/*
 * ctc.ct - L1: the ct-to-C compiler written in ct itself (Phase 1, bootstrap).
 *
 * This is the FIRST slice of Phase 1 self-hosting (milestone M2-a). It reads a
 * .ct file and writes plain C plus a matching .h, aiming to be byte-identical
 * with the frozen L0 compiler (ctc.c) on the subset listed below.
 *
 * Covered (M2-a):
 *   - trait NAME { ... }            -> struct NAME_vtbl / struct NAME_iface
 *   - struct NAME { ... } use T;    -> the qualified struct with the __t_vptr field
 *   - impl T for S { ... }          -> static methods + the vtable variable
 *   - method calls on value receivers (x.m(a) -> x.__t_vptr->m(&x, a))
 *   - a struct-typed variable declaration (append the vptr designator)
 *   - file-scope struct objects (`static S x = {...}`), which host the symbol table
 *   - ordinary function signatures (qualify known struct types, register params)
 *   - the generated .h (include guard, types only) and the provenance banner
 *   - the minimal CLI: `ctc <in.ct> -o <out.c>` (writes <out.c> and <out.h>)
 *
 * Not covered (left to later milestones). L1 reports these as errors instead of
 * emitting C that cannot compile:
 *   - namespace / import / pub (the module system)
 *   - interface polymorphism (a trait used as a variable / field / arg / return)
 *   - nested struct fields and struct composition construction
 *   - arrays, heap creation (malloc/calloc), delete / Drop
 *   - rvalue receivers (f().m()), field chains, #line and diagnostics
 *
 * The data model and pipeline layers are written as CT objects: the four symbol
 * tables live inside `g_sym` (`struct SymTab` + `use SymTabOps`) and the whole
 * output pipeline lives on `g_pipe` (`struct Pipe` + `use PipeOps`) -- the output
 * streams, the code emitters (`emit_trait_def` / `emit_struct_def` /
 * `put_own_vptr` / `body_needs_vtable`), the construct parsers, the line-rewriting
 * passes and the entry points (`emit_raw_line` / `compile_range` / `write_guard` /
 * `compile_file`) are its methods. Lookups read `g_sym.find_trait(..)` and the
 * pipeline is reached as `g_pipe.parse_trait(..)` / `g_pipe.compile_file(..)`, both
 * dispatching through their vtable. Only the facilities layer (Buf, allocators,
 * die, the scanning primitives) stays plain C.
 * The source stays inside the subset L0 itself accepts: the plain-C passthrough
 * of CT plus the line-rewriting discipline (one statement per line, no one-line
 * function bodies, declarations before use). L1 carries its own facilities; it
 * never includes ctc.c (reuse would make self-hosting vacuous).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

#include <ctype.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_NAME   128
#define MAX_PARAM  256
#define MAX_PARAMS 16
#define MAX_METHOD 32
#define MAX_TRAITS 16
#define MAX_STRUCT 32
#define MAX_VARS   512
#define MAX_SCOPE  256
#define MAX_FUNCS  64

#define CTC_VERSION "0.0.1"

/* ---------------------------------------------------------------- data */

typedef struct {
    char ret[MAX_NAME];
    char name[MAX_NAME];
    char params[MAX_PARAM];
    char ptypes[MAX_PARAMS][MAX_NAME];
    int  nparams;
} Method;

typedef struct {
    char   name[MAX_NAME];
    char   cname[MAX_NAME];
    Method m[MAX_METHOD];
    int    nm;
} Trait;

typedef struct {
    char name[MAX_NAME];
    char cname[MAX_NAME];
    char use_t[MAX_TRAITS][MAX_NAME];
    int  use_i[MAX_TRAITS];
    int  nu;
} Struct;

typedef struct {
    char name[MAX_NAME];
    int  s;
    int  ptr;
} Var;

/* A recorded function signature; M2-a only needs it to reject rvalue receivers
   (which would otherwise be passed through as C that cannot compile). */
typedef struct {
    char name[MAX_NAME];
    int  retstruct;
    int  retptr;
} FuncSig;

typedef struct {
    char   name[MAX_NAME];
    char   params[MAX_PARAM];
    size_t bstart, blen;
} ImplMethod;

typedef struct { char *p; size_t n, cap; } Buf;

/* -------------------------------------------------------------- globals */

static const char *g_src  = NULL;
static size_t      g_len  = 0;
static const char *g_path = "<input>";

/* the output streams live inside `g_pipe` and the four symbol tables inside
   `g_sym` (see the construct-parser and symbol-table sections) */

static int    g_scope[MAX_SCOPE];      static int g_nscope = 0;
static size_t g_body_abs = 0;
static int    g_body_pre = 0;

static char g_guard[MAX_NAME * 2];
static size_t g_line_off = 0;

/* ---------------------------------------------------------------- util */

static void *xmalloc(size_t n)
{
    void *p = malloc(n ? n : 1);
    if (!p) { fprintf(stderr, "ctc: out of memory\n"); exit(1); }
    return p;
}

static char *xstrndup(const char *s, size_t n)
{
    char *p = xmalloc(n + 1);
    memcpy(p, s, n);
    p[n] = 0;
    return p;
}

static int is_ident_char(int c)
{
    return isalnum((unsigned char)c) || c == '_';
}

static void die(size_t pos, const char *fmt, ...)
{
    va_list ap;
    int line = 1, col = 1;
    size_t i;

    for (i = 0; i < pos && i < g_len; i++) {
        if (g_src[i] == '\n') { line++; col = 1; } else col++;
    }
    fprintf(stderr, "%s:%d:%d: error: ", g_path, line, col);
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    va_end(ap);
    fputc('\n', stderr);
    exit(1);
}

/* leading/trailing whitespace trim, in place */
static void trim(char *s)
{
    size_t n, i = 0;
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') i++;
    if (i) memmove(s, s + i, strlen(s + i) + 1);
    n = strlen(s);
    while (n && isspace((unsigned char)s[n - 1])) s[--n] = 0;
}

static size_t trim_right_len(const char *s, size_t n)
{
    while (n && isspace((unsigned char)s[n - 1])) n--;
    return n;
}

static void to_lower(const char *in, char *out)
{
    size_t i;
    for (i = 0; in[i] && i < MAX_NAME - 1; i++)
        out[i] = (char)tolower((unsigned char)in[i]);
    out[i] = 0;
}

static void buf_init(Buf *b)
{
    b->cap = 256;
    b->n = 0;
    b->p = xmalloc(b->cap);
    b->p[0] = 0;
}

static void buf_putn(Buf *b, const char *s, size_t n)
{
    if (b->n + n + 1 > b->cap) {
        while (b->cap < b->n + n + 1) b->cap *= 2;
        b->p = realloc(b->p, b->cap);
        if (!b->p) { fprintf(stderr, "ctc: out of memory\n"); exit(1); }
    }
    memcpy(b->p + b->n, s, n);
    b->n += n;
    b->p[b->n] = 0;
}

static void buf_puts(Buf *b, const char *s)
{
    buf_putn(b, s, strlen(s));
}

static void buf_putc(Buf *b, char c)
{
    buf_putn(b, &c, 1);
}

/* --------------------------------------------------- source-level helpers */

static int word_at(size_t p, const char *w)
{
    size_t l = strlen(w);
    if (p + l > g_len) return 0;
    if (memcmp(g_src + p, w, l) != 0) return 0;
    if (p > 0 && is_ident_char((unsigned char)g_src[p - 1])) return 0;
    if (p + l < g_len && is_ident_char((unsigned char)g_src[p + l])) return 0;
    return 1;
}

static size_t skip_literal(size_t p)
{
    char q = g_src[p++];
    while (p < g_len) {
        if (g_src[p] == '\\' && p + 1 < g_len) { p += 2; continue; }
        if (g_src[p] == q) return p + 1;
        p++;
    }
    return p;
}

static size_t skip_comment(size_t p)
{
    if (p + 1 < g_len && g_src[p] == '/' && g_src[p + 1] == '/') {
        p += 2;
        while (p < g_len && g_src[p] != '\n') p++;
        return p;
    }
    if (p + 1 < g_len && g_src[p] == '/' && g_src[p + 1] == '*') {
        p += 2;
        while (p + 1 < g_len && !(g_src[p] == '*' && g_src[p + 1] == '/')) p++;
        return (p + 1 < g_len) ? p + 2 : g_len;
    }
    return p;
}

/* skip whitespace and comments (newlines included) */
static size_t skip_ws_comments(size_t p)
{
    for (;;) {
        while (p < g_len && isspace((unsigned char)g_src[p])) p++;
        if (p + 1 < g_len && g_src[p] == '/' &&
            (g_src[p + 1] == '/' || g_src[p + 1] == '*')) {
            p = skip_comment(p);
            continue;
        }
        return p;
    }
}

static size_t read_ident(size_t p, char *buf, size_t n)
{
    size_t i = 0;
    while (p < g_len && is_ident_char((unsigned char)g_src[p])) {
        if (i + 1 >= n) die(p, "identifier too long (max %d)", (int)n - 1);
        buf[i++] = g_src[p];
        p++;
    }
    buf[i] = 0;
    return p;
}

/* Copy the identifier at `src` into `buf` (MAX_NAME bytes) and return its
   length. A longer identifier is a hard error: dropping the tail would silently
   misparse (AGENTS §3 forbids silent truncation). */
static size_t copy_ident(const char *src, char *buf, size_t pos)
{
    size_t k = 0;
    while (is_ident_char((unsigned char)src[k])) {
        if (k + 1 >= MAX_NAME) die(pos, "identifier too long (max %d)", MAX_NAME - 1);
        buf[k] = src[k];
        k++;
    }
    buf[k] = 0;
    return k;
}

static size_t match_delim(size_t p, char open, char close)
{
    int depth = 0;
    size_t start = p;
    while (p < g_len) {
        char c = g_src[p];
        if (c == '"' || c == '\'') { p = skip_literal(p); continue; }
        if (c == '/' && p + 1 < g_len &&
            (g_src[p + 1] == '/' || g_src[p + 1] == '*')) { p = skip_comment(p); continue; }
        if (c == open) depth++;
        else if (c == close) { depth--; if (depth == 0) return p; }
        p++;
    }
    die(start, "unterminated '%c'", open);
    return p;
}

/* ---------------------------------------------------- symbol table */

/* The whole symbol table is one CT object. Lookups dispatch through SymTabOps,
   so call sites read `g_sym.find_trait(..)` instead of a bare global lookup. */
trait SymTabOps {
    Trait *find_trait(const char *name);
    Struct *find_struct(const char *name);
    const char *resolve_method(const Struct *s, const char *m);
    int find_var(const char *name);
    int new_var();
    FuncSig *find_func(const char *name);
    int is_any_trait_method(const char *m);
}

struct SymTab {
    Trait   traits[MAX_TRAITS];
    int     ntraits;
    Struct  structs[MAX_STRUCT];
    int     nstructs;
    Var     vars[MAX_VARS];
    int     nvars;
    FuncSig funcs[MAX_FUNCS];
    int     nfuncs;
} use SymTabOps;

impl SymTabOps for SymTab {
    Trait *find_trait(const char *name) {
        int i;
        for (i = 0; i < self->ntraits; i++)
            if (strcmp(self->traits[i].cname, name) == 0) return &self->traits[i];
        return NULL;
    }
    Struct *find_struct(const char *name) {
        int i;
        for (i = 0; i < self->nstructs; i++)
            if (strcmp(self->structs[i].cname, name) == 0) return &self->structs[i];
        return NULL;
    }
    /* which trait of struct `s` declares method `m`? NULL when none does */
    const char *resolve_method(const Struct *s, const char *m) {
        int i, k;
        for (i = 0; i < s->nu; i++) {
            const Trait *t = &self->traits[s->use_i[i]];
            for (k = 0; k < t->nm; k++)
                if (strcmp(t->m[k].name, m) == 0) return t->name;
        }
        return NULL;
    }
    int find_var(const char *name) {
        int i;
        for (i = 0; i < self->nvars; i++)
            if (strcmp(self->vars[i].name, name) == 0) return i;
        return -1;
    }
    /* Reserve the next variable slot. Overflow is a hard error: a dropped
       registration would mis-compile method calls (AGENTS §3). */
    int new_var() {
        int i;
        if (self->nvars >= MAX_VARS) die(0, "too many variables (max %d)", MAX_VARS);
        i = self->nvars++;
        return i;
    }
    /* the last recorded signature of `name`, or NULL */
    FuncSig *find_func(const char *name) {
        int i;
        for (i = self->nfuncs - 1; i >= 0; i--)
            if (strcmp(self->funcs[i].name, name) == 0) return &self->funcs[i];
        return NULL;
    }
    /* does any declared trait have a method named `m`? */
    int is_any_trait_method(const char *m) {
        int i, j;
        for (i = 0; i < self->ntraits; i++)
            for (j = 0; j < self->traits[i].nm; j++)
                if (strcmp(self->traits[i].m[j].name, m) == 0) return 1;
        return 0;
    }
}

static SymTab g_sym = { .ntraits = 0, .nstructs = 0, .nvars = 0, .nfuncs = 0 };

/* `struct_uses` stays plain C: it reads only the receiver Struct, no table. */
static int struct_uses(const Struct *s, const char *trait)
{
    int i;
    for (i = 0; i < s->nu; i++)
        if (strcmp(s->use_t[i], trait) == 0) return 1;
    return 0;
}

/* --------------------------------------------------- signature parsing */

static int is_type_keyword(const char *s)
{
    static const char *kw[] = {
        "void", "char", "short", "int", "long", "float", "double",
        "signed", "unsigned", "_Bool", "bool", "const", "volatile",
        "struct", "union", "enum", "size_t", "ssize_t", "FILE", "wchar_t",
        "int8_t", "int16_t", "int32_t", "int64_t",
        "uint8_t", "uint16_t", "uint32_t", "uint64_t", "ptrdiff_t", NULL
    };
    int i;
    for (i = 0; kw[i]; i++)
        if (strcmp(kw[i], s) == 0) return 1;
    return 0;
}

/* "char *name" -> "char *" ; "int" -> "int" (already a type) */
static void param_type_only(const char *piece, char *out)
{
    char t[MAX_NAME * 2];
    int end, st;
    char id[MAX_NAME];

    snprintf(t, sizeof t, "%s", piece);
    trim(t);

    end = (int)strlen(t);
    st = end;
    while (st > 0 && is_ident_char((unsigned char)t[st - 1])) st--;
    if (st == end) { snprintf(out, MAX_NAME, "%s", t); return; }

    snprintf(id, sizeof id, "%.*s", end - st, t + st);
    if (is_type_keyword(id)) { snprintf(out, MAX_NAME, "%s", t); return; }

    t[st] = 0;
    trim(t);
    snprintf(out, MAX_NAME, "%s", t);
}

/* parse_params / split_decl are `Pipe` methods now (see `impl PipeOps for
   Pipe` below): they turn one method declaration into the `Method` record and
   never read the symbol tables, so they take no `struct SymTab *sym`. */

/* C keywords that can never be a function's return type or its name */
static int is_stmt_keyword(const char *s)
{
    static const char *kw[] = {
        "if", "else", "while", "for", "switch", "case", "default", "do",
        "return", "goto", "break", "continue", "sizeof", NULL
    };
    int i;
    for (i = 0; kw[i]; i++)
        if (strcmp(kw[i], s) == 0) return 1;
    return 0;
}

/* the last identifier token in s[0..n): 1 and [*a,*b) when there is one */
static int last_ident(const char *s, size_t n, size_t *a, size_t *b)
{
    size_t e = n, st;
    while (e > 0 && !is_ident_char((unsigned char)s[e - 1])) e--;
    if (e == 0) return 0;
    st = e;
    while (st > 0 && is_ident_char((unsigned char)s[st - 1])) st--;
    *a = st;
    *b = e;
    return 1;
}

/* is the identifier at `off` in `type` already preceded by "struct"? */
static int already_qualified(const char *type, size_t off)
{
    size_t q = off;
    while (q > 0 && isspace((unsigned char)type[q - 1])) q--;
    return q >= 6 && memcmp(type + q - 6, "struct", 6) == 0 &&
           (q == 6 || !is_ident_char((unsigned char)type[q - 7]));
}

/* analyse_param / emit_qualified_type are `Pipe` methods now (see `impl
   PipeOps for Pipe` below); analyse_param reads the symbol tables through `sym`. */

/* The four code emitters (emit_trait_def / emit_struct_def / put_own_vptr /
   body_needs_vtable) are `Pipe` methods now -- see `impl PipeOps for Pipe`
   below. Each keeps its stream parameter (FILE* / Buf*) because it is used for
   both the .c output (`self->out`) and the .h output (`self->hout`), and takes
   `struct SymTab *sym` wherever it reads the symbol tables. `is_any_trait_method`
   stays a `SymTabOps` method (see the symbol-table section). */

/* Scan primitives and pipeline entry points defined after the `Pipe` impl but
   called from its methods (the line rewriters use `line_literal_end` /
   `line_match_paren`; `header_path` / `read_file` are called from `compile_file`). */
static size_t line_literal_end(const char *s, size_t i, size_t n);
static size_t line_match_paren(const char *s, size_t k, size_t n);
static void header_path(const char *outc, char *out, size_t n);
static char *read_file(const char *path, size_t *out_len);

/* ------------------------------------------------------- construct parsers */

/* The whole output pipeline lives on the `Pipe` object: the output streams are
   its fields and the code emitters, the construct parsers, the
   method-declaration parsers, the declaration-piece helpers and the pipeline
   entry points are its methods, so call sites read
   `g_pipe.parse_trait(..)` / `g_pipe.compile_file(..)`. The symbol tables arrive
   as `struct SymTab *sym` because a method body cannot see the file-scope
   `g_sym` object. */
trait PipeOps {
    size_t parse_trait(struct SymTab *sym, size_t p);
    size_t parse_struct(struct SymTab *sym, size_t p);
    size_t parse_impl(struct SymTab *sym, size_t p);
    /* method-declaration parsers, called from parse_trait */
    void parse_params(Method *m, const char *raw);
    void split_decl(const char *decl, size_t pos, Method *m);
    /* code emitters, called from the parsers above (stream passed explicitly) */
    void emit_trait_def(FILE *f, const Trait *T);
    void emit_struct_def(struct SymTab *sym, FILE *f, const Struct *S, const char *body);
    void put_own_vptr(Buf *b, const Struct *S, int *first);
    int body_needs_vtable(struct SymTab *sym, size_t bstart, size_t blen);
    /* declaration-piece helpers, shared by parse_fields and parse_func_sig */
    int analyse_param(struct SymTab *sym, const char *s, size_t n, int *ia, int *ib, char *cbase, int *need_struct, char *name, int *isptr, int *tr);
    void emit_qualified_type(Buf *b, const char *piece, size_t len, int ia, int ib, const char *cbase, int need_struct, int is_trait);
    char *parse_fields(struct SymTab *sym, const char *body, Struct *S, size_t pos);
    void emit_body(struct SymTab *sym, FILE *f, size_t bstart, size_t blen, const Struct *S, const char *params);
    void register_body_params(struct SymTab *sym, const char *params);
    void replace_self(const char *s, size_t n, Buf *out);
    char *transform_line(struct SymTab *sym, const char *line);
    char *try_var_decl(struct SymTab *sym, const char *line);
    void transform_calls(struct SymTab *sym, const char *s, Buf *out);
    int walk_method(struct SymTab *sym, const char *s, size_t n, size_t pos, int cur, int isptr, int *out_need_amp, const char **out_tr, size_t *out_rend, size_t *mp, char *memb);
    int decl_end_is_bare(const char *s);
    char *parse_func_sig(struct SymTab *sym, const char *line, size_t ls, int *has_body, size_t *body_abs);
    void scope_track(struct SymTab *sym, size_t ls, size_t le);
    void emit_raw_line(struct SymTab *sym, size_t ls, size_t le);
    void compile_range(struct SymTab *sym, size_t start, size_t end);
    int compile_file(struct SymTab *sym, const char *in, const char *outc);
    void write_guard(const char *hpath);
}

struct Pipe {
    FILE *out;
    FILE *hout;
} use PipeOps;

/* Copy a struct body verbatim. M2-a does not support composition or interface
   fields, so any field whose type names a known struct or trait is a hard error
   rather than silent C that cannot compile. Returns a new body string. This is a
   `Pipe` method now (see `impl PipeOps for Pipe` below). */

impl PipeOps for Pipe {
    void emit_trait_def(FILE *f, const Trait *T) {
        int i, k;
        (void)self;  /* the stream is passed in; the receiver is not used */
        fprintf(f, "struct %s_vtbl {\n", T->cname);
        for (i = 0; i < T->nm; i++) {
            const Method *m = &T->m[i];
            fprintf(f, "    %s (*%s)(void *", m->ret, m->name);
            for (k = 0; k < m->nparams; k++) fprintf(f, ", %s", m->ptypes[k]);
            fprintf(f, ");\n");
        }
        fprintf(f, "};\n");
        fprintf(f, "struct %s_iface {\n    void *self;\n    struct %s_vtbl *vt;\n};\n",
                T->cname, T->cname);
    }

    void emit_struct_def(struct SymTab *sym, FILE *f, const Struct *S, const char *body) {
        int i;
        size_t blen = strlen(body);

        (void)self;  /* the body only reads the symbol table, not the receiver */
        fprintf(f, "struct %s {", S->cname);
        if (blen && body[0] != '\n') fputc('\n', f);
        if (blen) fputs(body, f);
        if (blen == 0 || body[blen - 1] != '\n') fputc('\n', f);
        for (i = 0; i < S->nu; i++) {
            char low[MAX_NAME];
            to_lower(S->use_t[i], low);
            fprintf(f, "    struct %s_vtbl *__%s_vptr;\n", sym->traits[S->use_i[i]].cname, low);
        }
        fprintf(f, "};\n");
    }

    /* append one ".__<trait>_vptr = &<Struct>_<Trait>_vtable" per used trait */
    void put_own_vptr(Buf *b, const Struct *S, int *first) {
        int h;
        (void)self;  /* the buffer is passed in; the receiver is not used */
        for (h = 0; h < S->nu; h++) {
            char low[MAX_NAME];
            to_lower(S->use_t[h], low);
            if (!*first) buf_puts(b, ", ");
            *first = 0;
            buf_puts(b, ".__");
            buf_puts(b, low);
            buf_puts(b, "_vptr = &");
            buf_puts(b, S->cname);
            buf_putc(b, '_');
            buf_puts(b, S->use_t[h]);
            buf_puts(b, "_vtable");
        }
    }

    /* Does a body contain a call that will become a vtable dispatch? Any `.m(` /
       `->m(` whose `m` names a declared trait method counts; when it does, the
       impl's vtable variable must be declared before the method bodies. */
    int body_needs_vtable(struct SymTab *sym, size_t bstart, size_t blen) {
        size_t i = bstart, end = bstart + blen;

        (void)self;  /* the body only consults the symbol table for the method */
        while (i < end) {
            char c = g_src[i];
            if (c == '"' || c == '\'') {
                size_t j = skip_literal(i);
                i = (j > end) ? end : j;
                continue;
            }
            if (c == '/' && i + 1 < end &&
                (g_src[i + 1] == '/' || g_src[i + 1] == '*')) {
                size_t j = skip_comment(i);
                i = (j > end) ? end : j;
                continue;
            }
            if (c == '.' || c == '-') {
                size_t ms = (c == '.') ? i + 1 : i + 2;
                size_t e, ml;
                char mem[MAX_NAME];
                if (c == '-') {
                    if (i + 1 >= end || g_src[i + 1] != '>') { i++; continue; }
                }
                e = ms;
                while (e < end && is_ident_char((unsigned char)g_src[e])) e++;
                ml = e - ms;
                if (ml > 0 && ml < MAX_NAME && e < end && g_src[e] == '(') {
                    memcpy(mem, g_src + ms, ml);
                    mem[ml] = 0;
                    if (sym->is_any_trait_method(mem)) return 1;
                }
                i = (e > i) ? e : i + 1;
                continue;
            }
            i++;
        }
        return 0;
    }

    /* Analyse one declaration piece: the struct its type names (an index into
       sym->structs, or -1), the trait when the type is an interface value
       (`*tr`), the identifier span [*ia,*ib) of the base type name, its
       generated spelling (`cbase`), whether "struct " must be inserted, the
       declared name ("" when unnamed) and whether it is a pointer. */
    int analyse_param(struct SymTab *sym, const char *s, size_t n, int *ia, int *ib, char *cbase, int *need_struct, char *name, int *isptr, int *tr) {
        size_t a, b, lim = 0, tn, ea, eb;
        char type[MAX_NAME * 2], base[MAX_NAME];
        int idx = -1;
        const Struct *S;
        const Trait *T;

        (void)self;  /* the body only consults the symbol table for the type */
        *ia = -1;
        *ib = -1;
        *need_struct = 0;
        *tr = -1;
        cbase[0] = 0;
        base[0] = 0;
        name[0] = 0;
        *isptr = 0;

        while (lim < n && s[lim] != '[') lim++;
        if (!last_ident(s, lim, &a, &b)) return -1;

        {
            size_t lsx = b;
            char last[MAX_NAME];
            while (lsx > a && is_ident_char((unsigned char)s[lsx - 1])) lsx--;
            snprintf(last, sizeof last, "%.*s", (int)(b - lsx), s + lsx);
            if (!is_type_keyword(last) && !sym->find_struct(last) && !sym->find_trait(last)) {
                snprintf(name, MAX_NAME, "%s", last);
                snprintf(type, sizeof type, "%.*s", (int)a, s);
            } else {
                snprintf(type, sizeof type, "%.*s", (int)n, s);   /* the type itself */
            }
        }
        if (lim < n) name[0] = 0;                                 /* array: no object to bind */

        tn = strlen(type);
        while (tn > 0 && (type[tn - 1] == '*' || isspace((unsigned char)type[tn - 1]))) tn--;
        if (tn == 0 || !last_ident(type, tn, &ea, &eb)) return -1;

        {
            size_t bl = eb - ea;
            if (bl >= sizeof base) bl = sizeof base - 1;
            memcpy(base, type + ea, bl);
            base[bl] = 0;
            S = sym->find_struct(base);
            T = S ? NULL : sym->find_trait(base);
            if (S) snprintf(cbase, MAX_NAME, "%s", S->cname);
            else if (T) snprintf(cbase, MAX_NAME, "%s", T->cname);
        }

        if (S) {
            idx = (int)(S - sym->structs);
            *ia = (int)ea;
            *ib = (int)eb;
            *need_struct = !already_qualified(type, ea);
        } else if (T) {
            *tr = (int)(T - sym->traits);
            *ia = (int)ea;
            *ib = (int)eb;
            *need_struct = !already_qualified(type, ea);
        } else if (strlen(base) > 6 && strcmp(base + strlen(base) - 6, "_iface") == 0) {
            char pre[MAX_NAME];
            size_t pl = strlen(base) - 6;
            if (pl < sizeof pre) {
                memcpy(pre, base, pl);
                pre[pl] = 0;
                T = sym->find_trait(pre);
                if (T) *tr = (int)(T - sym->traits);
            }
        }

        *isptr = (strchr(type, '*') != NULL);
        return idx;
    }

    /* emit a declaration piece: replace the base type identifier [ia,ib) with its
       generated spelling, inserting "struct " as needed */
    void emit_qualified_type(Buf *b, const char *piece, size_t len, int ia, int ib, const char *cbase, int need_struct, int is_trait) {
        (void)self;  /* a pure emit helper; the receiver is not used */
        if (ia < 0) { buf_putn(b, piece, len); return; }
        buf_putn(b, piece, (size_t)ia);
        if (need_struct) buf_puts(b, "struct ");
        buf_puts(b, cbase);
        if (is_trait) buf_puts(b, "_iface");
        buf_putn(b, piece + ib, len - (size_t)ib);
    }

    char *parse_fields(struct SymTab *sym, const char *body, Struct *S, size_t pos) {
        Buf out;
        size_t n = strlen(body), i = 0;

        buf_init(&out);

        while (i < n) {
            size_t j = i, depth = 0;
            int ia = -1, ib = -1, need_struct = 0, ptr = 0, idx, tr;
            char fname[MAX_NAME], cbase[MAX_NAME];

            while (j < n) {
                char c = body[j];
                if (c == '"' || c == '\'') {
                    char q = c;
                    j++;
                    while (j < n) {
                        if (body[j] == '\\' && j + 1 < n) { j += 2; continue; }
                        if (body[j] == q) { j++; break; }
                        j++;
                    }
                    continue;
                }
                if (c == '{' || c == '(' || c == '[') depth++;
                else if (c == '}' || c == ')' || c == ']') depth--;
                else if (c == ';' && depth == 0) break;
                j++;
            }

            idx = self->analyse_param(sym, body + i, j - i, &ia, &ib, cbase, &need_struct, fname, &ptr, &tr);
            if (idx >= 0)
                die(pos, "struct '%s': a field of struct type is not supported (no composition)", S->name);
            if (tr >= 0)
                die(pos, "struct '%s': an interface-typed field is not supported", S->name);
            self->emit_qualified_type(&out, body + i, j - i, ia, ib, cbase, need_struct, 0);
            if (j < n) { buf_putc(&out, ';'); j++; }
            i = j;
        }
        return out.p;
    }

    /* raw param list -> verbatim params + type-only list */
    void parse_params(Method *m, const char *raw) {
        char tmp[MAX_PARAM * 2];
        char *p;
        int depth = 0;
        size_t start = 0, i, n;

        (void)self;  /* a pure parse helper; the receiver is not used */
        snprintf(tmp, sizeof tmp, "%s", raw);
        trim(tmp);

        m->nparams = 0;
        m->params[0] = 0;

        if (!tmp[0] || strcmp(tmp, "void") == 0) return;

        p = tmp;
        n = strlen(p);
        for (i = 0; i <= n; i++) {
            char c = (i < n) ? p[i] : ',';
            if (i < n) {
                if (c == '(' || c == '[') depth++;
                else if (c == ')' || c == ']') depth--;
            }
            if (c == ',' && depth == 0) {
                char piece[MAX_NAME * 2];
                size_t len = i - start;
                if (len >= sizeof piece) len = sizeof piece - 1;
                memcpy(piece, p + start, len);
                piece[len] = 0;
                trim(piece);
                if (piece[0]) {
                    if (m->nparams >= MAX_PARAMS)
                        die(0, "too many parameters in method '%s'", m->name);
                    if (m->nparams) strncat(m->params, ", ", sizeof m->params - strlen(m->params) - 1);
                    strncat(m->params, piece, sizeof m->params - strlen(m->params) - 1);
                    param_type_only(piece, m->ptypes[m->nparams]);
                    m->nparams++;
                }
                start = i + 1;
            }
        }
    }

    /* "void greet(int a)" -> ret="void", name="greet", params="int a" */
    void split_decl(const char *decl, size_t pos, Method *m) {
        const char *lp = strchr(decl, '(');
        const char *rp;
        char pre[MAX_NAME * 2];
        int end, st;

        (void)self;  /* a pure parse helper; the receiver is not used */
        if (!lp) die(pos, "expected '(' in method declaration");
        snprintf(pre, sizeof pre, "%.*s", (int)(lp - decl), decl);
        trim(pre);

        end = (int)strlen(pre);
        st = end;
        while (st > 0 && is_ident_char((unsigned char)pre[st - 1])) st--;
        if (st == end) die(pos, "expected method name in declaration");
        snprintf(m->name, sizeof m->name, "%.*s", end - st, pre + st);
        pre[st] = 0;
        trim(pre);
        if (!pre[0]) die(pos, "expected return type for method '%s'", m->name);
        snprintf(m->ret, sizeof m->ret, "%s", pre);

        rp = strchr(lp, ')');
        if (!rp) die(pos, "expected ')' in declaration of '%s'", m->name);
        {
            char raw[MAX_PARAM * 2];
            size_t len = (size_t)(rp - lp - 1);
            if (len >= sizeof raw) len = sizeof raw - 1;
            memcpy(raw, lp + 1, len);
            raw[len] = 0;
            self->parse_params(m, raw);
        }
        {
            const char *tail = rp + 1;
            while (*tail == ' ' || *tail == '\t') tail++;
            if (*tail) die(pos, "unexpected '%s' after declaration of '%s'", tail, m->name);
        }
    }

    size_t parse_trait(struct SymTab *sym, size_t p) {
        char name[MAX_NAME];
        Trait *T;
        size_t close, bstart, bend, i;
        Buf raw, clean;

        p += 5;                                     /* "trait" */
        p = skip_ws_comments(p);
        p = read_ident(p, name, sizeof name);
        if (!name[0]) die(p, "expected trait name");
        p = skip_ws_comments(p);
        if (p >= g_len || g_src[p] != '{') die(p, "expected '{' after trait '%s'", name);

        close = match_delim(p, '{', '}');
        bstart = p + 1;
        bend = close;

        if (sym->ntraits >= MAX_TRAITS) die(p, "too many traits (max %d)", MAX_TRAITS);
        T = &sym->traits[sym->ntraits++];
        snprintf(T->name, sizeof T->name, "%s", name);
        snprintf(T->cname, sizeof T->cname, "%s", name);
        T->nm = 0;

        buf_init(&raw);
        buf_putn(&raw, g_src + bstart, bend - bstart);
        buf_init(&clean);
        {
            /* strip comments once so ';' inside them does not split declarations */
            size_t k = 0, ln = raw.n;
            while (k < ln) {
                char c = raw.p[k];
                if (c == '"' || c == '\'') {
                    char q = c;
                    buf_putc(&clean, raw.p[k++]);
                    while (k < ln) {
                        if (raw.p[k] == '\\' && k + 1 < ln) {
                            buf_putc(&clean, raw.p[k]);
                            buf_putc(&clean, raw.p[k + 1]);
                            k += 2;
                            continue;
                        }
                        buf_putc(&clean, raw.p[k]);
                        if (raw.p[k] == q) { k++; break; }
                        k++;
                    }
                    continue;
                }
                if (c == '/' && k + 1 < ln && raw.p[k + 1] == '/') {
                    while (k < ln && raw.p[k] != '\n') k++;
                    continue;
                }
                if (c == '/' && k + 1 < ln && raw.p[k + 1] == '*') {
                    k += 2;
                    while (k + 1 < ln && !(raw.p[k] == '*' && raw.p[k + 1] == '/')) k++;
                    k = (k + 1 < ln) ? k + 2 : ln;
                    continue;
                }
                buf_putc(&clean, raw.p[k++]);
            }
        }
        free(raw.p);

        i = 0;
        for (;;) {
            size_t j = i;
            while (j <= clean.n && !(j < clean.n && clean.p[j] == ';')) j++;
            {
                char *seg = xstrndup(clean.p + i, j - i);
                trim(seg);
                if (seg[0]) {
                    if (T->nm >= MAX_METHOD)
                        die(close, "too many methods in trait '%s'", T->name);
                    self->split_decl(seg, close, &T->m[T->nm]);
                    T->nm++;
                }
                free(seg);
            }
            if (j >= clean.n) break;
            i = j + 1;
        }
        free(clean.p);

        self->emit_trait_def(self->out, T);
        self->emit_trait_def(self->hout, T);
        return close + 1;
    }

    size_t parse_struct(struct SymTab *sym, size_t p) {
        char name[MAX_NAME];
        Struct *S;
        size_t close, bstart, bend, q, probe;
        int i;

        p += 6;                                     /* "struct" */
        p = skip_ws_comments(p);
        p = read_ident(p, name, sizeof name);
        if (!name[0]) die(p, "expected struct name");
        p = skip_ws_comments(p);
        if (p >= g_len || g_src[p] != '{') die(p, "expected '{' after struct '%s'", name);

        close = match_delim(p, '{', '}');
        bstart = p + 1;
        bend = close;

        if (sym->nstructs >= MAX_STRUCT) die(p, "too many structs (max %d)", MAX_STRUCT);
        S = &sym->structs[sym->nstructs++];
        snprintf(S->name, sizeof S->name, "%s", name);
        snprintf(S->cname, sizeof S->cname, "%s", name);
        S->nu = 0;

        q = close + 1;
        probe = q;
        while (probe < g_len && (g_src[probe] == ' ' || g_src[probe] == '\t')) probe++;
        if (probe < g_len && g_src[probe] == '\n') {
            size_t t = probe + 1;
            while (t < g_len && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (word_at(t, "use")) probe = t;
        }

        if (word_at(probe, "use")) {
            size_t u = skip_ws_comments(probe + 3);
            for (;;) {
                char tn[MAX_NAME];
                u = read_ident(u, tn, sizeof tn);
                if (!tn[0]) die(u, "expected trait name in 'use' clause of '%s'", S->name);
                if (S->nu >= MAX_TRAITS) die(u, "too many traits used by '%s'", S->name);
                snprintf(S->use_t[S->nu], MAX_NAME, "%s", tn);
                S->nu++;
                u = skip_ws_comments(u);
                if (u < g_len && g_src[u] == ',') { u = skip_ws_comments(u + 1); continue; }
                break;
            }
            if (u >= g_len || g_src[u] != ';') die(u, "expected ';' after 'use' clause of '%s'", S->name);
            q = u + 1;
        } else {
            size_t t = q;
            while (t < g_len && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t < g_len && g_src[t] == ';') q = t + 1;
        }

        for (i = 0; i < S->nu; i++) {
            Trait *T = sym->find_trait(S->use_t[i]);
            if (!T)
                die(p, "struct '%s' uses undefined trait '%s'", S->name, S->use_t[i]);
            S->use_i[i] = (int)(T - sym->traits);
        }

        {
            char *raw = xstrndup(g_src + bstart, bend - bstart);
            char *qbody = self->parse_fields(sym, raw, S, p);
            free(raw);
            self->emit_struct_def(sym, self->out, S, qbody);
            self->emit_struct_def(sym, self->hout, S, qbody);
            free(qbody);
        }
        return q;
    }

    size_t parse_impl(struct SymTab *sym, size_t p) {
        char trait_name[MAX_NAME], struct_name[MAX_NAME];
        Trait *T;
        Struct *S;
        size_t close, i, k;
        ImplMethod impl[MAX_METHOD];
        int nimpl = 0, found;

        p += 4;                                     /* "impl" */
        p = skip_ws_comments(p);
        p = read_ident(p, trait_name, sizeof trait_name);
        if (!trait_name[0]) die(p, "expected trait name after 'impl'");
        p = skip_ws_comments(p);
        if (!word_at(p, "for")) die(p, "expected 'for' in impl of '%s'", trait_name);
        p = skip_ws_comments(p + 3);
        p = read_ident(p, struct_name, sizeof struct_name);
        if (!struct_name[0]) die(p, "expected struct name after 'for'");
        p = skip_ws_comments(p);
        if (p >= g_len || g_src[p] != '{') die(p, "expected '{' in impl body");

        close = match_delim(p, '{', '}');

        T = sym->find_trait(trait_name);
        if (!T) die(p, "impl for undefined trait '%s'", trait_name);
        S = sym->find_struct(struct_name);
        if (!S) die(p, "impl for undefined struct '%s'", struct_name);
        if (!struct_uses(S, T->name))
            die(p, "struct '%s' does not use trait '%s'", S->name, T->name);

        /* collect the methods written in the impl block */
        i = p + 1;
        while (1) {
            size_t lp, rp, bp, be;
            char header[MAX_NAME * 2];
            char pre[MAX_NAME * 2];
            int end, st;

            i = skip_ws_comments(i);
            if (i >= close) break;

            lp = i;
            while (lp < close && g_src[lp] != '(') lp++;
            if (lp >= close) die(i, "expected method declaration inside impl of '%s' for '%s'",
                                 T->name, S->name);

            snprintf(pre, sizeof pre, "%.*s", (int)(lp - i), g_src + i);
            trim(pre);
            end = (int)strlen(pre);
            st = end;
            while (st > 0 && is_ident_char((unsigned char)pre[st - 1])) st--;
            if (st == end) die(i, "expected method name inside impl of '%s' for '%s'",
                               T->name, S->name);
            if (nimpl >= MAX_METHOD) die(i, "too many methods in impl of '%s'", T->name);
            snprintf(header, sizeof header, "%.*s", end - st, pre + st);

            rp = match_delim(lp, '(', ')');
            {
                size_t blen = (rp > lp + 1) ? (rp - lp - 1) : 0;
                if (blen >= MAX_PARAM) die(lp, "parameter list too long (max %d)", MAX_PARAM - 1);
                memcpy(impl[nimpl].params, g_src + lp + 1, blen);
                impl[nimpl].params[blen] = 0;
                trim(impl[nimpl].params);
            }

            bp = skip_ws_comments(rp + 1);
            if (bp >= close || g_src[bp] != '{')
                die(bp, "expected '{' to start body of method '%s'", header);
            be = match_delim(bp, '{', '}');

            snprintf(impl[nimpl].name, MAX_NAME, "%s", header);
            impl[nimpl].bstart = bp + 1;
            impl[nimpl].blen = be - bp - 1;
            nimpl++;

            i = be + 1;
        }

        /* every impl method must belong to the trait */
        for (k = 0; k < (size_t)nimpl; k++) {
            int j;
            found = 0;
            for (j = 0; j < T->nm; j++)
                if (strcmp(T->m[j].name, impl[k].name) == 0) { found = 1; break; }
            if (!found)
                die(p, "method '%s' is not declared in trait '%s'", impl[k].name, T->name);
        }

        /* bodies that call a sibling method need the vtable declared up front */
        {
            int needs_vtable = 0;
            for (k = 0; k < (size_t)nimpl; k++)
                if (self->body_needs_vtable(sym, impl[k].bstart, impl[k].blen)) { needs_vtable = 1; break; }
            if (needs_vtable)
                fprintf(self->out, "static struct %s_vtbl %s_%s_vtable;\n\n",
                        T->cname, S->cname, T->name);
        }

        /* emit one function per trait method, in trait order */
        for (k = 0; k < (size_t)T->nm; k++) {
            Method *tm = &T->m[k];
            int idx = -1;
            int j;
            for (j = 0; j < nimpl; j++)
                if (strcmp(impl[j].name, tm->name) == 0) { idx = j; break; }
            if (idx < 0)
                die(p, "trait method '%s' is not implemented for struct '%s'",
                    tm->name, S->name);

            fprintf(self->out, "static %s %s_%s_%s(void *self", tm->ret, S->cname, T->name, tm->name);
            if (tm->nparams > 0) fprintf(self->out, ", %s", impl[idx].params);
            fprintf(self->out, ") {\n");
            fprintf(self->out, "    struct %s *_self = (struct %s *)self;\n", S->cname, S->cname);
            self->emit_body(sym, self->out, impl[idx].bstart, impl[idx].blen, S, impl[idx].params);
            fprintf(self->out, "}\n\n");
        }

        fprintf(self->out, "static struct %s_vtbl %s_%s_vtable = {\n",
                T->cname, S->cname, T->name);
        for (k = 0; k < (size_t)T->nm; k++)
            fprintf(self->out, "    .%s = %s_%s_%s%s\n",
                    T->m[k].name, S->cname, T->name, T->m[k].name,
                    (k + 1 < (size_t)T->nm) ? "," : "");
        fprintf(self->out, "};\n\n");

        {
            size_t q = close + 1;
            size_t t = q;
            while (t < g_len && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t < g_len && g_src[t] == ';') q = t + 1;
            return q;
        }
    }

    /* Pass one raw source line through the shared rewriting pipeline. */
    void emit_raw_line(struct SymTab *sym, size_t ls, size_t le) {
        size_t len = le - ls, t = 0;
        char *line, *sig;
        int pre = sym->nvars, has_body = 0;
        size_t body_abs = 0;

        line = xstrndup(g_src + ls, len);
        while (t < len && (line[t] == ' ' || line[t] == '\t')) t++;
        if (t < len && line[t] == '#') {                 /* preprocessor: verbatim */
            fputs(line, self->out);
            free(line);
            return;
        }

        g_line_off = ls;
        sig = self->parse_func_sig(sym, line, ls, &has_body, &body_abs);
        if (sig) {
            if (has_body) { g_body_abs = body_abs; g_body_pre = pre; }
            fputs(sig, self->out);
            free(sig);
        } else {
            char *out = self->transform_line(sym, line);
            fputs(out, self->out);
            free(out);
        }
        free(line);
        self->scope_track(sym, ls, le);
    }

    /* Scan [start,end): expand traits/structs/impls, pass the rest through. */
    void compile_range(struct SymTab *sym, size_t start, size_t end) {
        size_t pos = start;

        while (pos < end) {
            size_t ls = pos, q, le;

            q = ls;
            while (q < end && (g_src[q] == ' ' || g_src[q] == '\t')) q++;

            /* the module system lives in the CT layer; passing these through would
               silently emit C that cannot compile, so fail loudly instead. */
            {
                static const char *const gone[] = { "namespace", "import", "pub" };
                int gi;
                for (gi = 0; gi < 3; gi++) {
                    char nm[MAX_NAME];
                    size_t t;
                    if (!word_at(q, gone[gi])) continue;
                    t = read_ident(skip_ws_comments(q + strlen(gone[gi])), nm, sizeof nm);
                    if (nm[0] || (t < g_len && g_src[t] == '{'))
                        die(q, "'%s' is not supported by this compiler", gone[gi]);
                }
            }

            if (word_at(q, "trait")) {
                char nm[MAX_NAME];
                size_t t = read_ident(skip_ws_comments(q + 5), nm, sizeof nm);
                if (nm[0] || (t < g_len && g_src[t] == '{')) { pos = self->parse_trait(sym, q); continue; }
            }
            if (word_at(q, "impl")) {
                char nm[MAX_NAME];
                size_t t = read_ident(skip_ws_comments(q + 4), nm, sizeof nm);
                if (nm[0] || (t < g_len && g_src[t] == '{')) { pos = self->parse_impl(sym, q); continue; }
            }
            if (word_at(q, "struct")) {
                size_t t = skip_ws_comments(q + 6);
                char nm[MAX_NAME];
                t = read_ident(t, nm, sizeof nm);
                if (nm[0]) {
                    t = skip_ws_comments(t);
                    if (t < g_len && g_src[t] == '{') { pos = self->parse_struct(sym, q); continue; }
                }
            }

            le = ls;
            while (le < end && g_src[le] != '\n') le++;
            self->emit_raw_line(sym, ls, le);
            if (le < end) { fputc('\n', self->out); le++; }
            pos = le;
        }
    }

    /* Write the include guard and provenance banner into the header stream. */
    void write_guard(const char *hpath) {
        const char *b = strrchr(hpath, '/');
        char guard[MAX_NAME * 2];
        size_t i, j = 0;
        b = b ? b + 1 : hpath;

        for (i = 0; b[i] && b[i] != '.' && j + 1 < sizeof guard; i++)
            guard[j++] = (isalnum((unsigned char)b[i]) ? (char)toupper((unsigned char)b[i]) : '_');
        guard[j] = 0;
        if (!j) snprintf(guard, sizeof guard, "CT_OUTPUT");
        if (guard[0] >= '0' && guard[0] <= '9') {
            memmove(guard + 1, guard, j + 1);
            guard[0] = '_';
        }
        strncat(guard, "_H", sizeof guard - strlen(guard) - 1);

        fprintf(self->hout, "#ifndef %s\n#define %s\n\n", guard, guard);
        fprintf(self->hout, "/* Generated by ctc v%s from %s (Phase 0: types only, the\n"
                        "   generated .c is self-contained).\n"
                        "   Generated output is not covered by the GPL and may be "
                        "used without restriction (LICENSE.EXCEPTION). */\n\n",
                CTC_VERSION, g_path);
        snprintf(g_guard, sizeof g_guard, "%s", guard);
    }

    /* Compile one input to `outc` and a matching header. Returns 0 on success. */
    int compile_file(struct SymTab *sym, const char *in, const char *outc) {
        char hbuf[MAX_NAME * 4];

        sym->nvars = 0;
        g_nscope = 0;
        g_body_abs = 0;
        g_body_pre = 0;
        sym->ntraits = 0;
        sym->nstructs = 0;
        sym->nfuncs = 0;

        header_path(outc, hbuf, sizeof hbuf);
        g_path = in;
        g_src = read_file(in, &g_len);

        self->out = fopen(outc, "w");
        if (!self->out) { fprintf(stderr, "ctc: cannot write '%s'\n", outc); return 1; }
        self->hout = fopen(hbuf, "w");
        if (!self->hout) { fprintf(stderr, "ctc: cannot write '%s'\n", hbuf); fclose(self->out); return 1; }

        self->write_guard(hbuf);

        /* provenance banner: the generated C is a build product, not a source file */
        fprintf(self->out, "/* Generated by ctc v%s from %s -- do not edit; "
                       "change the .ct and re-run ctc. */\n"
                       "/* Generated output is not covered by the GPL and may be "
                       "used without restriction (LICENSE.EXCEPTION). */\n",
                CTC_VERSION, g_path);

        self->compile_range(sym, 0, g_len);

        fprintf(self->hout, "\n#endif /* %s */\n", g_guard);

        fclose(self->out);
        fclose(self->hout);
        return 0;
    }

    /* Emit an impl method body. `self` is registered as a pointer to `S` and the
       method's parameters are registered, then every line runs through the same
       pipeline as top-level code; only the identifier `self` is renamed to `_self`. */
    void emit_body(struct SymTab *sym, FILE *f, size_t bstart, size_t blen, const Struct *S, const char *params) {
        size_t i, j, n = blen;
        int minind = 1 << 30;
        size_t *ls, *le;
        int nlines = 0, first = -1, last = -1, k;
        int saved_nvars = sym->nvars, saved_nscope = g_nscope;
        /* the body reuses the shared var table from index 0, so snapshot the
           enclosing file-scope entries and put them back on the way out; restoring
           only the count would leave the outer registrations clobbered */
        Var *saved_vars = xmalloc(sizeof(Var) * (saved_nvars ? (size_t)saved_nvars : 1));
        memcpy(saved_vars, sym->vars, sizeof(Var) * (size_t)saved_nvars);
        size_t saved_body_abs = g_body_abs;
        int saved_body_pre = g_body_pre;
        size_t saved_line_off = g_line_off;
        int vi;

        ls = xmalloc(sizeof(size_t) * (n + 2));
        le = xmalloc(sizeof(size_t) * (n + 2));

        i = 0;
        while (i < n) {
            j = i;
            while (j < n && g_src[bstart + j] != '\n') j++;
            ls[nlines] = bstart + i;
            le[nlines] = bstart + j;
            nlines++;
            i = j + 1;
            if (j >= n) break;
        }

        for (k = 0; k < nlines; k++) {
            size_t t = ls[k];
            while (t < le[k] && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t < le[k]) {
                int ind = (int)(t - ls[k]);
                if (ind < minind) minind = ind;
                if (first < 0) first = k;
                last = k;
            }
        }

        if (first < 0) { free(ls); free(le); return; }

        /* the body sees only its own locals, never the surrounding file scope */
        sym->nvars = 0;
        g_nscope = 0;
        g_body_abs = 0;
        vi = sym->new_var();
        snprintf(sym->vars[vi].name, MAX_NAME, "self");
        sym->vars[vi].s = (int)(S - sym->structs);
        sym->vars[vi].ptr = 1;
        self->register_body_params(sym, params);

        for (k = first; k <= last; k++) {
            size_t t = ls[k], content;
            char *line, *out;
            Buf sb;

            g_line_off = ls[k];

            while (t < le[k] && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t >= le[k]) { fputc('\n', f); self->scope_track(sym, ls[k], le[k]); continue; }

            content = ls[k] + (size_t)minind;
            line = xstrndup(g_src + content, le[k] - content);
            out = self->transform_line(sym, line);
            buf_init(&sb);
            self->replace_self(out, strlen(out), &sb);
            {
                size_t p2 = 0;
                while (p2 < sb.n) {
                    size_t q2 = p2;
                    while (q2 < sb.n && sb.p[q2] != '\n') q2++;
                    fputs("    ", f);
                    fwrite(sb.p + p2, 1, q2 - p2, f);
                    fputc('\n', f);
                    p2 = (q2 < sb.n) ? q2 + 1 : q2;
                }
            }
            free(line);
            free(out);
            free(sb.p);
            self->scope_track(sym, ls[k], le[k]);
        }

        memcpy(sym->vars, saved_vars, sizeof(Var) * (size_t)saved_nvars);
        free(saved_vars);
        sym->nvars = saved_nvars;
        g_nscope = saved_nscope;
        g_body_abs = saved_body_abs;
        g_body_pre = saved_body_pre;
        g_line_off = saved_line_off;
        free(ls);
        free(le);
    }

    /* Register the impl method's parameters that are declared with a known struct
       type, so calls on them dispatch inside the body like top-level parameters do. */
    void register_body_params(struct SymTab *sym, const char *params) {
        const char *p = params;
        (void)self;  /* the body only reads the symbol table, not the receiver */
        while (p && *p) {
            const char *c = strchr(p, ',');
            const char *end = c ? c : p + strlen(p);
            char piece[MAX_PARAM];
            char name[MAX_NAME];
            const char *q;
            Struct *ST;
            size_t plen = (size_t)(end - p), nk;

            if (plen >= sizeof piece) plen = sizeof piece - 1;
            memcpy(piece, p, plen);
            piece[plen] = 0;
            trim(piece);

            q = piece;
            while (*q == ' ' || *q == '\t') q++;
            if (strncmp(q, "struct", 6) == 0 && !is_ident_char((unsigned char)q[6])) {
                q += 6;
                while (*q == ' ' || *q == '\t') q++;
            }
            nk = copy_ident(q, name, 0);
            name[nk] = 0;
            q += nk;
            ST = nk ? sym->find_struct(name) : NULL;
            if (ST) {
                int isptr = 0;
                while (*q == ' ' || *q == '\t') q++;
                if (*q == '*') {
                    isptr = 1;
                    while (*q == '*' || *q == ' ' || *q == '\t') q++;
                }
                if (is_ident_char((unsigned char)*q) && !isdigit((unsigned char)*q)) {
                    char pv[MAX_NAME];
                    int pk = copy_ident(q, pv, 0);
                    pv[pk] = 0;
                    if (pk) {
                        int vi = sym->new_var();
                        snprintf(sym->vars[vi].name, MAX_NAME, "%s", pv);
                        sym->vars[vi].s = (int)(ST - sym->structs);
                        sym->vars[vi].ptr = isptr;
                    }
                }
            }
            p = c ? c + 1 : end;
        }
    }

    /* `self` -> `_self` for one line. Strings and comments are copied verbatim, and
       a member literally named `self` (e.g. `g.self`) is not the implicit receiver. */
    void replace_self(const char *s, size_t n, Buf *out) {
        size_t i = 0;
        (void)self;  /* a pure string rewrite; the receiver is not used */
        while (i < n) {
            char c = s[i];
            if (c == '"' || c == '\'') {
                size_t j = line_literal_end(s, i, n);
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (c == '/' && i + 1 < n && (s[i + 1] == '/' || s[i + 1] == '*')) {
                size_t j;
                if (s[i + 1] == '/') {
                    j = n;
                } else {
                    j = i + 2;
                    while (j + 1 < n && !(s[j] == '*' && s[j + 1] == '/')) j++;
                    j = (j + 1 < n) ? j + 2 : n;
                }
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (is_ident_char((unsigned char)c) && !isdigit((unsigned char)c)) {
                size_t j = i;
                while (j < n && is_ident_char((unsigned char)s[j])) j++;
                if (j - i == 4 && memcmp(s + i, "self", 4) == 0 &&
                    !(i > 0 && (s[i - 1] == '.' ||
                                (s[i - 1] == '>' && i > 1 && s[i - 2] == '-'))))
                    buf_puts(out, "_self");
                else
                    buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            buf_putc(out, c);
            i++;
        }
    }

    char *transform_line(struct SymTab *sym, const char *line) {
        char *decl;
        const char *base;
        Buf out;
        char *res;
        const char *q = line;

        while (*q == ' ' || *q == '\t') q++;
        if (strncmp(q, "delete", 6) == 0 && !is_ident_char((unsigned char)q[6])) {
            const char *d = q + 6;
            while (*d == ' ' || *d == '\t') d++;
            if (is_ident_char((unsigned char)*d) && !isdigit((unsigned char)*d))
                die(0, "delete is not supported");
        }

        decl = self->try_var_decl(sym, line);
        base = decl ? decl : line;
        buf_init(&out);
        self->transform_calls(sym, base, &out);
        free(decl);
        res = out.p;
        return res;
    }

    /* "<Struct> x = {...};" / "struct <Struct> x = {...};" -> add struct + vptr */
    char *try_var_decl(struct SymTab *sym, const char *line) {
        size_t i = 0, ws, vk, nk;
        const char *p;
        char name[MAX_NAME], var[MAX_NAME];
        Struct *S;
        int done = 0, static_kw = 0;
        const char *rest;
        Buf b;

        while (line[i] == ' ' || line[i] == '\t') i++;
        ws = i;
        p = line + i;

        /* a leading `static` is re-emitted verbatim; the declaration underneath is
           still a ct struct object and must get its vptr written like any other */
        if (strncmp(p, "static", 6) == 0 && !is_ident_char((unsigned char)p[6])) {
            const char *z = p + 6;
            while (*z == ' ' || *z == '\t') z++;
            static_kw = 1;
            p = z;
        }

        if (strncmp(p, "struct", 6) == 0 && !is_ident_char((unsigned char)p[6])) {
            p += 6;
            while (*p == ' ' || *p == '\t') p++;
        }

        nk = copy_ident(p, name, 0);
        name[nk] = 0;
        if (!nk) return NULL;
        p += nk;
        S = sym->find_struct(name);
        if (!S) {
            if (sym->find_trait(name))
                die(0, "interface values are not supported");
            return NULL;
        }
        while (*p == ' ' || *p == '\t') p++;

        if (*p == '*') {                              /* pointer declaration */
            const char *q = p;
            char pv[MAX_NAME];
            int pk = 0;
            while (*q == '*' || *q == ' ' || *q == '\t') q++;
            pk = copy_ident(q, pv, 0);
            pv[pk] = 0;
            {
                const char *eq = strchr(p, '=');
                const char *aft = q + pk;
                if (eq) {
                    const char *rhs = eq + 1;
                    while (*rhs == ' ' || *rhs == '\t') rhs++;
                    if ((strncmp(rhs, "malloc", 6) == 0 && !is_ident_char((unsigned char)rhs[6])) ||
                        (strncmp(rhs, "calloc", 6) == 0 && !is_ident_char((unsigned char)rhs[6])))
                        die(0, "heap creation is not supported");
                }
                while (*aft == ' ' || *aft == '\t') aft++;
                if (*aft == '[') die(0, "arrays are not supported");
            }
            if (pk) {
                int vi = sym->new_var();
                snprintf(sym->vars[vi].name, MAX_NAME, "%s", pv);
                sym->vars[vi].s = (int)(S - sym->structs);
                sym->vars[vi].ptr = 1;
            }
            buf_init(&b);
            buf_putn(&b, line, ws);
            if (static_kw) buf_puts(&b, "static ");
            buf_puts(&b, "struct ");
            buf_puts(&b, S->cname);
            buf_putc(&b, ' ');
            buf_puts(&b, p);
            return b.p;
        }

        vk = copy_ident(p, var, 0);
        var[vk] = 0;
        if (!vk) return NULL;

        rest = p + vk;

        {
            const char *q = rest;
            while (*q == ' ' || *q == '\t') q++;
            if (*q == '[') die(0, "arrays are not supported");
        }
        {
            int vi = sym->new_var();
            snprintf(sym->vars[vi].name, MAX_NAME, "%s", var);
            sym->vars[vi].s = (int)(S - sym->structs);
            sym->vars[vi].ptr = 0;
        }

        buf_init(&b);
        buf_putn(&b, line, ws);
        if (static_kw) buf_puts(&b, "static ");
        buf_puts(&b, "struct ");
        buf_puts(&b, S->cname);
        buf_putc(&b, ' ');
        buf_puts(&b, var);

        {
            const char *r = rest;
            while (*r == ' ' || *r == '\t') r++;
            if (*r == '=' && S->nu > 0) {
                const char *e = r + 1;
                while (*e == ' ' || *e == '\t') e++;
                if (*e == '{') {
                    int depth = 0;
                    const char *close = NULL;
                    size_t ln = strlen(e);
                    size_t z;
                    for (z = 0; z < ln; z++) {
                        char cc = e[z];
                        if (cc == '"' || cc == '\'') { z = line_literal_end(e, z, ln) - 1; continue; }
                        if (cc == '{') depth++;
                        else if (cc == '}') { depth--; if (!depth) { close = e + z; break; } }
                    }
                    if (close) {
                        char *inner = xstrndup(e + 1, (size_t)(close - e - 1));
                        size_t it = trim_right_len(inner, strlen(inner));
                        int first = 1;
                        buf_putn(&b, rest, (size_t)(e - rest) + 1);        /* " = {" */
                        buf_putn(&b, inner, it);
                        if (it) buf_puts(&b, ", ");
                        else buf_putc(&b, ' ');
                        self->put_own_vptr(&b, S, &first);
                        buf_putc(&b, ' ');
                        buf_puts(&b, close);
                        free(inner);
                        done = 1;
                    } else {
                        die(0, "multi-line initialisers are not supported");
                    }
                } else {
                    die(0, "unsupported initialiser for struct '%s'", S->name);
                }
            } else if (S->nu > 0 && self->decl_end_is_bare(r)) {
                /* "Person p;" has no initialiser, so give it a designated one */
                int first = 1;
                buf_puts(&b, " = { ");
                self->put_own_vptr(&b, S, &first);
                buf_puts(&b, " }");
                buf_puts(&b, rest);
                done = 1;
            }
            if (!done) buf_puts(&b, rest);
        }

        return b.p;
    }

    void transform_calls(struct SymTab *sym, const char *s, Buf *out) {
        size_t i = 0, n = strlen(s);
        while (i < n) {
            char c = s[i];

            if (c == '"' || c == '\'') {
                size_t j = line_literal_end(s, i, n);
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (c == '/' && i + 1 < n && s[i + 1] == '/') {
                buf_putn(out, s + i, n - i);
                break;
            }
            if (c == '/' && i + 1 < n && s[i + 1] == '*') {
                size_t j = i + 2;
                while (j + 1 < n && !(s[j] == '*' && s[j + 1] == '/')) j++;
                j = (j + 1 < n) ? j + 2 : n;
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (is_ident_char((unsigned char)c) && !isdigit((unsigned char)c)) {
                size_t j = i;
                char tok[MAX_NAME];
                size_t tl;
                int vi;

                while (j < n && is_ident_char((unsigned char)s[j])) j++;
                tl = j - i;
                if (tl >= sizeof tok) tl = sizeof tok - 1;
                memcpy(tok, s + i, tl);
                tok[tl] = 0;

                vi = sym->find_var(tok);

                /* a call whose result is used as a receiver needs hoisting, which
                   M2-a does not implement: report it instead of passing it through */
                if (vi < 0 && j < n && s[j] == '(') {
                    FuncSig *FS = sym->find_func(tok);
                    if (FS && FS->retstruct >= 0) {
                        size_t cp = line_match_paren(s, j, n);
                        if (cp != (size_t)-1) {
                            size_t p2 = cp + 1;
                            char mem[MAX_NAME];
                            size_t ms2, k2, ml2;
                            if (p2 + 1 < n && s[p2] == '-' && s[p2 + 1] == '>') p2 += 2;
                            else if (p2 < n && s[p2] == '.') p2 += 1;
                            else p2 = 0;
                            if (p2) {
                                ms2 = p2;
                                k2 = p2;
                                while (k2 < n && is_ident_char((unsigned char)s[k2])) k2++;
                                ml2 = k2 - ms2;
                                if (ml2 > 0 && ml2 < MAX_NAME) {
                                    memcpy(mem, s + ms2, ml2);
                                    mem[ml2] = 0;
                                    if (k2 < n && s[k2] == '(' &&
                                        sym->resolve_method(&sym->structs[FS->retstruct], mem))
                                        die(g_line_off + i, "rvalue receivers are not supported");
                                }
                            }
                        }
                    }
                }

                if (vi >= 0) {
                    char mem[MAX_NAME], low[MAX_NAME];
                    const char *tr = NULL;
                    size_t pos = j, rend = 0, mp = 0;
                    int need_amp = 1, hit = 0;
                    int isptr = sym->vars[vi].ptr;

                    hit = self->walk_method(sym, s, n, pos, sym->vars[vi].s, isptr, &need_amp,
                                            &tr, &rend, &mp, mem);
                    if (hit) {
                        size_t z = mp + 1;
                        int empty;
                        while (z < n && isspace((unsigned char)s[z])) z++;
                        empty = (z < n && s[z] == ')');

                        to_lower(tr, low);
                        buf_putn(out, s + i, rend - i);           /* receiver */
                        buf_puts(out, need_amp ? ".__" : "->__");
                        buf_puts(out, low);
                        buf_puts(out, "_vptr->");
                        buf_puts(out, mem);
                        buf_putc(out, '(');
                        if (need_amp) buf_putc(out, '&');
                        buf_putn(out, s + i, rend - i);           /* receiver again */
                        if (!empty) buf_puts(out, ", ");
                        i = mp + 1;
                        continue;
                    }
                }
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            buf_putc(out, c);
            i++;
        }
    }

    /* Follow one `.method(` / `->method(` hop from the receiver of struct `cur`
       (a pointer when `isptr`) and report the trait method it names, where the
       receiver text ends (*out_rend) and where the argument list starts (*mp).
       M2-a supports a single hop; field chains are left to a later milestone. */
    int walk_method(struct SymTab *sym, const char *s, size_t n, size_t pos, int cur, int isptr,
                    int *out_need_amp, const char **out_tr, size_t *out_rend, size_t *mp, char *memb) {
        char mem[MAX_NAME];
        size_t ms, k, ml;
        (void)self;  /* the body only consults the symbol table for the method */

        if (isptr) {
            if (!(pos + 1 < n && s[pos] == '-' && s[pos + 1] == '>')) return 0;
            k = pos + 2;
        } else {
            if (!(pos < n && s[pos] == '.')) return 0;
            k = pos + 1;
        }
        ms = k;
        while (k < n && is_ident_char((unsigned char)s[k])) k++;
        ml = k - ms;
        if (ml == 0) return 0;
        if (ml >= sizeof mem) ml = sizeof mem - 1;
        memcpy(mem, s + ms, ml);
        mem[ml] = 0;

        *out_tr = sym->resolve_method(&sym->structs[cur], mem);
        if (*out_tr && k < n && s[k] == '(') {
            *out_need_amp = !isptr;
            *out_rend = pos;
            *mp = k;
            snprintf(memb, MAX_NAME, "%s", mem);
            return 1;
        }
        return 0;
    }

    /* is the tail of a declaration nothing but ';' (optionally a trailing comment)? */
    int decl_end_is_bare(const char *s) {
        (void)self;  /* a pure string test; the receiver is not used */
        while (*s == ' ' || *s == '\t') s++;
        if (*s != ';') return 0;
        s++;
        for (;;) {
            while (*s == ' ' || *s == '\t') s++;
            if (!*s) return 1;
            if (s[0] == '/' && s[1] == '/') return 1;
            if (s[0] == '/' && s[1] == '*') {
                const char *e = strstr(s + 2, "*/");
                if (!e) return 1;
                s = e + 2;
                continue;
            }
            return 0;
        }
    }

    /* roll sym->nvars back at every closing brace so locals stay in their own scope;
       string and comment contents are ignored */
    void scope_track(struct SymTab *sym, size_t ls, size_t le) {
        size_t p = ls;
        (void)self;  /* the body tracks the symbol table, not the receiver */
        while (p < le) {
            char c = g_src[p];
            if (c == '"' || c == '\'') {
                size_t j = skip_literal(p);
                p = (j > le) ? le : j;
                continue;
            }
            if (c == '/' && p + 1 < le &&
                (g_src[p + 1] == '/' || g_src[p + 1] == '*')) {
                size_t j = skip_comment(p);
                p = (j > le) ? le : j;
                continue;
            }
            if (c == '{') {
                int save = sym->nvars;
                if (g_body_abs && p == g_body_abs) { save = g_body_pre; g_body_abs = 0; }
                if (g_nscope >= MAX_SCOPE) die(p, "too many nested scopes (max %d)", MAX_SCOPE);
                g_scope[g_nscope++] = save;
            } else if (c == '}') {
                if (g_nscope > 0)
                    sym->nvars = g_scope[--g_nscope];
            }
            p++;
        }
    }

    /* Ordinary function definition or prototype: qualify the struct types in its
       return type and parameters, record the signature, and register the parameters
       when a body follows. Returns a new line, or NULL when `line` is not one. */
    char *parse_func_sig(struct SymTab *sym, const char *line, size_t ls, int *has_body, size_t *body_abs) {
        size_t n = strlen(line), lpo, he, ns, rt, rp, i, end;
        const char *lp;
        char name[MAX_NAME], tok[MAX_NAME];
        Buf b;
        int isdef = 0, ret_tr = -1, ret_ia = -1, ret_ib = -1, ret_ns = 0;
        int ret_struct = -1, ret_rptr = 0;
        char ret_cbase[MAX_NAME];
        (void)self;  /* the body records signatures in the symbol table, not the receiver */

        *has_body = 0;
        *body_abs = 0;

        lp = strchr(line, '(');
        if (!lp) return NULL;
        lpo = (size_t)(lp - line);
        {
            const char *sc = strchr(line, ';');
            if (sc && (size_t)(sc - line) < lpo) return NULL;      /* ';' before '(' */
        }

        he = trim_right_len(line, lpo);
        ns = he;
        while (ns > 0 && is_ident_char((unsigned char)line[ns - 1])) ns--;
        if (ns == he) return NULL;                                 /* no function name */
        rt = trim_right_len(line, ns);
        if (rt == 0) return NULL;                                  /* no return type */

        {
            size_t k, u;
            for (k = 0; k < rt; k++) {
                char c = line[k];
                if (!(is_ident_char((unsigned char)c) || c == '*' || c == ' ' || c == '\t'))
                    return NULL;
            }
            snprintf(name, sizeof name, "%.*s", (int)(he - ns), line + ns);
            if (is_stmt_keyword(name)) return NULL;
            for (k = 0; k < rt; ) {
                u = k;
                while (u < rt && !is_ident_char((unsigned char)line[u])) u++;
                k = u;
                while (k < rt && is_ident_char((unsigned char)line[k])) k++;
                if (k > u) {
                    size_t tl = k - u;
                    if (tl >= sizeof tok) tl = sizeof tok - 1;
                    memcpy(tok, line + u, tl);
                    tok[tl] = 0;
                    if (is_stmt_keyword(tok)) return NULL;
                }
            }
        }

        rp = line_match_paren(line, lpo, n);
        if (rp == (size_t)-1) return NULL;                         /* ')' on another line */

        {
            size_t k = skip_ws_comments(ls + rp + 1);
            if (k < g_len && g_src[k] == '{') { isdef = 1; *has_body = 1; *body_abs = k; }
            else if (k < g_len && g_src[k] == ';') { isdef = 0; }
            else return NULL;
        }

        {
            char rname[MAX_NAME];
            ret_struct = self->analyse_param(sym, line, rt, &ret_ia, &ret_ib, ret_cbase,
                                             &ret_ns, rname, &ret_rptr, &ret_tr);
        }
        if (ret_tr >= 0) die(ls, "interface return types are not supported");

        buf_init(&b);
        self->emit_qualified_type(&b, line, lpo, ret_ia, ret_ib, ret_cbase, ret_ns, 0);
        buf_putc(&b, '(');

        for (i = lpo + 1, end = rp; i < end; ) {
            size_t j = i;
            int depth = 0, pia = -1, pib = -1, pns = 0, ptr = 0, sidx, ptrtr = -1;
            char pname[MAX_NAME], pcbase[MAX_NAME];

            while (j < end) {
                char c = line[j];
                if (c == '"' || c == '\'') { j = line_literal_end(line, j, end); continue; }
                if (c == '(' || c == '[' || c == '{') depth++;
                else if (c == ')' || c == ']' || c == '}') depth--;
                else if (c == ',' && depth == 0) break;
                j++;
            }
            sidx = self->analyse_param(sym, line + i, j - i, &pia, &pib, pcbase, &pns, pname, &ptr, &ptrtr);
            if (ptrtr >= 0) die(ls, "interface parameters are not supported");
            self->emit_qualified_type(&b, line + i, j - i, pia, pib, pcbase, pns, 0);

            if (isdef && pname[0] && sidx >= 0) {
                int vi = sym->new_var();
                snprintf(sym->vars[vi].name, MAX_NAME, "%s", pname);
                sym->vars[vi].s = sidx;
                sym->vars[vi].ptr = ptr;
            }
            if (j < end) { buf_putc(&b, ','); j++; }
            i = j;
        }
        /* record the signature so call sites can reject rvalue receivers */
        if (sym->nfuncs >= MAX_FUNCS) die(0, "too many functions (max %d)", MAX_FUNCS);
        {
            FuncSig *FS = &sym->funcs[sym->nfuncs++];
            snprintf(FS->name, MAX_NAME, "%s", name);
            FS->retstruct = (ret_tr >= 0) ? -1 : ret_struct;
            FS->retptr = (ret_tr >= 0) ? 0 : ret_rptr;
        }

        buf_putc(&b, ')');
        buf_puts(&b, line + rp + 1);
        return b.p;
    }
}

static Pipe g_pipe = { };

/* ------------------------------------------------ raw line rewriting */

static size_t line_literal_end(const char *s, size_t i, size_t n)
{
    char q = s[i++];
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) { i += 2; continue; }
        if (s[i] == q) return i + 1;
        i++;
    }
    return n;
}

static size_t line_match_paren(const char *s, size_t k, size_t n)
{
    int depth = 0;
    while (k < n) {
        char c = s[k];
        if (c == '"' || c == '\'') { k = line_literal_end(s, k, n); continue; }
        if (c == '(') depth++;
        else if (c == ')') { depth--; if (!depth) return k; }
        k++;
    }
    return (size_t)-1;
}

/* ------------------------------------------------------------------ main */

static void usage(const char *prog)
{
    fprintf(stderr,
            "usage: %s <input.ct> [-o <output.c>]\n\n"
            "L1 (M2-a): compiles a subset of C-with-traits (.ct) into plain C,\n"
            "writing <output.c> and a matching header <output.h>. If -o is\n"
            "omitted the output is <input>.c next to the input.\n\n"
            "  -o <file>       write the generated C to <file>\n"
            "  -v, --version   print the compiler version and exit\n"
            "  -h, --help      print this help and exit\n",
            prog);
}

static void default_output(const char *in, char *out, size_t n)
{
    size_t l = strlen(in);
    if (l > 3 && strcmp(in + l - 3, ".ct") == 0) {
        snprintf(out, n, "%.*s.c", (int)(l - 3), in);
    } else {
        snprintf(out, n, "%s.c", in);
    }
}

static void header_path(const char *outc, char *out, size_t n)
{
    size_t l = strlen(outc);
    if (l > 2 && strcmp(outc + l - 2, ".c") == 0) {
        snprintf(out, n, "%.*s.h", (int)(l - 2), outc);
    } else {
        snprintf(out, n, "%s.h", outc);
    }
}

static char *read_file(const char *path, size_t *out_len)
{
    FILE *f = fopen(path, "rb");
    long sz;
    char *buf;

    if (!f) { fprintf(stderr, "ctc: cannot open '%s'\n", path); exit(1); }
    fseek(f, 0, SEEK_END);
    sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (sz < 0) { fprintf(stderr, "ctc: cannot read '%s'\n", path); exit(1); }

    buf = xmalloc((size_t)sz + 1);
    if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
        fprintf(stderr, "ctc: short read on '%s'\n", path);
        exit(1);
    }
    buf[sz] = 0;
    fclose(f);

    /* normalise CRLF / lone CR */
    {
        size_t i = 0, j = 0;
        while (i < (size_t)sz) {
            if (buf[i] == '\r') {
                if (i + 1 < (size_t)sz && buf[i + 1] == '\n') i++;
                buf[j++] = '\n';
                i++;
            } else {
                buf[j++] = buf[i++];
            }
        }
        buf[j] = 0;
        *out_len = j;
    }
    return buf;
}

int main(int argc, char **argv)
{
    const char *in = NULL, *outc = NULL;
    char outbuf[MAX_NAME * 4];
    int i;

    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
            usage(argv[0]);
            return 0;
        }
        if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
            printf("ctc v%s\n", CTC_VERSION);
            return 0;
        }
        if (strcmp(argv[i], "-o") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: -o needs an argument\n"); return 1; }
            outc = argv[++i];
            continue;
        }
        if (argv[i][0] == '-' && argv[i][1]) {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
            usage(argv[0]);
            return 1;
        }
        in = argv[i];
    }

    if (!in) { usage(argv[0]); return 1; }
    if (!outc) { default_output(in, outbuf, sizeof outbuf); outc = outbuf; }
    return g_pipe.compile_file(&g_sym, in, outc);
}
