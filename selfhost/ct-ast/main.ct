/*
 * main.ct - the ct-ast compiler: binding and dispatch only.
 *
 * Every stage lives in its own unit: the lexer, the parser (with the
 * expression, statement and `map` sub-objects), the symbol tables, the type
 * layer, the memory pass, the module/build driver, the incremental cache, the
 * package manager and the emitter. This file binds those collaborators once and
 * hands control to `tool::driver`.
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one dispatch per
 * concern). Symbol tables follow D33: functions, variables and types are
 * separate flat tables; only variables are scoped. Output contract: banner,
 * `<base>.h` guard and a self-contained `.c` (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
import backend::emit::Emit;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Map;
import frontend::module::Module;
import frontend::module::Unit;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import tool::cache::Cache;
import tool::diag::diag;
import tool::driver::driver;
import tool::pkg::pkg;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define CTC_VERSION "0.12.0"

/* Caps, node kinds and token/operator codes are declared by the unit that uses
   them: a macro spans one translation unit only, and every unit here compiles
   to its own `.c`. This entry file needs nothing but the version. */

int main(int argc, char **argv)
{
    const char *base;
    struct Arena *arena;
    struct Lexer *lex;
    struct Cache *cache;
    struct Symbols *sym;
    struct Memory *mem;
    struct TypeCheck *ty;
    struct Module *m;
    struct Parser *p;

    /* the node and literal pools live in runtime::arena; point the object at its
       singleton before anything can build a node. Every facade call here is
       qualified: the entry file is at the root, and a bare call would have to
       fall back to "the only row with that name". */
    arena = runtime::arena::arena_get();
    /* likewise the source cursor and the current token */
    lex = frontend::lex::lexer_get();
    /* the cache keys carry the compiler version; seed it once here */
    cache = tool::cache::cache_get();
    cache->version = CTC_VERSION;
    /* the symbol tables live in frontend::sym; point the object at its singleton */
    sym = frontend::sym::symbols_get();
    /* the memory analysis (backend::mem) reads both through the driver */
    mem = backend::mem::memory_get();
    mem->arena = arena;
    mem->sym = sym;
    /* static typing and boxing (frontend::type) read the same tables */
    ty = frontend::type::type_get();
    ty->arena = arena;
    ty->sym = sym;
    ty->lex = lex;
    /* the module driver (frontend::module) owns the unit table and the run
       options; seed the options the struct does not zero-init: `prog` (the entry
       name `-v` and the usage lines print) and the version (the banner and the
       cache key). */
    m = frontend::module::module_get();
    m->prog = "ct-ast";
    m->line_force = -1;
    m->std_flag = "-std=c99";
    m->version = CTC_VERSION;
    /* the parser (frontend::parse) reads the same collaborators; bind it once
       they are all in place so its own support object is wired too */
    p = frontend::parse::parse_get();
    frontend::parse::ct_parse_bind(arena, lex, sym, ty, mem, &m->build_mode);
    ty->maps = p->maps;
    ty->nmaps = &p->nmaps;
    /* the module driver draws on the same collaborators; wire it once they are
       all in place. It owns the unit table and the options the emitter reads. */
    frontend::module::ct_module_bind(arena, lex, sym, ty, mem, p, cache);

    base = strrchr(argv[0], '/');
    base = base ? base + 1 : argv[0];
    if (strcmp(base, "ct") == 0) m->prog = "ct";
    else if (strcmp(base, "ctc") == 0) m->prog = "ctc";
    /* the emitter (backend::emit) reads the same collaborators, the module
       tables, the options and the version; `out`/`path` follow through the
       setters as the driver re-points them. Bind after the entry-name branch
       because `prog` is part of the wired state. */
    backend::emit::ct_emit_bind(arena, sym, ty, lex, CTC_VERSION, m->outdir, m->prog);
    backend::emit::ct_emit_bind_tables(m->units, &m->nunits, p->maps, &p->nmaps, p->calls, &p->ncalls, &m->build_mode, &m->line_mode);
    backend::emit::ct_emit_bind_parse(&p->nparams, p->pend_fields, &p->npend);
    /* the compile-mode driver (tool::driver) holds the output sink and the
       collaborators of one run; bind it once they are all in place. */
    tool::driver::ct_driver_bind(arena, lex, sym, mem, m, p, CTC_VERSION);
    /* Phase 8 (ported in 10.6): the package subcommands live in their own unit
       and never reach the compile core; only primitives cross the boundary */
    if (argc > 1 && strcmp(argv[1], "get") == 0)
        return tool::pkg::ct_pkg_get(argc - 2, argv + 2, m->prog, CTC_VERSION);
    if (argc > 1 && strcmp(argv[1], "install") == 0)
        return tool::pkg::ct_pkg_install(argc - 2, argv + 2, m->prog, CTC_VERSION);
    return tool::driver::ct_driver_run(argc, argv);
}
