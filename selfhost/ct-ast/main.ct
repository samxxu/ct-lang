/*
 * main.ct - Phase 9: the AST compiler.
 *
 * 9.1 proved the pipe (lexer -> parser -> AST -> C). 9.2 added statements,
 * control flow and signatures. 9.3 added the declaration layer, 9.4 traits and
 * interface values, and 9.5a the module layer:
 *
 *   - `build` mode: one `.c` + `.h` per unit, imports resolved recursively
 *   - `import a::b;` (the importing file's directory first, then `-I` roots)
 *   - `pub` routing: exported traits/structs/typedefs/prototypes land in `.h`
 *   - `namespace A::B { ... }` plus `--ns-root` directory validation
 *   - metadata: `#line` (`--line` / `--no-line`) and `--emit-map`
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one dispatch per
 * concern). Symbol tables follow D33: functions, variables and types are
 * separate flat tables; only variables are scoped.
 *
 * Output contract: banner, `<base>.h` guard and a self-contained `.c`; byte
 * equality with the old pipeline is not required (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
import tool::pkg::pkg;
import tool::diag::diag;
import runtime::arena::arena;
import frontend::lex::lexer;
import frontend::module::unit;
import frontend::module::map;
import frontend::sym::sym;
import frontend::type::type;
import tool::cache::cache;
import backend::mem::mem;
import backend::emit::emit;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
/* the incremental cache stamps each unit with `stat` and creates `.ctcache`
   with `mkdir` (Phase 6.3, ported in 10.5) */
#include <sys/stat.h>

#define CTC_VERSION "0.12.0"

/* Capacity: the caps below were sized for the Phase 0 corpus; the old user-facing
   numbers (16 traits, 32 structs, 64 functions) stopped real programs. They stay
   fixed-size -- overflow is still a hard error -- but the numbers no longer bind.
   The node pool and the string-literal pool moved to `runtime::arena`, so their
   caps (65536 nodes, 256 KiB of literals) live on that class now. */
#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_FUNCS  256
#define MAX_PARAMS 16
#define MAX_VARS   4096
#define MAX_SCOPE  256
#define MAX_TYPES  256
#define MAX_TRAITS 64
#define MAX_METHODS 64
#define MAX_STRUCTS 128
#define MAX_FIELDS 64
#define MAX_UNITS  64
#define MAX_IMPORTS 16
#define MAX_INCDIRS 16
#define MAX_CALLS  1024
#define MAX_MAPS   64
#define MAX_ERRORS 20                   /* recovery cap: past this the compiler stops */
#define MAX_KEY    768                  /* one unit's incremental-cache key */
#define MAX_IH     2560                 /* MAX_IMPORTS * MAX_TEXT, spelled out */
/* the package manager (Phase 8, ported in 10.6) */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   512
#define MAX_PKG_DEPTH  8
#define MAX_PKG_CMD    2048
#define MAX_LOCK       4096             /* MAX_PKG_PATH * 8, spelled out */
#define MAX_PKG_LINE   1024             /* MAX_PKG_PATH * 2, spelled out */

/* node kinds (D32: one tag, one dispatch) */
#define N_PROG    1
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_PARAM   19
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_METHOD  29
#define N_MCALL   30
#define N_RAW     31
#define N_TRAIT   32
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41

/* token kinds */
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

/* binary operators (stored in `aux`) */
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13
#define B_XOR 14

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define P_INC 1
#define P_DEC 2

/* `parse_func` returns this when the declaration was a prototype (no node). */
#define NO_NODE (-2)

/* `Node` and the two pools now live in `runtime::arena`; this unit holds a
   pointer to the arena singleton and works through it. */

/* `Fn`, `Var`, `MethodSig`, `Trait`, `Field` and `StructDef` now live in
   `frontend::sym`; this unit holds a pointer to that singleton and works
   through it. */

/* One translation unit of a `build` is a value type of the module layer; see
   frontend/module/unit.h.ct. The caps its fields need stay in this unit's
   MAX_* list too, because the driver sizes the table and spells the same
   numbers. */

/* The `map` records and the call-graph edge are value types of the module
   layer; see frontend/module/map.h.ct. */

/* An rvalue receiver (`f().m()`) is hoisted into a temp so the call is
   evaluated once; the declarations are flushed before the statement. */
#define MAX_HOISTS 4

/* The entry name and the run options live on the `Ast` object now; see the
   fields below. `main` seeds the defaults before dispatching. */

/* Collected warnings and the semantic-error counter live in diag.ct; this unit
   only reaches them through the primitive wrappers declared there. */

/* AutoDrop (Phase 5, landed here in 10.3) and the leak analysis (10.3) keep
   their state on the `Ast` object: every scope records where its `own`
   declarations start, and the leak pass runs only while a function or method
   body is being parsed. See the fields below. */

trait AstOps {
    int  new_node(int kind);
    int  fail(const char *msg);
    void lex_next(void);
    int  accept(const char *p);
    int  expect(const char *p);
    int  read_file(const char *path);
    int  default_output(const char *in, char *out, size_t cap);
    int  run(int argc, char **argv);
}

trait SymOps {
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name, const char *type);
    int  find_var(const char *name);
    int  var_type(const char *name, char *out, size_t cap);
    int  find_func(const char *name);
    int  add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param);
    int  find_type(const char *name);
    int  add_type(const char *name, int kind);
    int  find_struct(const char *name);
    int  add_struct(const char *name);
    int  find_trait(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, size_t tcap);
    int  ns_decl_name(const char *name, char *out, size_t cap);
    int  resolve_type(const char *name, char *out, size_t cap);
    int  record_call(const char *callee, int line);
}

trait ParseOps {
    int  is_type_word(const char *w);
    int  type_append(char *out, size_t cap, size_t *n, const char *tok);
    int  parse_type(char *out, size_t cap);
    int  parse_array_dims(int n);
    int  next_is_type_name(void);
    int  parse_program(void);
    int  parse_func(int is_static, int is_pub);
    int  parse_params(void);
    int  parse_struct_def(void);
    int  parse_typedef(int is_pub);
    int  parse_field_def(void);
    int  parse_block(void);
    int  parse_stmt(void);
    int  parse_branch(void);
    int  parse_decl_node(void);
    int  parse_expr_stmt_node(void);
    int  parse_expr(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  parse_trait(int is_pub);
    int  parse_impl(void);
    int  parse_use_list(int sindex);
    int  parse_init_raw(char *out, size_t cap);
}

/* Static type queries and boxing. Split out of ParseOps: none of this is
   parsing, and ParseOps already sits at MAX_METHOD. */
trait TypeOps {
    int  is_iface_type(const char *type, char *tout, size_t tcap);
    int  iface_ref_type(const char *type, char *tout, size_t tcap, int *is_ptr);
    int  concrete_struct(const char *type, char *sout, size_t scap, int *is_ptr);
    int  expr_type(int n, char *out, size_t cap);
    int  maybe_box(int n, const char *trait, int addr);
    int  type_has_array_init(const char *type);
    int  init_item_text(const char *stype, const char *item, char *out, size_t cap);
    int  rewrite_init_text(const char *stype, const char *raw, char *out, size_t cap);
}

/* Driver plumbing: build-mode loading (paths, import resolution, unit loading,
   the namespace/directory check) and the facade onto the emitter, the output
   side of the same driver. Kept apart from ParseOps to leave the parser room to
   grow under MAX_METHOD. The emitter facade lives here rather than in a trait of
   its own because L2, which still builds this tree, caps the whole build at 16
   traits and the other units already use all sixteen. */
trait ModuleOps {
    int  base_name(const char *path, char *out, size_t cap, int *is_hdr);
    int  path_dir(const char *path, char *out, size_t cap);
    int  append_node(int prog, int n);
    int  skip_import(void);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr);
    int  load_unit(const char *path);
    int  check_ns_dir(int u);
    int  parse_top_decl(int is_pub);
    int  parse_namespace(int prog);
    int  parse_map(void);
    int  map_check_call(const struct frontend_module_MapBind *b, const char *inst);
    int  struct_def_ahead(void);
    int  cache_order(int u, int *state, int *order, int *n);
    int  cache_key_of(int u, char *out, int cap);
    int  build_main(int argc, char **argv);
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  write_header(const char *outc);
    int  write_map(const char *dest, int prog, int u);
}

/* Error recovery (Phase 10.4). A separate trait because `ParseOps` is at the
   MAX_METHOD ceiling and these are not parsing concerns. Everything that
   *stores* a diagnostic lives in diag.ct now. */
trait RecoverOps {
    int  skip_body(void);
    int  skip_after_error(void);
}

/* Memory semantics (Phase 10.3): `own` registration plus the leak analysis.
   The rules are deliberately the conservative ones L2 uses (D40), so the
   warnings match its output byte for byte. */
trait MemoryOps {
    int  mark_owned(int n, int line);
    int  expr_alloc(int e);
    int  expr_mentions(int e, const char *name);
    int  expr_returns(int e, const char *name);
    int  ret_same_struct(const char *ret, int si);
    int  leak_decl(int n);
    int  leak_scope(int from, int to);
    int  leak_assign(int n);
    int  leak_return(int ret, int conditional, int line);
    int  leak_delete(int e);
    int  warn_leak(int vi, int path_line);
}

/* The incremental build cache is an object of its own (tool/cache); the driver
   only hands it the unit table and the run's options. */


/* The struct carries the output, lexer and memory-analysis state so those
   methods are real OO methods on the object rather than free functions over
   file-scope globals; the tables still on it move out slice by slice. */
struct Ast {
    int nerr;
    /* Output state for one run: where emitted C goes, the source path the banner
       and diagnostics report, and the last parse/run error message. The driver
       re-points `path` for each unit in build mode. */
    FILE *out;
    const char *path;
    char errmsg[MAX_TEXT];
    /* The node pool and the literal pool live in runtime::arena; the driver
       points this at that singleton before it dispatches to `run`. */
    struct runtime_arena_Arena *arena;
    /* The incremental cache (tool::cache) and its version stamp. */
    struct tool_cache_Cache *cache;
    /* The source cursor and the current token live in frontend::lex; the driver
       points this at that singleton before it dispatches to `run`. */
    struct frontend_lex_Lexer *lex;
    /* The symbol tables of the unit being compiled live in frontend::sym; the
       driver points this at that singleton before it dispatches to `run`. */
    struct frontend_sym_Symbols *sym;
    /* Build mode: the unit table, the import search roots and the namespace
       path declared by the current unit, plus the calls and maps collected for
       the JSON map. The driver fills these before a build and reads them while
       emitting. */
    struct frontend_module_Unit units[MAX_UNITS];
    int  nunits;
    int  build_mode;
    char ns_decl[MAX_TEXT];     /* namespace path declared by the current unit */
    char outdir[MAX_PATH];
    const char *incdirs[MAX_INCDIRS];
    int  ninc;
    const char *nsroot;
    char rels[MAX_IMPORTS][MAX_TEXT];  /* import paths seen by the scanner */
    int  nrels;
    struct frontend_module_Call calls[MAX_CALLS];
    int  ncalls;
    struct frontend_module_Map maps[MAX_MAPS];
    int  nmaps;
    char cur_func[MAX_TEXT];    /* caller recorded for the map */
    /* Run options. `prog` is the entry name `-v` and the usage lines print
       (D44): `ct` when installed under that name, `ctc` for the compatibility
       alias, `ct-ast` for the development binary. Driver diagnostics keep the
       published `ctc:` prefix (SH-3 / phase10 non-goal), so logs and assertions
       do not move when the entry name changes. */
    int  line_mode;             /* emit `#line`: 0 off, 1 on */
    int  line_force;            /* -1 mode default, 0 --no-line, 1 --line */
    char map_path[MAX_PATH];
    int  have_map;
    const char *prog;
    int  diag_json;             /* --diagnostics=json */
    const char *std_flag;       /* --std=c99 | --std=gnu99 */
    /* Parse-time scratch: the parameter count of the signature being parsed and
       the fields of an untagged `typedef struct { ... }` (attached by
       parse_typedef). The emitter only sees them through pointers. */
    int  nparams;
    struct frontend_sym_Field pend_fields[MAX_FIELDS];
    int  npend;
    /* AutoDrop and the leak analysis live in backend::mem; the driver wires its
       arena, symbol table and path before it dispatches to `run`. */
    struct backend_mem_Memory *mem;
    /* Type inference and the boxing decision live in frontend::type; the driver
       wires the arena, the symbol table, the map table, its count and the lexer. */
    struct frontend_type_TypeCheck *ty;
} use AstOps, SymOps, ParseOps, TypeOps, ModuleOps, RecoverOps, MemoryOps;

impl AstOps for Ast {
    /* The pool owns the storage and the reset of a fresh node; the line number
       comes from the lexer and the overflow diagnostic from this object, so both
       stay here. */
    int new_node(int kind)
    {
        int n = self->arena->alloc(kind, self->lex->tokline);
        if (n < 0) return self->fail("too many AST nodes");
        return n;
    }

    int fail(const char *msg)
    {
        (void)self;
        /* the line and the offending token are the two things a self-hosting
           run needs to locate a gap; diagnostics are not compared (D34) */
        if (!self->errmsg[0])
            snprintf(self->errmsg, sizeof self->errmsg, "line %d: %s (at '%s')", self->lex->tokline, msg, self->lex->toktext);
        return -1;
    }

    /* The characters are frontend::lex's business; the parser only asks for the
       next token. */
    void lex_next(void)
    {
        (void)self;
        self->lex->next();
    }

    int accept(const char *p)
    {
        (void)self;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, p) == 0) {
            self->lex_next();
            return 1;
        }
        return 0;
    }

    int expect(const char *p)
    {
        (void)self;
        if (self->accept(p)) return 0;
        return self->fail("unexpected token");
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        (void)self;
        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        self->lex->src = buf;
        return 0;
    }

    int default_output(const char *in, char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0) {
            if (snprintf(out, cap, "%.*s.c", (int)(n - 3), in) >= (int)cap) return -1;
            return 0;
        }
        if (snprintf(out, cap, "%s.c", in) >= (int)cap) return -1;
        return 0;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        const char *out;
        char outbuf[MAX_PATH];
        int i, prog;
        FILE *f;

        in = NULL;
        out = NULL;
        if (argc > 1 && strcmp(argv[1], "build") == 0)
            return self->build_main(argc - 1, argv + 1);
        self->build_mode = 0;
        self->line_mode = 0;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s <input.ct> [-o <output.c>] [-I <dir>] [--line|--no-line]\n"
                       "              [--emit-map <file|->] [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s get <spec>[@<range>]\n"
                       "       %s install\n",
                       self->prog, self->prog, self->prog, self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, CTC_VERSION);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;   /* accepted for CLI parity; compile mode resolves no imports */
                continue;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: %s <input.ct> [-o <output.c>]\n", self->prog);
            return 1;
        }
        if (!out) {
            if (self->default_output(in, outbuf, sizeof outbuf) != 0) {
                fprintf(stderr, "ctc: output path too long\n");
                return 1;
            }
            out = outbuf;
        }

        self->path = in;
        self->mem->path = self->path;
        ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        ct_diag_reset();
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->self_mode = 0;
        self->nparams = 0;
        self->ncalls = 0;
        self->cur_func[0] = 0;
        self->errmsg[0] = 0;
        if (self->read_file(in) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        prog = self->parse_program();
        if (prog < 0) {
            if (ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", ct_diag_nsem());
                return 1;
            }
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        self->out = f;
        ct_emit_set_out(self->out);
        fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, self->path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              self->out);
        if (self->line_mode) fprintf(self->out, "#line 1 \"%s\"\n", self->path);
        if (self->emit_program(prog) != 0) {
            fclose(f);
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        if (self->write_header(out) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        if (self->have_map && self->write_map(self->map_path, prog, -1) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        if (ct_diag_emit(self->diag_json, 0) != 0) return 1;
        return 0;
    }
}

/* The tables live in frontend::sym; this facade keeps the parser's trait shape
   and wraps the reasons the tables record with the current position. */
impl SymOps for Ast {
    int push_scope(void)
    {
        if (self->sym->push_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->own_base[self->sym->nscope - 1] = self->mem->nowner;
        return 0;
    }

    int pop_scope(void)
    {
        if (self->sym->pop_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->nowner = self->mem->own_base[self->sym->nscope];
        return 0;
    }

    int declare_var(const char *name, const char *type)
    {
        if (self->sym->declare_var(name, type) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int find_var(const char *name)
    {
        return self->sym->find_var(name);
    }

    /* A miss is not an error: the parser probes names while inferring types, so
       only a recorded reason (overflow) becomes a diagnostic. */
    int var_type(const char *name, char *out, size_t cap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->var_type(name, out, (int)cap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int find_func(const char *name)
    {
        return self->sym->find_func(name);
    }

    /* A prototype followed by its definition updates the same entry. `pub` on
       either declaration exports the prototype to the unit header. */
    int add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param)
    {
        int i, k, p;

        i = self->sym->find_func(name);
        if (i < 0) {
            if (self->sym->nfunc >= MAX_FUNCS) return self->fail("too many functions");
            i = self->sym->nfunc;
            self->sym->nfunc++;
            snprintf(self->sym->funcs[i].name, MAX_TEXT, "%s", name);
            self->sym->funcs[i].is_pub = 0;
            self->sym->funcs[i].ret_owned = 0;   /* fresh row: no ownership fact yet */
        }
        if (is_pub) self->sym->funcs[i].is_pub = 1;
        snprintf(self->sym->funcs[i].ret, MAX_TEXT, "%s", ret);
        self->sym->funcs[i].is_static = is_static;
        self->sym->funcs[i].nparams = 0;
        p = first_param;
        k = 0;
        while (p > 0 && k < MAX_PARAMS) {
            snprintf(self->sym->funcs[i].ptype[k], MAX_TEXT, "%s", self->arena->nodes[p].text);
            snprintf(self->sym->funcs[i].pdim[k], MAX_TEXT, "%s", self->arena->nodes[p].text3);
            k++;
            p = self->arena->nodes[p].next;
        }
        if (k >= MAX_PARAMS && p > 0) return self->fail("too many parameters");
        self->sym->funcs[i].nparams = k;
        return i;
    }

    int find_type(const char *name)
    {
        return self->sym->find_type(name);
    }

    int add_type(const char *name, int kind)
    {
        if (self->sym->add_type(name, kind) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int find_struct(const char *name)
    {
        return self->sym->find_struct(name);
    }

    int add_struct(const char *name)
    {
        const char *why;
        int i;
        self->sym->errmsg[0] = 0;
        i = self->sym->add_struct(name);
        if (i < 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return i;
    }

    int find_trait(const char *name)
    {
        return self->sym->find_trait(name);
    }

    int add_trait(const char *name)
    {
        int i = self->sym->add_trait(name);
        if (i < 0) return self->fail(self->sym->last_error());
        return i;
    }

    /* A miss is not an error here either: the emitter tries trait methods of a
       receiver type and moves on when none matches. */
    int method_trait(const char *stype, const char *method, char *tout, size_t tcap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->method_trait(stype, method, tout, (int)tcap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int ns_decl_name(const char *name, char *out, size_t cap)
    {
        if (self->sym->ns_decl_name(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int resolve_type(const char *name, char *out, size_t cap)
    {
        if (self->sym->resolve_type(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    /* Remember `callee(...)` inside the function currently being parsed. */
    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!self->cur_func[0]) return 0;
        if (self->ncalls >= MAX_CALLS) return self->fail("too many calls");
        snprintf(self->calls[self->ncalls].caller, MAX_TEXT, "%s", self->cur_func);
        snprintf(self->calls[self->ncalls].callee, MAX_TEXT, "%s", callee);
        self->calls[self->ncalls].line = line;
        self->ncalls++;
        return 0;
    }
}

impl ParseOps for Ast {
    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "int") == 0 || strcmp(w, "void") == 0
            || strcmp(w, "char") == 0 || strcmp(w, "unsigned") == 0
            || strcmp(w, "signed") == 0 || strcmp(w, "long") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "enum") == 0
            || strcmp(w, "union") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0;
    }

    int type_append(char *out, size_t cap, size_t *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, cap - *n, "%s", tok);
        if (w < 0 || (size_t)w >= cap - *n) return self->fail("type is too long");
        *n += (size_t)w;
        return 0;
    }

    /* Consume a type specifier. `struct X` keeps the tag; a known typedef name
       is part of the type; `*` accumulates (9.3 supports a single pointer). */
    int parse_type(char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = 0;
        out[0] = 0;
        for (;;) {
            if (self->lex->tok == T_ID && self->is_type_word(self->lex->toktext)) {
                if (self->type_append(out, cap, &n, self->lex->toktext) != 0) return -1;
                if (strcmp(self->lex->toktext, "struct") == 0) {
                    char sname[MAX_TEXT];
                    self->lex_next();
                    if (self->lex->tok != T_ID) return self->fail("expected a struct name");
                    if (self->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->add_type(sname, 1) != 0) return -1;
                }
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID) {
                int ti;
                char rname[MAX_TEXT];
                char iface[MAX_TEXT];
                if (self->resolve_type(self->lex->toktext, rname, sizeof rname) != 0) return -1;
                ti = self->find_type(rname);
                if (ti < 0) break;
                /* a bare struct tag needs `struct`; a trait becomes its iface */
                if (self->sym->type_kind[ti] == 1) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                } else if (self->sym->type_kind[ti] == 3) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (snprintf(iface, sizeof iface, "%s_iface", rname) >= (int)sizeof iface)
                        return self->fail("type name is too long");
                    if (self->type_append(out, cap, &n, iface) != 0) return -1;
                    self->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->lex_next();
                continue;
            }
            break;
        }
        if (n == 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "expected a type (tok %d '%s')", self->lex->tok, self->lex->toktext);
            return self->fail(msg);
        }
        return 0;
    }

    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    int parse_array_dims(int n)
    {
        (void)self;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
            char dim[MAX_TEXT];
            char cur[MAX_TEXT];
            int unsized;
            unsized = 0;
            self->lex_next();
            if (self->lex->tok == T_NUM) {
                snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
            } else if (self->lex->tok == T_ID) {
                snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                /* `T a[][N]`: an unsized parameter dimension (10.6) */
                snprintf(dim, sizeof dim, "[]");
                unsized = 1;
            } else {
                return self->fail("expected an array length");
            }
            if (!unsized) self->lex_next();
            if (self->expect("]") != 0) return -1;
            snprintf(cur, sizeof cur, "%s%s", self->arena->nodes[n].text3, dim);
            snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cur);
            self->arena->nodes[n].num = 0;      /* text3 is the authoritative spelling */
        }
        return 0;
    }

    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->lex_next();
        res = (self->lex->tok == T_ID && (self->is_type_word(self->lex->toktext)
                                 || self->find_type(self->lex->toktext) >= 0));
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    int parse_program(void)
    {
        int prog, n, base;
        (void)self;

        prog = self->new_node(N_PROG);
        if (prog < 0) return -1;
        base = ct_diag_nsem();
        self->lex_next();
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PP) {
                n = self->new_node(N_PP);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->lex->toktext);
                if (self->append_node(prog, n) != 0) return -1;
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "import") == 0) {
                if (!self->build_mode)
                    return self->fail("'import' is not supported in compile mode");
                if (self->skip_import() != 0) return -1;
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "namespace") == 0) {
                if (self->parse_namespace(prog) != 0) return -1;
                continue;
            }
            n = self->parse_top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) {
                /* A reported error is recoverable: resynchronise and keep going
                   so one bad construct does not hide the rest of the file. A
                   parse failure without a diagnostic is still fatal. */
                if (ct_diag_nsem() == base) return -1;
                if (self->skip_after_error() != 0) return -1;
                continue;
            }
            if (self->append_node(prog, n) != 0) return -1;
        }
        /* errors leave the unit (and its artifacts) behind */
        if (ct_diag_nsem() > base) return -1;
        return prog;
    }

    /* A function (prototype or definition) or a global variable. */
    int parse_func(int is_static, int is_pub)
    {
        int f, b, params, fi, func_line;
        char ret[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        func_line = self->lex->tokline;
        if (self->parse_type(ret, sizeof ret) != 0) return -1;
        if (self->lex->tok != T_ID) return self->fail("expected a name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        self->lex_next();
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
            int g, e;
            g = self->new_node(N_GLOBAL);
            if (g < 0) return -1;
            snprintf(self->arena->nodes[g].text, MAX_TEXT, "%s", ret);
            snprintf(self->arena->nodes[g].text2, MAX_TEXT, "%s", name);
            self->arena->nodes[g].aux = is_static;
            self->arena->nodes[g].d = is_pub;
            self->arena->nodes[g].line = func_line;
            /* a file-scope name is visible to every function body */
            if (self->declare_var(name, ret) != 0) return -1;
            if (self->parse_array_dims(g) != 0) return -1;
            if (self->accept("=")) {
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                    char raw[MAX_TEXT];
                    char fixed[MAX_TEXT];
                    e = self->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->parse_init_raw(raw, sizeof raw) != 0) return -1;
                    if (self->rewrite_init_text(ret, raw, fixed, sizeof fixed) != 0) return -1;
                    snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", fixed);
                } else {
                    e = self->parse_expr();
                    if (e < 0) return -1;
                }
                self->arena->nodes[g].a = e;
            }
            if (self->expect(";") != 0) return -1;
            return g;
        }
        if (self->push_scope() != 0) return -1;
        params = self->parse_params();
        if (params < 0) {
            self->pop_scope();
            return -1;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
            self->lex_next();
            fi = self->add_func(name, ret, is_static, is_pub, params);
            if (fi < 0) {
                self->pop_scope();
                return -1;
            }
            self->sym->funcs[fi].line = func_line;
            self->pop_scope();
            return NO_NODE;
        }
        snprintf(self->sym->ret_type, sizeof self->sym->ret_type, "%s", ret);
        snprintf(self->cur_func, sizeof self->cur_func, "%s", name);
        /* the body is the leak analysis window; its own scope is the frame a
           deeper return counts as conditional against */
        self->mem->leak_active = 1;
        self->mem->leak_frame = self->sym->nscope + 1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        b = self->parse_block();
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->cur_func[0] = 0;
        self->sym->ret_type[0] = 0;
        if (b < 0) {
            self->pop_scope();
            return -1;
        }
        fi = self->add_func(name, ret, is_static, is_pub, params);
        if (fi < 0) {
            self->pop_scope();
            return -1;
        }
        self->sym->funcs[fi].ret_owned = self->mem->ret_owned;
        self->sym->funcs[fi].line = func_line;
        f = self->new_node(N_FUNC);
        if (f < 0) {
            self->pop_scope();
            return -1;
        }
        snprintf(self->arena->nodes[f].text, MAX_TEXT, "%s", ret);
        snprintf(self->arena->nodes[f].text2, MAX_TEXT, "%s", name);
        self->arena->nodes[f].aux = is_static;
        self->arena->nodes[f].d = is_pub;
        self->arena->nodes[f].line = func_line;
        self->arena->nodes[f].a = params;
        self->arena->nodes[f].b = b;
        self->pop_scope();
        return f;
    }

    int parse_params(void)
    {
        int first, tail, p;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        self->nparams = 0;
        first = 0;
        tail = 0;
        if (self->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        for (;;) {
            if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0 &&
                strcmp(typebuf, "void") == 0) {
                self->lex_next();
                return 0;
            }
            if (self->lex->tok != T_ID) return self->fail("expected a parameter name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->lex_next();
            p = self->new_node(N_PARAM);
            if (p < 0) return -1;
            snprintf(self->arena->nodes[p].text, MAX_TEXT, "%s", typebuf);
            snprintf(self->arena->nodes[p].text2, MAX_TEXT, "%s", name);
            if (self->parse_array_dims(p) != 0) return -1;
            if (self->declare_var(name, typebuf) != 0) return -1;
            if (self->arena->nodes[p].text3[0]) {
                int vi = self->find_var(name);
                if (vi >= 0) self->sym->vars[vi].is_array = 1;
            }
            if (tail == 0) first = p;
            else self->arena->nodes[tail].next = p;
            tail = p;
            self->nparams++;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }

    int parse_field_def(void)
    {
        int m;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        if (self->lex->tok != T_ID) return self->fail("expected a field name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        self->lex_next();
        m = self->new_node(N_FIELD);
        if (m < 0) return -1;
        snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", typebuf);
        snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", name);
        if (self->parse_array_dims(m) != 0) return -1;
        if (self->expect(";") != 0) return -1;
        return m;
    }

    /* `struct Name { ... }` (the trailing `;` is the caller's business). */
    int parse_struct_def(void)
    {
        int s, tail, m, struct_line, brace_line, brace_col;
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        (void)self;

        struct_line = self->lex->tokline;
        brace_line = 0;
        brace_col = 1;
        self->lex_next();
        name[0] = 0;
        qname[0] = 0;
        if (self->lex->tok == T_ID) {
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
            if (self->add_type(qname, 1) != 0) return -1;
            if (self->add_struct(qname) < 0) return -1;
            self->lex_next();
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
            /* `struct X;` -- a forward declaration: the tag is registered above,
               so `struct X *p` parses; the body may follow later */
            self->lex_next();
            return NO_NODE;
        }
        /* A second body for an already-defined tag is a hard error; a forward
           declaration above it is fine. L2 reports it at the '{'. */
        if (qname[0]) {
            int ex = self->find_struct(qname);
            if (ex >= 0 && self->sym->structs[ex].defined) {
                char msg[MAX_TEXT];
                snprintf(msg, sizeof msg, "duplicate struct '%s'", name);
                return ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->path);
            }
        }
        /* the body's `{` is where L2 reports an unresolved `use` trait */
        brace_line = self->lex->tokline;
        brace_col = self->lex->tokstart - self->lex->lstart + 1;
        if (self->expect("{") != 0) return -1;
        s = self->new_node(N_STRUCT);
        if (s < 0) return -1;
        self->arena->nodes[s].line = struct_line;
        snprintf(self->arena->nodes[s].text2, MAX_TEXT, "%s", qname);
        tail = -1;
        self->npend = 0;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            m = self->parse_field_def();
            if (m < 0) return -1;
            /* record the field type: receiver chains and nested vptr writes need it.
               An untagged body (typedef struct { ... }) lands in the pending list,
               which parse_typedef attaches to the alias. */
            if (qname[0]) {
                int si2 = self->find_struct(qname);
                if (si2 >= 0 && self->sym->structs[si2].nfields < MAX_FIELDS) {
                    snprintf(self->sym->structs[si2].fields[self->sym->structs[si2].nfields].name, MAX_TEXT,
                             "%s", self->arena->nodes[m].text2);
                    snprintf(self->sym->structs[si2].fields[self->sym->structs[si2].nfields].type, MAX_TEXT,
                             "%s", self->arena->nodes[m].text);
                    snprintf(self->sym->structs[si2].fields[self->sym->structs[si2].nfields].dims, MAX_TEXT,
                             "%s", self->arena->nodes[m].text3);
                    self->sym->structs[si2].nfields++;
                }
            } else if (self->npend < MAX_FIELDS) {
                snprintf(self->pend_fields[self->npend].name, MAX_TEXT, "%s", self->arena->nodes[m].text2);
                snprintf(self->pend_fields[self->npend].type, MAX_TEXT, "%s", self->arena->nodes[m].text);
                snprintf(self->pend_fields[self->npend].dims, MAX_TEXT, "%s", self->arena->nodes[m].text3);
                self->npend++;
            }
            if (tail < 0) self->arena->nodes[s].a = m;
            else self->arena->nodes[tail].next = m;
            tail = m;
        }
        if (self->expect("}") != 0) return -1;
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "use") == 0) {
            self->lex_next();
            if (qname[0] && self->parse_use_list(self->find_struct(qname)) != 0) return -1;
            /* every trait named in `use` must already be defined (the built-in
               Drop never joins the list); L2 reports the first miss at the
               struct's '{', so the remembered position is what is used here */
            if (qname[0]) {
                int si3, ui3;
                si3 = self->find_struct(qname);
                if (si3 >= 0) {
                    for (ui3 = 0; ui3 < self->sym->structs[si3].nuse; ui3++) {
                        if (self->find_trait(self->sym->structs[si3].use[ui3]) < 0) {
                            char msg[MAX_TEXT];
                            snprintf(msg, sizeof msg,
                                     "struct '%s' uses undefined trait '%s'",
                                     name, self->sym->structs[si3].use[ui3]);
                            return ct_sem_error(brace_line, brace_col, msg, self->path);
                        }
                    }
                }
            }
        }
        if (qname[0]) {
            int di = self->find_struct(qname);
            if (di >= 0) self->sym->structs[di].defined = 1;
        }
        return s;
    }

    /* `typedef struct { ... } Name;` or `typedef <type> Name;`. */
    int parse_typedef(int is_pub)
    {
        int t, td_line;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        (void)self;

        td_line = self->lex->tokline;
        self->lex_next();
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "struct") == 0) {
            t = self->parse_struct_def();
            if (t < 0) return -1;
            if (self->lex->tok != T_ID) return self->fail("expected a typedef name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
            /* keep the tag in `text`: `typedef struct Tag {...} Alias;` must emit
               the tag, or a `struct Tag` reference elsewhere is incomplete */
            snprintf(self->arena->nodes[t].text, MAX_TEXT, "%s", self->arena->nodes[t].text2);
            snprintf(self->arena->nodes[t].text2, MAX_TEXT, "%s", qname);
            self->arena->nodes[t].aux = 1;
            self->arena->nodes[t].d = is_pub;
            self->arena->nodes[t].line = td_line;
            if (self->add_type(qname, 2) != 0) return -1;
            if (self->add_struct(qname) < 0) return -1;
            /* the tag and the alias are two table entries: give the alias the
               `use` list the body attached to the tag, or its vptr fields vanish */
            {
                int tagi = -1, ai, ui;
                if (self->arena->nodes[t].text[0]) tagi = self->find_struct(self->arena->nodes[t].text);
                ai = self->find_struct(qname);
                if (tagi >= 0 && ai >= 0 && tagi != ai) {
                    self->sym->structs[ai].nuse = self->sym->structs[tagi].nuse;
                    self->sym->structs[ai].uses_drop = self->sym->structs[tagi].uses_drop;
                    for (ui = 0; ui < self->sym->structs[tagi].nuse; ui++)
                        snprintf(self->sym->structs[ai].use[ui], MAX_TEXT, "%s", self->sym->structs[tagi].use[ui]);
                    self->sym->structs[ai].nfields = self->sym->structs[tagi].nfields;
                    for (ui = 0; ui < self->sym->structs[tagi].nfields; ui++) {
                        snprintf(self->sym->structs[ai].fields[ui].name, MAX_TEXT, "%s",
                                 self->sym->structs[tagi].fields[ui].name);
                        snprintf(self->sym->structs[ai].fields[ui].type, MAX_TEXT, "%s",
                                 self->sym->structs[tagi].fields[ui].type);
                    }
                } else if (ai >= 0 && !self->arena->nodes[t].text[0]) {
                    /* an untagged body: the pending list belongs to this alias */
                    self->sym->structs[ai].nfields = self->npend;
                    for (ui = 0; ui < self->npend; ui++) {
                        snprintf(self->sym->structs[ai].fields[ui].name, MAX_TEXT, "%s",
                                 self->pend_fields[ui].name);
                        snprintf(self->sym->structs[ai].fields[ui].type, MAX_TEXT, "%s",
                                 self->pend_fields[ui].type);
                        snprintf(self->sym->structs[ai].fields[ui].dims, MAX_TEXT, "%s",
                                 self->pend_fields[ui].dims);
                    }
                }
            }
            return t;
        }
        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        if (self->lex->tok != T_ID) return self->fail("expected a typedef name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        self->lex_next();
        if (self->expect(";") != 0) return -1;
        if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
        t = self->new_node(N_TYPEDEF);
        if (t < 0) return -1;
        snprintf(self->arena->nodes[t].text, MAX_TEXT, "%s", typebuf);
        snprintf(self->arena->nodes[t].text2, MAX_TEXT, "%s", qname);
        self->arena->nodes[t].d = is_pub;
        self->arena->nodes[t].line = td_line;
        if (self->add_type(qname, 2) != 0) return -1;
        return t;
    }

    /* `use A, B` after a struct body; the trailing `;` stays with the caller. */
    int parse_use_list(int sindex)
    {
        char tname[MAX_TEXT];
        (void)self;
        if (sindex < 0) return self->fail("unknown struct in 'use'");
        for (;;) {
            if (self->lex->tok != T_ID) return self->fail("expected a trait name");
            if (self->resolve_type(self->lex->toktext, tname, sizeof tname) != 0) return -1;
            /* `Drop` is built in (Phase 5): it carries no vptr or vtable, so it
               never joins the `use` list -- only the flag matters */
            if (strcmp(tname, "Drop") == 0) {
                self->sym->structs[sindex].uses_drop = 1;
                self->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                    self->lex_next();
                    continue;
                }
                break;
            }
            if (self->sym->structs[sindex].nuse >= MAX_TRAITS) return self->fail("too many used traits");
            snprintf(self->sym->structs[sindex].use[self->sym->structs[sindex].nuse], MAX_TEXT, "%s", tname);
            self->sym->structs[sindex].nuse++;
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        return 0;
    }

    /* `trait Name { ret m(params); ... }` -- no node, the table is enough. */
    int parse_trait(int is_pub)
    {
        int ti, mi, np, trait_line;
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        char ret[MAX_TEXT];
        char ptype[MAX_TEXT];
        (void)self;

        trait_line = self->lex->tokline;
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a trait name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
        /* A second body for the same trait is a hard error. L2 reports it at the
           opening '{', so step there first and use its line/column. */
        if (self->find_trait(qname) >= 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "duplicate trait '%s'", name);
            self->lex_next();
            return ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->path);
        }
        ti = self->add_trait(qname);
        if (ti < 0) return -1;
        self->sym->traits[ti].is_pub = is_pub;
        self->sym->traits[ti].line = trait_line;
        if (self->add_type(qname, 3) != 0) return -1;   /* trait = iface type */
        self->lex_next();
        if (self->expect("{") != 0) return -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (self->parse_type(ret, sizeof ret) != 0) return -1;
            if (self->lex->tok != T_ID) return self->fail("expected a method name");
            if (self->sym->traits[ti].nm >= MAX_METHODS) return self->fail("too many trait methods");
            mi = self->sym->traits[ti].nm;
            snprintf(self->sym->traits[ti].m[mi].name, MAX_TEXT, "%s", self->lex->toktext);
            snprintf(self->sym->traits[ti].m[mi].ret, MAX_TEXT, "%s", ret);
            self->sym->traits[ti].m[mi].nparams = 0;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "void") == 0) {
                self->lex_next();
                if (self->expect(")") != 0) return -1;
                if (self->expect(";") != 0) return -1;
                self->sym->traits[ti].nm++;
                continue;
            }
            np = 0;
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                for (;;) {
                    if (self->parse_type(ptype, sizeof ptype) != 0) return -1;
                    if (self->lex->tok == T_ID) self->lex_next();
                    /* a parameter may be an array (`char a[][N]`): the dims
                       belong in the vtable signature too, or the impl's type
                       would not match it */
                    {
                        int sp;
                        sp = self->new_node(N_PARAM);
                        if (sp < 0) return -1;
                        if (self->parse_array_dims(sp) != 0) return -1;
                        if (self->arena->nodes[sp].text3[0])
                            snprintf(ptype + strlen(ptype),
                                     sizeof ptype - strlen(ptype), "%s", self->arena->nodes[sp].text3);
                    }
                    if (np >= MAX_PARAMS) return self->fail("too many method parameters");
                    snprintf(self->sym->traits[ti].m[mi].ptype[np], MAX_TEXT, "%s", ptype);
                    np++;
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                        self->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->expect(")") != 0) return -1;
            if (self->expect(";") != 0) return -1;
            self->sym->traits[ti].m[mi].nparams = np;
            self->sym->traits[ti].nm++;
        }
        if (self->expect("}") != 0) return -1;
        return NO_NODE;
    }

    /* `impl T for S { methods }` -- one N_IMPL node carrying N_METHOD children. */
    int parse_impl(void)
    {
        int ti, si, node, mnode, params, body, tail, impl_line;
        int mline, nimpl, tm_i, k2;
        char tname[MAX_TEXT];
        char sname[MAX_TEXT];
        char rtrait[MAX_TEXT];
        char rstruct[MAX_TEXT];
        char ret[MAX_TEXT];
        char mname[MAX_TEXT];
        char stype[MAX_TEXT];
        int type_index;
        (void)self;

        impl_line = self->lex->tokline;
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a trait name");
        snprintf(tname, sizeof tname, "%s", self->lex->toktext);
        if (self->resolve_type(tname, rtrait, sizeof rtrait) != 0) return -1;
        ti = self->find_trait(rtrait);
        /* `Drop` is built in: no `trait Drop` declaration exists, but
           `impl Drop for S` is legal and emits `S_Drop_drop` */
        if (ti < 0 && strcmp(rtrait, "Drop") != 0)
            return self->fail("impl of an unknown trait");
        self->lex_next();
        if (self->lex->tok != T_ID || strcmp(self->lex->toktext, "for") != 0)
            return self->fail("expected 'for' after the trait name");
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a struct name");
        snprintf(sname, sizeof sname, "%s", self->lex->toktext);
        if (self->resolve_type(sname, rstruct, sizeof rstruct) != 0) return -1;
        /* the struct must exist (a forward declaration is enough); an undefined
           one is reported at the body's `{`, like L2, and the body is skipped so
           the declarations after it are still parsed (Phase 10.4 recovery) */
        si = self->find_struct(rstruct);
        self->lex_next();
        if (si < 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "impl for undefined struct '%s'", sname);
            if (ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->path) != 0)
                return -1;
            if (self->skip_body() != 0) return -1;
            return NO_NODE;
        }
        type_index = self->find_type(rstruct);
        if (type_index >= 0 && self->sym->type_kind[type_index] == 1)
            snprintf(stype, sizeof stype, "struct %s", rstruct);
        else
            snprintf(stype, sizeof stype, "%s", rstruct);
        if (self->expect("{") != 0) return -1;
        node = self->new_node(N_IMPL);
        if (node < 0) return -1;
        self->arena->nodes[node].line = impl_line;
        snprintf(self->arena->nodes[node].text2, MAX_TEXT, "%s", rtrait);
        self->arena->nodes[node].aux = si;
        snprintf(self->arena->nodes[node].text, MAX_TEXT, "%s", stype);
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            mline = self->lex->tokline;
            if (self->parse_type(ret, sizeof ret) != 0) return -1;
            if (self->lex->tok != T_ID) return self->fail("expected a method name");
            snprintf(mname, sizeof mname, "%s", self->lex->toktext);
            self->lex_next();
            if (self->push_scope() != 0) return -1;
            if (self->declare_var("self", stype) != 0) {
                self->pop_scope();
                return -1;
            }
            params = self->parse_params();
            if (params < 0) {
                self->pop_scope();
                return -1;
            }
            /* Signature consistency against the trait -- a warning, not an error.
               The wording and the line (the method's, not the impl's) match L2
               (D39), so the module fixtures can be compared byte for byte. */
            nimpl = 0;
            for (k2 = params; k2 > 0; k2 = self->arena->nodes[k2].next) nimpl++;
            tm_i = 0;
            if (ti >= 0)
                for (tm_i = 0; tm_i < self->sym->traits[ti].nm; tm_i++)
                    if (strcmp(self->sym->traits[ti].m[tm_i].name, mname) == 0) break;
            if (ti >= 0 && tm_i < self->sym->traits[ti].nm) {
                char wmsg[MAX_TEXT];
                if (ret[0] && strcmp(ret, self->sym->traits[ti].m[tm_i].ret) != 0) {
                    snprintf(wmsg, sizeof wmsg, "return type '%s' does not match the trait's '%s'",
                             ret, self->sym->traits[ti].m[tm_i].ret);
                    if (ct_sig_warn(mline, mname, rtrait, rstruct, wmsg, self->path) != 0) {
                        self->pop_scope();
                        return -1;
                    }
                } else if (nimpl != self->sym->traits[ti].m[tm_i].nparams) {
                    snprintf(wmsg, sizeof wmsg, "takes %d parameter(s), the trait declares %d",
                             nimpl, self->sym->traits[ti].m[tm_i].nparams);
                    if (ct_sig_warn(mline, mname, rtrait, rstruct, wmsg, self->path) != 0) {
                        self->pop_scope();
                        return -1;
                    }
                }
            }
            snprintf(self->sym->ret_type, sizeof self->sym->ret_type, "%s", ret);
            snprintf(self->cur_func, sizeof self->cur_func, "%s_%s_%s",
                     self->sym->structs[si].name, rtrait, mname);
            /* the method body tracks leaks too; a method symbol is not in the
               function table, so nothing feeds `ret_owned` back to callers */
            self->mem->leak_active = 1;
            self->mem->leak_frame = self->sym->nscope + 1;
            self->mem->leak_impl = 1;
            body = self->parse_block();
            self->mem->leak_active = 0;
            self->mem->leak_frame = -1;
            self->mem->leak_impl = 0;
            self->cur_func[0] = 0;
            self->sym->ret_type[0] = 0;
            if (body < 0) {
                self->pop_scope();
                return -1;
            }
            self->pop_scope();
            mnode = self->new_node(N_METHOD);
            if (mnode < 0) return -1;
            snprintf(self->arena->nodes[mnode].text, MAX_TEXT, "%s", ret);
            snprintf(self->arena->nodes[mnode].text2, MAX_TEXT, "%s", mname);
            /* The emitted function takes the trait's return type (L2 does the
               same), so a mismatching impl still yields C that compiles; the
               map keeps the impl's written type in `text`. */
            if (ti >= 0 && tm_i < self->sym->traits[ti].nm)
                snprintf(self->arena->nodes[mnode].text3, MAX_TEXT, "%s", self->sym->traits[ti].m[tm_i].ret);
            self->arena->nodes[mnode].a = params;
            self->arena->nodes[mnode].b = body;
            self->arena->nodes[mnode].num = ti;
            self->arena->nodes[mnode].aux = si;
            if (tail < 0) self->arena->nodes[node].a = mnode;
            else self->arena->nodes[tail].next = mnode;
            tail = mnode;
        }
        if (self->expect("}") != 0) return -1;
        return node;
    }

    /* Capture a `{ ... }` initializer verbatim; the caller appends vptr items. */
    int parse_init_raw(char *out, size_t cap)
    {
        int depth, n, c;
        (void)self;

        n = 0;
        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
        out[n] = '{';
        n++;
        depth = 1;
        while (self->lex->src[self->lex->pos] && depth > 0) {
            c = (unsigned char)self->lex->src[self->lex->pos];
            if (c == '"') {
                if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                out[n] = '"';
                n++;
                self->lex->pos++;
                while (self->lex->src[self->lex->pos] && self->lex->src[self->lex->pos] != '"') {
                    if (self->lex->src[self->lex->pos] == '\\' && self->lex->src[self->lex->pos + 1]) {
                        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                        out[n] = self->lex->src[self->lex->pos];
                        n++;
                        self->lex->pos++;
                    }
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = self->lex->src[self->lex->pos];
                    n++;
                    self->lex->pos++;
                }
                if (self->lex->src[self->lex->pos] == '"') {
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = '"';
                    n++;
                    self->lex->pos++;
                }
                continue;
            }
            if (c == '{') depth++;
            else if (c == '}') depth--;
            if (n + 1 >= (int)cap) return self->fail("initializer is too long");
            out[n] = (char)c;
            n++;
            self->lex->pos++;
        }
        if (depth != 0) return self->fail("unterminated initializer");
        out[n] = 0;
        self->lex_next();
        return 0;
    }

    int parse_block(void)
    {
        int blk, tail, s, base;
        (void)self;

        if (self->expect("{") != 0) return -1;
        if (self->push_scope() != 0) return -1;
        base = self->mem->own_base[self->sym->nscope - 1];
        blk = self->new_node(N_BLOCK);
        if (blk < 0) {
            self->pop_scope();
            return -1;
        }
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            s = self->parse_stmt();
            if (s < 0) {
                self->pop_scope();
                return -1;
            }
            if (tail < 0) self->arena->nodes[blk].a = s;
            else self->arena->nodes[tail].next = s;
            tail = s;
        }
        /* AutoDrop: append `delete v;` for this scope's `own` declarations, in
           reverse order, just before the closing brace (L2's line rewrite does
           the same). A brace that shares its line with code cannot host the
           deletes, so that layout is rejected. */
        if (self->mem->nowner > base) {
            int p, at_start, d;
            at_start = 1;
            for (p = self->lex->lstart; p < self->lex->tokstart; p++)
                if (self->lex->src[p] != ' ' && self->lex->src[p] != '\t' && self->lex->src[p] != '\r') at_start = 0;
            if (!at_start) {
                self->pop_scope();
                return ct_sem_error(self->lex->tokline, 1,
                    "auto-drop requires the closing '}' at the start of a line", self->path);
            }
            for (d = self->mem->nowner - 1; d >= base; d--) {
                int del, v, vi;
                const char *tp;
                size_t bl;
                /* a reassigned / returned / moved `own` variable is no longer
                   ours to release (L2 clears the same flag before its rewrite) */
                vi = self->find_var(self->arena->nodes[self->mem->own_decl[d]].text2);
                if (vi >= 0 && !self->sym->vars[vi].autodrop) continue;
                del = self->new_node(N_DELETE);
                v = self->new_node(N_VAR);
                if (del < 0 || v < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[del].line = self->arena->nodes[self->mem->own_decl[d]].line;
                snprintf(self->arena->nodes[v].text2, MAX_TEXT, "%s", self->arena->nodes[self->mem->own_decl[d]].text2);
                self->arena->nodes[del].a = v;
                tp = self->arena->nodes[self->mem->own_decl[d]].text;
                if (strncmp(tp, "struct ", 7) == 0) tp += 7;
                snprintf(self->arena->nodes[del].text, MAX_TEXT, "%s", tp);
                bl = strlen(self->arena->nodes[del].text);
                while (bl > 0 && (self->arena->nodes[del].text[bl - 1] == '*'
                                  || self->arena->nodes[del].text[bl - 1] == ' ')) {
                    bl = bl - 1;
                    self->arena->nodes[del].text[bl] = 0;
                }
                if (tail < 0) self->arena->nodes[blk].a = del;
                else self->arena->nodes[tail].next = del;
                tail = del;
            }
        }
        if (self->expect("}") != 0) {
            self->pop_scope();
            return -1;
        }
        /* a scope that closes with a still-owned heap object leaks it (L2
           reports it at the same point, keeping the warning order) */
        if (self->mem->leak_active && self->leak_scope(self->sym->scope[self->sym->nscope - 1], self->sym->nvar) != 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        return blk;
    }

    int parse_stmt(void)
    {
        int s, e, c;
        (void)self;

        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) return self->parse_block();
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "return") == 0) {
            int rline = self->lex->tokline, at_start = 1, rp;
            for (rp = self->lex->lstart; rp < self->lex->tokstart; rp++)
                if (self->lex->src[rp] != ' ' && self->lex->src[rp] != '\t' && self->lex->src[rp] != '\r') at_start = 0;
            s = self->new_node(N_RET);
            if (s < 0) return -1;
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->lex_next();
                /* a bare `return;` leaves every owned object behind */
                if (self->mem->leak_active
                    && self->leak_return(-1, !at_start || self->sym->nscope > self->mem->leak_frame, rline) != 0)
                    return -1;
                return s;
            }
            e = self->parse_expr();
            if (e < 0) return -1;
            {
                char tr[MAX_TEXT];
                int ip = 0;
                if (self->iface_ref_type(self->sym->ret_type, tr, sizeof tr, &ip)) {
                    e = self->maybe_box(e, tr, ip);
                    if (e < 0) return -1;
                }
            }
            self->arena->nodes[s].a = e;
            /* a return nested in a block (or written mid-line) may be skipped
               at run time, so it only warns about what it leaves behind */
            if (self->mem->leak_active
                && self->leak_return(e, !at_start || self->sym->nscope > self->mem->leak_frame, rline) != 0)
                return -1;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "delete") == 0) {
            s = self->new_node(N_DELETE);
            if (s < 0) return -1;
            self->lex_next();
            e = self->parse_expr();
            if (e < 0) return -1;
            self->arena->nodes[s].a = e;
            /* the object is released: it can neither leak nor auto-drop */
            if (self->mem->leak_active && self->leak_delete(e) != 0) return -1;
            /* resolve the pointee's struct now (the variable may leave scope
               before the delete is emitted) and remember it only when it uses
               Drop; otherwise the emitter stays on the plain `free` path */
            {
                char dt[MAX_TEXT];
                if (self->expr_type(e, dt, sizeof dt) == 0) {
                    const char *dp = dt;
                    size_t dl;
                    int si;
                    if (strncmp(dp, "struct ", 7) == 0) dp += 7;
                    snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s", dp);
                    dl = strlen(self->arena->nodes[s].text);
                    while (dl > 0 && (self->arena->nodes[s].text[dl - 1] == '*'
                                      || self->arena->nodes[s].text[dl - 1] == ' ')) {
                        dl = dl - 1;
                        self->arena->nodes[s].text[dl] = 0;
                    }
                    si = self->find_struct(self->arena->nodes[s].text);
                    if (si < 0 || !self->sym->structs[si].uses_drop) self->arena->nodes[s].text[0] = 0;
                }
            }
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "break") == 0) {
            s = self->new_node(N_BREAK);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "continue") == 0) {
            s = self->new_node(N_CONT);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "if") == 0) {
            s = self->new_node(N_IF);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            self->arena->nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "else") == 0) {
                self->lex_next();
                e = self->parse_branch();
                if (e < 0) return -1;
                self->arena->nodes[s].c = e;
            }
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "while") == 0) {
            s = self->new_node(N_WHILE);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            self->arena->nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "for") == 0) {
            s = self->new_node(N_FOR);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (self->push_scope() != 0) return -1;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->arena->nodes[s].a = -1;
            } else if (self->lex->tok == T_ID && (self->is_type_word(self->lex->toktext)
                       || self->find_type(self->lex->toktext) >= 0)) {
                e = self->parse_decl_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].a = e;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].a = e;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->arena->nodes[s].b = -1;
            } else {
                c = self->parse_expr();
                if (c < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].b = c;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                self->arena->nodes[s].c = -1;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].c = e;
            }
            if (self->expect(")") != 0) {
                self->pop_scope();
                return -1;
            }
            e = self->parse_branch();
            if (e < 0) {
                self->pop_scope();
                return -1;
            }
            self->arena->nodes[s].d = e;
            self->pop_scope();
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "own") == 0) {
            int own_line = self->lex->tokline;
            self->lex_next();
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->expect(";") != 0) return -1;
            if (self->mark_owned(s, own_line) != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && (self->is_type_word(self->lex->toktext)
                              || self->find_type(self->lex->toktext) >= 0)) {
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        s = self->parse_expr_stmt_node();
        if (s < 0) return -1;
        if (self->expect(";") != 0) return -1;
        return s;
    }

    int parse_branch(void)
    {
        int b, s;
        (void)self;

        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) return self->parse_block();
        if (self->push_scope() != 0) return -1;
        s = self->parse_stmt();
        if (s < 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        b = self->new_node(N_BLOCK);
        if (b < 0) return -1;
        self->arena->nodes[b].a = s;
        return b;
    }

    /* `<type> name[dims] [= expr] (, name[dims] [= expr])*` without the trailing
       semicolon. Several declarators share the type and come back as an N_DECLS
       wrapper, so every consumer still sees one statement node. */
    int parse_decl_node(void)
    {
        int n, e, head, tail, base_stars, first_decl;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        head = -1;
        tail = -1;
        base_stars = 0;
        first_decl = 1;
        for (;;) {
            int stars = 0, si;
            size_t tl;
            char t2[MAX_TEXT];

            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                stars++;
                self->lex_next();
            }
            /* `parse_type` folds the first declarator's stars into the type; each
               later declarator brings its own, so the star suffix is rebuilt per
               declarator (`const char *p, *q;` and `int *a, **b;` both work) */
            tl = strlen(typebuf);
            while (tl > 0 && (typebuf[tl - 1] == '*' || typebuf[tl - 1] == ' ')) {
                if (first_decl && typebuf[tl - 1] == '*') base_stars++;
                tl--;
            }
            typebuf[tl] = 0;
            if (first_decl) {
                stars = base_stars;
                first_decl = 0;
            }
            for (si = 0; si < stars; si++) {
                snprintf(t2, sizeof t2, "%s *", typebuf);
                snprintf(typebuf, sizeof typebuf, "%s", t2);
            }
            if (self->lex->tok != T_ID) return self->fail("expected a variable name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->lex_next();
            n = self->new_node(N_DECL);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", typebuf);
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", name);
            if (self->declare_var(name, typebuf) != 0) return -1;
            if (self->parse_array_dims(n) != 0) return -1;
            if (self->arena->nodes[n].text3[0]) {
                int vi = self->find_var(name);
                if (vi >= 0) self->sym->vars[vi].is_array = 1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0) {
                self->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                    char raw[MAX_TEXT];
                    char fixed[MAX_TEXT];
                    e = self->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->parse_init_raw(raw, sizeof raw) != 0) return -1;
                    if (self->rewrite_init_text(typebuf, raw, fixed, sizeof fixed) != 0) return -1;
                    snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", fixed);
                } else {
                    e = self->parse_expr();
                    if (e < 0) return -1;
                }
                self->arena->nodes[n].a = e;
            }
            if (self->arena->nodes[n].a >= 0) {
                char tr[MAX_TEXT];
                int ip = 0;
                if (self->iface_ref_type(typebuf, tr, sizeof tr, &ip)) {
                    e = self->maybe_box(self->arena->nodes[n].a, tr, ip);
                    if (e < 0) return -1;
                    self->arena->nodes[n].a = e;
                }
            }
            if (self->mem->leak_active && self->leak_decl(n) != 0) return -1;
            if (head < 0) head = n;
            else self->arena->nodes[tail].next = n;
            tail = n;
            if (!self->accept(",")) break;
        }
        if (self->arena->nodes[head].next >= 0) {
            int w = self->new_node(N_DECLS);
            if (w < 0) return -1;
            self->arena->nodes[w].a = head;
            return w;
        }
        return head;
    }

    int parse_expr_stmt_node(void)
    {
        int e, rhs, n;
        (void)self;

        e = self->parse_expr();
        if (e < 0) return -1;
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+=") == 0 || strcmp(self->lex->toktext, "-=") == 0
                                 || strcmp(self->lex->toktext, "*=") == 0 || strcmp(self->lex->toktext, "/=") == 0
                                 || strcmp(self->lex->toktext, "%=") == 0)) {
            int op = 0, k2;
            char oc = self->lex->toktext[0];
            k2 = self->arena->nodes[e].kind;
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX && k2 != N_DEREF)
                return self->fail("assignment target is not assignable");
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else op = 5;
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            n = self->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].b = rhs;
            self->arena->nodes[n].aux = op;
            if (self->mem->leak_active && self->leak_assign(n) != 0) return -1;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0) {
            int k;
            char tt[MAX_TEXT];
            char tr[MAX_TEXT];
            k = self->arena->nodes[e].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->fail("assignment target is not assignable");
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            if ((k == N_VAR && self->var_type(self->arena->nodes[e].text2, tt, sizeof tt) == 0)
                || ((k == N_INDEX || k == N_MEMBER || k == N_ARROW)
                    && self->expr_type(e, tt, sizeof tt) == 0)) {
                int ip = 0;
                if (self->iface_ref_type(tt, tr, sizeof tr, &ip)) {
                    rhs = self->maybe_box(rhs, tr, ip);
                    if (rhs < 0) return -1;
                }
            }
            n = self->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].b = rhs;
            if (self->mem->leak_active && self->leak_assign(n) != 0) return -1;
            return n;
        }
        if (self->arena->nodes[e].kind == N_POST) return e;
        n = self->new_node(N_EXPR);
        if (n < 0) return -1;
        self->arena->nodes[n].a = e;
        return n;
    }

    int parse_expr(void)
    {
        int left, right, inner, n, c;
        (void)self;

        /* `&&` binds tighter than `||`; both are looser than parse_cmp's operators.
           The loops live here so the trait's method budget stays put. */
        left = self->parse_cmp();
        if (left < 0) return -1;
        /* `^` sits between the comparisons and `&&`; the cache's FNV fold is the
           first source to need it */
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "^") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_XOR;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_AND;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "||") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
                self->lex_next();
                inner = self->parse_cmp();
                if (inner < 0) return -1;
                n = self->new_node(N_BIN);
                if (n < 0) return -1;
                self->arena->nodes[n].a = right;
                self->arena->nodes[n].b = inner;
                self->arena->nodes[n].aux = B_AND;
                right = n;
            }
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_OR;
            left = n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "?") == 0) {
            int a, b;
            self->lex_next();
            a = self->parse_expr();
            if (a < 0) return -1;
            if (self->expect(":") != 0) return -1;
            b = self->parse_expr();
            if (b < 0) return -1;
            c = self->new_node(N_TERN);
            if (c < 0) return -1;
            self->arena->nodes[c].a = left;
            self->arena->nodes[c].b = a;
            self->arena->nodes[c].c = b;
            return c;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT) {
            op = 0;
            if (strcmp(self->lex->toktext, "<") == 0) op = B_LT;
            else if (strcmp(self->lex->toktext, ">") == 0) op = B_GT;
            else if (strcmp(self->lex->toktext, "<=") == 0) op = B_LE;
            else if (strcmp(self->lex->toktext, ">=") == 0) op = B_GE;
            else if (strcmp(self->lex->toktext, "==") == 0) op = B_EQ;
            else if (strcmp(self->lex->toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+") == 0 || strcmp(self->lex->toktext, "-") == 0)) {
            op = (self->lex->toktext[0] == '+') ? B_ADD : B_SUB;
            self->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "*") == 0
               || strcmp(self->lex->toktext, "/") == 0 || strcmp(self->lex->toktext, "%") == 0)) {
            op = B_MUL;
            if (self->lex->toktext[0] == '/') op = B_DIV;
            else if (self->lex->toktext[0] == '%') op = B_MOD;
            self->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "sizeof") == 0) {
            char tbuf[MAX_TEXT];
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
                && self->next_is_type_name()) {
                self->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->expect(")") != 0) return -1;
                n = self->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[n].aux = 1;
                return n;
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_SIZEOF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->expect(")") != 0) return -1;
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_CAST);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            self->arena->nodes[n].a = e;
            return n;
        }
        op = 0;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "-") == 0) op = U_NEG;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "!") == 0) op = U_NOT;
        if (op != 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_UNARY);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = op;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_ADDR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_DEREF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    int parse_postfix(void)
    {
        int n, m, idx, args;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->parse_primary();
        if (n < 0) return -1;
        for (;;) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                self->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->expect("]") != 0) return -1;
                m = self->new_node(N_INDEX);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].b = idx;
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, ".") == 0
                                     || strcmp(self->lex->toktext, "->") == 0)) {
                int arrow;
                arrow = (self->lex->toktext[0] == '-') ? 1 : 0;
                self->lex_next();
                if (self->lex->tok != T_ID) return self->fail("expected a field or method name");
                snprintf(fname, sizeof fname, "%s", self->lex->toktext);
                self->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                    self->arena->nodes[m].aux = arrow ? 2 : 1;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs */
                    if (self->expr_type(n, rtype, sizeof rtype) == 0) {
                        char ibase[MAX_TEXT];
                        size_t il;
                        int piface = 0;
                        /* a pointer to an interface value dispatches through
                           `->vt` instead of `.vt` */
                        snprintf(ibase, sizeof ibase, "%s", rtype);
                        il = strlen(ibase);
                        while (il > 0 && (ibase[il - 1] == ' ' || ibase[il - 1] == '*')) {
                            if (ibase[il - 1] == '*') piface = 1;
                            il--;
                            ibase[il] = 0;
                        }
                        if (self->is_iface_type(ibase, trname, sizeof trname)) {
                            int t = self->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                                    if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                self->arena->nodes[m].aux = piface ? 4 : 3;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            }
                        } else if (self->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                        }
                    }
                } else {
                    m = self->new_node(arrow ? N_ARROW : N_MEMBER);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                }
                n = m;
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0 || strcmp(self->lex->toktext, "--") == 0)) {
            int k;
            k = self->arena->nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->fail("'++' / '--' need an assignable target");
            m = self->new_node(N_POST);
            if (m < 0) return -1;
            self->arena->nodes[m].a = n;
            self->arena->nodes[m].aux = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->lex_next();
            return m;
        }
        return n;
    }

    int parse_primary(void)
    {
        int n, args, id_line;
        (void)self;

        if (self->lex->tok == T_NUM) {
            n = self->new_node(N_NUM);
            if (n < 0) return -1;
            self->arena->nodes[n].num = self->lex->toknum;
            self->lex_next();
            return n;
        }
        if (self->lex->tok == T_STR) {
            int off = self->arena->str_begin();
            n = self->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (self->lex->tok == T_STR) {
                int m = 0;
                while (self->lex->toktext[m]) {
                    if (self->arena->str_put((unsigned char)self->lex->toktext[m]) != 0)
                        return self->fail("string pool is full");
                    m++;
                }
                self->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            return n;
        }
        if (self->lex->tok == T_ID) {
            id_line = self->lex->tokline;
            n = self->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->lex->toktext);
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                int fi;
                args = self->parse_args();
                if (args < 0) return -1;
                fi = self->find_func(self->arena->nodes[n].text2);
                if (fi >= 0 && self->record_call(self->arena->nodes[n].text2, id_line) != 0) return -1;
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < self->sym->funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        int ip = 0;
                        if (self->iface_ref_type(self->sym->funcs[fi].ptype[k], tr, sizeof tr, &ip)) {
                            int boxed = self->maybe_box(cur, tr, ip);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else self->arena->nodes[prev].next = boxed;
                                self->arena->nodes[boxed].next = self->arena->nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                self->arena->nodes[n].kind = N_CALL;
                self->arena->nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->find_var(self->arena->nodes[n].text2) < 0) {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps;
                const char *nm = self->arena->nodes[n].text2;
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                return self->fail("use of an undeclared variable");
            }
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            self->lex_next();
            n = self->parse_expr();
            if (n < 0) return -1;
            if (self->expect(")") != 0) return -1;
            return n;
        }
        return self->fail("expected an expression");
    }

    int parse_args(void)
    {
        int first, tail, e;
        (void)self;

        if (self->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        first = -1;
        tail = -1;
        for (;;) {
            e = self->parse_expr();
            if (e < 0) return -1;
            if (tail < 0) first = e;
            else self->arena->nodes[tail].next = e;
            tail = e;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }
}

/* The type queries and the boxing decision live in frontend::type; this half
   only forwards, so the parser keeps calling them on the driver object. */
impl TypeOps for Ast {
    int is_iface_type(const char *type, char *tout, size_t tcap)
    {
        return self->ty->is_iface_type(type, tout, (int)tcap);
    }

    int iface_ref_type(const char *type, char *tout, size_t tcap, int *is_ptr)
    {
        return self->ty->iface_ref_type(type, tout, (int)tcap, is_ptr);
    }

    int concrete_struct(const char *type, char *sout, size_t scap, int *is_ptr)
    {
        return self->ty->concrete_struct(type, sout, (int)scap, is_ptr);
    }

    int expr_type(int n, char *out, size_t cap)
    {
        return self->ty->expr_type(n, out, (int)cap);
    }

    /* The type layer returns the box node's index on success (0 is a valid
       node), so only a negative result is a failure. */
    int maybe_box(int n, const char *trait, int addr)
    {
        const char *why;
        int box;
        self->ty->errmsg[0] = 0;
        box = self->ty->maybe_box(n, trait, addr);
        if (box < 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return box;
    }

    int type_has_array_init(const char *type)
    {
        return self->ty->type_has_array_init(type);
    }

    /* A miss is not the only failure here: an over-long initialiser records a
       reason inside the type layer, and the position has to be added here. */
    int init_item_text(const char *stype, const char *item, char *out, size_t cap)
    {
        const char *why;
        self->ty->errmsg[0] = 0;
        if (self->ty->init_item_text(stype, item, out, (int)cap) != 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int rewrite_init_text(const char *stype, const char *raw, char *out, size_t cap)
    {
        const char *why;
        self->ty->errmsg[0] = 0;
        if (self->ty->rewrite_init_text(stype, raw, out, (int)cap) != 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }
}

impl ModuleOps for Ast {
    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`. */
    int base_name(const char *path, char *out, size_t cap, int *is_hdr)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > cap) return self->fail("output name is too long");
        snprintf(out, cap, "%.*s", (int)n, name);
        return 0;
    }

    int path_dir(const char *path, char *out, size_t cap)
    {
        const char *slash;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        if (!slash) {
            if (cap < 2) return self->fail("path is too long");
            snprintf(out, cap, "%s", ".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        if (n + 1 > cap) return self->fail("path is too long");
        snprintf(out, cap, "%.*s", (int)n, path);
        return 0;
    }

    int append_node(int prog, int n)
    {
        int t;
        (void)self;

        self->arena->nodes[n].next = -1;
        if (self->arena->nodes[prog].a < 0) {
            self->arena->nodes[prog].a = n;
            return 0;
        }
        t = self->arena->nodes[prog].a;
        while (self->arena->nodes[t].next >= 0) t = self->arena->nodes[t].next;
        self->arena->nodes[t].next = n;
        return 0;
    }

    /* Consume `import a::b;` and remember the path; `load_unit` resolves it. */
    int skip_import(void)
    {
        char rel[MAX_TEXT];
        size_t n;
        (void)self;

        n = 0;
        rel[0] = 0;
        self->lex_next();
        for (;;) {
            if (self->lex->tok != T_ID) return self->fail("expected an import path");
            if (n > 0) {
                if (n + 1 >= sizeof rel) return self->fail("import path is too long");
                rel[n] = '/';
                n++;
            }
            if (n + strlen(self->lex->toktext) >= sizeof rel) return self->fail("import path is too long");
            snprintf(rel + n, sizeof rel - n, "%s", self->lex->toktext);
            n += strlen(self->lex->toktext);
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(";") != 0) return -1;
        if (self->nrels >= MAX_IMPORTS) return self->fail("too many imports");
        snprintf(self->rels[self->nrels], MAX_TEXT, "%s", rel);
        self->nrels++;
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. */
    int scan_imports(const char *from)
    {
        (void)self;
        self->nrels = 0;
        self->path = from;
        self->mem->path = self->path;
        ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->tok = 0;
        self->lex_next();
        for (;;) {
            if (self->lex->tok == T_PP) {
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "import") == 0) {
                if (self->skip_import() != 0) return -1;
                continue;
            }
            break;
        }
        return 0;
    }

    /* `a::b` -> `<root>/a/b.ct`, then `a/b.h.ct`, for the importing file's own
       directory and then every `-I` root. */
    int resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr)
    {
        char dir[MAX_PATH];
        char cand[MAX_PATH];
        const char *root;
        FILE *f;
        int r;
        (void)self;

        if (self->path_dir(from, dir, sizeof dir) != 0) return -1;
        for (r = -1; r < self->ninc; r++) {
            root = (r < 0) ? dir : self->incdirs[r];
            if (snprintf(cand, sizeof cand, "%s/%s.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 0;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
            if (snprintf(cand, sizeof cand, "%s/%s.h.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 1;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
        }
        snprintf(cand, sizeof cand, "cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char rels[MAX_IMPORTS][MAX_TEXT];
        char dep[MAX_PATH];
        char *mysrc;
        int u, i, d, nrels, is_hdr;
        (void)self;

        for (u = 0; u < self->nunits; u++)
            if (strcmp(self->units[u].path, path) == 0) return u;
        if (self->nunits >= MAX_UNITS) {
            self->fail("too many units");
            return -1;
        }
        u = self->nunits;
        self->nunits++;
        if (snprintf(self->units[u].path, MAX_PATH, "%s", path) >= MAX_PATH) {
            self->fail("path is too long");
            return -1;
        }
        self->units[u].ndep = 0;
        self->units[u].prog = -1;
        self->units[u].digest = 0;
        self->units[u].ns[0] = 0;
        if (self->base_name(path, self->units[u].base, MAX_TEXT, &is_hdr) != 0) return -1;
        self->units[u].is_hdr = is_hdr;

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)self->lex->src;
        if (self->scan_imports(path) != 0) return -1;
        nrels = self->nrels;
        for (i = 0; i < nrels; i++) snprintf(rels[i], MAX_TEXT, "%s", self->rels[i]);
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path, rels[i], dep, sizeof dep, &is_hdr) != 0) return -1;
            d = self->load_unit(dep);
            if (d < 0) return -1;
            if (self->units[u].ndep >= MAX_IMPORTS) {
                self->fail("too many imports");
                return -1;
            }
            snprintf(self->units[u].dep[self->units[u].ndep], MAX_TEXT, "%s", self->units[d].base);
            self->units[u].depu[self->units[u].ndep] = d;
            self->units[u].ndep++;
        }

        self->lex->src = mysrc;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ns[0] = 0;
        self->ns_decl[0] = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->cur_func[0] = 0;
        self->nparams = 0;
        /* `scan_imports` counted this unit's imports into `rels`, but the
           recursive loads above left the counter at a dependency's value, and
           parsing skips the same `import` lines again -- start that pass from
           zero so a unit is never charged for its dependencies' imports. */
        self->nrels = 0;
        self->path = path;
        self->mem->path = self->path;
        ct_emit_set_path(self->path);
        self->units[u].fn_start = self->sym->nfunc;
        self->units[u].tr_start = self->sym->ntraits;
        self->units[u].call_start = self->ncalls;
        self->units[u].prog = self->parse_program();
        if (self->units[u].prog < 0) return -1;
        self->units[u].fn_end = self->sym->nfunc;
        self->units[u].tr_end = self->sym->ntraits;
        self->units[u].call_end = self->ncalls;
        snprintf(self->units[u].ns, MAX_TEXT, "%s", self->ns_decl);
        return u;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char rest[MAX_PATH];
        char dir[MAX_TEXT];
        char want[MAX_TEXT];
        const char *p;
        size_t rn, k, m;

        (void)self;
        if (!self->units[u].ns[0]) return 0;
        if (!self->nsroot || !self->nsroot[0]) return 0;
        rn = strlen(self->nsroot);
        if (strncmp(self->units[u].path, self->nsroot, rn) != 0) return 0;
        p = self->units[u].path + rn;
        if (*p == '/') p++;
        snprintf(rest, sizeof rest, "%s", p);
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        if (k >= sizeof dir) return self->fail("path is too long");
        snprintf(dir, sizeof dir, "%.*s", (int)k, rest);

        m = 0;
        for (k = 0; self->units[u].ns[k]; k++) {
            if (m + 1 >= sizeof want) return self->fail("namespace is too long");
            if (self->units[u].ns[k] == ':' && self->units[u].ns[k + 1] == ':') {
                want[m] = '/';
                m++;
                k++;
            } else {
                want[m] = self->units[u].ns[k];
                m++;
            }
        }
        want[m] = 0;
        if (strcmp(dir, want) != 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "namespace '%s' does not match the directory '%s'",
                     self->units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* `struct` starts either a definition (`struct S {`) or the return type of a
       function/global (`struct S *f();`). Peek with a lexer snapshot. */
    int struct_def_ahead(void)
    {
        int pos, bol, tok, is_def;
        long num;
        char text[MAX_TEXT];
        (void)self;

        pos = self->lex->pos;
        bol = self->lex->bol;
        tok = self->lex->tok;
        num = self->lex->toknum;
        snprintf(text, sizeof text, "%s", self->lex->toktext);
        self->lex_next();
        is_def = 0;
        if (self->lex->tok == T_ID) self->lex_next();
        /* a body (`{`) or a forward declaration (`;`) both start a CT struct */
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "{") == 0 || strcmp(self->lex->toktext, ";") == 0))
            is_def = 1;
        self->lex->pos = pos;
        self->lex->bol = bol;
        self->lex->tok = tok;
        self->lex->toknum = num;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", text);
        return is_def;
    }

    /* One top-level declaration; `pub` may lead it. */
    int parse_top_decl(int is_pub)
    {
        int n;
        (void)self;

        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "pub") == 0) {
            if (is_pub) return self->fail("duplicate 'pub'");
            self->lex_next();
            return self->parse_top_decl(1);
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "own") == 0)
            return ct_sem_error(self->lex->tokline, 1,
                "'own' is only allowed inside a function body", self->path);
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "typedef") == 0) {
            n = self->parse_typedef(is_pub);
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "trait") == 0) {
            n = self->parse_trait(is_pub);
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "impl") == 0) {
            n = self->parse_impl();
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "map") == 0) {
            n = self->parse_map();
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "struct") == 0
                   && self->struct_def_ahead()) {
            n = self->parse_struct_def();
            /* CT writes `struct X { ... }` bare (the old pipeline accepts both) */
            if (n >= 0) self->accept(";");
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0) {
            self->lex_next();
            n = self->parse_func(1, is_pub);
        } else {
            n = self->parse_func(0, is_pub);
        }
        if (n == NO_NODE) return NO_NODE;
        if (n < 0) return -1;
        self->arena->nodes[n].d = is_pub ? 1 : 0;
        return n;
    }

    /* `namespace A::B { ... }`: C has one global namespace, so declarations are
       stored under the `A_B_` prefix. Functions keep their names (the published
       rule), and the block itself emits nothing. */
    int parse_namespace(int prog)
    {
        char path[MAX_TEXT];
        char prefix[MAX_TEXT];
        char save[MAX_TEXT];
        size_t np, npre;
        int n;
        (void)self;

        self->lex_next();
        np = 0;
        npre = 0;
        path[0] = 0;
        prefix[0] = 0;
        for (;;) {
            if (self->lex->tok != T_ID) return self->fail("expected a namespace name");
            if (np > 0) {
                if (np + 2 >= sizeof path) return self->fail("namespace is too long");
                path[np] = ':';
                path[np + 1] = ':';
                np += 2;
                path[np] = 0;
            }
            if (np + strlen(self->lex->toktext) >= sizeof path) return self->fail("namespace is too long");
            snprintf(path + np, sizeof path - np, "%s", self->lex->toktext);
            np += strlen(self->lex->toktext);
            if (npre + strlen(self->lex->toktext) + 1 >= sizeof prefix)
                return self->fail("namespace is too long");
            snprintf(prefix + npre, sizeof prefix - npre, "%s_", self->lex->toktext);
            npre += strlen(self->lex->toktext) + 1;
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (!self->sym->ns[0]) snprintf(self->ns_decl, MAX_TEXT, "%s", path);
        if (self->expect("{") != 0) return -1;
        snprintf(save, sizeof save, "%s", self->sym->ns);
        if (snprintf(self->sym->ns, sizeof self->sym->ns, "%s%s", save, prefix) >= (int)sizeof self->sym->ns)
            return self->fail("namespace is too long");
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (self->lex->tok == T_PP) {
                n = self->new_node(N_PP);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->lex->toktext);
                if (self->append_node(prog, n) != 0) return -1;
                self->lex_next();
                continue;
            }
            n = self->parse_top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) return -1;
            if (self->append_node(prog, n) != 0) return -1;
        }
        if (self->expect("}") != 0) return -1;
        snprintf(self->sym->ns, sizeof self->sym->ns, "%s", save);
        return 0;
    }

    /* `map trait T for instance x { m(params) -> call; ... }` (Phase 11.1): binds a
       declared global instance's trait methods to concrete calls. The binding emits
       an instance-level wrapper plus a vtable; it is not wired into dispatch yet
       (that is 11.2), so the generated pair is static and self-contained. */
    int parse_map(void)
    {
        char tname[MAX_TEXT];
        char rtrait[MAX_TEXT];
        char inst[MAX_TEXT];
        char msg[MAX_TEXT];
        struct frontend_module_Map *m;
        struct frontend_module_MapBind *b;
        int line, ti, mi, np, k, i, j, n, q, depth, eof, long_call, c, bound;
        (void)self;

        line = self->lex->tokline;
        self->lex_next();                       /* consume `map` */
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "trait") == 0))
            return self->fail("expected 'trait'");
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a trait name");
        snprintf(tname, sizeof tname, "%s", self->lex->toktext);
        if (self->resolve_type(tname, rtrait, sizeof rtrait) != 0) return -1;
        ti = self->find_trait(rtrait);
        if (ti < 0) return self->fail("map of an unknown trait");
        self->lex_next();
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "for") == 0))
            return self->fail("expected 'for'");
        self->lex_next();
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "instance") == 0))
            return self->fail("expected 'instance'");
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected an instance name");
        snprintf(inst, sizeof inst, "%s", self->lex->toktext);
        if (self->find_var(inst) < 0) {
            snprintf(msg, sizeof msg, "map instance '%s' is not a declared variable", inst);
            return self->fail(msg);
        }
        self->lex_next();
        if (self->expect("{") != 0) return -1;
        if (self->nmaps >= MAX_MAPS) return self->fail("too many maps");
        m = &self->maps[self->nmaps];
        snprintf(m->trait, MAX_TEXT, "%s", rtrait);
        snprintf(m->inst, MAX_TEXT, "%s", inst);
        snprintf(m->vtable, MAX_TEXT, "%s_%s_vtable", inst, rtrait);
        m->nb = 0;
        m->line = line;
        m->unit = self->nunits - 1;

        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (m->nb >= MAX_METHODS) return self->fail("too many map bindings");
            b = &m->b[m->nb];
            b->line = self->lex->tokline;
            if (self->lex->tok != T_ID) return self->fail("expected a method name");
            snprintf(b->method, MAX_TEXT, "%s", self->lex->toktext);
            mi = -1;
            for (k = 0; k < self->sym->traits[ti].nm; k++)
                if (strcmp(self->sym->traits[ti].m[k].name, b->method) == 0) { mi = k; break; }
            if (mi < 0) {
                snprintf(msg, sizeof msg, "'%s' is not a method of trait '%s'",
                         b->method, rtrait);
                return self->fail(msg);
            }
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            np = 0;
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                for (;;) {
                    if (self->lex->tok != T_ID) return self->fail("expected a parameter name");
                    if (np >= MAX_PARAMS) return self->fail("too many map parameters");
                    snprintf(b->params[np], MAX_TEXT, "%s", self->lex->toktext);
                    np++;
                    self->lex_next();
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                        self->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->expect(")") != 0) return -1;
            b->nparams = np;
            if (np != self->sym->traits[ti].m[mi].nparams) {
                snprintf(msg, sizeof msg,
                         "map binding for '%s' takes %d parameter(s), the trait declares %d",
                         b->method, np, self->sym->traits[ti].m[mi].nparams);
                return self->fail(msg);
            }
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "->") == 0))
                return self->fail("expected '->'");
            /* Capture the RHS verbatim from self->lex->pos: no lex_next has run since the
               '->' token, so self->lex->pos sits just past it (the parse_init_raw trick). */
            i = self->lex->pos;
            n = 0;
            q = 0;
            depth = 0;
            eof = 0;
            long_call = 0;
            while (self->lex->src[i] == ' ' || self->lex->src[i] == '\t'
                   || self->lex->src[i] == '\n' || self->lex->src[i] == '\r') i++;
            for (;;) {
                c = (unsigned char)self->lex->src[i];
                if (c == 0) { eof = 1; break; }
                if (q == 0 && depth == 0 && c == ';') break;
                if (n + 1 >= MAX_TEXT) { long_call = 1; break; }
                if (q == 0 && (c == '"' || c == '\'')) {
                    q = c;
                } else if (q != 0 && c == q) {
                    q = 0;
                } else if (q != 0 && c == '\\' && self->lex->src[i + 1]) {
                    b->call[n] = (char)c; n++; i++;
                    c = (unsigned char)self->lex->src[i];
                } else if (q == 0 && c == '(') {
                    depth++;
                } else if (q == 0 && c == ')') {
                    depth--;
                }
                b->call[n] = (char)c; n++; i++;
            }
            if (eof) return self->fail("unterminated map call");
            if (long_call) return self->fail("map call is too long");
            while (n > 0 && (b->call[n - 1] == ' ' || b->call[n - 1] == '\t'
                             || b->call[n - 1] == '\n' || b->call[n - 1] == '\r')) n--;
            b->call[n] = 0;
            self->lex->pos = i;
            self->lex_next();
            if (self->map_check_call(b, inst) != 0) return -1;
            if (self->expect(";") != 0) return -1;
            snprintf(b->wrapper, MAX_TEXT, "%s_%s_%s", inst, rtrait, b->method);
            b->ti = ti;
            b->mi = mi;
            m->nb++;
        }
        if (self->expect("}") != 0) return -1;
        /* A map must bind every trait method exactly once: an unbound slot stays
           a null pointer (calling it crashes at run time), and a duplicate
           binding would emit the wrapper function twice (a C redefinition). */
        for (i = 0; i < m->nb; i++) {
            for (j = i + 1; j < m->nb; j++)
                if (strcmp(m->b[i].method, m->b[j].method) == 0) {
                    snprintf(msg, sizeof msg, "duplicate binding for method '%s'",
                             m->b[i].method);
                    return self->fail(msg);
                }
        }
        for (k = 0; k < self->sym->traits[ti].nm; k++) {
            bound = 0;
            for (i = 0; i < m->nb; i++)
                if (strcmp(m->b[i].method, self->sym->traits[ti].m[k].name) == 0) {
                    bound = 1;
                    break;
                }
            if (!bound) {
                snprintf(msg, sizeof msg, "trait method '%s' is not bound by the map",
                         self->sym->traits[ti].m[k].name);
                return self->fail(msg);
            }
        }
        self->nmaps++;
        return NO_NODE;
    }

    /* The subset check: the RHS must be one `f(args)` call whose every argument
       is a literal, a bare name, or a member path rooted at the instance. */
    int map_check_call(const struct frontend_module_MapBind *b, const char *inst)
    {
        char msg[MAX_TEXT];
        char arg[MAX_TEXT];
        char root[MAX_TEXT];
        const char *p;
        const char *w;
        int n, depth, k, ai, ok;
        int rl;
        int q;
        (void)self;

        p = b->call;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || *p == '_'))
            return self->fail("a map call must name a function");
        while ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
               || (*p >= '0' && *p <= '9') || *p == '_') p++;
        while (*p == ' ' || *p == '\t') p++;
        if (*p != '(') return self->fail("a map call must be a single call");
        p++;
        for (;;) {
            while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
            if (*p == ')') { p++; break; }
            if (!*p) return self->fail("unterminated map call");
            n = 0;
            depth = 0;
            while (*p) {
                if (depth == 0 && (*p == ',' || *p == ')')) break;
                if (*p == '"' || *p == '\'') {
                    q = *p;
                    if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                    arg[n] = (char)q; n++; p++;
                    while (*p && *p != (char)q) {
                        if (*p == '\\' && *(p + 1)) {
                            if (n + 2 >= MAX_TEXT) return self->fail("a map argument is too long");
                            arg[n] = *p; n++; p++;
                            arg[n] = *p; n++; p++;
                            continue;
                        }
                        if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                        arg[n] = *p; n++; p++;
                    }
                    if (*p != (char)q) return self->fail("unterminated literal in a map call");
                    if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                    arg[n] = *p; n++; p++;
                    continue;
                }
                if (*p == '(') depth++;
                else if (*p == ')') depth--;
                if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                arg[n] = *p; n++; p++;
            }
            arg[n] = 0;
            while (n > 0 && (arg[n - 1] == ' ' || arg[n - 1] == '\t'
                             || arg[n - 1] == '\n' || arg[n - 1] == '\r')) {
                n--;
                arg[n] = 0;
            }
            ai = 0;
            while (arg[ai] == ' ' || arg[ai] == '\t') ai++;
            /* A bare name must be visible here (a binding parameter, this map's
               instance, or a declared variable); a member path must be rooted at
               the instance. Anything else would name an unknown symbol in the
               emitted wrapper. */
            ok = 0;
            if (arg[ai] == '"' || arg[ai] == '\'') {
                ok = 1;
            } else if (arg[ai] >= '0' && arg[ai] <= '9') {
                ok = 1;
            } else {
                w = arg + ai;
                if (*w == '&') {
                    w++;
                    while (*w == ' ' || *w == '\t') w++;
                }
                rl = 0;
                if ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z') || *w == '_') {
                    while ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                           || (*w >= '0' && *w <= '9') || *w == '_') {
                        if (rl + 1 < MAX_TEXT) { root[rl] = *w; rl++; }
                        w++;
                    }
                    root[rl] = 0;
                    if (*w == '.' || (*w == '-' && *(w + 1) == '>')) {
                        ok = (strcmp(root, inst) == 0);
                        while (ok && (*w == '.' || (*w == '-' && *(w + 1) == '>'))) {
                            w += (*w == '.') ? 1 : 2;
                            if (!((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                                  || *w == '_'))
                                ok = 0;
                            while ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                                   || (*w >= '0' && *w <= '9') || *w == '_') w++;
                        }
                    } else if (strcmp(root, inst) == 0) {
                        ok = 1;
                    } else {
                        for (k = 0; k < b->nparams; k++)
                            if (strcmp(root, b->params[k]) == 0) { ok = 1; break; }
                        if (!ok && self->find_var(root) >= 0) ok = 1;
                    }
                    while (*w == ' ' || *w == '\t') w++;
                    if (*w) ok = 0;
                }
            }
            if (!ok) {
                snprintf(msg, sizeof msg, "map argument '%s' is not allowed", arg + ai);
                return self->fail(msg);
            }
            if (*p == ',') { p++; continue; }
            if (*p == ')') continue;
            return self->fail("unterminated map call");
        }
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        if (*p) return self->fail("trailing text after the map call");
        return 0;
    }

    /* Dependency-first order for the cache. `load_unit` assigns an importer its
       index before recursing, so unit indices are neither a topological order
       nor its reverse; this postorder DFS is (same shape as L2's `order[]`).
       The graph belongs to this layer, not to the cache. */
    int cache_order(int u, int *state, int *order, int *n)
    {
        int k;
        (void)self;
        if (state[u] != 0) return 0;
        state[u] = 1;
        for (k = 0; k < self->units[u].ndep; k++)
            if (self->cache_order(self->units[u].depu[k], state, order, n) != 0)
                return -1;
        state[u] = 2;
        order[*n] = u;
        (*n)++;
        return 0;
    }

    /* The key material of unit `u`: its import list as text and the folded
       dependency digest. The cache turns this into a stamped key; the module
       layer owns the graph, so the folding happens here. */
    int cache_key_of(int u, char *out, int cap)
    {
        char ih[MAX_IH];
        unsigned long dep;
        size_t n, k;
        int w;
        (void)self;

        n = 0;
        ih[0] = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++) {
            w = snprintf(ih + n, sizeof ih - n, "%s.h;", self->units[u].dep[k]);
            if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
            n += (size_t)w;
        }
        dep = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++)
            dep = dep * (unsigned long)1099511628211
                + self->units[self->units[u].depu[k]].digest;
        if (self->cache->key(self->units[u].path, ih, dep, self->line_force,
                             self->diag_json, self->nsroot, out, cap) != 0)
            return -1;
        /* the unit's own digest is what its dependants fold next */
        self->units[u].digest = self->cache->digest(out);
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        const char *inputs[MAX_UNITS];
        int ninput, i, u, o, cn;
        int dirty[MAX_UNITS];
        int cstate[MAX_UNITS];
        int corder[MAX_UNITS];
        const char *outdir;
        char root[MAX_PATH];
        (void)self;

        ninput = 0;
        outdir = NULL;
        self->ninc = 0;
        self->nsroot = NULL;
        self->line_mode = 1;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n",
                       self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, CTC_VERSION);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                outdir = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (self->ninc >= MAX_INCDIRS) {
                    fprintf(stderr, "ctc: too many -I roots\n");
                    return 1;
                }
                self->incdirs[self->ninc] = argv[i];
                self->ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                self->nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= MAX_UNITS) {
                fprintf(stderr, "ctc: too many inputs\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: %s build <input.ct>... -o <dir>\n", self->prog);
            return 1;
        }
        if (!outdir) {
            fprintf(stderr, "ctc: build needs -o <dir>\n");
            return 1;
        }
        if (snprintf(self->outdir, sizeof self->outdir, "%s", outdir) >= (int)sizeof self->outdir) {
            fprintf(stderr, "ctc: output directory is too long\n");
            return 1;
        }
        if (!self->nsroot) {
            if (self->path_dir(inputs[0], root, sizeof root) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
            self->nsroot = root;
        }

        self->nunits = 0;
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->nrels = 0;
        self->nparams = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->sym->ns[0] = 0;
        self->ns_decl[0] = 0;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        self->ncalls = 0;
        ct_diag_reset();
        self->cur_func[0] = 0;
        self->errmsg[0] = 0;
        self->build_mode = 1;

        for (i = 0; i < ninput; i++) {
            if (self->load_unit(inputs[i]) < 0) {
                if (ct_diag_nsem()) fprintf(stderr, "ctc: %d error(s) generated\n", ct_diag_nsem());
                else fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
        }
        /* Incremental cache (Phase 6.3, ported in 10.5): a unit whose key still
           matches and whose .c/.h are on disk is not regenerated. The walk is a
           dependency-first postorder, so a unit's key can fold its dependencies'
           digests; a unit whose dependency is dirty is dirty too. `--emit-map`
           never reuses, because the map spans the whole run. */
        for (u = 0; u < self->nunits; u++) cstate[u] = 0;
        cn = 0;
        for (u = 0; u < self->nunits; u++)
            if (self->cache_order(u, cstate, corder, &cn) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            int k;
            u = corder[o];
            dirty[u] = 1;
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    >= (int)sizeof outc) {
                fprintf(stderr, "ctc: output path is too long\n");
                return 1;
            }
            if (!self->have_map && self->cache_key_of(u, key, sizeof key) == 0
                && self->cache->hit(outc, key))
                dirty[u] = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (dirty[self->units[u].depu[k]]) dirty[u] = 1;
        }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            u = corder[o];
            if (!dirty[u]) continue;
            if (self->emit_unit(u) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
            if (self->write_unit_header(u) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
            /* stamped only after a successful emit: a failed unit must never be
               reused, and a stale key must never vouch for new sources */
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    < (int)sizeof outc
                && self->cache_key_of(u, key, sizeof key) == 0)
                self->cache->store(outc, key);
        }
        if (self->have_map && self->write_map(self->map_path, self->units[0].prog, 0) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        /* The command the user runs next, in the same shape L2 prints; the
           target C standard (Phase 6.4) is the only option it carries. */
        printf("cc %s", self->std_flag);
        for (u = 0; u < self->nunits; u++)
            printf(" %s/%s.c", self->outdir, self->units[u].base);
        printf(" -o a.out\n");
        if (ct_diag_emit(self->diag_json, 1) != 0) return 1;
        return 0;
    }

    /* The emitter (backend::emit) owns the code generation; these facades wrap
       the first raw failure with the current position, as the old bodies did. */
    int emit_program(int prog)
    {
        const char *why;
        if (ct_emit_program(prog) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int emit_unit(int u)
    {
        const char *why;
        if (ct_emit_unit(u) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_unit_header(int u)
    {
        const char *why;
        if (ct_emit_unit_header(u) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_header(const char *outc)
    {
        const char *why;
        if (ct_emit_header(outc) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        const char *why;
        if (ct_emit_map(dest, prog, u) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }
}

/* Error recovery: the two token-skipping helpers. Everything that stores a
   diagnostic now lives in diag.ct. */
impl RecoverOps for Ast {
    /* Skip a balanced `{ ... }` group (the lexer sits on its `{`) so a rejected
       construct does not swallow the declarations that follow it. */
    int skip_body(void)
    {
        int depth;
        (void)self;
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "{") != 0)
            return self->fail("expected '{'");
        depth = 0;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                depth++;
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0) {
                depth--;
                if (depth == 0) {
                    self->lex_next();
                    return 0;
                }
            }
            self->lex_next();
        }
        return self->fail("unterminated body");
    }

    /* Resynchronisation after a reported error: stop past the next `}` or at the
       start of the next line, whichever comes first (L2's recover_pos). */
    int skip_after_error(void)
    {
        (void)self;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0) {
                self->lex_next();
                return 0;
            }
            self->lex_next();
            if (self->lex->bol) return 0;
        }
        return 0;
    }
}

/* The analysis itself lives in backend::mem; this facade keeps the trait the
   parser already calls and wraps the methods that can fail with the current
   position, exactly as the old bodies did. */
impl MemoryOps for Ast {
    int mark_owned(int n, int line)
    {
        if (self->mem->mark_owned(n, line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int expr_alloc(int e)
    {
        return self->mem->expr_alloc(e);
    }

    int expr_mentions(int e, const char *name)
    {
        return self->mem->expr_mentions(e, name);
    }

    int expr_returns(int e, const char *name)
    {
        return self->mem->expr_returns(e, name);
    }

    int ret_same_struct(const char *ret, int si)
    {
        return self->mem->ret_same_struct(ret, si);
    }

    int leak_decl(int n)
    {
        return self->mem->leak_decl(n);
    }

    int leak_scope(int from, int to)
    {
        if (self->mem->leak_scope(from, to) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_assign(int n)
    {
        return self->mem->leak_assign(n);
    }

    int leak_return(int ret, int conditional, int line)
    {
        if (self->mem->leak_return(ret, conditional, line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_delete(int e)
    {
        return self->mem->leak_delete(e);
    }

    int warn_leak(int vi, int path_line)
    {
        if (self->mem->warn_leak(vi, path_line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Ast g_ast;

int main(int argc, char **argv)
{
    const char *base;

    /* Run-option defaults: the struct is zero-initialised, so the two values
       that are not 0/off are seeded here, the one place that owns the process. */
    g_ast.prog = "ct-ast";
    g_ast.line_force = -1;
    g_ast.std_flag = "-std=c99";
    /* the node and literal pools live in runtime::arena; point the object at its
       singleton before anything can build a node */
    g_ast.arena = arena_get();
    /* likewise the source cursor and the current token */
    g_ast.lex = lexer_get();
    /* the cache keys carry the compiler version; seed it once here */
    g_ast.cache = cache_get();
    g_ast.cache->version = CTC_VERSION;
    /* the symbol tables live in frontend::sym; point the object at its singleton */
    g_ast.sym = symbols_get();
    /* the memory analysis (backend::mem) reads both through the driver */
    g_ast.mem = memory_get();
    g_ast.mem->arena = g_ast.arena;
    g_ast.mem->sym = g_ast.sym;
    /* static typing and boxing (frontend::type) read the same tables */
    g_ast.ty = type_get();
    g_ast.ty->arena = g_ast.arena;
    g_ast.ty->sym = g_ast.sym;
    g_ast.ty->lex = g_ast.lex;
    g_ast.ty->maps = g_ast.maps;
    g_ast.ty->nmaps = &g_ast.nmaps;

    base = strrchr(argv[0], '/');
    base = base ? base + 1 : argv[0];
    if (strcmp(base, "ct") == 0) g_ast.prog = "ct";
    else if (strcmp(base, "ctc") == 0) g_ast.prog = "ctc";
    /* the emitter (backend::emit) reads the same collaborators, the module
       tables, the options and the version; `out`/`path` follow through the
       setters as the driver re-points them. Bind after the entry-name branch
       because `prog` is part of the wired state. */
    ct_emit_bind(g_ast.arena, g_ast.sym, g_ast.ty, g_ast.lex, CTC_VERSION, g_ast.outdir, g_ast.prog);
    ct_emit_bind_tables(g_ast.units, &g_ast.nunits, g_ast.maps, &g_ast.nmaps, g_ast.calls, &g_ast.ncalls, &g_ast.build_mode, &g_ast.line_mode);
    ct_emit_bind_parse(&g_ast.nparams, g_ast.pend_fields, &g_ast.npend);
    /* Phase 8 (ported in 10.6): the package subcommands live in their own unit
       and never reach the compile core; only primitives cross the boundary */
    if (argc > 1 && strcmp(argv[1], "get") == 0)
        return ct_pkg_get(argc - 2, argv + 2, g_ast.prog, CTC_VERSION);
    if (argc > 1 && strcmp(argv[1], "install") == 0)
        return ct_pkg_install(argc - 2, argv + 2, g_ast.prog, CTC_VERSION);
    return g_ast.run(argc, argv);
}
