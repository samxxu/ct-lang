/*
 * main.ct - Phase 9: the AST compiler.
 *
 * 9.1 proved the pipe (lexer -> parser -> AST -> C). 9.2 added statements,
 * control flow and signatures. 9.3 added the declaration layer, 9.4 traits and
 * interface values, and 9.5a the module layer:
 *
 *   - `build` mode: one `.c` + `.h` per unit, imports resolved recursively
 *   - `import a::b;` (the importing file's directory first, then `-I` roots)
 *   - `pub` routing: exported traits/structs/typedefs/prototypes land in `.h`
 *   - `namespace A::B { ... }` plus `--ns-root` directory validation
 *   - metadata: `#line` (`--line` / `--no-line`) and `--emit-map`
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one dispatch per
 * concern). Symbol tables follow D33: functions, variables and types are
 * separate flat tables; only variables are scoped.
 *
 * Output contract: banner, `<base>.h` guard and a self-contained `.c`; byte
 * equality with the old pipeline is not required (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
import tool::pkg::pkg;
import tool::diag::diag;
import runtime::arena::arena;
import frontend::lex::lexer;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
/* the incremental cache stamps each unit with `stat` and creates `.ctcache`
   with `mkdir` (Phase 6.3, ported in 10.5) */
#include <sys/stat.h>

#define CTC_VERSION "0.12.0"

/* Capacity: the caps below were sized for the Phase 0 corpus; the old user-facing
   numbers (16 traits, 32 structs, 64 functions) stopped real programs. They stay
   fixed-size -- overflow is still a hard error -- but the numbers no longer bind.
   The node pool and the string-literal pool moved to `runtime::arena`, so their
   caps (65536 nodes, 256 KiB of literals) live on that class now. */
#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_FUNCS  256
#define MAX_PARAMS 16
#define MAX_VARS   4096
#define MAX_SCOPE  256
#define MAX_TYPES  256
#define MAX_TRAITS 64
#define MAX_METHODS 64
#define MAX_STRUCTS 128
#define MAX_FIELDS 64
#define MAX_UNITS  64
#define MAX_IMPORTS 16
#define MAX_INCDIRS 16
#define MAX_CALLS  1024
#define MAX_MAPS   64
#define MAX_ERRORS 20                   /* recovery cap: past this the compiler stops */
#define MAX_KEY    768                  /* one unit's incremental-cache key */
#define MAX_IH     2560                 /* MAX_IMPORTS * MAX_TEXT, spelled out */
/* the package manager (Phase 8, ported in 10.6) */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   512
#define MAX_PKG_DEPTH  8
#define MAX_PKG_CMD    2048
#define MAX_LOCK       4096             /* MAX_PKG_PATH * 8, spelled out */
#define MAX_PKG_LINE   1024             /* MAX_PKG_PATH * 2, spelled out */

/* node kinds (D32: one tag, one dispatch) */
#define N_PROG    1
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_PARAM   19
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_METHOD  29
#define N_MCALL   30
#define N_RAW     31
#define N_TRAIT   32
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41

/* token kinds */
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

/* binary operators (stored in `aux`) */
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13
#define B_XOR 14

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define P_INC 1
#define P_DEC 2

/* `parse_func` returns this when the declaration was a prototype (no node). */
#define NO_NODE (-2)

/* `Node` and the two pools now live in `runtime::arena`; this unit holds a
   pointer to the arena singleton and works through it. */

typedef struct Fn {
    char name[MAX_TEXT];
    char ret[MAX_TEXT];
    char ptype[MAX_PARAMS][MAX_TEXT];
    /* array dims are kept apart from the type: the prototype must spell them
       (`int f(Expr a[])` vs `int f(Expr a)` are conflicting types), while the
       call side still compares bare types for boxing */
    char pdim[MAX_PARAMS][MAX_TEXT];
    int  nparams;
    int  is_static;
    int  is_pub;
    int  line;
    int  ret_owned;     /* 1 when it may hand back an allocation it owns (10.3) */
} Fn;

typedef struct Var {
    char name[MAX_TEXT];
    char type[MAX_TEXT];
    /* an array's declared type carries no star of its own, but `T *a[N]` and
       `T *p` spell the same type; indexing tells them apart only through this */
    int  is_array;
    /* leak tracking (10.3), mirroring L2's conservative rules */
    int  st;            /* struct index when the type is `struct T *`, else -1 */
    int  owned;         /* 1 when a heap object (malloc/calloc/owned callee) */
    int  own_line;      /* source line of that allocation */
    int  autodrop;      /* 1 when declared `own`: release at scope exit */
    int  path_warned;   /* 1 once reported as possibly leaking on a return path */
} Var;

typedef struct MethodSig {
    char name[MAX_TEXT];
    char ret[MAX_TEXT];
    char ptype[MAX_PARAMS][MAX_TEXT];
    int  nparams;
} MethodSig;

typedef struct Trait {
    char name[MAX_TEXT];
    MethodSig m[MAX_METHODS];
    int  nm;
    int  is_pub;
    int  line;
} Trait;

typedef struct Field {
    char name[MAX_TEXT];
    char type[MAX_TEXT];
    /* array dims (`[2]`, `[N]`): a designated initialiser cannot reach an
       element, so such a field's vptrs are written by a loop instead */
    char dims[MAX_TEXT];
} Field;

typedef struct StructDef {
    char name[MAX_TEXT];
    char use[MAX_TRAITS][MAX_TEXT];
    int  nuse;
    /* field types: a receiver chain (`s.owner.greet()`) needs them, and so does
       the nested vptr initialiser of a struct-typed field */
    Field fields[MAX_FIELDS];
    int  nfields;
    int  defined;               /* a body was parsed; a forward declaration is not */
    int  uses_drop;             /* built-in `Drop`: no vptr, no vtable, `delete` calls it */
} StructDef;

/* One translation unit of a `build`: its source, output base, declared
   namespace and the exported names of the units it imports. */
typedef struct Unit {
    char path[MAX_PATH];
    char base[MAX_TEXT];
    char ns[MAX_TEXT];
    char dep[MAX_IMPORTS][MAX_TEXT];
    int  depu[MAX_IMPORTS];     /* the dependency's unit index (cache folding) */
    int  ndep;
    int  prog;
    int  is_hdr;
    int  fn_start;
    int  fn_end;
    int  tr_start;
    int  tr_end;
    int  call_start;
    int  call_end;
    unsigned long digest;       /* this unit's key digest (10.5) */
} Unit;

/* One `callee(...)` in a function body, for the map's call graph. */
typedef struct Call {
    char caller[MAX_TEXT];
    char callee[MAX_TEXT];
    int  line;
} Call;

/* One `method(params) -> call` inside a `map` block (Phase 11.1). */
typedef struct MapBind {
    char method[MAX_TEXT];                  /* trait method name */
    char params[MAX_PARAMS][MAX_TEXT];      /* CT-side parameter names, from the map's () */
    int  nparams;
    int  ti;                                /* index into self->traits */
    int  mi;                                /* index into that trait's m[] */
    char call[MAX_TEXT];                    /* raw, validated RHS text (no trailing ';') */
    char wrapper[MAX_TEXT];                 /* "<inst>_<Trait>_<method>" */
    int  line;
} MapBind;

/* `map trait T for instance x { ... }`: binds trait methods to a global instance. */
typedef struct Map {
    char trait[MAX_TEXT];
    char inst[MAX_TEXT];
    char vtable[MAX_TEXT];                  /* "<inst>_<Trait>_vtable" */
    MapBind b[MAX_METHODS];
    int  nb;
    int  line;
    int  unit;                              /* the unit that declared this map */
} Map;

/* An rvalue receiver (`f().m()`) is hoisted into a temp so the call is
   evaluated once; the declarations are flushed before the statement. */
#define MAX_HOISTS 4

/* The entry name and the run options live on the `Ast` object now; see the
   fields below. `main` seeds the defaults before dispatching. */

/* Collected warnings and the semantic-error counter live in diag.ct; this unit
   only reaches them through the primitive wrappers declared there. */

/* AutoDrop (Phase 5, landed here in 10.3) and the leak analysis (10.3) keep
   their state on the `Ast` object: every scope records where its `own`
   declarations start, and the leak pass runs only while a function or method
   body is being parsed. See the fields below. */

trait AstOps {
    int  new_node(int kind);
    int  fail(const char *msg);
    void lex_next(void);
    int  accept(const char *p);
    int  expect(const char *p);
    int  read_file(const char *path);
    int  default_output(const char *in, char *out, size_t cap);
    int  run(int argc, char **argv);
}

trait SymOps {
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name, const char *type);
    int  find_var(const char *name);
    int  var_type(const char *name, char *out, size_t cap);
    int  find_func(const char *name);
    int  add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param);
    int  find_type(const char *name);
    int  add_type(const char *name, int kind);
    int  find_struct(const char *name);
    int  add_struct(const char *name);
    int  find_trait(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, size_t tcap);
    int  ns_decl_name(const char *name, char *out, size_t cap);
    int  resolve_type(const char *name, char *out, size_t cap);
    int  record_call(const char *callee, int line);
}

trait ParseOps {
    int  is_type_word(const char *w);
    int  type_append(char *out, size_t cap, size_t *n, const char *tok);
    int  parse_type(char *out, size_t cap);
    int  parse_array_dims(int n);
    int  next_is_type_name(void);
    int  parse_program(void);
    int  parse_func(int is_static, int is_pub);
    int  parse_params(void);
    int  parse_struct_def(void);
    int  parse_typedef(int is_pub);
    int  parse_field_def(void);
    int  parse_block(void);
    int  parse_stmt(void);
    int  parse_branch(void);
    int  parse_decl_node(void);
    int  parse_expr_stmt_node(void);
    int  parse_expr(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  parse_trait(int is_pub);
    int  parse_impl(void);
    int  parse_use_list(int sindex);
    int  parse_init_raw(char *out, size_t cap);
}

/* Static type queries and boxing. Split out of ParseOps: none of this is
   parsing, and ParseOps already sits at MAX_METHOD. */
trait TypeOps {
    int  is_iface_type(const char *type, char *tout, size_t tcap);
    int  iface_ref_type(const char *type, char *tout, size_t tcap, int *is_ptr);
    int  concrete_struct(const char *type, char *sout, size_t scap, int *is_ptr);
    int  expr_type(int n, char *out, size_t cap);
    int  maybe_box(int n, const char *trait, int addr);
    int  type_has_array_init(const char *type);
    int  init_item_text(const char *stype, const char *item, char *out, size_t cap);
    int  rewrite_init_text(const char *stype, const char *raw, char *out, size_t cap);
}

/* Build-mode driving: path handling, import resolution, unit loading and the
   namespace/directory check. Kept apart from ParseOps to leave the parser room
   to grow under MAX_METHOD. */
trait ModuleOps {
    int  base_name(const char *path, char *out, size_t cap, int *is_hdr);
    int  path_dir(const char *path, char *out, size_t cap);
    int  append_node(int prog, int n);
    int  skip_import(void);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr);
    int  load_unit(const char *path);
    int  check_ns_dir(int u);
    int  parse_top_decl(int is_pub);
    int  parse_namespace(int prog);
    int  parse_map(void);
    int  map_check_call(const MapBind *b, const char *inst);
    int  struct_def_ahead(void);
    int  build_main(int argc, char **argv);
}

trait EmitOps {
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  emit_struct_fwd(void);
    int  emit_trait_range(int start, int end, int mode);
    int  emit_proto(int i);
    int  emit_vtable_fwd(int prog);
    int  header_guard(const char *base, char *out, size_t cap);
    int  write_map(const char *dest, int prog, int u);
    int  emit_json_str(FILE *f, const char *s);
    int  emit_node(int n, int ind);
    int  emit_inline(int n);
    int  emit_expr(int n);
    int  hoist_rvalue(int n);
    int  hoist_scan(int n);
    int  emit_hoists(int ind);
    int  emit_cond(int n);
    int  emit_indent(int n);
    int  emit_type_decl(int n, int ind, int with_semi);
    int  emit_trait_decls(void);
    int  emit_impls(int prog);
    int  emit_maps(int u);
    int  type_has_vptr(const char *type);
    int  type_needs_init(const char *type);
    int  emit_vptr_items(const char *prefix, const char *type);
    int  emit_field_vptrs(int si, int started);
    int  emit_array_field_vptrs(int si, const char *recv, int ind);
    int  emit_vptr_stmts(const char *recv, const char *type, int ind);
    int  emit_unit_init(int prog);
    int  emit_raw_init(int raw, const char *type);
    int  write_header(const char *outc);
}

/* Error recovery (Phase 10.4). A separate trait because `ParseOps` is at the
   MAX_METHOD ceiling and these are not parsing concerns. Everything that
   *stores* a diagnostic lives in diag.ct now. */
trait RecoverOps {
    int  skip_body(void);
    int  skip_after_error(void);
}

/* Memory semantics (Phase 10.3): `own` registration plus the leak analysis.
   The rules are deliberately the conservative ones L2 uses (D40), so the
   warnings match its output byte for byte. */
trait MemoryOps {
    int  mark_owned(int n, int line);
    int  expr_alloc(int e);
    int  expr_mentions(int e, const char *name);
    int  expr_returns(int e, const char *name);
    int  ret_same_struct(const char *ret, int si);
    int  leak_decl(int n);
    int  leak_scope(int from, int to);
    int  leak_assign(int n);
    int  leak_return(int ret, int conditional, int line);
    int  leak_delete(int e);
    int  warn_leak(int vi, int path_line);
}

/* Incremental build cache (Phase 6.3, ported in 10.5). The key is a function of
   the compiler version, the run's options and the unit's path, stamp, imports
   and dependency digests -- the same spelling L2 writes (D41). */
trait CacheOps {
    unsigned long cache_digest(const char *s);
    int  cache_order(int u, int *state, int *order, int *n);
    int  cache_key(int u, char *out, size_t cap);
    int  cache_paths(const char *outc, char *dir, size_t dcap,
                     char *kf, size_t kcap);
    int  cache_hit(const char *outc, const char *key);
    void cache_store(const char *outc, const char *key);
}


/* The struct carries the output, lexer and memory-analysis state so those
   methods are real OO methods on the object rather than free functions over
   file-scope globals; the remaining tables stay file-scope until their own
   slices land. */
struct Ast {
    int nerr;
    /* Output state for one run: where emitted C goes, the source path the banner
       and diagnostics report, and the last parse/run error message. The driver
       re-points `path` for each unit in build mode. */
    FILE *out;
    const char *path;
    char errmsg[MAX_TEXT];
    /* The node pool and the literal pool live in runtime::arena; the driver
       points this at that singleton before it dispatches to `run`. */
    struct runtime_arena_Arena *arena;
    /* The source cursor and the current token live in frontend::lex; the driver
       points this at that singleton before it dispatches to `run`. */
    struct frontend_lex_Lexer *lex;
    /* Symbol tables of the unit being compiled: functions, locals and scopes,
       type tags, traits and structs, plus the impl/return context the parser
       threads through. The driver resets them per unit. */
    Fn   funcs[MAX_FUNCS];
    int  nfunc;
    Var  vars[MAX_VARS];
    int  nvar;
    int  scope[MAX_SCOPE];
    int  nscope;
    char types[MAX_TYPES][MAX_TEXT];
    int  type_kind[MAX_TYPES];  /* 1 = struct tag, 2 = typedef */
    int  ntype;
    Trait traits[MAX_TRAITS];
    int  ntraits;
    StructDef structs[MAX_STRUCTS];
    int  nstructs;
    int  self_mode;             /* inside an impl body: `self` -> `_self` */
    char ret_type[MAX_TEXT];    /* return type of the function being parsed */
    /* Build mode: the unit table, the import search roots and the current
       namespace prefix, plus the calls and maps collected for the JSON map.
       The driver fills these before a build and reads them while emitting. */
    Unit units[MAX_UNITS];
    int  nunits;
    int  build_mode;
    char ns[MAX_TEXT];          /* current namespace prefix, e.g. "hal_" */
    char ns_decl[MAX_TEXT];     /* namespace path declared by the current unit */
    char outdir[MAX_PATH];
    const char *incdirs[MAX_INCDIRS];
    int  ninc;
    const char *nsroot;
    char rels[MAX_IMPORTS][MAX_TEXT];  /* import paths seen by the scanner */
    int  nrels;
    Call calls[MAX_CALLS];
    int  ncalls;
    Map  maps[MAX_MAPS];
    int  nmaps;
    char cur_func[MAX_TEXT];    /* caller recorded for the map */
    /* Run options. `prog` is the entry name `-v` and the usage lines print
       (D44): `ct` when installed under that name, `ctc` for the compatibility
       alias, `ct-ast` for the development binary. Driver diagnostics keep the
       published `ctc:` prefix (SH-3 / phase10 non-goal), so logs and assertions
       do not move when the entry name changes. */
    int  line_mode;             /* emit `#line`: 0 off, 1 on */
    int  line_force;            /* -1 mode default, 0 --no-line, 1 --line */
    char map_path[MAX_PATH];
    int  have_map;
    const char *prog;
    int  diag_json;             /* --diagnostics=json */
    const char *std_flag;       /* --std=c99 | --std=gnu99 */
    /* Emission scratch: hoisted rvalue temporaries (MAX_HOISTS) and the fields
       of an untagged `typedef struct { ... }` parked until the alias exists. */
    int  nparams;
    Field pend_fields[MAX_FIELDS];
    int  npend;
    int  hoist_calls[MAX_HOISTS];
    int  nhoist;
    int  ntmp;
    int  raw_call;              /* emit this call, not its temp name */
    /* AutoDrop: where each scope's `own` declarations start */
    int own_decl[MAX_VARS];
    int nowner;
    int own_base[MAX_SCOPE];
    /* Leak analysis, active only inside a function or method body. `leak_frame`
       is the body's own scope number -- a return in a deeper block is
       conditional. `ret_owned` is the current function's ownership hint. */
    int leak_active;
    int leak_frame;
    int leak_impl;              /* 1 while parsing an impl method body */
    int ret_owned;
} use AstOps, SymOps, ParseOps, TypeOps, ModuleOps, EmitOps, RecoverOps, MemoryOps,
    CacheOps;

impl AstOps for Ast {
    /* The pool owns the storage and the reset of a fresh node; the line number
       comes from the lexer and the overflow diagnostic from this object, so both
       stay here. */
    int new_node(int kind)
    {
        int n = self->arena->alloc(kind, self->lex->tokline);
        if (n < 0) return self->fail("too many AST nodes");
        return n;
    }

    int fail(const char *msg)
    {
        (void)self;
        /* the line and the offending token are the two things a self-hosting
           run needs to locate a gap; diagnostics are not compared (D34) */
        if (!self->errmsg[0])
            snprintf(self->errmsg, sizeof self->errmsg, "line %d: %s (at '%s')", self->lex->tokline, msg, self->lex->toktext);
        return -1;
    }

    /* The characters are frontend::lex's business; the parser only asks for the
       next token. */
    void lex_next(void)
    {
        (void)self;
        self->lex->next();
    }

    int accept(const char *p)
    {
        (void)self;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, p) == 0) {
            self->lex_next();
            return 1;
        }
        return 0;
    }

    int expect(const char *p)
    {
        (void)self;
        if (self->accept(p)) return 0;
        return self->fail("unexpected token");
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        (void)self;
        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        self->lex->src = buf;
        return 0;
    }

    int default_output(const char *in, char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0) {
            if (snprintf(out, cap, "%.*s.c", (int)(n - 3), in) >= (int)cap) return -1;
            return 0;
        }
        if (snprintf(out, cap, "%s.c", in) >= (int)cap) return -1;
        return 0;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        const char *out;
        char outbuf[MAX_PATH];
        int i, prog;
        FILE *f;

        in = NULL;
        out = NULL;
        if (argc > 1 && strcmp(argv[1], "build") == 0)
            return self->build_main(argc - 1, argv + 1);
        self->build_mode = 0;
        self->line_mode = 0;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s <input.ct> [-o <output.c>] [-I <dir>] [--line|--no-line]\n"
                       "              [--emit-map <file|->] [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s get <spec>[@<range>]\n"
                       "       %s install\n",
                       self->prog, self->prog, self->prog, self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, CTC_VERSION);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;   /* accepted for CLI parity; compile mode resolves no imports */
                continue;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: %s <input.ct> [-o <output.c>]\n", self->prog);
            return 1;
        }
        if (!out) {
            if (self->default_output(in, outbuf, sizeof outbuf) != 0) {
                fprintf(stderr, "ctc: output path too long\n");
                return 1;
            }
            out = outbuf;
        }

        self->path = in;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        ct_diag_reset();
        self->arena->reset();
        self->nfunc = 0;
        self->nvar = 0;
        self->nscope = 0;
        self->nowner = 0;
        self->leak_active = 0;
        self->leak_frame = -1;
        self->leak_impl = 0;
        self->ret_owned = 0;
        self->ntype = 0;
        self->ntraits = 0;
        self->nstructs = 0;
        self->self_mode = 0;
        self->nparams = 0;
        self->ncalls = 0;
        self->cur_func[0] = 0;
        self->errmsg[0] = 0;
        if (self->read_file(in) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        prog = self->parse_program();
        if (prog < 0) {
            if (ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", ct_diag_nsem());
                return 1;
            }
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        self->out = f;
        fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, self->path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              self->out);
        if (self->line_mode) fprintf(self->out, "#line 1 \"%s\"\n", self->path);
        if (self->emit_program(prog) != 0) {
            fclose(f);
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        if (self->write_header(out) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        if (self->have_map && self->write_map(self->map_path, prog, -1) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        if (ct_diag_emit(self->diag_json, 0) != 0) return 1;
        return 0;
    }
}

impl SymOps for Ast {
    int push_scope(void)
    {
        (void)self;
        if (self->nscope >= MAX_SCOPE) return self->fail("too many nested scopes");
        self->scope[self->nscope] = self->nvar;
        self->own_base[self->nscope] = self->nowner;
        self->nscope++;
        return 0;
    }

    int pop_scope(void)
    {
        (void)self;
        if (self->nscope <= 0) return self->fail("scope stack underflow");
        self->nscope--;
        self->nvar = self->scope[self->nscope];
        self->nowner = self->own_base[self->nscope];
        return 0;
    }

    int declare_var(const char *name, const char *type)
    {
        int i;
        (void)self;
        if (self->nvar >= MAX_VARS) return self->fail("too many variables");
        i = self->nvar;
        snprintf(self->vars[i].name, MAX_TEXT, "%s", name);
        snprintf(self->vars[i].type, MAX_TEXT, "%s", type);
        self->vars[i].is_array = 0;
        self->vars[i].st = -1;
        self->vars[i].owned = 0;
        self->vars[i].own_line = 0;
        self->vars[i].autodrop = 0;
        self->vars[i].path_warned = 0;
        self->nvar++;
        return 0;
    }

    int find_var(const char *name)
    {
        int i;
        (void)self;
        for (i = self->nvar - 1; i >= 0; i--)
            if (strcmp(self->vars[i].name, name) == 0) return i;
        return -1;
    }

    int var_type(const char *name, char *out, size_t cap)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        if (i < 0) return -1;
        if (snprintf(out, cap, "%s", self->vars[i].type) >= (int)cap) return -1;
        return 0;
    }

    int find_func(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nfunc; i++)
            if (strcmp(self->funcs[i].name, name) == 0) return i;
        return -1;
    }

    /* A prototype followed by its definition updates the same entry. `pub` on
       either declaration exports the prototype to the unit header. */
    int add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param)
    {
        int i, k, p;
        (void)self;

        i = self->find_func(name);
        if (i < 0) {
            if (self->nfunc >= MAX_FUNCS) return self->fail("too many functions");
            i = self->nfunc;
            self->nfunc++;
            snprintf(self->funcs[i].name, MAX_TEXT, "%s", name);
            self->funcs[i].is_pub = 0;
            self->funcs[i].ret_owned = 0;   /* fresh row: no ownership fact yet */
        }
        if (is_pub) self->funcs[i].is_pub = 1;
        snprintf(self->funcs[i].ret, MAX_TEXT, "%s", ret);
        self->funcs[i].is_static = is_static;
        self->funcs[i].nparams = 0;
        p = first_param;
        k = 0;
        while (p > 0 && k < MAX_PARAMS) {
            snprintf(self->funcs[i].ptype[k], MAX_TEXT, "%s", self->arena->nodes[p].text);
            snprintf(self->funcs[i].pdim[k], MAX_TEXT, "%s", self->arena->nodes[p].text3);
            k++;
            p = self->arena->nodes[p].next;
        }
        if (k >= MAX_PARAMS && p > 0) return self->fail("too many parameters");
        self->funcs[i].nparams = k;
        return i;
    }

    int find_type(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->ntype; i++)
            if (strcmp(self->types[i], name) == 0) return i;
        return -1;
    }

    int add_type(const char *name, int kind)
    {
        int i;
        (void)self;
        i = self->find_type(name);
        if (i >= 0) {
            /* a struct tag discovered while parsing a type keeps its kind */
            if (self->type_kind[i] == 0) self->type_kind[i] = kind;
            return 0;
        }
        if (self->ntype >= MAX_TYPES) return self->fail("too many types");
        snprintf(self->types[self->ntype], MAX_TEXT, "%s", name);
        self->type_kind[self->ntype] = kind;
        self->ntype++;
        return 0;
    }

    int find_struct(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nstructs; i++)
            if (strcmp(self->structs[i].name, name) == 0) return i;
        return -1;
    }

    int add_struct(const char *name)
    {
        int i;
        (void)self;
        if (!name[0]) return -1;
        i = self->find_struct(name);
        if (i >= 0) return i;
        if (self->nstructs >= MAX_STRUCTS) return self->fail("too many structs");
        snprintf(self->structs[self->nstructs].name, MAX_TEXT, "%s", name);
        self->structs[self->nstructs].nuse = 0;
        self->structs[self->nstructs].uses_drop = 0;
        self->nstructs++;
        return self->nstructs - 1;
    }

    int find_trait(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->ntraits; i++)
            if (strcmp(self->traits[i].name, name) == 0) return i;
        return -1;
    }

    int add_trait(const char *name)
    {
        int i;
        (void)self;
        i = self->find_trait(name);
        if (i >= 0) return i;
        if (self->ntraits >= MAX_TRAITS) return self->fail("too many traits");
        snprintf(self->traits[self->ntraits].name, MAX_TEXT, "%s", name);
        self->traits[self->ntraits].nm = 0;
        self->ntraits++;
        return self->ntraits - 1;
    }

    /* Which trait of `stype` declares `method`: the vtable field name and the
       dispatch target both need it. `stype` may carry a `struct ` prefix or a
       trailing `*` (a pointer receiver). */
    int method_trait(const char *stype, const char *method, char *tout, size_t tcap)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        int s, ti, mi;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", stype) >= (int)sizeof buf) return -1;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            base[n - 1] = 0;
            n--;
        }
        s = self->find_struct(base);
        if (s < 0) return -1;
        for (ti = 0; ti < self->structs[s].nuse; ti++) {
            int t = self->find_trait(self->structs[s].use[ti]);
            if (t < 0) continue;
            for (mi = 0; mi < self->traits[t].nm; mi++) {
                if (strcmp(self->traits[t].m[mi].name, method) == 0) {
                    if (snprintf(tout, tcap, "%s", self->traits[t].name) >= (int)tcap) return -1;
                    return 0;
                }
            }
        }
        return -1;
    }

    /* A declaration inside `namespace A::B` is stored under its C name,
       `A_B_<name>`; the top level adds no prefix. */
    int ns_decl_name(const char *name, char *out, size_t cap)
    {
        (void)self;
        if (snprintf(out, cap, "%s%s", self->ns, name) >= (int)cap)
            return self->fail("name is too long");
        return 0;
    }

    /* Unqualified lookup: the current namespace first, then the top level. */
    int resolve_type(const char *name, char *out, size_t cap)
    {
        char qname[MAX_TEXT];
        (void)self;

        if (self->ns[0]) {
            if (snprintf(qname, sizeof qname, "%s%s", self->ns, name) >= (int)sizeof qname)
                return self->fail("name is too long");
            if (self->find_type(qname) >= 0 || self->find_trait(qname) >= 0
                || self->find_struct(qname) >= 0) {
                if (snprintf(out, cap, "%s", qname) >= (int)cap)
                    return self->fail("name is too long");
                return 0;
            }
        }
        if (snprintf(out, cap, "%s", name) >= (int)cap)
            return self->fail("name is too long");
        return 0;
    }

    /* Remember `callee(...)` inside the function currently being parsed. */
    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!self->cur_func[0]) return 0;
        if (self->ncalls >= MAX_CALLS) return self->fail("too many calls");
        snprintf(self->calls[self->ncalls].caller, MAX_TEXT, "%s", self->cur_func);
        snprintf(self->calls[self->ncalls].callee, MAX_TEXT, "%s", callee);
        self->calls[self->ncalls].line = line;
        self->ncalls++;
        return 0;
    }
}

impl ParseOps for Ast {
    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "int") == 0 || strcmp(w, "void") == 0
            || strcmp(w, "char") == 0 || strcmp(w, "unsigned") == 0
            || strcmp(w, "signed") == 0 || strcmp(w, "long") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "enum") == 0
            || strcmp(w, "union") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0;
    }

    int type_append(char *out, size_t cap, size_t *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, cap - *n, "%s", tok);
        if (w < 0 || (size_t)w >= cap - *n) return self->fail("type is too long");
        *n += (size_t)w;
        return 0;
    }

    /* Consume a type specifier. `struct X` keeps the tag; a known typedef name
       is part of the type; `*` accumulates (9.3 supports a single pointer). */
    int parse_type(char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = 0;
        out[0] = 0;
        for (;;) {
            if (self->lex->tok == T_ID && self->is_type_word(self->lex->toktext)) {
                if (self->type_append(out, cap, &n, self->lex->toktext) != 0) return -1;
                if (strcmp(self->lex->toktext, "struct") == 0) {
                    char sname[MAX_TEXT];
                    self->lex_next();
                    if (self->lex->tok != T_ID) return self->fail("expected a struct name");
                    if (self->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->add_type(sname, 1) != 0) return -1;
                }
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID) {
                int ti;
                char rname[MAX_TEXT];
                char iface[MAX_TEXT];
                if (self->resolve_type(self->lex->toktext, rname, sizeof rname) != 0) return -1;
                ti = self->find_type(rname);
                if (ti < 0) break;
                /* a bare struct tag needs `struct`; a trait becomes its iface */
                if (self->type_kind[ti] == 1) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                } else if (self->type_kind[ti] == 3) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (snprintf(iface, sizeof iface, "%s_iface", rname) >= (int)sizeof iface)
                        return self->fail("type name is too long");
                    if (self->type_append(out, cap, &n, iface) != 0) return -1;
                    self->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->lex_next();
                continue;
            }
            break;
        }
        if (n == 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "expected a type (tok %d '%s')", self->lex->tok, self->lex->toktext);
            return self->fail(msg);
        }
        return 0;
    }

    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    int parse_array_dims(int n)
    {
        (void)self;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
            char dim[MAX_TEXT];
            char cur[MAX_TEXT];
            int unsized;
            unsized = 0;
            self->lex_next();
            if (self->lex->tok == T_NUM) {
                snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
            } else if (self->lex->tok == T_ID) {
                snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                /* `T a[][N]`: an unsized parameter dimension (10.6) */
                snprintf(dim, sizeof dim, "[]");
                unsized = 1;
            } else {
                return self->fail("expected an array length");
            }
            if (!unsized) self->lex_next();
            if (self->expect("]") != 0) return -1;
            snprintf(cur, sizeof cur, "%s%s", self->arena->nodes[n].text3, dim);
            snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cur);
            self->arena->nodes[n].num = 0;      /* text3 is the authoritative spelling */
        }
        return 0;
    }

    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->lex_next();
        res = (self->lex->tok == T_ID && (self->is_type_word(self->lex->toktext)
                                 || self->find_type(self->lex->toktext) >= 0));
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    int parse_program(void)
    {
        int prog, n, base;
        (void)self;

        prog = self->new_node(N_PROG);
        if (prog < 0) return -1;
        base = ct_diag_nsem();
        self->lex_next();
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PP) {
                n = self->new_node(N_PP);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->lex->toktext);
                if (self->append_node(prog, n) != 0) return -1;
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "import") == 0) {
                if (!self->build_mode)
                    return self->fail("'import' is not supported in compile mode");
                if (self->skip_import() != 0) return -1;
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "namespace") == 0) {
                if (self->parse_namespace(prog) != 0) return -1;
                continue;
            }
            n = self->parse_top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) {
                /* A reported error is recoverable: resynchronise and keep going
                   so one bad construct does not hide the rest of the file. A
                   parse failure without a diagnostic is still fatal. */
                if (ct_diag_nsem() == base) return -1;
                if (self->skip_after_error() != 0) return -1;
                continue;
            }
            if (self->append_node(prog, n) != 0) return -1;
        }
        /* errors leave the unit (and its artifacts) behind */
        if (ct_diag_nsem() > base) return -1;
        return prog;
    }

    /* A function (prototype or definition) or a global variable. */
    int parse_func(int is_static, int is_pub)
    {
        int f, b, params, fi, func_line;
        char ret[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        func_line = self->lex->tokline;
        if (self->parse_type(ret, sizeof ret) != 0) return -1;
        if (self->lex->tok != T_ID) return self->fail("expected a name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        self->lex_next();
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
            int g, e;
            g = self->new_node(N_GLOBAL);
            if (g < 0) return -1;
            snprintf(self->arena->nodes[g].text, MAX_TEXT, "%s", ret);
            snprintf(self->arena->nodes[g].text2, MAX_TEXT, "%s", name);
            self->arena->nodes[g].aux = is_static;
            self->arena->nodes[g].d = is_pub;
            self->arena->nodes[g].line = func_line;
            /* a file-scope name is visible to every function body */
            if (self->declare_var(name, ret) != 0) return -1;
            if (self->parse_array_dims(g) != 0) return -1;
            if (self->accept("=")) {
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                    char raw[MAX_TEXT];
                    char fixed[MAX_TEXT];
                    e = self->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->parse_init_raw(raw, sizeof raw) != 0) return -1;
                    if (self->rewrite_init_text(ret, raw, fixed, sizeof fixed) != 0) return -1;
                    snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", fixed);
                } else {
                    e = self->parse_expr();
                    if (e < 0) return -1;
                }
                self->arena->nodes[g].a = e;
            }
            if (self->expect(";") != 0) return -1;
            return g;
        }
        if (self->push_scope() != 0) return -1;
        params = self->parse_params();
        if (params < 0) {
            self->pop_scope();
            return -1;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
            self->lex_next();
            fi = self->add_func(name, ret, is_static, is_pub, params);
            if (fi < 0) {
                self->pop_scope();
                return -1;
            }
            self->funcs[fi].line = func_line;
            self->pop_scope();
            return NO_NODE;
        }
        snprintf(self->ret_type, sizeof self->ret_type, "%s", ret);
        snprintf(self->cur_func, sizeof self->cur_func, "%s", name);
        /* the body is the leak analysis window; its own scope is the frame a
           deeper return counts as conditional against */
        self->leak_active = 1;
        self->leak_frame = self->nscope + 1;
        self->leak_impl = 0;
        self->ret_owned = 0;
        b = self->parse_block();
        self->leak_active = 0;
        self->leak_frame = -1;
        self->cur_func[0] = 0;
        self->ret_type[0] = 0;
        if (b < 0) {
            self->pop_scope();
            return -1;
        }
        fi = self->add_func(name, ret, is_static, is_pub, params);
        if (fi < 0) {
            self->pop_scope();
            return -1;
        }
        self->funcs[fi].ret_owned = self->ret_owned;
        self->funcs[fi].line = func_line;
        f = self->new_node(N_FUNC);
        if (f < 0) {
            self->pop_scope();
            return -1;
        }
        snprintf(self->arena->nodes[f].text, MAX_TEXT, "%s", ret);
        snprintf(self->arena->nodes[f].text2, MAX_TEXT, "%s", name);
        self->arena->nodes[f].aux = is_static;
        self->arena->nodes[f].d = is_pub;
        self->arena->nodes[f].line = func_line;
        self->arena->nodes[f].a = params;
        self->arena->nodes[f].b = b;
        self->pop_scope();
        return f;
    }

    int parse_params(void)
    {
        int first, tail, p;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        self->nparams = 0;
        first = 0;
        tail = 0;
        if (self->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        for (;;) {
            if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0 &&
                strcmp(typebuf, "void") == 0) {
                self->lex_next();
                return 0;
            }
            if (self->lex->tok != T_ID) return self->fail("expected a parameter name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->lex_next();
            p = self->new_node(N_PARAM);
            if (p < 0) return -1;
            snprintf(self->arena->nodes[p].text, MAX_TEXT, "%s", typebuf);
            snprintf(self->arena->nodes[p].text2, MAX_TEXT, "%s", name);
            if (self->parse_array_dims(p) != 0) return -1;
            if (self->declare_var(name, typebuf) != 0) return -1;
            if (self->arena->nodes[p].text3[0]) {
                int vi = self->find_var(name);
                if (vi >= 0) self->vars[vi].is_array = 1;
            }
            if (tail == 0) first = p;
            else self->arena->nodes[tail].next = p;
            tail = p;
            self->nparams++;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }

    int parse_field_def(void)
    {
        int m;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        if (self->lex->tok != T_ID) return self->fail("expected a field name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        self->lex_next();
        m = self->new_node(N_FIELD);
        if (m < 0) return -1;
        snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", typebuf);
        snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", name);
        if (self->parse_array_dims(m) != 0) return -1;
        if (self->expect(";") != 0) return -1;
        return m;
    }

    /* `struct Name { ... }` (the trailing `;` is the caller's business). */
    int parse_struct_def(void)
    {
        int s, tail, m, struct_line, brace_line, brace_col;
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        (void)self;

        struct_line = self->lex->tokline;
        brace_line = 0;
        brace_col = 1;
        self->lex_next();
        name[0] = 0;
        qname[0] = 0;
        if (self->lex->tok == T_ID) {
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
            if (self->add_type(qname, 1) != 0) return -1;
            if (self->add_struct(qname) < 0) return -1;
            self->lex_next();
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
            /* `struct X;` -- a forward declaration: the tag is registered above,
               so `struct X *p` parses; the body may follow later */
            self->lex_next();
            return NO_NODE;
        }
        /* A second body for an already-defined tag is a hard error; a forward
           declaration above it is fine. L2 reports it at the '{'. */
        if (qname[0]) {
            int ex = self->find_struct(qname);
            if (ex >= 0 && self->structs[ex].defined) {
                char msg[MAX_TEXT];
                snprintf(msg, sizeof msg, "duplicate struct '%s'", name);
                return ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->path);
            }
        }
        /* the body's `{` is where L2 reports an unresolved `use` trait */
        brace_line = self->lex->tokline;
        brace_col = self->lex->tokstart - self->lex->lstart + 1;
        if (self->expect("{") != 0) return -1;
        s = self->new_node(N_STRUCT);
        if (s < 0) return -1;
        self->arena->nodes[s].line = struct_line;
        snprintf(self->arena->nodes[s].text2, MAX_TEXT, "%s", qname);
        tail = -1;
        self->npend = 0;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            m = self->parse_field_def();
            if (m < 0) return -1;
            /* record the field type: receiver chains and nested vptr writes need it.
               An untagged body (typedef struct { ... }) lands in the pending list,
               which parse_typedef attaches to the alias. */
            if (qname[0]) {
                int si2 = self->find_struct(qname);
                if (si2 >= 0 && self->structs[si2].nfields < MAX_FIELDS) {
                    snprintf(self->structs[si2].fields[self->structs[si2].nfields].name, MAX_TEXT,
                             "%s", self->arena->nodes[m].text2);
                    snprintf(self->structs[si2].fields[self->structs[si2].nfields].type, MAX_TEXT,
                             "%s", self->arena->nodes[m].text);
                    snprintf(self->structs[si2].fields[self->structs[si2].nfields].dims, MAX_TEXT,
                             "%s", self->arena->nodes[m].text3);
                    self->structs[si2].nfields++;
                }
            } else if (self->npend < MAX_FIELDS) {
                snprintf(self->pend_fields[self->npend].name, MAX_TEXT, "%s", self->arena->nodes[m].text2);
                snprintf(self->pend_fields[self->npend].type, MAX_TEXT, "%s", self->arena->nodes[m].text);
                snprintf(self->pend_fields[self->npend].dims, MAX_TEXT, "%s", self->arena->nodes[m].text3);
                self->npend++;
            }
            if (tail < 0) self->arena->nodes[s].a = m;
            else self->arena->nodes[tail].next = m;
            tail = m;
        }
        if (self->expect("}") != 0) return -1;
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "use") == 0) {
            self->lex_next();
            if (qname[0] && self->parse_use_list(self->find_struct(qname)) != 0) return -1;
            /* every trait named in `use` must already be defined (the built-in
               Drop never joins the list); L2 reports the first miss at the
               struct's '{', so the remembered position is what is used here */
            if (qname[0]) {
                int si3, ui3;
                si3 = self->find_struct(qname);
                if (si3 >= 0) {
                    for (ui3 = 0; ui3 < self->structs[si3].nuse; ui3++) {
                        if (self->find_trait(self->structs[si3].use[ui3]) < 0) {
                            char msg[MAX_TEXT];
                            snprintf(msg, sizeof msg,
                                     "struct '%s' uses undefined trait '%s'",
                                     name, self->structs[si3].use[ui3]);
                            return ct_sem_error(brace_line, brace_col, msg, self->path);
                        }
                    }
                }
            }
        }
        if (qname[0]) {
            int di = self->find_struct(qname);
            if (di >= 0) self->structs[di].defined = 1;
        }
        return s;
    }

    /* `typedef struct { ... } Name;` or `typedef <type> Name;`. */
    int parse_typedef(int is_pub)
    {
        int t, td_line;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        (void)self;

        td_line = self->lex->tokline;
        self->lex_next();
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "struct") == 0) {
            t = self->parse_struct_def();
            if (t < 0) return -1;
            if (self->lex->tok != T_ID) return self->fail("expected a typedef name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
            /* keep the tag in `text`: `typedef struct Tag {...} Alias;` must emit
               the tag, or a `struct Tag` reference elsewhere is incomplete */
            snprintf(self->arena->nodes[t].text, MAX_TEXT, "%s", self->arena->nodes[t].text2);
            snprintf(self->arena->nodes[t].text2, MAX_TEXT, "%s", qname);
            self->arena->nodes[t].aux = 1;
            self->arena->nodes[t].d = is_pub;
            self->arena->nodes[t].line = td_line;
            if (self->add_type(qname, 2) != 0) return -1;
            if (self->add_struct(qname) < 0) return -1;
            /* the tag and the alias are two table entries: give the alias the
               `use` list the body attached to the tag, or its vptr fields vanish */
            {
                int tagi = -1, ai, ui;
                if (self->arena->nodes[t].text[0]) tagi = self->find_struct(self->arena->nodes[t].text);
                ai = self->find_struct(qname);
                if (tagi >= 0 && ai >= 0 && tagi != ai) {
                    self->structs[ai].nuse = self->structs[tagi].nuse;
                    self->structs[ai].uses_drop = self->structs[tagi].uses_drop;
                    for (ui = 0; ui < self->structs[tagi].nuse; ui++)
                        snprintf(self->structs[ai].use[ui], MAX_TEXT, "%s", self->structs[tagi].use[ui]);
                    self->structs[ai].nfields = self->structs[tagi].nfields;
                    for (ui = 0; ui < self->structs[tagi].nfields; ui++) {
                        snprintf(self->structs[ai].fields[ui].name, MAX_TEXT, "%s",
                                 self->structs[tagi].fields[ui].name);
                        snprintf(self->structs[ai].fields[ui].type, MAX_TEXT, "%s",
                                 self->structs[tagi].fields[ui].type);
                    }
                } else if (ai >= 0 && !self->arena->nodes[t].text[0]) {
                    /* an untagged body: the pending list belongs to this alias */
                    self->structs[ai].nfields = self->npend;
                    for (ui = 0; ui < self->npend; ui++) {
                        snprintf(self->structs[ai].fields[ui].name, MAX_TEXT, "%s",
                                 self->pend_fields[ui].name);
                        snprintf(self->structs[ai].fields[ui].type, MAX_TEXT, "%s",
                                 self->pend_fields[ui].type);
                        snprintf(self->structs[ai].fields[ui].dims, MAX_TEXT, "%s",
                                 self->pend_fields[ui].dims);
                    }
                }
            }
            return t;
        }
        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        if (self->lex->tok != T_ID) return self->fail("expected a typedef name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        self->lex_next();
        if (self->expect(";") != 0) return -1;
        if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
        t = self->new_node(N_TYPEDEF);
        if (t < 0) return -1;
        snprintf(self->arena->nodes[t].text, MAX_TEXT, "%s", typebuf);
        snprintf(self->arena->nodes[t].text2, MAX_TEXT, "%s", qname);
        self->arena->nodes[t].d = is_pub;
        self->arena->nodes[t].line = td_line;
        if (self->add_type(qname, 2) != 0) return -1;
        return t;
    }

    /* `use A, B` after a struct body; the trailing `;` stays with the caller. */
    int parse_use_list(int sindex)
    {
        char tname[MAX_TEXT];
        (void)self;
        if (sindex < 0) return self->fail("unknown struct in 'use'");
        for (;;) {
            if (self->lex->tok != T_ID) return self->fail("expected a trait name");
            if (self->resolve_type(self->lex->toktext, tname, sizeof tname) != 0) return -1;
            /* `Drop` is built in (Phase 5): it carries no vptr or vtable, so it
               never joins the `use` list -- only the flag matters */
            if (strcmp(tname, "Drop") == 0) {
                self->structs[sindex].uses_drop = 1;
                self->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                    self->lex_next();
                    continue;
                }
                break;
            }
            if (self->structs[sindex].nuse >= MAX_TRAITS) return self->fail("too many used traits");
            snprintf(self->structs[sindex].use[self->structs[sindex].nuse], MAX_TEXT, "%s", tname);
            self->structs[sindex].nuse++;
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        return 0;
    }

    /* `trait Name { ret m(params); ... }` -- no node, the table is enough. */
    int parse_trait(int is_pub)
    {
        int ti, mi, np, trait_line;
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        char ret[MAX_TEXT];
        char ptype[MAX_TEXT];
        (void)self;

        trait_line = self->lex->tokline;
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a trait name");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
        /* A second body for the same trait is a hard error. L2 reports it at the
           opening '{', so step there first and use its line/column. */
        if (self->find_trait(qname) >= 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "duplicate trait '%s'", name);
            self->lex_next();
            return ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->path);
        }
        ti = self->add_trait(qname);
        if (ti < 0) return -1;
        self->traits[ti].is_pub = is_pub;
        self->traits[ti].line = trait_line;
        if (self->add_type(qname, 3) != 0) return -1;   /* trait = iface type */
        self->lex_next();
        if (self->expect("{") != 0) return -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (self->parse_type(ret, sizeof ret) != 0) return -1;
            if (self->lex->tok != T_ID) return self->fail("expected a method name");
            if (self->traits[ti].nm >= MAX_METHODS) return self->fail("too many trait methods");
            mi = self->traits[ti].nm;
            snprintf(self->traits[ti].m[mi].name, MAX_TEXT, "%s", self->lex->toktext);
            snprintf(self->traits[ti].m[mi].ret, MAX_TEXT, "%s", ret);
            self->traits[ti].m[mi].nparams = 0;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "void") == 0) {
                self->lex_next();
                if (self->expect(")") != 0) return -1;
                if (self->expect(";") != 0) return -1;
                self->traits[ti].nm++;
                continue;
            }
            np = 0;
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                for (;;) {
                    if (self->parse_type(ptype, sizeof ptype) != 0) return -1;
                    if (self->lex->tok == T_ID) self->lex_next();
                    /* a parameter may be an array (`char a[][N]`): the dims
                       belong in the vtable signature too, or the impl's type
                       would not match it */
                    {
                        int sp;
                        sp = self->new_node(N_PARAM);
                        if (sp < 0) return -1;
                        if (self->parse_array_dims(sp) != 0) return -1;
                        if (self->arena->nodes[sp].text3[0])
                            snprintf(ptype + strlen(ptype),
                                     sizeof ptype - strlen(ptype), "%s", self->arena->nodes[sp].text3);
                    }
                    if (np >= MAX_PARAMS) return self->fail("too many method parameters");
                    snprintf(self->traits[ti].m[mi].ptype[np], MAX_TEXT, "%s", ptype);
                    np++;
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                        self->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->expect(")") != 0) return -1;
            if (self->expect(";") != 0) return -1;
            self->traits[ti].m[mi].nparams = np;
            self->traits[ti].nm++;
        }
        if (self->expect("}") != 0) return -1;
        return NO_NODE;
    }

    /* `impl T for S { methods }` -- one N_IMPL node carrying N_METHOD children. */
    int parse_impl(void)
    {
        int ti, si, node, mnode, params, body, tail, impl_line;
        int mline, nimpl, tm_i, k2;
        char tname[MAX_TEXT];
        char sname[MAX_TEXT];
        char rtrait[MAX_TEXT];
        char rstruct[MAX_TEXT];
        char ret[MAX_TEXT];
        char mname[MAX_TEXT];
        char stype[MAX_TEXT];
        int type_index;
        (void)self;

        impl_line = self->lex->tokline;
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a trait name");
        snprintf(tname, sizeof tname, "%s", self->lex->toktext);
        if (self->resolve_type(tname, rtrait, sizeof rtrait) != 0) return -1;
        ti = self->find_trait(rtrait);
        /* `Drop` is built in: no `trait Drop` declaration exists, but
           `impl Drop for S` is legal and emits `S_Drop_drop` */
        if (ti < 0 && strcmp(rtrait, "Drop") != 0)
            return self->fail("impl of an unknown trait");
        self->lex_next();
        if (self->lex->tok != T_ID || strcmp(self->lex->toktext, "for") != 0)
            return self->fail("expected 'for' after the trait name");
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a struct name");
        snprintf(sname, sizeof sname, "%s", self->lex->toktext);
        if (self->resolve_type(sname, rstruct, sizeof rstruct) != 0) return -1;
        /* the struct must exist (a forward declaration is enough); an undefined
           one is reported at the body's `{`, like L2, and the body is skipped so
           the declarations after it are still parsed (Phase 10.4 recovery) */
        si = self->find_struct(rstruct);
        self->lex_next();
        if (si < 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "impl for undefined struct '%s'", sname);
            if (ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->path) != 0)
                return -1;
            if (self->skip_body() != 0) return -1;
            return NO_NODE;
        }
        type_index = self->find_type(rstruct);
        if (type_index >= 0 && self->type_kind[type_index] == 1)
            snprintf(stype, sizeof stype, "struct %s", rstruct);
        else
            snprintf(stype, sizeof stype, "%s", rstruct);
        if (self->expect("{") != 0) return -1;
        node = self->new_node(N_IMPL);
        if (node < 0) return -1;
        self->arena->nodes[node].line = impl_line;
        snprintf(self->arena->nodes[node].text2, MAX_TEXT, "%s", rtrait);
        self->arena->nodes[node].aux = si;
        snprintf(self->arena->nodes[node].text, MAX_TEXT, "%s", stype);
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            mline = self->lex->tokline;
            if (self->parse_type(ret, sizeof ret) != 0) return -1;
            if (self->lex->tok != T_ID) return self->fail("expected a method name");
            snprintf(mname, sizeof mname, "%s", self->lex->toktext);
            self->lex_next();
            if (self->push_scope() != 0) return -1;
            if (self->declare_var("self", stype) != 0) {
                self->pop_scope();
                return -1;
            }
            params = self->parse_params();
            if (params < 0) {
                self->pop_scope();
                return -1;
            }
            /* Signature consistency against the trait -- a warning, not an error.
               The wording and the line (the method's, not the impl's) match L2
               (D39), so the module fixtures can be compared byte for byte. */
            nimpl = 0;
            for (k2 = params; k2 > 0; k2 = self->arena->nodes[k2].next) nimpl++;
            tm_i = 0;
            if (ti >= 0)
                for (tm_i = 0; tm_i < self->traits[ti].nm; tm_i++)
                    if (strcmp(self->traits[ti].m[tm_i].name, mname) == 0) break;
            if (ti >= 0 && tm_i < self->traits[ti].nm) {
                char wmsg[MAX_TEXT];
                if (ret[0] && strcmp(ret, self->traits[ti].m[tm_i].ret) != 0) {
                    snprintf(wmsg, sizeof wmsg, "return type '%s' does not match the trait's '%s'",
                             ret, self->traits[ti].m[tm_i].ret);
                    if (ct_sig_warn(mline, mname, rtrait, rstruct, wmsg, self->path) != 0) {
                        self->pop_scope();
                        return -1;
                    }
                } else if (nimpl != self->traits[ti].m[tm_i].nparams) {
                    snprintf(wmsg, sizeof wmsg, "takes %d parameter(s), the trait declares %d",
                             nimpl, self->traits[ti].m[tm_i].nparams);
                    if (ct_sig_warn(mline, mname, rtrait, rstruct, wmsg, self->path) != 0) {
                        self->pop_scope();
                        return -1;
                    }
                }
            }
            snprintf(self->ret_type, sizeof self->ret_type, "%s", ret);
            snprintf(self->cur_func, sizeof self->cur_func, "%s_%s_%s",
                     self->structs[si].name, rtrait, mname);
            /* the method body tracks leaks too; a method symbol is not in the
               function table, so nothing feeds `ret_owned` back to callers */
            self->leak_active = 1;
            self->leak_frame = self->nscope + 1;
            self->leak_impl = 1;
            body = self->parse_block();
            self->leak_active = 0;
            self->leak_frame = -1;
            self->leak_impl = 0;
            self->cur_func[0] = 0;
            self->ret_type[0] = 0;
            if (body < 0) {
                self->pop_scope();
                return -1;
            }
            self->pop_scope();
            mnode = self->new_node(N_METHOD);
            if (mnode < 0) return -1;
            snprintf(self->arena->nodes[mnode].text, MAX_TEXT, "%s", ret);
            snprintf(self->arena->nodes[mnode].text2, MAX_TEXT, "%s", mname);
            /* The emitted function takes the trait's return type (L2 does the
               same), so a mismatching impl still yields C that compiles; the
               map keeps the impl's written type in `text`. */
            if (ti >= 0 && tm_i < self->traits[ti].nm)
                snprintf(self->arena->nodes[mnode].text3, MAX_TEXT, "%s", self->traits[ti].m[tm_i].ret);
            self->arena->nodes[mnode].a = params;
            self->arena->nodes[mnode].b = body;
            self->arena->nodes[mnode].num = ti;
            self->arena->nodes[mnode].aux = si;
            if (tail < 0) self->arena->nodes[node].a = mnode;
            else self->arena->nodes[tail].next = mnode;
            tail = mnode;
        }
        if (self->expect("}") != 0) return -1;
        return node;
    }

    /* Capture a `{ ... }` initializer verbatim; the caller appends vptr items. */
    int parse_init_raw(char *out, size_t cap)
    {
        int depth, n, c;
        (void)self;

        n = 0;
        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
        out[n] = '{';
        n++;
        depth = 1;
        while (self->lex->src[self->lex->pos] && depth > 0) {
            c = (unsigned char)self->lex->src[self->lex->pos];
            if (c == '"') {
                if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                out[n] = '"';
                n++;
                self->lex->pos++;
                while (self->lex->src[self->lex->pos] && self->lex->src[self->lex->pos] != '"') {
                    if (self->lex->src[self->lex->pos] == '\\' && self->lex->src[self->lex->pos + 1]) {
                        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                        out[n] = self->lex->src[self->lex->pos];
                        n++;
                        self->lex->pos++;
                    }
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = self->lex->src[self->lex->pos];
                    n++;
                    self->lex->pos++;
                }
                if (self->lex->src[self->lex->pos] == '"') {
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = '"';
                    n++;
                    self->lex->pos++;
                }
                continue;
            }
            if (c == '{') depth++;
            else if (c == '}') depth--;
            if (n + 1 >= (int)cap) return self->fail("initializer is too long");
            out[n] = (char)c;
            n++;
            self->lex->pos++;
        }
        if (depth != 0) return self->fail("unterminated initializer");
        out[n] = 0;
        self->lex_next();
        return 0;
    }

    int parse_block(void)
    {
        int blk, tail, s, base;
        (void)self;

        if (self->expect("{") != 0) return -1;
        if (self->push_scope() != 0) return -1;
        base = self->own_base[self->nscope - 1];
        blk = self->new_node(N_BLOCK);
        if (blk < 0) {
            self->pop_scope();
            return -1;
        }
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            s = self->parse_stmt();
            if (s < 0) {
                self->pop_scope();
                return -1;
            }
            if (tail < 0) self->arena->nodes[blk].a = s;
            else self->arena->nodes[tail].next = s;
            tail = s;
        }
        /* AutoDrop: append `delete v;` for this scope's `own` declarations, in
           reverse order, just before the closing brace (L2's line rewrite does
           the same). A brace that shares its line with code cannot host the
           deletes, so that layout is rejected. */
        if (self->nowner > base) {
            int p, at_start, d;
            at_start = 1;
            for (p = self->lex->lstart; p < self->lex->tokstart; p++)
                if (self->lex->src[p] != ' ' && self->lex->src[p] != '\t' && self->lex->src[p] != '\r') at_start = 0;
            if (!at_start) {
                self->pop_scope();
                return ct_sem_error(self->lex->tokline, 1,
                    "auto-drop requires the closing '}' at the start of a line", self->path);
            }
            for (d = self->nowner - 1; d >= base; d--) {
                int del, v, vi;
                const char *tp;
                size_t bl;
                /* a reassigned / returned / moved `own` variable is no longer
                   ours to release (L2 clears the same flag before its rewrite) */
                vi = self->find_var(self->arena->nodes[self->own_decl[d]].text2);
                if (vi >= 0 && !self->vars[vi].autodrop) continue;
                del = self->new_node(N_DELETE);
                v = self->new_node(N_VAR);
                if (del < 0 || v < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[del].line = self->arena->nodes[self->own_decl[d]].line;
                snprintf(self->arena->nodes[v].text2, MAX_TEXT, "%s", self->arena->nodes[self->own_decl[d]].text2);
                self->arena->nodes[del].a = v;
                tp = self->arena->nodes[self->own_decl[d]].text;
                if (strncmp(tp, "struct ", 7) == 0) tp += 7;
                snprintf(self->arena->nodes[del].text, MAX_TEXT, "%s", tp);
                bl = strlen(self->arena->nodes[del].text);
                while (bl > 0 && (self->arena->nodes[del].text[bl - 1] == '*'
                                  || self->arena->nodes[del].text[bl - 1] == ' ')) {
                    bl = bl - 1;
                    self->arena->nodes[del].text[bl] = 0;
                }
                if (tail < 0) self->arena->nodes[blk].a = del;
                else self->arena->nodes[tail].next = del;
                tail = del;
            }
        }
        if (self->expect("}") != 0) {
            self->pop_scope();
            return -1;
        }
        /* a scope that closes with a still-owned heap object leaks it (L2
           reports it at the same point, keeping the warning order) */
        if (self->leak_active && self->leak_scope(self->scope[self->nscope - 1], self->nvar) != 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        return blk;
    }

    int parse_stmt(void)
    {
        int s, e, c;
        (void)self;

        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) return self->parse_block();
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "return") == 0) {
            int rline = self->lex->tokline, at_start = 1, rp;
            for (rp = self->lex->lstart; rp < self->lex->tokstart; rp++)
                if (self->lex->src[rp] != ' ' && self->lex->src[rp] != '\t' && self->lex->src[rp] != '\r') at_start = 0;
            s = self->new_node(N_RET);
            if (s < 0) return -1;
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->lex_next();
                /* a bare `return;` leaves every owned object behind */
                if (self->leak_active
                    && self->leak_return(-1, !at_start || self->nscope > self->leak_frame, rline) != 0)
                    return -1;
                return s;
            }
            e = self->parse_expr();
            if (e < 0) return -1;
            {
                char tr[MAX_TEXT];
                int ip = 0;
                if (self->iface_ref_type(self->ret_type, tr, sizeof tr, &ip)) {
                    e = self->maybe_box(e, tr, ip);
                    if (e < 0) return -1;
                }
            }
            self->arena->nodes[s].a = e;
            /* a return nested in a block (or written mid-line) may be skipped
               at run time, so it only warns about what it leaves behind */
            if (self->leak_active
                && self->leak_return(e, !at_start || self->nscope > self->leak_frame, rline) != 0)
                return -1;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "delete") == 0) {
            s = self->new_node(N_DELETE);
            if (s < 0) return -1;
            self->lex_next();
            e = self->parse_expr();
            if (e < 0) return -1;
            self->arena->nodes[s].a = e;
            /* the object is released: it can neither leak nor auto-drop */
            if (self->leak_active && self->leak_delete(e) != 0) return -1;
            /* resolve the pointee's struct now (the variable may leave scope
               before the delete is emitted) and remember it only when it uses
               Drop; otherwise the emitter stays on the plain `free` path */
            {
                char dt[MAX_TEXT];
                if (self->expr_type(e, dt, sizeof dt) == 0) {
                    const char *dp = dt;
                    size_t dl;
                    int si;
                    if (strncmp(dp, "struct ", 7) == 0) dp += 7;
                    snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s", dp);
                    dl = strlen(self->arena->nodes[s].text);
                    while (dl > 0 && (self->arena->nodes[s].text[dl - 1] == '*'
                                      || self->arena->nodes[s].text[dl - 1] == ' ')) {
                        dl = dl - 1;
                        self->arena->nodes[s].text[dl] = 0;
                    }
                    si = self->find_struct(self->arena->nodes[s].text);
                    if (si < 0 || !self->structs[si].uses_drop) self->arena->nodes[s].text[0] = 0;
                }
            }
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "break") == 0) {
            s = self->new_node(N_BREAK);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "continue") == 0) {
            s = self->new_node(N_CONT);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "if") == 0) {
            s = self->new_node(N_IF);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            self->arena->nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "else") == 0) {
                self->lex_next();
                e = self->parse_branch();
                if (e < 0) return -1;
                self->arena->nodes[s].c = e;
            }
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "while") == 0) {
            s = self->new_node(N_WHILE);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            self->arena->nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "for") == 0) {
            s = self->new_node(N_FOR);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (self->push_scope() != 0) return -1;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->arena->nodes[s].a = -1;
            } else if (self->lex->tok == T_ID && (self->is_type_word(self->lex->toktext)
                       || self->find_type(self->lex->toktext) >= 0)) {
                e = self->parse_decl_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].a = e;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].a = e;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->arena->nodes[s].b = -1;
            } else {
                c = self->parse_expr();
                if (c < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].b = c;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                self->arena->nodes[s].c = -1;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].c = e;
            }
            if (self->expect(")") != 0) {
                self->pop_scope();
                return -1;
            }
            e = self->parse_branch();
            if (e < 0) {
                self->pop_scope();
                return -1;
            }
            self->arena->nodes[s].d = e;
            self->pop_scope();
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "own") == 0) {
            int own_line = self->lex->tokline;
            self->lex_next();
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->expect(";") != 0) return -1;
            if (self->mark_owned(s, own_line) != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && (self->is_type_word(self->lex->toktext)
                              || self->find_type(self->lex->toktext) >= 0)) {
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        s = self->parse_expr_stmt_node();
        if (s < 0) return -1;
        if (self->expect(";") != 0) return -1;
        return s;
    }

    int parse_branch(void)
    {
        int b, s;
        (void)self;

        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) return self->parse_block();
        if (self->push_scope() != 0) return -1;
        s = self->parse_stmt();
        if (s < 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        b = self->new_node(N_BLOCK);
        if (b < 0) return -1;
        self->arena->nodes[b].a = s;
        return b;
    }

    /* `<type> name[dims] [= expr] (, name[dims] [= expr])*` without the trailing
       semicolon. Several declarators share the type and come back as an N_DECLS
       wrapper, so every consumer still sees one statement node. */
    int parse_decl_node(void)
    {
        int n, e, head, tail, base_stars, first_decl;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        head = -1;
        tail = -1;
        base_stars = 0;
        first_decl = 1;
        for (;;) {
            int stars = 0, si;
            size_t tl;
            char t2[MAX_TEXT];

            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                stars++;
                self->lex_next();
            }
            /* `parse_type` folds the first declarator's stars into the type; each
               later declarator brings its own, so the star suffix is rebuilt per
               declarator (`const char *p, *q;` and `int *a, **b;` both work) */
            tl = strlen(typebuf);
            while (tl > 0 && (typebuf[tl - 1] == '*' || typebuf[tl - 1] == ' ')) {
                if (first_decl && typebuf[tl - 1] == '*') base_stars++;
                tl--;
            }
            typebuf[tl] = 0;
            if (first_decl) {
                stars = base_stars;
                first_decl = 0;
            }
            for (si = 0; si < stars; si++) {
                snprintf(t2, sizeof t2, "%s *", typebuf);
                snprintf(typebuf, sizeof typebuf, "%s", t2);
            }
            if (self->lex->tok != T_ID) return self->fail("expected a variable name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->lex_next();
            n = self->new_node(N_DECL);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", typebuf);
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", name);
            if (self->declare_var(name, typebuf) != 0) return -1;
            if (self->parse_array_dims(n) != 0) return -1;
            if (self->arena->nodes[n].text3[0]) {
                int vi = self->find_var(name);
                if (vi >= 0) self->vars[vi].is_array = 1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0) {
                self->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                    char raw[MAX_TEXT];
                    char fixed[MAX_TEXT];
                    e = self->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->parse_init_raw(raw, sizeof raw) != 0) return -1;
                    if (self->rewrite_init_text(typebuf, raw, fixed, sizeof fixed) != 0) return -1;
                    snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", fixed);
                } else {
                    e = self->parse_expr();
                    if (e < 0) return -1;
                }
                self->arena->nodes[n].a = e;
            }
            if (self->arena->nodes[n].a >= 0) {
                char tr[MAX_TEXT];
                int ip = 0;
                if (self->iface_ref_type(typebuf, tr, sizeof tr, &ip)) {
                    e = self->maybe_box(self->arena->nodes[n].a, tr, ip);
                    if (e < 0) return -1;
                    self->arena->nodes[n].a = e;
                }
            }
            if (self->leak_active && self->leak_decl(n) != 0) return -1;
            if (head < 0) head = n;
            else self->arena->nodes[tail].next = n;
            tail = n;
            if (!self->accept(",")) break;
        }
        if (self->arena->nodes[head].next >= 0) {
            int w = self->new_node(N_DECLS);
            if (w < 0) return -1;
            self->arena->nodes[w].a = head;
            return w;
        }
        return head;
    }

    int parse_expr_stmt_node(void)
    {
        int e, rhs, n;
        (void)self;

        e = self->parse_expr();
        if (e < 0) return -1;
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+=") == 0 || strcmp(self->lex->toktext, "-=") == 0
                                 || strcmp(self->lex->toktext, "*=") == 0 || strcmp(self->lex->toktext, "/=") == 0
                                 || strcmp(self->lex->toktext, "%=") == 0)) {
            int op = 0, k2;
            char oc = self->lex->toktext[0];
            k2 = self->arena->nodes[e].kind;
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX && k2 != N_DEREF)
                return self->fail("assignment target is not assignable");
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else op = 5;
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            n = self->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].b = rhs;
            self->arena->nodes[n].aux = op;
            if (self->leak_active && self->leak_assign(n) != 0) return -1;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0) {
            int k;
            char tt[MAX_TEXT];
            char tr[MAX_TEXT];
            k = self->arena->nodes[e].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->fail("assignment target is not assignable");
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            if ((k == N_VAR && self->var_type(self->arena->nodes[e].text2, tt, sizeof tt) == 0)
                || ((k == N_INDEX || k == N_MEMBER || k == N_ARROW)
                    && self->expr_type(e, tt, sizeof tt) == 0)) {
                int ip = 0;
                if (self->iface_ref_type(tt, tr, sizeof tr, &ip)) {
                    rhs = self->maybe_box(rhs, tr, ip);
                    if (rhs < 0) return -1;
                }
            }
            n = self->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].b = rhs;
            if (self->leak_active && self->leak_assign(n) != 0) return -1;
            return n;
        }
        if (self->arena->nodes[e].kind == N_POST) return e;
        n = self->new_node(N_EXPR);
        if (n < 0) return -1;
        self->arena->nodes[n].a = e;
        return n;
    }

    int parse_expr(void)
    {
        int left, right, inner, n, c;
        (void)self;

        /* `&&` binds tighter than `||`; both are looser than parse_cmp's operators.
           The loops live here so the trait's method budget stays put. */
        left = self->parse_cmp();
        if (left < 0) return -1;
        /* `^` sits between the comparisons and `&&`; the cache's FNV fold is the
           first source to need it */
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "^") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_XOR;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_AND;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "||") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
                self->lex_next();
                inner = self->parse_cmp();
                if (inner < 0) return -1;
                n = self->new_node(N_BIN);
                if (n < 0) return -1;
                self->arena->nodes[n].a = right;
                self->arena->nodes[n].b = inner;
                self->arena->nodes[n].aux = B_AND;
                right = n;
            }
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_OR;
            left = n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "?") == 0) {
            int a, b;
            self->lex_next();
            a = self->parse_expr();
            if (a < 0) return -1;
            if (self->expect(":") != 0) return -1;
            b = self->parse_expr();
            if (b < 0) return -1;
            c = self->new_node(N_TERN);
            if (c < 0) return -1;
            self->arena->nodes[c].a = left;
            self->arena->nodes[c].b = a;
            self->arena->nodes[c].c = b;
            return c;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT) {
            op = 0;
            if (strcmp(self->lex->toktext, "<") == 0) op = B_LT;
            else if (strcmp(self->lex->toktext, ">") == 0) op = B_GT;
            else if (strcmp(self->lex->toktext, "<=") == 0) op = B_LE;
            else if (strcmp(self->lex->toktext, ">=") == 0) op = B_GE;
            else if (strcmp(self->lex->toktext, "==") == 0) op = B_EQ;
            else if (strcmp(self->lex->toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+") == 0 || strcmp(self->lex->toktext, "-") == 0)) {
            op = (self->lex->toktext[0] == '+') ? B_ADD : B_SUB;
            self->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "*") == 0
               || strcmp(self->lex->toktext, "/") == 0 || strcmp(self->lex->toktext, "%") == 0)) {
            op = B_MUL;
            if (self->lex->toktext[0] == '/') op = B_DIV;
            else if (self->lex->toktext[0] == '%') op = B_MOD;
            self->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "sizeof") == 0) {
            char tbuf[MAX_TEXT];
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
                && self->next_is_type_name()) {
                self->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->expect(")") != 0) return -1;
                n = self->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[n].aux = 1;
                return n;
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_SIZEOF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->expect(")") != 0) return -1;
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_CAST);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            self->arena->nodes[n].a = e;
            return n;
        }
        op = 0;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "-") == 0) op = U_NEG;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "!") == 0) op = U_NOT;
        if (op != 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_UNARY);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = op;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_ADDR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_DEREF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    int parse_postfix(void)
    {
        int n, m, idx, args;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->parse_primary();
        if (n < 0) return -1;
        for (;;) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                self->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->expect("]") != 0) return -1;
                m = self->new_node(N_INDEX);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].b = idx;
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, ".") == 0
                                     || strcmp(self->lex->toktext, "->") == 0)) {
                int arrow;
                arrow = (self->lex->toktext[0] == '-') ? 1 : 0;
                self->lex_next();
                if (self->lex->tok != T_ID) return self->fail("expected a field or method name");
                snprintf(fname, sizeof fname, "%s", self->lex->toktext);
                self->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                    self->arena->nodes[m].aux = arrow ? 2 : 1;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs */
                    if (self->expr_type(n, rtype, sizeof rtype) == 0) {
                        char ibase[MAX_TEXT];
                        size_t il;
                        int piface = 0;
                        /* a pointer to an interface value dispatches through
                           `->vt` instead of `.vt` */
                        snprintf(ibase, sizeof ibase, "%s", rtype);
                        il = strlen(ibase);
                        while (il > 0 && (ibase[il - 1] == ' ' || ibase[il - 1] == '*')) {
                            if (ibase[il - 1] == '*') piface = 1;
                            il--;
                            ibase[il] = 0;
                        }
                        if (self->is_iface_type(ibase, trname, sizeof trname)) {
                            int t = self->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < self->traits[t].nm; mi++)
                                    if (strcmp(self->traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                self->arena->nodes[m].aux = piface ? 4 : 3;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            }
                        } else if (self->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                        }
                    }
                } else {
                    m = self->new_node(arrow ? N_ARROW : N_MEMBER);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                }
                n = m;
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0 || strcmp(self->lex->toktext, "--") == 0)) {
            int k;
            k = self->arena->nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->fail("'++' / '--' need an assignable target");
            m = self->new_node(N_POST);
            if (m < 0) return -1;
            self->arena->nodes[m].a = n;
            self->arena->nodes[m].aux = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->lex_next();
            return m;
        }
        return n;
    }

    int parse_primary(void)
    {
        int n, args, id_line;
        (void)self;

        if (self->lex->tok == T_NUM) {
            n = self->new_node(N_NUM);
            if (n < 0) return -1;
            self->arena->nodes[n].num = self->lex->toknum;
            self->lex_next();
            return n;
        }
        if (self->lex->tok == T_STR) {
            int off = self->arena->str_begin();
            n = self->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (self->lex->tok == T_STR) {
                int m = 0;
                while (self->lex->toktext[m]) {
                    if (self->arena->str_put((unsigned char)self->lex->toktext[m]) != 0)
                        return self->fail("string pool is full");
                    m++;
                }
                self->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            return n;
        }
        if (self->lex->tok == T_ID) {
            id_line = self->lex->tokline;
            n = self->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->lex->toktext);
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                int fi;
                args = self->parse_args();
                if (args < 0) return -1;
                fi = self->find_func(self->arena->nodes[n].text2);
                if (fi >= 0 && self->record_call(self->arena->nodes[n].text2, id_line) != 0) return -1;
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < self->funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        int ip = 0;
                        if (self->iface_ref_type(self->funcs[fi].ptype[k], tr, sizeof tr, &ip)) {
                            int boxed = self->maybe_box(cur, tr, ip);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else self->arena->nodes[prev].next = boxed;
                                self->arena->nodes[boxed].next = self->arena->nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                self->arena->nodes[n].kind = N_CALL;
                self->arena->nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->find_var(self->arena->nodes[n].text2) < 0) {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps;
                const char *nm = self->arena->nodes[n].text2;
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                return self->fail("use of an undeclared variable");
            }
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            self->lex_next();
            n = self->parse_expr();
            if (n < 0) return -1;
            if (self->expect(")") != 0) return -1;
            return n;
        }
        return self->fail("expected an expression");
    }

    int parse_args(void)
    {
        int first, tail, e;
        (void)self;

        if (self->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        first = -1;
        tail = -1;
        for (;;) {
            e = self->parse_expr();
            if (e < 0) return -1;
            if (tail < 0) first = e;
            else self->arena->nodes[tail].next = e;
            tail = e;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }
}

impl TypeOps for Ast {
    /* `struct T_iface` -> T. */
    int is_iface_type(const char *type, char *tout, size_t tcap)
    {
        const char *base;
        size_t n;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) != 0) return 0;
        base += 7;
        n = strlen(base);
        if (n <= 6 || strcmp(base + n - 6, "_iface") != 0) return 0;
        if (n - 6 >= tcap) return 0;
        snprintf(tout, tcap, "%.*s", (int)(n - 6), base);
        return 1;
    }

    /* `struct X_iface` -> (X, 0); `struct X_iface *` -> (X, 1). */
    int iface_ref_type(const char *type, char *tout, size_t tcap, int *is_ptr)
    {
        char buf[MAX_TEXT];
        size_t n;
        (void)self;

        *is_ptr = 0;
        if (snprintf(buf, sizeof buf, "%s", type) >= (int)sizeof buf) return 0;
        n = strlen(buf);
        while (n > 0 && (buf[n - 1] == ' ' || buf[n - 1] == '*')) {
            if (buf[n - 1] == '*') *is_ptr = 1;
            buf[n - 1] = 0;
            n--;
        }
        return self->is_iface_type(buf, tout, tcap);
    }

    /* `struct S` / `S` / `struct S *` -> S (and whether it was a pointer). */
    int concrete_struct(const char *type, char *sout, size_t scap, int *is_ptr)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", type) >= (int)sizeof buf) return 0;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        *is_ptr = 0;
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            if (base[n - 1] == '*') *is_ptr = 1;
            base[n - 1] = 0;
            n--;
        }
        if (self->find_struct(base) < 0) return 0;
        if (snprintf(sout, scap, "%s", base) >= (int)scap) return 0;
        return 1;
    }

    /* A best-effort static type for the expressions boxing needs. */
    int expr_type(int n, char *out, size_t cap)
    {
        int i;
        (void)self;

        if (self->arena->nodes[n].kind == N_VAR) return self->var_type(self->arena->nodes[n].text2, out, cap);
        if (self->arena->nodes[n].kind == N_INDEX) {
            /* a[i] is the pointee: a pointer's star drops, while an array's
               declared type has none to drop -- unless it is an array *of*
               pointers, which `is_array` keeps intact */
            size_t ln;
            if (self->expr_type(self->arena->nodes[n].a, out, cap) != 0) return -1;
            if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR) {
                int vi = self->find_var(self->arena->nodes[self->arena->nodes[n].a].text2);
                if (vi >= 0 && self->vars[vi].is_array) return 0;
            }
            ln = strlen(out);
            while (ln > 0 && out[ln - 1] == ' ') ln--;
            if (ln > 0 && out[ln - 1] == '*') {
                ln--;
                while (ln > 0 && out[ln - 1] == ' ') ln--;
                out[ln] = 0;
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ADDR) {
            if (self->expr_type(self->arena->nodes[n].a, out, cap) != 0) return -1;
            if (strlen(out) + 2 >= cap) return -1;
            strcat(out, " *");
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CALL) {
            i = self->find_func(self->arena->nodes[n].text2);
            if (i < 0) return -1;
            if (snprintf(out, cap, "%s", self->funcs[i].ret) >= (int)cap) return -1;
            return 0;
        }
        if (self->arena->nodes[n].kind == N_MEMBER || self->arena->nodes[n].kind == N_ARROW) {
            char rt[MAX_TEXT];
            char sname[MAX_TEXT];
            int is_ptr, si, fi;
            if (self->expr_type(self->arena->nodes[n].a, rt, sizeof rt) != 0) return -1;
            is_ptr = (self->arena->nodes[n].kind == N_ARROW);
            if (!self->concrete_struct(rt, sname, sizeof sname, &is_ptr)) return -1;
            si = self->find_struct(sname);
            if (si < 0) return -1;
            for (fi = 0; fi < self->structs[si].nfields; fi++)
                if (strcmp(self->structs[si].fields[fi].name, self->arena->nodes[n].text2) == 0) {
                    if (snprintf(out, cap, "%s", self->structs[si].fields[fi].type) >= (int)cap) return -1;
                    return 0;
                }
            return -1;
        }
        if (self->arena->nodes[n].kind == N_BOX) {
            if (snprintf(out, cap, "struct %s_iface%s", self->arena->nodes[n].text,
                         self->arena->nodes[n].aux >= 2 ? " *" : "") >= (int)cap) return -1;
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CAST) {
            if (snprintf(out, cap, "%s", self->arena->nodes[n].text) >= (int)cap) return -1;
            return 0;
        }
        if (self->arena->nodes[n].kind == N_SIZEOF) {
            if (snprintf(out, cap, "%s", "int") >= (int)cap) return -1;
            return 0;
        }
        return -1;
    }

    /* Wrap `n` in a fat pointer when `trait` is expected; an expression that is
       already the right interface passes through unchanged. A declared global
       instance bound by `map` (11.2) boxes with its instance-level vtable even
       when its struct never `use`d the trait. */
    int maybe_box(int n, const char *trait, int addr)
    {
        char t[MAX_TEXT];
        char tname[MAX_TEXT];
        char sname[MAX_TEXT];
        char iname[MAX_TEXT];
        int is_ptr, si, u, box, found, i, mptr, ip;
        (void)self;

        if (self->arena->nodes[n].kind == N_BOX) {
            /* already an interface value; a pointer target takes its address */
            if (!addr) return n;
            box = self->new_node(N_ADDR);
            if (box < 0) return -1;
            self->arena->nodes[box].a = n;
            return box;
        }
        /* N_BOX text2 names the vtable's owner: the struct for a struct-level
           box, the instance for a `map` box, so the same `<owner>_<trait>_vtable`
           emit rule covers both. */
        mptr = 0;
        iname[0] = 0;
        if (self->arena->nodes[n].kind == N_VAR) {
            snprintf(iname, sizeof iname, "%s", self->arena->nodes[n].text2);
        } else if (self->arena->nodes[n].kind == N_ADDR && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR) {
            snprintf(iname, sizeof iname, "%s", self->arena->nodes[self->arena->nodes[n].a].text2);
            mptr = 1;
        }
        if (iname[0]) {
            for (i = 0; i < self->nmaps; i++)
                if (strcmp(self->maps[i].inst, iname) == 0 && strcmp(self->maps[i].trait, trait) == 0) {
                    box = self->new_node(N_BOX);
                    if (box < 0) return -1;
                    self->arena->nodes[box].a = n;
                    self->arena->nodes[box].aux = mptr + (addr ? 2 : 0);
                    snprintf(self->arena->nodes[box].text, MAX_TEXT, "%s", trait);
                    snprintf(self->arena->nodes[box].text2, MAX_TEXT, "%s", iname);
                    return box;
                }
        }
        if (self->expr_type(n, t, sizeof t) != 0)
            return self->fail("cannot infer the type to box");
        ip = 0;
        if (self->iface_ref_type(t, tname, sizeof tname, &ip)) {
            if (strcmp(tname, trait) == 0) {
                if (ip == addr) return n;
                /* an array of interface values decays to a pointer */
                if (!ip && addr && self->arena->nodes[n].kind == N_VAR) {
                    int vi = self->find_var(self->arena->nodes[n].text2);
                    if (vi >= 0 && self->vars[vi].is_array) return n;
                }
            }
            return self->fail("interface type mismatch");
        }
        if (!self->concrete_struct(t, sname, sizeof sname, &is_ptr))
            return self->fail("cannot box this expression");
        si = self->find_struct(sname);
        if (si < 0) return self->fail("cannot box an unknown struct");
        found = 0;
        for (u = 0; u < self->structs[si].nuse; u++)
            if (strcmp(self->structs[si].use[u], trait) == 0) found = 1;
        if (!found) return self->fail("the struct does not use this trait");
        box = self->new_node(N_BOX);
        if (box < 0) return -1;
        self->arena->nodes[box].a = n;
        self->arena->nodes[box].aux = is_ptr + (addr ? 2 : 0);
        snprintf(self->arena->nodes[box].text, MAX_TEXT, "%s", trait);
        snprintf(self->arena->nodes[box].text2, MAX_TEXT, "%s", sname);
        return box;
    }

    /* Does `type` carry a struct-typed array field whose elements need vptrs?
       Such a field cannot be initialised by designator, so the declaration site
       has to emit a loop after it. */
    int type_has_array_init(const char *type)
    {
        const char *base;
        int si, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        for (fi = 0; si >= 0 && fi < self->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            if (!self->structs[si].fields[fi].dims[0]) continue;
            snprintf(ft, sizeof ft, "%s", self->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (self->type_needs_init(ft)) return 1;
        }
        return 0;
    }

    /* Rewrite one initialiser item when it fills an interface field from a
       concrete struct (`.l = a`, `.l = &a`). Both forms need boxing: a value
       field takes the fat pointer, a pointer field its address. Anything else
       (including a value that is already an interface) is copied verbatim, so
       existing initialisers stay byte for byte as they were. */
    int init_item_text(const char *stype, const char *item, char *out, size_t cap)
    {
        const char *p, *rhs, *base;
        char fname[MAX_TEXT];
        char ftype[MAX_TEXT];
        char sname[MAX_TEXT];
        char tname[MAX_TEXT];
        char vname[MAX_TEXT];
        char vtype[MAX_TEXT];
        int si, fi, is_ptr, srcptr, vptr, u, found, ok;
        size_t k;

        fname[0] = 0;
        ftype[0] = 0;
        sname[0] = 0;
        tname[0] = 0;
        vname[0] = 0;
        vtype[0] = 0;
        rhs = item;
        base = stype;

        /* shape: `.field = <operand>` */
        p = item;
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        ok = (*p == '.');
        if (ok) p++;
        k = 0;
        while (ok && ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                      || (*p >= '0' && *p <= '9') || *p == '_')) {
            if (k + 1 >= sizeof fname) ok = 0;
            else { fname[k] = *p; k++; p++; }
        }
        fname[k] = 0;
        if (!k) ok = 0;
        while (ok && (*p == ' ' || *p == '\t')) p++;
        if (ok && *p != '=') ok = 0;
        if (ok) { p++; rhs = p; }

        /* the field must be an interface (value or pointer) of a known struct */
        if (ok && strncmp(base, "struct ", 7) == 0) base += 7;
        while (ok && *base == ' ') base++;
        si = ok ? self->find_struct(base) : -1;
        if (si < 0) ok = 0;
        fi = -1;
        for (u = 0; ok && u < self->structs[si].nfields; u++)
            if (strcmp(self->structs[si].fields[u].name, fname) == 0) fi = u;
        if (ok && (fi < 0 || self->structs[si].fields[fi].dims[0])) ok = 0;
        is_ptr = 0;
        if (ok) {
            snprintf(ftype, sizeof ftype, "%s", self->structs[si].fields[fi].type);
            if (!self->iface_ref_type(ftype, tname, sizeof tname, &is_ptr)) ok = 0;
        }

        /* the operand must be a bare variable, optionally addressed */
        srcptr = 0;
        if (ok) {
            p = rhs;
            while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
            if (*p == '&') {
                srcptr = 1;
                p++;
                while (*p == ' ' || *p == '\t') p++;
            }
            k = 0;
            while (ok && ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                          || (*p >= '0' && *p <= '9') || *p == '_')) {
                if (k + 1 >= sizeof vname) ok = 0;
                else { vname[k] = *p; k++; p++; }
            }
            vname[k] = 0;
            if (!k) ok = 0;
            while (ok && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) p++;
            if (ok && *p) ok = 0;
        }

        /* ... of a struct that implements the trait, with matching indirection */
        vptr = 0;
        if (ok && self->var_type(vname, vtype, sizeof vtype) != 0) ok = 0;
        if (ok && !self->concrete_struct(vtype, sname, sizeof sname, &vptr)) ok = 0;
        if (ok && srcptr && vptr) ok = 0;     /* `&p` on a struct pointer is not a box source */
        found = 0;
        si = ok ? self->find_struct(sname) : -1;
        for (u = 0; ok && si >= 0 && u < self->structs[si].nuse; u++)
            if (strcmp(self->structs[si].use[u], tname) == 0) found = 1;
        if (ok && !found) ok = 0;

        if (!ok) {
            if (snprintf(out, cap, "%s", item) >= (int)cap) return -1;
            return 0;
        }
        /* the self pointer is the operand itself when it already is a pointer */
        if (snprintf(out, cap, ".%s = %s(struct %s_iface){ (void *)%s%s, &%s_%s_vtable }",
                     fname, is_ptr ? "&" : "", tname,
                     (srcptr || !vptr) ? "&" : "", vname, sname, tname) >= (int)cap) return -1;
        return 0;
    }

    /* Rewrite a captured `{ ... }` list item by item. Runs at parse time: the
       operand types come from the local variable table, which is gone by the
       time the emitter walks the AST. */
    int rewrite_init_text(const char *stype, const char *raw, char *out, size_t cap)
    {
        int len, i, depth, in_str, start, seg;
        char item[MAX_TEXT];
        char fixed[MAX_TEXT];

        len = (int)strlen(raw);
        if (len < 2 || raw[len - 1] != '}') {
            if (snprintf(out, cap, "%s", raw) >= (int)cap) return -1;
            return 0;
        }
        if (cap < 3) return -1;
        out[0] = '{';
        out[1] = 0;
        start = 1;
        depth = 0;
        in_str = 0;
        for (i = 1; i < len - 1; i++) {
            char c = raw[i];
            if (in_str) {
                if (c == '\\' && raw[i + 1]) i++;
                else if (c == '"') in_str = 0;
                continue;
            }
            if (c == '"') { in_str = 1; continue; }
            if (c == '{' || c == '[' || c == '(') depth++;
            else if (c == '}' || c == ']' || c == ')') depth--;
            else if (c == ',' && depth == 0) {
                seg = i - start;
                if (seg >= (int)sizeof item) return self->fail("initializer is too long");
                memcpy(item, raw + start, (size_t)seg);
                item[seg] = 0;
                if (self->init_item_text(stype, item, fixed, sizeof fixed) != 0) return -1;
                if (strlen(out) + strlen(fixed) + 2 >= cap) return -1;
                strcat(out, fixed);
                strcat(out, ",");
                start = i + 1;
            }
        }
        seg = len - 1 - start;
        if (seg < 0) seg = 0;
        if (seg >= (int)sizeof item) return self->fail("initializer is too long");
        memcpy(item, raw + start, (size_t)seg);
        item[seg] = 0;
        if (self->init_item_text(stype, item, fixed, sizeof fixed) != 0) return -1;
        if (strlen(out) + strlen(fixed) + 2 >= cap) return -1;
        strcat(out, fixed);
        strcat(out, "}");
        return 0;
    }
}

impl ModuleOps for Ast {
    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`. */
    int base_name(const char *path, char *out, size_t cap, int *is_hdr)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > cap) return self->fail("output name is too long");
        snprintf(out, cap, "%.*s", (int)n, name);
        return 0;
    }

    int path_dir(const char *path, char *out, size_t cap)
    {
        const char *slash;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        if (!slash) {
            if (cap < 2) return self->fail("path is too long");
            snprintf(out, cap, "%s", ".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        if (n + 1 > cap) return self->fail("path is too long");
        snprintf(out, cap, "%.*s", (int)n, path);
        return 0;
    }

    int append_node(int prog, int n)
    {
        int t;
        (void)self;

        self->arena->nodes[n].next = -1;
        if (self->arena->nodes[prog].a < 0) {
            self->arena->nodes[prog].a = n;
            return 0;
        }
        t = self->arena->nodes[prog].a;
        while (self->arena->nodes[t].next >= 0) t = self->arena->nodes[t].next;
        self->arena->nodes[t].next = n;
        return 0;
    }

    /* Consume `import a::b;` and remember the path; `load_unit` resolves it. */
    int skip_import(void)
    {
        char rel[MAX_TEXT];
        size_t n;
        (void)self;

        n = 0;
        rel[0] = 0;
        self->lex_next();
        for (;;) {
            if (self->lex->tok != T_ID) return self->fail("expected an import path");
            if (n > 0) {
                if (n + 1 >= sizeof rel) return self->fail("import path is too long");
                rel[n] = '/';
                n++;
            }
            if (n + strlen(self->lex->toktext) >= sizeof rel) return self->fail("import path is too long");
            snprintf(rel + n, sizeof rel - n, "%s", self->lex->toktext);
            n += strlen(self->lex->toktext);
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(";") != 0) return -1;
        if (self->nrels >= MAX_IMPORTS) return self->fail("too many imports");
        snprintf(self->rels[self->nrels], MAX_TEXT, "%s", rel);
        self->nrels++;
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. */
    int scan_imports(const char *from)
    {
        (void)self;
        self->nrels = 0;
        self->path = from;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->tok = 0;
        self->lex_next();
        for (;;) {
            if (self->lex->tok == T_PP) {
                self->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "import") == 0) {
                if (self->skip_import() != 0) return -1;
                continue;
            }
            break;
        }
        return 0;
    }

    /* `a::b` -> `<root>/a/b.ct`, then `a/b.h.ct`, for the importing file's own
       directory and then every `-I` root. */
    int resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr)
    {
        char dir[MAX_PATH];
        char cand[MAX_PATH];
        const char *root;
        FILE *f;
        int r;
        (void)self;

        if (self->path_dir(from, dir, sizeof dir) != 0) return -1;
        for (r = -1; r < self->ninc; r++) {
            root = (r < 0) ? dir : self->incdirs[r];
            if (snprintf(cand, sizeof cand, "%s/%s.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 0;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
            if (snprintf(cand, sizeof cand, "%s/%s.h.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 1;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
        }
        snprintf(cand, sizeof cand, "cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char rels[MAX_IMPORTS][MAX_TEXT];
        char dep[MAX_PATH];
        char *mysrc;
        int u, i, d, nrels, is_hdr;
        (void)self;

        for (u = 0; u < self->nunits; u++)
            if (strcmp(self->units[u].path, path) == 0) return u;
        if (self->nunits >= MAX_UNITS) {
            self->fail("too many units");
            return -1;
        }
        u = self->nunits;
        self->nunits++;
        if (snprintf(self->units[u].path, MAX_PATH, "%s", path) >= MAX_PATH) {
            self->fail("path is too long");
            return -1;
        }
        self->units[u].ndep = 0;
        self->units[u].prog = -1;
        self->units[u].digest = 0;
        self->units[u].ns[0] = 0;
        if (self->base_name(path, self->units[u].base, MAX_TEXT, &is_hdr) != 0) return -1;
        self->units[u].is_hdr = is_hdr;

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)self->lex->src;
        if (self->scan_imports(path) != 0) return -1;
        nrels = self->nrels;
        for (i = 0; i < nrels; i++) snprintf(rels[i], MAX_TEXT, "%s", self->rels[i]);
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path, rels[i], dep, sizeof dep, &is_hdr) != 0) return -1;
            d = self->load_unit(dep);
            if (d < 0) return -1;
            if (self->units[u].ndep >= MAX_IMPORTS) {
                self->fail("too many imports");
                return -1;
            }
            snprintf(self->units[u].dep[self->units[u].ndep], MAX_TEXT, "%s", self->units[d].base);
            self->units[u].depu[self->units[u].ndep] = d;
            self->units[u].ndep++;
        }

        self->lex->src = mysrc;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        self->nvar = 0;
        self->nscope = 0;
        self->nowner = 0;
        self->leak_active = 0;
        self->leak_frame = -1;
        self->leak_impl = 0;
        self->ret_owned = 0;
        self->ns[0] = 0;
        self->ns_decl[0] = 0;
        self->self_mode = 0;
        self->ret_type[0] = 0;
        self->cur_func[0] = 0;
        self->nparams = 0;
        self->path = path;
        self->units[u].fn_start = self->nfunc;
        self->units[u].tr_start = self->ntraits;
        self->units[u].call_start = self->ncalls;
        self->units[u].prog = self->parse_program();
        if (self->units[u].prog < 0) return -1;
        self->units[u].fn_end = self->nfunc;
        self->units[u].tr_end = self->ntraits;
        self->units[u].call_end = self->ncalls;
        snprintf(self->units[u].ns, MAX_TEXT, "%s", self->ns_decl);
        return u;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char rest[MAX_PATH];
        char dir[MAX_TEXT];
        char want[MAX_TEXT];
        const char *p;
        size_t rn, k, m;

        (void)self;
        if (!self->units[u].ns[0]) return 0;
        if (!self->nsroot || !self->nsroot[0]) return 0;
        rn = strlen(self->nsroot);
        if (strncmp(self->units[u].path, self->nsroot, rn) != 0) return 0;
        p = self->units[u].path + rn;
        if (*p == '/') p++;
        snprintf(rest, sizeof rest, "%s", p);
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        if (k >= sizeof dir) return self->fail("path is too long");
        snprintf(dir, sizeof dir, "%.*s", (int)k, rest);

        m = 0;
        for (k = 0; self->units[u].ns[k]; k++) {
            if (m + 1 >= sizeof want) return self->fail("namespace is too long");
            if (self->units[u].ns[k] == ':' && self->units[u].ns[k + 1] == ':') {
                want[m] = '/';
                m++;
                k++;
            } else {
                want[m] = self->units[u].ns[k];
                m++;
            }
        }
        want[m] = 0;
        if (strcmp(dir, want) != 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "namespace '%s' does not match the directory '%s'",
                     self->units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* `struct` starts either a definition (`struct S {`) or the return type of a
       function/global (`struct S *f();`). Peek with a lexer snapshot. */
    int struct_def_ahead(void)
    {
        int pos, bol, tok, is_def;
        long num;
        char text[MAX_TEXT];
        (void)self;

        pos = self->lex->pos;
        bol = self->lex->bol;
        tok = self->lex->tok;
        num = self->lex->toknum;
        snprintf(text, sizeof text, "%s", self->lex->toktext);
        self->lex_next();
        is_def = 0;
        if (self->lex->tok == T_ID) self->lex_next();
        /* a body (`{`) or a forward declaration (`;`) both start a CT struct */
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "{") == 0 || strcmp(self->lex->toktext, ";") == 0))
            is_def = 1;
        self->lex->pos = pos;
        self->lex->bol = bol;
        self->lex->tok = tok;
        self->lex->toknum = num;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", text);
        return is_def;
    }

    /* One top-level declaration; `pub` may lead it. */
    int parse_top_decl(int is_pub)
    {
        int n;
        (void)self;

        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "pub") == 0) {
            if (is_pub) return self->fail("duplicate 'pub'");
            self->lex_next();
            return self->parse_top_decl(1);
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "own") == 0)
            return ct_sem_error(self->lex->tokline, 1,
                "'own' is only allowed inside a function body", self->path);
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "typedef") == 0) {
            n = self->parse_typedef(is_pub);
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "trait") == 0) {
            n = self->parse_trait(is_pub);
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "impl") == 0) {
            n = self->parse_impl();
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "map") == 0) {
            n = self->parse_map();
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "struct") == 0
                   && self->struct_def_ahead()) {
            n = self->parse_struct_def();
            /* CT writes `struct X { ... }` bare (the old pipeline accepts both) */
            if (n >= 0) self->accept(";");
        } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0) {
            self->lex_next();
            n = self->parse_func(1, is_pub);
        } else {
            n = self->parse_func(0, is_pub);
        }
        if (n == NO_NODE) return NO_NODE;
        if (n < 0) return -1;
        self->arena->nodes[n].d = is_pub ? 1 : 0;
        return n;
    }

    /* `namespace A::B { ... }`: C has one global namespace, so declarations are
       stored under the `A_B_` prefix. Functions keep their names (the published
       rule), and the block itself emits nothing. */
    int parse_namespace(int prog)
    {
        char path[MAX_TEXT];
        char prefix[MAX_TEXT];
        char save[MAX_TEXT];
        size_t np, npre;
        int n;
        (void)self;

        self->lex_next();
        np = 0;
        npre = 0;
        path[0] = 0;
        prefix[0] = 0;
        for (;;) {
            if (self->lex->tok != T_ID) return self->fail("expected a namespace name");
            if (np > 0) {
                if (np + 2 >= sizeof path) return self->fail("namespace is too long");
                path[np] = ':';
                path[np + 1] = ':';
                np += 2;
                path[np] = 0;
            }
            if (np + strlen(self->lex->toktext) >= sizeof path) return self->fail("namespace is too long");
            snprintf(path + np, sizeof path - np, "%s", self->lex->toktext);
            np += strlen(self->lex->toktext);
            if (npre + strlen(self->lex->toktext) + 1 >= sizeof prefix)
                return self->fail("namespace is too long");
            snprintf(prefix + npre, sizeof prefix - npre, "%s_", self->lex->toktext);
            npre += strlen(self->lex->toktext) + 1;
            self->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (!self->ns[0]) snprintf(self->ns_decl, MAX_TEXT, "%s", path);
        if (self->expect("{") != 0) return -1;
        snprintf(save, sizeof save, "%s", self->ns);
        if (snprintf(self->ns, sizeof self->ns, "%s%s", save, prefix) >= (int)sizeof self->ns)
            return self->fail("namespace is too long");
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (self->lex->tok == T_PP) {
                n = self->new_node(N_PP);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->lex->toktext);
                if (self->append_node(prog, n) != 0) return -1;
                self->lex_next();
                continue;
            }
            n = self->parse_top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) return -1;
            if (self->append_node(prog, n) != 0) return -1;
        }
        if (self->expect("}") != 0) return -1;
        snprintf(self->ns, sizeof self->ns, "%s", save);
        return 0;
    }

    /* `map trait T for instance x { m(params) -> call; ... }` (Phase 11.1): binds a
       declared global instance's trait methods to concrete calls. The binding emits
       an instance-level wrapper plus a vtable; it is not wired into dispatch yet
       (that is 11.2), so the generated pair is static and self-contained. */
    int parse_map(void)
    {
        char tname[MAX_TEXT];
        char rtrait[MAX_TEXT];
        char inst[MAX_TEXT];
        char msg[MAX_TEXT];
        Map *m;
        MapBind *b;
        int line, ti, mi, np, k, i, j, n, q, depth, eof, long_call, c, bound;
        (void)self;

        line = self->lex->tokline;
        self->lex_next();                       /* consume `map` */
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "trait") == 0))
            return self->fail("expected 'trait'");
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected a trait name");
        snprintf(tname, sizeof tname, "%s", self->lex->toktext);
        if (self->resolve_type(tname, rtrait, sizeof rtrait) != 0) return -1;
        ti = self->find_trait(rtrait);
        if (ti < 0) return self->fail("map of an unknown trait");
        self->lex_next();
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "for") == 0))
            return self->fail("expected 'for'");
        self->lex_next();
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "instance") == 0))
            return self->fail("expected 'instance'");
        self->lex_next();
        if (self->lex->tok != T_ID) return self->fail("expected an instance name");
        snprintf(inst, sizeof inst, "%s", self->lex->toktext);
        if (self->find_var(inst) < 0) {
            snprintf(msg, sizeof msg, "map instance '%s' is not a declared variable", inst);
            return self->fail(msg);
        }
        self->lex_next();
        if (self->expect("{") != 0) return -1;
        if (self->nmaps >= MAX_MAPS) return self->fail("too many maps");
        m = &self->maps[self->nmaps];
        snprintf(m->trait, MAX_TEXT, "%s", rtrait);
        snprintf(m->inst, MAX_TEXT, "%s", inst);
        snprintf(m->vtable, MAX_TEXT, "%s_%s_vtable", inst, rtrait);
        m->nb = 0;
        m->line = line;
        m->unit = self->nunits - 1;

        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (m->nb >= MAX_METHODS) return self->fail("too many map bindings");
            b = &m->b[m->nb];
            b->line = self->lex->tokline;
            if (self->lex->tok != T_ID) return self->fail("expected a method name");
            snprintf(b->method, MAX_TEXT, "%s", self->lex->toktext);
            mi = -1;
            for (k = 0; k < self->traits[ti].nm; k++)
                if (strcmp(self->traits[ti].m[k].name, b->method) == 0) { mi = k; break; }
            if (mi < 0) {
                snprintf(msg, sizeof msg, "'%s' is not a method of trait '%s'",
                         b->method, rtrait);
                return self->fail(msg);
            }
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            np = 0;
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                for (;;) {
                    if (self->lex->tok != T_ID) return self->fail("expected a parameter name");
                    if (np >= MAX_PARAMS) return self->fail("too many map parameters");
                    snprintf(b->params[np], MAX_TEXT, "%s", self->lex->toktext);
                    np++;
                    self->lex_next();
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                        self->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->expect(")") != 0) return -1;
            b->nparams = np;
            if (np != self->traits[ti].m[mi].nparams) {
                snprintf(msg, sizeof msg,
                         "map binding for '%s' takes %d parameter(s), the trait declares %d",
                         b->method, np, self->traits[ti].m[mi].nparams);
                return self->fail(msg);
            }
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "->") == 0))
                return self->fail("expected '->'");
            /* Capture the RHS verbatim from self->lex->pos: no lex_next has run since the
               '->' token, so self->lex->pos sits just past it (the parse_init_raw trick). */
            i = self->lex->pos;
            n = 0;
            q = 0;
            depth = 0;
            eof = 0;
            long_call = 0;
            while (self->lex->src[i] == ' ' || self->lex->src[i] == '\t'
                   || self->lex->src[i] == '\n' || self->lex->src[i] == '\r') i++;
            for (;;) {
                c = (unsigned char)self->lex->src[i];
                if (c == 0) { eof = 1; break; }
                if (q == 0 && depth == 0 && c == ';') break;
                if (n + 1 >= MAX_TEXT) { long_call = 1; break; }
                if (q == 0 && (c == '"' || c == '\'')) {
                    q = c;
                } else if (q != 0 && c == q) {
                    q = 0;
                } else if (q != 0 && c == '\\' && self->lex->src[i + 1]) {
                    b->call[n] = (char)c; n++; i++;
                    c = (unsigned char)self->lex->src[i];
                } else if (q == 0 && c == '(') {
                    depth++;
                } else if (q == 0 && c == ')') {
                    depth--;
                }
                b->call[n] = (char)c; n++; i++;
            }
            if (eof) return self->fail("unterminated map call");
            if (long_call) return self->fail("map call is too long");
            while (n > 0 && (b->call[n - 1] == ' ' || b->call[n - 1] == '\t'
                             || b->call[n - 1] == '\n' || b->call[n - 1] == '\r')) n--;
            b->call[n] = 0;
            self->lex->pos = i;
            self->lex_next();
            if (self->map_check_call(b, inst) != 0) return -1;
            if (self->expect(";") != 0) return -1;
            snprintf(b->wrapper, MAX_TEXT, "%s_%s_%s", inst, rtrait, b->method);
            b->ti = ti;
            b->mi = mi;
            m->nb++;
        }
        if (self->expect("}") != 0) return -1;
        /* A map must bind every trait method exactly once: an unbound slot stays
           a null pointer (calling it crashes at run time), and a duplicate
           binding would emit the wrapper function twice (a C redefinition). */
        for (i = 0; i < m->nb; i++) {
            for (j = i + 1; j < m->nb; j++)
                if (strcmp(m->b[i].method, m->b[j].method) == 0) {
                    snprintf(msg, sizeof msg, "duplicate binding for method '%s'",
                             m->b[i].method);
                    return self->fail(msg);
                }
        }
        for (k = 0; k < self->traits[ti].nm; k++) {
            bound = 0;
            for (i = 0; i < m->nb; i++)
                if (strcmp(m->b[i].method, self->traits[ti].m[k].name) == 0) {
                    bound = 1;
                    break;
                }
            if (!bound) {
                snprintf(msg, sizeof msg, "trait method '%s' is not bound by the map",
                         self->traits[ti].m[k].name);
                return self->fail(msg);
            }
        }
        self->nmaps++;
        return NO_NODE;
    }

    /* The subset check: the RHS must be one `f(args)` call whose every argument
       is a literal, a bare name, or a member path rooted at the instance. */
    int map_check_call(const MapBind *b, const char *inst)
    {
        char msg[MAX_TEXT];
        char arg[MAX_TEXT];
        char root[MAX_TEXT];
        const char *p;
        const char *w;
        int n, depth, k, ai, ok;
        int rl;
        int q;
        (void)self;

        p = b->call;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || *p == '_'))
            return self->fail("a map call must name a function");
        while ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
               || (*p >= '0' && *p <= '9') || *p == '_') p++;
        while (*p == ' ' || *p == '\t') p++;
        if (*p != '(') return self->fail("a map call must be a single call");
        p++;
        for (;;) {
            while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
            if (*p == ')') { p++; break; }
            if (!*p) return self->fail("unterminated map call");
            n = 0;
            depth = 0;
            while (*p) {
                if (depth == 0 && (*p == ',' || *p == ')')) break;
                if (*p == '"' || *p == '\'') {
                    q = *p;
                    if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                    arg[n] = (char)q; n++; p++;
                    while (*p && *p != (char)q) {
                        if (*p == '\\' && *(p + 1)) {
                            if (n + 2 >= MAX_TEXT) return self->fail("a map argument is too long");
                            arg[n] = *p; n++; p++;
                            arg[n] = *p; n++; p++;
                            continue;
                        }
                        if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                        arg[n] = *p; n++; p++;
                    }
                    if (*p != (char)q) return self->fail("unterminated literal in a map call");
                    if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                    arg[n] = *p; n++; p++;
                    continue;
                }
                if (*p == '(') depth++;
                else if (*p == ')') depth--;
                if (n + 1 >= MAX_TEXT) return self->fail("a map argument is too long");
                arg[n] = *p; n++; p++;
            }
            arg[n] = 0;
            while (n > 0 && (arg[n - 1] == ' ' || arg[n - 1] == '\t'
                             || arg[n - 1] == '\n' || arg[n - 1] == '\r')) {
                n--;
                arg[n] = 0;
            }
            ai = 0;
            while (arg[ai] == ' ' || arg[ai] == '\t') ai++;
            /* A bare name must be visible here (a binding parameter, this map's
               instance, or a declared variable); a member path must be rooted at
               the instance. Anything else would name an unknown symbol in the
               emitted wrapper. */
            ok = 0;
            if (arg[ai] == '"' || arg[ai] == '\'') {
                ok = 1;
            } else if (arg[ai] >= '0' && arg[ai] <= '9') {
                ok = 1;
            } else {
                w = arg + ai;
                if (*w == '&') {
                    w++;
                    while (*w == ' ' || *w == '\t') w++;
                }
                rl = 0;
                if ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z') || *w == '_') {
                    while ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                           || (*w >= '0' && *w <= '9') || *w == '_') {
                        if (rl + 1 < MAX_TEXT) { root[rl] = *w; rl++; }
                        w++;
                    }
                    root[rl] = 0;
                    if (*w == '.' || (*w == '-' && *(w + 1) == '>')) {
                        ok = (strcmp(root, inst) == 0);
                        while (ok && (*w == '.' || (*w == '-' && *(w + 1) == '>'))) {
                            w += (*w == '.') ? 1 : 2;
                            if (!((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                                  || *w == '_'))
                                ok = 0;
                            while ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                                   || (*w >= '0' && *w <= '9') || *w == '_') w++;
                        }
                    } else if (strcmp(root, inst) == 0) {
                        ok = 1;
                    } else {
                        for (k = 0; k < b->nparams; k++)
                            if (strcmp(root, b->params[k]) == 0) { ok = 1; break; }
                        if (!ok && self->find_var(root) >= 0) ok = 1;
                    }
                    while (*w == ' ' || *w == '\t') w++;
                    if (*w) ok = 0;
                }
            }
            if (!ok) {
                snprintf(msg, sizeof msg, "map argument '%s' is not allowed", arg + ai);
                return self->fail(msg);
            }
            if (*p == ',') { p++; continue; }
            if (*p == ')') continue;
            return self->fail("unterminated map call");
        }
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        if (*p) return self->fail("trailing text after the map call");
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        const char *inputs[MAX_UNITS];
        int ninput, i, u, o, cn;
        int dirty[MAX_UNITS];
        int cstate[MAX_UNITS];
        int corder[MAX_UNITS];
        const char *outdir;
        char root[MAX_PATH];
        (void)self;

        ninput = 0;
        outdir = NULL;
        self->ninc = 0;
        self->nsroot = NULL;
        self->line_mode = 1;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n",
                       self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, CTC_VERSION);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                outdir = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (self->ninc >= MAX_INCDIRS) {
                    fprintf(stderr, "ctc: too many -I roots\n");
                    return 1;
                }
                self->incdirs[self->ninc] = argv[i];
                self->ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                self->nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= MAX_UNITS) {
                fprintf(stderr, "ctc: too many inputs\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: %s build <input.ct>... -o <dir>\n", self->prog);
            return 1;
        }
        if (!outdir) {
            fprintf(stderr, "ctc: build needs -o <dir>\n");
            return 1;
        }
        if (snprintf(self->outdir, sizeof self->outdir, "%s", outdir) >= (int)sizeof self->outdir) {
            fprintf(stderr, "ctc: output directory is too long\n");
            return 1;
        }
        if (!self->nsroot) {
            if (self->path_dir(inputs[0], root, sizeof root) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
            self->nsroot = root;
        }

        self->nunits = 0;
        self->arena->reset();
        self->nfunc = 0;
        self->nvar = 0;
        self->nscope = 0;
        self->nowner = 0;
        self->leak_active = 0;
        self->leak_frame = -1;
        self->leak_impl = 0;
        self->ret_owned = 0;
        self->ntype = 0;
        self->ntraits = 0;
        self->nstructs = 0;
        self->nrels = 0;
        self->nparams = 0;
        self->self_mode = 0;
        self->ret_type[0] = 0;
        self->ns[0] = 0;
        self->ns_decl[0] = 0;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        self->ncalls = 0;
        ct_diag_reset();
        self->cur_func[0] = 0;
        self->errmsg[0] = 0;
        self->build_mode = 1;

        for (i = 0; i < ninput; i++) {
            if (self->load_unit(inputs[i]) < 0) {
                if (ct_diag_nsem()) fprintf(stderr, "ctc: %d error(s) generated\n", ct_diag_nsem());
                else fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
        }
        /* Incremental cache (Phase 6.3, ported in 10.5): a unit whose key still
           matches and whose .c/.h are on disk is not regenerated. The walk is a
           dependency-first postorder, so a unit's key can fold its dependencies'
           digests; a unit whose dependency is dirty is dirty too. `--emit-map`
           never reuses, because the map spans the whole run. */
        for (u = 0; u < self->nunits; u++) cstate[u] = 0;
        cn = 0;
        for (u = 0; u < self->nunits; u++)
            if (self->cache_order(u, cstate, corder, &cn) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            int k;
            u = corder[o];
            dirty[u] = 1;
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    >= (int)sizeof outc) {
                fprintf(stderr, "ctc: output path is too long\n");
                return 1;
            }
            if (!self->have_map && self->cache_key(u, key, sizeof key) == 0
                && self->cache_hit(outc, key))
                dirty[u] = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (dirty[self->units[u].depu[k]]) dirty[u] = 1;
        }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            u = corder[o];
            if (!dirty[u]) continue;
            if (self->emit_unit(u) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
            if (self->write_unit_header(u) != 0) {
                fprintf(stderr, "ctc: %s\n", self->errmsg);
                return 1;
            }
            /* stamped only after a successful emit: a failed unit must never be
               reused, and a stale key must never vouch for new sources */
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    < (int)sizeof outc
                && self->cache_key(u, key, sizeof key) == 0)
                self->cache_store(outc, key);
        }
        if (self->have_map && self->write_map(self->map_path, self->units[0].prog, 0) != 0) {
            fprintf(stderr, "ctc: %s\n", self->errmsg);
            return 1;
        }
        /* The command the user runs next, in the same shape L2 prints; the
           target C standard (Phase 6.4) is the only option it carries. */
        printf("cc %s", self->std_flag);
        for (u = 0; u < self->nunits; u++)
            printf(" %s/%s.c", self->outdir, self->units[u].base);
        printf(" -o a.out\n");
        if (ct_diag_emit(self->diag_json, 1) != 0) return 1;
        return 0;
    }
}

impl EmitOps for Ast {
    int emit_indent(int n)
    {
        int i;
        (void)self;
        for (i = 0; i < n * 4; i++) fputc(' ', self->out);
        return 0;
    }

    /* Fresh state for one statement's hoist scan. The statement's `next` is the
       following statement (not part of this expression), so it is cut off
       while the children are walked. */
    int hoist_rvalue(int n)
    {
        int saved;
        (void)self;
        self->nhoist = 0;
        saved = self->arena->nodes[n].next;
        self->arena->nodes[n].next = -1;
        if (self->hoist_scan(n) != 0) {
            self->arena->nodes[n].next = saved;
            return -1;
        }
        self->arena->nodes[n].next = saved;
        return 0;
    }

    /* A chain like `f().a.b` as a method receiver has to be materialised: C
       will not take the address of the call result. Root calls are recorded
       and named `__ct_tmpN`. */
    int hoist_scan(int n)
    {
        int root;
        (void)self;

        if (n < 0) return 0;
        if (self->arena->nodes[n].kind == N_MCALL) {
            root = self->arena->nodes[n].a;
            while (root >= 0 && (self->arena->nodes[root].kind == N_MEMBER
                                 || self->arena->nodes[root].kind == N_ARROW))
                root = self->arena->nodes[root].a;
            if (root >= 0 && self->arena->nodes[root].kind == N_CALL
                && !self->arena->nodes[root].text3[0]
                && self->find_func(self->arena->nodes[root].text2) >= 0) {
                if (self->nhoist >= MAX_HOISTS)
                    return self->fail("too many hoisted receivers in one statement");
                snprintf(self->arena->nodes[root].text3, MAX_TEXT, "__ct_tmp%d", self->ntmp);
                self->ntmp++;
                self->hoist_calls[self->nhoist] = root;
                self->nhoist++;
            }
        }
        if (self->arena->nodes[n].a >= 0 && self->hoist_scan(self->arena->nodes[n].a) != 0) return -1;
        if (self->arena->nodes[n].b >= 0 && self->hoist_scan(self->arena->nodes[n].b) != 0) return -1;
        if (self->arena->nodes[n].c >= 0 && self->hoist_scan(self->arena->nodes[n].c) != 0) return -1;
        if (self->arena->nodes[n].d >= 0 && self->hoist_scan(self->arena->nodes[n].d) != 0) return -1;
        if (self->arena->nodes[n].next >= 0 && self->hoist_scan(self->arena->nodes[n].next) != 0) return -1;
        return 0;
    }

    int emit_hoists(int ind)
    {
        int i, f;
        (void)self;

        for (i = 0; i < self->nhoist; i++) {
            f = self->find_func(self->arena->nodes[self->hoist_calls[i]].text2);
            if (f < 0) return self->fail("cannot infer the type of a hoisted receiver");
            self->emit_indent(ind);
            fprintf(self->out, "%s %s = ", self->funcs[f].ret, self->arena->nodes[self->hoist_calls[i]].text3);
            self->raw_call = self->hoist_calls[i];
            if (self->emit_expr(self->hoist_calls[i]) != 0) {
                self->raw_call = -1;
                return -1;
            }
            self->raw_call = -1;
            fputs(";\n", self->out);
        }
        self->nhoist = 0;
        return 0;
    }

    /* PP lines, then types/globals in source order, then prototypes, then the
       definitions. Prototypes come after the type declarations they may use. */
    int emit_program(int prog)
    {
        int n, i;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_PP) fprintf(self->out, "%s\n", self->arena->nodes[n].text);

        if (self->emit_struct_fwd() != 0) return -1;
        if (self->emit_trait_decls() != 0) return -1;
        if (self->emit_vtable_fwd(prog) != 0) return -1;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
                || self->arena->nodes[n].kind == N_GLOBAL) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        if (self->emit_impls(prog) != 0) return -1;

        for (i = 0; i < self->nfunc; i++)
            if (self->emit_proto(i) != 0) return -1;

        if (self->emit_maps(-1) != 0) return -1;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_FUNC) {
                if (self->emit_node(n, 0) != 0) return -1;
            }
        }
        if (self->emit_unit_init(prog) != 0) return -1;
        return 0;
    }

    /* One prototype line for `self->funcs[i]`. */
    int emit_proto(int i)
    {
        int k;
        (void)self;

        if (self->funcs[i].is_static) fputs("static ", self->out);
        fprintf(self->out, "%s %s(", self->funcs[i].ret, self->funcs[i].name);
        if (self->funcs[i].nparams == 0) {
            fputs("void", self->out);
        } else {
            for (k = 0; k < self->funcs[i].nparams; k++) {
                if (k > 0) fputs(", ", self->out);
                fputs(self->funcs[i].ptype[k], self->out);
                fputs(self->funcs[i].pdim[k], self->out);
            }
        }
        fputs(");\n", self->out);
        return 0;
    }

    /* Tentative definitions so a global declared above an impl can already
       point at its vtable; C99 6.9.2 lets the definition below complete them. */
    int emit_vtable_fwd(int prog)
    {
        int n, si;
        const char *tname;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            tname = self->arena->nodes[n].text2;
            if (strcmp(tname, "Drop") == 0) continue;   /* no vptr, no vtable */
            fprintf(self->out, "static struct %s_vtbl %s_%s_vtable;\n",
                    tname, self->structs[si].name, tname);
        }
        /* a `delete` in a function body runs before the drop definition below */
        for (si = 0; si < self->nstructs; si++)
            if (self->structs[si].uses_drop)
                fprintf(self->out, "static void %s_Drop_drop(void *self);\n", self->structs[si].name);
        if (self->nstructs) fputs("\n", self->out);
        return 0;
    }

    /* One vtable type and one interface type per trait. */
    int emit_trait_decls(void)
    {
        (void)self;
        return self->emit_trait_range(0, self->ntraits, 0);
    }

    /* A vtable field may name a struct by pointer (`void (*m)(void *, struct S *)`)
       before that struct is defined, and a tag first seen inside a parameter
       list would get prototype scope. Declare every tag up front. */
    int emit_struct_fwd(void)
    {
        int i, ti;
        (void)self;

        for (i = 0; i < self->nstructs; i++) {
            ti = self->find_type(self->structs[i].name);
            if (ti < 0 || self->type_kind[ti] != 1) continue;
            fprintf(self->out, "struct %s;\n", self->structs[i].name);
        }
        return 0;
    }

    /* `mode`: 0 = every trait, 1 = exported only, 2 = private only. */
    int emit_trait_range(int start, int end, int mode)
    {
        int t, m, k;
        (void)self;

        for (t = start; t < end; t++) {
            if (mode == 1 && !self->traits[t].is_pub) continue;
            if (mode == 2 && self->traits[t].is_pub) continue;
            fprintf(self->out, "struct %s_vtbl {\n", self->traits[t].name);
            for (m = 0; m < self->traits[t].nm; m++) {
                fprintf(self->out, "    %s (*%s)(void *", self->traits[t].m[m].ret,
                        self->traits[t].m[m].name);
                for (k = 0; k < self->traits[t].m[m].nparams; k++)
                    fprintf(self->out, ", %s", self->traits[t].m[m].ptype[k]);
                fputs(");\n", self->out);
            }
            fputs("};\n", self->out);
            fprintf(self->out, "struct %s_iface {\n    void *self;\n    struct %s_vtbl *vt;\n};\n\n",
                    self->traits[t].name, self->traits[t].name);
        }
        return 0;
    }

    int type_has_vptr(const char *type)
    {
        const char *base;
        int si;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        return (si >= 0 && self->structs[si].nuse > 0) ? 1 : 0;
    }

    /* Does this *value* type need a vptr written somewhere -- itself or through a
       nested value field? `Outer { Inner in; }` needs one even though Outer uses
       no trait of its own. Pointer types are not initialised this way. */
    int type_needs_init(const char *type)
    {
        const char *base;
        char tb[MAX_TEXT];
        size_t tl;
        int si, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        snprintf(tb, sizeof tb, "%s", base);
        tl = strlen(tb);
        while (tl > 0 && (tb[tl - 1] == ' ')) {
            tl--;
            tb[tl] = 0;
        }
        if (strchr(tb, '*') != 0) return 0;
        si = self->find_struct(tb);
        if (si < 0) return 0;
        if (self->structs[si].nuse > 0) return 1;
        for (fi = 0; fi < self->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", self->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (self->type_needs_init(ft)) return 1;
        }
        return 0;
    }

    int emit_vptr_items(const char *prefix, const char *type)
    {
        const char *base;
        int si, u, i;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        if (si < 0) return 0;
        for (u = 0; u < self->structs[si].nuse; u++) {
            char low[MAX_TEXT];
            for (i = 0; self->structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                char c = self->structs[si].use[u][i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            if (u > 0) fputs(", ", self->out);
            fprintf(self->out, "%s.__%s_vptr = &%s_%s_vtable", prefix, low, base, self->structs[si].use[u]);
        }
        return 0;
    }

    /* The statement form of `emit_vptr_items`: write `recv.__x_vptr = ...` (and
       one level of nested value fields) for an object that could not carry an
       initialiser -- an array element, or a heap object after malloc. */
    int emit_vptr_stmts(const char *recv, const char *type, int ind)
    {
        const char *base;
        char tb[MAX_TEXT];
        size_t tl;
        int si, u, i, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        snprintf(tb, sizeof tb, "%s", base);
        tl = strlen(tb);
        while (tl > 0 && (tb[tl - 1] == '*' || tb[tl - 1] == ' ')) {
            tl--;
            tb[tl] = 0;
        }
        si = self->find_struct(tb);
        if (si < 0) return 0;
        for (u = 0; u < self->structs[si].nuse; u++) {
            char low[MAX_TEXT];
            for (i = 0; self->structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                char c = self->structs[si].use[u][i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            self->emit_indent(ind);
            fprintf(self->out, "%s.__%s_vptr = &%s_%s_vtable;\n", recv, low, tb, self->structs[si].use[u]);
        }
        for (fi = 0; fi < self->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            char sub[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", self->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (self->structs[si].fields[fi].dims[0]) continue;  /* handled by the loop form */
            if (!self->type_needs_init(ft)) continue;
            snprintf(sub, sizeof sub, "%s.%s", recv, self->structs[si].fields[fi].name);
            if (self->emit_vptr_stmts(sub, ft, ind) != 0) return -1;
        }
        return self->emit_array_field_vptrs(si, recv, ind);
    }

    /* File-scope arrays cannot carry per-element writes in an initialiser, so
       they go into the per-unit constructor (the same shape as D5=A in the old
       pipeline). Emitted only when such an array exists. */
    int emit_unit_init(int prog)
    {
        int n, any;
        (void)self;

        any = 0;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_GLOBAL && self->type_needs_init(self->arena->nodes[n].text)
                && (self->arena->nodes[n].text3[0]
                    || self->type_has_array_init(self->arena->nodes[n].text))) any = 1;
        if (!any) return 0;
        fputs("static void __ct_init(void) __attribute__((constructor));\n", self->out);
        fputs("static void __ct_init(void) {\n", self->out);
        fputs("    unsigned long __ct_i;\n", self->out);
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            char cnt[MAX_TEXT];
            char recv[MAX_TEXT];
            int i, k;
            if (self->arena->nodes[n].kind != N_GLOBAL) continue;
            if (!self->type_needs_init(self->arena->nodes[n].text)) continue;
            if (!self->arena->nodes[n].text3[0]) {
                /* a scalar object whose struct has array fields */
                if (self->type_has_array_init(self->arena->nodes[n].text)
                    && self->emit_vptr_stmts(self->arena->nodes[n].text2, self->arena->nodes[n].text, 2) != 0)
                    return -1;
                continue;
            }
            /* the count is the first bracket group of the suffix */
            k = 0;
            for (i = 1; self->arena->nodes[n].text3[i] && self->arena->nodes[n].text3[i] != ']' && k + 1 < MAX_TEXT; i++) {
                cnt[k] = self->arena->nodes[n].text3[i];
                k++;
            }
            cnt[k] = 0;
            snprintf(recv, sizeof recv, "%s[__ct_i]", self->arena->nodes[n].text2);
            fprintf(self->out, "    for (__ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
            if (self->emit_vptr_stmts(recv, self->arena->nodes[n].text, 2) != 0) return -1;
            fputs("    }\n", self->out);
        }
        fputs("}\n\n", self->out);
        return 0;
    }

    /* A captured `{ ... }` initializer; vptr items are appended before the final
       brace. An empty list gets `{ items }` without a dangling comma. */
    int emit_raw_init(int raw, const char *type)
    {
        const char *t;
        const char *base;
        int len, i, only_space, si;
        (void)self;

        t = self->arena->nodes[raw].text;
        len = (int)strlen(t);
        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        fputs(" = ", self->out);
        if (len < 2 || t[len - 1] != '}') {
            fputs(t, self->out);
            return 0;
        }
        only_space = 1;
        for (i = 1; i < len - 1; i++)
            if (t[i] != ' ' && t[i] != '\t' && t[i] != '\n' && t[i] != '\r') only_space = 0;
        if (only_space) {
            fputs("{ ", self->out);
            if (self->type_has_vptr(type)) {
                if (self->emit_vptr_items("", type) != 0) return -1;
            }
            if (si >= 0 && self->emit_field_vptrs(si, self->type_has_vptr(type)) != 0) return -1;
            fputs(" }", self->out);
            return 0;
        }
        fwrite(t, 1, (size_t)(len - 1), self->out);
        if (self->type_has_vptr(type)) {
            fputs(", ", self->out);
            if (self->emit_vptr_items("", type) != 0) return -1;
        }
        /* the captured text already has members, so a nested item needs its comma */
        if (si >= 0 && self->emit_field_vptrs(si, 1) != 0) return -1;
        fputs("}", self->out);
        return 0;
    }

    /* A struct-typed field with traits of its own needs a nested designator
       (`.owner.__greeter_vptr = ...`), or `s.owner.greet()` dereferences NULL. */
    int emit_field_vptrs(int si, int started)
    {
        int fi;
        (void)self;
        for (fi = 0; fi < self->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            char prefix[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", self->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;          /* a borrowed pointer, not a value */
            if (self->structs[si].fields[fi].dims[0]) continue;  /* an array: no designator reaches it */
            if (!self->type_needs_init(ft)) continue;
            snprintf(prefix, sizeof prefix, ".%s", self->structs[si].fields[fi].name);
            if (started) fputs(", ", self->out);
            if (self->emit_vptr_items(prefix, ft) != 0) return -1;
            started = 1;
        }
        return 0;
    }

    /* vptr writes for struct-typed array fields. A designated initialiser cannot
       reach an array element (`.f.__x_vptr` is not valid C), so the caller emits
       these as statements after the declaration. One loop per dimension. */
    int emit_array_field_vptrs(int si, const char *recv, int ind)
    {
        int fi;
        (void)self;
        for (fi = 0; fi < self->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            char sub[MAX_TEXT];
            const char *d;
            int depth, started;
            if (!self->structs[si].fields[fi].dims[0]) continue;
            snprintf(ft, sizeof ft, "%s", self->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (!self->type_needs_init(ft)) continue;
            snprintf(sub, sizeof sub, "%s.%s", recv, self->structs[si].fields[fi].name);
            d = self->structs[si].fields[fi].dims;
            depth = 0;
            started = 0;
            while (*d == '[') {
                const char *close = strchr(d, ']');
                char bound[MAX_TEXT];
                size_t bl;
                if (!close) break;
                bl = (size_t)(close - d - 1);
                if (bl >= sizeof bound) bl = sizeof bound - 1;
                memcpy(bound, d + 1, bl);
                bound[bl] = 0;
                if (!bound[0]) break;   /* `[]`: not a definition */
                self->emit_indent(ind + depth);
                fprintf(self->out, "for (unsigned long __ct_j%d = 0; __ct_j%d < %s; __ct_j%d++) {\n",
                        depth, depth, bound, depth);
                snprintf(sub, sizeof sub, "%s[__ct_j%d]", sub, depth);
                depth++;
                d = close + 1;
                started = 1;
            }
            if (!started) continue;
            if (self->emit_vptr_stmts(sub, ft, ind + depth) != 0) return -1;
            while (depth > 0) {
                depth--;
                self->emit_indent(ind + depth);
                fputs("}\n", self->out);
            }
        }
        return 0;
    }

    /* Impl methods and their vtables, emitted before the ordinary functions so
       `main` can already dispatch through them. */
    int emit_impls(int prog)
    {
        int n, m, k, u;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, ti;
            const char *tname;
            const char *sname;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            tname = self->arena->nodes[n].text2;
            ti = -1;
            for (k = 0; k < self->ntraits; k++)
                if (strcmp(self->traits[k].name, tname) == 0) ti = k;
            if (ti < 0 && strcmp(tname, "Drop") != 0)
                return self->fail("impl of an unknown trait");
            sname = self->arena->nodes[n].text;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                fprintf(self->out, "static %s %s_%s_%s(void *self",
                        self->arena->nodes[m].text3[0] ? self->arena->nodes[m].text3 : self->arena->nodes[m].text,
                        self->structs[si].name, tname, self->arena->nodes[m].text2);
                k = self->arena->nodes[m].a;
                while (k > 0) {
                    fprintf(self->out, ", %s %s", self->arena->nodes[k].text, self->arena->nodes[k].text2);
                    if (self->arena->nodes[k].text3[0]) fputs(self->arena->nodes[k].text3, self->out);
                    k = self->arena->nodes[k].next;
                }
                fputs(") {\n", self->out);
                fprintf(self->out, "    %s *_self = (%s *)self;\n", sname, sname);
                self->self_mode = 1;
                k = self->arena->nodes[self->arena->nodes[m].b].a;
                while (k >= 0) {
                    if (self->emit_node(k, 1) != 0) {
                        self->self_mode = 0;
                        return -1;
                    }
                    k = self->arena->nodes[k].next;
                }
                self->self_mode = 0;
                fputs("}\n\n", self->out);
            }
            if (strcmp(tname, "Drop") != 0) {
                fprintf(self->out, "static struct %s_vtbl %s_%s_vtable = {\n",
                        tname, self->structs[si].name, tname);
                u = 0;
                for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                    if (u > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s_%s_%s", self->arena->nodes[m].text2,
                            self->structs[si].name, tname, self->arena->nodes[m].text2);
                    u++;
                }
                fputs("\n};\n\n", self->out);
            }
        }
        /* A struct that `use Drop` but writes no impl gets a drop that recurses
           into its Drop-using value fields, the same shape L2 generates. */
        {
        int si;
        for (si = 0; si < self->nstructs; si++) {
            int has = 0, fi, used = 0;
            if (!self->structs[si].uses_drop) continue;
            for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
                if (self->arena->nodes[n].kind == N_IMPL && self->arena->nodes[n].aux == si
                    && strcmp(self->arena->nodes[n].text2, "Drop") == 0) has = 1;
            if (has) continue;
            fprintf(self->out, "static void %s_Drop_drop(void *self) {\n", self->structs[si].name);
            fprintf(self->out, "    struct %s *_self = (struct %s *)self;\n",
                    self->structs[si].name, self->structs[si].name);
            for (fi = 0; fi < self->structs[si].nfields; fi++) {
                char base[MAX_TEXT];
                const char *ft = self->structs[si].fields[fi].type;
                size_t bl;
                int ci;
                if (strncmp(ft, "struct ", 7) == 0) ft += 7;
                snprintf(base, sizeof base, "%s", ft);
                bl = strlen(base);
                while (bl > 0 && (base[bl - 1] == '*' || base[bl - 1] == ' ')) {
                    bl = bl - 1;
                    base[bl] = 0;
                }
                ci = self->find_struct(base);
                if (ci >= 0 && self->structs[ci].uses_drop) {
                    fprintf(self->out, "    %s_Drop_drop(&_self->%s);\n",
                            self->structs[ci].name, self->structs[si].fields[fi].name);
                    used = 1;
                }
            }
            if (!used) fputs("    (void)_self;\n", self->out);
            fputs("}\n\n", self->out);
        }
        }
        return 0;
    }

    /* The instance-level wrappers and vtable of every `map` (Phase 11.1). Emitted
       after the prototypes so a bound call may name any top-level function.
       `u` is the unit being emitted in build mode (only its own maps belong in
       its `.c`); `-1` emits every map, which is what compile mode wants. */
    int emit_maps(int u)
    {
        int i, j, k;
        (void)self;

        for (i = 0; i < self->nmaps; i++) {
            if (u >= 0 && self->maps[i].unit != u) continue;
            for (j = 0; j < self->maps[i].nb; j++) {
                MapBind *b;
                MethodSig *sig;
                b = &self->maps[i].b[j];
                sig = &self->traits[b->ti].m[b->mi];
                fprintf(self->out, "static %s %s(void *self", sig->ret, b->wrapper);
                for (k = 0; k < b->nparams; k++)
                    fprintf(self->out, ", %s %s", sig->ptype[k], b->params[k]);
                fputs(") {\n", self->out);
                fputs("    (void)self;\n", self->out);
                if (strcmp(sig->ret, "void") != 0)
                    fprintf(self->out, "    return %s;\n", b->call);
                else
                    fprintf(self->out, "    %s;\n", b->call);
                fputs("}\n", self->out);
            }
            if (self->maps[i].nb > 0) {
                fprintf(self->out, "static struct %s_vtbl %s = {\n",
                        self->maps[i].trait, self->maps[i].vtable);
                for (j = 0; j < self->maps[i].nb; j++) {
                    if (j > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s", self->maps[i].b[j].method,
                            self->maps[i].b[j].wrapper);
                }
                fputs("\n};\n\n", self->out);
            }
        }
        return 0;
    }

    /* Top-level declarations: struct / typedef / global (with a semicolon as
       appropriate). */
    int emit_type_decl(int n, int ind, int with_semi)
    {
        int m;
        (void)self;

        if (self->arena->nodes[n].kind == N_STRUCT) {
            int si, u;
            if (self->arena->nodes[n].aux) {
                /* `typedef struct Tag { ... } Name;` keeps the tag so a
                   `struct Tag` reference (or self-reference) stays valid */
                if (self->arena->nodes[n].text[0]) {
                    fprintf(self->out, "typedef struct %s {\n", self->arena->nodes[n].text);
                } else {
                    fputs("typedef struct {\n", self->out);
                }
            } else {
                fprintf(self->out, "struct %s {\n", self->arena->nodes[n].text2);
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                self->emit_indent(ind + 1);
                if (self->emit_inline(m) != 0) return -1;
                fputs(";\n", self->out);
            }
            si = self->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (u = 0; u < self->structs[si].nuse; u++) {
                    char low[MAX_TEXT];
                    int i;
                    for (i = 0; self->structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                        char c = self->structs[si].use[u][i];
                        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                        low[i] = c;
                    }
                    low[i] = 0;
                    self->emit_indent(ind + 1);
                    fprintf(self->out, "struct %s_vtbl *__%s_vptr;\n",
                            self->structs[si].use[u], low);
                }
            }
            self->emit_indent(ind);
            if (self->arena->nodes[n].aux) fprintf(self->out, "} %s;\n", self->arena->nodes[n].text2);
            else fputs("};\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_TYPEDEF) {
            fprintf(self->out, "typedef %s %s;\n", self->arena->nodes[n].text, self->arena->nodes[n].text2);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_GLOBAL) {
            self->emit_indent(ind);
            if (self->arena->nodes[n].aux) fputs("static ", self->out);
            fprintf(self->out, "%s %s", self->arena->nodes[n].text, self->arena->nodes[n].text2);
            if (self->arena->nodes[n].text3[0]) fputs(self->arena->nodes[n].text3, self->out);
            if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW) {
                if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text) != 0) return -1;
            } else if (self->arena->nodes[n].a >= 0) {
                fputs(" = ", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            } else if (self->type_needs_init(self->arena->nodes[n].text) && !self->arena->nodes[n].text3[0]) {
                /* an array gets per-element writes (local) or a constructor
                   (file scope); a designator on the array itself is invalid */
                fputs(" = { ", self->out);
                if (self->emit_vptr_items("", self->arena->nodes[n].text) != 0) return -1;
                if (self->emit_field_vptrs(self->find_struct(
                        strncmp(self->arena->nodes[n].text, "struct ", 7) == 0
                            ? self->arena->nodes[n].text + 7 : self->arena->nodes[n].text),
                        self->type_has_vptr(self->arena->nodes[n].text)) != 0) return -1;
                fputs(" }", self->out);
            }
            if (with_semi) fputs(";\n", self->out);
            return 0;
        }
        return self->fail("unknown declaration node");
    }

    int emit_node(int n, int ind)
    {
        int c;
        (void)self;

        if (self->arena->nodes[n].kind == N_FUNC) {
            if (self->arena->nodes[n].aux) fputs("static ", self->out);
            fprintf(self->out, "%s %s(", self->arena->nodes[n].text, self->arena->nodes[n].text2);
            c = self->arena->nodes[n].a;
            if (c == 0) {
                fputs("void) ", self->out);
            } else {
                int first;
                first = 1;
                while (c > 0) {
                    if (!first) fputs(", ", self->out);
                    fprintf(self->out, "%s %s", self->arena->nodes[c].text, self->arena->nodes[c].text2);
                    if (self->arena->nodes[c].text3[0]) fputs(self->arena->nodes[c].text3, self->out);
                    first = 0;
                    c = self->arena->nodes[c].next;
                }
                fputs(") ", self->out);
            }
            return self->emit_node(self->arena->nodes[n].b, ind);
        }
        if (self->arena->nodes[n].kind == N_BLOCK) {
            fputs("{\n", self->out);
            for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            self->emit_indent(ind);
            fputs("}\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_RET) {
            if (self->hoist_rvalue(n) != 0) return -1;
            if (self->emit_hoists(ind) != 0) return -1;
            self->emit_indent(ind);
            if (self->arena->nodes[n].a < 0) {
                fputs("return;\n", self->out);
                return 0;
            }
            fputs("return ", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DELETE) {
            int si;
            si = -1;
            if (self->arena->nodes[n].text[0]) si = self->find_struct(self->arena->nodes[n].text);
            self->emit_indent(ind);
            if (si >= 0 && self->structs[si].uses_drop) {
                /* a Drop struct runs its drop before the memory goes away */
                fputs("if (", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ") { %s_Drop_drop(", self->structs[si].name);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs("); free(", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs("); }\n", self->out);
                return 0;
            }
            fputs("if (", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(") free(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(");\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_BREAK) {
            self->emit_indent(ind);
            fputs("break;\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CONT) {
            self->emit_indent(ind);
            fputs("continue;\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DECLS) {
            int c = self->arena->nodes[n].a;
            while (c >= 0) {
                self->emit_indent(ind);
                if (self->emit_inline(c) != 0) return -1;
                fputs(";\n", self->out);
                c = self->arena->nodes[c].next;
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DECL) {
            const char *tp = self->arena->nodes[n].text;
            size_t tl = strlen(tp);
            int heap_ptr = 0;

            /* `T *p = malloc(..)` writes its vptrs on the next line */
            if (tl > 0 && tp[tl - 1] == '*' && self->arena->nodes[n].a >= 0
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_CALL
                && (strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "malloc") == 0
                    || strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "calloc") == 0))
                heap_ptr = 1;

            if (self->arena->nodes[n].text3[0] && self->arena->nodes[n].a < 0 && self->type_needs_init(tp)) {
                /* a local array of trait-carrying values: one loop writes every
                   element's vptr (`Type name[n];` has no initialiser to extend) */
                char cnt[MAX_TEXT];
                char recv[MAX_TEXT];
                size_t ci;
                int k = 0;
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", self->out);
                for (ci = 1; self->arena->nodes[n].text3[ci] && self->arena->nodes[n].text3[ci] != ']'
                           && k + 1 < MAX_TEXT; ci++) {
                    cnt[k] = self->arena->nodes[n].text3[ci];
                    k++;
                }
                cnt[k] = 0;
                snprintf(recv, sizeof recv, "%s[__ct_i]", self->arena->nodes[n].text2);
                self->emit_indent(ind);
                fprintf(self->out, "for (unsigned long __ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
                if (self->emit_vptr_stmts(recv, tp, ind + 1) != 0) return -1;
                self->emit_indent(ind);
                fputs("}\n", self->out);
                return 0;
            }
            if (!self->arena->nodes[n].text3[0] && self->type_needs_init(tp)
                && (self->arena->nodes[n].a < 0
                    || self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW)
                && self->type_has_array_init(tp)) {
                /* a struct-typed array field cannot be reached by a designator,
                   so its elements get their vptrs on the lines after */
                const char *base = tp;
                int si;
                if (strncmp(base, "struct ", 7) == 0) base += 7;
                si = self->find_struct(base);
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", self->out);
                return self->emit_array_field_vptrs(si, self->arena->nodes[n].text2, ind);
            }
            if (heap_ptr) {
                char recv[MAX_TEXT];
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", self->out);
                snprintf(recv, sizeof recv, "(*%s)", self->arena->nodes[n].text2);
                return self->emit_vptr_stmts(recv, tp, ind);
            }
        }
        if (self->arena->nodes[n].kind == N_DECL || self->arena->nodes[n].kind == N_ASSIGN
            || self->arena->nodes[n].kind == N_EXPR || self->arena->nodes[n].kind == N_POST) {
            if (self->hoist_rvalue(n) != 0) return -1;
            if (self->emit_hoists(ind) != 0) return -1;
            self->emit_indent(ind);
            if (self->emit_inline(n) != 0) return -1;
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_IF) {
            self->emit_indent(ind);
            fputs("if (", self->out);
            if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
            fputs(") ", self->out);
            if (self->emit_node(self->arena->nodes[n].b, ind) != 0) return -1;
            if (self->arena->nodes[n].c >= 0) {
                self->emit_indent(ind);
                fputs("else ", self->out);
                if (self->emit_node(self->arena->nodes[n].c, ind) != 0) return -1;
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_WHILE) {
            self->emit_indent(ind);
            fputs("while (", self->out);
            if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
            fputs(") ", self->out);
            return self->emit_node(self->arena->nodes[n].b, ind);
        }
        if (self->arena->nodes[n].kind == N_FOR) {
            self->emit_indent(ind);
            fputs("for (", self->out);
            if (self->arena->nodes[n].a >= 0 && self->emit_inline(self->arena->nodes[n].a) != 0) return -1;
            fputs("; ", self->out);
            if (self->arena->nodes[n].b >= 0 && self->emit_cond(self->arena->nodes[n].b) != 0) return -1;
            fputs("; ", self->out);
            if (self->arena->nodes[n].c >= 0 && self->emit_inline(self->arena->nodes[n].c) != 0) return -1;
            fputs(") ", self->out);
            return self->emit_node(self->arena->nodes[n].d, ind);
        }
        {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "unknown statement node (kind %d)", self->arena->nodes[n].kind);
            return self->fail(msg);
        }
    }

    int emit_inline(int n)
    {
        (void)self;

        if (self->arena->nodes[n].kind == N_DECLS) {
            /* a `for` initialiser: one shared type, then bare declarators */
            int c = self->arena->nodes[n].a, first = 1;
            while (c >= 0) {
                if (first) {
                    if (self->emit_inline(c) != 0) return -1;
                } else {
                    fputs(", ", self->out);
                    fputs(self->arena->nodes[c].text2, self->out);
                    if (self->arena->nodes[c].text3[0]) fputs(self->arena->nodes[c].text3, self->out);
                    if (self->arena->nodes[c].a >= 0) {
                        if (self->arena->nodes[self->arena->nodes[c].a].kind == N_RAW) {
                            if (self->emit_raw_init(self->arena->nodes[c].a, self->arena->nodes[c].text) != 0) return -1;
                        } else {
                            fputs(" = ", self->out);
                            if (self->emit_expr(self->arena->nodes[c].a) != 0) return -1;
                        }
                    }
                }
                first = 0;
                c = self->arena->nodes[c].next;
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DECL || self->arena->nodes[n].kind == N_FIELD) {
            fprintf(self->out, "%s %s", self->arena->nodes[n].text, self->arena->nodes[n].text2);
            if (self->arena->nodes[n].text3[0]) fputs(self->arena->nodes[n].text3, self->out);
            if (self->arena->nodes[n].kind == N_DECL) {
                if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW) {
                    if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text) != 0) return -1;
                } else if (self->arena->nodes[n].a >= 0) {
                    fputs(" = ", self->out);
                    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                } else if (self->type_needs_init(self->arena->nodes[n].text) && !self->arena->nodes[n].text3[0]) {
                    fputs(" = { ", self->out);
                    if (self->emit_vptr_items("", self->arena->nodes[n].text) != 0) return -1;
                    if (self->emit_field_vptrs(self->find_struct(
                            strncmp(self->arena->nodes[n].text, "struct ", 7) == 0
                                ? self->arena->nodes[n].text + 7 : self->arena->nodes[n].text),
                            self->type_has_vptr(self->arena->nodes[n].text)) != 0) return -1;
                    fputs(" }", self->out);
                }
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ASSIGN) {
            const char *aop = " = ";
            if (self->arena->nodes[n].aux == 1) aop = " += ";
            else if (self->arena->nodes[n].aux == 2) aop = " -= ";
            else if (self->arena->nodes[n].aux == 3) aop = " *= ";
            else if (self->arena->nodes[n].aux == 4) aop = " /= ";
            else if (self->arena->nodes[n].aux == 5) aop = " %= ";
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(aop, self->out);
            return self->emit_expr(self->arena->nodes[n].b);
        }
        if (self->arena->nodes[n].kind == N_EXPR) return self->emit_expr(self->arena->nodes[n].a);
        if (self->arena->nodes[n].kind == N_POST) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
            return 0;
        }
        return self->fail("cannot inline this node");
    }

    int emit_cond(int n)
    {
        const char *op;
        (void)self;

        if (self->arena->nodes[n].kind == N_BIN && self->arena->nodes[n].aux >= B_LT && self->arena->nodes[n].aux <= B_NE) {
            op = "<";
            if (self->arena->nodes[n].aux == B_GT) op = ">";
            else if (self->arena->nodes[n].aux == B_LE) op = "<=";
            else if (self->arena->nodes[n].aux == B_GE) op = ">=";
            else if (self->arena->nodes[n].aux == B_EQ) op = "==";
            else if (self->arena->nodes[n].aux == B_NE) op = "!=";
            else if (self->arena->nodes[n].aux == B_AND) op = "&&";
            else if (self->arena->nodes[n].aux == B_OR) op = "||";
            else if (self->arena->nodes[n].aux == B_XOR) op = "^";
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, " %s ", op);
            return self->emit_expr(self->arena->nodes[n].b);
        }
        return self->emit_expr(n);
    }

    int emit_expr(int n)
    {
        int c;
        const char *op;
        (void)self;

        if (self->arena->nodes[n].kind == N_NUM) {
            fprintf(self->out, "%ld", self->arena->nodes[n].num);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_STR) {
            fputs(self->arena->str_at(self->arena->nodes[n].num), self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_RAW) {
            fputs(self->arena->nodes[n].text, self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_VAR) {
            if (self->self_mode && strcmp(self->arena->nodes[n].text2, "self") == 0) fputs("_self", self->out);
            else fputs(self->arena->nodes[n].text2, self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_MEMBER) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ".%s", self->arena->nodes[n].text2);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ARROW) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, "->%s", self->arena->nodes[n].text2);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_INDEX) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs("[", self->out);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs("]", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ADDR) {
            fputs("(&", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DEREF) {
            fputs("(*", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CAST) {
            fprintf(self->out, "(%s)(", self->arena->nodes[n].text);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_SIZEOF) {
            if (self->arena->nodes[n].aux) {
                fprintf(self->out, "sizeof(%s)", self->arena->nodes[n].text);
                return 0;
            }
            fputs("sizeof(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_POST) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_TERN) {
            fputs("(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(" ? ", self->out);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs(" : ", self->out);
            if (self->emit_expr(self->arena->nodes[n].c) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_BIN) {
            op = "+";
            if (self->arena->nodes[n].aux == B_SUB) op = "-";
            else if (self->arena->nodes[n].aux == B_MUL) op = "*";
            else if (self->arena->nodes[n].aux == B_DIV) op = "/";
            else if (self->arena->nodes[n].aux == B_MOD) op = "%";
            else if (self->arena->nodes[n].aux == B_LT) op = "<";
            else if (self->arena->nodes[n].aux == B_GT) op = ">";
            else if (self->arena->nodes[n].aux == B_LE) op = "<=";
            else if (self->arena->nodes[n].aux == B_GE) op = ">=";
            else if (self->arena->nodes[n].aux == B_EQ) op = "==";
            else if (self->arena->nodes[n].aux == B_NE) op = "!=";
            else if (self->arena->nodes[n].aux == B_AND) op = "&&";
            else if (self->arena->nodes[n].aux == B_OR) op = "||";
            else if (self->arena->nodes[n].aux == B_XOR) op = "^";
            fputs("(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, " %s ", op);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_UNARY) {
            fputs(self->arena->nodes[n].aux == U_NEG ? "(-" : "(!", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_BOX) {
            /* aux: bit 0 = the source operand is a pointer, bit 1 = take the
               address of the literal (a pointer-to-interface target) */
            int a = self->arena->nodes[n].aux;
            if (a >= 2) fputs("&", self->out);
            fprintf(self->out, "(struct %s_iface){ (void *)", self->arena->nodes[n].text);
            if (a == 1 || a == 3) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            } else {
                fputs("&", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            }
            fprintf(self->out, ", &%s_%s_vtable }", self->arena->nodes[n].text2, self->arena->nodes[n].text);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_MCALL) {
            char tname[MAX_TEXT];
            char low[MAX_TEXT];
            int i, c2, rk;
            if (self->arena->nodes[n].a < 0) return self->fail("method call without a receiver");
            rk = self->arena->nodes[self->arena->nodes[n].a].kind;
            if (rk != N_VAR && rk != N_INDEX && rk != N_CALL
                && rk != N_MEMBER && rk != N_ARROW)
                return self->fail("method receiver must be a variable, an element, a call or a field chain");
            if (!self->arena->nodes[n].text[0])
                return self->fail("cannot resolve the method trait (unknown receiver type)");
            snprintf(tname, sizeof tname, "%s", self->arena->nodes[n].text);
            for (i = 0; tname[i] && i + 1 < MAX_TEXT; i++) {
                char c = tname[i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            if (self->arena->nodes[n].aux == 4) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, "->vt->%s(", self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs("->self", self->out);
            } else if (self->arena->nodes[n].aux == 3) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ".vt->%s(", self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(".self", self->out);
            } else if (self->arena->nodes[n].aux == 2) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, "->__%s_vptr->%s(", low, self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            } else {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ".__%s_vptr->%s(&", low, self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            }
            c2 = self->arena->nodes[n].b;
            while (c2 >= 0) {
                fputs(", ", self->out);
                if (self->emit_expr(c2) != 0) return -1;
                c2 = self->arena->nodes[c2].next;
            }
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CALL) {
            if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
                fputs(self->arena->nodes[n].text3, self->out);
                return 0;
            }
            fprintf(self->out, "%s(", self->arena->nodes[n].text2);
            c = self->arena->nodes[n].a;
            while (c >= 0) {
                if (self->emit_expr(c) != 0) return -1;
                c = self->arena->nodes[c].next;
                if (c >= 0) fputs(", ", self->out);
            }
            fputs(")", self->out);
            return 0;
        }
        return self->fail("unknown expression node");
    }

    /* `foo` -> `FOO_H`; a leading digit gets an underscore so the guard is a
       valid identifier. */
    int header_guard(const char *base, char *out, size_t cap)
    {
        size_t n, i, m;
        (void)self;

        n = strlen(base);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            out[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            if (m + 1 >= cap) return self->fail("output name too long");
            out[m] = c;
            m++;
        }
        if (m + 3 >= cap) return self->fail("output name too long");
        out[m] = '_';
        out[m + 1] = 'H';
        out[m + 2] = 0;
        return 0;
    }

    /* Build mode: one `.c` per unit. It includes its own header (so the `pub`
       declarations are visible exactly once) and the headers of its imports. */
    int emit_unit(int u)
    {
        char path[MAX_PATH];
        int n, i;
        FILE *f;
        (void)self;

        if (snprintf(path, sizeof path, "%s/%s.c", self->outdir, self->units[u].base) >= (int)sizeof path)
            return self->fail("output path is too long");
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the output file");
        self->out = f;
        self->path = self->units[u].path;
        fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, self->path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              self->out);
        fprintf(self->out, "#include \"%s.h\"\n", self->units[u].base);
        for (i = 0; i < self->units[u].ndep; i++)
            fprintf(self->out, "#include \"%s.h\"\n", self->units[u].dep[i]);
        fputs("\n", self->out);
        if (self->line_mode) fprintf(self->out, "#line 1 \"%s\"\n", self->path);

        for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_PP) fprintf(self->out, "%s\n", self->arena->nodes[n].text);

        if (self->emit_struct_fwd() != 0) return -1;
        if (self->emit_trait_range(self->units[u].tr_start, self->units[u].tr_end, 2) != 0) return -1;
        if (self->emit_vtable_fwd(self->units[u].prog) != 0) return -1;

        for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if ((self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
                 || self->arena->nodes[n].kind == N_GLOBAL) && self->arena->nodes[n].d != 1) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        if (self->emit_impls(self->units[u].prog) != 0) return -1;

        for (i = self->units[u].fn_start; i < self->units[u].fn_end; i++)
            if (self->emit_proto(i) != 0) return -1;

        if (self->emit_maps(u) != 0) return -1;

        for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_FUNC && self->emit_node(n, 0) != 0) return -1;

        if (fclose(f) != 0) return self->fail("cannot write the output file");
        return 0;
    }

    /* Build mode: the unit's exported surface (D34 keeps the naming contract,
       not byte equality with the old pipeline). */
    int write_unit_header(int u)
    {
        char path[MAX_PATH];
        char guard[MAX_PATH];
        int n, i;
        FILE *f;
        (void)self;

        if (snprintf(path, sizeof path, "%s/%s.h", self->outdir, self->units[u].base) >= (int)sizeof path)
            return self->fail("output path is too long");
        if (self->header_guard(self->units[u].base, guard, sizeof guard) != 0) return -1;
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        self->out = f;
        self->path = self->units[u].path;
        fprintf(self->out, "#ifndef %s\n", guard);
        fprintf(self->out, "#define %s\n\n", guard);
        fprintf(self->out, "/* Generated by ct v%s from %s (multi-file mode: exported types; the matching .c\n"
                       "   includes this header).\n"
                       "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                CTC_VERSION, self->path);
        for (i = 0; i < self->units[u].ndep; i++)
            fprintf(self->out, "#include \"%s.h\"\n", self->units[u].dep[i]);
        if (self->units[u].ndep > 0) fputs("\n", self->out);

        if (self->emit_struct_fwd() != 0) return -1;
        if (self->emit_trait_range(self->units[u].tr_start, self->units[u].tr_end, 1) != 0) return -1;

        for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if ((self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF)
                && self->arena->nodes[n].d == 1) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        for (i = self->units[u].fn_start; i < self->units[u].fn_end; i++) {
            if (!self->funcs[i].is_pub || self->funcs[i].is_static) continue;
            if (self->emit_proto(i) != 0) return -1;
        }

        fputs("\n#endif\n", self->out);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }

    /* JSON string body (no surrounding quotes). */
    int emit_json_str(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
        return 0;
    }

    /* `--emit-map`: the same shape the old pipeline emits (compiler / file /
       traits / structs / functions / impls / calls). `u < 0` means compile
       mode, where the tables cover the single unit. */
    int write_map(const char *dest, int prog, int u)
    {
        FILE *f;
        const char *path;
        int trs, tre, fns, fne, cls, cle;
        int i, j, m, n, first, si, count;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the map");
        }
        if (u >= 0) {
            path = self->units[u].path;
            trs = self->units[u].tr_start;
            tre = self->units[u].tr_end;
            fns = self->units[u].fn_start;
            fne = self->units[u].fn_end;
            cls = self->units[u].call_start;
            cle = self->units[u].call_end;
        } else {
            path = self->path;
            trs = 0;
            tre = self->ntraits;
            fns = 0;
            fne = self->nfunc;
            cls = 0;
            cle = self->ncalls;
        }

        fputs("{\n", f);
        fprintf(f, "  \"compiler\": \"ct v%s\",\n", CTC_VERSION);
        fputs("  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n", f);

        fputs("  \"traits\": [", f);
        first = 1;
        for (i = trs; i < tre; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->traits[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->traits[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"methods\":[", self->traits[i].line);
            for (m = 0; m < self->traits[i].nm; m++) {
                if (m > 0) fputc(',', f);
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, self->traits[i].m[m].name);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->traits[i].m[m].ret);
                fprintf(f, "\",\"params\":%d}", self->traits[i].m[m].nparams);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"structs\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_STRUCT) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"uses\":[", self->arena->nodes[n].line);
            si = self->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < self->structs[si].nuse; i++) {
                    if (i > 0) fputc(',', f);
                    fputc('"', f);
                    self->emit_json_str(f, self->structs[si].use[i]);
                    fputc('"', f);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"functions\": [", f);
        first = 1;
        for (i = fns; i < fne; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->funcs[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"ret\":\"", self->funcs[i].line);
            self->emit_json_str(f, self->funcs[i].ret);
            fprintf(f, "\",\"params\":%d}", self->funcs[i].nparams);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"impls\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            const char *tname;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            tname = self->arena->nodes[n].text2;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                if (!first) fputc(',', f);
                fputs("{\"struct\":\"", f);
                self->emit_json_str(f, self->structs[si].name);
                fputs("\",\"trait\":\"", f);
                self->emit_json_str(f, tname);
                fputs("\",\"method\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text2);
                fputs("\",\"symbol\":\"", f);
                fprintf(f, "%s_%s_%s", self->structs[si].name, tname, self->arena->nodes[m].text2);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text);
                count = 0;
                for (i = self->arena->nodes[m].a; i > 0; i = self->arena->nodes[i].next) count++;
                fprintf(f, "\",\"params\":%d,\"file\":\"", count);
                self->emit_json_str(f, path);
                fprintf(f, "\",\"line\":%d}", self->arena->nodes[n].line);
                first = 0;
            }
        }
        fputs("],\n", f);

        fputs("  \"calls\": [", f);
        for (i = cls; i < cle; i++) {
            if (i > cls) fputc(',', f);
            fputs("{\"caller\":\"", f);
            self->emit_json_str(f, self->calls[i].caller);
            fputs("\",\"callee\":\"", f);
            self->emit_json_str(f, self->calls[i].callee);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", self->calls[i].line);
        }
        fputs("],\n", f);

        fputs("  \"maps\": [", f);
        for (i = 0; i < self->nmaps; i++) {
            if (i > 0) fputc(',', f);
            fputs("{\"trait\":\"", f);
            self->emit_json_str(f, self->maps[i].trait);
            fputs("\",\"instance\":\"", f);
            self->emit_json_str(f, self->maps[i].inst);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"bindings\":[", self->maps[i].line);
            for (j = 0; j < self->maps[i].nb; j++) {
                if (j > 0) fputc(',', f);
                fputs("{\"method\":\"", f);
                self->emit_json_str(f, self->maps[i].b[j].method);
                fputs("\",\"symbol\":\"", f);
                self->emit_json_str(f, self->maps[i].b[j].wrapper);
                fputs("\"}", f);
            }
            fputs("]}", f);
        }
        fputs("]\n", f);
        fputs("}\n", f);

        if (f != stdout) {
            if (fclose(f) != 0) return self->fail("cannot write the map");
        }
        return 0;
    }

    /* Compile mode: a placeholder header (types only; the .c is self-contained). */
    int write_header(const char *outc)
    {
        char path[MAX_PATH];
        char base[MAX_PATH];
        char guard[MAX_PATH];
        const char *name;
        FILE *f;
        size_t n;

        (void)self;
        if (snprintf(path, sizeof path, "%s", outc) >= (int)sizeof path)
            return self->fail("output path too long");
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        if (snprintf(base, sizeof base, "%s", name) >= (int)sizeof base)
            return self->fail("output path too long");
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        if (self->header_guard(base, guard, sizeof guard) != 0) return -1;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                CTC_VERSION, self->path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }
}

/* Error recovery: the two token-skipping helpers. Everything that stores a
   diagnostic now lives in diag.ct. */
impl RecoverOps for Ast {
    /* Skip a balanced `{ ... }` group (the lexer sits on its `{`) so a rejected
       construct does not swallow the declarations that follow it. */
    int skip_body(void)
    {
        int depth;
        (void)self;
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "{") != 0)
            return self->fail("expected '{'");
        depth = 0;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                depth++;
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0) {
                depth--;
                if (depth == 0) {
                    self->lex_next();
                    return 0;
                }
            }
            self->lex_next();
        }
        return self->fail("unterminated body");
    }

    /* Resynchronisation after a reported error: stop past the next `}` or at the
       start of the next line, whichever comes first (L2's recover_pos). */
    int skip_after_error(void)
    {
        (void)self;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0) {
                self->lex_next();
                return 0;
            }
            self->lex_next();
            if (self->lex->bol) return 0;
        }
        return 0;
    }
}

impl MemoryOps for Ast {
    /* `own T *x = malloc(...)`: the declaration is validated and remembered so
       the enclosing block can append its release (L2's AutoDrop). */
    int mark_owned(int n, int line)
    {
        int d;
        (void)self;
        d = n;
        if (self->arena->nodes[n].kind == N_DECLS) d = self->arena->nodes[n].a;
        while (d >= 0) {
            char base[MAX_TEXT];
            char msg[MAX_TEXT];
            const char *tp = self->arena->nodes[d].text;
            size_t bl;
            int si, vi;
            if (self->arena->nodes[d].text3[0] != 0)
                return ct_sem_error(line, 1, "'own' does not support arrays", self->path);
            if (!self->expr_alloc(self->arena->nodes[d].a))
                return ct_sem_error(line, 1,
                                       "'own' requires a malloc or calloc initialiser", self->path);
            if (strncmp(tp, "struct ", 7) == 0) tp += 7;
            snprintf(base, sizeof base, "%s", tp);
            bl = strlen(base);
            while (bl > 0 && (base[bl - 1] == '*' || base[bl - 1] == ' ')) {
                bl = bl - 1;
                base[bl] = 0;
            }
            si = self->find_struct(base);
            if (si < 0 || !self->structs[si].uses_drop) {
                snprintf(msg, sizeof msg, "struct '%s' does not use trait 'Drop'", base);
                return ct_sem_error(line, 1, msg, self->path);
            }
            vi = self->find_var(self->arena->nodes[d].text2);
            if (vi >= 0) self->vars[vi].autodrop = 1;
            if (self->nowner >= MAX_VARS) return self->fail("too many owned variables");
            self->own_decl[self->nowner] = d;
            self->nowner++;
            d = self->arena->nodes[d].next;
        }
        return 0;
    }

    /* Is this expression a direct `malloc` / `calloc` call? Only that spelling
       counts, exactly as in L2 (a cast in front already hides the allocation). */
    int expr_alloc(int e)
    {
        (void)self;
        if (e < 0) return 0;
        if (self->arena->nodes[e].kind != N_CALL) return 0;
        if (strcmp(self->arena->nodes[e].text2, "malloc") == 0) return 1;
        if (strcmp(self->arena->nodes[e].text2, "calloc") == 0) return 1;
        return 0;
    }

    /* Does any name in the expression spell `name`? Field names count too: L2
       scans words on the line, not values. */
    int expr_mentions(int e, const char *name)
    {
        int p;
        (void)self;
        if (e < 0) return 0;
        if (self->arena->nodes[e].kind == N_VAR) return strcmp(self->arena->nodes[e].text2, name) == 0;
        if (self->arena->nodes[e].kind == N_MEMBER || self->arena->nodes[e].kind == N_ARROW) {
            if (strcmp(self->arena->nodes[e].text2, name) == 0) return 1;
            return self->expr_mentions(self->arena->nodes[e].a, name);
        }
        if (self->arena->nodes[e].kind == N_CALL) {
            if (strcmp(self->arena->nodes[e].text2, name) == 0) return 1;
            for (p = self->arena->nodes[e].a; p >= 0; p = self->arena->nodes[p].next)
                if (self->expr_mentions(p, name)) return 1;
            return 0;
        }
        if (self->expr_mentions(self->arena->nodes[e].a, name)) return 1;
        if (self->expr_mentions(self->arena->nodes[e].b, name)) return 1;
        if (self->expr_mentions(self->arena->nodes[e].c, name)) return 1;
        if (self->expr_mentions(self->arena->nodes[e].d, name)) return 1;
        return 0;
    }

    /* Does the expression hand `name` back by value? A field or member read
       (`p->n`, `p.n`) is not a transfer; `p` and `p[0]` are, matching the
       character test L2 applies after the name. */
    int expr_returns(int e, const char *name)
    {
        int p;
        (void)self;
        if (e < 0) return 0;
        if (self->arena->nodes[e].kind == N_VAR) return strcmp(self->arena->nodes[e].text2, name) == 0;
        if (self->arena->nodes[e].kind == N_MEMBER || self->arena->nodes[e].kind == N_ARROW) return 0;
        if (self->arena->nodes[e].kind == N_INDEX) return self->expr_returns(self->arena->nodes[e].a, name);
        if (self->arena->nodes[e].kind == N_CALL) {
            for (p = self->arena->nodes[e].a; p >= 0; p = self->arena->nodes[p].next)
                if (self->expr_returns(p, name)) return 1;
            return 0;
        }
        if (self->expr_returns(self->arena->nodes[e].a, name)) return 1;
        if (self->expr_returns(self->arena->nodes[e].b, name)) return 1;
        if (self->expr_returns(self->arena->nodes[e].c, name)) return 1;
        if (self->expr_returns(self->arena->nodes[e].d, name)) return 1;
        return 0;
    }

    /* Is `ret` a pointer to struct `si`? L2 compares the recorded return type
       with the variable's struct before trusting its `ret_owned` hint. */
    int ret_same_struct(const char *ret, int si)
    {
        char rt[MAX_TEXT];
        size_t bl;
        (void)self;
        bl = strlen(ret);
        if (bl == 0 || ret[bl - 1] != '*') return 0;
        snprintf(rt, sizeof rt, "%s", ret);
        bl = strlen(rt);
        while (bl > 0 && (rt[bl - 1] == '*' || rt[bl - 1] == ' ')) {
            bl = bl - 1;
            rt[bl] = 0;
        }
        if (strncmp(rt, "struct ", 7) == 0)
            return strcmp(rt + 7, self->structs[si].name) == 0;
        return strcmp(rt, self->structs[si].name) == 0;
    }

    /* A declaration: `struct T *p = malloc(...)` (or a call to a function that
       returns an owned pointer of the same struct) starts tracking `p`. Any
       other owned variable named in the initialiser escapes here, because L2
       runs its assignment scan on the declaration line as well. */
    int leak_decl(int n)
    {
        int e, vi, i, si, heap, call_owned;
        (void)self;

        e = self->arena->nodes[n].a;
        if (e < 0) return 0;
        heap = self->expr_alloc(e);
        call_owned = 0;
        si = -1;
        {
            char base[MAX_TEXT];
            char sname[MAX_TEXT];
            const char *tp = self->arena->nodes[n].text;
            size_t bl = strlen(tp);
            if (bl > 0 && tp[bl - 1] == '*' && self->arena->nodes[n].text3[0] == 0) {
                snprintf(base, sizeof base, "%s", tp);
                bl = strlen(base);
                while (bl > 0 && (base[bl - 1] == '*' || base[bl - 1] == ' ')) {
                    bl = bl - 1;
                    base[bl] = 0;
                }
                if (strncmp(base, "struct ", 7) == 0)
                    snprintf(sname, sizeof sname, "%s", base + 7);
                else
                    snprintf(sname, sizeof sname, "%s", base);
                si = self->find_struct(sname);
                if (!heap && si >= 0 && self->arena->nodes[e].kind == N_CALL) {
                    int fi = self->find_func(self->arena->nodes[e].text2);
                    if (fi >= 0 && self->funcs[fi].ret_owned)
                        call_owned = self->ret_same_struct(self->funcs[fi].ret, si);
                }
            }
        }
        vi = self->find_var(self->arena->nodes[n].text2);
        if (vi >= 0 && si >= 0) {
            self->vars[vi].st = si;
            if (heap || call_owned) {
                self->vars[vi].owned = 1;
                self->vars[vi].own_line = self->arena->nodes[n].line;
            }
        }
        for (i = 0; i < self->nvar; i++) {
            if (i == vi) continue;
            if (!self->vars[i].owned && !self->vars[i].autodrop) continue;
            if (!self->expr_mentions(e, self->vars[i].name)) continue;
            self->vars[i].owned = 0;
            if (self->expr_returns(e, self->vars[i].name)) self->vars[i].autodrop = 0;
        }
        return 0;
    }

    /* A scope is closing: a still-owned object in it is unreachable. */
    int leak_scope(int from, int to)
    {
        int i;
        (void)self;
        for (i = from; i < to; i++)
            if (self->vars[i].owned && !self->vars[i].autodrop && !self->vars[i].path_warned)
                if (self->warn_leak(i, 0) != 0) return -1;
        return 0;
    }

    /* An assignment: the target keeps ownership (`p = x` only stops AutoDrop),
       anything else owned and named on the line escapes. */
    int leak_assign(int n)
    {
        int lhs, rhs, bv, i;
        (void)self;
        lhs = self->arena->nodes[n].a;
        rhs = self->arena->nodes[n].b;
        bv = -1;
        if (lhs >= 0) {
            if (self->arena->nodes[lhs].kind == N_VAR)
                bv = self->find_var(self->arena->nodes[lhs].text2);
            else if (self->arena->nodes[lhs].kind == N_MEMBER || self->arena->nodes[lhs].kind == N_ARROW) {
                int b = self->arena->nodes[lhs].a;
                if (b >= 0 && self->arena->nodes[b].kind == N_VAR)
                    bv = self->find_var(self->arena->nodes[b].text2);
            }
        }
        for (i = 0; i < self->nvar; i++) {
            if (i == bv) {
                if (self->vars[i].autodrop && lhs >= 0 && self->arena->nodes[lhs].kind == N_VAR)
                    self->vars[i].autodrop = 0;
                continue;
            }
            if (!self->vars[i].owned && !self->vars[i].autodrop) continue;
            if (!self->expr_mentions(lhs, self->vars[i].name)
                && !self->expr_mentions(rhs, self->vars[i].name)) continue;
            self->vars[i].owned = 0;
            if (self->expr_returns(rhs, self->vars[i].name)) self->vars[i].autodrop = 0;
        }
        return 0;
    }

    /* A return: at the body's own level it moves the returned object's
       ownership out and tells the caller (one level, via `ret_owned`); nested in
       a block it may be skipped, so everything it leaves behind is reported once
       as a possible leak. */
    int leak_return(int ret, int conditional, int line)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nvar; i++) {
            int pos = 0;
            if (self->vars[i].autodrop) {
                if (ret >= 0 && self->expr_mentions(ret, self->vars[i].name))
                    self->vars[i].autodrop = 0;
                continue;
            }
            if (!self->vars[i].owned) continue;
            if (ret >= 0 && self->expr_returns(ret, self->vars[i].name)) pos = 1;
            if (!conditional) {
                if (pos) {
                    self->vars[i].owned = 0;
                    if (!self->leak_impl) self->ret_owned = 1;
                }
                continue;
            }
            if (!pos && !self->vars[i].path_warned) {
                self->vars[i].path_warned = 1;
                if (self->warn_leak(i, line) != 0) return -1;
            }
        }
        return 0;
    }

    int leak_delete(int e)
    {
        int vi;
        (void)self;
        if (e < 0 || self->arena->nodes[e].kind != N_VAR) return 0;
        vi = self->find_var(self->arena->nodes[e].text2);
        if (vi < 0) return 0;
        self->vars[vi].owned = 0;
        self->vars[vi].autodrop = 0;
        return 0;
    }

    /* Record one leak warning. `path_line` 0 means a definite leak; otherwise it
       is the conditional return that leaves the object behind. The store lives in
       diag.ct; this method only computes the fields it needs. */
    int warn_leak(int vi, int path_line)
    {
        int kind;
        char tname[MAX_TEXT];
        (void)self;
        kind = (path_line > 0) ? 2 : 0;
        if (self->vars[vi].st >= 0)
            snprintf(tname, sizeof tname, "%s", self->structs[self->vars[vi].st].name);
        else
            tname[0] = 0;
        if (ct_leak_warn(kind, self->vars[vi].own_line, path_line, self->path,
                         self->vars[vi].name, tname) != 0)
            return self->fail("too many warnings");
        return 0;
    }
}

impl CacheOps for Ast {
    /* FNV-1a: folds a variable-length string into the fixed-width number a key
       carries, so dependency chains stay bounded (L2's `digest`, D41). */
    unsigned long cache_digest(const char *s)
    {
        unsigned long h;
        size_t i;
        (void)self;
        h = (unsigned long)2166136261;
        i = 0;
        while (s[i]) {
            h = h ^ (unsigned long)(unsigned char)s[i];
            h = h * (unsigned long)16777619;
            i++;
        }
        return h;
    }

    /* Dependency-first order for the cache. `load_unit` assigns an importer its
       index before recursing, so unit indices are neither a topological order
       nor its reverse; this postorder DFS is (same shape as L2's `order[]`). */
    int cache_order(int u, int *state, int *order, int *n)
    {
        int k;
        (void)self;
        if (state[u] != 0) return 0;
        state[u] = 1;
        for (k = 0; k < self->units[u].ndep; k++)
            if (self->cache_order(self->units[u].depu[k], state, order, n) != 0)
                return -1;
        state[u] = 2;
        order[*n] = u;
        (*n)++;
        return 0;
    }

    /* The key of unit `u`: what its .c/.h are a function of. `-1` means "no key"
       and is treated as "cannot be reused" (a missing stamp must never be
       papered over). The spelling matches L2 byte for byte. */
    int cache_key(int u, char *out, size_t cap)
    {
        char stamp[64];
        char ih[MAX_IH];
        unsigned long dep;
        struct stat st;
        size_t n, k;
        int w;
        (void)self;

        if (stat(self->units[u].path, &st) != 0) return -1;
        snprintf(stamp, sizeof stamp, "%lu.%lu",
                 (unsigned long)st.st_mtime, (unsigned long)st.st_size);
        n = 0;
        ih[0] = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++) {
            w = snprintf(ih + n, sizeof ih - n, "%s.h;", self->units[u].dep[k]);
            if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
            n += (size_t)w;
        }
        dep = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++)
            dep = dep * (unsigned long)1099511628211 + self->units[self->units[u].depu[k]].digest;
        w = snprintf(out, cap, "ctc %s L%d D%d N%s P%s S%s I%lu K%lu",
                     CTC_VERSION, self->line_force, self->diag_json, self->nsroot,
                     self->units[u].path, stamp, self->cache_digest(ih), dep);
        if (w < 0 || (size_t)w >= cap) return -1;
        self->units[u].digest = self->cache_digest(out);
        return 0;
    }

    /* `<dir of outc>/.ctcache/<base>.key`: the cache sits beside the unit's own
       outputs, so `-o <dir>` keeps it out of the source tree. */
    int cache_paths(const char *outc, char *dir, size_t dcap,
                    char *kf, size_t kcap)
    {
        const char *slash;
        const char *base;
        int w;
        (void)self;
        slash = strrchr(outc, '/');
        base = slash ? slash + 1 : outc;
        if (slash) w = snprintf(dir, dcap, "%.*s/.ctcache", (int)(slash - outc), outc);
        else w = snprintf(dir, dcap, ".ctcache");
        if (w < 0 || (size_t)w >= dcap) return -1;
        w = snprintf(kf, kcap, "%s/%s.key", dir, base);
        if (w < 0 || (size_t)w >= kcap) return -1;
        return 0;
    }

    /* A hit needs the key file to match byte for byte and both artefacts on
       disk: a key whose .c/.h were deleted must not be reused. */
    int cache_hit(const char *outc, const char *key)
    {
        char dir[MAX_PATH];
        char kf[MAX_PATH];
        char hp[MAX_PATH];
        char buf[MAX_KEY];
        FILE *f;
        size_t n, kl, hl;
        (void)self;

        if (self->cache_paths(outc, dir, sizeof dir, kf, sizeof kf) != 0) return 0;
        f = fopen(kf, "r");
        if (!f) return 0;
        n = fread(buf, 1, sizeof buf, f);
        fclose(f);
        kl = strlen(key);
        if (n != kl || memcmp(buf, key, kl) != 0) return 0;
        if (snprintf(hp, sizeof hp, "%s", outc) >= (int)sizeof hp) return 0;
        hl = strlen(hp);
        if (hl < 3 || hp[hl - 1] != 'c' || hp[hl - 2] != '.') return 0;
        hp[hl - 1] = 'h';
        f = fopen(hp, "rb");
        if (!f) return 0;
        fclose(f);
        f = fopen(outc, "rb");
        if (!f) return 0;
        fclose(f);
        return 1;
    }

    /* Best effort by design: a cache that cannot be written costs a rebuild,
       never a broken build, so an unwritable directory stays silent. */
    void cache_store(const char *outc, const char *key)
    {
        char dir[MAX_PATH];
        char kf[MAX_PATH];
        FILE *f;
        (void)self;
        if (self->cache_paths(outc, dir, sizeof dir, kf, sizeof kf) != 0) return;
        mkdir(dir, 0755);            /* EEXIST on a warm cache is the normal case */
        f = fopen(kf, "w");
        if (!f) return;
        fprintf(f, "%s", key);       /* no newline: `hit` compares byte for byte */
        fclose(f);
    }
}


/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Ast g_ast;

int main(int argc, char **argv)
{
    const char *base;

    /* Run-option defaults: the struct is zero-initialised, so the two values
       that are not 0/off are seeded here, the one place that owns the process. */
    g_ast.prog = "ct-ast";
    g_ast.line_force = -1;
    g_ast.std_flag = "-std=c99";
    /* the node and literal pools live in runtime::arena; point the object at its
       singleton before anything can build a node */
    g_ast.arena = arena_get();
    /* likewise the source cursor and the current token */
    g_ast.lex = lexer_get();

    base = strrchr(argv[0], '/');
    base = base ? base + 1 : argv[0];
    if (strcmp(base, "ct") == 0) g_ast.prog = "ct";
    else if (strcmp(base, "ctc") == 0) g_ast.prog = "ctc";
    /* Phase 8 (ported in 10.6): the package subcommands live in their own unit
       and never reach the compile core; only primitives cross the boundary */
    if (argc > 1 && strcmp(argv[1], "get") == 0)
        return ct_pkg_get(argc - 2, argv + 2, g_ast.prog, CTC_VERSION);
    if (argc > 1 && strcmp(argv[1], "install") == 0)
        return ct_pkg_install(argc - 2, argv + 2, g_ast.prog, CTC_VERSION);
    return g_ast.run(argc, argv);
}
