/*
 * main.ct - Phase 9: the AST compiler.
 *
 * 9.1 proved the pipe (lexer -> parser -> AST -> C). 9.2 added statements,
 * control flow and signatures. 9.3 added the declaration layer, 9.4 traits and
 * interface values, and 9.5a the module layer:
 *
 *   - `build` mode: one `.c` + `.h` per unit, imports resolved recursively
 *   - `import a::b;` (the importing file's directory first, then `-I` roots)
 *   - `pub` routing: exported traits/structs/typedefs/prototypes land in `.h`
 *   - `namespace A::B { ... }` plus `--ns-root` directory validation
 *   - metadata: `#line` (`--line` / `--no-line`) and `--emit-map`
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one dispatch per
 * concern). Symbol tables follow D33: functions, variables and types are
 * separate flat tables; only variables are scoped.
 *
 * Output contract: banner, `<base>.h` guard and a self-contained `.c`; byte
 * equality with the old pipeline is not required (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
import backend::emit::Emit;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Map;
import frontend::module::Module;
import frontend::module::Unit;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import tool::cache::Cache;
import tool::diag::diag;
import tool::driver::driver;
import tool::pkg::pkg;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
/* the incremental cache stamps each unit with `stat` and creates `.ctcache`
   with `mkdir` (Phase 6.3, ported in 10.5) */
#include <sys/stat.h>

#define CTC_VERSION "0.12.0"

/* Capacity: the caps below were sized for the Phase 0 corpus; the old user-facing
   numbers (16 traits, 32 structs, 64 functions) stopped real programs. They stay
   fixed-size -- overflow is still a hard error -- but the numbers no longer bind.
   The node pool and the string-literal pool moved to `runtime::arena`, so their
   caps (65536 nodes, 256 KiB of literals) live on that class now. */
#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_FUNCS  256
#define MAX_PARAMS 16
#define MAX_VARS   4096
#define MAX_SCOPE  256
#define MAX_TYPES  256
#define MAX_TRAITS 64
#define MAX_METHODS 64
#define MAX_STRUCTS 128
#define MAX_FIELDS 64
#define MAX_UNITS  64
#define MAX_IMPORTS 32
#define MAX_INCDIRS 16
#define MAX_CALLS  1024
#define MAX_MAPS   64
#define MAX_ERRORS 20                   /* recovery cap: past this the compiler stops */
#define MAX_KEY    768                  /* one unit's incremental-cache key */
#define MAX_IH     5120                 /* MAX_IMPORTS * MAX_TEXT, spelled out */
/* the package manager (Phase 8, ported in 10.6) */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   512
#define MAX_PKG_DEPTH  8
#define MAX_PKG_CMD    2048
#define MAX_LOCK       4096             /* MAX_PKG_PATH * 8, spelled out */
#define MAX_PKG_LINE   1024             /* MAX_PKG_PATH * 2, spelled out */

/* node kinds (D32: one tag, one dispatch) */
#define N_PROG    1
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_PARAM   19
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_METHOD  29
#define N_MCALL   30
#define N_RAW     31
#define N_TRAIT   32
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41

/* token kinds */
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

/* binary operators (stored in `aux`) */
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13
#define B_XOR 14

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define P_INC 1
#define P_DEC 2

/* `parse_func` returns this when the declaration was a prototype (no node). */
#define NO_NODE (-2)

/* `Node` and the two pools now live in `runtime::arena`; the compile driver
   holds a pointer to the arena singleton and works through it. */

/* `Fn`, `Var`, `MethodSig`, `Trait`, `Field` and `StructDef` now live in
   `frontend::sym`; the driver holds a pointer to that singleton and works
   through it. */

/* One translation unit of a `build` is a value type of the module layer; see
   frontend/module/unit.h.ct. The caps its fields need stay in this unit's
   MAX_* list too, because the driver sizes the table and spells the same
   numbers. */

/* The `map` records and the call-graph edge are value types of the module
   layer; see frontend/module/map.h.ct. */

/* An rvalue receiver (`f().m()`) is hoisted into a temp so the call is
   evaluated once; the declarations are flushed before the statement. */
#define MAX_HOISTS 4

/* The entry name and the run options live on the module object
   (frontend::module) now; `main` seeds the defaults before dispatching. The
   build-mode entry and the run options stay there too -- the compile-mode
   driver (tool::driver) only points at the object. */

/* Collected warnings and the semantic-error counter live in diag.ct; the
   compile driver reaches them only through the primitive wrappers declared
   there. */

/* AutoDrop (Phase 5, landed here in 10.3) and the leak analysis (10.3) keep
   their state on the memory object (backend::mem): every scope records where
   its `own` declarations start, and the leak pass runs only while a function
   or method body is being parsed. */

/* The compile-mode driver (`ct <file> -o <file>`), the build driver
   (frontend::module), the incremental cache (tool::cache) and the emitter
   (backend::emit) each live in their own units; `main` only binds the
   collaborators and dispatches. See tool/driver/driver.ct. */

int main(int argc, char **argv)
{
    const char *base;
    struct Arena *arena;
    struct Lexer *lex;
    struct Cache *cache;
    struct Symbols *sym;
    struct Memory *mem;
    struct TypeCheck *ty;
    struct Module *m;
    struct Parser *p;

    /* the node and literal pools live in runtime::arena; point the object at its
       singleton before anything can build a node. Every facade call here is
       qualified: the entry file is at the root, and a bare call would have to
       fall back to "the only row with that name". */
    arena = runtime::arena::arena_get();
    /* likewise the source cursor and the current token */
    lex = frontend::lex::lexer_get();
    /* the cache keys carry the compiler version; seed it once here */
    cache = tool::cache::cache_get();
    cache->version = CTC_VERSION;
    /* the symbol tables live in frontend::sym; point the object at its singleton */
    sym = frontend::sym::symbols_get();
    /* the memory analysis (backend::mem) reads both through the driver */
    mem = backend::mem::memory_get();
    mem->arena = arena;
    mem->sym = sym;
    /* static typing and boxing (frontend::type) read the same tables */
    ty = frontend::type::type_get();
    ty->arena = arena;
    ty->sym = sym;
    ty->lex = lex;
    /* the module driver (frontend::module) owns the unit table and the run
       options; seed the options the struct does not zero-init: `prog` (the entry
       name `-v` and the usage lines print) and the version (the banner and the
       cache key). */
    m = frontend::module::module_get();
    m->prog = "ct-ast";
    m->line_force = -1;
    m->std_flag = "-std=c99";
    m->version = CTC_VERSION;
    /* the parser (frontend::parse) reads the same collaborators; bind it once
       they are all in place so its own support object is wired too */
    p = frontend::parse::parse_get();
    frontend::parse::ct_parse_bind(arena, lex, sym, ty, mem, &m->build_mode);
    ty->maps = p->maps;
    ty->nmaps = &p->nmaps;
    /* the module driver draws on the same collaborators; wire it once they are
       all in place. It owns the unit table and the options the emitter reads. */
    frontend::module::ct_module_bind(arena, lex, sym, ty, mem, p, cache);

    base = strrchr(argv[0], '/');
    base = base ? base + 1 : argv[0];
    if (strcmp(base, "ct") == 0) m->prog = "ct";
    else if (strcmp(base, "ctc") == 0) m->prog = "ctc";
    /* the emitter (backend::emit) reads the same collaborators, the module
       tables, the options and the version; `out`/`path` follow through the
       setters as the driver re-points them. Bind after the entry-name branch
       because `prog` is part of the wired state. */
    backend::emit::ct_emit_bind(arena, sym, ty, lex, CTC_VERSION, m->outdir, m->prog);
    backend::emit::ct_emit_bind_tables(m->units, &m->nunits, p->maps, &p->nmaps, p->calls, &p->ncalls, &m->build_mode, &m->line_mode);
    backend::emit::ct_emit_bind_parse(&p->nparams, p->pend_fields, &p->npend);
    /* the compile-mode driver (tool::driver) holds the output sink and the
       collaborators of one run; bind it once they are all in place. */
    tool::driver::ct_driver_bind(arena, lex, sym, mem, m, p, CTC_VERSION);
    /* Phase 8 (ported in 10.6): the package subcommands live in their own unit
       and never reach the compile core; only primitives cross the boundary */
    if (argc > 1 && strcmp(argv[1], "get") == 0)
        return tool::pkg::ct_pkg_get(argc - 2, argv + 2, m->prog, CTC_VERSION);
    if (argc > 1 && strcmp(argv[1], "install") == 0)
        return tool::pkg::ct_pkg_install(argc - 2, argv + 2, m->prog, CTC_VERSION);
    return tool::driver::ct_driver_run(argc, argv);
}
