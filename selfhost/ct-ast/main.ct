/*
 * main.ct - Phase 9: the AST compiler.
 *
 * 9.1 proved the pipe (lexer -> parser -> AST -> C). 9.2 added statements,
 * control flow and signatures. 9.3 added the declaration layer, 9.4 traits and
 * interface values, and 9.5a the module layer:
 *
 *   - `build` mode: one `.c` + `.h` per unit, imports resolved recursively
 *   - `import a::b;` (the importing file's directory first, then `-I` roots)
 *   - `pub` routing: exported traits/structs/typedefs/prototypes land in `.h`
 *   - `namespace A::B { ... }` plus `--ns-root` directory validation
 *   - metadata: `#line` (`--line` / `--no-line`) and `--emit-map`
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one dispatch per
 * concern). Symbol tables follow D33: functions, variables and types are
 * separate flat tables; only variables are scoped.
 *
 * Output contract: banner, `<base>.h` guard and a self-contained `.c`; byte
 * equality with the old pipeline is not required (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
import tool::pkg::pkg;
import tool::diag::diag;
import runtime::arena::arena;
import frontend::lex::lexer;
import frontend::module::unit;
import frontend::module::map;
import frontend::sym::sym;
import frontend::type::type;
import frontend::parse::parse;
import tool::cache::cache;
import backend::mem::mem;
import backend::emit::emit;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
/* the incremental cache stamps each unit with `stat` and creates `.ctcache`
   with `mkdir` (Phase 6.3, ported in 10.5) */
#include <sys/stat.h>

#define CTC_VERSION "0.12.0"

/* Capacity: the caps below were sized for the Phase 0 corpus; the old user-facing
   numbers (16 traits, 32 structs, 64 functions) stopped real programs. They stay
   fixed-size -- overflow is still a hard error -- but the numbers no longer bind.
   The node pool and the string-literal pool moved to `runtime::arena`, so their
   caps (65536 nodes, 256 KiB of literals) live on that class now. */
#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_FUNCS  256
#define MAX_PARAMS 16
#define MAX_VARS   4096
#define MAX_SCOPE  256
#define MAX_TYPES  256
#define MAX_TRAITS 64
#define MAX_METHODS 64
#define MAX_STRUCTS 128
#define MAX_FIELDS 64
#define MAX_UNITS  64
#define MAX_IMPORTS 16
#define MAX_INCDIRS 16
#define MAX_CALLS  1024
#define MAX_MAPS   64
#define MAX_ERRORS 20                   /* recovery cap: past this the compiler stops */
#define MAX_KEY    768                  /* one unit's incremental-cache key */
#define MAX_IH     2560                 /* MAX_IMPORTS * MAX_TEXT, spelled out */
/* the package manager (Phase 8, ported in 10.6) */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   512
#define MAX_PKG_DEPTH  8
#define MAX_PKG_CMD    2048
#define MAX_LOCK       4096             /* MAX_PKG_PATH * 8, spelled out */
#define MAX_PKG_LINE   1024             /* MAX_PKG_PATH * 2, spelled out */

/* node kinds (D32: one tag, one dispatch) */
#define N_PROG    1
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_PARAM   19
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_METHOD  29
#define N_MCALL   30
#define N_RAW     31
#define N_TRAIT   32
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41

/* token kinds */
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

/* binary operators (stored in `aux`) */
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13
#define B_XOR 14

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define P_INC 1
#define P_DEC 2

/* `parse_func` returns this when the declaration was a prototype (no node). */
#define NO_NODE (-2)

/* `Node` and the two pools now live in `runtime::arena`; this unit holds a
   pointer to the arena singleton and works through it. */

/* `Fn`, `Var`, `MethodSig`, `Trait`, `Field` and `StructDef` now live in
   `frontend::sym`; this unit holds a pointer to that singleton and works
   through it. */

/* One translation unit of a `build` is a value type of the module layer; see
   frontend/module/unit.h.ct. The caps its fields need stay in this unit's
   MAX_* list too, because the driver sizes the table and spells the same
   numbers. */

/* The `map` records and the call-graph edge are value types of the module
   layer; see frontend/module/map.h.ct. */

/* An rvalue receiver (`f().m()`) is hoisted into a temp so the call is
   evaluated once; the declarations are flushed before the statement. */
#define MAX_HOISTS 4

/* The entry name and the run options live on the `Ast` object now; see the
   fields below. `main` seeds the defaults before dispatching. */

/* Collected warnings and the semantic-error counter live in diag.ct; this unit
   only reaches them through the primitive wrappers declared there. */

/* AutoDrop (Phase 5, landed here in 10.3) and the leak analysis (10.3) keep
   their state on the `Ast` object: every scope records where its `own`
   declarations start, and the leak pass runs only while a function or method
   body is being parsed. See the fields below. */

trait AstOps {
    int  fail(const char *msg);
    int  read_file(const char *path);
    int  default_output(const char *in, char *out, size_t cap);
    int  run(int argc, char **argv);
}

trait SymOps {
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name, const char *type);
    int  find_var(const char *name);
    int  var_type(const char *name, char *out, size_t cap);
    int  find_func(const char *name);
    int  add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param);
    int  find_type(const char *name);
    int  add_type(const char *name, int kind);
    int  find_struct(const char *name);
    int  add_struct(const char *name);
    int  find_trait(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, size_t tcap);
    int  ns_decl_name(const char *name, char *out, size_t cap);
    int  resolve_type(const char *name, char *out, size_t cap);
}

/* Driver plumbing: build-mode loading (paths, import resolution, unit loading,
   the namespace/directory check) and the facade onto the emitter, the output
   side of the same driver. Kept apart from ParseOps to leave the parser room to
   grow under MAX_METHOD. The emitter facade lives here rather than in a trait of
   its own because L2, which still builds this tree, caps the whole build at 16
   traits and the other units already use all sixteen. */
trait ModuleOps {
    int  base_name(const char *path, char *out, size_t cap, int *is_hdr);
    int  path_dir(const char *path, char *out, size_t cap);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr);
    int  load_unit(const char *path);
    int  check_ns_dir(int u);
    int  cache_order(int u, int *state, int *order, int *n);
    int  cache_key_of(int u, char *out, int cap);
    int  build_main(int argc, char **argv);
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  write_header(const char *outc);
    int  write_map(const char *dest, int prog, int u);
}

/* The incremental build cache is an object of its own (tool/cache); the driver
   only hands it the unit table and the run's options. */


/* The struct carries the output, lexer and memory-analysis state so those
   methods are real OO methods on the object rather than free functions over
   file-scope globals; the tables still on it move out slice by slice. */
struct Ast {
    int nerr;
    /* Output state for one run: where emitted C goes, the source path the banner
       and diagnostics report, and the last parse/run error message. The driver
       re-points `path` for each unit in build mode. */
    FILE *out;
    const char *path;
    /* The node pool and the literal pool live in runtime::arena; the driver
       points this at that singleton before it dispatches to `run`. */
    struct runtime_arena_Arena *arena;
    /* The incremental cache (tool::cache) and its version stamp. */
    struct tool_cache_Cache *cache;
    /* The source cursor and the current token live in frontend::lex; the driver
       points this at that singleton before it dispatches to `run`. */
    struct frontend_lex_Lexer *lex;
    /* The symbol tables of the unit being compiled live in frontend::sym; the
       driver points this at that singleton before it dispatches to `run`. */
    struct frontend_sym_Symbols *sym;
    /* Build mode: the unit table and the import search roots. The namespace
       path, the import list, the calls and the maps the JSON reports are the
       parser's now (frontend::parse); the driver reads them back through `p`. */
    struct frontend_module_Unit units[MAX_UNITS];
    int  nunits;
    int  build_mode;
    char outdir[MAX_PATH];
    const char *incdirs[MAX_INCDIRS];
    int  ninc;
    const char *nsroot;
    /* Run options. `prog` is the entry name `-v` and the usage lines print
       (D44): `ct` when installed under that name, `ctc` for the compatibility
       alias, `ct-ast` for the development binary. Driver diagnostics keep the
       published `ctc:` prefix (SH-3 / phase10 non-goal), so logs and assertions
       do not move when the entry name changes. */
    int  line_mode;             /* emit `#line`: 0 off, 1 on */
    int  line_force;            /* -1 mode default, 0 --no-line, 1 --line */
    char map_path[MAX_PATH];
    int  have_map;
    const char *prog;
    int  diag_json;             /* --diagnostics=json */
    const char *std_flag;       /* --std=c99 | --std=gnu99 */
    /* AutoDrop and the leak analysis live in backend::mem; the driver wires its
       arena, symbol table and path before it dispatches to `run`. */
    struct backend_mem_Memory *mem;
    /* Type inference and the boxing decision live in frontend::type; the driver
       wires the arena, the symbol table, the map table, its count and the lexer. */
    struct frontend_type_TypeCheck *ty;
    /* The parser (frontend::parse) owns the parse-time tables and scratch; the
       driver reads them back through this pointer. */
    struct frontend_parse_Parser *p;
} use AstOps, SymOps, ModuleOps;

impl AstOps for Ast {
    /* The token cursor and the error store now live in frontend::parse
       (support.h.ct); the driver forwards so the store stays single. */
    int fail(const char *msg)
    {
        (void)self;
        return ct_parse_fail(msg);
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        (void)self;
        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        self->lex->src = buf;
        return 0;
    }

    int default_output(const char *in, char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0) {
            if (snprintf(out, cap, "%.*s.c", (int)(n - 3), in) >= (int)cap) return -1;
            return 0;
        }
        if (snprintf(out, cap, "%s.c", in) >= (int)cap) return -1;
        return 0;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        const char *out;
        char outbuf[MAX_PATH];
        int i, prog;
        FILE *f;

        in = NULL;
        out = NULL;
        if (argc > 1 && strcmp(argv[1], "build") == 0)
            return self->build_main(argc - 1, argv + 1);
        self->build_mode = 0;
        self->line_mode = 0;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s <input.ct> [-o <output.c>] [-I <dir>] [--line|--no-line]\n"
                       "              [--emit-map <file|->] [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s get <spec>[@<range>]\n"
                       "       %s install\n",
                       self->prog, self->prog, self->prog, self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, CTC_VERSION);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;   /* accepted for CLI parity; compile mode resolves no imports */
                continue;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: %s <input.ct> [-o <output.c>]\n", self->prog);
            return 1;
        }
        if (!out) {
            if (self->default_output(in, outbuf, sizeof outbuf) != 0) {
                fprintf(stderr, "ctc: output path too long\n");
                return 1;
            }
            out = outbuf;
        }

        self->path = in;
        self->mem->path = self->path;
        ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        ct_diag_reset();
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->self_mode = 0;
        self->p->nparams = 0;
        self->p->ncalls = 0;
        self->p->cur_func[0] = 0;
        ct_parse_clear_error();
        if (self->read_file(in) != 0) {
            fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
            return 1;
        }
        prog = ct_parse_program();
        if (prog < 0) {
            if (ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", ct_diag_nsem());
                return 1;
            }
            fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
            return 1;
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        self->out = f;
        ct_emit_set_out(self->out);
        fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, self->path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              self->out);
        if (self->line_mode) fprintf(self->out, "#line 1 \"%s\"\n", self->path);
        if (self->emit_program(prog) != 0) {
            fclose(f);
            fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
            return 1;
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        if (self->write_header(out) != 0) {
            fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
            return 1;
        }
        if (self->have_map && self->write_map(self->map_path, prog, -1) != 0) {
            fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
            return 1;
        }
        if (ct_diag_emit(self->diag_json, 0) != 0) return 1;
        return 0;
    }
}

/* The tables live in frontend::sym; this facade keeps the parser's trait shape
   and wraps the reasons the tables record with the current position. */
impl SymOps for Ast {
    int push_scope(void)
    {
        if (self->sym->push_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->own_base[self->sym->nscope - 1] = self->mem->nowner;
        return 0;
    }

    int pop_scope(void)
    {
        if (self->sym->pop_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->nowner = self->mem->own_base[self->sym->nscope];
        return 0;
    }

    int declare_var(const char *name, const char *type)
    {
        if (self->sym->declare_var(name, type) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int find_var(const char *name)
    {
        return self->sym->find_var(name);
    }

    /* A miss is not an error: the parser probes names while inferring types, so
       only a recorded reason (overflow) becomes a diagnostic. */
    int var_type(const char *name, char *out, size_t cap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->var_type(name, out, (int)cap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int find_func(const char *name)
    {
        return self->sym->find_func(name);
    }

    /* A prototype followed by its definition updates the same entry. `pub` on
       either declaration exports the prototype to the unit header. */
    int add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param)
    {
        int i, k, p;

        i = self->sym->find_func(name);
        if (i < 0) {
            if (self->sym->nfunc >= MAX_FUNCS) return self->fail("too many functions");
            i = self->sym->nfunc;
            self->sym->nfunc++;
            snprintf(self->sym->funcs[i].name, MAX_TEXT, "%s", name);
            self->sym->funcs[i].is_pub = 0;
            self->sym->funcs[i].ret_owned = 0;   /* fresh row: no ownership fact yet */
        }
        if (is_pub) self->sym->funcs[i].is_pub = 1;
        snprintf(self->sym->funcs[i].ret, MAX_TEXT, "%s", ret);
        self->sym->funcs[i].is_static = is_static;
        self->sym->funcs[i].nparams = 0;
        p = first_param;
        k = 0;
        while (p > 0 && k < MAX_PARAMS) {
            snprintf(self->sym->funcs[i].ptype[k], MAX_TEXT, "%s", self->arena->nodes[p].text);
            snprintf(self->sym->funcs[i].pdim[k], MAX_TEXT, "%s", self->arena->nodes[p].text3);
            k++;
            p = self->arena->nodes[p].next;
        }
        if (k >= MAX_PARAMS && p > 0) return self->fail("too many parameters");
        self->sym->funcs[i].nparams = k;
        return i;
    }

    int find_type(const char *name)
    {
        return self->sym->find_type(name);
    }

    int add_type(const char *name, int kind)
    {
        if (self->sym->add_type(name, kind) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int find_struct(const char *name)
    {
        return self->sym->find_struct(name);
    }

    int add_struct(const char *name)
    {
        const char *why;
        int i;
        self->sym->errmsg[0] = 0;
        i = self->sym->add_struct(name);
        if (i < 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return i;
    }

    int find_trait(const char *name)
    {
        return self->sym->find_trait(name);
    }

    int add_trait(const char *name)
    {
        int i = self->sym->add_trait(name);
        if (i < 0) return self->fail(self->sym->last_error());
        return i;
    }

    /* A miss is not an error here either: the emitter tries trait methods of a
       receiver type and moves on when none matches. */
    int method_trait(const char *stype, const char *method, char *tout, size_t tcap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->method_trait(stype, method, tout, (int)tcap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int ns_decl_name(const char *name, char *out, size_t cap)
    {
        if (self->sym->ns_decl_name(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int resolve_type(const char *name, char *out, size_t cap)
    {
        if (self->sym->resolve_type(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

}


impl ModuleOps for Ast {
    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`. */
    int base_name(const char *path, char *out, size_t cap, int *is_hdr)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > cap) return self->fail("output name is too long");
        snprintf(out, cap, "%.*s", (int)n, name);
        return 0;
    }

    int path_dir(const char *path, char *out, size_t cap)
    {
        const char *slash;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        if (!slash) {
            if (cap < 2) return self->fail("path is too long");
            snprintf(out, cap, "%s", ".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        if (n + 1 > cap) return self->fail("path is too long");
        snprintf(out, cap, "%.*s", (int)n, path);
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. */
    int scan_imports(const char *from)
    {
        (void)self;
        self->p->nrels = 0;
        self->path = from;
        self->mem->path = self->path;
        ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->tok = 0;
        ct_parse_lex_next();
        for (;;) {
            if (self->lex->tok == T_PP) {
                ct_parse_lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "import") == 0) {
                if (ct_parse_skip_import() != 0) return -1;
                continue;
            }
            break;
        }
        return 0;
    }

    /* `a::b` -> `<root>/a/b.ct`, then `a/b.h.ct`, for the importing file's own
       directory and then every `-I` root. */
    int resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr)
    {
        char dir[MAX_PATH];
        char cand[MAX_PATH];
        const char *root;
        FILE *f;
        int r;
        (void)self;

        if (self->path_dir(from, dir, sizeof dir) != 0) return -1;
        for (r = -1; r < self->ninc; r++) {
            root = (r < 0) ? dir : self->incdirs[r];
            if (snprintf(cand, sizeof cand, "%s/%s.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 0;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
            if (snprintf(cand, sizeof cand, "%s/%s.h.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 1;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
        }
        snprintf(cand, sizeof cand, "cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char rels[MAX_IMPORTS][MAX_TEXT];
        char dep[MAX_PATH];
        char *mysrc;
        int u, i, d, nrels, is_hdr;
        (void)self;

        for (u = 0; u < self->nunits; u++)
            if (strcmp(self->units[u].path, path) == 0) return u;
        if (self->nunits >= MAX_UNITS) {
            self->fail("too many units");
            return -1;
        }
        u = self->nunits;
        self->nunits++;
        if (snprintf(self->units[u].path, MAX_PATH, "%s", path) >= MAX_PATH) {
            self->fail("path is too long");
            return -1;
        }
        self->units[u].ndep = 0;
        self->units[u].prog = -1;
        self->units[u].digest = 0;
        self->units[u].ns[0] = 0;
        if (self->base_name(path, self->units[u].base, MAX_TEXT, &is_hdr) != 0) return -1;
        self->units[u].is_hdr = is_hdr;

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)self->lex->src;
        if (self->scan_imports(path) != 0) return -1;
        nrels = self->p->nrels;
        for (i = 0; i < nrels; i++) snprintf(rels[i], MAX_TEXT, "%s", self->p->rels[i]);
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path, rels[i], dep, sizeof dep, &is_hdr) != 0) return -1;
            d = self->load_unit(dep);
            if (d < 0) return -1;
            if (self->units[u].ndep >= MAX_IMPORTS) {
                self->fail("too many imports");
                return -1;
            }
            snprintf(self->units[u].dep[self->units[u].ndep], MAX_TEXT, "%s", self->units[d].base);
            self->units[u].depu[self->units[u].ndep] = d;
            self->units[u].ndep++;
        }

        self->lex->src = mysrc;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ns[0] = 0;
        self->p->ns_decl[0] = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->p->cur_func[0] = 0;
        self->p->nparams = 0;
        /* `scan_imports` counted this unit's imports into `rels`, but the
           recursive loads above left the counter at a dependency's value, and
           parsing skips the same `import` lines again -- start that pass from
           zero so a unit is never charged for its dependencies' imports. */
        self->p->nrels = 0;
        self->path = path;
        self->mem->path = self->path;
        ct_emit_set_path(self->path);
        self->units[u].fn_start = self->sym->nfunc;
        self->units[u].tr_start = self->sym->ntraits;
        self->units[u].call_start = self->p->ncalls;
        self->p->cur_unit = u;
        self->units[u].prog = ct_parse_program();
        if (self->units[u].prog < 0) return -1;
        self->units[u].fn_end = self->sym->nfunc;
        self->units[u].tr_end = self->sym->ntraits;
        self->units[u].call_end = self->p->ncalls;
        snprintf(self->units[u].ns, MAX_TEXT, "%s", self->p->ns_decl);
        return u;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char rest[MAX_PATH];
        char dir[MAX_TEXT];
        char want[MAX_TEXT];
        const char *p;
        size_t rn, k, m;

        (void)self;
        if (!self->units[u].ns[0]) return 0;
        if (!self->nsroot || !self->nsroot[0]) return 0;
        rn = strlen(self->nsroot);
        if (strncmp(self->units[u].path, self->nsroot, rn) != 0) return 0;
        p = self->units[u].path + rn;
        if (*p == '/') p++;
        snprintf(rest, sizeof rest, "%s", p);
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        if (k >= sizeof dir) return self->fail("path is too long");
        snprintf(dir, sizeof dir, "%.*s", (int)k, rest);

        m = 0;
        for (k = 0; self->units[u].ns[k]; k++) {
            if (m + 1 >= sizeof want) return self->fail("namespace is too long");
            if (self->units[u].ns[k] == ':' && self->units[u].ns[k + 1] == ':') {
                want[m] = '/';
                m++;
                k++;
            } else {
                want[m] = self->units[u].ns[k];
                m++;
            }
        }
        want[m] = 0;
        if (strcmp(dir, want) != 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "namespace '%s' does not match the directory '%s'",
                     self->units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* Dependency-first order for the cache. `load_unit` assigns an importer its
       index before recursing, so unit indices are neither a topological order
       nor its reverse; this postorder DFS is (same shape as L2's `order[]`).
       The graph belongs to this layer, not to the cache. */
    int cache_order(int u, int *state, int *order, int *n)
    {
        int k;
        (void)self;
        if (state[u] != 0) return 0;
        state[u] = 1;
        for (k = 0; k < self->units[u].ndep; k++)
            if (self->cache_order(self->units[u].depu[k], state, order, n) != 0)
                return -1;
        state[u] = 2;
        order[*n] = u;
        (*n)++;
        return 0;
    }

    /* The key material of unit `u`: its import list as text and the folded
       dependency digest. The cache turns this into a stamped key; the module
       layer owns the graph, so the folding happens here. */
    int cache_key_of(int u, char *out, int cap)
    {
        char ih[MAX_IH];
        unsigned long dep;
        size_t n, k;
        int w;
        (void)self;

        n = 0;
        ih[0] = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++) {
            w = snprintf(ih + n, sizeof ih - n, "%s.h;", self->units[u].dep[k]);
            if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
            n += (size_t)w;
        }
        dep = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++)
            dep = dep * (unsigned long)1099511628211
                + self->units[self->units[u].depu[k]].digest;
        if (self->cache->key(self->units[u].path, ih, dep, self->line_force,
                             self->diag_json, self->nsroot, out, cap) != 0)
            return -1;
        /* the unit's own digest is what its dependants fold next */
        self->units[u].digest = self->cache->digest(out);
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        const char *inputs[MAX_UNITS];
        int ninput, i, u, o, cn;
        int dirty[MAX_UNITS];
        int cstate[MAX_UNITS];
        int corder[MAX_UNITS];
        const char *outdir;
        char root[MAX_PATH];
        (void)self;

        ninput = 0;
        outdir = NULL;
        self->ninc = 0;
        self->nsroot = NULL;
        self->line_mode = 1;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n",
                       self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, CTC_VERSION);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                outdir = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (self->ninc >= MAX_INCDIRS) {
                    fprintf(stderr, "ctc: too many -I roots\n");
                    return 1;
                }
                self->incdirs[self->ninc] = argv[i];
                self->ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                self->nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= MAX_UNITS) {
                fprintf(stderr, "ctc: too many inputs\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: %s build <input.ct>... -o <dir>\n", self->prog);
            return 1;
        }
        if (!outdir) {
            fprintf(stderr, "ctc: build needs -o <dir>\n");
            return 1;
        }
        if (snprintf(self->outdir, sizeof self->outdir, "%s", outdir) >= (int)sizeof self->outdir) {
            fprintf(stderr, "ctc: output directory is too long\n");
            return 1;
        }
        if (!self->nsroot) {
            if (self->path_dir(inputs[0], root, sizeof root) != 0) {
                fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
                return 1;
            }
            self->nsroot = root;
        }

        self->nunits = 0;
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->p->nrels = 0;
        self->p->nparams = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->sym->ns[0] = 0;
        self->p->ns_decl[0] = 0;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        self->p->ncalls = 0;
        ct_diag_reset();
        self->p->cur_func[0] = 0;
        ct_parse_clear_error();
        self->build_mode = 1;

        for (i = 0; i < ninput; i++) {
            if (self->load_unit(inputs[i]) < 0) {
                if (ct_diag_nsem()) fprintf(stderr, "ctc: %d error(s) generated\n", ct_diag_nsem());
                else fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
                return 1;
            }
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
                return 1;
            }
        }
        /* Incremental cache (Phase 6.3, ported in 10.5): a unit whose key still
           matches and whose .c/.h are on disk is not regenerated. The walk is a
           dependency-first postorder, so a unit's key can fold its dependencies'
           digests; a unit whose dependency is dirty is dirty too. `--emit-map`
           never reuses, because the map spans the whole run. */
        for (u = 0; u < self->nunits; u++) cstate[u] = 0;
        cn = 0;
        for (u = 0; u < self->nunits; u++)
            if (self->cache_order(u, cstate, corder, &cn) != 0) {
                fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
                return 1;
            }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            int k;
            u = corder[o];
            dirty[u] = 1;
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    >= (int)sizeof outc) {
                fprintf(stderr, "ctc: output path is too long\n");
                return 1;
            }
            if (!self->have_map && self->cache_key_of(u, key, sizeof key) == 0
                && self->cache->hit(outc, key))
                dirty[u] = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (dirty[self->units[u].depu[k]]) dirty[u] = 1;
        }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            u = corder[o];
            if (!dirty[u]) continue;
            if (self->emit_unit(u) != 0) {
                fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
                return 1;
            }
            if (self->write_unit_header(u) != 0) {
                fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
                return 1;
            }
            /* stamped only after a successful emit: a failed unit must never be
               reused, and a stale key must never vouch for new sources */
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    < (int)sizeof outc
                && self->cache_key_of(u, key, sizeof key) == 0)
                self->cache->store(outc, key);
        }
        if (self->have_map && self->write_map(self->map_path, self->units[0].prog, 0) != 0) {
            fprintf(stderr, "ctc: %s\n", ct_parse_last_error());
            return 1;
        }
        /* The command the user runs next, in the same shape L2 prints; the
           target C standard (Phase 6.4) is the only option it carries. */
        printf("cc %s", self->std_flag);
        for (u = 0; u < self->nunits; u++)
            printf(" %s/%s.c", self->outdir, self->units[u].base);
        printf(" -o a.out\n");
        if (ct_diag_emit(self->diag_json, 1) != 0) return 1;
        return 0;
    }

    /* The emitter (backend::emit) owns the code generation; these facades wrap
       the first raw failure with the current position, as the old bodies did. */
    int emit_program(int prog)
    {
        const char *why;
        if (ct_emit_program(prog) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int emit_unit(int u)
    {
        const char *why;
        if (ct_emit_unit(u) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_unit_header(int u)
    {
        const char *why;
        if (ct_emit_unit_header(u) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_header(const char *outc)
    {
        const char *why;
        if (ct_emit_header(outc) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        const char *why;
        if (ct_emit_map(dest, prog, u) != 0) {
            why = ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Ast g_ast;

int main(int argc, char **argv)
{
    const char *base;

    /* Run-option defaults: the struct is zero-initialised, so the two values
       that are not 0/off are seeded here, the one place that owns the process. */
    g_ast.prog = "ct-ast";
    g_ast.line_force = -1;
    g_ast.std_flag = "-std=c99";
    /* the node and literal pools live in runtime::arena; point the object at its
       singleton before anything can build a node */
    g_ast.arena = arena_get();
    /* likewise the source cursor and the current token */
    g_ast.lex = lexer_get();
    /* the cache keys carry the compiler version; seed it once here */
    g_ast.cache = cache_get();
    g_ast.cache->version = CTC_VERSION;
    /* the symbol tables live in frontend::sym; point the object at its singleton */
    g_ast.sym = symbols_get();
    /* the memory analysis (backend::mem) reads both through the driver */
    g_ast.mem = memory_get();
    g_ast.mem->arena = g_ast.arena;
    g_ast.mem->sym = g_ast.sym;
    /* static typing and boxing (frontend::type) read the same tables */
    g_ast.ty = type_get();
    g_ast.ty->arena = g_ast.arena;
    g_ast.ty->sym = g_ast.sym;
    g_ast.ty->lex = g_ast.lex;
    /* the parser (frontend::parse) reads the same collaborators; bind it once
       they are all in place so its own support object is wired too */
    g_ast.p = parse_get();
    ct_parse_bind(g_ast.arena, g_ast.lex, g_ast.sym, g_ast.ty, g_ast.mem, &g_ast.build_mode);
    g_ast.ty->maps = g_ast.p->maps;
    g_ast.ty->nmaps = &g_ast.p->nmaps;

    base = strrchr(argv[0], '/');
    base = base ? base + 1 : argv[0];
    if (strcmp(base, "ct") == 0) g_ast.prog = "ct";
    else if (strcmp(base, "ctc") == 0) g_ast.prog = "ctc";
    /* the emitter (backend::emit) reads the same collaborators, the module
       tables, the options and the version; `out`/`path` follow through the
       setters as the driver re-points them. Bind after the entry-name branch
       because `prog` is part of the wired state. */
    ct_emit_bind(g_ast.arena, g_ast.sym, g_ast.ty, g_ast.lex, CTC_VERSION, g_ast.outdir, g_ast.prog);
    ct_emit_bind_tables(g_ast.units, &g_ast.nunits, g_ast.p->maps, &g_ast.p->nmaps, g_ast.p->calls, &g_ast.p->ncalls, &g_ast.build_mode, &g_ast.line_mode);
    ct_emit_bind_parse(&g_ast.p->nparams, g_ast.p->pend_fields, &g_ast.p->npend);
    /* Phase 8 (ported in 10.6): the package subcommands live in their own unit
       and never reach the compile core; only primitives cross the boundary */
    if (argc > 1 && strcmp(argv[1], "get") == 0)
        return ct_pkg_get(argc - 2, argv + 2, g_ast.prog, CTC_VERSION);
    if (argc > 1 && strcmp(argv[1], "install") == 0)
        return ct_pkg_install(argc - 2, argv + 2, g_ast.prog, CTC_VERSION);
    return g_ast.run(argc, argv);
}

