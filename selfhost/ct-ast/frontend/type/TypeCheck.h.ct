/*
 * TypeCheck.h.ct - static type inference and the boxing decision.
 *
 * None of this is parsing: the unit reads the node pool, the symbol tables and
 * the map table, and it writes back into the pool (boxing allocates fresh
 * N_ADDR / N_BOX nodes, hence the lexer for their line numbers). It lives on
 * its own so the driver and the parser reach it through pointers instead of
 * file-scope globals.
 *
 * Macros do not cross a unit boundary, so the cap and the node kinds this unit
 * reads are declared here; MAX_TEXT 160 is the value
 * `frontend/sym/Symbols.h.ct` lists.
 */
#include <stdio.h>
#include <string.h>
import frontend::sym::SymbolsTypeText;

import frontend::lex::Lexer;
import frontend::module::MapTable;
import frontend::sym::Symbols;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import runtime::arena::Arena;
import runtime::arena::Arena::NodeKind as NodeKind;
import frontend::sym::SymbolsTypeText;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
/* one item of a `{ … }` list, and the text it rewrites to (boxing a struct
   operand appends to it); a long string literal makes an item large */
#define MAX_INIT_ITEM 4096
#define MAX_INIT_ITEM_MAX 65536
#define MAX_INIT_TEXT 16384
#define MAX_INIT_TEXT_MAX 65536
/* only the node kinds this unit reads; the numbers are the ones the parser
   builds and the emitter dispatches on */
#define N_CALL   7
#define N_VAR    10
/* LANG-29 S4 / B5: `match` in expression position (statement form: 78). */
#define N_MATCH  78
/* Phase 84: `Shape.Circle(args)` -- the constructor answers `struct Shape`. */
#define N_ADTCTOR 81
#define N_NUM    8
#define N_STR    9
#define N_FNUM   54
#define N_MCALL  30
#define N_MEMBER 24
#define N_ARROW  25
#define N_INDEX  26
#define N_ADDR   27
#define N_DEREF  28
#define N_BOX    34
#define N_NEWOBJ 77
#define N_CAST   35
#define N_SIZEOF 36
#define N_OFFSETOF 47
#define N_COMPOUND 51
#define N_VAARG  53
/* Phase 30: the receiver block and the `$` / `.name` reference inside it both
   carry the receiver's static type in `text`. */
#define N_INTO 63
#define N_INTO_SELF 64
#define N_IMPL 33

namespace frontend::type;
pub trait TypeOps {
    int  is_iface_type(const char *type, char *tout, int tcap);
    int  iface_ref_type(const char *type, char *tout, int tcap, int *is_ptr);
    int  concrete_struct(const char *type, char *sout, int scap, int *is_ptr);
    int  expr_type(int n, char *out, int cap);
    int  expr_ctype(int n, char *out, int cap);
    int  maybe_box(int n, const char *trait, int addr);
    /* Phase 31: the C return type of an inherent method of an instantiated
       struct, with the template's type parameters bound to the instance's
       concrete C arguments. 0 when the method or its return type is unknown. */
    int  inst_method_ret(const char *ibase, const char *fname, char *out, int cap);
    int  type_has_array_init(const char *type);
    int  init_item_text(const char *stype, const char *item, char *out, int cap);
    int  rewrite_init_text(const char *stype, const char *raw, char **out, int *ocap);
    int  rewrite_init_names(const char *in, char *out, int cap);
    /* internals: the local node factory and the nested-value probe the array
       initialiser question needs */
    int  new_node(int kind);
    int  needs_init(const char *type);
    int  fail(const char *msg);
    const char *last_error(void);
}

pub struct TypeCheck {
    struct Arena *arena;
    struct Symbols *sym;
    struct Lexer   *lex;   /* only for the line of a fresh node */
    /* S1a-0 C1: the map table grows while parsing, so the type pass holds the
       parser's slot and dereferences it at every read. */
    struct MapTable  **maps; /* the map table slot */
    int  *nmaps;                        /* points at the driver's count: the table grows while parsing */
    char errmsg[160];
} use TypeOps;

/* A type spelling reduced to the key the type-host lookup compares: every
   whitespace character dropped, the `const` / `volatile` keywords dropped, and
   the integer aliases folded (`unsigned` == `unsigned int`, `long` ==
   `long int`, ...). The key is lossy by design -- it is only ever compared,
   never emitted, so `const char *` and `char *` are one host.
   This is `pub` because it is the one host key: the type pass here, the
   parser's arity pre-check and the emitter all compare with it, so no spelling
   can be matched for emission and missed for the arity diagnostic. */
pub void type_key(const char *in, char *out, int cap);
void type_key(const char *in, char *out, int cap)
{
    char raw[MAX_TEXT];
    char w[MAX_TEXT];
    int rn = 0, wn = 0, i;
    while (*in) {
        if (*in == ' ' || *in == '\t' || *in == '\n' || *in == '\r') {
            in++;
            continue;
        }
        if ((*in >= 'a' && *in <= 'z') || (*in >= 'A' && *in <= 'Z') || *in == '_') {
            wn = 0;
            while (((*in >= 'a' && *in <= 'z') || (*in >= 'A' && *in <= 'Z')
                    || (*in >= '0' && *in <= '9') || *in == '_') && wn < MAX_TEXT - 1)
                w[wn++] = *in++;
            w[wn] = 0;
            if (strcmp(w, "const") == 0 || strcmp(w, "volatile") == 0) continue;
            for (i = 0; i < wn && rn < MAX_TEXT - 1; i++) raw[rn++] = w[i];
            continue;
        }
        if (rn < MAX_TEXT - 1) raw[rn++] = *in;
        in++;
    }
    raw[rn] = 0;
    if (strchr(raw, '*') == 0 && strchr(raw, '[') == 0 && strchr(raw, '(') == 0) {
        if (strcmp(raw, "signed") == 0 || strcmp(raw, "signedint") == 0) {
            snprintf(raw, sizeof raw, "%s", "int");
        } else if (strcmp(raw, "unsignedint") == 0) {
            snprintf(raw, sizeof raw, "%s", "unsigned");
        } else if (strcmp(raw, "longint") == 0 || strcmp(raw, "signedlong") == 0
                   || strcmp(raw, "signedlongint") == 0) {
            snprintf(raw, sizeof raw, "%s", "long");
        } else if (strcmp(raw, "unsignedlongint") == 0) {
            snprintf(raw, sizeof raw, "%s", "unsignedlong");
        } else if (strcmp(raw, "longlongint") == 0 || strcmp(raw, "signedlonglong") == 0
                   || strcmp(raw, "signedlonglongint") == 0) {
            snprintf(raw, sizeof raw, "%s", "longlong");
        } else if (strcmp(raw, "unsignedlonglongint") == 0) {
            snprintf(raw, sizeof raw, "%s", "unsignedlonglong");
        } else if (strcmp(raw, "shortint") == 0 || strcmp(raw, "signedshort") == 0
                   || strcmp(raw, "signedshortint") == 0) {
            snprintf(raw, sizeof raw, "%s", "short");
        } else if (strcmp(raw, "unsignedshortint") == 0) {
            snprintf(raw, sizeof raw, "%s", "unsignedshort");
        }
    }
    snprintf(out, (size_t)cap, "%s", raw);
}

pub struct TypeCheck *type_get(void);

/* Phase 84: an ADT constructor answers the ADT's C struct spelling. */
/* PH-87 S87b slice: `AdtCtor` (one node kind). */
static int tc_expr_adtctor(struct TypeCheck *self, int n, char *out, int cap)
{
            if (snprintf(out, (size_t)cap, "struct %s", self->arena->nodes[n].text) >= cap)
                return -1;
            return 0;
}

/* PH-87 S87b slice: `Var` (one node kind). */
static int tc_expr_var(struct TypeCheck *self, int n, char *out, int cap)
{
    int i;
            const char *why;
            self->sym->errmsg[0] = 0;
            i = self->sym->var_type(self->arena->nodes[n].text2, out, cap);
            if (i < 0) {
                why = self->sym->last_error();
                if (why[0]) return self->fail(why);
                return -1;
            }
            return 0;
}

/* PH-87 S87b slice: `Index` (one node kind). */
static int tc_expr_index(struct TypeCheck *self, int n, char *out, int cap)
{
            /* a[i] is the pointee: a pointer's star drops, while an array's
               declared type has none to drop -- unless it is an array *of*
               pointers, which `is_array` keeps intact */
            size_t ln;
            if (self->expr_type(self->arena->nodes[n].a, out, cap) != 0) return -1;
            if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[self->arena->nodes[n].a].text2);
                if (vi >= 0 && self->sym->vars[vi].is_array) return 0;
            }
            ln = strlen(out);
            while (ln > 0 && out[ln - 1] == ' ') ln--;
            if (ln > 0 && out[ln - 1] == '*') {
                ln--;
                while (ln > 0 && out[ln - 1] == ' ') ln--;
                out[ln] = 0;
            }
            return 0;
}

/* PH-87 S87b slice: `Addr` (one node kind). */
static int tc_expr_addr(struct TypeCheck *self, int n, char *out, int cap)
{
            if (self->expr_type(self->arena->nodes[n].a, out, cap) != 0) return -1;
            if (strlen(out) + 2 >= (size_t)cap) return -1;
            strcat(out, " *");
            return 0;
}

/* PH-87 S87b slice: `Mcall` (one node kind). */
static int tc_expr_mcall(struct TypeCheck *self, int n, char *out, int cap)
{
            /* A static mapping call: the return type comes from the trait's
               method signature. `aux == 5` names the trait directly; `aux == 6`
               is a type host and the receiver's static type finds it. */
            if (self->arena->nodes[n].aux == 5) {
                int ti = self->sym->find_trait(self->arena->nodes[n].text);
                int mi;
                if (ti < 0) return -1;
                for (mi = 0; mi < self->sym->traits[ti].nm; mi++)
                    if (strcmp(self->sym->traits[ti].m[mi].name,
                               self->arena->nodes[n].text2) == 0) {
                        if (snprintf(out, (size_t)cap, "%s",
                                     self->sym->traits[ti].m[mi].ret) >= cap) return -1;
                        return 0;
                    }
                return -1;
            }
            if (self->arena->nodes[n].aux == 12) {
                /* LANG-29 S4 / B4: a `map binding` conversion answers its
                   declared target. */
                if (!self->arena->nodes[n].text4[0]) return -1;
                if (snprintf(out, (size_t)cap, "%s",
                             self->arena->nodes[n].text4) >= cap) return -1;
                return 0;
            }
            if (self->arena->nodes[n].aux == 6) {
                char rt[MAX_TEXT];
                char rk[MAX_TEXT];
                char tk[MAX_TEXT];
                int i, j;
                snprintf(rt, sizeof rt, "%s", self->arena->nodes[n].text);
                if (!rt[0]) return -1;
                type_key(rt, rk, MAX_TEXT);
                for (i = 0; i < (*self->nmaps); i++) {
                    if ((*self->maps)[i].is_binding) continue;
                    if (!(*self->maps)[i].is_static || !(*self->maps)[i].type_host) continue;
                    if (self->arena->nodes[n].text3[0]
                        && strcmp((*self->maps)[i].trait, self->arena->nodes[n].text3) != 0)
                        continue;
                    type_key((*self->maps)[i].host_type, tk, MAX_TEXT);
                    if (strcmp(tk, rk) != 0) continue;
                    for (j = 0; j < (*self->maps)[i].nb; j++)
                        if (strcmp((*self->maps)[i].b[j].method, self->arena->nodes[n].text2) == 0) {
                            if (snprintf(out, (size_t)cap, "%s",
                                         self->sym->traits[(*self->maps)[i].b[j].ti]
                                             .m[(*self->maps)[i].b[j].mi].ret) >= cap) return -1;
                            return 0;
                        }
                }
                return -1;
            }
            /* SH-72: a call through an interface value's vtable (aux 3/4)
               returns what the receiver trait's signature says, the same way
               the static mapping branch above reads it. Without this branch a
               call such as `HttpResponse res = req.send();` had no static type
               and the boxing decision reported `cannot infer the type to box`
               even though both sides name the same interface. */
            if (self->arena->nodes[n].aux == 3 || self->arena->nodes[n].aux == 4) {
                int ti = self->sym->find_trait(self->arena->nodes[n].text);
                int mi;
                if (ti < 0) return -1;
                for (mi = 0; mi < self->sym->traits[ti].nm; mi++)
                    if (strcmp(self->sym->traits[ti].m[mi].name,
                               self->arena->nodes[n].text2) == 0) {
                        if (snprintf(out, (size_t)cap, "%s",
                                     self->sym->traits[ti].m[mi].ret) >= cap) return -1;
                        return 0;
                    }
                return -1;
            }
            /* Phase 31: an inherent method of an instantiated struct (aux 9/10).
               The template's type parameters are bound to the instance's C
               arguments so an interface element read types correctly. */
            if (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10) {
                if (self->inst_method_ret(self->arena->nodes[n].text,
                                          self->arena->nodes[n].text2, out, cap))
                    return 0;
                return -1;
            }
            return -1;
}

/* PH-87 S87b slice: `Call` (one node kind). */
static int tc_expr_call(struct TypeCheck *self, int n, char *out, int cap)
{
    int i;
            i = self->sym->find_func(self->arena->nodes[n].text2);
            if (i < 0) return -1;
            if (snprintf(out, (size_t)cap, "%s", self->sym->funcs[i].ret) >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `Member), (N_ARROW` (one node kind). */
static int tc_expr_member_or_arrow(struct TypeCheck *self, int n, char *out, int cap)
{
            char rt[MAX_TEXT];
            char sname[MAX_TEXT];
            int is_ptr, si, fi;
            if (self->expr_type(self->arena->nodes[n].a, rt, sizeof rt) != 0) return -1;
            is_ptr = (self->arena->nodes[n].kind == N_ARROW);
            if (!self->concrete_struct(rt, sname, sizeof sname, &is_ptr)) return -1;
            si = self->sym->find_struct(sname);
            if (si < 0) return -1;
            for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
                if (strcmp(self->sym->structs[si].fields[fi].name, self->arena->nodes[n].text2) == 0) {
                    /* an array field decays to a pointer to its element, the
                       same way an array variable does at the call site -- but
                       only a one-dimensional array has a single element type
                       to name. `char names[2][8]` decays to `char (*)[8]`,
                       which no host spells, so it stays unknown instead of
                       silently becoming `char *`. */
                    const char *dims = self->sym->structs[si].fields[fi].dims;
                    int nb = 0;
                    const char *dp;
                    for (dp = dims; *dp; dp++)
                        if (*dp == '[') nb++;
                    if (nb > 1) return -1;
                    if (snprintf(out, (size_t)cap, "%s%s",
                                 self->sym->structs[si].fields[fi].type,
                                 nb == 1 ? " *" : "") >= cap)
                        return -1;
                    return 0;
                }
            return -1;
}

/* PH-87 S87b slice: `Box` (one node kind). */
static int tc_expr_box(struct TypeCheck *self, int n, char *out, int cap)
{
            if (snprintf(out, (size_t)cap, "struct %s_iface%s", self->arena->nodes[n].text,
                         (self->arena->nodes[n].aux & 2) ? " *" : "") >= cap) return -1;
            return 0;
}

/* PH-81 S1b: `new T { ... }` has the `Box<T>` type the parser recorded on the
   node, so the declaration / assignment checks see it. */
/* PH-87 S87b slice: `NewObj` (one node kind). */
static int tc_expr_newobj(struct TypeCheck *self, int n, char *out, int cap)
{
            if (snprintf(out, (size_t)cap, "%s", self->arena->nodes[n].text3) >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `Num` (one node kind). */
static int tc_expr_num(struct TypeCheck *self, int n, char *out, int cap)
{
            /* `text` holds the normalised suffix; the type host that claims a
               literal has to be the one matching that suffix, not always `int` */
            const char *sfx = self->arena->nodes[n].text;
            const char *t = "int";
            if (strcmp(sfx, "U") == 0) t = "unsigned";
            else if (strcmp(sfx, "L") == 0) t = "long";
            else if (strcmp(sfx, "UL") == 0 || strcmp(sfx, "LU") == 0) t = "unsigned long";
            else if (strcmp(sfx, "LL") == 0) t = "long long";
            else if (strcmp(sfx, "ULL") == 0 || strcmp(sfx, "LLU") == 0) t = "unsigned long long";
            if (snprintf(out, (size_t)cap, "%s", t) >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `FNum` (one node kind). */
static int tc_expr_fnum(struct TypeCheck *self, int n, char *out, int cap)
{
            size_t ln = strlen(self->arena->nodes[n].text);
            const char *t = "double";
            if (ln > 0 && (self->arena->nodes[n].text[ln - 1] == 'f'
                           || self->arena->nodes[n].text[ln - 1] == 'F')) t = "float";
            else if (ln > 0 && (self->arena->nodes[n].text[ln - 1] == 'l'
                                || self->arena->nodes[n].text[ln - 1] == 'L')) t = "long double";
            if (snprintf(out, (size_t)cap, "%s", t) >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `Str` (one node kind). */
static int tc_expr_str(struct TypeCheck *self, int n, char *out, int cap)
{
            /* a C string literal is `char[N]` in an object context and `char *`
               in a value context; a character literal is an `int`. PH-80: a
               literal already bound to String/Str keeps that type. */
            const char *t;
            if (self->arena->nodes[n].aux == 1) t = "String";
            else if (self->arena->nodes[n].aux == 2) t = "Str";
            else t = self->arena->str_at((int)self->arena->nodes[n].num)[0] == '\''
                     ? "int" : "char *";
            if (snprintf(out, (size_t)cap, "%s", t) >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `Cast` (one node kind). */
static int tc_expr_cast(struct TypeCheck *self, int n, char *out, int cap)
{
            /* a compound literal has the type it names, and `va_arg` yields the
               type it asks for, so the rest of the inference is unchanged */
            if (snprintf(out, (size_t)cap, "%s", self->arena->nodes[n].text) >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `Sizeof` (one node kind). */
static int tc_expr_sizeof(struct TypeCheck *self, int n, char *out, int cap)
{
    (void)self;
    (void)n;
            /* the corpus treats `sizeof` as `int`; `offsetof` is the same kind
               of integral value, so it shares the answer */
            if (snprintf(out, (size_t)cap, "%s", "int") >= cap) return -1;
            return 0;
}

/* PH-87 S87b slice: `Into` (one node kind). */
static int tc_expr_into(struct TypeCheck *self, int n, char *out, int cap)
{
            if (self->arena->nodes[n].text[0] == 0) return -1;
            if (snprintf(out, (size_t)cap, "%s", self->arena->nodes[n].text) >= cap)
                return -1;
            return 0;
}


/* v1-PH-0 S0.5b: the N_MEMBER / N_ARROW body, shared by the two match arms
   (the only difference is whether the base is a pointer). */
static int ctype_member(struct TypeCheck *self, int n, char *out, int cap, int is_ptr)
{
    char rt[MAX_TEXT];
    char sname[MAX_TEXT];
    int si, fi, w;

    if (self->expr_type(self->arena->nodes[n].a, rt, sizeof rt) != 0) return -1;
    if (!self->concrete_struct(rt, sname, sizeof sname, &is_ptr)) return -1;
    si = self->sym->find_struct(sname);
    if (si < 0) return -1;
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
        if (strcmp(self->sym->structs[si].fields[fi].name,
                   self->arena->nodes[n].text2) == 0) {
            w = snprintf(out, (size_t)cap, "%s%s",
                         self->sym->structs[si].fields[fi].type,
                         self->sym->structs[si].fields[fi].dims);
            if (w < 0 || w >= cap) return -1;
            return 0;
        }
    return -1;
}

/* LANG-29 S4 / B5 slice: an expression match answers the type the parser
   unified across its `yield` arms (stored on the node). A statement match is
   not a value and keeps the old "undecidable" answer. */
static int tc_expr_match(struct TypeCheck *self, int n, char *out, int cap)
{
    if ((self->arena->nodes[n].sflags & 8) == 0) return -1;
    if (!self->arena->nodes[n].text2[0]) return -1;
    if (snprintf(out, (size_t)cap, "%s", self->arena->nodes[n].text2) >= cap) return -1;
    return 0;
}

/* S1a-0 C2c: one rewritten initialiser text grows from MAX_INIT_TEXT (the old
   fixed buffer) to MAX_INIT_TEXT_MAX, doubling. A need over the formal bound
   and a failed realloc both return -1; the caller knows the need and can name
   the resource case before calling, so OOM stays distinct. */
static int init_text_reserve(char **buf, int *cap, int need)
{
    int ncap;
    char *grown;

    if (need <= *cap) return 0;
    ncap = *cap > 0 ? *cap : MAX_INIT_TEXT;
    while (ncap < need && ncap < MAX_INIT_TEXT_MAX) ncap *= 2;
    if (ncap > MAX_INIT_TEXT_MAX) ncap = MAX_INIT_TEXT_MAX;
    if (need > ncap) return -1;
    grown = (char *)realloc(*buf, (size_t)ncap);
    if (!grown) return -1;
    *buf = grown;
    *cap = ncap;
    return 0;
}

impl TypeOps for TypeCheck {
    /* Phase 31: the C return type of an inherent method of an instantiated
       struct, with the template's type parameters replaced by the instance's
       concrete C arguments. `Map<char *, Show>::get` answers
       `struct Show_iface *`; without the substitution the caller only sees the
       template spelling (`V *`), which no use site can match against a declared
       type. 0 when the method or its return type is unknown. */
    int inst_method_ret(const char *ibase, const char *fname, char *out, int cap)
    {
        char base[MAX_TEXT];
        char ret[MAX_TEXT];
        char tmp[MAX_TEXT];
        int m, inst, ti, tn, ii, nimpls, k, ni, j, hit;
        struct StructImpl *im;
        struct StructInst *ins;
        struct StructTmpl *tp;

        if (strncmp(ibase, "struct ", 7) != 0) return 0;
        snprintf(base, sizeof base, "%s", ibase + 7);
        inst = frontend::sym::ct_inst_find(base);
        if (inst < 0) {
            /* LANG-5 (ct-json JSON-2): a plain, non-generic inherent impl has no
               `ct_inst` row, so the instance branch below cannot run. Its method
               results still need a static type: without one a chained call
               (`doc.get(k).has(k)`) stays unresolved and the emitter rejects the
               receiver. The declared return type is already concrete, so read it
               from the arena the way `ParseSupport` resolves the method itself,
               and spell a struct result the way `static_ctype` does (`Ref` ->
               `struct Ref`). */
            int ni2, mi2;
            for (ni2 = 0; ni2 < self->arena->nnode; ni2++) {
                if (self->arena->nodes[ni2].kind != N_IMPL) continue;
                if (self->arena->nodes[ni2].text2[0]) continue;
                /* -1 is a template impl; an ADT inherent impl is
                   `-2 - adt` (LANG-29 S3 / B2). */
                if (self->arena->nodes[ni2].aux == -1) continue;
                if (strcmp(self->arena->nodes[ni2].text, ibase) != 0) continue;
                for (mi2 = self->arena->nodes[ni2].a; mi2 >= 0;
                     mi2 = self->arena->nodes[mi2].next)
                    if (strcmp(self->arena->nodes[mi2].text2, fname) == 0) break;
                if (mi2 < 0) continue;
                if (!self->arena->nodes[mi2].text[0]) return 0;
                snprintf(ret, sizeof ret, "%s", self->arena->nodes[mi2].text);
                if (strcmp(ret, "void") == 0) return 0;
                if (!strchr(ret, ' ') && !strchr(ret, '*')
                    && self->sym->find_struct(ret) >= 0) {
                    snprintf(tmp, sizeof tmp, "struct %s", ret);
                    snprintf(ret, sizeof ret, "%s", tmp);
                }
                if (snprintf(out, (size_t)cap, "%s", ret) >= cap) return 0;
                return 1;
            }
            return 0;
        }
        m = -1;
        im = frontend::sym::ct_impls(&nimpls);
        for (ii = 0; im && ii < nimpls && m < 0; ii++) {
            if (im[ii].use[0]) continue;
            if (!frontend::sym::ct_impl_matches(ii, inst)) continue;
            for (ni = self->arena->nodes[im[ii].node].a; ni >= 0;
                 ni = self->arena->nodes[ni].next)
                if (strcmp(self->arena->nodes[ni].text2, fname) == 0) {
                    m = ni;
                    break;
                }
        }
        if (m < 0) return 0;
        if (!self->arena->nodes[m].text[0]) return 0;
        snprintf(ret, sizeof ret, "%s", self->arena->nodes[m].text);
        ins = frontend::sym::ct_insts(&k);
        ti = frontend::sym::ct_tmpl_find(ins[inst].tmpl);
        tp = frontend::sym::ct_tmpls(&tn);
        hit = 1;
        if (ti >= 0 && tp) {
            for (j = 0; hit && j < tp[ti].ntparams; j++) {
                if (j >= ins[inst].nargs) break;
                if (!tp[ti].tparam[j] || !ins[inst].ctype[j]) continue;
                if (frontend::sym::ct_generic_subst(ret, tp[ti].tparam[j],
                                                    ins[inst].ctype[j], tmp, MAX_TEXT) != 0)
                    hit = 0;
                else snprintf(ret, sizeof ret, "%s", tmp);
            }
        }
        if (!hit) return 0;
        if (strcmp(ret, "void") == 0) return 0;
        if (snprintf(out, (size_t)cap, "%s", ret) >= cap) return 0;
        return 1;
    }

    /* The pool owns the storage and the reset of a fresh node; the line comes
       from the lexer and the overflow diagnostic from this object. */
    int new_node(int kind)
    {
        int n = self->arena->alloc(kind, self->lex->tokline);
        if (n < 0) return self->fail("too many AST nodes");
        return n;
    }

    int fail(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0])
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
        return -1;
    }

    const char *last_error(void)
    {
        (void)self;
        return self->errmsg;
    }

    /* `struct T_iface` -> T. */
    int is_iface_type(const char *type, char *tout, int tcap)
    {
        const char *base;
        size_t n;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) != 0) return 0;
        base += 7;
        n = strlen(base);
        if (n <= 6 || strcmp(base + n - 6, "_iface") != 0) return 0;
        if (n - 6 >= (size_t)tcap) return 0;
        snprintf(tout, (size_t)tcap, "%.*s", (int)(n - 6), base);
        return 1;
    }

    /* `struct X_iface` -> (X, 0); `struct X_iface *` -> (X, 1). */
    int iface_ref_type(const char *type, char *tout, int tcap, int *is_ptr)
    {
        char buf[MAX_TEXT];
        size_t n;
        (void)self;

        *is_ptr = 0;
        if (!type[0]) return 0;                  /* no type derived: not an interface */
        if (snprintf(buf, sizeof buf, "%s", type) >= (int)sizeof buf) return 0;
        n = strlen(buf);
        while (n > 0 && (buf[n - 1] == ' ' || buf[n - 1] == '*')) {
            if (buf[n - 1] == '*') *is_ptr = 1;
            buf[n - 1] = 0;
            n--;
        }
        return self->is_iface_type(buf, tout, tcap);
    }

    /* `struct S` / `S` / `struct S *` -> S (and whether it was a pointer). */
    int concrete_struct(const char *type, char *sout, int scap, int *is_ptr)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", type) >= (int)sizeof buf) return 0;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        *is_ptr = 0;
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            if (base[n - 1] == '*') *is_ptr = 1;
            base[n - 1] = 0;
            n--;
        }
        if (self->sym->find_struct(base) < 0) return 0;
        if (snprintf(sout, (size_t)scap, "%s", base) >= scap) return 0;
        return 1;
    }

    /* A best-effort static type for the expressions boxing needs.
       PH-87 S87b: the node-kind dispatch, one slice per kind (the bodies are
       the `tc_expr_*` helpers above). The kind is read once; the slice set is
       the one `p87_checker` inventories, so a kind that loses its slice fails
       the probe instead of silently returning "undecidable". */
    int expr_type(int n, char *out, int cap)
    {
        int k;

        k = self->arena->nodes[n].kind;
        if (k == N_ADTCTOR) return tc_expr_adtctor(self, n, out, cap);
        if (k == N_VAR) return tc_expr_var(self, n, out, cap);
        if (k == N_INDEX) return tc_expr_index(self, n, out, cap);
        if (k == N_ADDR) return tc_expr_addr(self, n, out, cap);
        if (k == N_MCALL) return tc_expr_mcall(self, n, out, cap);
        if (k == N_CALL) return tc_expr_call(self, n, out, cap);
        if (k == N_MEMBER || k == N_ARROW) return tc_expr_member_or_arrow(self, n, out, cap);
        if (k == N_BOX) return tc_expr_box(self, n, out, cap);
        if (k == N_NEWOBJ) return tc_expr_newobj(self, n, out, cap);
        if (k == N_NUM) return tc_expr_num(self, n, out, cap);
        if (k == N_FNUM) return tc_expr_fnum(self, n, out, cap);
        if (k == N_STR) return tc_expr_str(self, n, out, cap);
        if (k == N_CAST || k == N_COMPOUND || k == N_VAARG) return tc_expr_cast(self, n, out, cap);
        if (k == N_SIZEOF || k == N_OFFSETOF) return tc_expr_sizeof(self, n, out, cap);
        if (k == N_INTO || k == N_INTO_SELF) return tc_expr_into(self, n, out, cap);
        if (k == N_MATCH) return tc_expr_match(self, n, out, cap);
        return -1;
    }

    /* 19.2: the expression's type with its array dimensions kept (`char[64]`).
       `expr_type` drops them (boxing only needs the class), but the coarse
       argument-type check needs to see a decayed array so it can leave it
       alone: an N_VAR with `is_array` gains `[]` (the count is not needed), an
       N_MEMBER / N_ARROW appends the field's dims, an N_INDEX peels one dim
       off its base (or one star off a pointer), `&x` appends one star, and the
       implicit `self` -- recorded without its pointer star -- gains it back.
       Everything else defers to `expr_type`. */
    int expr_ctype(int n, char *out, int cap)
    {
        int k;

        k = self->arena->nodes[n].kind;

        match ((NodeKind){ .tag = k }) {
            NodeKind.NK_UNUSED0() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_PROG() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_PP() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_FUNC() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_BLOCK() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_RET() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_EXPR() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_CALL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_NUM() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_STR() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_VAR() => {
                int vi = self->sym->find_var(self->arena->nodes[n].text2);
                int w;
                if (vi < 0) return -1;
                w = snprintf(out, (size_t)cap, "%s%s%s", self->sym->vars[vi].type,
                             (strcmp(self->arena->nodes[n].text2, "self") == 0
                              && strncmp(self->sym->vars[vi].type, "struct ", 7) == 0
                              && !strchr(self->sym->vars[vi].type, '*')) ? " *" : "",
                             self->sym->vars[vi].is_array ? "[]" : "");
                if (w < 0 || w >= cap) return -1;
                return 0;
            
            }
            NodeKind.NK_BIN() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_DECL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ASSIGN() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_IF() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_WHILE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_FOR() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_UNARY() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_POST() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_PARAM() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_STRUCT() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_TYPEDEF() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_GLOBAL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_FIELD() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_MEMBER() => { return ctype_member(self, n, out, cap, 0); }
            NodeKind.NK_ARROW() => { return ctype_member(self, n, out, cap, 1); }
            NodeKind.NK_INDEX() => {
                char *br, *close;
                if (self->expr_ctype(self->arena->nodes[n].a, out, cap) != 0) return -1;
                br = strchr(out, '[');
                if (br) {
                    if (br[1] == ']') return 0;   /* a var's bare `[]` marker: the
                        remaining dims are unknown, so the element stays an array */
                    close = strchr(br, ']');
                    if (close) memmove(br, close + 1, strlen(close + 1) + 1);
                    return 0;
                }
                br = strrchr(out, '*');
                if (!br) return -1;
                memmove(br, br + 1, strlen(br + 1) + 1);
                return 0;
            
            }
            NodeKind.NK_ADDR() => {
                int n2;
                if (self->expr_ctype(self->arena->nodes[n].a, out, cap) != 0) return -1;
                n2 = (int)strlen(out);
                if (n2 + 3 >= cap) return -1;
                out[n2] = ' ';
                out[n2 + 1] = '*';
                out[n2 + 2] = 0;
                return 0;
            
            }
            NodeKind.NK_DEREF() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_METHOD() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_MCALL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_RAW() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_UNUSED32() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_IMPL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_BOX() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_CAST() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_SIZEOF() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_TERN() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_BREAK() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_CONT() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_DECLS() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_DELETE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_SWITCH() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_CASE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_DOWHILE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ENUM() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ENUMVAL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_OFFSETOF() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_UNION() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_LABEL() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_GOTO() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_COMPOUND() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_EMPTY() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_VAARG() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_FNUM() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_SASSERT() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_FIELDS() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_PRE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_RAW_TEXT() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_CLOSURE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_LOOP() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_INIT_RANGE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_FOREACH() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_INTO() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_INTO_SELF() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_INIT_BRACE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_INIT_ITEM() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_INIT_MBRACE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_UNUSED68() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_DEFER() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_DEFER_RUN() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_TRY() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_OPT() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_MATSEQ() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_SLICE_INDEX() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_SLICE_RANGE() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_SLICE_GET() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_NEWOBJ() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_MATCH() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ARM() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_BIND() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ADTCTOR() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ADTFIELD() => { return self->expr_type(n, out, cap); }
            NodeKind.NK_ADTMEM() => { return self->expr_type(n, out, cap); }
        }
    }

    /* Wrap `n` in a fat pointer when `trait` is expected; an expression that is
       already the right interface passes through unchanged. A declared global
       instance bound by `map` (11.2) boxes with its instance-level vtable even
       when its struct never `use`d the trait. */
    int maybe_box(int n, const char *trait, int addr)
    {
        char t[MAX_TEXT];
        char tname[MAX_TEXT];
        char sname[MAX_TEXT];
        char iname[MAX_TEXT];
        int is_ptr, si, u, bnode, found, i, mptr, ip, nk;
        (void)self;

        {
            int st = self->sym->find_trait(trait);
            if (st >= 0 && self->sym->traits[st].is_static)
                return self->fail("a static trait has no interface value");
        }
        nk = self->arena->nodes[n].kind;
        mptr = 0;
        iname[0] = 0;
        match ((NodeKind){ .tag = nk }) {
            NodeKind.NK_BOX() => {
                /* already an interface value; the trait must be the expected one.
                   Bit 3 of aux marks the node as accepted by an interface context,
                   which is what the emitter requires of a namespace-host value
                   (SH-20). `b` stays a child slot: the emitter's hoist walk reads
                   it as a node index. */
                if (strcmp(self->arena->nodes[n].text, trait) != 0)
                    return self->fail("interface type mismatch");
                self->arena->nodes[n].aux |= 8;
                /* a pointer target takes its address */
                if (!addr) return n;
                bnode = self->new_node(N_ADDR);
                if (bnode < 0) return -1;
                self->arena->nodes[bnode].a = n;
                return bnode;
            
            }
            NodeKind.NK_VAR() => {
                snprintf(iname, sizeof iname, "%s", self->arena->nodes[n].text2);
            }
            NodeKind.NK_ADDR() => {
                if (self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR) {
                    snprintf(iname, sizeof iname, "%s", self->arena->nodes[self->arena->nodes[n].a].text2);
                    mptr = 1;
                }
            }
            NodeKind.NK_UNUSED0() => { }
            NodeKind.NK_PROG() => { }
            NodeKind.NK_PP() => { }
            NodeKind.NK_FUNC() => { }
            NodeKind.NK_BLOCK() => { }
            NodeKind.NK_RET() => { }
            NodeKind.NK_EXPR() => { }
            NodeKind.NK_CALL() => { }
            NodeKind.NK_NUM() => { }
            NodeKind.NK_STR() => { }
            NodeKind.NK_BIN() => { }
            NodeKind.NK_DECL() => { }
            NodeKind.NK_ASSIGN() => { }
            NodeKind.NK_IF() => { }
            NodeKind.NK_WHILE() => { }
            NodeKind.NK_FOR() => { }
            NodeKind.NK_UNARY() => { }
            NodeKind.NK_POST() => { }
            NodeKind.NK_PARAM() => { }
            NodeKind.NK_STRUCT() => { }
            NodeKind.NK_TYPEDEF() => { }
            NodeKind.NK_GLOBAL() => { }
            NodeKind.NK_FIELD() => { }
            NodeKind.NK_MEMBER() => { }
            NodeKind.NK_ARROW() => { }
            NodeKind.NK_INDEX() => { }
            NodeKind.NK_DEREF() => { }
            NodeKind.NK_METHOD() => { }
            NodeKind.NK_MCALL() => { }
            NodeKind.NK_RAW() => { }
            NodeKind.NK_UNUSED32() => { }
            NodeKind.NK_IMPL() => { }
            NodeKind.NK_CAST() => { }
            NodeKind.NK_SIZEOF() => { }
            NodeKind.NK_TERN() => { }
            NodeKind.NK_BREAK() => { }
            NodeKind.NK_CONT() => { }
            NodeKind.NK_DECLS() => { }
            NodeKind.NK_DELETE() => { }
            NodeKind.NK_SWITCH() => { }
            NodeKind.NK_CASE() => { }
            NodeKind.NK_DOWHILE() => { }
            NodeKind.NK_ENUM() => { }
            NodeKind.NK_ENUMVAL() => { }
            NodeKind.NK_OFFSETOF() => { }
            NodeKind.NK_UNION() => { }
            NodeKind.NK_LABEL() => { }
            NodeKind.NK_GOTO() => { }
            NodeKind.NK_COMPOUND() => { }
            NodeKind.NK_EMPTY() => { }
            NodeKind.NK_VAARG() => { }
            NodeKind.NK_FNUM() => { }
            NodeKind.NK_SASSERT() => { }
            NodeKind.NK_FIELDS() => { }
            NodeKind.NK_PRE() => { }
            NodeKind.NK_RAW_TEXT() => { }
            NodeKind.NK_CLOSURE() => { }
            NodeKind.NK_LOOP() => { }
            NodeKind.NK_INIT_RANGE() => { }
            NodeKind.NK_FOREACH() => { }
            NodeKind.NK_INTO() => { }
            NodeKind.NK_INTO_SELF() => { }
            NodeKind.NK_INIT_BRACE() => { }
            NodeKind.NK_INIT_ITEM() => { }
            NodeKind.NK_INIT_MBRACE() => { }
            NodeKind.NK_UNUSED68() => { }
            NodeKind.NK_DEFER() => { }
            NodeKind.NK_DEFER_RUN() => { }
            NodeKind.NK_TRY() => { }
            NodeKind.NK_OPT() => { }
            NodeKind.NK_MATSEQ() => { }
            NodeKind.NK_SLICE_INDEX() => { }
            NodeKind.NK_SLICE_RANGE() => { }
            NodeKind.NK_SLICE_GET() => { }
            NodeKind.NK_NEWOBJ() => { }
            NodeKind.NK_MATCH() => { }
            NodeKind.NK_ARM() => { }
            NodeKind.NK_BIND() => { }
            NodeKind.NK_ADTCTOR() => { }
            NodeKind.NK_ADTFIELD() => { }
            NodeKind.NK_ADTMEM() => { }
        }
        if (iname[0]) {
            for (i = 0; i < (*self->nmaps); i++)
                if (!(*self->maps)[i].is_binding
                    && strcmp((*self->maps)[i].inst, iname) == 0
                    && strcmp((*self->maps)[i].trait, trait) == 0) {
                    bnode = self->new_node(N_BOX);
                    if (bnode < 0) return -1;
                    self->arena->nodes[bnode].a = n;
                    self->arena->nodes[bnode].aux = mptr + (addr ? 2 : 0);
                    self->arena->nodes[bnode].text = runtime::text::ct_intern(trait);
                    if (!self->arena->nodes[bnode].text) return self->fail("out of memory");
                    /* the map's instance-level vtable is named from the
                       instance's C spelling, which carries its namespace */
                    self->arena->nodes[bnode].text2 = runtime::text::ct_intern((*self->maps)[i].cname);
                    if (!self->arena->nodes[bnode].text2) return self->fail("out of memory");
                    return bnode;
                }
        }
        if (self->expr_type(n, t, sizeof t) != 0)
            return self->fail("cannot infer the type to box");
        ip = 0;
        if (self->iface_ref_type(t, tname, sizeof tname, &ip)) {
            if (strcmp(tname, trait) == 0) {
                if (ip == addr) return n;
                /* an array of interface values decays to a pointer */
                if (!ip && addr) {
                    match ((NodeKind){ .tag = nk }) {
                        NodeKind.NK_VAR() => {
                            int vi = self->sym->find_var(self->arena->nodes[n].text2);
                            if (vi >= 0 && self->sym->vars[vi].is_array) return n;
                        }
                        NodeKind.NK_UNUSED0() => { }
                        NodeKind.NK_PROG() => { }
                        NodeKind.NK_PP() => { }
                        NodeKind.NK_FUNC() => { }
                        NodeKind.NK_BLOCK() => { }
                        NodeKind.NK_RET() => { }
                        NodeKind.NK_EXPR() => { }
                        NodeKind.NK_CALL() => { }
                        NodeKind.NK_NUM() => { }
                        NodeKind.NK_STR() => { }
                        NodeKind.NK_BIN() => { }
                        NodeKind.NK_DECL() => { }
                        NodeKind.NK_ASSIGN() => { }
                        NodeKind.NK_IF() => { }
                        NodeKind.NK_WHILE() => { }
                        NodeKind.NK_FOR() => { }
                        NodeKind.NK_UNARY() => { }
                        NodeKind.NK_POST() => { }
                        NodeKind.NK_PARAM() => { }
                        NodeKind.NK_STRUCT() => { }
                        NodeKind.NK_TYPEDEF() => { }
                        NodeKind.NK_GLOBAL() => { }
                        NodeKind.NK_FIELD() => { }
                        NodeKind.NK_MEMBER() => { }
                        NodeKind.NK_ARROW() => { }
                        NodeKind.NK_INDEX() => { }
                        NodeKind.NK_ADDR() => { }
                        NodeKind.NK_DEREF() => { }
                        NodeKind.NK_METHOD() => { }
                        NodeKind.NK_MCALL() => { }
                        NodeKind.NK_RAW() => { }
                        NodeKind.NK_UNUSED32() => { }
                        NodeKind.NK_IMPL() => { }
                        NodeKind.NK_BOX() => { }
                        NodeKind.NK_CAST() => { }
                        NodeKind.NK_SIZEOF() => { }
                        NodeKind.NK_TERN() => { }
                        NodeKind.NK_BREAK() => { }
                        NodeKind.NK_CONT() => { }
                        NodeKind.NK_DECLS() => { }
                        NodeKind.NK_DELETE() => { }
                        NodeKind.NK_SWITCH() => { }
                        NodeKind.NK_CASE() => { }
                        NodeKind.NK_DOWHILE() => { }
                        NodeKind.NK_ENUM() => { }
                        NodeKind.NK_ENUMVAL() => { }
                        NodeKind.NK_OFFSETOF() => { }
                        NodeKind.NK_UNION() => { }
                        NodeKind.NK_LABEL() => { }
                        NodeKind.NK_GOTO() => { }
                        NodeKind.NK_COMPOUND() => { }
                        NodeKind.NK_EMPTY() => { }
                        NodeKind.NK_VAARG() => { }
                        NodeKind.NK_FNUM() => { }
                        NodeKind.NK_SASSERT() => { }
                        NodeKind.NK_FIELDS() => { }
                        NodeKind.NK_PRE() => { }
                        NodeKind.NK_RAW_TEXT() => { }
                        NodeKind.NK_CLOSURE() => { }
                        NodeKind.NK_LOOP() => { }
                        NodeKind.NK_INIT_RANGE() => { }
                        NodeKind.NK_FOREACH() => { }
                        NodeKind.NK_INTO() => { }
                        NodeKind.NK_INTO_SELF() => { }
                        NodeKind.NK_INIT_BRACE() => { }
                        NodeKind.NK_INIT_ITEM() => { }
                        NodeKind.NK_INIT_MBRACE() => { }
                        NodeKind.NK_UNUSED68() => { }
                        NodeKind.NK_DEFER() => { }
                        NodeKind.NK_DEFER_RUN() => { }
                        NodeKind.NK_TRY() => { }
                        NodeKind.NK_OPT() => { }
                        NodeKind.NK_MATSEQ() => { }
                        NodeKind.NK_SLICE_INDEX() => { }
                        NodeKind.NK_SLICE_RANGE() => { }
                        NodeKind.NK_SLICE_GET() => { }
                        NodeKind.NK_NEWOBJ() => { }
                        NodeKind.NK_MATCH() => { }
                        NodeKind.NK_ARM() => { }
                        NodeKind.NK_BIND() => { }
                        NodeKind.NK_ADTCTOR() => { }
                        NodeKind.NK_ADTFIELD() => { }
                        NodeKind.NK_ADTMEM() => { }
                    }
                }
            }
            return self->fail("interface type mismatch");
        }
        if (!self->concrete_struct(t, sname, sizeof sname, &is_ptr))
            return self->fail("cannot box this expression");
        si = self->sym->find_struct(sname);
        if (si < 0) return self->fail("cannot box an unknown struct");
        found = 0;
        for (u = 0; u < self->sym->structs[si].nuse; u++)
            if (strcmp(self->sym->structs[si].use[u], trait) == 0) found = 1;
        if (!found) return self->fail("the struct does not use this trait");
        /* A non-pointer interface box takes the operand's address. Only an addressable
           operand may be boxed; a struct-valued call is an rvalue, and
           `(void *)&mk()` is invalid C. Reject it here instead of emitting C
           the backend cannot compile. */
        if (!is_ptr) {
            match ((NodeKind){ .tag = nk }) {
                NodeKind.NK_VAR() => { }
                NodeKind.NK_MEMBER() => { }
                NodeKind.NK_ARROW() => { }
                NodeKind.NK_INDEX() => { }
                NodeKind.NK_DEREF() => { }
                NodeKind.NK_UNUSED0() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_PROG() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_PP() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_FUNC() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_BLOCK() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_RET() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_EXPR() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_CALL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_NUM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_STR() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_BIN() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_DECL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ASSIGN() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_IF() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_WHILE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_FOR() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_UNARY() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_POST() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_PARAM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_STRUCT() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_TYPEDEF() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_GLOBAL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_FIELD() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ADDR() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_METHOD() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_MCALL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_RAW() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_UNUSED32() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_IMPL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_BOX() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_CAST() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_SIZEOF() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_TERN() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_BREAK() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_CONT() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_DECLS() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_DELETE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_SWITCH() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_CASE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_DOWHILE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ENUM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ENUMVAL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_OFFSETOF() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_UNION() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_LABEL() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_GOTO() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_COMPOUND() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_EMPTY() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_VAARG() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_FNUM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_SASSERT() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_FIELDS() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_PRE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_RAW_TEXT() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_CLOSURE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_LOOP() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_INIT_RANGE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_FOREACH() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_INTO() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_INTO_SELF() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_INIT_BRACE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_INIT_ITEM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_INIT_MBRACE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_UNUSED68() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_DEFER() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_DEFER_RUN() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_TRY() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_OPT() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_MATSEQ() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_SLICE_INDEX() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_SLICE_RANGE() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_SLICE_GET() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_NEWOBJ() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_MATCH() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ARM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_BIND() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ADTCTOR() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ADTFIELD() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
                NodeKind.NK_ADTMEM() => { return self->fail("cannot box an rvalue struct; assign it to a variable first"); }
            }
        }
        bnode = self->new_node(N_BOX);
        if (bnode < 0) return -1;
        self->arena->nodes[bnode].a = n;
        self->arena->nodes[bnode].aux = is_ptr + (addr ? 2 : 0);
        self->arena->nodes[bnode].text = runtime::text::ct_intern(trait);
        if (!self->arena->nodes[bnode].text) return self->fail("out of memory");
        self->arena->nodes[bnode].text2 = runtime::text::ct_intern(sname);
        if (!self->arena->nodes[bnode].text2) return self->fail("out of memory");
        return bnode;
    }

    /* Does `type` carry a struct-typed array field whose elements need vptrs?
       Such a field cannot be initialised by designator, so the declaration site
       has to emit a loop after it. */
    int type_has_array_init(const char *type)
    {
        const char *base;
        int si, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->sym->find_struct(base);
        for (fi = 0; si >= 0 && fi < self->sym->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            if (!self->sym->structs[si].fields[fi].dims[0]) continue;
            snprintf(ft, sizeof ft, "%s", self->sym->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (self->needs_init(ft)) return 1;
        }
        return 0;
    }

    /* Does this *value* type need a vptr written somewhere -- itself or through a
       nested value field? `Outer { Inner in; }` needs one even though Outer uses
       no trait of its own. Pointer types are not initialised this way. The
       emitter keeps the same probe on the driver; this copy is the one the
       array-field question above asks. */
    int needs_init(const char *type)
    {
        const char *base;
        char tb[MAX_TEXT];
        size_t tl;
        int si, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        snprintf(tb, sizeof tb, "%s", base);
        tl = strlen(tb);
        while (tl > 0 && (tb[tl - 1] == ' ')) {
            tl--;
            tb[tl] = 0;
        }
        if (strchr(tb, '*') != 0) return 0;
        si = self->sym->find_struct(tb);
        if (si < 0) return 0;
        if (self->sym->structs[si].nuse > 0) return 1;
        for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", self->sym->structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (self->needs_init(ft)) return 1;
        }
        return 0;
    }

    /* Rewrite one initialiser item when it fills an interface field from a
       concrete struct (`.l = a`, `.l = &a`). Both forms need boxing: a value
       field takes the fat pointer, a pointer field its address. Anything else
       (including a value that is already an interface) is copied verbatim, so
       existing initialisers stay byte for byte as they were. */
    int init_item_text(const char *stype, const char *item, char *out, int cap)
    {
        const char *p, *rhs, *base;
        char fname[MAX_TEXT];
        char ftype[MAX_TEXT];
        char sname[MAX_TEXT];
        char tname[MAX_TEXT];
        char vname[MAX_TEXT];
        char vtype[MAX_TEXT];
        int si, fi, is_ptr, srcptr, vptr, u, found, ok;
        size_t k;

        fname[0] = 0;
        ftype[0] = 0;
        sname[0] = 0;
        tname[0] = 0;
        vname[0] = 0;
        vtype[0] = 0;
        rhs = item;
        base = stype;

        /* shape: `.field = <operand>` */
        p = item;
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        ok = (*p == '.');
        if (ok) p++;
        k = 0;
        while (ok && ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                      || (*p >= '0' && *p <= '9') || *p == '_')) {
            if (k + 1 >= sizeof fname) ok = 0;
            else { fname[k] = *p; k++; p++; }
        }
        fname[k] = 0;
        if (!k) ok = 0;
        while (ok && (*p == ' ' || *p == '\t')) p++;
        if (ok && *p != '=') ok = 0;
        if (ok) { p++; rhs = p; }

        /* the field must be an interface (value or pointer) of a known struct */
        if (ok && strncmp(base, "struct ", 7) == 0) base += 7;
        while (ok && *base == ' ') base++;
        si = ok ? self->sym->find_struct(base) : -1;
        if (si < 0) ok = 0;
        fi = -1;
        for (u = 0; ok && u < self->sym->structs[si].nfields; u++)
            if (strcmp(self->sym->structs[si].fields[u].name, fname) == 0) fi = u;
        if (ok && (fi < 0 || self->sym->structs[si].fields[fi].dims[0])) ok = 0;
        is_ptr = 0;
        if (ok) {
            snprintf(ftype, sizeof ftype, "%s", self->sym->structs[si].fields[fi].type);
            if (!self->iface_ref_type(ftype, tname, sizeof tname, &is_ptr)) ok = 0;
        }

        /* the operand must be a bare variable, optionally addressed */
        srcptr = 0;
        if (ok) {
            p = rhs;
            while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
            if (*p == '&') {
                srcptr = 1;
                p++;
                while (*p == ' ' || *p == '\t') p++;
            }
            k = 0;
            while (ok && ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                          || (*p >= '0' && *p <= '9') || *p == '_')) {
                if (k + 1 >= sizeof vname) ok = 0;
                else { vname[k] = *p; k++; p++; }
            }
            vname[k] = 0;
            if (!k) ok = 0;
            while (ok && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r')) p++;
            if (ok && *p) ok = 0;
        }

        /* ... of a struct that implements the trait, with matching indirection */
        vptr = 0;
        if (ok) {
            self->sym->errmsg[0] = 0;
            if (self->sym->var_type(vname, vtype, (int)sizeof vtype) != 0) ok = 0;
        }
        if (ok && !self->concrete_struct(vtype, sname, sizeof sname, &vptr)) ok = 0;
        if (ok && srcptr && vptr) ok = 0;     /* `&p` on a struct pointer is not an interface-box source */
        found = 0;
        si = ok ? self->sym->find_struct(sname) : -1;
        for (u = 0; ok && si >= 0 && u < self->sym->structs[si].nuse; u++)
            if (strcmp(self->sym->structs[si].use[u], tname) == 0) found = 1;
        if (ok && !found) ok = 0;

        if (!ok) {
            if (snprintf(out, (size_t)cap, "%s", item) >= cap) return -1;
            return 0;
        }
        /* the self pointer is the operand itself when it already is a pointer */
        if (snprintf(out, (size_t)cap, ".%s = %s(struct %s_iface){ (void *)%s%s, &%s_%s_vtable }",
                     fname, is_ptr ? "&" : "", tname,
                     (srcptr || !vptr) ? "&" : "", vname, sname, tname) >= cap) return -1;
        return 0;
    }

    /* Rewrite a captured `{ ... }` list item by item. Runs at parse time: the
       operand types come from the local variable table, which is gone by the
       time the emitter walks the AST. S1a-0 C2c: the result is a heap block
       owned by the caller (`*out` / `*ocap`); it grows from the old
       MAX_INIT_TEXT to the formal MAX_INIT_TEXT_MAX, and over-limit is a named
       resource error instead of a silent -1. */
    int rewrite_init_text(const char *stype, const char *raw, char **out, int *ocap)
    {
        int len, i, depth, in_str, start, seg, need, cap, fixedcap, namedcap, had;
        char *buf, *item, *fixed, *named;
        (void)self;

        *out = (char *)0;
        *ocap = 0;
        buf = (char *)0;
        cap = 0;
        len = (int)strlen(raw);
        if (len < 2 || raw[len - 1] != '}') {
            need = len + 1;
            if (need > MAX_INIT_TEXT_MAX)
                return self->fail("initializer text exceeds 65536 bytes");
            if (init_text_reserve(&buf, &cap, need) != 0)
                return self->fail("out of memory");
            snprintf(buf, (size_t)cap, "%s", raw);
            *out = buf;
            *ocap = cap;
            return 0;
        }
        /* S1a-0 C1: one item may exceed the old MAX_INIT_ITEM (4096); the
           scratch only has to hold this line's captured text, so it is sized
           from `len` and freed before returning. S1a-0 C2c: the rewritten
           single item's own buffer is sized the same way (a boxing rewrite
           adds at most a few hundred bytes of fixed text). */
        item = (char *)malloc((size_t)len + 1);
        if (!item) return self->fail("out of memory");
        fixedcap = len + 1024;
        fixed = (char *)malloc((size_t)fixedcap);
        if (!fixed) {
            free(item);
            return self->fail("out of memory");
        }
        if (init_text_reserve(&buf, &cap, 3) != 0) {
            free(item);
            free(fixed);
            return self->fail("out of memory");
        }
        buf[0] = '{';
        buf[1] = 0;
        start = 1;
        depth = 0;
        in_str = 0;
        for (i = 1; i < len - 1; i++) {
            char c = raw[i];
            if (in_str) {
                if (c == '\\' && raw[i + 1]) i++;
                else if (c == '"') in_str = 0;
                continue;
            }
            if (c == '"') { in_str = 1; continue; }
            if (c == '{' || c == '[' || c == '(') depth++;
            else if (c == '}' || c == ']' || c == ')') depth--;
            else if (c == ',' && depth == 0) {
                seg = i - start;
                memcpy(item, raw + start, (size_t)seg);
                item[seg] = 0;
                if (self->init_item_text(stype, item, fixed, fixedcap) != 0) {
                    free(item);
                    free(fixed);
                    free(buf);
                    return self->fail("initializer text exceeds 65536 bytes");
                }
                need = (int)strlen(buf) + (int)strlen(fixed) + 3;
                if (need > MAX_INIT_TEXT_MAX) {
                    free(item);
                    free(fixed);
                    free(buf);
                    return self->fail("initializer text exceeds 65536 bytes");
                }
                if (init_text_reserve(&buf, &cap, need) != 0) {
                    free(item);
                    free(fixed);
                    free(buf);
                    return self->fail("out of memory");
                }
                strcat(buf, fixed);
                strcat(buf, ",");
                start = i + 1;
            }
        }
        seg = len - 1 - start;
        if (seg < 0) seg = 0;
        memcpy(item, raw + start, (size_t)seg);
        item[seg] = 0;
        if (self->init_item_text(stype, item, fixed, fixedcap) != 0) {
            free(item);
            free(fixed);
            free(buf);
            return self->fail("initializer text exceeds 65536 bytes");
        }
        need = (int)strlen(buf) + (int)strlen(fixed) + 3;
        if (need > MAX_INIT_TEXT_MAX) {
            free(item);
            free(fixed);
            free(buf);
            return self->fail("initializer text exceeds 65536 bytes");
        }
        if (init_text_reserve(&buf, &cap, need) != 0) {
            free(item);
            free(fixed);
            free(buf);
            return self->fail("out of memory");
        }
        strcat(buf, fixed);
        strcat(buf, "}");
        /* The captured text still spells a namespaced global the way the source
           did, while its declaration is emitted under the mangled name (SH-52).
           Substituting here keeps the initialiser and the declaration in step.
           The name rewrite can lengthen a name, so its scratch is the formal
           bound; a real semantic failure has already set errmsg and must not be
           overwritten with a resource message. */
        namedcap = MAX_INIT_TEXT_MAX;
        named = (char *)malloc((size_t)namedcap);
        if (!named) {
            free(item);
            free(fixed);
            free(buf);
            return self->fail("out of memory");
        }
        self->errmsg[0] = 0;
        if (self->rewrite_init_names(buf, named, namedcap) != 0) {
            had = self->errmsg[0] != 0;
            free(item);
            free(fixed);
            free(named);
            free(buf);
            if (had) return -1;
            return self->fail("initializer text exceeds 65536 bytes");
        }
        need = (int)strlen(named) + 1;
        if (need > MAX_INIT_TEXT_MAX) {
            free(item);
            free(fixed);
            free(named);
            free(buf);
            return self->fail("initializer text exceeds 65536 bytes");
        }
        if (init_text_reserve(&buf, &cap, need) != 0) {
            free(item);
            free(fixed);
            free(named);
            free(buf);
            return self->fail("out of memory");
        }
        snprintf(buf, (size_t)cap, "%s", named);
        free(item);
        free(fixed);
        free(named);
        *out = buf;
        *ocap = cap;
        return 0;
    }

    /* Rewrite every identifier in captured C initialiser text that the variable
       table knows under a different C spelling. Member names (`.x`, `->x`),
       struct tags and string literals are copied verbatim: none of them can name
       a file-scope variable. A local keeps its own name, so only namespaced
       globals and imported globals change. */
    int rewrite_init_names(const char *in, char *out, int cap)
    {
        char id[MAX_TEXT];
        char last[MAX_TEXT];
        char fn_cn[MAX_TEXT];
        char msg[MAX_TEXT];
        int i, n, w, vi, fi, fn_hits, fn_bad;
        char c;
        (void)self;

        i = 0;
        w = 0;
        last[0] = 0;
        while (in[i]) {
            c = in[i];
            if (c == '"' || c == '\'') {
                if (w + 1 >= cap) return -1;
                out[w] = c;
                w++;
                i++;
                while (in[i]) {
                    if (in[i] == '\\' && in[i + 1]) {
                        if (w + 2 >= cap) return -1;
                        out[w] = in[i]; w++;
                        i++;
                        out[w] = in[i]; w++;
                        i++;
                        continue;
                    }
                    if (w + 1 >= cap) return -1;
                    out[w] = in[i];
                    w++;
                    if (in[i] == c) { i++; break; }
                    i++;
                }
                last[0] = 0;
                continue;
            }
            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                  || (c >= '0' && c <= '9') || c == '_')) {
                if (w + 1 >= cap) return -1;
                out[w] = c;
                w++;
                i++;
                if (c == '.' || c == '>') {
                    last[0] = c;
                    last[1] = 0;
                } else if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
                    last[0] = 0;
                }
                continue;
            }
            n = 0;
            while ((in[i] >= 'a' && in[i] <= 'z') || (in[i] >= 'A' && in[i] <= 'Z')
                   || (in[i] >= '0' && in[i] <= '9') || in[i] == '_') {
                if (n + 1 < (int)sizeof id) { id[n] = in[i]; n++; }
                i++;
            }
            id[n] = 0;
            /* a member name and a struct / enum / union tag are not variables */
            if (last[0] == '.' || last[0] == '>' || strcmp(last, "struct") == 0
                || strcmp(last, "enum") == 0 || strcmp(last, "union") == 0) {
                if (w + n >= cap) return -1;
                snprintf(out + w, (size_t)(cap - w), "%s", id);
                w += n;
                snprintf(last, sizeof last, "%s", id);
                continue;
            }
            vi = self->sym->find_var(id);
            /* M4: a bare name two imports spell differently has no single C
               spelling, so emitting it verbatim only moves the failure to `cc`.
               Diagnose it here instead. */
            if (vi >= 0 && self->sym->vars[vi].ambiguous) {
                snprintf(msg, sizeof msg,
                         "global '%s' is declared by more than one import and"
                         " cannot be named in a static initializer", id);
                return self->fail(msg);
            }
            if (vi >= 0 && strcmp(self->sym->vars[vi].cname, id) != 0) {
                snprintf(out + w, (size_t)(cap - w), "%s", self->sym->vars[vi].cname);
                w += (int)strlen(self->sym->vars[vi].cname);
                snprintf(last, sizeof last, "%s", id);
                continue;
            }
            /* M4: a function used as a value (`&handler`) needs the mangling its
               declaration gets. One C spelling replaces the name; two
               namespaces exporting it is an ambiguity, not a silent pick. */
            fn_hits = 0;
            fn_bad = 0;
            fn_cn[0] = 0;
            for (fi = 0; fi < self->sym->nfunc; fi++) {
                if (strcmp(self->sym->funcs[fi].name, id) != 0) continue;
                if (fn_hits == 0)
                    snprintf(fn_cn, sizeof fn_cn, "%s", self->sym->funcs[fi].cname);
                else if (strcmp(fn_cn, self->sym->funcs[fi].cname) != 0)
                    fn_bad = 1;
                fn_hits++;
            }
            if (fn_bad) {
                snprintf(msg, sizeof msg,
                         "function '%s' is declared by more than one namespace and"
                         " cannot be named in a static initializer", id);
                return self->fail(msg);
            }
            if (fn_hits > 0 && strcmp(fn_cn, id) != 0) {
                snprintf(out + w, (size_t)(cap - w), "%s", fn_cn);
                w += (int)strlen(fn_cn);
            } else {
                if (w + n >= cap) return -1;
                snprintf(out + w, (size_t)(cap - w), "%s", id);
                w += n;
            }
            snprintf(last, sizeof last, "%s", id);
        }
        if (w >= cap) return -1;
        out[w] = 0;
        return 0;
    }
}

/* The instance lives after the impl: its vptr initialisers need the vtable
   forward declaration the emitter places with each impl. */
static struct TypeCheck g_type;

struct TypeCheck *type_get(void)
{
    return &g_type;
}
