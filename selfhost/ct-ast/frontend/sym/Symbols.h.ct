/*
 * Symbols.h.ct - the symbol tables of one translation unit, one class of its own.
 *
 * The tables and the lookups over them (functions, variables and their scopes,
 * type tags, traits and structs, plus the namespace prefix and the parser's
 * impl/return context) are a property of the unit being compiled, not of the
 * parser. Keeping them here lets the driver hold a pointer to the singleton and
 * keep its own position-carrying failures while this unit reports the bare
 * message.
 *
 * Macros do not cross a unit boundary, so this unit declares the symbol-table
 * caps; a unit that reads one of them mirrors the value listed here (MAX_TEXT
 * 160, MAX_PARAMS 16, MAX_FUNCS 256, MAX_VARS 4096, MAX_SCOPE 256, MAX_TYPES
 * 256, MAX_METHODS 64, MAX_TRAITS 64, MAX_STRUCTS 128, MAX_FIELDS 64). The
 * array lengths are spelled out as literals because a `pub struct` lands in the
 * generated header, which carries no macros.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

/* Contract-tested caps (TEST-9): check-ast.sh generates one overflow fixture for
   MAX_PARAMS, MAX_METHODS, MAX_FUNCS, MAX_SCOPE, MAX_VARS, MAX_FIELDS and
   MAX_STRUCTS (MAX_MAPS and MAX_ERRORS are covered in its map and recovery
   sections). The rest are reachable but stay unfixtured on purpose: each case
   costs a generator plus a text contract, and the return has flattened. Pin one
   only when that cap is about to change. */
#define MAX_TEXT    160
#define MAX_PARAMS  16
#define MAX_FUNCS   256
#define MAX_VARS    4096
#define MAX_SCOPE   256
#define MAX_TYPES   256
#define MAX_METHODS 64
#define MAX_TRAITS  64
#define MAX_STRUCTS 128
#define MAX_FIELDS  64
#define MAX_TYPE_ALIASES 64
#define MAX_GLOBAL_TYPE_ALIASES 256
#define MAX_ALIAS_CHAIN 32
#define MAX_CLOSURES 64

namespace frontend::sym;
/* A compile-time synonym for a type spelling. It never reaches the generated C;
   `target` is the canonical spelling the type parser would have emitted for the
   alias. `forward` marks a declaration found by the pre-scan but not parsed yet;
   `resolving` marks the one currently being parsed, so a self reference is a
   cycle instead of an empty expansion. */
pub struct TypeAlias {
    char name[160];
    char target[160];
    char path[1024];
    int  line;
    int  is_pub;
    int  owner;         /* unit index; -1 outside `build` */
    int  forward;
    int  resolving;
}

pub trait TypeAliasOps {
    int find_type_alias(const char *name);
    int begin_type_alias(const char *name, const char *path, int line, int is_pub, int owner);
    int finish_type_alias(const char *target);
    void abort_type_alias(void);
    int add_forward_type_alias(const char *name, const char *path, int line, int owner);
    int add_visible_type_alias(const char *name, const char *target, const char *path,
                               int line, int owner);
    int find_global_type_alias(const char *name, char *path, int cap, int *line);
    int expand_type_alias(const char *name, char *out, int cap);
    int expand_type_text(const char *text, char *out, int cap);
    int resolve_exported_type_aliases(int owner);
}

pub struct Fn {
    char name[160];
    /* the C spelling: a `pub` function inside a namespace is mangled with its
       prefix, a static helper keeps the plain name */
    char cname[160];
    char ret[160];
    char ptype[16][160];
    /* array dims are kept apart from the type: the prototype must spell them
       (`int f(Expr a[])` vs `int f(Expr a)` are conflicting types), while the
       call side still compares bare types for boxing */
    char pdim[16][160];
    int  nparams;
    int  is_static;
    int  is_pub;
    int  variadic;      /* `int f(int n, ...)`: the prototype needs the `...` */
    int  line;
    int  ret_owned;     /* 1 when it may hand back an allocation it owns (10.3) */
    /* A GNU `__attribute__((…))` on the declaration: -1 when it carried none,
       otherwise the offset of its captured spelling in the string pool. The
       prototype re-emits it after the parameter list (the C compiler owns the
       meaning). */
    int  attr;
}

pub struct Var {
    char name[160];
    char type[160];
    /* an array's declared type carries no star of its own, but `T *a[N]` and
       `T *p` spell the same type; indexing tells them apart only through this */
    int  is_array;
    /* leak tracking (10.3), mirroring L2's conservative rules */
    int  st;            /* struct index when the type is `struct T *`, else -1 */
    int  owned;         /* 1 when a heap object (malloc/calloc/owned callee) */
    int  own_line;      /* source line of that allocation */
    int  autodrop;      /* 1 when declared `own`: release at scope exit */
    int  path_warned;   /* 1 once reported as possibly leaking on a return path */
    /* `borrow`: the pointer is lent, not owned. `borrowed` refuses `delete` on
       it and storing it somewhere that outlives the borrow; `is_param` keeps a
       parameter (whose lifetime the caller owns) apart from a local
       declaration, which a `return` may hand back (D5). */
    int  borrowed;
    int  is_param;
    /* A namespaced global is emitted under a mangled C name, so `cname` carries
       that spelling (equal to `name` for a local or a root global). `ns` holds
       the declaring namespace in underscore form (`a_b`), which is what a
       qualified reference (`a::b::h`) is matched against. `extern` globals keep
       their C name and an empty `ns`: the library owns the symbol. */
    char cname[160];
    char ns[160];
    int  is_global;     /* file-scope: the mangling / qualification rules apply */
    int  is_static;     /* a block-scope `static`: its lifetime outlives the block */
    int  imported;      /* copied in from an imported unit's export */
    int  ambiguous;     /* a bare reference cannot pick between two imports */
    /* An enum member is emitted as a C enumerator and behaves like a constant
       in an expression, so it sits in this table under a masked type (`int`) and
       this flag tells the constant-expression check it may be folded (5.0). */
    int  is_const;
    /* A closure variable (Phase 21 S2): the name is a binding for the
       (trampoline, env) pair, not a value. `closure_id` indexes
       `Symbols.closures` and stays -1 on a plain variable. */
    int  is_closure;
    int  closure_id;
}

/* One non-escaping closure literal. The parser fills this table; the emitter
   reads it in S3. Parameter and capture lists are copied by value because the
   `Var` rows they came from die when the enclosing scope is popped. */
pub struct Closure {
    char owner[160];            /* enclosing function's C name, empty at file scope */
    char ret[160];              /* return type from the host function pointer */
    char ptype[16][160];        /* the literal's parameter types, as written */
    char pname[16][160];        /* their names, for S3's trampoline */
    int  nparams;
    int  body;                  /* expression node index, or an N_BLOCK */
    int  is_block;              /* 1 when the body is `=> { … }` (S5) */
    int  ncap;
    char cap_name[16][160];
    char cap_type[16][160];
    int  line;
    int  col;
}

pub struct MethodSig {
    char name[160];
    char ret[160];
    char ptype[16][160];
    int  nparams;
    /* A `.m.ct` trait has no vtable slot, so its signature may end in `...`:
       the map recipe forwards the rest of the call verbatim. A real trait keeps
       this 0 -- its vtable slot is a fixed function-pointer type (batch 13). */
    int  variadic;
    /* A default body (`{ … }` after the signature): the N_BLOCK's index and
       the N_PARAM chain that names its parameters. Both are -1 for an abstract
       method, whose body the adopting impl must write. `line` is where the
       signature was declared, which is what an expansion failure points at. */
    int  body;
    int  pnode;
    int  line;
}

pub struct Trait {
    char name[160];
    struct MethodSig m[64];
    int  nm;
    int  is_pub;
    int  is_static;             /* declared in a `.m.ct` unit: no iface, no vtable */
    int  line;
    /* the declaring unit's path, for the D-7 expansion diagnostic */
    char path[160];
    /* the declaring namespace in underscore form, for a static namespace host */
    char ns[160];
}

pub struct Field {
    char name[160];
    char type[160];
    /* array dims (`[2]`, `[N]`): a designated initialiser cannot reach an
       element, so such a field's vptrs are written by a loop instead */
    char dims[160];
}

pub struct StructDef {
    char name[160];
    char use[64][160];
    int  nuse;
    /* field types: a receiver chain (`s.owner.greet()`) needs them, and so does
       the nested vptr initialiser of a struct-typed field */
    struct Field fields[64];
    int  nfields;
    int  defined;               /* a body was parsed; a forward declaration is not */
    int  uses_drop;             /* built-in `Drop`: no vptr, no vtable, `delete` calls it */
    int  uses_handback;         /* built-in `Handback`: no vptr, no vtable, `borrow` calls it */
    int  has_handback_impl;     /* this unit parsed `impl Handback for S` */
}

pub trait SymbolOps {
    int  declare_var(const char *name, const char *type);
    int  declare_global(const char *name, const char *type, const char *cname,
                        const char *ns, int imported);
    /* An enum member: a file-scope `int` the source may not assign to. */
    int  declare_const(const char *name, const char *cname, const char *ns, int imported);
    int  is_const_name(const char *name);
    int  var_cname(const char *name, char *out, int cap);
    int  var_ambiguous(const char *name);
    int  find_qualified_global(const char *qual, const char *name, char *cname, int cap);
    int  find_var(const char *name);
    int  var_type(const char *name, char *out, int cap);
    int  find_func(const char *cname);
    /* The row a plain call names: the unit's own namespace first, then the
       root. Fails when the name is exported only from another namespace, which
       an unqualified call cannot reach. */
    int  resolve_func(const char *name);
    int  find_type(const char *name);
    int  add_type(const char *name, int kind);
    int  add_bare_type(const char *name, const char *full);
    int  find_struct(const char *name);
    int  add_struct(const char *name);
    int  find_trait(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, int tcap);
    int  method_trait_amb(const char *stype, const char *method, const char *first,
                          char *other, int ocap);
    int  ns_decl_name(const char *name, char *out, int cap);
    int  resolve_type(const char *name, char *out, int cap);
    int  add_alias(const char *name, const char *full);
    int  push_scope(void);
    int  pop_scope(void);
    /* A fresh closure row; the parser fills in parameters, captures and body. */
    int  closure_new(const char *owner);
    /* The unit a capacity message names: the basename of `path`, or
       "this unit" before the driver binds one. */
    const char *unit_name(void);
    /* R10: `__ct_` names the compiler's own products. Every declaration category
       (local / parameter / global / type / field / function) shares this one
       predicate; the callers report the bare message. */
    int  reserved_name(const char *name);
    int  fail(const char *msg);
    const char *last_error(void);
}

pub struct Symbols {
    /* The four big tables are heap blocks allocated in `symbols_get` (SH-42):
       as inline arrays in the file-scope instance they put ~21 MB of zeroes
       into __DATA. Their caps stay literal, mirroring the MAX_* values above. */
    struct Fn   *funcs;
    int  nfunc;
    struct Var  *vars;
    int  nvar;
    int  scope[256];
    int  nscope;
    char types[256][160];
    int  type_kind[256];        /* 1 = struct tag, 2 = typedef, 3 = trait, 4 = function-pointer typedef,
                                   5 = enum tag, 6 = union tag */
    int  ntype;
    struct Trait *traits;
    int  ntraits;
    struct StructDef *structs;
    int  nstructs;
    struct Closure *closures;
    int  nclosure;
    /* An exported type declared in a namespace is also reachable by its bare
       name, so a consumer need not alias-import it. A second unit exporting the
       same bare name from another namespace marks it ambiguous: the alias
       import remains the escape hatch. */
    char tbare[128][160];       /* the name the source wrote */
    char tfull[128][160];       /* its qualified C name (`hal_Writer`) */
    int  tbambig[128];
    int  ntb;
    char ns[160];               /* current namespace prefix, set by the module layer */
    /* The input the table is filling, kept in step with `mem->path` by the
       driver and the module layer. The capacity messages name it: a generated
       file with hundreds of declarations otherwise leaves the reader hunting
       for the unit that overflowed (SH-53). */
    const char *path;
    /* `import a::b::C as D;` brings one exported name in under `D` for this unit
       only (the table resets per unit); `alias_full` is the mangled C name. */
    char alias_name[16][160];
    char alias_full[16][160];
    int  nalias;
    /* Type aliases (`pub type X = T;`): a per-unit visible table plus a global
       registry of every declaration loaded in this build. The global half is
       what lets `parse_type` say "declared in ... but not imported" instead of
       treating the name as an opaque C type. Both blocks are heap allocated. */
    struct TypeAlias *taliases;
    int  ntalias;
    char tachain[32][160];      /* MAX_ALIAS_CHAIN, spelled out for the header */
    int  ntachain;
    struct TypeAlias *gtaliases;
    int  ngtalias;
    /* 1 while `parse_type` reads the right-hand side of a `type` declaration.
       A forward reference there is deferred as raw text (so alias cycles and
       legal forward targets stay one mechanism); outside it, a forward row is
       a use before the declaration and is reported. */
    int  alias_decl;
    int  self_mode;             /* inside an impl body: `self` -> `_self` */
    char ret_type[160];         /* return type of the function being parsed */
    /* Inside a trait method's default body: the trait `self->m(...)` dispatches
       through. Empty everywhere else. The adopting struct is unknown at parse
       time, so the receiver resolves to the enclosing trait by construction. */
    char trait_default[160];
    char errmsg[160];           /* the bare message `fail` recorded; Ast adds the position */
} use SymbolOps, TypeAliasOps;

pub struct Symbols *symbols_get(void);

impl SymbolOps for Symbols {
    /* The tables report the bare reason; the position belongs to the parser
       object, which wraps this message with the current line and token. */
    int fail(const char *msg)
    {
        (void)self;
        snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
        return -1;
    }

    const char *last_error(void)
    {
        (void)self;
        return self->errmsg;
    }

    /* R10: `__ct_` names the compiler's own products. The check used to guard
       only locals and parameters; every declaration category shares this one
       predicate now, so a global, function, type or field cannot collide with
       the generated C either. */
    int reserved_name(const char *name)
    {
        (void)self;
        return name && !strncmp(name, "__ct_", 5);
    }

    /* Only the last path component: the diagnostic already prints the full
       path as its prefix, and a basename keeps the message inside the 160-byte
       buffer that carries it. */
    const char *unit_name(void)
    {
        const char *slash;
        (void)self;
        if (!self->path || !self->path[0]) return "this unit";
        slash = strrchr(self->path, '/');
        return slash ? slash + 1 : self->path;
    }

    int push_scope(void)
    {
        (void)self;
        if (self->nscope >= MAX_SCOPE) return self->fail("too many nested scopes");
        self->scope[self->nscope] = self->nvar;
        self->nscope++;
        return 0;
    }

    int pop_scope(void)
    {
        (void)self;
        if (self->nscope <= 0) return self->fail("scope stack underflow");
        self->nscope--;
        self->nvar = self->scope[self->nscope];
        return 0;
    }

    int closure_new(const char *owner)
    {
        struct Closure *c;
        char msg[MAX_TEXT];
        (void)self;
        if (self->nclosure >= MAX_CLOSURES) {
            snprintf(msg, sizeof msg, "too many closures in unit '%s' (limit %d)",
                     self->unit_name(), MAX_CLOSURES);
            return self->fail(msg);
        }
        c = &self->closures[self->nclosure];
        snprintf(c->owner, MAX_TEXT, "%s", owner ? owner : "");
        c->ret[0] = 0;
        c->nparams = 0;
        c->body = -1;
        c->is_block = 0;
        c->ncap = 0;
        c->line = 0;
        c->col = 0;
        return self->nclosure++;
    }

    int declare_var(const char *name, const char *type)
    {
        int i;
        char msg[MAX_TEXT];
        (void)self;
        /* `__ct_` names the compiler's own locals and closure products; a user
           declaration could otherwise collide with them in the generated C. */
        if (self->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        if (self->nvar >= MAX_VARS) {
            snprintf(msg, sizeof msg, "too many variables in unit '%s' (limit %d)",
                     self->unit_name(), MAX_VARS);
            return self->fail(msg);
        }
        i = self->nvar;
        snprintf(self->vars[i].name, MAX_TEXT, "%s", name);
        snprintf(self->vars[i].type, MAX_TEXT, "%s", type);
        snprintf(self->vars[i].cname, MAX_TEXT, "%s", name);
        self->vars[i].ns[0] = 0;
        self->vars[i].is_global = 0;
        self->vars[i].is_static = 0;
        self->vars[i].imported = 0;
        self->vars[i].ambiguous = 0;
        self->vars[i].is_array = 0;
        self->vars[i].st = -1;
        self->vars[i].owned = 0;
        self->vars[i].own_line = 0;
        self->vars[i].autodrop = 0;
        self->vars[i].path_warned = 0;
        self->vars[i].borrowed = 0;
        self->vars[i].is_param = 0;
        self->vars[i].is_const = 0;
        self->vars[i].is_closure = 0;
        self->vars[i].closure_id = -1;
        self->nvar++;
        return 0;
    }

    /* A file-scope variable. `cname` is the C spelling to emit and `ns` the
       declaring namespace in underscore form (empty at the root, and for an
       `extern` declaration whose symbol belongs to a C library). Two imported
       units exporting the same source name make the bare name ambiguous; a
       declaration later in this unit shadows them instead. */
    int declare_global(const char *name, const char *type, const char *cname,
                       const char *ns, int imported)
    {
        int i, k;
        char msg[MAX_TEXT];
        (void)self;
        if (self->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        if (self->nvar >= MAX_VARS) {
            snprintf(msg, sizeof msg, "too many variables in unit '%s' (limit %d)",
                     self->unit_name(), MAX_VARS);
            return self->fail(msg);
        }
        i = self->nvar;
        self->nvar++;
        snprintf(self->vars[i].name, MAX_TEXT, "%s", name);
        snprintf(self->vars[i].type, MAX_TEXT, "%s", type);
        snprintf(self->vars[i].cname, MAX_TEXT, "%s", cname);
        snprintf(self->vars[i].ns, MAX_TEXT, "%s", ns);
        self->vars[i].is_global = 1;
        self->vars[i].is_static = 0;
        self->vars[i].imported = imported;
        self->vars[i].ambiguous = 0;
        self->vars[i].is_array = 0;
        self->vars[i].st = -1;
        self->vars[i].owned = 0;
        self->vars[i].own_line = 0;
        self->vars[i].autodrop = 0;
        self->vars[i].path_warned = 0;
        self->vars[i].borrowed = 0;
        self->vars[i].is_param = 0;
        self->vars[i].is_const = 0;
        if (imported)
            for (k = 0; k < i; k++)
                if (self->vars[k].is_global && self->vars[k].imported
                    && strcmp(self->vars[k].name, name) == 0
                    && strcmp(self->vars[k].cname, cname) != 0) {
                    self->vars[k].ambiguous = 1;
                    self->vars[i].ambiguous = 1;
                }
        return i;
    }

    /* An enum member: the type the expression grammar expects is `int`, and
       `is_const` lets the constant-expression check fold it. */
    int declare_const(const char *name, const char *cname, const char *ns, int imported)
    {
        int i;
        (void)self;
        i = self->declare_global(name, "int", cname, ns, imported);
        if (i < 0) return -1;
        self->vars[i].is_const = 1;
        return i;
    }

    int is_const_name(const char *name)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        return (i >= 0) ? self->vars[i].is_const : 0;
    }

    int var_cname(const char *name, char *out, int cap)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        if (i < 0) return -1;
        return (snprintf(out, (size_t)cap, "%s", self->vars[i].cname) >= cap) ? -1 : 0;
    }

    int var_ambiguous(const char *name)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        return (i >= 0) ? self->vars[i].ambiguous : 0;
    }

    /* `A::B::h` in an expression: match the path (underscore form, no trailing
       separator) against the namespace a global was declared in. */
    int find_qualified_global(const char *qual, const char *name, char *cname, int cap)
    {
        int i;
        (void)self;
        for (i = self->nvar - 1; i >= 0; i--)
            if (self->vars[i].is_global && strcmp(self->vars[i].name, name) == 0
                && strcmp(self->vars[i].ns, qual) == 0) {
                if (snprintf(cname, (size_t)cap, "%s", self->vars[i].cname) >= cap) return -1;
                return 0;
            }
        return -1;
    }

    int find_var(const char *name)
    {
        int i;
        (void)self;
        for (i = self->nvar - 1; i >= 0; i--)
            if (strcmp(self->vars[i].name, name) == 0) return i;
        return -1;
    }

    int var_type(const char *name, char *out, int cap)
    {
        int i, w;
        (void)self;
        i = self->find_var(name);
        if (i < 0) return -1;
        w = snprintf(out, (size_t)cap, "%s", self->vars[i].type);
        if (w < 0 || w >= cap) return -1;
        return 0;
    }

    /* Rows are keyed by the C spelling, not by the source name: two namespaces
       may each export a `get`, and the mangled names keep them apart. */
    int find_func(const char *cname)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nfunc; i++)
            if (strcmp(self->funcs[i].cname, cname) == 0) return i;
        return -1;
    }

    /* A plain call names the enclosing namespace first, then the root. Reaching
       into another namespace takes a qualified call (`a::f`, `Type::f`), so a
       bare name that only matches rows elsewhere is refused -- and two rows
       sharing the name is the ambiguity the qualification exists to settle. */
    int resolve_func(const char *name)
    {
        char full[160];
        int i, hits;
        (void)self;

        if (self->ns[0] && snprintf(full, sizeof full, "%s%s", self->ns, name) < (int)sizeof full) {
            i = self->find_func(full);
            if (i >= 0) return i;
        }
        i = self->find_func(name);
        if (i >= 0) return i;
        hits = 0;
        for (i = 0; i < self->nfunc; i++)
            if (strcmp(self->funcs[i].name, name) == 0) hits++;
        if (hits > 1)
            return self->fail("that function is exported by more than one namespace");
        if (hits == 1)
            return self->fail("that function lives in another namespace and needs a qualified call");
        return -1;
    }

    int find_type(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->ntype; i++)
            if (strcmp(self->types[i], name) == 0) return i;
        return -1;
    }

    int add_type(const char *name, int kind)
    {
        int i;
        (void)self;
        if (self->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        i = self->find_type(name);
        if (i >= 0) {
            /* a struct tag discovered while parsing a type keeps its kind */
            if (self->type_kind[i] == 0) self->type_kind[i] = kind;
            return 0;
        }
        /* A finished alias already owns this spelling; the two would disagree
           about what the name means, so the later declaration is the error. A
           forward row is only the pre-scan's placeholder and does not clash. */
        i = self->find_type_alias(name);
        if (i < 0 && self->ns[0]) {
            size_t nl = strlen(self->ns);
            if (strncmp(name, self->ns, nl) == 0)
                i = self->find_type_alias(name + nl);
        }
        if (i >= 0 && !self->taliases[i].forward) {
            char msg[512];
            snprintf(msg, sizeof msg, "type '%s' conflicts with an existing type alias", name);
            return self->fail(msg);
        }
        if (self->ntype >= MAX_TYPES) return self->fail("too many types");
        snprintf(self->types[self->ntype], MAX_TEXT, "%s", name);
        self->type_kind[self->ntype] = kind;
        self->ntype++;
        return 0;
    }

    int find_struct(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nstructs; i++)
            if (strcmp(self->structs[i].name, name) == 0) return i;
        return -1;
    }

    int add_struct(const char *name)
    {
        int i;
        (void)self;
        if (!name[0]) return -1;
        i = self->find_struct(name);
        if (i >= 0) return i;
        if (self->nstructs >= MAX_STRUCTS) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "too many structs in unit '%s' (limit %d)",
                     self->unit_name(), MAX_STRUCTS);
            return self->fail(msg);
        }
        snprintf(self->structs[self->nstructs].name, MAX_TEXT, "%s", name);
        self->structs[self->nstructs].nuse = 0;
        self->structs[self->nstructs].uses_drop = 0;
        self->structs[self->nstructs].uses_handback = 0;
        self->structs[self->nstructs].has_handback_impl = 0;
        self->nstructs++;
        return self->nstructs - 1;
    }

    int find_trait(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->ntraits; i++)
            if (strcmp(self->traits[i].name, name) == 0) return i;
        return -1;
    }

    int add_trait(const char *name)
    {
        int i;
        (void)self;
        i = self->find_trait(name);
        if (i >= 0) return i;
        if (self->ntraits >= MAX_TRAITS) return self->fail("too many traits");
        snprintf(self->traits[self->ntraits].name, MAX_TEXT, "%s", name);
        self->traits[self->ntraits].nm = 0;
        self->ntraits++;
        return self->ntraits - 1;
    }

    /* Which trait of `stype` declares `method`: the vtable field name and the
       dispatch target both need it. `stype` may carry a `struct ` prefix or a
       trailing `*` (a pointer receiver). */
    int method_trait(const char *stype, const char *method, char *tout, int tcap)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        int s, ti, mi, w;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", stype) >= (int)sizeof buf) return -1;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            base[n - 1] = 0;
            n--;
        }
        s = self->find_struct(base);
        if (s < 0) return -1;
        for (ti = 0; ti < self->structs[s].nuse; ti++) {
            int t = self->find_trait(self->structs[s].use[ti]);
            if (t < 0) continue;
            for (mi = 0; mi < self->traits[t].nm; mi++) {
                if (strcmp(self->traits[t].m[mi].name, method) == 0) {
                    w = snprintf(tout, (size_t)tcap, "%s", self->traits[t].name);
                    if (w < 0 || w >= tcap) return -1;
                    return 0;
                }
            }
        }
        return -1;
    }

    /* SH-46 (19.3): `method_trait` answers with the first match in `use`
       order, and a bare call keeps that resolution (the spec pins it). This
       companion answers whether a *different* trait of the same struct also
       declares `method` -- the call is then ambiguous and the caller names
       both traits in a warning. `first` is the trait `method_trait` already
       named; the same struct `use`ing one trait twice is not ambiguous. */
    int method_trait_amb(const char *stype, const char *method, const char *first,
                         char *other, int ocap)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        int s, ti, mi, w;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", stype) >= (int)sizeof buf) return -1;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            base[n - 1] = 0;
            n--;
        }
        s = self->find_struct(base);
        if (s < 0) return -1;
        for (ti = 0; ti < self->structs[s].nuse; ti++) {
            int t = self->find_trait(self->structs[s].use[ti]);
            if (t < 0) continue;
            if (strcmp(self->traits[t].name, first) == 0) continue;
            for (mi = 0; mi < self->traits[t].nm; mi++) {
                if (strcmp(self->traits[t].m[mi].name, method) == 0) {
                    w = snprintf(other, (size_t)ocap, "%s", self->traits[t].name);
                    if (w < 0 || w >= ocap) return -1;
                    return 0;
                }
            }
        }
        return -1;
    }

    /* A declaration inside `namespace A::B` is stored under its C name,
       `A_B_<name>`; the top level adds no prefix. */
    int ns_decl_name(const char *name, char *out, int cap)
    {
        int w;
        (void)self;
        w = snprintf(out, (size_t)cap, "%s%s", self->ns, name);
        if (w < 0 || w >= cap) return self->fail("name is too long");
        return 0;
    }

    /* Register one `import ... as ...` alias for the current unit. A second
       import that binds the same alias to a different name is ambiguous, so it
       is an error rather than a silent override. */
    int add_alias(const char *name, const char *full)
    {
        int i;
        (void)self;

        for (i = 0; i < self->nalias; i++) {
            if (strcmp(self->alias_name[i], name) != 0) continue;
            if (strcmp(self->alias_full[i], full) == 0) return 0;
            return self->fail("one alias names two imports");
        }
        if (self->nalias >= 16) return self->fail("too many import aliases");
        snprintf(self->alias_name[self->nalias], sizeof self->alias_name[0], "%s", name);
        snprintf(self->alias_full[self->nalias], sizeof self->alias_full[0], "%s", full);
        self->nalias++;
        return 0;
    }

    /* Record a namespace-qualified export under its bare name. Repeating the
       same pair is a no-op (a forward declaration may precede the body); the
       same bare name pointing at two different C names is ambiguous. */
    int add_bare_type(const char *name, const char *full)
    {
        int i;
        (void)self;

        for (i = 0; i < self->ntb; i++) {
            if (strcmp(self->tbare[i], name) != 0) continue;
            if (strcmp(self->tfull[i], full) == 0) return 0;
            self->tbambig[i] = 1;
            return 0;
        }
        if (self->ntb >= 128) return self->fail("too many exported type names");
        snprintf(self->tbare[self->ntb], MAX_TEXT, "%s", name);
        snprintf(self->tfull[self->ntb], MAX_TEXT, "%s", full);
        self->tbambig[self->ntb] = 0;
        self->ntb++;
        return 0;
    }

    /* Unqualified lookup: an explicit import alias first, then the current
       namespace, then the top level. */
    int resolve_type(const char *name, char *out, int cap)
    {
        char qname[MAX_TEXT];
        int w, i;
        (void)self;

        for (i = 0; i < self->nalias; i++) {
            if (strcmp(self->alias_name[i], name) != 0) continue;
            w = snprintf(out, (size_t)cap, "%s", self->alias_full[i]);
            if (w < 0 || w >= cap) return self->fail("name is too long");
            return 0;
        }
        if (self->ns[0]) {
            w = snprintf(qname, sizeof qname, "%s%s", self->ns, name);
            if (w < 0 || w >= (int)sizeof qname) return self->fail("name is too long");
            if (self->find_type(qname) >= 0 || self->find_trait(qname) >= 0
                || self->find_struct(qname) >= 0) {
                w = snprintf(out, (size_t)cap, "%s", qname);
                if (w < 0 || w >= cap) return self->fail("name is too long");
                return 0;
            }
        }
        /* an exported type from another namespace, reachable by its bare name */
        for (i = 0; i < self->ntb; i++) {
            if (strcmp(self->tbare[i], name) != 0) continue;
            if (self->tbambig[i])
                return self->fail("that type is exported by more than one namespace; import it as an alias");
            w = snprintf(out, (size_t)cap, "%s", self->tfull[i]);
            if (w < 0 || w >= cap) return self->fail("name is too long");
            return 0;
        }
        w = snprintf(out, (size_t)cap, "%s", name);
        if (w < 0 || w >= cap) return self->fail("name is too long");
        return 0;
    }
}

impl TypeAliasOps for Symbols {
    int find_type_alias(const char *name)
    {
        int i;
        for (i = 0; i < self->ntalias; i++)
            if (strcmp(self->taliases[i].name, name) == 0) return i;
        return -1;
    }

    /* Start a declaration: insert the row, then push its name on the expansion
       chain so a self reference is reported as a cycle rather than reading an
       empty target. A pre-scanned forward row is reused in place. */
    int begin_type_alias(const char *name, const char *path, int line, int is_pub, int owner)
    {
        int i;
        char msg[512];
        /* The pre-scan runs before any declaration is parsed, so a type that
           appears above the alias was not known then. Check it here, where the
           declaration order is finally known. */
        if (self->find_type(name) >= 0) {
            snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
            return self->fail(msg);
        }
        /* Declarations inside a namespace are stored under the mangled spelling
           (`lib_Thing`), so a trait or typedef declared above is a conflict even
           though the alias keeps its bare name. */
        if (self->ns[0]) {
            char qn[MAX_TEXT];
            int w = snprintf(qn, sizeof qn, "%s%s", self->ns, name);
            if (w >= 0 && w < (int)sizeof qn && self->find_type(qn) >= 0) {
                snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
                return self->fail(msg);
            }
        }
        i = self->find_type_alias(name);
        if (i >= 0) {
            if (self->taliases[i].owner == owner) {
                if (!self->taliases[i].forward) {
                    snprintf(msg, sizeof msg,
                             "duplicate type alias '%s' (first at %s:%d)",
                             name, self->taliases[i].path, self->taliases[i].line);
                    return self->fail(msg);
                }
                self->taliases[i].line = line;
                self->taliases[i].is_pub = is_pub;
                snprintf(self->taliases[i].path, sizeof self->taliases[i].path, "%s", path);
                self->taliases[i].forward = 0;
                self->taliases[i].resolving = 1;
                if (self->ntachain >= MAX_ALIAS_CHAIN)
                    return self->fail("type alias expansion is too deep");
                snprintf(self->tachain[self->ntachain], 160, "%s", name);
                self->ntachain++;
                return 0;
            }
            /* An imported row is just a synonym registered for this unit. A
               local declaration of the same name shadows it in place: the
               local target is what the rest of this unit sees from here on. */
            memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
            snprintf(self->taliases[i].name, sizeof self->taliases[i].name, "%s", name);
            snprintf(self->taliases[i].path, sizeof self->taliases[i].path, "%s", path);
            self->taliases[i].line = line;
            self->taliases[i].is_pub = is_pub;
            self->taliases[i].owner = owner;
            self->taliases[i].resolving = 1;
            if (self->ntachain >= MAX_ALIAS_CHAIN)
                return self->fail("type alias expansion is too deep");
            snprintf(self->tachain[self->ntachain], 160, "%s", name);
            self->ntachain++;
            return 0;
        }
        if (self->find_type(name) >= 0) {
            snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
            return self->fail(msg);
        }
        for (i = 0; i < self->nalias; i++)
            if (strcmp(self->alias_name[i], name) == 0) {
                snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
                return self->fail(msg);
            }
        if (self->ntalias >= MAX_TYPE_ALIASES)
            return self->fail("too many type aliases in this unit");
        i = self->ntalias;
        self->ntalias++;
        memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
        snprintf(self->taliases[i].name, sizeof self->taliases[i].name, "%s", name);
        snprintf(self->taliases[i].path, sizeof self->taliases[i].path, "%s", path);
        self->taliases[i].line = line;
        self->taliases[i].is_pub = is_pub;
        self->taliases[i].owner = owner;
        self->taliases[i].resolving = 1;
        if (self->ntachain >= MAX_ALIAS_CHAIN)
            return self->fail("type alias expansion is too deep");
        snprintf(self->tachain[self->ntachain], 160, "%s", name);
        self->ntachain++;
        return 0;
    }

    int finish_type_alias(const char *target)
    {
        int i, g;
        if (self->ntachain <= 0) return self->fail("internal: type alias declaration is not open");
        i = self->find_type_alias(self->tachain[self->ntachain - 1]);
        if (i < 0) return self->fail("internal: type alias declaration is not open");
        snprintf(self->taliases[i].target, sizeof self->taliases[i].target, "%s", target);
        self->taliases[i].forward = 0;
        self->taliases[i].resolving = 0;
        if (self->ngtalias >= MAX_GLOBAL_TYPE_ALIASES)
            return self->fail("too many type aliases in this build");
        g = self->ngtalias;
        self->ngtalias++;
        self->gtaliases[g] = self->taliases[i];
        self->gtaliases[g].forward = 0;
        self->gtaliases[g].resolving = 0;
        self->ntachain--;
        return 0;
    }

    void abort_type_alias(void)
    {
        if (self->ntachain > 0) self->ntachain--;
    }

    /* A name found by the module layer's top-level pre-scan. It only exists so a
       use before the declaration can say why it is not a type; the real row is
       filled by `begin_type_alias` when the parser reaches the declaration. */
    int add_forward_type_alias(const char *name, const char *path, int line, int owner)
    {
        int i;
        if (self->find_type_alias(name) >= 0) return 0;
        if (self->find_type(name) >= 0) return 0;
        if (self->ntalias >= MAX_TYPE_ALIASES)
            return self->fail("too many type aliases in this unit");
        i = self->ntalias;
        self->ntalias++;
        memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
        snprintf(self->taliases[i].name, sizeof self->taliases[i].name, "%s", name);
        snprintf(self->taliases[i].path, sizeof self->taliases[i].path, "%s", path);
        self->taliases[i].line = line;
        self->taliases[i].owner = owner;
        self->taliases[i].forward = 1;
        return 0;
    }

    /* Imported rows are already fully resolved in the declaring unit, so the
       importing unit never needs that unit's private aliases. The same name and
       target from two reachable units is one synonym; different targets are an
       ambiguity. */
    int add_visible_type_alias(const char *name, const char *target, const char *path,
                               int line, int owner)
    {
        int i;
        char msg[512];
        for (i = 0; i < self->ntalias; i++) {
            if (strcmp(self->taliases[i].name, name) != 0) continue;
            if (strcmp(self->taliases[i].target, target) == 0) return 0;
            snprintf(msg, sizeof msg,
                     "type alias '%s' is exported by both %s and %s",
                     name, self->taliases[i].path, path);
            return self->fail(msg);
        }
        if (self->find_type(name) >= 0) {
            snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
            return self->fail(msg);
        }
        for (i = 0; i < self->nalias; i++)
            if (strcmp(self->alias_name[i], name) == 0) {
                snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
                return self->fail(msg);
            }
        if (self->ntalias >= MAX_TYPE_ALIASES)
            return self->fail("too many type aliases in this unit");
        i = self->ntalias;
        self->ntalias++;
        memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
        snprintf(self->taliases[i].name, sizeof self->taliases[i].name, "%s", name);
        snprintf(self->taliases[i].target, sizeof self->taliases[i].target, "%s", target);
        snprintf(self->taliases[i].path, sizeof self->taliases[i].path, "%s", path);
        self->taliases[i].line = line;
        self->taliases[i].owner = owner;
        return 0;
    }

    int find_global_type_alias(const char *name, char *path, int cap, int *line)
    {
        int i;
        for (i = 0; i < self->ngtalias; i++) {
            if (strcmp(self->gtaliases[i].name, name) != 0) continue;
            /* a private alias of another unit is not a name this unit could
               ever import, so it stays an opaque C spelling */
            if (!self->gtaliases[i].is_pub) continue;
            snprintf(path, (size_t)cap, "%s", self->gtaliases[i].path);
            *line = self->gtaliases[i].line;
            return 0;
        }
        return -1;
    }

    /* Expand one bare name. A forward row outside a declaration is a use before
       the declaration; inside a declaration it is deferred as text, so a legal
       forward reference between aliases still resolves at the use site. */
    int expand_type_alias(const char *name, char *out, int cap)
    {
        int i, k, w;
        char msg[512];
        i = self->find_type_alias(name);
        if (i < 0) {
            w = snprintf(out, (size_t)cap, "%s", name);
            if (w < 0 || w >= cap) return self->fail("type alias is too long");
            return 0;
        }
        if (self->taliases[i].forward) {
            if (!self->alias_decl) {
                snprintf(msg, sizeof msg,
                         "type alias '%s' must be declared before it is used", name);
                return self->fail(msg);
            }
            w = snprintf(out, (size_t)cap, "%s", name);
            if (w < 0 || w >= cap) return self->fail("type alias is too long");
            return 0;
        }
        for (k = 0; k < self->ntachain; k++) {
            int m;
            if (strcmp(self->tachain[k], name) != 0) continue;
            m = snprintf(msg, sizeof msg, "type alias cycle: ");
            for (; k < self->ntachain; k++)
                m += snprintf(msg + m, sizeof msg - (size_t)m, "'%s' -> ", self->tachain[k]);
            snprintf(msg + m, sizeof msg - (size_t)m, "'%s'", name);
            return self->fail(msg);
        }
        if (self->ntachain >= MAX_ALIAS_CHAIN)
            return self->fail("type alias expansion is too deep");
        snprintf(self->tachain[self->ntachain], 160, "%s", name);
        self->ntachain++;
        if (!self->taliases[i].target[0]) {
            self->ntachain--;
            return self->fail("type alias has no target");
        }
        k = self->expand_type_text(self->taliases[i].target, out, cap);
        self->ntachain--;
        return k;
    }

    /* Replace every bare identifier that names a visible alias, except the tag
       after `struct` / `enum` / `union` (`struct Alias` is a C tag, not the
       synonym). Whitespace and punctuation are copied verbatim; the host-key
       normaliser strips the former, and the type emitter re-spaces the latter. */
    int expand_type_text(const char *text, char *out, int cap)
    {
        int i = 0, o = 0, n, after_tag = 0, w;
        char id[160], eb[160];
        while (text[i]) {
            unsigned char c = (unsigned char)text[i];
            if (isalpha(c) || c == '_') {
                n = 0;
                while (text[i] && (isalnum((unsigned char)text[i]) || text[i] == '_')) {
                    if (n < (int)sizeof(id) - 1) id[n++] = text[i];
                    i++;
                }
                id[n] = 0;
                if (after_tag) {
                    after_tag = 0;
                    w = snprintf(out + o, (size_t)(cap - o), "%s", id);
                    if (w < 0 || o + w >= cap) return self->fail("type alias is too long");
                    o += w;
                } else if (strcmp(id, "struct") == 0 || strcmp(id, "enum") == 0
                           || strcmp(id, "union") == 0) {
                    after_tag = 1;
                    w = snprintf(out + o, (size_t)(cap - o), "%s", id);
                    if (w < 0 || o + w >= cap) return self->fail("type alias is too long");
                    o += w;
                } else {
                    if (self->expand_type_alias(id, eb, sizeof eb) != 0) return -1;
                    w = snprintf(out + o, (size_t)(cap - o), "%s", eb);
                    if (w < 0 || o + w >= cap) return self->fail("type alias is too long");
                    o += w;
                }
                continue;
            }
            if (o + 1 >= cap) return self->fail("type alias is too long");
            out[o++] = text[i++];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') after_tag = 0;
        }
        out[o] = 0;
        return 0;
    }

    /* At the end of a unit every local alias exists, so its exported target can
       be written out in terms of the underlying spelling. An importer then sees
       a self-contained row and never depends on this unit's private names. */
    int resolve_exported_type_aliases(int owner)
    {
        int i, k;
        char out[160];
        for (i = 0; i < self->ngtalias; i++) {
            if (self->gtaliases[i].owner != owner) continue;
            if (self->expand_type_text(self->gtaliases[i].target, out, sizeof out) != 0)
                return -1;
            snprintf(self->gtaliases[i].target, sizeof self->gtaliases[i].target, "%s", out);
        }
        for (i = 0; i < self->ntalias; i++) {
            if (self->taliases[i].owner != owner) continue;
            if (self->expand_type_text(self->taliases[i].target, out, sizeof out) != 0)
                return -1;
            k = snprintf(self->taliases[i].target, sizeof self->taliases[i].target, "%s", out);
            if (k < 0 || k >= (int)sizeof self->taliases[i].target)
                return self->fail("type alias is too long");
        }
        return 0;
    }
}

/* The instance lives after the impl: its vptr initialiser needs the vtable
   forward declaration the emitter places with the impl. */
static struct Symbols g_symbols;

/* Give the four big tables their backing store. calloc keeps the zero-filled
   semantics the static arrays had, and it runs before any writer -- the parser
   appends to `funcs` directly -- so no access can meet a NULL table. */
static int symbols_grow(struct Symbols *self)
{
    if (!self->funcs) {
        self->funcs = calloc(MAX_FUNCS, sizeof(*self->funcs));
        if (!self->funcs) return -1;
    }
    if (!self->vars) {
        self->vars = calloc(MAX_VARS, sizeof(*self->vars));
        if (!self->vars) return -1;
    }
    if (!self->traits) {
        self->traits = calloc(MAX_TRAITS, sizeof(*self->traits));
        if (!self->traits) return -1;
    }
    if (!self->structs) {
        self->structs = calloc(MAX_STRUCTS, sizeof(*self->structs));
        if (!self->structs) return -1;
    }
    if (!self->closures) {
        self->closures = calloc(MAX_CLOSURES, sizeof(*self->closures));
        if (!self->closures) return -1;
    }
    if (!self->taliases) {
        self->taliases = calloc(MAX_TYPE_ALIASES, sizeof(*self->taliases));
        if (!self->taliases) return -1;
    }
    if (!self->gtaliases) {
        self->gtaliases = calloc(MAX_GLOBAL_TYPE_ALIASES, sizeof(*self->gtaliases));
        if (!self->gtaliases) return -1;
    }
    return 0;
}

struct Symbols *symbols_get(void)
{
    if (symbols_grow(&g_symbols) != 0) {
        fprintf(stderr, "ctc: out of memory\n");
        exit(1);
    }
    return &g_symbols;
}
