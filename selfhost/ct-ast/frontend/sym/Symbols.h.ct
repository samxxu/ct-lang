/*
 * Symbols.h.ct - the symbol tables of one translation unit, one class of its own.
 *
 * The tables and the lookups over them (functions, variables and their scopes,
 * type tags, traits and structs, plus the namespace prefix and the parser's
 * impl/return context) are a property of the unit being compiled, not of the
 * parser. Keeping them here lets the driver hold a pointer to the singleton and
 * keep its own position-carrying failures while this unit reports the bare
 * message.
 *
 * Macros do not cross a unit boundary, so this unit declares the symbol-table
 * caps; a unit that reads one of them mirrors the value listed here (MAX_TEXT
 * 160, MAX_PARAMS 16, MAX_FUNCS 512, MAX_VARS 4096, MAX_SCOPE 256, MAX_TYPES
 * 256, MAX_METHODS 64, MAX_TRAITS 64, MAX_STRUCTS 128, MAX_FIELDS 64). The
 * array lengths are spelled out as literals because a `pub struct` lands in the
 * generated header, which carries no macros.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
import frontend::sym::SymbolsTypeText;
import runtime::text::Intern;
import tool::sh::Sh;

/* Contract-tested caps (TEST-9): check-ast.sh generates one overflow fixture for
   MAX_PARAMS, MAX_METHODS, MAX_FUNCS, MAX_SCOPE, MAX_VARS, MAX_FIELDS and
   MAX_STRUCTS (MAX_MAPS and MAX_ERRORS are covered in its map and recovery
   sections). The rest are reachable but stay unfixtured on purpose: each case
   costs a generator plus a text contract, and the return has flattened. Pin one
   only when that cap is about to change. */
/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT    160
#define MAX_PARAMS  16
#define MAX_PARAMS_MAX 65536
/* Whole-program budget: `nfunc` accumulates across every unit in one build
   (build mode shares one symbol table), so this is one cap for the entire
   program, not a per-unit allowance. The table itself is MAX_FUNCS + 64 rows.
   Raised 256 -> 512 when ct-ast hit the 256 ceiling exactly (Phase 54 S0). */
#define MAX_FUNCS   512
#define MAX_FUNCS_MAX 65536
#define MAX_IMPORT_ALIASES 24
#define MAX_IMPORT_ALIASES_MAX 65536
#define MAX_VARS    4096
#define MAX_VARS_MAX 65536
#define MAX_SCOPE   256
#define MAX_SCOPE_MAX 65536
#define MAX_TYPES   256
#define MAX_TYPES_MAX 65536
#define MAX_METHODS 64
#define MAX_METHODS_MAX 65536
#define MAX_TRAITS  64
#define MAX_TRAITS_MAX 65536
#define MAX_STRUCTS 128
#define MAX_STRUCTS_MAX 65536
#define MAX_EXPORTED_TYPES 128
#define MAX_EXPORTED_TYPES_MAX 65536
#define MAX_FIELDS  64
#define MAX_FIELDS_MAX 65536
#define MAX_TYPE_ALIASES 64
#define MAX_TYPE_ALIASES_MAX 65536
#define MAX_GLOBAL_TYPE_ALIASES 256
#define MAX_GLOBAL_TYPE_ALIASES_MAX 65536
#define MAX_ALIAS_CHAIN 32
#define MAX_CLOSURES 64
#define MAX_CLOSURES_MAX 65536
#define MAX_GENERIC_INSTS 64
#define MAX_GENERIC_INSTS_MAX 65536
#define MAX_STRUCT_TPLS 64
#define MAX_STRUCT_TPLS_MAX 65536
#define MAX_STRUCT_INSTS 128
#define MAX_STRUCT_INSTS_MAX 65536
#define MAX_STRUCT_TPARAMS 2
#define MAX_STRUCT_TPARAMS_MAX 65536
#define MAX_STRUCT_IMPLS 64
#define MAX_STRUCT_IMPLS_MAX 65536
/* Phase 78 S2b: one row per inherent method carrying ref/out annotations.
   Trait methods use their existing MethodSig row; this table only covers an
   implementation block that has no trait. */
#define MAX_METH_ANN 256
#define MAX_METH_ANN_MAX 65536

namespace frontend::sym;
/* A compile-time synonym for a type spelling. It never reaches the generated C;
   `target` is the canonical spelling the type parser would have emitted for the
   alias. `forward` marks a declaration found by the pre-scan but not parsed yet;
   `resolving` marks the one currently being parsed, so a self reference is a
   cycle instead of an empty expansion. */
pub struct TypeAlias {
    /* S1a-0 C2n-0: `name` / `target` are interned texts owned by
       runtime::text::Intern, not inline `char[160]` arrays. They are copied as
       pointers and never freed by a symbol-table reset (only the pool may
       release them), so a row reset per unit cannot dangle another row's
       spelling. */
    const char *name;
    const char *target;
    const char *path;
    int  line;
    int  is_pub;
    int  owner;         /* unit index; -1 outside `build` */
    int  forward;
    int  resolving;
}

pub trait TypeAliasOps {
    int find_type_alias(const char *name);
    int begin_type_alias(const char *name, const char *path, int line, int is_pub, int owner);
    int finish_type_alias(const char *target);
    void abort_type_alias(void);
    int add_forward_type_alias(const char *name, const char *path, int line, int owner);
    int add_visible_type_alias(const char *name, const char *target, const char *path,
                               int line, int owner);
    int find_global_type_alias(const char *name, char *path, int cap, int *line);
    /* S1a-0 C2p-4: the pool-text forms. The old `(char *out, int cap)` output
       and the `id[160]` / `eb[160]` scratch rows cut an alias target at 160
       bytes; each step now builds a dynamic block and interns the result. */
    int expand_type_alias_text(const char *name, const char **out);
    int expand_type_text_text(const char *text, const char **out);
    int resolve_exported_type_aliases(int owner);
}

pub struct Fn {
    /* S1a-0 C2n-1: the row's spellings are interned texts owned by
       runtime::text::Intern. A row copy is a pointer copy, and a per-unit
       reset drops the row without freeing a text another row may share. */
    const char *name;
    /* the C spelling: a `pub` function inside a namespace is mangled with its
       prefix, a static helper keeps the plain name */
    const char *cname;
    const char *ret;
    /* S1a-0 C1/C2p-3: the parameter rows are three parallel heap blocks owned
       by this row, grown on demand. `ptype`/`pdim` are pointer rows (each an
       interned text), so a 2000-byte parameter type is not cut at a MAX_TEXT
       stride; `pann` is one byte per position. `pcap` is their common
       capacity; a row reused after the per-unit reset keeps its blocks. */
    const char **ptype;
    /* array dims are kept apart from the type: the prototype must spell them
       (`int f(Expr a[])` vs `int f(Expr a)` are conflicting types), while the
       call side still compares bare types for boxing */
    const char **pdim;
    /* Phase 78 (S2): 0 = plain, 2 = `ref`, 3 = `out`. The stored type stays
       the caller's base type (type checking compares it), and the emitter adds
       the C pointer at the declaration/call boundary. */
    char *pann;
    int  nparams;
    int  pcap;
    int  is_static;
    int  is_pub;
    int  variadic;      /* `int f(int n, ...)`: the prototype needs the `...` */
    /* Phase 26: a generic function carries exactly one type parameter. The
       template itself is never emitted; every call site that names a concrete
       type argument gets a monomorphised instance in `ginsts`. */
    int  ntparams;
    const char *tparam;
    /* Phase 28: the one trait bound of a generic template (`T name<T: Trait>`),
       empty when the parameter is unbounded. Instances inherit it through the
       template row, so the satisfaction check reads it off `funcs[ginst.func]`. */
    const char *bound;
    /* Phase 26: the template's N_FUNC node, so the emitter can monomorphise it
       once per instance without a second AST copy (-1 for a plain row). */
    int  body;
    int  line;
    int  ret_owned;     /* 1 when it may hand back an allocation it owns (10.3) */
    /* A GNU `__attribute__((…))` on the declaration: -1 when it carried none,
       otherwise the offset of its captured spelling in the string pool. The
       prototype re-emits it after the parameter list (the C compiler owns the
       meaning). */
    int  attr;
}

pub struct Var {
    const char *name;
    const char *type;
    /* an array's declared type carries no star of its own, but `T *a[N]` and
       `T *p` spell the same type; indexing tells them apart only through this */
    int  is_array;
    /* The declared dimensions verbatim (`[5]`, `[]`, `[A][B]`), empty for a
       plain value. `foreach` counts them to refuse a multidimensional array and
       to tell an inferred-length local from an unsized file-scope one. */
    const char *dims;
    /* leak tracking (10.3), mirroring L2's conservative rules */
    int  st;            /* struct index when the type is `struct T *`, else -1 */
    int  owned;         /* 1 when a heap object (malloc/calloc/owned callee) */
    int  own_line;      /* source line of that allocation */
    int  autodrop;      /* 1 when declared `own`: release at scope exit */
    int  path_warned;   /* 1 once reported as possibly leaking on a return path */
    /* `borrow`: the pointer is lent, not owned. `borrowed` refuses `delete` on
       it and storing it somewhere that outlives the borrow; `is_param` keeps a
       parameter (whose lifetime the caller owns) apart from a local
       declaration, which a `return` may hand back (D5). */
    int  borrowed;
    /* Phase 78 (S2): the parameter is `ref` / `out`; reads and writes emit
       `(*name)` because the C signature carries a pointer. `initialized` is
       the caller-side fact `out` needs: an owning actual must already hold a
       value (globals, parameters and `=`-initialised locals do). */
    int  ref_param;
    int  out_param;
    int  initialized;
    /* Phase 31 S23a: 1 when a container local holds a borrowed view (`get` /
       `entry` / `foreach item`, or a copy of one). The view does not own the
       buffer, so `release` on it is refused (L31-13/L31-14). It is set and
       cleared at parse time; `borrowed` above stays the `borrow` pointer flag. */
    int  cview;
    int  is_param;
    /* A declared function or trait-method parameter, not only a `borrow` one.
       C decays `int a[]` into `int *`, so `foreach` must refuse an array
       parameter instead of asking `sizeof` for a length that no longer exists. */
    int  is_fnparam;
    /* A namespaced global is emitted under a mangled C name, so `cname` carries
       that spelling (equal to `name` for a local or a root global). `ns` holds
       the declaring namespace in underscore form (`a_b`), which is what a
       qualified reference (`a::b::h`) is matched against. `extern` globals keep
       their C name and an empty `ns`: the library owns the symbol. */
    const char *cname;
    const char *ns;
    int  is_global;     /* file-scope: the mangling / qualification rules apply */
    int  is_static;     /* a block-scope `static`: its lifetime outlives the block */
    int  imported;      /* copied in from an imported unit's export */
    int  ambiguous;     /* a bare reference cannot pick between two imports */
    /* An enum member is emitted as a C enumerator and behaves like a constant
       in an expression, so it sits in this table under a masked type (`int`) and
       this flag tells the constant-expression check it may be folded (5.0). */
    int  is_const;
    /* A closure variable (Phase 21 S2): the name is a binding for the
       (trampoline, env) pair, not a value. `closure_id` indexes
       `Symbols.closures` and stays -1 on a plain variable. */
    int  is_closure;
    int  closure_id;
    /* P-7.2 (S3 slice prototype): a variable whose declared type is `T[]`.
       The C storage is `struct __ct_slice`; the element spelling and the
       `const` flag stay here because the erased C type cannot carry them.
       `slice_escape` is set on a local view built from a local array, so a
       direct `return` of it can be linted (P-4.3). */
    int  is_slice;
    const char *slice_elem;
    int  slice_const;
    int  slice_escape;
    /* SH-106: the same lifetime-lite bookkeeping for the borrowed `Str` /
       `U16Str` views. `str_escape` is 0 when the view's owner outlives the
       frame (immortal literal, parameter, field, global / static), 1 when it
       borrows a local owning `String` / `U16String` (released at frame exit)
       and 2 when it borrows a temporary owner (released at the end of the
       full expression). `str_immortal` marks a local owning handle bound from
       a literal: its `release()` is a no-op (`refs = -1`), so a view of it
       stays valid across the frame boundary. Only the parser reads/writes
       them; the emitter is unchanged. */
    int  str_escape;
    int  str_immortal;
}

/* One non-escaping closure literal. The parser fills this table; the emitter
   reads it in S3. Parameter and capture lists are copied by value because the
   `Var` rows they came from die when the enclosing scope is popped. */
pub struct Closure {
    /* S1a-0 C2p-5: pool texts, so a 2000-byte enclosing name / return type /
       capture spelling is not cut by a 160-byte row. */
    const char *owner;          /* enclosing function's C name, empty at file scope */
    const char *ret;            /* return type from the host function pointer */
    /* S1a-0 C2p-4: the parameter rows are pointer arrays of interned texts, so
       a 2000-byte parameter type/name is not cut at the old 160-byte row. The
       16-slot count is still the closure's own limit (a hard error). */
    const char *ptype[16];      /* the literal's parameter types, as written */
    const char *pname[16];      /* their names, for S3's trampoline */
    int  nparams;
    int  body;                  /* expression node index, or an N_BLOCK */
    int  is_block;              /* 1 when the body is `=> { … }` (S5) */
    int  ncap;
    const char *cap_name[16];
    const char *cap_type[16];
    int  line;
    int  col;
}

/* Phase 78 (S2b): the ref/out annotation of one inherent method's parameters.
   Trait methods keep theirs on `MethodSig`; an inherent method has no trait
   row, so the parser records it here and the emitter reads it at the call site
   to take addresses. `host` is normalised (see `meth_host_key`). */
pub struct MethAnn {
    const char *host;
    const char *name;
    char *pann;
    int  nparams;
    int  pcap;
}

pub struct MethodSig {
    const char *name;
    const char *ret;
    /* S1a-0 C1: the parameter rows grow on demand, like `Fn`'s.
       S1a-0 C2p-4: `ptype` is a pointer row (each entry an interned text), so
       a 2000-byte trait method parameter type is not cut at a MAX_TEXT stride;
       `pann` is one byte per position. */
    const char **ptype;
    /* Phase 78 (S2b): 0 = plain, 2 = `ref`, 3 = `out`. */
    char *pann;
    int  nparams;
    int  pcap;
    /* A `.m.ct` trait has no vtable slot, so its signature may end in `...`:
       the map recipe forwards the rest of the call verbatim. A real trait keeps
       this 0 -- its vtable slot is a fixed function-pointer type (batch 13). */
    int  variadic;
    /* SH-60 / D-60-1: the postfix `mut` annotation (`int f() mut;`) says the
       method writes its receiver. Only a static `.m.ct` method may carry it;
       the call site warns when the receiver is a literal or a top-level const
       value. It is a compile-time table flag only -- no vtable slot, mangled
       name, recipe or emitted C changes. */
    int  is_mut;
    /* A default body (`{ … }` after the signature): the N_BLOCK's index and
       the N_PARAM chain that names its parameters. Both are -1 for an abstract
       method, whose body the adopting impl must write. `line` is where the
       signature was declared, which is what an expansion failure points at. */
    int  body;
    int  pnode;
    int  line;
}

pub struct Trait {
    const char *name;
    /* S1a-0 C1: the method rows grow on demand instead of stopping at 64.
       The block is owned by the row; `mcap` is its capacity and `m` may be
       NULL until the first method is appended. A generic instance row gets
       its own block and copies the `MethodSig` values (they hold no
       pointers), so a realloc of `traits` or of `m` never aliases two rows. */
    struct MethodSig *m;
    int  nm;
    int  mcap;
    int  is_pub;
    int  is_static;             /* declared in a `.m.ct` unit: no iface, no vtable */
    int  line;
    /* the declaring unit's path, for the D-7 expansion diagnostic */
    const char *path;
    /* the declaring namespace in underscore form, for a static namespace host */
    const char *ns;
    /* Phase 35: a parameterised trait (`trait Iter<T>`) is a template row.
       `ntparams > 0` marks it and `tparam[]`/`bound[]` hold the declaration;
       every `Iter<int>` use copies `m[]` into an instance row whose signatures
       carry the argument instead of `T`. `tmpl` is the template row's index on
       an instance (-1 on a template or a plain trait), `nargs`/`carg[]` hold
       the normalised arguments of an instance, and `owner` is the declaring
       unit (the cross-unit guard names it). */
    int  ntparams;
    /* S1a-0 C3: pointer rows (one MAX_TEXT buffer per row), grown on demand.
       `tcap` is the shared capacity of `tparam`/`bound`; `cacap` of `carg`. */
    char **tparam;
    char **bound;
    int  tcap;
    int  bcap;
    int  tmpl;
    int  nargs;
    char **carg;
    int  cacap;
    int  owner;
}

pub struct Field {
    const char *name;
    const char *type;
    int  line;                  /* PH-59: declaration line for the model export */
    int  col;                   /* PH-74/J11: declaration column for the model export */
    /* array dims (`[2]`, `[N]`): a designated initialiser cannot reach an
       element, so such a field's vptrs are written by a loop instead */
    const char *dims;
    int  is_pub;                /* PH-73: only `pub` fields enter the public header */
    /* Phase 78 fix SH-95: a bit-field has no C address, so it can never be a
       `ref`/`out` place. The parser records the N_FIELD marker here. */
    int  is_bitfield;
}

pub struct StructDef {
    const char *name;
    const char *use[64];
    int  nuse;
    /* field types: a receiver chain (`s.owner.greet()`) needs them, and so does
       the nested vptr initialiser of a struct-typed field. S1a-0 C1: the rows
       are a heap block owned by this struct row (`fcap`); a realloc of the
       struct table does not move it. */
    struct Field *fields;
    int  nfields;
    int  fcap;
    int  defined;               /* a body was parsed; a forward declaration is not */
    /* PH-82: the definition's `struct` keyword position and whether the same
       source line carries the `ct: allow-cycle` marker -- the direct-cycle
       warning (Module::cycle_check) reads both. */
    int  line;
    int  col;
    int  allow_cycle;
    int  uses_drop;             /* built-in `Drop`: no vptr, no vtable, `delete` calls it */
    int  uses_handback;         /* built-in `Handback`: no vptr, no vtable, `borrow` calls it */
    int  has_handback_impl;     /* this unit parsed `impl Handback for S` */
    int  has_drop_impl;         /* P36 S2a: parsed an `impl Drop` (incl. generic) */
    /* Phase 29: a generic struct template (`struct Stack<T>`) emits no C of its
       own; every `(template, type arguments)` pair gets one instance row whose
       fields are the template's with `T`/`U` replaced. `is_inst` marks that row,
       and `declared_here` says this unit's `.h` already carries the definition,
       so the `.c` must not repeat it. */
    int  ntparams;
    /* S1a-0 C3: the declaration's parameter names are heap rows (`tcap`). */
    char **tparam;
    int  tcap;
    int  is_template;
    int  is_inst;
    int  is_pub;
    int  declared_here;
    /* Phase 33 O3: the unit that declared this type (-1 outside `build` and on
       an instance row). A container instantiated elsewhere compares it with the
       template owner's unit to decide whether the element's definition reaches
       the unit that would otherwise write the instance methods. */
    int  owner;
}

pub trait SymbolOps {
    int  declare_var(const char *name, const char *type);
    int  declare_global(const char *name, const char *type, const char *cname,
                        const char *ns, int imported);
    /* An enum member: a file-scope `int` the source may not assign to. */
    int  declare_const(const char *name, const char *cname, const char *ns, int imported);
    int  is_const_name(const char *name);
    int  var_cname(const char *name, char *out, int cap);
    int  var_ambiguous(const char *name);
    const char *find_qualified_global(const char *qual, const char *name);
    int  find_var(const char *name);
    int  var_type(const char *name, char *out, int cap);
    int  find_func(const char *cname);
    int  ensure_fn_capacity(int need);
    /* S1a-0 C1: grow function `fi`'s parameter rows to hold `need` positions.
       The three blocks move together and the new slots are zeroed; -1 only at
       allocation failure or past MAX_PARAMS_MAX. */
    int  ensure_fn_param_capacity(int fi, int need);
    /* S1a-0 C1: the variable table and the scope stack grow on demand. */
    int  ensure_var_capacity(int need);
    int  ensure_scope_capacity(int need);
    int  ensure_type_capacity(int need);
    int  ensure_ginst_capacity(int need);
    int  ensure_closure_capacity(int need);
    int  ensure_alias_capacity(int need);
    int  ensure_bare_capacity(int need);
    int  ensure_type_alias_capacity(int need);
    int  ensure_global_type_alias_capacity(int need);
    /* Phase 78 S2b: remember / look up an inherent method's ref/out
       annotations. Both sides normalise the host spelling (struct/union tag
       prefix and generic arguments are dropped). */
    int  add_meth_ann(const char *host, const char *name, const int *pann, int nparams);
    int  find_meth_ann(const char *host, const char *name, int *pann, int cap);
    /* The row a plain call names: the unit's own namespace first, then the
       root. Fails when the name is exported only from another namespace, which
       an unqualified call cannot reach. */
    int  resolve_func(const char *name);
    int  find_type(const char *name);
    int  add_type(const char *name, int kind);
    /* V29-4: the spelling behind a C typedef name (empty for an opaque one). */
    int  set_type_target(const char *name, const char *target);
    int  type_target_of(const char *name, char *out, int cap);
    /* S1a-0 C2p-5: the pool-text form of `type_target_of`. */
    const char *type_target_text(const char *name);
    int  add_bare_type(const char *name, const char *full);
    int  find_struct(const char *name);
    int  add_struct(const char *name);
    int  ensure_struct_capacity(int need);
    /* S1a-0 C1: one struct's field block, and one template's field block. */
    int  ensure_struct_field_capacity(int si, int need);
    int  ensure_tmpl_field_capacity(int ti, int need);
    /* Phase 29: a monomorphised generic struct. Its own cap does not eat the
       MAX_STRUCTS budget the plain declarations rely on. */
    int  add_struct_inst(const char *name);
    int  find_trait(const char *name);
    int  add_trait(const char *name);
    /* S1a-0 C1: grow the trait table itself (not the per-trait method block). */
    int  ensure_trait_table_capacity(int need);
    /* S1a-0 C1: grow trait `ti`'s method block to hold `need` rows. The new
       slots are zeroed; -1 (an `out of memory` message) only at allocation
       failure or past MAX_METHODS_MAX. The parser calls this before writing
       the row it just parsed. */
    int  ensure_trait_capacity(int ti, int need);
    /* S1a-0 C1: grow method `mi` of trait `ti` to hold `need` parameter rows. */
    int  ensure_meth_param_capacity(int ti, int mi, int need);
    /* S1a-0 C1: grow the annotation table to `need` rows. */
    int  ensure_meth_ann_capacity(int need);
    /* S1a-0 C1: grow annotation row `mi` to hold `need` parameter flags. */
    int  ensure_meth_ann_param_capacity(int mi, int need);
    /* Phase 35: find or create the instance row of a parameterised trait.
       `args` are the source-canonical arguments the encoded name and `carg[]`
       use; `cargs` are the C spellings substituted into method signatures. Both
       are row blocks of `nargs` entries (S1a-0 C3: any arity up to the formal
       cap). The row is registered as an iface type too. -1 sets last_error. */
    int  trait_inst(const char *tname, int nargs, char **args, char **cargs,
                    int owner);
    /* Phase 35 S5a: the concrete trait row a template impl's `use` names for
       one instance. A plain name passes through; the symbolic `Iter<T>` binds
       positionally to the instance's arguments. `owner` is the unit allowed to
       create the row (-1 in the emitter, where the parser already made it). */
    int  impl_use_concrete(const char *use, int nargs, char **args, char **cargs,
                           int owner, char *out, int cap);
    int  method_trait(const char *stype, const char *method, char *tout, int tcap);
    /* S1a-0 C2p-5: the pool-text form, so a 2000-byte trait name is not cut
       by the caller's row and the dispatch does not fall through to a map. */
    const char *method_trait_text(const char *stype, const char *method);
    int  method_trait_amb(const char *stype, const char *method, const char *first,
                          char *other, int ocap);
    /* S1a-0 C2p-6: the pool-text form; NULL when no second trait declares it. */
    const char *method_trait_amb_text(const char *stype, const char *method,
                                      const char *first);
    int  ns_decl_name(const char *name, char *out, int cap);
    /* S1a-0 C2o: the same mapping, returned as a pool text so a declaration
       name of any length up to TEXT_LIMIT needs no fixed `out` buffer. */
    const char *ns_decl_text(const char *name);
    int  resolve_type(const char *name, char *out, int cap);
    /* S1a-0 C2p: the same lookup, but the resolved spelling is a pool text the
       caller may keep -- no caller-sized buffer, so a long type name is no
       longer "name is too long". NULL only when the pool cannot grow. */
    const char *resolve_type_text(const char *name);
    int  add_alias(const char *name, const char *full);
    int  push_scope(void);
    int  pop_scope(void);
    /* A fresh closure row; the parser fills in parameters, captures and body. */
    int  closure_new(const char *owner);
    /* The unit a capacity message names: the basename of `path`, or
       "this unit" before the driver binds one. */
    const char *unit_name(void);
    /* R10: `__ct_` names the compiler's own products. Every declaration category
       (local / parameter / global / type / field / function) shares this one
       predicate; the callers report the bare message. */
    int  reserved_name(const char *name);
    int  fail(const char *msg);
    const char *last_error(void);
}

/* Phase 26: one monomorphised instance of a generic function. `func` indexes
   the template row in `funcs`; `row` indexes its own static copy there; `targ`
   is the concrete type spelling; `cname` is `<template>__ct<N>`. */
pub struct GenericInst {
    int  func;
    int  row;
    /* S1a-0 C2p-3: pool texts, so a 2000-byte type argument survives. */
    const char *targ;
    const char *cname;
    /* Phase 34 (D34-1): the unit that asked for the instance. A `pub` template
       lives in a `.h.ct` header, so `func` points at the template owner's row;
       only the asking unit may emit the `static` copy, otherwise the header
       unit writes an unused one and the consumer calls an undefined symbol. */
    int  owner;
    /* Phase 28: where the instance was asked for, so a missing implementation
       is reported at the call site rather than at the template; `checked`
       keeps a multi-unit build from re-reporting the same row. */
    int  line;
    int  col;
    int  checked;
}

/* Phase 29: a generic struct template and its monomorphised instances. Both
   registries cover the whole build, not one unit: the per-unit tables reset and
   re-export only names, so a consumer that names `Stack<int>` needs the
   template's field spellings and the instance's identity from somewhere that
   outlives the reset. */
pub struct StructTmpl {
    const char *name;           /* the source name, `Stack` */
    const char *full;           /* namespace-qualified C name */
    int  ntparams;
    /* S1a-0 C3: pointer rows grown on demand; `tcap` is the shared capacity of
       `tparam`/`bound`. */
    char **tparam;
    /* Phase 33 O1: the trait bound written after a parameter
       (`struct Box<T: Show>`), position-aligned with `tparam`; empty when the
       parameter is unbounded. It is a spelling, not a resolved row: a consumer
       unit may not see the trait's declaration, so `find_trait` waits for the
       unit that creates an instance (D33-5, L33-6). */
    char **bound;
    int  tcap;
    int  bcap;
    struct Field *fields;
    int  nfields;
    int  fcap;
    const char *use[64];
    int  nuse;
    int  uses_drop;              /* P36 S2a2: built-in Drop flag, copied to instances */
    int  uses_handback;          /* P36 S2a2: built-in Handback flag, copied to instances */
    int  is_pub;
    int  owner;                 /* unit index; -1 outside `build` */
    char path[1024];
    int  line;
}

pub struct StructInst {
    const char *name;           /* the encoded C tag, `Stack_int` */
    const char *tmpl;           /* the template's source name */
    /* The canonical type-argument spellings, in the form the encoder consumed
       (`int`, `char*`, `Vec<int>`). They are the identity of the instance: the
       encoded name is only a hash-like spelling of them (D29-6). */
    char **carg;
    /* The same arguments in the C spelling (`struct Vec_int`), which is what a
       method's `T` has to become when the block is monomorphised. */
    char **ctype;
    int  acap;
    int  ccap;
    int  nargs;
    int  owner;                 /* the unit that first named the instance */
    /* Phase 33 O1: where the first type argument was written, so the bound
       check can blame the instantiation (`Box<int>`'s `int`). 0 outside a
       source position (a nested registration with no argument list). */
    int  line;
    int  col;
    int  carried;               /* the template owner's `.h` already defines it */
    int  emitted;               /* the writer already printed the definition */
}

pub struct StructTmpl *ct_tmpls(int *n);
pub struct StructInst *ct_insts(int *n);
/* Phase 29: an `impl` block written against a template rather than a concrete
   struct (`impl<T> Pair<T, int>`). The block is monomorphised once per matching
   instance, so it carries the argument *pattern* rather than an instance name. */
pub struct StructImpl {
    const char *tmpl;
    int  ntparams;
    char **tparam;
    int  tcap;
    int  nargs;
    char **pat;                 /* a declared parameter name, or a canonical type */
    int  pcap;
    const char *use;            /* trait name; empty for an inherent block */
    int  node;                  /* arena index of the N_IMPL node */
    int  owner;
    int  line;
}
pub struct StructImpl *ct_impls(int *n);
pub int ct_impl_find(const char *tmpl, int nargs, char **pats, const char *use);
pub int ct_impl_add(const char *tmpl, int ntprm, char **tparams, int nargs,
                    char **pats, const char *use, int node, int owner, int line);
/* 1 when the instance row `inst` is covered by the block `ii`. */
pub int ct_impl_matches(int ii, int inst);
/* Phase 32 S6: bind the block's type parameters to the instance's concrete C
   arguments (`T` -> `struct Vec_int`). `names`/`values` are row blocks of at
   least `cap` entries; each bound parameter i writes names[i]/values[i].
   Returns how many were bound, or -1 when the block does not cover the
   instance. */
pub int ct_method_bind(int ii, int inst, char **names, char **values, int cap);
pub int ct_tmpl_find(const char *name);
pub int ct_tmpl_add(const char *name, const char *full, int ntprm, char **tparams, char **bounds, int is_pub, int owner, const char *path, int line);
pub int ct_inst_find(const char *name);
pub int ct_inst_add(const char *name, const char *tmpl, int nargs, char **args, char **cargs, int owner, int carried, int line, int col);
/* Phase 29 §2.2: the canonical spelling of one type argument (trim, collapse
   whitespace, glue `*` to the previous token) and the encoded instance name. */
/* Phase 29 L29-9/L29-11: 1 when `type` is a by-value built-in container
   (`struct Vec_*` / `struct Map_*`). A pointer to one is not a container
   value, so `Vec<int> *p` answers 0. */
/* PH-80 SH-102 (D-013 §3): 0 when `type` is not one of the two by-value owning
   built-in string handles, 1 for `String`, 2 for `U16String`. A pointer, an
   array or a `const` view (`Str` / `U16Str`) is 0: those borrow and must not be
   retained or released. */
/* Phase 29: rewrite a spelling that still names an instance (`Vec<int>`,
   optionally prefixed by `struct`) to `struct <encoded>`. -1 when it is not an
   instance or the table has no such row yet. */
pub int ct_inst_resolve(const char *in, char *out, int cap);
/* Phase 29: split `[struct ]Name<a[, b]>` into its template name, canonicalized
   arguments and the trailing suffix (stars / dims). 0 when the spelling is an
   instance form, -1 otherwise. */

/* ---- Phase 84: minimal ADTs (`enum T { V(payload), … }`) ----

   A payload-bearing `enum` is an ADT: the tag joins the type table under kind 7
   (its C spelling is `struct <tag>`), and the variants/payloads live in this
   build-wide registry so the parser, the type pass and the emitter read one
   copy of the layout. It is global like the template/instance registries: the
   per-unit symbol tables reset, while a consumer unit must still see the
   variants of a `pub` header ADT (D84-2).

   S1a-0 C3: the three counts grow on demand. `MAX_ADTS` / `MAX_ADT_VARIANTS`
   / `MAX_ADT_FIELDS` are only the starting capacities; the formal ceiling is
   `MAX_ADTS_MAX` / `MAX_ADT_VARIANTS_MAX` / `MAX_ADT_FIELDS_MAX` (65536, an
   OOM guard, not a language limit). The blocks are heap rows owned by the
   enclosing row, so a realloc of the ADT table never moves a variant block.
   Caps are literals: the generated header carries no macros. */
#define MAX_ADTS 64
#define MAX_ADTS_MAX 65536
#define MAX_ADT_VARIANTS 96
#define MAX_ADT_VARIANTS_MAX 65536
#define MAX_ADT_FIELDS 8
#define MAX_ADT_FIELDS_MAX 65536
pub struct AdtField {
    /* S1a-0 C2p-4: interned texts, so a 2000-byte payload field name or type
       is not cut at the old 160-byte row. */
    const char *name;
    const char *type;
}
pub struct AdtVariant {
    const char *name;           /* the source name, `Circle` */
    const char *cname;          /* the emitted union member, `Circle` */
    int  nfields;
    int  fcap;
    struct AdtField *fields;    /* owned by this variant; NULL until the first field */
    int  line;
    int  col;
}
pub struct Adt {
    const char *name;           /* the source name, `Shape` */
    const char *full;           /* the namespace-mangled C tag, `lib_Shape` */
    int  nvariants;
    int  vcap;
    struct AdtVariant *variants; /* owned by this row; NULL until the first variant */
    int  is_pub;
    int  owner;                 /* the unit that declared it; -1 in compile mode */
    char path[1024];
    int  line;
}
pub struct Adt *ct_adts(int *n);
/* The row whose C tag (or, as a fallback, source name) is `name`; -1 otherwise. */
pub int ct_adt_find(const char *name);
/* Phase 84 fix (F1): the ADT row behind a *type spelling* -- `struct T`,
   `T *`, a typedef alias (`Alias`, `lib_Alias`) or a namespaced tag. The
   alias row records its target (`struct <tag>`) in the type table, so one
   spelling rule serves the parser, the type pass and the emitter. */
pub int ct_adt_from_type(const char *spelling);
/* Create the row for `full`; returns its index, -1 on a cap overflow, -2 when a
   row with that spelling already exists (the caller reports the duplicate). */
pub int ct_adt_add(const char *name, const char *full, int is_pub, int owner, const char *path, int line);
pub int ct_adt_add_variant(int adt, const char *name, const char *cname, int line, int col);
pub int ct_adt_add_field(int adt, int v, const char *name, const char *type);
/* The variant row of `adt` named `name`; -1 when the variant does not exist. */
pub int ct_adt_variant(int adt, const char *name);
/* 1 when the ADT has a variant with this name. */
pub int ct_adt_has_variant(int adt, const char *name);

pub struct Symbols {
    /* The four big tables are heap blocks allocated in `symbols_get` (SH-42):
       as inline arrays in the file-scope instance they put ~21 MB of zeroes
       into __DATA. Their caps stay literal, mirroring the MAX_* values above. */
    struct Fn   *funcs;
    int  nfunc;
    int  fncap;
    /* Phase 41: any ct_atomic_* builtin was lowered in this program, so the
       emitter must write the static inline helper block into each .c. */
    int  atomic_used;
    /* P36 S4a2: functions registered by the built-in layer before the user
       program starts. `MAX_FUNCS` bounds the user's budget, so the check is
       `nfunc >= nfunc_base + MAX_FUNCS`; the table itself is allocated with
       headroom (`MAX_FUNCS + 64`). */
    int  nfunc_base;
    struct GenericInst *ginsts;
    int  nginsts;
    int  ginstcap;
    struct Var  *vars;
    int  nvar;
    int  varcap;
    int  *scope;
    int  nscope;
    int  scopecap;
    /* S1a-0 C1: three parallel blocks grown together by
       `ensure_type_capacity`. S1a-0 C2p-3: `types`/`type_target` are pointer
       rows (each an interned text), so a 2000-byte struct name is not cut at
       the old MAX_TEXT stride. */
    const char **types;
    int  *type_kind;            /* 1 = struct tag, 2 = typedef, 3 = trait, 4 = function-pointer typedef,
                                   5 = enum tag, 6 = union tag */
    /* V29-4: the spelling a C typedef stands for (`typedef Vec<int> (*VecFn)(void)`
       keeps `struct Vec_int (*)(void)`), so the subscript checker resolves the
       alias by name instead of inferring it from the use site. */
    const char **type_target;
    int  ntype;
    int  typecap;
    struct Trait *traits;
    int  ntraits;
    int  traitscap;
    struct StructDef *structs;      /* grown from MAX_STRUCTS + MAX_STRUCT_INSTS rows */
    int  nstructs;
    int  nstruct_inst;              /* the instance half of `structs` */
    int  structcap;
    struct Closure *closures;
    int  nclosure;
    int  closurecap;
    /* Phase 78 S2b: inherent-method parameter annotations, filled while the
       impl block is parsed. A template impl stores its template host, so an
       instance call (`Box<int>`) finds it after normalisation. */
    /* 256 = MAX_METH_ANN, spelled literally: macros do not cross the unit
       boundary, so the generated header must see the number. */
    /* S1a-0 C1: the inherent-method annotation rows grow on demand. */
    struct MethAnn *meth;
    int  methcap;
    int  nmeth;
    /* An exported type declared in a namespace is also reachable by its bare
       name, so a consumer need not alias-import it. A second unit exporting the
       same bare name from another namespace marks it ambiguous: the alias
       import remains the escape hatch. */
    /* S1a-0 C2o: exported type names are pointer rows (each a pool text) and
       grow on demand; the old `char[128][160]` cut both the count and one
       exported name's length. */
    const char **tbare;         /* the name the source wrote */
    const char **tfull;         /* its qualified C name (`hal_Writer`) */
    int  *tbambig;
    int  ntb;
    int  tbcap;
    /* S1a-0 C2o: the current namespace prefix is a pool text (`A_B_`), so a
       long namespace path is not cut at the old 160-byte row. Empty is "". */
    const char *ns;
    /* The input the table is filling, kept in step with `mem->path` by the
       driver and the module layer. The capacity messages name it: a generated
       file with hundreds of declarations otherwise leaves the reader hunting
       for the unit that overflowed (SH-53). */
    const char *path;
    /* `import a::b::C as D;` brings one exported name in under `D` for this unit
       only (the table resets per unit); `alias_full` is the mangled C name. */
    /* S1a-0 C1/C2n-1: the import-alias rows grow on demand from 24. They are
       two pointer rows now (each entry an interned text owned by
       runtime::text::Intern); `ensure_alias_capacity` grows them together.
       (Before C1 they were fixed `char [24][160]` arrays, which S1a-1's
       one-unit-per-method-group split immediately outgrew.) */
    const char **alias_name;
    const char **alias_full;
    int  nalias;
    int  aliascap;
    /* Type aliases (`pub type X = T;`): a per-unit visible table plus a global
       registry of every declaration loaded in this build. The global half is
       what lets `parse_type` say "declared in ... but not imported" instead of
       treating the name as an opaque C type. Both blocks are heap allocated. */
    struct TypeAlias *taliases;
    int  ntalias;
    int  taliascap;
    /* S1a-0 C2p-5: pool texts; a 2000-byte alias name is not cut by a row. */
    const char *tachain[32];    /* MAX_ALIAS_CHAIN, spelled out for the header */
    int  ntachain;
    struct TypeAlias *gtaliases;
    int  ngtalias;
    int  gtaliascap;
    /* 1 while `parse_type` reads the right-hand side of a `type` declaration.
       A forward reference there is deferred as raw text (so alias cycles and
       legal forward targets stay one mechanism); outside it, a forward row is
       a use before the declaration and is reported. */
    int  alias_decl;
    int  self_mode;             /* inside an impl body: `self` -> `_self` */
    /* S1a-0 C2p-4: an interned text, so a 2000-byte return type is kept whole
       for the return-statement checks and the emitter's drop spelling. */
    const char *ret_type;       /* return type of the function being parsed */
    /* Inside a trait method's default body: the trait `self->m(...)` dispatches
       through. Empty everywhere else. The adopting struct is unknown at parse
       time, so the receiver resolves to the enclosing trait by construction. */
    const char *trait_default;  /* S1a-0 C2p-5: pool text */
    /* S1a-0 C2p: a pool text, not a 160-byte row. */
    const char *errmsg;         /* the bare message `fail` recorded; Ast adds the position */
} use SymbolOps, TypeAliasOps;

pub struct Symbols *symbols_get(void);

/* Phase 26: replace the whole-word occurrences of `word` in a type spelling
   with `repl` (`T` -> `int`, `T *` -> `int *`). Returns 0 and writes `out`,
   -1 when `out` would not fit. A word is bounded by non-identifier characters,
   so `T2` and `struct T` are left alone. */


impl SymbolOps for Symbols {
    /* The tables report the bare reason; the position belongs to the parser
       object, which wraps this message with the current line and token. */
    int fail(const char *msg)
    {
        (void)self;
        self->errmsg = runtime::text::ct_internf("%s", msg);
        return -1;
    }

    const char *last_error(void)
    {
        (void)self;
        return self->errmsg ? self->errmsg : "";
    }

    /* R10: `__ct_` names the compiler's own products. The check used to guard
       only locals and parameters; every declaration category shares this one
       predicate now, so a global, function, type or field cannot collide with
       the generated C either. */
    /* SH-109: grow the function table on demand instead of treating 512 as
       a hard whole-program limit. 512 is the initial capacity; the safety
       valve is MAX_FUNCS_MAX (65536). */
    int ensure_fn_capacity(int need)
    {
        int cap;
        void *grown;
        if (need <= self->fncap) return 0;
        cap = self->fncap > 0 ? self->fncap : MAX_FUNCS + 64;
        while (cap < need && cap < MAX_FUNCS_MAX) cap *= 2;
        if (cap > MAX_FUNCS_MAX) cap = MAX_FUNCS_MAX;
        if (need > cap) return -1;
        grown = realloc(self->funcs, (size_t)cap * sizeof(*self->funcs));
        if (!grown) return -1;
        self->funcs = grown;
        memset(self->funcs + self->fncap, 0, (size_t)(cap - self->fncap) * sizeof(*self->funcs));
        self->fncap = cap;
        return 0;
    }

    /* S1a-0 C1: a function's parameter rows are three parallel heap blocks.
       They are owned by the row and grow together, so a moved `funcs` table
       does not invalidate them and a reused row keeps its capacity. */
    int ensure_fn_param_capacity(int fi, int need)
    {
        int cap;
        const char **types, **dims;
        char *anns;
        if (fi < 0 || fi >= self->nfunc) return self->fail("function table out of range");
        if (need <= self->funcs[fi].pcap) return 0;
        cap = self->funcs[fi].pcap > 0 ? self->funcs[fi].pcap : MAX_PARAMS;
        while (cap < need && cap < MAX_PARAMS_MAX) cap *= 2;
        if (cap > MAX_PARAMS_MAX) cap = MAX_PARAMS_MAX;
        if (need > cap) return self->fail("out of memory");
        types = (const char **)realloc(self->funcs[fi].ptype,
                                       (size_t)cap * sizeof(*types));
        if (!types) return self->fail("out of memory");
        memset(types + self->funcs[fi].pcap, 0,
               (size_t)(cap - self->funcs[fi].pcap) * sizeof(*types));
        self->funcs[fi].ptype = types;
        dims = (const char **)realloc(self->funcs[fi].pdim,
                                      (size_t)cap * sizeof(*dims));
        if (!dims) return self->fail("out of memory");
        memset(dims + self->funcs[fi].pcap, 0,
               (size_t)(cap - self->funcs[fi].pcap) * sizeof(*dims));
        self->funcs[fi].pdim = dims;
        anns = (char *)realloc(self->funcs[fi].pann, (size_t)cap);
        if (!anns) return self->fail("out of memory");
        memset(anns + self->funcs[fi].pcap, 0, (size_t)(cap - self->funcs[fi].pcap));
        self->funcs[fi].pann = anns;
        self->funcs[fi].pcap = cap;
        return 0;
    }

    /* S1a-0 C1: MAX_VARS/MAX_SCOPE are starting capacities. Both blocks are
       owned by the singleton and reset only by index (`nvar`/`nscope`), so a
       moved block invalidates no caller: every reader re-indexes through
       `self`. */
    int ensure_var_capacity(int need)
    {
        int cap;
        struct Var *grown;
        (void)self;
        if (need <= self->varcap) return 0;
        cap = self->varcap > 0 ? self->varcap : MAX_VARS;
        while (cap < need && cap < MAX_VARS_MAX) cap *= 2;
        if (cap > MAX_VARS_MAX) cap = MAX_VARS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Var *)realloc(self->vars, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->varcap, 0, (size_t)(cap - self->varcap) * sizeof(*grown));
        self->vars = grown;
        self->varcap = cap;
        return 0;
    }

    int ensure_scope_capacity(int need)
    {
        int cap;
        int *grown;
        (void)self;
        if (need <= self->scopecap) return 0;
        cap = self->scopecap > 0 ? self->scopecap : MAX_SCOPE;
        while (cap < need && cap < MAX_SCOPE_MAX) cap *= 2;
        if (cap > MAX_SCOPE_MAX) cap = MAX_SCOPE_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (int *)realloc(self->scope, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->scopecap, 0, (size_t)(cap - self->scopecap) * sizeof(*grown));
        self->scope = grown;
        self->scopecap = cap;
        return 0;
    }

    /* S1a-0 C1: the type table and its two parallel arrays move together.
       A failed later realloc leaves the earlier blocks larger than `typecap`;
       that is harmless (capacity is a lower bound), so no partial state is
       visible to a reader. */
    int ensure_type_capacity(int need)
    {
        int cap;
        const char **names;
        int *kinds;
        const char **targets;
        (void)self;
        if (need <= self->typecap) return 0;
        cap = self->typecap > 0 ? self->typecap : MAX_TYPES;
        while (cap < need && cap < MAX_TYPES_MAX) cap *= 2;
        if (cap > MAX_TYPES_MAX) cap = MAX_TYPES_MAX;
        if (need > cap) return self->fail("out of memory");
        names = (const char **)realloc(self->types, (size_t)cap * sizeof(*names));
        if (!names) return self->fail("out of memory");
        memset(names + self->typecap, 0,
               (size_t)(cap - self->typecap) * sizeof(*names));
        self->types = names;
        kinds = (int *)realloc(self->type_kind, (size_t)cap * sizeof(*kinds));
        if (!kinds) return self->fail("out of memory");
        memset(kinds + self->typecap, 0,
               (size_t)(cap - self->typecap) * sizeof(*kinds));
        self->type_kind = kinds;
        targets = (const char **)realloc(self->type_target,
                                         (size_t)cap * sizeof(*targets));
        if (!targets) return self->fail("out of memory");
        memset(targets + self->typecap, 0,
               (size_t)(cap - self->typecap) * sizeof(*targets));
        self->type_target = targets;
        self->typecap = cap;
        return 0;
    }

    /* S1a-0 C1: the four remaining per-unit tables. Each row record holds
       only values, so a moved block invalidates no caller (all readers use
       indices through `self`). */
    int ensure_ginst_capacity(int need)
    {
        int cap;
        struct GenericInst *grown;
        (void)self;
        if (need <= self->ginstcap) return 0;
        cap = self->ginstcap > 0 ? self->ginstcap : MAX_GENERIC_INSTS;
        while (cap < need && cap < MAX_GENERIC_INSTS_MAX) cap *= 2;
        if (cap > MAX_GENERIC_INSTS_MAX) cap = MAX_GENERIC_INSTS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct GenericInst *)realloc(self->ginsts, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->ginstcap, 0,
               (size_t)(cap - self->ginstcap) * sizeof(*grown));
        self->ginsts = grown;
        self->ginstcap = cap;
        return 0;
    }

    int ensure_closure_capacity(int need)
    {
        int cap;
        struct Closure *grown;
        (void)self;
        if (need <= self->closurecap) return 0;
        cap = self->closurecap > 0 ? self->closurecap : MAX_CLOSURES;
        while (cap < need && cap < MAX_CLOSURES_MAX) cap *= 2;
        if (cap > MAX_CLOSURES_MAX) cap = MAX_CLOSURES_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Closure *)realloc(self->closures, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->closurecap, 0,
               (size_t)(cap - self->closurecap) * sizeof(*grown));
        self->closures = grown;
        self->closurecap = cap;
        return 0;
    }

    int ensure_type_alias_capacity(int need)
    {
        int cap;
        struct TypeAlias *grown;
        (void)self;
        if (need <= self->taliascap) return 0;
        cap = self->taliascap > 0 ? self->taliascap : MAX_TYPE_ALIASES;
        while (cap < need && cap < MAX_TYPE_ALIASES_MAX) cap *= 2;
        if (cap > MAX_TYPE_ALIASES_MAX) cap = MAX_TYPE_ALIASES_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct TypeAlias *)realloc(self->taliases, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->taliascap, 0,
               (size_t)(cap - self->taliascap) * sizeof(*grown));
        self->taliases = grown;
        self->taliascap = cap;
        return 0;
    }

    int ensure_global_type_alias_capacity(int need)
    {
        int cap;
        struct TypeAlias *grown;
        (void)self;
        if (need <= self->gtaliascap) return 0;
        cap = self->gtaliascap > 0 ? self->gtaliascap : MAX_GLOBAL_TYPE_ALIASES;
        while (cap < need && cap < MAX_GLOBAL_TYPE_ALIASES_MAX) cap *= 2;
        if (cap > MAX_GLOBAL_TYPE_ALIASES_MAX) cap = MAX_GLOBAL_TYPE_ALIASES_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct TypeAlias *)realloc(self->gtaliases, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->gtaliascap, 0,
               (size_t)(cap - self->gtaliascap) * sizeof(*grown));
        self->gtaliases = grown;
        self->gtaliascap = cap;
        return 0;
    }

    int reserved_name(const char *name)
    {
        (void)self;
        return name && !strncmp(name, "__ct_", 5);
    }

    /* Only the last path component: the diagnostic already prints the full
       path as its prefix, and a basename keeps the message inside the 160-byte
       buffer that carries it. */
    const char *unit_name(void)
    {
        const char *slash;
        (void)self;
        if (!self->path || !self->path[0]) return "this unit";
        slash = strrchr(self->path, '/');
        return slash ? slash + 1 : self->path;
    }

    int push_scope(void)
    {
        (void)self;
        if (self->ensure_scope_capacity(self->nscope + 1) != 0) return -1;
        self->scope[self->nscope] = self->nvar;
        self->nscope++;
        return 0;
    }

    int pop_scope(void)
    {
        (void)self;
        if (self->nscope <= 0) return self->fail("scope stack underflow");
        self->nscope--;
        self->nvar = self->scope[self->nscope];
        return 0;
    }

    int closure_new(const char *owner)
    {
        struct Closure *c;
        int i;
        (void)self;
        if (self->ensure_closure_capacity(self->nclosure + 1) != 0) return -1;
        c = &self->closures[self->nclosure];
        c->owner = runtime::text::ct_intern(owner ? owner : "");
        if (!c->owner) return self->fail("out of memory");
        c->ret = "";
        /* S1a-0 C2p-4: the parameter rows are pointer rows now; a row the
           literal never fills is the empty spelling, not NULL (`closure_match`
           reads past `nparams` while walking the host prototype).
           C2p-5: the capture rows are pointer rows too. */
        for (i = 0; i < 16; i++) {
            c->ptype[i] = "";
            c->pname[i] = "";
            c->cap_name[i] = "";
            c->cap_type[i] = "";
        }
        c->nparams = 0;
        c->body = -1;
        c->is_block = 0;
        c->ncap = 0;
        c->line = 0;
        c->col = 0;
        return self->nclosure++;
    }

    int declare_var(const char *name, const char *type)
    {
        int i;
        (void)self;
        /* `__ct_` names the compiler's own locals and closure products; a user
           declaration could otherwise collide with them in the generated C. */
        if (self->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        if (self->ensure_var_capacity(self->nvar + 1) != 0) return -1;
        i = self->nvar;
        self->vars[i].name = runtime::text::ct_intern(name);
        if (!self->vars[i].name) return self->fail("out of memory");
        self->vars[i].type = runtime::text::ct_intern(type);
        if (!self->vars[i].type) return self->fail("out of memory");
        self->vars[i].cname = runtime::text::ct_intern(name);
        if (!self->vars[i].cname) return self->fail("out of memory");
        self->vars[i].ns = runtime::text::ct_intern("");
        if (!self->vars[i].ns) return self->fail("out of memory");
        self->vars[i].is_global = 0;
        self->vars[i].is_static = 0;
        self->vars[i].imported = 0;
        self->vars[i].ambiguous = 0;
        self->vars[i].is_array = 0;
        self->vars[i].dims = runtime::text::ct_intern("");
        if (!self->vars[i].dims) return self->fail("out of memory");
        self->vars[i].st = -1;
        self->vars[i].owned = 0;
        self->vars[i].own_line = 0;
        self->vars[i].autodrop = 0;
        self->vars[i].path_warned = 0;
        self->vars[i].borrowed = 0;
        self->vars[i].ref_param = 0;
        self->vars[i].out_param = 0;
        self->vars[i].initialized = 0;
        self->vars[i].cview = 0;
        self->vars[i].is_param = 0;
        self->vars[i].is_fnparam = 0;
        self->vars[i].is_const = 0;
        self->vars[i].is_closure = 0;
        self->vars[i].closure_id = -1;
        self->vars[i].is_slice = 0;
        self->vars[i].slice_elem = runtime::text::ct_intern("");
        if (!self->vars[i].slice_elem) return self->fail("out of memory");
        self->vars[i].slice_const = 0;
        self->vars[i].slice_escape = 0;
        self->vars[i].str_escape = 0;
        self->vars[i].str_immortal = 0;
        self->nvar++;
        return 0;
    }

    /* A file-scope variable. `cname` is the C spelling to emit and `ns` the
       declaring namespace in underscore form (empty at the root, and for an
       `extern` declaration whose symbol belongs to a C library). Two imported
       units exporting the same source name make the bare name ambiguous; a
       declaration later in this unit shadows them instead. */
    int declare_global(const char *name, const char *type, const char *cname,
                       const char *ns, int imported)
    {
        int i, k;
        (void)self;
        if (self->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        if (self->ensure_var_capacity(self->nvar + 1) != 0) return -1;
        i = self->nvar;
        self->nvar++;
        self->vars[i].name = runtime::text::ct_intern(name);
        if (!self->vars[i].name) return self->fail("out of memory");
        self->vars[i].type = runtime::text::ct_intern(type);
        if (!self->vars[i].type) return self->fail("out of memory");
        self->vars[i].cname = runtime::text::ct_intern(cname);
        if (!self->vars[i].cname) return self->fail("out of memory");
        self->vars[i].ns = runtime::text::ct_intern(ns);
        if (!self->vars[i].ns) return self->fail("out of memory");
        self->vars[i].is_global = 1;
        self->vars[i].is_static = 0;
        self->vars[i].imported = imported;
        self->vars[i].ambiguous = 0;
        self->vars[i].is_array = 0;
        self->vars[i].dims = runtime::text::ct_intern("");
        if (!self->vars[i].dims) return self->fail("out of memory");
        self->vars[i].st = -1;
        self->vars[i].owned = 0;
        self->vars[i].own_line = 0;
        self->vars[i].autodrop = 0;
        self->vars[i].path_warned = 0;
        self->vars[i].borrowed = 0;
        self->vars[i].ref_param = 0;
        self->vars[i].out_param = 0;
        /* A file-scope object exists (zero- or explicitly initialised) from
           program start, so it satisfies the `out` owning-actual rule. */
        self->vars[i].initialized = 1;
        self->vars[i].cview = 0;
        self->vars[i].is_param = 0;
        self->vars[i].is_fnparam = 0;
        self->vars[i].is_const = 0;
        self->vars[i].is_slice = 0;
        self->vars[i].slice_elem = runtime::text::ct_intern("");
        if (!self->vars[i].slice_elem) return self->fail("out of memory");
        self->vars[i].slice_const = 0;
        self->vars[i].slice_escape = 0;
        self->vars[i].str_escape = 0;
        self->vars[i].str_immortal = 0;
        if (imported)
            for (k = 0; k < i; k++)
                if (self->vars[k].is_global && self->vars[k].imported
                    && strcmp(self->vars[k].name, name) == 0
                    && strcmp(self->vars[k].cname, cname) != 0) {
                    self->vars[k].ambiguous = 1;
                    self->vars[i].ambiguous = 1;
                }
        return i;
    }

    /* An enum member: the type the expression grammar expects is `int`, and
       `is_const` lets the constant-expression check fold it. */
    int declare_const(const char *name, const char *cname, const char *ns, int imported)
    {
        int i;
        (void)self;
        i = self->declare_global(name, "int", cname, ns, imported);
        if (i < 0) return -1;
        self->vars[i].is_const = 1;
        return i;
    }

    int is_const_name(const char *name)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        return (i >= 0) ? self->vars[i].is_const : 0;
    }

    int var_cname(const char *name, char *out, int cap)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        if (i < 0) return -1;
        return (snprintf(out, (size_t)cap, "%s", self->vars[i].cname) >= cap) ? -1 : 0;
    }

    int var_ambiguous(const char *name)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        return (i >= 0) ? self->vars[i].ambiguous : 0;
    }

    /* `A::B::h` in an expression: match the path (underscore form, no trailing
       separator) against the namespace a global was declared in. */
    const char *find_qualified_global(const char *qual, const char *name)
    {
        int i;
        (void)self;
        for (i = self->nvar - 1; i >= 0; i--)
            if (self->vars[i].is_global && strcmp(self->vars[i].name, name) == 0
                && strcmp(self->vars[i].ns, qual) == 0)
                return self->vars[i].cname;
        return (const char *)0;
    }

    int find_var(const char *name)
    {
        int i;
        (void)self;
        for (i = self->nvar - 1; i >= 0; i--)
            if (strcmp(self->vars[i].name, name) == 0) return i;
        return -1;
    }

    int var_type(const char *name, char *out, int cap)
    {
        int i, w;
        (void)self;
        i = self->find_var(name);
        if (i < 0) return -1;
        w = snprintf(out, (size_t)cap, "%s", self->vars[i].type);
        if (w < 0 || w >= cap) return -1;
        return 0;
    }

    /* Rows are keyed by the C spelling, not by the source name: two namespaces
       may each export a `get`, and the mangled names keep them apart. */
    int find_func(const char *cname)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nfunc; i++)
            if (strcmp(self->funcs[i].cname, cname) == 0) return i;
        return -1;
    }

    /* Phase 78 S2b: record an inherent method's parameter annotations. A
       second definition of the same (host, method) overwrites the first, which
       matches the language's single-impl rule. */
    int add_meth_ann(const char *host, const char *name, const int *pann, int nparams)
    {
        char key[160];
        int i, k;
        (void)self;

        meth_host_key(host, key, sizeof key);
        if (!key[0] || !name[0]) return 0;
        i = -1;
        for (k = 0; k < self->nmeth; k++)
            if (strcmp(self->meth[k].host, key) == 0
                && strcmp(self->meth[k].name, name) == 0) {
                i = k;
                break;
            }
        if (i < 0) {
            if (self->ensure_meth_ann_capacity(self->nmeth + 1) != 0) return -1;
            i = self->nmeth;
            self->nmeth++;
        }
        self->meth[i].host = runtime::text::ct_intern(key);
        if (!self->meth[i].host) return self->fail("out of memory");
        self->meth[i].name = runtime::text::ct_intern(name);
        if (!self->meth[i].name) return self->fail("out of memory");
        if (nparams > 0
            && self->ensure_meth_ann_param_capacity(i, nparams) != 0) return -1;
        self->meth[i].nparams = nparams;
        for (k = 0; k < nparams; k++)
            self->meth[i].pann[k] = (k < nparams && pann) ? (char)pann[k] : 0;
        return 0;
    }

    /* Answer the annotations stored for `host::name`; the copy is capped at
       `cap` positions. 0 = found, -1 = no row. */
    int find_meth_ann(const char *host, const char *name, int *pann, int cap)
    {
        char key[160];
        int i, k;
        (void)self;

        meth_host_key(host, key, sizeof key);
        for (i = 0; i < self->nmeth; i++) {
            size_t hl = strlen(self->meth[i].host);
            int hit = strcmp(self->meth[i].host, key) == 0;
            /* A generic template's row is keyed by the template (`Box`), while
               the emitter sees the encoded instance (`Box_int`). A `<row>_`
               prefix names the same template; no pair of templates can collide
               on this because the underscore is the encoding separator. */
            if (!hit && hl > 0 && strncmp(key, self->meth[i].host, hl) == 0
                && key[hl] == '_')
                hit = 1;
            if (!hit || strcmp(self->meth[i].name, name) != 0) continue;
            for (k = 0; k < cap; k++)
                pann[k] = (k < self->meth[i].nparams)
                              ? (int)(unsigned char)self->meth[i].pann[k] : 0;
            return 0;
        }
        return -1;
    }

    /* A plain call names the enclosing namespace first, then the root. Reaching
       into another namespace takes a qualified call (`a::f`, `Type::f`), so a
       bare name that only matches rows elsewhere is refused -- and two rows
       sharing the name is the ambiguity the qualification exists to settle. */
    int resolve_func(const char *name)
    {
        const char *full;
        int i, hits;
        (void)self;

        if (self->ns && self->ns[0]) {
            full = runtime::text::ct_intern_join(self->ns, name);
            if (!full) return self->fail("out of memory");
            i = self->find_func(full);
            if (i >= 0) return i;
        }
        i = self->find_func(name);
        if (i >= 0) return i;
        hits = 0;
        for (i = 0; i < self->nfunc; i++)
            if (strcmp(self->funcs[i].name, name) == 0) hits++;
        if (hits > 1)
            return self->fail("that function is exported by more than one namespace");
        if (hits == 1)
            return self->fail("that function lives in another namespace and needs a qualified call");
        return -1;
    }

    int find_type(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->ntype; i++)
            if (self->types[i] && strcmp(self->types[i], name) == 0) return i;
        return -1;
    }

    int add_type(const char *name, int kind)
    {
        int i;
        (void)self;
        if (self->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        i = self->find_type(name);
        if (i >= 0) {
            /* a struct tag discovered while parsing a type keeps its kind */
            if (self->type_kind[i] == 0) self->type_kind[i] = kind;
            return 0;
        }
        /* A finished alias already owns this spelling; the two would disagree
           about what the name means, so the later declaration is the error. A
           forward row is only the pre-scan's placeholder and does not clash. */
        i = self->find_type_alias(name);
        if (i < 0 && self->ns && self->ns[0]) {
            size_t nl = strlen(self->ns);
            if (strncmp(name, self->ns, nl) == 0)
                i = self->find_type_alias(name + nl);
        }
        if (i >= 0 && !self->taliases[i].forward) {
            char msg[512];
            snprintf(msg, sizeof msg, "type '%s' conflicts with an existing type alias", name);
            return self->fail(msg);
        }
        if (self->ensure_type_capacity(self->ntype + 1) != 0) return -1;
        self->types[self->ntype] = runtime::text::ct_intern(name);
        if (!self->types[self->ntype]) return self->fail("out of memory");
        self->type_kind[self->ntype] = kind;
        self->ntype++;
        return 0;
    }

    /* V29-4: remember what a C typedef stands for. Called by the typedef
       parser once the name is registered; a lookup miss (an opaque header
       type) stays empty and the caller keeps the name as written. */
    int set_type_target(const char *name, const char *target)
    {
        int i;
        i = self->find_type(name);
        if (i < 0) return 0;
        self->type_target[i] = runtime::text::ct_intern(target);
        if (!self->type_target[i]) return self->fail("out of memory");
        return 1;
    }

    int type_target_of(const char *name, char *out, int cap)
    {
        int i;
        i = self->find_type(name);
        if (i < 0 || !self->type_target[i] || !self->type_target[i][0]) return 0;
        snprintf(out, (size_t)cap, "%s", self->type_target[i]);
        return 1;
    }

    const char *type_target_text(const char *name)
    {
        int i;
        i = self->find_type(name);
        if (i < 0 || !self->type_target[i] || !self->type_target[i][0])
            return (const char *)0;
        return self->type_target[i];
    }

    /* S1a-0 C1: the per-unit struct block is one array for plain rows and
       instance rows; capacity is a single total. A realloc moves rows, and no
       caller keeps a `StructDef *` across a call that can add one (audited:
       all readers re-index through `self`). */
    int ensure_struct_capacity(int need)
    {
        int cap;
        struct StructDef *grown;
        (void)self;
        if (need <= self->structcap) return 0;
        cap = self->structcap > 0 ? self->structcap : MAX_STRUCTS + MAX_STRUCT_INSTS;
        while (cap < need && cap < MAX_STRUCTS_MAX + MAX_STRUCT_INSTS_MAX) cap *= 2;
        if (cap > MAX_STRUCTS_MAX + MAX_STRUCT_INSTS_MAX)
            cap = MAX_STRUCTS_MAX + MAX_STRUCT_INSTS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct StructDef *)realloc(self->structs, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->structcap, 0,
               (size_t)(cap - self->structcap) * sizeof(*grown));
        self->structs = grown;
        self->structcap = cap;
        return 0;
    }

    int ensure_struct_field_capacity(int si, int need)
    {
        int cap;
        struct Field *grown;
        (void)self;
        if (si < 0 || si >= self->nstructs) return self->fail("struct table out of range");
        if (need <= self->structs[si].fcap) return 0;
        cap = self->structs[si].fcap > 0 ? self->structs[si].fcap : MAX_FIELDS;
        while (cap < need && cap < MAX_FIELDS_MAX) cap *= 2;
        if (cap > MAX_FIELDS_MAX) cap = MAX_FIELDS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Field *)realloc(self->structs[si].fields,
                                        (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->structs[si].fcap, 0,
               (size_t)(cap - self->structs[si].fcap) * sizeof(*grown));
        self->structs[si].fields = grown;
        self->structs[si].fcap = cap;
        return 0;
    }

    int ensure_tmpl_field_capacity(int ti, int need)
    {
        int cap, n;
        struct StructTmpl *t;
        struct Field *grown;
        (void)self;
        t = ct_tmpls(&n);
        if (!t || ti < 0 || ti >= n) return self->fail("template table out of range");
        if (need <= t[ti].fcap) return 0;
        cap = t[ti].fcap > 0 ? t[ti].fcap : MAX_FIELDS;
        while (cap < need && cap < MAX_FIELDS_MAX) cap *= 2;
        if (cap > MAX_FIELDS_MAX) cap = MAX_FIELDS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Field *)realloc(t[ti].fields, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + t[ti].fcap, 0, (size_t)(cap - t[ti].fcap) * sizeof(*grown));
        t[ti].fields = grown;
        t[ti].fcap = cap;
        return 0;
    }

    int find_struct(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->nstructs; i++)
            if (strcmp(self->structs[i].name, name) == 0) return i;
        return -1;
    }

    int add_struct(const char *name)
    {
        int i;
        (void)self;
        if (!name[0]) return -1;
        i = self->find_struct(name);
        if (i >= 0) return i;
        if (self->ensure_struct_capacity(self->nstructs + 1) != 0) return -1;
        self->structs[self->nstructs].name = runtime::text::ct_intern(name);
        if (!self->structs[self->nstructs].name) return self->fail("out of memory");
        self->structs[self->nstructs].nuse = 0;
        self->structs[self->nstructs].nfields = 0;
        self->structs[self->nstructs].defined = 0;
        self->structs[self->nstructs].line = 0;
        self->structs[self->nstructs].col = 0;
        self->structs[self->nstructs].allow_cycle = 0;
        self->structs[self->nstructs].uses_drop = 0;
        self->structs[self->nstructs].uses_handback = 0;
        self->structs[self->nstructs].has_handback_impl = 0;
        self->structs[self->nstructs].has_drop_impl = 0;
        self->structs[self->nstructs].ntparams = 0;
        self->structs[self->nstructs].is_template = 0;
        self->structs[self->nstructs].is_inst = 0;
        self->structs[self->nstructs].is_pub = 0;
        self->structs[self->nstructs].declared_here = 0;
        self->structs[self->nstructs].owner = -1;
        self->nstructs++;
        return self->nstructs - 1;
    }

    int add_struct_inst(const char *name)
    {
        int i;
        (void)self;
        i = self->find_struct(name);
        if (i >= 0) return i;
        if (self->nstruct_inst >= MAX_STRUCT_INSTS_MAX) return self->fail("out of memory");
        i = self->add_struct(name);
        if (i < 0) return -1;
        self->structs[i].is_inst = 1;
        self->nstruct_inst++;
        return i;
    }

    int find_trait(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < self->ntraits; i++)
            if (strcmp(self->traits[i].name, name) == 0) return i;
        return -1;
    }

    /* S1a-0 C1: the trait table itself moves with `realloc`; the per-trait
       method blocks are separate allocations, so a moved row keeps its `m`
       pointer. New rows start zeroed (m = NULL, mcap = 0). */
    int ensure_trait_table_capacity(int need)
    {
        int cap;
        struct Trait *grown;
        (void)self;
        if (need <= self->traitscap) return 0;
        cap = self->traitscap > 0 ? self->traitscap : MAX_TRAITS;
        while (cap < need && cap < MAX_TRAITS_MAX) cap *= 2;
        if (cap > MAX_TRAITS_MAX) cap = MAX_TRAITS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Trait *)realloc(self->traits, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->traitscap, 0,
               (size_t)(cap - self->traitscap) * sizeof(*grown));
        self->traits = grown;
        self->traitscap = cap;
        return 0;
    }

    /* S1a-0 C1: the method rows are a per-trait heap block, so the cap is a
       starting capacity rather than a limit. Doubling is bounded by
       MAX_METHODS_MAX; the caller has an index, never a row address, so the
       `traits` block moving underneath does not matter. */
    int ensure_trait_capacity(int ti, int need)
    {
        int cap;
        struct MethodSig *grown;
        (void)self;
        if (ti < 0 || ti >= self->ntraits) return self->fail("trait table out of range");
        if (need <= self->traits[ti].mcap) return 0;
        cap = self->traits[ti].mcap > 0 ? self->traits[ti].mcap : MAX_METHODS;
        while (cap < need && cap < MAX_METHODS_MAX) cap *= 2;
        if (cap > MAX_METHODS_MAX) cap = MAX_METHODS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct MethodSig *)realloc(self->traits[ti].m,
                                           (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->traits[ti].mcap, 0,
               (size_t)(cap - self->traits[ti].mcap) * sizeof(*grown));
        self->traits[ti].m = grown;
        self->traits[ti].mcap = cap;
        return 0;
    }

    /* S1a-0 C1: a trait method's parameter rows are two heap blocks owned by
       the method row. S1a-0 C2p-4: `ptype` is a pointer row (interned texts),
       like `Fn`'s, and `pann` one byte per position. */
    int ensure_meth_param_capacity(int ti, int mi, int need)
    {
        int cap;
        const char **types;
        char *anns;
        if (ti < 0 || ti >= self->ntraits) return self->fail("trait table out of range");
        /* During signature parsing the row being filled is `nm` (it becomes
           `nm + 1` when the signature closes), so `mi == nm` is valid. */
        if (mi < 0 || mi > self->traits[ti].nm) return self->fail("method table out of range");
        if (need <= self->traits[ti].m[mi].pcap) return 0;
        cap = self->traits[ti].m[mi].pcap > 0 ? self->traits[ti].m[mi].pcap : MAX_PARAMS;
        while (cap < need && cap < MAX_PARAMS_MAX) cap *= 2;
        if (cap > MAX_PARAMS_MAX) cap = MAX_PARAMS_MAX;
        if (need > cap) return self->fail("out of memory");
        types = (const char **)realloc(self->traits[ti].m[mi].ptype,
                                       (size_t)cap * sizeof(*types));
        if (!types) return self->fail("out of memory");
        memset(types + self->traits[ti].m[mi].pcap, 0,
               (size_t)(cap - self->traits[ti].m[mi].pcap) * sizeof(*types));
        self->traits[ti].m[mi].ptype = types;
        anns = (char *)realloc(self->traits[ti].m[mi].pann, (size_t)cap);
        if (!anns) return self->fail("out of memory");
        memset(anns + self->traits[ti].m[mi].pcap, 0,
               (size_t)(cap - self->traits[ti].m[mi].pcap));
        self->traits[ti].m[mi].pann = anns;
        self->traits[ti].m[mi].pcap = cap;
        return 0;
    }

    /* S1a-0 C1: the annotation rows themselves grow on demand. */
    int ensure_meth_ann_capacity(int need)
    {
        int cap;
        struct MethAnn *grown;
        if (need <= self->methcap) return 0;
        cap = self->methcap > 0 ? self->methcap : MAX_METH_ANN;
        while (cap < need && cap < MAX_METH_ANN_MAX) cap *= 2;
        if (cap > MAX_METH_ANN_MAX) cap = MAX_METH_ANN_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct MethAnn *)realloc(self->meth, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->methcap, 0,
               (size_t)(cap - self->methcap) * sizeof(*grown));
        self->meth = grown;
        self->methcap = cap;
        return 0;
    }

    /* S1a-0 C1: an inherent method's ref/out flags grow the same way. */
    int ensure_meth_ann_param_capacity(int mi, int need)
    {
        int cap;
        char *anns;
        if (mi < 0 || mi >= self->nmeth) return self->fail("annotation table out of range");
        if (need <= self->meth[mi].pcap) return 0;
        cap = self->meth[mi].pcap > 0 ? self->meth[mi].pcap : MAX_PARAMS;
        while (cap < need && cap < MAX_PARAMS_MAX) cap *= 2;
        if (cap > MAX_PARAMS_MAX) cap = MAX_PARAMS_MAX;
        if (need > cap) return self->fail("out of memory");
        anns = (char *)realloc(self->meth[mi].pann, (size_t)cap);
        if (!anns) return self->fail("out of memory");
        memset(anns + self->meth[mi].pcap, 0, (size_t)(cap - self->meth[mi].pcap));
        self->meth[mi].pann = anns;
        self->meth[mi].pcap = cap;
        return 0;
    }

    int add_trait(const char *name)
    {
        int i;
        (void)self;
        i = self->find_trait(name);
        if (i >= 0) return i;
        if (self->ensure_trait_table_capacity(self->ntraits + 1) != 0) return -1;
        self->traits[self->ntraits].name = runtime::text::ct_intern(name);
        if (!self->traits[self->ntraits].name) return self->fail("out of memory");
        self->traits[self->ntraits].path = runtime::text::ct_intern("");
        if (!self->traits[self->ntraits].path) return self->fail("out of memory");
        self->traits[self->ntraits].ns = runtime::text::ct_intern("");
        if (!self->traits[self->ntraits].ns) return self->fail("out of memory");
        /* A row reused after the per-unit reset keeps its method block and
           row-block capacities (the old rows are dead, the allocation is not).
           Counts are reset so a stale instance row cannot look like a
           template. */
        self->traits[self->ntraits].nm = 0;
        self->traits[self->ntraits].nargs = 0;
        self->traits[self->ntraits].ntparams = 0;
        self->ntraits++;
        return self->ntraits - 1;
    }

    int trait_inst(const char *tname, int nargs, char **args, char **cargs,
                   int owner)
    {
        const char *enc;
        char msg[MAX_TEXT * 2];
        int ti, ni, mi, pi, pk;

        ti = self->find_trait(tname);
        if (ti < 0) {
            snprintf(msg, sizeof msg, "unknown trait '%s'", tname);
            return self->fail(msg);
        }
        if (self->traits[ti].ntparams == 0) {
            snprintf(msg, sizeof msg, "trait '%s' is not generic", tname);
            return self->fail(msg);
        }
        if (self->traits[ti].ntparams != nargs) {
            snprintf(msg, sizeof msg,
                     "generic trait '%s' takes %d type arguments, %d given",
                     tname, self->traits[ti].ntparams, nargs);
            return self->fail(msg);
        }
        /* Phase 35 S6 (L35-4): the template's owner is the only unit that may
           create an instance row. A consumer naming one would split the vtable
           and the interface layout across two units. */
        if (owner >= 0 && self->traits[ti].owner >= 0 && self->traits[ti].owner != owner)
            return self->fail("a generic trait instance must be created in its owner unit");
        /* `Iter<char *>` and `Iter<char*>` must land on the same row. Nested
           instances keep their source-canonical spelling (`Vec<int>`). */
        enc = ct_inst_encode_text(tname, nargs, args);
        if (!enc) return self->fail("out of memory");
        ni = self->find_trait(enc);
        if (ni >= 0) {
            /* S7 (L35-6): a user-declared trait that happens to carry the
               encoded name is a collision, not a reusable instance row. */
            if (self->traits[ni].tmpl < 0) {
                snprintf(msg, sizeof msg,
                         "trait instance name '%s' collides with a declared type", enc);
                return self->fail(msg);
            }
            return ni;
        }
        {
            /* The generated products are the vtable and iface structs; a user
               declaration of either leaves no room for the instance. */
            const char *gname;
            gname = runtime::text::ct_internf("%s_vtbl", enc);
            if (!gname) return self->fail("out of memory");
            if (self->find_struct(gname) >= 0) {
                return self->fail(runtime::text::ct_internf(
                         "trait instance name '%s' collides with a declared type", enc));
            }
            gname = runtime::text::ct_internf("%s_iface", enc);
            if (!gname) return self->fail("out of memory");
            if (self->find_struct(gname) >= 0) {
                return self->fail(runtime::text::ct_internf(
                         "trait instance name '%s' collides with a declared type", enc));
            }
        }
        ni = self->add_trait(enc);
        if (ni < 0) return -1;
        self->traits[ni].tmpl = ti;
        self->traits[ni].ntparams = 0;
        self->traits[ni].nargs = nargs;
        self->traits[ni].carg = ct_rows_reserve(self->traits[ni].carg,
                                                self->traits[ni].cacap,
                                                nargs, &self->traits[ni].cacap);
        if ((nargs > 0 && !self->traits[ni].carg)
            || self->traits[ni].cacap < nargs)
            return self->fail("out of memory");
        for (pi = 0; pi < nargs; pi++)
            if (ct_row_set(self->traits[ni].carg, pi,
                           args && args[pi] ? args[pi] : "") != 0)
                return self->fail("out of memory");
        /* The instance owns its signatures: grow its own block and copy the
           values. `MethodSig`'s `name`/`ret` are pool pointers now, so the row
           copy shares them; the substitution below replaces `ret` with a fresh
           interned text instead of writing through the template's pointer.
           Sharing `m` would still let a later growth of either row invalidate
           the other, so the block is per-instance. */
        if (self->ensure_trait_capacity(ni, self->traits[ti].nm) != 0) return -1;
        self->traits[ni].nm = self->traits[ti].nm;
        for (mi = 0; mi < self->traits[ti].nm; mi++) {
            self->traits[ni].m[mi] = self->traits[ti].m[mi];
            /* S1a-0 C1: the row assignment shares the template's parameter
               blocks; the instance must own its copies because the
               substitution below rewrites them. */
            self->traits[ni].m[mi].ptype = 0;
            self->traits[ni].m[mi].pann = 0;
            self->traits[ni].m[mi].pcap = 0;
            if (self->traits[ti].m[mi].nparams > 0) {
                if (self->ensure_meth_param_capacity(ni, mi,
                        self->traits[ti].m[mi].nparams) != 0) return -1;
                memcpy(self->traits[ni].m[mi].ptype, self->traits[ti].m[mi].ptype,
                       (size_t)self->traits[ti].m[mi].nparams * sizeof(char *));
                memcpy(self->traits[ni].m[mi].pann, self->traits[ti].m[mi].pann,
                       (size_t)self->traits[ti].m[mi].nparams);
            }
            /* D35-3: the instance owns concrete signatures. The impl parser can
               then run its ordinary return/parameter compatibility checks
               against this row instead of learning about trait parameters.
               S1a-0 C2p-4: the substitution writes fresh interned texts, so a
               2000-byte argument is not cut at a MAX_TEXT scratch row. */
            for (pi = 0; pi < nargs; pi++) {
                const char *sub = cargs && cargs[pi] ? cargs[pi] : "";
                const char *nret = ct_generic_subst_text(self->traits[ni].m[mi].ret,
                                                         self->traits[ti].tparam[pi], sub);
                if (!nret) return self->fail("out of memory");
                self->traits[ni].m[mi].ret = nret;
                for (pk = 0; pk < self->traits[ni].m[mi].nparams; pk++) {
                    const char *ntype =
                        ct_generic_subst_text(self->traits[ni].m[mi].ptype[pk],
                                              self->traits[ti].tparam[pi], sub);
                    if (!ntype) return self->fail("out of memory");
                    self->traits[ni].m[mi].ptype[pk] = ntype;
                }
            }
        }
        self->traits[ni].is_pub = self->traits[ti].is_pub;
        self->traits[ni].is_static = self->traits[ti].is_static;
        self->traits[ni].line = self->traits[ti].line;
        self->traits[ni].path = self->traits[ti].path;
        self->traits[ni].ns = self->traits[ti].ns;
        self->traits[ni].owner = owner;
        if (self->add_type(enc, 3) != 0) return -1;
        return ni;
    }

    int impl_use_concrete(const char *use, int nargs, char **args, char **cargs,
                          int owner, char *out, int cap)
    {
        char tname[MAX_TEXT];
        char enc[MAX_TEXT];
        const char *lt;
        size_t nl;
        int ni;

        lt = strchr(use, '<');
        if (!lt) {
            if (snprintf(out, (size_t)cap, "%s", use) >= cap) return -1;
            return 0;
        }
        nl = (size_t)(lt - use);
        if (nl == 0 || nl >= sizeof tname) return -1;
        memcpy(tname, use, nl);
        tname[nl] = 0;
        if (nargs < 1) return -1;
        if (ct_inst_encode(tname, nargs, args, enc, MAX_TEXT) != 0) return -1;
        ni = self->find_trait(enc);
        if (ni < 0 && owner >= 0)
            ni = self->trait_inst(tname, nargs, args, cargs, owner);
        if (ni < 0) return -1;
        if (snprintf(out, (size_t)cap, "%s", self->traits[ni].name) >= cap) return -1;
        return 0;
    }

    /* Which trait of `stype` declares `method`: the vtable field name and the
       dispatch target both need it. `stype` may carry a `struct ` prefix or a
       trailing `*` (a pointer receiver). */
    int method_trait(const char *stype, const char *method, char *tout, int tcap)
    {
        const char *base;
        const char *key;
        size_t n;
        int s, ti, mi, w;
        (void)self;

        /* S1a-0 C2p-3: the receiver spelling is a pool text; stripping the
           `struct ` prefix and the trailing `*` is a view, not a copy, so a
           2000-byte struct name is not cut at the old 160-byte row. */
        base = stype;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) n--;
        key = runtime::text::ct_intern_len(base, (int)n);
        if (!key) return self->fail("out of memory");
        s = self->find_struct(key);
        if (s < 0) return -1;
        for (ti = 0; ti < self->structs[s].nuse; ti++) {
            int t = self->find_trait(self->structs[s].use[ti]);
            if (t < 0) continue;
            for (mi = 0; mi < self->traits[t].nm; mi++) {
                if (strcmp(self->traits[t].m[mi].name, method) == 0) {
                    w = snprintf(tout, (size_t)tcap, "%s", self->traits[t].name);
                    if (w < 0 || w >= tcap) return -1;
                    return 0;
                }
            }
        }
        return -1;
    }

    const char *method_trait_text(const char *stype, const char *method)
    {
        const char *base;
        const char *key;
        size_t n;
        int s, ti, mi;
        (void)self;

        base = stype;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) n--;
        key = runtime::text::ct_intern_len(base, (int)n);
        if (!key) return (const char *)0;
        s = self->find_struct(key);
        if (s < 0) return (const char *)0;
        for (ti = 0; ti < self->structs[s].nuse; ti++) {
            int t = self->find_trait(self->structs[s].use[ti]);
            if (t < 0) continue;
            for (mi = 0; mi < self->traits[t].nm; mi++)
                if (strcmp(self->traits[t].m[mi].name, method) == 0)
                    return self->traits[t].name;
        }
        return (const char *)0;
    }

    /* SH-46 (19.3): `method_trait` answers with the first match in `use`
       order, and a bare call keeps that resolution (the spec pins it). This
       companion answers whether a *different* trait of the same struct also
       declares `method` -- the call is then ambiguous and the caller names
       both traits in a warning. `first` is the trait `method_trait` already
       named; the same struct `use`ing one trait twice is not ambiguous. */
    const char *method_trait_amb_text(const char *stype, const char *method,
                                      const char *first)
    {
        const char *base;
        const char *key;
        size_t n;
        int s, ti, mi;
        (void)self;

        base = stype;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) n--;
        key = runtime::text::ct_intern_len(base, (int)n);
        if (!key) return (const char *)0;
        s = self->find_struct(key);
        if (s < 0) return (const char *)0;
        for (ti = 0; ti < self->structs[s].nuse; ti++) {
            int t = self->find_trait(self->structs[s].use[ti]);
            if (t < 0) continue;
            if (strcmp(self->traits[t].name, first) == 0) continue;
            for (mi = 0; mi < self->traits[t].nm; mi++)
                if (strcmp(self->traits[t].m[mi].name, method) == 0)
                    return self->traits[t].name;
        }
        return (const char *)0;
    }

    int method_trait_amb(const char *stype, const char *method, const char *first,
                         char *other, int ocap)
    {
        const char *o;
        int w;
        o = self->method_trait_amb_text(stype, method, first);
        if (!o) return -1;
        w = snprintf(other, (size_t)ocap, "%s", o);
        if (w < 0 || w >= ocap) return -1;
        return 0;
    }

    /* A declaration inside `namespace A::B` is stored under its C name,
       `A_B_<name>`; the top level adds no prefix. */
    int ns_decl_name(const char *name, char *out, int cap)
    {
        int w;
        (void)self;
        w = snprintf(out, (size_t)cap, "%s%s", self->ns, name);
        if (w < 0 || w >= cap) return self->fail("name is too long");
        return 0;
    }

    const char *ns_decl_text(const char *name)
    {
        if (!name) name = "";
        if (!self->ns || !self->ns[0]) return runtime::text::ct_intern(name);
        return runtime::text::ct_intern_join(self->ns, name);
    }

    /* Grow the import-alias rows to at least `need`. Mirrors the other S1a-0
       ensure_* blocks: double from the current capacity (24 initially) up to
       MAX_IMPORT_ALIASES_MAX, and fail with the OOM message past that. */
    int ensure_alias_capacity(int need)
    {
        int cap;
        const char **names;
        const char **fulls;
        (void)self;
        if (need <= self->aliascap) return 0;
        cap = self->aliascap > 0 ? self->aliascap : MAX_IMPORT_ALIASES;
        while (cap < need && cap < MAX_IMPORT_ALIASES_MAX) cap *= 2;
        if (cap > MAX_IMPORT_ALIASES_MAX) cap = MAX_IMPORT_ALIASES_MAX;
        if (need > cap) return self->fail("out of memory");
        names = (const char **)realloc(self->alias_name, (size_t)cap * sizeof(*names));
        if (!names) return self->fail("out of memory");
        memset(names + self->aliascap, 0,
               (size_t)(cap - self->aliascap) * sizeof(*names));
        self->alias_name = names;
        fulls = (const char **)realloc(self->alias_full, (size_t)cap * sizeof(*fulls));
        if (!fulls) return self->fail("out of memory");
        memset(fulls + self->aliascap, 0,
               (size_t)(cap - self->aliascap) * sizeof(*fulls));
        self->alias_full = fulls;
        self->aliascap = cap;
        return 0;
    }

    /* Register one `import ... as ...` alias for the current unit. A second
       import that binds the same alias to a different name is ambiguous, so it
       is an error rather than a silent override. */
    int add_alias(const char *name, const char *full)
    {
        int i;
        (void)self;

        for (i = 0; i < self->nalias; i++) {
            if (strcmp(self->alias_name[i], name) != 0) continue;
            if (strcmp(self->alias_full[i], full) == 0) return 0;
            return self->fail("one alias names two imports");
        }
        if (self->ensure_alias_capacity(self->nalias + 1) != 0) return -1;
        self->alias_name[self->nalias] = runtime::text::ct_intern(name);
        if (!self->alias_name[self->nalias]) return self->fail("out of memory");
        self->alias_full[self->nalias] = runtime::text::ct_intern(full);
        if (!self->alias_full[self->nalias]) return self->fail("out of memory");
        self->nalias++;
        return 0;
    }

    /* Grow the exported-type rows to at least `need`. Doubles from the old
       128-row size to the formal ceiling (S1a-0 C2o). */
    int ensure_bare_capacity(int need)
    {
        int cap;
        const char **names;
        const char **fulls;
        int *ambig;
        (void)self;
        if (need <= self->tbcap) return 0;
        cap = self->tbcap > 0 ? self->tbcap : MAX_EXPORTED_TYPES;
        while (cap < need && cap < MAX_EXPORTED_TYPES_MAX) cap *= 2;
        if (cap > MAX_EXPORTED_TYPES_MAX) cap = MAX_EXPORTED_TYPES_MAX;
        if (need > cap) return self->fail("out of memory");
        names = (const char **)realloc(self->tbare, (size_t)cap * sizeof(*names));
        if (!names) return self->fail("out of memory");
        self->tbare = names;
        fulls = (const char **)realloc(self->tfull, (size_t)cap * sizeof(*fulls));
        if (!fulls) return self->fail("out of memory");
        self->tfull = fulls;
        ambig = (int *)realloc(self->tbambig, (size_t)cap * sizeof(*ambig));
        if (!ambig) return self->fail("out of memory");
        self->tbambig = ambig;
        memset(names + self->tbcap, 0, (size_t)(cap - self->tbcap) * sizeof(*names));
        memset(fulls + self->tbcap, 0, (size_t)(cap - self->tbcap) * sizeof(*fulls));
        memset(ambig + self->tbcap, 0, (size_t)(cap - self->tbcap) * sizeof(*ambig));
        self->tbcap = cap;
        return 0;
    }

    /* Record a namespace-qualified export under its bare name. Repeating the
       same pair is a no-op (a forward declaration may precede the body); the
       same bare name pointing at two different C names is ambiguous. */
    int add_bare_type(const char *name, const char *full)
    {
        int i;
        (void)self;

        for (i = 0; i < self->ntb; i++) {
            if (strcmp(self->tbare[i], name) != 0) continue;
            if (strcmp(self->tfull[i], full) == 0) return 0;
            self->tbambig[i] = 1;
            return 0;
        }
        if (self->ensure_bare_capacity(self->ntb + 1) != 0) return -1;
        self->tbare[self->ntb] = runtime::text::ct_intern(name);
        if (!self->tbare[self->ntb]) return self->fail("out of memory");
        self->tfull[self->ntb] = runtime::text::ct_intern(full);
        if (!self->tfull[self->ntb]) return self->fail("out of memory");
        self->tbambig[self->ntb] = 0;
        self->ntb++;
        return 0;
    }

    /* Unqualified lookup: an explicit import alias first, then the current
       namespace, then the top level. */
    int resolve_type(const char *name, char *out, int cap)
    {
        int w, i;
        (void)self;

        for (i = 0; i < self->nalias; i++) {
            if (strcmp(self->alias_name[i], name) != 0) continue;
            w = snprintf(out, (size_t)cap, "%s", self->alias_full[i]);
            if (w < 0 || w >= cap) return self->fail("name is too long");
            return 0;
        }
        if (self->ns && self->ns[0]) {
            /* S1a-0 C2n-1: build the qualified spelling as a pool text, not
               a fixed 160-byte row. The old walk stopped with "name is too
               long" once `ns + name` passed the row, even though no such
               declaration existed and the caller would have kept the short
               spelling. Anything past TEXT_LIMIT cannot name a table row
               either, so only the lookup is skipped, not the caller. */
            const char *qn = runtime::text::ct_intern_join(self->ns, name);
            if (!qn) return self->fail("out of memory");
            if (self->find_type(qn) >= 0 || self->find_trait(qn) >= 0
                || self->find_struct(qn) >= 0) {
                w = snprintf(out, (size_t)cap, "%s", qn);
                if (w < 0 || w >= cap) return self->fail("name is too long");
                return 0;
            }
        }
        /* an exported type from another namespace, reachable by its bare name */
        for (i = 0; i < self->ntb; i++) {
            if (strcmp(self->tbare[i], name) != 0) continue;
            if (self->tbambig[i])
                return self->fail("that type is exported by more than one namespace; import it as an alias");
            w = snprintf(out, (size_t)cap, "%s", self->tfull[i]);
            if (w < 0 || w >= cap) return self->fail("name is too long");
            return 0;
        }
        w = snprintf(out, (size_t)cap, "%s", name);
        if (w < 0 || w >= cap) return self->fail("name is too long");
        return 0;
    }

    const char *resolve_type_text(const char *name)
    {
        int i;
        (void)self;
        if (!name) name = "";
        for (i = 0; i < self->nalias; i++)
            if (strcmp(self->alias_name[i], name) == 0)
                return self->alias_full[i];
        if (self->ns && self->ns[0]) {
            const char *qn = runtime::text::ct_intern_join(self->ns, name);
            if (!qn) return (const char *)0;
            if (self->find_type(qn) >= 0 || self->find_trait(qn) >= 0
                || self->find_struct(qn) >= 0)
                return qn;
        }
        for (i = 0; i < self->ntb; i++) {
            if (strcmp(self->tbare[i], name) != 0) continue;
            /* an ambiguous export has no single spelling; hand back the bare
               name and let the caller's table lookup decide, as the buffer
               version's failure did */
            if (self->tbambig[i]) return runtime::text::ct_intern(name);
            return self->tfull[i];
        }
        return runtime::text::ct_intern(name);
    }
}

impl TypeAliasOps for Symbols {
    int find_type_alias(const char *name)
    {
        int i;
        for (i = 0; i < self->ntalias; i++)
            if (strcmp(self->taliases[i].name, name) == 0) return i;
        return -1;
    }

    /* Start a declaration: insert the row, then push its name on the expansion
       chain so a self reference is reported as a cycle rather than reading an
       empty target. A pre-scanned forward row is reused in place. */
    int begin_type_alias(const char *name, const char *path, int line, int is_pub, int owner)
    {
        int i;
        char msg[512];
        /* The pre-scan runs before any declaration is parsed, so a type that
           appears above the alias was not known then. Check it here, where the
           declaration order is finally known. */
        if (self->find_type(name) >= 0) {
            snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
            return self->fail(msg);
        }
        /* Declarations inside a namespace are stored under the mangled spelling
           (`lib_Thing`), so a trait or typedef declared above is a conflict even
           though the alias keeps its bare name. */
        if (self->ns && self->ns[0]) {
            char qn[MAX_TEXT];
            int w = snprintf(qn, sizeof qn, "%s%s", self->ns, name);
            if (w >= 0 && w < (int)sizeof qn && self->find_type(qn) >= 0) {
                snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
                return self->fail(msg);
            }
        }
        i = self->find_type_alias(name);
        if (i >= 0) {
            if (self->taliases[i].owner == owner) {
                if (!self->taliases[i].forward) {
                    snprintf(msg, sizeof msg,
                             "duplicate type alias '%s' (first at %s:%d)",
                             name, self->taliases[i].path, self->taliases[i].line);
                    return self->fail(msg);
                }
                self->taliases[i].line = line;
                self->taliases[i].is_pub = is_pub;
                self->taliases[i].path = runtime::text::ct_intern(path);
        if (!self->taliases[i].path) return self->fail("out of memory");
                self->taliases[i].forward = 0;
                self->taliases[i].resolving = 1;
                if (self->ntachain >= MAX_ALIAS_CHAIN)
                    return self->fail("type alias expansion is too deep");
                self->tachain[self->ntachain] = runtime::text::ct_intern(name);
                if (!self->tachain[self->ntachain]) return self->fail("out of memory");
                self->ntachain++;
                return 0;
            }
            /* An imported row is just a synonym registered for this unit. A
               local declaration of the same name shadows it in place: the
               local target is what the rest of this unit sees from here on. */
            memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
            self->taliases[i].name = runtime::text::ct_intern(name);
            if (!self->taliases[i].name) return self->fail("out of memory");
            self->taliases[i].path = runtime::text::ct_intern(path);
        if (!self->taliases[i].path) return self->fail("out of memory");
            self->taliases[i].line = line;
            self->taliases[i].is_pub = is_pub;
            self->taliases[i].owner = owner;
            self->taliases[i].resolving = 1;
            if (self->ntachain >= MAX_ALIAS_CHAIN)
                return self->fail("type alias expansion is too deep");
            self->tachain[self->ntachain] = runtime::text::ct_intern(name);
            if (!self->tachain[self->ntachain]) return self->fail("out of memory");
            self->ntachain++;
            return 0;
        }
        if (self->find_type(name) >= 0) {
            snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
            return self->fail(msg);
        }
        for (i = 0; i < self->nalias; i++)
            if (strcmp(self->alias_name[i], name) == 0) {
                snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
                return self->fail(msg);
            }
        if (self->ensure_type_alias_capacity(self->ntalias + 1) != 0) return -1;
        i = self->ntalias;
        self->ntalias++;
        memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
        self->taliases[i].name = runtime::text::ct_intern(name);
        if (!self->taliases[i].name) return self->fail("out of memory");
        self->taliases[i].path = runtime::text::ct_intern(path);
        if (!self->taliases[i].path) return self->fail("out of memory");
        self->taliases[i].line = line;
        self->taliases[i].is_pub = is_pub;
        self->taliases[i].owner = owner;
        self->taliases[i].resolving = 1;
        if (self->ntachain >= MAX_ALIAS_CHAIN)
            return self->fail("type alias expansion is too deep");
        self->tachain[self->ntachain] = runtime::text::ct_intern(name);
        if (!self->tachain[self->ntachain]) return self->fail("out of memory");
        self->ntachain++;
        return 0;
    }

    int finish_type_alias(const char *target)
    {
        int i, g;
        const char *tgt;
        if (self->ntachain <= 0) return self->fail("internal: type alias declaration is not open");
        i = self->find_type_alias(self->tachain[self->ntachain - 1]);
        if (i < 0) return self->fail("internal: type alias declaration is not open");
        tgt = runtime::text::ct_intern(target);
        if (!tgt) return self->fail("out of memory");
        self->taliases[i].target = tgt;
        self->taliases[i].forward = 0;
        self->taliases[i].resolving = 0;
        if (self->ensure_global_type_alias_capacity(self->ngtalias + 1) != 0) return -1;
        g = self->ngtalias;
        self->ngtalias++;
        self->gtaliases[g] = self->taliases[i];
        self->gtaliases[g].forward = 0;
        self->gtaliases[g].resolving = 0;
        self->ntachain--;
        return 0;
    }

    void abort_type_alias(void)
    {
        if (self->ntachain > 0) self->ntachain--;
    }

    /* A name found by the module layer's top-level pre-scan. It only exists so a
       use before the declaration can say why it is not a type; the real row is
       filled by `begin_type_alias` when the parser reaches the declaration. */
    int add_forward_type_alias(const char *name, const char *path, int line, int owner)
    {
        int i;
        if (self->find_type_alias(name) >= 0) return 0;
        if (self->find_type(name) >= 0) return 0;
        if (self->ensure_type_alias_capacity(self->ntalias + 1) != 0) return -1;
        i = self->ntalias;
        self->ntalias++;
        memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
        self->taliases[i].name = runtime::text::ct_intern(name);
        if (!self->taliases[i].name) return self->fail("out of memory");
        self->taliases[i].path = runtime::text::ct_intern(path);
        if (!self->taliases[i].path) return self->fail("out of memory");
        self->taliases[i].line = line;
        self->taliases[i].owner = owner;
        self->taliases[i].forward = 1;
        return 0;
    }

    /* Imported rows are already fully resolved in the declaring unit, so the
       importing unit never needs that unit's private aliases. The same name and
       target from two reachable units is one synonym; different targets are an
       ambiguity. */
    int add_visible_type_alias(const char *name, const char *target, const char *path,
                               int line, int owner)
    {
        int i;
        char msg[512];
        for (i = 0; i < self->ntalias; i++) {
            if (strcmp(self->taliases[i].name, name) != 0) continue;
            if (self->taliases[i].target
                && strcmp(self->taliases[i].target, target) == 0) return 0;
            snprintf(msg, sizeof msg,
                     "type alias '%s' is exported by both %s and %s",
                     name, self->taliases[i].path, path);
            return self->fail(msg);
        }
        if (self->find_type(name) >= 0) {
            snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
            return self->fail(msg);
        }
        for (i = 0; i < self->nalias; i++)
            if (strcmp(self->alias_name[i], name) == 0) {
                snprintf(msg, sizeof msg, "type alias '%s' conflicts with an existing type", name);
                return self->fail(msg);
            }
        if (self->ensure_type_alias_capacity(self->ntalias + 1) != 0) return -1;
        i = self->ntalias;
        self->ntalias++;
        memset(&self->taliases[i], 0, sizeof(self->taliases[i]));
        self->taliases[i].name = runtime::text::ct_intern(name);
        if (!self->taliases[i].name) return self->fail("out of memory");
        self->taliases[i].target = runtime::text::ct_intern(target);
        if (!self->taliases[i].target) return self->fail("out of memory");
        self->taliases[i].path = runtime::text::ct_intern(path);
        if (!self->taliases[i].path) return self->fail("out of memory");
        self->taliases[i].line = line;
        self->taliases[i].owner = owner;
        return 0;
    }

    int find_global_type_alias(const char *name, char *path, int cap, int *line)
    {
        int i;
        for (i = 0; i < self->ngtalias; i++) {
            if (strcmp(self->gtaliases[i].name, name) != 0) continue;
            /* a private alias of another unit is not a name this unit could
               ever import, so it stays an opaque C spelling */
            if (!self->gtaliases[i].is_pub) continue;
            snprintf(path, (size_t)cap, "%s", self->gtaliases[i].path);
            *line = self->gtaliases[i].line;
            return 0;
        }
        return -1;
    }

    /* Expand one bare name. A forward row outside a declaration is a use before
       the declaration; inside a declaration it is deferred as text, so a legal
       forward reference between aliases still resolves at the use site.
       S1a-0 C2p-4: the result is one interned text, so a 2000-byte alias
       target is not cut by the old 160-byte output row. */
    int expand_type_alias_text(const char *name, const char **out)
    {
        int i, k;
        char msg[512];
        const char *pooled;
        i = self->find_type_alias(name);
        if (i < 0) {
            pooled = runtime::text::ct_intern(name);
            if (!pooled) return self->fail("out of memory");
            *out = pooled;
            return 0;
        }
        if (self->taliases[i].forward) {
            if (!self->alias_decl) {
                snprintf(msg, sizeof msg,
                         "type alias '%s' must be declared before it is used", name);
                return self->fail(msg);
            }
            pooled = runtime::text::ct_intern(name);
            if (!pooled) return self->fail("out of memory");
            *out = pooled;
            return 0;
        }
        for (k = 0; k < self->ntachain; k++) {
            int m;
            if (strcmp(self->tachain[k], name) != 0) continue;
            m = snprintf(msg, sizeof msg, "type alias cycle: ");
            for (; k < self->ntachain; k++)
                m += snprintf(msg + m, sizeof msg - (size_t)m, "'%s' -> ", self->tachain[k]);
            snprintf(msg + m, sizeof msg - (size_t)m, "'%s'", name);
            return self->fail(msg);
        }
        if (self->ntachain >= MAX_ALIAS_CHAIN)
            return self->fail("type alias expansion is too deep");
        self->tachain[self->ntachain] = runtime::text::ct_intern(name);
        if (!self->tachain[self->ntachain]) return self->fail("out of memory");
        self->ntachain++;
        if (!self->taliases[i].target || !self->taliases[i].target[0]) {
            self->ntachain--;
            return self->fail("type alias has no target");
        }
        k = self->expand_type_text_text(self->taliases[i].target, out);
        self->ntachain--;
        return k;
    }

    /* Replace every bare identifier that names a visible alias, except the tag
       after `struct` / `enum` / `union` (`struct Alias` is a C tag, not the
       synonym). Whitespace and punctuation are copied verbatim; the host-key
       normaliser strips the former, and the type emitter re-spaces the latter.
       S1a-0 C2p-4: no `id[160]` / `eb[160]` scratch row -- the identifier is
       interned from the source span and the joined text is a dynamic block. */
    int expand_type_text_text(const char *text, const char **out)
    {
        int i = 0, after_tag = 0;
        char *buf = 0;
        int cap = 0;
        const char *pooled;
        if (tool::sh::ct_text_init(&buf, &cap, 64) != 0)
            return self->fail("out of memory");
        while (text[i]) {
            unsigned char c = (unsigned char)text[i];
            if (isalpha(c) || c == '_') {
                int start = i;
                const char *tok, *rep;
                while (text[i] && (isalnum((unsigned char)text[i]) || text[i] == '_')) i++;
                tok = runtime::text::ct_intern_len(text + start, i - start);
                if (!tok) goto oom;
                if (after_tag) {
                    after_tag = 0;
                    if (tool::sh::ct_text_cat(&buf, &cap, tok) != 0) goto toolong;
                } else if (strcmp(tok, "struct") == 0 || strcmp(tok, "enum") == 0
                           || strcmp(tok, "union") == 0) {
                    after_tag = 1;
                    if (tool::sh::ct_text_cat(&buf, &cap, tok) != 0) goto toolong;
                } else {
                    if (self->expand_type_alias_text(tok, &rep) != 0) {
                        tool::sh::ct_text_free(&buf, &cap);
                        return -1;
                    }
                    if (tool::sh::ct_text_cat(&buf, &cap, rep) != 0) goto toolong;
                }
                continue;
            }
            {
                char one[2];
                one[0] = text[i];
                one[1] = 0;
                if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto toolong;
                i++;
                if (c != ' ' && c != '\t' && c != '\n' && c != '\r') after_tag = 0;
            }
        }
        pooled = runtime::text::ct_intern(buf);
        tool::sh::ct_text_free(&buf, &cap);
        if (!pooled) return self->fail("out of memory");
        *out = pooled;
        return 0;
        toolong:
        tool::sh::ct_text_free(&buf, &cap);
        return self->fail("type alias is too long");
        oom:
        tool::sh::ct_text_free(&buf, &cap);
        return self->fail("out of memory");
    }

    /* At the end of a unit every local alias exists, so its exported target can
       be written out in terms of the underlying spelling. An importer then sees
       a self-contained row and never depends on this unit's private names. */
    int resolve_exported_type_aliases(int owner)
    {
        int i;
        const char *out;
        for (i = 0; i < self->ngtalias; i++) {
            if (self->gtaliases[i].owner != owner) continue;
            if (!self->gtaliases[i].target) continue;
            if (self->expand_type_text_text(self->gtaliases[i].target, &out) != 0)
                return -1;
            self->gtaliases[i].target = out;
        }
        for (i = 0; i < self->ntalias; i++) {
            if (self->taliases[i].owner != owner) continue;
            if (!self->taliases[i].target) continue;
            if (self->expand_type_text_text(self->taliases[i].target, &out) != 0)
                return -1;
            self->taliases[i].target = out;
        }
        return 0;
    }
}

/* The instance lives after the impl: its vptr initialiser needs the vtable
   forward declaration the emitter places with the impl. */
static struct Symbols g_symbols;

/* Give the four big tables their backing store. calloc keeps the zero-filled
   semantics the static arrays had, and it runs before any writer -- the parser
   appends to `funcs` directly -- so no access can meet a NULL table. */
static int symbols_grow(struct Symbols *self)
{
    if (!self->funcs) {
        self->funcs = calloc(MAX_FUNCS + 64, sizeof(*self->funcs));
        if (!self->funcs) return -1;
        self->fncap = MAX_FUNCS + 64;
    }
    if (!self->vars) {
        self->vars = calloc(MAX_VARS, sizeof(*self->vars));
        if (!self->vars) return -1;
        self->varcap = MAX_VARS;
    }
    if (!self->scope) {
        self->scope = calloc(MAX_SCOPE, sizeof(*self->scope));
        if (!self->scope) return -1;
        self->scopecap = MAX_SCOPE;
    }
    if (!self->ginsts) {
        self->ginsts = calloc(MAX_GENERIC_INSTS, sizeof(*self->ginsts));
        if (!self->ginsts) return -1;
        self->ginstcap = MAX_GENERIC_INSTS;
    }
    if (!self->traits) {
        self->traits = calloc(MAX_TRAITS, sizeof(*self->traits));
        if (!self->traits) return -1;
        self->traitscap = MAX_TRAITS;
    }
    if (!self->structs) {
        self->structs = calloc(MAX_STRUCTS + MAX_STRUCT_INSTS, sizeof(*self->structs));
        if (!self->structs) return -1;
        self->structcap = MAX_STRUCTS + MAX_STRUCT_INSTS;
    }
    if (!self->closures) {
        self->closures = calloc(MAX_CLOSURES, sizeof(*self->closures));
        if (!self->closures) return -1;
        self->closurecap = MAX_CLOSURES;
    }
    if (!self->taliases) {
        self->taliases = calloc(MAX_TYPE_ALIASES, sizeof(*self->taliases));
        if (!self->taliases) return -1;
        self->taliascap = MAX_TYPE_ALIASES;
    }
    if (!self->gtaliases) {
        self->gtaliases = calloc(MAX_GLOBAL_TYPE_ALIASES, sizeof(*self->gtaliases));
        if (!self->gtaliases) return -1;
        self->gtaliascap = MAX_GLOBAL_TYPE_ALIASES;
    }
    if (!self->types) {
        self->types = (const char **)calloc(MAX_TYPES, sizeof(*self->types));
        if (!self->types) return -1;
        self->type_kind = calloc(MAX_TYPES, sizeof(*self->type_kind));
        if (!self->type_kind) return -1;
        self->type_target = (const char **)calloc(MAX_TYPES, sizeof(*self->type_target));
        if (!self->type_target) return -1;
        self->typecap = MAX_TYPES;
    }
    return 0;
}

struct Symbols *symbols_get(void)
{
    if (!g_symbols.ret_type) g_symbols.ret_type = "";   /* non-NULL before the first body */
    if (!g_symbols.trait_default) g_symbols.trait_default = "";   /* C2p-5: non-NULL outside a default body */
    if (symbols_grow(&g_symbols) != 0) {
        fprintf(stderr, "ctc: out of memory\n");
        exit(1);
    }
    return &g_symbols;
}




/* ---- Phase 29: generic struct templates and instances, build-wide ---- */

/* Allocated on first use and never reset: the per-unit symbol tables are reset
   between units, while an instance's identity and layout must survive so a
   later unit reuses the one the template's owner published (D29-10). */
static struct StructTmpl *g_tmpls;
static int g_ntmpls;
static int g_tmplscap;
static struct StructInst *g_insts;
static int g_ninsts;
static int g_instscap;

/* S1a-0 C1: the three build-wide registries grow on demand. They are never
   reset, so a capacity only moves forward. */
static int tmpls_grow(int need)
{
    int cap;
    struct StructTmpl *grown;

    if (need <= g_tmplscap) return 0;
    cap = g_tmplscap > 0 ? g_tmplscap : MAX_STRUCT_TPLS;
    while (cap < need && cap < MAX_STRUCT_TPLS_MAX) cap *= 2;
    if (cap > MAX_STRUCT_TPLS_MAX) cap = MAX_STRUCT_TPLS_MAX;
    if (need > cap) return -1;
    grown = (struct StructTmpl *)realloc(g_tmpls, (size_t)cap * sizeof(*grown));
    if (!grown) return -1;
    memset(grown + g_tmplscap, 0, (size_t)(cap - g_tmplscap) * sizeof(*grown));
    g_tmpls = grown;
    g_tmplscap = cap;
    return 0;
}

static int insts_grow(int need)
{
    int cap;
    struct StructInst *grown;

    if (need <= g_instscap) return 0;
    cap = g_instscap > 0 ? g_instscap : MAX_STRUCT_INSTS;
    while (cap < need && cap < MAX_STRUCT_INSTS_MAX) cap *= 2;
    if (cap > MAX_STRUCT_INSTS_MAX) cap = MAX_STRUCT_INSTS_MAX;
    if (need > cap) return -1;
    grown = (struct StructInst *)realloc(g_insts, (size_t)cap * sizeof(*grown));
    if (!grown) return -1;
    memset(grown + g_instscap, 0, (size_t)(cap - g_instscap) * sizeof(*grown));
    g_insts = grown;
    g_instscap = cap;
    return 0;
}

struct StructTmpl *ct_tmpls(int *n)
{
    if (!g_tmpls) {
        g_tmpls = calloc(MAX_STRUCT_TPLS, sizeof(*g_tmpls));
        if (g_tmpls) g_tmplscap = MAX_STRUCT_TPLS;
    }
    if (!g_tmpls) {
        if (n) *n = 0;
        return g_tmpls;
    }
    if (n) *n = g_ntmpls;
    return g_tmpls;
}

struct StructInst *ct_insts(int *n)
{
    if (!g_insts) {
        g_insts = calloc(MAX_STRUCT_INSTS, sizeof(*g_insts));
        if (g_insts) g_instscap = MAX_STRUCT_INSTS;
    }
    if (!g_insts) {
        if (n) *n = 0;
        return g_insts;
    }
    if (n) *n = g_ninsts;
    return g_insts;
}

int ct_tmpl_find(const char *name)
{
    int i, n;
    struct StructTmpl *t = ct_tmpls(&n);

    for (i = 0; i < n; i++)
        if (strcmp(t[i].name, name) == 0) return i;
    return -1;
}

int ct_tmpl_add(const char *name, const char *full, int ntprm,
                char **tparams, char **bounds,
                int is_pub, int owner, const char *path, int line)
{
    int i, n, k;
    struct StructTmpl *t;

    i = ct_tmpl_find(name);
    if (i >= 0) return i;
    if (ntprm < 0 || ntprm > MAX_STRUCT_TPARAMS_MAX) return -1;
    if (tmpls_grow(g_ntmpls + 1) != 0) return -1;
    t = ct_tmpls(&n);
    if (!t) return -1;
    n = g_ntmpls;
    t[n].name = runtime::text::ct_intern(name);
    if (!t[n].name) { return -1; }
    t[n].full = runtime::text::ct_intern(full);
    if (!t[n].full) { return -1; }
    t[n].ntparams = ntprm;
    t[n].tparam = ct_rows_reserve(t[n].tparam, t[n].tcap, ntprm, &t[n].tcap);
    if (ntprm > 0 && (!t[n].tparam || t[n].tcap < ntprm)) return -1;
    t[n].bound = ct_rows_reserve(t[n].bound, t[n].bcap, ntprm, &t[n].bcap);
    if (ntprm > 0 && (!t[n].bound || t[n].bcap < ntprm)) return -1;
    for (k = 0; k < ntprm; k++) {
        snprintf(t[n].tparam[k], MAX_TEXT, "%s", tparams && tparams[k] ? tparams[k] : "");
        snprintf(t[n].bound[k], MAX_TEXT, "%s", bounds && bounds[k] ? bounds[k] : "");
    }
    t[n].nfields = 0;
    t[n].nuse = 0;
    t[n].uses_drop = 0;
    t[n].uses_handback = 0;
    t[n].is_pub = is_pub;
    t[n].owner = owner;
    snprintf(t[n].path, 1024, "%s", path);
    t[n].line = line;
    g_ntmpls++;
    return n;
}

int ct_inst_find(const char *name)
{
    int i, n;
    struct StructInst *t = ct_insts(&n);

    for (i = 0; i < n; i++)
        if (strcmp(t[i].name, name) == 0) return i;
    return -1;
}

int ct_inst_add(const char *name, const char *tmpl, int nargs,
                char **args, char **cargs,
                int owner, int carried, int line, int col)
{
    int i, n, k;
    struct StructInst *t;

    if (nargs < 0 || nargs > MAX_STRUCT_TPARAMS_MAX) return -1;
    i = ct_inst_find(name);
    t = ct_insts(&n);
    if (i >= 0) {
        /* The same encoding must always mean the same argument list (L29-5). */
        if (t[i].nargs != nargs) return -2;
        for (k = 0; k < nargs; k++) {
            if (!t[i].carg[k] || !args || !args[k]
                || strcmp(t[i].carg[k], args[k]) != 0) return -2;
        }
        if (carried && !t[i].carried) t[i].carried = 1;
        return i;
    }
    if (insts_grow(g_ninsts + 1) != 0) return -1;
    t = ct_insts(&n);
    if (!t) return -1;
    n = g_ninsts;
    t[n].name = runtime::text::ct_intern(name);
    if (!t[n].name) return -1;
    t[n].tmpl = runtime::text::ct_intern(tmpl);
    if (!t[n].tmpl) return -1;
    t[n].nargs = nargs;
    t[n].carg = ct_rows_reserve(t[n].carg, t[n].acap, nargs, &t[n].acap);
    if (nargs > 0 && (!t[n].carg || t[n].acap < nargs)) return -1;
    t[n].ctype = ct_rows_reserve(t[n].ctype, t[n].ccap, nargs, &t[n].ccap);
    if (nargs > 0 && (!t[n].ctype || t[n].ccap < nargs)) return -1;
    for (k = 0; k < nargs; k++) {
        if (ct_row_set(t[n].carg, k, args && args[k] ? args[k] : "") != 0)
            return -1;
        if (ct_row_set(t[n].ctype, k, cargs && cargs[k] ? cargs[k] : "") != 0)
            return -1;
    }
    t[n].owner = owner;
    t[n].carried = carried;
    t[n].line = line;
    t[n].col = col;
    g_ninsts++;
    return n;
}

/* ---- Phase 29: `impl` blocks written against a template ---- */

static struct StructImpl *g_impls;
static int g_nimpls;
static int g_implscap;

static int impls_grow(int need)
{
    int cap;
    struct StructImpl *grown;

    if (need <= g_implscap) return 0;
    cap = g_implscap > 0 ? g_implscap : MAX_STRUCT_IMPLS;
    while (cap < need && cap < MAX_STRUCT_IMPLS_MAX) cap *= 2;
    if (cap > MAX_STRUCT_IMPLS_MAX) cap = MAX_STRUCT_IMPLS_MAX;
    if (need > cap) return -1;
    grown = (struct StructImpl *)realloc(g_impls, (size_t)cap * sizeof(*grown));
    if (!grown) return -1;
    memset(grown + g_implscap, 0, (size_t)(cap - g_implscap) * sizeof(*grown));
    g_impls = grown;
    g_implscap = cap;
    return 0;
}

struct StructImpl *ct_impls(int *n)
{
    if (!g_impls) {
        g_impls = calloc(MAX_STRUCT_IMPLS, sizeof(*g_impls));
        if (g_impls) g_implscap = MAX_STRUCT_IMPLS;
    }
    if (!g_impls) {
        if (n) *n = 0;
        return g_impls;
    }
    if (n) *n = g_nimpls;
    return g_impls;
}

int ct_impl_find(const char *tmpl, int nargs, char **pats, const char *use)
{
    int i, n, k, ok;
    struct StructImpl *t = ct_impls(&n);

    for (i = 0; i < n; i++) {
        if (strcmp(t[i].tmpl, tmpl) != 0) continue;
        if (t[i].nargs != nargs) continue;
        ok = 1;
        for (k = 0; k < nargs; k++)
            if (!t[i].pat[k] || !pats || !pats[k]
                || strcmp(t[i].pat[k], pats[k]) != 0) {
                ok = 0;
                break;
            }
        if (!ok) continue;
        if (strcmp(t[i].use, use) != 0) continue;
        return i;
    }
    return -1;
}

int ct_impl_add(const char *tmpl, int ntprm, char **tparams,
                int nargs, char **pats, const char *use,
                int node, int owner, int line)
{
    int i, n, k;
    struct StructImpl *t = ct_impls(&n);

    if (ntprm < 0 || ntprm > MAX_STRUCT_TPARAMS_MAX
        || nargs < 0 || nargs > MAX_STRUCT_TPARAMS_MAX) return -1;
    i = ct_impl_find(tmpl, nargs, pats, use);
    if (i >= 0) return i;
    if (impls_grow(g_nimpls + 1) != 0) return -1;
    t = ct_impls(&n);
    if (!t) return -1;
    n = g_nimpls;
    t[n].tmpl = runtime::text::ct_intern(tmpl);
    if (!t[n].tmpl) return -1;
    t[n].ntparams = ntprm;
    t[n].tparam = ct_rows_reserve(t[n].tparam, t[n].tcap, ntprm, &t[n].tcap);
    if (ntprm > 0 && (!t[n].tparam || t[n].tcap < ntprm)) return -1;
    t[n].nargs = nargs;
    t[n].pat = ct_rows_reserve(t[n].pat, t[n].pcap, nargs, &t[n].pcap);
    if (nargs > 0 && (!t[n].pat || t[n].pcap < nargs)) return -1;
    for (k = 0; k < ntprm; k++)
        snprintf(t[n].tparam[k], MAX_TEXT, "%s",
                 tparams && tparams[k] ? tparams[k] : "");
    for (k = 0; k < nargs; k++)
        snprintf(t[n].pat[k], MAX_TEXT, "%s", pats && pats[k] ? pats[k] : "");
    t[n].use = runtime::text::ct_intern(use);
    if (!t[n].use) return -1;
    t[n].node = node;
    t[n].owner = owner;
    t[n].line = line;
    g_nimpls++;
    return n;
}

/* Phase 33 S5: patterns nest (`Box<T>`, `Pair<int, Box<T>>`). The matcher walks
   the pattern spelling and the instance's argument spellings together; a
   parameter binds the *C spelling* of whatever it matched, however deep, which
   is what a method body's `T` has to become. */


static int impl_tparam(struct StructImpl *t, const char *pat)
{
    int i;
    for (i = 0; i < t->ntparams; i++)
        if (t->tparam[i] && strcmp(pat, t->tparam[i]) == 0) return i;
    return -1;
}

/* S1a-0 C3: `vals`/`set` are indexed by type-parameter position, so the walk
   is no longer fixed at two slots. A nested pattern gets its own row block, so
   a recursive `impl_match` never invalidates the parent's arguments. */
static int impl_match(int ii, const char *pat, const char *arg,
                      const char *cspell, char **vals, int *set, int depth)
{
    char name[MAX_TEXT], base[MAX_TEXT], cbase[MAX_TEXT];
    char **pargs = 0;
    int pcap = 0, need, na, pi, k, n, ai;
    struct StructImpl *t = ct_impls(&n);

    if (!t || ii < 0 || ii >= n || depth > 8) return 0;
    pi = impl_tparam(&t[ii], pat);
    if (pi >= 0) {
        if (set[pi]) return strcmp(vals[pi], cspell) == 0;
        set[pi] = 1;
        snprintf(vals[pi], MAX_TEXT, "%s", cspell);
        return 1;
    }
    need = ct_inst_arg_count(pat);
    if (need <= 0) {
        impl_arg_canon(pat, base, sizeof base);
        impl_arg_canon(arg, cbase, sizeof cbase);
        return strcmp(base, cbase) == 0;
    }
    pargs = ct_rows_reserve(0, 0, need, &pcap);
    if (!pargs || pcap < need) return 0;
    if (!impl_pat_split(pat, name, pargs, pcap, &na)) return 0;
    impl_arg_canon(arg, cbase, sizeof cbase);
    ai = ct_inst_find(cbase);
    if (ai < 0) return 0;
    {
        struct StructInst *ins = ct_insts(&k);
        if (!ins || k <= ai) return 0;
        if (strcmp(ins[ai].tmpl, name) != 0 || ins[ai].nargs != na) return 0;
        for (k = 0; k < na; k++)
            if (!impl_match(ii, pargs[k], ins[ai].carg[k], ins[ai].ctype[k],
                            vals, set, depth + 1))
                return 0;
    }
    return 1;
}

/* The pattern of a block is either one of its declared parameters (a wildcard,
   bound to the instance's argument) or a concrete spelling; patterns nest, and
   a parameter written twice must receive the same argument both times. */
int ct_impl_matches(int ii, int inst)
{
    int k, n, nins, nt, *set;
    char **vals = 0;
    int vcap = 0;
    struct StructImpl *t = ct_impls(&n);
    struct StructInst *ins = ct_insts(&nins);

    if (!t || !ins || ii < 0 || ii >= n || inst < 0 || inst >= nins) return 0;
    if (strcmp(t[ii].tmpl, ins[inst].tmpl) != 0) return 0;
    if (t[ii].nargs != ins[inst].nargs) return 0;
    nt = t[ii].ntparams;
    set = 0;
    if (nt > 0) {
        vals = ct_rows_reserve(0, 0, nt, &vcap);
        set = (int *)calloc((size_t)nt, sizeof(*set));
        if (!vals || vcap < nt || !set) return 0;
    }
    for (k = 0; k < ins[inst].nargs; k++)
        if (!impl_match(ii, t[ii].pat[k], ins[inst].carg[k], ins[inst].ctype[k],
                        vals, set, 0))
            return 0;
    for (k = 0; k < nt; k++)
        if (!set[k]) return 0;
    return 1;
}

/* Phase 32 S6 / 33 S5: the same pattern walk as `ct_impl_matches`, but it also
   hands back what each parameter binds to -- the C spelling of the matched
   argument, however deep in the pattern it sat. `names`/`values` are row blocks
   with at least `cap` entries and receive one pair per bound parameter. */
int ct_method_bind(int ii, int inst, char **names, char **values, int cap)
{
    int k, n, nins, nt, bound, *set;
    char **vals = 0;
    int vcap = 0;
    struct StructImpl *t = ct_impls(&n);
    struct StructInst *ins = ct_insts(&nins);

    if (!t || !ins || ii < 0 || ii >= n || inst < 0 || inst >= nins) return -1;
    if (cap < 0) return -1;
    if (!ct_impl_matches(ii, inst)) return -1;
    nt = t[ii].ntparams;
    if (nt > cap) return -1;
    if (nt > 0) {
        vals = ct_rows_reserve(0, 0, nt, &vcap);
        set = (int *)calloc((size_t)nt, sizeof(*set));
        if (!vals || vcap < nt || !set) return -1;
    }
    for (k = 0; k < ins[inst].nargs; k++)
        impl_match(ii, t[ii].pat[k], ins[inst].carg[k], ins[inst].ctype[k],
                   vals, set, 0);
    bound = 0;
    for (k = 0; k < nt; k++) {
        if (!set[k]) continue;
        if (!names || !names[k] || !values || !values[k]) continue;
        snprintf(names[k], MAX_TEXT, "%s", t[ii].tparam[k]);
        snprintf(values[k], MAX_TEXT, "%s", vals[k]);
        bound++;
    }
    return bound;
}

/* `Vec<int>` / `struct Vec<int> *` -> `struct Vec_int` plus the trailing
   suffix. A miss means the instance was never created, so the caller keeps the
   original spelling and reports its own diagnostic. */
int ct_inst_resolve(const char *in, char *out, int cap)
{
    char name[MAX_TEXT];
    char tail[MAX_TEXT];
    char enc[MAX_TEXT];
    char cc[MAX_TEXT];
    char **args = 0;
    int acap = 0;
    int need, nargs, found, k, j, nins, ok;
    struct StructInst *ins;

    need = ct_inst_arg_count(in);
    if (need <= 0) return -1;
    args = ct_rows_reserve(0, 0, need, &acap);
    if (!args || acap < need) return -1;
    if (ct_inst_split(in, name, &nargs, args, acap, tail, sizeof tail) != 0) return -1;
    if (nargs <= 0) return -1;
    if (ct_inst_encode(name, nargs, args, enc, sizeof enc) != 0) return -1;
    found = ct_inst_find(enc);
    if (found < 0) {
        /* Phase 31 O2: a nested spelling arrives with C arguments
           (`Vec<struct Vec_int>`), while rows are encoded from the source
           arguments that created them (`Vec<Vec<int>>`). Match the C arguments
           against the rows and print the row's own name. Both sides are
           canonicalized because `char*` and `char *` name the same argument. */
        ins = ct_insts(&nins);
        for (k = 0; ins && k < nins; k++) {
            if (strcmp(ins[k].tmpl, name) != 0 || ins[k].nargs != nargs) continue;
            ok = 1;
            for (j = 0; j < nargs; j++) {
                if (!ins[k].ctype[j] || !args[j]
                    || ct_type_canon(ins[k].ctype[j], cc, sizeof cc) != 0
                    || strcmp(cc, args[j]) != 0) {
                    ok = 0;
                    break;
                }
            }
            if (!ok) continue;
            found = k;
            break;
        }
        if (found >= 0) {
            k = snprintf(out, (size_t)cap, "struct %s%s", ins[found].name, tail);
            if (k < 0 || k >= cap) return -1;
            return 0;
        }
    }
    if (found < 0) return -1;
    k = snprintf(out, (size_t)cap, "struct %s%s", enc, tail);
    if (k < 0 || k >= cap) return -1;
    return 0;
}

/* ---- Phase 84: the ADT registry ----
   Allocated on first use and never reset, for the same reason the template
   registries are build-wide: a consumer unit reads the variants of a `pub`
   header ADT after the owner's per-unit tables are gone. */
static struct Adt *g_adts;
static int g_nadts;
static int g_adtcap;

/* S1a-0 C3: double the ADT table to hold `need` rows. The rows hold pointers to
   their own variant/field blocks, so a realloc moves the rows only. -1 is OOM or
   the formal ceiling (`MAX_ADTS_MAX`), which the caller reports as a capacity
   error. */
static int adt_ensure(int need)
{
    int cap;
    struct Adt *p;

    if (need <= g_adtcap) return 0;
    if (need > MAX_ADTS_MAX) return -1;
    cap = g_adtcap > 0 ? g_adtcap : MAX_ADTS;
    while (cap < need) {
        if (cap > MAX_ADTS_MAX / 2) {
            cap = MAX_ADTS_MAX;
            break;
        }
        cap *= 2;
    }
    p = realloc(g_adts, (size_t)cap * sizeof(*g_adts));
    if (!p) return -1;
    g_adts = p;
    g_adtcap = cap;
    return 0;
}

struct Adt *ct_adts(int *n)
{
    if (!g_adts && adt_ensure(MAX_ADTS) != 0) {
        if (n) *n = 0;
        return 0;
    }
    if (n) *n = g_nadts;
    return g_adts;
}

/* The variant block of one ADT. `need` is the count the caller is about to
   store, so the block always has room for it. */
static int adt_ensure_variants(int adt, int need)
{
    int cap;
    struct AdtVariant *p;

    if (!g_adts || adt < 0 || adt >= g_nadts) return -1;
    if (need <= g_adts[adt].vcap) return 0;
    if (need > MAX_ADT_VARIANTS_MAX) return -1;
    cap = g_adts[adt].vcap > 0 ? g_adts[adt].vcap : MAX_ADT_VARIANTS;
    while (cap < need) {
        if (cap > MAX_ADT_VARIANTS_MAX / 2) {
            cap = MAX_ADT_VARIANTS_MAX;
            break;
        }
        cap *= 2;
    }
    p = realloc(g_adts[adt].variants, (size_t)cap * sizeof(*p));
    if (!p) return -1;
    g_adts[adt].variants = p;
    g_adts[adt].vcap = cap;
    return 0;
}

/* The payload-field block of one variant. */
static int adt_ensure_fields(int adt, int v, int need)
{
    int cap;
    struct AdtField *p;

    if (!g_adts || adt < 0 || adt >= g_nadts) return -1;
    if (v < 0 || v >= g_adts[adt].nvariants) return -1;
    if (need <= g_adts[adt].variants[v].fcap) return 0;
    if (need > MAX_ADT_FIELDS_MAX) return -1;
    cap = g_adts[adt].variants[v].fcap > 0 ? g_adts[adt].variants[v].fcap
                                           : MAX_ADT_FIELDS;
    while (cap < need) {
        if (cap > MAX_ADT_FIELDS_MAX / 2) {
            cap = MAX_ADT_FIELDS_MAX;
            break;
        }
        cap *= 2;
    }
    p = realloc(g_adts[adt].variants[v].fields, (size_t)cap * sizeof(*p));
    if (!p) return -1;
    g_adts[adt].variants[v].fields = p;
    g_adts[adt].variants[v].fcap = cap;
    return 0;
}

/* The C tag is the row's identity across units; the source name is the
   fallback for compile mode, where no mangling happened. */
int ct_adt_find(const char *name)
{
    int i, n;
    struct Adt *a = ct_adts(&n);

    if (!name || !name[0]) return -1;
    for (i = 0; a && i < n; i++)
        if (strcmp(a[i].full, name) == 0) return i;
    for (i = 0; a && i < n; i++)
        if (strcmp(a[i].name, name) == 0) return i;
    return -1;
}

int ct_adt_add(const char *name, const char *full, int is_pub, int owner,
               const char *path, int line)
{
    int i, n;
    struct Adt *a = ct_adts(&n);

    if (ct_adt_find(full) >= 0) return -2;
    if (!a || adt_ensure(n + 1) != 0) return -1;
    a = g_adts;
    i = n;
    a[i].name = runtime::text::ct_intern(name ? name : "");
    if (!a[i].name) return -1;
    a[i].full = runtime::text::ct_intern(full ? full : "");
    if (!a[i].full) return -1;
    a[i].nvariants = 0;
    a[i].vcap = 0;
    a[i].variants = 0;
    a[i].is_pub = is_pub;
    a[i].owner = owner;
    snprintf(a[i].path, 1024, "%s", path ? path : "");
    a[i].line = line;
    g_nadts++;
    return i;
}

int ct_adt_variant(int adt, const char *name)
{
    int n, v;
    struct Adt *a = ct_adts(&n);

    if (!a || adt < 0 || adt >= n) return -1;
    for (v = 0; v < a[adt].nvariants; v++)
        if (strcmp(a[adt].variants[v].name, name) == 0) return v;
    return -1;
}

int ct_adt_has_variant(int adt, const char *name)
{
    return ct_adt_variant(adt, name) >= 0 ? 1 : 0;
}

int ct_adt_add_variant(int adt, const char *name, const char *cname, int line, int col)
{
    int n, v;
    struct Adt *a = ct_adts(&n);

    if (!a || adt < 0 || adt >= n) return -1;
    if (adt_ensure_variants(adt, a[adt].nvariants + 1) != 0) return -1;
    a = g_adts;
    v = a[adt].nvariants;
    a[adt].variants[v].name = runtime::text::ct_intern(name ? name : "");
    if (!a[adt].variants[v].name) return -1;
    a[adt].variants[v].cname = runtime::text::ct_intern(cname ? cname : "");
    if (!a[adt].variants[v].cname) return -1;
    a[adt].variants[v].nfields = 0;
    a[adt].variants[v].fcap = 0;
    a[adt].variants[v].fields = 0;
    a[adt].variants[v].line = line;
    a[adt].variants[v].col = col;
    a[adt].nvariants++;
    return v;
}

int ct_adt_add_field(int adt, int v, const char *name, const char *type)
{
    int n, f;
    struct Adt *a = ct_adts(&n);

    if (!a || adt < 0 || adt >= n) return -1;
    if (v < 0 || v >= a[adt].nvariants) return -1;
    if (adt_ensure_fields(adt, v, a[adt].variants[v].nfields + 1) != 0) return -1;
    a = g_adts;
    f = a[adt].variants[v].nfields;
    a[adt].variants[v].fields[f].name = runtime::text::ct_intern(name ? name : "");
    if (!a[adt].variants[v].fields[f].name) return -1;
    a[adt].variants[v].fields[f].type = runtime::text::ct_intern(type ? type : "");
    if (!a[adt].variants[v].fields[f].type) return -1;
    a[adt].variants[v].nfields++;
    return f;
}


int ct_adt_from_type(const char *spelling)
{
    const char *raw;
    const char *base;
    const char *tgt;
    const char *rn;
    struct Symbols *sym;
    int a;

    if (!spelling || !spelling[0]) return -1;
    raw = adt_strip_type_text(spelling);
    if (!raw || !raw[0]) return -1;
    a = ct_adt_find(raw);
    if (a >= 0) return a;
    sym = symbols_get();
    rn = sym->resolve_type_text(raw);
    if (rn && rn[0] && strcmp(rn, raw) != 0) {
        base = adt_strip_type_text(rn);
        if (base) {
            a = ct_adt_find(base);
            if (a >= 0) return a;
        }
    }
    /* a typedef alias records `struct <tag>` as its target (F1) */
    tgt = sym->type_target_text(raw);
    if (tgt) {
        base = adt_strip_type_text(tgt);
        if (base) {
            a = ct_adt_find(base);
            if (a >= 0) return a;
        }
    }
    if (rn && rn[0] && strcmp(rn, raw) != 0) {
        tgt = sym->type_target_text(rn);
        if (tgt) {
            base = adt_strip_type_text(tgt);
            if (base) {
                a = ct_adt_find(base);
                if (a >= 0) return a;
            }
        }
    }
    return -1;
}
