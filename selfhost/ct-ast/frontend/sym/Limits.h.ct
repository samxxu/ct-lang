/*
 * Limits.h.ct - the single authority for ct-ast's capacity caps.
 *
 * Macros do not cross a translation unit: every `.h.ct` unit compiles to its
 * own `.c`, and the generated header carries types only. The cap values
 * therefore have to be repeated in each unit that sizes an array with one.
 * Those copies are *mirrors*, not a second source: this file is the only
 * place a value is chosen, and `tools/limits_sync.py` (run by
 * `selfhost/check-ast.sh`) rewrites/refuses every mirror that drifts.
 *
 * The unit is deliberately not imported: importing it would publish an empty
 * `Limits` type, and the macros would still stay in this unit. It is the
 * source the generator reads, not linkable state.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
namespace frontend::sym;

/* A stateless marker: a unit file is named after its main type. */
pub struct Limits {
    int unused;
}

