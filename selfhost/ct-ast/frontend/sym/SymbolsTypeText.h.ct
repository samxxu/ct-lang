/*
 * SymbolsTypeText.h.ct - moved out of Symbols.h.ct (PH-85 S85c M0, pure move).
 *
 * Bodies are byte-identical to the ones this unit used to hold;
 * the declaration line only loses `static` and gains a `pub`
 * prototype, the interface change the M0 card allows. See
 * docs/design/p85_m0.md for the baseline and the old->new map.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
import runtime::text::Intern;
import tool::sh::Sh;


/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT    160
#define MAX_STRUCT_TPARAMS 2
#define MAX_STRUCT_TPARAMS_MAX 65536

namespace frontend::sym;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct SymbolsTypeText {
    int unused;
}

pub void adt_strip_type(const char *in, char *out, int cap);
/* S1a-0 C2p-5: the pool-text form, so a 2000-byte ADT tag is not cut by a
   caller row before `ct_adt_find` compares it. */
pub const char *adt_strip_type_text(const char *in);
pub int ct_generic_subst(const char *in, const char *word, const char *repl, char *out, int cap);
/* S1a-0 C3: every cap is a starting capacity, not a language limit. A "row
   block" is an array of `char *`, one MAX_TEXT buffer per row; the block grows
   by doubling to MAX_STRUCT_TPARAMS_MAX (the formal/OOM ceiling). Rows are
   zeroed on allocation, and an existing row keeps its buffer across a grow, so
   a caller can reserve once and keep appending. */
pub char **ct_rows_reserve(char **rows, int have, int need, int *got);
/* S1a-0 C2p-6: the same growable block for rows that hold a pool text each
   (`Emitter.gtparam` / `.gtarg`) instead of a fixed MAX_TEXT buffer. No per-row
   buffer is allocated; a new slot is NULL until the caller stores a text. */
pub const char **ct_text_rows_reserve(const char **rows, int have, int need, int *got);
/* The number of top-level type arguments in `Name<a[, b[, …]]>`; 0 when the
   spelling carries no argument list. The parser grows its row block from this
   before calling `ct_inst_split`, so the splitter never truncates. */
pub int ct_inst_arg_count(const char *in);
pub int ct_inst_encode(const char *tmpl, int nargs, char **args, char *out, int cap);
/* S1a-0 C2p-3: the pool-text encoder. The old `buf[MAX_TEXT * 2]` cut the
   template/argument spelling before hashing, and the fixed output row turned a
   long instance identity into "the instantiated name exceeds 159 characters".
   The whole spelling is built and then, past 63 characters, hashed exactly as
   before; the result is one interned text. NULL is OOM / over TEXT_LIMIT. */
pub const char *ct_inst_encode_text(const char *tmpl, int nargs, char **args);
pub int ct_inst_split(const char *in, char *name, int *nargs, char **args, int argcap, char *tail, int cap);
pub int ct_is_container_type(const char *type);
pub int ct_is_string_value_type(const char *type);
pub int ct_type_canon(const char *in, char *out, int cap);
/* S1a-0 C2p-3: the pool-text canonicaliser and substitution, so a 2000-byte
   type argument is not cut at a 160-byte instance row. */
pub const char *ct_type_canon_text(const char *in);
pub const char *ct_generic_subst_text(const char *in, const char *word,
                                      const char *repl);
/* Replace one preallocated row with an exact copy of `s` (freeing the old
   MAX_TEXT block). Returns -1 on OOM. */
pub int ct_row_set(char **rows, int i, const char *s);
pub int generic_tag_prefix(const char *in, const char *p);
pub int generic_word_char(int c);
pub void impl_arg_canon(const char *arg, char *out, int cap);
pub int impl_pat_split(const char *pat, char *name, char **args, int argcap, int *na);
pub int inst_enc_one(const char *arg, char *out, int cap);
pub void meth_host_key(const char *host, char *out, int cap);

/* The bare C name behind a type spelling: whitespace, `*`, `const` / `volatile`
   and the `struct` / `union` keyword are dropped. `Alias *` and
   `const struct lib_Shape *` both answer `Alias` / `lib_Shape`. */
void adt_strip_type(const char *in, char *out, int cap)
{
    const char *b;
    size_t n;

    b = in ? in : "";
    while (*b == ' ' || *b == '\t' || *b == '\n' || *b == '\r') b++;
    n = strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t' || b[n - 1] == '\n'
                     || b[n - 1] == '\r' || b[n - 1] == '*'))
        n--;
    if (n >= (size_t)cap) n = (size_t)cap - 1;
    memcpy(out, b, n);
    out[n] = 0;
    b = out;
    for (;;) {
        if (strncmp(b, "const ", 6) == 0) b += 6;
        else if (strncmp(b, "volatile ", 9) == 0) b += 9;
        else if (strncmp(b, "struct ", 7) == 0) b += 7;
        else if (strncmp(b, "union ", 6) == 0) b += 6;
        else break;
        while (*b == ' ' || *b == '\t') b++;
    }
    if (b != out) memmove(out, b, strlen(b) + 1);
}

const char *adt_strip_type_text(const char *in)
{
    const char *b;
    size_t n;

    b = in ? in : "";
    while (*b == ' ' || *b == '\t' || *b == '\n' || *b == '\r') b++;
    n = strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t' || b[n - 1] == '\n'
                     || b[n - 1] == '\r' || b[n - 1] == '*'))
        n--;
    for (;;) {
        if (n > 6 && strncmp(b, "const ", 6) == 0) { b += 6; n -= 6; }
        else if (n > 9 && strncmp(b, "volatile ", 9) == 0) { b += 9; n -= 9; }
        else if (n > 7 && strncmp(b, "struct ", 7) == 0) { b += 7; n -= 7; }
        else if (n > 6 && strncmp(b, "union ", 6) == 0) { b += 6; n -= 6; }
        else break;
        while (n > 0 && (*b == ' ' || *b == '\t')) { b++; n--; }
    }
    return runtime::text::ct_intern_len(b, (int)n);
}

int ct_generic_subst(const char *in, const char *word, const char *repl, char *out, int cap)
{
    int n, wl, rl;
    const char *p;

    wl = (int)strlen(word);
    rl = (int)strlen(repl);
    n = 0;
    p = in;
    if (wl == 0) {
        if ((int)strlen(in) + 1 > cap) return -1;
        snprintf(out, (size_t)cap, "%s", in);
        return 0;
    }
    while (*p) {
        if ((p == in || !generic_word_char((unsigned char)p[-1]))
            && strncmp(p, word, (size_t)wl) == 0
            && !generic_word_char((unsigned char)p[wl])
            && !generic_tag_prefix(in, p)) {
            if (n + rl + 1 > cap) return -1;
            memcpy(out + n, repl, (size_t)rl);
            n += rl;
            p += wl;
        } else {
            if (n + 2 > cap) return -1;
            out[n] = *p;
            n++;
            p++;
        }
    }
    out[n] = 0;
    return 0;
}

/* Grow a row block to `need` rows. `have` is the current capacity (the
   caller stores the returned `got`); `rows` may be NULL. New rows are
   allocated zeroed, so a later `snprintf` starts from an empty spelling.
   Allocation failure returns the block it could build (never a dangling old
   pointer) with `got` below `need`; the caller reports OOM. */
char **ct_rows_reserve(char **rows, int have, int need, int *got)
{
    char **grown;
    int cap, i;

    if (have < 0) have = 0;
    if (need <= have) {
        if (got) *got = have;
        return rows;
    }
    if (need > MAX_STRUCT_TPARAMS_MAX) {
        if (got) *got = have;
        return rows;
    }
    cap = have > 0 ? have : MAX_STRUCT_TPARAMS;
    while (cap < need && cap < MAX_STRUCT_TPARAMS_MAX) cap *= 2;
    if (cap > MAX_STRUCT_TPARAMS_MAX) cap = MAX_STRUCT_TPARAMS_MAX;
    if (need > cap) {
        if (got) *got = have;
        return rows;
    }
    grown = (char **)realloc(rows, (size_t)cap * sizeof(*grown));
    if (!grown) {
        if (got) *got = have;
        return rows;
    }
    for (i = have; i < cap; i++) {
        grown[i] = (char *)calloc((size_t)MAX_TEXT, 1);
        if (!grown[i]) {
            if (got) *got = i;
            return grown;
        }
    }
    if (got) *got = cap;
    return grown;
}

/* S1a-0 C2p-6: the pool-text variant. The block is the same geometric grow;
   the rows are references, so nothing past `have` is allocated and a new slot
   is NULL until it is bound. */
const char **ct_text_rows_reserve(const char **rows, int have, int need, int *got)
{
    const char **grown;
    int cap, i;

    if (have < 0) have = 0;
    if (need <= have) {
        if (got) *got = have;
        return rows;
    }
    if (need > MAX_STRUCT_TPARAMS_MAX) {
        if (got) *got = have;
        return rows;
    }
    cap = have > 0 ? have : MAX_STRUCT_TPARAMS;
    while (cap < need && cap < MAX_STRUCT_TPARAMS_MAX) cap *= 2;
    if (cap > MAX_STRUCT_TPARAMS_MAX) cap = MAX_STRUCT_TPARAMS_MAX;
    if (need > cap) {
        if (got) *got = have;
        return rows;
    }
    grown = (const char **)realloc((void *)rows, (size_t)cap * sizeof(*grown));
    if (!grown) {
        if (got) *got = have;
        return rows;
    }
    for (i = have; i < cap; i++) grown[i] = (const char *)0;
    if (got) *got = cap;
    return grown;
}

/* S1a-0 C3: count the top-level arguments of the first `<…>` group. The parser
   reserves exactly this many rows before `ct_inst_split`, so no spelling that
   fits the formal limit can be truncated by a two-slot buffer. */
int ct_inst_arg_count(const char *in)
{
    const char *p, *lt;
    int depth, n;

    if (!in) return 0;
    p = in;
    while (*p == ' ' || *p == '\t') p++;
    if (strncmp(p, "struct ", 7) == 0) p += 7;
    lt = strchr(p, '<');
    if (!lt) return 0;
    depth = 1;
    n = 1;
    for (p = lt + 1; *p; p++) {
        if (*p == '<') depth++;
        else if (*p == '>') {
            depth--;
            if (depth == 0) return n;
        } else if (*p == ',' && depth == 1) n++;
    }
    return 0;
}

/* S1a-0 C2p-3: one argument's encoded spelling as a pool text. */
static const char *inst_enc_one_text(const char *arg)
{
    char *buf = 0;
    int cap = 0;
    const char *pooled;
    const char *p = arg ? arg : "";

    if (tool::sh::ct_text_init(&buf, &cap, 32) != 0) return (const char *)0;
    if (strncmp(p, "struct ", 7) == 0) {
        p += 7;
    } else if (strncmp(p, "union ", 6) == 0) {
        p += 6;
        if (tool::sh::ct_text_cat(&buf, &cap, "u_") != 0) goto fail;
    } else if (strncmp(p, "enum ", 5) == 0) {
        p += 5;
        if (tool::sh::ct_text_cat(&buf, &cap, "e_") != 0) goto fail;
    }
    while (*p) {
        const char *rep = "";
        if (*p == '*') rep = "_p";
        else if (*p == ' ') rep = "_";
        else if (*p == '_') rep = "__";
        else if (*p == '<') rep = "_l";
        else if (*p == '>') rep = "_r";
        else if (*p == ',') rep = "_c";
        if (rep[0]) {
            if (tool::sh::ct_text_cat(&buf, &cap, rep) != 0) goto fail;
        } else {
            char one[2];
            one[0] = *p;
            one[1] = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto fail;
        }
        p++;
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

const char *ct_inst_encode_text(const char *tmpl, int nargs, char **args)
{
    char *buf = 0;
    int cap = 0, i, n;
    int h, k;
    const char *enc;
    const char *pooled;

    if (nargs < 0 || nargs > MAX_STRUCT_TPARAMS_MAX) return (const char *)0;
    if (tool::sh::ct_text_init(&buf, &cap, 64) != 0) return (const char *)0;
    if (tool::sh::ct_text_cat(&buf, &cap, tmpl ? tmpl : "") != 0) goto fail;
    for (i = 0; i < nargs; i++) {
        enc = inst_enc_one_text(args && args[i] ? args[i] : "");
        if (!enc) goto fail;
        if (tool::sh::ct_text_cat(&buf, &cap, "_") != 0
            || tool::sh::ct_text_cat(&buf, &cap, enc) != 0) goto fail;
    }
    n = (int)strlen(buf);
    /* Beyond 63 characters the spelling stops being readable in C, so keep a
       prefix and a digest of the whole thing (§2.2 step 5). */
    if (n >= 64) {
        h = 0;
        for (k = 0; k < n; k++) h = (h * 31 + (unsigned char)buf[k]) & 0x7fffffff;
        pooled = runtime::text::ct_internf("%.40s_h%08x", buf, (unsigned int)h);
    } else {
        pooled = runtime::text::ct_intern(buf);
    }
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

int ct_inst_encode(const char *tmpl, int nargs, char **args, char *out, int cap)
{
    const char *enc;
    size_t n;

    enc = ct_inst_encode_text(tmpl, nargs, args);
    if (!enc) return -1;
    n = strlen(enc);
    if (n + 1 > (size_t)cap) return -1;
    memcpy(out, enc, n + 1);
    return 0;
}

/* Split `[struct ]Name<a[, b]>` into the template name, the canonical argument
   spellings and the suffix after `>` (stars, dims). The argument list honours
   nesting (`Vec<Vec<int> >` has one argument) and either arity of the frozen
   cap. Both the emitter (resolve) and the parser (register a nested instance)
   read the same shape through this one scanner. */
int ct_inst_split(const char *in, char *name, int *nargs, char **args, int argcap,
                  char *tail, int cap)
{
    const char *p, *lt, *gt, *base;
    int r, depth, i;

    *nargs = 0;
    tail[0] = 0;
    p = in;
    while (*p == ' ') p++;
    if (strncmp(p, "struct ", 7) == 0) p += 7;
    lt = strchr(p, '<');
    if (!lt) return -1;
    base = p;
    r = (int)(lt - base);
    while (r > 0 && base[r - 1] == ' ') r--;
    if (r <= 0 || r >= cap) return -1;
    memcpy(name, base, (size_t)r);
    name[r] = 0;
    gt = lt;
    depth = 0;
    for (; *gt; gt++) {
        if (*gt == '<') depth++;
        else if (*gt == '>') {
            depth--;
            if (depth == 0) break;
        }
    }
    if (!*gt) return -1;
    {
        const char *a = lt + 1;
        const char *b = a;
        depth = 0;
        for (;;) {
            if (*b == 0 || (*b == ',' && depth == 0) || (b == gt)) {
                int len = (int)(b - a);
                char raw[MAX_TEXT];
                char canon[MAX_TEXT];
                if (*nargs >= argcap || *nargs >= MAX_STRUCT_TPARAMS_MAX
                    || len <= 0 || len >= MAX_TEXT) return -1;
                memcpy(raw, a, (size_t)len);
                raw[len] = 0;
                if (ct_type_canon(raw, canon, sizeof canon) != 0) return -1;
                if (!args || !args[*nargs]) return -1;
                snprintf(args[*nargs], MAX_TEXT, "%s", canon);
                *nargs = *nargs + 1;
                if (b == gt) break;
                a = b + 1;
                b = a;
                continue;
            }
            if (*b == '<') depth++;
            else if (*b == '>') depth--;
            b++;
        }
    }
    i = snprintf(tail, (size_t)cap, "%s", gt + 1);
    if (i < 0 || i >= cap) return -1;
    return 0;
}

/* Phase 29: a by-value built-in container. Trailing blanks are ignored; a
   trailing `*` means the value is a pointer and therefore not a container. */
int ct_is_container_type(const char *type)
{
    size_t n;

    if (type == 0) return 0;
    n = strlen(type);
    while (n > 0 && (type[n - 1] == ' ' || type[n - 1] == '\t')) n--;
    if (n > 0 && type[n - 1] == '*') return 0;
    if (strncmp(type, "struct Vec_", 11) == 0) return 1;
    if (strncmp(type, "struct Map_", 11) == 0) return 1;
    return 0;
}

/* PH-80 SH-102: the two owning string handles whose by-value copies carry a
   reference. The spelling is the parser's canonical `struct <Name>`; the bare
   name is accepted too so a pre-canonical caller cannot silently miss it. */
int ct_is_string_value_type(const char *type)
{
    const char *b;
    size_t n;

    if (type == 0) return 0;
    b = type;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    while (*b == ' ' || *b == '\t') b++;
    n = strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
    if (n == 0 || b[n - 1] == '*' || b[n - 1] == ']') return 0;
    if (n == 6 && strncmp(b, "String", 6) == 0) return 1;
    if (n == 9 && strncmp(b, "U16String", 9) == 0) return 2;
    return 0;
}

/* `char *` -> `char*`, `unsigned   int` -> `unsigned int`, leading and trailing
   blanks dropped. Nothing else is normalized, so the spelling stays readable
   and two spellings that mean the same type still need the same spelling. */
int ct_type_canon(const char *in, char *out, int cap)
{
    int n = 0, sp = 0;
    const char *p = in;

    while (*p == ' ' || *p == '\t') p++;
    while (*p) {
        if (*p == ' ' || *p == '\t') {
            sp = 1;
            p++;
            continue;
        }
        if (*p == '*') {
            sp = 0;
            if (n + 2 > cap) return -1;
            out[n] = '*';
            n++;
            p++;
            continue;
        }
        if (sp && n > 0) {
            if (n + 2 > cap) return -1;
            out[n] = ' ';
            n++;
        }
        sp = 0;
        if (n + 2 > cap) return -1;
        out[n] = *p;
        n++;
        p++;
    }
    out[n] = 0;
    return 0;
}

/* S1a-0 C2p-3: the same normalisation into one interned text. */
const char *ct_type_canon_text(const char *in)
{
    char *buf = 0;
    int cap = 0, sp = 0;
    const char *p = in ? in : "";
    const char *pooled;
    char one[2];

    if (tool::sh::ct_text_init(&buf, &cap, 32) != 0) return (const char *)0;
    while (*p == ' ' || *p == '\t') p++;
    while (*p) {
        if (*p == ' ' || *p == '\t') {
            sp = 1;
            p++;
            continue;
        }
        if (*p == '*') {
            sp = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, "*") != 0) goto fail;
            p++;
            continue;
        }
        if (sp && strlen(buf) > 0) {
            if (tool::sh::ct_text_cat(&buf, &cap, " ") != 0) goto fail;
        }
        sp = 0;
        one[0] = *p;
        one[1] = 0;
        if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto fail;
        p++;
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

/* S1a-0 C2p-3: whole-word substitution into one interned text. */
const char *ct_generic_subst_text(const char *in, const char *word,
                                  const char *repl)
{
    char *buf = 0;
    int cap = 0, wl;
    const char *p = in ? in : "";
    const char *pooled;
    char one[2];

    if (!word || !word[0]) return runtime::text::ct_intern(p);
    if (!repl) repl = "";
    wl = (int)strlen(word);
    if (tool::sh::ct_text_init(&buf, &cap, 32) != 0) return (const char *)0;
    while (*p) {
        if ((p == in || !generic_word_char((unsigned char)p[-1]))
            && strncmp(p, word, (size_t)wl) == 0
            && !generic_word_char((unsigned char)p[wl])
            && !generic_tag_prefix(in, p)) {
            if (tool::sh::ct_text_cat(&buf, &cap, repl) != 0) goto fail;
            p += wl;
        } else {
            one[0] = *p;
            one[1] = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto fail;
            p++;
        }
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

int ct_row_set(char **rows, int i, const char *s)
{
    char *p;
    size_t n;

    if (!rows || i < 0) return -1;
    if (!s) s = "";
    n = strlen(s);
    p = (char *)malloc(n + 1);
    if (!p) return -1;
    memcpy(p, s, n + 1);
    free(rows[i]);
    rows[i] = p;
    return 0;
}

/* Phase 26 fix (SH-63): `struct T` names a tag, not the type parameter. If the
   word is preceded (ignoring spaces) by struct/union/enum, leave it alone. */
int generic_tag_prefix(const char *in, const char *p)
{
    const char *e, *s;
    int n;

    e = p;
    while (e > in && (e[-1] == ' ' || e[-1] == '\t')) e--;
    s = e;
    while (s > in && generic_word_char((unsigned char)s[-1])) s--;
    n = (int)(e - s);
    return (n == 6 && strncmp(s, "struct", 6) == 0)
        || (n == 5 && strncmp(s, "union", 5) == 0)
        || (n == 4 && strncmp(s, "enum", 4) == 0);
}

int generic_word_char(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

/* Strip the C `struct ` prefix and every blank, so `struct Box_int`, `Box_int`
   and the pattern's `Box_int` compare equal. */
void impl_arg_canon(const char *arg, char *out, int cap)
{
    const char *s = arg;
    int n = 0;

    if (strncmp(s, "struct ", 7) == 0) s += 7;
    while (*s && n < cap - 1) {
        if (*s != ' ' && *s != '\t') out[n++] = *s;
        s++;
    }
    out[n] = 0;
}

/* `Name<a, b>` -> name plus the two top-level argument spellings. 0 when the
   spelling is not a template application. */
int impl_pat_split(const char *pat, char *name, char **args, int argcap, int *na)
{
    const char *lt = strchr(pat, '<');
    const char *end, *p, *seg;
    int depth = 0, n = 0, len;

    *na = 0;
    if (!lt) return 0;
    len = (int)strlen(pat);
    if (len == 0 || pat[len - 1] != '>') return 0;
    if ((int)(lt - pat) >= MAX_TEXT) return 0;
    memcpy(name, pat, (size_t)(lt - pat));
    name[(size_t)(lt - pat)] = 0;
    end = pat + len - 1;
    seg = lt + 1;
    for (p = lt + 1; p <= end; p++) {
        if (p == end || (*p == ',' && depth == 0)) {
            char *dst;
            int sl = (int)(p - seg), i = 0;
            if (n >= argcap || n >= MAX_STRUCT_TPARAMS_MAX) return 0;
            dst = args ? args[n] : 0;
            if (!dst) return 0;
            while (sl > 0 && (*seg == ' ' || *seg == '\t')) {
                seg++;
                sl--;
            }
            while (sl > 0 && (seg[sl - 1] == ' ' || seg[sl - 1] == '\t')) sl--;
            if (sl >= MAX_TEXT) sl = MAX_TEXT - 1;
            for (i = 0; i < sl; i++) dst[i] = seg[i];
            dst[sl] = 0;
            n++;
            seg = p + 1;
            continue;
        }
        if (*p == '<') depth++;
        else if (*p == '>') depth--;
    }
    *na = n;
    return n > 0;
}

/* One encoded type argument: `struct Point` -> `Point`, `char*` -> `char_p`,
   `Vec<int>` -> `Vec_l_int_r` (§2.2 step 3). */
int inst_enc_one(const char *arg, char *out, int cap)
{
    int n = 0, rl;
    const char *p = arg;
    const char *rep;

    if (strncmp(p, "struct ", 7) == 0) {
        p += 7;
    } else if (strncmp(p, "union ", 6) == 0) {
        if (n + 3 > cap) return -1;
        out[n] = 'u';
        out[n + 1] = '_';
        n += 2;
        p += 6;
    } else if (strncmp(p, "enum ", 5) == 0) {
        if (n + 3 > cap) return -1;
        out[n] = 'e';
        out[n + 1] = '_';
        n += 2;
        p += 5;
    }
    while (*p) {
        rep = "";
        if (*p == '*') rep = "_p";
        else if (*p == ' ') rep = "_";
        else if (*p == '_') rep = "__";
        else if (*p == '<') rep = "_l";
        else if (*p == '>') rep = "_r";
        else if (*p == ',') rep = "_c";
        rl = (int)strlen(rep);
        if (rl > 0) {
            if (n + rl + 1 > cap) return -1;
            memcpy(out + n, rep, (size_t)rl);
            n += rl;
        } else {
            if (n + 2 > cap) return -1;
            out[n] = *p;
            n++;
        }
        p++;
    }
    out[n] = 0;
    return n;
}

/* Phase 78 S2b: the key an inherent method's annotation is stored under. The
   tag prefix (`struct` / `union`) and the generic argument list are dropped,
   so `Box`, `struct Box` and `struct Box<int>` name the same template host. */
void meth_host_key(const char *host, char *out, int cap)
{
    const char *p;
    int i;

    p = host;
    if (strncmp(p, "struct ", 7) == 0) p += 7;
    else if (strncmp(p, "union ", 6) == 0) p += 6;
    i = 0;
    while (*p && *p != '<' && *p != ' ' && *p != '*' && i + 1 < cap) {
        out[i] = *p;
        i++;
        p++;
    }
    out[i] = 0;
}
