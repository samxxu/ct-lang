/*
 * Module.h.ct - the build driver: unit loading and the output side.
 *
 * The module layer of a `build`: path and import resolution, loading the unit
 * closure, validating a unit's directory against its `namespace`, ordering the
 * units for the incremental cache, and driving the emitter for every unit. The
 * compile-mode entry (`run`) stays with the driver object in
 * tool/driver/Driver.h.ct; this unit holds the state the two share -- the unit
 * table, the run options and the current path -- so those methods are real
 * methods on an object rather than free functions over file-scope globals.
 *
 * Macros do not cross a unit boundary, so the caps and the token kinds used
 * here are declared here; MAX_TEXT 160 is the value
 * `frontend/sym/Symbols.h.ct` lists and MAX_KEY 768 the one
 * `tool/cache/Cache.h.ct` spells.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

import backend::emit::Emitter;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Unit;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import tool::cache::Cache;
import tool::diag::Diag;
import tool::sh::Sh;
import frontend::module::ModuleBoundary;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_UNITS  64
#define MAX_UNITS_MAX 65536
#define MAX_IMPORTS 32
#define MAX_IMPORTS_MAX 65536
#define MAX_INCDIRS 16
#define MAX_INCDIRS_MAX 65536
#define MAX_FLAGS  1024                 /* accumulated --cflags / --ldflags */
#define MAX_CMD    8192                 /* one composed cc command line */
#define MAX_KEY    768                  /* one unit's incremental-cache key */

/* token kinds (the scanner only needs these two) */
#define T_ID     1
#define T_PUNCT  4
#define T_PP     5
/* node kinds: file-scope variables and the two type declarations, the same
   values `Arena.h.ct` assigns */
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_IMPL    33
#define N_ENUM    45
#define N_ENUMVAL 46
#define N_UNION   48

namespace frontend::module;
/* Shell-line helpers for the one-step build (Phase 17.6); defined after the
   impl. They are free functions, not methods: the L2 build path caps impl
   methods per compile, and these need no object state. */
/* `realpath` is POSIX/XSI, and glibc hides its declaration under `-std=c99`
   (strict ANSI) unless a feature-test macro asks for it. Declare the symbol
   here so the build stays flag-free; this is the POSIX.1 prototype. */
extern char *realpath(const char *path, char *resolved);
pub trait ModuleOps {
    int  fail(const char *msg);
    int  fail_emit(const char *msg);
    int  read_file(const char *path);
    int  base_name(const char *path, char *out, int cap, int *is_hdr, int *is_map);
    int  path_dir(const char *path, char *out, int cap);
    /* S1a-0 C1: the three module tables grow by doubling from their old caps
       (MAX_UNITS / MAX_IMPORTS / MAX_INCDIRS) to their `*_MAX` ceiling. */
    int  ensure_unit_capacity(int need);
    int  ensure_incdir_capacity(int need);
    int  ensure_unit_dep_capacity(int u, int need);
    int  ensure_reach(int need);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char *out, int cap,
                        int *is_hdr, int *is_map, int line);
    int  load_unit(const char *path);
    /* Phase 29 E29-5: locate the built-in container layer for `ct build`, with
       the same five probes the compile-mode driver uses. `base` names the file
       inside the layer (`Vec.h.ct`, `Option.h.ct`, `Result.h.ct`). */
    int  find_builtin(const char *in, const char *base, char *out, int cap);
    int  is_builtin_unit(int u);
    int  builtin_slot(int u);
    int  builtin_live_for(int u);
    int  c_boundary_for(const char *path);
    /* PH-82: the package's `leaks = warn|error` key (D-012). 0 = warn (also
       the default and every old package), 1 = error. It resolves from the
       input's package root: an `-I` root with a manifest first, then the
       unit's own directory, so compile mode reads it without `-I` too. */
    int  leaks_for(const char *path);
    /* PH-82: the direct-cycle warning over the `Box<X>` field graph (depth 3). */
    int  cycle_check(void);
    int  io_header_mask(int unit);
    int  io_header_mask_tail(int from);
    int  io_call_count(void);
    const char *io_first_name(int from);
    int  io_first_line(int from);
    int  unit_reaches(int from, int to);
    int  register_visible_type_aliases(int u);
    int  scan_forward_type_aliases(const char *path, int owner);
    int  check_ns_dir(int u);
    /* PH-48 D48-2 (L48-2): every exported `use Drop` struct must publish its
       `<S>_Drop_drop` body from the unit that declares it; an impl written in
       another unit has no prototype in the type's header. */
    int  check_drop_visibility(void);
    /* PH-81: load the Box unit only when an input names it. */
    int  module_src_wants_Box(const char *path);
    int  module_inputs_want_Box(const char **ins, int n);
    int  cache_order(int u, int *state, int *order, int *n);
    int  cache_key_of(int u, char *out, int cap);
    int  lib_scan(int root_u);
    int  build_main(int argc, char **argv);
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  write_header(const char *outc);
    int  write_map(const char *dest, int prog, int u);
    int  write_model(const char *dest, int prog);
}

pub struct Module {
    /* Collaborators the methods reach through; the driver wires them once. */
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct TypeCheck *ty;
    struct Memory *mem;
    struct Parser *p;
    struct Cache *cache;
    /* Output state for one run: the source path the banner and diagnostics
       report. The driver re-points it for each unit in build mode. */
    const char *path;
    /* Build mode: the unit table and the import search roots. These tables have
       element types from this same namespace; a generated header carries no
       `#include`, so their storage lives in this unit's `.c` and the object
       keeps a pointer. */
    struct Unit *units;
    int  nunits;
    int  unitcap;               /* S1a-0 C1: grows from MAX_UNITS on demand */
    int  build_mode;
    /* Array bounds are literals because this struct lands in a generated header
       that carries no macros; 1024 is MAX_PATH. The import roots grow from
       MAX_INCDIRS (16) on demand, so their storage is a heap block too. */
    char outdir[1024];
    const char **incdirs;
    int  ninc;
    int  inccap;
    const char *nsroot;
    /* S1a-0 C1: the reachability walk's scratch row (one byte per unit),
       grown on demand and reused; `unit_reaches` is not re-entrant. */
    char *reach;
    int  reachcap;
    /* Run options. `prog` is the entry name `-v` and the usage lines print
       (D44): `ct` when installed under that name, `ctc` for the compatibility
       alias, `ct-ast` for the development binary. Driver diagnostics keep the
       published `ctc:` prefix (SH-3 / phase10 non-goal). */
    int  line_mode;             /* emit `#line`: 0 off, 1 on */
    /* Phase 29 E29-5: the built-in layer is an implicit dependency of every
       unit, so `Vec` / `Map` work in a multi-unit `ct build` without an import.
       Phase 34 S9a turns it into a set of files: `Vec.h.ct` keeps the
       containers, `Option.h.ct` / `Result.h.ct` carry the ecosystem types.
       `nbuiltin` is 0 when this installation has no layer. */
    int  builtin_units[8];
    int  nbuiltin;
    /* PH-64 T2: a built-in unit is emitted only when the program can reach it.
       Filled once per build, before the emit loop. */
    int  builtin_live[8];      /* slot order, parallel to builtin_units[] */
    int  computed_live;
    int  line_force;            /* -1 mode default, 0 --no-line, 1 --line */
    char map_path[1024];
    int  have_map;
    char model_path[1024];
    int  have_model;
    const char *prog;
    int  diag_json;             /* --diagnostics=json */
    int  diag_codes;            /* --diag-codes: text carries [E-...] / [W-...] */
    int  diag_emitted;          /* build: warnings already printed before emit */
    /* `ct check` (19.4): parse and report the semantic findings, write no C.
       The driver's compile path short-circuits on it after parsing. */
    int  check_mode;
    /* PH-85 S85d: `ct build --check-level=off|warn|error` (0/1/2). SH-115:
       `warn` (1) was the CLI default; v1-PH-1 S3 makes `error` (2) the CLI
       default, so only an explicit 0 keeps the build path silent. */
    int  types_level;
    const char *std_flag;       /* --std=c99 | --std=gnu99 */
    const char *version;        /* CTC_VERSION, bound by the driver */
    /* Phase 17.6: the one-step build. `emit_c` keeps the old emit-only shape
       (`.c` / `.h` into `outdir`, nothing run); otherwise the C goes to
       `outdir` and the binary lands at `exe`. `cc` / `cflags` / `ldflags` are
       pass-through: composed into the line, never parsed or validated. */
    int  emit_c;
    int  lib_mode;              /* Phase 39: ct build --lib */
    int  lib_root;              /* root unit index for --lib */
    int  model_unit;            /* entry unit for --emit-model/-map */
    int  abi_mode;              /* 1 while Emitter writes the ABI header */
    int  abi_exports[256];      /* root function indices in the export set */
    int  abi_n;
    int  runtime_checks;        /* --runtime-checks: guard null vtables in build */
    /* PH-64: `--freestanding` promises the product needs no host runtime: no
       constructor, no libc, no implicit heap. `--alloc A[,B[,C[,D]]]` maps
       malloc/free/realloc/calloc onto the target's own symbols. */
    int  freestanding;
    /* PH-65 R1: the C boundary policy. -1 resolves per path (external strict,
       the CT tree allow, a package manifest may override); 0 = allow,
       1 = strict. */
    int  c_boundary;
    int  show_c_boundary;
    /* PH-66 R1: print the libc I/O headers the program's direct calls need. */
    int  show_io_headers;
    char alloc_map[256];
    const char *exe;
    const char *outdir_opt;
    const char *cc;
    char cflags[1024];          /* MAX_FLAGS: a literal, the header has no macros */
    char ldflags[1024];
} use ModuleOps;

/* Declared here, after the struct, so the parameter spells the mangled type. */
static int ct_pkg_ns_clash(struct Module *m, char *msg, int cap, char *file, int fcap);

/* SH-87: is `word` one of layer unit `u`'s own functions? The list is derived
   from the parsed rows (`fn_start..fn_end`), not written down here, so a new
   helper in `lib/core/Str.h.ct` needs no second edit. */
static int is_layer_fn(struct Symbols *sym, int fn_start, int fn_end, const char *word)
{
    int i;
    for (i = fn_start; i < fn_end; i++)
        if (strcmp(sym->funcs[i].name, word) == 0) return 1;
    return 0;
}



/* Does this source use the built-in `Str` layer?

   Three defects of the first version (battle hw-2): a substring match counted
   `Struct` / `String` / comments (J-2), a single `fread` into a 256 KiB buffer
   dropped the tail of a larger source (J-1), and the layer's lowercase helpers
   (`str_from`, `str_len`) contain no `Str` at all (J-1). So: whole identifiers
   only; comments and literals skipped; a layer function counts only when it is
   called; the whole file is read. */
static int file_uses_str(struct Symbols *sym, const char *path, int fn_start, int fn_end,
                         int u16_only)
{
    FILE *f;
    char *b;
    char word[96];
    size_t cap = 65536, n = 0, k;
    int state = 0, i, wl = 0, pend = 0, hit = 0;

    f = fopen(path, "r");
    if (!f) return 0;
    b = (char *)malloc(cap);
    if (!b) {
        fclose(f);
        return 0;
    }
    for (;;) {
        if (n + 1 >= cap) {
            char *nb = (char *)realloc(b, cap * 2);
            if (!nb) {
                free(b);
                fclose(f);
                return 0;
            }
            b = nb;
            cap *= 2;
        }
        k = fread(b + n, 1, cap - n - 1, f);
        n += k;
        if (k == 0) break;
    }
    fclose(f);
    b[n] = 0;
    for (i = 0; i < (int)n && !hit; i++) {
        char c = b[i];
        if (state == 1) {                    /* `// …` */
            if (c == '\n') state = 0;
            continue;
        }
        if (state == 2) {                    /* a block comment, ends at star-slash */
            if (c == '*' && i + 1 < (int)n && b[i + 1] == '/') {
                state = 0;
                i++;
            }
            continue;
        }
        if (state == 3 || state == 4) {      /* a string or a character literal */
            if (c == '\\' && i + 1 < (int)n) {
                i++;
                continue;
            }
            if ((state == 3 && c == '"') || (state == 4 && c == '\'')) state = 0;
            continue;
        }
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
            if (wl < (int)sizeof word - 1) word[wl++] = c;
            pend = 0;
            continue;
        }
        if (wl > 0) {
            word[wl] = 0;
            wl = 0;
            if (u16_only) {
                if (word_is(word, "U16String")) {
                    hit = 1;
                    break;
                }
            } else if (word_is(word, "Str") || word_is(word, "String")
                       || word_is(word, "U16String")) {
                hit = 1;
                break;
            }
            if (u16_only)
                pend = (strncmp(word, "u16_", 4) == 0
                        || strncmp(word, "ct_u16_", 7) == 0);
            else
                pend = is_layer_fn(sym, fn_start, fn_end, word);
        }
        if (c == '/' && i + 1 < (int)n && b[i + 1] == '/') {
            state = 1;
            i++;
            continue;
        }
        if (c == '/' && i + 1 < (int)n && b[i + 1] == '*') {
            state = 2;
            i++;
            continue;
        }
        if (c == '"') {
            state = 3;
            pend = 0;
            continue;
        }
        if (c == '\'') {
            state = 4;
            pend = 0;
            continue;
        }
        if (c == '(') {
            if (pend) {
                hit = 1;
                break;
            }
            continue;
        }
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') pend = 0;
    }
    if (!hit && wl > 0) {
        word[wl] = 0;
        if (u16_only) {
            if (word_is(word, "U16String")) hit = 1;
        } else if (word_is(word, "Str") || word_is(word, "String")
                   || word_is(word, "U16String")) hit = 1;
    }
    free(b);
    return hit;
}





/* PH-65 R5: two units with the same base both publishing a shim make the
   `#include "<base>.shim.h"` (and the `-I` set) ambiguous. */
static int ct_shim_ambiguity(struct Module *m, const struct Unit *units, int n)
{
    int i, j;

    for (i = 0; i < n; i++) {
        if (!units[i].has_shim) continue;
        for (j = i + 1; j < n; j++) {
            if (!units[j].has_shim) continue;
            if (strcmp(units[i].base, units[j].base) != 0) continue;
            fprintf(stderr, "ctc: shim base name '%s' is ambiguous: %s, %s\n",
                    units[i].base, units[i].path, units[j].path);
            return 1;
        }
    }
    (void)m;
    return 0;
}

/* PH-82: the Box-field graph the direct-cycle warning walks. The symbol
   table's own caps bound it (`Symbols` lists MAX_STRUCTS 128 +
   MAX_STRUCT_INSTS 128 rows and MAX_FIELDS 64), so the adjacency lives in
   fixed arrays instead of a per-run allocation. */
#define CYCLE_ROWS 256
#define CYCLE_DEGREE 64
static int g_cycle_adj[CYCLE_ROWS][CYCLE_DEGREE];
static int g_cycle_nout[CYCLE_ROWS];

/* The unit that declared `si`, so a finding (and a suppression point) names the
   right file after the build walked every unit; `path` is the fallback for a
   compile-mode row whose owner index is not in `units[]`. */
static const char *cycle_file(struct Module *m, int si)
{
    int o = m->sym->structs[si].owner;

    if (o >= 0 && o < m->nunits && m->units[o].path[0]) return m->units[o].path;
    return m->path;
}

/* One `Box<X>` edge: the field's spelling is `struct Box_<enc>`, and the
   instance's `ptr` payload slot names the target (`struct T *`). Anything the
   payload slot cannot name -- a typedef alias, a generic instance, a forward
   declaration -- is not an edge: D-012 keeps typedef/container/generic
   indirection out of the graph instead of guessing through it. */
/* LANG-24: only the built-in `lib/core/Box.h.ct` instance is a cycle edge.
   A project-owned `struct Box<T>` (the historical fixtures) shares the
   `Box_` prefix but is an ordinary struct. */
static int cycle_is_builtin_Box(struct Module *m, const char *name)
{
    int inst, ti, tn;
    struct StructInst *ins;
    struct StructTmpl *tps;
    const char *b = name;

    (void)m;
    if (!b || !b[0]) return 0;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    inst = frontend::sym::ct_inst_find(b);
    if (inst < 0) return 0;
    ins = frontend::sym::ct_insts(&tn);
    if (!ins) return 0;
    ti = frontend::sym::ct_tmpl_find(ins[inst].tmpl);
    tps = frontend::sym::ct_tmpls(&tn);
    if (ti < 0 || !tps) return 0;
    return strstr(tps[ti].path, "lib/core/Box.h.ct") != 0
        || strstr(tps[ti].path, "lib/std/Box.h.ct") != 0;
}

static int cycle_Box_target(struct Module *m, int si, int fi)
{
    const char *t;
    char ptype[MAX_TEXT];
    int bx, pi, n, ti;

    t = m->sym->structs[si].fields[fi].type;
    if (strncmp(t, "struct Box_", 11) == 0) t += 7;
    else if (strncmp(t, "Box_", 4) != 0) return -1;
    if (!cycle_is_builtin_Box(m, t)) return -1;
    bx = m->sym->find_struct(t);
    if (bx < 0 || !m->sym->structs[bx].is_inst) return -1;
    for (pi = 0; pi < m->sym->structs[bx].nfields; pi++)
        if (strcmp(m->sym->structs[bx].fields[pi].name, "ptr") == 0) break;
    if (pi >= m->sym->structs[bx].nfields) return -1;
    snprintf(ptype, sizeof ptype, "%s", m->sym->structs[bx].fields[pi].type);
    n = (int)strlen(ptype);
    while (n > 0 && (ptype[n - 1] == ' ' || ptype[n - 1] == '\t')) ptype[--n] = 0;
    if (n == 0 || ptype[n - 1] != '*') return -1;
    ptype[--n] = 0;
    while (n > 0 && (ptype[n - 1] == ' ' || ptype[n - 1] == '\t')) ptype[--n] = 0;
    t = ptype;
    if (strncmp(t, "struct ", 7) == 0) t += 7;
    else if (strncmp(t, "union ", 6) == 0) t += 6;
    ti = m->sym->find_struct(t);
    if (ti < 0) return -1;
    if (!m->sym->structs[ti].defined) return -1;
    if (m->sym->structs[ti].is_template || m->sym->structs[ti].is_inst) return -1;
    return ti;
}

/* Report one cycle once; `b`/`c` are -1 for a self loop / a two-edge cycle.
   The wording says "may leak ... unless the cycle is broken by hand", never
   "will leak" (D-012). A participant whose declaration line carries the
   ct: allow-cycle marker suppresses the finding; `ct check` still names the
   suppression point so the exemption is auditable. */
static int cycle_emit(struct Module *m, int a, int b, int c)
{
    char chain[MAX_TEXT];
    char msg[MAX_TEXT];
    const char *file;
    int nodes[3], n, i, w, k, mark;

    nodes[0] = a;
    n = 1;
    if (b >= 0) nodes[n++] = b;
    if (c >= 0) nodes[n++] = c;
    chain[0] = 0;
    w = 0;
    for (i = 0; i < n; i++) {
        k = snprintf(chain + w, sizeof chain - (size_t)w, "%s%s",
                     w ? " -> " : "", m->sym->structs[nodes[i]].name);
        if (k < 0 || w + k >= (int)sizeof chain) { w = (int)sizeof chain - 1; break; }
        w += k;
    }
    if (w < (int)sizeof chain - 1) {
        k = snprintf(chain + w, sizeof chain - (size_t)w, " -> %s",
                     m->sym->structs[a].name);
        if (k > 0 && w + k < (int)sizeof chain) w += k;
    }
    mark = -1;
    for (i = 0; i < n; i++)
        if (m->sym->structs[nodes[i]].allow_cycle) { mark = nodes[i]; break; }
    if (mark >= 0) {
        if (!m->check_mode) return 0;
        snprintf(msg, sizeof msg,
                 "reference cycle suppressed by 'ct: allow-cycle': %s", chain);
        return tool::diag::ct_sem_note(m->sym->structs[mark].line,
                                       m->sym->structs[mark].col, msg,
                                       cycle_file(m, mark));
    }
    snprintf(msg, sizeof msg,
             "potential reference cycle: %s; instances may leak unless the cycle is broken by hand",
             chain);
    file = cycle_file(m, a);
    return tool::diag::ct_cycle_warn(m->sym->structs[a].line,
                                     m->sym->structs[a].col, msg, file);
}

/* DOC-87 Stage 1: the built-in layer directory and its environment key were
   renamed (`lib/std` -> `lib/core`, `CT_STD_DIR` -> `CT_CORE_DIR`; DOC-87 迁移).
   The old spellings stay readable for one MINOR, but never silently: each is
   announced once per process. The lookup lives inside `find_builtin` (not in
   file-scope helpers): the self-hosted compiler keeps one whole-program
   function table with a 512-entry budget, and both drivers share this one
   implementation so compile and build mode cannot drift. */
static int g_module_legacy_env_warned;
static int g_module_legacy_path_warned;

/* LANG-24: a source that declares its own `struct Box` keeps that type; the
   built-in layer is not loaded, so the historical generic fixtures and any
   project that already owns the name keep compiling. `Box` is still loaded
   for every program that does not declare it. */
static int module_src_declares_Box(const char *path)
{
    FILE *f;
    char line[1024];
    int after_tag = 0;
    int in_block = 0;

    f = fopen(path, "r");
    if (!f) return 0;
    while (fgets(line, sizeof line, f)) {
        const char *p = line;
        while (*p) {
            if (in_block) {
                while (*p && !(p[0] == '*' && p[1] == '/')) p++;
                if (*p) { p += 2; in_block = 0; }
                continue;
            }
            if (p[0] == '/' && p[1] == '/') break;
            if (p[0] == '/' && p[1] == '*') { p += 2; in_block = 1; continue; }
            if (*p == '"' || *p == '\'') {
                char q = *p;
                p++;
                while (*p && *p != q) { if (*p == '\\' && p[1]) p++; p++; }
                if (*p) p++;
                continue;
            }
            if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                  || (*p >= '0' && *p <= '9') || *p == '_')) {
                if (*p != ' ' && *p != '\t' && *p != '\n' && *p != '\r')
                    after_tag = 0;
                p++;
                continue;
            }
            {
                const char *q = p;
                while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                       || (*q >= '0' && *q <= '9') || *q == '_') q++;
                if ((size_t)(q - p) == 6 && strncmp(p, "struct", 6) == 0) {
                    after_tag = 1;
                } else if ((size_t)(q - p) == 5 && strncmp(p, "union", 5) == 0) {
                    after_tag = 1;
                } else if ((size_t)(q - p) == 4 && strncmp(p, "enum", 4) == 0) {
                    after_tag = 1;
                } else {
                    if (after_tag && (size_t)(q - p) == 3
                        && strncmp(p, "Box", 3) == 0) {
                        fclose(f);
                        return 1;
                    }
                    after_tag = 0;
                }
                p = q;
            }
        }
    }
    fclose(f);
    return 0;
}

impl ModuleOps for Module {
    /* Module failures are about the build itself -- an unreadable input, an
       import that does not resolve, a path that does not fit, a limit. None of
       them has a source position, so they keep the `ctc:` shape. A diagnostic
       that *is* about the source goes through `fail_emit` / the parser. */
    int fail(const char *msg)
    {
        (void)self;
        return frontend::parse::ct_parse_fail_driver(msg);
    }

    /* An emitter failure may blame an AST node (its line is exact) or be about
       the output file (no position at all). */
    int fail_emit(const char *msg)
    {
        int line;
        (void)self;
        line = backend::emit::ct_emit_error_line();
        if (line > 0) return frontend::parse::ct_parse_fail_at(line, msg);
        return frontend::parse::ct_parse_fail_driver(msg);
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        self->lex->src = buf;
        self->lex->srclen = (int)sz;
        return 0;
    }

    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`;
       `foo.m.ct` -> `foo` and `is_map = 1`. */
    int base_name(const char *path, char *out, int cap, int *is_hdr, int *is_map)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        *is_map = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 5 && strcmp(name + n - 5, ".m.ct") == 0) {
            *is_map = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > (size_t)cap) return self->fail("output name is too long");
        snprintf(out, (size_t)cap, "%.*s", (int)n, name);
        return 0;
    }

    int path_dir(const char *path, char *out, int cap)
    {
        const char *slash;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        if (!slash) {
            if (cap < 2) return self->fail("path is too long");
            snprintf(out, (size_t)cap, "%s", ".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        if (n + 1 > (size_t)cap) return self->fail("path is too long");
        snprintf(out, (size_t)cap, "%.*s", (int)n, path);
        return 0;
    }

    /* S1a-0 C1: the unit table doubles from MAX_UNITS; each move rebinds the
       emitter, which holds `units` as a pointer (a realloc invalidates it).
       The new rows are zeroed so a fresh Unit starts at ndep 0 / dep NULL. */
    int ensure_unit_capacity(int need)
    {
        int cap;
        struct Unit *grown;
        (void)self;
        if (need <= self->unitcap) return 0;
        cap = self->unitcap > 0 ? self->unitcap : MAX_UNITS;
        while (cap < need && cap < MAX_UNITS_MAX) cap *= 2;
        if (cap > MAX_UNITS_MAX) cap = MAX_UNITS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Unit *)realloc(self->units, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->unitcap, 0,
               (size_t)(cap - self->unitcap) * sizeof(*grown));
        self->units = grown;
        self->unitcap = cap;
        backend::emit::ct_emit_bind_units(grown);
        return 0;
    }

    /* S1a-0 C1: the `-I` roots double from MAX_INCDIRS; only the table moves,
       the strings stay owned by argv. */
    int ensure_incdir_capacity(int need)
    {
        int cap;
        const char **grown;
        (void)self;
        if (need <= self->inccap) return 0;
        cap = self->inccap > 0 ? self->inccap : MAX_INCDIRS;
        while (cap < need && cap < MAX_INCDIRS_MAX) cap *= 2;
        if (cap > MAX_INCDIRS_MAX) cap = MAX_INCDIRS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (const char **)realloc((void *)self->incdirs,
                                       (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->inccap, 0,
               (size_t)(cap - self->inccap) * sizeof(*grown));
        self->incdirs = grown;
        self->inccap = cap;
        return 0;
    }

    /* S1a-0 C1: one unit's dependency rows (`dep` text + `depu` indices) grow
       together from MAX_IMPORTS; both new halves are zeroed. */
    int ensure_unit_dep_capacity(int u, int need)
    {
        int cap;
        char *deps;
        int *ids;
        (void)self;
        if (need <= self->units[u].depcap) return 0;
        cap = self->units[u].depcap > 0 ? self->units[u].depcap : MAX_IMPORTS;
        while (cap < need && cap < MAX_IMPORTS_MAX) cap *= 2;
        if (cap > MAX_IMPORTS_MAX) cap = MAX_IMPORTS_MAX;
        if (need > cap) return self->fail("out of memory");
        deps = (char *)realloc(self->units[u].dep, (size_t)cap * MAX_TEXT);
        if (!deps) return self->fail("out of memory");
        memset(deps + (size_t)self->units[u].depcap * MAX_TEXT, 0,
               (size_t)(cap - self->units[u].depcap) * MAX_TEXT);
        ids = (int *)realloc(self->units[u].depu, (size_t)cap * sizeof(*ids));
        if (!ids) return self->fail("out of memory");
        memset(ids + self->units[u].depcap, 0,
               (size_t)(cap - self->units[u].depcap) * sizeof(*ids));
        self->units[u].dep = deps;
        self->units[u].depu = ids;
        self->units[u].depcap = cap;
        return 0;
    }

    /* S1a-0 C1: the reachability scratch row used by `unit_reaches`. */
    int ensure_reach(int need)
    {
        int cap;
        char *grown;
        (void)self;
        if (need <= self->reachcap) return 0;
        cap = self->reachcap > 0 ? self->reachcap : MAX_UNITS;
        while (cap < need && cap < MAX_UNITS_MAX) cap *= 2;
        if (cap > MAX_UNITS_MAX) cap = MAX_UNITS_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (char *)realloc(self->reach, (size_t)cap);
        if (!grown) return self->fail("out of memory");
        memset(grown + self->reachcap, 0, (size_t)(cap - self->reachcap));
        self->reach = grown;
        self->reachcap = cap;
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. The dependencies are not loaded yet, so this
       pass only records the paths (`scan_only` keeps `skip_import` from trying
       to resolve aliases against a symbol table that does not have them).
       S1a-0 C1: the list is the parser's growable block; a caller records its
       own slice starting at the current `nrels`, and a recursive load appends
       after it and restores the counter on the way out. The scan itself does
       not reset the counter, or an outer unit's rows would be lost. */
    int scan_imports(const char *from)
    {
        self->p->scan_only = 1;
        self->path = from;
        self->mem->path = self->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->lstart = 0;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        frontend::parse::ct_parse_lex_next();
        for (;;) {
            if (self->lex->tok == T_PP) {
                frontend::parse::ct_parse_lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && self->lex->tok_is("import")) {
                if (frontend::parse::ct_parse_skip_import() != 0) { self->p->scan_only = 0; return -1; }
                continue;
            }
            break;
        }
        self->p->scan_only = 0;
        return 0;
    }

    /* A unit's interface lives in its header, so a `.h.ct` or `.m.ct` unit can
       be imported. Every root is searched (the importer's own directory, then
       the `-I` roots in command-line order). A hit in a second root is a clash,
       not a fallback: two `-I` roots that both ship `Uart` must not let the
       command line pick one silently. Only three pairs are exempt, because in
       each the second hit is the same unit seen twice rather than a competing
       definition: the resolved paths are identical, the root strings are
       identical (a duplicated `-I`), or the first hit came from the importer's
       own directory (which outranks every `-I`, as `test/modules/precedence`
       pins). A root whose package declares the first import segment
       (`namespace = app` in its ct.pkg) is searched for the flat layout
       (`<root>/model/Item.h.ct`) first and the doubled one
       (`<root>/app/model/Item.h.ct`) second, so old trees keep resolving. The
       second pass names a plain `.ct` unit, which is the mistake worth
       reporting. */
    int resolve_import(const char *from, const char *rel, char *out, int cap,
                       int *is_hdr, int *is_map, int line)
    {
        char dir[MAX_PATH];
        char cand[MAX_PATH];
        char first[MAX_PATH];
        char firstroot[MAX_PATH];
        char ncand[MAX_PATH];
        char nfirst[MAX_PATH];
        char nroot[MAX_PATH];
        char nfirstroot[MAX_PATH];
        char msg[MAX_PATH * 2 + MAX_TEXT];
        const char *root;
        FILE *f;
        int r, st, hit, cand_hdr, cand_map, first_local;
        (void)self;

        if (self->path_dir(from, dir, sizeof dir) != 0) return -1;
        *is_hdr = 0;
        *is_map = 0;
        hit = 0;
        first_local = 0;
        first[0] = 0;
        firstroot[0] = 0;
        for (r = -1; r < self->ninc; r++) {
            root = (r < 0) ? dir : self->incdirs[r];
            st = ct_root_find(root, rel, cand, sizeof cand, &cand_hdr, &cand_map,
                              msg, sizeof msg);
            if (st < 0) {
                if (line > 0) return tool::diag::ct_sem_error(line, 1, msg, from);
                return self->fail(msg);
            }
            if (st == 0) continue;
            if (!hit) {
                hit = 1;
                first_local = (r < 0);
                snprintf(first, sizeof first, "%s", cand);
                snprintf(firstroot, sizeof firstroot, "%s", root);
                *is_hdr = cand_hdr;
                *is_map = cand_map;
                continue;
            }
            /* Same unit seen twice: identical file, duplicate `-I`, or the
               importer's own directory already won. Anything else is two roots
               competing for one name and must be reported. The paths are
               normalized first: `-I x` and `-I ./x`, `a/../b`, or a symlinked
               root all name one directory, and comparing the spellings would
               report a clash that is not there. */
            ct_norm_path(cand, ncand, sizeof ncand);
            ct_norm_path(first, nfirst, sizeof nfirst);
            if (strcmp(ncand, nfirst) == 0) continue;
            ct_norm_path(root, nroot, sizeof nroot);
            ct_norm_path(firstroot, nfirstroot, sizeof nfirstroot);
            if (strcmp(nroot, nfirstroot) == 0) continue;
            if (first_local) continue;
            snprintf(msg, sizeof msg,
                     "unit '%s' exists in two import roots: '%s' and '%s'",
                     rel, first, cand);
            if (line > 0) return tool::diag::ct_sem_error(line, 1, msg, from);
            return self->fail(msg);
        }
        if (hit) {
            if (snprintf(out, (size_t)cap, "%s", first) >= cap)
                return self->fail("import path is too long");
            return 0;
        }
        for (r = -1; r < self->ninc; r++) {
            char flat[MAX_TEXT];
            char doubled[MAX_TEXT];
            int nc, ci;
            root = (r < 0) ? dir : self->incdirs[r];
            nc = ct_rel_cands(root, rel, flat, doubled);
            for (ci = 0; ci < nc; ci++) {
                const char *c;
                if (ci == 0) c = flat;
                else c = doubled;
                if (snprintf(cand, sizeof cand, "%s/%s.ct", root, c) >= (int)sizeof cand)
                    return self->fail("import path is too long");
                f = fopen(cand, "rb");
                if (f) {
                    fclose(f);
                    if (snprintf(cand, sizeof cand,
                                 "only a .h.ct unit can be imported: rename '%s.ct' to '%s.h.ct'",
                                 rel, rel) >= (int)sizeof cand)
                        return self->fail("import path is too long");
                    return self->fail(cand);
                }
            }
        }
        snprintf(cand, sizeof cand, "cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Phase 29 E29-5: the built-in `Vec` / `Map` layer ships with the compiler
       and is found the same way compile mode finds it. DOC-87 Stage 1 moved it
       to `lib/core` and renamed the key to `CT_CORE_DIR`; the five-step lookup
       and the compatibility warnings live here (compile mode calls it too). 0 when found, -1 when
       this installation has none, -2 on a hard error (a bogus CT_CORE_DIR). A
       program that never uses a container still builds without the layer. */
    int find_builtin(const char *in, const char *base, char *out, int cap)
    {
        char cand[MAX_PATH];
        char alt[MAX_PATH];
        const char *env_core;
        const char *env_std;
        const char *slash;
        struct stat st;
        int n;
        FILE *probe;

        env_core = getenv("CT_CORE_DIR");
        env_std = getenv("CT_STD_DIR");
        /* 1/2: CT_CORE_DIR is authoritative; a missing directory is a hard
           error, never a silent fallback to the working tree. */
        if (env_core && env_core[0]) {
            int ok;
            ok = stat(env_core, &st);
            if (ok == 0) ok = S_ISDIR(st.st_mode); else ok = 0;
            if (!ok) {
                char msg[MAX_PATH + 64];
                snprintf(msg, sizeof msg,
                         "CT_CORE_DIR points to a missing directory: %s", env_core);
                self->fail(msg);
                return -2;
            }
            if (env_std && env_std[0] && strcmp(env_core, env_std) != 0
                && !g_module_legacy_env_warned) {
                g_module_legacy_env_warned = 1;
                fprintf(stderr, "ctc: warning: CT_STD_DIR is deprecated; use CT_CORE_DIR\n");
            }
            n = snprintf(cand, sizeof cand, "%s/%s", env_core, base);
            if (n < 0 || n >= (int)sizeof cand) return -1;
            if (strcmp(cand, in) == 0) return -1;
            probe = fopen(cand, "r");
            if (!probe) return -1;
            fclose(probe);
            if (snprintf(out, cap, "%s", cand) >= cap) return -1;
            return 0;
        }
        /* 3: the legacy key still works during the one-MINOR window. */
        if (env_std && env_std[0]) {
            if (!g_module_legacy_env_warned) {
                g_module_legacy_env_warned = 1;
                fprintf(stderr, "ctc: warning: CT_STD_DIR is deprecated; use CT_CORE_DIR\n");
            }
            if (stat(env_std, &st) == 0 && S_ISDIR(st.st_mode)) {
                n = snprintf(cand, sizeof cand, "%s/%s", env_std, base);
                if (n > 0 && n < (int)sizeof cand && strcmp(cand, in) != 0) {
                    probe = fopen(cand, "r");
                    if (probe) {
                        fclose(probe);
                        if (snprintf(out, cap, "%s", cand) >= cap) return -1;
                        return 0;
                    }
                }
            }
        }
        /* 5: ./lib/core, the input's sibling ../lib/core, then the old
           ./lib/std / sibling spellings (the old hit never resolves silently; DOC-87 迁移回退). */
        if (stat("lib/core", &st) == 0 && S_ISDIR(st.st_mode)) {
            n = snprintf(cand, sizeof cand, "lib/core/%s", base);
            if (n > 0 && n < (int)sizeof cand && strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    if (snprintf(out, cap, "%s", cand) >= cap) return -1;
                    return 0;
                }
            }
        }
        slash = strrchr(in, '/');
        if (slash && (size_t)(slash - in) < sizeof alt) {
            memcpy(alt, in, (size_t)(slash - in));
            alt[slash - in] = 0;
            n = snprintf(cand, sizeof cand, "%s/../lib/core/%s", alt, base);
            if (n > 0 && n < (int)sizeof cand && strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    if (snprintf(out, cap, "%s", cand) >= cap) return -1;
                    return 0;
                }
            }
        }
        if (stat("lib/std", &st) == 0 && S_ISDIR(st.st_mode)) { /* DOC-87 迁移回退 */
            n = snprintf(cand, sizeof cand, "lib/std/%s", base); /* DOC-87 迁移回退 */
            if (n > 0 && n < (int)sizeof cand && strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    if (!g_module_legacy_path_warned) {
                        g_module_legacy_path_warned = 1;
                        fprintf(stderr, "ctc: warning: lib/std is deprecated; use lib/core (DOC-87)\n"); /* DOC-87 迁移回退 */
                    }
                    if (snprintf(out, cap, "%s", cand) >= cap) return -1;
                    return 0;
                }
            }
        }
        if (slash && (size_t)(slash - in) < sizeof alt) {
            n = snprintf(cand, sizeof cand, "%s/../lib/std/%s", alt, base); /* DOC-87 迁移回退 */
            if (n > 0 && n < (int)sizeof cand && strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    if (!g_module_legacy_path_warned) {
                        g_module_legacy_path_warned = 1;
                        fprintf(stderr, "ctc: warning: lib/std is deprecated; use lib/core (DOC-87)\n"); /* DOC-87 迁移回退 */
                    }
                    if (snprintf(out, cap, "%s", cand) >= cap) return -1;
                    return 0;
                }
            }
        }
        return -1;
    }

    /* P34 S9a: the built-in files are pre-parsed source, not imports, so the
       dependency graph never lists them and each must be re-emitted every run. */
    int is_builtin_unit(int u)
    {
        int i;
        (void)self;

        for (i = 0; i < self->nbuiltin; i++)
            if (self->builtin_units[i] == u) return 1;
        return 0;
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char dep[MAX_PATH];
        char *mysrc;
        int mysrclen;
        int u, i, k, d, nrels, rb, is_hdr, is_map, dep_is_map, dup, dn, gn;
        (void)self;

        for (u = 0; u < self->nunits; u++)
            if (strcmp(self->units[u].path, path) == 0) return u;
        if (self->ensure_unit_capacity(self->nunits + 1) != 0) return -1;
        u = self->nunits;
        self->nunits++;
        if (snprintf(self->units[u].path, MAX_PATH, "%s", path) >= MAX_PATH) {
            self->fail("path is too long");
            return -1;
        }
        self->units[u].ndep = 0;
        self->units[u].prog = -1;
        self->units[u].digest = 0;
        self->units[u].ns[0] = 0;
        if (self->base_name(path, self->units[u].base, MAX_TEXT, &is_hdr, &is_map) != 0) return -1;
        self->units[u].is_hdr = is_hdr;
        self->units[u].is_map = is_map;
        /* LANG-11: `<base>.h.ct` and `<base>.ct` would both emit `<base>.c`
           (the second silently overwrote the first). Refuse with both paths. */
        if (!is_map) {
            for (k = 0; k < u; k++) {
                if (self->units[k].is_map) continue;
                /* Two shim headers with one base keep the PH-65 ambiguity
                   diagnostic (they publish a header, not a `.c` collision). */
                if (self->units[k].is_hdr && is_hdr) continue;
                if (strcmp(self->units[k].base, self->units[u].base) == 0) {
                    char cmsg[MAX_TEXT];
                    const char *p1 = strrchr(self->units[k].path, '/');
                    const char *p2 = strrchr(path, '/');
                    if (p1) p1++; else p1 = self->units[k].path;
                    if (p2) p2++; else p2 = path;
                    snprintf(cmsg, sizeof cmsg,
                             "units '%s' and '%s' both emit '%s.c'; rename one",
                             p1, p2, self->units[u].base);
                    self->fail(cmsg);
                    return -1;
                }
            }
        }
        self->p->unit_is_map = is_map;
        self->p->c_strict = (!is_map && self->c_boundary_for(path)) ? 1 : 0;
        snprintf(self->p->c_base, sizeof self->p->c_base, "%s", self->units[u].base);
        /* A shim belongs to a mapping/header unit (batch 39, PH-65 R5): `<base>.shim.h` is
           an include root for the consumer, `<base>.shim.c` joins the program.
           Header-only shims are the normal case; a source without its header
           cannot declare anything for a recipe, so it is rejected by name. */
        self->units[u].has_shim = 0;
        self->units[u].shim_dir[0] = 0;
        self->units[u].shim_h[0] = 0;
        self->units[u].shim_c[0] = 0;
        if (is_map || is_hdr) {
            char dir[MAX_PATH];
            char h[MAX_PATH];
            char c[MAX_PATH];
            struct stat st;
            /* The diagnostic names the file the user has to add, so it holds a
               path; `sem_error` prints the message directly (no 160-byte cap). */
            char msg[MAX_PATH + 128];
            if (self->path_dir(path, dir, sizeof dir) != 0) return -1;
            if (snprintf(h, sizeof h, "%s/%s.shim.h", dir, self->units[u].base) >= (int)sizeof h
             || snprintf(c, sizeof c, "%s/%s.shim.c", dir, self->units[u].base) >= (int)sizeof c) {
                self->fail("path is too long");
                return -1;
            }
            if (stat(h, &st) == 0) {
                if (!S_ISREG(st.st_mode) || access(h, R_OK) != 0) {
                    snprintf(msg, sizeof msg, "a shim header is not a readable file: %s", h);
                    return tool::diag::ct_sem_error(1, 1, msg, path);
                }
                snprintf(self->units[u].shim_h, MAX_PATH, "%s", h);
            }
            if (stat(c, &st) == 0) {
                if (!S_ISREG(st.st_mode)) {
                    snprintf(msg, sizeof msg, "a shim source is not a regular file: %s", c);
                    return tool::diag::ct_sem_error(1, 1, msg, path);
                }
                snprintf(self->units[u].shim_c, MAX_PATH, "%s", c);
            }
            if (is_map && self->units[u].shim_c[0] && !self->units[u].shim_h[0]) {
                snprintf(msg, sizeof msg, "a shim source needs a matching .shim.h: %s", h);
                return tool::diag::ct_sem_error(1, 1, msg, path);
            }
            if (self->units[u].shim_h[0]) {
                self->units[u].has_shim = 1;
                snprintf(self->units[u].shim_dir, MAX_PATH, "%s", dir);
            }
        }

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)self->lex->src;
        mysrclen = self->lex->srclen;
        /* S1a-0 C1: this unit's rows start at the current counter; a recursive
           load appends after them and restores the counter, so the slice stays
           valid while this loop walks it. */
        rb = self->p->nrels;
        if (self->scan_imports(path) != 0) return -1;
        nrels = self->p->nrels - rb;
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path,
                                     self->p->rels + (size_t)(rb + i) * MAX_TEXT,
                                     dep, sizeof dep, &is_hdr, &dep_is_map,
                                     self->p->rel_line[rb + i]) != 0) return -1;
            /* SH-71 A-1: a mapping unit may also import a header unit. The
               type host's trait signature has to name the interface type it
               returns, and only a `.h.ct` unit publishes one; the header
               unit's `pub` types and traits are registered as bare names for
               this unit like any other dependency. The other direction stays
               as it was (`map_unit_cross` pins a `.h.ct` importing a `.m.ct`),
               and a plain `.ct` unit is still not importable at all --
               `resolve_import` refuses that by name. */
            d = self->load_unit(dep);
            if (d < 0) return -1;
            /* A unit still on the depth-first stack has no program yet
               (`prog == -1`), so reaching it again is a circular import:
               `A` imports `B` and `B` imports `A` closes here with `A` still
               being loaded. The dependency walk below reads `prog` as an arena
               index, and `-1` is an out-of-bounds read; name the two units
               instead of walking into the crash. */
            if (self->units[d].prog < 0) {
                char cmsg[MAX_PATH + 128];
                snprintf(cmsg, sizeof cmsg,
                         "circular import: '%s' imports '%s', which is still being loaded",
                         self->units[u].path, self->units[d].path);
                return tool::diag::ct_sem_error(self->p->rel_line[rb + i], 1, cmsg, path);
            }
            /* Two `import` lines may name the same unit; a dependency is listed
               once, so the generated `#include` is emitted once. */
            dup = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (self->units[u].depu[k] == d) dup = 1;
            if (dup) continue;
            if (self->ensure_unit_dep_capacity(u, self->units[u].ndep + 1) != 0)
                return -1;
            snprintf(self->units[u].dep + (size_t)self->units[u].ndep * MAX_TEXT,
                     MAX_TEXT, "%s", self->units[d].base);
            self->units[u].depu[self->units[u].ndep] = d;
            self->units[u].ndep++;
        }

        self->lex->src = mysrc;
        self->lex->srclen = mysrclen;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->lstart = 0;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        /* the bare-name table for exported types is rebuilt from this unit's
           direct dependencies below */
        self->sym->ntb = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ns[0] = 0;
        self->sym->nalias = 0;
        self->sym->ntalias = 0;
        self->sym->ntachain = 0;
        self->sym->alias_decl = 0;
        self->p->ns_decl[0] = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->p->cur_func[0] = 0;
        self->p->nparams = 0;
        /* 2a.2: an imported unit's `pub` global is declared `extern` in that
           unit's header, so C links one object for both units. Register it here
           as well, or this unit could not name it in `import count; g_counter`.
           The C spelling is mangled by the owner's namespace (the same rule the
           owner used when it declared the global); an `extern` declaration keeps
           the library's own name and has no namespace to qualify with. */
        for (i = 0; i < self->units[u].ndep; i++) {
            char gcn[MAX_TEXT];
            char gns[MAX_TEXT];
            const char *gname;
            size_t gl;
            dn = self->units[u].depu[i];
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                if (self->arena->nodes[gn].kind != N_GLOBAL || self->arena->nodes[gn].d != 1) continue;
                gname = self->arena->nodes[gn].text2;
                if (self->arena->nodes[gn].aux == 2 || !self->units[dn].nsprefix[0]) {
                    snprintf(gcn, sizeof gcn, "%s", gname);
                    gns[0] = 0;
                } else {
                    if (snprintf(gcn, sizeof gcn, "%s%s",
                                 self->units[dn].nsprefix, gname) >= (int)sizeof gcn)
                        return self->fail("variable name is too long");
                    snprintf(gns, sizeof gns, "%s", self->units[dn].nsprefix);
                    gl = strlen(gns);
                    if (gl > 0) gns[gl - 1] = 0;
                }
                if (self->sym->declare_global(gname, self->arena->nodes[gn].text,
                                              gcn, gns, 1) < 0)
                    return self->fail(self->sym->last_error());
                /* V29-4e: an imported pub array keeps its dimensions, so the
                   subscript checker still sees `table[0]` as one element. */
                if (self->arena->nodes[gn].text3[0]) {
                    int vi = self->sym->find_var(gname);
                    if (vi >= 0) {
                        self->sym->vars[vi].is_array = 1;
                        snprintf(self->sym->vars[vi].dims, MAX_TEXT, "%s",
                                 self->arena->nodes[gn].text3);
                    }
                }
            }
            /* An exported enum's members are file-scope constants (D-3). The
               var table was reset for this unit, so they are registered here
               under the owner's C spelling, exactly as the owner declared them. */
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                char ccn[MAX_TEXT];
                char cns[MAX_TEXT];
                const char *cmn;
                size_t cl;
                int mv;
                if (self->arena->nodes[gn].kind != N_ENUM || self->arena->nodes[gn].d != 1) continue;
                /* Phase 84: an ADT introduces no file-scope variant constants
                   (bare variant names are not a language form), so there is
                   nothing to re-export here. */
                if (self->arena->nodes[gn].aux & 2) continue;
                for (mv = self->arena->nodes[gn].a; mv >= 0; mv = self->arena->nodes[mv].next) {
                    cmn = self->arena->nodes[mv].text2;
                    if (!self->units[dn].nsprefix[0]) {
                        snprintf(ccn, sizeof ccn, "%s", cmn);
                        cns[0] = 0;
                    } else {
                        if (snprintf(ccn, sizeof ccn, "%s%s",
                                     self->units[dn].nsprefix, cmn) >= (int)sizeof ccn)
                            return self->fail("variable name is too long");
                        snprintf(cns, sizeof cns, "%s", self->units[dn].nsprefix);
                        cl = strlen(cns);
                        if (cl > 0) cns[cl - 1] = 0;
                    }
                    if (self->sym->declare_const(cmn, ccn, cns, 1) < 0)
                        return self->fail(self->sym->last_error());
                    if (self->sym->declare_const(cmn, ccn,
                                                 self->arena->nodes[gn].text, 1) < 0)
                        return self->fail(self->sym->last_error());
                }
            }
            /* Exported types of the dependency, reachable by their bare name
               here (SH-18). The table is per importing unit, so an unrelated
               namespace elsewhere in the program cannot make a name ambiguous. */
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                const char *full;
                const char *bare;
                size_t pl;
                if (self->arena->nodes[gn].d != 1) continue;
                if (self->arena->nodes[gn].kind != N_STRUCT
                    && self->arena->nodes[gn].kind != N_TYPEDEF
                    && self->arena->nodes[gn].kind != N_ENUM
                    && self->arena->nodes[gn].kind != N_UNION) continue;
                full = self->arena->nodes[gn].text2;
                bare = full;
                pl = strlen(self->units[dn].nsprefix);
                if (pl > 0 && strncmp(full, self->units[dn].nsprefix, pl) == 0) bare = full + pl;
                if (self->sym->add_bare_type(bare, full) != 0)
                    return self->fail(self->sym->last_error());
                /* Phase 84 fix (F2): a `pub typedef enum Tag { … } Alias;`
                   publishes `lib_Alias` as the declaration's name, but the
                   source tag `Shape` must also resolve — otherwise the
                   consumer emits the undeclared `Shape`. */
                if (self->arena->nodes[gn].kind == N_ENUM
                    && (self->arena->nodes[gn].aux & 3) == 3
                    && self->arena->nodes[gn].num > 0) {
                    struct Adt *adts;
                    int nadts, adi;
                    adts = frontend::sym::ct_adts(&nadts);
                    adi = (int)self->arena->nodes[gn].num - 1;
                    if (adts && adi >= 0 && adi < nadts
                        && self->sym->add_bare_type(adts[adi].name, adts[adi].full) != 0)
                        return self->fail(self->sym->last_error());
                }
            }
            for (gn = self->units[dn].tr_start; gn < self->units[dn].tr_end; gn++) {
                const char *full;
                const char *bare;
                size_t pl;
                if (!self->sym->traits[gn].is_pub) continue;
                full = self->sym->traits[gn].name;
                bare = full;
                pl = strlen(self->units[dn].nsprefix);
                if (pl > 0 && strncmp(full, self->units[dn].nsprefix, pl) == 0) bare = full + pl;
                if (self->sym->add_bare_type(bare, full) != 0)
                    return self->fail(self->sym->last_error());
            }
        }
        /* S1a-0 C1: this unit's import slice begins at `rb`; the recursive
           loads above appended after it, so restore the counter to the slice
           end. The parse pass skips the same `import` lines with `scan_only`
           clear, which no longer records anything, so this unit is never
           charged for its dependencies' imports. */
        self->p->nrels = rb + nrels;
        self->p->scan_only = 0;
        self->path = path;
        self->mem->path = self->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_set_path(self->path);
        self->units[u].fn_start = self->sym->nfunc;
        self->units[u].tr_start = self->sym->ntraits;
        self->units[u].call_start = self->p->ncalls;
        self->p->cur_unit = u;
        /* dependencies were parsed recursively and overwrote the flag */
        self->p->unit_is_map = self->units[u].is_map;
        self->p->unit_is_hdr = self->units[u].is_hdr;
        self->p->c_strict = (!self->units[u].is_map
                             && self->c_boundary_for(self->units[u].path)) ? 1 : 0;
        snprintf(self->p->c_base, sizeof self->p->c_base, "%s", self->units[u].base);
        /* Type aliases visible here: every `pub` alias of a unit in this unit's
           transitive import closure (the same reachability the map lookup and
           the generated C headers use). Then the unit's own top-level aliases
           are pre-scanned so a use before the declaration names the alias. */
        if (self->register_visible_type_aliases(u) != 0) return -1;
        if (self->scan_forward_type_aliases(self->units[u].path, u) != 0) return -1;
        self->units[u].prog = frontend::parse::ct_parse_program();
        if (self->units[u].prog < 0) return -1;
        /* Every local alias now exists: rewrite the exported targets in terms of
           the underlying spelling so an importer never depends on a private one. */
        if (self->sym->resolve_exported_type_aliases(u) != 0)
            return self->fail(self->sym->last_error());
        self->units[u].fn_end = self->sym->nfunc;
        self->units[u].tr_end = self->sym->ntraits;
        self->units[u].call_end = self->p->ncalls;
        snprintf(self->units[u].ns, MAX_TEXT, "%s", self->p->ns_decl);
        /* `sym->ns` is the mangled prefix the unit's parser used for its
           exported names; its globals need the same prefix here. */
        snprintf(self->units[u].nsprefix, MAX_TEXT, "%s", self->sym->ns);
        /* S1a-0 C1: drop this unit's import rows; the caller (or the next
           top-level load) starts from the slice base again, so the parser's
           block stays as large as the widest single unit, not the build. */
        self->p->nrels = rb;
        return u;
    }

    /* Is `to` in `from`'s transitive import closure? Mirrors the reachability
       the emitter uses for `map_visible`, so a type alias and a map see the
       same program shape. */
    int unit_reaches(int from, int to)
    {
        char *reach;
        int d, k, changed;
        (void)self;

        if (from == to) return 1;
        if (to < 0 || to >= self->nunits) return 0;
        if (self->ensure_reach(self->nunits) != 0) return 0;
        reach = self->reach;
        for (d = 0; d < self->nunits; d++) reach[d] = 0;
        reach[from] = 1;
        changed = 1;
        while (changed) {
            changed = 0;
            for (d = 0; d < self->nunits; d++) {
                if (!reach[d]) continue;
                for (k = 0; k < self->units[d].ndep; k++) {
                    int dep = self->units[d].depu[k];
                    if (dep >= 0 && dep < self->nunits && !reach[dep]) {
                        reach[dep] = 1;
                        changed = 1;
                    }
                }
            }
        }
        return reach[to];
    }

    /* Register every `pub` alias of a reachable unit into this unit's visible
       table. Dependencies were parsed first, so their exported targets are
       already fully resolved. */
    int register_visible_type_aliases(int u)
    {
        int i;
        (void)self;

        for (i = 0; i < self->sym->ngtalias; i++) {
            int owner = self->sym->gtaliases[i].owner;
            if (owner < 0 || owner == u) continue;
            if (!self->sym->gtaliases[i].is_pub) continue;
            if (!self->unit_reaches(u, owner)) continue;
            if (self->sym->add_visible_type_alias(self->sym->gtaliases[i].name,
                                                  self->sym->gtaliases[i].target,
                                                  self->sym->gtaliases[i].path,
                                                  self->sym->gtaliases[i].line,
                                                  owner) != 0)
                return self->fail(self->sym->last_error());
        }
        return 0;
    }

    /* Record every top-level `type IDENT =` before parsing, so a use that comes
       earlier in the file can say the alias must be declared before it is used
       instead of treating the name as an opaque C type. The scan only looks at
       depth 0 and restores the cursor afterwards. */
    int scan_forward_type_aliases(const char *path, int owner)
    {
        int pos, bol, line, tokline, tokstart, lstart, tok, tokfloat, toktrunc;
        long num;
        const char *text_ptr; int text_len;
        const char *suffix_ptr; int suffix_len;
        char prev[MAX_TEXT];
        char prev2[MAX_TEXT];
        int prev_line, prev2_line, depth;
        (void)self;

        pos = self->lex->pos;
        bol = self->lex->bol;
        line = self->lex->line;
        tokline = self->lex->tokline;
        tokstart = self->lex->tokstart;
        lstart = self->lex->lstart;
        tok = self->lex->tok;
        num = self->lex->toknum;
        tokfloat = self->lex->tokfloat;
        toktrunc = self->lex->toktrunc;
        text_ptr = self->lex->tokstr.ptr; text_len = self->lex->tokstr.len;
        suffix_ptr = self->lex->toksuffix.ptr; suffix_len = self->lex->toksuffix.len;

        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->lstart = 0;
        self->lex->tokline = 1;
        self->lex->tokstart = 0;
        self->lex->lstart = 0;
        self->lex->tok = T_ID;
        self->lex->tokstr.ptr = self->lex->src;
        self->lex->tokstr.len = 0;
        prev[0] = 0;
        prev2[0] = 0;
        prev_line = 0;
        prev2_line = 0;
        depth = 0;
        /* The cursor is driven through the raw lexer, not ParseSupport: a
           speculative scan must not turn a lexical complaint (an over-long
           identifier, a bad raw block) into the parse's error before the parser
           has reached it. The real parse re-reads everything. */
        self->lex->next();
        while (self->lex->tok != 0) {
            if (self->lex->tok == T_PP
                && self->lex->tok_prefix("#ct-raw")) {
                /* raw blocks hold arbitrary C: nothing in them is a CT alias */
                while (self->lex->src[self->lex->pos]) {
                    int atbol = (self->lex->pos == 0
                                 || self->lex->src[self->lex->pos - 1] == '\n');
                    if (atbol && strncmp(self->lex->src + self->lex->pos, "#ct-endraw", 10) == 0
                        && (self->lex->src[self->lex->pos + 10] == 0
                            || self->lex->src[self->lex->pos + 10] == '\n'
                            || self->lex->src[self->lex->pos + 10] == '\r'
                            || self->lex->src[self->lex->pos + 10] == ' ')) {
                        while (self->lex->src[self->lex->pos]
                               && self->lex->src[self->lex->pos] != '\n')
                            self->lex->pos++;
                        break;
                    }
                    if (self->lex->src[self->lex->pos] == '\n') self->lex->line++;
                    self->lex->pos++;
                }
                self->lex->bol = 0;
                self->lex->next();
                continue;
            }
            if (self->lex->tok == T_PUNCT) {
                if (self->lex->tok_is("{")) depth++;
                else if (self->lex->tok_is("}") && depth > 0) depth--;
            }
            if (depth == 0 && self->lex->tok == T_PUNCT
                && self->lex->tok_is("=")
                && strcmp(prev2, "type") == 0
                && ((prev[0] >= 'a' && prev[0] <= 'z') || (prev[0] >= 'A' && prev[0] <= 'Z')
                    || prev[0] == '_')) {
                if (self->sym->add_forward_type_alias(prev, path, prev2_line, owner) != 0)
                    return self->fail(self->sym->last_error());
            }
            snprintf(prev2, sizeof prev2, "%s", prev);
            prev2_line = prev_line;
            self->lex->tok_copy(prev, sizeof prev);
            prev_line = self->lex->tokline;
            self->lex->next();
        }

        self->lex->pos = pos;
        self->lex->bol = bol;
        self->lex->line = line;
        self->lex->tokline = tokline;
        self->lex->tokstart = tokstart;
        self->lex->lstart = lstart;
        self->lex->tok = tok;
        self->lex->toknum = num;
        self->lex->tokfloat = tokfloat;
        self->lex->toktrunc = toktrunc;
        self->lex->tokstr.ptr = text_ptr; self->lex->tokstr.len = text_len;
        self->lex->toksuffix.ptr = suffix_ptr; self->lex->toksuffix.len = suffix_len;
        return 0;
    }

    /* PH-48 D48-2 / L48-2: an exported `use Drop` struct publishes its
       `<S>_Drop_drop` body through its own header. The body may be an explicit
       `impl Drop` in that unit or the recursive glue the unit emits when there
       is no impl; an impl written in a different unit leaves the header with no
       real prototype, so a consumer could only call an empty stub (the silent
       behaviour this phase removes). Reject the build before any `.c` is
       written, at the struct's own line. */
    int check_drop_visibility(void)
    {
        int si, u, n, found, line;
        const char *name;

        for (si = 0; si < self->sym->nstructs; si++) {
            if (!self->sym->structs[si].uses_drop) continue;
            if (self->sym->structs[si].is_template || self->sym->structs[si].is_inst) continue;
            if (!self->sym->structs[si].is_pub) continue;
            u = self->sym->structs[si].owner;
            if (u < 0 || u >= self->nunits) continue;
            if (!self->units[u].is_hdr) continue;
            if (!self->sym->structs[si].has_drop_impl) continue;
            found = 0;
            for (n = self->arena->nodes[self->units[u].prog].a; n >= 0;
                 n = self->arena->nodes[n].next)
                if (self->arena->nodes[n].kind == N_IMPL
                    && self->arena->nodes[n].aux == si
                    && strcmp(self->arena->nodes[n].text2, "Drop") == 0) {
                    found = 1;
                    break;
                }
            if (found) continue;
            name = self->sym->structs[si].name;
            line = 1;
            for (n = self->arena->nodes[self->units[u].prog].a; n >= 0;
                 n = self->arena->nodes[n].next)
                if (self->arena->nodes[n].kind == N_STRUCT
                    && strcmp(self->arena->nodes[n].text2, name) == 0) {
                    line = self->arena->nodes[n].line;
                    break;
                }
            {
                char bare[MAX_TEXT];
                char msg[MAX_TEXT * 2];
                const char *shown = name;
                size_t pl = strlen(self->units[u].nsprefix);
                if (pl > 0 && strncmp(name, self->units[u].nsprefix, pl) == 0)
                    shown = name + pl;
                snprintf(bare, sizeof bare, "%s", shown);
                snprintf(msg, sizeof msg,
                         "Drop body for 'struct %s' is not visible through its header;"
                         " move 'impl Drop for %s' into the unit that declares the struct",
                         bare, bare);
                return tool::diag::ct_sem_error(line, 1, msg, self->units[u].path);
            }
        }
        return 0;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char rest[MAX_PATH];
        char dir[MAX_TEXT];
        char want[MAX_TEXT];
        const char *p;
        size_t rn, k, m;

        (void)self;
        if (!self->units[u].ns[0]) return 0;
        if (!self->nsroot || !self->nsroot[0]) return 0;
        rn = strlen(self->nsroot);
        if (strncmp(self->units[u].path, self->nsroot, rn) != 0) return 0;
        p = self->units[u].path + rn;
        if (*p == '/') p++;
        snprintf(rest, sizeof rest, "%s", p);
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        if (k >= sizeof dir) return self->fail("path is too long");
        snprintf(dir, sizeof dir, "%.*s", (int)k, rest);

        m = 0;
        for (k = 0; self->units[u].ns[k]; k++) {
            if (m + 1 >= sizeof want) return self->fail("namespace is too long");
            if (self->units[u].ns[k] == ':' && self->units[u].ns[k + 1] == ':') {
                want[m] = '/';
                m++;
                k++;
            } else {
                want[m] = self->units[u].ns[k];
                m++;
            }
        }
        want[m] = 0;
        if (strcmp(dir, want) != 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "namespace '%s' does not match the directory '%s'",
                     self->units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* Dependency-first order for the cache. `load_unit` assigns an importer its
       index before recursing, so unit indices are neither a topological order
       nor its reverse; this postorder DFS is (same shape as L2's `order[]`).
       The graph belongs to this layer, not to the cache. */
    int cache_order(int u, int *state, int *order, int *n)
    {
        int k;
        (void)self;
        if (state[u] != 0) return 0;
        state[u] = 1;
        for (k = 0; k < self->units[u].ndep; k++)
            if (self->cache_order(self->units[u].depu[k], state, order, n) != 0)
                return -1;
        state[u] = 2;
        order[*n] = u;
        (*n)++;
        return 0;
    }

    /* The key material of unit `u`: its import list as text and the folded
       dependency digest. The cache turns this into a stamped key; the module
       layer owns the graph, so the folding happens here. */
    int cache_key_of(int u, char *out, int cap)
    {
        /* S1a-0 C1: the key material is one row per import, so a fixed
           MAX_IH block cannot outlive the old 32-import cap. Sized from the
           actual `ndep`; `MAX_IH` is gone with the cap it mirrored. */
        char *ih;
        unsigned long dep;
        size_t n, k, ihcap;
        int w;
        (void)self;

        n = 0;
        ihcap = (size_t)self->units[u].ndep * (MAX_TEXT + 4) + 256;
        ih = (char *)malloc(ihcap);
        if (!ih) return -1;
        ih[0] = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++) {
            w = snprintf(ih + n, ihcap - n, "%s%s;",
                         self->units[u].dep + k * MAX_TEXT,
                         self->units[self->units[u].depu[k]].is_map ? ".m" : ".h");
            if (w < 0 || (size_t)w >= ihcap - n) { free(ih); return -1; }
            n += (size_t)w;
        }
        /* A shim is part of the mapping's definition: touching either file must
           rebuild the consumers, so its stamp joins the key material. */
        if (self->units[u].is_map && self->units[u].has_shim) {
            struct stat st;
            if (stat(self->units[u].shim_h, &st) == 0) {
                w = snprintf(ih + n, ihcap - n, "sh@%lu.%lu;",
                             (unsigned long)st.st_mtime, (unsigned long)st.st_size);
                if (w < 0 || (size_t)w >= ihcap - n) { free(ih); return -1; }
                n += (size_t)w;
            }
            if (self->units[u].shim_c[0] && stat(self->units[u].shim_c, &st) == 0) {
                w = snprintf(ih + n, ihcap - n, "sc@%lu.%lu;",
                             (unsigned long)st.st_mtime, (unsigned long)st.st_size);
                if (w < 0 || (size_t)w >= ihcap - n) { free(ih); return -1; }
                n += (size_t)w;
            }
        }
        dep = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++)
            dep = dep * (unsigned long)1099511628211
                + self->units[self->units[u].depu[k]].digest;
        if (self->cache->key(self->units[u].path, ih, dep, self->line_force,
                             self->diag_json, self->runtime_checks,
                             self->nsroot, out, cap) != 0) {
            free(ih);
            return -1;
        }
        /* the unit's own digest is what its dependants fold next */
        self->units[u].digest = self->cache->digest(out);
        free(ih);
        return 0;
    }

    /* Phase 39 R2: classify the root unit's exports and enforce the L39-*
       rules. R3/R5 consume the same rules when they write the ABI header and
       the archive; this method only decides whether the build may continue. */
    int lib_scan(int root_u)
    {
        int u, fi, gi, count, nonroot, bad;
        const char *root_path;
        char msg[MAX_TEXT];

        if (root_u < 0 || root_u >= self->nunits) {
            fprintf(stderr, "%s: no exported functions in '<input>'\n", self->prog);
            return 1;
        }
        root_path = self->units[root_u].path;
        self->lib_root = root_u;
        self->abi_n = 0;
        if (!self->units[root_u].is_hdr) {
            fprintf(stderr, "%s: no exported functions in '%s'\n", self->prog, root_path);
            return 1;
        }
        /* L39-3 / L39-5 / L39-4: things that make the archive uncontrollable. */
        for (u = 0; u < self->nunits; u++) {
            if (self->units[u].is_map && self->units[u].has_shim) {
                snprintf(msg, sizeof msg,
                         "a --lib build cannot include the C shim of '%s'",
                         self->units[u].path);
                return tool::diag::ct_sem_error(1, 1, msg, root_path);
            }
            for (fi = self->units[u].fn_start; fi < self->units[u].fn_end; fi++) {
                if (strcmp(self->sym->funcs[fi].name, "main") == 0
                    && self->sym->funcs[fi].body >= 0) {
                    return tool::diag::ct_sem_error(self->sym->funcs[fi].line, 1,
                        "a --lib build cannot contain 'main'", self->units[u].path);
                }
            }
            for (gi = self->arena->nodes[self->units[u].prog].a; gi >= 0;
                 gi = self->arena->nodes[gi].next) {
                if (self->arena->nodes[gi].kind != N_GLOBAL
                    || self->arena->nodes[gi].d != 1) continue;
                snprintf(msg, sizeof msg,
                         "'%s' cannot be exported: pub globals are not supported",
                         self->arena->nodes[gi].text2);
                return tool::diag::ct_sem_error(self->arena->nodes[gi].line, 1,
                                                msg, self->units[u].path);
            }
        }
        count = 0;
        nonroot = 0;
        for (u = 0; u < self->nunits; u++) {
            if (self->is_builtin_unit(u)) continue;
            for (fi = self->units[u].fn_start; fi < self->units[u].fn_end; fi++) {
                int k, is_root_candidate;
                if (!self->sym->funcs[fi].is_pub) continue;
                is_root_candidate = (u == root_u && self->sym->funcs[fi].body >= 0);
                if (!is_root_candidate) {
                    nonroot++;
                    continue;
                }
                count++;
                if (self->sym->funcs[fi].ntparams > 0) {
                    snprintf(msg, sizeof msg,
                             "'%s' not exported: generic template has no external symbol",
                             self->sym->funcs[fi].name);
                    if (tool::diag::ct_type_warn(self->sym->funcs[fi].line, 1, "", msg, root_path) != 0)
                        return 1;
                    continue;
                }
                bad = 0;
                snprintf(msg, sizeof msg, "'%s' cannot be exported: ", self->sym->funcs[fi].name);
                {
                    /* S1a-0 C1: a function may carry more than 16 parameters,
                       so walk the return type and every parameter directly
                       instead of copying them into a 17-row stack buffer. */
                    for (k = -1; k < self->sym->funcs[fi].nparams; k++) {
                        const char *tp = k < 0 ? self->sym->funcs[fi].ret
                                               : self->sym->funcs[fi].ptype + (k) * MAX_TEXT;
                        const char *base = tp;
                        if (strncmp(base, "struct ", 7) == 0) base += 7;
                        else if (strncmp(base, "union ", 6) == 0) base += 6;
                        if (strstr(tp, "own ")) {
                            strncat(msg, "own", sizeof msg - strlen(msg) - 1);
                            bad = 1;
                            break;
                        }
                        if (strstr(tp, "_iface") || self->sym->find_trait(base) >= 0) {
                            strncat(msg, "trait value", sizeof msg - strlen(msg) - 1);
                            bad = 1;
                            break;
                        }
                        if (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0
                            || strncmp(base, "Option_", 7) == 0
                            || strncmp(base, "Result_", 7) == 0
                            || (strncmp(base, "Str", 3) == 0
                                && (base[3] == 0 || base[3] == ' '
                                    || base[3] == '*' || base[3] == '['))) {
                            strncat(msg, "std type", sizeof msg - strlen(msg) - 1);
                            bad = 1;
                            break;
                        }
                        if ((strncmp(tp, "struct ", 7) == 0
                             || strncmp(tp, "union ", 6) == 0)
                            && strchr(tp, '*') == 0) {
                            strncat(msg, "by-value struct", sizeof msg - strlen(msg) - 1);
                            bad = 1;
                            break;
                        }
                    }
                }
                if (bad)
                    return tool::diag::ct_sem_error(self->sym->funcs[fi].line, 1, msg, root_path);
                if (self->abi_n < 256) self->abi_exports[self->abi_n++] = fi;
            }
        }
        if (count == 0) {
            snprintf(msg, sizeof msg, "no exported functions in '%s'", root_path);
            return tool::diag::ct_sem_error(1, 1, msg, root_path);
        }
        if (nonroot > 0) {
            snprintf(msg, sizeof msg,
                     "%d pub function(s) are not part of the ABI surface (imported or extern)",
                     nonroot);
            if (tool::diag::ct_type_warn(1, 1, "", msg, root_path) != 0) return 1;
        }
        if (tool::diag::ct_diag_nwarn() > 0
            && tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
        return 0;
    }

    /* PH-81: the `Box.h.ct` unit is loaded only when a build input names a
       `Box<...>` type (or its deprecated `box<...>` alias) or a `new T { ... }`
       construction in code (comments and strings are skipped). An unused fifth
       unit would add `struct ct_Box_hdr;`
       to every product and change the `--emit-c` bytes of unrelated programs. */
    int module_src_wants_Box(const char *path)
    {
        FILE *f;
        char line[1024];
        (void)self;

        if (module_src_declares_Box(path)) return 0;
        f = fopen(path, "r");
        if (!f) return 0;
        while (fgets(line, sizeof line, f)) {
            const char *p = line;
            while (*p) {
                if (p[0] == '/' && p[1] == '/') break;
                if (p[0] == '/' && p[1] == '*') {
                    p += 2;
                    while (*p && !(p[0] == '*' && p[1] == '/')) p++;
                    if (*p) p += 2;
                    continue;
                }
                if (*p == '"' || *p == '\'') {
                    char q = *p;
                    p++;
                    while (*p && *p != q) { if (*p == '\\' && p[1]) p++; p++; }
                    if (*p) p++;
                    continue;
                }
                if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                      || (*p >= '0' && *p <= '9') || *p == '_')) { p++; continue; }
                {
                    const char *q = p;
                    while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                           || (*q >= '0' && *q <= '9') || *q == '_') q++;
                    if ((size_t)(q - p) == 3
                        && (strncmp(p, "Box", 3) == 0
                            || strncmp(p, "box", 3) == 0)) {
                        const char *t = q;
                        while (*t == ' ' || *t == '\t') t++;
                        if (*t == '<') { fclose(f); return 1; }
                    }
                    if ((size_t)(q - p) == 3 && strncmp(p, "new", 3) == 0) {
                        const char *t = q;
                        while (*t == ' ' || *t == '\t') t++;
                        if ((*t >= 'a' && *t <= 'z') || (*t >= 'A' && *t <= 'Z')
                            || *t == '_' || *t == '{') { fclose(f); return 1; }
                    }
                    p = q;
                }
            }
        }
        fclose(f);
        return 0;
    }

    int module_inputs_want_Box(const char **ins, int n)
    {
        int i;
        (void)self;
        /* A user `struct Box` in any input makes the whole build own the name,
           so the built-in layer must stay out even if another unit names
           `Box<...>`; otherwise the two templates collide. */
        for (i = 0; i < n; i++)
            if (module_src_declares_Box(ins[i])) return 0;
        for (i = 0; i < n; i++)
            if (self->module_src_wants_Box(ins[i])) return 1;
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        /* S1a-0 C1: the per-run rows are heap blocks. `inputs` is bounded by
           argc; the three cache-walk rows follow the grown unit table. A
           fixed `[MAX_UNITS]` stack row would cap the build at 64 again. */
        const char **inputs;
        int ninput, i, u, o, cn;
        int *dirty;
        int *cstate;
        int *corder;
        const char *outdir;
        const char *oarg;
        const char *ccpath;
        char cmd[MAX_CMD];
        int ncmd, code, st;
        char root[MAX_PATH];
        (void)self;

        inputs = (const char **)calloc((size_t)argc, sizeof(*inputs));
        if (!inputs) {
            fprintf(stderr, "ctc: out of memory\n");
            return 1;
        }
        ninput = 0;
        outdir = NULL;
        oarg = NULL;
        ccpath = NULL;
        self->ninc = 0;
        self->nsroot = NULL;
        self->line_mode = 1;
        self->line_force = -1;
        self->have_map = 0;
        self->have_model = 0;
        self->emit_c = 0;
        self->lib_mode = 0;
        self->lib_root = -1;
        self->abi_mode = 0;
        self->abi_n = 0;
        self->runtime_checks = 0;
        self->freestanding = 0;
        self->c_boundary = -1;
        self->show_c_boundary = 0;
        self->show_io_headers = 0;
        self->alloc_map[0] = 0;
        self->exe = NULL;
        self->outdir_opt = NULL;
        self->cc = NULL;
        self->cflags[0] = 0;
        self->ldflags[0] = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s build <input.ct>... [-o <exe>] [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--locked] [--emit-c] [--lib] [--runtime-checks] [--outdir <dir>] [--cc <path>]\n"
                       "                 [--freestanding] [--alloc <m,f[,r,c]>] [--c-boundary=strict|allow]\n"
                       "                 [--check-level=off|warn|error]\n"
                       "                 [--cflags <s>] [--ldflags <s>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->] [--emit-model <file|->]\n"
                       "                 [--diagnostics=text|json] [--diag-codes] [--std=c99|gnu99|c11]\n",
                       self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (strcmp(argv[i], "--emit-c") == 0) {
                self->emit_c = 1;
                continue;
            }
            if (strcmp(argv[i], "--lib") == 0) {
                self->lib_mode = 1;
                continue;
            }
            if (strcmp(argv[i], "--runtime-checks") == 0) {
                self->runtime_checks = 1;
                continue;
            }
            if (strcmp(argv[i], "--freestanding") == 0) {
                self->freestanding = 1;
                continue;
            }
            if (strcmp(argv[i], "--allow-c-boundary") == 0) {
                self->c_boundary = 0;
                continue;
            }
            if (strcmp(argv[i], "--show-c-boundary") == 0) {
                self->show_c_boundary = 1;
                continue;
            }
            if (strcmp(argv[i], "--show-io-headers") == 0) {
                self->show_io_headers = 1;
                continue;
            }
            if (strncmp(argv[i], "--c-boundary=", 13) == 0) {
                const char *v = argv[i] + 13;
                if (strcmp(v, "strict") == 0) {
                    self->c_boundary = 1;
                    continue;
                }
                if (strcmp(v, "allow") == 0) {
                    self->c_boundary = 0;
                    continue;
                }
                fprintf(stderr, "ctc: --c-boundary takes strict or allow, not '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--alloc") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --alloc needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->alloc_map, sizeof self->alloc_map, "%s", argv[i])
                        >= (int)sizeof self->alloc_map) {
                    fprintf(stderr, "ctc: --alloc value is too long\n");
                    return 1;
                }
                continue;
            }
            if (strcmp(argv[i], "--outdir") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --outdir needs an argument\n");
                    return 1;
                }
                i++;
                self->outdir_opt = argv[i];
                continue;
            }
            if (strcmp(argv[i], "--cc") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --cc needs an argument\n");
                    return 1;
                }
                i++;
                self->cc = argv[i];
                continue;
            }
            if (strcmp(argv[i], "--cflags") == 0 || strcmp(argv[i], "--ldflags") == 0) {
                int is_cf = argv[i][2] == 'c';
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: %s needs an argument\n", argv[i]);
                    return 1;
                }
                i++;
                if (ct_append_flags(is_cf ? self->cflags : self->ldflags,
                                    MAX_FLAGS, argv[i]) != 0) {
                    fprintf(stderr, "ctc: %s value is too long\n", is_cf ? "--cflags" : "--ldflags");
                    return 1;
                }
                continue;
            }
            if (strcmp(argv[i], "--diag-codes") == 0) {
                self->diag_codes = 1;
                continue;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                if (strcmp(v, "c11") == 0) {
                    self->std_flag = "-std=c11";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "--emit-model") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-model needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->model_path, sizeof self->model_path, "%s", argv[i])
                    >= (int)sizeof self->model_path) {
                    fprintf(stderr, "ctc: model path is too long\n");
                    return 1;
                }
                self->have_model = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                oarg = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (self->ensure_incdir_capacity(self->ninc + 1) != 0) {
                    fprintf(stderr, "ctc: out of memory\n");
                    return 1;
                }
                self->incdirs[self->ninc] = argv[i];
                self->ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                self->nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= MAX_UNITS_MAX) {
                fprintf(stderr, "ctc: out of memory\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: %s build <input.ct>... [-o <exe>]\n", self->prog);
            return 1;
        }
        if (self->show_io_headers) {
            int mask = 0;
            for (i = 0; i < self->nunits; i++) {
                int bu = 0, k;
                for (k = 0; k < self->nbuiltin; k++)
                    if (self->builtin_units[k] == i) bu = 1;
                if (bu) continue;
                mask |= self->io_header_mask(i);
            }
            if (mask & 1) printf("stdio.h\n");
            if (mask & 2) printf("wchar.h\n");
            return 0;
        }
        /* PH-65 R1 observability: print the resolved policy and stop. */
        if (self->show_c_boundary) {
            printf("%s\n", self->c_boundary_for(inputs[0]) ? "strict" : "allow");
            return 0;
        }
        if (self->lib_mode && self->emit_c) {
            fprintf(stderr, "ctc: --lib and --emit-c are mutually exclusive\n");
            return 1;
        }
        /* A `.m.ct` unit is a compile-time mapping: it is loaded through
           `import`, never as a build input, and it never writes an artefact. */
        for (i = 0; i < ninput; i++) {
            size_t pl = strlen(inputs[i]);
            if (pl > 5 && strcmp(inputs[i] + pl - 5, ".m.ct") == 0) {
                fprintf(stderr, "ctc: a .m.ct unit produces no output; import it from a .ct unit\n");
                return 1;
            }
        }
        /* `-o` means the output directory only under `--emit-c` (its old
           meaning); in the default form it names the executable and the C
           lands in `--outdir` (default `.ctbuild/`). */
        if (self->emit_c) {
            outdir = oarg ? oarg : self->outdir_opt;
            if (!outdir) {
                fprintf(stderr, "ctc: build needs -o <dir>\n");
                return 1;
            }
        } else {
            self->exe = oarg ? oarg : "a.out";
            outdir = self->outdir_opt ? self->outdir_opt : ".ctbuild";
        }
        if (snprintf(self->outdir, sizeof self->outdir, "%s", outdir) >= (int)sizeof self->outdir) {
            fprintf(stderr, "ctc: output directory is too long\n");
            return 1;
        }
        if (!self->emit_c && ct_ensure_dir(self->outdir) != 0) {
            fprintf(stderr, "ctc: cannot create '%s'%s\n", self->outdir,
                    self->diag_codes ? " [E-DRIVER-004]" : "");
            return 1;
        }
        if (!self->nsroot) {
            if (self->path_dir(inputs[0], root, sizeof root) != 0) {
                return frontend::parse::ct_parse_report();
            }
            self->nsroot = root;
        }
        /* P20-06: a namespace segment names one package, so two roots claiming
           the same segment make every `import <seg>::x` ambiguous regardless of
           which files exist. */
        {
            char nmsg[MAX_PATH * 2 + MAX_TEXT];
            char nfile[MAX_PATH];
            if (ct_pkg_ns_clash(self, nmsg, sizeof nmsg, nfile, sizeof nfile)) {
                tool::diag::ct_sem_error(1, 1, nmsg, nfile);
                fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                return 1;
            }
        }

        self->nunits = 0;
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->nstruct_inst = 0;
        self->sym->ntb = 0;
        self->p->nrels = 0;
        self->p->scan_only = 0;
        self->p->nparams = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->sym->ns[0] = 0;
        self->sym->nalias = 0;
        self->sym->ntalias = 0;
        self->sym->ntachain = 0;
        self->sym->alias_decl = 0;
        self->p->ns_decl[0] = 0;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        self->p->ncalls = 0;
        tool::diag::ct_diag_reset();
        /* PH-69-R1: `ct check` routed through the build graph keeps check
           severity (all findings are errors), not build's signature-only 2. */
        tool::diag::ct_diag_set_strict(self->check_mode ? 1 : 2);
        /* PH-85 S85d: the B checker on the build path. SH-115 made `warn` and
           v1-PH-1 S3 makes `error` the CLI default, so `types_mode` is 1 for
           an ordinary build; an explicit `--check-level=off` leaves it 0 and
           the build is byte-for-byte what it was before PH-85. `warn` /
           `error` pick how a finding is treated. */
        tool::diag::ct_diag_set_types_level(self->types_level);
        if (self->types_level > 0) self->p->types_mode = 1;
        /* PH-82: one package per run, so the build's first input decides the
           leak policy for every unit in it (D-012's "本包"). */
        tool::diag::ct_diag_set_leaks_error(self->leaks_for(ninput > 0 ? inputs[0] : ""));
        self->diag_emitted = 0;
        self->p->cur_func[0] = 0;
        frontend::parse::ct_parse_clear_error();
        /* LANG-10 7b: a parse failure follows `--diagnostics=json`; build keeps
           the document on stderr (stdout carries the cc line), check on stdout. */
        frontend::parse::ct_parse_set_json(self->diag_json, self->check_mode ? 0 : 1,
                                           self->diag_codes);
        tool::diag::ct_diag_set_codes(self->diag_codes);
        self->build_mode = 1;

        /* Phase 29 E29-5: the built-in layer is loaded as a unit of every
           build, so a program needs neither an `import` nor `ct get std`. Each
           file is a `pub` header unit, so instances and their impl definitions
           land in its own `.h` / `.c` exactly like a user template. A missing
           file is not an error (an installation may not carry it).
           P34 S9a: the layer may span several files (`Vec.h.ct`, `Option.h.ct`,
           `Result.h.ct`); P36 S4a1 adds `Str.h.ct`; SH-120 splits the strings
           into `Str.h.ct` / `String.h.ct` / `utf16/U16Str.h.ct` /
           `utf16/U16String.h.ct` (eight slots). Each found file joins the
           layer. */
        self->nbuiltin = 0;
        self->computed_live = 0;
        self->builtin_live[0] = 0;
        self->builtin_live[1] = 0;
        self->builtin_live[2] = 0;
        self->builtin_live[3] = 0;
        self->builtin_live[4] = 0;
        self->builtin_live[5] = 0;
        self->builtin_live[6] = 0;
        self->builtin_live[7] = 0;
        backend::emit::ct_emit_clear_builtins();
        {
            char bpath[MAX_PATH];
            int bi;
            for (bi = 0; bi < 8; bi++) {
                const char *base;
                if (bi == 7 && !self->module_inputs_want_Box(inputs, ninput))
                    continue;
                base = bi == 0 ? "Vec.h.ct"
                     : (bi == 1 ? "Option.h.ct"
                     : (bi == 2 ? "Result.h.ct"
                     : (bi == 3 ? "Str.h.ct"
                     : (bi == 4 ? "String.h.ct"
                     : (bi == 5 ? "utf16/U16Str.h.ct"
                     : (bi == 6 ? "utf16/U16String.h.ct" : "Box.h.ct"))))));
                {
                    int br = self->find_builtin(inputs[0], base, bpath, sizeof bpath);
                    if (br == -2) return frontend::parse::ct_parse_report();
                    if (br != 0) continue;
                }
                {
                    int bu;
                    bu = self->load_unit(bpath);
                    if (bu < 0) return frontend::parse::ct_parse_report();
                    self->builtin_units[self->nbuiltin] = bu;
                    self->nbuiltin += 1;
                    backend::emit::ct_emit_add_builtin(bu);
                }
                /* L29-W1: the shadow warning is the same on both paths. */
                {
                    FILE *vs = fopen("vendor/std", "r");
                    if (vs) {
                        fclose(vs);
                        if (tool::diag::ct_std_shadow_warn(1, 1,
                                "the built-in Vec/Map supersede a project-local 'vendor/std' (ignored)",
                                "vendor/std") != 0) {
                            self->fail("too many warnings");
                            return frontend::parse::ct_parse_report();
                        }
                    }
                }
            }
            /* PH-85 S85d: `--check-level=error` counts its findings in
               `nsem` without aborting the parse (a warning-shaped kernel stays
               on its path), so stop here -- before any product is written. */
            if (tool::diag::ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                return 1;
            }
        }

        /* P36 S4a2: the built-in layer's functions do not count against the
           user program's `MAX_FUNCS` budget. */
        self->sym->nfunc_base = self->sym->nfunc;

        {
            int root_u = -1;
            for (i = 0; i < ninput; i++) {
                int lu = self->load_unit(inputs[i]);
                if (i == 0) root_u = lu;
                if (lu < 0) {
                    if (tool::diag::ct_diag_nsem()) fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                    else frontend::parse::ct_parse_report();
                    return 1;
                }
            }
            /* PH-48 L48-2: reject an exported Drop whose body cannot be reached
               through the type's header before any product is written. */
            if (self->check_drop_visibility() != 0)
                return frontend::parse::ct_parse_report();
            /* PH-82: the direct-cycle warning is a whole-build property (the
               field graph spans units), so it runs once after every unit is
               in the symbol table and before the cache/emit walk. */
            if (self->cycle_check() != 0)
                return frontend::parse::ct_parse_report();
            /* `leaks = error` fails the run here, before any `.c`/`.h`/archive
               is written, and covers `--lib` too (that branch returns before
               the later diagnostics flush). */
            if (tool::diag::ct_diag_leaks_failed()) {
                tool::diag::ct_diag_emit(self->diag_json, 1);
                return 1;
            }
            if (self->lib_mode) {
                const char *od = self->outdir_opt ? self->outdir_opt : ".ctbuild";
                char hp[MAX_PATH];
                if (self->lib_scan(root_u) != 0) return 1;
                if (snprintf(self->outdir, sizeof self->outdir, "%s", od)
                    >= (int)sizeof self->outdir) {
                    fprintf(stderr, "ctc: output directory is too long\n");
                    return 1;
                }
                if (ct_ensure_dir(self->outdir) != 0) {
                    fprintf(stderr, "ctc: cannot create '%s'%s\n", self->outdir,
                    self->diag_codes ? " [E-DRIVER-004]" : "");
                    return 1;
                }
                if (snprintf(hp, sizeof hp, "%s/%s.abi.h", self->outdir,
                             self->units[root_u].base) >= (int)sizeof hp) {
                    fprintf(stderr, "ctc: ABI header path is too long\n");
                    return 1;
                }
                self->abi_mode = 1;
                if (backend::emit::ct_emit_header(hp) != 0) return 1;
                /* SH-79 facet 1: --lib used to return without writing the map
                   or the model (the flags were accepted silently). */
                if (self->have_map
                    && self->write_map(self->map_path, self->units[root_u].prog, root_u) != 0)
                    return 1;
                if (self->have_model
                    && self->write_model(self->model_path, self->units[root_u].prog) != 0)
                    return 1;
                /* R4 intermediate: emit every unit first (headers may
                   reference each other), then compile each object with hidden
                   visibility; R5 folds these objects into the archive. */
                for (u = 0; u < self->nunits; u++) {
                    if (self->units[u].is_map) continue;
                    if (self->emit_unit(u) != 0) return 1;
                    if (self->units[u].is_hdr && self->write_unit_header(u) != 0) return 1;
                }
                for (u = 0; u < self->nunits; u++) {
                    char src[MAX_PATH], obj[MAX_PATH], cmd[MAX_CMD];
                    int ncmd = 0, code2, st2;
                    const char *ccp = self->cc;
                    const char *cstd;
                    if (self->units[u].is_map) continue;
                    /* Phase 41: _Atomic needs C11. Keep the user's explicit
                       gnu99/c11 choice; lift the default c99 only when an
                       atomic builtin was actually lowered. */
                    cstd = self->std_flag ? self->std_flag : "-std=c99";
                    if (self->sym->atomic_used && strcmp(cstd, "-std=c99") == 0)
                        cstd = "-std=c11";
                    if (snprintf(src, sizeof src, "%s/%s.c", self->outdir, self->units[u].base)
                            >= (int)sizeof src
                        || snprintf(obj, sizeof obj, "%s/%s.o", self->outdir, self->units[u].base)
                            >= (int)sizeof obj)
                        return 1;
                    if (!ccp || !ccp[0]) ccp = "cc";
                    if (ct_cmd_token(cmd, MAX_CMD, &ncmd, ccp) != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd,
                                        cstd) != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, "-fvisibility=hidden") != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, "-I") != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, self->outdir) != 0)
                        return 1;
                    {
                        int kk;
                        for (kk = 0; kk < self->nunits; kk++) {
                            if (!self->units[kk].has_shim) continue;
                            if (ct_cmd_token(cmd, MAX_CMD, &ncmd, "-I") != 0
                                || ct_cmd_token(cmd, MAX_CMD, &ncmd,
                                                self->units[kk].shim_dir) != 0)
                                return 1;
                        }
                    }
                    if (ct_cmd_token(cmd, MAX_CMD, &ncmd, "-c") != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, src) != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, "-o") != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, obj) != 0) {
                        fprintf(stderr, "ctc: the cc command line is too long\n");
                        return 1;
                    }
                    printf("%s\n", cmd);
                    fflush(stdout);
                    st2 = system(cmd);
                    if (st2 < 0) {
                        fprintf(stderr, "ctc: cannot run '%s'\n", ccp);
                        return 1;
                    }
                    if (st2 & 0x7f) code2 = 128 + (st2 & 0x7f);
                    else code2 = (st2 >> 8) & 0xff;
                    if (code2 != 0) return 1;
                }
                /* R5: archive every object of this build. `ar rcsD` is the
                   deterministic form; macOS ar has no -D, so fall back to
                   ZERO_AR_DATE=1 + rcs (R7 asserts two runs hash equal). */
                {
                    char archive[MAX_PATH], cmd[MAX_CMD];
                    int ncmd = 0, code2, st2;
                    const char *arp = getenv("AR");
                    if (!arp || !arp[0]) arp = "ar";
                    if (oarg) {
                        if (snprintf(archive, sizeof archive, "%s", oarg)
                            >= (int)sizeof archive) {
                            fprintf(stderr, "ctc: archive path is too long\n");
                            return 1;
                        }
                    } else if (snprintf(archive, sizeof archive, "%s/lib%s.a",
                                        self->outdir, self->units[root_u].base)
                               >= (int)sizeof archive) {
                        fprintf(stderr, "ctc: archive path is too long\n");
                        return 1;
                    }
                    remove(archive);
                    if (ct_cmd_token(cmd, MAX_CMD, &ncmd, arp) != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, "rcsD") != 0
                        || ct_cmd_token(cmd, MAX_CMD, &ncmd, archive) != 0) {
                        fprintf(stderr, "ctc: the ar command line is too long\n");
                        return 1;
                    }
                    for (u = 0; u < self->nunits; u++) {
                        char obj[MAX_PATH];
                        if (self->units[u].is_map) continue;
                        if (snprintf(obj, sizeof obj, "%s/%s.o", self->outdir,
                                     self->units[u].base) >= (int)sizeof obj
                            || ct_cmd_token(cmd, MAX_CMD, &ncmd, obj) != 0) {
                            fprintf(stderr, "ctc: the ar command line is too long\n");
                            return 1;
                        }
                    }
                    {
                        char qcmd[MAX_CMD + 16];
                        snprintf(qcmd, sizeof qcmd, "%s 2>/dev/null", cmd);
                        st2 = system(qcmd);
                    }
                    if (st2 < 0 || ((st2 & 0x7f) ? 128 + (st2 & 0x7f) : ((st2 >> 8) & 0xff)) != 0) {
                        /* fallback: non-deterministic ar, fixed timestamp via
                           the shell's environment assignment (C99 has no setenv) */
                        ncmd = 0;
                        if (ct_cmd_token(cmd, MAX_CMD, &ncmd, arp) != 0
                            || ct_cmd_token(cmd, MAX_CMD, &ncmd, "rcs") != 0
                            || ct_cmd_token(cmd, MAX_CMD, &ncmd, archive) != 0)
                            return 1;
                        for (u = 0; u < self->nunits; u++) {
                            char obj[MAX_PATH];
                            if (self->units[u].is_map) continue;
                            if (snprintf(obj, sizeof obj, "%s/%s.o", self->outdir,
                                         self->units[u].base) >= (int)sizeof obj
                                || ct_cmd_token(cmd, MAX_CMD, &ncmd, obj) != 0)
                                return 1;
                        }
                        {
                            char envcmd[MAX_CMD + 32];
                            snprintf(envcmd, sizeof envcmd, "ZERO_AR_DATE=1 %s", cmd);
                            st2 = system(envcmd);
                        }
                        if (st2 < 0) return 1;
                        if (st2 & 0x7f) code2 = 128 + (st2 & 0x7f);
                        else code2 = (st2 >> 8) & 0xff;
                        if (code2 != 0) {
                            fprintf(stderr, "ctc: ar failed\n");
                            return 1;
                        }
                        printf("%s\n", cmd);
                        fflush(stdout);
                    }
                }
                return 0;
            }
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                return frontend::parse::ct_parse_report();
            }
        }
        /* Phase 37 O1: a signature mismatch is a hard error in build; fail
           before the cache/emit walk so no `.c` or `.h` is left behind. */
        if (tool::diag::ct_diag_nwarn() > 0) {
            if (tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
            self->diag_emitted = 1;
        }
        /* A shim header is found by base name, so two mapping units with the
           same base in different directories would both put `<base>.shim.h` on
           the include path and the C compiler would silently pick the first
           root. A clash is a build error, not a coin toss. */
        for (u = 0; u < self->nunits; u++) {
            int k;
            if (!self->units[u].is_map || !self->units[u].has_shim) continue;
            for (k = 0; k < u; k++) {
                if (!self->units[k].is_map || !self->units[k].has_shim) continue;
                if (strcmp(self->units[k].base, self->units[u].base) != 0) continue;
                if (strcmp(self->units[k].shim_dir, self->units[u].shim_dir) == 0) continue;
                fprintf(stderr, "ctc: shim base name '%s' is ambiguous: %s and %s\n",
                        self->units[u].base,
                        self->units[k].shim_dir, self->units[u].shim_dir);
                return 1;
            }
        }
        /* Incremental cache (Phase 6.3, ported in 10.5): a unit whose key still
           matches and whose .c/.h are on disk is not regenerated. The walk is a
           dependency-first postorder, so a unit's key can fold its dependencies'
           digests; a unit whose dependency is dirty is dirty too. `--emit-map`
           never reuses, because the map spans the whole run. */
        dirty = (int *)calloc((size_t)self->nunits, sizeof(*dirty));
        cstate = (int *)calloc((size_t)self->nunits, sizeof(*cstate));
        corder = (int *)calloc((size_t)self->nunits, sizeof(*corder));
        if (!dirty || !cstate || !corder) {
            fprintf(stderr, "ctc: out of memory\n");
            return 1;
        }
        for (u = 0; u < self->nunits; u++) cstate[u] = 0;
        cn = 0;
        for (u = 0; u < self->nunits; u++)
            if (self->cache_order(u, cstate, corder, &cn) != 0) {
                return frontend::parse::ct_parse_report();
            }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            int k;
            u = corder[o];
            dirty[u] = 1;
            /* A map unit writes nothing, but its digest is folded by every
               consumer, so the key is computed and it is never a cache hit. */
            if (self->units[u].is_map) {
                if (self->cache_key_of(u, key, sizeof key) != 0)
                    return frontend::parse::ct_parse_report();
                dirty[u] = 0;
                continue;
            }
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    >= (int)sizeof outc) {
                fprintf(stderr, "ctc: output path is too long\n");
                return 1;
            }
            if (!self->have_map && self->cache_key_of(u, key, sizeof key) == 0
                && self->cache->hit(outc, key, self->units[u].is_hdr))
                dirty[u] = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (dirty[self->units[u].depu[k]]) dirty[u] = 1;
            /* Phase 29: the built-in layer's `.h` carries one definition per
               instance the whole build asks for, so its content depends on the
               consumers, not only on its own source. Its key cannot see that
               set, so it is re-emitted every run: a new `Vec<char *>` in an
               unrelated unit must not meet a cached header. */
            if (self->is_builtin_unit(u)) dirty[u] = 1;
        }
        /* PH-64 T2: decide, once per build, which built-in units the program
           can reach. A dead unit is neither emitted nor linked, and the
           products stop including its header. */
        for (o = 0; o < self->nbuiltin; o++)
            self->builtin_live[o] = self->builtin_live_for(self->builtin_units[o]);
        self->computed_live = 1;
        backend::emit::ct_emit_bind_builtin_live(self->builtin_live);
        if (ct_shim_ambiguity(self, self->units, self->nunits)) return 1;
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            u = corder[o];
            if (self->units[u].is_map) continue;
            if (!dirty[u]) continue;
            if (self->emit_unit(u) != 0) {
                /* the `.c` was already opened, so a failure leaves half a file;
                   a failed unit must not leave an artefact behind */
                if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                        < (int)sizeof outc)
                    remove(outc);
                return frontend::parse::ct_parse_report();
            }
            if (self->units[u].is_hdr && self->write_unit_header(u) != 0) {
                /* symmetric with the `.c` above: a half-written `.h` looks like
                   a real artefact, so drop it too */
                if (snprintf(outc, sizeof outc, "%s/%s.h", self->outdir, self->units[u].base)
                        < (int)sizeof outc)
                    remove(outc);
                return frontend::parse::ct_parse_report();
            }
            /* stamped only after a successful emit: a failed unit must never be
               reused, and a stale key must never vouch for new sources */
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    < (int)sizeof outc
                && self->cache_key_of(u, key, sizeof key) == 0)
                self->cache->store(outc, key);
        }
        {
            /* SH-79: the model/map describe the entry unit, not whatever unit
               happened to load first (the builtin layer) or last (a dependency
               loaded after the entry). */
            int entry = (self->lib_root >= 0) ? self->lib_root : -1;
            int ui;
            if (entry < 0 && ninput > 0) {
                const char *want = inputs[ninput - 1];
                size_t wl = strlen(want);
                for (ui = 0; ui < self->nunits; ui++) {
                    size_t ul = strlen(self->units[ui].path);
                    if (strcmp(self->units[ui].path, want) == 0
                        || (ul >= wl && strcmp(self->units[ui].path + ul - wl, want) == 0)) {
                        entry = ui;
                        break;
                    }
                }
            }
            if (entry < 0) entry = self->nunits - 1;
            if (entry < 0 || entry >= self->nunits) entry = 0;
            self->model_unit = entry;
        }
        if (self->have_map && self->write_map(self->map_path, self->units[self->model_unit].prog, self->model_unit) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (self->have_model && self->write_model(self->model_path, self->units[self->model_unit].prog) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (!self->diag_emitted && tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
        if (self->emit_c) {
            /* PH-69-R1: `ct check` reuses this path only for the unit graph;
               the suggested cc line is not part of check output. */
            if (backend::emit::ct_emit_no_write()) return 0;
            /* The old shape, unchanged: print the suggested line, run nothing.
               The target C standard (Phase 6.4) is the only option it carries. */
            printf("cc %s", self->std_flag);
            /* A shim header is included by base name, so its directory becomes
               an include root; one root is printed once even for several
               mappings. */
            for (u = 0; u < self->nunits; u++) {
                int dupd = 0;
                if (!self->units[u].is_map || !self->units[u].has_shim) continue;
                for (i = 0; i < u; i++)
                    if (self->units[i].is_map && self->units[i].has_shim
                        && strcmp(self->units[i].shim_dir, self->units[u].shim_dir) == 0)
                        dupd = 1;
                if (!dupd) printf(" -I %s", self->units[u].shim_dir);
            }
            /* A shim source may include a generated type header, so the output
               directory is an include root too. It goes after every shim root:
               a generated `<Type>.h` must never shadow a same-named system
               header that a shim directory carries. */
            printf(" -I %s", self->outdir);
            for (u = 0; u < self->nunits; u++) {
                int bs;
                if (self->units[u].is_map) continue;
                bs = self->builtin_slot(u);
                if (bs >= 0 && !self->builtin_live[bs]) continue;
                printf(" %s/%s.c", self->outdir, self->units[u].base);
            }
            /* The shim implementation is part of the program, not an artefact:
               it is compiled straight from its source next to the mapping unit. */
            for (u = 0; u < self->nunits; u++) {
                if (!self->units[u].is_map || !self->units[u].shim_c[0]) continue;
                printf(" %s", self->units[u].shim_c);
            }
            printf(" -o a.out\n");
            return 0;
        }
        /* The default form (D17-9): compose the line, print it, run it. Every
           path is single-quoted; --cflags / --ldflags are pass-through and go
           in verbatim. */
        ccpath = self->cc;
        if (!ccpath) ccpath = getenv("CC");
        if (!ccpath || !ccpath[0]) ccpath = "cc";
        ncmd = 0;
        cmd[0] = 0;
        if (ct_cmd_token(cmd, MAX_CMD, &ncmd, ccpath) != 0
            || ct_cmd_raw(cmd, MAX_CMD, &ncmd, self->std_flag) != 0
            || ct_cmd_raw(cmd, MAX_CMD, &ncmd, self->cflags) != 0)
            goto cmd_too_long;
        for (u = 0; u < self->nunits; u++) {
            int dupd = 0;
            if (!self->units[u].is_map || !self->units[u].has_shim) continue;
            for (i = 0; i < u; i++)
                if (self->units[i].is_map && self->units[i].has_shim
                    && strcmp(self->units[i].shim_dir, self->units[u].shim_dir) == 0)
                    dupd = 1;
            if (dupd) continue;
            if (ct_cmd_raw(cmd, MAX_CMD, &ncmd, "-I") != 0
                || ct_cmd_token(cmd, MAX_CMD, &ncmd, self->units[u].shim_dir) != 0)
                goto cmd_too_long;
        }
        /* Same root, same order as the printed line: the output directory last,
           so a generated `<Type>.h` cannot shadow a system header. */
        if (ct_cmd_raw(cmd, MAX_CMD, &ncmd, "-I") != 0
            || ct_cmd_token(cmd, MAX_CMD, &ncmd, self->outdir) != 0)
            goto cmd_too_long;
        for (u = 0; u < self->nunits; u++) {
            char src[MAX_PATH];
            if (self->units[u].is_map) continue;
            {
                int bs = self->builtin_slot(u);
                if (bs >= 0 && !self->builtin_live[bs]) continue;
            }
            if (snprintf(src, sizeof src, "%s/%s.c", self->outdir, self->units[u].base)
                    >= (int)sizeof src || ct_cmd_token(cmd, MAX_CMD, &ncmd, src) != 0)
                goto cmd_too_long;
        }
        for (u = 0; u < self->nunits; u++) {
            if (!self->units[u].is_map || !self->units[u].shim_c[0]) continue;
            if (ct_cmd_token(cmd, MAX_CMD, &ncmd, self->units[u].shim_c) != 0)
                goto cmd_too_long;
        }
        if (ct_cmd_raw(cmd, MAX_CMD, &ncmd, self->ldflags) != 0
            || ct_cmd_token(cmd, MAX_CMD, &ncmd, "-o") != 0
            || ct_cmd_token(cmd, MAX_CMD, &ncmd, self->exe) != 0)
            goto cmd_too_long;
        printf("%s\n", cmd);
        fflush(stdout);
        st = system(cmd);
        if (st < 0) {
            fprintf(stderr, "ctc: cannot run '%s'\n", ccpath);
            return 1;
        }
        if (st & 0x7f) code = 128 + (st & 0x7f);
        else code = (st >> 8) & 0xff;
        if (code == 127) fprintf(stderr, "ctc: cannot run '%s'\n", ccpath);
        return code;
cmd_too_long:
        fprintf(stderr, "ctc: the cc command line is too long\n");
        return 1;
    }

    /* The emitter (backend::emit) owns the code generation; these facades hand
       the first raw failure to the error store in the shape it deserves: a node
       error keeps its line, an output-file error has none. */
    int emit_program(int prog)
    {
        const char *why;
        if (backend::emit::ct_emit_program(prog) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail_emit(why);
            return -1;
        }
        return 0;
    }

    /* PH-64 T2: is built-in unit `u` reachable from this program? A generic
       unit is live when one of its templates was instantiated (`Vec`/`Map` for
       the Vec unit); `Str` is a plain struct, so the sources are scanned for
       the name. `Vec` uses `Str` in its own signatures, which is the only
       inter-unit edge in the layer. */
    int builtin_live_for(int u)
    {
        const char *base;
        int i, n, su = -1, si = -1, uu = -1, us = -1, str_used = 0, u16_used = 0;
        struct frontend_sym_StructInst *ins;
        (void)self;

        if (!self->is_builtin_unit(u)) return 1;
        base = self->units[u].base;
        /* PH-80 / SH-120: the string units are plain structs, so the user
           sources are scanned for their names and exported functions. The
           UTF-8 and UTF-16 halves are scanned separately: a UTF-8-only program
           must not emit the UTF-16 units, while a UTF-16 program needs
           String / Str / U16Str because U16String calls their helpers. */
        for (i = 0; i < self->nbuiltin; i++) {
            const char *b = self->units[self->builtin_units[i]].base;
            if (strcmp(b, "Str") == 0) su = self->builtin_units[i];
            if (strcmp(b, "String") == 0) si = self->builtin_units[i];
            if (strcmp(b, "U16String") == 0) uu = self->builtin_units[i];
            if (strcmp(b, "U16Str") == 0) us = self->builtin_units[i];
        }
        for (i = 0; i < self->nunits; i++) {
            if (self->is_builtin_unit(i)) continue;
            /* The layer helpers now span the pair: `str_slice` / `str_compare`
               live in Str, `str_dup` / `str_concat` / `ct_str_live_count` in
               String. Scan both ranges so a helper call is still a use. */
            if (su >= 0 && file_uses_str(self->sym, self->units[i].path,
                                         self->units[su].fn_start,
                                         self->units[su].fn_end, 0))
                str_used = 1;
            if (si >= 0 && file_uses_str(self->sym, self->units[i].path,
                                         self->units[si].fn_start,
                                         self->units[si].fn_end, 0))
                str_used = 1;
            if (uu >= 0 && file_uses_str(self->sym, self->units[i].path,
                                         self->units[uu].fn_start,
                                         self->units[uu].fn_end, 1))
                u16_used = 1;
            if (us >= 0 && file_uses_str(self->sym, self->units[i].path,
                                         self->units[us].fn_start,
                                         self->units[us].fn_end, 1))
                u16_used = 1;
        }
        ins = frontend::sym::ct_insts(&n);
        for (i = 0; i < n; i++) {
            /* PH-80: the built-in layer itself names `Vec<U16String>` (the
               `split` result), so parsing it registers a `Vec` instance.
               That layer-internal instance must not make the container unit
               live on its own; a concrete `Vec`/`Map` named by a user unit, or
               the container the live string layer needs, pulls it in (below). */
            if (strcmp(base, "Vec") == 0
                && (strcmp(ins[i].tmpl, "Vec") == 0 || strcmp(ins[i].tmpl, "Map") == 0)
                && !self->is_builtin_unit(ins[i].owner))
                return 1;
            if (strcmp(base, "Option") == 0 && strcmp(ins[i].tmpl, "Option") == 0
                && !self->is_builtin_unit(ins[i].owner)) return 1;
            if (strcmp(base, "Result") == 0 && strcmp(ins[i].tmpl, "Result") == 0
                && !self->is_builtin_unit(ins[i].owner)) return 1;
            /* SH-116: `Box` has its own layer unit (PH-81), so it needs the same
               on-demand rule as the other templates. Without this branch the
               unit was loaded but pruned: the product kept only
               `struct ct_Box_hdr;` and `cc` rejected the incomplete type. */
            if (strcmp(base, "Box") == 0 && strcmp(ins[i].tmpl, "Box") == 0
                && !self->is_builtin_unit(ins[i].owner)) return 1;
            if (strcmp(base, "Str") == 0
                && (has_word(ins[i].ctype[0], "Str") || has_word(ins[i].carg[0], "Str"))
                && !self->is_builtin_unit(ins[i].owner))
                return 1;
            if (strcmp(base, "U16String") == 0
                && (has_word(ins[i].ctype[0], "U16String")
                    || has_word(ins[i].carg[0], "U16String"))
                && !self->is_builtin_unit(ins[i].owner))
                return 1;
        }
        /* The string layer needs the container unit for `split`; the UTF-16
           half additionally needs the UTF-8 half (String / Str) and U16Str. */
        if (strcmp(base, "Vec") == 0) {
            if (su >= 0 && (str_used || u16_used)) return 1;
            return 0;
        }
        if (strcmp(base, "Str") == 0 || strcmp(base, "String") == 0)
            return (str_used || u16_used) ? 1 : 0;
        if (strcmp(base, "U16Str") == 0 || strcmp(base, "U16String") == 0)
            return u16_used ? 1 : 0;
        return 0;
    }

    /* PH-65 R1: the policy for one unit path. The CLI wins; then the package
       manifest (its units follow the package's key); then the four
       grandfathered in-repo directories; else the external default, strict.
       SH-93: the working directory is not an input. */
    int c_boundary_for(const char *path)
    {
        int i, r;

        if (self->c_boundary >= 0) return self->c_boundary;
        {
            const char *e = getenv("CT_C_BOUNDARY");
            if (e != 0 && strcmp(e, "allow") == 0) return 0;
            if (e != 0 && strcmp(e, "strict") == 0) return 1;
        }
        /* A package manifest is the most specific statement about a unit that
           lives inside that package: it wins over the four in-repo
           directories, so a package's own strict setting is testable from the
           repo root. */
        for (i = 0; i < self->ninc; i++) {
            if (strncmp(path, self->incdirs[i], strlen(self->incdirs[i])) != 0)
                continue;
            r = c_manifest_boundary(self->incdirs[i]);
            if (r >= 0) return r;
            /* A package published before PH-65 has no `c-boundary` key: it
               keeps the allow window instead of breaking on upgrade (D65-7). */
            if (c_has_manifest(self->incdirs[i])) return 0;
        }
        if (c_path_is_core(path)) return 0;
        return 1;
    }

    /* PH-82 (D-012): the package's leak policy. `leaks = error` escalates the
       existing leak diagnostics and the direct-cycle warning, nothing else;
       `c-boundary` and `--debug-leaks` keep their own contracts. An `-I` root
       with a manifest is the package statement; without one the unit's own
       directory is read, so `ct compile`/`ct check` (which ignore `-I`) still
       see the package they live in. A missing key or any other value keeps the
       pre-PH-82 `warn` behaviour, so old packages do not change. */
    int leaks_for(const char *path)
    {
        char v[MAX_TEXT];
        char dir[MAX_PATH];
        int i, n;
        size_t l;

        if (path != 0)
            for (i = 0; i < self->ninc; i++) {
                l = strlen(self->incdirs[i]);
                if (l == 0 || strncmp(path, self->incdirs[i], l) != 0) continue;
                if (ct_pkg_key(self->incdirs[i], "leaks", v, sizeof v))
                    return strcmp(v, "error") == 0 ? 1 : 0;
                return 0;
            }
        if (path == 0 || path[0] == 0) return 0;
        n = self->path_dir(path, dir, sizeof dir);
        if (n != 0) return 0;
        if (ct_pkg_key(dir, "leaks", v, sizeof v) && strcmp(v, "error") == 0) return 1;
        return 0;
    }

    /* PH-82 (D-012): the direct-cycle warning. Nodes are plain, defined structs
       (generic templates/instances stay out, so generics never report); an edge
       is a `Box<X>` field and adjacent edges count one. The walk stops at three
       edges, a repeated payload field is one edge, and a cycle is emitted from
       its smallest row, so A -> B -> A and B -> A -> B are one finding. */
    int cycle_check(void)
    {
        int nrows, i, fi, a, b, c, j, k, n;

        nrows = self->sym->nstructs;
        if (nrows > CYCLE_ROWS) nrows = CYCLE_ROWS;
        for (i = 0; i < nrows; i++) g_cycle_nout[i] = 0;
        for (i = 0; i < nrows; i++) {
            if (!self->sym->structs[i].defined) continue;
            if (self->sym->structs[i].is_template) continue;
            if (self->sym->structs[i].is_inst) continue;
            for (fi = 0; fi < self->sym->structs[i].nfields; fi++) {
                k = cycle_Box_target(self, i, fi);
                if (k < 0) continue;
                for (j = 0; j < g_cycle_nout[i]; j++)
                    if (g_cycle_adj[i][j] == k) break;
                if (j < g_cycle_nout[i]) continue;
                if (g_cycle_nout[i] >= CYCLE_DEGREE) continue;
                g_cycle_adj[i][g_cycle_nout[i]++] = k;
            }
        }
        for (a = 0; a < nrows; a++) {
            if (!self->sym->structs[a].defined) continue;
            if (self->sym->structs[a].is_template) continue;
            if (self->sym->structs[a].is_inst) continue;
            for (j = 0; j < g_cycle_nout[a]; j++) {
                b = g_cycle_adj[a][j];
                if (b == a) {
                    if (cycle_emit(self, a, -1, -1) != 0) return 1;
                    continue;
                }
                for (k = 0; k < g_cycle_nout[b]; k++) {
                    c = g_cycle_adj[b][k];
                    if (c == a) {
                        if (a < b && cycle_emit(self, a, b, -1) != 0) return 1;
                        continue;
                    }
                    if (c == b) continue;
                    for (n = 0; n < g_cycle_nout[c]; n++)
                        if (g_cycle_adj[c][n] == a) break;
                    if (n < g_cycle_nout[c] && a < b && a < c
                        && cycle_emit(self, a, b, c) != 0)
                        return 1;
                }
            }
        }
        return 0;
    }

    /* PH-66 R1: bit0 = <stdio.h>, bit1 = <wchar.h>; `to` is exclusive. */
    /* PH-66 R1/R2: bit0 = <stdio.h>, bit1 = <wchar.h>. `unit < 0` covers every
       call (compile mode merges the layer and the input into one unit). */
    int io_header_mask(int unit)
    {
        const char *h;
        int i, mask = 0;

        (void)self;
        for (i = 0; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (unit >= 0 && frontend::parse::ct_parse_io_call_unit(i) != unit) continue;
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            h = io_header_for(frontend::parse::ct_parse_io_call_name(i));
            if (h == 0) continue;
            if (strcmp(h, "stdio.h") == 0) mask |= 1;
            else mask |= 2;
        }
        return mask;
    }

    /* Compile mode: the layer units are parsed first but only the ones the
       input uses are spliced, so only calls recorded after `from` belong to
       the product. */
    int io_header_mask_tail(int from)
    {
        const char *h;
        int i, mask = 0;

        (void)self;
        for (i = from; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            h = io_header_for(frontend::parse::ct_parse_io_call_name(i));
            if (h == 0) continue;
            if (strcmp(h, "stdio.h") == 0) mask |= 1;
            else mask |= 2;
        }
        return mask;
    }

    /* The freestanding diagnostic names the first libc I/O call the product
       would need; empty when there is none. */
    const char *io_first_name(int from)
    {
        int i;

        (void)self;
        for (i = from; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            if (io_header_for(frontend::parse::ct_parse_io_call_name(i)) != 0)
                return frontend::parse::ct_parse_io_call_name(i);
        }
        return "";
    }

    int io_first_line(int from)
    {
        int i;

        (void)self;
        for (i = from; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            if (io_header_for(frontend::parse::ct_parse_io_call_name(i)) != 0)
                return frontend::parse::ct_parse_io_call_line(i);
        }
        return 0;
    }

    int io_call_count(void)
    {
        (void)self;
        return frontend::parse::ct_parse_io_call_count();
    }

    int builtin_slot(int u)
    {
        int i;
        for (i = 0; i < self->nbuiltin; i++)
            if (self->builtin_units[i] == u) return i;
        return -1;
    }

    int emit_unit(int u)
    {
        {
            int bs = self->builtin_slot(u);
            if (bs >= 0 && self->computed_live && !self->builtin_live[bs]) return 0;
        }
        const char *why;
        /* a diagnostic raised while emitting this unit must name this unit: the
           error store reads `mem->path`, the capacity messages `sym->path` */
        self->path = self->units[u].path;
        self->mem->path = self->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_bind_io_mask(self->io_header_mask(u));
        if (backend::emit::ct_emit_unit(u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail_emit(why);
            return -1;
        }
        return 0;
    }

    int write_unit_header(int u)
    {
        {
            int bs = self->builtin_slot(u);
            if (bs >= 0 && self->computed_live && !self->builtin_live[bs]) return 0;
        }
        const char *why;
        if (backend::emit::ct_emit_unit_header(u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* Compile mode has no unit table, so the rule is read from the input path:
       a `.h.ct` source publishes its header, a plain `.ct` one does not. */
    int write_header(const char *outc)
    {
        const char *why;
        size_t pl;
        (void)self;
        pl = strlen(self->path);
        if (!(pl > 5 && strcmp(self->path + pl - 5, ".h.ct") == 0)) return 0;
        if (backend::emit::ct_emit_header(outc) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        const char *why;
        if (backend::emit::ct_emit_map(dest, prog, u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_model(const char *dest, int prog)
    {
        const char *why;
        if (backend::emit::ct_emit_model(dest, prog) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }
}

/* Shell-line helpers for the one-step build (Phase 17.6). */






/* The same segment claimed by two `-I` roots: an error, never a silent pick.
   `file` names the later manifest, which is the one to change. */
static int ct_pkg_ns_clash(struct Module *m, char *msg, int cap, char *file, int fcap)
{
    char ns[MAX_TEXT];
    char nroot[MAX_PATH];
    char nother[MAX_PATH];
    int i, j;

    for (i = 0; i < m->ninc; i++) {
        if (!ct_pkg_key(m->incdirs[i], "namespace", ns, sizeof ns)) continue;
        ct_norm_path(m->incdirs[i], nroot, sizeof nroot);
        for (j = 0; j < i; j++) {
            char other[MAX_TEXT];
            if (!ct_pkg_key(m->incdirs[j], "namespace", other, sizeof other)) continue;
            if (strcmp(ns, other) != 0) continue;
            /* One directory spelled twice (`-I a -I ./a`) is one package, not a
               clash with itself. */
            ct_norm_path(m->incdirs[j], nother, sizeof nother);
            if (strcmp(nroot, nother) == 0) continue;
            snprintf(msg, (size_t)cap,
                     "package namespace '%s' is declared by two import roots: '%s' and '%s'",
                     ns, m->incdirs[j], m->incdirs[i]);
            snprintf(file, (size_t)fcap, "%s/ct.pkg", m->incdirs[i]);
            return 1;
        }
    }
    return 0;
}



/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Module g_module;

/* Storage for the unit table: its element type belongs to `unit.h.ct`, and a
   generated header carries no `#include`, so the array stays here and
   `g_module` points at it. It is a heap block (SH-42): a `struct Unit` caches
   its parsed text, so 64 of them inline put ~620 KB of zeroes into __DATA. */
static struct Unit *g_units;

pub struct Module *module_get(void);
struct Module *module_get(void)
{
    return &g_module;
}

/* The driver wires the collaborators and the shared table once, before it
   dispatches; the name and the version it sets through the object itself. */
pub void ct_module_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *p, void *cache);
/* PH-66 R1: the driver and the build path both need the header mask. */
pub int ct_module_io_mask(int unit);
int ct_module_io_mask(int unit)
{
    return g_module.io_header_mask(unit);
}

void ct_module_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *p, void *cache)
{
    g_module.arena = (struct Arena *)arena;
    g_module.lex = (struct Lexer *)lex;
    g_module.sym = (struct Symbols *)sym;
    g_module.ty = (struct TypeCheck *)ty;
    g_module.mem = (struct Memory *)mem;
    g_module.p = (struct Parser *)p;
    g_module.cache = (struct Cache *)cache;
    if (!g_units) {
        g_units = calloc(MAX_UNITS, sizeof(*g_units));
        if (!g_units) {
            fprintf(stderr, "ctc: out of memory\n");
            exit(1);
        }
        g_module.unitcap = MAX_UNITS;
    }
    g_module.units = g_units;
    if (!g_module.incdirs) {
        g_module.incdirs = calloc(MAX_INCDIRS, sizeof(*g_module.incdirs));
        if (!g_module.incdirs) {
            fprintf(stderr, "ctc: out of memory\n");
            exit(1);
        }
        g_module.inccap = MAX_INCDIRS;
    }
    /* PH-65 R1: both modes start from "resolve per path"; build_main and the
       driver may override it from the command line. */
    g_module.c_boundary = -1;
    g_module.show_c_boundary = 0;
    g_module.show_io_headers = 0;
}
