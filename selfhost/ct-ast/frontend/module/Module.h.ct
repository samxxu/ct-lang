import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import tool::cache::Cache;
import tool::diag::Diag;
import tool::sh::Sh;
import frontend::module::ModuleBoundary;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160
/* S8 shell plan row kinds (mirror of backend/lir/LModule.h.ct). */
#define LPS_PP          1
#define LPS_TYPE        3
#define LPS_GLOBAL      4
#define LPS_SASSERT     5
#define LPS_FUNC        6
#define LPS_DROP        7
#define LPS_RAW         8
#define LPS_INC         9
#define LPS_PROTO       10
#define LPS_INPROTO     11
#define LPS_INST        12
#define LPS_INSTPROTO   13
#define LPS_INSTHELP    14
#define LPS_IMPL        15
#define LPS_BOXPROTO    16
#define LPS_BOXHELP     17
#define LPS_ADTLIFE     18
#define LPS_STRPROTO    19
#define LPS_STRUCTFWD   20
#define LPS_TRAITDECL   21
#define LPS_VTBLFWD     22
#define LPS_DROPPROTO   23
#define LPS_HANDBAK     24
#define LPS_LINKEXTERN  25
#define LPS_IMPLDEF     26
#define LPS_MAPDEF      27
#define LPS_GINIT       28
#define LPS_UNITINIT    29
#define LPS_STRLIT      30
/* S8 closeout: map / model JSON row kinds (mirror of backend/lir/LModule.h.ct). */
#define LMP_TRAIT          1
#define LMP_TRAIT_M        2
#define LMP_STRUCT         3
#define LMP_STRUCT_USE     4
#define LMP_FUNC           5
#define LMP_IMPL           6
#define LMP_CALL           7
#define LMP_MAP            8
#define LMP_MAP_BIND       9
#define LMP_MSTRUCT       10
#define LMP_MSTRUCT_FIELD 11
#define LMP_MENUM         12
#define LMP_MENUM_M       13
#define LMP_MFUNC         14
#define LMP_MFUNC_PARAM   15
#define LMP_MAP_STATIC     1
#define LMP_MAP_TYPE_HOST  2
#define LMP_MAP_NS_HOST    4
#define LMP_MAP_SHIM       8
#define LMP_MAP_SHIM_SRC  16
#define LINC_C_IO       0
#define LINC_C_PRE      1
#define LINC_C_POST     2
#define LINC_H_PRE      3
#define LINC_H_POST     4
#define MAX_UNITS  64
#define CAP_LIMIT 65536
#define MAX_IMPORTS 32
#define MAX_INCDIRS 16
#define MAX_FLAGS  1024                 /* accumulated --cflags / --ldflags */
#define MAX_CMD    8192                 /* one composed cc command line */
#define MAX_KEY    768                  /* one unit's incremental-cache key */

/* token kinds (the scanner only needs these two) */
#define T_ID     1
#define T_PUNCT  4
#define T_PP     5
/* node kinds: file-scope variables and the two type declarations, the same
   values `Arena.h.ct` assigns */
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_NUM      8
#define N_STR      9
#define N_RAW     31
#define N_GLOBAL  22
#define N_IMPL    33
#define N_ENUM    45
#define N_ENUMVAL 46
#define N_UNION   48
#define N_PP       2
#define N_FUNC     3
#define N_SASSERT 55
#define N_RAW_TEXT 58

namespace frontend::module;

/* S1b-S2b: the LIR body seam, bound to the emitter for one unit's `.c`. A
   body the lowerer covered end to end is printed from LIR; everything else
   keeps the emitter's own writer, byte for byte. */
static int mod_lir_body(const char *name, void *out, int ind, int ntmp,
                        int *new_ntmp, int stmts)
{
    return backend::lir::ct_lir_try_body(name, out, ind, ntmp, new_ntmp, stmts);
}
/* Shell-line helpers for the one-step build (Phase 17.6); defined after the
   impl. They are free functions, not methods: the L2 build path caps impl
   methods per compile, and these need no object state. */
pub trait ModuleOps {
    int  fail(const char *msg);
    int  fail_emit(const char *msg);
    int  read_file(const char *path);
    int  base_name(const char *path, char *out, int cap, int *is_hdr, int *is_map);
    int  path_dir(const char *path, char **out);
    /* S1a-0 C1: the three module tables grow by doubling from their old caps
       (MAX_UNITS / MAX_IMPORTS / MAX_INCDIRS) to their `*_MAX` ceiling. */
    int  ensure_unit_capacity(int need);
    int  ensure_incdir_capacity(int need);
    int  ensure_unit_dep_capacity(int u, int need);
    int  ensure_reach(int need);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char **out,
                        int *is_hdr, int *is_map, int line);
    int  load_unit(const char *path);
    /* Phase 29 E29-5: locate the built-in container layer for `ct build`, with
       the same five probes the compile-mode driver uses. `base` names the file
       inside the layer (`Vec.h.ct`, `Option.h.ct`, `Result.h.ct`). */
    int  find_builtin(const char *in, const char *base, char **out);
    int  is_builtin_unit(int u);
    int  builtin_slot(int u);
    int  builtin_live_for(int u);
    int  c_boundary_for(const char *path);
    /* PH-82: the package's `leaks = warn|error` key (D-012). 0 = warn (also
       the default and every old package), 1 = error. It resolves from the
       input's package root: an `-I` root with a manifest first, then the
       unit's own directory, so compile mode reads it without `-I` too. */
    int  leaks_for(const char *path);
    /* PH-82: the direct-cycle warning over the `Box<X>` field graph (depth 3). */
    int  cycle_check(void);
    int  io_header_mask(int unit);
    int  io_header_mask_tail(int from);
    int  io_call_count(void);
    const char *io_first_name(int from);
    int  io_first_line(int from);
    int  unit_reaches(int from, int to);
    int  register_visible_type_aliases(int u);
    int  scan_forward_type_aliases(const char *path, int owner);
    int  check_ns_dir(int u);
    /* PH-48 D48-2 (L48-2): every exported `use Drop` struct must publish its
       `<S>_Drop_drop` body from the unit that declares it; an impl written in
       another unit has no prototype in the type's header. */
    int  check_drop_visibility(void);
    /* PH-81: load the Box unit only when an input names it. */
    int  module_src_wants_Box(const char *path);
    int  module_inputs_want_Box(const char **ins, int n);
    int  cache_order(int u, int *state, int *order, int *n);
    int  cache_key_of(int u, char **out);
    int  lib_scan(int root_u);
    int  build_main(int argc, char **argv);
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  write_header(const char *outc);
    int  write_map(const char *dest, int prog, int u);
    int  write_model(const char *dest, int prog);
}

pub struct Module {
    /* Collaborators the methods reach through; the driver wires them once. */
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct TypeCheck *ty;
    struct Memory *mem;
    struct Parser *p;
    struct Cache *cache;
    /* Output state for one run: the source path the banner and diagnostics
       report. The driver re-points it for each unit in build mode. */
    const char *path;
    /* Build mode: the unit table and the import search roots. These tables have
       element types from this same namespace; a generated header carries no
       `#include`, so their storage lives in this unit's `.c` and the object
       keeps a pointer. */
    struct Unit *units;
    int  nunits;
    int  unitcap;               /* S1a-0 C1: grows from MAX_UNITS on demand */
    int  build_mode;
    /* S1a-0 C2l: the output / map / model paths are run-scoped owned blocks;
       the import roots grow from MAX_INCDIRS (16) on demand, so their storage
       is a heap block too. */
    char *outdir;               /* S1a-0 C2l: run-scoped owned path */
    const char **incdirs;
    int  ninc;
    int  inccap;
    const char *nsroot;
    /* S1a-0 C1: the reachability walk's scratch row (one byte per unit),
       grown on demand and reused; `unit_reaches` is not re-entrant. */
    char *reach;
    int  reachcap;
    /* Run options. `prog` is the entry name `-v` and the usage lines print
       (D44): `ct` when installed under that name, `ctc` for the compatibility
       alias, `ct-ast` for the development binary. Driver diagnostics keep the
       published `ctc:` prefix (SH-3 / phase10 non-goal). */
    int  line_mode;             /* emit `#line`: 0 off, 1 on */
    /* Phase 29 E29-5: the built-in layer is an implicit dependency of every
       unit, so `Vec` / `Map` work in a multi-unit `ct build` without an import.
       Phase 34 S9a turns it into a set of files: `Vec.h.ct` keeps the
       containers, `Option.h.ct` / `Result.h.ct` carry the ecosystem types.
       `nbuiltin` is 0 when this installation has no layer. */
    int  builtin_units[8];
    int  nbuiltin;
    /* PH-64 T2: a built-in unit is emitted only when the program can reach it.
       Filled once per build, before the emit loop. */
    int  builtin_live[8];      /* slot order, parallel to builtin_units[] */
    /* v1-PH-2 S8: the semantic dependency graph's answer, computed once per
       build (backend/tir/TGraph.h.ct). `tgraph_done` keeps the per-slot query
       from re-walking the AST. */
    int  tgraph_live[8];
    int  tgraph_done;
    int  computed_live;
    int  line_force;            /* -1 mode default, 0 --no-line, 1 --line */
    char *map_path;             /* S1a-0 C2l: run-scoped owned path */
    int  have_map;
    char *model_path;           /* S1a-0 C2l: run-scoped owned path */
    int  have_model;
    const char *prog;
    int  diag_json;             /* --diagnostics=json */
    int  diag_codes;            /* --diag-codes: text carries [E-...] / [W-...] */
    int  diag_emitted;          /* build: warnings already printed before emit */
    /* `ct check` (19.4): parse and report the semantic findings, write no C.
       The driver's compile path short-circuits on it after parsing. */
    int  check_mode;
    /* PH-85 S85d: `ct build --check-level=off|warn|error` (0/1/2). SH-115:
       `warn` (1) was the CLI default; v1-PH-1 S3 makes `error` (2) the CLI
       default, so only an explicit 0 keeps the build path silent. */
    int  types_level;
    const char *std_flag;       /* --std=c99 | --std=gnu99 */
    const char *version;        /* CTC_VERSION, bound by the driver */
    /* Phase 17.6: the one-step build. `emit_c` keeps the old emit-only shape
       (`.c` / `.h` into `outdir`, nothing run); otherwise the C goes to
       `outdir` and the binary lands at `exe`. `cc` / `cflags` / `ldflags` are
       pass-through: composed into the line, never parsed or validated. */
    int  emit_c;
    int  lib_mode;              /* Phase 39: ct build --lib */
    int  lib_root;              /* root unit index for --lib */
    int  model_unit;            /* entry unit for --emit-model/-map */
    int  abi_mode;              /* 1 while Emitter writes the ABI header */
    int  abi_exports[256];      /* root function indices in the export set */
    int  abi_n;
    int  runtime_checks;        /* --runtime-checks: guard null vtables in build */
    /* PH-64: `--freestanding` promises the product needs no host runtime: no
       constructor, no libc, no implicit heap. `--alloc A[,B[,C[,D]]]` maps
       malloc/free/realloc/calloc onto the target's own symbols. */
    int  freestanding;
    /* PH-65 R1 / v1-PH-2 S9: the C boundary policy. -1 resolves per path
       (strict by default, a package manifest may override); 0 = allow,
       1 = strict. */
    int  c_boundary;
    int  show_c_boundary;
    /* PH-66 R1: print the libc I/O headers the program's direct calls need. */
    int  show_io_headers;
    char alloc_map[256];
    const char *exe;
    const char *outdir_opt;
    const char *cc;
    /* S1a-0 C2g: the accumulated flags grow from MAX_FLAGS (the old literal
       1024) to TEXT_LIMIT; the build line appends them verbatim. */
    char *cflags;
    int  cflagscap;
    char *ldflags;
    int  ldflagscap;
} use ModuleOps;

/* Declared here, after the struct, so the parameter spells the mangled type. */
static int ct_pkg_ns_clash(struct Module *m, char **msg, char **file);

/* PH-65 R5: two units with the same base both publishing a shim make the
   `#include "<base>.shim.h"` (and the `-I` set) ambiguous. */
static int ct_shim_ambiguity(struct Module *m, const struct Unit *units, int n)
{
    int i, j;

    for (i = 0; i < n; i++) {
        if (!units[i].has_shim) continue;
        for (j = i + 1; j < n; j++) {
            if (!units[j].has_shim) continue;
            if (strcmp(units[i].base, units[j].base) != 0) continue;
            fprintf(stderr, "ctc: shim base name '%s' is ambiguous: %s, %s\n",
                    units[i].base, units[i].path, units[j].path);
            return 1;
        }
    }
    (void)m;
    return 0;
}

/* S8 shell finishing: the include block is a module decision. One row per
   printed line, `pos` says where the shell prints it and "" is a blank line,
   so the blank-line grouping stays with the decision, not the renderer. */
static int ct_shell_inc(int unit, int pos, const char *line)
{
    return backend::lir::lmod_plan_shell_add_stage(LPS_INC, unit, 0, pos, 0,
                                                   line);
}

/* 1 when unit `u` writes an ADT layout (body) / publishes one (header). */
static int ct_unit_has_adt(struct Module *self, int u, int pub_only)
{
    int i, n;
    struct Adt *adts = frontend::sym::ct_adts(&n);

    (void)self;

    for (i = 0; adts && i < n; i++) {
        if (adts[i].owner != u) continue;
        if (pub_only && !adts[i].is_pub) continue;
        return 1;
    }
    return 0;
}

/* 1 when unit `u` defines a struct with both pub and private fields, so its
   header needs the `CT_UNIT_PRIVATE` guard. */
static int ct_unit_mixed_private(struct Module *self, int u)
{
    int si, fi;

    for (si = 0; si < self->sym->nstructs; si++) {
        int hp = 0, hv = 0;
        if (self->sym->structs[si].owner != u) continue;
        if (self->sym->structs[si].nuse > 0) continue;
        for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
            if (self->sym->structs[si].fields[fi].is_pub) hp = 1;
            else hv = 1;
        }
        if (hp && hv) return 1;
    }
    return 0;
}

/* The layer headers a unit includes. A normal build uses the liveness set the
   semantic graph computed; `--lib` runs before that decision, so it lists every
   loaded layer unit exactly as the pre-plan fallback did. */
static int ct_shell_add_layer_headers(struct Module *self, int unit, int pos)
{
    int i;

    if (self->computed_live) {
        for (i = 0; i < self->nbuiltin; i++) {
            const char *base;
            if (!self->builtin_live[i]) continue;
            if (self->builtin_units[i] == unit) continue;
            base = self->units[self->builtin_units[i]].base;
            if (ct_shell_inc(unit, pos, tool::sh::ct_scratch_fmt(
                                 "#include \"%s.h\"",
                                 strcmp(base, "String") == 0 ? "String_" : base)) != 0)
                return 1;
        }
    } else {
        for (i = 0; i < self->nbuiltin; i++) {
            const char *base;
            int bu = self->builtin_units[i];
            if (bu < 0 || bu >= self->nunits || bu == unit) continue;
            base = self->units[bu].base;
            if (ct_shell_inc(unit, pos, tool::sh::ct_scratch_fmt(
                                 "#include \"%s.h\"",
                                 strcmp(base, "String") == 0 ? "String_" : base)) != 0)
                return 1;
        }
    }
    return 0;
}

/* One unit's include rows, for its `.c` and (when it publishes one) its `.h`.
   Mirrors the exact order and blank-line grouping the shell used to assemble
   from the AST and the unit table. */
static int ct_shell_plan_add_includes(struct Module *self, int prog, int unit,
                                      int is_header)
{
    int i, pp;
    int n;
    struct Arena *ar = self->arena;
    const struct Unit *uu = &self->units[unit];

    if (!is_header) {
        int mask = self->io_header_mask(unit);
        if ((mask & 1) && ct_shell_inc(unit, LINC_C_IO, "#include <stdio.h>") != 0)
            return 1;
        if ((mask & 2) && ct_shell_inc(unit, LINC_C_IO, "#include <wchar.h>") != 0)
            return 1;
        if (ct_unit_has_adt(self, unit, 0)
            && ct_shell_inc(unit, LINC_C_PRE, "#include <stddef.h>") != 0)
            return 1;
        if (ct_unit_mixed_private(self, unit)
            && ct_shell_inc(unit, LINC_C_POST, "#define CT_UNIT_PRIVATE 1") != 0)
            return 1;
        if (uu->is_hdr) {
            if (ct_shell_inc(unit, LINC_C_POST, tool::sh::ct_scratch_fmt(
                                 "#include \"%s.h\"",
                                 strcmp(uu->base, "String") == 0
                                     ? "String_" : uu->base)) != 0)
                return 1;
        }
        for (i = 0; i < uu->ndep; i++) {
            if (self->units[uu->depu[i]].is_map) continue;
            if (ct_shell_inc(unit, LINC_C_POST, tool::sh::ct_scratch_fmt(
                                 "#include \"%s.h\"",
                                 uu->dep + (size_t)i * MAX_TEXT)) != 0)
                return 1;
        }
        if (ct_shell_add_layer_headers(self, unit, LINC_C_POST) != 0) return 1;
        if (ct_shell_inc(unit, LINC_C_POST, "") != 0) return 1;
        return 0;
    }
    /* `.h`: the author's C includes lead the header, then the published shim
       (unless the author already included it), then deps and layer headers. */
    if (ct_unit_has_adt(self, unit, 1)
        && ct_shell_inc(unit, LINC_H_PRE, "#include <stddef.h>") != 0)
        return 1;
    pp = 0;
    for (n = (prog >= 0) ? ar->nodes[prog].a : -1; n >= 0;
         n = ar->nodes[n].next) {
        if (ar->nodes[n].kind != N_PP) continue;
        if (strncmp(ar->nodes[n].text, "#include", 8) != 0) continue;
        if (ct_shell_inc(unit, LINC_H_POST, ar->nodes[n].text) != 0) return 1;
        pp++;
    }
    if (uu->has_shim) {
        int dup = 0;
        const char *shimline = tool::sh::ct_scratch_fmt(
            "#include \"%s.shim.h\"", uu->base);
        for (n = (prog >= 0) ? ar->nodes[prog].a : -1; n >= 0;
             n = ar->nodes[n].next) {
            if (ar->nodes[n].kind != N_PP) continue;
            if (strcmp(ar->nodes[n].text, shimline) == 0) { dup = 1; break; }
        }
        if (!dup && ct_shell_inc(unit, LINC_H_POST, shimline) != 0) return 1;
    }
    if (pp > 0 && ct_shell_inc(unit, LINC_H_POST, "") != 0) return 1;
    for (i = 0; i < uu->ndep; i++) {
        if (self->units[uu->depu[i]].is_map) continue;
        if (ct_shell_inc(unit, LINC_H_POST, tool::sh::ct_scratch_fmt(
                             "#include \"%s.h\"",
                             uu->dep + (size_t)i * MAX_TEXT)) != 0)
            return 1;
    }
    if (uu->ndep > 0 && ct_shell_inc(unit, LINC_H_POST, "") != 0) return 1;
    if (ct_shell_add_layer_headers(self, unit, LINC_H_POST) != 0) return 1;
    if (self->nbuiltin > 0 && ct_shell_inc(unit, LINC_H_POST, "") != 0) return 1;
    return 0;
}

/* S8 shell finishing: the glue tables the emitter used to walk are selected
   here as well. These predicates are the module layer's copy of the ones in
   `EmitDecl` / `EmitExpr`; they answer "which row does this product write",
   which is exactly the decision the plan carries. */
static const char *ct_norm_type_text(const char *type)
{
    char *res;
    const char *pooled;

    if (!type || !type[0]) return type;
    if (!strchr(type, '<')) return type;
    res = (char *)malloc(CAP_LIMIT);
    if (!res) return type;
    if (frontend::sym::ct_inst_resolve(type, res, CAP_LIMIT) != 0) {
        free(res);
        return type;
    }
    pooled = runtime::text::ct_intern(res);
    free(res);
    return pooled ? pooled : type;
}

static const char *ct_base_type_text(const char *type)
{
    const char *b;
    size_t n;

    b = type ? type : "";
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    else if (strncmp(b, "union ", 6) == 0) b += 6;
    else if (strncmp(b, "enum ", 5) == 0) b += 5;
    while (*b == ' ' || *b == '\t') b++;
    n = strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
    return runtime::text::ct_intern_len(b, (int)n);
}

static int ct_adt_owns(struct Module *self, int adi, int depth);
static int ct_adt_own_kind(struct Module *self, const char *type, int depth)
{
    const char *base;
    int ai;

    if (!type || !type[0] || depth > 16) return 0;
    if (strchr(type, '*') || strchr(type, '[')) return 0;
    if (frontend::sym::ct_is_string_value_type(type)) return 1;
    base = ct_base_type_text(ct_norm_type_text(type));
    if (base && (strncmp(base, "Vec_", 4) == 0
                 || strncmp(base, "Map_", 4) == 0)) return 1;
    if (base && backend::emit::inst_is_builtin_Box(base)) return 1;
    ai = frontend::sym::ct_adt_from_type(type);
    if (ai >= 0 && ct_adt_owns(self, ai, depth + 1)) return 1;
    return 0;
}

static int ct_adt_owns(struct Module *self, int adi, int depth)
{
    int v, f, n;
    struct Adt *adts = frontend::sym::ct_adts(&n);

    (void)self;
    if (!adts || adi < 0 || adi >= n || depth > 16) return 0;
    if (adts[adi].is_template) return 0;
    for (v = 0; v < adts[adi].nvariants; v++)
        for (f = 0; f < adts[adi].variants[v].nfields; f++)
            if (ct_adt_own_kind(self, adts[adi].variants[v].fields[f].type, depth))
                return 1;
    return 0;
}

static int ct_elem_plain_owner(struct Module *self, const char *ctype)
{
    const char *base;
    int si;

    if (strncmp(ctype, "struct ", 7) != 0) return -1;
    base = ctype + 7;
    if (frontend::sym::ct_inst_find(base) >= 0) return -1;
    si = self->sym->find_struct(base);
    if (si < 0) return -1;
    return self->sym->structs[si].owner;
}

/* 1 when instance `ii`'s element (or Map value) belongs to another unit, so
   the instance body must move to the consumer. Mirrors
   `backend::emit::inst_elem_foreign`. */
static int ct_inst_elem_foreign(struct Module *self, int ii)
{
    int n, tn, tmpl, o1, o2;
    struct StructInst *ins;
    struct StructTmpl *tps;
    struct Expr *ex;
    const char *e1, *e2;

    ins = frontend::sym::ct_insts(&n);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!ins || !tps || ii < 0 || ii >= n) return 0;
    if (backend::emit::inst_is_builtin_Box(ins[ii].name)) return 1;
    if (strcmp(ins[ii].tmpl, "Vec") != 0 && strcmp(ins[ii].tmpl, "Map") != 0
        && strcmp(ins[ii].tmpl, "MapEntry") != 0
        && strcmp(ins[ii].tmpl, "Option") != 0 && strcmp(ins[ii].tmpl, "Result") != 0)
        return 0;
    tmpl = ins[ii].tmpl_row;
    if (tmpl < 0 || tmpl >= tn || tps[tmpl].owner < 0) return 0;
    e1 = ins[ii].ctype[0];
    e2 = ((strcmp(ins[ii].tmpl, "Map") == 0 || strcmp(ins[ii].tmpl, "MapEntry") == 0)
          && ins[ii].nargs > 1) ? ins[ii].ctype[1] : 0;
    ex = frontend::parse::expr_get();
    if (ex->container_elem_foreign(e1, tmpl)) return 1;
    if (e2 != 0 && ex->container_elem_foreign(e2, tmpl)) return 1;
    o1 = ct_elem_plain_owner(self, e1);
    if (o1 >= 0 && o1 != tps[tmpl].owner) return 1;
    o2 = (e2 != 0) ? ct_elem_plain_owner(self, e2) : -1;
    return o2 >= 0 && o2 != tps[tmpl].owner;
}

/* 1 when an impl of unit `u` matches instance `ii` (the helper-ownership
   rule). Mirrors `backend::emit::inst_touched_by_unit`. */
static int ct_inst_touched(struct Module *self, int u, int ii)
{
    int k, n;
    struct StructImpl *im;

    (void)self;
    if (u < 0) return 1;
    im = frontend::sym::ct_impls(&n);
    for (k = 0; im && k < n; k++) {
        if (im[k].owner != u) continue;
        if (frontend::sym::ct_impl_matches(k, ii)) return 1;
    }
    return 0;
}

/* 1 when unit `u` writes instance `ii`'s per-instance element helpers.
   Mirrors `backend::emit::inst_writes_helpers`. */
static int ct_inst_writes_helpers(struct Module *self, int u, int ii)
{
    int n;
    struct StructInst *ins;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (!ct_inst_elem_foreign(self, ii)) return ct_inst_touched(self, u, ii);
    if (u < 0) return 1;
    return ins[ii].owner == u;
}

/* One unit's instance / impl / Box / ADT glue rows. `is_header` adds the
   exports a `.h` publishes; the `.c` call adds the body rows. */
static int ct_shell_plan_add_glue(struct Module *self, int unit, int is_header)
{
    int i, ki, n, tn, ninst, ninst2, tmpl, via_hdr, foreign;
    struct StructInst *ins;
    struct StructTmpl *tps;
    struct StructImpl *im;

    im = frontend::sym::ct_impls(&n);
    ins = frontend::sym::ct_insts(&ninst);
    tps = frontend::sym::ct_tmpls(&tn);
    (void)ninst2;
    if (!ins || !tps) return 0;
    for (i = 0; i < ninst; i++) {
        if (ins[i].tmpl_row < 0 || ins[i].tmpl_row >= tn) continue;
        tmpl = ins[i].tmpl_row;
        via_hdr = tps[tmpl].is_pub && tps[tmpl].owner >= 0
                  && self->units[tps[tmpl].owner].is_hdr;
        foreign = ct_inst_elem_foreign(self, i);
        if (is_header) {
            if (via_hdr && tps[tmpl].owner == unit && !foreign)
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_INST, unit, i, 0, 1, 0) != 0)
                    return 1;
            continue;
        }
        if (foreign) {
            if (unit >= 0 && ins[i].owner != unit) continue;
        } else {
            if (via_hdr) continue;
            if (unit >= 0 && ins[i].owner != unit) continue;
        }
        if (backend::lir::lmod_plan_shell_add_stage(LPS_INST, unit, i, 0, 0, 0) != 0)
            return 1;
    }
    if (im) {
        for (ki = 0; ki < n; ki++) {
            tmpl = im[ki].tmpl_row;
            if (is_header) {
                if (tmpl < 0 || (unit >= 0 && im[ki].owner != unit)) continue;
                via_hdr = tps[tmpl].is_pub && tps[tmpl].owner >= 0
                          && self->units[tps[tmpl].owner].is_hdr;
                if (!via_hdr || tps[tmpl].owner != unit) continue;
                for (i = 0; i < ninst; i++) {
                    if (!frontend::sym::ct_impl_matches(ki, i)) continue;
                    if (ct_inst_elem_foreign(self, i)) continue;
                    if (backend::lir::lmod_plan_shell_add_stage(
                            LPS_IMPL, unit, ki, i, 1, 0) != 0)
                        return 1;
                }
                continue;
            }
            for (i = 0; i < ninst; i++) {
                if (!frontend::sym::ct_impl_matches(ki, i)) continue;
                if (ct_inst_elem_foreign(self, i)) {
                    if (unit >= 0 && ins[i].owner != unit) continue;
                } else if (unit >= 0 && im[ki].owner != unit) {
                    continue;
                }
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_IMPL, unit, ki, i, 0, 0) != 0)
                    return 1;
            }
        }
    }
    if (is_header) return 0;
    /* the per-instance element prototypes / helpers (body only) */
    for (i = 0; i < ninst; i++) {
        if (!ct_inst_writes_helpers(self, unit, i)) continue;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_INSTPROTO, unit, i, 0, 0, 0) != 0)
            return 1;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_INSTHELP, unit, i, 0, 0, 0) != 0)
            return 1;
    }
    /* PH-81: the per-instance Box helpers are written by the unit that named
       the instance. */
    for (i = 0; i < ninst; i++) {
        if (!backend::emit::inst_is_builtin_Box(ins[i].name)) continue;
        if (unit >= 0 && ins[i].owner != unit) continue;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_BOXPROTO, unit, i, 0, 0, 0) != 0)
            return 1;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_BOXHELP, unit, i, 0, 0, 0) != 0)
            return 1;
    }
    /* LANG-29 S2 / B3: the per-ADT retain / release definitions. */
    {
        int adi, nadts;
        struct Adt *adts = frontend::sym::ct_adts(&nadts);
        for (adi = 0; adts && adi < nadts; adi++) {
            if (unit >= 0 && adts[adi].owner != unit) continue;
            if (adts[adi].is_template) continue;
            if (!ct_adt_owns(self, adi, 0)) continue;
            if (backend::lir::lmod_plan_shell_add_stage(
                    LPS_ADTLIFE, unit, adi, 0, 0, 0) != 0)
                return 1;
        }
    }
    return 0;
}

static int ct_decl_is_pub(struct Module *self, int kind, const char *name)
{
    int n;

    for (n = 0; n < self->arena->nnode; n++)
        if (self->arena->nodes[n].kind == kind && self->arena->nodes[n].d == 1
            && strcmp(self->arena->nodes[n].text2, name) == 0) return 1;
    return 0;
}

/* The inherent-method prototypes a product publishes: one row per pub,
   non-template inherent impl block of the unit. */
static int ct_shell_plan_add_inprots(struct Module *self, int prog, int unit)
{
    int n, si, adi, nadts;
    struct Adt *adts = frontend::sym::ct_adts(&nadts);

    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_IMPL) continue;
        if (self->arena->nodes[n].text2[0]) continue;   /* trait impl */
        si = self->arena->nodes[n].aux;
        if (si == -1) continue;   /* template impl */
        if (si <= -2) {
            adi = -2 - si;
            if (!adts || adi < 0 || adi >= nadts) continue;
            if (!adts[adi].is_pub) continue;
        } else {
            if (si < 0 || si >= self->sym->nstructs) continue;
            if (!ct_decl_is_pub(self, N_STRUCT, self->sym->structs[si].name))
                continue;
        }
        if (backend::lir::lmod_plan_shell_add_stage(LPS_INPROTO, unit, n,
                                                    0, 0, 0) != 0)
            return 1;
    }
    return 0;
}

/* The function prototypes the writer prints: every function of the unit for
   the `.c`, the exported (pub, non-static) ones for the `.h`. Compile mode has
   one merged unit, so every symbol-table function is a body prototype. */
static int ct_shell_plan_add_protos(struct Module *self, int unit)
{
    int i, lo, hi;

    if (unit < 0) {
        lo = 0;
        hi = self->sym->nfunc;
    } else {
        lo = self->units[unit].fn_start;
        hi = self->units[unit].fn_end;
    }
    for (i = lo; i < hi; i++) {
        if (backend::lir::lmod_plan_shell_add_stage(LPS_PROTO, unit, i, 0, 0,
                                                    0) != 0)
            return 1;
        if (unit >= 0 && self->sym->fn_at(i)->is_pub
            && !self->sym->fn_at(i)->is_static)
            if (backend::lir::lmod_plan_shell_add_stage(LPS_PROTO, unit, i, 0,
                                                        1, 0) != 0)
                return 1;
    }
    return 0;
}

/* S8 closeout: the remaining writer selections. Everything these writers used
   to decide by walking the symbol table / AST is a row here; the writer keeps
   only the rendering (and still reads a symbol row's fields to spell it). */

/* EmitterQuery's predicate, so the module layer and the emitter agree on which
   vtable is exported. */
static int ct_vtable_exported(struct Module *self, int si, const char *tname)
{
    int t;

    if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0) return 0;
    t = self->sym->find_trait(tname);
    if (t < 0 || !self->sym->traits[t].is_pub) return 0;
    return ct_decl_is_pub(self, N_STRUCT, self->sym->structs[si].name);
}

static int ct_map_vtable_exported(struct Module *self, int i)
{
    int t;

    t = self->sym->find_trait(self->p->maps[i].trait);
    if (t < 0 || !self->sym->traits[t].is_pub) return 0;
    /* a namespace host has no object to be private: `pub trait` is the whole
       contract (SH-20) */
    if (self->p->maps[i].ns_host) return 1;
    return ct_decl_is_pub(self, N_GLOBAL, self->p->maps[i].inst);
}

/* An all-default trait fills its own slots, so an adoption `impl` with no
   method bodies still needs the vtable forward declaration. */
static int ct_adoption_default_only(struct Module *self, int si, const char *tname)
{
    int ti, mi;

    ti = self->sym->find_trait(tname);
    if (ti < 0) return 0;
    if (backend::emit::impl_exists_anywhere(self->arena, si, tname)) return 0;
    if (self->sym->traits[ti].nm == 0) return 0;
    for (mi = 0; mi < self->sym->traits[ti].nm; mi++)
        if (self->sym->traits[ti].m[mi].body < 0) return 0;
    return 1;
}

static int ct_unit_has_drop_impl(struct Module *self, int u, int si)
{
    int n;

    if (u < 0 || u >= self->nunits || si < 0) return 0;
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0;
         n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_IMPL
            && self->arena->nodes[n].aux == si
            && strcmp(self->arena->nodes[n].text2, "Drop") == 0)
            return 1;
    return 0;
}

/* One global needing the constructor, the same predicate the emitter used
   (`unit_init_needed`), with the module layer's arena / type pass. */
static int ct_unit_init_needed(struct Module *self, int n)
{
    struct Arena *a = self->arena;
    struct Init *init = backend::emit::init_get();
    const char *lit;
    int k;

    if (a->nodes[n].kind != N_GLOBAL) return 0;
    if (!init->type_needs_init(a->nodes[n].text)) return 0;
    if (!a->nodes[n].text3[0]
        && !self->ty->type_has_array_init(a->nodes[n].text)) return 0;
    k = a->nodes[n].a;
    if (k >= 0 && a->nodes[k].kind == N_RAW && a->nodes[n].text3[0]
        && init->type_has_vptr(a->nodes[n].text)
        && !init->type_needs_nested_init(a->nodes[n].text)) {
        lit = a->nodes[k].aux ? a->str_at((int)a->nodes[k].num)
                              : a->nodes[k].text;
        if (backend::emit::init_has_elem_groups(lit)) return 0;
    }
    return 1;
}

static int ct_shell_plan_add_surface(struct Module *self, int prog, int unit,
                                     int is_header)
{
    int n, i, si, trs, tre;
    const char *tname;

    /* forward declarations: every non-template struct row of the run (every
       product prints them, so the row is per unit) */
    for (i = 0; i < self->sym->nstructs; i++) {
        int ti;
        if (self->sym->structs[i].is_template) continue;
        ti = self->sym->find_type(self->sym->structs[i].name);
        if (ti < 0) continue;
        if (self->sym->types[ti].kind != 1 && self->sym->types[ti].kind != 6)
            continue;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_STRUCTFWD, unit, i,
                self->sym->types[ti].kind == 6 ? 1 : 0, 0, 0) != 0)
            return 1;
    }
    /* trait vtables: compile mode prints all; a unit's `.c` the private ones
       and its `.h` the `pub` ones */
    if (unit < 0) {
        for (i = 0; i < self->sym->ntraits; i++) {
            if (self->sym->traits[i].is_static
                || self->sym->traits[i].ntparams > 0) continue;
            if (backend::lir::lmod_plan_shell_add_stage(
                    LPS_TRAITDECL, unit, i, 0, 0, 0) != 0)
                return 1;
        }
    } else {
        trs = self->units[unit].tr_start;
        tre = self->units[unit].tr_end;
        for (i = trs; i < tre; i++) {
            if (self->sym->traits[i].is_static
                || self->sym->traits[i].ntparams > 0) continue;
            if (!self->sym->traits[i].is_pub)
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_TRAITDECL, unit, i, 2, 0, 0) != 0)
                    return 1;
            if (is_header && self->sym->traits[i].is_pub)
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_TRAITDECL, unit, i, 1, 1, 0) != 0)
                    return 1;
        }
    }
    /* vtable forwards: impl rows, then all-default adoptions */
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_IMPL) continue;
        si = self->arena->nodes[n].aux;
        if (si < 0) continue;
        if (!self->arena->nodes[n].text2[0]) continue;
        tname = self->arena->nodes[n].text2;
        if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0)
            continue;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_VTBLFWD, unit, si, ct_vtable_exported(self, si, tname),
                0, tname) != 0)
            return 1;
    }
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_STRUCT
            || !self->arena->nodes[n].text2[0]) continue;
        si = self->sym->find_struct(self->arena->nodes[n].text2);
        if (si < 0) continue;
        for (i = 0; i < self->sym->structs[si].nuse; i++) {
            tname = self->sym->structs[si].use[i];
            if (!ct_adoption_default_only(self, si, tname)) continue;
            if (backend::lir::lmod_plan_shell_add_stage(
                    LPS_VTBLFWD, unit, si, ct_vtable_exported(self, si, tname),
                    0, tname) != 0)
                return 1;
        }
    }
    /* `Drop` / `Handback` prototypes: the static/export split is a module
       decision (PH-48 D48-2) */
    for (si = 0; si < self->sym->nstructs; si++) {
        int owner, legacy, kind;
        if (!self->sym->structs[si].uses_drop
            || self->sym->structs[si].is_template) continue;
        owner = self->sym->structs[si].owner;
        legacy = (unit < 0 || owner < 0);
        if (unit < 0) {
            kind = 0;
        } else if (legacy) {
            if (self->sym->structs[si].is_inst) continue;
            kind = 1;
        } else if (owner == unit) {
            if (self->sym->structs[si].has_drop_impl
                && !ct_unit_has_drop_impl(self, unit, si)) continue;
            kind = 2;
        } else {
            kind = 3;
        }
        if (backend::lir::lmod_plan_shell_add_stage(LPS_DROPPROTO, unit, si,
                                                    kind, 0, 0) != 0)
            return 1;
    }
    for (si = 0; si < self->sym->nstructs; si++)
        if (self->sym->structs[si].has_handback_impl)
            if (backend::lir::lmod_plan_shell_add_stage(LPS_HANDBAK, unit, si,
                                                        0, 0, 0) != 0)
                return 1;
    /* link-time vtable externs: the `.h` writer only */
    if (is_header && unit >= 0) {
        for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
             n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;
            if (!self->arena->nodes[n].text2[0]) continue;
            tname = self->arena->nodes[n].text2;
            if (!ct_vtable_exported(self, si, tname)) continue;
            if (backend::lir::lmod_plan_shell_add_stage(
                    LPS_LINKEXTERN, unit, si, 0, 1, tname) != 0)
                return 1;
        }
        for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
             n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_STRUCT
                || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (i = 0; i < self->sym->structs[si].nuse; i++) {
                tname = self->sym->structs[si].use[i];
                if (!ct_adoption_default_only(self, si, tname)) continue;
                if (!ct_vtable_exported(self, si, tname)) continue;
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_LINKEXTERN, unit, si, 0, 1, tname) != 0)
                    return 1;
            }
        }
        for (i = 0; i < self->p->nmaps; i++) {
            if (self->p->maps[i].unit != unit) continue;
            if (self->p->maps[i].is_static) continue;
            if (!ct_map_vtable_exported(self, i)) continue;
            if (backend::lir::lmod_plan_shell_add_stage(
                    LPS_LINKEXTERN, unit, i, 1, 1,
                    self->p->maps[i].trait) != 0)
                return 1;
        }
    }
    /* impl bodies, map wrappers / vtables, generic instances, the constructor
       and the literal table: the `.c` writer of this product */
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        int k = self->arena->nodes[n].kind;
        /* aux 1: trait impl body; 2: inherent / ADT impl; 3: a struct whose
           `use` clause may expand all-default trait methods. */
        if (k == N_IMPL) {
            if (self->arena->nodes[n].aux >= 0
                && self->arena->nodes[n].text2[0]) {
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_IMPLDEF, unit, n, 1, 0, 0) != 0)
                    return 1;
            } else if (!self->arena->nodes[n].text2[0]
                       && self->arena->nodes[n].aux != -1) {
                if (backend::lir::lmod_plan_shell_add_stage(
                        LPS_IMPLDEF, unit, n, 2, 0, 0) != 0)
                    return 1;
            }
        } else if (k == N_STRUCT && self->arena->nodes[n].text2[0]) {
            if (backend::lir::lmod_plan_shell_add_stage(
                    LPS_IMPLDEF, unit, n, 3, 0, 0) != 0)
                return 1;
        }
    }
    for (i = 0; i < self->p->nmaps; i++) {
        if (unit >= 0 && self->p->maps[i].unit != unit) continue;
        if (self->p->maps[i].is_static) continue;
        if (backend::lir::lmod_plan_shell_add_stage(
                LPS_MAPDEF, unit, i, ct_map_vtable_exported(self, i), 0, 0) != 0)
            return 1;
    }
    for (i = 0; i < self->sym->nginsts; i++) {
        if (unit >= 0 && self->sym->ginsts[i].owner != unit) continue;
        if (self->sym->fn_at(self->sym->ginsts[i].func)->body < 0) continue;
        if (backend::lir::lmod_plan_shell_add_stage(LPS_GINIT, unit, i, 0, 0,
                                                    0) != 0)
            return 1;
    }
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next)
        if (ct_unit_init_needed(self, n))
            if (backend::lir::lmod_plan_shell_add_stage(LPS_UNITINIT, unit, n,
                                                        0, 0, 0) != 0)
                return 1;
    for (n = 0; n < self->arena->nnode; n++) {
        if (self->arena->nodes[n].kind != N_STR) continue;
        if (self->arena->nodes[n].aux != 1) continue;
        if (backend::lir::lmod_plan_shell_add_stage(LPS_STRLIT, unit, n, 0, 0,
                                                    0) != 0)
            return 1;
    }
    return 0;
}

/* S8 emitter contract: fill the shell plan for one program (compile mode:
   `unit < 0`; build mode: the unit whose `.c`/`.h` is next). The rows carry
   the decisions the shell used to make by scanning the AST and the symbol
   table: preprocessor lines, raw blocks, type / global / assert / function
   order, includes and the function prototypes, and (for a `.h.ct` unit) the
   exported surface. `is_header` also asks for the header rows; a plain `.c`
   unit has none. */
static int ct_shell_plan_add_program(struct Module *self, int prog, int unit,
                                     int is_header)
{
    struct Arena *ar = self->arena;
    int n;
    const struct Unit *uu = unit >= 0 ? &self->units[unit] : 0;

    /* node ids are 0-based: 0 is a valid root. A unit without a program still
       gets its include block and prototypes (both are empty by construction). */
    for (n = (prog >= 0) ? ar->nodes[prog].a : -1; n >= 0;
         n = ar->nodes[n].next) {
        int k = ar->nodes[n].kind;
        if (k == N_PP) {
            const char *t = ar->nodes[n].text;
            /* The io header mask belongs to the run, and the shell already
               has it bound when it renders; only the include bit is a plan
               fact. */
            int aux = strncmp(t, "#include", 8) == 0 ? 1 : 0;
            if (backend::lir::lmod_plan_shell_add(LPS_PP, unit,
                                                  n, aux, t) != 0)
                return 1;
        } else if (k == N_RAW_TEXT) {
            if (backend::lir::lmod_plan_shell_add(LPS_RAW, unit,
                                                  n, 0, 0) != 0)
                return 1;
        } else if (k == N_STRUCT || k == N_TYPEDEF || k == N_ENUM
                   || k == N_UNION) {
            if (backend::lir::lmod_plan_shell_add(LPS_TYPE, unit,
                                                  n, ar->nodes[n].d == 1 ? 1 : 0,
                                                  0) != 0)
                return 1;
        } else if (k == N_GLOBAL) {
            int aux = (ar->nodes[n].d == 1 ? 1 : 0)
                      | (ar->nodes[n].aux == 2 ? 2 : 0);
            if (backend::lir::lmod_plan_shell_add(LPS_GLOBAL, unit,
                                                  n, aux, 0) != 0)
                return 1;
        } else if (k == N_SASSERT) {
            if (backend::lir::lmod_plan_shell_add(LPS_SASSERT,
                                                  unit, n, 0, 0) != 0)
                return 1;
        } else if (k == N_FUNC) {
            int cur = self->sym->find_func(ar->nodes[n].text2);
            int aux = (cur >= 0 && self->sym->fn_at(cur)->ntparams > 0) ? 1 : 0;
            if (backend::lir::lmod_plan_shell_add(LPS_FUNC, unit,
                                                  n, aux, 0) != 0)
                return 1;
        }
    }
    if (ct_shell_plan_add_glue(self, unit, 0) != 0) return 1;
    if (is_header && ct_shell_plan_add_glue(self, unit, 1) != 0) return 1;
    if (ct_shell_plan_add_protos(self, unit) != 0) return 1;
    if (ct_shell_plan_add_inprots(self, prog, unit) != 0) return 1;
    if (unit >= 0) {
        /* a `.h.ct` unit emits both products: the `.c` rows always, the `.h`
           rows only when the unit publishes a header. */
        if (ct_shell_plan_add_includes(self, prog, unit, 0) != 0) return 1;
        if (is_header && ct_shell_plan_add_includes(self, prog, unit, 1) != 0)
            return 1;
    }
    if (unit < 0) {
        /* SH-120: compile mode merges the layer into one file, so the owning
           handle entry points are declared before the instance glue. */
        if (self->sym->find_struct("String") >= 0
            && backend::lir::lmod_plan_shell_add_stage(
                   LPS_STRPROTO, -1, 0, 0, 0,
                   "struct String String_retain(struct String *);\n"
                   "void String_release(struct String *);\n") != 0)
            return 1;
        if (self->sym->find_struct("U16String") >= 0
            && backend::lir::lmod_plan_shell_add_stage(
                   LPS_STRPROTO, -1, 0, 0, 0,
                   "struct U16String U16String_retain(struct U16String *);\n"
                   "void U16String_release(struct U16String *);\n") != 0)
            return 1;
        /* the instance-glue writer repeats the four declarations adjacent to
           the merged program's container impls (same text, harmless C) */
        if (self->sym->find_struct("String") >= 0
            && self->sym->find_struct("U16String") >= 0
            && backend::lir::lmod_plan_shell_add_stage(
                   LPS_STRPROTO, -1, 0, 1, 0,
                   "struct String String_retain(struct String *);\n"
                   "void String_release(struct String *);\n"
                   "struct U16String U16String_retain(struct U16String *);\n"
                   "void U16String_release(struct U16String *);\n") != 0)
            return 1;
    }
    /* the surface rows exist for every product; the `.h`-only rows below are
       filtered by is_header inside the builder */
    if (ct_shell_plan_add_surface(self, prog, unit, is_header) != 0) return 1;
    if (!is_header || !uu) return 0;
    /* Exported types and globals are the same rows filtered by the pub bit;
       the Drop surface is its own row because its predicate (a `pub` struct
       whose real body this unit emits) is a lifetime decision. */
    {
        int si;
        for (si = 0; si < self->sym->nstructs; si++) {
            int has_body = 0;
            if (!self->sym->structs[si].uses_drop) continue;
            if (self->sym->structs[si].is_template) continue;
            if (self->sym->structs[si].is_inst) continue;
            if (!self->sym->structs[si].is_pub) continue;
            if (self->sym->structs[si].owner != unit) continue;
            if (self->sym->structs[si].has_drop_impl) {
                for (n = ar->nodes[self->units[unit].prog].a; n >= 0;
                     n = ar->nodes[n].next)
                    if (ar->nodes[n].kind == N_IMPL && ar->nodes[n].aux == si
                        && strcmp(ar->nodes[n].text2, "Drop") == 0) {
                        has_body = 1;
                        break;
                    }
                if (!has_body) continue;
            }
            if (backend::lir::lmod_plan_shell_add(LPS_DROP, unit,
                                                  si, 0, 0) != 0)
                return 1;
        }
    }
    return 0;
}

/* S8 closeout: the map / model JSON records. The module layer picks every
   record and nested list item here -- the predicates the writers used to run
   themselves -- and the writers render plan rows only (no symbol table, no
   AST). `parent` is the plan row of the enclosing record, -1 at top level. */
static int ct_map_plan_add(int kind, int unit, int parent, int line, int a,
                           int b, const char *t1, const char *t2,
                           const char *t3, const char *t4, const char *t5)
{
    if (backend::lir::lmod_map_plan_add(kind, unit, parent, line, a, b,
                                        t1, t2, t3, t4, t5) != 0)
        return 1;
    return 0;
}

/* The six `--emit-map` sections for the entry unit (compile mode: `u < 0`,
   where the ranges are the whole symbol table / call graph). */
static int ct_map_plan_build(struct Module *self, int prog, int u)
{
    struct MapTable *maps = self->p->maps;
    struct Call *calls = self->p->calls;
    int nmaps = self->p->nmaps;
    int trs, tre, fns, fne, cls, cle;
    int i, j, m, n, si, parent;

    backend::lir::lmod_map_plan_reset();
    if (u >= 0) {
        trs = self->units[u].tr_start;
        tre = self->units[u].tr_end;
        fns = self->units[u].fn_start;
        fne = self->units[u].fn_end;
        cls = self->units[u].call_start;
        cle = self->units[u].call_end;
    } else {
        trs = 0;
        tre = self->sym->ntraits;
        fns = 0;
        fne = self->sym->nfunc;
        cls = 0;
        cle = self->p->ncalls;
    }
    /* traits, with their method rows */
    for (i = trs; i < tre; i++) {
        parent = backend::lir::lmod_map_plan_count();
        if (ct_map_plan_add(LMP_TRAIT, u, -1, self->sym->traits[i].line,
                            0, 0, self->sym->traits[i].name,
                            self->sym->traits[i].name, 0, 0, 0) != 0)
            return 1;
        for (m = 0; m < self->sym->traits[i].nm; m++)
            if (ct_map_plan_add(LMP_TRAIT_M, u, parent, 0,
                                self->sym->traits[i].m[m].nparams, 0,
                                self->sym->traits[i].m[m].name,
                                self->sym->traits[i].m[m].ret, 0, 0, 0) != 0)
                return 1;
    }
    /* structs, with the traits each one uses */
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_STRUCT) continue;
        parent = backend::lir::lmod_map_plan_count();
        if (ct_map_plan_add(LMP_STRUCT, u, -1, self->arena->nodes[n].line,
                            0, 0, self->arena->nodes[n].text2,
                            self->arena->nodes[n].text2, 0, 0, 0) != 0)
            return 1;
        si = self->sym->find_struct(self->arena->nodes[n].text2);
        if (si >= 0)
            for (i = 0; i < self->sym->structs[si].nuse; i++)
                if (ct_map_plan_add(LMP_STRUCT_USE, u, parent, 0, 0, 0,
                                    self->sym->structs[si].use[i],
                                    0, 0, 0, 0) != 0)
                    return 1;
    }
    /* functions */
    for (i = fns; i < fne; i++)
        if (ct_map_plan_add(LMP_FUNC, u, -1, self->sym->fn_at(i)->line, 0,
                            self->sym->fn_at(i)->nparams,
                            self->sym->fn_at(i)->name,
                            self->sym->fn_at(i)->ret, 0, 0, 0) != 0)
            return 1;
    /* impl rows (inherent blocks and template impls have no row) */
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        const char *tname;
        if (self->arena->nodes[n].kind != N_IMPL) continue;
        si = self->arena->nodes[n].aux;
        if (si < 0) continue;
        if (!self->arena->nodes[n].text2[0]) continue;
        tname = self->arena->nodes[n].text2;
        for (m = self->arena->nodes[n].a; m >= 0;
             m = self->arena->nodes[m].next) {
            int count = 0;
            for (i = self->arena->nodes[m].a; i > 0;
                 i = self->arena->nodes[i].next) count++;
            if (ct_map_plan_add(LMP_IMPL, u, -1,
                                self->arena->nodes[n].line, count, 0,
                                self->sym->structs[si].name, tname,
                                self->arena->nodes[m].text2,
                                self->arena->nodes[m].text, 0) != 0)
                return 1;
        }
    }
    /* the call graph edges */
    for (i = cls; i < cle; i++)
        if (ct_map_plan_add(LMP_CALL, u, -1, calls[i].line, 0, 0,
                            calls[i].caller, calls[i].callee, 0, 0, 0) != 0)
            return 1;
    /* the map table (global, not per unit); `is_binding` rows are conversion
       registry entries, not trait maps (LANG-29 S4 / B4) */
    for (i = 0; i < nmaps; i++) {
        int flags = 0;
        if (!maps || maps[i].is_binding) continue;
        if (maps[i].is_static) flags |= LMP_MAP_STATIC;
        if (maps[i].type_host) flags |= LMP_MAP_TYPE_HOST;
        else if (maps[i].ns_host) flags |= LMP_MAP_NS_HOST;
        if (maps[i].is_static) {
            int su = maps[i].unit;
            if (su >= 0 && su < self->nunits && self->units[su].has_shim) {
                flags |= LMP_MAP_SHIM;
                if (self->units[su].shim_c) flags |= LMP_MAP_SHIM_SRC;
            }
        }
        parent = backend::lir::lmod_map_plan_count();
        if (ct_map_plan_add(LMP_MAP, u, -1, maps[i].line, 0, flags,
                            maps[i].trait, maps[i].inst,
                            maps[i].type_host ? maps[i].host_type : 0,
                            (flags & LMP_MAP_SHIM)
                                ? self->units[maps[i].unit].shim_h : 0,
                            (flags & LMP_MAP_SHIM_SRC)
                                ? self->units[maps[i].unit].shim_c : 0) != 0)
            return 1;
        for (j = 0; j < maps[i].nb; j++) {
            const char *sym;
            if (maps[i].is_static) {
                sym = backend::emit::map_recipe_callee_text(maps[i].b[j].call);
                if (!sym) return 1;
            } else {
                sym = maps[i].b[j].direct ? maps[i].b[j].call
                                          : maps[i].b[j].wrapper;
            }
            if (ct_map_plan_add(LMP_MAP_BIND, u, parent, 0, 0,
                                maps[i].b[j].direct,
                                maps[i].b[j].method, sym, 0, 0, 0) != 0)
                return 1;
        }
    }
    return 0;
}

/* The three `--emit-model` sections. The struct / enum lists are the entry
   program's own nodes without the built-in layer and the container / handle
   types the model deliberately leaves out; the functions are the whole symbol
   table except the built-in helper prefixes. */
static int ct_model_plan_build(struct Module *self, int prog)
{
    int n, i, j, si, bi, bn, skip, parent;

    backend::lir::lmod_map_plan_reset();
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        int k = self->arena->nodes[n].kind;
        if (k != N_STRUCT && k != N_UNION) continue;
        skip = 0;
        for (bi = 0; bi < self->nbuiltin && !skip; bi++) {
            int bu = self->builtin_units[bi];
            if (bu < 0 || bu >= self->nunits) continue;
            for (bn = self->arena->nodes[self->units[bu].prog].a; bn >= 0;
                 bn = self->arena->nodes[bn].next)
                if (bn == n) { skip = 1; break; }
        }
        if (skip) continue;
        if (strcmp(self->arena->nodes[n].text2, "ct_buf") == 0
            || strcmp(self->arena->nodes[n].text2, "Vec") == 0
            || strcmp(self->arena->nodes[n].text2, "Map") == 0
            || strcmp(self->arena->nodes[n].text2, "MapEntry") == 0
            || strcmp(self->arena->nodes[n].text2, "Option") == 0
            || strcmp(self->arena->nodes[n].text2, "Result") == 0
            || strcmp(self->arena->nodes[n].text2, "Str") == 0) continue;
        parent = backend::lir::lmod_map_plan_count();
        if (ct_map_plan_add(LMP_MSTRUCT, -1, -1, self->arena->nodes[n].line,
                            0, k == N_UNION,
                            self->arena->nodes[n].text2, 0, 0, 0, 0) != 0)
            return 1;
        si = self->sym->find_struct(self->arena->nodes[n].text2);
        if (si >= 0)
            for (i = 0; i < self->sym->structs[si].nfields; i++)
                if (ct_map_plan_add(LMP_MSTRUCT_FIELD, -1, parent, 0,
                                    self->sym->structs[si].fields[i].line,
                                    self->sym->structs[si].fields[i].col,
                                    self->sym->structs[si].fields[i].name,
                                    self->sym->structs[si].fields[i].type,
                                    0, 0, 0) != 0)
                    return 1;
    }
    for (n = (prog >= 0) ? self->arena->nodes[prog].a : -1; n >= 0;
         n = self->arena->nodes[n].next) {
        int m;
        if (self->arena->nodes[n].kind != N_ENUM) continue;
        /* Phase 84: the model's `enums` list stays C enums; an ADT's layout is
           documented in the spec, not in this export. */
        if (self->arena->nodes[n].aux & 2) continue;
        skip = 0;
        for (bi = 0; bi < self->nbuiltin && !skip; bi++) {
            int bu = self->builtin_units[bi];
            if (bu < 0 || bu >= self->nunits) continue;
            for (bn = self->arena->nodes[self->units[bu].prog].a; bn >= 0;
                 bn = self->arena->nodes[bn].next)
                if (bn == n) { skip = 1; break; }
        }
        if (skip) continue;
        parent = backend::lir::lmod_map_plan_count();
        if (ct_map_plan_add(LMP_MENUM, -1, -1, self->arena->nodes[n].line,
                            0, 0, self->arena->nodes[n].text, 0, 0, 0, 0) != 0)
            return 1;
        for (m = self->arena->nodes[n].a, i = 0; m >= 0;
             m = self->arena->nodes[m].next, i++) {
            int val = 0;
            if (self->arena->nodes[m].a >= 0
                && self->arena->nodes[self->arena->nodes[m].a].kind == N_NUM)
                val = (int)self->arena->nodes[self->arena->nodes[m].a].num;
            if (ct_map_plan_add(LMP_MENUM_M, -1, parent, 0, val, 0,
                                self->arena->nodes[m].text2, 0, 0, 0, 0) != 0)
                return 1;
        }
    }
    for (i = 0; i < self->sym->nfunc; i++) {
        if (strncmp(self->sym->fn_at(i)->name, "str_", 4) == 0
            || strncmp(self->sym->fn_at(i)->name, "vec_", 4) == 0
            || strncmp(self->sym->fn_at(i)->name, "map_", 4) == 0
            || strncmp(self->sym->fn_at(i)->name, "option_", 7) == 0
            || strncmp(self->sym->fn_at(i)->name, "result_", 7) == 0) continue;
        parent = backend::lir::lmod_map_plan_count();
        if (ct_map_plan_add(LMP_MFUNC, -1, -1, self->sym->fn_at(i)->line,
                            0, 0, self->sym->fn_at(i)->name,
                            self->sym->fn_at(i)->cname,
                            self->sym->fn_at(i)->ret, 0, 0) != 0)
            return 1;
        for (j = 0; j < self->sym->fn_at(i)->nparams; j++)
            if (ct_map_plan_add(LMP_MFUNC_PARAM, -1, parent, 0, 0, 0,
                                self->sym->fn_ptype(i, j), 0, 0, 0, 0) != 0)
                return 1;
    }
    return 0;
}

/* PH-82: the Box-field graph the direct-cycle warning walks. The symbol
   table's own caps bound it (`Symbols` lists MAX_STRUCTS 128 +
   MAX_STRUCT_INSTS 128 rows and MAX_FIELDS 64), so the adjacency lives in
   fixed arrays instead of a per-run allocation. */
#define CYCLE_ROWS 256
#define CYCLE_DEGREE 64
static int g_cycle_adj[CYCLE_ROWS][CYCLE_DEGREE];
static int g_cycle_nout[CYCLE_ROWS];

/* The unit that declared `si`, so a finding (and a suppression point) names the
   right file after the build walked every unit; `path` is the fallback for a
   compile-mode row whose owner index is not in `units[]`. */
static const char *cycle_file(struct Module *m, int si)
{
    int o = m->sym->structs[si].owner;

    if (o >= 0 && o < m->nunits && m->units[o].path && m->units[o].path[0])
        return m->units[o].path;
    return m->path;
}

/* One `Box<X>` edge: the field's spelling is `struct Box_<enc>`, and the
   instance's `ptr` payload slot names the target (`struct T *`). Anything the
   payload slot cannot name -- a typedef alias, a generic instance, a forward
   declaration -- is not an edge: D-012 keeps typedef/container/generic
   indirection out of the graph instead of guessing through it. */
/* LANG-24: only the built-in `lib/core/Box.h.ct` instance is a cycle edge.
   A project-owned `struct Box<T>` (the historical fixtures) shares the
   `Box_` prefix but is an ordinary struct. */
static int cycle_is_builtin_Box(struct Module *m, const char *name)
{
    int inst, ti, tn;
    struct StructInst *ins;
    struct StructTmpl *tps;
    const char *b = name;

    (void)m;
    if (!b || !b[0]) return 0;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    inst = frontend::sym::ct_inst_find(b);
    if (inst < 0) return 0;
    ins = frontend::sym::ct_insts(&tn);
    if (!ins) return 0;
    ti = ins[inst].tmpl_row;
    tps = frontend::sym::ct_tmpls(&tn);
    if (ti < 0 || !tps) return 0;
    return strstr(tps[ti].path, "lib/core/Box.h.ct") != 0
        || strstr(tps[ti].path, "lib/std/Box.h.ct") != 0;
}

static int cycle_Box_target(struct Module *m, int si, int fi)
{
    const char *t;
    const char *ptype;
    int bx, pi, n, ti;

    t = m->sym->structs[si].fields[fi].type;
    if (strncmp(t, "struct Box_", 11) == 0) t += 7;
    else if (strncmp(t, "Box_", 4) != 0) return -1;
    if (!cycle_is_builtin_Box(m, t)) return -1;
    bx = m->sym->find_struct(t);
    if (bx < 0 || !m->sym->structs[bx].is_inst) return -1;
    for (pi = 0; pi < m->sym->structs[bx].nfields; pi++)
        if (strcmp(m->sym->structs[bx].fields[pi].name, "ptr") == 0) break;
    if (pi >= m->sym->structs[bx].nfields) return -1;
    /* S1a-0 C2p-11: the payload type is already a pool text; trim it as a
       view instead of cutting it into a 160-byte row. */
    t = m->sym->structs[bx].fields[pi].type;
    n = (int)strlen(t);
    while (n > 0 && (t[n - 1] == ' ' || t[n - 1] == '\t')) n--;
    if (n == 0 || t[n - 1] != '*') return -1;
    n--;
    while (n > 0 && (t[n - 1] == ' ' || t[n - 1] == '\t')) n--;
    ptype = runtime::text::ct_intern_len(t, n);
    if (!ptype) return -1;
    t = ptype;
    if (strncmp(t, "struct ", 7) == 0) t += 7;
    else if (strncmp(t, "union ", 6) == 0) t += 6;
    ti = m->sym->find_struct(t);
    if (ti < 0) return -1;
    if (!m->sym->structs[ti].defined) return -1;
    if (m->sym->structs[ti].is_template || m->sym->structs[ti].is_inst) return -1;
    return ti;
}

/* Report one cycle once; `b`/`c` are -1 for a self loop / a two-edge cycle.
   The wording says "may leak ... unless the cycle is broken by hand", never
   "will leak" (D-012). A participant whose declaration line carries the
   ct: allow-cycle marker suppresses the finding; `ct check` still names the
   suppression point so the exemption is auditable. */
static int cycle_emit(struct Module *m, int a, int b, int c)
{
    const char *chain;
    const char *msg;
    const char *file;
    int nodes[3], n, i, mark;

    nodes[0] = a;
    n = 1;
    if (b >= 0) nodes[n++] = b;
    if (c >= 0) nodes[n++] = c;
    chain = "";
    for (i = 0; i < n; i++)
        chain = tool::sh::ct_scratch_fmt("%s%s%s", chain, i ? " -> " : "",
                                          m->sym->structs[nodes[i]].name);
    chain = tool::sh::ct_scratch_fmt("%s -> %s", chain,
                                     m->sym->structs[a].name);
    mark = -1;
    for (i = 0; i < n; i++)
        if (m->sym->structs[nodes[i]].allow_cycle) { mark = nodes[i]; break; }
    if (mark >= 0) {
        if (!m->check_mode) return 0;
        msg = tool::sh::ct_scratch_fmt(
            "reference cycle suppressed by 'ct: allow-cycle': %s", chain);
        return tool::diag::ct_sem_note(m->sym->structs[mark].line,
                                       m->sym->structs[mark].col, msg,
                                       cycle_file(m, mark));
    }
    msg = tool::sh::ct_scratch_fmt(
        "potential reference cycle: %s; instances may leak unless the cycle is broken by hand",
        chain);
    file = cycle_file(m, a);
    return tool::diag::ct_cycle_warn(m->sym->structs[a].line,
                                     m->sym->structs[a].col, msg, file);
}

/* DOC-87 Stage 1: the built-in layer directory and its environment key were
   renamed (`lib/std` -> `lib/core`, `CT_STD_DIR` -> `CT_CORE_DIR`; DOC-87 迁移).
   The old spellings stay readable for one MINOR, but never silently: each is
   announced once per process. The lookup lives inside `find_builtin` (not in
   file-scope helpers): the self-hosted compiler keeps one whole-program
   function table with a 512-entry budget, and both drivers share this one
   implementation so compile and build mode cannot drift. */
static int g_module_legacy_env_warned;
static int g_module_legacy_path_warned;

/* LANG-24: a source that declares its own `struct Box` keeps that type; the
   built-in layer is not loaded, so the historical generic fixtures and any
   project that already owns the name keep compiling. `Box` is still loaded
   for every program that does not declare it. */
static int module_src_declares_Box(const char *path)
{
    FILE *f;
    char line[1024];
    int after_tag = 0;
    int in_block = 0;

    f = fopen(path, "r");
    if (!f) return 0;
    while (fgets(line, sizeof line, f)) {
        const char *p = line;
        while (*p) {
            if (in_block) {
                while (*p && !(p[0] == '*' && p[1] == '/')) p++;
                if (*p) { p += 2; in_block = 0; }
                continue;
            }
            if (p[0] == '/' && p[1] == '/') break;
            if (p[0] == '/' && p[1] == '*') { p += 2; in_block = 1; continue; }
            if (*p == '"' || *p == '\'') {
                char q = *p;
                p++;
                while (*p && *p != q) { if (*p == '\\' && p[1]) p++; p++; }
                if (*p) p++;
                continue;
            }
            if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                  || (*p >= '0' && *p <= '9') || *p == '_')) {
                if (*p != ' ' && *p != '\t' && *p != '\n' && *p != '\r')
                    after_tag = 0;
                p++;
                continue;
            }
            {
                const char *q = p;
                while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                       || (*q >= '0' && *q <= '9') || *q == '_') q++;
                if ((size_t)(q - p) == 6 && strncmp(p, "struct", 6) == 0) {
                    after_tag = 1;
                } else if ((size_t)(q - p) == 5 && strncmp(p, "union", 5) == 0) {
                    after_tag = 1;
                } else if ((size_t)(q - p) == 4 && strncmp(p, "enum", 4) == 0) {
                    after_tag = 1;
                } else {
                    if (after_tag && (size_t)(q - p) == 3
                        && strncmp(p, "Box", 3) == 0) {
                        fclose(f);
                        return 1;
                    }
                    after_tag = 0;
                }
                p = q;
            }
        }
    }
    fclose(f);
    return 0;
}

impl ModuleOps for Module {
    /* Module failures are about the build itself -- an unreadable input, an
       import that does not resolve, a path that does not fit, a limit. None of
       them has a source position, so they keep the `ctc:` shape. A diagnostic
       that *is* about the source goes through `fail_emit` / the parser. */
    int fail(const char *msg)
    {
        (void)self;
        return frontend::parse::ct_parse_fail_driver(msg);
    }

    /* An emitter failure may blame an AST node (its line is exact) or be about
       the output file (no position at all). */
    int fail_emit(const char *msg)
    {
        int line;
        (void)self;
        line = backend::emit::ct_emit_error_line();
        if (line > 0) return frontend::parse::ct_parse_fail_at(line, msg);
        return frontend::parse::ct_parse_fail_driver(msg);
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        self->lex->src = buf;
        self->lex->srclen = (int)sz;
        return 0;
    }

    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`;
       `foo.m.ct` -> `foo` and `is_map = 1`. */
    int base_name(const char *path, char *out, int cap, int *is_hdr, int *is_map)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        *is_map = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 5 && strcmp(name + n - 5, ".m.ct") == 0) {
            *is_map = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > (size_t)cap) return self->fail("output name is too long");
        snprintf(out, (size_t)cap, "%.*s", (int)n, name);
        return 0;
    }

    /* S1a-0 C2l: the directory is a fresh owned block; the caller's old
       `char[MAX_PATH]` (and its "path is too long") is gone. */
    int path_dir(const char *path, char **out)
    {
        const char *slash;
        size_t n;
        (void)self;

        *out = (char *)0;
        slash = strrchr(path, '/');
        if (!slash) {
            *out = tool::sh::ct_scratch_dup(".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        *out = tool::sh::ct_scratch_fmt("%.*s", (int)n, path);
        return 0;
    }

    /* S1a-0 C1: the unit table doubles from MAX_UNITS; each move rebinds the
       emitter, which holds `units` as a pointer (a realloc invalidates it).
       The new rows are zeroed so a fresh Unit starts at ndep 0 / dep NULL. */
    int ensure_unit_capacity(int need)
    {
        int cap;
        struct Unit *grown;
        (void)self;
        if (need <= self->unitcap) return 0;
        cap = self->unitcap > 0 ? self->unitcap : MAX_UNITS;
        while (cap < need && cap < CAP_LIMIT) cap *= 2;
        if (cap > CAP_LIMIT) cap = CAP_LIMIT;
        if (need > cap) return self->fail("out of memory");
        grown = (struct Unit *)realloc(self->units, (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->unitcap, 0,
               (size_t)(cap - self->unitcap) * sizeof(*grown));
        self->units = grown;
        self->unitcap = cap;
        backend::emit::ct_emit_bind_units(grown);
        return 0;
    }

    /* S1a-0 C1: the `-I` roots double from MAX_INCDIRS; only the table moves,
       the strings stay owned by argv. */
    int ensure_incdir_capacity(int need)
    {
        int cap;
        const char **grown;
        (void)self;
        if (need <= self->inccap) return 0;
        cap = self->inccap > 0 ? self->inccap : MAX_INCDIRS;
        while (cap < need && cap < CAP_LIMIT) cap *= 2;
        if (cap > CAP_LIMIT) cap = CAP_LIMIT;
        if (need > cap) return self->fail("out of memory");
        grown = (const char **)realloc((void *)self->incdirs,
                                       (size_t)cap * sizeof(*grown));
        if (!grown) return self->fail("out of memory");
        memset(grown + self->inccap, 0,
               (size_t)(cap - self->inccap) * sizeof(*grown));
        self->incdirs = grown;
        self->inccap = cap;
        return 0;
    }

    /* S1a-0 C1: one unit's dependency rows (`dep` text + `depu` indices) grow
       together from MAX_IMPORTS; both new halves are zeroed. */
    int ensure_unit_dep_capacity(int u, int need)
    {
        int cap;
        char *deps;
        int *ids;
        (void)self;
        if (need <= self->units[u].depcap) return 0;
        cap = self->units[u].depcap > 0 ? self->units[u].depcap : MAX_IMPORTS;
        while (cap < need && cap < CAP_LIMIT) cap *= 2;
        if (cap > CAP_LIMIT) cap = CAP_LIMIT;
        if (need > cap) return self->fail("out of memory");
        deps = (char *)realloc(self->units[u].dep, (size_t)cap * MAX_TEXT);
        if (!deps) return self->fail("out of memory");
        memset(deps + (size_t)self->units[u].depcap * MAX_TEXT, 0,
               (size_t)(cap - self->units[u].depcap) * MAX_TEXT);
        ids = (int *)realloc(self->units[u].depu, (size_t)cap * sizeof(*ids));
        if (!ids) return self->fail("out of memory");
        memset(ids + self->units[u].depcap, 0,
               (size_t)(cap - self->units[u].depcap) * sizeof(*ids));
        self->units[u].dep = deps;
        self->units[u].depu = ids;
        self->units[u].depcap = cap;
        return 0;
    }

    /* S1a-0 C1: the reachability scratch row used by `unit_reaches`. */
    int ensure_reach(int need)
    {
        int cap;
        char *grown;
        (void)self;
        if (need <= self->reachcap) return 0;
        cap = self->reachcap > 0 ? self->reachcap : MAX_UNITS;
        while (cap < need && cap < CAP_LIMIT) cap *= 2;
        if (cap > CAP_LIMIT) cap = CAP_LIMIT;
        if (need > cap) return self->fail("out of memory");
        grown = (char *)realloc(self->reach, (size_t)cap);
        if (!grown) return self->fail("out of memory");
        memset(grown + self->reachcap, 0, (size_t)(cap - self->reachcap));
        self->reach = grown;
        self->reachcap = cap;
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. The dependencies are not loaded yet, so this
       pass only records the paths (`scan_only` keeps `skip_import` from trying
       to resolve aliases against a symbol table that does not have them).
       S1a-0 C1: the list is the parser's growable block; a caller records its
       own slice starting at the current `nrels`, and a recursive load appends
       after it and restores the counter on the way out. The scan itself does
       not reset the counter, or an outer unit's rows would be lost. */
    int scan_imports(const char *from)
    {
        self->p->scan_only = 1;
        self->path = from;
        self->mem->path = self->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->lstart = 0;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        frontend::parse::ct_parse_lex_next();
        for (;;) {
            if (self->lex->tok == T_PP) {
                frontend::parse::ct_parse_lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && self->lex->tok_is("import")) {
                if (frontend::parse::ct_parse_skip_import() != 0) { self->p->scan_only = 0; return -1; }
                continue;
            }
            break;
        }
        self->p->scan_only = 0;
        return 0;
    }

    /* A unit's interface lives in its header, so a `.h.ct` or `.m.ct` unit can
       be imported. Every root is searched (the importer's own directory, then
       the `-I` roots in command-line order). A hit in a second root is a clash,
       not a fallback: two `-I` roots that both ship `Uart` must not let the
       command line pick one silently. Only three pairs are exempt, because in
       each the second hit is the same unit seen twice rather than a competing
       definition: the resolved paths are identical, the root strings are
       identical (a duplicated `-I`), or the first hit came from the importer's
       own directory (which outranks every `-I`, as `test/modules/precedence`
       pins). A root whose package declares the first import segment
       (`namespace = app` in its ct.pkg) is searched for the flat layout
       (`<root>/model/Item.h.ct`) first and the doubled one
       (`<root>/app/model/Item.h.ct`) second, so old trees keep resolving. The
       second pass names a plain `.ct` unit, which is the mistake worth
       reporting. */
    int resolve_import(const char *from, const char *rel, char **out,
                       int *is_hdr, int *is_map, int line)
    {
        char *dir;
        char *cand = (char *)0;
        char *first = (char *)0;
        char *firstroot = (char *)0;
        char *ncand;
        char *nfirst;
        char *nroot;
        char *nfirstroot;
        char *msg;
        const char *root;
        FILE *f;
        int r, st, hit, cand_hdr, cand_map, first_local;
        (void)self;

        *out = (char *)0;
        *is_hdr = 0;
        *is_map = 0;
        hit = 0;
        first_local = 0;
        if (self->path_dir(from, &dir) != 0) return -1;
        for (r = -1; r < self->ninc; r++) {
            root = (r < 0) ? dir : self->incdirs[r];
            st = ct_root_find(root, rel, &cand, &cand_hdr, &cand_map, &msg);
            if (st < 0) {
                if (line > 0) return tool::diag::ct_sem_error(line, 1, msg, from);
                return self->fail(msg);
            }
            if (st == 0) continue;
            if (!hit) {
                hit = 1;
                first_local = (r < 0);
                first = tool::sh::ct_scratch_dup(cand);
                firstroot = tool::sh::ct_scratch_dup(root);
                *is_hdr = cand_hdr;
                *is_map = cand_map;
                continue;
            }
            /* Same unit seen twice: identical file, duplicate `-I`, or the
               importer's own directory already won. Anything else is two roots
               competing for one name and must be reported. The paths are
               normalized first: `-I x` and `-I ./x`, `a/../b`, or a symlinked
               root all name one directory, and comparing the spellings would
               report a clash that is not there. */
            ct_norm_path(cand, &ncand);
            ct_norm_path(first, &nfirst);
            if (strcmp(ncand, nfirst) == 0) continue;
            ct_norm_path(root, &nroot);
            ct_norm_path(firstroot, &nfirstroot);
            if (strcmp(nroot, nfirstroot) == 0) continue;
            if (first_local) continue;
            msg = tool::sh::ct_scratch_fmt(
                "unit '%s' exists in two import roots: '%s' and '%s'",
                rel, first, cand);
            if (line > 0) return tool::diag::ct_sem_error(line, 1, msg, from);
            return self->fail(msg);
        }
        if (hit) {
            *out = first;
            return 0;
        }
        for (r = -1; r < self->ninc; r++) {
            char *flat;
            char *doubled;
            int nc, ci;
            root = (r < 0) ? dir : self->incdirs[r];
            nc = ct_rel_cands(root, rel, &flat, &doubled);
            for (ci = 0; ci < nc; ci++) {
                const char *c;
                if (ci == 0) c = flat;
                else c = doubled;
                cand = tool::sh::ct_scratch_fmt("%s/%s.ct", root, c);
                f = fopen(cand, "rb");
                if (f) {
                    fclose(f);
                    cand = tool::sh::ct_scratch_fmt(
                        "only a .h.ct unit can be imported: rename '%s.ct' to '%s.h.ct'",
                        rel, rel);
                    return self->fail(cand);
                }
            }
        }
        cand = tool::sh::ct_scratch_fmt("cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Phase 29 E29-5: the built-in `Vec` / `Map` layer ships with the compiler
       and is found the same way compile mode finds it. DOC-87 Stage 1 moved it
       to `lib/core` and renamed the key to `CT_CORE_DIR`; the five-step lookup
       and the compatibility warnings live here (compile mode calls it too). 0 when found, -1 when
       this installation has none, -2 on a hard error (a bogus CT_CORE_DIR). A
       program that never uses a container still builds without the layer. */
    int find_builtin(const char *in, const char *base, char **out)
    {
        char *cand;
        char *alt = (char *)0;
        char *msg;
        const char *env_core;
        const char *env_std;
        const char *slash;
        struct stat st;
        FILE *probe;

        *out = (char *)0;
        env_core = getenv("CT_CORE_DIR");
        env_std = getenv("CT_STD_DIR");
        /* 1/2: CT_CORE_DIR is authoritative; a missing directory is a hard
           error, never a silent fallback to the working tree. */
        if (env_core && env_core[0]) {
            int ok;
            ok = stat(env_core, &st);
            if (ok == 0) ok = S_ISDIR(st.st_mode); else ok = 0;
            if (!ok) {
                msg = tool::sh::ct_scratch_fmt(
                    "CT_CORE_DIR points to a missing directory: %s", env_core);
                self->fail(msg);
                return -2;
            }
            if (env_std && env_std[0] && strcmp(env_core, env_std) != 0
                && !g_module_legacy_env_warned) {
                g_module_legacy_env_warned = 1;
                fprintf(stderr, "ctc: warning: CT_STD_DIR is deprecated; use CT_CORE_DIR\n");
            }
            cand = tool::sh::ct_scratch_fmt("%s/%s", env_core, base);
            if (strcmp(cand, in) == 0) return -1;
            probe = fopen(cand, "r");
            if (!probe) return -1;
            fclose(probe);
            *out = cand;
            return 0;
        }
        /* 3: the legacy key still works during the one-MINOR window. */
        if (env_std && env_std[0]) {
            if (!g_module_legacy_env_warned) {
                g_module_legacy_env_warned = 1;
                fprintf(stderr, "ctc: warning: CT_STD_DIR is deprecated; use CT_CORE_DIR\n");
            }
            if (stat(env_std, &st) == 0 && S_ISDIR(st.st_mode)) {
                cand = tool::sh::ct_scratch_fmt("%s/%s", env_std, base);
                if (strcmp(cand, in) != 0) {
                    probe = fopen(cand, "r");
                    if (probe) {
                        fclose(probe);
                        *out = cand;
                        return 0;
                    }
                }
            }
        }
        /* 5: ./lib/core, the input's sibling ../lib/core, then the old
           ./lib/std / sibling spellings (the old hit never resolves silently; DOC-87 迁移回退). */
        if (stat("lib/core", &st) == 0 && S_ISDIR(st.st_mode)) {
            cand = tool::sh::ct_scratch_fmt("lib/core/%s", base);
            if (strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    *out = cand;
                    return 0;
                }
            }
        }
        slash = strrchr(in, '/');
        if (slash) {
            alt = tool::sh::ct_scratch_fmt("%.*s", (int)(slash - in), in);
            cand = tool::sh::ct_scratch_fmt("%s/../lib/core/%s", alt, base);
            if (strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    *out = cand;
                    return 0;
                }
            }
        }
        if (stat("lib/std", &st) == 0 && S_ISDIR(st.st_mode)) { /* DOC-87 迁移回退 */
            cand = tool::sh::ct_scratch_fmt("lib/std/%s", base); /* DOC-87 迁移回退 */
            if (strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    if (!g_module_legacy_path_warned) {
                        g_module_legacy_path_warned = 1;
                        fprintf(stderr, "ctc: warning: lib/std is deprecated; use lib/core (DOC-87)\n"); /* DOC-87 迁移回退 */
                    }
                    *out = cand;
                    return 0;
                }
            }
        }
        if (slash) {
            cand = tool::sh::ct_scratch_fmt("%s/../lib/std/%s", alt, base); /* DOC-87 迁移回退 */
            if (strcmp(cand, in) != 0) {
                probe = fopen(cand, "r");
                if (probe) {
                    fclose(probe);
                    if (!g_module_legacy_path_warned) {
                        g_module_legacy_path_warned = 1;
                        fprintf(stderr, "ctc: warning: lib/std is deprecated; use lib/core (DOC-87)\n"); /* DOC-87 迁移回退 */
                    }
                    *out = cand;
                    return 0;
                }
            }
        }
        return -1;
    }

    /* P34 S9a: the built-in files are pre-parsed source, not imports, so the
       dependency graph never lists them and each must be re-emitted every run. */
    int is_builtin_unit(int u)
    {
        int i;
        (void)self;

        for (i = 0; i < self->nbuiltin; i++)
            if (self->builtin_units[i] == u) return 1;
        return 0;
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char *dep;
        char *mysrc;
        int mysrclen;
        int u, i, k, d, nrels, rb, is_hdr, is_map, dep_is_map, dup, dn, gn;
        (void)self;

        for (u = 0; u < self->nunits; u++)
            if (strcmp(self->units[u].path, path) == 0) return u;
        if (self->ensure_unit_capacity(self->nunits + 1) != 0) return -1;
        u = self->nunits;
        self->nunits++;
        self->units[u].path = tool::sh::ct_scratch_dup(path);
        self->units[u].ndep = 0;
        self->units[u].prog = -1;
        self->units[u].node_start = 0;
        self->units[u].node_end = 0;
        self->units[u].has_outconv = 0;
        self->units[u].has_anon_typedef = 0;
        self->units[u].digest = 0;
        self->units[u].ns = runtime::text::ct_intern("");
        if (!self->units[u].ns) return self->fail("out of memory");
        self->units[u].nsprefix = runtime::text::ct_intern("");
        if (!self->units[u].nsprefix) return self->fail("out of memory");
        {
            /* S1a-0 C2p-11: the base is a file-name component, but a deep path
               still reaches this row; give the extractor the formal bound. */
            char *basebuf = tool::sh::ct_scratch_alloc(1024);
            if (self->base_name(path, basebuf, 1024, &is_hdr, &is_map) != 0)
                return -1;
            self->units[u].base = runtime::text::ct_intern(basebuf);
            if (!self->units[u].base) return self->fail("out of memory");
        }
        self->units[u].is_hdr = is_hdr;
        self->units[u].is_map = is_map;
        /* LANG-11: `<base>.h.ct` and `<base>.ct` would both emit `<base>.c`
           (the second silently overwrote the first). Refuse with both paths. */
        if (!is_map) {
            for (k = 0; k < u; k++) {
                if (self->units[k].is_map) continue;
                /* Two shim headers with one base keep the PH-65 ambiguity
                   diagnostic (they publish a header, not a `.c` collision). */
                if (self->units[k].is_hdr && is_hdr) continue;
                if (strcmp(self->units[k].base, self->units[u].base) == 0) {
                    const char *p1 = strrchr(self->units[k].path, '/');
                    const char *p2 = strrchr(path, '/');
                    if (p1) p1++; else p1 = self->units[k].path;
                    if (p2) p2++; else p2 = path;
                    self->fail(tool::sh::ct_scratch_fmt(
                        "units '%s' and '%s' both emit '%s.c'; rename one",
                        p1, p2, self->units[u].base));
                    return -1;
                }
            }
        }
        self->p->unit_is_map = is_map;
        self->p->c_strict = (!is_map && self->c_boundary_for(path)) ? 1 : 0;
        self->p->c_base = self->units[u].base;
        /* A shim belongs to a mapping/header unit (batch 39, PH-65 R5): `<base>.shim.h` is
           an include root for the consumer, `<base>.shim.c` joins the program.
           Header-only shims are the normal case; a source without its header
           cannot declare anything for a recipe, so it is rejected by name. */
        self->units[u].has_shim = 0;
        self->units[u].shim_dir = (char *)0;
        self->units[u].shim_h = (char *)0;
        self->units[u].shim_c = (char *)0;
        if (is_map || is_hdr) {
            char *dir;
            char *h;
            char *c;
            char *msg;
            struct stat st;
            /* The diagnostic names the file the user has to add, so it holds a
               path; `sem_error` prints the message directly (no 160-byte cap). */
            if (self->path_dir(path, &dir) != 0) return -1;
            h = tool::sh::ct_scratch_fmt("%s/%s.shim.h", dir, self->units[u].base);
            c = tool::sh::ct_scratch_fmt("%s/%s.shim.c", dir, self->units[u].base);
            if (stat(h, &st) == 0) {
                if (!S_ISREG(st.st_mode) || access(h, R_OK) != 0) {
                    msg = tool::sh::ct_scratch_fmt(
                        "a shim header is not a readable file: %s", h);
                    return tool::diag::ct_sem_error(1, 1, msg, path);
                }
                self->units[u].shim_h = h;
            }
            if (stat(c, &st) == 0) {
                if (!S_ISREG(st.st_mode)) {
                    msg = tool::sh::ct_scratch_fmt(
                        "a shim source is not a regular file: %s", c);
                    return tool::diag::ct_sem_error(1, 1, msg, path);
                }
                self->units[u].shim_c = c;
            }
            if (is_map && self->units[u].shim_c && !self->units[u].shim_h) {
                msg = tool::sh::ct_scratch_fmt(
                    "a shim source needs a matching .shim.h: %s", h);
                return tool::diag::ct_sem_error(1, 1, msg, path);
            }
            if (self->units[u].shim_h) {
                self->units[u].has_shim = 1;
                self->units[u].shim_dir = dir;
            }
        }

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)self->lex->src;
        mysrclen = self->lex->srclen;
        /* S1a-0 C1: this unit's rows start at the current counter; a recursive
           load appends after them and restores the counter, so the slice stays
           valid while this loop walks it. */
        rb = self->p->nrels;
        if (self->scan_imports(path) != 0) return -1;
        nrels = self->p->nrels - rb;
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path,
                                     self->p->rels[rb + i],
                                     &dep, &is_hdr, &dep_is_map,
                                     self->p->rel_line[rb + i]) != 0) return -1;
            /* SH-71 A-1: a mapping unit may also import a header unit. The
               type host's trait signature has to name the interface type it
               returns, and only a `.h.ct` unit publishes one; the header
               unit's `pub` types and traits are registered as bare names for
               this unit like any other dependency. The other direction stays
               as it was (`map_unit_cross` pins a `.h.ct` importing a `.m.ct`),
               and a plain `.ct` unit is still not importable at all --
               `resolve_import` refuses that by name. */
            d = self->load_unit(dep);
            if (d < 0) return -1;
            /* A unit still on the depth-first stack has no program yet
               (`prog == -1`), so reaching it again is a circular import:
               `A` imports `B` and `B` imports `A` closes here with `A` still
               being loaded. The dependency walk below reads `prog` as an arena
               index, and `-1` is an out-of-bounds read; name the two units
               instead of walking into the crash. */
            if (self->units[d].prog < 0) {
                char *cmsg;
                cmsg = tool::sh::ct_scratch_fmt(
                    "circular import: '%s' imports '%s', which is still being loaded",
                    self->units[u].path, self->units[d].path);
                return tool::diag::ct_sem_error(self->p->rel_line[rb + i], 1, cmsg, path);
            }
            /* Two `import` lines may name the same unit; a dependency is listed
               once, so the generated `#include` is emitted once. */
            dup = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (self->units[u].depu[k] == d) dup = 1;
            if (dup) continue;
            if (self->ensure_unit_dep_capacity(u, self->units[u].ndep + 1) != 0)
                return -1;
            snprintf(self->units[u].dep + (size_t)self->units[u].ndep * MAX_TEXT,
                     MAX_TEXT, "%s", self->units[d].base);
            self->units[u].depu[self->units[u].ndep] = d;
            self->units[u].ndep++;
        }

        self->lex->src = mysrc;
        self->lex->srclen = mysrclen;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->lstart = 0;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        /* the bare-name table for exported types is rebuilt from this unit's
           direct dependencies below */
        self->sym->ntb = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ns = "";
        self->sym->nalias = 0;
        self->sym->ntalias = 0;
        self->sym->ntachain = 0;
        self->sym->alias_decl = 0;
        self->p->ns_decl = "";
        self->sym->self_mode = 0;
        self->sym->ret_type = "";
        self->p->cur_func = "";
        self->p->nparams = 0;
        /* 2a.2: an imported unit's `pub` global is declared `extern` in that
           unit's header, so C links one object for both units. Register it here
           as well, or this unit could not name it in `import count; g_counter`.
           The C spelling is mangled by the owner's namespace (the same rule the
           owner used when it declared the global); an `extern` declaration keeps
           the library's own name and has no namespace to qualify with. */
        for (i = 0; i < self->units[u].ndep; i++) {
            const char *gcn;
            const char *gns;
            const char *gname;
            size_t gl;
            dn = self->units[u].depu[i];
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                if (self->arena->nodes[gn].kind != N_GLOBAL || self->arena->nodes[gn].d != 1) continue;
                gname = self->arena->nodes[gn].text2;
                if (self->arena->nodes[gn].aux == 2 || !self->units[dn].nsprefix[0]) {
                    gcn = runtime::text::ct_intern(gname);
                    if (!gcn) return self->fail("out of memory");
                    gns = "";
                } else {
                    gcn = runtime::text::ct_intern_join(self->units[dn].nsprefix, gname);
                    if (!gcn) return self->fail("out of memory");
                    gl = strlen(self->units[dn].nsprefix);
                    gns = runtime::text::ct_intern_len(self->units[dn].nsprefix,
                                                       (int)(gl > 0 ? gl - 1 : 0));
                    if (!gns) return self->fail("out of memory");
                }
                if (!gcn) return self->fail("out of memory");
                if (self->sym->declare_global(gname, self->arena->nodes[gn].text,
                                              gcn, gns, 1) < 0)
                    return self->fail(self->sym->last_error());
                /* V29-4e: an imported pub array keeps its dimensions, so the
                   subscript checker still sees `table[0]` as one element. */
                if (self->arena->nodes[gn].text3[0]) {
                    int vi = self->sym->find_var(gname);
                    if (vi >= 0) {
                        self->sym->vars[vi].is_array = 1;
                        self->sym->vars[vi].dims =
                            runtime::text::ct_intern(self->arena->nodes[gn].text3);
                        if (!self->sym->vars[vi].dims)
                            return self->fail("out of memory");
                    }
                }
            }
            /* An exported enum's members are file-scope constants (D-3). The
               var table was reset for this unit, so they are registered here
               under the owner's C spelling, exactly as the owner declared them. */
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                const char *ccn;
                const char *cns;
                const char *cmn;
                size_t cl;
                int mv;
                if (self->arena->nodes[gn].kind != N_ENUM || self->arena->nodes[gn].d != 1) continue;
                /* Phase 84: an ADT introduces no file-scope variant constants
                   (bare variant names are not a language form), so there is
                   nothing to re-export here. */
                if (self->arena->nodes[gn].aux & 2) continue;
                for (mv = self->arena->nodes[gn].a; mv >= 0; mv = self->arena->nodes[mv].next) {
                    cmn = self->arena->nodes[mv].text2;
                    if (!self->units[dn].nsprefix[0]) {
                        ccn = runtime::text::ct_intern(cmn);
                        cns = "";
                    } else {
                        ccn = runtime::text::ct_intern_join(self->units[dn].nsprefix, cmn);
                        cl = strlen(self->units[dn].nsprefix);
                        cns = runtime::text::ct_intern_len(self->units[dn].nsprefix,
                                                           (int)(cl > 0 ? cl - 1 : 0));
                        if (!cns) return self->fail("out of memory");
                    }
                    if (!ccn) return self->fail("out of memory");
                    if (self->sym->declare_const(cmn, ccn, cns, 1) < 0)
                        return self->fail(self->sym->last_error());
                    if (self->sym->declare_const(cmn, ccn,
                                                 self->arena->nodes[gn].text, 1) < 0)
                        return self->fail(self->sym->last_error());
                }
            }
            /* Exported types of the dependency, reachable by their bare name
               here (SH-18). The table is per importing unit, so an unrelated
               namespace elsewhere in the program cannot make a name ambiguous. */
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                const char *full;
                const char *bare;
                size_t pl;
                if (self->arena->nodes[gn].d != 1) continue;
                if (self->arena->nodes[gn].kind != N_STRUCT
                    && self->arena->nodes[gn].kind != N_TYPEDEF
                    && self->arena->nodes[gn].kind != N_ENUM
                    && self->arena->nodes[gn].kind != N_UNION) continue;
                full = self->arena->nodes[gn].text2;
                bare = full;
                pl = strlen(self->units[dn].nsprefix);
                if (pl > 0 && strncmp(full, self->units[dn].nsprefix, pl) == 0) bare = full + pl;
                if (self->sym->add_bare_type(bare, full) != 0)
                    return self->fail(self->sym->last_error());
                /* Phase 84 fix (F2): a `pub typedef enum Tag { … } Alias;`
                   publishes `lib_Alias` as the declaration's name, but the
                   source tag `Shape` must also resolve — otherwise the
                   consumer emits the undeclared `Shape`. */
                if (self->arena->nodes[gn].kind == N_ENUM
                    && (self->arena->nodes[gn].aux & 3) == 3
                    && self->arena->nodes[gn].num > 0) {
                    struct Adt *adts;
                    int nadts, adi;
                    adts = frontend::sym::ct_adts(&nadts);
                    adi = (int)self->arena->nodes[gn].num - 1;
                    if (adts && adi >= 0 && adi < nadts
                        && self->sym->add_bare_type(adts[adi].name, adts[adi].full) != 0)
                        return self->fail(self->sym->last_error());
                }
            }
            for (gn = self->units[dn].tr_start; gn < self->units[dn].tr_end; gn++) {
                const char *full;
                const char *bare;
                size_t pl;
                if (!self->sym->traits[gn].is_pub) continue;
                full = self->sym->traits[gn].name;
                bare = full;
                pl = strlen(self->units[dn].nsprefix);
                if (pl > 0 && strncmp(full, self->units[dn].nsprefix, pl) == 0) bare = full + pl;
                if (self->sym->add_bare_type(bare, full) != 0)
                    return self->fail(self->sym->last_error());
            }
        }
        /* S1a-0 C1: this unit's import slice begins at `rb`; the recursive
           loads above appended after it, so restore the counter to the slice
           end. The parse pass skips the same `import` lines with `scan_only`
           clear, which no longer records anything, so this unit is never
           charged for its dependencies' imports. */
        self->p->nrels = rb + nrels;
        self->p->scan_only = 0;
        self->path = path;
        self->mem->path = self->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_set_path(self->path);
        self->units[u].fn_start = self->sym->nfunc;
        self->units[u].tr_start = self->sym->ntraits;
        self->units[u].call_start = self->p->ncalls;
        self->p->cur_unit = u;
        /* dependencies were parsed recursively and overwrote the flag */
        self->p->unit_is_map = self->units[u].is_map;
        self->p->unit_is_hdr = self->units[u].is_hdr;
        self->p->c_strict = (!self->units[u].is_map
                             && self->c_boundary_for(self->units[u].path)) ? 1 : 0;
        self->p->c_base = self->units[u].base;
        /* Type aliases visible here: every `pub` alias of a unit in this unit's
           transitive import closure (the same reachability the map lookup and
           the generated C headers use). Then the unit's own top-level aliases
           are pre-scanned so a use before the declaration names the alias. */
        if (self->register_visible_type_aliases(u) != 0) return -1;
        if (self->scan_forward_type_aliases(self->units[u].path, u) != 0) return -1;
        self->units[u].node_start = self->arena->nnode;
        {
            int oc0 = self->arena->noutconv;
            int nn;
            self->units[u].prog = frontend::parse::ct_parse_program();
            self->units[u].has_outconv = self->arena->noutconv > oc0 ? 1 : 0;
            for (nn = self->units[u].node_start; nn < self->arena->nnode; nn++)
                if (self->arena->nodes[nn].kind == N_STRUCT
                    && self->arena->nodes[nn].aux != 0
                    && (!self->arena->nodes[nn].text
                        || !self->arena->nodes[nn].text[0]))
                    self->units[u].has_anon_typedef = 1;
        }
        self->units[u].node_end = self->arena->nnode;
        if (self->units[u].prog < 0) return -1;
        /* Every local alias now exists: rewrite the exported targets in terms of
           the underlying spelling so an importer never depends on a private one. */
        if (self->sym->resolve_exported_type_aliases(u) != 0)
            return self->fail(self->sym->last_error());
        self->units[u].fn_end = self->sym->nfunc;
        self->units[u].tr_end = self->sym->ntraits;
        self->units[u].call_end = self->p->ncalls;
        self->units[u].ns = runtime::text::ct_intern(self->p->ns_decl);
        if (!self->units[u].ns) return self->fail("out of memory");
        /* `sym->ns` is the mangled prefix the unit's parser used for its
           exported names; its globals need the same prefix here. */
        self->units[u].nsprefix = runtime::text::ct_intern(self->sym->ns);
        if (!self->units[u].nsprefix) return self->fail("out of memory");
        /* S1a-0 C1: drop this unit's import rows; the caller (or the next
           top-level load) starts from the slice base again, so the parser's
           block stays as large as the widest single unit, not the build. */
        self->p->nrels = rb;
        return u;
    }

    /* Is `to` in `from`'s transitive import closure? Mirrors the reachability
       the emitter uses for `map_visible`, so a type alias and a map see the
       same program shape. */
    int unit_reaches(int from, int to)
    {
        char *reach;
        int d, k, changed;
        (void)self;

        if (from == to) return 1;
        if (to < 0 || to >= self->nunits) return 0;
        if (self->ensure_reach(self->nunits) != 0) return 0;
        reach = self->reach;
        for (d = 0; d < self->nunits; d++) reach[d] = 0;
        reach[from] = 1;
        changed = 1;
        while (changed) {
            changed = 0;
            for (d = 0; d < self->nunits; d++) {
                if (!reach[d]) continue;
                for (k = 0; k < self->units[d].ndep; k++) {
                    int dep = self->units[d].depu[k];
                    if (dep >= 0 && dep < self->nunits && !reach[dep]) {
                        reach[dep] = 1;
                        changed = 1;
                    }
                }
            }
        }
        return reach[to];
    }

    /* Register every `pub` alias of a reachable unit into this unit's visible
       table. Dependencies were parsed first, so their exported targets are
       already fully resolved. */
    int register_visible_type_aliases(int u)
    {
        int i;
        (void)self;

        for (i = 0; i < self->sym->ngtalias; i++) {
            int owner = self->sym->gtaliases[i].owner;
            if (owner < 0 || owner == u) continue;
            if (!self->sym->gtaliases[i].is_pub) continue;
            if (!self->unit_reaches(u, owner)) continue;
            if (self->sym->add_visible_type_alias(self->sym->gtaliases[i].name,
                                                  self->sym->gtaliases[i].target,
                                                  self->sym->gtaliases[i].path,
                                                  self->sym->gtaliases[i].line,
                                                  owner) != 0)
                return self->fail(self->sym->last_error());
        }
        return 0;
    }

    /* Record every top-level `type IDENT =` before parsing, so a use that comes
       earlier in the file can say the alias must be declared before it is used
       instead of treating the name as an opaque C type. The scan only looks at
       depth 0 and restores the cursor afterwards. */
    int scan_forward_type_aliases(const char *path, int owner)
    {
        int pos, bol, line, tokline, tokstart, lstart, tok, tokfloat, toktrunc;
        long num;
        const char *text_ptr; int text_len;
        const char *suffix_ptr; int suffix_len;
        const char *prev;
        const char *prev2;
        int prev_line, prev2_line, depth;
        (void)self;

        pos = self->lex->pos;
        bol = self->lex->bol;
        line = self->lex->line;
        tokline = self->lex->tokline;
        tokstart = self->lex->tokstart;
        lstart = self->lex->lstart;
        tok = self->lex->tok;
        num = self->lex->toknum;
        tokfloat = self->lex->tokfloat;
        toktrunc = self->lex->toktrunc;
        text_ptr = self->lex->tokstr.ptr; text_len = self->lex->tokstr.len;
        suffix_ptr = self->lex->toksuffix.ptr; suffix_len = self->lex->toksuffix.len;

        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->lstart = 0;
        self->lex->tokline = 1;
        self->lex->tokstart = 0;
        self->lex->lstart = 0;
        self->lex->tok = T_ID;
        self->lex->tokstr.ptr = self->lex->src;
        self->lex->tokstr.len = 0;
        prev = "";
        prev2 = "";
        prev_line = 0;
        prev2_line = 0;
        depth = 0;
        /* The cursor is driven through the raw lexer, not ParseSupport: a
           speculative scan must not turn a lexical complaint (an over-long
           identifier, a bad raw block) into the parse's error before the parser
           has reached it. The real parse re-reads everything. */
        self->lex->next();
        while (self->lex->tok != 0) {
            if (self->lex->tok == T_PP
                && self->lex->tok_prefix("#ct-raw")) {
                /* raw blocks hold arbitrary C: nothing in them is a CT alias */
                while (self->lex->src[self->lex->pos]) {
                    int atbol = (self->lex->pos == 0
                                 || self->lex->src[self->lex->pos - 1] == '\n');
                    if (atbol && strncmp(self->lex->src + self->lex->pos, "#ct-endraw", 10) == 0
                        && (self->lex->src[self->lex->pos + 10] == 0
                            || self->lex->src[self->lex->pos + 10] == '\n'
                            || self->lex->src[self->lex->pos + 10] == '\r'
                            || self->lex->src[self->lex->pos + 10] == ' ')) {
                        while (self->lex->src[self->lex->pos]
                               && self->lex->src[self->lex->pos] != '\n')
                            self->lex->pos++;
                        break;
                    }
                    if (self->lex->src[self->lex->pos] == '\n') self->lex->line++;
                    self->lex->pos++;
                }
                self->lex->bol = 0;
                self->lex->next();
                continue;
            }
            if (self->lex->tok == T_PUNCT) {
                if (self->lex->tok_is("{")) depth++;
                else if (self->lex->tok_is("}") && depth > 0) depth--;
            }
            if (depth == 0 && self->lex->tok == T_PUNCT
                && self->lex->tok_is("=")
                && strcmp(prev2, "type") == 0
                && ((prev[0] >= 'a' && prev[0] <= 'z') || (prev[0] >= 'A' && prev[0] <= 'Z')
                    || prev[0] == '_')) {
                if (self->sym->add_forward_type_alias(prev, path, prev2_line, owner) != 0)
                    return self->fail(self->sym->last_error());
            }
            prev2 = prev;
            prev2_line = prev_line;
            prev = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!prev) return self->fail("out of memory");
            prev_line = self->lex->tokline;
            self->lex->next();
        }

        self->lex->pos = pos;
        self->lex->bol = bol;
        self->lex->line = line;
        self->lex->tokline = tokline;
        self->lex->tokstart = tokstart;
        self->lex->lstart = lstart;
        self->lex->tok = tok;
        self->lex->toknum = num;
        self->lex->tokfloat = tokfloat;
        self->lex->toktrunc = toktrunc;
        self->lex->tokstr.ptr = text_ptr; self->lex->tokstr.len = text_len;
        self->lex->toksuffix.ptr = suffix_ptr; self->lex->toksuffix.len = suffix_len;
        return 0;
    }

    /* PH-48 D48-2 / L48-2: an exported `use Drop` struct publishes its
       `<S>_Drop_drop` body through its own header. The body may be an explicit
       `impl Drop` in that unit or the recursive glue the unit emits when there
       is no impl; an impl written in a different unit leaves the header with no
       real prototype, so a consumer could only call an empty stub (the silent
       behaviour this phase removes). Reject the build before any `.c` is
       written, at the struct's own line. */
    int check_drop_visibility(void)
    {
        int si, u, n, found, line;
        const char *name;

        for (si = 0; si < self->sym->nstructs; si++) {
            if (!self->sym->structs[si].uses_drop) continue;
            if (self->sym->structs[si].is_template || self->sym->structs[si].is_inst) continue;
            if (!self->sym->structs[si].is_pub) continue;
            u = self->sym->structs[si].owner;
            if (u < 0 || u >= self->nunits) continue;
            if (!self->units[u].is_hdr) continue;
            if (!self->sym->structs[si].has_drop_impl) continue;
            found = 0;
            for (n = self->arena->nodes[self->units[u].prog].a; n >= 0;
                 n = self->arena->nodes[n].next)
                if (self->arena->nodes[n].kind == N_IMPL
                    && self->arena->nodes[n].aux == si
                    && strcmp(self->arena->nodes[n].text2, "Drop") == 0) {
                    found = 1;
                    break;
                }
            if (found) continue;
            name = self->sym->structs[si].name;
            line = 1;
            for (n = self->arena->nodes[self->units[u].prog].a; n >= 0;
                 n = self->arena->nodes[n].next)
                if (self->arena->nodes[n].kind == N_STRUCT
                    && strcmp(self->arena->nodes[n].text2, name) == 0) {
                    line = self->arena->nodes[n].line;
                    break;
                }
            {
                const char *shown = name;
                size_t pl = strlen(self->units[u].nsprefix);
                if (pl > 0 && strncmp(name, self->units[u].nsprefix, pl) == 0)
                    shown = name + pl;
                return tool::diag::ct_sem_error(line, 1,
                         tool::sh::ct_scratch_fmt(
                             "Drop body for 'struct %s' is not visible through its header;"
                             " move 'impl Drop for %s' into the unit that declares the struct",
                             shown, shown),
                         self->units[u].path);
            }
        }
        return 0;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char *dir;
        char *msg;
        const char *p;
        const char *rest;
        size_t rn, k, ni, wi;

        (void)self;
        if (!self->units[u].ns[0]) return 0;
        if (!self->nsroot || !self->nsroot[0]) return 0;
        rn = strlen(self->nsroot);
        if (strncmp(self->units[u].path, self->nsroot, rn) != 0) return 0;
        p = self->units[u].path + rn;
        if (*p == '/') p++;
        rest = p;
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        dir = tool::sh::ct_scratch_fmt("%.*s", (int)k, rest);

        /* S1a-0 C2p-11: compare the namespace with the directory in place
           (`::` counts as `/`), so a long namespace needs no fixed row. */
        ni = 0;
        wi = 0;
        while (self->units[u].ns[ni]) {
            if (self->units[u].ns[ni] == ':' && self->units[u].ns[ni + 1] == ':') {
                if (dir[wi] != '/') break;
                ni += 2;
            } else {
                if (dir[wi] != self->units[u].ns[ni]) break;
                ni++;
            }
            wi++;
        }
        if (self->units[u].ns[ni] || dir[wi] != 0) {
            msg = tool::sh::ct_scratch_fmt(
                "namespace '%s' does not match the directory '%s'",
                self->units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* Dependency-first order for the cache. `load_unit` assigns an importer its
       index before recursing, so unit indices are neither a topological order
       nor its reverse; this postorder DFS is (same shape as L2's `order[]`).
       The graph belongs to this layer, not to the cache. */
    int cache_order(int u, int *state, int *order, int *n)
    {
        int k;
        (void)self;
        if (state[u] != 0) return 0;
        state[u] = 1;
        for (k = 0; k < self->units[u].ndep; k++)
            if (self->cache_order(self->units[u].depu[k], state, order, n) != 0)
                return -1;
        state[u] = 2;
        order[*n] = u;
        (*n)++;
        return 0;
    }

    /* The key material of unit `u`: its import list as text and the folded
       dependency digest. The cache turns this into a stamped key; the module
       layer owns the graph, so the folding happens here. */
    int cache_key_of(int u, char **out)
    {
        /* S1a-0 C1: the key material is one row per import, so a fixed
           MAX_IH block cannot outlive the old 32-import cap. Sized from the
           actual `ndep`; `MAX_IH` is gone with the cap it mirrored.
           S1a-0 C2b: the finished key is a heap string owned by the caller --
           a unit path may put it over the old 768-byte buffer. */
        char *ih;
        char *key;
        int kcap, rc;
        unsigned long dep;
        size_t n, k, ihcap;
        int w;
        (void)self;

        *out = (char *)0;
        n = 0;
        ihcap = (size_t)self->units[u].ndep * (MAX_TEXT + 4) + 256;
        ih = (char *)malloc(ihcap);
        if (!ih) return -1;
        ih[0] = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++) {
            w = snprintf(ih + n, ihcap - n, "%s%s;",
                         self->units[u].dep + k * MAX_TEXT,
                         self->units[self->units[u].depu[k]].is_map ? ".m" : ".h");
            if (w < 0 || (size_t)w >= ihcap - n) { free(ih); return -1; }
            n += (size_t)w;
        }
        /* A shim is part of the mapping's definition: touching either file must
           rebuild the consumers, so its stamp joins the key material. */
        if (self->units[u].is_map && self->units[u].has_shim) {
            struct stat st;
            if (stat(self->units[u].shim_h, &st) == 0) {
                w = snprintf(ih + n, ihcap - n, "sh@%lu.%lu;",
                             (unsigned long)st.st_mtime, (unsigned long)st.st_size);
                if (w < 0 || (size_t)w >= ihcap - n) { free(ih); return -1; }
                n += (size_t)w;
            }
            if (self->units[u].shim_c && stat(self->units[u].shim_c, &st) == 0) {
                w = snprintf(ih + n, ihcap - n, "sc@%lu.%lu;",
                             (unsigned long)st.st_mtime, (unsigned long)st.st_size);
                if (w < 0 || (size_t)w >= ihcap - n) { free(ih); return -1; }
                n += (size_t)w;
            }
        }
        dep = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++)
            dep = dep * (unsigned long)1099511628211
                + self->units[self->units[u].depu[k]].digest;
        key = (char *)0;
        kcap = 0;
        rc = self->cache->key(self->units[u].path, ih, dep, self->line_force,
                              self->diag_json, self->runtime_checks,
                              self->nsroot, &key, &kcap);
        if (rc != 0) {
            free(ih);
            free(key);
            if (rc == -2) return self->fail("out of memory");
            if (rc == -3) return self->fail("cache key exceeds 65536 bytes");
            return -1;               /* no key (the path could not be stamped) */
        }
        /* the unit's own digest is what its dependants fold next */
        self->units[u].digest = self->cache->digest(key);
        *out = key;
        free(ih);
        return 0;
    }

    /* Phase 39 R2: classify the root unit's exports and enforce the L39-*
       rules. R3/R5 consume the same rules when they write the ABI header and
       the archive; this method only decides whether the build may continue. */
    int lib_scan(int root_u)
    {
        int u, fi, gi, count, nonroot, bad;
        const char *root_path;
        const char *msg;

        if (root_u < 0 || root_u >= self->nunits) {
            fprintf(stderr, "%s: no exported functions in '<input>'\n", self->prog);
            return 1;
        }
        root_path = self->units[root_u].path;
        self->lib_root = root_u;
        self->abi_n = 0;
        if (!self->units[root_u].is_hdr) {
            fprintf(stderr, "%s: no exported functions in '%s'\n", self->prog, root_path);
            return 1;
        }
        /* L39-3 / L39-5 / L39-4: things that make the archive uncontrollable. */
        for (u = 0; u < self->nunits; u++) {
            if (self->units[u].is_map && self->units[u].has_shim) {
                msg = tool::sh::ct_scratch_fmt(
                    "a --lib build cannot include the C shim of '%s'",
                    self->units[u].path);
                return tool::diag::ct_sem_error(1, 1, msg, root_path);
            }
            for (fi = self->units[u].fn_start; fi < self->units[u].fn_end; fi++) {
                if (strcmp(self->sym->fn_at(fi)->name, "main") == 0
                    && self->sym->fn_at(fi)->body >= 0) {
                    return tool::diag::ct_sem_error(self->sym->fn_at(fi)->line, 1,
                        "a --lib build cannot contain 'main'", self->units[u].path);
                }
            }
            for (gi = self->arena->nodes[self->units[u].prog].a; gi >= 0;
                 gi = self->arena->nodes[gi].next) {
                if (self->arena->nodes[gi].kind != N_GLOBAL
                    || self->arena->nodes[gi].d != 1) continue;
                msg = tool::sh::ct_scratch_fmt(
                    "'%s' cannot be exported: pub globals are not supported",
                    self->arena->nodes[gi].text2);
                return tool::diag::ct_sem_error(self->arena->nodes[gi].line, 1,
                                                msg, self->units[u].path);
            }
        }
        count = 0;
        nonroot = 0;
        for (u = 0; u < self->nunits; u++) {
            if (self->is_builtin_unit(u)) continue;
            for (fi = self->units[u].fn_start; fi < self->units[u].fn_end; fi++) {
                int k, is_root_candidate;
                if (!self->sym->fn_at(fi)->is_pub) continue;
                is_root_candidate = (u == root_u && self->sym->fn_at(fi)->body >= 0);
                if (!is_root_candidate) {
                    nonroot++;
                    continue;
                }
                count++;
                if (self->sym->fn_at(fi)->ntparams > 0) {
                    msg = tool::sh::ct_scratch_fmt(
                        "'%s' not exported: generic template has no external symbol",
                        self->sym->fn_at(fi)->name);
                    if (tool::diag::ct_type_warn(self->sym->fn_at(fi)->line, 1, "", msg, root_path) != 0)
                        return 1;
                    continue;
                }
                bad = 0;
                msg = tool::sh::ct_scratch_fmt("'%s' cannot be exported: ",
                                               self->sym->fn_at(fi)->name);
                {
                    /* S1a-0 C1: a function may carry more than 16 parameters,
                       so walk the return type and every parameter directly
                       instead of copying them into a 17-row stack buffer. */
                    for (k = -1; k < self->sym->fn_at(fi)->nparams; k++) {
                        const char *tp = k < 0 ? self->sym->fn_at(fi)->ret
                                               : self->sym->fn_ptype(fi, k);
                        const char *base = tp;
                        if (strncmp(base, "struct ", 7) == 0) base += 7;
                        else if (strncmp(base, "union ", 6) == 0) base += 6;
                        if (strstr(tp, "own ")) {
                            msg = tool::sh::ct_scratch_fmt("%sown", msg);
                            bad = 1;
                            break;
                        }
                        if (strstr(tp, "_iface") || self->sym->find_trait(base) >= 0) {
                            msg = tool::sh::ct_scratch_fmt("%strait value", msg);
                            bad = 1;
                            break;
                        }
                        if (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0
                            || strncmp(base, "Option_", 7) == 0
                            || strncmp(base, "Result_", 7) == 0
                            || (strncmp(base, "Str", 3) == 0
                                && (base[3] == 0 || base[3] == ' '
                                    || base[3] == '*' || base[3] == '['))) {
                            msg = tool::sh::ct_scratch_fmt("%sstd type", msg);
                            bad = 1;
                            break;
                        }
                        if ((strncmp(tp, "struct ", 7) == 0
                             || strncmp(tp, "union ", 6) == 0)
                            && strchr(tp, '*') == 0) {
                            msg = tool::sh::ct_scratch_fmt("%sby-value struct", msg);
                            bad = 1;
                            break;
                        }
                    }
                }
                if (bad)
                    return tool::diag::ct_sem_error(self->sym->fn_at(fi)->line, 1, msg, root_path);
                if (self->abi_n < 256) self->abi_exports[self->abi_n++] = fi;
            }
        }
        if (count == 0) {
            msg = tool::sh::ct_scratch_fmt("no exported functions in '%s'", root_path);
            return tool::diag::ct_sem_error(1, 1, msg, root_path);
        }
        if (nonroot > 0) {
            msg = tool::sh::ct_scratch_fmt(
                "%d pub function(s) are not part of the ABI surface (imported or extern)",
                nonroot);
            if (tool::diag::ct_type_warn(1, 1, "", msg, root_path) != 0) return 1;
        }
        /* S8 emitter contract: the export set is plan data; the ABI writer
           renders it instead of re-deriving it from the symbol table. */
        backend::lir::lmod_plan_set_abi(self->lib_root, self->abi_exports,
                                        self->abi_n);
        if (tool::diag::ct_diag_nwarn() > 0
            && tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
        return 0;
    }

    /* PH-81: the `Box.h.ct` unit is loaded only when a build input names a
       `Box<...>` type (or its deprecated `box<...>` alias) or a `new T { ... }`
       construction in code (comments and strings are skipped). An unused fifth
       unit would add `struct ct_Box_hdr;`
       to every product and change the `--emit-c` bytes of unrelated programs. */
    int module_src_wants_Box(const char *path)
    {
        FILE *f;
        char line[1024];
        (void)self;

        if (module_src_declares_Box(path)) return 0;
        f = fopen(path, "r");
        if (!f) return 0;
        while (fgets(line, sizeof line, f)) {
            const char *p = line;
            while (*p) {
                if (p[0] == '/' && p[1] == '/') break;
                if (p[0] == '/' && p[1] == '*') {
                    p += 2;
                    while (*p && !(p[0] == '*' && p[1] == '/')) p++;
                    if (*p) p += 2;
                    continue;
                }
                if (*p == '"' || *p == '\'') {
                    char q = *p;
                    p++;
                    while (*p && *p != q) { if (*p == '\\' && p[1]) p++; p++; }
                    if (*p) p++;
                    continue;
                }
                if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                      || (*p >= '0' && *p <= '9') || *p == '_')) { p++; continue; }
                {
                    const char *q = p;
                    while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                           || (*q >= '0' && *q <= '9') || *q == '_') q++;
                    if ((size_t)(q - p) == 3
                        && (strncmp(p, "Box", 3) == 0
                            || strncmp(p, "box", 3) == 0)) {
                        const char *t = q;
                        while (*t == ' ' || *t == '\t') t++;
                        if (*t == '<') { fclose(f); return 1; }
                    }
                    if ((size_t)(q - p) == 3 && strncmp(p, "new", 3) == 0) {
                        const char *t = q;
                        while (*t == ' ' || *t == '\t') t++;
                        if ((*t >= 'a' && *t <= 'z') || (*t >= 'A' && *t <= 'Z')
                            || *t == '_' || *t == '{') { fclose(f); return 1; }
                    }
                    p = q;
                }
            }
        }
        fclose(f);
        return 0;
    }

    int module_inputs_want_Box(const char **ins, int n)
    {
        int i;
        (void)self;
        /* A user `struct Box` in any input makes the whole build own the name,
           so the built-in layer must stay out even if another unit names
           `Box<...>`; otherwise the two templates collide. */
        for (i = 0; i < n; i++)
            if (module_src_declares_Box(ins[i])) return 0;
        for (i = 0; i < n; i++)
            if (self->module_src_wants_Box(ins[i])) return 1;
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        /* S1a-0 C1: the per-run rows are heap blocks. `inputs` is bounded by
           argc; the three cache-walk rows follow the grown unit table. A
           fixed `[MAX_UNITS]` stack row would cap the build at 64 again. */
        const char **inputs;
        int ninput, i, u, o, cn;
        int *dirty;
        int *cstate;
        int *corder;
        const char *outdir;
        const char *oarg;
        const char *ccpath;
        /* S1a-0 C2f: the link/archive lines grow from the old MAX_CMD. */
        char *cmd;
        int cmdcap, code, st;
        char *root;
        (void)self;

        cmd = 0;
        cmdcap = 0;

        inputs = (const char **)calloc((size_t)argc, sizeof(*inputs));
        if (!inputs) {
            fprintf(stderr, "ctc: out of memory\n");
            return 1;
        }
        ninput = 0;
        outdir = NULL;
        oarg = NULL;
        ccpath = NULL;
        self->ninc = 0;
        self->nsroot = NULL;
        self->line_mode = 1;
        self->line_force = -1;
        self->have_map = 0;
        self->have_model = 0;
        self->emit_c = 0;
        self->lib_mode = 0;
        self->lib_root = -1;
        self->abi_mode = 0;
        self->abi_n = 0;
        self->runtime_checks = 0;
        self->freestanding = 0;
        self->c_boundary = -1;
        self->show_c_boundary = 0;
        self->show_io_headers = 0;
        self->alloc_map[0] = 0;
        self->exe = NULL;
        self->outdir_opt = NULL;
        self->cc = NULL;
        if (self->cflags != 0) self->cflags[0] = 0;
        if (self->ldflags != 0) self->ldflags[0] = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s build <input.ct>... [-o <exe>] [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--locked] [--emit-c] [--lib] [--runtime-checks] [--outdir <dir>] [--cc <path>]\n"
                       "                 [--freestanding] [--alloc <m,f[,r,c]>] [--c-boundary=strict|allow]\n"
                       "                 [--check-level=off|warn|error]\n"
                       "                 [--cflags <s>] [--ldflags <s>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->] [--emit-model <file|->]\n"
                       "                 [--diagnostics=text|json] [--diag-codes] [--std=c99|gnu99|c11]\n",
                       self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (strcmp(argv[i], "--emit-c") == 0) {
                self->emit_c = 1;
                continue;
            }
            /* S1b-S2b: the LIR switch is the same in build mode as in compile
               mode (on / shadow / off). */
            if (strncmp(argv[i], "--ir=", 5) == 0) {
                const char *v = argv[i] + 5;
                if (strcmp(v, "on") == 0) {
                    backend::lir::ct_lir_set_switch(1);
                    continue;
                }
                if (strcmp(v, "shadow") == 0) {
                    backend::lir::ct_lir_set_switch(2);
                    continue;
                }
                if (strcmp(v, "off") == 0) {
                    backend::lir::ct_lir_set_switch(0);
                    continue;
                }
                fprintf(stderr, "ctc: unknown --ir mode '%s' (on|off|shadow)\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--lib") == 0) {
                self->lib_mode = 1;
                continue;
            }
            if (strcmp(argv[i], "--runtime-checks") == 0) {
                self->runtime_checks = 1;
                continue;
            }
            if (strcmp(argv[i], "--freestanding") == 0) {
                self->freestanding = 1;
                continue;
            }
            if (strcmp(argv[i], "--allow-c-boundary") == 0) {
                self->c_boundary = 0;
                continue;
            }
            if (strcmp(argv[i], "--show-c-boundary") == 0) {
                self->show_c_boundary = 1;
                continue;
            }
            if (strcmp(argv[i], "--show-io-headers") == 0) {
                self->show_io_headers = 1;
                continue;
            }
            if (strncmp(argv[i], "--c-boundary=", 13) == 0) {
                const char *v = argv[i] + 13;
                if (strcmp(v, "strict") == 0) {
                    self->c_boundary = 1;
                    continue;
                }
                if (strcmp(v, "allow") == 0) {
                    self->c_boundary = 0;
                    continue;
                }
                fprintf(stderr, "ctc: --c-boundary takes strict or allow, not '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--alloc") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --alloc needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->alloc_map, sizeof self->alloc_map, "%s", argv[i])
                        >= (int)sizeof self->alloc_map) {
                    fprintf(stderr, "ctc: --alloc value is too long\n");
                    return 1;
                }
                continue;
            }
            if (strcmp(argv[i], "--outdir") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --outdir needs an argument\n");
                    return 1;
                }
                i++;
                self->outdir_opt = argv[i];
                continue;
            }
            if (strcmp(argv[i], "--cc") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --cc needs an argument\n");
                    return 1;
                }
                i++;
                self->cc = argv[i];
                continue;
            }
            if (strcmp(argv[i], "--cflags") == 0 || strcmp(argv[i], "--ldflags") == 0) {
                int is_cf = argv[i][2] == 'c';
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: %s needs an argument\n", argv[i]);
                    return 1;
                }
                i++;
                char **fp;
                int *fcap;
                if (is_cf) {
                    fp = &self->cflags;
                    fcap = &self->cflagscap;
                } else {
                    fp = &self->ldflags;
                    fcap = &self->ldflagscap;
                }
                if (ct_append_flags(fp, fcap, MAX_FLAGS, argv[i]) != 0) {
                    fprintf(stderr, "ctc: %s value is too long\n", is_cf ? "--cflags" : "--ldflags");
                    return 1;
                }
                continue;
            }
            if (strcmp(argv[i], "--diag-codes") == 0) {
                self->diag_codes = 1;
                continue;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                if (strcmp(v, "c11") == 0) {
                    self->std_flag = "-std=c11";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                self->map_path = tool::sh::ct_scratch_dup(argv[i]);
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "--emit-model") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-model needs an argument\n");
                    return 1;
                }
                i++;
                self->model_path = tool::sh::ct_scratch_dup(argv[i]);
                self->have_model = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                oarg = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (self->ensure_incdir_capacity(self->ninc + 1) != 0) {
                    fprintf(stderr, "ctc: out of memory\n");
                    return 1;
                }
                self->incdirs[self->ninc] = argv[i];
                self->ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                self->nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= CAP_LIMIT) {
                fprintf(stderr, "ctc: out of memory\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: %s build <input.ct>... [-o <exe>]\n", self->prog);
            return 1;
        }
        if (self->show_io_headers) {
            int mask = 0;
            for (i = 0; i < self->nunits; i++) {
                int bu = 0, k;
                for (k = 0; k < self->nbuiltin; k++)
                    if (self->builtin_units[k] == i) bu = 1;
                if (bu) continue;
                mask |= self->io_header_mask(i);
            }
            if (mask & 1) printf("stdio.h\n");
            if (mask & 2) printf("wchar.h\n");
            return 0;
        }
        /* PH-65 R1 observability: print the resolved policy and stop. */
        if (self->show_c_boundary) {
            printf("%s\n", self->c_boundary_for(inputs[0]) ? "strict" : "allow");
            return 0;
        }
        if (self->lib_mode && self->emit_c) {
            fprintf(stderr, "ctc: --lib and --emit-c are mutually exclusive\n");
            return 1;
        }
        /* A `.m.ct` unit is a compile-time mapping: it is loaded through
           `import`, never as a build input, and it never writes an artefact. */
        for (i = 0; i < ninput; i++) {
            size_t pl = strlen(inputs[i]);
            if (pl > 5 && strcmp(inputs[i] + pl - 5, ".m.ct") == 0) {
                fprintf(stderr, "ctc: a .m.ct unit produces no output; import it from a .ct unit\n");
                return 1;
            }
        }
        /* `-o` means the output directory only under `--emit-c` (its old
           meaning); in the default form it names the executable and the C
           lands in `--outdir` (default `.ctbuild/`). */
        if (self->emit_c) {
            outdir = oarg ? oarg : self->outdir_opt;
            if (!outdir) {
                fprintf(stderr, "ctc: build needs -o <dir>\n");
                return 1;
            }
        } else {
            self->exe = oarg ? oarg : "a.out";
            outdir = self->outdir_opt ? self->outdir_opt : ".ctbuild";
        }
        self->outdir = tool::sh::ct_scratch_dup(outdir);
        if (!self->emit_c && ct_ensure_dir(self->outdir) != 0) {
            fprintf(stderr, "ctc: cannot create '%s'%s\n", self->outdir,
                    self->diag_codes ? " [E-DRIVER-004]" : "");
            return 1;
        }
        if (!self->nsroot) {
            if (self->path_dir(inputs[0], &root) != 0) {
                return frontend::parse::ct_parse_report();
            }
            self->nsroot = root;
        }
        /* P20-06: a namespace segment names one package, so two roots claiming
           the same segment make every `import <seg>::x` ambiguous regardless of
           which files exist. */
        {
            char *nmsg;
            char *nfile;
            if (ct_pkg_ns_clash(self, &nmsg, &nfile)) {
                tool::diag::ct_sem_error(1, 1, nmsg, nfile);
                fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                return 1;
            }
        }

        self->nunits = 0;
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->nstruct_inst = 0;
        self->sym->ntb = 0;
        self->p->nrels = 0;
        self->p->scan_only = 0;
        self->p->nparams = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type = "";
        self->sym->ns = "";
        self->sym->nalias = 0;
        self->sym->ntalias = 0;
        self->sym->ntachain = 0;
        self->sym->alias_decl = 0;
        self->p->ns_decl = "";
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        self->p->ncalls = 0;
        tool::diag::ct_diag_reset();
        /* PH-69-R1: `ct check` routed through the build graph keeps check
           severity (all findings are errors), not build's signature-only 2. */
        tool::diag::ct_diag_set_strict(self->check_mode ? 1 : 2);
        /* PH-85 S85d: the B checker on the build path. SH-115 made `warn` and
           v1-PH-1 S3 makes `error` the CLI default, so `types_mode` is 1 for
           an ordinary build; an explicit `--check-level=off` leaves it 0 and
           the build is byte-for-byte what it was before PH-85. `warn` /
           `error` pick how a finding is treated. */
        tool::diag::ct_diag_set_types_level(self->types_level);
        if (self->types_level > 0) self->p->types_mode = 1;
        /* PH-82: one package per run, so the build's first input decides the
           leak policy for every unit in it (D-012's "本包"). */
        tool::diag::ct_diag_set_leaks_error(self->leaks_for(ninput > 0 ? inputs[0] : ""));
        self->diag_emitted = 0;
        self->p->cur_func = "";
        frontend::parse::ct_parse_clear_error();
        /* LANG-10 7b: a parse failure follows `--diagnostics=json`; build keeps
           the document on stderr (stdout carries the cc line), check on stdout. */
        frontend::parse::ct_parse_set_json(self->diag_json, self->check_mode ? 0 : 1,
                                           self->diag_codes);
        tool::diag::ct_diag_set_codes(self->diag_codes);
        self->build_mode = 1;
        /* v1-PH-2 S8: the self-hosting build (this path) prints function
           bodies from LIR by default. `--ir=off` and `CT_LIR=0` keep the AST
           path as the oracle; compile mode stays AST by default until the
           remaining shapes in the S8 diff list are closed. */
        if (!self->check_mode) backend::lir::ct_lir_default_build();
        if (self->runtime_checks) backend::lir::ct_lir_disable_bodies();
        /* `--freestanding` / `--alloc` rewrite malloc/free/realloc/calloc at
           emit time (`sync_alloc`); the lowerer has no such mapping. */
        if (self->freestanding || self->alloc_map[0])
            backend::lir::ct_lir_disable_bodies();

        /* Phase 29 E29-5: the built-in layer is loaded as a unit of every
           build, so a program needs neither an `import` nor `ct get std`. Each
           file is a `pub` header unit, so instances and their impl definitions
           land in its own `.h` / `.c` exactly like a user template. A missing
           file is not an error (an installation may not carry it).
           P34 S9a: the layer may span several files (`Vec.h.ct`, `Option.h.ct`,
           `Result.h.ct`); P36 S4a1 adds `Str.h.ct`; SH-120 splits the strings
           into `Str.h.ct` / `String.h.ct` / `utf16/U16Str.h.ct` /
           `utf16/U16String.h.ct` (eight slots). Each found file joins the
           layer. */
        /* v1-PH-2 S6b: while the built-in layer itself is being parsed, every
           template row in the table belongs to it. The ceiling makes the
           per-unit lookup fall through to the built-in rows for the layer's
           own cross-file references (`String.h.ct` names `Map`); the real
           boundary is written once the loop below finishes. */
        self->sym->builtin_tmpl_hi = CAP_LIMIT;
        self->nbuiltin = 0;
        self->computed_live = 0;
        self->tgraph_done = 0;
        self->builtin_live[0] = 0;
        self->builtin_live[1] = 0;
        self->builtin_live[2] = 0;
        self->builtin_live[3] = 0;
        self->builtin_live[4] = 0;
        self->builtin_live[5] = 0;
        self->builtin_live[6] = 0;
        self->builtin_live[7] = 0;
        backend::emit::ct_emit_clear_builtins();
        {
            char *bpath;
            int bi;
            for (bi = 0; bi < 8; bi++) {
                const char *base;
                if (bi == 7 && !self->module_inputs_want_Box(inputs, ninput))
                    continue;
                base = bi == 0 ? "Vec.h.ct"
                     : (bi == 1 ? "Option.h.ct"
                     : (bi == 2 ? "Result.h.ct"
                     : (bi == 3 ? "Str.h.ct"
                     : (bi == 4 ? "String.h.ct"
                     : (bi == 5 ? "utf16/U16Str.h.ct"
                     : (bi == 6 ? "utf16/U16String.h.ct" : "Box.h.ct"))))));
                {
                    int br = self->find_builtin(inputs[0], base, &bpath);
                    if (br == -2) return frontend::parse::ct_parse_report();
                    if (br != 0) continue;
                }
                {
                    int bu;
                    bu = self->load_unit(bpath);
                    if (bu < 0) return frontend::parse::ct_parse_report();
                    self->builtin_units[self->nbuiltin] = bu;
                    self->nbuiltin += 1;
                    backend::emit::ct_emit_add_builtin(bu);
                }
                /* L29-W1: the shadow warning is the same on both paths. */
                {
                    FILE *vs = fopen("vendor/std", "r");
                    if (vs) {
                        fclose(vs);
                        if (tool::diag::ct_std_shadow_warn(1, 1,
                                "the built-in Vec/Map supersede a project-local 'vendor/std' (ignored)",
                                "vendor/std") != 0) {
                            self->fail("too many warnings");
                            return frontend::parse::ct_parse_report();
                        }
                    }
                }
            }
            /* PH-85 S85d: `--check-level=error` counts its findings in
               `nsem` without aborting the parse (a warning-shaped kernel stays
               on its path), so stop here -- before any product is written. */
            if (tool::diag::ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                return 1;
            }
        }

        /* v1-PH-2 S6b: every template row created so far belongs to the
           built-in layer. A user unit's `enum Option<T>` may shadow only these
           rows; the index boundary survives the per-unit table resets. */
        {
            int btn;
            frontend::sym::ct_tmpls(&btn);
            self->sym->builtin_tmpl_hi = btn;
        }

        /* P36 S4a2: the built-in layer's functions do not count against the
           user program's `MAX_FUNCS` budget. */
        self->sym->nfunc_base = self->sym->nfunc;

        {
            int root_u = -1;
            for (i = 0; i < ninput; i++) {
                int lu = self->load_unit(inputs[i]);
                if (i == 0) root_u = lu;
                if (lu < 0) {
                    if (tool::diag::ct_diag_nsem()) fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                    else frontend::parse::ct_parse_report();
                    return 1;
                }
            }
            /* PH-48 L48-2: reject an exported Drop whose body cannot be reached
               through the type's header before any product is written. */
            if (self->check_drop_visibility() != 0)
                return frontend::parse::ct_parse_report();
            /* PH-82: the direct-cycle warning is a whole-build property (the
               field graph spans units), so it runs once after every unit is
               in the symbol table and before the cache/emit walk. */
            if (self->cycle_check() != 0)
                return frontend::parse::ct_parse_report();
            /* `leaks = error` fails the run here, before any `.c`/`.h`/archive
               is written, and covers `--lib` too (that branch returns before
               the later diagnostics flush). */
            if (tool::diag::ct_diag_leaks_failed()) {
                tool::diag::ct_diag_emit(self->diag_json, 1);
                return 1;
            }
            /* REQ-MEM-2 S7-c: the intra-unit write summary. The per-definition
               scan already ran with the local symbol table live; this pass
               composes one level and reports at the call site. `ct check` is
               always strict; the build path follows `--check-level`
               (off = skip, warn, error), which is the documented escape.
               Built-in layer units and generic templates are out of scope for
               this stage, so they are skipped. */
            if (self->check_mode || self->types_level > 0) {
                for (u = 0; u < self->nunits; u++) {
                    int is_builtin = 0;
                    int bj;
                    for (bj = 0; bj < self->nbuiltin; bj++)
                        if (self->builtin_units[bj] == u) is_builtin = 1;
                    if (is_builtin) continue;
                    if (frontend::parse::mem2_finish_unit(self->arena, self->sym,
                            self->units[u].fn_start, self->units[u].fn_end,
                            self->check_mode, self->types_level,
                            self->units[u].path) != 0) {
                        if (tool::diag::ct_diag_nsem())
                            fprintf(stderr, "ctc: %d error(s) generated\n",
                                    tool::diag::ct_diag_nsem());
                        else frontend::parse::ct_parse_report();
                        return 1;
                    }
                }
            }
            /* S1b-S1: the TIR shadow (CT_TIR=1). Every unit is built and
               V1-V4 verified before the first product is opened, so a failure
               writes no `.c`/`.h`. The default path is untouched. */
            if (backend::tir::ct_tir_shadow_on()) {
                for (u = 0; u < self->nunits; u++) {
                    /* S8: with LIR on (the build default), the LIR entry
                       builds and verifies the unit's TIR slice before its
                       `.c` is opened; a second shadow build would duplicate
                       every row. Map units have no LIR body, so they keep
                       the shadow. */
                    if (backend::lir::ct_lir_on() && !self->units[u].is_map)
                        continue;
                    if (backend::tir::ct_tir_shadow_unit((void *)&self->units[u], u) != 0)
                        return 1;
                }
            }
            if (self->lib_mode) {
                const char *od = self->outdir_opt ? self->outdir_opt : ".ctbuild";
                char *hp;
                /* S8 emitter contract: `--lib` writes the ABI header and the
                   units before the normal build plan is bound, so build the
                   shell rows here. Liveness is not computed yet on this path,
                   exactly like the pre-plan fallback (every loaded layer
                   header is listed). */
                backend::lir::lmod_plan_shell_reset();
                for (u = 0; u < self->nunits; u++) {
                    if (self->units[u].is_map) continue;
                    if (ct_shell_plan_add_program(self, self->units[u].prog, u,
                                                  self->units[u].is_hdr) != 0)
                        return 1;
                }
                if (self->lib_scan(root_u) != 0) return 1;
                self->outdir = tool::sh::ct_scratch_dup(od);
                if (ct_ensure_dir(self->outdir) != 0) {
                    fprintf(stderr, "ctc: cannot create '%s'%s\n", self->outdir,
                    self->diag_codes ? " [E-DRIVER-004]" : "");
                    return 1;
                }
                hp = tool::sh::ct_scratch_fmt("%s/%s.abi.h", self->outdir,
                                              self->units[root_u].base);
                self->abi_mode = 1;
                if (backend::emit::ct_emit_header(hp) != 0) return 1;
                /* SH-79 facet 1: --lib used to return without writing the map
                   or the model (the flags were accepted silently). */
                if (self->have_map
                    && self->write_map(self->map_path, self->units[root_u].prog, root_u) != 0)
                    return 1;
                if (self->have_model
                    && self->write_model(self->model_path, self->units[root_u].prog) != 0)
                    return 1;
                /* R4 intermediate: emit every unit first (headers may
                   reference each other), then compile each object with hidden
                   visibility; R5 folds these objects into the archive. */
                for (u = 0; u < self->nunits; u++) {
                    if (self->units[u].is_map) continue;
                    if (self->emit_unit(u) != 0) return 1;
                    if (self->units[u].is_hdr && self->write_unit_header(u) != 0) return 1;
                }
                /* v1-PH-2 S9: `--lib` publishes headers, so it publishes the
                   shims those headers include: copy every `<base>.shim.h` next
                   to the object files (the normal build does the same after
                   its emit loop). */
                for (u = 0; u < self->nunits; u++) {
                    FILE *sf;
                    FILE *df;
                    char *dst;
                    char sbuf[4096];
                    size_t got;
                    if (!self->units[u].has_shim || !self->units[u].shim_h) continue;
                    /* A dead built-in unit has no `.c`/`.h` in the product, so
                       its shim is not part of the product either. */
                    if (self->is_builtin_unit(u) && !self->builtin_live_for(u)) continue;
                    sf = fopen(self->units[u].shim_h, "rb");
                    if (!sf) continue;
                    dst = tool::sh::ct_scratch_fmt("%s/%s.shim.h", self->outdir,
                                                   self->units[u].base);
                    df = fopen(dst, "wb");
                    if (!df) {
                        fclose(sf);
                        return 1;
                    }
                    while ((got = fread(sbuf, 1, sizeof sbuf, sf)) > 0) {
                        if (fwrite(sbuf, 1, got, df) != got) {
                            fclose(sf);
                            fclose(df);
                            return 1;
                        }
                    }
                    fclose(sf);
                    if (fclose(df) != 0) return 1;
                }
                for (u = 0; u < self->nunits; u++) {
                    char *src, *obj;
                    /* S1a-0 C2f: one composed cc line per object, grown from
                       the old MAX_CMD instead of a fixed 8192-byte array. */
                    char *cmd;
                    int cmdcap, code2, st2;
                    const char *ccp = self->cc;
                    const char *cstd;
                    cmd = 0;
                    cmdcap = 0;
                    if (self->units[u].is_map) continue;
                    /* Phase 41: _Atomic needs C11. Keep the user's explicit
                       gnu99/c11 choice; lift the default c99 only when an
                       atomic builtin was actually lowered. */
                    cstd = self->std_flag ? self->std_flag : "-std=c99";
                    if (self->sym->atomic_used && strcmp(cstd, "-std=c99") == 0)
                        cstd = "-std=c11";
                    src = tool::sh::ct_scratch_fmt("%s/%s.c", self->outdir, self->units[u].base);
                    obj = tool::sh::ct_scratch_fmt("%s/%s.o", self->outdir, self->units[u].base);
                    if (!ccp || !ccp[0]) ccp = "cc";
                    if (tool::sh::ct_text_init(&cmd, &cmdcap, MAX_CMD) != 0) return 1;
                    if (ct_cmd_token(&cmd, &cmdcap, ccp) != 0
                        || ct_cmd_token(&cmd, &cmdcap,
                                        cstd) != 0
                        || ct_cmd_token(&cmd, &cmdcap, "-fvisibility=hidden") != 0
                        || ct_cmd_token(&cmd, &cmdcap, "-I") != 0
                        || ct_cmd_token(&cmd, &cmdcap, self->outdir) != 0) {
                        fprintf(stderr, "ctc: the cc command line is too long\n");
                        tool::sh::ct_text_free(&cmd, &cmdcap);
                        return 1;
                    }
                    {
                        int kk;
                        for (kk = 0; kk < self->nunits; kk++) {
                            if (!self->units[kk].has_shim) continue;
                            if (ct_cmd_token(&cmd, &cmdcap, "-I") != 0
                                || ct_cmd_token(&cmd, &cmdcap,
                                                self->units[kk].shim_dir) != 0) {
                                fprintf(stderr, "ctc: the cc command line is too long\n");
                                tool::sh::ct_text_free(&cmd, &cmdcap);
                                return 1;
                            }
                        }
                    }
                    if (ct_cmd_token(&cmd, &cmdcap, "-c") != 0
                        || ct_cmd_token(&cmd, &cmdcap, src) != 0
                        || ct_cmd_token(&cmd, &cmdcap, "-o") != 0
                        || ct_cmd_token(&cmd, &cmdcap, obj) != 0) {
                        fprintf(stderr, "ctc: the cc command line is too long\n");
                        tool::sh::ct_text_free(&cmd, &cmdcap);
                        return 1;
                    }
                    printf("%s\n", cmd);
                    fflush(stdout);
                    st2 = system(cmd);
                    tool::sh::ct_text_free(&cmd, &cmdcap);
                    if (st2 < 0) {
                        fprintf(stderr, "ctc: cannot run '%s'\n", ccp);
                        return 1;
                    }
                    if (st2 & 0x7f) code2 = 128 + (st2 & 0x7f);
                    else code2 = (st2 >> 8) & 0xff;
                    if (code2 != 0) return 1;
                }
                /* R5: archive every object of this build. `ar rcsD` is the
                   deterministic form; macOS ar has no -D, so fall back to
                   ZERO_AR_DATE=1 + rcs (R7 asserts two runs hash equal). */
                {
                    char *archive;
                    char *cmd;
                    int cmdcap, code2, st2;
                    const char *arp = getenv("AR");
                    cmd = 0;
                    cmdcap = 0;
                    if (!arp || !arp[0]) arp = "ar";
                    if (oarg) archive = tool::sh::ct_scratch_dup(oarg);
                    else archive = tool::sh::ct_scratch_fmt("%s/lib%s.a",
                                                            self->outdir,
                                                            self->units[root_u].base);
                    remove(archive);
                    if (tool::sh::ct_text_init(&cmd, &cmdcap, MAX_CMD) != 0) return 1;
                    if (ct_cmd_token(&cmd, &cmdcap, arp) != 0
                        || ct_cmd_token(&cmd, &cmdcap, "rcsD") != 0
                        || ct_cmd_token(&cmd, &cmdcap, archive) != 0) {
                        fprintf(stderr, "ctc: the ar command line is too long\n");
                        tool::sh::ct_text_free(&cmd, &cmdcap);
                        return 1;
                    }
                    for (u = 0; u < self->nunits; u++) {
                        char *obj;
                        if (self->units[u].is_map) continue;
                        obj = tool::sh::ct_scratch_fmt("%s/%s.o", self->outdir,
                                                       self->units[u].base);
                        if (ct_cmd_token(&cmd, &cmdcap, obj) != 0) {
                            fprintf(stderr, "ctc: the ar command line is too long\n");
                            tool::sh::ct_text_free(&cmd, &cmdcap);
                            return 1;
                        }
                    }
                    {
                        char *qcmd;
                        int qcap;
                        qcmd = 0;
                        qcap = 0;
                        if (tool::sh::ct_text_printf(&qcmd, &qcap, "%s 2>/dev/null", cmd) != 0) {
                            tool::sh::ct_text_free(&qcmd, &qcap);
                            tool::sh::ct_text_free(&cmd, &cmdcap);
                            return 1;
                        }
                        st2 = system(qcmd);
                        tool::sh::ct_text_free(&qcmd, &qcap);
                    }
                    if (st2 < 0 || ((st2 & 0x7f) ? 128 + (st2 & 0x7f) : ((st2 >> 8) & 0xff)) != 0) {
                        /* fallback: non-deterministic ar, fixed timestamp via
                           the shell's environment assignment (C99 has no setenv) */
                        tool::sh::ct_text_reset(&cmd, &cmdcap, MAX_CMD);
                        if (ct_cmd_token(&cmd, &cmdcap, arp) != 0
                            || ct_cmd_token(&cmd, &cmdcap, "rcs") != 0
                            || ct_cmd_token(&cmd, &cmdcap, archive) != 0) {
                            fprintf(stderr, "ctc: the ar command line is too long\n");
                            tool::sh::ct_text_free(&cmd, &cmdcap);
                            return 1;
                        }
                        for (u = 0; u < self->nunits; u++) {
                            char *obj;
                            if (self->units[u].is_map) continue;
                            obj = tool::sh::ct_scratch_fmt("%s/%s.o", self->outdir,
                                                          self->units[u].base);
                            if (ct_cmd_token(&cmd, &cmdcap, obj) != 0) {
                                fprintf(stderr, "ctc: the ar command line is too long\n");
                                tool::sh::ct_text_free(&cmd, &cmdcap);
                                return 1;
                            }
                        }
                        {
                            char *envcmd;
                            int envcap;
                            envcmd = 0;
                            envcap = 0;
                            if (tool::sh::ct_text_printf(&envcmd, &envcap,
                                                         "ZERO_AR_DATE=1 %s", cmd) != 0) {
                                tool::sh::ct_text_free(&envcmd, &envcap);
                                tool::sh::ct_text_free(&cmd, &cmdcap);
                                return 1;
                            }
                            st2 = system(envcmd);
                            tool::sh::ct_text_free(&envcmd, &envcap);
                        }
                        if (st2 < 0) {
                            tool::sh::ct_text_free(&cmd, &cmdcap);
                            return 1;
                        }
                        if (st2 & 0x7f) code2 = 128 + (st2 & 0x7f);
                        else code2 = (st2 >> 8) & 0xff;
                        if (code2 != 0) {
                            fprintf(stderr, "ctc: ar failed\n");
                            tool::sh::ct_text_free(&cmd, &cmdcap);
                            return 1;
                        }
                        printf("%s\n", cmd);
                        fflush(stdout);
                    }
                    tool::sh::ct_text_free(&cmd, &cmdcap);
                }
                return 0;
            }
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                return frontend::parse::ct_parse_report();
            }
        }
        /* Phase 37 O1: a signature mismatch is a hard error in build; fail
           before the cache/emit walk so no `.c` or `.h` is left behind. */
        if (tool::diag::ct_diag_nwarn() > 0) {
            if (tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
            self->diag_emitted = 1;
        }
        /* A shim header is found by base name, so two mapping units with the
           same base in different directories would both put `<base>.shim.h` on
           the include path and the C compiler would silently pick the first
           root. A clash is a build error, not a coin toss. */
        for (u = 0; u < self->nunits; u++) {
            int k;
            if (!self->units[u].is_map || !self->units[u].has_shim) continue;
            for (k = 0; k < u; k++) {
                if (!self->units[k].is_map || !self->units[k].has_shim) continue;
                if (strcmp(self->units[k].base, self->units[u].base) != 0) continue;
                if (strcmp(self->units[k].shim_dir, self->units[u].shim_dir) == 0) continue;
                fprintf(stderr, "ctc: shim base name '%s' is ambiguous: %s and %s\n",
                        self->units[u].base,
                        self->units[k].shim_dir, self->units[u].shim_dir);
                return 1;
            }
        }
        /* Incremental cache (Phase 6.3, ported in 10.5): a unit whose key still
           matches and whose .c/.h are on disk is not regenerated. The walk is a
           dependency-first postorder, so a unit's key can fold its dependencies'
           digests; a unit whose dependency is dirty is dirty too. `--emit-map`
           never reuses, because the map spans the whole run. */
        dirty = (int *)calloc((size_t)self->nunits, sizeof(*dirty));
        cstate = (int *)calloc((size_t)self->nunits, sizeof(*cstate));
        corder = (int *)calloc((size_t)self->nunits, sizeof(*corder));
        if (!dirty || !cstate || !corder) {
            fprintf(stderr, "ctc: out of memory\n");
            return 1;
        }
        for (u = 0; u < self->nunits; u++) cstate[u] = 0;
        cn = 0;
        for (u = 0; u < self->nunits; u++)
            if (self->cache_order(u, cstate, corder, &cn) != 0) {
                return frontend::parse::ct_parse_report();
            }
        for (o = 0; o < cn; o++) {
            char *outc;
            char *key;
            int k;
            u = corder[o];
            dirty[u] = 1;
            /* A map unit writes nothing, but its digest is folded by every
               consumer, so the key is computed and it is never a cache hit. */
            if (self->units[u].is_map) {
                if (self->cache_key_of(u, &key) != 0)
                    return frontend::parse::ct_parse_report();
                dirty[u] = 0;
                free(key);
                continue;
            }
            outc = tool::sh::ct_scratch_fmt("%s/%s.c", self->outdir,
                                            self->units[u].base);
            key = (char *)0;
            if (!self->have_map && self->cache_key_of(u, &key) == 0
                && self->cache->hit(outc, key, self->units[u].is_hdr))
                dirty[u] = 0;
            free(key);
            for (k = 0; k < self->units[u].ndep; k++)
                if (dirty[self->units[u].depu[k]]) dirty[u] = 1;
            /* Phase 29: the built-in layer's `.h` carries one definition per
               instance the whole build asks for, so its content depends on the
               consumers, not only on its own source. Its key cannot see that
               set, so it is re-emitted every run: a new `Vec<char *>` in an
               unrelated unit must not meet a cached header. */
            if (self->is_builtin_unit(u)) dirty[u] = 1;
        }
        /* PH-64 T2: decide, once per build, which built-in units the program
           can reach. A dead unit is neither emitted nor linked, and the
           products stop including its header. */
        for (o = 0; o < self->nbuiltin; o++)
            self->builtin_live[o] = self->builtin_live_for(self->builtin_units[o]);
        self->computed_live = 1;
        /* S8 emitter contract: the liveness decision is TGraph's; the emitter
           receives it as LModule plan metadata, never as a module table. */
        backend::lir::lmod_plan_set_live(self->builtin_live, self->nbuiltin);
        {
            int bi, nb = 0;
            int bu[8];
            const char *bh[8];
            for (bi = 0; bi < self->nbuiltin && nb < 8; bi++) {
                const char *bb;
                if (!self->builtin_live[bi]) continue;
                bu[nb] = self->builtin_units[bi];
                bb = self->units[bu[nb]].base;
                bh[nb] = strcmp(bb, "String") == 0 ? "String_" : bb;
                nb++;
            }
            backend::lir::lmod_plan_set_builtin_headers(bu, bh, nb);
        }
        backend::emit::ct_emit_bind_plan(backend::lir::lmod_plan_get());
        /* S8 emitter contract: the shell plan is built once, after every unit
           and the symbol table are final. The shell writers only render it. */
        backend::lir::lmod_plan_shell_reset();
        for (u = 0; u < self->nunits; u++) {
            if (self->units[u].is_map) continue;
            if (ct_shell_plan_add_program(self, self->units[u].prog, u,
                                          self->units[u].is_hdr) != 0)
                return frontend::parse::ct_parse_report();
        }
        if (ct_shim_ambiguity(self, self->units, self->nunits)) return 1;
        for (o = 0; o < cn; o++) {
            char *outc;
            char *key;
            u = corder[o];
            if (self->units[u].is_map) continue;
            if (!dirty[u]) continue;
            /* S1b-S2b: build and verify this unit's LIR before its `.c` is
               opened, then let the body seam print what the lowerer covered.
               A verifier failure removes the (still absent) product. */
            if (backend::lir::ct_lir_on() && backend::lir::ct_lir_emit_on()) {
                int verr = backend::verify::ct_verifier_errors();
                if (backend::lir::ct_lir_build_unit((void *)&self->units[u], u,
                        backend::emit::ct_emit_ntmp()) != 0) {
                    /* S8: the TIR/LIR verifier and the emitter still own
                       different diagnostics. A program the AST path rejects
                       with a richer message (an unknown method receiver, a
                       construct outside the LIR subset) must keep that
                       message; on a verifier finding the build falls back to
                       the AST oracle for the rest of the run instead of
                       replacing the diagnostic. `CT_LIR_STRICT=1` keeps the
                       verifier fatal (test/ir's negatives). */
                    if (backend::verify::ct_verifier_errors() > verr
                        && !getenv("CT_LIR_STRICT")) {
                        backend::lir::ct_lir_set_switch(0);
                    } else {
                        outc = tool::sh::ct_scratch_fmt("%s/%s.c", self->outdir,
                                                        self->units[u].base);
                        remove(outc);
                        return frontend::parse::ct_parse_report();
                    }
                } else {
                    backend::emit::ct_emit_set_body_hook(mod_lir_body);
                }
            }
            if (self->emit_unit(u) != 0) {
                /* the `.c` was already opened, so a failure leaves half a file;
                   a failed unit must not leave an artefact behind */
                outc = tool::sh::ct_scratch_fmt("%s/%s.c", self->outdir,
                                                self->units[u].base);
                remove(outc);
                return frontend::parse::ct_parse_report();
            }
            backend::lir::ct_lir_report_printed();
            if (self->units[u].is_hdr && self->write_unit_header(u) != 0) {
                /* symmetric with the `.c` above: a half-written `.h` looks like
                   a real artefact, so drop it too */
                outc = tool::sh::ct_scratch_fmt("%s/%s.h", self->outdir,
                                                self->units[u].base);
                remove(outc);
                return frontend::parse::ct_parse_report();
            }
            /* stamped only after a successful emit: a failed unit must never be
               reused, and a stale key must never vouch for new sources */
            key = (char *)0;
            outc = tool::sh::ct_scratch_fmt("%s/%s.c", self->outdir,
                                            self->units[u].base);
            if (self->cache_key_of(u, &key) == 0)
                self->cache->store(outc, key);
            free(key);
        }
        /* v1-PH-2 S9: a compiled shim is part of what a build publishes. Copy
           every unit's `<base>.shim.h` next to the emitted `.c`/`.h` so the
           product tree is self-contained: the printed cc line, the frozen seed
           (`bootstrap/ct-ast`) and the harnesses then find it with
           `-I <outdir>` alone, without a second include root per shim
           directory. Ambiguous bases were rejected by `ct_shim_ambiguity`
           above, so the flat copy cannot collide. */
        for (u = 0; u < self->nunits; u++) {
            FILE *sf;
            FILE *df;
            char *dst;
            char sbuf[4096];
            size_t got;
            if (!self->units[u].has_shim || !self->units[u].shim_h) continue;
            /* A dead built-in unit has no `.c`/`.h` in the product, so its
               shim is not part of the product either. */
            if (self->is_builtin_unit(u) && !self->builtin_live_for(u)) continue;
            sf = fopen(self->units[u].shim_h, "rb");
            if (!sf) continue;              /* discovery already stat()ed it */
            dst = tool::sh::ct_scratch_fmt("%s/%s.shim.h", self->outdir,
                                           self->units[u].base);
            df = fopen(dst, "wb");
            if (!df) {
                fclose(sf);
                return 1;
            }
            while ((got = fread(sbuf, 1, sizeof sbuf, sf)) > 0) {
                if (fwrite(sbuf, 1, got, df) != got) {
                    fclose(sf);
                    fclose(df);
                    return 1;
                }
            }
            fclose(sf);
            if (fclose(df) != 0) return 1;
        }
        {
            /* SH-79: the model/map describe the entry unit, not whatever unit
               happened to load first (the builtin layer) or last (a dependency
               loaded after the entry). */
            int entry = (self->lib_root >= 0) ? self->lib_root : -1;
            int ui;
            if (entry < 0 && ninput > 0) {
                const char *want = inputs[ninput - 1];
                size_t wl = strlen(want);
                for (ui = 0; ui < self->nunits; ui++) {
                    size_t ul = strlen(self->units[ui].path);
                    if (strcmp(self->units[ui].path, want) == 0
                        || (ul >= wl && strcmp(self->units[ui].path + ul - wl, want) == 0)) {
                        entry = ui;
                        break;
                    }
                }
            }
            if (entry < 0) entry = self->nunits - 1;
            if (entry < 0 || entry >= self->nunits) entry = 0;
            self->model_unit = entry;
        }
        if (self->have_map && self->write_map(self->map_path, self->units[self->model_unit].prog, self->model_unit) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (self->have_model && self->write_model(self->model_path, self->units[self->model_unit].prog) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (!self->diag_emitted && tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
        if (self->emit_c) {
            /* PH-69-R1: `ct check` reuses this path only for the unit graph;
               the suggested cc line is not part of check output. */
            if (backend::emit::ct_emit_no_write()) return 0;
            /* The old shape, unchanged: print the suggested line, run nothing.
               The target C standard (Phase 6.4) is the only option it carries. */
            printf("cc %s", self->std_flag);
            /* A shim header is included by base name, so its directory becomes
               an include root; one root is printed once even for several
               mappings. */
            for (u = 0; u < self->nunits; u++) {
                int dupd = 0;
                if (!self->units[u].is_map || !self->units[u].has_shim) continue;
                for (i = 0; i < u; i++)
                    if (self->units[i].is_map && self->units[i].has_shim
                        && strcmp(self->units[i].shim_dir, self->units[u].shim_dir) == 0)
                        dupd = 1;
                if (!dupd) printf(" -I %s", self->units[u].shim_dir);
            }
            /* A shim source may include a generated type header, so the output
               directory is an include root too. It goes after every shim root:
               a generated `<Type>.h` must never shadow a same-named system
               header that a shim directory carries. */
            printf(" -I %s", self->outdir);
            for (u = 0; u < self->nunits; u++) {
                int bs;
                if (self->units[u].is_map) continue;
                bs = self->builtin_slot(u);
                if (bs >= 0 && !self->builtin_live[bs]) continue;
                printf(" %s/%s.c", self->outdir, self->units[u].base);
            }
            /* The shim implementation is part of the program, not an artefact:
               it is compiled straight from its source next to the mapping unit. */
            for (u = 0; u < self->nunits; u++) {
                if (!self->units[u].is_map || !self->units[u].shim_c) continue;
                printf(" %s", self->units[u].shim_c);
            }
            printf(" -o a.out\n");
            return 0;
        }
        /* The default form (D17-9): compose the line, print it, run it. Every
           path is single-quoted; --cflags / --ldflags are pass-through and go
           in verbatim. */
        ccpath = self->cc;
        if (!ccpath) ccpath = getenv("CC");
        if (!ccpath || !ccpath[0]) ccpath = "cc";
        if (tool::sh::ct_text_init(&cmd, &cmdcap, MAX_CMD) != 0) return 1;
        if (ct_cmd_token(&cmd, &cmdcap, ccpath) != 0
            || ct_cmd_raw(&cmd, &cmdcap, self->std_flag) != 0
            || ct_cmd_raw(&cmd, &cmdcap, self->cflags) != 0)
            goto cmd_too_long;
        for (u = 0; u < self->nunits; u++) {
            int dupd = 0;
            if (!self->units[u].is_map || !self->units[u].has_shim) continue;
            for (i = 0; i < u; i++)
                if (self->units[i].is_map && self->units[i].has_shim
                    && strcmp(self->units[i].shim_dir, self->units[u].shim_dir) == 0)
                    dupd = 1;
            if (dupd) continue;
            if (ct_cmd_raw(&cmd, &cmdcap, "-I") != 0
                || ct_cmd_token(&cmd, &cmdcap, self->units[u].shim_dir) != 0)
                goto cmd_too_long;
        }
        /* Same root, same order as the printed line: the output directory last,
           so a generated `<Type>.h` cannot shadow a system header. */
        if (ct_cmd_raw(&cmd, &cmdcap, "-I") != 0
            || ct_cmd_token(&cmd, &cmdcap, self->outdir) != 0)
            goto cmd_too_long;
        for (u = 0; u < self->nunits; u++) {
            char *src;
            if (self->units[u].is_map) continue;
            {
                int bs = self->builtin_slot(u);
                if (bs >= 0 && !self->builtin_live[bs]) continue;
            }
            src = tool::sh::ct_scratch_fmt("%s/%s.c", self->outdir,
                                            self->units[u].base);
            if (ct_cmd_token(&cmd, &cmdcap, src) != 0)
                goto cmd_too_long;
        }
        for (u = 0; u < self->nunits; u++) {
            if (!self->units[u].is_map || !self->units[u].shim_c) continue;
            if (ct_cmd_token(&cmd, &cmdcap, self->units[u].shim_c) != 0)
                goto cmd_too_long;
        }
        if (ct_cmd_raw(&cmd, &cmdcap, self->ldflags) != 0
            || ct_cmd_token(&cmd, &cmdcap, "-o") != 0
            || ct_cmd_token(&cmd, &cmdcap, self->exe) != 0)
            goto cmd_too_long;
        printf("%s\n", cmd);
        fflush(stdout);
        st = system(cmd);
        tool::sh::ct_text_free(&cmd, &cmdcap);
        if (st < 0) {
            fprintf(stderr, "ctc: cannot run '%s'\n", ccpath);
            return 1;
        }
        if (st & 0x7f) code = 128 + (st & 0x7f);
        else code = (st >> 8) & 0xff;
        if (code == 127) fprintf(stderr, "ctc: cannot run '%s'\n", ccpath);
        return code;
cmd_too_long:
        tool::sh::ct_text_free(&cmd, &cmdcap);
        fprintf(stderr, "ctc: the cc command line is too long\n");
        return 1;
    }

    /* The emitter (backend::emit) owns the code generation; these facades hand
       the first raw failure to the error store in the shape it deserves: a node
       error keeps its line, an output-file error has none. */
    int emit_program(int prog)
    {
        const char *why;
        /* S8 emitter contract: compile mode is one program; the plan rows let
           the shell render its top-level order without scanning the AST. */
        if (!self->build_mode) {
            backend::lir::lmod_plan_shell_reset();
            backend::lir::lmod_plan_set_prog(prog);
            if (ct_shell_plan_add_program(self, prog, -1, 0) != 0)
                return self->fail("cannot build the emission plan");
        }
        if (backend::emit::ct_emit_program(prog) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail_emit(why);
            return -1;
        }
        return 0;
    }

    /* v1-PH-2 S8: is built-in unit `u` reachable from this program? The
       answer comes from the semantic dependency graph (backend/tir/TGraph.h.ct,
       contract §3.4): unit -> layer edges from the parsed AST (type spellings,
       callee names), layer -> layer edges for the layer's own needs, and
       instance -> layer edges from the instance registry. The old whole-file
       text scan is gone; the SH-113 boundary cases are pinned by
       test/ast/sh113_builtin_live.sh. */
    int builtin_live_for(int u)
    {
        int slot, i, rc;
        (void)self;

        if (!self->is_builtin_unit(u)) return 1;
        slot = self->builtin_slot(u);
        if (slot < 0) return 1;
        if (!self->tgraph_done) {
            rc = backend::tir::tgraph_builtin_live(self->units, self->nunits,
                                                   self->builtin_units,
                                                   self->nbuiltin, self->arena,
                                                   self->sym, self->tgraph_live);
            if (rc != 0) {
                /* a caller outside the module layer has no node ranges: keep
                   the conservative answer (nothing pruned) */
                for (i = 0; i < 8; i++) self->tgraph_live[i] = 1;
            }
            self->tgraph_done = 1;
        }
        return self->tgraph_live[slot];
    }

    /* v1-PH-2 S9 (REQ-STRICT-1): the policy for one unit path. The CLI wins;
       then the environment; then the package manifest (its units follow the
       package's key); anything else is strict. The pre-1.0 allowance for
       `selfhost/`, `lib/core/`, `lib/std/`, `test/` and `examples/` is gone,
       and a manifest without a `c-boundary` key is strict too -- `ct migrate`
       writes `c-boundary = allow` into an old package that needs the bridge.
       SH-93: the working directory is not an input. */
    int c_boundary_for(const char *path)
    {
        int i, r;

        if (self->c_boundary >= 0) return self->c_boundary;
        {
            const char *e = getenv("CT_C_BOUNDARY");
            if (e != 0 && strcmp(e, "allow") == 0) return 0;
            if (e != 0 && strcmp(e, "strict") == 0) return 1;
        }
        /* A package manifest is the most specific statement about a unit that
           lives inside that package: its `c-boundary` key wins over the
           default. A manifest without the key is strict (S9 flipped the old
           allow window; `ct migrate` writes the key for an old package). */
        for (i = 0; i < self->ninc; i++) {
            if (strncmp(path, self->incdirs[i], strlen(self->incdirs[i])) != 0)
                continue;
            r = c_manifest_boundary(self->incdirs[i]);
            if (r >= 0) return r;
        }
        return 1;
    }

    /* PH-82 (D-012): the package's leak policy. `leaks = error` escalates the
       existing leak diagnostics and the direct-cycle warning, nothing else;
       `c-boundary` and `--debug-leaks` keep their own contracts. An `-I` root
       with a manifest is the package statement; without one the unit's own
       directory is read, so `ct compile`/`ct check` (which ignore `-I`) still
       see the package they live in. A missing key or any other value keeps the
       pre-PH-82 `warn` behaviour, so old packages do not change. */
    int leaks_for(const char *path)
    {
        const char *v;
        char *dir;
        int i, n;
        size_t l;

        if (path != 0)
            for (i = 0; i < self->ninc; i++) {
                l = strlen(self->incdirs[i]);
                if (l == 0 || strncmp(path, self->incdirs[i], l) != 0) continue;
                if (ct_pkg_key(self->incdirs[i], "leaks", &v))
                    return strcmp(v, "error") == 0 ? 1 : 0;
                return 0;
            }
        if (path == 0 || path[0] == 0) return 0;
        n = self->path_dir(path, &dir);
        if (n != 0) return 0;
        if (ct_pkg_key(dir, "leaks", &v) && strcmp(v, "error") == 0) return 1;
        return 0;
    }

    /* PH-82 (D-012): the direct-cycle warning. Nodes are plain, defined structs
       (generic templates/instances stay out, so generics never report); an edge
       is a `Box<X>` field and adjacent edges count one. The walk stops at three
       edges, a repeated payload field is one edge, and a cycle is emitted from
       its smallest row, so A -> B -> A and B -> A -> B are one finding. */
    int cycle_check(void)
    {
        int nrows, i, fi, a, b, c, j, k, n;

        nrows = self->sym->nstructs;
        if (nrows > CYCLE_ROWS) nrows = CYCLE_ROWS;
        for (i = 0; i < nrows; i++) g_cycle_nout[i] = 0;
        for (i = 0; i < nrows; i++) {
            if (!self->sym->structs[i].defined) continue;
            if (self->sym->structs[i].is_template) continue;
            if (self->sym->structs[i].is_inst) continue;
            for (fi = 0; fi < self->sym->structs[i].nfields; fi++) {
                k = cycle_Box_target(self, i, fi);
                if (k < 0) continue;
                for (j = 0; j < g_cycle_nout[i]; j++)
                    if (g_cycle_adj[i][j] == k) break;
                if (j < g_cycle_nout[i]) continue;
                if (g_cycle_nout[i] >= CYCLE_DEGREE) continue;
                g_cycle_adj[i][g_cycle_nout[i]++] = k;
            }
        }
        for (a = 0; a < nrows; a++) {
            if (!self->sym->structs[a].defined) continue;
            if (self->sym->structs[a].is_template) continue;
            if (self->sym->structs[a].is_inst) continue;
            for (j = 0; j < g_cycle_nout[a]; j++) {
                b = g_cycle_adj[a][j];
                if (b == a) {
                    if (cycle_emit(self, a, -1, -1) != 0) return 1;
                    continue;
                }
                for (k = 0; k < g_cycle_nout[b]; k++) {
                    c = g_cycle_adj[b][k];
                    if (c == a) {
                        if (a < b && cycle_emit(self, a, b, -1) != 0) return 1;
                        continue;
                    }
                    if (c == b) continue;
                    for (n = 0; n < g_cycle_nout[c]; n++)
                        if (g_cycle_adj[c][n] == a) break;
                    if (n < g_cycle_nout[c] && a < b && a < c
                        && cycle_emit(self, a, b, c) != 0)
                        return 1;
                }
            }
        }
        return 0;
    }

    /* PH-66 R1: bit0 = <stdio.h>, bit1 = <wchar.h>; `to` is exclusive. */
    /* PH-66 R1/R2: bit0 = <stdio.h>, bit1 = <wchar.h>. `unit < 0` covers every
       call (compile mode merges the layer and the input into one unit). */
    int io_header_mask(int unit)
    {
        const char *h;
        int i, mask = 0;

        (void)self;
        for (i = 0; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (unit >= 0 && frontend::parse::ct_parse_io_call_unit(i) != unit) continue;
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            h = io_header_for(frontend::parse::ct_parse_io_call_name(i));
            if (h == 0) continue;
            if (strcmp(h, "stdio.h") == 0) mask |= 1;
            else mask |= 2;
        }
        return mask;
    }

    /* Compile mode: the layer units are parsed first but only the ones the
       input uses are spliced, so only calls recorded after `from` belong to
       the product. */
    int io_header_mask_tail(int from)
    {
        const char *h;
        int i, mask = 0;

        (void)self;
        for (i = from; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            h = io_header_for(frontend::parse::ct_parse_io_call_name(i));
            if (h == 0) continue;
            if (strcmp(h, "stdio.h") == 0) mask |= 1;
            else mask |= 2;
        }
        return mask;
    }

    /* The freestanding diagnostic names the first libc I/O call the product
       would need; empty when there is none. */
    const char *io_first_name(int from)
    {
        int i;

        (void)self;
        for (i = from; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            if (io_header_for(frontend::parse::ct_parse_io_call_name(i)) != 0)
                return frontend::parse::ct_parse_io_call_name(i);
        }
        return "";
    }

    int io_first_line(int from)
    {
        int i;

        (void)self;
        for (i = from; i < frontend::parse::ct_parse_io_call_count(); i++) {
            if (frontend::parse::ct_parse_io_call_known(i)) continue;
            if (io_header_for(frontend::parse::ct_parse_io_call_name(i)) != 0)
                return frontend::parse::ct_parse_io_call_line(i);
        }
        return 0;
    }

    int io_call_count(void)
    {
        (void)self;
        return frontend::parse::ct_parse_io_call_count();
    }

    int builtin_slot(int u)
    {
        int i;
        for (i = 0; i < self->nbuiltin; i++)
            if (self->builtin_units[i] == u) return i;
        return -1;
    }

    int emit_unit(int u)
    {
        {
            int bs = self->builtin_slot(u);
            if (bs >= 0 && self->computed_live && !self->builtin_live[bs]) return 0;
        }
        const char *why;
        /* a diagnostic raised while emitting this unit must name this unit: the
           error store reads `mem->path`, the capacity messages `sym->path` */
        self->path = self->units[u].path;
        self->mem->path = self->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_bind_io_mask(self->io_header_mask(u));
        if (backend::emit::ct_emit_unit(u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail_emit(why);
            return -1;
        }
        return 0;
    }

    int write_unit_header(int u)
    {
        {
            int bs = self->builtin_slot(u);
            if (bs >= 0 && self->computed_live && !self->builtin_live[bs]) return 0;
        }
        const char *why;
        if (backend::emit::ct_emit_unit_header(u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* Compile mode has no unit table, so the rule is read from the input path:
       a `.h.ct` source publishes its header, a plain `.ct` one does not. */
    int write_header(const char *outc)
    {
        const char *why;
        size_t pl;
        (void)self;
        pl = strlen(self->path);
        if (!(pl > 5 && strcmp(self->path + pl - 5, ".h.ct") == 0)) return 0;
        if (backend::emit::ct_emit_header(outc) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        const char *why;
        /* S8 closeout: the module layer selects the six JSON sections; the
           writer renders plan rows only (no symbol table / AST read). */
        if (ct_map_plan_build(self, prog, u) != 0) return self->fail("out of memory");
        if (backend::emit::ct_emit_map(dest, prog, u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_model(const char *dest, int prog)
    {
        const char *why;
        /* S8 closeout: same contract for the model's three sections. */
        if (ct_model_plan_build(self, prog) != 0) return self->fail("out of memory");
        if (backend::emit::ct_emit_model(dest, prog) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }
}

/* Shell-line helpers for the one-step build (Phase 17.6). */






/* The same segment claimed by two `-I` roots: an error, never a silent pick.
   `file` names the later manifest, which is the one to change. */
static int ct_pkg_ns_clash(struct Module *m, char **msg, char **file)
{
    const char *ns;
    char *nroot;
    char *nother;
    int i, j;

    *msg = (char *)0;
    *file = (char *)0;
    for (i = 0; i < m->ninc; i++) {
        if (!ct_pkg_key(m->incdirs[i], "namespace", &ns)) continue;
        ct_norm_path(m->incdirs[i], &nroot);
        for (j = 0; j < i; j++) {
            const char *other;
            if (!ct_pkg_key(m->incdirs[j], "namespace", &other)) continue;
            if (strcmp(ns, other) != 0) continue;
            /* One directory spelled twice (`-I a -I ./a`) is one package, not a
               clash with itself. */
            ct_norm_path(m->incdirs[j], &nother);
            if (strcmp(nroot, nother) == 0) continue;
            *msg = tool::sh::ct_scratch_fmt(
                "package namespace '%s' is declared by two import roots: '%s' and '%s'",
                ns, m->incdirs[j], m->incdirs[i]);
            *file = tool::sh::ct_scratch_fmt("%s/ct.pkg", m->incdirs[i]);
            return 1;
        }
    }
    return 0;
}



/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Module g_module;

/* Storage for the unit table: its element type belongs to `unit.h.ct`, and a
   generated header carries no `#include`, so the array stays here and
   `g_module` points at it. It is a heap block (SH-42): a `struct Unit` caches
   its parsed text, so 64 of them inline put ~620 KB of zeroes into __DATA. */
static struct Unit *g_units;

pub struct Module *module_get(void);
struct Module *module_get(void)
{
    return &g_module;
}

/* S1a-0 C2g: release the run's --cflags / --ldflags accumulators. The driver
   calls it once after the command returns, so every exit path is covered. */
pub void ct_module_free_flags(void);
void ct_module_free_flags(void)
{
    free(g_module.cflags);
    free(g_module.ldflags);
    g_module.cflags = 0;
    g_module.cflagscap = 0;
    g_module.ldflags = 0;
    g_module.ldflagscap = 0;
}

/* The driver wires the collaborators and the shared table once, before it
   dispatches; the name and the version it sets through the object itself. */
pub void ct_module_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *p, void *cache);
/* PH-66 R1: the driver and the build path both need the header mask. */
pub int ct_module_io_mask(int unit);
int ct_module_io_mask(int unit)
{
    return g_module.io_header_mask(unit);
}

void ct_module_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *p, void *cache)
{
    g_module.arena = (struct Arena *)arena;
    g_module.lex = (struct Lexer *)lex;
    g_module.sym = (struct Symbols *)sym;
    g_module.ty = (struct TypeCheck *)ty;
    g_module.mem = (struct Memory *)mem;
    g_module.p = (struct Parser *)p;
    g_module.cache = (struct Cache *)cache;
    if (!g_units) {
        g_units = calloc(MAX_UNITS, sizeof(*g_units));
        if (!g_units) {
            fprintf(stderr, "ctc: out of memory\n");
            exit(1);
        }
        g_module.unitcap = MAX_UNITS;
    }
    g_module.units = g_units;
    if (!g_module.incdirs) {
        g_module.incdirs = calloc(MAX_INCDIRS, sizeof(*g_module.incdirs));
        if (!g_module.incdirs) {
            fprintf(stderr, "ctc: out of memory\n");
            exit(1);
        }
        g_module.inccap = MAX_INCDIRS;
    }
    /* PH-65 R1: both modes start from "resolve per path"; build_main and the
       driver may override it from the command line. */
    g_module.c_boundary = -1;
    g_module.show_c_boundary = 0;
    g_module.show_io_headers = 0;
}
