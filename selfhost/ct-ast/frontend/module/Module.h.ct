/*
 * Module.h.ct - the build driver: unit loading and the output side.
 *
 * The module layer of a `build`: path and import resolution, loading the unit
 * closure, validating a unit's directory against its `namespace`, ordering the
 * units for the incremental cache, and driving the emitter for every unit. The
 * compile-mode entry (`run`) stays with the driver object in
 * tool/driver/Driver.h.ct; this unit holds the state the two share -- the unit
 * table, the run options and the current path -- so those methods are real
 * methods on an object rather than free functions over file-scope globals.
 *
 * Macros do not cross a unit boundary, so the caps and the token kinds used
 * here are declared here; MAX_TEXT 160 is the value
 * `frontend/sym/Symbols.h.ct` lists and MAX_KEY 768 the one
 * `tool/cache/Cache.h.ct` spells.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

import backend::emit::Emitter;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Unit;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import tool::cache::Cache;
import tool::diag::Diag;

#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_UNITS  64
#define MAX_IMPORTS 32
#define MAX_INCDIRS 16
#define MAX_IH     5120                 /* MAX_IMPORTS * MAX_TEXT, spelled out */
#define MAX_KEY    768                  /* one unit's incremental-cache key */

/* token kinds (the scanner only needs these two) */
#define T_ID     1
#define T_PP     5
/* node kinds: file-scope variables and the two type declarations, the same
   values `Arena.h.ct` assigns */
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_ENUM    45
#define N_ENUMVAL 46
#define N_UNION   48

namespace frontend::module;
pub trait ModuleOps {
    int  fail(const char *msg);
    int  fail_emit(const char *msg);
    int  read_file(const char *path);
    int  base_name(const char *path, char *out, int cap, int *is_hdr, int *is_map);
    int  path_dir(const char *path, char *out, int cap);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char *out, int cap,
                        int *is_hdr, int *is_map, int line);
    int  load_unit(const char *path);
    int  check_ns_dir(int u);
    int  cache_order(int u, int *state, int *order, int *n);
    int  cache_key_of(int u, char *out, int cap);
    int  build_main(int argc, char **argv);
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  write_header(const char *outc);
    int  write_map(const char *dest, int prog, int u);
}

pub struct Module {
    /* Collaborators the methods reach through; the driver wires them once. */
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct TypeCheck *ty;
    struct Memory *mem;
    struct Parser *p;
    struct Cache *cache;
    /* Output state for one run: the source path the banner and diagnostics
       report. The driver re-points it for each unit in build mode. */
    const char *path;
    /* Build mode: the unit table and the import search roots. These tables have
       element types from this same namespace; a generated header carries no
       `#include`, so their storage lives in this unit's `.c` and the object
       keeps a pointer. */
    struct Unit *units;
    int  nunits;
    int  build_mode;
    /* Array bounds are literals because this struct lands in a generated header
       that carries no macros; 1024 is MAX_PATH and 16 is MAX_INCDIRS here. */
    char outdir[1024];
    const char *incdirs[16];
    int  ninc;
    const char *nsroot;
    /* Run options. `prog` is the entry name `-v` and the usage lines print
       (D44): `ct` when installed under that name, `ctc` for the compatibility
       alias, `ct-ast` for the development binary. Driver diagnostics keep the
       published `ctc:` prefix (SH-3 / phase10 non-goal). */
    int  line_mode;             /* emit `#line`: 0 off, 1 on */
    int  line_force;            /* -1 mode default, 0 --no-line, 1 --line */
    char map_path[1024];
    int  have_map;
    const char *prog;
    int  diag_json;             /* --diagnostics=json */
    const char *std_flag;       /* --std=c99 | --std=gnu99 */
    const char *version;        /* CTC_VERSION, bound by the driver */
} use ModuleOps;

impl ModuleOps for Module {
    /* Module failures are about the build itself -- an unreadable input, an
       import that does not resolve, a path that does not fit, a limit. None of
       them has a source position, so they keep the `ctc:` shape. A diagnostic
       that *is* about the source goes through `fail_emit` / the parser. */
    int fail(const char *msg)
    {
        (void)self;
        return frontend::parse::ct_parse_fail_driver(msg);
    }

    /* An emitter failure may blame an AST node (its line is exact) or be about
       the output file (no position at all). */
    int fail_emit(const char *msg)
    {
        int line;
        (void)self;
        line = backend::emit::ct_emit_error_line();
        if (line > 0) return frontend::parse::ct_parse_fail_at(line, msg);
        return frontend::parse::ct_parse_fail_driver(msg);
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        self->lex->src = buf;
        return 0;
    }

    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`;
       `foo.m.ct` -> `foo` and `is_map = 1`. */
    int base_name(const char *path, char *out, int cap, int *is_hdr, int *is_map)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        *is_map = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 5 && strcmp(name + n - 5, ".m.ct") == 0) {
            *is_map = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > (size_t)cap) return self->fail("output name is too long");
        snprintf(out, (size_t)cap, "%.*s", (int)n, name);
        return 0;
    }

    int path_dir(const char *path, char *out, int cap)
    {
        const char *slash;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        if (!slash) {
            if (cap < 2) return self->fail("path is too long");
            snprintf(out, (size_t)cap, "%s", ".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        if (n + 1 > (size_t)cap) return self->fail("path is too long");
        snprintf(out, (size_t)cap, "%.*s", (int)n, path);
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. The dependencies are not loaded yet, so this
       pass only records the paths (`scan_only` keeps `skip_import` from trying
       to resolve aliases against a symbol table that does not have them). */
    int scan_imports(const char *from)
    {
        self->p->nrels = 0;
        self->p->scan_only = 1;
        self->path = from;
        self->mem->path = self->path;
        backend::emit::ct_emit_set_path(self->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        frontend::parse::ct_parse_lex_next();
        for (;;) {
            if (self->lex->tok == T_PP) {
                frontend::parse::ct_parse_lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "import") == 0) {
                if (frontend::parse::ct_parse_skip_import() != 0) { self->p->scan_only = 0; return -1; }
                continue;
            }
            break;
        }
        self->p->scan_only = 0;
        return 0;
    }

    /* A unit's interface lives in its header, so a `.h.ct` or `.m.ct` unit can
       be imported. The search is two passes -- first every root for `a/b.h.ct`
       and `a/b.m.ct` (the importer's own directory, then the `-I` roots, in
       command-line order), then every root for `a/b.ct`: a plain unit there is
       the mistake worth naming, because it is an implementation file. The two
       importable suffixes in one root are an ambiguity. */
    int resolve_import(const char *from, const char *rel, char *out, int cap,
                       int *is_hdr, int *is_map, int line)
    {
        char dir[MAX_PATH];
        char cand[MAX_PATH];
        char hdr[MAX_PATH];
        const char *root;
        FILE *f;
        int r;
        (void)self;

        if (self->path_dir(from, dir, sizeof dir) != 0) return -1;
        *is_map = 0;
        for (r = -1; r < self->ninc; r++) {
            int has_h, has_m;
            root = (r < 0) ? dir : self->incdirs[r];
            if (snprintf(hdr, sizeof hdr, "%s/%s.h.ct", root, rel) >= (int)sizeof hdr)
                return self->fail("import path is too long");
            f = fopen(hdr, "rb");
            has_h = (f != NULL);
            if (f) fclose(f);
            if (snprintf(cand, sizeof cand, "%s/%s.m.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            has_m = (f != NULL);
            if (f) fclose(f);
            if (has_h && has_m) {
                char msg[MAX_PATH + MAX_PATH];
                snprintf(msg, sizeof msg,
                         "import '%s' is ambiguous: both %s and %s exist", rel, hdr, cand);
                if (line > 0) return tool::diag::ct_sem_error(line, 1, msg, from);
                return self->fail(msg);
            }
            if (has_h) {
                *is_hdr = 1;
                if (snprintf(out, (size_t)cap, "%s", hdr) >= cap) return self->fail("import path is too long");
                return 0;
            }
            if (has_m) {
                *is_map = 1;
                if (snprintf(out, (size_t)cap, "%s", cand) >= cap) return self->fail("import path is too long");
                return 0;
            }
        }
        for (r = -1; r < self->ninc; r++) {
            root = (r < 0) ? dir : self->incdirs[r];
            if (snprintf(cand, sizeof cand, "%s/%s.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                if (snprintf(cand, sizeof cand,
                             "only a .h.ct unit can be imported: rename '%s.ct' to '%s.h.ct'",
                             rel, rel) >= (int)sizeof cand)
                    return self->fail("import path is too long");
                return self->fail(cand);
            }
        }
        snprintf(cand, sizeof cand, "cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char rels[MAX_IMPORTS][MAX_TEXT];
        int  lines[MAX_IMPORTS];
        char dep[MAX_PATH];
        char *mysrc;
        int u, i, k, d, nrels, is_hdr, is_map, dep_is_map, dup, dn, gn;
        (void)self;

        for (u = 0; u < self->nunits; u++)
            if (strcmp(self->units[u].path, path) == 0) return u;
        if (self->nunits >= MAX_UNITS) {
            self->fail("too many units");
            return -1;
        }
        u = self->nunits;
        self->nunits++;
        if (snprintf(self->units[u].path, MAX_PATH, "%s", path) >= MAX_PATH) {
            self->fail("path is too long");
            return -1;
        }
        self->units[u].ndep = 0;
        self->units[u].prog = -1;
        self->units[u].digest = 0;
        self->units[u].ns[0] = 0;
        if (self->base_name(path, self->units[u].base, MAX_TEXT, &is_hdr, &is_map) != 0) return -1;
        self->units[u].is_hdr = is_hdr;
        self->units[u].is_map = is_map;
        self->p->unit_is_map = is_map;
        /* A shim belongs to a mapping unit only (batch 39): `<base>.shim.h` is
           an include root for the consumer, `<base>.shim.c` joins the program.
           Header-only shims are the normal case; a source without its header
           cannot declare anything for a recipe, so it is rejected by name. */
        self->units[u].has_shim = 0;
        self->units[u].shim_dir[0] = 0;
        self->units[u].shim_h[0] = 0;
        self->units[u].shim_c[0] = 0;
        if (is_map) {
            char dir[MAX_PATH];
            char h[MAX_PATH];
            char c[MAX_PATH];
            struct stat st;
            if (self->path_dir(path, dir, sizeof dir) != 0) return -1;
            snprintf(h, sizeof h, "%s/%s.shim.h", dir, self->units[u].base);
            snprintf(c, sizeof c, "%s/%s.shim.c", dir, self->units[u].base);
            if (stat(h, &st) == 0)
                snprintf(self->units[u].shim_h, MAX_PATH, "%s", h);
            if (stat(c, &st) == 0)
                snprintf(self->units[u].shim_c, MAX_PATH, "%s", c);
            if (self->units[u].shim_c[0] && !self->units[u].shim_h[0])
                return tool::diag::ct_sem_error(1, 1,
                    "a shim source needs a matching .shim.h", path);
            if (self->units[u].shim_h[0]) {
                self->units[u].has_shim = 1;
                snprintf(self->units[u].shim_dir, MAX_PATH, "%s", dir);
            }
        }

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)self->lex->src;
        if (self->scan_imports(path) != 0) return -1;
        nrels = self->p->nrels;
        for (i = 0; i < nrels; i++) {
            snprintf(rels[i], MAX_TEXT, "%s", self->p->rels[i]);
            lines[i] = self->p->rel_line[i];
        }
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path, rels[i], dep, sizeof dep, &is_hdr, &dep_is_map,
                                    lines[i]) != 0) return -1;
            if (is_map && !dep_is_map) {
                return tool::diag::ct_sem_error(lines[i], 1,
                    "a .m.ct unit can only import another .m.ct unit", path);
            }
            d = self->load_unit(dep);
            if (d < 0) return -1;
            /* Two `import` lines may name the same unit; a dependency is listed
               once, so the generated `#include` is emitted once. */
            dup = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (self->units[u].depu[k] == d) dup = 1;
            if (dup) continue;
            if (self->units[u].ndep >= MAX_IMPORTS) {
                self->fail("too many imports");
                return -1;
            }
            snprintf(self->units[u].dep[self->units[u].ndep], MAX_TEXT, "%s", self->units[d].base);
            self->units[u].depu[self->units[u].ndep] = d;
            self->units[u].ndep++;
        }

        self->lex->src = mysrc;
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->tok = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        /* the bare-name table for exported types is rebuilt from this unit's
           direct dependencies below */
        self->sym->ntb = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ns[0] = 0;
        self->sym->nalias = 0;
        self->p->ns_decl[0] = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->p->cur_func[0] = 0;
        self->p->nparams = 0;
        /* 2a.2: an imported unit's `pub` global is declared `extern` in that
           unit's header, so C links one object for both units. Register it here
           as well, or this unit could not name it in `import count; g_counter`.
           The C spelling is mangled by the owner's namespace (the same rule the
           owner used when it declared the global); an `extern` declaration keeps
           the library's own name and has no namespace to qualify with. */
        for (i = 0; i < self->units[u].ndep; i++) {
            char gcn[MAX_TEXT];
            char gns[MAX_TEXT];
            const char *gname;
            size_t gl;
            dn = self->units[u].depu[i];
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                if (self->arena->nodes[gn].kind != N_GLOBAL || self->arena->nodes[gn].d != 1) continue;
                gname = self->arena->nodes[gn].text2;
                if (self->arena->nodes[gn].aux == 2 || !self->units[dn].nsprefix[0]) {
                    snprintf(gcn, sizeof gcn, "%s", gname);
                    gns[0] = 0;
                } else {
                    if (snprintf(gcn, sizeof gcn, "%s%s",
                                 self->units[dn].nsprefix, gname) >= (int)sizeof gcn)
                        return self->fail("variable name is too long");
                    snprintf(gns, sizeof gns, "%s", self->units[dn].nsprefix);
                    gl = strlen(gns);
                    if (gl > 0) gns[gl - 1] = 0;
                }
                if (self->sym->declare_global(gname, self->arena->nodes[gn].text,
                                              gcn, gns, 1) < 0)
                    return self->fail(self->sym->last_error());
            }
            /* An exported enum's members are file-scope constants (D-3). The
               var table was reset for this unit, so they are registered here
               under the owner's C spelling, exactly as the owner declared them. */
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                char ccn[MAX_TEXT];
                char cns[MAX_TEXT];
                const char *cmn;
                size_t cl;
                int mv;
                if (self->arena->nodes[gn].kind != N_ENUM || self->arena->nodes[gn].d != 1) continue;
                for (mv = self->arena->nodes[gn].a; mv >= 0; mv = self->arena->nodes[mv].next) {
                    cmn = self->arena->nodes[mv].text2;
                    if (!self->units[dn].nsprefix[0]) {
                        snprintf(ccn, sizeof ccn, "%s", cmn);
                        cns[0] = 0;
                    } else {
                        if (snprintf(ccn, sizeof ccn, "%s%s",
                                     self->units[dn].nsprefix, cmn) >= (int)sizeof ccn)
                            return self->fail("variable name is too long");
                        snprintf(cns, sizeof cns, "%s", self->units[dn].nsprefix);
                        cl = strlen(cns);
                        if (cl > 0) cns[cl - 1] = 0;
                    }
                    if (self->sym->declare_const(cmn, ccn, cns, 1) < 0)
                        return self->fail(self->sym->last_error());
                }
            }
            /* Exported types of the dependency, reachable by their bare name
               here (SH-18). The table is per importing unit, so an unrelated
               namespace elsewhere in the program cannot make a name ambiguous. */
            for (gn = self->arena->nodes[self->units[dn].prog].a; gn >= 0;
                 gn = self->arena->nodes[gn].next) {
                const char *full;
                const char *bare;
                size_t pl;
                if (self->arena->nodes[gn].d != 1) continue;
                if (self->arena->nodes[gn].kind != N_STRUCT
                    && self->arena->nodes[gn].kind != N_TYPEDEF
                    && self->arena->nodes[gn].kind != N_ENUM
                    && self->arena->nodes[gn].kind != N_UNION) continue;
                full = self->arena->nodes[gn].text2;
                bare = full;
                pl = strlen(self->units[dn].nsprefix);
                if (pl > 0 && strncmp(full, self->units[dn].nsprefix, pl) == 0) bare = full + pl;
                if (self->sym->add_bare_type(bare, full) != 0)
                    return self->fail(self->sym->last_error());
            }
            for (gn = self->units[dn].tr_start; gn < self->units[dn].tr_end; gn++) {
                const char *full;
                const char *bare;
                size_t pl;
                if (!self->sym->traits[gn].is_pub) continue;
                full = self->sym->traits[gn].name;
                bare = full;
                pl = strlen(self->units[dn].nsprefix);
                if (pl > 0 && strncmp(full, self->units[dn].nsprefix, pl) == 0) bare = full + pl;
                if (self->sym->add_bare_type(bare, full) != 0)
                    return self->fail(self->sym->last_error());
            }
        }
        /* `scan_imports` counted this unit's imports into `rels`, but the
           recursive loads above left the counter at a dependency's value, and
           parsing skips the same `import` lines again -- start that pass from
           zero so a unit is never charged for its dependencies' imports. */
        self->p->nrels = 0;
        self->p->scan_only = 0;
        self->path = path;
        self->mem->path = self->path;
        backend::emit::ct_emit_set_path(self->path);
        self->units[u].fn_start = self->sym->nfunc;
        self->units[u].tr_start = self->sym->ntraits;
        self->units[u].call_start = self->p->ncalls;
        self->p->cur_unit = u;
        /* dependencies were parsed recursively and overwrote the flag */
        self->p->unit_is_map = self->units[u].is_map;
        self->units[u].prog = frontend::parse::ct_parse_program();
        if (self->units[u].prog < 0) return -1;
        self->units[u].fn_end = self->sym->nfunc;
        self->units[u].tr_end = self->sym->ntraits;
        self->units[u].call_end = self->p->ncalls;
        snprintf(self->units[u].ns, MAX_TEXT, "%s", self->p->ns_decl);
        /* `sym->ns` is the mangled prefix the unit's parser used for its
           exported names; its globals need the same prefix here. */
        snprintf(self->units[u].nsprefix, MAX_TEXT, "%s", self->sym->ns);
        return u;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char rest[MAX_PATH];
        char dir[MAX_TEXT];
        char want[MAX_TEXT];
        const char *p;
        size_t rn, k, m;

        (void)self;
        if (!self->units[u].ns[0]) return 0;
        if (!self->nsroot || !self->nsroot[0]) return 0;
        rn = strlen(self->nsroot);
        if (strncmp(self->units[u].path, self->nsroot, rn) != 0) return 0;
        p = self->units[u].path + rn;
        if (*p == '/') p++;
        snprintf(rest, sizeof rest, "%s", p);
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        if (k >= sizeof dir) return self->fail("path is too long");
        snprintf(dir, sizeof dir, "%.*s", (int)k, rest);

        m = 0;
        for (k = 0; self->units[u].ns[k]; k++) {
            if (m + 1 >= sizeof want) return self->fail("namespace is too long");
            if (self->units[u].ns[k] == ':' && self->units[u].ns[k + 1] == ':') {
                want[m] = '/';
                m++;
                k++;
            } else {
                want[m] = self->units[u].ns[k];
                m++;
            }
        }
        want[m] = 0;
        if (strcmp(dir, want) != 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "namespace '%s' does not match the directory '%s'",
                     self->units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* Dependency-first order for the cache. `load_unit` assigns an importer its
       index before recursing, so unit indices are neither a topological order
       nor its reverse; this postorder DFS is (same shape as L2's `order[]`).
       The graph belongs to this layer, not to the cache. */
    int cache_order(int u, int *state, int *order, int *n)
    {
        int k;
        (void)self;
        if (state[u] != 0) return 0;
        state[u] = 1;
        for (k = 0; k < self->units[u].ndep; k++)
            if (self->cache_order(self->units[u].depu[k], state, order, n) != 0)
                return -1;
        state[u] = 2;
        order[*n] = u;
        (*n)++;
        return 0;
    }

    /* The key material of unit `u`: its import list as text and the folded
       dependency digest. The cache turns this into a stamped key; the module
       layer owns the graph, so the folding happens here. */
    int cache_key_of(int u, char *out, int cap)
    {
        char ih[MAX_IH];
        unsigned long dep;
        size_t n, k;
        int w;
        (void)self;

        n = 0;
        ih[0] = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++) {
            w = snprintf(ih + n, sizeof ih - n, "%s%s;", self->units[u].dep[k],
                         self->units[self->units[u].depu[k]].is_map ? ".m" : ".h");
            if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
            n += (size_t)w;
        }
        /* A shim is part of the mapping's definition: touching either file must
           rebuild the consumers, so its stamp joins the key material. */
        if (self->units[u].is_map && self->units[u].has_shim) {
            struct stat st;
            if (stat(self->units[u].shim_h, &st) == 0) {
                w = snprintf(ih + n, sizeof ih - n, "sh@%lu.%lu;",
                             (unsigned long)st.st_mtime, (unsigned long)st.st_size);
                if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
                n += (size_t)w;
            }
            if (self->units[u].shim_c[0] && stat(self->units[u].shim_c, &st) == 0) {
                w = snprintf(ih + n, sizeof ih - n, "sc@%lu.%lu;",
                             (unsigned long)st.st_mtime, (unsigned long)st.st_size);
                if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
                n += (size_t)w;
            }
        }
        dep = 0;
        for (k = 0; k < (size_t)self->units[u].ndep; k++)
            dep = dep * (unsigned long)1099511628211
                + self->units[self->units[u].depu[k]].digest;
        if (self->cache->key(self->units[u].path, ih, dep, self->line_force,
                             self->diag_json, self->nsroot, out, cap) != 0)
            return -1;
        /* the unit's own digest is what its dependants fold next */
        self->units[u].digest = self->cache->digest(out);
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        const char *inputs[MAX_UNITS];
        int ninput, i, u, o, cn;
        int dirty[MAX_UNITS];
        int cstate[MAX_UNITS];
        int corder[MAX_UNITS];
        const char *outdir;
        char root[MAX_PATH];
        (void)self;

        ninput = 0;
        outdir = NULL;
        self->ninc = 0;
        self->nsroot = NULL;
        self->line_mode = 1;
        self->line_force = -1;
        self->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n",
                       self->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->line_mode = 1;
                self->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->line_mode = 0;
                self->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->map_path, sizeof self->map_path, "%s", argv[i]) >= (int)sizeof self->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                outdir = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (self->ninc >= MAX_INCDIRS) {
                    fprintf(stderr, "ctc: too many -I roots\n");
                    return 1;
                }
                self->incdirs[self->ninc] = argv[i];
                self->ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                self->nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= MAX_UNITS) {
                fprintf(stderr, "ctc: too many inputs\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: %s build <input.ct>... -o <dir>\n", self->prog);
            return 1;
        }
        /* A `.m.ct` unit is a compile-time mapping: it is loaded through
           `import`, never as a build input, and it never writes an artefact. */
        for (i = 0; i < ninput; i++) {
            size_t pl = strlen(inputs[i]);
            if (pl > 5 && strcmp(inputs[i] + pl - 5, ".m.ct") == 0) {
                fprintf(stderr, "ctc: a .m.ct unit produces no output; import it from a .ct unit\n");
                return 1;
            }
        }
        if (!outdir) {
            fprintf(stderr, "ctc: build needs -o <dir>\n");
            return 1;
        }
        if (snprintf(self->outdir, sizeof self->outdir, "%s", outdir) >= (int)sizeof self->outdir) {
            fprintf(stderr, "ctc: output directory is too long\n");
            return 1;
        }
        if (!self->nsroot) {
            if (self->path_dir(inputs[0], root, sizeof root) != 0) {
                return frontend::parse::ct_parse_report();
            }
            self->nsroot = root;
        }

        self->nunits = 0;
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->ntb = 0;
        self->p->nrels = 0;
        self->p->scan_only = 0;
        self->p->nparams = 0;
        self->sym->self_mode = 0;
        self->sym->ret_type[0] = 0;
        self->sym->ns[0] = 0;
        self->sym->nalias = 0;
        self->p->ns_decl[0] = 0;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        self->p->ncalls = 0;
        tool::diag::ct_diag_reset();
        self->p->cur_func[0] = 0;
        frontend::parse::ct_parse_clear_error();
        self->build_mode = 1;

        for (i = 0; i < ninput; i++) {
            if (self->load_unit(inputs[i]) < 0) {
                if (tool::diag::ct_diag_nsem()) fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                else frontend::parse::ct_parse_report();
                return 1;
            }
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                return frontend::parse::ct_parse_report();
            }
        }
        /* Incremental cache (Phase 6.3, ported in 10.5): a unit whose key still
           matches and whose .c/.h are on disk is not regenerated. The walk is a
           dependency-first postorder, so a unit's key can fold its dependencies'
           digests; a unit whose dependency is dirty is dirty too. `--emit-map`
           never reuses, because the map spans the whole run. */
        for (u = 0; u < self->nunits; u++) cstate[u] = 0;
        cn = 0;
        for (u = 0; u < self->nunits; u++)
            if (self->cache_order(u, cstate, corder, &cn) != 0) {
                return frontend::parse::ct_parse_report();
            }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            int k;
            u = corder[o];
            dirty[u] = 1;
            /* A map unit writes nothing, but its digest is folded by every
               consumer, so the key is computed and it is never a cache hit. */
            if (self->units[u].is_map) {
                if (self->cache_key_of(u, key, sizeof key) != 0)
                    return frontend::parse::ct_parse_report();
                dirty[u] = 0;
                continue;
            }
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    >= (int)sizeof outc) {
                fprintf(stderr, "ctc: output path is too long\n");
                return 1;
            }
            if (!self->have_map && self->cache_key_of(u, key, sizeof key) == 0
                && self->cache->hit(outc, key, self->units[u].is_hdr))
                dirty[u] = 0;
            for (k = 0; k < self->units[u].ndep; k++)
                if (dirty[self->units[u].depu[k]]) dirty[u] = 1;
        }
        for (o = 0; o < cn; o++) {
            char outc[MAX_PATH];
            char key[MAX_KEY];
            u = corder[o];
            if (self->units[u].is_map) continue;
            if (!dirty[u]) continue;
            if (self->emit_unit(u) != 0) {
                /* the `.c` was already opened, so a failure leaves half a file;
                   a failed unit must not leave an artefact behind */
                if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                        < (int)sizeof outc)
                    remove(outc);
                return frontend::parse::ct_parse_report();
            }
            if (self->units[u].is_hdr && self->write_unit_header(u) != 0) {
                return frontend::parse::ct_parse_report();
            }
            /* stamped only after a successful emit: a failed unit must never be
               reused, and a stale key must never vouch for new sources */
            if (snprintf(outc, sizeof outc, "%s/%s.c", self->outdir, self->units[u].base)
                    < (int)sizeof outc
                && self->cache_key_of(u, key, sizeof key) == 0)
                self->cache->store(outc, key);
        }
        if (self->have_map && self->write_map(self->map_path, self->units[0].prog, 0) != 0) {
            return frontend::parse::ct_parse_report();
        }
        /* The command the user runs next, in the same shape L2 prints; the
           target C standard (Phase 6.4) is the only option it carries. */
        printf("cc %s", self->std_flag);
        /* A shim header is included by base name, so its directory becomes an
           include root; one root is printed once even for several mappings. */
        for (u = 0; u < self->nunits; u++) {
            int dupd = 0;
            if (!self->units[u].is_map || !self->units[u].has_shim) continue;
            for (i = 0; i < u; i++)
                if (self->units[i].is_map && self->units[i].has_shim
                    && strcmp(self->units[i].shim_dir, self->units[u].shim_dir) == 0)
                    dupd = 1;
            if (!dupd) printf(" -I %s", self->units[u].shim_dir);
        }
        for (u = 0; u < self->nunits; u++) {
            if (self->units[u].is_map) continue;
            printf(" %s/%s.c", self->outdir, self->units[u].base);
        }
        /* The shim implementation is part of the program, not an artefact: it
           is compiled straight from its source next to the mapping unit. */
        for (u = 0; u < self->nunits; u++) {
            if (!self->units[u].is_map || !self->units[u].shim_c[0]) continue;
            printf(" %s", self->units[u].shim_c);
        }
        printf(" -o a.out\n");
        if (tool::diag::ct_diag_emit(self->diag_json, 1) != 0) return 1;
        return 0;
    }

    /* The emitter (backend::emit) owns the code generation; these facades hand
       the first raw failure to the error store in the shape it deserves: a node
       error keeps its line, an output-file error has none. */
    int emit_program(int prog)
    {
        const char *why;
        if (backend::emit::ct_emit_program(prog) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail_emit(why);
            return -1;
        }
        return 0;
    }

    int emit_unit(int u)
    {
        const char *why;
        /* a diagnostic raised while emitting this unit must name this unit, and
           the error store reads the path from the memory object */
        self->path = self->units[u].path;
        self->mem->path = self->path;
        if (backend::emit::ct_emit_unit(u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail_emit(why);
            return -1;
        }
        return 0;
    }

    int write_unit_header(int u)
    {
        const char *why;
        if (backend::emit::ct_emit_unit_header(u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* Compile mode has no unit table, so the rule is read from the input path:
       a `.h.ct` source publishes its header, a plain `.ct` one does not. */
    int write_header(const char *outc)
    {
        const char *why;
        size_t pl;
        (void)self;
        pl = strlen(self->path);
        if (!(pl > 5 && strcmp(self->path + pl - 5, ".h.ct") == 0)) return 0;
        if (backend::emit::ct_emit_header(outc) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        const char *why;
        if (backend::emit::ct_emit_map(dest, prog, u) != 0) {
            why = backend::emit::ct_emit_last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Module g_module;

/* Storage for the unit table: its element type belongs to `unit.h.ct`, and a
   generated header carries no `#include`, so the array stays here and
   `g_module` points at it. */
static struct Unit g_units[MAX_UNITS];

pub struct Module *module_get(void);
struct Module *module_get(void)
{
    return &g_module;
}

/* The driver wires the collaborators and the shared table once, before it
   dispatches; the name and the version it sets through the object itself. */
pub void ct_module_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *p, void *cache);
void ct_module_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *p, void *cache)
{
    g_module.arena = (struct Arena *)arena;
    g_module.lex = (struct Lexer *)lex;
    g_module.sym = (struct Symbols *)sym;
    g_module.ty = (struct TypeCheck *)ty;
    g_module.mem = (struct Memory *)mem;
    g_module.p = (struct Parser *)p;
    g_module.cache = (struct Cache *)cache;
    g_module.units = g_units;
}
