/*
 * ModuleBoundary.h.ct - moved out of Module.h.ct (PH-85 S85c M0, pure move).
 *
 * Bodies are byte-identical to the ones this unit used to hold;
 * the declaration line only loses `static` and gains a `pub`
 * prototype, the interface change the M0 card allows. See
 * docs/design/p85_m0.md for the baseline and the old->new map.
 */

#include "ModuleBoundary.shim.h"
import backend::emit::Emitter;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Unit;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::type::TypeCheck;
