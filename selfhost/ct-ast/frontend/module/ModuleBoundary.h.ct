/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160

namespace frontend::module;

/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ModuleBoundary {
    int unused;
}

pub int c_manifest_boundary(const char *dir);
pub int ct_append_flags(char **buf, int *cap, int init, const char *val);
pub int ct_cmd_raw(char **cmd, int *cap, const char *frag);
pub int ct_cmd_token(char **cmd, int *cap, const char *tok);
pub int ct_ensure_dir(const char *path);
/* S1a-0 C2l: both paths are run-scoped blocks (see `ct_scratch_fmt`). */
pub int ct_norm_path(const char *in, char **out);
pub int ct_pkg_key(const char *root, const char *key, const char **out);
pub int ct_rel_cands(const char *root, const char *rel, char **first, char **fallback);
pub int ct_root_find(const char *root, const char *rel, char **out, int *is_hdr, int *is_map, char **err);
pub int has_word(const char *s, const char *w);
pub const char *io_header_for(const char *name);
pub int word_is(const char *s, const char *w);

/* `c-boundary = allow|strict` in `<dir>/ct.pkg`; -1 when the file or the key is
   absent. v1-PH-2 S9: a missing key is strict (the old allow window for
   packages published before PH-65 is gone; `ct migrate` writes the key). */
int c_manifest_boundary(const char *dir)
{
    char *p;
    char line[512];
    FILE *f;
    int r = -1;

    if (dir == 0 || dir[0] == 0) return -1;
    p = tool::sh::ct_scratch_fmt("%s/ct.pkg", dir);
    f = fopen(p, "r");
    if (!f) return -1;
    while (fgets(line, sizeof line, f)) {
        char *k = line, *eq, *v;
        int n;

        while (*k == ' ' || *k == '\t') k++;
        if (*k == '#' || *k == 0 || *k == '\n') continue;
        eq = strchr(k, '=');
        if (!eq) continue;
        *eq = 0;
        v = eq + 1;
        while (*v == ' ' || *v == '\t') v++;
        n = (int)strlen(v);
        while (n > 0 && (v[n - 1] == ' ' || v[n - 1] == '\t'
                         || v[n - 1] == '\n' || v[n - 1] == '\r')) v[--n] = 0;
        n = (int)strlen(k);
        while (n > 0 && (k[n - 1] == ' ' || k[n - 1] == '\t')) k[--n] = 0;
        if (strcmp(k, "c-boundary") == 0) {
            if (strcmp(v, "allow") == 0) r = 0;
            else if (strcmp(v, "strict") == 0) r = 1;
        }
    }
    fclose(f);
    return r;
}

/* Append one `--cflags` / `--ldflags` value, growing the accumulator on
   demand (S1a-0 C2g). `init` is the old fixed cap; the first append allocates
   it, later appends double to TEXT_LIMIT. flags are pass-through, never
   re-quoted. */
int ct_append_flags(char **buf, int *cap, int init, const char *val)
{
    if (!val || !val[0]) return 0;
    if (*buf == 0 && tool::sh::ct_text_init(buf, cap, init) != 0) return -1;
    if ((*buf)[0] != 0 && tool::sh::ct_text_cat(buf, cap, " ") != 0) return -1;
    return tool::sh::ct_text_cat(buf, cap, val);
}

/* A verbatim fragment: user flags are pass-through, never re-quoted. S1a-0
   C2f: the cc line is `char **` + capacity text owned by the caller, so a
   fragment past the old 8192 bytes grows the buffer instead of failing. */
int ct_cmd_raw(char **cmd, int *cap, const char *frag)
{
    if (!frag || !frag[0]) return 0;
    if (*cmd != 0 && (*cmd)[0] != 0
        && tool::sh::ct_text_cat(cmd, cap, " ") != 0)
        return -1;
    return tool::sh::ct_text_cat(cmd, cap, frag);
}

/* One shell-quoted token on the growing cc line. The quoted form is appended
   in place; no stack copy is sized by MAX_PATH any more. */
int ct_cmd_token(char **cmd, int *cap, const char *tok)
{
    if (*cmd != 0 && (*cmd)[0] != 0
        && tool::sh::ct_text_cat(cmd, cap, " ") != 0)
        return -1;
    return tool::sh::ct_text_quote(cmd, cap, tok);
}

/* The intermediate directory in the default form: created on demand, so a
   fresh checkout needs no `mkdir` before the first `ct build`. */
int ct_ensure_dir(const char *path)
{
    struct stat st;

    if (stat(path, &st) == 0) return S_ISDIR(st.st_mode) ? 0 : -1;
    return mkdir(path, 0755) == 0 ? 0 : -1;
}

/* Normalize a path so two spellings of one directory compare equal: `-I x` vs
   `-I ./x`, `a/../b`, or a symlinked root. `realpath` needs the path to exist,
   which import roots and resolved units do; when it fails we keep the spelling
   we were given rather than inventing one. */
int ct_norm_path(const char *in, char **out)
{
    char buf[4096];

    if (realpath(in, buf)) *out = tool::sh::ct_scratch_dup(buf);
    else *out = tool::sh::ct_scratch_dup(in);
    return 0;
}

/* One manifest key of the package rooted at `root`. `tool/pkg` owns the real
   parser, but that layer sits above the frontend and the module resolver must
   not depend on it (a build never reads a vendor manifest); only `namespace`
   and `name` matter here. Returns 1 when the key carries a value, 0 for a
   missing manifest, a missing key, or an empty value. */
int ct_pkg_key(const char *root, const char *key, const char **out)
{
    char *path;
    char *buf;
    FILE *f;
    long sz;
    size_t kl, got;
    int found;

    *out = "";
    path = tool::sh::ct_scratch_fmt("%s/ct.pkg", root);
    f = fopen(path, "rb");
    if (!f) return 0;
    /* S1a-0 C2p-11: read the manifest at its own size. A namespace / name is
       user text, so a fixed row would cut a 2000-byte value before the module
       resolver compares it. */
    if (fseek(f, 0, SEEK_END) != 0 || (sz = ftell(f)) < 0 || sz >= 65536) {
        fclose(f);
        return 0;
    }
    rewind(f);
    buf = tool::sh::ct_scratch_alloc(((int)sz) + 1);
    got = fread(buf, 1, (size_t)sz, f);
    buf[got] = 0;
    fclose(f);
    kl = strlen(key);
    found = 0;
    {
        char *line = buf;
        while (*line) {
            char *end = strchr(line, '\n');
            char *p;
            char *v;
            if (end) *end = 0;
            p = line;
            while (*p == ' ' || *p == '\t') p++;
            if (strncmp(p, key, kl) == 0) {
                p += kl;
                while (*p == ' ' || *p == '\t') p++;
                if (*p == '=') {
                    p++;
                    while (*p == ' ' || *p == '\t') p++;
                    v = p;
                    while (*p && *p != '\r' && *p != ' ' && *p != '\t' && *p != '#') p++;
                    *p = 0;
                    if (v[0]) {
                        *out = runtime::text::ct_intern(v);
                        found = 1;
                    }
                    break;
                }
            }
            if (!end) break;
            line = end + 1;
        }
    }
    return found;
}

/* The relative paths one root offers for `rel`. A package that declares
   `namespace = app` owns the first import segment, so `app::model::Item` names
   `model/Item` under that root; the doubled layout the old convention forced
   stays as the compatibility fallback. Returns the candidate count. */
int ct_rel_cands(const char *root, const char *rel, char **first, char **fallback)
{
    const char *ns;
    size_t nl;

    *first = tool::sh::ct_scratch_dup(rel);
    *fallback = (char *)0;
    if (!ct_pkg_key(root, "namespace", &ns)) return 1;
    nl = strlen(ns);
    if (nl == 0 || strncmp(rel, ns, nl) != 0 || rel[nl] != '/' || rel[nl + 1] == 0)
        return 1;
    *first = tool::sh::ct_scratch_dup(rel + nl + 1);
    *fallback = tool::sh::ct_scratch_dup(rel);
    return 2;
}

/* Resolve `rel` under one root: 1 found, 0 absent, -1 ambiguous or too long
   (`err` carries the message). Both importable suffixes in one root are an
   ambiguity, exactly as before; the namespace candidates are tried in order,
   but a hit in the flat and the doubled layout at once is also an ambiguity
   (M6) -- picking the first silently would hide a second definition. */
int ct_root_find(const char *root, const char *rel, char **out,
                 int *is_hdr, int *is_map, char **err)
{
    char *flat;
    char *doubled;
    char *hdr;
    char *map;
    char *first_hit = (char *)0;
    int first_hdr, first_map;
    int nc, ci, has_h, has_m, nhit;
    FILE *f;

    *out = (char *)0;
    *err = (char *)0;
    *is_hdr = 0;
    *is_map = 0;
    first_hdr = 0;
    first_map = 0;
    nhit = 0;
    nc = ct_rel_cands(root, rel, &flat, &doubled);
    for (ci = 0; ci < nc; ci++) {
        const char *c;
        if (ci == 0) c = flat;
        else c = doubled;
        hdr = tool::sh::ct_scratch_fmt("%s/%s.h.ct", root, c);
        map = tool::sh::ct_scratch_fmt("%s/%s.m.ct", root, c);
        f = fopen(hdr, "rb");
        has_h = (f != NULL);
        if (f) fclose(f);
        f = fopen(map, "rb");
        has_m = (f != NULL);
        if (f) fclose(f);
        if (has_h && has_m) {
            *err = tool::sh::ct_scratch_fmt(
                "import '%s' is ambiguous: both %s and %s exist", rel, hdr, map);
            return -1;
        }
        if (!has_h && !has_m) continue;
        if (nhit > 0) {
            *err = tool::sh::ct_scratch_fmt(
                "import '%s' is ambiguous: both %s and %s exist",
                rel, first_hit, has_h ? hdr : map);
            return -1;
        }
        first_hit = tool::sh::ct_scratch_dup(has_h ? hdr : map);
        first_hdr = has_h;
        first_map = has_m;
        nhit = 1;
    }
    if (nhit == 1) {
        *is_hdr = first_hdr;
        *is_map = first_map;
        *out = first_hit;
        return 1;
    }
    return 0;
}

/* Does `s` carry `w` as a whole identifier? `struct Str` yes, `struct
   Struct` no. */
int has_word(const char *s, const char *w)
{
    size_t wn = strlen(w);
    const char *p = s;

    while (*p) {
        const char *q;
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) {
            p++;
            continue;
        }
        q = p;
        while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
               || (*q >= '0' && *q <= '9') || *q == '_') q++;
        if ((size_t)(q - p) == wn && strncmp(p, w, wn) == 0) return 1;
        p = q;
    }
    return 0;
}

/* PH-66 R1: the libc I/O set and the header each name needs (D-008 §1/§2).
   Membership is by exact name -- no prefix matching -- and only a direct call
   reaches this table (the call list is built by the expression parser). */
const char *io_header_for(const char *name)
{
    static const char *const stdio_fns[13] = {
        "printf", "fprintf", "sprintf", "snprintf",
        "scanf", "fscanf", "sscanf",
        "puts", "putchar", "fputs", "fputc", "fflush", "perror",
    };
    static const char *const wchar_fns[6] = {
        "wprintf", "fwprintf", "swprintf", "wscanf", "fwscanf", "swscanf",
    };
    int i;

    for (i = 0; i < 13; i++)
        if (strcmp(name, stdio_fns[i]) == 0) return "stdio.h";
    for (i = 0; i < 6; i++)
        if (strcmp(name, wchar_fns[i]) == 0) return "wchar.h";
    return 0;
}

/* A whole-identifier match: `Str` counts, `Struct` / `String` / `Strlen` do
   not (battle hw-2 J-2). */
int word_is(const char *s, const char *w)
{
    size_t n = strlen(w);
    if (strncmp(s, w, n) != 0) return 0;
    if (s[n] != 0) return 0;
    return 1;
}
