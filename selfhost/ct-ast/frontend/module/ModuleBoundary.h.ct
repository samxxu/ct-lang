/*
 * ModuleBoundary.h.ct - moved out of Module.h.ct (PH-85 S85c M0, pure move).
 *
 * Bodies are byte-identical to the ones this unit used to hold;
 * the declaration line only loses `static` and gains a `pub`
 * prototype, the interface change the M0 card allows. See
 * docs/design/p85_m0.md for the baseline and the old->new map.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

import backend::emit::Emitter;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Unit;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import tool::cache::Cache;
import tool::diag::Diag;
import tool::sh::Sh;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160
#define MAX_PATH   1024

namespace frontend::module;
/* `realpath` is POSIX/XSI; glibc and musl hide its declaration under
   `-std=c99`, so the explicit prototype keeps every host warning-free. It
   moved here with `ct_norm_path` (macOS exposes it by default; the Linux
   musl cross build does not, which is how the missing declaration showed). */
extern char *realpath(const char *path, char *resolved);

/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ModuleBoundary {
    int unused;
}

pub int c_has_manifest(const char *dir);
pub int c_manifest_boundary(const char *dir);
pub int c_path_is_core(const char *path);
pub int ct_append_flags(char *buf, int cap, const char *val);
pub int ct_cmd_raw(char **cmd, int *cap, const char *frag);
pub int ct_cmd_token(char **cmd, int *cap, const char *tok);
pub int ct_ensure_dir(const char *path);
pub void ct_norm_path(const char *in, char *out, int cap);
pub int ct_pkg_key(const char *root, const char *key, char *out, int cap);
pub int ct_rel_cands(const char *root, const char *rel, char *first, char *fallback);
pub int ct_root_find(const char *root, const char *rel, char *out, int cap, int *is_hdr, int *is_map, char *err, int errcap);
pub int has_word(const char *s, const char *w);
pub const char *io_header_for(const char *name);
pub int word_is(const char *s, const char *w);

/* `c-boundary = allow|strict` in `<dir>/ct.pkg`; -1 when the file or the key is
   absent, which keeps the allow window for packages published before PH-65
   (D65-7). */
int c_has_manifest(const char *dir)
{
    char p[1024];
    FILE *f;

    if (dir == 0 || dir[0] == 0) return 0;
    snprintf(p, sizeof p, "%s/ct.pkg", dir);
    f = fopen(p, "r");
    if (!f) return 0;
    fclose(f);
    return 1;
}

int c_manifest_boundary(const char *dir)
{
    char p[1024], line[512];
    FILE *f;
    int r = -1;

    if (dir == 0 || dir[0] == 0) return -1;
    snprintf(p, sizeof p, "%s/ct.pkg", dir);
    f = fopen(p, "r");
    if (!f) return -1;
    while (fgets(line, sizeof line, f)) {
        char *k = line, *eq, *v;
        int n;

        while (*k == ' ' || *k == '\t') k++;
        if (*k == '#' || *k == 0 || *k == '\n') continue;
        eq = strchr(k, '=');
        if (!eq) continue;
        *eq = 0;
        v = eq + 1;
        while (*v == ' ' || *v == '\t') v++;
        n = (int)strlen(v);
        while (n > 0 && (v[n - 1] == ' ' || v[n - 1] == '\t'
                         || v[n - 1] == '\n' || v[n - 1] == '\r')) v[--n] = 0;
        n = (int)strlen(k);
        while (n > 0 && (k[n - 1] == ' ' || k[n - 1] == '\t')) k[--n] = 0;
        if (strcmp(k, "c-boundary") == 0) {
            if (strcmp(v, "allow") == 0) r = 0;
            else if (strcmp(v, "strict") == 0) r = 1;
        }
    }
    fclose(f);
    return r;
}

/* PH-65 R1: the CT tree keeps the pre-1.0 behaviour; every in-repo include
   lives in one of these four directories. An absolute path or a `..` escape is
   not "inside" the tree. The policy is decided by the input path alone: SH-93
   removed the old "cwd is the CT tree => allow" shortcut, which let a run from
   the repo root silently relax an external unit (spec §4.66 lists only these
   four directories, not a cwd rule). */
int c_path_is_core(const char *path)
{
    static const char *const core[5] = { "selfhost/", "lib/core/", "lib/std/", "test/", "examples/" }; /* DOC-87 迁移回退 */
    char cwd[1024];
    const char *p = path;
    size_t n;
    int i;

    if (path == 0 || path[0] == 0) return 0;
    /* A build invoked from the repo root may hand us absolute unit paths
       (`$PWD/lib/core/Vec.h.ct`); strip the cwd before matching. */
    if (path[0] == '/' && getcwd(cwd, sizeof cwd) != 0) {
        n = strlen(cwd);
        if (strncmp(path, cwd, n) == 0 && path[n] == '/') p = path + n + 1;
    }
    if (p[0] == '/' || (p[0] == '.' && p[1] == '.')) return 0;
    for (i = 0; i < 5; i++)
        if (strncmp(p, core[i], strlen(core[i])) == 0) return 1;
    return 0;
}

int ct_append_flags(char *buf, int cap, const char *val)
{
    int n, w;

    n = (int)strlen(buf);
    if (!val[0]) return 0;
    if (n + 1 >= cap) return -1;
    w = snprintf(buf + n, (size_t)(cap - n), "%s%s", n ? " " : "", val);
    if (w < 0 || n + w >= cap) return -1;
    return 0;
}

/* A verbatim fragment: user flags are pass-through, never re-quoted. S1a-0
   C2f: the cc line is `char **` + capacity text owned by the caller, so a
   fragment past the old 8192 bytes grows the buffer instead of failing. */
int ct_cmd_raw(char **cmd, int *cap, const char *frag)
{
    if (!frag || !frag[0]) return 0;
    if (*cmd != 0 && (*cmd)[0] != 0
        && tool::sh::ct_text_cat(cmd, cap, " ") != 0)
        return -1;
    return tool::sh::ct_text_cat(cmd, cap, frag);
}

/* One shell-quoted token on the growing cc line. The quoted form is appended
   in place; no stack copy is sized by MAX_PATH any more. */
int ct_cmd_token(char **cmd, int *cap, const char *tok)
{
    if (*cmd != 0 && (*cmd)[0] != 0
        && tool::sh::ct_text_cat(cmd, cap, " ") != 0)
        return -1;
    return tool::sh::ct_text_quote(cmd, cap, tok);
}

/* The intermediate directory in the default form: created on demand, so a
   fresh checkout needs no `mkdir` before the first `ct build`. */
int ct_ensure_dir(const char *path)
{
    struct stat st;

    if (stat(path, &st) == 0) return S_ISDIR(st.st_mode) ? 0 : -1;
    return mkdir(path, 0755) == 0 ? 0 : -1;
}

/* Normalize a path so two spellings of one directory compare equal: `-I x` vs
   `-I ./x`, `a/../b`, or a symlinked root. `realpath` needs the path to exist,
   which import roots and resolved units do; when it fails we keep the spelling
   we were given rather than inventing one. */
void ct_norm_path(const char *in, char *out, int cap)
{
    char buf[MAX_PATH];

    if (realpath(in, buf)) snprintf(out, (size_t)cap, "%s", buf);
    else snprintf(out, (size_t)cap, "%s", in);
}

/* One manifest key of the package rooted at `root`. `tool/pkg` owns the real
   parser, but that layer sits above the frontend and the module resolver must
   not depend on it (a build never reads a vendor manifest); only `namespace`
   and `name` matter here. Returns 1 when the key carries a value, 0 for a
   missing manifest, a missing key, or an empty value. */
int ct_pkg_key(const char *root, const char *key, char *out, int cap)
{
    char path[MAX_PATH];
    char line[320];
    FILE *f;
    size_t kl;
    int found;

    out[0] = 0;
    if (snprintf(path, sizeof path, "%s/ct.pkg", root) >= (int)sizeof path) return 0;
    f = fopen(path, "rb");
    if (!f) return 0;
    kl = strlen(key);
    found = 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *p;
        char *v;
        p = line;
        while (*p == ' ' || *p == '\t') p++;
        if (strncmp(p, key, kl) != 0) continue;
        p += kl;
        while (*p == ' ' || *p == '\t') p++;
        if (*p != '=') continue;
        p++;
        while (*p == ' ' || *p == '\t') p++;
        v = p;
        while (*p && *p != '\n' && *p != '\r' && *p != ' '
               && *p != '\t' && *p != '#') p++;
        *p = 0;
        if (v[0]) {
            snprintf(out, (size_t)cap, "%s", v);
            found = 1;
        }
        break;
    }
    fclose(f);
    return found;
}

/* The relative paths one root offers for `rel`. A package that declares
   `namespace = app` owns the first import segment, so `app::model::Item` names
   `model/Item` under that root; the doubled layout the old convention forced
   stays as the compatibility fallback. Returns the candidate count. */
int ct_rel_cands(const char *root, const char *rel, char *first, char *fallback)
{
    char ns[MAX_TEXT];
    size_t nl;

    snprintf(first, MAX_TEXT, "%s", rel);
    if (!ct_pkg_key(root, "namespace", ns, sizeof ns)) return 1;
    nl = strlen(ns);
    if (nl == 0 || strncmp(rel, ns, nl) != 0 || rel[nl] != '/' || rel[nl + 1] == 0)
        return 1;
    snprintf(first, MAX_TEXT, "%s", rel + nl + 1);
    snprintf(fallback, MAX_TEXT, "%s", rel);
    return 2;
}

/* Resolve `rel` under one root: 1 found, 0 absent, -1 ambiguous or too long
   (`err` carries the message). Both importable suffixes in one root are an
   ambiguity, exactly as before; the namespace candidates are tried in order,
   but a hit in the flat and the doubled layout at once is also an ambiguity
   (M6) -- picking the first silently would hide a second definition. */
int ct_root_find(const char *root, const char *rel, char *out, int cap,
                        int *is_hdr, int *is_map, char *err, int errcap)
{
    char flat[MAX_TEXT];
    char doubled[MAX_TEXT];
    char hdr[MAX_PATH];
    char map[MAX_PATH];
    char first_hit[MAX_PATH];
    int first_hdr, first_map;
    int nc, ci, has_h, has_m, nhit;
    FILE *f;

    *is_hdr = 0;
    *is_map = 0;
    first_hdr = 0;
    first_map = 0;
    nhit = 0;
    nc = ct_rel_cands(root, rel, flat, doubled);
    for (ci = 0; ci < nc; ci++) {
        const char *c;
        if (ci == 0) c = flat;
        else c = doubled;
        if (snprintf(hdr, sizeof hdr, "%s/%s.h.ct", root, c) >= (int)sizeof hdr
            || snprintf(map, sizeof map, "%s/%s.m.ct", root, c) >= (int)sizeof map) {
            snprintf(err, (size_t)errcap, "import path is too long");
            return -1;
        }
        f = fopen(hdr, "rb");
        has_h = (f != NULL);
        if (f) fclose(f);
        f = fopen(map, "rb");
        has_m = (f != NULL);
        if (f) fclose(f);
        if (has_h && has_m) {
            snprintf(err, (size_t)errcap,
                     "import '%s' is ambiguous: both %s and %s exist", rel, hdr, map);
            return -1;
        }
        if (!has_h && !has_m) continue;
        if (nhit > 0) {
            snprintf(err, (size_t)errcap,
                     "import '%s' is ambiguous: both %s and %s exist",
                     rel, first_hit, has_h ? hdr : map);
            return -1;
        }
        snprintf(first_hit, sizeof first_hit, "%s", has_h ? hdr : map);
        first_hdr = has_h;
        first_map = has_m;
        nhit = 1;
    }
    if (nhit == 1) {
        *is_hdr = first_hdr;
        *is_map = first_map;
        if (snprintf(out, (size_t)cap, "%s", first_hit) >= cap) {
            snprintf(err, (size_t)errcap, "import path is too long");
            return -1;
        }
        return 1;
    }
    return 0;
}

/* Does `s` carry `w` as a whole identifier? `struct Str` yes, `struct
   Struct` no. */
int has_word(const char *s, const char *w)
{
    size_t wn = strlen(w);
    const char *p = s;

    while (*p) {
        const char *q;
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) {
            p++;
            continue;
        }
        q = p;
        while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
               || (*q >= '0' && *q <= '9') || *q == '_') q++;
        if ((size_t)(q - p) == wn && strncmp(p, w, wn) == 0) return 1;
        p = q;
    }
    return 0;
}

/* PH-66 R1: the libc I/O set and the header each name needs (D-008 §1/§2).
   Membership is by exact name -- no prefix matching -- and only a direct call
   reaches this table (the call list is built by the expression parser). */
const char *io_header_for(const char *name)
{
    static const char *const stdio_fns[13] = {
        "printf", "fprintf", "sprintf", "snprintf",
        "scanf", "fscanf", "sscanf",
        "puts", "putchar", "fputs", "fputc", "fflush", "perror",
    };
    static const char *const wchar_fns[6] = {
        "wprintf", "fwprintf", "swprintf", "wscanf", "fwscanf", "swscanf",
    };
    int i;

    for (i = 0; i < 13; i++)
        if (strcmp(name, stdio_fns[i]) == 0) return "stdio.h";
    for (i = 0; i < 6; i++)
        if (strcmp(name, wchar_fns[i]) == 0) return "wchar.h";
    return 0;
}

/* A whole-identifier match: `Str` counts, `Struct` / `String` / `Strlen` do
   not (battle hw-2 J-2). */
int word_is(const char *s, const char *w)
{
    size_t n = strlen(w);
    if (strncmp(s, w, n) != 0) return 0;
    if (s[n] != 0) return 0;
    return 1;
}
