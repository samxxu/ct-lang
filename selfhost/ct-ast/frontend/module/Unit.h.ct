/*
 * Unit.h.ct - one translation unit of a `build`, as a value type.
 *
 * A unit is plain data shared by the module layer (which fills it), the cache
 * (which folds its dependencies into a key) and the emitter (which reads the
 * ranges). It lives in its own unit so those three can name it without going
 * through the driver object; the array lengths are literals because a `pub
 * struct` lands in a header that carries no macros (1024 = MAX_PATH, 160 =
 * MAX_TEXT and 32 = MAX_IMPORTS of the module layer).
 */
namespace frontend::module;
pub struct Unit {
    char path[1024];
    char base[160];
    char ns[160];
    char nsprefix[160];         /* `ns` in mangled form (`a_b_`), for globals */
    char dep[32][160];
    int  depu[32];              /* the dependency's unit index (cache folding) */
    int  ndep;
    int  prog;
    int  is_hdr;
    int  fn_start;
    int  fn_end;
    int  tr_start;
    int  tr_end;
    int  call_start;
    int  call_end;
    unsigned long digest;       /* this unit's key digest (10.5) */
}
