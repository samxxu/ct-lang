/*
 * Unit.h.ct - one translation unit of a `build`, as a value type.
 *
 * A unit is plain data shared by the module layer (which fills it), the cache
 * (which folds its dependencies into a key) and the emitter (which reads the
 * ranges). It lives in its own unit so those three can name it without going
 * through the driver object; the array lengths are literals because a `pub
 * struct` lands in a header that carries no macros (160 = MAX_TEXT and 32 =
 * MAX_IMPORTS of the module layer). S1a-0 C2l: `path` and the three shim
 * paths are owned blocks (`ct_scratch_*` from tool/sh), not `char[1024]`, so
 * a unit path is never cut at the old MAX_PATH. They are released with the
 * run's scratch pool, after every consumer has finished.
 */
namespace frontend::module;
pub struct Unit {
    char *path;                 /* owned by the run's scratch pool */
    char base[160];
    char ns[160];
    char nsprefix[160];         /* `ns` in mangled form (`a_b_`), for globals */
    /* S1a-0 C1: the dependency rows grow on demand (old cap 32). `dep` is a
       flat block, one 160-byte row per import, because a pub struct lands in a
       header that carries no macros and a pointer-to-array declarator is not
       part of the dialect; `depu` is the parallel index table. */
    char *dep;
    int  *depu;                 /* the dependency's unit index (cache folding) */
    int  ndep;
    int  depcap;
    int  prog;
    int  is_hdr;                /* a `.h.ct` unit: publishes a header, importable */
    int  is_map;                /* a `.m.ct` unit: a compile-time mapping, no output */
    int  has_shim;              /* a `.m.ct` unit with a sibling C shim (batch 39) */
    char *shim_dir;             /* directory of the shim (an include root) */
    char *shim_h;               /* `<base>.shim.h`; null when absent */
    char *shim_c;               /* `<base>.shim.c`; null when absent */
    int  fn_start;
    int  fn_end;
    int  tr_start;
    int  tr_end;
    int  call_start;
    int  call_end;
    unsigned long digest;       /* this unit's key digest (10.5) */
}
