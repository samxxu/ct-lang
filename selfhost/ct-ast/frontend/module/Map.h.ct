/*
 * Map.h.ct - the `map` construct's records and the call graph edge.
 *
 * These are plain value types of the module layer: the parser fills them, the
 * type checker reads the map table while boxing, and the emitter writes the
 * wrappers and the JSON map. Keeping them beside Unit means each consumer names
 * them through the module namespace instead of through the driver object.
 *
 * Macros do not cross a unit boundary, so the caps are declared here; MAX_TEXT
 * 160, MAX_PARAMS 16 and MAX_METHODS 64 are the values
 * `frontend/sym/Symbols.h.ct` lists. The array lengths are literals because a
 * `pub struct` lands in a header with no macros.
 */
namespace frontend::module;
/* One `callee(...)` in a function body, for the map's call graph. */
pub struct Call {
    char caller[160];
    char callee[160];
    int  line;
}

/* One `method(params) -> call` inside a `map` block (Phase 11.1). */
pub struct MapBind {
    char method[160];               /* trait method name */
    char params[16][160];           /* CT-side parameter names, from the map's () */
    int  nparams;
    int  ti;                        /* index into the trait table */
    int  mi;                        /* index into that trait's m[] */
    char call[160];                 /* raw, validated RHS text (no trailing ';') */
    char wrapper[160];              /* "<inst>_<Trait>_<method>" (empty when static) */
    int  direct;                    /* 1 when `-> f` binds the C function itself */
    int  recv;                      /* 1 when the first parameter is a type-host receiver */
    int  uses[16];                  /* evaluation occurrences of each parameter in the recipe */
    int  sizeofs[16];               /* `sizeof p` occurrences (not evaluated) */
    int  variadic;                  /* 1 when the binding list ends in `...` (static only) */
    int  line;
}

/* `map trait T for instance x { ... }` binds trait methods to a global instance;
   `map trait T for namespace ns { ... }` binds them to a namespace (SH-20). */
pub struct Map {
    char trait[160];
    char inst[160];                 /* the variable's source name, or the namespace path */
    char cname[160];                /* the variable's C spelling, or the namespace prefix */
    char prefix[160];               /* what wrappers and the vtable are named after */
    char vtable[160];               /* "<prefix>_vtable" */
    int  ns_host;                   /* 1 when the host is a namespace, not an object */
    int  is_static;                 /* declared in a `.m.ct` unit: no wrapper, no vtable */
    int  type_host;                 /* 1 when the host is a C type (`for type`) */
    char host_type[160];            /* the type host's receiver spelling */
    struct MapBind b[64];
    int  nb;
    int  line;
    int  unit;                      /* the unit that declared this map */
    char path[160];                 /* that unit's source path, for duplicates */
}
