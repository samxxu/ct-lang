/*
 * Map.h.ct - the `map` construct's records and the call graph edge.
 *
 * These are plain value types of the module layer: the parser fills them, the
 * type checker reads the map table while boxing, and the emitter writes the
 * wrappers and the JSON map. Keeping them beside Unit means each consumer names
 * them through the module namespace instead of through the driver object.
 *
 * S1a-0 C1: the per-map binding block and each binding's parameter arrays are
 * heap blocks that grow on demand (`MAX_METHODS`, `MAX_PARAMS` and `MAX_TEXT`
 * are still their initial sizes), so this header carries no fixed-length rows:
 * a `pub struct` lands in a header with no macros and could not name a cap.
 */
namespace frontend::module;
/* One `callee(...)` in a function body, for the map's call graph. */
pub struct Call {
    const char *caller;
    const char *callee;
    int  line;
}

/* One `method(params) -> call` inside a `map` block (Phase 11.1). */
pub struct MapBind {
    const char *method;             /* trait method name */
    char **params;                  /* CT-side parameter names, from the map's (); row stride MAX_TEXT */
    int  pcap;                      /* rows allocated for params/uses/sizeofs */
    int  nparams;
    int  ti;                        /* index into the trait table */
    int  mi;                        /* index into that trait's m[] */
    const char *call;               /* raw, validated RHS text (no trailing ';') */
    const char *wrapper;            /* "<inst>_<Trait>_<method>" (empty when static) */
    int  direct;                    /* 1 when `-> f` binds the C function itself */
    int  recv;                      /* 1 when the first parameter is a type-host receiver */
    int *uses;                      /* evaluation occurrences of each parameter in the recipe */
    int *sizeofs;                   /* `sizeof p` occurrences (not evaluated) */
    int  variadic;                  /* 1 when the binding list ends in `...` (static only) */
    int  line;
}

/* `map trait T for instance x { ... }` binds trait methods to a global instance;
   `map trait T for namespace ns { ... }` binds them to a namespace (SH-20). */
pub struct MapTable {
    const char *trait;
    const char *inst;               /* the variable's source name, or the namespace path */
    const char *cname;              /* the variable's C spelling, or the namespace prefix */
    const char *prefix;             /* what wrappers and the vtable are named after */
    const char *vtable;             /* "<prefix>_vtable" */
    int  ns_host;                   /* 1 when the host is a namespace, not an object */
    int  is_static;                 /* declared in a `.m.ct` unit: no wrapper, no vtable */
    int  type_host;                 /* 1 when the host is a C type (`for type`) */
    const char *host_type;          /* the type host's receiver spelling */
    /* LANG-29 S4 / B4: a compile-time `map binding <Source> -> <Target>` entry.
       It sits in the same table so import reachability (`map_visible`) is shared;
       it has no trait, no wrapper and no vtable. `bind_dst` is the target type. */
    int  is_binding;
    const char *bind_dst;
    struct MapBind *b;              /* the binding block (initial MAX_METHODS rows) */
    int  bcap;                      /* rows allocated for b */
    int  nb;
    int  line;
    int  unit;                      /* the unit that declared this map */
    const char *path;               /* that unit's source path, for duplicates */
}
