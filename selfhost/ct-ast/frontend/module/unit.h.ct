/*
 * unit.h.ct - one translation unit of a `build`, as a value type.
 *
 * A unit is plain data shared by the module layer (which fills it), the cache
 * (which folds its dependencies into a key) and the emitter (which reads the
 * ranges). It lives in its own unit so those three can name it without going
 * through the driver object; the caps it needs are restated here because macros
 * do not cross a unit boundary and a `pub struct` lands in a header that carries
 * none. They must stay equal to MAX_PATH 1024, MAX_TEXT 160 and MAX_IMPORTS 16.
 */
namespace frontend::module {
pub struct Unit {
    char path[1024];
    char base[160];
    char ns[160];
    char dep[16][160];
    int  depu[16];              /* the dependency's unit index (cache folding) */
    int  ndep;
    int  prog;
    int  is_hdr;
    int  fn_start;
    int  fn_end;
    int  tr_start;
    int  tr_end;
    int  call_start;
    int  call_end;
    unsigned long digest;       /* this unit's key digest (10.5) */
}
}
