/*
 * Parser.h.ct - the parser: statements, declarations and the translation-unit
 * level (top-level declarations, namespaces, `map`). The expression chain and
 * the type grammar live on a sub-object (Expr.h.ct) reached through
 * `expr_get`.
 *
 * The node pool, the symbol tables, the type layer and the memory pass are
 * reached through collaborator pointers; everything that is not parsing lives
 * on `ParseSupport` (ParseSupport.h.ct) or in the driver
 * (tool/driver/Driver.h.ct). The driver only ever calls the pub primitives below,
 * so `main.ct` keeps nothing but the wiring and the dispatch.
 *
 * Macros do not cross a unit boundary, so the caps, node kinds, token kinds and
 * operator codes used here are declared here; the symbol caps are the values
 * `frontend/sym/Symbols.h.ct` lists and MAX_IMPORTS the one
 * `frontend/module/Module.h.ct` spells.
 */
#include "Parser.shim.h"
import frontend::sym::SymbolsTypeText;

import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable;
import frontend::parse::Expr;
import frontend::parse::MapBuild;
import frontend::parse::Mem2Writes;
import frontend::parse::ParseSupport;
import frontend::parse::Stmt;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::Field as Field;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import tool::diag::Diag;
import tool::sh::Sh;
import tool::sh::Sh;
import frontend::sym::SymbolsTypeText;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_CALLS 8192
#define CAP_LIMIT 65536
#define MAX_FIELDS 64
#define MAX_IMPORTS 32
#define MAX_MAPS 64
#define MAX_METHODS 64
#define MAX_PARAMS 16
#define MAX_TEXT 160
/* S1a-0 C2: a raw block is stored in the growable literal pool, so the old
   fixed MAX_RAW_BLOCK 32768 is gone; only the formal text bound remains. */
#define TEXT_LIMIT 65536
#define MAX_TRAITS 64
#define NO_NODE (-2)
/* only the node kinds this pass builds or reads; the numbers are the shared
   contract with the expression/statement sub-objects and the emitter */
/* Phase 78 S2a: the statement kinds the `out` definite-assignment walk reads.
   The numbers are the shared contract with Stmt.h.ct / Expr.h.ct. */
#define N_ASSIGN 13
#define N_BIN 11
#define N_BLOCK 4
#define N_BREAK 38
#define N_CASE 43
#define N_CONT 39
#define N_DECLS 40
#define N_DECL 12
#define N_DEFER_RUN 70
#define N_DOWHILE 44
#define N_EXPR 6
#define N_FOREACH 62
#define N_FOR 16
#define N_GOTO 50
#define N_IF 14
#define N_LABEL 49
#define N_LOOP 60
#define N_MATSEQ 73
#define N_RET 5
#define N_SWITCH 42
#define N_TERN 37
#define N_WHILE 15

#define N_ENUM 45
#define N_ENUMVAL 46
/* Phase 84: the ADT reader's temporary rows -- one member (`text` = name,
   `aux` = 1 when it carries a payload list, `a` = first field or the explicit
   value, `line`/`num` = member position, `d`/`c` = value position) and one
   payload field (`text` = type, `text2` = name). They never reach the emitter
   as AST nodes: the ADT registry keeps the layout. The numbers are the shared
   contract with the statement/expression/emitter units. */
#define N_ADTMEM 83
#define N_ADTFIELD 82
#define N_FIELD 23
#define N_FIELDS 56
#define N_FUNC 3
#define N_GLOBAL 22
#define N_IMPL 33
#define N_MCALL 30
#define N_METHOD 29
#define N_PARAM 19
#define N_PP 2
#define N_PROG 1
#define N_RAW 31
#define N_RAW_TEXT 58
#define N_STRUCT 20
#define N_TYPEDEF 21
#define N_UNION 48
#define N_VAR 10
#define N_MEMBER 24
#define N_ARROW 25
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PP 5
#define T_PUNCT 4
#define T_STR 3

namespace frontend::parse;
pub trait ParseOps {
    int  parse_program(void);
    int  parse_func(int is_static, int is_pub, int is_extern);
    int  parse_params(void);
    /* Phase 78 S2a: the L1 definite-assignment walk for `out` parameters. */
    int  out_index(const char *nm);
    int  out_report(int mask, int line);
    int  out_scan(int n, int *mask);
    int  out_scan_chain(int n, int *mask);
    int  out_check_body(int body, int params, int line);
    int  parse_record_def(int is_union);
    /* PH-82: does the source line carry the `ct: allow-cycle` marker? */
    int  record_line_allows_cycle(int line);
    int  parse_enum_def(int is_pub, int tag_required);
    int  parse_typedef(int is_pub);
    int  parse_field_def(void);
    int  parse_record_body(int node, int reg);
    int  parse_anon_member(void);
    int  record_body_ahead(void);
    int  register_field(int m);
    int  ensure_pend_fields(int need);
    int  parse_trait(int is_pub);
    int  parse_impl(int is_pub);
    /* Phase 29: `impl<T> Name<Args> [use Trait] { … }`, the template form.
       `have_name` is 0 when the caller already read the template name. */
    int  parse_impl_inst(const char *tmpl, int have_name);
    /* Phase 34 S4: `impl Name { … }` -- a non-generic inherent impl. The
       cursor sits on the `{`; `rname` is the struct's resolved name. */
    int  parse_impl_inherent(const char *rname, int si, int impl_line);
    int  parse_pat_arg(char *out, int cap, int base, int *l4line, int *l4col, int *deep, int *bad);
    int  parse_use_list(int sindex);
    /* L36-1 (S1b): walk a `drop` body and reject a second `release()` on the
       same `self` field. Syntax-level, no flow analysis. */
    int  drop_release_scan(int body);
    int  drop_release_walk(int n, char *seen, int *nseen);
}

/* The translation-unit passes: top-level declarations, namespaces, imports and
   `map`. They are members so the parser owns every stage; a trait of its own
   keeps ParseOps clear of the 32-method ceiling. The binding pointer rides in
   as `char *` and is cast in the body: a trait parameter list takes neither
   `void *` nor another unit's `struct` tag (the generated header has no
   #include, and naming the tag there trips -Wvisibility). */
pub trait ParseDeclOps {
    int  struct_def_ahead(void);
    int  type_alias_ahead(void);
    int  parse_type_alias(int is_pub);
    int  append_node(int prog, int n);
    /* S1a-0 C1: grow the import list to hold `need` rows (old cap 32). */
    int  ensure_rels(int need);
    int  skip_import(void);
    int  top_decl(int is_pub);
    int  parse_namespace(int prog);
}

pub struct Parser {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;   /* the tables the direct lookups read */
    struct Memory *mem;     /* the current unit's path for diagnostics */
    int *build_mode;                    /* points at the driver's flag */
    int *check_mode;                    /* likewise: `ct check` (single unit, SH-55) */
    /* Phase 32: the opt-in `--types` gate, set by the driver's `check` branch
       and handed to the expression object while a unit is parsed. It stays 0
       under `ct build` / `ct compile` and without the flag. */
    int  types_mode;
    /* The module tables the translation-unit passes fill: the import list the
       scanner and the parser share, and the call graph and `map` records the
       map JSON reports. The driver reads them back through this object.
       S1a-0 C1/C2o: the import list is a pointer row block that grows on
       demand; each row is a pool text, so neither the count nor a single
       import path is cut at the old row width. */
    const char **rels;
    int  nrels;
    int  relcap;
    /* These tables have element types from other units, and a generated header
       carries no `#include`, so their storage lives in this unit's `.c` and the
       object keeps a pointer (the arrangement `ct_emit_bind_tables` already
       uses for the same tables). */
    struct Call *calls;
    int  ncalls;
    int  callcap;
    /* S1a-0 C1: the map table is a heap block that grows on demand; the
       capacity is kept beside the count so the owner can grow it in place. */
    struct MapTable *maps;
    int  nmaps;
    int  mapcap;
    int  cur_unit;                      /* index of the unit being parsed */
    /* The namespace path the current unit declared and the caller recorded for
       the map; the driver re-reads both after a unit is parsed. */
    /* S1a-0 C2o: the namespace spelling and the current function name are pool
       texts, so a long namespace / function name is kept whole. Empty is "". */
    const char *ns_decl;
    const char *cur_func;
    /* Set while the unit being parsed is a `.m.ct` mapping unit: the content
       whitelist and the static-trait rules key off it. */
    int  unit_is_map;
    /* PH-65 R2: the C boundary policy for this unit (1 = strict) and the base
       name that may legitimately appear as `<base>.shim.h`. Set by the loader
       per unit; Parser must not reach back into Module. */
    int  c_strict;
    const char *c_base;          /* S1a-0 C2p-6: pool text, never a 160 row */
    /* Set while the unit being parsed is a `.h.ct` interface unit. A type
       alias may live in a `.h.ct` (a public signature may use it) but not in
       a plain `.ct`, which no unit can import. */
    int  unit_is_hdr;
    /* Set once the unit has consumed a declaration. `import` is a leading
       declaration; one seen after this point is reported instead of being
       parsed, because a reader cannot tell it apart from a dropped import. */
    int  seen_decl;
    /* The line of each import, recorded by `skip_import` so a `.m.ct` unit that
       imports a non-map unit is reported at the import line. */
    int *rel_line;
    /* The record whose body is being read. Its fields land in
       `structs[].fields[]`; when the body has no tag (`typedef struct { … }`),
       this stays empty and the fields land in `pend_fields` instead. An
       anonymous member promotes its own fields into this same table. */
    const char *cur_record;
    int  field_pub;
    int  field_col;
    /* Parse scratch the emitter reads through pointers (`ct_emit_bind_parse`). */
    int  nparams;
    /* Phase 78 S2a: the `out` parameter names of the function being checked,
       for the L1 definite-assignment walk. */
    const char *out_names[16];   /* S1a-0 C2p-6: pool texts, not 160 rows */
    int  nout;
    /* Set by `parse_params` when the list ends with `...`; the caller stores it
       on the symbol row (for the prototype) and on the function node. */
    int  variadic;
    /* A GNU `__attribute__((…))` written before the declaration specifiers is
       captured first and consumed by `parse_func` (`0` = none, else the pool
       offset plus one, so the zero-initialised singleton needs no setup). */
    int  pending_attr;
    struct Field *pend_fields;   /* storage owned by this unit (grown on demand) */
    int  npend;
    int  pendcap;
    struct ParseSupport *sup;
    struct Expr *ex;     /* the expression and type grammar */
    struct Stmt *st;     /* the statement layer */
    /* The pre-pass only collects the import list: the dependencies are not
       parsed yet, so nothing can be resolved into an alias. */
    int  scan_only;
    /* Phase 29: `pub` of the declaration `top_decl` is reading. A generic
       struct template registers itself with the build-wide registry before the
       caller sees the node, so it needs the flag here. */
    int  decl_pub;
    /* P-7.2: set when the unit uses a slice; `main` binds the emitter to this
       flag so the slice struct and helpers are emitted only for such a run. */
    int  slice_used;
} use ParseOps, ParseDeclOps;

/* The struct a `borrow`-able type points to, or -1 when the type is not a
   pointer to a struct this unit knows. A borrow is meaningless elsewhere: the
   later stage generates the exit call from that struct's name. */
static int borrow_struct_of(struct Parser *self, const char *type, int is_array)
{
    const char *t;
    size_t bl;

    if (is_array) return -1;
    bl = strlen(type);
    if (bl == 0 || type[bl - 1] != '*') return -1;
    while (bl > 0 && (type[bl - 1] == '*' || type[bl - 1] == ' ')) bl--;
    t = runtime::text::ct_intern_len(type, (int)bl);
    if (!t) return -1;
    if (strncmp(t, "struct ", 7) == 0) t += 7;
    return self->sym->find_struct(t);
}

/* S1a-0 C2p-10: the bare struct name behind a C spelling (leading blanks,
   `struct ` tag, trailing blanks/stars dropped). The generic-bound checks read
   one struct row out of a template argument, so a 2000-byte argument must not
   be cut before `find_struct`. */
static const char *struct_name_text(const char *spell)
{
    const char *p = spell;
    size_t n;

    while (*p == ' ') p++;
    n = strlen(p);
    while (n > 0 && (p[n - 1] == ' ' || p[n - 1] == '*')) n--;
    p = runtime::text::ct_intern_len(p, (int)n);
    if (!p) return (const char *)0;
    if (strncmp(p, "struct ", 7) == 0) p += 7;
    return p;
}

/* A `borrow` parameter annotation changes nothing in the generated C; it only
   records that the pointer is lent, which is what refuses `delete` on it and a
   store into a longer-lived variable (stage one). The N_PARAM node carries the
   name, the base type and the dims. */
static int check_borrow_param(struct Parser *self, int pnode, int line, int col)
{
    int si, vi;

    si = borrow_struct_of(self, self->arena->nodes[pnode].text,
                          self->arena->nodes[pnode].text3[0] != 0);
    if (si < 0)
        return tool::diag::ct_sem_error(line, col,
                               "'borrow' requires a struct pointer parameter", self->mem->path);
    vi = self->sym->find_var(self->arena->nodes[pnode].text2);
    if (vi >= 0) {
        self->sym->vars[vi].borrowed = 1;
        self->sym->vars[vi].is_param = 1;
        self->sym->vars[vi].own_line = line;
    }
    return 0;
}

/* Parse the `{ … }` of a trait method's default body. The adopting struct is
   unknown here, so `self` is bound to `void *`; the emitter expands the block
   once per struct, where `self` becomes `struct <S> *`. The parameter names
   ride on the N_PARAM chain the caller built. */
static int parse_trait_body(struct Parser *self, int ti, int mi, const char *ret)
{
    int p, body, pi;
    const char *save_trait;
    const char *save_ret;
    (void)self;

    if (self->sup->push_scope() != 0) return -1;
    pi = 0;
    for (p = self->sym->traits[ti].m[mi].pnode; p >= 0;
         p = self->arena->nodes[p].next, pi++) {
        /* The signature row is the authoritative annotation (it is what the
           vtable and the definition are emitted from); repair the N_PARAM node
           from it before the body's name references are tagged. */
        if (pi < self->sym->traits[ti].m[mi].nparams
            && (self->sym->traits[ti].m[mi].pann[pi] == 2
                || self->sym->traits[ti].m[mi].pann[pi] == 3))
            self->arena->nodes[p].aux = (char)self->sym->traits[ti].m[mi].pann[pi];
        if (!self->arena->nodes[p].text2[0]) continue;
        if (self->sup->declare_var(self->arena->nodes[p].text2, self->arena->nodes[p].text) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        {
            int vi = self->sym->find_var(self->arena->nodes[p].text2);
            if (vi >= 0) {
                self->sym->vars[vi].is_fnparam = 1;
                /* The default body is the only place a trait signature's
                   parameter becomes a variable, so the ref/out flags come from
                   the N_PARAM annotation copied into the body's scope here. */
                self->sym->vars[vi].ref_param = self->arena->nodes[p].aux == 2;
                self->sym->vars[vi].out_param = self->arena->nodes[p].aux == 3;
                self->sym->vars[vi].initialized = self->arena->nodes[p].aux == 3 ? 0 : 1;
            }
        }
        if (self->arena->nodes[p].text3[0]) {
            int vi = self->sym->find_var(self->arena->nodes[p].text2);
            if (vi >= 0) {
                self->sym->vars[vi].is_array = 1;
                self->sym->vars[vi].dims =
                    runtime::text::ct_intern(self->arena->nodes[p].text3);
                if (!self->sym->vars[vi].dims)
                    return self->sup->fail("out of memory");
            }
        }
        /* the annotation rides on the N_PARAM node (`aux`): the default body
           is the only place where that parameter becomes a variable. Only 1 is
           `borrow`; 2 / 3 are `ref` / `out` and add no borrow check. */
        if (self->arena->nodes[p].aux == 1
            && check_borrow_param(self, p, self->arena->nodes[p].line, 1) != 0) {
            self->sup->pop_scope();
            return -1;
        }
    }
    if (self->sup->declare_var("self", "void *") != 0) {
        self->sup->pop_scope();
        return -1;
    }
    save_trait = self->sym->trait_default;
    save_ret = self->sym->ret_type;
    self->sym->ret_type = ret;
    self->sym->trait_default = self->sym->traits[ti].name;
    self->mem->leak_active = 1;
    self->mem->leak_frame = self->sym->nscope + 1;
    self->mem->leak_impl = 1;
    self->st->func_begin();
    body = self->st->parse_block();
    self->mem->leak_active = 0;
    self->mem->leak_frame = -1;
    self->mem->leak_impl = 0;
    self->sym->ret_type = save_ret;
    self->sym->trait_default = save_trait;
    self->sup->pop_scope();
    if (body < 0) return -1;
    if (self->out_check_body(body, self->sym->traits[ti].m[mi].pnode,
                             self->sym->traits[ti].m[mi].line) != 0) return -1;
    if (self->st->func_end() != 0) return -1;
    self->sym->traits[ti].m[mi].body = body;
    return 0;
}

/* Record one edge per `self->m(...)` in a default body: a cycle among default
   bodies would recurse forever at run time (D-6). Only calls the parser tagged
   with this trait (`N_MCALL.text`) count, which is exactly the sibling set. */
static void trait_default_edges(struct Arena *arena, int n, struct Symbols *sym,
                                int ti, int from, char *edge, int stride)
{
    int mi;

    for (; n >= 0; n = arena->nodes[n].next) {
        if (arena->nodes[n].kind == N_MCALL
            && strcmp(arena->nodes[n].text, sym->traits[ti].name) == 0) {
            for (mi = 0; mi < sym->traits[ti].nm; mi++)
                if (strcmp(sym->traits[ti].m[mi].name, arena->nodes[n].text2) == 0) {
                    edge[from * stride + mi] = 1;
                    break;
                }
        }
        trait_default_edges(arena, arena->nodes[n].a, sym, ti, from, edge, stride);
        trait_default_edges(arena, arena->nodes[n].b, sym, ti, from, edge, stride);
        trait_default_edges(arena, arena->nodes[n].c, sym, ti, from, edge, stride);
        trait_default_edges(arena, arena->nodes[n].d, sym, ti, from, edge, stride);
    }
}

/* `#ct-raw` is a preprocessor line the parser treats as a directive: the
   spelling must match exactly, and trailing spaces / tabs / CR are allowed. */
static int pp_is(const char *text, const char *name)
{
    int i = 0;
    while (name[i] && text[i] == name[i]) i++;
    if (name[i]) return 0;
    while (text[i] == ' ' || text[i] == '\t' || text[i] == '\r') i++;
    return text[i] == 0;
}

/* `#ct-raw` … `#ct-endraw`: copy the bytes between the two marker lines into
   the literal pool verbatim and hand back an `N_RAW_TEXT` node. The block is
   never tokenised; the lexer is rewound onto the line after `#ct-endraw` so
   the rest of the file lexes normally. `num` is the pool offset, `a` the
   length. The markers must start at column 1, and a block that runs into EOF
   is reported at the `#ct-raw` line. */
static int raw_text_node(struct Parser *self)
{
    const char *src;
    int line, curline, i, ls, j, end, after, len, off, n, atbol;

    src = self->lex->src;
    line = self->lex->tokline;
    if (self->lex->tokstart != self->lex->lstart)
        return self->sup->fail_at(line, "#ct-raw must start at column 1");
    i = self->lex->pos;
    if (src[i] != '\n')
        return self->sup->fail_at(line, "unclosed #ct-raw (expected #ct-endraw)");
    i = i + 1;
    ls = i;
    curline = line + 1;
    atbol = 1;
    for (;;) {
        if (!src[i])
            return self->sup->fail_at(line, "unclosed #ct-raw (expected #ct-endraw)");
        if (atbol && src[i] == '#' && strncmp(src + i, "#ct-endraw", 10) == 0) {
            j = i + 10;
            while (src[j] == ' ' || src[j] == '\t' || src[j] == '\r') j++;
            if (src[j] == '\n' || src[j] == 0) { end = i; after = j; break; }
            return self->sup->fail_at(curline, "unexpected text after #ct-endraw");
        }
        if (src[i] == '\n') { curline++; i++; atbol = 1; continue; }
        atbol = 0;
        i++;
    }
    len = end - ls;
    if (len > TEXT_LIMIT)
        return self->sup->fail_at(line, "raw block exceeds 65536 bytes");
    off = self->arena->str_begin();
    for (i = 0; i < len; i++)
        if (self->arena->str_put((int)src[ls + i]) != 0)
            return self->sup->fail_at(line, "raw block exceeds the literal pool");
    self->arena->str_end();
    n = self->sup->new_node(N_RAW_TEXT);
    if (n < 0) return -1;
    self->arena->nodes[n].line = line;
    self->arena->nodes[n].num = off;
    self->arena->nodes[n].a = len;
    /* resume lexing on the line after the marker */
    self->lex->line = curline;
    self->lex->pos = after;
    self->lex->bol = 1;
    self->sup->lex_next();
    return n;
}

impl ParseDeclOps for Parser {
    int struct_def_ahead(void)
    {
        int pos, bol, tok, line, tokline, tokstart, lstart, is_def;
        long num;
        const char *text_ptr; int text_len;
        (void)self;

        pos = self->lex->pos;
        bol = self->lex->bol;
        tok = self->lex->tok;
        line = self->lex->line;
        tokline = self->lex->tokline;
        tokstart = self->lex->tokstart;
        lstart = self->lex->lstart;
        num = self->lex->toknum;
        text_ptr = self->lex->tokstr.ptr; text_len = self->lex->tokstr.len;
        self->sup->lex_next();
        is_def = 0;
        if (self->lex->tok == T_ID) {
            self->sup->lex_next();
            /* Phase 29: skip `struct Name<T[, U]>`'s parameter list, so the
               body below is still what decides the declaration kind. */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                int depth = 0;
                while (self->lex->tok != T_EOF) {
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                        depth++;
                    } else if (self->lex->tok == T_PUNCT
                               && self->lex->tok_is(">")) {
                        depth--;
                        if (depth <= 0) {
                            self->sup->lex_next();
                            break;
                        }
                    }
                    self->sup->lex_next();
                }
            }
        }
        /* a body (`{`) or a forward declaration (`;`) both start a CT struct */
        if (self->lex->tok == T_PUNCT && (self->lex->tok_is("{") || self->lex->tok_is(";")))
            is_def = 1;
        /* restoring the cursor must restore the line state too: the lookahead
           may cross a newline, and a stale `line` shifts every later
           diagnostic in the file */
        self->lex->pos = pos;
        self->lex->bol = bol;
        self->lex->tok = tok;
        self->lex->line = line;
        self->lex->tokline = tokline;
        self->lex->tokstart = tokstart;
        self->lex->lstart = lstart;
        self->lex->toknum = num;
        self->lex->tokstr.ptr = text_ptr; self->lex->tokstr.len = text_len;
        return is_def;
    }

    /* `type IDENT =` starts a type alias; `type` is a contextual keyword, so
       every other use of the identifier stays a type name or a declarator. */
    int type_alias_ahead(void)
    {
        int pos, bol, tok, line, tokline, tokstart, lstart, is_alias;
        long num;
        const char *text_ptr; int text_len;
        (void)self;

        pos = self->lex->pos;
        bol = self->lex->bol;
        tok = self->lex->tok;
        line = self->lex->line;
        tokline = self->lex->tokline;
        tokstart = self->lex->tokstart;
        lstart = self->lex->lstart;
        num = self->lex->toknum;
        text_ptr = self->lex->tokstr.ptr; text_len = self->lex->tokstr.len;
        self->sup->lex_next();
        is_alias = 0;
        if (self->lex->tok == T_ID) {
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("="))
                is_alias = 1;
        }
        self->lex->pos = pos;
        self->lex->bol = bol;
        self->lex->tok = tok;
        self->lex->line = line;
        self->lex->tokline = tokline;
        self->lex->tokstart = tokstart;
        self->lex->lstart = lstart;
        self->lex->toknum = num;
        self->lex->tokstr.ptr = text_ptr; self->lex->tokstr.len = text_len;
        return is_alias;
    }

    /* `[pub] type Name = <type>;`: a compile-time synonym, no node, no C. The
       target goes through `parse_type`, so what the table stores is already
       the canonical spelling an ordinary declaration would have produced. */
    int parse_type_alias(int is_pub)
    {
        int line, col;
        const char *name;
        const char *target;
        (void)self;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        if (!self->unit_is_hdr && !self->unit_is_map)
            return tool::diag::ct_sem_error(line, col,
                "a type alias is only allowed in a .h.ct or .m.ct unit", self->mem->path);
        if (self->unit_is_map && !is_pub)
            return tool::diag::ct_sem_error(line, col,
                "a type alias in a .m.ct unit must be 'pub'", self->mem->path);
        self->sup->lex_next();                       /* consume `type` */
        if (self->lex->tok != T_ID) return self->sup->fail("expected a name after 'type'");
        name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                            self->lex->tokstr.len);
        if (!name) return self->sup->fail("out of memory");
        self->sup->lex_next();
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("=")))
            return self->sup->fail("expected '=' in a type alias declaration");
        if (self->sym->begin_type_alias(name, self->mem->path, line, is_pub,
                                        self->cur_unit) != 0)
            return self->sup->fail(self->sym->last_error());
        self->sup->lex_next();                       /* consume `=` */
        self->sym->alias_decl++;
        self->ex->saw_atomic = 0;
        if (self->ex->parse_type_text(&target) != 0) {
            self->sym->alias_decl--;
            self->sym->abort_type_alias();
            return -1;
        }
        if (self->ex->saw_atomic) {
            self->sym->alias_decl--;
            self->sym->abort_type_alias();
            return tool::diag::ct_sem_error(line, col,
                "an atomic value cannot be a typedef target", self->mem->path);
        }
        self->sym->alias_decl--;
        if (self->ex->saw_trait) {
            self->sym->abort_type_alias();
            {
                char msg[512];
                snprintf(msg, sizeof msg, "type alias '%s' cannot name a trait", name);
                return self->sup->fail(msg);
            }
        }
        if (!target[0]) {
            self->sym->abort_type_alias();
            return self->sup->fail("expected a type after '=' in a type alias declaration");
        }
        if (self->sup->expect(";") != 0) {
            self->sym->abort_type_alias();
            return -1;
        }
        if (self->sym->finish_type_alias(target) != 0)
            return self->sup->fail(self->sym->last_error());
        return NO_NODE;
    }

    int append_node(int prog, int n)
    {
        int t;
        (void)self;

        self->arena->nodes[n].next = -1;
        if (self->arena->nodes[prog].a < 0) {
            self->arena->nodes[prog].a = n;
            return 0;
        }
        t = self->arena->nodes[prog].a;
        while (self->arena->nodes[t].next >= 0) t = self->arena->nodes[t].next;
        self->arena->nodes[t].next = n;
        return 0;
    }

    /* `import a::b::C;` pulls in the unit `a::b::C`. When the last segment is
       upper-case the file name is the unit's main exported type, so that name is
       also usable short here. `import a::b::C::D as E;` pulls in one exported
       name instead: `a::b::C` is the unit, `D` is what it exports and `E` is how
       this file spells it. */
    /* S1a-0 C1: the import list grows by doubling from MAX_IMPORTS, with
       CAP_LIMIT as the formal ceiling. A build's imports are recorded
       while `scan_only` is set, so the pass that decides the dependency graph
       never depends on a fixed 32-row table. */
    int ensure_rels(int need)
    {
        int cap;
        const char **grown;
        int *lines;
        (void)self;
        if (need <= self->relcap) return 0;
        cap = self->relcap > 0 ? self->relcap : MAX_IMPORTS;
        while (cap < need && cap < CAP_LIMIT) cap *= 2;
        if (cap > CAP_LIMIT) cap = CAP_LIMIT;
        if (need > cap) return self->sup->fail("out of memory");
        grown = (const char **)realloc(self->rels, (size_t)cap * sizeof(*grown));
        if (!grown) return self->sup->fail("out of memory");
        memset(grown + self->relcap, 0,
               (size_t)(cap - self->relcap) * sizeof(*grown));
        lines = (int *)realloc(self->rel_line, (size_t)cap * sizeof(*lines));
        if (!lines) return self->sup->fail("out of memory");
        memset(lines + self->relcap, 0,
               (size_t)(cap - self->relcap) * sizeof(*lines));
        self->rels = grown;
        self->rel_line = lines;
        self->relcap = cap;
        return 0;
    }

    int skip_import(void)
    {
        TokView *seg = 0;
        int nseg = 0, segcap = 0;
        char *rel = 0, *full = 0;
        int relcap = 0, fullcap = 0;
        const char *alias, *last;
        int i, has_as, import_line, rc;

        import_line = self->lex->tokline;
        has_as = 0;
        rc = 0;
        self->sup->lex_next();                       /* consume `import` */
        for (;;) {
            if (self->lex->tok != T_ID) { rc = self->sup->fail("expected an import path"); goto done; }
            if (nseg >= segcap) {
                int ncap = segcap > 0 ? segcap * 2 : 16;
                TokView *grown;
                if (ncap > TEXT_LIMIT) ncap = TEXT_LIMIT;
                if (nseg >= ncap) { rc = self->sup->fail("import path is too long"); goto done; }
                grown = (TokView *)realloc(seg, (size_t)ncap * sizeof(*grown));
                if (!grown) { rc = self->sup->fail("out of memory"); goto done; }
                seg = grown;
                segcap = ncap;
            }
            seg[nseg].ptr = self->lex->tokstr.ptr;
            seg[nseg].len = self->lex->tokstr.len;
            nseg++;
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("::")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        last = runtime::text::ct_intern_len(seg[nseg - 1].ptr, seg[nseg - 1].len);
        if (!last) { rc = self->sup->fail("out of memory"); goto done; }
        alias = last;
        if (self->lex->tok == T_ID && self->lex->tok_is("as")) {
            has_as = 1;
            self->sup->lex_next();
            if (self->lex->tok != T_ID) { rc = self->sup->fail("expected an alias after 'as'"); goto done; }
            alias = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!alias) { rc = self->sup->fail("out of memory"); goto done; }
            self->sup->lex_next();
        }
        if (self->sup->expect(";") != 0) { rc = -1; goto done; }
        if (has_as && nseg < 2) { rc = self->sup->fail("an imported name needs a unit"); goto done; }
        /* The unit path: every segment, `/`-joined. The C spelling: every
           segment, `_`-joined (`as` rebuilds it without the unit's file
           segment below). Both grow on demand, so neither the segment count
           nor a segment's length is capped by the old 16 x 160 rows. */
        for (i = 0; i < nseg; i++) {
            const char *si = runtime::text::ct_intern_len(seg[i].ptr, seg[i].len);
            if (!si) { rc = self->sup->fail("out of memory"); goto done; }
            if (i < nseg - 1 || !has_as) {
                if (tool::sh::ct_text_cat(&rel, &relcap, i > 0 ? "/" : "") != 0
                    || tool::sh::ct_text_cat(&rel, &relcap, si) != 0) {
                    rc = self->sup->fail("import path is too long"); goto done;
                }
            }
            if (i > 0 && tool::sh::ct_text_cat(&full, &fullcap, "_") != 0) {
                rc = self->sup->fail("qualified name is too long"); goto done;
            }
            if (tool::sh::ct_text_cat(&full, &fullcap, si) != 0) {
                rc = self->sup->fail("qualified name is too long"); goto done;
            }
        }
        /* Only the dependency-graph scan records imports: the parse pass sees
           the same lines again and would otherwise charge this unit for its
           dependencies' rows (the module layer keeps one stack). */
        if (rel && rel[0] && self->scan_only) {
            const char *r = runtime::text::ct_intern(rel);
            if (!r) { rc = self->sup->fail("out of memory"); goto done; }
            if (self->ensure_rels(self->nrels + 1) != 0) { rc = -1; goto done; }
            self->rels[self->nrels] = r;
            self->rel_line[self->nrels] = import_line;
            self->nrels++;
        }
        /* A by-name import binds the last segment; a unit import binds the
           type named by its upper-case file name. A lower-case unit import
           binds nothing. */
        if (self->scan_only) goto done;
        if (!has_as && !(seg[nseg - 1].ptr[0] >= 'A' && seg[nseg - 1].ptr[0] <= 'Z'))
            goto done;
        {
            const char *cn;
            if (has_as) {
                /* `import a::b::C::D as E;`: the C name is `a_b_D` -- the
                   unit file segment `C` is not part of it. Rebuild the
                   namespace prefix from segments 0..nseg-3 and append `D`. */
                char *prefix = 0;
                int pcap = 0;
                char *tmp = 0;
                int k;
                for (k = 0; k < nseg - 2; k++) {
                    const char *sk = runtime::text::ct_intern_len(seg[k].ptr, seg[k].len);
                    if (!sk) { free(prefix); rc = self->sup->fail("out of memory"); goto done; }
                    if (k > 0 && tool::sh::ct_text_cat(&prefix, &pcap, "_") != 0) {
                        free(prefix); rc = self->sup->fail("qualified name is too long"); goto done;
                    }
                    if (tool::sh::ct_text_cat(&prefix, &pcap, sk) != 0) {
                        free(prefix); rc = self->sup->fail("qualified name is too long"); goto done;
                    }
                }
                if (prefix && prefix[0]) {
                    if (tool::sh::ct_text_fmt(&tmp, 1, "%s_%s", prefix, last) != 0) {
                        free(prefix); rc = self->sup->fail("qualified name is too long"); goto done;
                    }
                    cn = runtime::text::ct_intern(tmp);
                } else {
                    cn = last;
                }
                free(prefix);
                free(tmp);
            } else {
                cn = runtime::text::ct_intern(full);
            }
            if (!cn) { rc = self->sup->fail("out of memory"); goto done; }
            if (self->sym->find_type(cn) < 0 && self->sym->find_trait(cn) < 0
                && self->sym->find_struct(cn) < 0) {
                if (has_as) { rc = self->sup->fail("the imported unit does not export that name"); goto done; }
                goto done;                       /* a unit with no such type: no alias */
            }
            if (self->sym->add_alias(alias, cn) != 0) {
                rc = self->sup->fail(self->sym->last_error());
                goto done;
            }
        }
    done:
        free(seg);
        free(rel);
        free(full);
        return rc;
    }

    int top_decl(int is_pub)
    {
        int n;
        (void)self;

        if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
            if (is_pub) return self->sup->fail("duplicate 'pub'");
            self->sup->lex_next();
            return self->top_decl(1);
        }
        self->decl_pub = is_pub;
        /* A `.m.ct` unit is a mapping-only unit: its whitelist is `pub trait`,
           `map` and `_Static_assert`; everything else is refused here so the
           message names what the unit is not allowed to carry. */
        if (self->unit_is_map && !(self->lex->tok == T_ID
                && (self->lex->tok_is("trait")
                    || self->lex->tok_is("map")
                    || (self->lex->tok_is("type") && self->type_alias_ahead())
                    || self->lex->tok_is("_Static_assert")
                    || self->lex->tok_is("static_assert")))) {
            int dline, dcol, dn, dk;
            dline = self->lex->tokline;
            dcol = self->lex->tokstart - self->lex->lstart + 1;
            if (self->lex->tok == T_ID && self->lex->tok_is("impl"))
                return tool::diag::ct_sem_error(dline, dcol,
                    "a .m.ct unit cannot contain an impl", self->mem->path);
            if (self->lex->tok == T_ID
                && (self->lex->tok_is("typedef")
                    || self->lex->tok_is("struct")
                    || self->lex->tok_is("union")
                    || self->lex->tok_is("enum")))
                return tool::diag::ct_sem_error(dline, dcol,
                    "a .m.ct unit cannot declare a type", self->mem->path);
            if (self->lex->tok == T_ID
                && (self->lex->tok_is("static")
                    || self->lex->tok_is("inline")))
                return tool::diag::ct_sem_error(dline, dcol,
                    "a .m.ct unit cannot declare a function", self->mem->path);
            if (self->lex->tok == T_ID
                && (self->lex->tok_is("extern")
                    || self->lex->tok_is("own")
                    || self->lex->tok_is("__attribute__")
                    || self->lex->tok_is("_Alignas")))
                return tool::diag::ct_sem_error(dline, dcol,
                    "a .m.ct unit cannot declare a global variable", self->mem->path);
            dn = self->parse_func(0, 0, 0);
            /* NO_NODE is a prototype: its row lives in the function table. It
               is negative, so it must be handled before the generic error test. */
            if (dn < 0 && dn != NO_NODE) return -1;
            dk = (dn == NO_NODE) ? -1 : self->arena->nodes[dn].kind;
            if (dn == NO_NODE)
                return tool::diag::ct_sem_error(dline, dcol,
                    "a .m.ct unit cannot declare a function", self->mem->path);
            if (dk == N_FUNC)
                return tool::diag::ct_sem_error(dline, dcol,
                    "a .m.ct unit cannot define a function", self->mem->path);
            return tool::diag::ct_sem_error(dline, dcol,
                "a .m.ct unit cannot declare a global variable", self->mem->path);
        }
        /* A leading `__attribute__((…))` and a leading `_Alignas(…)` are both
           declaration prefixes: the attribute is held for `parse_func`, the
           alignment spelling is prepended to the type. Either may sit before
           the storage class (`__attribute__((unused)) static int g;`,
           `_Alignas(16) static int g;`). */
        if (self->lex->tok == T_ID && self->lex->tok_is("__attribute__")) {
            int a, r;
            if (self->sup->attr_pool(&a) < 0) return -1;
            if (a < 0) return -1;
            if (self->pending_attr)
                return self->sup->fail("duplicate __attribute__ on one declaration");
            self->pending_attr = a + 1;
            r = self->top_decl(is_pub);
            if (r < 0) {
                self->pending_attr = 0;
                return r;
            }
            if (self->pending_attr) {
                self->pending_attr = 0;
                return self->sup->fail("an attribute must prefix a declaration");
            }
            return r;
        }
        if (self->lex->tok == T_ID && self->lex->tok_is("_Alignas")) {
            int r, np, depth;
            const char *tbuf;
            char *dpx = 0;
            int dcap = 0;
            if (self->ex->decl_prefix[0])
                return self->sup->fail("duplicate _Alignas on one declaration");
            /* Capture only the specifier; the rest of the declaration (a
               storage class included) is read by the recursive call. */
            np = 0;
            if (tool::sh::ct_text_init(&dpx, &dcap, 64) != 0)
                return self->sup->fail("out of memory");
            if (tool::sh::ct_text_cat(&dpx, &dcap, "_Alignas") != 0)
                return self->sup->fail("out of memory");
            self->sup->lex_next();
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("(")))
                return self->sup->fail("expected '(' after _Alignas");
            depth = 0;
            for (;;) {
                if (self->lex->tok == T_EOF) return self->sup->fail("unterminated _Alignas");
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    tbuf = runtime::text::ct_internf("%ld", self->lex->toknum);
                else
                    tbuf = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                        self->lex->tokstr.len);
                if (!tbuf) return self->sup->fail("out of memory");
                if (np > 0 && tool::sh::ct_text_cat(&dpx, &dcap, " ") != 0)
                    return self->sup->fail("out of memory");
                if (tool::sh::ct_text_cat(&dpx, &dcap, tbuf) != 0)
                    return self->sup->fail("out of memory");
                np = 1;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) depth++;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
                    depth--;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                }
                self->sup->lex_next();
            }
            self->ex->decl_prefix = runtime::text::ct_intern(dpx);
            tool::sh::ct_text_free(&dpx, &dcap);
            if (!self->ex->decl_prefix) return self->sup->fail("out of memory");
            r = self->top_decl(is_pub);
            if (r < 0) {
                self->ex->decl_prefix = "";
                return r;
            }
            if (self->ex->decl_prefix[0]) {
                self->ex->decl_prefix = "";
                return self->sup->fail("an _Alignas specifier must prefix a variable declaration");
            }
            return r;
        }
        if (self->lex->tok == T_ID && self->lex->tok_is("own")) {
            /* PH-49 L49-3: a return-position `own` stays rejected, but the
               message names the supported form. A `(` before the first `=` / `;`
               is a function declarator (`own struct P *make(void) {`); a
               file-scope variable has `=` or `;` first. The lookahead restores
               the lexer exactly, so the old message still covers file-scope
               variables (`own P *global = malloc(...)`). */
            const char *save_text_ptr; int save_text_len;
            int save_tok, save_float, save_line, save_tokline, save_start;
            int save_lstart, save_bol, save_pos, look;
            long save_num;
            save_tok = self->lex->tok;
            save_num = self->lex->toknum;
            save_float = self->lex->tokfloat;
            save_line = self->lex->line;
            save_tokline = self->lex->tokline;
            save_start = self->lex->tokstart;
            save_lstart = self->lex->lstart;
            save_bol = self->lex->bol;
            save_pos = self->lex->pos;
            save_text_ptr = self->lex->tokstr.ptr; save_text_len = self->lex->tokstr.len;
            self->sup->lex_next();
            look = 0;
            while (self->lex->tok != T_EOF) {
                if (self->lex->tok == T_PUNCT
                    && (self->lex->tok_is(";")
                        || self->lex->tok_is("{")
                        || self->lex->tok_is("=")))
                    break;
                if (self->lex->tok == T_PUNCT
                    && self->lex->tok_is("(")) {
                    look = 1;
                    break;
                }
                self->sup->lex_next();
            }
            self->lex->tok = save_tok;
            self->lex->toknum = save_num;
            self->lex->tokfloat = save_float;
            self->lex->line = save_line;
            self->lex->tokline = save_tokline;
            self->lex->tokstart = save_start;
            self->lex->lstart = save_lstart;
            self->lex->bol = save_bol;
            self->lex->pos = save_pos;
            self->lex->tokstr.ptr = save_text_ptr; self->lex->tokstr.len = save_text_len;
            if (look)
                return tool::diag::ct_sem_error(self->lex->tokline, 1,
                    "'own' in a return type is not supported;"
                    " mark the call site instead: 'own struct <T> *p = factory();'",
                    self->mem->path);
            return tool::diag::ct_sem_error(self->lex->tokline, 1,
                "'own' is only allowed inside a function body", self->mem->path);
        }
        /* `borrow` at file scope has no exit to hand the pointer back at, and
           passing it through as a type name emits C the C compiler rejects
           (SH-34) */
        if (self->lex->tok == T_ID && self->lex->tok_is("borrow"))
            return tool::diag::ct_sem_error(self->lex->tokline, 1,
                "'borrow' is only allowed inside a function body", self->mem->path);
        if (self->lex->tok == T_ID && self->lex->tok_is("typedef")) {
            n = self->parse_typedef(is_pub);
        } else if (self->lex->tok == T_ID && self->lex->tok_is("type")
                   && self->type_alias_ahead()) {
            n = self->parse_type_alias(is_pub);
        } else if (self->lex->tok == T_ID && self->lex->tok_is("trait")) {
            n = self->parse_trait(is_pub);
        } else if (self->lex->tok == T_ID && self->lex->tok_is("impl")) {
            n = self->parse_impl(is_pub);
        } else if (self->lex->tok == T_ID && self->lex->tok_is("map")) {
            n = mapbuild_get()->parse(self->cur_unit);
        } else if (self->lex->tok == T_ID && self->lex->tok_is("enum")) {
            /* `enum Tag { ... }`: the tag is required, and the braces follow the
               name directly (there is no forward form) (D-2). */
            n = self->parse_enum_def(is_pub, 1);
            if (n >= 0) self->sup->accept(";");
        } else if (self->lex->tok == T_ID && self->lex->tok_is("struct")
                   && self->struct_def_ahead()) {
            n = self->parse_record_def(0);
            /* CT writes `struct X { ... }` bare (the old pipeline accepts both) */
            if (n >= 0) self->sup->accept(";");
        } else if (self->lex->tok == T_ID && self->lex->tok_is("union")
                   && self->struct_def_ahead()) {
            n = self->parse_record_def(1);
            if (n >= 0) self->sup->accept(";");
        } else if (self->lex->tok == T_ID && self->lex->tok_is("static")) {
            self->sup->lex_next();
            /* `static inline` and `inline static` mean the same thing in C */
            if (self->lex->tok == T_ID && self->lex->tok_is("inline")) {
                int iline = self->lex->tokline, icol = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                n = self->parse_func(1, is_pub, 0);
                if (n > 0 && self->arena->nodes[n].kind != N_FUNC)
                    return tool::diag::ct_sem_error(iline, icol,
                        "'inline' can only declare a function", self->mem->path);
                if (n > 0) self->arena->nodes[n].num = 1;
            } else {
                n = self->parse_func(1, is_pub, 0);
            }
        } else if (self->lex->tok == T_ID && self->lex->tok_is("inline")) {
            int iline = self->lex->tokline, icol = self->lex->tokstart - self->lex->lstart + 1;
            int in_static = 0;
            self->sup->lex_next();
            if (self->lex->tok == T_ID && self->lex->tok_is("static")) {
                in_static = 1;
                self->sup->lex_next();
            }
            n = self->parse_func(in_static, is_pub, 0);
            if (n > 0 && self->arena->nodes[n].kind != N_FUNC)
                return tool::diag::ct_sem_error(iline, icol,
                    "'inline' can only declare a function", self->mem->path);
            if (n > 0) self->arena->nodes[n].num = 1;
        } else if (self->lex->tok == T_ID
                   && (self->lex->tok_is("_Static_assert")
                       || self->lex->tok_is("static_assert"))) {
            /* a file-scope static assertion is the statement form; the statement
               layer owns the grammar and the constant check */
            n = self->st->parse_stmt();
        } else if (self->lex->tok == T_ID && self->lex->tok_is("extern")) {
            if (self->c_strict && !self->unit_is_map)
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    "a strict C boundary forbids direct C declarations;"
                    " use <base>.shim.h or a .m.ct mapping",
                    self->mem->path);
            /* A declaration only, for a symbol the C library owns. Both forms
               are accepted: `extern int flag;` (a variable) and
               `extern int fn(int);` (a prototype); neither defines anything.
               The position is captured here because parsing consumes the whole
               declaration, which would leave the lexer on the next line. */
            int eline, ecol;
            eline = self->lex->tokline;
            ecol = self->lex->tokstart - self->lex->lstart + 1;
            self->sup->lex_next();
            n = self->parse_func(0, is_pub, 1);
            if (n == NO_NODE) {
                /* a prototype: its row is in the function table, so a `pub`
                   one reaches the header and every unit's `.c` gets the
                   declaration it needs to call it */
            } else if (n < 0) {
                return -1;
            } else if (self->arena->nodes[n].kind == N_FUNC) {
                return tool::diag::ct_sem_error(eline, ecol,
                    "an extern declaration cannot define a function", self->mem->path);
            } else {
                self->arena->nodes[n].aux = 2;
                if (self->arena->nodes[n].a >= 0)
                    return tool::diag::ct_sem_error(eline, ecol,
                        "an extern declaration cannot have an initialiser", self->mem->path);
            }
        } else {
            n = self->parse_func(0, is_pub, 0);
        }
        if (n == NO_NODE) return NO_NODE;
        if (n < 0) return -1;
        self->arena->nodes[n].d = is_pub ? 1 : 0;
        return n;
    }

    int parse_namespace(int prog)
    {
        char *path = 0, *prefix = 0;
        int pathcap = 0, prefixcap = 0;
        int first, rc;
        (void)prog;

        first = 1;
        rc = 0;
        self->sup->lex_next();
        for (;;) {
            const char *seg;
            if (self->lex->tok != T_ID) { rc = self->sup->fail("expected a namespace name"); goto done; }
            seg = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                               self->lex->tokstr.len);
            if (!seg) { rc = self->sup->fail("out of memory"); goto done; }
            if (!first && tool::sh::ct_text_cat(&path, &pathcap, "::") != 0) {
                rc = self->sup->fail("namespace is too long"); goto done;
            }
            if (tool::sh::ct_text_cat(&path, &pathcap, seg) != 0) {
                rc = self->sup->fail("namespace is too long"); goto done;
            }
            if (tool::sh::ct_text_cat(&prefix, &prefixcap, seg) != 0
                || tool::sh::ct_text_cat(&prefix, &prefixcap, "_") != 0) {
                rc = self->sup->fail("namespace is too long"); goto done;
            }
            first = 0;
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("::")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (!self->sym->ns || !self->sym->ns[0]) {
            self->ns_decl = runtime::text::ct_intern(path);
            if (!self->ns_decl) { rc = self->sup->fail("out of memory"); goto done; }
        }
        /* Only the file-scoped form is accepted: a block would let one unit
           declare several namespaces, which the per-unit prefix and the
           directory check both assume away. */
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is(";")) {
            rc = self->sup->fail("a namespace is file-scoped: write 'namespace A::B;'");
            goto done;
        }
        self->sup->lex_next();
        /* DOC-87 Stage 2: the built-in layer declares `namespace core` so the
           canonical `core::Vec` spelling resolves and the declaration is visible
           to editors. Its C symbols stay in the root compatibility namespace for
           this MINOR (no ABI churn); `core::` is an alias of the root spelling. */
        if (strstr(self->mem->path, "lib/core/") != 0
            || strstr(self->mem->path, "lib/std/") != 0) /* DOC-87 迁移回退 */
            goto done;
        if (prefix && prefix[0]) {
            const char *joined = runtime::text::ct_intern_join(self->sym->ns, prefix);
            if (!joined) { rc = self->sup->fail("out of memory"); goto done; }
            self->sym->ns = joined;
        }
    done:
        free(path);
        free(prefix);
        return rc;
    }

}

/* Phase 28 (D28-3): an instance may only be built when its type argument
   satisfies the template's bound. The check runs after the unit is parsed so
   an `impl` written below the call still counts; without it the emitter would
   spell a vtable nobody defines. `use` covers the adoption written on the
   struct, the arena scan covers `impl Trait for S`. */
static int impl_declares(struct Parser *self, int si, const char *trait)
{
    int i;

    for (i = 0; i < self->arena->nnode; i++)
        if (self->arena->nodes[i].kind == N_IMPL
            && self->arena->nodes[i].aux == si
            && strcmp(self->arena->nodes[i].text2, trait) == 0)
            return 1;
    return 0;
}

static int check_generic_bounds(struct Parser *self)
{
    int i, k, si, base;
    char msg[512];

    base = tool::diag::ct_diag_nsem();
    for (i = 0; i < self->sym->nginsts; i++) {
        int f = self->sym->ginsts[i].func;
        const char *targ;
        const char *tbase;
        size_t tl;
        int ok;
        if (self->sym->ginsts[i].checked) continue;
        self->sym->ginsts[i].checked = 1;
        if (!self->sym->fn_at(f)->bound[0]) continue;
        targ = self->sym->ginsts[i].targ ? self->sym->ginsts[i].targ : "";
        tl = strlen(targ);
        while (tl > 0 && (targ[tl - 1] == ' ' || targ[tl - 1] == '*')) tl--;
        targ = runtime::text::ct_intern_len(targ, (int)tl);
        if (!targ) return -1;
        if (strncmp(targ, "struct ", 7) == 0) tbase = targ + 7;
        else if (strncmp(targ, "union ", 6) == 0) tbase = targ + 6;
        else tbase = targ;
        si = self->sym->find_struct(tbase);
        if (si < 0) {
            snprintf(msg, sizeof msg,
                     "type argument '%s' cannot satisfy trait '%s' (not a struct)",
                     self->sym->ginsts[i].targ, self->sym->fn_at(f)->bound);
            tool::diag::ct_sem_error(self->sym->ginsts[i].line, self->sym->ginsts[i].col,
                                     msg, self->mem->path);
            continue;
        }
        ok = impl_declares(self, si, self->sym->fn_at(f)->bound);
        for (k = 0; !ok && k < self->sym->structs[si].nuse; k++)
            if (strcmp(self->sym->structs[si].use[k], self->sym->fn_at(f)->bound) == 0)
                ok = 1;
        if (!ok) {
            snprintf(msg, sizeof msg,
                     "type argument '%s' does not implement trait '%s'",
                     self->sym->structs[si].name, self->sym->fn_at(f)->bound);
            tool::diag::ct_sem_error(self->sym->ginsts[i].line, self->sym->ginsts[i].col,
                                     msg, self->mem->path);
        }
    }
    return tool::diag::ct_diag_nsem() > base ? -1 : 0;
}

/* Phase 33 O1: every concrete instance a unit creates is checked against its
   template's bound after the whole unit is parsed, so an `impl` / `use` written
   below the instantiation still counts (R33-6). The bound trait itself must be
   visible here (D33-5): an unknown name is L33-6 rather than a silent pass. */
static int check_struct_bounds(struct Parser *self)
{
    int i, k, k2, base, n, ntm;
    struct StructInst *ins = frontend::sym::ct_insts(&n);
    struct StructTmpl *tp = frontend::sym::ct_tmpls(&ntm);
    char msg[512];

    base = tool::diag::ct_diag_nsem();
    (void)ntm;
    if (!ins || !tp) return 0;
    for (i = 0; i < n; i++) {
        int ti, si, ok;
        const char *tbase;
        char *arg;
        if (ins[i].owner != self->cur_unit || ins[i].line <= 0) continue;
        ti = ins[i].tmpl_row;
        if (ti < 0) continue;
        for (k = 0; k < ins[i].nargs; k++) {
            if (!tp[ti].bound[k][0]) continue;
            arg = ins[i].carg[k];
            if (self->sym->find_trait(tp[ti].bound[k]) < 0) {
                snprintf(msg, sizeof msg, "unknown trait '%s' in a generic bound",
                         tp[ti].bound[k]);
                tool::diag::ct_sem_error(ins[i].line, ins[i].col, msg, self->mem->path);
                continue;
            }
            tbase = struct_name_text(arg);
            if (!tbase) return self->sup->fail("out of memory");
            si = self->sym->find_struct(tbase);
            ok = 0;
            if (si >= 0) {
                ok = impl_declares(self, si, tp[ti].bound[k]);
                for (k2 = 0; !ok && k2 < self->sym->structs[si].nuse; k2++)
                    if (strcmp(self->sym->structs[si].use[k2], tp[ti].bound[k]) == 0)
                        ok = 1;
                /* An `impl Trait for Box` written against the template tag
                   covers every `Box<…>` instance for the type system; the
                   emitter only misses the per-instance vtable, which this
                   check never needs. */
                if (!ok) {
                    int ii = frontend::sym::ct_inst_find(tbase);
                    int sj = ii >= 0 ? self->sym->find_struct(ins[ii].tmpl) : -1;
                    if (sj >= 0) ok = impl_declares(self, sj, tp[ti].bound[k]);
                }
            }
            if (!ok) {
                snprintf(msg, sizeof msg,
                         "instance argument '%s' does not satisfy the bound '%s'",
                         arg, tp[ti].bound[k]);
                tool::diag::ct_sem_error(ins[i].line, ins[i].col, msg, self->mem->path);
            }
        }
    }
    return tool::diag::ct_diag_nsem() > base ? -1 : 0;
}

/* Phase 35 S4 (L35-1): a trait instance may only be built when every type
   argument satisfies its parameter's bound. Like the struct-template check it
   runs after the unit is parsed, so an `impl` written below the use still
   counts; the instance row names the template it came from. */
static int check_trait_bounds(struct Parser *self)
{
    int i, k, k2, base, si, ti, ok;
    char msg[512];
    const char *tbase;

    base = tool::diag::ct_diag_nsem();
    for (i = 0; i < self->sym->ntraits; i++) {
        if (self->sym->traits[i].tmpl < 0) continue;
        if (self->sym->traits[i].owner != self->cur_unit) continue;
        ti = self->sym->traits[i].tmpl;
        for (k = 0; k < self->sym->traits[i].nargs; k++) {
            const char *arg;
            if (!self->sym->traits[ti].bound[k][0]) continue;
            arg = self->sym->traits[i].carg[k];
            if (self->sym->find_trait(self->sym->traits[ti].bound[k]) < 0) {
                snprintf(msg, sizeof msg, "unknown trait '%s' in a generic bound",
                         self->sym->traits[ti].bound[k]);
                tool::diag::ct_sem_error(self->sym->traits[i].line, 1, msg, self->mem->path);
                continue;
            }
            tbase = struct_name_text(arg);
            if (!tbase) return self->sup->fail("out of memory");
            si = self->sym->find_struct(tbase);
            ok = 0;
            if (si >= 0) {
                ok = impl_declares(self, si, self->sym->traits[ti].bound[k]);
                for (k2 = 0; !ok && k2 < self->sym->structs[si].nuse; k2++)
                    if (strcmp(self->sym->structs[si].use[k2],
                               self->sym->traits[ti].bound[k]) == 0)
                        ok = 1;
            }
            if (!ok) {
                snprintf(msg, sizeof msg,
                         "'%s' does not satisfy the bound '%s' of '%s'",
                         tbase, self->sym->traits[ti].bound[k],
                         self->sym->traits[ti].name);
                tool::diag::ct_sem_error(self->sym->traits[i].line, 1, msg, self->mem->path);
            }
        }
    }
    return tool::diag::ct_diag_nsem() > base ? -1 : 0;
}

/* Phase 35 S3b: read the concrete arguments after a generic trait name. The
   encoded identity keeps the source spelling of a nested instance (`Vec<int>`),
   while method signatures need its C spelling (`struct Vec_int`). */
static int parse_trait_inst_args(struct Parser *self, char *tname, int cap)
{
    char **arg = 0;
    char **ctype = 0;
    const char *abuf;
    int acap = 0, ccap = 0, nargs = 0, ti;

    if (self->sup->expect("<") != 0) return -1;
    for (;;) {
        arg = frontend::sym::ct_rows_reserve(arg, acap, nargs + 1, &acap);
        ctype = frontend::sym::ct_rows_reserve(ctype, ccap, nargs + 1, &ccap);
        if (!arg || acap < nargs + 1 || !ctype || ccap < nargs + 1)
            return self->sup->fail("a generic trait has too many type arguments");
        self->ex->inst_canon = "";
        if (self->ex->parse_type_text(&abuf) != 0) return -1;
        if (frontend::sym::ct_type_canon(self->ex->inst_canon
                                             && self->ex->inst_canon[0]
                                             ? self->ex->inst_canon : abuf,
                                         arg[nargs], MAX_TEXT) != 0)
            return self->sup->fail("type is too long");
        snprintf(ctype[nargs], MAX_TEXT, "%s", abuf);
        nargs++;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
            self->sup->lex_next();
            continue;
        }
        break;
    }
    /* As in parse_inst_type, let the first half of `>>` close this list and
       leave the second half for the enclosing type argument list. */
    if (self->lex->tok == T_PUNCT && self->lex->tok_is(">>")) {
        self->lex->tokstr.ptr = self->lex->src + self->lex->tokstart + 1;
        self->lex->tokstr.len = 1;
        self->lex->pos = self->lex->pos - 1;
        self->lex->tokstart = self->lex->tokstart + 1;
    }
    if (self->sup->expect(">") != 0) return -1;
    ti = self->sym->trait_inst(tname, nargs, arg, ctype, self->cur_unit);
    if (ti < 0) return self->sup->fail(self->sym->last_error());
    if (snprintf(tname, (size_t)cap, "%s", self->sym->traits[ti].name) >= cap)
        return self->sup->fail("type name is too long");
    return ti;
}

/* Phase 84 (D84-1): does the `{` at the cursor open an ADT member list? The
   form of the whole declaration depends on it, and a payload may name the ADT
   itself (`Add(Node *l, Node *r)`), so the tag has to join the type table
   before the members are read. The answer is a raw-source scan at brace depth
   1: a member name directly followed by `(` is a payload list, while an
   initialiser (`A = f(1)`) is skipped to its `,` / `}` so a call there does not
   count. Strings, characters and comments are skipped. */
static int enum_adt_ahead(struct Parser *self)
{
    const char *p;
    int brace, pdepth;

    p = self->lex->src + self->lex->tokstart;
    if (*p != '{') return 0;
    brace = 0;
    for (;;) {
        if (!*p) return 0;
        if (*p == '"' || *p == '\'') {
            char q = *p;
            p++;
            while (*p && *p != q) {
                if (*p == '\\' && p[1]) p++;
                p++;
            }
            if (*p) p++;
            continue;
        }
        if (*p == '/' && p[1] == '*') {
            p += 2;
            while (*p && !(*p == '*' && p[1] == '/')) p++;
            if (*p) p += 2;
            continue;
        }
        if (*p == '/' && p[1] == '/') {
            while (*p && *p != '\n') p++;
            continue;
        }
        if (*p == '{') { brace++; p++; continue; }
        if (*p == '}') {
            brace--;
            if (brace == 0) return 0;
            p++;
            continue;
        }
        if (brace != 1) { p++; continue; }
        if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == ',') { p++; continue; }
        if (*p == '_' || (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')) {
            while (*p == '_' || (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                   || (*p >= '0' && *p <= '9')) p++;
            while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
            if (*p == '(') return 1;
            if (*p != '=') continue;
            /* skip the initialiser up to the member list's own `,` / `}` */
            p++;
            pdepth = 0;
            while (*p) {
                if (*p == '"' || *p == '\'') {
                    char q = *p;
                    p++;
                    while (*p && *p != q) {
                        if (*p == '\\' && p[1]) p++;
                        p++;
                    }
                    if (*p) p++;
                    continue;
                }
                if (*p == '/' && p[1] == '*') {
                    p += 2;
                    while (*p && !(*p == '*' && p[1] == '/')) p++;
                    if (*p) p += 2;
                    continue;
                }
                if (*p == '/') { while (*p && *p != '\n') p++; continue; }
                if (*p == '(' || *p == '[' || *p == '{') { pdepth++; p++; continue; }
                if (*p == ')' || *p == ']' || *p == '}') {
                    if (pdepth == 0) break;
                    pdepth--;
                    p++;
                    continue;
                }
                if (pdepth == 0 && *p == ',') break;
                p++;
            }
            continue;
        }
        p++;
    }
}

impl ParseOps for Parser {

    /* Phase 33 S6: read one impl-pattern argument without `parse_type`. A bare
       parameter stays its own spelling (a wildcard); a nested `Name<...>` keeps
       the whole spelling and is walked by bracket depth, so no pseudo instance
       is registered. A suffix (`*`, `[`) or a declarator (`(`) is not a pattern
       shape and leaves `bad` set for the caller's L33-5; the depth cap counts
       openings, so the sixth `Box` is the first that trips L33-4 (E33-11). */
    int parse_pat_arg(char *out, int cap, int base,
                      int *l4line, int *l4col, int *deep, int *bad)
    {
        int n = 0, depth = 0;

        out[0] = 0;
        for (;;) {
            int txl = self->lex->tokstr.len;
            int tl = self->lex->tokline;
            int tc = self->lex->tokstart - self->lex->lstart + 1;

            if (self->lex->tok == T_ID) {
                if (self->lex->tok_is("_")) *bad = 1;
                if (n + txl + 1 >= cap)
                    return self->sup->fail("an impl pattern is too long");
                self->lex->tok_copy(out + n, cap - n);
                n += txl;
                self->sup->lex_next();
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                depth++;
                /* depth counts the `Box` layers below the impl's own template:
                   depth 4 (five `Box`) stays legal, depth 5 (six) reports
                   L33-4 at the innermost `<`. */
                if (base + depth > 4) {
                    *deep = 1;
                    *l4line = tl;
                    *l4col = tc;
                }
                if (n + 2 >= cap)
                    return self->sup->fail("an impl pattern is too long");
                n += snprintf(out + n, (size_t)(cap - n), "<");
                self->sup->lex_next();
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is(">>")) {
                /* D29-2: the lexer keeps `>>` as one token. Two open layers
                   spend both characters; one open layer spends the first and
                   leaves the rewritten `>` for the caller's own list. */
                if (depth >= 2) {
                    depth -= 2;
                    if (n + 3 >= cap)
                        return self->sup->fail("an impl pattern is too long");
                    n += snprintf(out + n, (size_t)(cap - n), ">>");
                    self->sup->lex_next();
                    if (depth == 0) break;
                } else if (depth == 1) {
                    depth = 0;
                    if (n + 2 >= cap)
                        return self->sup->fail("an impl pattern is too long");
                    n += snprintf(out + n, (size_t)(cap - n), ">");
                    self->lex->tokstr.ptr = self->lex->src + self->lex->tokstart + 1;
                    self->lex->tokstr.len = 1;
                    self->lex->tokstart = self->lex->tokstart + 1;
                    break;
                } else {
                    break;
                }
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is(">")) {
                if (depth == 0) break;
                depth--;
                n += snprintf(out + n, (size_t)(cap - n), ">");
                self->sup->lex_next();
                if (depth == 0) break;
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is(",") && depth == 0) {
                break;
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is("*")) {
                /* A concrete pointer argument (`Map<char *, V>`) stays legal;
                   the unsupported *suffix on a type parameter* is detected by
                   the caller once the whole spelling is known (L33-5). */
                if (n + 2 >= cap)
                    return self->sup->fail("an impl pattern is too long");
                n += snprintf(out + n, (size_t)(cap - n), "*");
                self->sup->lex_next();
            } else if (self->lex->tok == T_PUNCT
                       && (self->lex->tok_is("[") || self->lex->tok_is("]")
                           || self->lex->tok_is("(") || self->lex->tok_is(")")
                           || self->lex->tok_is("&"))) {
                *bad = 1;
                if (n + txl + 1 >= cap)
                    return self->sup->fail("an impl pattern is too long");
                self->lex->tok_copy(out + n, cap - n);
                n += txl;
                self->sup->lex_next();
            } else if (self->lex->tok == T_NUM) {
                /* An integer literal has no token text; the spelling is rebuilt
                   from the value and the suffix. */
                *bad = 1;
                if (n + 32 >= cap)
                    return self->sup->fail("an impl pattern is too long");
                n += snprintf(out + n, (size_t)(cap - n), "%ld%.*s",
                              self->lex->toknum, self->lex->toksuffix.len,
                              self->lex->toksuffix.ptr);
                self->sup->lex_next();
            } else {
                return self->sup->fail("expected a type in the impl pattern");
            }
        }
        return 0;
    }

    int parse_program(void)
    {
        int prog, n, base;
        (void)self;

        prog = self->sup->new_node(N_PROG);
        if (prog < 0) return -1;
        base = tool::diag::ct_diag_nsem();
        self->seen_decl = 0;
        self->ex->cur_unit = self->cur_unit;
        self->ex->build_mode = self->build_mode;
        self->ex->types_mode = &self->types_mode;
        self->ex->check_mode = self->check_mode;
        self->ex->narg_pos = 0;
        self->ex->arg_base = 0;
        /* SH-60 / D-60-2: the per-unit signature evidence starts empty; the
           prologue loop below records the unit's `#include` headers. */
        self->sup->map_sig_begin(self->unit_is_map);
        self->sup->lex_next();
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PP) {
                if (self->lex->toktrunc)
                    return tool::diag::ct_sem_error(self->lex->tokline, 1,
                        "preprocessor line exceeds 65536 bytes; split it or move it to a header",
                        self->mem->path);
                if (self->unit_is_map && self->lex->tok_prefix("#include"))
                    self->sup->map_include(self->lex->tok_cstr());
                if (self->c_strict && !self->unit_is_map
                    && pp_is(self->lex->tok_cstr(), "#ct-raw"))
                    return tool::diag::ct_sem_error(self->lex->tokline, 1,
                        "a strict C boundary forbids #ct-raw", self->mem->path);
                if (self->c_strict && !self->unit_is_map
                    && self->lex->tok_prefix("#define")) {
                    /* A function-like macro (`#define F(x) ...`) can drag
                       arbitrary C in through its expansion; only object-like
                       constants stay. C requires `(` right after the name. */
                    const char *d = self->lex->tokstr.ptr + 7;
                    const char *dend = self->lex->tokstr.ptr + self->lex->tokstr.len;
                    while (d < dend && (*d == ' ' || *d == '\t')) d++;
                    while (d < dend && ((*d >= 'a' && *d <= 'z') || (*d >= 'A' && *d <= 'Z')
                           || (*d >= '0' && *d <= '9') || *d == '_')) d++;
                    if (d < dend && *d == '(')
                        return tool::diag::ct_sem_error(self->lex->tokline, 1,
                            "a strict C boundary forbids function-like '#define';"
                            " use an object-like macro or <base>.shim.h",
                            self->mem->path);
                }
                if (self->c_strict && !self->unit_is_map
                    && self->lex->tok_prefix("#include")) {
                    const char *t = self->lex->tokstr.ptr + 8;
                    int tlen = self->lex->tokstr.len - 8;
                    const char *want;
                    while (tlen > 0 && (*t == ' ' || *t == '\t')) { t++; tlen--; }
                    want = runtime::text::ct_internf("\"%s.shim.h\"", self->c_base);
                    if (!want) return self->sup->fail("out of memory");
                    if (tlen != (int)strlen(want) || memcmp(t, want, (size_t)tlen) != 0)
                        return tool::diag::ct_sem_error(self->lex->tokline, 1,
                            "a strict C boundary forbids '#include';"
                            " use .m.ct or <base>.shim.h",
                            self->mem->path);
                }
                if (self->unit_is_map
                    && self->lex->tok_prefix("#define")) {
                    /* A mapping unit is the C boundary, but a function-like
                       macro would let a consumer pull arbitrary C in through
                       expansion; object-like constants stay (D65-4). */
                    const char *d = self->lex->tokstr.ptr + 7;
                    const char *dend = self->lex->tokstr.ptr + self->lex->tokstr.len;
                    while (d < dend && (*d == ' ' || *d == '\t')) d++;
                    while (d < dend && ((*d >= 'a' && *d <= 'z') || (*d >= 'A' && *d <= 'Z')
                           || (*d >= '0' && *d <= '9') || *d == '_')) d++;
                    if (d < dend && *d == '(')
                        return tool::diag::ct_sem_error(self->lex->tokline, 1,
                            "a strict .m.ct allows #include and object-like macros only",
                            self->mem->path);
                }
                if (self->unit_is_map
                    && !(self->lex->tok_prefix("#include")
                         || self->lex->tok_prefix("#define")))
                    return tool::diag::ct_sem_error(self->lex->tokline, 1,
                        "a .m.ct unit allows only #include and #define in its prologue;"
                        " put the C implementation in <base>.shim.h",
                        self->mem->path);
                if (pp_is(self->lex->tok_cstr(), "#ct-raw")) {
                    n = raw_text_node(self);
                    if (n < 0) return -1;
                    if (self->append_node(prog, n) != 0) return -1;
                    continue;
                }
                if (pp_is(self->lex->tok_cstr(), "#ct-endraw"))
                    return self->sup->fail_at(self->lex->tokline, "#ct-endraw without #ct-raw");
                n = self->sup->new_node(N_PP);
                if (n < 0) return -1;
                self->arena->nodes[n].text = runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len);
                if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                if (self->append_node(prog, n) != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID && self->lex->tok_is("import")) {
                /* Imports are the unit's leading declarations. Accepting one
                   here would drop it from `scan_imports` and leave a symbol
                   that never resolves, so name the move instead (SH-57). */
                if (self->seen_decl)
                    return self->sup->fail("imports must be at the top of the file;"
                                           " move this import above the first declaration");
                if (!*self->build_mode) {
                    /* Multi-file input is a build-mode feature (SH-55), so the
                       message names the way out instead of the mode it is in;
                       `ct check` is single-unit by design, which is why it
                       gets its own reason (D19-4, DOC-62). */
                    if (self->check_mode && *self->check_mode)
                        return self->sup->fail("'import' requires multi-file mode: use 'ct build'"
                                               " (ct check is single-unit)");
                    return self->sup->fail("'import' requires multi-file mode: use 'ct build'");
                }
                if (self->skip_import() != 0) return -1;
                continue;
            }
            if (self->lex->tok == T_ID && self->lex->tok_is("namespace")) {
                if (self->parse_namespace(prog) != 0) return -1;
                self->seen_decl = 1;
                continue;
            }
            /* Phase 38: a defer block has no file-scope meaning; diagnose it
               here instead of letting `top_decl` report a missing type. */
            if (self->lex->tok == T_ID && self->lex->tok_is("defer")) {
                const char *p = self->lex->src + self->lex->tokstart + 5;
                while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
                if (*p == '{')
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1,
                        "defer is only allowed inside a function", self->mem->path);
            }
            n = self->top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) {
                /* A reported error is recoverable: resynchronise and keep going
                   so one bad construct does not hide the rest of the file. A
                   parse failure without a diagnostic is still fatal. */
                if (tool::diag::ct_diag_nsem() == base) return -1;
                if (self->sup->skip_after_error() != 0) return -1;
                continue;
            }
            if (self->append_node(prog, n) != 0) return -1;
            self->seen_decl = 1;
        }
        /* errors leave the unit (and its artifacts) behind */
        if (check_generic_bounds(self) != 0) return -1;
        if (check_struct_bounds(self) != 0) return -1;
        if (check_trait_bounds(self) != 0) return -1;
        if (tool::diag::ct_diag_nsem() > base) return -1;
        return prog;
    }

    /* A function (prototype or definition) or a global variable. */
    int parse_func(int is_static, int is_pub, int is_extern)
    {
        int f, b, params, fi, func_line, func_col, ar, attr, lead, body_start;
        const char *ret;
        const char *name;
        const char *cname;
        const char *gns = "";
        char *tparam;
        const char *bound;
        char *gparam[1];
        int is_generic, ret_slice;
        (void)self;

        /* a leading attribute was captured by `top_decl`; it is this
           declaration's and must not leak into a later one */
        lead = self->pending_attr ? self->pending_attr - 1 : -1;
        self->pending_attr = 0;
        if (self->lex->tok == T_ID && self->lex->tok_is("errdefer")
            && self->st->errdefer_ahead())
            return tool::diag::ct_sem_error(self->lex->tokline, 1,
                "errdefer is not allowed here", self->mem->path);
        func_line = self->lex->tokline;
        func_col = self->lex->tokstart - self->lex->lstart + 1;
        self->ex->saw_atomic = 0;
        if (self->ex->parse_type_text(&ret) != 0) return -1;
        /* P-7.2: `T[] name(` is a function returning a slice (a view the
           caller must not outlive); `T[] name =` / `T[] name;` is a
           file-scope variable, refused below. The return position is legal
           because P-4.3 judges it through the return lint, not the placement
           matrix. */
        ret_slice = 0;
        {
            int sl, sc;
            if (self->sup->slice_brackets_ahead(&sl, &sc)) {
                self->sup->lex_next();
                if (self->sup->expect("]") != 0) return -1;
                ret_slice = 1;
                self->sup->note_slice();
                ret = "struct __ct_slice";
            }
        }
        if (self->ex->fnptr_state) {
            name = runtime::text::ct_intern(self->ex->fnptr_name);
            if (!name) return self->sup->fail("out of memory");
        } else {
            if (self->lex->tok != T_ID) return self->sup->fail("expected a name");
            name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!name) return self->sup->fail("out of memory");
            self->sup->lex_next();
        }
        /* `__ct_` names the compiler's own locals and closure products; a user
           declaration could otherwise collide with them in the generated C. */
        if (!strncmp(name, "__ct_", 5))
            return self->sup->fail("identifier '__ct_' is reserved for the compiler");
        /* Phase 26: one optional type parameter, written C-style after the name:
           `T id<T>(T x)`. The template is parsed in place; instances are
           monomorphised at the call site (D26-1/D26-2). */
        is_generic = 0;
        tparam = 0;
        bound = "";
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
            /* Phase 34 (O1): L26-2 lifted — `pub T id<T>(T x)` is legal.
               Template body must live in a `.h.ct` header; the `.ct` import
               rule (only a .h.ct unit can be imported) already enforces the
               visibility contract, so no new diagnostic is needed. */
            self->sup->lex_next();
            if (self->lex->tok != T_ID)
                return self->sup->fail("expected a type parameter name");
            tparam = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
            if (!tparam) return self->sup->fail("out of memory");
            snprintf(tparam, TEXT_LIMIT, "%.*s", self->lex->tokstr.len,
                     self->lex->tokstr.ptr);
            self->sup->lex_next();
            /* Phase 28 (D28-1): one optional trait bound, written C++-style
               between the parameter and `>`: `T max2<T: Compare>(T a, T b)`.
               The trait is resolved and validated here, so the template body
               and every instance work from one checked spelling. */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                const char *raw;
                int bline, bcol, bi;
                self->sup->lex_next();
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a trait name after ':'");
                bline = self->lex->tokline;
                bcol = self->lex->tokstart - self->lex->lstart + 1;
                raw = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                   self->lex->tokstr.len);
                if (!raw) return self->sup->fail("out of memory");
                self->sup->lex_next();
                bound = self->sym->resolve_type_text(raw);
                if (!bound) return self->sup->fail("out of memory");
                bi = self->sym->find_trait(bound);
                if (bi < 0 && strcmp(bound, "Drop") != 0 && strcmp(bound, "Handback") != 0)
                    return tool::diag::ct_sem_error(bline, bcol,
                        tool::sh::ct_scratch_fmt(
                            "unknown trait '%s' in a generic bound", raw),
                        self->mem->path);
                /* L28-3: a `.m.ct` static trait has no vtable slot, and the two
                   built-in traits have no vtable at all; a bound would emit a
                   symbol nobody defines. */
                if ((bi >= 0 && self->sym->traits[bi].is_static)
                    || strcmp(bound, "Drop") == 0 || strcmp(bound, "Handback") == 0)
                    return tool::diag::ct_sem_error(bline, bcol,
                        tool::sh::ct_scratch_fmt(
                            "trait '%s' cannot bound a type parameter", raw),
                        self->mem->path);
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("+"))
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1,
                        "only one trait bound is supported", self->mem->path);
                /* Phase 35 S4 (D35-4): `T: Iter<int>` names an instance. The
                   bound is stored under its encoded name, so the dispatch in a
                   bounded body finds the very row the impl filled. */
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                    char *bbuf;
                    if (bi < 0)
                        return self->sup->fail("unknown trait in a generic bound");
                    bbuf = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
                    if (!bbuf) return self->sup->fail("out of memory");
                    snprintf(bbuf, TEXT_LIMIT, "%s", bound);
                    if (parse_trait_inst_args(self, bbuf, TEXT_LIMIT) < 0) return -1;
                    bound = runtime::text::ct_intern(bbuf);
                    if (!bound) return self->sup->fail("out of memory");
                }
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(","))
                return self->sup->fail("only one type parameter is supported");
            if (self->lex->tok != T_PUNCT || !self->lex->tok_is(">"))
                return self->sup->fail("expected '>' after the type parameter");
            self->sup->lex_next();
            is_generic = 1;
            /* A bare `T` return type was resolved as the same-named tag before
               the type parameter was known; restore it now (SH-63). */
            if (self->ex->last_bare_tag[0]) {
                int ll = (int)strlen(self->ex->last_bare_tag);
                int tl = (int)strlen(tparam);
                if (ll > tl && self->ex->last_bare_tag[ll - tl - 1] == ' '
                    && strcmp(self->ex->last_bare_tag + ll - tl, tparam) == 0
                    && strncmp(ret, self->ex->last_bare_tag, (size_t)ll) == 0) {
                    ret = runtime::text::ct_internf("%s%s", tparam, ret + ll);
                    if (!ret) return self->sup->fail("out of memory");
                }
            }
        }
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is("(")) {
            int g, e;
            /* P-7.2 (P-4.1): a file-scope variable would outlive the view it
               stores. A function return type is judged by the return lint. */
            if (ret_slice)
                return tool::diag::ct_sem_error(func_line, func_col,
                    "a slice 'T[]' cannot be a file-scope variable; keep it a local or a parameter",
                    self->mem->path);
            /* A namespaced global is emitted under a prefixed C name, the same
               rule `pub` functions follow; `extern` is exempt because the symbol
               belongs to the C library and keeps its own spelling. `gns` is the
               underscore form a qualified reference matches (`a_b`). */
            if (is_extern || !self->sym->ns || !self->sym->ns[0]) {
                cname = runtime::text::ct_intern(name);
                gns = "";
            } else {
                /* S1a-0 C2p: the namespace is a pool text, so its underscore
                   form is one too -- the old `gns[160]` cut a declaration in a
                   namespace longer than 159 bytes, and a qualified reference
                   could then no longer match it. */
                size_t nl;
                cname = runtime::text::ct_intern_join(self->sym->ns, name);
                if (!cname) return self->sup->fail("out of memory");
                nl = strlen(self->sym->ns);
                gns = runtime::text::ct_intern_len(self->sym->ns, (int)nl - 1);
                if (!gns) return self->sup->fail("out of memory");
            }
            if (!cname) return self->sup->fail("out of memory");
            g = self->sup->new_node(N_GLOBAL);
            if (g < 0) return -1;
            self->arena->nodes[g].text = ret;
            self->arena->nodes[g].text2 = runtime::text::ct_intern(name);
            if (!self->arena->nodes[g].text2) return self->sup->fail("out of memory");
            self->arena->nodes[g].aux = is_static;
            self->arena->nodes[g].d = is_pub;
            self->arena->nodes[g].line = func_line;
            /* a file-scope name is visible to every function body */
            if (self->sym->declare_global(name, ret, cname, gns, 0) < 0)
                return self->sup->fail(self->sym->last_error());
            if (self->ex->fnptr_state && self->ex->fnptr_dims[0]) {
                    self->arena->nodes[g].text3 = runtime::text::ct_intern(self->ex->fnptr_dims);
                    if (!self->arena->nodes[g].text3) return self->sup->fail("out of memory");
            }
            {
                int dim_line = self->lex->tokline;
                int dim_col = self->lex->tokstart - self->lex->lstart + 1;
                if (self->ex->parse_array_dims(g) != 0) return -1;
                if (self->arena->nodes[g].text3[0]) {
                    int vi = self->sym->find_var(name);
                    if (vi >= 0) {
                        /* V29-4e: a file-scope array is an array too. The
                           subscript checker counts dimensions from `is_array`,
                           so leaving it clear made `Vec<int> g[2]; g[0]` look
                           like indexing a container value. */
                        self->sym->vars[vi].is_array = 1;
                        self->sym->vars[vi].dims =
                            runtime::text::ct_intern(self->arena->nodes[g].text3);
                        if (!self->sym->vars[vi].dims)
                            return self->sup->fail("out of memory");
                    }
                }
                /* Phase 24 L24-10: same check as the block-scope declarator */
                if (strchr(self->arena->nodes[g].text3, '$'))
                    return tool::diag::ct_sem_error(dim_line, dim_col,
                                                    "'$' cannot be used in an array dimension",
                                                    self->mem->path);
            }
            attr = -1;
            ar = self->sup->attr_pool(&attr);
            if (ar < 0) return -1;
            if (lead >= 0) {
                if (attr >= 0)
                    return self->sup->fail("duplicate __attribute__ on one declaration");
                attr = lead;
            }
            if (attr >= 0) self->arena->nodes[g].attr = attr;
            if (self->sup->accept("=")) {
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                    /* A keyword or message table is easily longer than the
                       `text` field, so the rewritten initialiser is copied into
                       the arena string pool; `aux = 1` records that and `num`
                       holds the offset (see `emit_raw_init`). */
                    char *raw;
                    char *fixed;
                    int off, k, fixedcap;
                    /* V29-4: a Vec / Map has no C aggregate initializer. */
                    if (self->ex->container_global_init_check(ret) != 0) return -1;
                    e = self->sup->new_node(N_RAW);
                    if (e < 0) return -1;
                    {
                        /* SH-115: the same literal-item judgement as a local
                           declaration; the `{` keeps its own source position. */
                        int bl = self->lex->tokline;
                        int bc = self->lex->tokstart - self->lex->lstart + 1;
                        if (self->sup->init_raw(&raw) != 0) return -1;
                        if (self->ex->chk_brace_init(ret, raw, bl, bc) != 0)
                            return -1;
                    }
                    fixed = (char *)0;
                    fixedcap = 0;
                    if (self->sup->rewrite_init_text(ret, raw, &fixed, &fixedcap) != 0) {
                        free(fixed);
                        return -1;
                    }
                    off = self->arena->str_begin();
                    for (k = 0; fixed[k]; k++)
                        if (self->arena->str_put(fixed[k]) != 0) {
                            free(fixed);
                            return self->sup->fail("initializer is too long");
                        }
                    self->arena->str_end();
                    free(fixed);
                    self->arena->nodes[e].num = off;
                    self->arena->nodes[e].aux = 1;
                } else if (self->st->range_init_ahead()) {
                    /* Phase 24: file-scope `= 0..n($…)` -- the global branch
                       parses its own initialiser, so it needs its own entry. */
                    e = self->st->parse_range_init(g, ret);
                    if (e < 0) return -1;
                } else {
                    e = self->ex->parse_expr();
                    if (e < 0) return -1;
                    /* D-029: a file-scope function-pointer initializer follows
                       the same signature rule as a local one. */
                    if (self->ex->fnptr_sig_check(ret, e, func_line, func_col) != 0)
                        return -1;
                    /* PH-80: a file-scope `String g = "x"` / `Str g = "x"` is
                       the same literal binding as a local declaration. */
                    if (self->ex->lit_coerce(ret, e) != 0) return -1;
                }
                /* LANG-22: a file-scope `Str` / `U16Str` stores a view that
                   outlives every frame; only an immortal literal, a view of
                   another global / static, or a caller-owned view is safe. */
                if (e >= 0
                    && self->sup->str_store_warn(e, ret, func_line, func_col) != 0)
                    return -1;
                self->arena->nodes[g].a = e;
            }
            /* E2 at file scope: the environment would die with the call that
               created it while the global outlives every frame. `.h.ct` units
               reach the same rule through a `pub` global, so this also keeps a
               closure out of the header. */
            if (self->arena->nodes[g].a >= 0
                && self->st->closure_global_init(self->arena->nodes[g].a, name,
                                                 func_line, func_col) != 0)
                return -1;
            if (self->sup->expect(";") != 0) return -1;
            return g;
        }
        if (self->ex->saw_atomic)
            return tool::diag::ct_sem_error(func_line, func_col,
                "an atomic value cannot be a return type", self->mem->path);
        /* D-029: the functor sugar is a function-pointer type, and a C
           function cannot return one. The spelling `(A,B) => R ret` used as a
           return type would otherwise emit `R (*)(A, B) f(...)`, which is not
           C. A file-scope function-pointer *variable* took the branch above. */
        if (strstr(ret, "(*)"))
            return tool::diag::ct_sem_error(func_line, func_col,
                "a function cannot return a function pointer; use a struct field or an 'out' parameter",
                self->mem->path);
        if (self->sup->push_scope() != 0) return -1;
        /* Parameter types written bare `T` must read as the type parameter,
           even when a struct/union/enum with that tag exists (SH-63). */
        if (is_generic) {
            gparam[0] = tparam;
            self->ex->in_generic_tparam = gparam;
            self->ex->in_generic_ntparam = 1;
        }
        params = self->parse_params();
        if (is_generic) {
            self->ex->in_generic_tparam = 0;
            self->ex->in_generic_ntparam = 0;
        }
        if (params < 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* the trailing GNU attribute belongs to the declaration, not to the
           parameter list, so `void f(void) __attribute__((noreturn));` and the
           definition form both land here */
        attr = -1;
        ar = self->sup->attr_pool(&attr);
        if (ar < 0) {
            self->sup->pop_scope();
            return -1;
        }
        if (lead >= 0) {
            if (attr >= 0) {
                self->sup->pop_scope();
                return self->sup->fail("duplicate __attribute__ on one declaration");
            }
            attr = lead;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(";")) {
            self->sup->lex_next();
            /* A template without a body cannot be monomorphised in this unit. */
            if (is_generic) {
                self->sup->pop_scope();
                return self->sup->fail("a generic function needs a definition in this unit");
            }
            fi = self->sup->add_func(name, ret, is_static, is_extern ? 0 : is_pub, params);
            if (fi < 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (attr >= 0) self->sym->fn_at(fi)->attr = attr;
            /* `extern` names a C library symbol: never mangled, even when the
               prototype is exported to the header */
            if (is_extern && is_pub) self->sym->fn_at(fi)->is_pub = 1;
            self->sym->fn_at(fi)->variadic = self->variadic;
            self->sym->fn_at(fi)->line = func_line;
            self->sup->pop_scope();
            return NO_NODE;
        }
        self->sym->ret_type = ret;
        self->cur_func = name;
        /* the body is the leak analysis window; its own scope is the frame a
           deeper return counts as conditional against */
        self->mem->leak_active = 1;
        self->mem->leak_frame = self->sym->nscope + 1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->st->func_begin();
        /* Phase 26: a generic call inside the template body has no instance
           yet, so the body may not contain one (L26-5). The expression layer
           reads this flag at the `<type>` call form. */
        if (is_generic) self->ex->in_generic = 1;
        if (is_generic) {
            gparam[0] = tparam;
            self->ex->in_generic_tparam = gparam;
            self->ex->in_generic_ntparam = 1;
        }
        if (is_generic) {
            self->ex->in_generic_bound = runtime::text::ct_intern(bound);
            if (!self->ex->in_generic_bound) return self->sup->fail("out of memory");
        }
        body_start = self->arena->nnode;
        b = self->st->parse_block();
        if (is_generic) self->ex->in_generic = 0;
        if (is_generic) {
            self->ex->in_generic_tparam = 0;
            self->ex->in_generic_ntparam = 0;
        }
        if (is_generic) self->ex->in_generic_bound = "";
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->cur_func = "";
        self->sym->ret_type = "";
        if (b < 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* Phase 78 S2a: every `out` parameter must be assigned on every path
           that leaves the function. This runs for `ct check` and `ct build`
           alike; the walk is L1 (straight line + if/else exact, loops/switch/
           goto conservative). */
        if (self->out_check_body(b, params, func_line) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* labels are function-scoped: the goto table is judged once the whole
           body has been seen (a label may follow its `goto`) */
        if (self->st->func_end() != 0) {
            self->sup->pop_scope();
            return -1;
        }
        fi = self->sup->add_func(name, ret, is_static, is_pub, params);
        if (fi < 0) {
            self->sup->pop_scope();
            return -1;
        }
        if (attr >= 0) self->sym->fn_at(fi)->attr = attr;
        self->sym->fn_at(fi)->ret_owned = self->mem->ret_owned;
        self->sym->fn_at(fi)->variadic = self->variadic;
        self->sym->fn_at(fi)->line = func_line;
        if (is_generic) {
            self->sym->fn_at(fi)->ntparams = 1;
            self->sym->fn_at(fi)->is_static = 1;   /* D26-4: instances stay in this unit */
            self->sym->fn_at(fi)->tparam = runtime::text::ct_intern(tparam);
            if (!self->sym->fn_at(fi)->tparam) return self->sup->fail("out of memory");
            self->sym->fn_at(fi)->bound = runtime::text::ct_intern(bound);
            if (!self->sym->fn_at(fi)->bound) return self->sup->fail("out of memory");
        }
        f = self->sup->new_node(N_FUNC);
        if (f < 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sym->fn_at(fi)->body = f;
        self->arena->nodes[f].text = runtime::text::ct_intern(ret);
        if (!self->arena->nodes[f].text) return self->sup->fail("out of memory");
        /* the C spelling only: `cur_func` and the map keep the short name */
        self->arena->nodes[f].text2 = runtime::text::ct_intern(self->sym->fn_at(fi)->cname);
        if (!self->arena->nodes[f].text2) return self->sup->fail("out of memory");
        self->arena->nodes[f].aux = is_generic ? 1 : is_static;
        self->arena->nodes[f].d = is_pub;
        self->arena->nodes[f].line = func_line;
        self->arena->nodes[f].attr = attr;
        if (is_generic) {
                self->arena->nodes[f].text3 = runtime::text::ct_intern(tparam);
                if (!self->arena->nodes[f].text3) return self->sup->fail("out of memory");
        }
        self->arena->nodes[f].a = params;
        self->arena->nodes[f].b = b;
        self->arena->nodes[f].c = self->variadic;
        /* REQ-MEM-2 S7-c: the body's node range is exactly what this
           definition allocated, so the write summary needs no second AST
           walker. The local symbol table is still live here, which is what
           tells a global from a local on the store's left-hand side. */
        if (frontend::parse::mem2_scan_function(self->arena, self->sym, fi,
                                                params, body_start,
                                                self->arena->nnode) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        if (self->st->uninit_check(b, func_line) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        if (self->st->missing_return_check(b, ret, func_line) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sup->pop_scope();
        return f;
    }

    /* Phase 78 S2a: L1 definite assignment for `out` parameters.
       Straight-line statements and if/else are exact; loops, switch and goto
       are conservative -- an assignment inside them never proves the value
       after the construct, and a `goto` ends the path it is on. Assignments
       are only recognised on an `out` parameter's own N_VAR node (`aux == 3`),
       so assigning a shadow with the same name does not count. */
    int out_index(const char *nm)
    {
        int i;
        for (i = 0; i < self->nout; i++)
            if (strcmp(self->out_names[i], nm) == 0) return i;
        return -1;
    }

    int out_report(int mask, int line)
    {
        int i;
        for (i = 0; i < self->nout; i++)
            if ((mask & (1 << i)) == 0) {
                char msg[320];
                snprintf(msg, sizeof msg,
                         "out parameter '%s' is not assigned on every path",
                         self->out_names[i]);
                return tool::diag::ct_sem_error(line, 1, msg, self->mem->path);
            }
        return 0;
    }

    int out_scan_chain(int n, int *mask)
    {
        int r;
        for (; n >= 0; n = self->arena->nodes[n].next) {
            r = self->out_scan(n, mask);
            if (r != 0) return r;
        }
        return 0;
    }

    int out_scan(int n, int *mask)
    {
        int k, i, r, m0, tm, em, all;

        if (n < 0) return 0;
        all = (1 << self->nout) - 1;
        k = self->arena->nodes[n].kind;
        /* every `return` is an exit: its expression is evaluated first, then
           every out value must be set on that path */
        if (k == N_RET) {
            if (self->out_scan(self->arena->nodes[n].a, mask) < 0) return -1;
            if (*mask != all) return self->out_report(*mask, self->arena->nodes[n].line);
            return 1;
        }
        if (k == N_BLOCK) return self->out_scan_chain(self->arena->nodes[n].a, mask);
        if (k == N_IF) {
            /* The condition always runs, so an assignment in it is exact. */
            if (self->out_scan(self->arena->nodes[n].a, mask) < 0) return -1;
            m0 = *mask;
            tm = m0;
            r = self->out_scan(self->arena->nodes[n].b, &tm);
            if (r < 0) return -1;
            if (self->arena->nodes[n].c >= 0) {
                em = m0;
                i = self->out_scan(self->arena->nodes[n].c, &em);
                if (i < 0) return -1;
                *mask = tm & em;
                return (r == 1 && i == 1) ? 1 : 0;
            }
            /* no else: the false path carries the condition's assignments */
            *mask = m0;
            return 0;
        }
        if (k == N_ASSIGN) {
            int lhs = self->arena->nodes[n].a;
            /* the right side is evaluated first (`x = (y = 1)`) */
            if (self->out_scan(self->arena->nodes[n].b, mask) < 0) return -1;
            if (lhs >= 0 && self->arena->nodes[lhs].kind == N_VAR
                && self->arena->nodes[lhs].aux == 3) {
                i = self->out_index(self->arena->nodes[lhs].text2);
                if (i >= 0) *mask = *mask | (1 << i);
            }
            return 0;
        }
        if (k == N_DECL) {
            /* `int y = (x = 1);` -- the initialiser runs, the declared name is
               not an out parameter. */
            return self->out_scan(self->arena->nodes[n].a, mask) < 0 ? -1 : 0;
        }
        if (k == N_DECLS) return self->out_scan_chain(self->arena->nodes[n].a, mask);
        if (k == N_EXPR || k == N_LABEL || k == N_DEFER_RUN || k == N_CASE)
            return self->out_scan_chain(self->arena->nodes[n].a, mask);
        if (k == N_MATSEQ) {
            /* PH-76: `{ x = call; … }` is one statement; both halves run. */
            if (self->out_scan_chain(self->arena->nodes[n].a, mask) < 0) return -1;
            return self->out_scan(self->arena->nodes[n].b, mask) < 0 ? -1 : 0;
        }
        if (k == N_BIN && self->arena->nodes[n].aux == 19) {
            /* a comma statement runs left to right; short-circuit operators
               are deliberately not modelled (L1 limitation) */
            if (self->out_scan(self->arena->nodes[n].a, mask) < 0) return -1;
            return self->out_scan(self->arena->nodes[n].b, mask) < 0 ? -1 : 0;
        }
        if (k == N_TERN) {
            if (self->out_scan(self->arena->nodes[n].a, mask) < 0) return -1;
            m0 = *mask;
            tm = m0;
            if (self->out_scan(self->arena->nodes[n].b, &tm) < 0) return -1;
            em = m0;
            if (self->out_scan(self->arena->nodes[n].c, &em) < 0) return -1;
            *mask = tm & em;
            return 0;
        }
        /* Loops may run zero times: scan them for returns (with the incoming
           set) but never let their assignments flow out. */
        if (k == N_WHILE || k == N_FOR || k == N_DOWHILE || k == N_LOOP
            || k == N_FOREACH) {
            m0 = *mask;
            tm = m0;
            if (self->out_scan(self->arena->nodes[n].a, &tm) < 0) return -1;
            if (self->out_scan(self->arena->nodes[n].b, &tm) < 0) return -1;
            if (self->out_scan(self->arena->nodes[n].c, &tm) < 0) return -1;
            if (self->out_scan(self->arena->nodes[n].d, &tm) < 0) return -1;
            *mask = m0;
            return 0;
        }
        if (k == N_SWITCH) {
            int blk, c, seq;
            if (self->out_scan(self->arena->nodes[n].a, mask) < 0) return -1;
            m0 = *mask;
            blk = self->arena->nodes[n].b;
            seq = m0;
            /* Each case is its own entry path and a `break` inside one case
               must not hide the later cases' returns. */
            c = (blk >= 0) ? self->arena->nodes[blk].a : -1;
            for (; c >= 0; c = self->arena->nodes[c].next) {
                if (self->arena->nodes[c].kind == N_CASE) {
                    tm = m0;
                    r = self->out_scan_chain(self->arena->nodes[c].a, &tm);
                } else {
                    r = self->out_scan(c, &seq);
                }
                if (r < 0) return -1;
            }
            *mask = m0;
            return 0;
        }
        if (k == N_GOTO) {
            /* A jump may land after assignments this linear walk cannot see,
               so the conservative rule is: the values must already be set at
               the jump itself. */
            if (*mask != all) return self->out_report(*mask, self->arena->nodes[n].line);
            return 1;
        }
        if (k == N_BREAK || k == N_CONT) return 1;
        /* Anything else (a value expression, a declaration wrapper) carries no
           definite assignment for an `out` parameter at this L1 level. */
        return 0;
    }

    int out_check_body(int body, int params, int line)
    {
        int p, mask, r, all;

        self->nout = 0;
        for (p = params; p > 0; p = self->arena->nodes[p].next)
            if (self->arena->nodes[p].aux == 3 && self->nout < 16)
                self->out_names[self->nout++] = self->arena->nodes[p].text2;
        if (self->nout == 0 || body < 0) return 0;
        all = (1 << self->nout) - 1;
        mask = 0;
        r = self->out_scan(body, &mask);
        if (r < 0) return -1;
        if (mask != all) return self->out_report(mask, line);
        return 0;
    }

    int parse_params(void)
    {
        int first, tail, p, ar, ao;
        int seen_borrow, seen_ref, seen_out, bline, bcol;
        int is_slice, slice_const, slice_line, slice_col;
        const char *slice_elem = "";
        const char *typebuf;
        const char *parsed;
        const char *name;
        (void)self;

        self->nparams = 0;
        self->variadic = 0;
        first = 0;
        tail = 0;
        if (self->sup->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
            self->sup->lex_next();
            return 0;
        }
        for (;;) {
            /* `...` closes the list: C requires at least one named parameter
               before it, and it is not a parameter of its own */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("...")) {
                if (self->nparams == 0)
                    return self->sup->fail("'...' needs a named parameter before it");
                self->variadic = 1;
                self->sup->lex_next();
                break;
            }
            /* `borrow` is a contextual keyword: as the first token of a
               parameter it can only be the annotation, never a type name */
            seen_borrow = 0;
            seen_ref = 0;
            seen_out = 0;
            bline = self->lex->tokline;
            bcol = self->lex->tokstart - self->lex->lstart + 1;
            if (self->lex->tok == T_ID && self->lex->tok_is("borrow")) {
                seen_borrow = 1;
                self->sup->lex_next();
            } else if (self->lex->tok == T_ID && self->lex->tok_is("ref")) {
                /* `ref` / `out` are contextual: only the first token of a
                   parameter list entry is the annotation, so `int out;`,
                   `time_t *ref;` and a parameter named `out` stay identifiers. */
                seen_ref = 1;
                self->sup->lex_next();
            } else if (self->lex->tok == T_ID && self->lex->tok_is("out")) {
                seen_out = 1;
                self->sup->lex_next();
            }
            if (self->ex->parse_type_text(&parsed) != 0) return -1;
            typebuf = parsed;
            /* P-7.2: `T[] name` is a slice parameter. Its C storage is the
               erased `struct __ct_slice`; the element spelling travels in the
               symbol row. Parameters are allowed placements (A.4). */
            is_slice = 0;
            slice_const = 0;
            slice_line = self->lex->tokline;
            slice_col = self->lex->tokstart - self->lex->lstart + 1;
            if (self->sup->slice_brackets_ahead(&slice_line, &slice_col)) {
                self->sup->lex_next();
                if (self->sup->expect("]") != 0) return -1;
                is_slice = 1;
                self->sup->note_slice();
                slice_elem = typebuf;
                if (strncmp(slice_elem, "const ", 6) == 0) {
                    slice_const = 1;
                    slice_elem += 6;
                }
                typebuf = "struct __ct_slice";
            }
            if (self->ex->fnptr_state) {
                /* the declarator name came with the type (`int (*cb)(void *)`) */
                name = self->ex->fnptr_name;
            } else {
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(")") &&
                    strcmp(typebuf, "void") == 0) {
                    self->sup->lex_next();
                    return 0;
                }
                if (self->lex->tok != T_ID) return self->sup->fail("expected a parameter name");
                name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                    self->lex->tokstr.len);
                if (!name) return self->sup->fail("out of memory");
                self->sup->lex_next();
            }
            /* C would adjust `int (*tbl[2])(int)` into a pointer to a pointer,
               which the abstract declarator the prototype spells cannot express */
            if (self->ex->fnptr_state && self->ex->fnptr_dims[0])
                return self->sup->fail("function-pointer arrays are not supported as parameters");
            p = self->sup->new_node(N_PARAM);
            if (p < 0) return -1;
            self->arena->nodes[p].text = typebuf;
            self->arena->nodes[p].text2 = runtime::text::ct_intern(name);
            if (!self->arena->nodes[p].text2) return self->sup->fail("out of memory");
            if (seen_ref) self->arena->nodes[p].aux = 2;
            else if (seen_out) self->arena->nodes[p].aux = 3;
            if (self->ex->parse_array_dims(p) != 0) return -1;
            /* D-029: the functor sugar is the same abstract declarator as a
               hand-written function pointer, so its array shape is refused by
               the same parameter rule. */
            if (strstr(typebuf, "(*)") && self->arena->nodes[p].text3[0])
                return self->sup->fail("function-pointer arrays are not supported as parameters");
            /* The pointer form is a scalar C parameter; an array or function
               pointer declarator cannot be spelled `T *` without changing the
               meaning, so both shapes are refused here. */
            if ((seen_ref || seen_out)
                && (self->arena->nodes[p].text3[0] || self->ex->fnptr_state
                    || strstr(typebuf, "(*)")))
                return self->sup->fail("ref/out parameters cannot be arrays or function pointers");
            if (seen_ref && seen_borrow)
                return self->sup->fail("a parameter cannot be both 'borrow' and 'ref'");
            if (seen_out && seen_borrow)
                return self->sup->fail("a parameter cannot be both 'borrow' and 'out'");
            if (self->sup->declare_var(name, typebuf) != 0) return -1;
            {
                int vi = self->sym->find_var(name);
                if (vi >= 0) {
                    self->sym->vars[vi].is_fnparam = 1;
                    self->sym->vars[vi].ref_param = seen_ref;
                    self->sym->vars[vi].out_param = seen_out;
                    /* `out` starts without a value; a normal or `ref`
                       parameter is bound by the caller. */
                    self->sym->vars[vi].initialized = seen_out ? 0 : 1;
                    if (is_slice) {
                        self->sym->vars[vi].is_slice = 1;
                        self->sym->vars[vi].slice_elem =
                            runtime::text::ct_intern(slice_elem);
                        if (!self->sym->vars[vi].slice_elem)
                            return self->sup->fail("out of memory");
                        self->sym->vars[vi].slice_const = slice_const;
                    }
                }
            }
            if (self->arena->nodes[p].text3[0]) {
                int vi = self->sym->find_var(name);
                if (vi >= 0) {
                    self->sym->vars[vi].is_array = 1;
                    self->sym->vars[vi].dims =
                        runtime::text::ct_intern(self->arena->nodes[p].text3);
                    if (!self->sym->vars[vi].dims)
                        return self->sup->fail("out of memory");
                }
            }
            /* the annotation never reaches the C text: only the symbol table
               learns that this parameter is lent */
            if (seen_borrow && check_borrow_param(self, p, bline, bcol) != 0)
                return -1;
            /* S7-c: carry `borrow` on the N_PARAM row too (1 is the value the
               trait-method parser already uses). `add_func` copies it into
               `Fn.pann`, where the call-site judge reads it. 2 / 3 stay
               `ref` / `out`. */
            if (seen_borrow) self->arena->nodes[p].aux = 1;
            /* a trailing attribute belongs to the parameter (`int *p
               __attribute__((nonnull))`), so it rides with its name/dims */
            ao = -1;
            ar = self->sup->attr_pool(&ao);
            if (ar < 0) return -1;
            if (ao >= 0) self->arena->nodes[p].attr = ao;
            if (tail == 0) first = p;
            else self->arena->nodes[tail].next = p;
            tail = p;
            self->nparams++;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->sup->expect(")") != 0) return -1;
        return first;
    }

    /* Does the current token open a body-less record member (`union { … };`)?
       The lexer has no peek, so the state is saved, the next token is read and
       everything is put back -- including the line bookkeeping, because the
       node built afterwards takes its line from the cursor. */
    int record_body_ahead(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, r;
        long snum;
        const char *stext_ptr; int stext_len;
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        if (!self->lex->tok_is("struct") && !self->lex->tok_is("union")) return 0;
        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        stext_ptr = self->lex->tokstr.ptr; stext_len = self->lex->tokstr.len;
        self->sup->lex_next();
        r = (self->lex->tok == T_PUNCT && self->lex->tok_is("{"));
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokstr.ptr = stext_ptr; self->lex->tokstr.len = stext_len;
        return r;
    }

    /* Register one field, flattening an anonymous member (C11 6.7.2.1p13): its
       inner names join the enclosing record, so `o.i` and the vptr writers that
       build `.name.__x_vptr` need no second table. Two levels of nesting are the
       same walk, and a collision is what C would reject too. The row lands in
       the tag's table, or in `pend_fields` while the body has no tag. */
    /* S1a-0 C1: the pending-field list is a heap block; MAX_FIELDS is only
       its starting capacity. */
    int ensure_pend_fields(int need)
    {
        int cap;
        struct Field *grown;
        (void)self;
        if (need <= self->pendcap) return 0;
        cap = self->pendcap > 0 ? self->pendcap : MAX_FIELDS;
        while (cap < need && cap < CAP_LIMIT) cap *= 2;
        if (cap > CAP_LIMIT) cap = CAP_LIMIT;
        if (need > cap) return self->sup->fail("out of memory");
        grown = (struct Field *)realloc(self->pend_fields, (size_t)cap * sizeof(*grown));
        if (!grown) return self->sup->fail("out of memory");
        memset(grown + self->pendcap, 0, (size_t)(cap - self->pendcap) * sizeof(*grown));
        self->pend_fields = grown;
        self->pendcap = cap;
        return 0;
    }

    int register_field(int m)
    {
        int c, i, si;
        const char *nm;
        (void)self;

        if (self->arena->nodes[m].kind == N_FIELDS) {
            /* several declarators share one type: each name is its own row */
            for (c = self->arena->nodes[m].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->register_field(c) != 0) return -1;
            return 0;
        }
        if (self->arena->nodes[m].kind == N_FIELD && self->arena->nodes[m].aux == 2) {
            for (c = self->arena->nodes[m].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->register_field(c) != 0) return -1;
            return 0;
        }
        nm = self->arena->nodes[m].text2;
        if (!nm[0]) return 0;                       /* a nameless padding bit-field */
        if (self->sym->reserved_name(nm))
            return self->sup->fail("identifier '__ct_' is reserved for the compiler");
        if (self->cur_record && self->cur_record[0]) {
            si = self->sym->find_struct(self->cur_record);
            if (si < 0) return 0;
            for (i = 0; i < self->sym->structs[si].nfields; i++)
                if (strcmp(self->sym->structs[si].fields[i].name, nm) == 0)
                    return self->sup->fail_at(self->arena->nodes[m].line,
                        tool::sh::ct_scratch_fmt("duplicate member '%s'", nm));
            if (self->sym->ensure_struct_field_capacity(si,
                    self->sym->structs[si].nfields + 1) != 0) return -1;
            {
                self->sym->structs[si].fields[self->sym->structs[si].nfields].name =
                    runtime::text::ct_intern(nm);
                if (!self->sym->structs[si].fields[self->sym->structs[si].nfields].name)
                    return self->sup->fail("out of memory");
                self->sym->structs[si].fields[self->sym->structs[si].nfields].type =
                    runtime::text::ct_intern(self->arena->nodes[m].text);
                if (!self->sym->structs[si].fields[self->sym->structs[si].nfields].type)
                    return self->sup->fail("out of memory");
                self->sym->structs[si].fields[self->sym->structs[si].nfields].dims =
                    runtime::text::ct_intern(self->arena->nodes[m].text3);
                if (!self->sym->structs[si].fields[self->sym->structs[si].nfields].dims)
                    return self->sup->fail("out of memory");
                self->sym->structs[si].fields[self->sym->structs[si].nfields].line =
                    self->arena->nodes[m].line;
                self->sym->structs[si].fields[self->sym->structs[si].nfields].is_pub =
                    self->arena->nodes[m].d;
                self->sym->structs[si].fields[self->sym->structs[si].nfields].col =
                    (int)self->arena->nodes[m].num;
                self->sym->structs[si].fields[self->sym->structs[si].nfields].is_bitfield =
                    self->arena->nodes[m].aux == 1;
                self->sym->structs[si].nfields++;
            }
            return 0;
        }
        for (i = 0; i < self->npend; i++)
            if (strcmp(self->pend_fields[i].name, nm) == 0)
                return self->sup->fail_at(self->arena->nodes[m].line,
                    tool::sh::ct_scratch_fmt("duplicate member '%s'", nm));
        if (self->ensure_pend_fields(self->npend + 1) != 0) return -1;
        {
            self->pend_fields[self->npend].name = runtime::text::ct_intern(nm);
            if (!self->pend_fields[self->npend].name)
                return self->sup->fail("out of memory");
            self->pend_fields[self->npend].type =
                runtime::text::ct_intern(self->arena->nodes[m].text);
            if (!self->pend_fields[self->npend].type)
                return self->sup->fail("out of memory");
            self->pend_fields[self->npend].dims =
                runtime::text::ct_intern(self->arena->nodes[m].text3);
            if (!self->pend_fields[self->npend].dims)
                return self->sup->fail("out of memory");
            self->pend_fields[self->npend].line = self->arena->nodes[m].line;
            self->pend_fields[self->npend].is_pub = self->arena->nodes[m].d;
            self->pend_fields[self->npend].col = (int)self->arena->nodes[m].num;
            self->pend_fields[self->npend].is_bitfield = self->arena->nodes[m].aux == 1;
            self->npend++;
        }
        return 0;
    }

    /* The body of a record, from `{` to `}`; the caller owns the node. `reg`
       registers the rows as they are read -- an anonymous member's own body
       passes 0, because its names are promoted once, by the enclosing body's
       `register_field` walk. */
    int parse_record_body(int node, int reg)
    {
        int m, tail;
        (void)self;

        if (self->sup->expect("{") != 0) return -1;
        tail = -1;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            m = self->parse_field_def();
            if (m < 0) return -1;
            if (reg && self->register_field(m) != 0) return -1;
            if (tail < 0) self->arena->nodes[node].a = m;
            else self->arena->nodes[tail].next = m;
            tail = m;
        }
        if (self->sup->expect("}") != 0) return -1;
        return 0;
    }

    /* `union { … };` as a member: the keyword, a nameless body and the closing
       `;`. `text` keeps the keyword for emission and `a` the inner chain;
       `aux = 2` marks the form (`aux = 1` is a bit-field). The body is read
       with the *enclosing* `cur_record`, so its names promote into it. */
    int parse_anon_member(void)
    {
        int m;
        (void)self;

        m = self->sup->new_node(N_FIELD);
        if (m < 0) return -1;
        self->arena->nodes[m].text = runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len);
        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
        self->arena->nodes[m].aux = 2;
        self->sup->lex_next();
        if (self->parse_record_body(m, 0) != 0) return -1;
        if (self->arena->nodes[m].a < 0)
            return self->sup->fail("an anonymous record needs a member");
        if (self->lex->tok == T_ID)
            return self->sup->fail("an anonymous record member cannot have a name; tag the record instead");
        if (self->sup->expect(";") != 0) return -1;
        return m;
    }

    /* `<type> name[dims] [, name[dims]]* ;` — or, when a `:` follows, a bit-field
       `<type> [name] : <width>;`. A bit-field reuses this node: `aux = 1` marks
       it and `a` holds the width expression, so a width of `(1 << 2)` or a macro
       name emits as written. The width never reaches `text3`, which stays the
       array-dimension slot the type checker and the vptr writer read. A leading
       `:` means the field is nameless (padding). A `struct` / `union` followed
       by `{` is an anonymous member instead (`aux = 2`, D-6). Several
       declarators share one type (`size_t bstart, blen;`) and come back as an
       N_FIELDS wrapper, the way a local uses N_DECLS. */
    int parse_field_def(void)
    {
        int m, w, head, tail, count, ar, ao;
        const char *typebuf;
        const char *base;
        const char *firsttype;
        const char *name;
        size_t bl;
        (void)self;

        if (self->record_body_ahead()) return self->parse_anon_member();
        {
            int fpub = 0;
            if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                fpub = 1;
                self->sup->lex_next();
            }
            if (self->ex->parse_type_text(&typebuf) != 0) return -1;
            self->field_pub = fpub;
            /* P-7.2 (P-4.1): a struct field would outlive the view it stores,
               so `T[]` is a hard error here rather than a silent C struct. */
            {
                int sl, sc;
                const char *fb = typebuf;
                if (self->sup->slice_brackets_ahead(&sl, &sc))
                    return tool::diag::ct_sem_error(sl, sc,
                        "a slice 'T[]' cannot be a struct field; it is a non-owning view",
                        self->mem->path);
                /* PH-81 S1a: a borrowed `Str` / `U16Str` is a view, so a field
                   would outlive the bytes it borrows; this is the struct
                   declaration layer `Box<Bad>` relies on. */
                if (strncmp(fb, "struct ", 7) == 0) fb += 7;
                while (*fb == ' ' || *fb == '\t') fb++;
                if (strcmp(fb, "Str") == 0 || strcmp(fb, "U16Str") == 0)
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1,
                        "a borrowed 'Str' view cannot be a struct field; store an owning 'String' and call as_str() at the use site",
                        self->mem->path);
            }
        }
        /* the first declarator's stars are part of `typebuf`; later ones bring
           their own, so the base type is kept once (`int *a, b;` makes `b` an
           `int`, the same rule a local declaration follows) */
        firsttype = typebuf;
        bl = strlen(typebuf);
        while (bl > 0 && (typebuf[bl - 1] == '*' || typebuf[bl - 1] == ' ')) bl--;
        base = runtime::text::ct_intern_len(typebuf, (int)bl);
        if (!base) return self->sup->fail("out of memory");
        head = -1;
        tail = -1;
        count = 0;
        for (;;) {
            int stars = 0;
            if (self->ex->fnptr_state) {
                name = runtime::text::ct_intern(self->ex->fnptr_name);
                if (!name) return self->sup->fail("out of memory");
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                name = "";
            } else {
                if (count > 0) {
                    const char *t2;
                    while (self->lex->tok == T_PUNCT && self->lex->tok_is("*")) {
                        stars++;
                        self->sup->lex_next();
                    }
                    t2 = base;
                    while (stars > 0) {
                        t2 = runtime::text::ct_internf("%s *", t2);
                        if (!t2) return self->sup->fail("out of memory");
                        stars--;
                    }
                    typebuf = t2;
                }
                if (self->lex->tok != T_ID) return self->sup->fail("expected a field name");
                name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                    self->lex->tokstr.len);
                if (!name) return self->sup->fail("out of memory");
                self->field_col = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
            }
            m = self->sup->new_node(N_FIELD);
            if (m < 0) return -1;
            self->arena->nodes[m].text = typebuf;
            self->arena->nodes[m].text2 = name;
            self->arena->nodes[m].d = self->field_pub;
            self->arena->nodes[m].num = self->field_col;
            if (self->ex->fnptr_state && self->ex->fnptr_dims[0]) {
                    self->arena->nodes[m].text3 = runtime::text::ct_intern(self->ex->fnptr_dims);
                    if (!self->arena->nodes[m].text3) return self->sup->fail("out of memory");
            }
            if (self->ex->parse_array_dims(m) != 0) return -1;
            /* `int x __attribute__((aligned(8)));`: the attribute follows the
               declarator (and a bit-field's width is emitted before it) */
            ao = -1;
            ar = self->sup->attr_pool(&ao);
            if (ar < 0) return -1;
            if (ao >= 0) self->arena->nodes[m].attr = ao;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                if (self->arena->nodes[m].text3[0])
                    return self->sup->fail("a bit-field cannot be an array");
                /* C wants an integer; a pointer or a record spelled out here is
                   certainly wrong, while a typedef alias is left to the C compiler */
                if (strstr(typebuf, "*") || strncmp(typebuf, "struct ", 7) == 0
                    || strncmp(typebuf, "union ", 6) == 0)
                    return self->sup->fail("a bit-field must have an integer type");
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(";"))
                    return self->sup->fail("expected a bit-field width");
                w = self->ex->parse_expr();
                if (w < 0) return -1;
                /* the same constant rule a `case` label follows: a whole name is
                   allowed whether or not it is declared (it may be a macro) */
                if (!self->ex->const_ok(w) && self->arena->nodes[w].kind != N_VAR
                    && self->arena->nodes[w].kind != N_RAW)
                    return self->sup->fail("a bit-field width must be an integer constant");
                self->arena->nodes[m].aux = 1;
                self->arena->nodes[m].a = w;
            }
            if (head < 0) head = m;
            else self->arena->nodes[tail].next = m;
            tail = m;
            count++;
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(","))) break;
            if (self->ex->fnptr_state) return self->sup->fail("a function pointer declares one name");
            self->sup->lex_next();
            self->ex->fnptr_state = 0;
        }
        if (self->sup->expect(";") != 0) return -1;
        if (count == 1) return head;
        w = self->sup->new_node(N_FIELDS);
        if (w < 0) return -1;
        /* the wrapper carries the first declarator's spelling, stars included */
        self->arena->nodes[w].text = firsttype;
        self->arena->nodes[w].a = head;
        return w;
    }

    /* PH-82 (D-012): the only suppression form for the direct-cycle warning is
       the `ct: allow-cycle` marker on the struct declaration's own line. The
       lexer drops comments, so the check reads the source line back; anything
       else (a marker above the struct, or on a field's line) does not count. */
    int record_line_allows_cycle(int line)
    {
        const char *p = self->lex->src;
        const char *e;
        const char *m;
        int ln = 1;

        if (p == 0) return 0;
        while (*p) {
            e = p;
            while (*e && *e != '\n') e++;
            if (ln == line) {
                m = p;
                while (m + 15 <= e) {
                    if (strncmp(m, "ct: allow-cycle", 15) == 0) return 1;
                    m++;
                }
                return 0;
            }
            if (*e == 0) break;
            p = e + 1;
            ln++;
        }
        return 0;
    }

    /* `struct Name { ... }` (the trailing `;` is the caller's business). A
       `union` is the same record shape: the tags share the `structs` table so
       field chains and `offsetof` keep resolving, and they differ only in the
       emitted keyword, the type kind (`6`) and the fact that a union can carry
       no `use` clause (there is no vptr to append). */
    int parse_record_def(int is_union)
    {
        int s, struct_line, struct_col, allow_cycle, brace_line, brace_col, kind, ar, ao;
        int nt, templ;
        const char *name = "";
        const char *qname = "";
        /* S1a-0 C3: the parameter rows grow on demand (initial 2, formal cap
           65536); `tcap`/`bcap` are their capacities. */
        char **tparam = 0;
        char **bound = 0;
        int tcap = 0, bcap = 0;
        (void)self;

        nt = 0;
        templ = 0;
        struct_line = self->lex->tokline;
        struct_col = self->lex->tokstart - self->lex->lstart + 1;
        allow_cycle = self->record_line_allows_cycle(struct_line);
        brace_line = 0;
        brace_col = 1;
        kind = is_union ? N_UNION : N_STRUCT;
        self->sup->lex_next();
        if (self->lex->tok == T_ID) {
            name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!name) return self->sup->fail("out of memory");
            qname = self->sup->ns_decl_text(name);
            if (!qname) return -1;
            /* Phase 29 §2.5: the three container names belong to the built-in
               layer, so a user unit may not declare them again (L29-7). */
            if (strstr(self->mem->path, "lib/core/") == 0
                && strstr(self->mem->path, "lib/std/") == 0 /* DOC-87 迁移回退 */
                && (strcmp(name, "Vec") == 0 || strcmp(name, "Map") == 0
                    || strcmp(name, "MapEntry") == 0)) {
                char msg[MAX_TEXT * 2];
                snprintf(msg, sizeof msg,
                         "'%s' is a built-in type and cannot be redeclared", name);
                return tool::diag::ct_sem_error(struct_line, 1, msg, self->mem->path);
            }
            if (self->sup->add_type(qname, is_union ? 6 : 1) != 0) return -1;
            if (self->sup->add_struct(qname) < 0) return -1;
            self->sup->lex_next();
        }
        /* Phase 29/33: `struct Name<T[, U]>` -- at most two type parameters,
           each with one optional trait bound (`T: Show`). The bound is kept as
           written: a consumer unit may not see the trait's declaration, so the
           satisfaction check waits for the unit that instantiates (L33-6). */
        if (name[0] && !is_union && self->lex->tok == T_PUNCT
            && self->lex->tok_is("<")) {
            self->sup->lex_next();
            for (;;) {
                tparam = frontend::sym::ct_rows_reserve(tparam, tcap, nt + 1, &tcap);
                bound = frontend::sym::ct_rows_reserve(bound, bcap, nt + 1, &bcap);
                if (!tparam || tcap < nt + 1 || !bound || bcap < nt + 1)
                    return self->sup->fail("a generic struct has too many type parameters");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a type parameter name");
                self->lex->tok_copy(tparam[nt], MAX_TEXT);
                nt++;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                    const char *raw;
                    int bline, bcol, bi;
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a trait name after ':'");
                    bline = self->lex->tokline;
                    bcol = self->lex->tokstart - self->lex->lstart + 1;
                    raw = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                       self->lex->tokstr.len);
                    if (!raw) return self->sup->fail("out of memory");
                    self->sup->lex_next();
                    /* L28-3 (unchanged text): the two built-in traits carry no
                       vtable at all and a `.m.ct` static trait has no slot, so
                       a bound would name a symbol nobody defines. The check is
                       by name for the built-ins, whether or not the user has
                       declared a same-named trait. */
                    bi = self->sym->find_trait(raw);
                    if ((bi >= 0 && self->sym->traits[bi].is_static)
                        || strcmp(raw, "Drop") == 0 || strcmp(raw, "Handback") == 0)
                        return tool::diag::ct_sem_error(bline, bcol,
                            tool::sh::ct_scratch_fmt(
                                "trait '%s' cannot bound a type parameter", raw),
                            self->mem->path);
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("+"))
                        return tool::diag::ct_sem_error(self->lex->tokline,
                            self->lex->tokstart - self->lex->lstart + 1,
                            "a struct type parameter cannot carry more than one bound",
                            self->mem->path);
                    snprintf(bound[nt - 1], MAX_TEXT, "%s", raw);
                }
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
            if (self->lex->tok != T_PUNCT || !self->lex->tok_is(">"))
                return self->sup->fail("expected '>' after the type parameters");
            self->sup->lex_next();
            templ = 1;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(";")) {
            /* `struct X;` -- a forward declaration: the tag is registered above,
               so `struct X *p` parses; the body may follow later */
            if (templ) return self->sup->fail("a generic struct template needs a body");
            self->sup->lex_next();
            return NO_NODE;
        }
        /* A second body for an already-defined tag is a hard error; a forward
           declaration above it is fine. L2 reports it at the '{'. */
        if (qname[0]) {
            int ex = self->sym->find_struct(qname);
            if (ex >= 0 && self->sym->structs[ex].defined)
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    tool::sh::ct_scratch_fmt("duplicate %s '%s'",
                                             is_union ? "union" : "struct", name),
                    self->mem->path);
        }
        /* the body's `{` is where L2 reports an unresolved `use` trait */
        brace_line = self->lex->tokline;
        brace_col = self->lex->tokstart - self->lex->lstart + 1;
        s = self->sup->new_node(kind);
        if (s < 0) return -1;
        self->arena->nodes[s].line = struct_line;
        self->arena->nodes[s].text2 = qname;
        self->npend = 0;
        /* the fields of this body (and of any anonymous member inside it) are
           registered under `cur_record`; an untagged body leaves it empty */
        self->cur_record = qname;
        /* Phase 29: inside a template body `T`/`U` are types, the same way a
           generic function's parameter is handled (D26-4). */
        if (templ) {
            self->ex->in_generic_tparam = tparam;
            self->ex->in_generic_ntparam = nt;
        }
        if (self->parse_record_body(s, 1) != 0) {
            self->cur_record = "";
            self->ex->in_generic_tparam = 0;
            self->ex->in_generic_ntparam = 0;
            return -1;
        }
        self->cur_record = "";
        self->ex->in_generic_tparam = 0;
        self->ex->in_generic_ntparam = 0;
        if (is_union && self->lex->tok == T_ID && self->lex->tok_is("use"))
            return self->sup->fail("a union cannot use a trait");
        if (!is_union && self->lex->tok == T_ID && self->lex->tok_is("use")) {
            self->sup->lex_next();
            if (qname[0] && self->parse_use_list(self->sym->find_struct(qname)) != 0) return -1;
            /* every trait named in `use` must already be defined (the built-in
               Drop never joins the list); L2 reports the first miss at the
               struct's '{', so the remembered position is what is used here */
            if (qname[0]) {
                int si3, ui3;
                si3 = self->sym->find_struct(qname);
                if (si3 >= 0) {
                    for (ui3 = 0; ui3 < self->sym->structs[si3].nuse; ui3++) {
                        if (self->sym->find_trait(self->sym->structs[si3].use[ui3]) < 0)
                            return tool::diag::ct_sem_error(brace_line, brace_col,
                                tool::sh::ct_scratch_fmt(
                                    "struct '%s' uses undefined trait '%s'",
                                    name, self->sym->structs[si3].use[ui3]),
                                self->mem->path);
                    }
                }
            }
        }
        if (qname[0]) {
            int di = self->sym->find_struct(qname);
            if (di >= 0) {
                self->sym->structs[di].defined = 1;
                self->sym->structs[di].is_pub = self->decl_pub;
                self->sym->structs[di].line = struct_line;
                self->sym->structs[di].col = struct_col;
                self->sym->structs[di].allow_cycle = allow_cycle;
            }
            /* Phase 33 O3: remember the declaring unit, so a container named by
               another unit can tell whether the element's definition is visible
               in the container template's own unit. */
            if (di >= 0) self->sym->structs[di].owner = self->cur_unit;
        }
        /* Phase 29: publish the template build-wide, so a consumer unit that
           names `Stack<int>` can substitute the field spellings without ever
           parsing this body (the per-unit tables are reset between units). */
        if (templ && qname[0]) {
            int di, ti4, tn4, fi4, ui4;
            struct StructTmpl *tps;

            di = self->sym->find_struct(qname);
            ti4 = frontend::sym::ct_tmpl_add(name, qname, nt, tparam, bound,
                              self->decl_pub, self->cur_unit, self->mem->path,
                              struct_line);
            if (ti4 < 0) return self->sup->fail("out of memory");
            tps = frontend::sym::ct_tmpls(&tn4);
            if (di >= 0 && tps) {
                if (self->sym->ensure_tmpl_field_capacity(ti4,
                        self->sym->structs[di].nfields) != 0) return -1;
                tps = frontend::sym::ct_tmpls(&tn4);
                tps[ti4].nfields = self->sym->structs[di].nfields;
                for (fi4 = 0; fi4 < tps[ti4].nfields; fi4++) {
                    tps[ti4].fields[fi4].name = self->sym->structs[di].fields[fi4].name;
                    tps[ti4].fields[fi4].type = self->sym->structs[di].fields[fi4].type;
                    tps[ti4].fields[fi4].dims = self->sym->structs[di].fields[fi4].dims;
                }
                tps[ti4].nuse = self->sym->structs[di].nuse;
                for (ui4 = 0; ui4 < tps[ti4].nuse; ui4++)
                    tps[ti4].use[ui4] = self->sym->structs[di].use[ui4];
                self->sym->structs[di].is_template = 1;
                self->sym->structs[di].ntparams = nt;
                self->sym->structs[di].tparam =
                    frontend::sym::ct_rows_reserve(self->sym->structs[di].tparam,
                        self->sym->structs[di].tcap, nt,
                        &self->sym->structs[di].tcap);
                if (nt > 0 && (!self->sym->structs[di].tparam
                               || self->sym->structs[di].tcap < nt))
                    return self->sup->fail("out of memory");
                for (fi4 = 0; fi4 < nt; fi4++)
                    snprintf(self->sym->structs[di].tparam[fi4], MAX_TEXT, "%s",
                             tparam[fi4]);
                self->sym->structs[di].is_pub = self->decl_pub;
                /* P36 S2a2: the built-in Drop/Handback flags travel with the
                   template so consumer units can copy them onto instances. */
                tps[ti4].uses_drop = self->sym->structs[di].uses_drop;
                tps[ti4].uses_handback = self->sym->structs[di].uses_handback;
            }
        }
        /* `struct S { … } __attribute__((packed));`: either after the body or,
           in the typedef form, between the body and the alias */
        ao = -1;
        ar = self->sup->attr_pool(&ao);
        if (ar < 0) return -1;
        if (ao >= 0) self->arena->nodes[s].attr = ao;
        return s;
    }

    /* `enum Tag { A, B = <常量>, C };` -- every member becomes a file-scope
       constant (D-3) and the tag joins the type table under kind 5 (D-2).
       Phase 84 (D84-1): a member with a parenthesised payload list makes the
       whole declaration an ADT -- the tag joins the table under kind 7 (its C
       spelling is `struct Tag`) and the variants live in the ADT registry. The
       two forms never mix, and an ADT variant cannot carry an explicit value.
       The members are read into temporary nodes first, because only the last
       one tells a C enum from an ADT. The `typedef` entry calls the same reader
       with `tag_required == 0`, then owns the alias half of the node. */
    int parse_enum_def(int is_pub, int tag_required)
    {
        int s, m, tail, ti, e, ar, ao;
        int mem_first, mem_last, has_payload, has_value, all_payload;
        int first_nopay_line, first_nopay_col, first_val_line, first_val_col;
        int adt, tn, tline, tcol, is_adt, pre_adt;
        /* v1-PH-2 S6: `enum Opt<T>` is a generic ADT template. Its parameters
           are grown rows, mirroring a generic struct's. */
        char **tparam = 0;
        char **bound = 0;
        int tcap = 0, bcap = 0, nt = 0, templ = 0;
        int ltline = 0, ltcol = 0, early_ti = -1;
        const char *name;
        const char *qname;
        const char *mname;
        const char *cname;
        const char *nsbuf;
        size_t nl;
        (void)self;

        name = "";
        qname = "";
        adt = -1;
        has_payload = 0;
        has_value = 0;
        all_payload = 1;
        mem_first = -1;
        mem_last = -1;
        first_nopay_line = 0;
        first_nopay_col = 0;
        first_val_line = 0;
        first_val_col = 0;
        tline = self->lex->tokline;
        tcol = self->lex->tokstart - self->lex->lstart + 1;
        self->sup->lex_next();                       /* consume `enum` */
        if (self->lex->tok == T_ID) {
            name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!name) return self->sup->fail("out of memory");
            qname = self->sup->ns_decl_text(name);
            if (!qname) return self->sup->fail("out of memory");
            ti = self->sym->find_type(qname);
            if (ti >= 0 && self->sym->types[ti].kind == 5)
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    tool::sh::ct_scratch_fmt("duplicate enum '%s'", name),
                    self->mem->path);
            if (ti >= 0 && self->sym->types[ti].kind == 7)
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    tool::sh::ct_scratch_fmt("duplicate ADT '%s'", name),
                    self->mem->path);
            self->sup->lex_next();
        } else if (tag_required) {
            return self->sup->fail("expected an enum name");
        }
        /* v1-PH-2 S6: `enum Opt<T[, U]>` declares a generic ADT template. The
           members still decide whether the declaration is an ADT at all; a
           generic C enum has no monomorphisation axis and keeps the L34-3
           rejection, reported at the `<`. */
        if (name[0] && self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
            ltline = self->lex->tokline;
            ltcol = self->lex->tokstart - self->lex->lstart + 1;
            self->sup->lex_next();
            for (;;) {
                tparam = frontend::sym::ct_rows_reserve(tparam, tcap, nt + 1, &tcap);
                bound = frontend::sym::ct_rows_reserve(bound, bcap, nt + 1, &bcap);
                if (!tparam || tcap < nt + 1 || !bound || bcap < nt + 1)
                    return self->sup->fail("a generic ADT has too many type parameters");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a type parameter name");
                self->lex->tok_copy(tparam[nt], MAX_TEXT);
                nt++;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                    const char *raw;
                    int bi;
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a trait name after ':'");
                    raw = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                       self->lex->tokstr.len);
                    if (!raw) return self->sup->fail("out of memory");
                    self->sup->lex_next();
                    bi = self->sym->find_trait(raw);
                    if ((bi >= 0 && self->sym->traits[bi].is_static)
                        || strcmp(raw, "Drop") == 0 || strcmp(raw, "Handback") == 0)
                        return tool::diag::ct_sem_error(self->lex->tokline,
                            self->lex->tokstart - self->lex->lstart + 1,
                            tool::sh::ct_scratch_fmt(
                                "trait '%s' cannot bound a type parameter", raw),
                            self->mem->path);
                    snprintf(bound[nt - 1], MAX_TEXT, "%s", raw);
                }
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
            if (self->lex->tok != T_PUNCT || !self->lex->tok_is(">"))
                return self->sup->fail("expected '>' after the type parameters");
            self->sup->lex_next();
            templ = 1;
        }
        pre_adt = 0;
        if (name[0] && self->lex->tok == T_PUNCT && self->lex->tok_is("{"))
            pre_adt = enum_adt_ahead(self);
        if (self->sup->expect("{") != 0) return -1;
        /* the tag joins the table before its members are read: a payload may
           name the ADT itself, and its C spelling differs between the forms */
        if (name[0] && self->sup->add_type(qname, pre_adt ? 7 : 5) != 0) return -1;
        /* A template's own payload may name the template (`List<T> next`), so
           the generic row has to exist before the member list is read. The
           ADT row itself follows the body (its variants are not known yet);
           `adt` is patched below. */
        if (templ && pre_adt && name[0]) {
            struct StructTmpl *tps_e;
            int tn_e, tbx_e, shadowable_e;
            /* v1-PH-2 S6b: `Option` / `Result` may shadow the built-in generic
               struct of the same name in this unit; every other visible
               template of that name is still a hard conflict. */
            tbx_e = frontend::sym::ct_tmpl_find(name, self->cur_unit);
            tps_e = frontend::sym::ct_tmpls(&tn_e);
            shadowable_e = tbx_e >= 0 && tbx_e < self->sym->builtin_tmpl_hi
                           && (strcmp(name, "Option") == 0
                               || strcmp(name, "Result") == 0);
            if (tbx_e >= 0
                && (!tps_e
                    || (tps_e[tbx_e].owner == self->cur_unit
                        && tbx_e >= self->sym->builtin_tmpl_hi)
                    || !shadowable_e))
                return tool::diag::ct_sem_error(ltline, ltcol,
                    tool::sh::ct_scratch_fmt(
                        "generic ADT '%s' conflicts with an existing generic type of the same name",
                        name),
                    self->mem->path);
            early_ti = frontend::sym::ct_tmpl_add(name, qname, nt, tparam, bound,
                                                  is_pub, self->cur_unit,
                                                  self->mem->path, tline);
            if (early_ti < 0) return self->sup->fail("out of memory");
            tps_e = frontend::sym::ct_tmpls(&tn_e);
            if (!tps_e) return self->sup->fail("out of memory");
            tps_e[early_ti].is_adt = 1;
            tps_e[early_ti].adt = -1;
            tps_e[early_ti].is_pub = is_pub;
            tps_e[early_ti].owner = self->cur_unit;
        }
        /* inside the member list the declared parameters are types, exactly as
           they are inside a generic struct body (D26-4) */
        if (templ) {
            self->ex->in_generic_tparam = tparam;
            self->ex->in_generic_ntparam = nt;
        }
        /* the member rows are temporary: they become N_ENUMVAL constants (C
           enum) or ADT registry rows, never emitted AST nodes of their own */
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            if (self->lex->tok != T_ID) return self->sup->fail("expected an enum member");
            tn = self->sup->new_node(N_ADTMEM);
            if (tn < 0) return -1;
            self->arena->nodes[tn].text = runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len);
            if (!self->arena->nodes[tn].text) return self->sup->fail("out of memory");
            self->arena->nodes[tn].line = self->lex->tokline;
            self->arena->nodes[tn].num = self->lex->tokstart - self->lex->lstart + 1;
            self->arena->nodes[tn].aux = 0;         /* 1 = payload list */
            self->sup->lex_next();
            if (self->sup->accept("(")) {
                int ftail = -1;
                self->arena->nodes[tn].aux = 1;
                has_payload = 1;
                while (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")"))) {
                    int fld, fline, fcol;
                    const char *ftype;
                    const char *fname;
                    fline = self->lex->tokline;
                    fcol = self->lex->tokstart - self->lex->lstart + 1;
                    if (self->ex->parse_type_text(&ftype) != 0) return -1;
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a payload field name");
                    fname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                         self->lex->tokstr.len);
                    if (!fname) return self->sup->fail("out of memory");
                    self->sup->lex_next();
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("["))
                        return tool::diag::ct_sem_error(fline, fcol,
                            "an ADT payload field cannot be an array", self->mem->path);
                    if (strcmp(ftype, "void") == 0)
                        return tool::diag::ct_sem_error(fline, fcol,
                            "an ADT payload field cannot have type 'void'", self->mem->path);
                    fld = self->sup->new_node(N_ADTFIELD);
                    if (fld < 0) return -1;
                    self->arena->nodes[fld].text = ftype;
                    self->arena->nodes[fld].text2 = fname;
                    self->arena->nodes[fld].line = fline;
                    self->arena->nodes[fld].num = fcol;
                    if (self->arena->nodes[tn].a < 0) self->arena->nodes[tn].a = fld;
                    else self->arena->nodes[ftail].next = fld;
                    ftail = fld;
                    if (!self->sup->accept(",")) break;
                }
                if (self->sup->expect(")") != 0) return -1;
                /* D84-1: an ADT variant names its tag by position; an explicit
                   value would be a C-enum form, so it is refused where written */
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("="))
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1,
                        "an ADT variant cannot carry an explicit value", self->mem->path);
            } else if (self->sup->accept("=")) {
                int vline, vcol;
                vline = self->lex->tokline;
                vcol = self->lex->tokstart - self->lex->lstart + 1;
                e = self->ex->parse_expr();
                if (e < 0) return -1;
                if (!self->ex->const_ok(e))
                    return tool::diag::ct_sem_error(vline, vcol,
                        "an enum value must be an integer constant", self->mem->path);
                self->arena->nodes[tn].a = e;
                self->arena->nodes[tn].d = vline;
                self->arena->nodes[tn].c = vcol;
                if (!has_value) {
                    has_value = 1;
                    first_val_line = vline;
                    first_val_col = vcol;
                }
                all_payload = 0;
            } else {
                all_payload = 0;
                if (first_nopay_line == 0) {
                    first_nopay_line = self->arena->nodes[tn].line;
                    first_nopay_col = self->arena->nodes[tn].num;
                }
            }
            if (mem_first < 0) mem_first = tn;
            else self->arena->nodes[mem_last].next = tn;
            mem_last = tn;
            /* a trailing comma before `}` is allowed */
            if (!self->sup->accept(",")) break;
        }
        if (self->sup->expect("}") != 0) return -1;
        if (templ) {
            self->ex->in_generic_tparam = 0;
            self->ex->in_generic_ntparam = 0;
        }
        is_adt = has_payload;
        if (is_adt && !name[0])
            return tool::diag::ct_sem_error(tline, tcol,
                "an ADT needs a tag name (write `enum Shape { ... }`)", self->mem->path);
        /* Phase 34 (L34-3): a generic C enum still has no monomorphisation
           axis; only a payload-bearing declaration is an ADT template. */
        if (templ && !is_adt)
            return tool::diag::ct_sem_error(ltline, ltcol,
                "generic enums are not supported", self->mem->path);
        s = self->sup->new_node(N_ENUM);
        if (s < 0) return -1;
        self->arena->nodes[s].text = runtime::text::ct_intern(name);
        if (!self->arena->nodes[s].text) return self->sup->fail("out of memory");
        self->arena->nodes[s].text2 = runtime::text::ct_intern(qname);
        if (!self->arena->nodes[s].text2) return self->sup->fail("out of memory");
        self->arena->nodes[s].text3 = runtime::text::ct_intern("");
        if (!self->arena->nodes[s].text3) return self->sup->fail("out of memory");
        self->arena->nodes[s].d = is_pub;
        if (name[0]) {
            /* the pre-scan and the real member list must agree; if they ever
               do not, the parsed form wins and the table follows it */
            ti = self->sym->find_type(qname);
            if (ti >= 0 && self->sym->types[ti].kind != (is_adt ? 7 : 5))
                self->sym->types[ti].kind = is_adt ? 7 : 5;
        }
        if (is_adt) {
            if (has_value)
                return tool::diag::ct_sem_error(first_val_line, first_val_col,
                    "an ADT variant cannot carry an explicit value", self->mem->path);
            if (!all_payload)
                return tool::diag::ct_sem_error(first_nopay_line, first_nopay_col,
                    "every variant of an ADT must carry a payload list", self->mem->path);
            adt = frontend::sym::ct_adt_add(name, qname, is_pub, self->cur_unit,
                                            self->mem->path, tline);
            if (adt == -2)
                return tool::diag::ct_sem_error(tline, tcol,
                    tool::sh::ct_scratch_fmt("duplicate ADT '%s'", name),
                    self->mem->path);
            if (adt < 0)
                return tool::diag::ct_sem_error(tline, tcol,
                    "too many ADT types in this build (limit 65536)", self->mem->path);
            self->arena->nodes[s].aux = 2;          /* ADT */
            self->arena->nodes[s].num = adt + 1;    /* registry row + 1 */
            for (tn = mem_first; tn >= 0; tn = self->arena->nodes[tn].next) {
                int v, fld, seen;
                struct Adt *adts;
                int nadts;
                v = frontend::sym::ct_adt_add_variant(adt, self->arena->nodes[tn].text,
                        self->arena->nodes[tn].text, self->arena->nodes[tn].line,
                        self->arena->nodes[tn].num);
                if (v < 0)
                    return tool::diag::ct_sem_error(self->arena->nodes[tn].line,
                        self->arena->nodes[tn].num,
                        tool::sh::ct_scratch_fmt(
                            "too many variants for ADT '%s' (limit 65536)", name),
                        self->mem->path);
                adts = frontend::sym::ct_adts(&nadts);
                for (fld = self->arena->nodes[tn].a; fld >= 0;
                     fld = self->arena->nodes[fld].next) {
                    for (seen = 0; seen < adts[adt].variants[v].nfields; seen++)
                        if (strcmp(adts[adt].variants[v].fields[seen].name,
                                   self->arena->nodes[fld].text2) == 0)
                            return tool::diag::ct_sem_error(self->arena->nodes[fld].line,
                                self->arena->nodes[fld].num,
                                tool::sh::ct_scratch_fmt(
                                    "duplicate payload field '%s'",
                                    self->arena->nodes[fld].text2),
                                self->mem->path);
                    if (frontend::sym::ct_adt_add_field(adt, v, self->arena->nodes[fld].text2,
                            self->arena->nodes[fld].text) < 0)
                        return tool::diag::ct_sem_error(self->arena->nodes[fld].line,
                            self->arena->nodes[fld].num,
                            tool::sh::ct_scratch_fmt(
                                "too many payload fields for '%s.%s' (limit 65536)",
                                name, self->arena->nodes[tn].text),
                            self->mem->path);
                    /* LANG-29 S2 / B3 (D-021 §3): an ADT payload is copied by
                       value and its owning leaves are retain/released, so a
                       bare `Str` view has no owner to keep alive. Store a
                       `String` instead and take a view with `as_str()`. */
                    if (self->sup->str_handle_kind(self->arena->nodes[fld].text) == 3
                        || self->sup->str_handle_kind(self->arena->nodes[fld].text) == 4) {
                        char msg[MAX_TEXT * 2];
                        snprintf(msg, sizeof msg,
                                 "an ADT payload cannot be a bare '%s' view; store a 'String' and take a view with as_str()",
                                 self->sup->str_handle_kind(self->arena->nodes[fld].text) == 4
                                     ? "U16Str" : "Str");
                        return tool::diag::ct_sem_error(self->arena->nodes[fld].line,
                            self->arena->nodes[fld].num, msg, self->mem->path);
                    }
                }
            }
            /* v1-PH-2 S6: a parameterised declaration is a template. Record
               the parameter names on the ADT row (the instance substitution
               reads them) and register a struct-template row so `Opt<int>` in
               a type position reaches the ordinary instance reader. */
            if (templ) {
                int ti5, tn5, pi5;
                struct StructTmpl *tps5;
                if (frontend::sym::ct_adt_set_template(adt, 0) != 0)
                    return self->sup->fail("out of memory");
                for (pi5 = 0; pi5 < nt; pi5++)
                    if (frontend::sym::ct_adt_add_tparam(adt, tparam[pi5]) < 0)
                        return self->sup->fail("out of memory");
                /* The row was registered before the body when the pre-scan
                   saw an ADT; only its ADT index was unknown. A declaration
                   the scan missed still gets its row here. */
                if (early_ti < 0) {
                    int tbx_l = frontend::sym::ct_tmpl_find(name, self->cur_unit);
                    int tn_l;
                    struct StructTmpl *tps_l = frontend::sym::ct_tmpls(&tn_l);
                    int shadowable_l = tbx_l >= 0
                        && tbx_l < self->sym->builtin_tmpl_hi
                        && (strcmp(name, "Option") == 0
                            || strcmp(name, "Result") == 0);
                    if (tbx_l >= 0
                        && (!tps_l
                            || (tps_l[tbx_l].owner == self->cur_unit
                                && tbx_l >= self->sym->builtin_tmpl_hi)
                            || !shadowable_l))
                        return tool::diag::ct_sem_error(tline, tcol,
                            tool::sh::ct_scratch_fmt(
                                "generic ADT '%s' conflicts with an existing generic type of the same name",
                                name),
                            self->mem->path);
                }
                if (early_ti < 0) {
                    ti5 = frontend::sym::ct_tmpl_add(name, qname, nt, tparam, bound,
                                                     is_pub, self->cur_unit,
                                                     self->mem->path, tline);
                    if (ti5 < 0) return self->sup->fail("out of memory");
                } else {
                    ti5 = early_ti;
                }
                tps5 = frontend::sym::ct_tmpls(&tn5);
                if (!tps5) return self->sup->fail("out of memory");
                tps5[ti5].is_adt = 1;
                tps5[ti5].adt = adt;
                tps5[ti5].is_pub = is_pub;
                tps5[ti5].owner = self->cur_unit;
            }
            ao = -1;
            ar = self->sup->attr_pool(&ao);
            if (ar < 0) return -1;
            if (ao >= 0) self->arena->nodes[s].attr = ao;
            return s;
        }
        /* the constants are matched against a namespace path without the
           trailing separator, like every other global */
        nl = (self->sym->ns && self->sym->ns[0]) ? strlen(self->sym->ns) : 0;
        if (nl > 0) nl--;
        nsbuf = runtime::text::ct_intern_len(self->sym->ns ? self->sym->ns : "",
                                             (int)nl);
        if (!nsbuf) return self->sup->fail("out of memory");
        tail = -1;
        for (tn = mem_first; tn >= 0; tn = self->arena->nodes[tn].next) {
            /* S1a-0 C2p-7: the member name is the pool text the variant row
               already holds; the old 160-byte copy cut a long enum member. */
            mname = self->arena->nodes[tn].text;
            cname = self->sup->ns_decl_text(mname);
            if (!cname) return -1;
            m = self->sup->new_node(N_ENUMVAL);
            if (m < 0) return -1;
            self->arena->nodes[m].text = cname;
            if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
            self->arena->nodes[m].text2 = runtime::text::ct_intern(mname);
            if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
            self->arena->nodes[m].line = self->arena->nodes[tn].line;
            if (self->sym->declare_const(mname, cname, nsbuf, 0) < 0)
                return self->sup->fail(self->sym->last_error());
            /* PH-57: also key the member by its source enum tag so the value
               form `Type::Member` resolves through find_qualified_global. */
            if (name[0] && self->sym->declare_const(mname, cname, name, 0) < 0)
                return self->sup->fail(self->sym->last_error());
            if (self->arena->nodes[tn].a >= 0)
                self->arena->nodes[m].a = self->arena->nodes[tn].a;
            if (tail < 0) self->arena->nodes[s].a = m;
            else self->arena->nodes[tail].next = m;
            tail = m;
        }
        ao = -1;
        ar = self->sup->attr_pool(&ao);
        if (ar < 0) return -1;
        if (ao >= 0) self->arena->nodes[s].attr = ao;
        return s;
    }

    /* `typedef struct { ... } Name;` or `typedef <type> Name;`. */
    int parse_typedef(int is_pub)
    {
        int t, td_line, ar, ao;
        const char *typebuf;
        const char *name;
        const char *qname;
        (void)self;

        td_line = self->lex->tokline;
        self->sup->lex_next();
        if (self->lex->tok == T_ID && self->lex->tok_is("enum")) {
            /* `typedef enum [Tag] { ... } Alias;`: both halves are table entries,
               so `enum Tag` and `Alias` name the same type (D-2) */
            t = self->parse_enum_def(0, 0);
            if (t < 0) return -1;
            if (self->lex->tok != T_ID) return self->sup->fail("expected a typedef name");
            name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!name) return self->sup->fail("out of memory");
            self->sup->lex_next();
            ao = -1;
            ar = self->sup->attr_pool(&ao);
            if (ar < 0) return -1;
            if (ao >= 0) {
                if (self->arena->nodes[t].attr >= 0)
                    return self->sup->fail("duplicate __attribute__ on one declaration");
                self->arena->nodes[t].attr = ao;
            }
            if (self->sup->expect(";") != 0) return -1;
            qname = self->sup->ns_decl_text(name);
            if (!qname) return self->sup->fail("out of memory");
            /* bit 1 marks the typedef half; bit 2 (an ADT) must survive it */
            self->arena->nodes[t].aux = self->arena->nodes[t].aux | 1;
            if ((self->arena->nodes[t].aux & 2) && self->arena->nodes[t].num > 0) {
                struct Adt *adts;
                int nadts, adi;
                adts = frontend::sym::ct_adts(&nadts);
                adi = (int)self->arena->nodes[t].num - 1;
                if (adts && adi >= 0 && adi < nadts) adts[adi].is_pub = is_pub;
            }
            self->arena->nodes[t].text = runtime::text::ct_intern(name);
            if (!self->arena->nodes[t].text) return self->sup->fail("out of memory");
            self->arena->nodes[t].text3 = runtime::text::ct_intern(self->arena->nodes[t].text2);
            if (!self->arena->nodes[t].text3) return self->sup->fail("out of memory");
            self->arena->nodes[t].text2 = runtime::text::ct_intern(qname);
            if (!self->arena->nodes[t].text2) return self->sup->fail("out of memory");
            self->arena->nodes[t].d = is_pub;
            self->arena->nodes[t].line = td_line;
            if (self->sup->add_type(qname, 2) != 0) return -1;
            if ((self->arena->nodes[t].aux & 2) && self->arena->nodes[t].num > 0) {
                struct Adt *adts;
                int nadts, adi;
                const char *tgt;
                adts = frontend::sym::ct_adts(&nadts);
                adi = (int)self->arena->nodes[t].num - 1;
                if (adts && adi >= 0 && adi < nadts) {
                    /* F1: the alias names the same sum type as the tag; the
                       C target lets a match subject / constructor spelled
                       with the alias resolve back to the ADT row. */
                    tgt = runtime::text::ct_internf("struct %s", adts[adi].full);
                    if (!tgt) return self->sup->fail("out of memory");
                    self->sym->set_type_target(qname, tgt);
                }
            }
            return t;
        }
        if (self->lex->tok == T_ID
            && (self->lex->tok_is("struct") || self->lex->tok_is("union"))) {
            t = self->parse_record_def(self->lex->tok_is("union"));
            if (t < 0) return -1;
            if (self->lex->tok != T_ID) return self->sup->fail("expected a typedef name");
            name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!name) return self->sup->fail("out of memory");
            self->sup->lex_next();
            ao = -1;
            ar = self->sup->attr_pool(&ao);
            if (ar < 0) return -1;
            if (ao >= 0) {
                if (self->arena->nodes[t].attr >= 0)
                    return self->sup->fail("duplicate __attribute__ on one declaration");
                self->arena->nodes[t].attr = ao;
            }
            if (self->sup->expect(";") != 0) return -1;
            qname = self->sup->ns_decl_text(name);
            if (!qname) return self->sup->fail("out of memory");
            /* keep the tag in `text`: `typedef struct Tag {...} Alias;` must emit
               the tag, or a `struct Tag` reference elsewhere is incomplete */
            self->arena->nodes[t].text = runtime::text::ct_intern(self->arena->nodes[t].text2);
            if (!self->arena->nodes[t].text) return self->sup->fail("out of memory");
            self->arena->nodes[t].text2 = runtime::text::ct_intern(qname);
            if (!self->arena->nodes[t].text2) return self->sup->fail("out of memory");
            self->arena->nodes[t].aux = 1;
            self->arena->nodes[t].d = is_pub;
            self->arena->nodes[t].line = td_line;
            if (self->sup->add_type(qname, 2) != 0) return -1;
            if (self->sup->add_struct(qname) < 0) return -1;
            /* the tag and the alias are two table entries: give the alias the
               `use` list the body attached to the tag, or its vptr fields vanish */
            {
                int tagi = -1, ai, ui;
                if (self->arena->nodes[t].text[0]) tagi = self->sym->find_struct(self->arena->nodes[t].text);
                ai = self->sym->find_struct(qname);
                if (tagi >= 0 && ai >= 0 && tagi != ai) {
                    self->sym->structs[ai].nuse = self->sym->structs[tagi].nuse;
                    self->sym->structs[ai].uses_drop = self->sym->structs[tagi].uses_drop;
                    self->sym->structs[ai].uses_handback = self->sym->structs[tagi].uses_handback;
                    self->sym->structs[ai].has_handback_impl = self->sym->structs[tagi].has_handback_impl;
                    for (ui = 0; ui < self->sym->structs[tagi].nuse; ui++)
                        self->sym->structs[ai].use[ui] = self->sym->structs[tagi].use[ui];
                    if (self->sym->ensure_struct_field_capacity(ai,
                            self->sym->structs[tagi].nfields) != 0) return -1;
                    self->sym->structs[ai].nfields = self->sym->structs[tagi].nfields;
                    for (ui = 0; ui < self->sym->structs[tagi].nfields; ui++) {
                        self->sym->structs[ai].fields[ui].name =
                            self->sym->structs[tagi].fields[ui].name;
                        self->sym->structs[ai].fields[ui].type =
                            self->sym->structs[tagi].fields[ui].type;
                        /* `dims` makes an array field an array; without it the
                           alias emits a scalar and the vptr initialiser targets
                           `.items.__t_vptr` on a struct array, which no C
                           compiler accepts */
                        self->sym->structs[ai].fields[ui].dims =
                            self->sym->structs[tagi].fields[ui].dims;
                        self->sym->structs[ai].fields[ui].line =
                            self->sym->structs[tagi].fields[ui].line;
                        self->sym->structs[ai].fields[ui].col =
                            self->sym->structs[tagi].fields[ui].col;
                        self->sym->structs[ai].fields[ui].is_pub =
                            self->sym->structs[tagi].fields[ui].is_pub;
                        self->sym->structs[ai].fields[ui].is_bitfield =
                            self->sym->structs[tagi].fields[ui].is_bitfield;
                    }
                } else if (ai >= 0 && !self->arena->nodes[t].text[0]) {
                    /* an untagged body: the pending list belongs to this alias */
                    if (self->sym->ensure_struct_field_capacity(ai, self->npend) != 0)
                        return -1;
                    self->sym->structs[ai].nfields = self->npend;
                    for (ui = 0; ui < self->npend; ui++) {
                        self->sym->structs[ai].fields[ui].name =
                            self->pend_fields[ui].name;
                        self->sym->structs[ai].fields[ui].type =
                            self->pend_fields[ui].type;
                        self->sym->structs[ai].fields[ui].dims =
                            self->pend_fields[ui].dims;
                        self->sym->structs[ai].fields[ui].line = self->pend_fields[ui].line;
                        self->sym->structs[ai].fields[ui].col = self->pend_fields[ui].col;
                        self->sym->structs[ai].fields[ui].is_pub = self->pend_fields[ui].is_pub;
                        self->sym->structs[ai].fields[ui].is_bitfield =
                            self->pend_fields[ui].is_bitfield;
                    }
                }
            }
            return t;
        }
        self->ex->saw_atomic = 0;
        if (self->ex->parse_type_text(&typebuf) != 0) return -1;
        if (self->ex->saw_atomic)
            return tool::diag::ct_sem_error(td_line, 1,
                "an atomic value cannot be a typedef target", self->mem->path);
        if (self->ex->fnptr_state) {
            /* `typedef int (*BinOp)(int, int);`: the alias came with the type */
            name = self->ex->fnptr_name;
        } else {
            if (self->lex->tok != T_ID) return self->sup->fail("expected a typedef name");
            name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!name) return self->sup->fail("out of memory");
            self->sup->lex_next();
        }
        ao = -1;
        ar = self->sup->attr_pool(&ao);
        if (ar < 0) return -1;
        if (self->sup->expect(";") != 0) return -1;
        qname = self->sup->ns_decl_text(name);
        if (!qname) return self->sup->fail("out of memory");
        t = self->sup->new_node(N_TYPEDEF);
        if (t < 0) return -1;
        if (ao >= 0) self->arena->nodes[t].attr = ao;
        self->arena->nodes[t].text = typebuf;
        self->arena->nodes[t].text2 = runtime::text::ct_intern(qname);
        if (!self->arena->nodes[t].text2) return self->sup->fail("out of memory");
        self->arena->nodes[t].text3 = runtime::text::ct_intern(self->ex->fnptr_dims);
        if (!self->arena->nodes[t].text3) return self->sup->fail("out of memory");
        self->arena->nodes[t].d = is_pub;
        self->arena->nodes[t].line = td_line;
        /* kind 4 marks a function-pointer alias: the type string alone is the
           abstract declarator `int (*)(int, int)`, so a field of that alias
           would otherwise look like an opaque typedef (D-2) */
        if (self->sup->add_type(qname, strstr(typebuf, "(*") ? 4 : 2) != 0) return -1;
        /* V29-4: keep the spelling so an alias used as a subscript base or a
           callee resolves to its real type, not to the alias name. */
        self->sym->set_type_target(qname, typebuf);
        return t;
    }

    /* `use A, B` after a struct body; the trailing `;` stays with the caller. */
    int parse_use_list(int sindex)
    {
        const char *tname;
        int uti;
        (void)self;
        if (sindex < 0) return self->sup->fail("unknown struct in 'use'");
        for (;;) {
            if (self->lex->tok != T_ID) return self->sup->fail("expected a trait name");
            tname = self->sym->resolve_type_text(runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len));
            if (!tname) return self->sup->fail("out of memory");
            uti = self->sym->find_trait(tname);
            if (uti >= 0 && self->sym->traits[uti].is_static)
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    "a static trait cannot be adopted", self->mem->path);
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                char *tnbuf = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
                if (!tnbuf) return self->sup->fail("out of memory");
                snprintf(tnbuf, TEXT_LIMIT, "%s", tname);
                if (parse_trait_inst_args(self, tnbuf, TEXT_LIMIT) < 0) return -1;
                tname = runtime::text::ct_intern(tnbuf);
                if (!tname) return self->sup->fail("out of memory");
            }
            /* `Drop` is built in (Phase 5): it carries no vptr or vtable, so it
               never joins the `use` list -- only the flag matters */
            if (strcmp(tname, "Drop") == 0) {
                self->sym->structs[sindex].uses_drop = 1;
            /* `Handback` is built in as well: a borrowed object is handed back
               to its pool, so it carries no vptr or vtable and never joins the
               `use` list -- only the flag matters */
            } else if (strcmp(tname, "Handback") == 0) {
                self->sym->structs[sindex].uses_handback = 1;
            } else {
                if (self->sym->structs[sindex].nuse >= MAX_TRAITS)
                    return self->sup->fail("too many used traits");
                self->sym->structs[sindex].use[self->sym->structs[sindex].nuse] =
                    runtime::text::ct_intern(tname);
                if (!self->sym->structs[sindex].use[self->sym->structs[sindex].nuse])
                    return self->sup->fail("out of memory");
                self->sym->structs[sindex].nuse++;
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        return 0;
    }

    /* `trait Name { ret m(params); ... }` -- no node, the table is enough. A
       method may instead carry a default body (`{ … }`), which the emitter
       expands once per adopting struct. */
    int parse_trait(int is_pub)
    {
        int ti, mi, np, trait_line, mline, pfirst, ptail, dm, di, dj, dk, dcycle;
        int seen_borrow, seen_ref, seen_out, bline;
        int rty;
        int ntp, pi, discard, save_ntraits, save_ntype, save_nnode, stride;
        char **tparam = 0;
        char **tbound = 0;
        int tcap = 0, bcap = 0;
        const char *name;
        const char *qname;
        const char *ret;
        const char *ptype;
        const char *pname;
        char *edge;
        (void)self;

        trait_line = self->lex->tokline;
        if (self->unit_is_map && !is_pub)
            return tool::diag::ct_sem_error(trait_line, 1,
                "a trait in a .m.ct unit must be 'pub'", self->mem->path);
        self->sup->lex_next();
        if (self->lex->tok != T_ID) return self->sup->fail("expected a trait name");
        name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                            self->lex->tokstr.len);
        if (!name) return self->sup->fail("out of memory");
        /* LANG-23: `Drop` / `Handback` are reserved built-in traits. The
           built-in declaration unit may write them (the row is parsed for
           validation, then discarded: no MAX_TRAITS count, no vtable, and
           `find_trait` keeps returning <0 so every name-based built-in path
           stays in charge). Any other unit is refused, matching L2. */
        discard = 0;
        if (strcmp(name, "Drop") == 0 || strcmp(name, "Handback") == 0) {
            if (strstr(self->mem->path, "lib/core/Vec.h.ct") != 0
                || strstr(self->mem->path, "lib/std/Vec.h.ct") != 0) {
                discard = 1;
            } else {
                return tool::diag::ct_sem_error(trait_line, 1,
                    tool::sh::ct_scratch_fmt(
                        "'%s' is a reserved built-in trait and cannot be defined", name),
                    self->mem->path);
            }
        }
        save_ntraits = self->sym->ntraits;
        save_ntype = self->sym->ntype;
        save_nnode = self->arena->nnode;
        qname = self->sup->ns_decl_text(name);
        if (!qname) return self->sup->fail("out of memory");
        /* Phase 35: `trait Iter<T[, U]> { … }` declares a template. The row keeps
           the bare name and the parameters; `T` in a signature is substituted
           when an instance row is created (S2). A bound (`T: Show`) is parsed in
           S1b; the capacity guard lives here because the field is two wide.
           Stepping past the name first is what lets the `<` be seen; the cursor
           then sits on the `{` the duplicate diagnostic points at. */
        self->sup->lex_next();
        ntp = 0;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
            self->sup->lex_next();
            for (;;) {
                tparam = frontend::sym::ct_rows_reserve(tparam, tcap, ntp + 1, &tcap);
                tbound = frontend::sym::ct_rows_reserve(tbound, bcap, ntp + 1, &bcap);
                if (!tparam || tcap < ntp + 1 || !tbound || bcap < ntp + 1)
                    return self->sup->fail("a trait has too many type parameters");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a type parameter name");
                for (pi = 0; pi < ntp; pi++) {
                    if (self->lex->tok_is(tparam[pi]))
                        return tool::diag::ct_sem_error(self->lex->tokline,
                            self->lex->tokstart - self->lex->lstart + 1,
                            tool::sh::ct_scratch_fmt(
                                "duplicate type parameter '%.*s'",
                                self->lex->tokstr.len, self->lex->tokstr.ptr),
                            self->mem->path);
                }
                self->lex->tok_copy(tparam[ntp], MAX_TEXT);
                tbound[ntp][0] = 0;
                self->sup->lex_next();
                /* `T: Show` names one trait. Multi-bounds are out of scope
                   (L35-2); the trait is resolved when an instance is created
                   (S4), so a later declaration is still fine here. */
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a trait name in the bound");
                    self->lex->tok_copy(tbound[ntp], MAX_TEXT);
                    self->sup->lex_next();
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("+"))
                        return tool::diag::ct_sem_error(self->lex->tokline,
                            self->lex->tokstart - self->lex->lstart + 1,
                            "a type parameter supports one trait bound", self->mem->path);
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                        if (parse_trait_inst_args(self, tbound[ntp], MAX_TEXT) < 0)
                            return -1;
                    }
                }
                ntp++;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
            if (self->sup->expect(">") != 0) return -1;
        }
        /* A second body for the same trait is a hard error. L2 reports it at the
           opening '{', which is where the cursor sits now. */
        if (self->sym->find_trait(qname) >= 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                tool::sh::ct_scratch_fmt("duplicate trait '%s'", name),
                self->mem->path);
        ti = self->sup->add_trait(qname);
        if (ti < 0) return -1;
        self->sym->traits[ti].is_pub = is_pub;
        self->sym->traits[ti].is_static = self->unit_is_map;
        self->sym->traits[ti].line = trait_line;
        self->sym->traits[ti].path = runtime::text::ct_intern(self->mem->path);
        if (!self->sym->traits[ti].path) return self->sup->fail("out of memory");
        {
            const char *nsbuf;
            size_t nl;
            nl = (self->sym->ns && self->sym->ns[0]) ? strlen(self->sym->ns) : 0;
            if (nl > 0 && self->sym->ns[nl - 1] == '_') nl--;
            nsbuf = runtime::text::ct_intern_len(self->sym->ns ? self->sym->ns : "",
                                                 (int)nl);
            if (!nsbuf) return self->sup->fail("out of memory");
            self->sym->traits[ti].ns = nsbuf;
        }
        self->sym->traits[ti].ntparams = ntp;
        self->sym->traits[ti].tparam =
            frontend::sym::ct_rows_reserve(self->sym->traits[ti].tparam,
                self->sym->traits[ti].tcap, ntp, &self->sym->traits[ti].tcap);
        self->sym->traits[ti].bound =
            frontend::sym::ct_rows_reserve(self->sym->traits[ti].bound,
                self->sym->traits[ti].bcap, ntp, &self->sym->traits[ti].bcap);
        if (ntp > 0 && (!self->sym->traits[ti].tparam
                        || !self->sym->traits[ti].bound
                        || self->sym->traits[ti].tcap < ntp
                        || self->sym->traits[ti].bcap < ntp))
            return self->sup->fail("out of memory");
        for (pi = 0; pi < ntp; pi++) {
            snprintf(self->sym->traits[ti].tparam[pi], MAX_TEXT, "%s", tparam[pi]);
            snprintf(self->sym->traits[ti].bound[pi], MAX_TEXT, "%s", tbound[pi]);
        }
        self->sym->traits[ti].tmpl = -1;
        self->sym->traits[ti].owner = self->cur_unit;
        if (self->sup->add_type(qname, 3) != 0) return -1;   /* trait = iface type */
        if (self->sup->expect("{") != 0) return -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            mline = self->lex->tokline;
            /* D-60-1: receiver mutability is postfix (`int f() mut;`). Refuse
               the prefix spelling with the placement instead of reading `mut`
               as an opaque return type and turning `int` into the method
               name. */
            if (self->unit_is_map && self->lex->tok == T_ID
                && self->lex->tok_is("mut"))
                return tool::diag::ct_sem_error(mline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    "receiver mutability is written after the parameter list: 'int f() mut;'",
                    self->mem->path);
            /* SH-60 / D-60-2: a `.m.ct` signature is the one place where an
               unknown bare type name is an error instead of an opaque C
               spelling -- the recipe cannot verify it and there is no C
               header in the unit to correct it. */
            self->sup->map_sig = self->unit_is_map;
            rty = self->ex->parse_type_text(&ret);
            self->sup->map_sig = 0;
            if (rty != 0) return -1;
            if (self->ex->fnptr_state)
                return self->sup->fail("a trait method cannot return a function pointer");
            if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
            /* S1a-0 C1: the method block grows on demand; only the OOM valve
               (CAP_LIMIT) can stop it now. */
            if (self->sym->ensure_trait_capacity(ti, self->sym->traits[ti].nm + 1) != 0)
                return -1;
            mi = self->sym->traits[ti].nm;
            self->sym->traits[ti].m[mi].name = runtime::text::ct_intern_len(
                self->lex->tokstr.ptr, self->lex->tokstr.len);
            if (!self->sym->traits[ti].m[mi].name)
                return self->sup->fail("out of memory");
            self->sym->traits[ti].m[mi].ret = ret;
            self->sym->traits[ti].m[mi].nparams = 0;
            self->sym->traits[ti].m[mi].body = -1;
            self->sym->traits[ti].m[mi].pnode = -1;
            self->sym->traits[ti].m[mi].line = mline;
            self->sym->traits[ti].m[mi].is_mut = 0;
            pfirst = -1;
            ptail = -1;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            if (self->lex->tok == T_ID && self->lex->tok_is("void")) {
                /* `(void)` is C's empty parameter list, but `void *p` is a
                   parameter like any other: look one token ahead before taking
                   the shortcut. */
                int save_tok, save_line, save_srcline, save_bol;
                long save_num;
                size_t save_pos;
                const char *save_text_ptr; int save_text_len;
                save_tok = self->lex->tok;
                save_num = self->lex->toknum;
                save_line = self->lex->tokline;
                save_pos = self->lex->pos;
                save_srcline = self->lex->line;
                save_bol = self->lex->bol;
                save_text_ptr = self->lex->tokstr.ptr; save_text_len = self->lex->tokstr.len;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
                    self->sup->lex_next();
                    /* D-60-1: the postfix `mut` sits between `)` and `;`. */
                    if (self->lex->tok == T_ID && self->lex->tok_is("mut")) {
                        if (!self->unit_is_map)
                            return tool::diag::ct_sem_error(self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1,
                                "receiver mutability is only valid on a .m.ct trait method",
                                self->mem->path);
                        self->sym->traits[ti].m[mi].is_mut = 1;
                        self->sup->lex_next();
                    }
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                        if (self->unit_is_map)
                            return tool::diag::ct_sem_error(mline, 1,
                                "a .m.ct trait cannot carry a default body", self->mem->path);
                        if (ntp > 0)
                            return tool::diag::ct_sem_error(mline, 1,
                                "a generic trait cannot carry a default method body", self->mem->path);
                        if (parse_trait_body(self, ti, mi, ret) != 0) return -1;
                    } else if (self->sup->expect(";") != 0) {
                        return -1;
                    }
                    self->sym->traits[ti].nm++;
                    continue;
                }
                self->lex->tok = save_tok;
                self->lex->toknum = save_num;
                self->lex->tokline = save_line;
                self->lex->pos = save_pos;
                self->lex->line = save_srcline;
                self->lex->bol = save_bol;
                self->lex->tokstr.ptr = save_text_ptr; self->lex->tokstr.len = save_text_len;
            }
            np = 0;
            self->sym->traits[ti].m[mi].variadic = 0;
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")"))) {
                for (;;) {
                    /* a static map is expanded at the call site, so its
                       signature may end in `...`; a real trait keeps the fixed
                       vtable slot and stays non-variadic */
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("...")) {
                        if (!self->unit_is_map)
                            return self->sup->fail("a trait method cannot be variadic");
                        self->sym->traits[ti].m[mi].variadic = 1;
                        self->sup->lex_next();
                        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")")))
                            return self->sup->fail("'...' must be the last parameter");
                        break;
                    }
                    /* a `borrow` annotation is not part of the vtable
                       signature: it only marks the parameter in `vars[]` when
                       the default body declares it (parse_trait_body) */
                    seen_borrow = 0;
                    seen_ref = 0;
                    seen_out = 0;
                    bline = self->lex->tokline;
                    if (self->lex->tok == T_ID && self->lex->tok_is("borrow")) {
                        seen_borrow = 1;
                        self->sup->lex_next();
                    } else if (self->lex->tok == T_ID && self->lex->tok_is("ref")) {
                        seen_ref = 1;
                        self->sup->lex_next();
                    } else if (self->lex->tok == T_ID && self->lex->tok_is("out")) {
                        seen_out = 1;
                        self->sup->lex_next();
                    }
                    self->sup->map_sig = self->unit_is_map;
                    rty = self->ex->parse_type_text(&ptype);
                    self->sup->map_sig = 0;
                    if (rty != 0) return -1;
                    pname = "";
                    if (self->lex->tok == T_ID) {
                        pname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                             self->lex->tokstr.len);
                        if (!pname) return self->sup->fail("out of memory");
                        self->sup->lex_next();
                    }
                    /* a parameter may be an array (`char a[][N]`): the dims
                       belong in the vtable signature too, or the impl's type
                       would not match it. The N_PARAM node keeps the base
                       type, the name and the dims apart, which is what a
                       default body's definition needs. */
                    {
                        int sp;
                        sp = self->sup->new_node(N_PARAM);
                        if (sp < 0) return -1;
                        self->arena->nodes[sp].text = ptype;
                        self->arena->nodes[sp].text2 = pname;
                        if (self->ex->parse_array_dims(sp) != 0) return -1;
                        if (self->arena->nodes[sp].text3[0]) {
                            ptype = runtime::text::ct_intern_join(
                                ptype, self->arena->nodes[sp].text3);
                            if (!ptype) return self->sup->fail("out of memory");
                        }
                        /* `aux` carries the annotation to the default body,
                           which is where the parameter becomes a variable:
                           1 = borrow, 2 = ref, 3 = out. `line` keeps the
                           position for its diagnostic */
                        self->arena->nodes[sp].aux = seen_borrow ? 1
                                                    : (seen_ref ? 2 : (seen_out ? 3 : 0));
                        if (seen_borrow || seen_ref || seen_out)
                            self->arena->nodes[sp].line = bline;
                        if ((seen_ref || seen_out)
                            && (self->arena->nodes[sp].text3[0] || self->ex->fnptr_state))
                            return self->sup->fail(
                                "ref/out parameters cannot be arrays or function pointers");
                        if ((seen_ref || seen_out) && seen_borrow)
                            return self->sup->fail("a parameter cannot be both 'borrow' and ref/out");
                        if (pfirst < 0) pfirst = sp;
                        else self->arena->nodes[ptail].next = sp;
                        ptail = sp;
                    }
                    if (self->sym->ensure_meth_param_capacity(ti, mi, np + 1) != 0)
                        return -1;
                    self->sym->traits[ti].m[mi].ptype[np] = ptype;
                    self->sym->traits[ti].m[mi].pann[np] =
                        seen_ref ? 2 : (seen_out ? 3 : 0);
                    np++;
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                        self->sup->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->sup->expect(")") != 0) return -1;
            /* D-60-1: the postfix `mut` sits between `)` and the body / `;`. */
            if (self->lex->tok == T_ID && self->lex->tok_is("mut")) {
                if (!self->unit_is_map)
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1,
                        "receiver mutability is only valid on a .m.ct trait method",
                        self->mem->path);
                self->sym->traits[ti].m[mi].is_mut = 1;
                self->sup->lex_next();
            }
            self->sym->traits[ti].m[mi].nparams = np;
            self->sym->traits[ti].m[mi].pnode = pfirst;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                if (self->unit_is_map)
                    return tool::diag::ct_sem_error(mline, 1,
                        "a .m.ct trait cannot carry a default body", self->mem->path);
                /* L35-3: a default body is expanded once per adopting struct,
                   so its `T` would need per-impl monomorphisation -- out of
                   scope for a parameterised trait. */
                if (ntp > 0)
                    return tool::diag::ct_sem_error(mline, 1,
                        "a generic trait cannot carry a default method body", self->mem->path);
                if (parse_trait_body(self, ti, mi, ret) != 0) return -1;
            } else if (self->sup->expect(";") != 0) {
                return -1;
            }
            self->sym->traits[ti].nm++;
        }
        if (self->sup->expect("}") != 0) return -1;
        /* D-6: a cycle of default bodies has no non-default method to break it
           and would recurse forever at run time. The declaration line is where
           the diagnostic belongs. S1a-0 C1: the adjacency matrix is sized by
           the trait's final method count (the old fixed 64x64 stack block was
           the MAX_METHODS cap); it is zeroed and released here. */
        stride = self->sym->traits[ti].nm;
        dcycle = 0;
        if (stride > 0) {
            size_t cells = (size_t)stride * (size_t)stride;
            edge = (char *)calloc(cells, 1);
            if (!edge) return self->sup->fail("out of memory");
            for (dm = 0; dm < stride; dm++)
                if (self->sym->traits[ti].m[dm].body >= 0)
                    trait_default_edges(self->arena,
                                        self->arena->nodes[self->sym->traits[ti].m[dm].body].a,
                                        self->sym, ti, dm, edge, stride);
            for (dk = 0; dk < stride; dk++)
                for (di = 0; di < stride; di++)
                    if (edge[di * stride + dk])
                        for (dj = 0; dj < stride; dj++)
                            if (edge[dk * stride + dj]) edge[di * stride + dj] = 1;
            for (di = 0; di < stride; di++)
                if (edge[di * stride + di]) dcycle = 1;
            free(edge);
        }
        if (dcycle)
            return tool::diag::ct_sem_error(trait_line, 1,
                tool::sh::ct_scratch_fmt(
                    "trait '%s' has no non-default method to break the cycle", name),
                self->mem->path);
        /* LANG-23: the built-in declaration is visible in lib/core but creates
           no dispatch row and no type entry. */
        if (discard) {
            self->sym->ntraits = save_ntraits;
            self->sym->ntype = save_ntype;
            /* no node from a discarded declaration may survive: literal ids
               and instance tags are arena indices, so a stray N_PARAM would
               shift every later unit's generated C. */
            self->arena->nnode = save_nnode;
        }
        return NO_NODE;
    }

    /* `impl T for S { methods }` -- one N_IMPL node carrying N_METHOD children. */
    int parse_impl(int is_pub)
    {
        int ti, si, node, mnode, params, body, tail, impl_line;
        int mline, mcol, nimpl, tm_i, k2, brace_line, brace_col, found, dup_i;
        const char *tname;
        const char *sname;
        const char *rtrait;
        const char *rstruct;
        const char *ret;
        const char *mname;
        const char *stype;
        int type_index;
        (void)self;

        impl_line = self->lex->tokline;
        if (is_pub)
            return tool::diag::ct_sem_error(impl_line, 1,
                "a pub impl block is not supported; mark methods",
                self->mem->path);
        self->sup->lex_next();
        /* Phase 29: `impl<T> Name<Args> [use Trait] { … }` writes against a
           template, so it has no struct row of its own. A `<` after a generic
           trait name instead creates its concrete row and rejoins the ordinary
           impl path below; every other template keeps the struct dispatcher. */
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("<"))
            return self->parse_impl_inst("", 1);
        if (self->lex->tok != T_ID) return self->sup->fail("expected a trait name");
        tname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                             self->lex->tokstr.len);
        if (!tname) return self->sup->fail("out of memory");
        self->sup->lex_next();
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
            /* S1a-0 C2p-3: the receiver spelling is a pool text, so a
               2000-byte struct/trait name survives the resolver. The encoded
               generic-trait name still uses the trait helper's own row. */
            rtrait = self->sym->resolve_type_text(tname);
            if (!rtrait) return -1;
            ti = self->sym->find_trait(rtrait);
            if (ti < 0 || self->sym->traits[ti].ntparams == 0)
                return self->parse_impl_inst(tname, 0);
            {
                char *rb = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
                if (!rb) return self->sup->fail("out of memory");
                snprintf(rb, TEXT_LIMIT, "%s", rtrait);
                ti = parse_trait_inst_args(self, rb, TEXT_LIMIT);
                if (ti < 0) return -1;
                rtrait = runtime::text::ct_intern(rb);
                if (!rtrait) return self->sup->fail("out of memory");
            }
        } else {
            rtrait = self->sym->resolve_type_text(tname);
            if (!rtrait) return -1;
            ti = self->sym->find_trait(rtrait);
        }
        /* Phase 34 S4: `impl Counter { … }` writes inherent methods on a
           non-generic struct. Only a `{` that follows a known struct takes
           this path; anything else keeps the trait-impl wording below. */
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
            const char *rinh;
            int si_inh;

            rinh = self->sym->resolve_type_text(tname);
            if (!rinh) return -1;
            si_inh = self->sym->find_struct(rinh);
            if (si_inh >= 0) return self->parse_impl_inherent(rinh, si_inh, impl_line);
            /* LANG-29 S3 / B2: an enum ADT is a nominal type too, so
               `impl N { … }` writes inherent methods without a trait. The
               struct row index is negative for an ADT (see
               `parse_impl_inherent`); `-2 - adt` keeps template impls (-1)
               distinct. */
            {
                int adi_inh = frontend::sym::ct_adt_find(rinh);
                if (adi_inh < 0) adi_inh = frontend::sym::ct_adt_find(tname);
                if (adi_inh >= 0)
                    return self->parse_impl_inherent(rinh, -2 - adi_inh, impl_line);
            }
        }
        /* A static trait has no iface and no vtable: it is bound by a `map`,
           never implemented. */
        if (ti >= 0 && self->sym->traits[ti].is_static) {
            if (tool::diag::ct_sem_error(impl_line, 1,
                    "a static trait cannot be implemented", self->mem->path) != 0) return -1;
            if (self->sup->skip_body() != 0) return -1;
            return NO_NODE;
        }
        /* `Drop` is built in: no `trait Drop` declaration exists, but
           `impl Drop for S` is legal and emits `S_Drop_drop` */
        if (ti < 0 && strcmp(rtrait, "Drop") != 0 && strcmp(rtrait, "Handback") != 0)
            return self->sup->fail("impl of an unknown trait");
        if (self->lex->tok != T_ID || !self->lex->tok_is("for"))
            return self->sup->fail("expected 'for' after the trait name");
        self->sup->lex_next();
        if (self->lex->tok != T_ID) return self->sup->fail("expected a struct name");
        sname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                             self->lex->tokstr.len);
        if (!sname) return self->sup->fail("out of memory");
        rstruct = self->sym->resolve_type_text(sname);
        if (!rstruct) return -1;
        /* the struct must exist (a forward declaration is enough); an undefined
           one is reported at the body's `{`, like L2, and the body is skipped so
           the declarations after it are still parsed (Phase 10.4 recovery) */
        si = self->sym->find_struct(rstruct);
        self->sup->lex_next();
        if (si < 0) {
            const char *msg = runtime::text::ct_internf(
                "impl for undefined struct '%s'", sname);
            if (!msg) return self->sup->fail("out of memory");
            if (tool::diag::ct_sem_error(self->lex->tokline, self->lex->tokstart - self->lex->lstart + 1, msg, self->mem->path) != 0)
                return -1;
            if (self->sup->skip_body() != 0) return -1;
            return NO_NODE;
        }
        type_index = self->sym->find_type(rstruct);
        if (type_index >= 0 && self->sym->types[type_index].kind == 1) {
            stype = runtime::text::ct_internf("struct %s", rstruct);
            if (!stype) return self->sup->fail("out of memory");
        } else {
            stype = rstruct;
        }
        /* A second impl of the same (struct, trait) would emit the vtable and the
           methods twice; with external linkage that is a duplicate symbol, so the
           duplicate is refused and the first definition is named by its unit. */
        for (dup_i = 0; dup_i < self->arena->nnode; dup_i++)
            if (self->arena->nodes[dup_i].kind == N_IMPL && self->arena->nodes[dup_i].aux == si
                && strcmp(self->arena->nodes[dup_i].text2, rtrait) == 0) {
                const char *dmsg = runtime::text::ct_internf(
                         "duplicate impl of trait '%s' for struct '%s' (first at %s:%d)",
                         tname, sname, self->arena->nodes[dup_i].text3, self->arena->nodes[dup_i].line);
                if (!dmsg) return self->sup->fail("out of memory");
                if (tool::diag::ct_sem_error(impl_line, 1, dmsg, self->mem->path) != 0) return -1;
                if (self->sup->skip_body() != 0) return -1;
                return NO_NODE;
            }
        /* the borrow declaration needs to know that this unit wrote the handback
           body: `use Handback` alone would hand back to nothing */
        if (strcmp(rtrait, "Handback") == 0) self->sym->structs[si].has_handback_impl = 1;
        /* PH-48 D48-2: the concrete impl Drop marks the struct row too. The
           generic template path already does this when an instance is created;
           without it a consumer unit could not distinguish no impl at all (the
           owner emits the recursive glue) from an impl in a different unit
           (L48-2). */
        if (strcmp(rtrait, "Drop") == 0) self->sym->structs[si].has_drop_impl = 1;
        brace_line = self->lex->tokline;
        brace_col = self->lex->tokstart - self->lex->lstart + 1;
        if (self->sup->expect("{") != 0) return -1;
        node = self->sup->new_node(N_IMPL);
        if (node < 0) return -1;
        self->arena->nodes[node].line = impl_line;
        self->arena->nodes[node].text2 = rtrait;
        self->arena->nodes[node].aux = si;
        self->arena->nodes[node].text = stype;
        self->arena->nodes[node].text3 = runtime::text::ct_intern(self->mem->path);
        if (!self->arena->nodes[node].text3) return self->sup->fail("out of memory");
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            mline = self->lex->tokline;
            /* V29-3: a vtable slot is a function pointer without a receiver, so
               `static` cannot fill it. Reading it as a return-type qualifier used
               to only warn about the signature and still ship the method in the
               vtable (docs/language-spec.md L29-3 promises a hard error). */
            if (self->lex->tok == T_ID && self->lex->tok_is("pub"))
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    "a trait impl method cannot be pub", self->mem->path);
            if (self->lex->tok == T_ID && self->lex->tok_is("static"))
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    "a static method cannot implement a trait", self->mem->path);
            if (self->ex->parse_type_text(&ret) != 0) return -1;
            if (self->ex->fnptr_state)
                return self->sup->fail("an impl method cannot return a function pointer");
            if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
            /* S1a-0 C2p-7: the method name is a pool text, so a 2000-byte
               method name matches the trait's row and reaches every emitted
               spelling whole. */
            mname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!mname) return self->sup->fail("out of memory");
            mcol = self->lex->tokstart - self->lex->lstart + 1;
            self->sup->lex_next();
            if (self->sup->push_scope() != 0) return -1;
            if (self->sup->declare_var("self", stype) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            params = self->parse_params();
            if (params < 0) {
                self->sup->pop_scope();
                return -1;
            }
            /* the vtable slot is a fixed function-pointer type, so a method
               cannot carry a variadic tail */
            if (self->variadic) {
                self->sup->pop_scope();
                return self->sup->fail("a trait method cannot be variadic");
            }
            /* Signature consistency against the trait -- a warning, not an error.
               The wording and the line (the method's, not the impl's) match L2
               (D39), so the module fixtures can be compared byte for byte. */
            nimpl = 0;
            for (k2 = params; k2 > 0; k2 = self->arena->nodes[k2].next) nimpl++;
            tm_i = 0;
            if (ti >= 0)
                for (tm_i = 0; tm_i < self->sym->traits[ti].nm; tm_i++)
                    if (strcmp(self->sym->traits[ti].m[tm_i].name, mname) == 0) break;
            if (ti >= 0 && tm_i < self->sym->traits[ti].nm) {
                const char *wmsg;
                if (ret[0] && strcmp(ret, self->sym->traits[ti].m[tm_i].ret) != 0) {
                    wmsg = runtime::text::ct_internf(
                             "return type '%s' does not match the trait's '%s'",
                             ret, self->sym->traits[ti].m[tm_i].ret);
                    if (!wmsg) return self->sup->fail("out of memory");
                    if (tool::diag::ct_sig_warn(mline, mcol, mname, rtrait, rstruct, wmsg, self->mem->path) != 0) {
                        self->sup->pop_scope();
                        return -1;
                    }
                } else if (nimpl != self->sym->traits[ti].m[tm_i].nparams) {
                    wmsg = runtime::text::ct_internf(
                             "takes %d parameter(s), the trait declares %d",
                             nimpl, self->sym->traits[ti].m[tm_i].nparams);
                    if (!wmsg) return self->sup->fail("out of memory");
                    if (tool::diag::ct_sig_warn(mline, mcol, mname, rtrait, rstruct, wmsg, self->mem->path) != 0) {
                        self->sup->pop_scope();
                        return -1;
                    }
                } else {
                    /* 19.3: the parameter types, one position at a time, the
                       coarse rules of 19.2. This is where an imported unit's
                       exported signature meets the local impl -- the check
                       runs against the shared trait table, so the trait's home
                       unit makes no difference. An array parameter decays and
                       stays unknown; the first mismatching position is enough. */
                    int pk = 0;
                    for (k2 = params; k2 > 0; k2 = self->arena->nodes[k2].next) {
                        const char *ft = self->sym->traits[ti].m[tm_i].ptype[pk];
                        if (!strchr(ft, '[') && !self->arena->nodes[k2].text3[0]
                            && self->ex->decl_type_compat(ft, self->arena->nodes[k2].text) == 1) {
                            wmsg = runtime::text::ct_internf(
                                     "parameter %d type '%s' does not match the trait's '%s'",
                                     pk + 1, self->arena->nodes[k2].text, ft);
                            if (!wmsg) return self->sup->fail("out of memory");
                            if (tool::diag::ct_sig_warn(mline, mcol, mname, rtrait, rstruct,
                                                        wmsg, self->mem->path) != 0) {
                                self->sup->pop_scope();
                                return -1;
                            }
                            break;
                        }
                        pk++;
                    }
                }
                /* Phase 78 S2b: the ref/out annotation is part of the vtable
                   slot's C type, not just a source spelling. An impl that
                   disagrees (a pointer slot filled by a value function) would
                   compile as an incompatible function pointer and misread the
                   arguments, so this one is a hard error rather than the
                   forgiving signature warning above. */
                if (tm_i < self->sym->traits[ti].nm) {
                    int pk2 = 0;
                    for (k2 = params; k2 > 0
                         && pk2 < self->sym->traits[ti].m[tm_i].nparams;
                         k2 = self->arena->nodes[k2].next, pk2++) {
                        int impl_ann = self->arena->nodes[k2].aux;
                        int trait_ann = self->sym->traits[ti].m[tm_i].pann[pk2];
                        if (impl_ann != trait_ann) {
                            char amsg[MAX_TEXT + 96];
                            snprintf(amsg, sizeof amsg,
                                     "parameter %d ref/out annotation does not match the trait's",
                                     pk2 + 1);
                            return tool::diag::ct_sem_error(mline, mcol, amsg,
                                                            self->mem->path);
                        }
                    }
                }
            }
            self->sym->ret_type = ret;
            self->cur_func = runtime::text::ct_internf("%s_%s_%s",
                     self->sym->structs[si].name, rtrait, mname);
            if (!self->cur_func) return self->sup->fail("out of memory");
            /* the method body tracks leaks too; a method symbol is not in the
               function table, so nothing feeds `ret_owned` back to callers */
            self->mem->leak_active = 1;
            self->mem->leak_frame = self->sym->nscope + 1;
            self->mem->leak_impl = 1;
            self->st->func_begin();
            body = self->st->parse_block();
            self->mem->leak_active = 0;
            self->mem->leak_frame = -1;
            self->mem->leak_impl = 0;
            self->cur_func = "";
            self->sym->ret_type = "";
            if (body < 0) {
                self->sup->pop_scope();
                return -1;
            }
            /* Phase 78 S2b: impl methods obey the same `out` L1 rule as a
               free function, as does a trait default body. */
            if (self->out_check_body(body, params, mline) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->st->func_end() != 0) {
                self->sup->pop_scope();
                return -1;
            }
            self->sup->pop_scope();
            mnode = self->sup->new_node(N_METHOD);
            if (mnode < 0) return -1;
            self->arena->nodes[mnode].text = runtime::text::ct_intern(ret);
            if (!self->arena->nodes[mnode].text) return self->sup->fail("out of memory");
            self->arena->nodes[mnode].text2 = runtime::text::ct_intern(mname);
            if (!self->arena->nodes[mnode].text2) return self->sup->fail("out of memory");
            /* The emitted function takes the trait's return type (L2 does the
               same), so a mismatching impl still yields C that compiles; the
               map keeps the impl's written type in `text`. */
            if (ti >= 0 && tm_i < self->sym->traits[ti].nm) {
                    self->arena->nodes[mnode].text3 = runtime::text::ct_intern(self->sym->traits[ti].m[tm_i].ret);
                    if (!self->arena->nodes[mnode].text3) return self->sup->fail("out of memory");
            }
            self->arena->nodes[mnode].a = params;
            self->arena->nodes[mnode].b = body;
            self->arena->nodes[mnode].num = ti;
            self->arena->nodes[mnode].aux = si;
            if (tail < 0) self->arena->nodes[node].a = mnode;
            else self->arena->nodes[tail].next = mnode;
            tail = mnode;
        }
        if (self->sup->expect("}") != 0) return -1;
        /* A missing method would leave a NULL slot in the vtable and crash on
           the first call; L0 and L2 reject the same input up front, so accepting
           it here would be a regression against our own oracle. A method with a
           default body is not missing: the emitter expands it (D-4). Reported at
           the impl's `{` -- the position and the wording L2 uses. The error
           counter makes `parse_program` drop the unit, so no C is emitted. */
        if (ti >= 0) {
            for (tm_i = 0; tm_i < self->sym->traits[ti].nm; tm_i++) {
                if (self->sym->traits[ti].m[tm_i].body >= 0) continue;
                found = 0;
                for (k2 = self->arena->nodes[node].a; k2 >= 0; k2 = self->arena->nodes[k2].next)
                    if (strcmp(self->arena->nodes[k2].text2, self->sym->traits[ti].m[tm_i].name) == 0) {
                        found = 1;
                        break;
                    }
                if (!found) {
                    /* S1a-0 C2p: a run-scoped message, so a long struct or
                       method name is not cut at the old emsg[160]. */
                    tool::diag::ct_sem_error(brace_line, brace_col,
                        tool::sh::ct_scratch_fmt(
                            "trait method '%s' is not implemented for struct '%s'",
                            self->sym->traits[ti].m[tm_i].name, sname),
                        self->mem->path);
                }
            }
        }
        /* L36-1 (S1b): a `drop` body may not `release()` the same `self` field
           twice. Walk the `drop` method's body and report the first duplicate. */
        if (strcmp(rtrait, "Drop") == 0) {
            int mi;
            for (mi = self->arena->nodes[node].a; mi >= 0;
                 mi = self->arena->nodes[mi].next) {
                if (strcmp(self->arena->nodes[mi].text2, "drop") != 0) continue;
                if (self->drop_release_scan(self->arena->nodes[mi].b) != 0)
                    return -1;
                break;
            }
        }
        return node;
    }

    /* Phase 34 S4 (D34-4): `impl Counter { … }` -- inherent methods on a
       non-generic struct. The block is an N_IMPL node whose trait name (`text2`)
       is empty; the emitter's trait paths skip it, and S5 wires the lookup,
       the static dispatch and the cross-unit prototype. The method symbols are
       `<Struct>_<method>`, the same shape a template impl emits, so nothing
       about the trait machinery (`ti`, vtable slots) applies here. */
    int parse_impl_inherent(const char *rname, int si, int impl_line)
    {
        int node, mnode, params, body, tail, mline, is_static, is_pub;
        const char *ret;
        const char *mname;
        const char *stype;
        int type_index;
        /* LANG-29 S3 / B2: `si <= -2` encodes an enum ADT row (`-2 - adt`),
           because an ADT has no struct row of its own. Its C spelling is the
           generated `struct <full>` and its methods are named `<tag>_<method>`
           exactly like a plain struct's. */
        int adt = (si <= -2) ? (-2 - si) : -1;
        int type_is_pub = 0;

        if (adt >= 0) {
            struct Adt *adts;
            int nadts;
            adts = frontend::sym::ct_adts(&nadts);
            if (!adts || adt >= nadts)
                return self->sup->fail("the ADT row is missing");
            stype = runtime::text::ct_internf("struct %s", adts[adt].full);
            if (!stype) return self->sup->fail("out of memory");
            type_is_pub = adts[adt].is_pub;
        } else {
            type_index = self->sym->find_type(rname);
            if (type_index >= 0 && self->sym->types[type_index].kind == 1) {
                stype = runtime::text::ct_internf("struct %s", rname);
                if (!stype) return self->sup->fail("out of memory");
            } else {
                stype = rname;
            }
            type_is_pub = self->sym->structs[si].is_pub;
        }
        if (self->sup->expect("{") != 0) return -1;
        node = self->sup->new_node(N_IMPL);
        if (node < 0) return -1;
        self->arena->nodes[node].line = impl_line;
        self->arena->nodes[node].text = stype;
        self->arena->nodes[node].text2 = runtime::text::ct_intern("");   /* inherent: no trait */
        if (!self->arena->nodes[node].text2) return self->sup->fail("out of memory");
        self->arena->nodes[node].aux = si;
        self->arena->nodes[node].text3 = runtime::text::ct_intern(self->mem->path);
        if (!self->arena->nodes[node].text3) return self->sup->fail("out of memory");
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            mline = self->lex->tokline;
            /* P29-2: a receiverless method (`static Counter make()`) is written
               as `<Struct>_<method>` and takes no `self`. Phase 42: a method
               is private by default; `pub`/`pub static` opt in. */
            is_static = 0;
            is_pub = 0;
            if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                is_pub = 1;
                self->sup->lex_next();
            }
            if (self->lex->tok == T_ID && self->lex->tok_is("static")) {
                is_static = 1;
                self->sup->lex_next();
                if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                    if (is_pub) return self->sup->fail("duplicate pub on one method");
                    is_pub = 1;
                    self->sup->lex_next();
                }
            } else if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                return self->sup->fail("duplicate pub on one method");
            }
            if (is_pub && (!self->unit_is_hdr || !type_is_pub))
                return tool::diag::ct_sem_error(mline, 1,
                    adt >= 0
                        ? "a pub method needs a pub ADT in a .h.ct unit"
                        : "a pub method needs a pub struct in a .h.ct unit",
                    self->mem->path);
            if (self->ex->parse_type_text(&ret) != 0) return -1;
            if (self->ex->fnptr_state)
                return self->sup->fail("an impl method cannot return a function pointer");
            if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
            /* S1a-0 C2p-7: the method name is a pool text, so a 2000-byte
               method name matches the trait's row and reaches every emitted
               spelling whole. */
            mname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!mname) return self->sup->fail("out of memory");
            self->sup->lex_next();
            if (self->sup->push_scope() != 0) return -1;
            if (!is_static && self->sup->declare_var("self", stype) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            params = self->parse_params();
            if (params < 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->variadic) {
                self->sup->pop_scope();
                return self->sup->fail("a struct method cannot be variadic");
            }
            /* Phase 78 S2b: record this inherent method's ref/out annotations
               for the call site (a trait impl keeps them on its MethodSig). */
            {
                int *pa, pn = 0, pk3, pnmax = 0;
                for (pk3 = params; pk3 > 0; pk3 = self->arena->nodes[pk3].next) pnmax++;
                pa = pnmax > 0 ? (int *)calloc((size_t)pnmax, sizeof(*pa)) : 0;
                if (pnmax > 0 && !pa) {
                    self->sup->pop_scope();
                    return self->sup->fail("out of memory");
                }
                for (pk3 = params; pk3 > 0 && pn < pnmax;
                     pk3 = self->arena->nodes[pk3].next)
                    pa[pn++] = self->arena->nodes[pk3].aux;
                if (self->sym->add_meth_ann(rname, mname, pa, pn) != 0) {
                    free(pa);
                    self->sup->pop_scope();
                    return -1;
                }
                free(pa);
            }
            self->sym->ret_type = ret;
            self->cur_func = runtime::text::ct_internf("%s_%s", rname, mname);
            if (!self->cur_func) return self->sup->fail("out of memory");
            self->mem->leak_active = 1;
            self->mem->leak_frame = self->sym->nscope + 1;
            self->mem->leak_impl = 1;
            self->st->func_begin();
            body = self->st->parse_block();
            self->mem->leak_active = 0;
            self->mem->leak_frame = -1;
            self->mem->leak_impl = 0;
            self->cur_func = "";
            self->sym->ret_type = "";
            if (body < 0) {
                self->sup->pop_scope();
                return -1;
            }
            /* Phase 78 S2b: impl methods obey the same `out` L1 rule as a
               free function, as does a trait default body. */
            if (self->out_check_body(body, params, mline) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->st->func_end() != 0) {
                self->sup->pop_scope();
                return -1;
            }
            self->sup->pop_scope();
            (void)mline;
            mnode = self->sup->new_node(N_METHOD);
            if (mnode < 0) return -1;
            self->arena->nodes[mnode].text = runtime::text::ct_intern(ret);
            if (!self->arena->nodes[mnode].text) return self->sup->fail("out of memory");
            self->arena->nodes[mnode].text2 = runtime::text::ct_intern(mname);
            if (!self->arena->nodes[mnode].text2) return self->sup->fail("out of memory");
            self->arena->nodes[mnode].a = params;
            self->arena->nodes[mnode].b = body;
            self->arena->nodes[mnode].num = -1;   /* no trait */
            self->arena->nodes[mnode].aux = si;
            self->arena->nodes[mnode].c = is_static;
            self->arena->nodes[mnode].d = is_pub;
            if (tail < 0) self->arena->nodes[node].a = mnode;
            else self->arena->nodes[tail].next = mnode;
            tail = mnode;
        }
        if (self->sup->expect("}") != 0) return -1;
        return node;
    }

    /* Phase 29: `impl<T> Name<Args> [ use Trait ] { methods }`. The block has no
       struct row of its own -- it is registered build-wide against the template
       together with its argument pattern, and the emitter monomorphises the
       methods once per matching instance. A `use` clause fills the trait's
       vtable slots for every instance; without one the methods are inherent and
       the call site dispatches statically (no vtable, no dynamic dispatch). */
    int parse_impl_inst(const char *tmpl_in, int have_name)
    {
        const char *tmpl;
        char **tn = 0;
        char **pat = 0;
        int tcap = 0, pcap = 0;
        const char *use;
        const char *ruse;
        const char *ret;
        const char *mname;
        const char *htype;
        int nt, nargs, line, node, tail, mnode, params, body, ti, mline, is_static, is_pub;

        nt = 0;
        nargs = 0;
        htype = "void *";
        use = "";
        tmpl = tmpl_in;
        line = self->lex->tokline;
        if (have_name) {
            /* the cursor sits on `<` */
            self->sup->lex_next();
            for (;;) {
                tn = frontend::sym::ct_rows_reserve(tn, tcap, nt + 1, &tcap);
                if (!tn || tcap < nt + 1)
                    return self->sup->fail("a generic struct has too many type parameters");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a type parameter name");
                self->lex->tok_copy(tn[nt], MAX_TEXT);
                nt++;
                self->sup->lex_next();
                /* Phase 33 O1 (L33-2): the bound belongs to the struct
                   declaration; repeating it here would create a second source
                   of truth (D33-3). The message names both what was repeated
                   and where the repeat sits. */
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                    const char *braw;
                    int bl, bc;
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a trait name after ':'");
                    bl = self->lex->tokline;
                    bc = self->lex->tokstart - self->lex->lstart + 1;
                    braw = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                        self->lex->tokstr.len);
                    if (!braw) return self->sup->fail("out of memory");
                    return tool::diag::ct_sem_error(bl, bc, tool::sh::ct_scratch_fmt(
                        "impl type parameter '%s' cannot repeat the bound '%s'",
                        tn[nt - 1], braw), self->mem->path);
                }
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(">")))
                return self->sup->fail("expected '>' after the type parameters");
            self->sup->lex_next();
            if (self->lex->tok != T_ID)
                return self->sup->fail("expected a struct name");
            tmpl = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                self->lex->tokstr.len);
            if (!tmpl) return self->sup->fail("out of memory");
            self->sup->lex_next();
            /* P36 S1a: `impl<T> Drop for Box<T>` -- the built-in trait name comes
               first, then `for`, then the struct and its type arguments. The
               built-in `Drop`/`Handback` need no trait lookup; everything else
               must resolve. */
            if (self->lex->tok == T_ID && self->lex->tok_is("for")) {
                const char *tname = tmpl;
                self->sup->lex_next();
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a struct name after 'for'");
                tmpl = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                    self->lex->tokstr.len);
                if (!tmpl) return self->sup->fail("out of memory");
                self->sup->lex_next();
                if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0) {
                    ti = -1;
                } else {
                    ti = self->sym->find_trait(tname);
                    if (ti < 0) return self->sup->fail("impl of an unknown trait");
                }
                use = tname;
            }
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
            self->sup->lex_next();
            for (;;) {
                pat = frontend::sym::ct_rows_reserve(pat, pcap, nargs + 1, &pcap);
                if (!pat || pcap < nargs + 1)
                    return self->sup->fail("a generic struct has too many type arguments");
                {
                    int aline = self->lex->tokline;
                    int acol = self->lex->tokstart - self->lex->lstart + 1;
                    int l4line = 0, l4col = 0, deep = 0, badp = 0;

                    if (self->parse_pat_arg(pat[nargs], MAX_TEXT, 0,
                                            &l4line, &l4col, &deep, &badp) != 0)
                        return -1;
                    if (deep)
                        return tool::diag::ct_sem_error(l4line, l4col,
                            "impl pattern nesting exceeds 4 levels", self->mem->path);
                    if (!badp) {
                        /* L33-5: a pointer suffix on a type parameter (`T *`)
                           has no concrete spelling to bind; a concrete pointer
                           (`char *`) keeps the old support. */
                        char *cs = tool::sh::ct_scratch_alloc(
                                       (int)strlen(pat[nargs]) + 1);
                        int cn = 0, bi;
                        const char *cs0 = pat[nargs];

                        if (!cs) return self->sup->fail("out of memory");
                        while (*cs0) {
                            if (*cs0 != ' ' && *cs0 != '\t') cs[cn++] = *cs0;
                            cs0++;
                        }
                        cs[cn] = 0;
                        for (bi = 0; bi < nt && !badp; bi++) {
                            const char *q = cs;
                            int tl = (int)strlen(tn[bi]);
                            while ((q = strstr(q, tn[bi])) != 0) {
                                int pre = q == cs
                                    || !((q[-1] >= 'a' && q[-1] <= 'z')
                                         || (q[-1] >= 'A' && q[-1] <= 'Z')
                                         || (q[-1] >= '0' && q[-1] <= '9')
                                         || q[-1] == '_');
                                if (pre && q[tl] == '*') badp = 1;
                                q += tl;
                            }
                        }
                    }
                    if (badp)
                        return tool::diag::ct_sem_error(aline, acol,
                            tool::sh::ct_scratch_fmt("unsupported impl pattern '%s'",
                                                     pat[nargs]),
                            self->mem->path);
                }
                nargs++;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(">")))
                return self->sup->fail("expected '>' after the type arguments");
            self->sup->lex_next();
        }
        ti = -1;
        if (!use[0] && self->lex->tok == T_ID && self->lex->tok_is("use")) {
            self->sup->lex_next();
            if (self->lex->tok != T_ID)
                return self->sup->fail("expected a trait name after 'use'");
            use = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                               self->lex->tokstr.len);
            if (!use) return self->sup->fail("out of memory");
            ruse = self->sym->resolve_type_text(use);
            if (!ruse) return -1;
            use = ruse;
            ti = self->sym->find_trait(use);
            if (ti < 0 && strcmp(use, "Drop") != 0 && strcmp(use, "Handback") != 0)
                return self->sup->fail("impl of an unknown trait");
            self->sup->lex_next();
            /* Phase 35 S5b (D35-6): a template impl may adopt a generic trait
               only in the one-to-one shape `impl<T> MyVec<T> use Iter<T>`. The
               row is created per instance (S5a), so the impl keeps the symbolic
               spelling and the emitter binds it when the struct instance binds. */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                char *full = 0;
                int fcap = 0;
                const char *targ;
                int na = 0, ai, bad = 0;

                self->sup->lex_next();
                for (;;) {
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a type argument");
                    targ = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                        self->lex->tokstr.len);
                    if (!targ) return self->sup->fail("out of memory");
                    if (na >= nt || strcmp(targ, tn[na]) != 0) bad = 1;
                    na++;
                    self->sup->lex_next();
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                        self->sup->lex_next();
                        continue;
                    }
                    break;
                }
                if (self->sup->expect(">") != 0) return -1;
                if (na != nt) bad = 1;
                if (bad)
                    return tool::diag::ct_sem_error(line, 1,
                        "unsupported generic trait implementation shape", self->mem->path);
                if (tool::sh::ct_text_init(&full, &fcap, 64) != 0)
                    return self->sup->fail("out of memory");
                if (tool::sh::ct_text_cat(&full, &fcap, ruse) != 0
                    || tool::sh::ct_text_cat(&full, &fcap, "<") != 0)
                    return self->sup->fail("out of memory");
                for (ai = 0; ai < na; ai++) {
                    if (ai > 0 && tool::sh::ct_text_cat(&full, &fcap, ",") != 0)
                        return self->sup->fail("out of memory");
                    if (tool::sh::ct_text_cat(&full, &fcap, tn[ai]) != 0)
                        return self->sup->fail("out of memory");
                }
                if (tool::sh::ct_text_cat(&full, &fcap, ">") != 0)
                    return self->sup->fail("out of memory");
                use = runtime::text::ct_intern(full);
                tool::sh::ct_text_free(&full, &fcap);
                if (!use) return self->sup->fail("out of memory");
            }
        }
        if (self->sup->expect("{") != 0) return -1;
        node = self->sup->new_node(N_IMPL);
        if (node < 0) return -1;
        self->arena->nodes[node].line = line;
        self->arena->nodes[node].text = runtime::text::ct_intern(tmpl);
        if (!self->arena->nodes[node].text) return self->sup->fail("out of memory");
        self->arena->nodes[node].text2 = runtime::text::ct_intern(use);
        if (!self->arena->nodes[node].text2) return self->sup->fail("out of memory");
        self->arena->nodes[node].text3 = runtime::text::ct_intern(self->mem->path);
        if (!self->arena->nodes[node].text3) return self->sup->fail("out of memory");
        self->arena->nodes[node].aux = -1;   /* no struct row: this is a template */
        self->arena->nodes[node].num = frontend::sym::ct_impl_add(tmpl, nt, tn,
                                                                 nargs, pat, use,
                                                                 node, self->cur_unit, line);
        if (self->arena->nodes[node].num < 0) return self->sup->fail("out of memory");
        if (use[0] && self->arena->nodes[node].num >= 0) {
            /* Instances that already exist adopt the trait now; the ones that
               appear later adopt it in `parse_inst_type`. Both fill the use
               list the vptr field, the initialiser and the dispatch read.
               P36 S2a: the built-in `Drop`/`Handback` have no vptr, so instead
               of adopting them we mark the matched instance rows. */
            int is_builtin = (strcmp(use, "Drop") == 0 || strcmp(use, "Handback") == 0)
                             && self->sym->find_trait(use) < 0;
            int ii2, nins2;
            struct StructInst *ins2 = frontend::sym::ct_insts(&nins2);
            for (ii2 = 0; ii2 < nins2; ii2++)
                if (frontend::sym::ct_impl_matches(self->arena->nodes[node].num, ii2)) {
                    if (is_builtin) {
                        if (strcmp(use, "Drop") == 0) {
                            int si_d = self->sym->find_struct(ins2[ii2].name);
                            if (si_d >= 0)
                                self->sym->structs[si_d].has_drop_impl = 1;
                        }
                    } else {
                        self->sup->adopt_use(ins2[ii2].name, use);
                    }
                }
        }
        tail = -1;
        self->ex->in_generic_tparam = tn;
        self->ex->in_generic_ntparam = nt;
        /* Phase 33 O1 (D33-3): the method bodies inherit the struct's bound by
           the parameter's *position* in the pattern (`impl<U> Box<U>` maps
           through `pat`, not through the name), so `self->value.show()`
           dispatches exactly like inside a bounded generic function. A bound
           that lands on the second parameter is not wired: the dispatch check
           reads one bound, the same limit a generic function has. */
        self->ex->in_generic_bound = "";
        {
            int tbi = frontend::sym::ct_tmpl_find(tmpl, self->cur_unit);
            int tbn, kb;
            struct StructTmpl *tps = frontend::sym::ct_tmpls(&tbn);
            (void)tbn;
            if (tbi >= 0 && tps && tps[tbi].ntparams > 0 && tn[0][0]) {
                for (kb = 0; kb < nargs; kb++)
                    if (strcmp(pat[kb], tn[0]) == 0) {
                        self->ex->in_generic_bound =
                            runtime::text::ct_intern(tps[tbi].bound[kb]);
                        if (!self->ex->in_generic_bound)
                            return self->sup->fail("out of memory");
                        /* A bounded body types `self` as the template's tag,
                           so `self->value` resolves to the parameter and the
                           dispatch above can see it; the emitter keeps its own
                           `void *self` and casts, so the C is unchanged. */
                        if (self->ex->in_generic_bound[0]) {
                            htype = runtime::text::ct_internf("struct %s", tmpl);
                            if (!htype) return self->sup->fail("out of memory");
                        }
                        break;
                    }
            }
        }
        /* v1-PH-2 S6: a generic ADT impl types `self` as the template's C tag
           (the ADT's `full`), so `match (self)` sees an ADT subject and can
           name the template's variants. The emitted C still spells the
           receiver `void *` and casts, exactly like the bounded-struct path. */
        {
            int tbi2 = frontend::sym::ct_tmpl_find(tmpl, self->cur_unit);
            int tbn2;
            struct StructTmpl *tps2 = frontend::sym::ct_tmpls(&tbn2);
            (void)tbn2;
            if (tbi2 >= 0 && tps2 && tps2[tbi2].is_adt) {
                int adn2;
                struct Adt *ad2 = frontend::sym::ct_adts(&adn2);
                int ai2 = tps2[tbi2].adt;
                if (!ad2 || ai2 < 0 || ai2 >= adn2)
                    return self->sup->fail("the ADT row is missing");
                htype = runtime::text::ct_internf("struct %s", ad2[ai2].full);
                if (!htype) return self->sup->fail("out of memory");
            }
        }
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            mline = self->lex->tokline;
            ret = "";
            /* P29-2: `static Vec<T> from(T *items, int n)` -- an inherent
               method with no receiver. It is emitted as `<Inst>_<method>` with
               no `self` parameter, so a container can be built from an array
               without the compiler knowing the container's fields (B29-3). A
               trait block fills vtable slots, which a receiverless function
               cannot do, so `use` rejects it. */
            is_static = 0;
            is_pub = 0;
            if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                is_pub = 1;
                self->sup->lex_next();
                if (use[0])
                    return tool::diag::ct_sem_error(mline, 1,
                        "a trait impl method cannot be pub", self->mem->path);
            }
            if (self->lex->tok == T_ID && self->lex->tok_is("static")) {
                if (use[0])
                    return self->sup->fail("a static method cannot implement a trait");
                is_static = 1;
                self->sup->lex_next();
                if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                    if (is_pub) return self->sup->fail("duplicate pub on one method");
                    is_pub = 1;
                    self->sup->lex_next();
                }
            } else if (self->lex->tok == T_ID && self->lex->tok_is("pub")) {
                return self->sup->fail("duplicate pub on one method");
            }
            if (is_pub) {
                int tsi = self->sym->find_struct(tmpl);
                int tpub = 0;
                int is_adt_t = 0;
                if (tsi >= 0) {
                    tpub = self->sym->structs[tsi].is_pub;
                } else {
                    /* v1-PH-2 S6: a generic ADT template has no struct row;
                       its ADT row carries the `pub` flag. */
                    int tbi3 = frontend::sym::ct_tmpl_find(tmpl, self->cur_unit);
                    int tbn3;
                    struct StructTmpl *tps3 = frontend::sym::ct_tmpls(&tbn3);
                    if (tbi3 >= 0 && tps3 && tps3[tbi3].is_adt) {
                        int adn3;
                        struct Adt *ad3 = frontend::sym::ct_adts(&adn3);
                        int ai3 = tps3[tbi3].adt;
                        if (ad3 && ai3 >= 0 && ai3 < adn3) {
                            tpub = ad3[ai3].is_pub;
                            is_adt_t = 1;
                        }
                    }
                }
                if (!self->unit_is_hdr || !tpub)
                    return tool::diag::ct_sem_error(mline, 1,
                        is_adt_t
                            ? "a pub method needs a pub ADT in a .h.ct unit"
                            : "a pub method needs a pub struct in a .h.ct unit",
                        self->mem->path);
            }
            if (self->ex->parse_type_text(&ret) != 0) return -1;
            if (self->ex->fnptr_state)
                return self->sup->fail("an impl method cannot return a function pointer");
            if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
            /* S1a-0 C2p-7: the method name is a pool text, so a 2000-byte
               method name matches the trait's row and reaches every emitted
               spelling whole. */
            mname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!mname) return self->sup->fail("out of memory");
            self->sup->lex_next();
            if (self->sup->push_scope() != 0) return -1;
            if (!is_static && self->sup->declare_var("self", htype) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            params = self->parse_params();
            if (params < 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->variadic) {
                self->sup->pop_scope();
                return self->sup->fail("a struct method cannot be variadic");
            }
            /* Phase 78 S2b: the template host is normalised, so an instance
               call (`Box<int>`) finds the annotation row. */
            {
                int *pa, pn = 0, pk3, pnmax = 0;
                for (pk3 = params; pk3 > 0; pk3 = self->arena->nodes[pk3].next) pnmax++;
                pa = pnmax > 0 ? (int *)calloc((size_t)pnmax, sizeof(*pa)) : 0;
                if (pnmax > 0 && !pa) {
                    self->sup->pop_scope();
                    return self->sup->fail("out of memory");
                }
                for (pk3 = params; pk3 > 0 && pn < pnmax;
                     pk3 = self->arena->nodes[pk3].next)
                    pa[pn++] = self->arena->nodes[pk3].aux;
                if (self->sym->add_meth_ann(tmpl, mname, pa, pn) != 0) {
                    free(pa);
                    self->sup->pop_scope();
                    return -1;
                }
                free(pa);
            }
            self->sym->ret_type = ret;
            self->cur_func = runtime::text::ct_internf("%s_%s", tmpl, mname);
            if (!self->cur_func) return self->sup->fail("out of memory");
            self->mem->leak_active = 1;
            self->mem->leak_frame = self->sym->nscope + 1;
            self->mem->leak_impl = 1;
            self->st->func_begin();
            body = self->st->parse_block();
            self->mem->leak_active = 0;
            self->mem->leak_frame = -1;
            self->mem->leak_impl = 0;
            self->cur_func = "";
            self->sym->ret_type = "";
            if (body < 0) {
                self->sup->pop_scope();
                return -1;
            }
            /* Phase 78 S2b: impl methods obey the same `out` L1 rule as a
               free function, as does a trait default body. */
            if (self->out_check_body(body, params, mline) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->st->func_end() != 0) {
                self->sup->pop_scope();
                return -1;
            }
            self->sup->pop_scope();
            (void)mline;
            mnode = self->sup->new_node(N_METHOD);
            if (mnode < 0) return -1;
            self->arena->nodes[mnode].text = runtime::text::ct_intern(ret);
            if (!self->arena->nodes[mnode].text) return self->sup->fail("out of memory");
            self->arena->nodes[mnode].text2 = runtime::text::ct_intern(mname);
            if (!self->arena->nodes[mnode].text2) return self->sup->fail("out of memory");
            self->arena->nodes[mnode].a = params;
            self->arena->nodes[mnode].b = body;
            self->arena->nodes[mnode].num = ti;
            self->arena->nodes[mnode].aux = -1;
            self->arena->nodes[mnode].d = is_pub;
            /* P29-2: `c` marks a receiverless method; the emitter drops the
               `void *self` parameter and the `_self` local. */
            self->arena->nodes[mnode].c = is_static;
            if (tail < 0) self->arena->nodes[node].a = mnode;
            else self->arena->nodes[tail].next = mnode;
            tail = mnode;
        }
        self->ex->in_generic_tparam = 0;
        self->ex->in_generic_ntparam = 0;
        self->ex->in_generic_bound = "";
        if (self->sup->expect("}") != 0) return -1;
        /* L36-1 (S1b): a `drop` body may not `release()` the same `self` field
           twice. Walk the `drop` method's body and report the first duplicate. */
        if (strcmp(use, "Drop") == 0) {
            int mi;
            for (mi = self->arena->nodes[node].a; mi >= 0;
                 mi = self->arena->nodes[mi].next) {
                if (strcmp(self->arena->nodes[mi].text2, "drop") != 0) continue;
                if (self->drop_release_scan(self->arena->nodes[mi].b) != 0)
                    return -1;
                break;
            }
        }
        return node;
    }

    /* L36-1 (S1b): recursive walk of a `drop` body. Every `self->field.release()`
       (or `self.field.release()`) records the field name; a second call on the
       same field is an error. The released-field set is shared across the whole
       body via the output parameters so sibling statements see each other's
       releases. */
    int drop_release_walk(int n, char *seen, int *nseen)
    {
        int k;
        for (; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].a >= 0
                && self->drop_release_walk(self->arena->nodes[n].a, seen, nseen) != 0)
                return -1;
            if (self->arena->nodes[n].kind != N_MCALL) continue;
            if (strcmp(self->arena->nodes[n].text2, "release") != 0) continue;
            {
                int recv = self->arena->nodes[n].a;
                int rkind;
                const char *field;
                if (recv < 0) continue;
                rkind = self->arena->nodes[recv].kind;
                if (rkind != N_ARROW && rkind != N_MEMBER) continue;
                if (self->arena->nodes[recv].a < 0) continue;
                if (self->arena->nodes[self->arena->nodes[recv].a].kind != N_VAR)
                    continue;
                if (strcmp(self->arena->nodes[self->arena->nodes[recv].a].text2,
                           "self") != 0)
                    continue;
                field = self->arena->nodes[recv].text2;
                for (k = 0; k < *nseen; k++)
                    if (strcmp(seen + k * MAX_TEXT, field) == 0)
                        return tool::diag::ct_sem_error(
                            self->arena->nodes[n].line,
                            (int)self->arena->nodes[n].num,
                            tool::sh::ct_scratch_fmt(
                                "field '%s' is released more than once in drop()",
                                field),
                            self->mem->path);
                if (*nseen < 32) {
                    snprintf(seen + (*nseen) * MAX_TEXT, MAX_TEXT, "%s", field);
                    (*nseen)++;
                }
            }
        }
        return 0;
    }

    int drop_release_scan(int body)
    {
        char seen[32 * MAX_TEXT];
        int nseen = 0;
        return self->drop_release_walk(body, seen, &nseen);
    }

}

static struct Parser g_parse;

/* Storage for the tables whose element types belong to other units (see the
   comment on the fields): a generated header carries no `#include`, so the
   arrays stay here and `g_parse` points at them. `g_maps` is a heap block
   (SH-42): one `struct MapTable` carries 64 `MapBind` rows, so 64 of them inline
   put ~14 MB of zeroes into __DATA and shipped a 21 MB compiler. */
static struct MapTable  *g_maps;

/* Phase 21 S5: a block-bodied closure needs `parse_block`, which lives in the
   statement layer; the expression object cannot import that layer (the edge
   would close a cycle), so it calls back through this one hook. Phase 44 op 1
   reuses it to snapshot the failure cleanup of a postfix `?` node. */
static int parser_st_hook(int op, int arg)
{
    if (op == 1) return g_parse.st->try_attach(arg);
    /* LANG-29 S4 / B5: op 3 is the expression-form lookahead, op 2 the reader. */
    if (op == 2) return g_parse.st->parse_match_expr();
    if (op == 3) return g_parse.st->expr_match_ahead();
    return g_parse.st->parse_block();
}

/* The parser's shared primitives live in support.h.ct; the driver reaches all
   of them through these wrappers, so no trait name crosses the unit line. */
pub void ct_parse_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *build_mode, void *check_mode);
void ct_parse_bind(void *arena, void *lex, void *sym, void *ty, void *mem, void *build_mode, void *check_mode)
{
    g_parse.arena = (struct Arena *)arena;
    g_parse.lex = (struct Lexer *)lex;
    g_parse.sym = (struct Symbols *)sym;
    g_parse.mem = (struct Memory *)mem;
    g_parse.build_mode = (int *)build_mode;
    g_parse.check_mode = (int *)check_mode;
    g_parse.sup = parse_support_get();
    g_parse.sup->arena = (struct Arena *)arena;
    g_parse.sup->lex = (struct Lexer *)lex;
    g_parse.sup->sym = (struct Symbols *)sym;
    g_parse.sup->ty = (struct TypeCheck *)ty;
    g_parse.sup->mem = (struct Memory *)mem;
    /* S1a-0 C1: the call table grows on demand (`record_call` in Expr.h.ct
       reallocs through the slot bound below); MAX_CALLS is the starting
       capacity. The block is allocated here because `struct Call` belongs to
       the module layer. */
    g_parse.calls = (struct Call *)calloc(MAX_CALLS, sizeof(*g_parse.calls));
    if (!g_parse.calls) {
        fprintf(stderr, "ctc: out of memory\n");
        exit(1);
    }
    g_parse.callcap = MAX_CALLS;
    if (!g_maps) {
        g_maps = calloc(MAX_MAPS, sizeof(*g_maps));
        if (!g_maps) {
            fprintf(stderr, "ctc: out of memory\n");
            exit(1);
        }
        g_parse.mapcap = MAX_MAPS;
    }
    g_parse.maps = g_maps;
    g_parse.pend_fields = 0;
    g_parse.pendcap = 0;
    /* the `map` construct (mapbuild.h.ct) reads the same cursor, primitives and
       tables, and records into the map array this unit owns */
    ct_mapbuild_bind(lex, g_parse.sup, sym, &g_parse.maps, &g_parse.nmaps,
                     &g_parse.mapcap, &g_parse.unit_is_map);
    /* the expression chain: it reads the same cursor and primitives, and writes
       the call table and the current-function name this unit owns */
    g_parse.cur_func = "";
    g_parse.ns_decl = "";
    g_parse.cur_record = "";
    ct_expr_bind(arena, lex, sym, g_parse.sup, &g_parse.cur_func, &g_parse.calls, &g_parse.ncalls,
                 &g_parse.callcap, &g_parse.maps, &g_parse.nmaps);
    g_parse.ex = expr_get();
    /* the statement layer reads the same cursor and tables and writes nodes
       through the same primitives */
    ct_stmt_bind(arena, lex, sym, g_parse.mem, g_parse.sup, g_parse.ex);
    g_parse.st = stmt_get();
    g_parse.ex->st_hook = parser_st_hook;
    /* P-7.2: the expression / statement layers note a slice through
       `ParseSupport`, which is the one collaborator all three share. */
    g_parse.sup->slice_used = &g_parse.slice_used;
}

pub struct Parser *parse_get(void);
struct Parser *parse_get(void)
{
    return &g_parse;
}

pub int ct_parse_program(void);
int ct_parse_program(void)
{
    return g_parse.parse_program();
}

pub int ct_parse_skip_import(void);
int ct_parse_skip_import(void)
{
    return g_parse.skip_import();
}

pub int ct_parse_fail(const char *msg);
int ct_parse_fail(const char *msg)
{
    return g_parse.sup->fail(msg);
}

pub int ct_parse_fail_at(int line, const char *msg);
int ct_parse_fail_at(int line, const char *msg)
{
    return g_parse.sup->fail_at(line, msg);
}

pub int ct_parse_fail_driver(const char *msg);
int ct_parse_fail_driver(const char *msg)
{
    return g_parse.sup->fail_driver(msg);
}

pub int ct_parse_report(void);
int ct_parse_report(void)
{
    return g_parse.sup->report();
}

pub void ct_parse_set_json(int on, int to_stderr, int codes);
void ct_parse_set_json(int on, int to_stderr, int codes)
{
    g_parse.sup->diag_json = on;
    g_parse.sup->diag_json_stderr = to_stderr;
    g_parse.sup->diag_codes = codes;
}

pub void ct_parse_lex_next(void);
void ct_parse_lex_next(void)
{
    g_parse.sup->lex_next();
}

pub const char *ct_parse_last_error(void);
const char *ct_parse_last_error(void)
{
    return g_parse.sup->last_error();
}

pub void ct_parse_clear_error(void);
/* PH-66 R1: the call list lives in this unit; the module layer asks by index
   instead of touching `struct Call` (whose definition is not visible there). */
pub int ct_parse_io_call_count(void);
pub const char *ct_parse_io_call_name(int i);
pub int ct_parse_io_call_unit(int i);
pub int ct_parse_io_call_known(int i);
pub int ct_parse_io_call_line(int i);
void ct_parse_clear_error(void)
{
    g_parse.sup->errmsg = "";
    g_parse.sup->errfile[0] = 0;
    g_parse.sup->errline = 0;
    g_parse.sup->errcol = 0;
}

int ct_parse_io_call_count(void)
{
    return g_parse.ex->nio;
}

const char *ct_parse_io_call_name(int i)
{
    if (i < 0 || i >= g_parse.ex->nio) return "";
    return g_parse.ex->io_names[i];
}

int ct_parse_io_call_unit(int i)
{
    if (i < 0 || i >= g_parse.ex->nio) return -1;
    return g_parse.ex->io_owner[i];
}

int ct_parse_io_call_known(int i)
{
    if (i < 0 || i >= g_parse.ex->nio) return 0;
    return g_parse.ex->io_known[i];
}

int ct_parse_io_call_line(int i)
{
    if (i < 0 || i >= g_parse.ex->nio) return 0;
    return g_parse.ex->io_line[i];
}
