namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprTraitInst {
    int unused;
}

/* S1a-0 C2p-3: `<trait><a[, b]>` as one pool text, so a long trait name is
   not cut at the old 160-byte canon row. */
static const char *trait_inst_spell(const char *tname, int nargs, char **args)
{
    char *buf = 0;
    int cap = 0, i;
    const char *pooled;

    if (tool::sh::ct_text_init(&buf, &cap, 64) != 0) return (const char *)0;
    if (tool::sh::ct_text_cat(&buf, &cap, tname) != 0
        || tool::sh::ct_text_cat(&buf, &cap, "<") != 0) {
        tool::sh::ct_text_free(&buf, &cap);
        return (const char *)0;
    }
    for (i = 0; i < nargs; i++) {
        if (i > 0 && tool::sh::ct_text_cat(&buf, &cap, ",") != 0) break;
        if (tool::sh::ct_text_cat(&buf, &cap, args && args[i] ? args[i] : "") != 0)
            break;
    }
    if (i < nargs || tool::sh::ct_text_cat(&buf, &cap, ">") != 0) {
        tool::sh::ct_text_free(&buf, &cap);
        return (const char *)0;
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
}


impl ExprTraitInst for Expr {
    /* Phase 35 S3a: one trait instance in a type position. Source-canonical
       arguments identify the row; their C spellings substitute the method
       signatures. Symbolic arguments belong to the later generic-impl slice. */
    int parse_trait_inst_type(char *out, int cap)
    {
        const char *tname;
        char **carg = 0;
        char **ctype = 0;
        const char *canon;
        const char *abuf;
        const char *iface;
        size_t base_len;
        int ccap = 0, tccap = 0, gpi;
        int n, sti, ni, nargs;

        n = (int)strlen(out);
        {
            const char *tok = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                          self->lex->tokstr.len);
            if (!tok) return self->sup->fail("out of memory");
            tname = self->sym->resolve_type_text(tok);
        }
        if (!tname) return self->sup->fail("out of memory");
        sti = self->sym->find_trait(tname);
        if (sti < 0 || self->sym->traits[sti].ntparams == 0)
            return self->sup->fail("internal: generic trait row vanished");
        self->sup->lex_next();
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is("<")) {
            return self->sup->fail(runtime::text::ct_internf(
                     "generic trait '%s' needs type arguments in a type position", tname));
        }
        self->sup->lex_next();
        nargs = 0;
        for (;;) {
            carg = frontend::sym::ct_rows_reserve(carg, ccap, nargs + 1, &ccap);
            ctype = frontend::sym::ct_rows_reserve(ctype, tccap, nargs + 1, &tccap);
            if (!carg || ccap < nargs + 1 || !ctype || tccap < nargs + 1)
                return self->sup->fail("a generic trait has too many type arguments");
            self->inst_canon = "";
            self->type_depth++;
            if (self->type_depth > 4) {
                self->type_depth--;
                return self->sup->fail("generic type arguments nest deeper than 4");
            }
            if (self->parse_type_text(&abuf) != 0) {
                self->type_depth--;
                return -1;
            }
            self->type_depth--;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("[")) {
                int gl = self->lex->tokline;
                int gc = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("]"))
                    return tool::diag::ct_sem_error(gl, gc,
                        "a slice 'T[]' cannot be a generic type argument; it is a non-owning view",
                        self->sup->mem->path);
                return self->sup->fail("expected '>' after the type arguments");
            }
            if (!abuf[0] || strcmp(abuf, "void") == 0 || strchr(abuf, '[')
                || strchr(abuf, '(') || strchr(abuf, ')')
                || strncmp(abuf, "const ", 6) == 0
                || strncmp(abuf, "volatile ", 9) == 0) {
                return self->sup->fail(runtime::text::ct_internf(
                         "type argument '%s' cannot instantiate a generic trait", abuf));
            }
            for (gpi = 0; gpi < self->in_generic_ntparam; gpi++) {
                const char *sym;
                if (!self->in_generic_tparam[gpi]) continue;
                sym = frontend::sym::ct_generic_subst_text(abuf,
                                                           self->in_generic_tparam[gpi], "");
                if (!sym) return self->sup->fail("out of memory");
                if (strcmp(sym, abuf) != 0)
                    return self->sup->fail("symbolic trait type arguments are not supported yet");
            }
            if (frontend::sym::ct_row_set(ctype, nargs, abuf) != 0)
                return self->sup->fail("out of memory");
            if (self->inst_canon && self->inst_canon[0]) {
                /* Keep `Vec<int>` rather than its C tag; a pointer suffix still
                   belongs to the argument's canonical spelling. */
                const char *tailt = "";
                base_len = strlen(self->last_bare_tag ? self->last_bare_tag : "");
                if (base_len > 0 && strncmp(abuf, self->last_bare_tag, base_len) == 0) {
                    tailt = frontend::sym::ct_type_canon_text(abuf + base_len);
                    if (!tailt) return self->sup->fail("out of memory");
                }
                {
                    const char *ct = runtime::text::ct_internf("%s%s",
                                        self->inst_canon, tailt);
                    if (!ct) return self->sup->fail("out of memory");
                    if (frontend::sym::ct_row_set(carg, nargs, ct) != 0)
                        return self->sup->fail("out of memory");
                }
            } else {
                const char *cn = frontend::sym::ct_type_canon_text(abuf);
                if (!cn) return self->sup->fail("out of memory");
                if (frontend::sym::ct_row_set(carg, nargs, cn) != 0)
                    return self->sup->fail("out of memory");
            }
            nargs++;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(">>")) {
            self->lex->tokstr.ptr = self->lex->src + self->lex->tokstart + 1;
            self->lex->tokstr.len = 1;
            self->lex->pos = self->lex->pos - 1;
            self->lex->tokstart = self->lex->tokstart + 1;
        }
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is(">"))
            return self->sup->fail("expected '>' after the type arguments");
        self->sup->lex_next();
        ni = self->sym->trait_inst(tname, nargs, carg, ctype, self->cur_unit);
        if (ni < 0) return self->sup->fail(self->sym->last_error());
        canon = trait_inst_spell(tname, nargs, carg);
        if (!canon) return self->sup->fail("out of memory");
        iface = runtime::text::ct_internf("%s_iface", self->sym->traits[ni].name);
        if (!iface) return self->sup->fail("out of memory");
        self->inst_canon = canon;
        self->last_bare_tag = runtime::text::ct_internf("struct %s", iface);
        if (!self->last_bare_tag) return self->sup->fail("out of memory");
        self->saw_trait = 1;
        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
        if (self->type_append(out, cap, &n, iface) != 0) return -1;
        return 0;
    }
}
