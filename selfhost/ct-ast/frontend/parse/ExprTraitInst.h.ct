import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::arena::Arena::NodeKind as NodeKind;
import runtime::arena::Arena::Node as Node;
import tool::diag::Diag;
import frontend::parse::ExprTypeText;
import frontend::parse::ExprPure;
import frontend::parse::ExprCore;
import frontend::parse::ExprAdtCtor;
import frontend::parse::ExprNewObject;
import frontend::parse::ExprSubscript;
import frontend::parse::ExprOptional;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 8192
#define MAX_CALLS_MAX 65536
#define MAX_FUNCS 512
#define MAX_FUNCS_MAX 65536
#define MAX_ARG_POS 32
#define MAX_ARG_POS_MAX 65536
#define MAX_GENERIC_INSTS 64
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
#define N_MATSEQ 73
#define N_NEWOBJ 77
#define N_INTO 63
#define N_INTO_SELF 64
#define N_TRY 71
#define N_ADTCTOR 81
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_OPT 72
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprTraitInst {
    int unused;
}


impl ExprTraitInst for Expr {
    /* Phase 35 S3a: one trait instance in a type position. Source-canonical
       arguments identify the row; their C spellings substitute the method
       signatures. Symbolic arguments belong to the later generic-impl slice. */
    int parse_trait_inst_type(char *out, int cap)
    {
        char tname[MAX_TEXT];
        char **carg = 0;
        char **ctype = 0;
        char canon[MAX_TEXT];
        char abuf[MAX_TEXT];
        char tail[MAX_TEXT];
        char symbolic[MAX_TEXT];
        char iface[MAX_TEXT];
        char msg[MAX_TEXT * 2];
        size_t base_len;
        int ccap = 0, tccap = 0, gpi;
        int n, sti, ni, nargs;

        n = (int)strlen(out);
        if (self->sup->resolve_type(self->lex->tok_cstr(), tname, sizeof tname) != 0) return -1;
        sti = self->sym->find_trait(tname);
        if (sti < 0 || self->sym->traits[sti].ntparams == 0)
            return self->sup->fail("internal: generic trait row vanished");
        self->sup->lex_next();
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is("<")) {
            snprintf(msg, sizeof msg,
                     "generic trait '%s' needs type arguments in a type position", tname);
            return self->sup->fail(msg);
        }
        self->sup->lex_next();
        nargs = 0;
        for (;;) {
            carg = frontend::sym::ct_rows_reserve(carg, ccap, nargs + 1, &ccap);
            ctype = frontend::sym::ct_rows_reserve(ctype, tccap, nargs + 1, &tccap);
            if (!carg || ccap < nargs + 1 || !ctype || tccap < nargs + 1)
                return self->sup->fail("a generic trait has too many type arguments");
            self->inst_canon[0] = 0;
            self->type_depth++;
            if (self->type_depth > 4) {
                self->type_depth--;
                return self->sup->fail("generic type arguments nest deeper than 4");
            }
            if (self->parse_type(abuf, sizeof abuf) != 0) {
                self->type_depth--;
                return -1;
            }
            self->type_depth--;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("[")) {
                int gl = self->lex->tokline;
                int gc = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("]"))
                    return tool::diag::ct_sem_error(gl, gc,
                        "a slice 'T[]' cannot be a generic type argument; it is a non-owning view",
                        self->sup->mem->path);
                return self->sup->fail("expected '>' after the type arguments");
            }
            if (!abuf[0] || strcmp(abuf, "void") == 0 || strchr(abuf, '[')
                || strchr(abuf, '(') || strchr(abuf, ')')
                || strncmp(abuf, "const ", 6) == 0
                || strncmp(abuf, "volatile ", 9) == 0) {
                snprintf(msg, sizeof msg,
                         "type argument '%s' cannot instantiate a generic trait", abuf);
                return self->sup->fail(msg);
            }
            for (gpi = 0; gpi < self->in_generic_ntparam; gpi++) {
                if (!self->in_generic_tparam[gpi]) continue;
                if (frontend::sym::ct_generic_subst(abuf, self->in_generic_tparam[gpi], "",
                                                    symbolic, sizeof symbolic) != 0)
                    return self->sup->fail("type is too long");
                if (strcmp(symbolic, abuf) != 0)
                    return self->sup->fail("symbolic trait type arguments are not supported yet");
            }
            snprintf(ctype[nargs], MAX_TEXT, "%s", abuf);
            tail[0] = 0;
            if (self->inst_canon[0]) {
                /* Keep `Vec<int>` rather than its C tag; a pointer suffix still
                   belongs to the argument's canonical spelling. */
                base_len = strlen(self->last_bare_tag);
                if (base_len > 0 && strncmp(abuf, self->last_bare_tag, base_len) == 0
                    && frontend::sym::ct_type_canon(abuf + base_len, tail, sizeof tail) != 0)
                    return self->sup->fail("type is too long");
                if (snprintf(carg[nargs], MAX_TEXT, "%s%s", self->inst_canon, tail) >= MAX_TEXT)
                    return self->sup->fail("type is too long");
            } else if (frontend::sym::ct_type_canon(abuf, carg[nargs], MAX_TEXT) != 0) {
                return self->sup->fail("type is too long");
            }
            nargs++;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(">>")) {
            self->lex->tokstr.ptr = self->lex->src + self->lex->tokstart + 1;
            self->lex->tokstr.len = 1;
            self->lex->pos = self->lex->pos - 1;
            self->lex->tokstart = self->lex->tokstart + 1;
        }
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is(">"))
            return self->sup->fail("expected '>' after the type arguments");
        self->sup->lex_next();
        ni = self->sym->trait_inst(tname, nargs, carg, ctype, self->cur_unit);
        if (ni < 0) return self->sup->fail(self->sym->last_error());
        {
            int cl = snprintf(canon, sizeof canon, "%s<", tname);
            for (gpi = 0; gpi < nargs; gpi++) {
                int wr = snprintf(canon + cl, sizeof canon - (size_t)cl,
                                  "%s%s", gpi == 0 ? "" : ",", carg[gpi]);
                if (cl < 0 || wr < 0 || cl + wr >= (int)sizeof canon)
                    return self->sup->fail("type is too long");
                cl += wr;
            }
            if (cl + 2 > (int)sizeof canon)
                return self->sup->fail("type is too long");
            canon[cl] = '>';
            canon[cl + 1] = 0;
        }
        if (snprintf(iface, sizeof iface, "%s_iface", self->sym->traits[ni].name)
            >= (int)sizeof iface)
            return self->sup->fail("type name is too long");
        snprintf(self->inst_canon, sizeof self->inst_canon, "%s", canon);
        snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "struct %s", iface);
        self->saw_trait = 1;
        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
        if (self->type_append(out, cap, &n, iface) != 0) return -1;
        return 0;
    }
}
