namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprSubscript {
    int unused;
}


impl ExprSubscript for Expr {
    /* PH-52 D52-2: the diagnostics name the user's spelling, not the encoded
       instance tag. `Box<int>` comes from the instance row; a plain struct
       keeps its declared name. */
    int custom_index_label(const char *bty, char *out, int cap)
    {
        const char *base;
        int inst, n;
        struct StructInst *ins;

        (void)self;
        base = (strncmp(bty, "struct ", 7) == 0) ? bty + 7 : bty;
        inst = frontend::sym::ct_inst_find(base);
        if (inst >= 0) {
            ins = frontend::sym::ct_insts(&n);
            if (ins && inst < n && ins[inst].nargs > 0) {
                if (ins[inst].nargs > 1)
                    snprintf(out, (size_t)cap, "%s<%s, %s>", ins[inst].tmpl,
                             ins[inst].carg[0], ins[inst].carg[1]);
                else
                    snprintf(out, (size_t)cap, "%s<%s>", ins[inst].tmpl,
                             ins[inst].carg[0]);
                return 0;
            }
        }
        snprintf(out, (size_t)cap, "%s", base);
        return 0;
    }

    /* PH-52 D52-2 / D52-5: protocol matching is name + arity + instance
       (never the parameter type); a miss is a hard error, never a C subscript
       fallback. `writable` selects the set-side wording. Returns the method
       node on success; a diagnostic has already been emitted on failure. */
    int custom_index_method(const char *bty, const char *name, int want,
                            int line, int col, int writable, int idx_node)
    {
        int m, p, got = 0;
        char label[MAX_TEXT];
        char msg[MAX_TEXT];

        self->custom_index_label(bty, label, sizeof label);
        m = self->inst_inherent_method(bty, name);
        if (m == -2) {
            if (writable)
                snprintf(msg, sizeof msg,
                    "type '%s' has no writable subscript: '%s' is private to its unit",
                    label, name);
            else
                snprintf(msg, sizeof msg,
                    "type '%s' has no subscript: '%s' is private to its unit",
                    label, name);
            return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        }
        if (m < 0) {
            if (writable)
                snprintf(msg, sizeof msg,
                    "type '%s' has a read-only subscript: declare 'void set(K, V)' in impl %s",
                    label, label);
            else
                snprintf(msg, sizeof msg,
                    "type '%s' has no subscript: declare 'V get(K)' in impl %s",
                    label, label);
            return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        }
        if (self->arena->nodes[m].c) {
            snprintf(msg, sizeof msg,
                "type '%s' has no subscript: '%s' must be an instance method",
                label, name);
            return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        }
        for (p = self->arena->nodes[m].a; p > 0; p = self->arena->nodes[p].next)
            got++;
        if (got != want) {
            if (writable)
                snprintf(msg, sizeof msg,
                    "type '%s' has no writable subscript: 'set' must take 2 parameters",
                    label);
            else
                snprintf(msg, sizeof msg,
                    "type '%s' has no subscript: 'get' must take 1 parameter",
                    label);
            return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        }
        /* LANG-4: the index must also fit the declared key type. Matching only
           name+arity let `char *get(char *)` receive an int silently. */
        if (idx_node >= 0) {
            char kty[MAX_TEXT];
            int kz = 0;
            const char *pt = self->arena->nodes[self->arena->nodes[m].a].text;
            if (self->chk_type(idx_node, kty, sizeof kty, &kz) == 0
                && kty[0] && pt[0]) {
                self->chk_line = line;
                self->chk_col = col;
                self->chk_arg = 1;
                if (self->chk_assignable(pt, kty, 0, 6) != 0) return -1;
            }
        }
        return m;
    }

}
