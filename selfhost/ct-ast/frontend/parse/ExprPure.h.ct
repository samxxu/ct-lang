/*
 * ExprPure.h.ct - host-free helpers moved out of Expr.h.ct (SH-94 S1, pure move).
 *
 * These functions never take the `Expr` object: they read an arena, a lexer,
 * a closure or the symbol tables and answer a value (or write a text buffer).
 * Moving them out keeps the parser's giant unit to the methods that actually
 * hold `self`; the bodies below are byte-identical to the ones Expr.h.ct used
 * to hold and the call sites are unchanged.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import frontend::lex::Lexer;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import runtime::arena::Arena::Node as Node;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
#define N_VAR 10

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprPure {
    int unused;
}

pub int arg_count(struct Arena *a, int first);
pub int slice_range_ahead(struct Lexer *lex);
pub int is_range_index(struct Arena *a, int n);
pub int closure_capture_index(struct Closure *c, const char *name);
pub void bind_conv_key(const char *in, char *out, int cap);
/* S1a-0 C2p-5: the full-length conversion key as a pool text. Comparing the
   `char[160]` rows cut two spellings that agree for 159 bytes into one
   conversion; the pool form compares the whole type. */
pub const char *bind_conv_key_text(const char *in);
pub int bind_conv_on(void);
pub int expr_is_builtin_Box_type(const char *type);
pub int bplus_space(int c);
pub int bplus_id(int c);
pub const char *bplus_lit_type_text(const char *s, int n, int *is_zero);

pub int arg_count(struct Arena *a, int first)
{
    int c = 0;
    while (first > 0) {
        c++;
        first = a->nodes[first].next;
    }
    return c;
}

pub int slice_range_ahead(struct Lexer *lex)
{
    int p = lex->tokstart + 1;
    int depth = 0;
    while (lex->src[p]) {
        char c = lex->src[p];
        if (c == '"' || c == '\'') {
            char q = c;
            p++;
            while (lex->src[p] && lex->src[p] != q) {
                if (lex->src[p] == '\\' && lex->src[p + 1]) p++;
                p++;
            }
            if (lex->src[p]) p++;
        } else if (c == '/' && lex->src[p + 1] == '*') {
            p += 2;
            while (lex->src[p] && !(lex->src[p] == '*' && lex->src[p + 1] == '/')) p++;
            if (lex->src[p]) p += 2;
        } else if (c == '/' && lex->src[p + 1] == '/') {
            while (lex->src[p] && lex->src[p] != '\n') p++;
        } else if (c == '(' || c == '[' || c == '{') {
            depth++;
            p++;
        } else if (c == ')' || c == '}') {
            if (depth > 0) depth--;
            p++;
        } else if (c == ']') {
            if (depth == 0) return 0;
            depth--;
            p++;
        } else if (c == '.' && lex->src[p + 1] == '.' && depth == 0) {
            return 1;
        } else {
            p++;
        }
    }
    return 0;
}

pub int is_range_index(struct Arena *a, int n)
{
    return n >= 0 && a->nodes[n].kind == N_VAR && strcmp(a->nodes[n].text2, "$") == 0;
}

pub int closure_capture_index(struct Closure *c, const char *name)
{
    int i;

    for (i = 0; i < c->ncap; i++)
        if (strcmp(c->cap_name[i], name) == 0) return i;
    return -1;
}

pub void bind_conv_key(const char *in, char *out, int cap)
{
    const char *k = bind_conv_key_text(in);

    if (!k) {
        if (cap > 0) out[0] = 0;
        return;
    }
    snprintf(out, (size_t)cap, "%s", k);
}

const char *bind_conv_key_text(const char *in)
{
    const char *k = frontend::type::type_key_text(in);

    if (!k) return (const char *)0;
    if (strncmp(k, "struct", 6) == 0) return runtime::text::ct_intern(k + 6);
    if (strncmp(k, "union", 5) == 0) return runtime::text::ct_intern(k + 5);
    if (strncmp(k, "enum", 4) == 0) return runtime::text::ct_intern(k + 4);
    return k;
}

pub int bind_conv_on(void)
{
    const char *v = getenv("CT_BINDING_CONVERSION");
    return !(v && strcmp(v, "0") == 0);
}

pub int expr_is_builtin_Box_type(const char *type)
{
    const char *base;
    int inst, ti, tn;
    struct StructInst *ins;
    struct StructTmpl *tps;

    if (!type || !type[0]) return 0;
    base = type;
    if (strncmp(base, "struct ", 7) == 0) base += 7;
    inst = frontend::sym::ct_inst_find(base);
    if (inst < 0) return 0;
    ins = frontend::sym::ct_insts(&tn);
    if (!ins) return 0;
    ti = ins[inst].tmpl_row;
    tps = frontend::sym::ct_tmpls(&tn);
    if (ti < 0 || !tps) return 0;
    return strstr(tps[ti].path, "lib/core/Box.h.ct") != 0
        || strstr(tps[ti].path, "lib/std/Box.h.ct") != 0;
}

pub int bplus_space(int c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

pub int bplus_id(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

pub const char *bplus_lit_type_text(const char *s, int n, int *is_zero)
{
    int i, j, digits, dots, exps, suf_at, sn, all_zero, k, ucount, lcount;
    char suf[8];

    *is_zero = 0;
    if (n <= 0) return (const char *)0;
    if (s[0] == '"' && n >= 2 && s[n - 1] == '"') return "char *";
    if (s[0] == '\'' && n >= 2 && s[n - 1] == '\'') return "int";
    i = 0;
    if (i < n && (s[i] == '-' || s[i] == '+')) i++;
    j = i;
    digits = 0;
    dots = 0;
    exps = 0;
    while (i < n && s[i] >= '0' && s[i] <= '9') { i++; digits++; }
    if (i < n && s[i] == '.') {
        dots = 1;
        i++;
        while (i < n && s[i] >= '0' && s[i] <= '9') { i++; digits++; }
    }
    if (digits == 0) return (const char *)0;
    if (i < n && (s[i] == 'e' || s[i] == 'E')) {
        int ed = 0;
        exps = 1;
        i++;
        if (i < n && (s[i] == '+' || s[i] == '-')) i++;
        while (i < n && s[i] >= '0' && s[i] <= '9') { i++; ed++; }
        if (ed == 0) return (const char *)0;
    }
    suf_at = i;
    sn = 0;
    while (i < n && (s[i] == 'u' || s[i] == 'U' || s[i] == 'l' || s[i] == 'L'
                     || s[i] == 'f' || s[i] == 'F')) {
        if (sn + 1 >= (int)sizeof suf) return (const char *)0;
        suf[sn] = s[i];
        sn++;
        i++;
    }
    suf[sn] = 0;
    if (i != n) return (const char *)0;    /* not a single literal */
    if (dots || exps || strchr(suf, 'f') != 0 || strchr(suf, 'F') != 0) {
        if (strchr(suf, 'u') != 0 || strchr(suf, 'U') != 0) return (const char *)0;
        if (sn == 0) return "double";
        if (sn == 1 && (suf[0] == 'f' || suf[0] == 'F')) return "float";
        for (k = 0; k < sn; k++)
            if (suf[k] != 'l' && suf[k] != 'L') return (const char *)0;
        return "long double";
    }
    /* an integer suffix: the only spellings that name a C numeric type */
    ucount = 0;
    lcount = 0;
    for (k = 0; k < sn; k++) {
        if (suf[k] == 'u' || suf[k] == 'U') ucount++;
        else if (suf[k] == 'l' || suf[k] == 'L') lcount++;
        else return (const char *)0;
    }
    all_zero = 1;
    for (k = j; k < suf_at; k++)
        if (s[k] != '.' && s[k] != '0') { all_zero = 0; break; }
    if (all_zero && digits > 0) *is_zero = 1;
    if (sn == 0) return "int";
    if (ucount && !lcount) return "unsigned";
    if (!ucount && lcount == 1) return "long";
    if (!ucount && lcount >= 2) return "long long";
    if (ucount == 1 && lcount == 1) return "unsigned long";
    if (ucount == 1 && lcount >= 2) return "unsigned long long";
    return (const char *)0;
}
