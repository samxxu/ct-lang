/*
 * StmtSwitch.h.ct - the switch / label / goto grammar (SH-94 S1a-1, pure move out of Stmt.h.ct).
 *
 * The method bodies are byte-identical to the ones Stmt.h.ct held; the
 * `Stmt` type and every trait declaration live in StmtCore.h.ct, so this unit
 * imports Core instead of the host and the import graph stays acyclic.
 * Stmt.h.ct imports this unit for the vtable.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>


import frontend::sym::SymbolsTypeText;
import runtime::arena::Arena;
import runtime::text::Intern;
import runtime::arena::Arena::Node as Node;
import frontend::lex::Lexer;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::StructInst as StructInst;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::parse::Expr;
import tool::diag::Diag;
import frontend::parse::StmtRangeText;
import frontend::parse::StmtRangeScan;
import frontend::parse::StmtScope;
import frontend::parse::StmtCore;
import frontend::parse::StmtDefer;
import frontend::type::TypeCheck;
import frontend::parse::StmtMatch;
import frontend::parse::StmtLoop;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
#define CAP_LIMIT 65536
#define MAX_LABELS 64
#define B_COMMA 19
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_MOD 11
#define B_SHL 17
#define B_SHR 18
#define B_BAND 15
#define B_BOR 16
#define B_XOR 14
#define N_INDEX 26
#define N_CALL 7
#define N_MCALL 30
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BLOCK 4
#define N_CLOSURE 59
#define N_BREAK 38
#define N_CASE 43
#define N_CONT 39
#define N_DECL 12
#define N_DECLS 40
#define N_DELETE 41
#define N_DEREF 28
#define N_DOWHILE 44
#define N_EMPTY 52
#define N_SASSERT 55
#define N_EXPR 6
#define N_FOR 16
#define N_GOTO 50
#define N_IF 14
#define N_INIT_RANGE 61
#define N_MATSEQ 73
#define N_INIT_BRACE 65
#define N_INIT_ITEM 66
#define N_DEFER 69
#define N_DEFER_RUN 70
#define N_INIT_MBRACE 67
#define N_LABEL 49
#define N_LOOP 60
#define N_FOREACH 62
#define N_MEMBER 24
#define N_NUM 8
#define N_STR 9
#define N_UNARY 17
#define N_POST 18
#define N_PRE 57
#define N_ADDR 27
#define N_RAW 31
#define N_RET 5
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_SWITCH 42
#define N_MATCH 78
#define N_ARM 79
#define N_BIND 80
#define N_VAR 10
#define N_WHILE 15
#define N_INTO 63
#define N_INTO_SELF 64
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define CT_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct StmtSwitch {
    int unused;
}

pub int map_fold_num(struct Stmt *self, int n, long *out);

pub int map_fold_num(struct Stmt *self, int n, long *out)
{
    struct Node *nd;
    long a, b;

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    if (nd->kind == N_NUM) {
        *out = nd->num;
        return 1;
    }
    if (nd->kind == N_UNARY) {
        if (!map_fold_num(self, nd->a, &a)) return 0;
        if (nd->aux == 1) { *out = -a; return 1; }
        if (nd->aux == 2) { *out = !a; return 1; }
        if (nd->aux == 3) { *out = ~a; return 1; }
        return 0;
    }
    if (nd->kind != N_BIN) return 0;
    if (!map_fold_num(self, nd->a, &a) || !map_fold_num(self, nd->b, &b)) return 0;
    if (a < -1099511627776L || a > 1099511627776L) return 0;   /* 2^40 */
    if (b < -1099511627776L || b > 1099511627776L) return 0;
    switch (nd->aux) {
    case B_ADD: *out = a + b; break;
    case B_SUB: *out = a - b; break;
    case B_MUL:
        if (a < -2147483647L || a > 2147483647L) return 0;
        if (b < -2147483647L || b > 2147483647L) return 0;
        *out = a * b;
        break;
    case B_DIV: if (b == 0) return 0; *out = a / b; break;
    case B_MOD: if (b == 0) return 0; *out = a % b; break;
    case B_SHL:
        if (b < 0 || b > 20) return 0;
        if (a < -524288L || a > 524288L) return 0;
        *out = a << b;
        break;
    case B_SHR:
        if (b < 0 || b > 40) return 0;
        *out = a >> b;
        break;
    case B_BAND: *out = a & b; break;
    case B_BOR: *out = a | b; break;
    case B_XOR: *out = a ^ b; break;
    default: return 0;
    }
    return 1;
}

pub int ensure_label_capacity(struct Stmt *self, int need)
{
    int cap;
    struct LabelRow *grown;

    if (need <= self->labelcap) return 0;
    cap = self->labelcap > 0 ? self->labelcap : MAX_LABELS;
    while (cap < need && cap < CAP_LIMIT) cap *= 2;
    if (cap > CAP_LIMIT) cap = CAP_LIMIT;
    if (need > cap) return self->sup->fail("out of memory");
    grown = (struct LabelRow *)realloc(self->labels, (size_t)cap * sizeof(*grown));
    if (!grown) return self->sup->fail("out of memory");
    memset(grown + self->labelcap, 0, (size_t)(cap - self->labelcap) * sizeof(*grown));
    self->labels = grown;
    self->labelcap = cap;
    return 0;
}

pub int ensure_goto_capacity(struct Stmt *self, int need)
{
    int cap;
    struct LabelRow *grown;

    if (need <= self->gotocap) return 0;
    cap = self->gotocap > 0 ? self->gotocap : MAX_LABELS;
    while (cap < need && cap < CAP_LIMIT) cap *= 2;
    if (cap > CAP_LIMIT) cap = CAP_LIMIT;
    if (need > cap) return self->sup->fail("out of memory");
    grown = (struct LabelRow *)realloc(self->gotos, (size_t)cap * sizeof(*grown));
    if (!grown) return self->sup->fail("out of memory");
    memset(grown + self->gotocap, 0, (size_t)(cap - self->gotocap) * sizeof(*grown));
    self->gotos = grown;
    self->gotocap = cap;
    return 0;
}

impl StmtSwitch for Stmt {
    int parse_switch_body(void)
    {
        int blk, s, tail;
        (void)self;

        if (self->sup->expect("{") != 0) return -1;
        if (self->sup->push_scope() != 0) return -1;
        blk = self->sup->new_node(N_BLOCK);
        if (blk < 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* `own` is refused inside a switch, so the only `own` a `break` can meet
           are none: the baseline is the body's own scope, and this entry is what
           stops a `case … break` from releasing an enclosing loop's object. */
        if (jump_push(self, self->mem->own_base[self->sym->nscope - 1], -1) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* Push the switch body's defer entry *after* the jump baseline: a
           `break` must run this body's defers, just like a loop body's. */
        if (self->ndefer_blocks >= 256) {
            self->sup->pop_scope();
            return self->sup->fail("blocks are nested too deeply");
        }
        self->defer_head[self->ndefer_blocks] = -1;
        self->defer_tail[self->ndefer_blocks] = -1;
        self->defer_block_err[self->ndefer_blocks] = 0;
        self->ndefer_next_id = self->ndefer_next_id + 1;
        self->defer_ids[self->ndefer_blocks] = self->ndefer_next_id;
        self->ndefer_blocks = self->ndefer_blocks + 1;
        self->switch_depth = self->switch_depth + 1;
        tail = -1;
        {
        long case_lo[64];
        long case_hi[64];
        int ncase = 0;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            if (self->lex->tok == T_ID
                && (self->lex->tok_is("case") || self->lex->tok_is("default"))) {
                {
                int lab_line = self->lex->tokline;
                int lab_col = self->lex->tokstart - self->lex->lstart + 1;
                s = self->parse_label();
                /* PH-70-R3: duplicate `case` values/overlapping ranges are an
                   error under `ct check` (only foldable constants are judged). */
                if (s >= 0 && self->ex->check_mode && *self->ex->check_mode == 2
                    && self->arena->nodes[s].aux == 0) {
                    long lo = 0;
                    long hi = 0;
                    if (map_fold_num(self, self->arena->nodes[s].b, &lo)) {
                        hi = lo;
                        if (self->arena->nodes[s].c >= 0
                            && !map_fold_num(self, self->arena->nodes[s].c, &hi))
                            lo = hi + 1;
                        if (lo <= hi) {
                            int ci;
                            for (ci = 0; ci < ncase; ci++)
                                if (lo <= case_hi[ci] && hi >= case_lo[ci])
                                    return tool::diag::ct_sem_error(
                                        lab_line, lab_col,
                                        "duplicate case value", self->mem->path);
                            if (ncase < 64) {
                                case_lo[ncase] = lo;
                                case_hi[ncase] = hi;
                                ncase++;
                            }
                        }
                    }
                }
                }
            }
            else
                s = self->parse_stmt();
            if (s < 0) {
                self->switch_depth = self->switch_depth - 1;
                jump_pop(self, 0);
                self->sup->pop_scope();
                return -1;
            }
            if (tail < 0) self->arena->nodes[blk].a = s;
            else self->arena->nodes[tail].next = s;
            tail = s;
        }
        }
        if (self->defer_flush_block(blk, &tail) != 0) {
            self->switch_depth = self->switch_depth - 1;
            jump_pop(self, 0);
            self->sup->pop_scope();
            return -1;
        }
        self->switch_depth = self->switch_depth - 1;
        jump_pop(self, 0);
        if (self->sup->expect("}") != 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sup->pop_scope();
        (void)self->defer_mark_block();
        self->ndefer_blocks = self->ndefer_blocks - 1;
        return blk;
    }

    int parse_label(void)
    {
        int s, c, head, tail, is_def, val;
        (void)self;

        if (self->in_defer)
            return self->sup->fail("a defer block cannot declare a label");
        s = self->sup->new_node(N_CASE);
        if (s < 0) return -1;
        is_def = self->lex->tok_is("default");
        self->arena->nodes[s].aux = is_def;
        self->sup->lex_next();
        if (!is_def) {
            val = self->parse_case_value();
            if (val < 0) return -1;
            self->arena->nodes[s].b = val;
            self->arena->nodes[s].c = self->case_hi;
        }
        if (self->sup->expect(":") != 0) return -1;
        head = -1;
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))
               && !(self->lex->tok == T_ID
                    && (self->lex->tok_is("case")
                        || self->lex->tok_is("default")))
               && !self->label_ahead()) {
            if (self->is_decl_start()
                || (self->lex->tok == T_ID && self->lex->tok_is("static")))
                return self->sup->fail("a declaration cannot follow a case label; wrap it in a block");
            c = self->parse_stmt();
            if (c < 0) return -1;
            if (tail < 0) head = c;
            else self->arena->nodes[tail].next = c;
            tail = c;
        }
        if (head < 0
            && (self->lex->tok == T_EOF
                || (self->lex->tok == T_PUNCT && self->lex->tok_is("}"))))
            return self->sup->fail("a case label needs a statement");
        self->arena->nodes[s].a = head;
        return s;
    }

    int parse_case_value(void)
    {
        int e, hi;
        (void)self;

        self->case_hi = -1;
        e = self->ex->parse_expr();
        if (e < 0) return -1;
        if (!self->ex->const_ok(e) && self->arena->nodes[e].kind != N_VAR
            && self->arena->nodes[e].kind != N_RAW)
            return self->sup->fail("a case label must be an integer constant");
        /* `case <low> ... <high>:` -- a GNU / C23 range. Both ends follow the
           same constant rule, and the high end waits in `case_hi`. */
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("..."))) return e;
        self->sup->lex_next();
        hi = self->ex->parse_expr();
        if (hi < 0) return -1;
        if (!self->ex->const_ok(hi) && self->arena->nodes[hi].kind != N_VAR
            && self->arena->nodes[hi].kind != N_RAW)
            return self->sup->fail("a case label must be an integer constant");
        self->case_hi = hi;
        return e;
    }

    int label_ahead(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, r;
        long snum;
        const char *stext_ptr; int stext_len;
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        stext_ptr = self->lex->tokstr.ptr; stext_len = self->lex->tokstr.len;
        self->sup->lex_next();
        r = 0;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) r = 1;
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokstr.ptr = stext_ptr; self->lex->tokstr.len = stext_len;
        return r;
    }

    int label_find(const char *name)
    {
        int i;
        (void)self;

        for (i = 0; i < self->nlabels; i++)
            if (strcmp(self->labels[i].name, name) == 0) return i;
        return -1;
    }

    int parse_named_label(void)
    {
        int s, c, head, tail, line, i;
        const char *name;
        (void)self;

        if (self->in_defer)
            return self->sup->fail("a defer block cannot declare a label");
        line = self->lex->tokline;
        /* S1a-0 C2p-7: the label name is a pool text, so a 2000-byte `goto`
           target and its definition are spelled whole (the old 160-byte row
           cut both consistently, which compiled but named another label). */
        name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                            self->lex->tokstr.len);
        if (!name) return self->sup->fail("out of memory");
        if (ensure_label_capacity(self, self->nlabels + 1) != 0) return -1;
        if (self->label_find(name) >= 0) {
            return self->sup->fail(tool::sh::ct_scratch_fmt(
                "duplicate label '%s'", name));
        }
        s = self->sup->new_node(N_LABEL);
        if (s < 0) return -1;
        self->labels[self->nlabels].name = name;
        self->labels[self->nlabels].line = line;
        self->labels[self->nlabels].depth = self->ndefer_blocks;
        for (i = 0; i < self->ndefer_blocks; i++) {
            self->labels[self->nlabels].path[i] = self->defer_ids[i];
            self->labels[self->nlabels].has[i] = 0;
        }
        self->nlabels = self->nlabels + 1;
        self->arena->nodes[s].text2 = runtime::text::ct_intern(name);
        if (!self->arena->nodes[s].text2) return self->sup->fail("out of memory");
        self->sup->lex_next();
        if (self->sup->expect(":") != 0) return -1;
        head = -1;
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))
               && !(self->lex->tok == T_ID
                    && (self->lex->tok_is("case")
                        || self->lex->tok_is("default")))
               && !(head >= 0 && self->label_ahead())) {
            if (self->is_decl_start()
                || (self->lex->tok == T_ID && self->lex->tok_is("static")))
                return self->sup->fail("a declaration cannot follow a label; wrap it in a block");
            c = self->parse_stmt();
            if (c < 0) return -1;
            if (tail < 0) head = c;
            else self->arena->nodes[tail].next = c;
            tail = c;
        }
        if (head < 0) return self->sup->fail("a label needs a statement");
        self->arena->nodes[s].a = head;
        return s;
    }

    int parse_goto(void)
    {
        int s, i;
        const char *name;
        (void)self;

        if (self->in_errdefer)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "an errdefer block cannot transfer control", self->mem->path);
        if (self->in_defer)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a defer block cannot transfer control", self->mem->path);
        s = self->sup->new_node(N_GOTO);
        if (s < 0) return -1;
        self->sup->lex_next();
        if (self->lex->tok != T_ID) return self->sup->fail("expected a label name");
        if (ensure_goto_capacity(self, self->ngotos + 1) != 0) return -1;
        name = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                            self->lex->tokstr.len);
        if (!name) return self->sup->fail("out of memory");
        self->arena->nodes[s].text2 = name;
        if (!self->arena->nodes[s].text2) return self->sup->fail("out of memory");
        self->gotos[self->ngotos].name = name;
        if (!self->gotos[self->ngotos].name) return self->sup->fail("out of memory");
        self->gotos[self->ngotos].line = self->arena->nodes[s].line;
        self->gotos[self->ngotos].depth = self->ndefer_blocks;
        for (i = 0; i < self->ndefer_blocks; i++) {
            self->gotos[self->ngotos].path[i] = self->defer_ids[i];
            self->gotos[self->ngotos].has[i] = 0;
        }
        self->ngotos = self->ngotos + 1;
        self->sup->lex_next();
        if (self->sup->expect(";") != 0) return -1;
        return s;
    }
}
