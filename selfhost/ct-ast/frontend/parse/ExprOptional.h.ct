#include <stdlib.h>
#include <string.h>

import frontend::sym::SymbolsTypeText;
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::arena::Arena::NodeKind as NodeKind;
import runtime::arena::Arena::Node as Node;
import tool::diag::Diag;
import tool::sh::Sh;
import frontend::parse::ExprTypeText;
import frontend::parse::ExprPure;
import frontend::parse::ExprCore;
import frontend::parse::ExprAdtCtor;
import frontend::parse::ExprNewObject;
import frontend::parse::ExprSubscript;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 8192
#define CAP_LIMIT 65536
#define MAX_FUNCS 512
#define MAX_ARG_POS 32
#define MAX_GENERIC_INSTS 64
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
#define N_MATSEQ 73
#define N_NEWOBJ 77
#define N_INTO 63
#define N_INTO_SELF 64
#define N_TRY 71
#define N_ADTCTOR 81
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_OPT 72
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprOptional {
    int unused;
}


impl ExprOptional for Expr {
    /* PH-53 §4.5: no lexer token; look past the `?` and restore. `.5` is a
       ternary's float literal, never an optional chain. 1 = field, 2 = `[`. */
    int opt_suffix_kind(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, sfloat, strunc;
        int kind = 0;
        long snum;
        const char *stext_ptr; int stext_len;
        const char *ssuf_ptr; int ssuf_len;

        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        sfloat = self->lex->tokfloat;
        strunc = self->lex->toktrunc;
        stext_ptr = self->lex->tokstr.ptr; stext_len = self->lex->tokstr.len;
        ssuf_ptr = self->lex->toksuffix.ptr; ssuf_len = self->lex->toksuffix.len;
        self->sup->lex_next();
        if (self->lex->tok == T_NUM && self->lex->tok_first() == '.') {
            kind = 0;
        } else if (self->lex->tok == T_PUNCT
                   && self->lex->tok_is(".")) {
            self->sup->lex_next();
            if (self->lex->tok == T_ID) kind = 1;
        } else if (self->lex->tok == T_PUNCT
                   && self->lex->tok_is("[")) {
            kind = 2;
        }
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokfloat = sfloat;
        self->lex->toktrunc = strunc;
        self->lex->tokstr.ptr = stext_ptr; self->lex->tokstr.len = stext_len;
        self->lex->toksuffix.ptr = ssuf_ptr; self->lex->toksuffix.len = ssuf_len;
        return kind;
    }

    /* PH-53 L53-3/L53-4: a struct/union value has no NULL representation. */
    int opt_result_ok(const char *ty, int subscript, int line, int col)
    {
        const char *label;

        (void)self;
        if (strchr(ty, '*') != 0) return 0;
        if (strncmp(ty, "struct ", 7) != 0 && strncmp(ty, "union ", 6) != 0)
            return 0;
        label = self->custom_index_label_text(ty);
        if (!label) return self->sup->fail("out of memory");
        if (subscript)
            return tool::diag::ct_sem_error(line, col, tool::sh::ct_scratch_fmt(
                "optional subscript result must be a pointer or scalar; '%s' has no NULL representation",
                label), self->sup->mem->path);
        return tool::diag::ct_sem_error(line, col, tool::sh::ct_scratch_fmt(
            "optional chain result must be a pointer or scalar; '%s' has no NULL representation",
            label), self->sup->mem->path);
    }

    /* `recv?.field`: recv must be a struct pointer; the field must exist and
       its value must have a NULL spelling (L53-3). */
    int opt_field(int recv, const char *fname, int line, int col)
    {
        const char *rty;
        const char *base;
        const char *fty;
        size_t n;
        int ad = 0, si, fi, i, m, inst, nins;
        struct StructInst *ins;

        /* L53-5: `m["k"]` already answers `V *`; when V is itself a pointer the
           result is `V **` and `->field` would be one level off. */
        if (self->arena->nodes[recv].kind == N_MCALL
            && self->arena->nodes[recv].aux == 9
            && strcmp(self->arena->nodes[recv].text2, "get") == 0
            && strncmp(self->arena->nodes[recv].text, "struct Map_", 11) == 0) {
            inst = frontend::sym::ct_inst_find(self->arena->nodes[recv].text + 7);
            ins = frontend::sym::ct_insts(&nins);
            if (inst >= 0 && ins && inst < nins && ins[inst].nargs == 2
                && strchr(ins[inst].ctype[1], '*') != 0)
                return tool::diag::ct_sem_error(line, col,
                    "optional chain on a map lookup requires a value-typed V; got pointer value type; use a map of values or guard the inner pointer",
                    self->sup->mem->path);
        }
        rty = self->static_ctype_text(recv, &ad, 0);
        if (!rty || ad != 0)
            return self->sup->fail("cannot resolve the receiver type of '?.'");
        if (strchr(rty, '*') == 0)
            return tool::diag::ct_sem_error(line, col,
                "optional chain '?.' requires a pointer receiver; a struct value has no empty state",
                self->sup->mem->path);
        base = rty;
        n = strlen(base);
        while (n > 0 && base[n - 1] == ' ') n--;
        if (n == 0 || base[n - 1] != '*')
            return tool::diag::ct_sem_error(line, col,
                "optional chain '?.' requires a pointer receiver; a struct value has no empty state",
                self->sup->mem->path);
        n--;
        while (n > 0 && base[n - 1] == ' ') n--;
        base = runtime::text::ct_intern_len(base, (int)n);
        if (!base) return self->sup->fail("out of memory");
        if (strncmp(base, "struct ", 7) == 0) {
            base = runtime::text::ct_intern(base + 7);
            if (!base) return self->sup->fail("out of memory");
        }
        si = self->sym->find_struct(base);
        if (si < 0) return self->sup->fail("the '?.' receiver is not a struct pointer");
        fi = -1;
        for (i = 0; i < self->sym->structs[si].nfields; i++)
            if (strcmp(self->sym->structs[si].fields[i].name, fname) == 0) {
                fi = i;
                break;
            }
        if (fi < 0)
            return self->sup->fail(tool::sh::ct_scratch_fmt(
                "type '%s' has no field '%s'", base, fname));
        fty = self->ctype_expand_text(self->sym->structs[si].fields[fi].type, 0);
        if (!fty)
            return self->sup->fail("cannot resolve the optional field type");
        if (self->opt_result_ok(fty, 0, line, col) != 0) return -1;
        m = self->sup->new_node(N_OPT);
        if (m < 0) return -1;
        self->arena->nodes[m].a = recv;
        self->arena->nodes[m].aux = 1;
        self->arena->nodes[m].line = line;
        self->arena->nodes[m].num = col;
        self->arena->nodes[m].text = runtime::text::ct_intern(fname);
        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
        self->arena->nodes[m].text2 = fty;
        self->arena->nodes[m].text4 = rty;
        return m;
    }

    /* `recv?[key]`: C pointer element or `Map *` get; L53-2 / L53-4. */
    int opt_subscript(int recv, int idx, int line, int col)
    {
        const char *rty;
        const char *base;
        const char *rty2;
        size_t n;
        int ad = 0, m, inst, nins;
        struct StructInst *ins;

        rty = self->static_ctype_text(recv, &ad, 0);
        if (!rty || ad != 0)
            return self->sup->fail("cannot resolve the receiver type of '?['");
        if (strchr(rty, '*') == 0)
            return tool::diag::ct_sem_error(line, col,
                "optional subscript '?[' requires a pointer receiver; a struct value has no empty state",
                self->sup->mem->path);
        base = rty;
        n = strlen(base);
        while (n > 0 && base[n - 1] == ' ') n--;
        n--;                            /* exactly one pointer layer */
        while (n > 0 && base[n - 1] == ' ') n--;
        base = runtime::text::ct_intern_len(base, (int)n);
        if (!base) return self->sup->fail("out of memory");
        m = self->sup->new_node(N_OPT);
        if (m < 0) return -1;
        self->arena->nodes[m].a = recv;
        self->arena->nodes[m].b = idx;
        self->arena->nodes[m].line = line;
        self->arena->nodes[m].num = col;
        self->arena->nodes[m].text4 = rty;
        if (strncmp(base, "struct Map_", 11) == 0
            && (inst = frontend::sym::ct_inst_find(base + 7)) >= 0) {
            ins = frontend::sym::ct_insts(&nins);
            if (!ins || inst >= nins || ins[inst].nargs != 2)
                return self->sup->fail("cannot resolve the Map value type");
            rty2 = runtime::text::ct_internf("%s *", ins[inst].ctype[1]);
            if (!rty2) return self->sup->fail("out of memory");
            self->arena->nodes[m].aux = 3;
            self->arena->nodes[m].text = runtime::text::ct_intern(base + 7);
            if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
            self->arena->nodes[m].text2 = rty2;
            return m;
        }
        if (self->opt_result_ok(base, 1, line, col) != 0) return -1;
        self->arena->nodes[m].aux = 2;
        self->arena->nodes[m].text2 = base;
        return m;
    }

    /* PH-53 L53-6: an optional chain is a value, never an lvalue. Walk the
       member/arrow chain so `p?.b.f = 1` is refused at the `?.`. */
    int opt_lvalue_check(int n, int line, int col)
    {
        int at = n;

        while (at >= 0 && (self->arena->nodes[at].kind == N_MEMBER
                           || self->arena->nodes[at].kind == N_ARROW))
            at = self->arena->nodes[at].a;
        if (at < 0 || self->arena->nodes[at].kind != N_OPT) return 0;
        return tool::diag::ct_sem_error(line, col,
            "optional chain/subscript is not an lvalue; it cannot be assigned or address-taken",
            self->sup->mem->path);
    }
}
