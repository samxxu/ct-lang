namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprBinding {
    int unused;
}

pub int bind_conv_struct_like(struct Expr *self, const char *t)
{
    const char *p = t;

    while (*p == ' ' || *p == '\t') p++;
    if (strncmp(p, "struct ", 7) == 0 || strncmp(p, "union ", 6) == 0
        || strncmp(p, "enum ", 5) == 0)
        return 1;
    if (strstr(t, "_iface") != 0) return 1;
    return self->sym->find_struct(t) >= 0;
}

/* S1a-0 C2p-9: the pool-text form. `bind_conv_ibase` used to copy the
   receiver into a 160-byte row before `find_struct`, so a 2000-byte struct
   had no inherent block and a legal binding site said "no conversion". The
   trimmed spelling is interned, so the whole type survives the lookup and
   the returned pointer is stable for the rest of the parse. */
pub const char *bind_conv_ibase_text(struct Expr *self, const char *stype, int *is_ptr)
{
    const char *b = stype ? stype : "";
    const char *base;
    size_t n = strlen(b);

    *is_ptr = 0;
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
    if (n > 0 && b[n - 1] == '*') {
        *is_ptr = 1;
        n--;
        while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
    }
    base = runtime::text::ct_intern_len(b, (int)n);
    if (!base) return (const char *)0;
    if (strncmp(base, "struct ", 7) != 0 && strncmp(base, "union ", 6) != 0) {
        if (self->sym->find_struct(base) < 0) return (const char *)0;
        base = runtime::text::ct_internf("struct %s", base);
        if (!base) return (const char *)0;
    }
    return base;
}

/* The caller-sized form kept for the sites outside this batch; it now
   delegates to the pool-text form and only fails when the answer cannot fit
   the caller's (still 160-byte) row. */
pub int bind_conv_ibase(struct Expr *self, const char *stype, char *out, int cap, int *is_ptr)
{
    const char *t = bind_conv_ibase_text(self, stype, is_ptr);
    if (!t) return 0;
    if (snprintf(out, (size_t)cap, "%s", t) >= cap) return 0;
    return 1;
}

pub int bind_conv_inherent_text(struct Expr *self, const char *stype, const char *method, const char **ret, int *is_ptr)
{
    const char *ibase;
    char *buf = 0;
    int cap = 0, m, np;
    const char *pooled;

    if (ret) *ret = "";
    ibase = bind_conv_ibase_text(self, stype, is_ptr);
    if (!ibase) return -1;
    m = self->inst_inherent_method(ibase, method);
    if (m == -2) return -2;
    if (m < 0) return -1;
    np = 0;
    {
        int pi;
        for (pi = self->arena->nodes[m].a; pi > 0; pi = self->arena->nodes[pi].next) np++;
    }
    if (np != 0) return -3;
    if (tool::sh::ct_text_init(&buf, &cap, TEXT_LIMIT) != 0) return -1;
    if (!self->sup->ty->inst_method_ret(ibase, method, buf, cap)) {
        if (tool::sh::ct_text_printf(&buf, &cap, "%s", self->arena->nodes[m].text) != 0) {
            tool::sh::ct_text_free(&buf, &cap);
            return -1;
        }
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    if (!pooled) return -1;
    if (ret) *ret = pooled;
    return m;
}

pub int bind_conv_inherent(struct Expr *self, const char *stype, const char *method, char *ret, int cap, int *is_ptr)
{
    const char *t;
    int m = bind_conv_inherent_text(self, stype, method, &t, is_ptr);
    ret[0] = 0;
    if (m < 0) return m;
    if (snprintf(ret, (size_t)cap, "%s", t) >= cap) return -1;
    return m;
}

pub int bind_conv_maps_text(struct Expr *self, const char *stype, const char *method, const char **ret)
{
    const char *sk;
    const char *hk;
    const char *hit = (const char *)0;
    int i, j, seen = 0;

    if (ret) *ret = "";
    sk = bind_conv_key_text(stype);
    if (!sk) return -1;
    for (i = 0; i < *self->nmaps; i++) {
        if ((*self->maps)[i].is_binding) continue;
        if (!(*self->maps)[i].is_static || !(*self->maps)[i].type_host) continue;
        hk = bind_conv_key_text((*self->maps)[i].host_type);
        if (!hk) return -1;
        if (strcmp(hk, sk) != 0) continue;
        for (j = 0; j < (*self->maps)[i].nb; j++) {
            int ti = (*self->maps)[i].b[j].ti;
            int mi = (*self->maps)[i].b[j].mi;
            if (strcmp((*self->maps)[i].b[j].method, method) != 0) continue;
            if ((*self->maps)[i].b[j].nparams - (*self->maps)[i].b[j].recv != 0) continue;
            if (ti < 0 || mi < 0 || mi >= self->sym->traits[ti].nm) continue;
            if (!hit) hit = self->sym->traits[ti].m[mi].ret;
            seen++;
        }
    }
    if (ret) *ret = hit ? hit : "";
    return seen;
}

pub int bind_conv_maps(struct Expr *self, const char *stype, const char *method, char *ret, int cap)
{
    const char *t;
    int seen = bind_conv_maps_text(self, stype, method, &t);
    ret[0] = 0;
    if (seen < 0) return seen;
    if (seen > 0 && snprintf(ret, (size_t)cap, "%s", t) >= cap) return -1;
    return seen;
}

pub int bind_conv_binding(struct Expr *self, const char *stype, const char *target)
{
    const char *sk;
    const char *tk;
    const char *hk;
    const char *dk;
    int i, seen = 0;

    sk = bind_conv_key_text(stype);
    tk = bind_conv_key_text(target);
    if (!sk || !tk) return -1;
    for (i = 0; i < *self->nmaps; i++) {
        if (!(*self->maps)[i].is_binding) continue;
        hk = bind_conv_key_text((*self->maps)[i].host_type);
        if (!hk) return -1;
        if (strcmp(hk, sk) != 0) continue;
        dk = bind_conv_key_text((*self->maps)[i].bind_dst);
        if (!dk) return -1;
        if (strcmp(dk, tk) != 0) continue;
        seen++;
    }
    return seen;
}

pub int bind_conv_call_binding(struct Expr *self, int recv, const char *stype,
                                  const char *target, int line, int col)
{
    int n = self->sup->new_node(N_MCALL);
    if (n < 0) return -1;
    self->arena->nodes[n].aux = 12;
    self->arena->nodes[n].text = runtime::text::ct_intern(stype);
    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
    self->arena->nodes[n].text4 = runtime::text::ct_intern(target);
    if (!self->arena->nodes[n].text4) return self->sup->fail("out of memory");
    self->arena->nodes[n].sflags = self->arena->nodes[n].sflags | 4;
    self->arena->nodes[n].a = recv;
    self->arena->nodes[n].b = -1;
    self->arena->nodes[n].line = line;
    self->arena->nodes[n].num = col;
    return n;
}

/* Does any conversion (inherent or mapped) exist for this source spelling? */
pub int bind_conv_any(struct Expr *self, const char *stype, const char *method)
{
    const char *ret;
    int ptr = 0;

    if (bind_conv_inherent_text(self, stype, method, &ret, &ptr) >= 0) return 1;
    if (bind_conv_maps_text(self, stype, method, &ret) > 0) return 1;
    return 0;
}

pub int bind_conv_call(struct Expr *self, int recv, const char *stype, const char *method, const char *target, int line, int col)
{
    int n, ptr = 0;
    const char *ibase;
    const char *ret = "";

    if ((ibase = bind_conv_ibase_text(self, stype, &ptr)) != (const char *)0) {
        /* an inherent method wins over a mapping trait (D-020 lookup order) */
        if (bind_conv_inherent_text(self, stype, method, &ret, &ptr) >= 0) {
            n = self->sup->new_node(N_MCALL);
            if (n < 0) return -1;
            self->arena->nodes[n].aux = ptr ? 10 : 9;
            if (ptr) {
                size_t tl = strlen(stype);
                while (tl > 0 && (stype[tl - 1] == '*' || stype[tl - 1] == ' ')) tl = tl - 1;
                self->arena->nodes[n].text = runtime::text::ct_intern_len(stype, (int)tl);
            } else {
                self->arena->nodes[n].text = runtime::text::ct_intern(stype);
            }
            if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
            self->arena->nodes[n].text2 = runtime::text::ct_intern(method);
            if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
            self->arena->nodes[n].text4 = runtime::text::ct_intern(target);
            if (!self->arena->nodes[n].text4) return self->sup->fail("out of memory");
            self->arena->nodes[n].sflags |= 4;
            self->arena->nodes[n].a = recv;
            self->arena->nodes[n].b = -1;
            self->arena->nodes[n].line = line;
            self->arena->nodes[n].num = col;
            return n;
        }
    }
    n = self->sup->new_node(N_MCALL);
    if (n < 0) return -1;
    self->arena->nodes[n].aux = 6;
    self->arena->nodes[n].text = runtime::text::ct_intern(stype);
    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
    self->arena->nodes[n].text2 = runtime::text::ct_intern(method);
    if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
    self->arena->nodes[n].text4 = runtime::text::ct_intern(target);
    if (!self->arena->nodes[n].text4) return self->sup->fail("out of memory");
    self->arena->nodes[n].sflags |= 4;
    self->arena->nodes[n].a = recv;
    self->arena->nodes[n].b = -1;
    self->arena->nodes[n].line = line;
    self->arena->nodes[n].num = col;
    return n;
}

pub int bind_conv_site(struct Expr *self, int expr, const char *target, int line, int col)
{
    /* S1a-0 C2p-4: the source type is a pool text, so a 2000-byte host type
       reaches the binding registry instead of failing the 160-byte row. */
    const char *st;
    const char *sk;
    const char *tk;
    const char *ret = "";
    const char *tr;
    int ptr = 0, nm, ip = 0, mm;

    /* D-020 §6.3: off means v1.0 -- no implicit conversion at any binding site */
    if (!bind_conv_on()) return expr;
    if (expr < 0 || !target || !target[0]) return expr;
    if (strcmp(target, "void") == 0) return expr;
    if (strchr(target, '*')) return expr;
    if (self->sup->expr_type_text(expr, &st) != 0 || !st[0]) return expr;
    if (strchr(st, '*')) return expr;
    sk = bind_conv_key_text(st);
    tk = bind_conv_key_text(target);
    if (!sk || !tk) return expr;
    if (strcmp(sk, tk) == 0) return expr;
    /* an interface target is filled by the boxing pass, not by a conversion */
    if (self->sup->iface_ref_type_text(target, &tr, &ip)
        && self->sym->find_trait(tr) >= 0)
        return expr;
    mm = bind_conv_inherent_text(self, st, "as", &ret, &ptr);
    if (mm >= 0) {
        const char *rk = bind_conv_key_text(ret);
        if (!rk) return expr;
        if (strcmp(rk, tk) == 0)
            return bind_conv_call(self, expr, st, "as", target, line, col);
        return tool::diag::ct_sem_error(line, col,
            tool::sh::ct_scratch_fmt(
                 "no conversion from '%s' to '%s': inherent 'as' answers '%s'",
                 st, target, ret),
            self->sup->mem->path);
    }
    if (mm == -2)
        return tool::diag::ct_sem_error(line, col,
            "method is private to its unit", self->sup->mem->path);
    if (mm == -3)
        return tool::diag::ct_sem_error(line, col,
            "an 'as' conversion takes no arguments", self->sup->mem->path);
    /* D-021 §4 lookup order: inherent `as`, then a `map binding`, then an
       imported `map trait`. The binding is keyed by the pair, so it is asked
       before the method table. */
    if (bind_conv_binding(self, st, target) > 0)
        return bind_conv_call_binding(self, expr, st, target, line, col);
    nm = bind_conv_maps_text(self, st, "as", &ret);
    if (nm > 0)
        return bind_conv_call(self, expr, st, "as", target, line, col);
    /* No candidate. Under `--types` the existing kernel owns the
       "expected/got" diagnostic (its wording is pinned by p32/p43/p86), so
       leave the expression alone. In compile mode an aggregate-to-aggregate
       binding has no C conversion at all; name the missing conversion instead
       of emitting C that `cc` will reject. */
    if (self->types_mode && *self->types_mode
        && !(self->build_mode && *self->build_mode)) return expr;
    /* The owning-string and container types have their own binding
       diagnostics (escape, copy/move, element type). A conversion error here
       would preempt them, so those families keep the existing behaviour. */
    if (frontend::sym::ct_is_string_value_type(st)
        || frontend::sym::ct_is_string_value_type(target)
        || frontend::sym::ct_is_container_type(st)
        || frontend::sym::ct_is_container_type(target)
        || strstr(st, "Box_") != 0 || strstr(target, "Box_") != 0)
        return expr;
    if (bind_conv_struct_like(self, st) && bind_conv_struct_like(self, target)) {
        return tool::diag::ct_sem_error(line, col,
            tool::sh::ct_scratch_fmt(
                 "no conversion from '%s' to '%s'; add an inherent 'as' method on '%s', "
                 "import a mapping trait that declares 'as', or import a mapping unit "
                 "with a 'map binding' for this pair",
                 st, target, st),
            self->sup->mem->path);
    }
    return expr;
}

impl ExprBinding for Expr {
    int binding_convert(int expr, const char *target, int line, int col)
    {
        return bind_conv_site(self, expr, target, line, col);
    }
}
