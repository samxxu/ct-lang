/*
 * ParseSupport.h.ct - the parser's shared primitives.
 *
 * Everything the parser and the build driver both rely on that only touches a
 * collaborator: the token cursor helpers (`fail` / `lex_next` / `accept` /
 * `expect` / `new_node`), the thin wrappers onto the symbol tables, the type
 * layer and the memory pass, and the two error-recovery scans. It is its own
 * unit so the parser proper holds nothing but parsing; `Parser` keeps a
 * pointer to the single instance and calls it as `self->sup`.
 *
 * Macros do not cross a unit boundary, so the caps and token kinds used here
 * are declared here; MAX_FUNCS 256, MAX_PARAMS 16 and MAX_TEXT 160 are the
 * values `frontend/sym/Symbols.h.ct` lists.
 */
#include <stdio.h>
#include <string.h>

import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import tool::diag::Diag;

#define MAX_FUNCS 256
#define MAX_PARAMS 16
#define MAX_TEXT 160
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4

namespace frontend::parse;
pub trait SupportOps {
    int  fail(const char *msg);
    int  fail_at(int line, const char *msg);
    int  fail_driver(const char *msg);
    int  report(void);
    void lex_next(void);
    int  accept(const char *p);
    int  expect(const char *p);
    int  new_node(int kind);
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name, const char *type);
    int  var_type(const char *name, char *out, int cap);
    int  add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param);
    int  attr_pool(int *out);
    int  add_type(const char *name, int kind);
    int  add_struct(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, int tcap);
    int  method_trait_amb(const char *stype, const char *method, const char *first,
                          char *other, int ocap);
    int  arity_warn(int line, int col, const char *callee, const char *msg);
    int  type_warn(int line, int col, const char *callee, const char *msg);
    int  amb_warn(int line, int col, const char *method, const char *msg);
    int  ns_decl_name(const char *name, char *out, int cap);
    int  resolve_type(const char *name, char *out, int cap);
    int  is_iface_type(const char *type, char *tout, int tcap);
    int  iface_ref_type(const char *type, char *tout, int tcap, int *is_ptr);
    /* Phase 29: adopt a trait for a struct row (an instance's `use` list). */
    int  adopt_use(const char *name, const char *trait);
    int  expr_type(int n, char *out, int cap);
    int  expr_ctype(int n, char *out, int cap);
    int  maybe_box(int n, const char *trait, int addr);
    int  rewrite_init_text(const char *stype, const char *raw, char *out, int cap);
    int  mark_owned(int n, int line);
    int  leak_decl(int n);
    int  leak_scope(int from, int to);
    int  leak_assign(int n);
    int  leak_return(int ret, int conditional, int line);
    int  leak_delete(int e);
    int  skip_body(void);
    int  init_raw(char *out, int cap);
    int  skip_after_error(void);
    const char *last_error(void);
}

/* The field sizes are literals, not the macros above: a generated header carries
   no `#define`s, so a struct field cannot name one. 160 is MAX_TEXT and 1024 is
   MAX_PATH in `frontend/sym/Symbols.h.ct`. */
pub struct ParseSupport {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct TypeCheck *ty;
    struct Memory *mem;
    char errmsg[160];
    char errfile[1024];         /* the input the message was recorded against */
    int  errline;               /* 0 = a driver-level message, no source position */
    int  errcol;
} use SupportOps;

pub struct ParseSupport *parse_support_get(void);

impl SupportOps for ParseSupport {
    int new_node(int kind)
    {
        int n = self->arena->alloc(kind, self->lex->tokline);
        if (n < 0) return self->fail("too many AST nodes");
        return n;
    }

    /* A source diagnostic: the position is the token the parser stopped at, and
       the shape is L2's (`file:line:col: error: ...`). Recorded, not printed, so
       the driver can decide when to flush it (and so recovery can drop it). */
    int fail(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
            self->errfile[0] = 0;
            if (self->mem->path) snprintf(self->errfile, sizeof self->errfile, "%s", self->mem->path);
            self->errline = self->lex->tokline;
            self->errcol = self->lex->tokstart - self->lex->lstart + 1;
            /* at EOF the cursor's start is not on the line it reports */
            if (self->errcol < 1) self->errcol = 1;
        }
        return -1;
    }

    /* The caller knows where the fault is. An emitter error is about an AST node
       whose line is exact, while the lexer already sits at EOF by then. */
    int fail_at(int line, const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
            self->errfile[0] = 0;
            if (self->mem->path) snprintf(self->errfile, sizeof self->errfile, "%s", self->mem->path);
            self->errline = line;
            self->errcol = 1;
        }
        return -1;
    }

    /* A driver-level failure -- an unreadable input, a path that does not fit, a
       container limit. There is no source position to blame, so it keeps the
       `ctc:` prefix instead of pretending to point at a line. */
    int fail_driver(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
            self->errfile[0] = 0;
            self->errline = 0;
            self->errcol = 0;
        }
        return -1;
    }

    /* Flush the recorded failure once, in the shape it was recorded with. */
    int report(void)
    {
        (void)self;
        if (!self->errmsg[0]) return 1;
        if (self->errline > 0)
            fprintf(stderr, "%s:%d:%d: error: %s\n", self->errfile, self->errline, self->errcol, self->errmsg);
        else
            fprintf(stderr, "ctc: %s\n", self->errmsg);
        return 1;
    }

    void lex_next(void)
    {
        (void)self;
        self->lex->next();
        /* a name that did not fit in `toktext` is a hard error, not a silent
           truncation: two long names sharing a prefix would collapse into one
           symbol and the generated C would fail to compile */
        if (self->lex->toktrunc) {
            self->lex->toktrunc = 0;
            self->fail("identifier is too long");
            self->lex->tok = T_EOF;
        }
    }

    int accept(const char *p)
    {
        (void)self;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, p) == 0) {
            self->lex_next();
            return 1;
        }
        return 0;
    }

    int expect(const char *p)
    {
        (void)self;
        if (self->accept(p)) return 0;
        return self->fail("unexpected token");
    }

    int push_scope(void)
    {
        if (self->sym->push_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->own_base[self->sym->nscope - 1] = self->mem->nowner;
        return 0;
    }

    int pop_scope(void)
    {
        if (self->sym->pop_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->nowner = self->mem->own_base[self->sym->nscope];
        return 0;
    }

    int declare_var(const char *name, const char *type)
    {
        if (self->sym->declare_var(name, type) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int var_type(const char *name, char *out, int cap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->var_type(name, out, (int)cap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param)
    {
        char cname[MAX_TEXT];
        char msg[MAX_TEXT];
        int i, k, p, pub_now, fresh;

        /* `__ct_` names the compiler's own locals and closure products; a user
           declaration could otherwise collide with them in the generated C.
           `reserved_name` owns the one `__ct_recv<N>` exception (E30-9). */
        if (self->sym->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");

        /* Rows are keyed by the C spelling, so the declaration has to find the
           row that belongs to it first: the namespace-prefixed spelling (a
           `pub` function) is tried before the plain one (a static helper).
           `pub` sticks to the row -- a prototype may carry it while the
           definition repeats the signature without it, and both must spell the
           same C name -- so a prefixed row is found from either line. */
        i = -1;
        cname[0] = 0;
        if (self->sym->ns[0]
            && snprintf(cname, sizeof cname, "%s%s", self->sym->ns, name) < (int)sizeof cname)
            i = self->sym->find_func(cname);
        if (i < 0 && !is_pub) i = self->sym->find_func(name);
        pub_now = is_pub;
        if (i >= 0 && self->sym->funcs[i].is_pub) pub_now = 1;
        fresh = 0;
        if (i < 0) {
            if (self->sym->nfunc >= MAX_FUNCS) {
                snprintf(msg, sizeof msg, "too many functions in unit '%s' (limit %d)",
                         self->sym->unit_name(), MAX_FUNCS);
                return self->fail(msg);
            }
            i = self->sym->nfunc;
            self->sym->nfunc++;
            snprintf(self->sym->funcs[i].name, MAX_TEXT, "%s", name);
            self->sym->funcs[i].is_pub = 0;
            self->sym->funcs[i].ret_owned = 0;   /* fresh row: no ownership fact yet */
            self->sym->funcs[i].attr = -1;       /* fresh row: no attribute yet */
            self->sym->funcs[i].body = -1;       /* Phase 26: no definition node yet */
            fresh = 1;
        }
        if (pub_now) self->sym->funcs[i].is_pub = 1;
        if (pub_now && self->sym->ns[0]) {
            if (snprintf(cname, sizeof cname, "%s%s", self->sym->ns, name) >= (int)sizeof cname)
                return self->fail("function name is too long");
        } else {
            snprintf(cname, sizeof cname, "%s", name);
        }
        snprintf(self->sym->funcs[i].cname, MAX_TEXT, "%s", cname);
        /* The return type belongs to the first declaration: a prototype such as
           `_Noreturn void f(void);` keeps its prefix when the definition repeats
           the signature as `void f(void) {}`. */
        if (fresh) snprintf(self->sym->funcs[i].ret, MAX_TEXT, "%s", ret);
        self->sym->funcs[i].is_static = is_static;
        self->sym->funcs[i].nparams = 0;
        p = first_param;
        k = 0;
        while (p > 0 && k < MAX_PARAMS) {
            snprintf(self->sym->funcs[i].ptype[k], MAX_TEXT, "%s", self->arena->nodes[p].text);
            snprintf(self->sym->funcs[i].pdim[k], MAX_TEXT, "%s", self->arena->nodes[p].text3);
            /* a parameter's trailing `__attribute__` rides with its name/dims,
               so the prototype and the definition spell it the same way */
            if (self->arena->nodes[p].attr >= 0) {
                size_t dl = strlen(self->sym->funcs[i].pdim[k]);
                snprintf(self->sym->funcs[i].pdim[k] + dl, MAX_TEXT - dl, " %s",
                         self->arena->str_at(self->arena->nodes[p].attr));
            }
            k++;
            p = self->arena->nodes[p].next;
        }
        if (k >= MAX_PARAMS && p > 0) {
            snprintf(msg, sizeof msg, "too many parameters in unit '%s' (limit %d)",
                     self->sym->unit_name(), MAX_PARAMS);
            return self->fail(msg);
        }
        self->sym->funcs[i].nparams = k;
        return i;
    }

    /* Capture a GNU `__attribute__((…))` at the cursor into the arena string
       pool and report its offset (`-1` when the token is not an attribute).
       Consecutive groups are captured as one spelling, so the emitter can put
       them back at the declaration's trailing position verbatim. */
    int attr_pool(int *out)
    {
        char tbuf[MAX_TEXT];
        int depth, got, k, first;

        *out = -1;
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "__attribute__") == 0)) return 0;
        *out = self->arena->str_begin();
        got = 0;
        first = 1;
        while (self->lex->tok == T_ID && strcmp(self->lex->toktext, "__attribute__") == 0) {
            got = 1;
            depth = 0;
            for (;;) {
                if (self->lex->tok == T_EOF) return self->fail("unterminated __attribute__");
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                else
                    snprintf(tbuf, sizeof tbuf, "%s", self->lex->toktext);
                if (!first && self->arena->str_put(' ') != 0)
                    return self->fail("__attribute__ is too long");
                for (k = 0; tbuf[k]; k++)
                    if (self->arena->str_put(tbuf[k]) != 0)
                        return self->fail("__attribute__ is too long");
                first = 0;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) depth++;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                    depth--;
                    if (depth == 0) {
                        self->lex_next();
                        break;
                    }
                }
                self->lex_next();
            }
        }
        self->arena->str_end();
        return got;
    }

    int add_type(const char *name, int kind)
    {
        if (self->sym->add_type(name, kind) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int add_struct(const char *name)
    {
        const char *why;
        int i;
        if (self->sym->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        self->sym->errmsg[0] = 0;
        i = self->sym->add_struct(name);
        if (i < 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return i;
    }

    int add_trait(const char *name)
    {
        int i;
        if (self->sym->reserved_name(name))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        i = self->sym->add_trait(name);
        if (i < 0) return self->fail(self->sym->last_error());
        return i;
    }

    int method_trait(const char *stype, const char *method, char *tout, int tcap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->method_trait(stype, method, tout, (int)tcap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* SH-46 (19.3): whether a trait other than `first` also declares the
       method; the symbol unit owns the tables, this only wraps the error. */
    int method_trait_amb(const char *stype, const char *method, const char *first,
                         char *other, int ocap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->method_trait_amb(stype, method, first, other, (int)ocap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* A call-site arity mismatch (19.1). The caller (the expression grammar)
       knows the position and the signature; this unit only supplies the path
       the driver re-points at each unit. */
    int arity_warn(int line, int col, const char *callee, const char *msg)
    {
        return tool::diag::ct_arity_warn(line, col, callee, msg, self->mem->path);
    }

    /* A call-site argument type mismatch (19.2); same warning path as arity. */
    int type_warn(int line, int col, const char *callee, const char *msg)
    {
        return tool::diag::ct_type_warn(line, col, callee, msg, self->mem->path);
    }

    /* A bare call two traits of the receiver both declare (19.3, SH-46);
       same warning path as arity. */
    int amb_warn(int line, int col, const char *method, const char *msg)
    {
        return tool::diag::ct_amb_warn(line, col, method, msg, self->mem->path);
    }

    int ns_decl_name(const char *name, char *out, int cap)
    {
        if (self->sym->ns_decl_name(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int resolve_type(const char *name, char *out, int cap)
    {
        if (self->sym->resolve_type(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int is_iface_type(const char *type, char *tout, int tcap)
    {
        return self->ty->is_iface_type(type, tout, (int)tcap);
    }

    int iface_ref_type(const char *type, char *tout, int tcap, int *is_ptr)
    {
        return self->ty->iface_ref_type(type, tout, (int)tcap, is_ptr);
    }

    /* Phase 29: adopt `trait` for the struct row `name` once. An instance's
       `use` list is what its vptr field, its initialiser and its dispatch all
       read, so a `use` clause on a template impl lands there. */
    int adopt_use(const char *name, const char *trait)
    {
        int si, k;
        if (!self->sym || !trait[0]) return 0;
        si = self->sym->find_struct(name);
        if (si < 0) return 0;
        for (k = 0; k < self->sym->structs[si].nuse; k++)
            if (strcmp(self->sym->structs[si].use[k], trait) == 0) return 0;
        if (self->sym->structs[si].nuse >= 64) return 0;
        snprintf(self->sym->structs[si].use[self->sym->structs[si].nuse], 160, "%s", trait);
        self->sym->structs[si].nuse++;
        return 0;
    }

    int expr_type(int n, char *out, int cap)
    {
        return self->ty->expr_type(n, out, (int)cap);
    }

    int expr_ctype(int n, char *out, int cap)
    {
        return self->ty->expr_ctype(n, out, cap);
    }

    int maybe_box(int n, const char *trait, int addr)
    {
        const char *why;
        int box;
        self->ty->errmsg[0] = 0;
        box = self->ty->maybe_box(n, trait, addr);
        if (box < 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return box;
    }

    int rewrite_init_text(const char *stype, const char *raw, char *out, int cap)
    {
        const char *why;
        self->ty->errmsg[0] = 0;
        if (self->ty->rewrite_init_text(stype, raw, out, (int)cap) != 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int skip_body(void)
    {
        int depth;
        (void)self;
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "{") != 0)
            return self->fail("expected '{'");
        depth = 0;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                depth++;
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0) {
                depth--;
                if (depth == 0) {
                    self->lex_next();
                    return 0;
                }
            }
            self->lex_next();
        }
        return self->fail("unterminated body");
    }

    /* Capture a `{ ... }` initializer verbatim on behalf of whoever is reading
       one -- a declaration (the statement layer) or a compound literal (the
       expression layer). The cursor sits on the `{` token, so `pos` already
       points behind it; the scan works on the source characters because braces
       and commas are not tokens the caller wants. The captured text includes
       both braces and the caller appends the vptr items. */
    int init_raw(char *out, int cap)
    {
        int depth, n, c;
        (void)self;

        n = 0;
        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
        out[n] = '{';
        n++;
        depth = 1;
        while (self->lex->src[self->lex->pos] && depth > 0) {
            c = (unsigned char)self->lex->src[self->lex->pos];
            if (c == '"') {
                if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                out[n] = '"';
                n++;
                self->lex->pos++;
                while (self->lex->src[self->lex->pos] && self->lex->src[self->lex->pos] != '"') {
                    if (self->lex->src[self->lex->pos] == '\\' && self->lex->src[self->lex->pos + 1]) {
                        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                        out[n] = self->lex->src[self->lex->pos];
                        n++;
                        self->lex->pos++;
                    }
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = self->lex->src[self->lex->pos];
                    n++;
                    self->lex->pos++;
                }
                if (self->lex->src[self->lex->pos] == '"') {
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = '"';
                    n++;
                    self->lex->pos++;
                }
                continue;
            }
            if (c == '{') depth++;
            else if (c == '}') depth--;
            if (n + 1 >= (int)cap) return self->fail("initializer is too long");
            out[n] = (char)c;
            n++;
            self->lex->pos++;
        }
        if (depth != 0) return self->fail("unterminated initializer");
        out[n] = 0;
        self->lex_next();
        return 0;
    }

    int skip_after_error(void)
    {
        (void)self;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0) {
                self->lex_next();
                return 0;
            }
            self->lex_next();
            if (self->lex->bol) return 0;
        }
        return 0;
    }

    int mark_owned(int n, int line)
    {
        if (self->mem->mark_owned(n, line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_decl(int n)
    {
        return self->mem->leak_decl(n);
    }

    int leak_scope(int from, int to)
    {
        if (self->mem->leak_scope(from, to) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_assign(int n)
    {
        return self->mem->leak_assign(n);
    }

    int leak_return(int ret, int conditional, int line)
    {
        if (self->mem->leak_return(ret, conditional, line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_delete(int e)
    {
        return self->mem->leak_delete(e);
    }

    const char *last_error(void)
    {
        (void)self;
        return self->errmsg;
    }
}

/* The instance lives after the impl: its vptr initialisers need the vtable
   the emitter places with the impl. */
static struct ParseSupport g_support;

struct ParseSupport *parse_support_get(void)
{
    return &g_support;
}
