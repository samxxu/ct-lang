/*
 * ParseSupport.h.ct - the parser's shared primitives.
 *
 * Everything the parser and the build driver both rely on that only touches a
 * collaborator: the token cursor helpers (`fail` / `lex_next` / `accept` /
 * `expect` / `new_node`), the thin wrappers onto the symbol tables, the type
 * layer and the memory pass, and the two error-recovery scans. It is its own
 * unit so the parser proper holds nothing but parsing; `Parser` keeps a
 * pointer to the single instance and calls it as `self->sup`.
 *
 * Macros do not cross a unit boundary, so the caps and token kinds used here
 * are declared here; MAX_FUNCS 512, MAX_PARAMS 16 and MAX_TEXT 160 are the
 * values `frontend/sym/Symbols.h.ct` lists.
 */
#include <stdio.h>
#include <string.h>

import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import tool::diag::Diag;

/* Mirror of Symbols.h.ct's whole-program function budget (macros do not cross
   units). Raised 256 -> 512 together with the other three mirrors. */
/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_RAW_INIT 4096
#define MAX_RAW_INIT_MAX 65536
#define MAX_FUNCS 512
#define MAX_FUNCS_MAX 65536
#define MAX_PARAMS 16
#define MAX_PARAMS_MAX 65536
#define MAX_TEXT 160
#define T_EOF 0
#define T_ID 1
#define N_CALL 7
#define N_VAR 10
#define N_STR 9
#define N_MEMBER 24
#define N_ARROW 25
#define N_INDEX 26
#define N_DEREF 28
#define N_MCALL 30
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define T_NUM 2
#define T_PUNCT 4

namespace frontend::parse;
pub trait SupportOps {
    int  fail(const char *msg);
    int  fail_at(int line, const char *msg);
    int  fail_driver(const char *msg);
    int  report(void);
    void lex_next(void);
    int  accept(const char *p);
    int  expect(const char *p);
    int  new_node(int kind);
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name, const char *type);
    int  var_type(const char *name, char *out, int cap);
    int  add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param);
    int  attr_pool(int *out);
    int  add_type(const char *name, int kind);
    int  add_struct(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, int tcap);
    int  method_trait_amb(const char *stype, const char *method, const char *first,
                          char *other, int ocap);
    int  arity_warn(int line, int col, const char *callee, const char *msg);
    int  type_warn(int line, int col, const char *callee, const char *msg);
    int  amb_warn(int line, int col, const char *method, const char *msg);
    int  ns_decl_name(const char *name, char *out, int cap);
    const char *ns_decl_text(const char *name);
    int  resolve_type(const char *name, char *out, int cap);
    int  is_iface_type(const char *type, char *tout, int tcap);
    int  iface_ref_type(const char *type, char *tout, int tcap, int *is_ptr);
    /* Phase 29: adopt a trait for a struct row (an instance's `use` list). */
    int  adopt_use(const char *name, const char *trait);
    int  expr_type(int n, char *out, int cap);
    int  expr_ctype(int n, char *out, int cap);
    int  maybe_box(int n, const char *trait, int addr);
    int  rewrite_init_text(const char *stype, const char *raw, char **out, int *ocap);
    int  mark_owned(int n, int line);
    int  leak_decl(int n);
    int  leak_scope(int from, int to);
    int  leak_assign(int n);
    int  leak_return(int ret, int conditional, int line);
    int  leak_delete(int e);
    int  skip_body(void);
    /* P-7.2: note that the unit uses a slice, so the emitter writes the
       `{ptr,len}` struct and its helpers. The flag lives on `Parser`; the
       pointer is bound by `ct_parse_bind`. */
    void note_slice(void);
    /* P-7.2: is the expression a slice view (a slice variable, a subslice or
       a call returning `T[]`)? Used by the placement checks that must refuse
       storing a view in an interface / closure environment. */
    int  expr_is_slice(int n);
    /* LANG-22: SH-106's borrowed-view classifier, shared with the expression
       and statement layers so a store into a container / ADT / global can ask
       whether the value is a local or temporary view. */
    int  str_handle_kind(const char *t);
    int  str_escape_class(int e);
    int  str_escape_class_at(int e, int depth);
    int  str_store_warn(int e, const char *type, int line, int col);
    /* S1a-0 C1: the captured brace-initializer text grows on demand; the
       caller receives a pointer into the support object's buffer. */
    int  ensure_raw(int need);
    int  init_raw(char **out);
    /* P-7.2: `[` `]` lookahead used by every declaration position, so a slice
       spelling can be accepted (local / parameter) or refused (field / global)
       with the placement named. It sits here rather than on the expression
       object because that trait is at its method cap. */
    int  slice_brackets_ahead(int *line, int *col);
    int  skip_after_error(void);
    const char *last_error(void);
    /* SH-60 / D-60-2: the evidence for a C type name in a `.m.ct` trait
       signature. `map_sig_begin` resets the per-unit state, `map_include`
       records one prologue line, and `map_std_typedef` answers whether the
       name belongs to a standard header this unit includes. A name neither
       declared in CT nor evidenced here must be spelled through a `pub type`
       alias; the compiler never parses a C header. */
    void map_sig_begin(int is_map);
    void map_include(const char *line);
    int  map_std_typedef(const char *name);
}

/* The field sizes are literals, not the macros above: a generated header carries
   no `#define`s, so a struct field cannot name one. 160 is MAX_TEXT in
   `frontend/sym/Symbols.h.ct`; `errfile` still carries the legacy 1024-byte
   path bound (a later S1a-0 slice). */
pub struct ParseSupport {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct TypeCheck *ty;
    struct Memory *mem;
    char errmsg[160];
    char errfile[1024];         /* the input the message was recorded against */
    int  errline;               /* 0 = a driver-level message, no source position */
    int  errcol;
    /* LANG-10 7b: `--diagnostics=json` also covers a recorded parse failure.
       The channel matches the mode: compile/check write the document to stdout,
       build to stderr (stdout already carries the suggested cc line). */
    int  diag_json;
    int  diag_json_stderr;
    /* LANG-25: the stable code recorded with the first failure, and the
       `--diag-codes` text switch (default text stays byte-identical). */
    char errcode[32];
    int  diag_codes;
    /* P-7.2: points at the parser's slice-use flag. */
    int *slice_used;
    /* SH-60 / D-60-2: set while the parser reads a `.m.ct` trait signature.
       An unknown bare type name is then judged against the unit's includes
       instead of being kept as an opaque C spelling. */
    int  map_sig;
    /* the `#include` headers of the unit being parsed, by their spelling
       (`stddef.h`, `sys/types.h`); the table in the impl turns one into
       evidence for a standard typedef. */
    char map_headers[16][64];
    int  nmap_headers;
    /* S1a-0 C1: one captured initializer at a time; a caller consumes the
       text before the next `init_raw` call, so one growing buffer is enough. */
    char *raw;
    int  rawcap;
} use SupportOps;

pub struct ParseSupport *parse_support_get(void);

/* SH-60 / D-60-2: the standard C / POSIX typedefs a `.m.ct` signature may
   name when the unit includes the header that declares them. The compiler
   never parses a C header, so this table is the written evidence -- a name is
   accepted only when one of its home headers is in the unit's `#include` set.
   The type reader already knows `size_t`, `FILE`, `intN_t` and friends, so
   those never reach this table; a project typedef uses `pub type` instead.
   One name may appear once per header that is required to declare it. */
static const char *g_map_std_name[] = {
    "size_t", "size_t", "size_t", "size_t", "size_t", "size_t", "size_t",
    "ptrdiff_t", "wchar_t", "wchar_t", "wchar_t", "max_align_t",
    "FILE", "fpos_t",
    "time_t", "clock_t", "div_t", "ldiv_t", "lldiv_t",
    "int8_t", "int16_t", "int32_t", "int64_t",
    "uint8_t", "uint16_t", "uint32_t", "uint64_t",
    "int_least8_t", "int_least16_t", "int_least32_t", "int_least64_t",
    "uint_least8_t", "uint_least16_t", "uint_least32_t", "uint_least64_t",
    "int_fast8_t", "int_fast16_t", "int_fast32_t", "int_fast64_t",
    "uint_fast8_t", "uint_fast16_t", "uint_fast32_t", "uint_fast64_t",
    "intptr_t", "uintptr_t", "intmax_t", "uintmax_t", "imaxdiv_t",
    "bool", "va_list", "char16_t", "char32_t", "wint_t", "mbstate_t",
    "sig_atomic_t", "fenv_t", "fexcept_t",
    "off_t", "pid_t", "ssize_t", "uid_t", "gid_t", "mode_t", "dev_t",
    "ino_t", "nlink_t", "blksize_t", "blkcnt_t", "clockid_t", "timer_t",
    "key_t",
    "socklen_t",
    "pthread_t", "pthread_mutex_t", "pthread_cond_t", "pthread_attr_t",
    "pthread_key_t", "pthread_rwlock_t", "pthread_barrier_t",
    "pthread_spinlock_t",
    "DIR", "locale_t",
    0
};
static const char *g_map_std_header[] = {
    "stddef.h", "stdio.h", "stdlib.h", "string.h", "time.h", "wchar.h", "uchar.h",
    "stddef.h", "stddef.h", "stdlib.h", "wchar.h", "stddef.h",
    "stdio.h", "stdio.h",
    "time.h", "time.h", "stdlib.h", "stdlib.h", "stdlib.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h",
    "stdint.h", "stdint.h", "stdint.h", "stdint.h", "inttypes.h",
    "stdbool.h", "stdarg.h", "uchar.h", "uchar.h", "wchar.h", "wchar.h",
    "signal.h", "fenv.h", "fenv.h",
    "sys/types.h", "sys/types.h", "sys/types.h", "sys/types.h",
    "sys/types.h", "sys/types.h", "sys/types.h", "sys/types.h",
    "sys/types.h", "sys/types.h", "sys/types.h", "sys/types.h",
    "sys/types.h",
    "sys/types.h",
    "sys/socket.h",
    "pthread.h", "pthread.h", "pthread.h", "pthread.h",
    "pthread.h", "pthread.h", "pthread.h",
    "pthread.h",
    "dirent.h", "locale.h"
};

/* LANG-10 7b: the JSON string escaper (defined after the impl). */
static void put_json_parse(FILE *f, const char *s);

impl SupportOps for ParseSupport {
    int new_node(int kind)
    {
        int n = self->arena->alloc(kind, self->lex->tokline);
        if (n < 0) return self->fail("too many AST nodes");
        return n;
    }

    void note_slice(void)
    {
        if (self->slice_used) *self->slice_used = 1;
    }

    int expr_is_slice(int n)
    {
        int vi;
        char rt[MAX_TEXT];
        if (n < 0) return 0;
        if (self->arena->nodes[n].kind == N_VAR) {
            vi = self->sym->find_var(self->arena->nodes[n].text2);
            return vi >= 0 && self->sym->vars[vi].is_slice;
        }
        if (self->arena->nodes[n].kind == N_SLICE_RANGE) return 1;
        if (self->arena->nodes[n].kind == N_CALL) {
            rt[0] = 0;
            if (self->ty->expr_type(n, rt, (int)sizeof rt) == 0
                && strcmp(rt, "struct __ct_slice") == 0)
                return 1;
        }
        return 0;
    }

    /* LANG-22 (shared with SH-106): 1 `String`, 2 `U16String`, 3 `Str`,
       4 `U16Str`; 0 for anything else. A pointer / array suffix is not a
       handle. */
    int str_handle_kind(const char *t)
    {
        const char *b;
        (void)self;
        size_t n;

        if (t == 0) return 0;
        b = t;
        if (strncmp(b, "const ", 6) == 0) b += 6;
        if (strncmp(b, "struct ", 7) == 0) b += 7;
        while (*b == ' ' || *b == '\t') b++;
        n = strlen(b);
        while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
        if (n == 0 || b[n - 1] == '*' || b[n - 1] == ']') return 0;
        if (n == 6 && strncmp(b, "String", 6) == 0) return 1;
        if (n == 9 && strncmp(b, "U16String", 9) == 0) return 2;
        if (n == 3 && strncmp(b, "Str", 3) == 0) return 3;
        if (n == 6 && strncmp(b, "U16Str", 6) == 0) return 4;
        return 0;
    }

    int str_escape_class(int e)
    {
        return self->str_escape_class_at(e, 0);
    }

    /* SH-106's escape class of view expression `e`: 0 safe (immortal literal,
       owner is a parameter / field / global / static / immortal local),
       1 local owner, 2 temporary owner. LANG-22 reuses it unchanged. */
    int str_escape_class_at(int e, int depth)
    {
        char et[MAX_TEXT];
        int k, vi, rk, r;

        if (e < 0 || depth > 8) return 0;
        if (self->ty->expr_type(e, et, (int)sizeof et) != 0) return 0;
        rk = self->str_handle_kind(et);
        if (rk != 3 && rk != 4) return 0;
        k = self->arena->nodes[e].kind;
        if (k == N_STR) return 0;          /* immortal literal view */
        if (k == N_VAR) {
            vi = self->sym->find_var(self->arena->nodes[e].text2);
            if (vi < 0) return 0;
            return self->sym->vars[vi].str_escape;
        }
        if (k == N_MCALL) {
            const char *mn = self->arena->nodes[e].text2;
            if (!(strcmp(mn, "as_str") == 0 || strcmp(mn, "get") == 0
                  || strcmp(mn, "at") == 0 || strcmp(mn, "char_at") == 0
                  || strcmp(mn, "byte_slice") == 0 || strcmp(mn, "slice") == 0))
                return 0;
            r = self->arena->nodes[e].a;
            if (r < 0) return 0;
            if (self->ty->expr_type(r, et, (int)sizeof et) != 0) return 0;
            rk = self->str_handle_kind(et);
            if (rk == 3 || rk == 4)
                return self->str_escape_class_at(r, depth + 1);
            if (rk != 1 && rk != 2) return 0;
            if (self->arena->nodes[r].kind == N_STR) return 0;
            if (self->arena->nodes[r].kind == N_VAR) {
                if (strcmp(self->arena->nodes[r].text2, "self") == 0) return 0;
                vi = self->sym->find_var(self->arena->nodes[r].text2);
                if (vi < 0) return 0;
                if (self->sym->vars[vi].is_global || self->sym->vars[vi].is_static)
                    return 0;
                if (self->sym->vars[vi].is_fnparam || self->sym->vars[vi].is_param)
                    return 0;
                if (self->sym->vars[vi].str_immortal) return 0;
                return 1;
            }
            if (self->arena->nodes[r].kind == N_MEMBER
                || self->arena->nodes[r].kind == N_ARROW
                || self->arena->nodes[r].kind == N_DEREF
                || self->arena->nodes[r].kind == N_INDEX
                || self->arena->nodes[r].kind == N_SLICE_INDEX)
                return 0;
            return 2;
        }
        if (k == N_CALL && strcmp(self->arena->nodes[e].text2, "str_slice") == 0)
            return self->str_escape_class_at(self->arena->nodes[e].a, depth + 1);
        return 0;
    }

    /* LANG-22: a non-immortal `Str` / `U16Str` view is being stored in a
       container element, an ADT payload or a global / static. Warning only
       (compile/build) and an error under `ct check`, the SH-106 policy. */
    int str_store_warn(int e, const char *type, int line, int col)
    {
        char msg[MAX_TEXT * 2];
        int hk = self->str_handle_kind(type);

        if (hk != 3 && hk != 4) return 0;
        if (self->str_escape_class(e) == 0) return 0;
        snprintf(msg, sizeof msg,
                 "storing a non-immortal '%s' view; the owner must outlive the container",
                 hk == 4 ? "U16Str" : "Str");
        return tool::diag::ct_str_warn(line, col, msg, self->mem->path);
    }

    /* P-7.2: `[` `]` lookahead without consuming. The lexer has no peek, so
       the whole cursor state is saved and restored the way the parser's
       `record_body_ahead` does. */
    int slice_brackets_ahead(int *line, int *col)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, r;
        long snum;
        const char *stext_ptr; int stext_len;

        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("[")))
            return 0;
        if (line) *line = self->lex->tokline;
        if (col) *col = self->lex->tokstart - self->lex->lstart + 1;
        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        stext_ptr = self->lex->tokstr.ptr; stext_len = self->lex->tokstr.len;
        self->lex_next();
        r = (self->lex->tok == T_PUNCT && self->lex->tok_is("]"));
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokstr.ptr = stext_ptr; self->lex->tokstr.len = stext_len;
        return r;
    }

    /* A source diagnostic: the position is the token the parser stopped at, and
       the shape is L2's (`file:line:col: error: ...`). Recorded, not printed, so
       the driver can decide when to flush it (and so recovery can drop it). */
    int fail(const char *msg)
    {
        /* LANG-8: C's lexer reads `5.` as a float literal, so `5.foo()` leaves
           `foo` as the next token with no suffix `.` left for the parser. The
           generic `unexpected token` hides that cause; name it and give the
           one-character workaround. Only the adjacent spelling is rewritten --
           `5. foo` already has a separator and is judged on its own. */
        if (strcmp(msg, "unexpected token") == 0 && self->lex->tok == T_ID) {
            const char *src = self->lex->src;
            int n = self->lex->tokstart;
            int d = -1;
            /* `5.foo` leaves `foo`, but `5.f` is already a suffixed float and
               leaves `oo`; accept the optional float suffix before matching the
               `.` that the numeric scanner consumed. */
            if (src && n >= 2 && src[n - 1] == '.'
                && src[n - 2] >= '0' && src[n - 2] <= '9')
                d = n - 2;
            else if (src && n >= 3
                     && (src[n - 1] == 'f' || src[n - 1] == 'F'
                         || src[n - 1] == 'l' || src[n - 1] == 'L')
                     && src[n - 2] == '.'
                     && src[n - 3] >= '0' && src[n - 3] <= '9')
                d = n - 3;
            if (d >= 0)
                msg = "a numeric literal followed by '.' is a float; add a space for a method call";
        }
        (void)self;
        if (!self->errmsg[0]) {
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
            self->errfile[0] = 0;
            if (self->mem->path) snprintf(self->errfile, sizeof self->errfile, "%s", self->mem->path);
            self->errline = self->lex->tokline;
            self->errcol = self->lex->tokstart - self->lex->lstart + 1;
            /* at EOF the cursor's start is not on the line it reports */
            if (self->errcol < 1) self->errcol = 1;
            snprintf(self->errcode, sizeof self->errcode, "%s",
                     tool::diag::ct_diag_code_for_error(self->errmsg));
            if (!self->errcode[0]) snprintf(self->errcode, sizeof self->errcode, "E-PARSE-999");
        }
        return -1;
    }

    /* The caller knows where the fault is. An emitter error is about an AST node
       whose line is exact, while the lexer already sits at EOF by then. */
    int fail_at(int line, const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
            self->errfile[0] = 0;
            if (self->mem->path) snprintf(self->errfile, sizeof self->errfile, "%s", self->mem->path);
            self->errline = line;
            self->errcol = 1;
            snprintf(self->errcode, sizeof self->errcode, "%s",
                     tool::diag::ct_diag_code_for_error(self->errmsg));
            if (!self->errcode[0]) snprintf(self->errcode, sizeof self->errcode, "E-PARSE-999");
        }
        return -1;
    }

    /* A driver-level failure -- an unreadable input, a path that does not fit, a
       container limit. There is no source position to blame, so it keeps the
       `ctc:` prefix instead of pretending to point at a line. */
    int fail_driver(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
            self->errfile[0] = 0;
            self->errline = 0;
            self->errcol = 0;
            snprintf(self->errcode, sizeof self->errcode, "%s",
                     tool::diag::ct_diag_code_for_error(self->errmsg));
        }
        return -1;
    }

    /* Flush the recorded failure once, in the shape it was recorded with.
       LANG-10 7b: JSON mode emits one document with the same fields the
       semantic findings use; text mode stays byte-identical. */
    int report(void)
    {
        (void)self;
        if (!self->errmsg[0]) return 1;
        if (self->diag_json) {
            FILE *f = self->diag_json_stderr ? stderr : stdout;
            fputs("{\"errors\":[{\"severity\":\"error\",", f);
            if (self->errcode[0]) {
                fputs("\"code\":\"", f);
                put_json_parse(f, self->errcode);
                fputs("\",", f);
            }
            if (self->errline > 0) {
                fputs("\"file\":\"", f);
                put_json_parse(f, self->errfile);
                fprintf(f, "\",\"line\":%d,\"col\":%d,", self->errline, self->errcol);
            }
            fputs("\"message\":\"", f);
            put_json_parse(f, self->errmsg);
            fputs("\"}]}\n", f);
            return 1;
        }
        if (self->errline > 0 && self->diag_codes && self->errcode[0])
            fprintf(stderr, "%s:%d:%d: error: %s [%s]\n", self->errfile, self->errline,
                    self->errcol, self->errmsg, self->errcode);
        else if (self->errline > 0)
            fprintf(stderr, "%s:%d:%d: error: %s\n", self->errfile, self->errline, self->errcol, self->errmsg);
        else if (self->diag_codes && self->errcode[0])
            fprintf(stderr, "ctc: %s [%s]\n", self->errmsg, self->errcode);
        else
            fprintf(stderr, "ctc: %s\n", self->errmsg);
        return 1;
    }

    void lex_next(void)
    {
        (void)self;
        self->lex->next();
        /* a name past the formal text bound is a hard error, not a silent
           truncation: two long names sharing a prefix would collapse into one
           symbol and the generated C would fail to compile. A 2000-byte name
           is well inside the bound and is kept whole (S1a-0 C2o). */
        if (self->lex->toktrunc && self->lex->tok == T_ID) {
            self->lex->toktrunc = 0;
            self->fail("identifier is too long (over the 65536-byte formal text limit)");
            self->lex->tok = T_EOF;
        }
    }

    int accept(const char *p)
    {
        (void)self;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(p)) {
            self->lex_next();
            return 1;
        }
        return 0;
    }

    int expect(const char *p)
    {
        (void)self;
        if (self->accept(p)) return 0;
        return self->fail("unexpected token");
    }

    int push_scope(void)
    {
        if (self->sym->push_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->own_base[self->sym->nscope - 1] = self->mem->nowner;
        return 0;
    }

    int pop_scope(void)
    {
        if (self->sym->pop_scope() != 0) return self->fail(self->sym->last_error());
        self->mem->nowner = self->mem->own_base[self->sym->nscope];
        return 0;
    }

    int declare_var(const char *name, const char *type)
    {
        if (self->sym->declare_var(name, type) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int var_type(const char *name, char *out, int cap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->var_type(name, out, (int)cap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param)
    {
        const char *cname;
        char msg[MAX_TEXT];
        int i, k, p, pub_now, fresh, prev_nparams;

        /* `__ct_` names the compiler's own locals and closure products; a user
           declaration could otherwise collide with them in the generated C. */
        if (!strncmp(name, "__ct_", 5))
            return self->fail("identifier '__ct_' is reserved for the compiler");

        /* Rows are keyed by the C spelling, so the declaration has to find the
           row that belongs to it first: the namespace-prefixed spelling (a
           `pub` function) is tried before the plain one (a static helper).
           `pub` sticks to the row -- a prototype may carry it while the
           definition repeats the signature without it, and both must spell the
           same C name -- so a prefixed row is found from either line. */
        i = -1;
        cname = (const char *)0;
        if (self->sym->ns && self->sym->ns[0]) {
            cname = runtime::text::ct_intern_join(self->sym->ns, name);
            if (!cname) return self->fail("out of memory");
            i = self->sym->find_func(cname);
        }
        if (i < 0 && !is_pub) i = self->sym->find_func(name);
        pub_now = is_pub;
        if (i >= 0 && self->sym->funcs[i].is_pub) pub_now = 1;
        fresh = 0;
        if (i < 0) {
            if (self->sym->ensure_fn_capacity(self->sym->nfunc + 1) != 0) {
                snprintf(msg, sizeof msg, "too many functions (limit %d, whole program)", MAX_FUNCS_MAX);
                return self->fail(msg);
            }
            i = self->sym->nfunc;
            self->sym->nfunc++;
            self->sym->funcs[i].name = runtime::text::ct_intern(name);
            if (!self->sym->funcs[i].name) return self->fail("out of memory");
            self->sym->funcs[i].tparam = runtime::text::ct_intern("");
            if (!self->sym->funcs[i].tparam) return self->fail("out of memory");
            self->sym->funcs[i].bound = runtime::text::ct_intern("");
            if (!self->sym->funcs[i].bound) return self->fail("out of memory");
            self->sym->funcs[i].is_pub = 0;
            self->sym->funcs[i].ret_owned = 0;   /* fresh row: no ownership fact yet */
            self->sym->funcs[i].attr = -1;       /* fresh row: no attribute yet */
            self->sym->funcs[i].body = -1;       /* Phase 26: no definition node yet */
            fresh = 1;
        }
        if (pub_now) self->sym->funcs[i].is_pub = 1;
        if (!(pub_now && self->sym->ns && self->sym->ns[0])) {
            /* A static helper keeps its plain name even inside a namespace. */
            cname = runtime::text::ct_intern(name);
            if (!cname) return self->fail("out of memory");
        }
        self->sym->funcs[i].cname = cname;
        /* The return type belongs to the first declaration: a prototype such as
           `_Noreturn void f(void);` keeps its prefix when the definition repeats
           the signature as `void f(void) {}`. */
        if (fresh) {
            self->sym->funcs[i].ret = runtime::text::ct_intern(ret);
            if (!self->sym->funcs[i].ret) return self->fail("out of memory");
        }
        self->sym->funcs[i].is_static = is_static;
        prev_nparams = self->sym->funcs[i].nparams;
        self->sym->funcs[i].nparams = 0;
        p = first_param;
        k = 0;
        while (p > 0) {
            if (self->sym->ensure_fn_param_capacity(i, k + 1) != 0)
                return self->fail(self->sym->last_error());
            snprintf(self->sym->funcs[i].ptype + (size_t)k * MAX_TEXT, MAX_TEXT,
                     "%s", self->arena->nodes[p].text);
            snprintf(self->sym->funcs[i].pdim + (size_t)k * MAX_TEXT, MAX_TEXT,
                     "%s", self->arena->nodes[p].text3);
            /* Phase 78 S2a: `ref` / `out` is part of the C signature (the
               emitter spells `T *`), so a prototype and its definition must
               agree; silently taking the last one would emit two conflicting
               C declarations. */
            if (!fresh && k < prev_nparams
                && self->sym->funcs[i].pann[k] != (char)self->arena->nodes[p].aux) {
                snprintf(msg, sizeof msg,
                         "redeclaration of '%s' changes the ref/out annotation of parameter %d",
                         name, k + 1);
                return self->fail(msg);
            }
            self->sym->funcs[i].pann[k] = (char)self->arena->nodes[p].aux;
            /* a parameter's trailing `__attribute__` rides with its name/dims,
               so the prototype and the definition spell it the same way */
            if (self->arena->nodes[p].attr >= 0) {
                char *dim = self->sym->funcs[i].pdim + (size_t)k * MAX_TEXT;
                size_t dl = strlen(dim);
                snprintf(dim + dl, MAX_TEXT - dl, " %s",
                         self->arena->str_at(self->arena->nodes[p].attr));
            }
            k++;
            p = self->arena->nodes[p].next;
        }
        self->sym->funcs[i].nparams = k;
        return i;
    }

    /* Capture a GNU `__attribute__((…))` at the cursor into the arena string
       pool and report its offset (`-1` when the token is not an attribute).
       Consecutive groups are captured as one spelling, so the emitter can put
       them back at the declaration's trailing position verbatim. */
    int attr_pool(int *out)
    {
        char tbuf[MAX_TEXT];
        int depth, got, k, first;

        *out = -1;
        if (!(self->lex->tok == T_ID && self->lex->tok_is("__attribute__"))) return 0;
        *out = self->arena->str_begin();
        got = 0;
        first = 1;
        while (self->lex->tok == T_ID && self->lex->tok_is("__attribute__")) {
            got = 1;
            depth = 0;
            for (;;) {
                if (self->lex->tok == T_EOF) return self->fail("unterminated __attribute__");
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                else
                    self->lex->tok_copy(tbuf, sizeof tbuf);
                if (!first && self->arena->str_put(' ') != 0)
                    return self->fail("__attribute__ is too long");
                for (k = 0; tbuf[k]; k++)
                    if (self->arena->str_put(tbuf[k]) != 0)
                        return self->fail("__attribute__ is too long");
                first = 0;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) depth++;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
                    depth--;
                    if (depth == 0) {
                        self->lex_next();
                        break;
                    }
                }
                self->lex_next();
            }
        }
        self->arena->str_end();
        return got;
    }

    int add_type(const char *name, int kind)
    {
        if (self->sym->add_type(name, kind) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int add_struct(const char *name)
    {
        const char *why;
        int i;
        if (!strncmp(name, "__ct_", 5))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        self->sym->errmsg[0] = 0;
        i = self->sym->add_struct(name);
        if (i < 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return i;
    }

    int add_trait(const char *name)
    {
        int i;
        if (!strncmp(name, "__ct_", 5))
            return self->fail("identifier '__ct_' is reserved for the compiler");
        i = self->sym->add_trait(name);
        if (i < 0) return self->fail(self->sym->last_error());
        return i;
    }

    int method_trait(const char *stype, const char *method, char *tout, int tcap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->method_trait(stype, method, tout, (int)tcap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* SH-46 (19.3): whether a trait other than `first` also declares the
       method; the symbol unit owns the tables, this only wraps the error. */
    int method_trait_amb(const char *stype, const char *method, const char *first,
                         char *other, int ocap)
    {
        const char *why;
        self->sym->errmsg[0] = 0;
        if (self->sym->method_trait_amb(stype, method, first, other, (int)ocap) != 0) {
            why = self->sym->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    /* A call-site arity mismatch (19.1). The caller (the expression grammar)
       knows the position and the signature; this unit only supplies the path
       the driver re-points at each unit. */
    int arity_warn(int line, int col, const char *callee, const char *msg)
    {
        return tool::diag::ct_arity_warn(line, col, callee, msg, self->mem->path);
    }

    /* A call-site argument type mismatch (19.2); same warning path as arity. */
    int type_warn(int line, int col, const char *callee, const char *msg)
    {
        return tool::diag::ct_type_warn(line, col, callee, msg, self->mem->path);
    }

    /* A bare call two traits of the receiver both declare (19.3, SH-46);
       same warning path as arity. */
    int amb_warn(int line, int col, const char *method, const char *msg)
    {
        return tool::diag::ct_amb_warn(line, col, method, msg, self->mem->path);
    }

    const char *ns_decl_text(const char *name)
    {
        const char *q = self->sym->ns_decl_text(name);
        if (!q) self->fail("out of memory");
        return q;
    }

    int ns_decl_name(const char *name, char *out, int cap)
    {
        if (self->sym->ns_decl_name(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int resolve_type(const char *name, char *out, int cap)
    {
        if (self->sym->resolve_type(name, out, (int)cap) != 0)
            return self->fail(self->sym->last_error());
        return 0;
    }

    int is_iface_type(const char *type, char *tout, int tcap)
    {
        return self->ty->is_iface_type(type, tout, (int)tcap);
    }

    int iface_ref_type(const char *type, char *tout, int tcap, int *is_ptr)
    {
        return self->ty->iface_ref_type(type, tout, (int)tcap, is_ptr);
    }

    /* Phase 29: adopt `trait` for the struct row `name` once. An instance's
       `use` list is what its vptr field, its initialiser and its dispatch all
       read, so a `use` clause on a template impl lands there. */
    int adopt_use(const char *name, const char *trait)
    {
        int si, k;
        if (!self->sym || !trait[0]) return 0;
        si = self->sym->find_struct(name);
        if (si < 0) return 0;
        for (k = 0; k < self->sym->structs[si].nuse; k++)
            if (strcmp(self->sym->structs[si].use[k], trait) == 0) return 0;
        if (self->sym->structs[si].nuse >= 64) return 0;
        self->sym->structs[si].use[self->sym->structs[si].nuse] =
            runtime::text::ct_intern(trait);
        if (!self->sym->structs[si].use[self->sym->structs[si].nuse])
            return self->fail("out of memory");
        self->sym->structs[si].nuse++;
        return 0;
    }

    int expr_type(int n, char *out, int cap)
    {
        return self->ty->expr_type(n, out, (int)cap);
    }

    int expr_ctype(int n, char *out, int cap)
    {
        return self->ty->expr_ctype(n, out, cap);
    }

    int maybe_box(int n, const char *trait, int addr)
    {
        const char *why;
        int bnode;
        char msg[MAX_TEXT * 2];
        /* P-7.2 (P-4.1): an interface slot owns the concrete value it boxes;
           a slice is a non-owning view and cannot be stored there. The
           declaration / assignment sites also check with their own accurate
           positions; this central guard covers the remaining boxing paths
           (arguments, returns, container elements). */
        if (self->expr_is_slice(n)) {
            snprintf(msg, sizeof msg,
                     "a slice 'T[]' cannot be stored in interface '%s'; it is a non-owning view",
                     trait);
            return tool::diag::ct_sem_error(self->arena->nodes[n].line,
                                            self->arena->nodes[n].num > 0
                                                ? self->arena->nodes[n].num : 1,
                                            msg, self->mem->path);
        }
        self->ty->errmsg[0] = 0;
        bnode = self->ty->maybe_box(n, trait, addr);
        if (bnode < 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return bnode;
    }

    int rewrite_init_text(const char *stype, const char *raw, char **out, int *ocap)
    {
        const char *why;
        self->ty->errmsg[0] = 0;
        if (self->ty->rewrite_init_text(stype, raw, out, ocap) != 0) {
            why = self->ty->last_error();
            if (why[0]) return self->fail(why);
            return -1;
        }
        return 0;
    }

    int skip_body(void)
    {
        int depth;
        (void)self;
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is("{"))
            return self->fail("expected '{'");
        depth = 0;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                depth++;
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is("}")) {
                depth--;
                if (depth == 0) {
                    self->lex_next();
                    return 0;
                }
            }
            self->lex_next();
        }
        return self->fail("unterminated body");
    }

    /* S1a-0 C1: the capture buffer doubles from MAX_RAW_INIT up to
       MAX_RAW_INIT_MAX; only the resource limit reports a failure. */
    int ensure_raw(int need)
    {
        int cap;
        char *grown;
        (void)self;
        if (need <= self->rawcap) return 0;
        cap = self->rawcap > 0 ? self->rawcap : MAX_RAW_INIT;
        while (cap < need && cap < MAX_RAW_INIT_MAX) cap *= 2;
        if (cap > MAX_RAW_INIT_MAX) cap = MAX_RAW_INIT_MAX;
        if (need > cap) return self->fail("out of memory");
        grown = (char *)realloc(self->raw, (size_t)cap);
        if (!grown) return self->fail("out of memory");
        memset(grown + self->rawcap, 0, (size_t)(cap - self->rawcap));
        self->raw = grown;
        self->rawcap = cap;
        return 0;
    }

    /* Capture a `{ ... }` initializer verbatim on behalf of whoever is reading
       one -- a declaration (the statement layer) or a compound literal (the
       expression layer). The cursor sits on the `{` token, so `pos` already
       points behind it; the scan works on the source characters because braces
       and commas are not tokens the caller wants. The captured text includes
       both braces and the caller appends the vptr items. */
    int init_raw(char **out)
    {
        int depth, n, c;
        (void)self;

        n = 0;
        if (self->ensure_raw(n + 2) != 0) return -1;
        self->raw[n] = '{';
        n++;
        depth = 1;
        while (self->lex->src[self->lex->pos] && depth > 0) {
            c = (unsigned char)self->lex->src[self->lex->pos];
            if (c == '"') {
                if (self->ensure_raw(n + 2) != 0) return -1;
                self->raw[n] = '"';
                n++;
                self->lex->pos++;
                while (self->lex->src[self->lex->pos] && self->lex->src[self->lex->pos] != '"') {
                    if (self->lex->src[self->lex->pos] == '\\' && self->lex->src[self->lex->pos + 1]) {
                        if (self->ensure_raw(n + 3) != 0) return -1;
                        self->raw[n] = self->lex->src[self->lex->pos];
                        n++;
                        self->lex->pos++;
                    }
                    if (self->ensure_raw(n + 2) != 0) return -1;
                    self->raw[n] = self->lex->src[self->lex->pos];
                    n++;
                    self->lex->pos++;
                }
                if (self->lex->src[self->lex->pos] == '"') {
                    if (self->ensure_raw(n + 2) != 0) return -1;
                    self->raw[n] = '"';
                    n++;
                    self->lex->pos++;
                }
                continue;
            }
            if (c == '{') depth++;
            else if (c == '}') depth--;
            if (self->ensure_raw(n + 2) != 0) return -1;
            self->raw[n] = (char)c;
            n++;
            self->lex->pos++;
        }
        if (depth != 0) return self->fail("unterminated initializer");
        self->raw[n] = 0;
        self->lex_next();
        *out = self->raw;
        return 0;
    }

    int skip_after_error(void)
    {
        (void)self;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("}")) {
                self->lex_next();
                return 0;
            }
            self->lex_next();
            if (self->lex->bol) return 0;
        }
        return 0;
    }

    int mark_owned(int n, int line)
    {
        if (self->mem->mark_owned(n, line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_decl(int n)
    {
        return self->mem->leak_decl(n);
    }

    int leak_scope(int from, int to)
    {
        if (self->mem->leak_scope(from, to) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_assign(int n)
    {
        return self->mem->leak_assign(n);
    }

    int leak_return(int ret, int conditional, int line)
    {
        if (self->mem->leak_return(ret, conditional, line) != 0)
            return self->fail(self->mem->last_error());
        return 0;
    }

    int leak_delete(int e)
    {
        return self->mem->leak_delete(e);
    }

    const char *last_error(void)
    {
        (void)self;
        return self->errmsg;
    }

    /* SH-60 / D-60-2: one unit's signature evidence starts empty; the parser
       calls this at the top of `parse_program` and re-arms `map_sig` only
       around a `.m.ct` trait method's return / parameter types. */
    void map_sig_begin(int is_map)
    {
        (void)self;
        (void)is_map;
        self->map_sig = 0;
        self->nmap_headers = 0;
    }

    /* Record `#include <h>` / `#include "h"` (a no-op for any other prologue
       line). The header keeps its spelling, because the table above is keyed
       by it; duplicates collapse and the list is capped -- past the cap the
       worst outcome is one more "unknown type" diagnostic, never a wrong
       acceptance. */
    void map_include(const char *line)
    {
        const char *p;
        const char *b;
        char close;
        char hdr[64];
        int n, i;
        (void)self;

        p = line;
        while (*p == ' ' || *p == '\t') p++;
        if (strncmp(p, "#include", 8) != 0) return;
        p += 8;
        while (*p == ' ' || *p == '\t') p++;
        if (*p != '<' && *p != '"') return;
        close = (*p == '<') ? '>' : '"';
        b = ++p;
        while (*p && *p != close) p++;
        n = (int)(p - b);
        if (n <= 0 || n >= (int)sizeof hdr) return;
        memcpy(hdr, b, (size_t)n);
        hdr[n] = 0;
        for (i = 0; i < self->nmap_headers; i++)
            if (strcmp(self->map_headers[i], hdr) == 0) return;
        if (self->nmap_headers >= 16) return;
        snprintf(self->map_headers[self->nmap_headers], 64, "%s", hdr);
        self->nmap_headers++;
    }

    int map_std_typedef(const char *name)
    {
        int i, h;

        for (i = 0; g_map_std_name[i]; i++) {
            if (strcmp(g_map_std_name[i], name) != 0) continue;
            for (h = 0; h < self->nmap_headers; h++)
                if (strcmp(self->map_headers[h], g_map_std_header[i]) == 0) return 1;
        }
        return 0;
    }
}

/* LANG-10 7b: the JSON escaping the diagnostic store already uses, kept local
   because `Diag::put_json` is a method of another unit. */
static void put_json_parse(FILE *f, const char *s)
{
    for (; *s; s++) {
        if (*s == '"' || *s == '\\') {
            fputc('\\', f);
            fputc(*s, f);
        } else if (*s == '\n') {
            fputs("\\n", f);
        } else if (*s == '\t') {
            fputs("\\t", f);
        } else if ((unsigned char)*s < 0x20) {
            fputc('?', f);
        } else {
            fputc(*s, f);
        }
    }
}

/* The instance lives after the impl: its vptr initialisers need the vtable
   the emitter places with the impl. */
static struct ParseSupport g_support;

struct ParseSupport *parse_support_get(void)
{
    return &g_support;
}
