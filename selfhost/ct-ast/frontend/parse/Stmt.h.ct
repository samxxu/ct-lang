/*
 * Stmt.h.ct - the statement layer, one sub-object of the parser.
 *
 * Blocks, control flow (`if` / `while` / `for`), declarations and expression
 * statements, plus the raw initialiser capture they share. They only read the
 * cursor, the shared primitives, the symbol/memory tables and the expression
 * sub-object; the parser keeps functions, types, traits and the translation
 * unit and reaches this layer through `stmt_get`.
 *
 * Macros do not cross a unit boundary, so the caps and node kinds used here are
 * declared here; MAX_TEXT 160 is the value `frontend/sym/Symbols.h.ct` lists and
 * the node-kind numbers are the ones the parser builds.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <limits.h>
#include <stdio.h>
#include <string.h>

import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import frontend::lex::Lexer;
import frontend::sym::Symbols;
import frontend::sym::Symbols::StructInst as StructInst;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::parse::Expr;
import tool::diag::Diag;

#define MAX_TEXT 160
#define MAX_RAW_INIT 4096
#define MAX_INIT_TEXT 16384
#define MAX_LABELS 64

#define B_COMMA 19
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_MOD 11
#define B_SHL 17
#define B_SHR 18
#define B_BAND 15
#define B_BOR 16
#define B_XOR 14
#define N_INDEX 26
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BLOCK 4
#define N_CLOSURE 59
#define N_BREAK 38
#define N_CASE 43
#define N_CONT 39
#define N_DECL 12
#define N_DECLS 40
#define N_DELETE 41
#define N_DEREF 28
#define N_DOWHILE 44
#define N_EMPTY 52
#define N_SASSERT 55
#define N_EXPR 6
#define N_FOR 16
#define N_GOTO 50
#define N_IF 14
#define N_INIT_RANGE 61
/* Phase 31 S11a: `Vec<T> v = {…}` on a local declaration. `text` is the
   element's C type, `text2` the encoded instance name, `aux` the element count
   and `a` the first element expression (the rest hang off `next`). */
#define N_INIT_BRACE 65
/* Phase 31 S14a: one `key: value` pair of a `Map` brace initializer. `a` is the
   key expression, `b` the value expression, and pairs chain through `next`. */
#define N_INIT_ITEM 66
/* Phase 38: a parsed `defer { … }` block (`a` = body). It is not a statement in
   the emitted chain; the parser materialises N_DEFER_RUN wrappers at exits. */
#define N_DEFER 69
#define N_DEFER_RUN 70
/* Phase 31 S14a: a `Map` brace initializer. `text` is the nested `MapEntry`
   struct spelling, `text2` the encoded `Map` name, `aux` the item count and `a`
   the first `N_INIT_ITEM` (items chain through `next`). */
#define N_INIT_MBRACE 67
#define N_LABEL 49
#define N_LOOP 60
#define N_FOREACH 62
#define N_MEMBER 24
#define N_NUM 8
#define N_STR 9
#define N_UNARY 17
#define N_POST 18
#define N_PRE 57
#define N_ADDR 27
#define N_RAW 31
#define N_RET 5
#define N_SWITCH 42
#define N_VAR 10
#define N_WHILE 15
#define N_INTO 63
#define N_INTO_SELF 64
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3

namespace frontend::parse;
pub trait StmtOps {
    int  is_decl_start(void);
    int  parse_block(void);
    int  defer_ahead(void);
    int  err_ahead(void);
    int  errdefer_ahead(void);
    int  errdefer_own_refs(int n);
    int  parse_trailing_defer(int decl);
    int  trailing_alias(int n, const char *name);
    int  defer_add(int node);
    int  defer_active_depth(void);
    int  defer_mark_block(void);
    int  defer_run_node(int body, int line);
    int  defer_prepend(int node, int base, int on_error);
    int  defer_flush_block(int blk, int *tail);
    int  parse_stmt(void);
    int  parse_branch(void);
    int  parse_decl_node(void);
    int  parse_expr_stmt_node(void);
    int  parse_switch_body(void);
    int  parse_label(void);
    int  parse_case_value(void);
    int  label_ahead(void);
    int  label_find(const char *name);
    int  parse_named_label(void);
    int  parse_goto(void);
    int  loop_ahead(void);
    int  parse_loop(void);
    int  foreach_ahead(void);
    int  parse_foreach(void);
    int  range_init_ahead(void);
    int  parse_range_init(int n, const char *type);
    int  closure_global_init(int e, const char *name, int line, int col);
    int  func_begin(void);
    int  func_end(void);
}

pub struct Stmt {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct Memory *mem;
    struct ParseSupport *sup;
    struct Expr *ex;
    /* A switch may skip a case or fall through, so the ordered-block ownership
       rules do not hold inside one: `own` is refused while this is non-zero
       (D-7). The body has its own label grammar, so `parse_block` is not used.
       g_stmt is static, so this starts at zero. */
    int switch_depth;
    /* The high end of `case 1 ... 5:` (`-1` when the label is a single value).
       `parse_case_value` fills it and `parse_label` moves it onto the node. */
    int case_hi;
    /* Non-zero while `parse_decl_node` reads a `static` local: each N_DECL it
       builds is marked (`aux = 1`) and kept out of the leak analysis, since a
       static object outlives every scope that names it. */
    int static_decl;
    /* A GNU `__attribute__((…))` written before a block-scope declaration
       (`0` = none, else the pool offset plus one). `parse_decl_node` moves it
       onto every `N_DECL` it builds, so a multi-declarator line shares it. */
    int decl_attr;
    /* C labels are function-scoped, so both tables are reset at every function
       (or method) body: a duplicate is caught at the second spelling, and a
       `goto` whose label never shows up is reported when the body ends. The
       lengths are literals because a `pub struct` lands in the generated
       header, which carries no macros (`MAX_LABELS` is the value used here). */
    int  nlabels;
    char label_names[64][160];
    int  label_lines[64];
    int  ngotos;
    char goto_names[64][160];
    int  goto_lines[64];
    /* How many `loop` bodies enclose the statement being parsed. Only an inner
       `loop` inside an outer `loop` is diagnosed (D22-5): a hand-written `int i`
       or a native `for (int i = …)` is ordinary C shadowing and stays silent. */
    int  loop_depth;
    /* How many `foreach` bodies enclose the statement being parsed. Only an
       inner `foreach` inside an outer one is diagnosed (D27-10, mirroring
       D22-5): a hand-written `item` stays ordinary C shadowing and is silent. */
    int  foreach_depth;
    /* AutoDrop across a jump. A `break` / `continue` leaves its construct, so
       the `own` objects declared inside it have to be released first, exactly
       like `return` (SH-33). Each enclosing construct pushes the boundary its
       jump may release down to: a `switch` only offers a `break` (a `continue`
       in it belongs to the enclosing loop), and a `for` keeps the initialiser's
       object alive across `continue` but not across `break`. The length is a
       literal because a `pub struct` lands in the generated header. */
    int  break_base[256];
    int  break_is_switch[256];
    int  nbreak;
    int  cont_base[256];
    int  ncont;
    /* Phase 38: one defer stack per open block. `parse_block` pushes an entry;
       `defer_add` appends at parse time, and the exits materialise wrappers.
       `in_defer` rejects control transfer inside a defer body. */
    int  in_defer;
    int  in_errdefer;
    int  ndefer_blocks;
    int  defer_head[256];
    int  defer_tail[256];
    int  defer_ids[257];
    int  defer_block_err[256];
    int  ndefer_next_id;
    int  defer_break_base[256];
    int  defer_cont_base[256];
    /* The defer depth at each label/goto, so `func_end` can reject a jump
       across a block that owns a defer while allowing a same-block jump. */
    int  label_path[64][256];
    int  goto_path[64][256];
    char label_path_has[64][256];
    char goto_path_has[64][256];
    int  label_path_depth[64];
    int  goto_path_depth[64];
} use StmtOps;

/* AutoDrop: append `delete v;` for the `own` declarations recorded since `base`,
   in reverse order. `blk` receives them, `*tail` is the last node already linked
   (or -1) and ends up pointing at the newest release. Returns -1 on allocation
   failure. The caller owns the scope: `parse_block` closes a source `}`, and
   `parse_branch` closes the block it synthesises for a braceless branch, so a
   braceless `own` reaches the same release the braced form gets. */
static int autodrop_append(struct Stmt *self, int blk, int base, int *tail)
{
    int d;

    for (d = self->mem->nowner - 1; d >= base; d--) {
        int del, v, vi;
        const char *name, *tp;
        size_t bl;
        /* a reassigned / returned / moved `own` variable is no longer ours to
           release (L2 clears the same flag before its rewrite). The entry keeps
           the symbol it was declared as: a nested `own` of the same name is the
           innermost binding now, and asking by name would judge (and release)
           that one instead. */
        vi = self->mem->own_var[d];
        if (vi >= 0 && !self->sym->vars[vi].autodrop) continue;
        del = self->sup->new_node(N_DELETE);
        v = self->sup->new_node(N_VAR);
        if (del < 0 || v < 0) return -1;
        self->arena->nodes[del].aux = self->mem->own_kind[d];
        self->arena->nodes[del].line = self->arena->nodes[self->mem->own_decl[d]].line;
        name = self->arena->nodes[self->mem->own_decl[d]].text2;
        if (vi >= 0 && self->sym->find_var(name) != vi) {
            /* the name is shadowed at this release site, so the deletion cannot
               address the declared object through the source spelling. A private
               alias declared beside it (`aux = 2` prints `, *__ct_own_N = name`)
               keeps every release on the symbol this entry was declared as. */
            self->arena->nodes[self->mem->own_decl[d]].aux = 2;
            snprintf(self->arena->nodes[v].text2, MAX_TEXT, "__ct_own_%d", self->mem->own_decl[d]);
        } else {
            snprintf(self->arena->nodes[v].text2, MAX_TEXT, "%s", name);
        }
        self->arena->nodes[del].a = v;
        tp = self->arena->nodes[self->mem->own_decl[d]].text;
        if (strncmp(tp, "struct ", 7) == 0) tp += 7;
        snprintf(self->arena->nodes[del].text, MAX_TEXT, "%s", tp);
        bl = strlen(self->arena->nodes[del].text);
        while (bl > 0 && (self->arena->nodes[del].text[bl - 1] == '*'
                          || self->arena->nodes[del].text[bl - 1] == ' ')) {
            bl = bl - 1;
            self->arena->nodes[del].text[bl] = 0;
        }
        if (*tail < 0) self->arena->nodes[blk].a = del;
        else self->arena->nodes[*tail].next = del;
        *tail = del;
    }
    return 0;
}

/* A `return` has to release what the scope holds before it leaves, or the
   release appended at the closing `}` is dead code and the object is leaked
   (SH-33). The releases hang off the return node's `b` slot, in reverse
   declaration order, so the emitter prints them at the return's own
   indentation; the caller links the return as one node and cannot carry a
   chain. `permanent` (a return at the body's own level) also clears the flags:
   the fall-through path cannot reach the `}` anyway, and a second release
   there would only be dead code. The maintained flags keep the nested-block
   path correct, where the `}` release still serves the branch that does not
   return; `owned` is cleared either way, because every path now releases. */
static int retire_before_return(struct Stmt *self, int ret, int permanent)
{
    int blk, tail, d;

    if (self->mem->nowner <= 0) return ret;
    /* `autodrop_append` links into a container; the block is scratch and only
       its head is kept, which is then moved onto the return */
    blk = self->sup->new_node(N_BLOCK);
    if (blk < 0) return -1;
    tail = -1;
    if (autodrop_append(self, blk, 0, &tail) != 0) return -1;
    if (tail < 0) return ret;
    self->arena->nodes[ret].b = self->arena->nodes[blk].a;
    for (d = 0; d < self->mem->nowner; d++) {
        int vi = self->mem->own_var[d];
        if (vi < 0 || !self->sym->vars[vi].autodrop) continue;
        self->sym->vars[vi].owned = 0;
        if (permanent) self->sym->vars[vi].autodrop = 0;
    }
    return ret;
}

/* A `break` / `continue` leaves its construct, so every `own` declared since
   the construct opened is released first, in reverse order: the releases hang
   off the jump node's `b` slot and the emitter prints them before the keyword.
   `base` is the construct's baseline (`retire_before_return` uses the same
   shape), so a jump never touches an `own` declared outside the loop or
   switch. */
static int retire_before_jump(struct Stmt *self, int jump, int base)
{
    int blk, tail;

    if (self->mem->nowner <= base) return jump;
    /* the block is scratch; only its head is moved onto the jump */
    blk = self->sup->new_node(N_BLOCK);
    if (blk < 0) return -1;
    tail = -1;
    if (autodrop_append(self, blk, base, &tail) != 0) return -1;
    if (tail >= 0) self->arena->nodes[jump].b = self->arena->nodes[blk].a;
    return jump;
}

/* Push the baselines of one construct: a loop offers both a `break` and a
   `continue`, a switch only a `break` (`cont < 0`), because a `continue` inside
   it still belongs to the enclosing loop and must keep that loop's baseline.
   `256` is the literal the `pub struct` carries; going deeper is an error, not
   a silent overwrite. */
static int jump_push(struct Stmt *self, int brk, int cont)
{
    if (self->nbreak >= 256 || (cont >= 0 && self->ncont >= 256))
        return self->sup->fail("loops are nested too deeply");
    self->break_base[self->nbreak] = brk;
    self->break_is_switch[self->nbreak] = (cont < 0);
    self->defer_break_base[self->nbreak] = self->ndefer_blocks;
    self->nbreak = self->nbreak + 1;
    if (cont < 0) return 0;
    self->cont_base[self->ncont] = cont;
    self->defer_cont_base[self->ncont] = self->ndefer_blocks;
    self->ncont = self->ncont + 1;
    return 0;
}

static void jump_pop(struct Stmt *self, int with_cont)
{
    if (self->nbreak > 0) self->nbreak = self->nbreak - 1;
    if (with_cont && self->ncont > 0) self->ncont = self->ncont - 1;
}

/* SH-45: a release must not run before the returned value is read. When the
   expression reads (but does not hand over) an object that is still
   auto-dropped, the emitter materialises the value first and releases after. */
static int return_reads_autodrop(struct Stmt *self, int e)
{
    int i;

    for (i = 0; i < self->sym->nvar; i++) {
        if (!self->sym->vars[i].autodrop) continue;
        if (!self->mem->expr_mentions(e, self->sym->vars[i].name)) continue;
        if (self->mem->expr_returns(e, self->sym->vars[i].name)) continue;
        return 1;
    }
    return 0;
}

/* The scope a variable belongs to: the innermost scope whose opening boundary
   is at or before it. A parameter sits in the function's own scope and a local
   in the block's, so a shallower scope index is a longer-lived variable. */
static int var_scope(struct Symbols *sym, int vi)
{
    int s;

    for (s = sym->nscope - 1; s >= 0; s--)
        if (sym->scope[s] <= vi) return s;
    return -1;
}

/* Whether `target` outlives `source`: a global or a block-scope `static` lives
   past every scope, and a shallower scope outlives a deeper one. A sibling in
   the same scope dies with the source, so it does not. This is the one lifetime
   comparison shared by the borrow store check and (Phase 21) the closure
   escape check; keep both callers on it instead of open-coding the rule. */
static int outlives(struct Symbols *sym, int target, int source)
{
    if (target < 0 || source < 0) return 0;
    if (sym->vars[target].is_global || sym->vars[target].is_static) return 1;
    return var_scope(sym, target) < var_scope(sym, source);
}

/* Phase 21 S4: every closure error is followed by the same copy-pasteable
   tier-1 recipe. It goes through the note channel, which prints only: the
   error cap, the warning array, the JSON document and exit codes do not move.
   R02: `Callable` lives in ct-pkg and is not defined in this repository, so the
   hint spells a self-contained trait + struct + impl instead. It stays inside
   the 160-byte preprocessor token: a longer `#define` line is truncated when
   the compiler reads its own source. */
#define CT_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

static int closure_error(struct Stmt *self, int line, int col, const char *msg)
{
    tool::diag::ct_sem_error(line, col, msg, self->mem->path);
    tool::diag::ct_sem_note(line, col, CT_CLOSURE_HINT, self->mem->path);
    return -1;
}

/* The variable index a closure expression names: a bound variable, not a
   literal whose environment is created where it is written. -1 when the
   expression is not a closure binding. */
static int closure_var_index(struct Stmt *self, int e)
{
    int vi;

    if (e < 0 || self->arena->nodes[e].kind != N_VAR) return -1;
    vi = self->sym->find_var(self->arena->nodes[e].text2);
    if (vi < 0 || !self->sym->vars[vi].is_closure) return -1;
    return vi;
}

/* E1: the returned value itself is a closure binding or a literal. A closure
   handed to a call inside the return expression is that call's business, so
   only the value position is judged. */
static int closure_is_returned(struct Stmt *self, int e)
{
    if (e < 0) return 0;
    if (self->arena->nodes[e].kind == N_CLOSURE) return 1;
    return closure_var_index(self, e) >= 0;
}

/* E2 / E3 / E7: moving a closure binding out of the frame that owns its
   environment loses the `env` half, so every store form that is not the
   declaration bind is refused at the source position. */
/* R08: the column comes from the statement / declarator the check belongs to,
   not a fixed 1, so an editor can jump to the line as written. */
static int check_closure_assign(struct Stmt *self, int n, int col)
{
    int lhs, rhs, bv, lv, kind;
    char msg[MAX_TEXT];

    if (n < 0) return 0;
    lhs = self->arena->nodes[n].a;
    rhs = self->arena->nodes[n].b;
    lv = closure_var_index(self, lhs);
    /* a bound name is not assignable: it names the pair, not a slot */
    if (lv >= 0) return closure_error(self, self->arena->nodes[n].line, col,
                                      "this closure is a binding, not a value (inline it or use a struct + trait)");
    if (rhs < 0) return 0;
    kind = self->arena->nodes[rhs].kind;
    bv = closure_var_index(self, rhs);
    if (bv < 0 && kind != N_CLOSURE) return 0;
    if (kind == N_CLOSURE) {
        /* only a declaration binds a literal; storing it elsewhere is E7 */
        return closure_error(self, self->arena->nodes[n].line, col,
                             "this closure is a binding, not a value (inline it or use a struct + trait)");
    }
    if (lhs < 0) return 0;
    kind = self->arena->nodes[lhs].kind;
    if (kind == N_MEMBER || kind == N_ARROW || kind == N_INDEX)
        return closure_error(self, self->arena->nodes[n].line, col,
                             "a closure cannot be stored in a field, an element or a container");
    if (kind == N_VAR) {
        lv = self->sym->find_var(self->arena->nodes[lhs].text2);
        if (lv >= 0 && outlives(self->sym, lv, bv)) {
            snprintf(msg, sizeof msg,
                     "a closure cannot be stored in '%s' (its scope outlives the closure)",
                     self->sym->vars[lv].name);
            return closure_error(self, self->arena->nodes[n].line, col, msg);
        }
    }
    return closure_error(self, self->arena->nodes[n].line, col,
                         "this closure is a binding, not a value (inline it or use a struct + trait)");
}

/* The declaration path: `int (*d)(int) = c;` copies a binding, while
   `int (*d)(int) = (int x) => …;` is the one form that creates one. */
static int check_closure_decl_init(struct Stmt *self, int n, const char *name, int col)
{
    int rhs, bv, dv;
    char msg[MAX_TEXT];

    if (n < 0 || self->arena->nodes[n].a < 0) return 0;
    rhs = self->arena->nodes[n].a;
    bv = closure_var_index(self, rhs);
    if (bv < 0) return 0;
    dv = self->sym->find_var(name);
    if (dv >= 0 && outlives(self->sym, dv, bv)) {
        snprintf(msg, sizeof msg,
                 "a closure cannot be stored in '%s' (its scope outlives the closure)", name);
        return closure_error(self, self->arena->nodes[n].line, col, msg);
    }
    return closure_error(self, self->arena->nodes[n].line, col,
                         "this closure is a binding, not a value (inline it or use a struct + trait)");
}

/* `delete r;` on a borrowed pointer frees an object the lender still owns: a
   pooled object stays live after the handback, and a stack object was never
   ours to free. Only the bare spelling is judged, as in the design. */
static int check_borrow_delete(struct Stmt *self, int e)
{
    int vi;

    if (e < 0 || self->arena->nodes[e].kind != N_VAR) return 0;
    vi = self->sym->find_var(self->arena->nodes[e].text2);
    if (vi < 0 || !self->sym->vars[vi].borrowed) return 0;
    return tool::diag::ct_sem_error(self->arena->nodes[e].line, 1,
                           "a borrowed pointer cannot be deleted", self->mem->path);
}

/* Storing a borrow into a variable that lives longer hands out a pointer that
   dies with the borrow. Only `x = r` and `x = r[0]` are judged; a field store
   (`s->p = r`) and a call (`store(r)`) would need interprocedural analysis,
   which this compiler does not do (design 7.1 / 7.2). A global and a shallower
   scope both outlive the borrow; a sibling in the same scope dies with it, so
   that store stays legal. */
static int check_borrow_store(struct Stmt *self, int n)
{
    int lhs, rhs, bv, lv;
    char msg[MAX_TEXT];

    if (n < 0) return 0;
    lhs = self->arena->nodes[n].a;
    rhs = self->arena->nodes[n].b;
    /* The handle itself is not assignable: a second object would overwrite the
       one the exit still has to hand back (SH-35). */
    if (lhs >= 0 && self->arena->nodes[lhs].kind == N_VAR) {
        lv = self->sym->find_var(self->arena->nodes[lhs].text2);
        if (lv >= 0 && self->sym->vars[lv].borrowed)
            return tool::diag::ct_sem_error(self->arena->nodes[n].line, 1,
                                   "a borrowed pointer cannot be reassigned",
                                   self->mem->path);
    }
    bv = -1;
    if (rhs >= 0) {
        if (self->arena->nodes[rhs].kind == N_VAR)
            bv = self->sym->find_var(self->arena->nodes[rhs].text2);
        else if (self->arena->nodes[rhs].kind == N_INDEX && self->arena->nodes[rhs].a >= 0
                 && self->arena->nodes[self->arena->nodes[rhs].a].kind == N_VAR)
            bv = self->sym->find_var(self->arena->nodes[self->arena->nodes[rhs].a].text2);
    }
    if (bv < 0 || !self->sym->vars[bv].borrowed) return 0;
    if (lhs < 0 || self->arena->nodes[lhs].kind != N_VAR) return 0;
    lv = self->sym->find_var(self->arena->nodes[lhs].text2);
    if (lv < 0) return 0;
    /* a static local outlives the borrow just like a global (SH-37) */
    if (!outlives(self->sym, lv, bv)) return 0;
    snprintf(msg, sizeof msg,
             "a borrowed pointer cannot be stored in '%s' (its scope outlives the borrow)",
             self->sym->vars[lv].name);
    return tool::diag::ct_sem_error(self->arena->nodes[n].line, 1, msg, self->mem->path);
}

/* The token after a leading `borrow` decides what the statement is: a type
   start makes it a declaration, while `(` makes it a call to a function of that
   name (`test/modules/leak_call/prog.ct` keeps `borrow` as a function). The
   cursor is restored, since the caller consumes the keyword itself. */
static int borrow_decl_ahead(struct Stmt *self)
{
    char save_text[MAX_TEXT];
    int save_tok, save_float, save_line, save_tokline, save_start;
    int save_lstart, save_bol, save_pos, look;
    long save_num;

    save_tok = self->lex->tok;
    save_num = self->lex->toknum;
    save_float = self->lex->tokfloat;
    save_line = self->lex->line;
    save_tokline = self->lex->tokline;
    save_start = self->lex->tokstart;
    save_lstart = self->lex->lstart;
    save_bol = self->lex->bol;
    save_pos = self->lex->pos;
    snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
    self->sup->lex_next();
    look = self->is_decl_start();
    self->lex->tok = save_tok;
    self->lex->toknum = save_num;
    self->lex->tokfloat = save_float;
    self->lex->line = save_line;
    self->lex->tokline = save_tokline;
    self->lex->tokstart = save_start;
    self->lex->lstart = save_lstart;
    self->lex->bol = save_bol;
    self->lex->pos = save_pos;
    snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
    return look;
}

/* `borrow Conn *c = pool.acquire(…);`: at scope exit the compiler hands the
   object back with `Conn_Handback_handback(c)` and nulls the pointer. The
   declaration is checked here, because a pooled object that nobody hands back
   leaks its slot, and a handback on a type without an impl would compile to a
   call of an undefined symbol. */
static int mark_borrow(struct Stmt *self, int n, int line, int col)
{
    char base[MAX_TEXT];
    char et[MAX_TEXT];
    char msg[MAX_TEXT];
    char eb[MAX_TEXT];
    int d, si, vi;
    size_t bl, el;

    d = n;
    if (self->arena->nodes[n].kind == N_DECLS) d = self->arena->nodes[n].a;
    while (d >= 0) {
        const char *tp = self->arena->nodes[d].text;
        if (self->arena->nodes[d].text3[0] != 0)
            return tool::diag::ct_sem_error(line, col, "'borrow' does not support arrays",
                                            self->mem->path);
        bl = strlen(tp);
        if (bl == 0 || tp[bl - 1] != '*')
            return tool::diag::ct_sem_error(line, col,
                                   "'borrow' requires an initialiser of struct pointer type",
                                   self->mem->path);
        snprintf(base, sizeof base, "%s", tp);
        bl = strlen(base);
        while (bl > 0 && (base[bl - 1] == '*' || base[bl - 1] == ' ')) {
            bl = bl - 1;
            base[bl] = 0;
        }
        if (strncmp(base, "struct ", 7) == 0) memmove(base, base + 7, strlen(base + 7) + 1);
        si = self->sym->find_struct(base);
        if (si < 0 || self->arena->nodes[d].a < 0)
            return tool::diag::ct_sem_error(line, col,
                                   "'borrow' requires an initialiser of struct pointer type",
                                   self->mem->path);
        /* the initialiser must name a pointer to the same struct whenever its
           type is resolvable here; an untyped expression is left to the C
           compiler, as the rest of the compiler does */
        if (self->sup->expr_type(self->arena->nodes[d].a, et, sizeof et) == 0) {
            el = strlen(et);
            if (el > 0 && et[el - 1] == '*') {
                snprintf(eb, sizeof eb, "%s", et);
                el = strlen(eb);
                while (el > 0 && (eb[el - 1] == '*' || eb[el - 1] == ' ')) {
                    el = el - 1;
                    eb[el] = 0;
                }
                if (strncmp(eb, "struct ", 7) == 0) memmove(eb, eb + 7, strlen(eb + 7) + 1);
                if (strcmp(eb, base) != 0)
                    return tool::diag::ct_sem_error(line, col,
                                           "'borrow' requires an initialiser of struct pointer type",
                                           self->mem->path);
            } else {
                return tool::diag::ct_sem_error(line, col,
                                       "'borrow' requires an initialiser of struct pointer type",
                                       self->mem->path);
            }
        }
        if (!self->sym->structs[si].uses_handback) {
            snprintf(msg, sizeof msg, "struct '%s' does not use trait 'Handback'", base);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        if (!self->sym->structs[si].has_handback_impl) {
            /* the impl table is per unit (design E-B), so a cross-unit impl is
               not visible here; the message says "in this unit" rather than
               claiming the impl does not exist (SH-38 / SH-39) */
            snprintf(msg, sizeof msg, "struct '%s' uses trait 'Handback' but this unit has no impl", base);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        vi = self->sym->find_var(self->arena->nodes[d].text2);
        if (vi >= 0) {
            self->sym->vars[vi].borrowed = 1;
            self->sym->vars[vi].autodrop = 1;
            self->sym->vars[vi].owned = 0;
            self->sym->vars[vi].own_line = line;
        }
        /* the pools live in Memory, whose cap is 4096; the guard keeps the two
           arrays in step instead of running past the second one */
        if (self->mem->nowner >= 4096) return self->mem->fail("too many owned variables");
        self->mem->own_decl[self->mem->nowner] = d;
        self->mem->own_kind[self->mem->nowner] = 1;
        self->mem->own_var[self->mem->nowner] = vi;
        self->mem->nowner++;
        d = self->arena->nodes[d].next;
    }
    return 0;
}

/* A borrowed pointer handed back through `return`: the caller would keep a
   pointer whose borrow ended with this frame. A parameter belongs to the
   caller and may legitimately be passed on, so it only warns; a local cannot
   be handed back at all, so its injection is cancelled -- returning it would
   put the object back in the pool while the caller still reads the slot. */
static int borrow_escape(struct Stmt *self, int ret, int line)
{
    int i;

    if (ret < 0) return 0;
    for (i = 0; i < self->sym->nvar; i++) {
        if (!self->sym->vars[i].borrowed) continue;
        if (!self->mem->expr_returns(ret, self->sym->vars[i].name)) continue;
        if (tool::diag::ct_borrow_warn(line, self->sym->vars[i].name, self->mem->path) != 0)
            return self->mem->fail("too many warnings");
        if (!self->sym->vars[i].is_param) self->sym->vars[i].autodrop = 0;
    }
    return 0;
}

/* Classify the static type of a `loop` count: 1 = an integer type, 0 = a type
   that is confidently not one (L22-5), -1 = unknown, which is never diagnosed
   (a false positive is worse than a miss). Pointers, arrays and function types
   are not integers; `enum` and `_Bool` are. */
static int loop_count_class(const char *t)
{
    char w[MAX_TEXT];
    int n, words;

    if (strchr(t, '*') || strchr(t, '[') || strchr(t, '(')) return 0;
    if (strncmp(t, "struct ", 7) == 0 || strncmp(t, "union ", 6) == 0) return 0;
    if (strncmp(t, "enum ", 5) == 0) return 1;
    words = 0;
    while (*t) {
        while (*t == ' ' || *t == '\t') t++;
        if (!*t) break;
        n = 0;
        while (*t && *t != ' ' && *t != '\t') {
            if (n < MAX_TEXT - 1) w[n++] = *t;
            t++;
        }
        w[n] = 0;
        if (strcmp(w, "const") == 0 || strcmp(w, "volatile") == 0) continue;
        words = 1;
        if (strcmp(w, "char") == 0 || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
            || strcmp(w, "long") == 0 || strcmp(w, "signed") == 0
            || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0)
            continue;
        if (strcmp(w, "float") == 0 || strcmp(w, "double") == 0 || strcmp(w, "void") == 0)
            return 0;
        /* an unresolved alias or a spelling this layer cannot classify */
        return -1;
    }
    return words ? 1 : -1;
}

/* ---- Phase 24: array range initialisers ---------------------------------- */

/* The source spelling of the current token. An integer literal carries no
   `toktext` (the lexer keeps its value in `toknum`), so the digits are taken
   back from the source between the token's first byte and the cursor. */
static void range_spelling(struct Lexer *lx, char *out, int cap)
{
    int i = 0;

    if (lx->tok == T_NUM) {
        int s = lx->tokstart;
        while (s + i < lx->pos && i < cap - 1) {
            out[i] = lx->src[s + i];
            i++;
        }
    } else {
        while (lx->toktext[i] && i < cap - 1) {
            out[i] = lx->toktext[i];
            i++;
        }
    }
    out[i] = 0;
    if (!out[0]) snprintf(out, (size_t)cap, "%s", "end of file");
}

static int range_digit(int c, int base)
{
    if (c >= '0' && c <= '9') return (c - '0' < base) ? c - '0' : -1;
    if (base == 16) {
        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    }
    return -1;
}

/* Evaluate one range bound from its source spelling. The shared lexer neither
   rejects a digit-less `0x` (it yields 0) nor detects overflow, so the spelling
   is re-read here instead of trusting `toknum`: 0 = ok, 1 = not an integer
   literal, 2 = out of `long`. Popping a value that does not fit is what keeps a
   wrapped bound from turning into a bogus `count`. */
static int range_bound_value(struct Lexer *lx, long *out, char *spell, int cap)
{
    char text[MAX_TEXT];
    const char *p;
    long v = 0;
    int base = 10, d, nd = 0;

    range_spelling(lx, text, (int)sizeof text);
    snprintf(spell, (size_t)cap, "%s", text);
    if (lx->tok != T_NUM || lx->tokfloat) return 1;
    p = text;
    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
        base = 16;
        p += 2;
    } else if (p[0] == '0' && p[1] >= '0' && p[1] <= '7') {
        base = 8;
        p += 1;
    }
    while ((d = range_digit(*p, base)) >= 0) {
        if (v > (LONG_MAX - d) / base) return 2;
        v = v * base + d;
        p++;
        nd++;
    }
    if (!nd) return 1;
    while (*p) {
        if (*p != 'u' && *p != 'U' && *p != 'l' && *p != 'L') return 1;
        p++;
    }
    *out = v;
    return 0;
}

/* Parse one bound: an optional unary `-` and one integer literal. The cursor
   ends past the literal. */
static int range_bound(struct Stmt *self, long *out)
{
    char spell[MAX_TEXT];
    char msg[256];
    int neg = 0, rc, line, col;
    long v = 0;

    line = self->lex->tokline;
    col = self->lex->tokstart - self->lex->lstart + 1;
    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "-") == 0) {
        neg = 1;
        self->sup->lex_next();
        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
    }
    /* `..` followed straight by `(` is a missing bound, not a bad one */
    if (!neg && self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0)
        return tool::diag::ct_sem_error(line, col, "a range initializer needs both bounds", self->mem->path);
    rc = range_bound_value(self->lex, &v, spell, (int)sizeof spell);
    if (rc == 2)
        return tool::diag::ct_sem_error(line, col, "a range bound is out of range", self->mem->path);
    if (rc == 1) {
        snprintf(msg, sizeof msg, "a range bound must be an integer literal (got '%s')", spell);
        return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
    }
    self->sup->lex_next();
    *out = neg ? -v : v;
    return 0;
}

/* A numeric dimension as `parse_array_dims` normalises it: `[13]` -> 13.
   Anything else (`[]`, `[N]`, `[BASE + 1]`) is left to C. */
static int range_dim_value(const char *dims, long *out)
{
    long v = 0;
    int i = 1, nd = 0;

    if (dims[0] != '[') return 0;
    while (dims[i] >= '0' && dims[i] <= '9') {
        if (v > 1000000) return 0;
        v = v * 10 + (dims[i] - '0');
        i++;
        nd++;
    }
    if (!nd || dims[i] != ']') return 0;
    *out = v;
    return 1;
}

/* The element spelling used in the L24-6 message, without the storage class. */
static void range_element_spelling(const char *type, char *out, int cap)
{
    const char *p = type;
    for (;;) {
        if (strncmp(p, "static ", 7) == 0) p += 7;
        else if (strncmp(p, "const ", 6) == 0) p += 6;
        else if (strncmp(p, "extern ", 7) == 0) p += 7;
        else if (strncmp(p, "volatile ", 9) == 0) p += 9;
        else if (strncmp(p, "register ", 9) == 0) p += 9;
        else break;
    }
    snprintf(out, (size_t)cap, "%s", p);
}

/* Phase 24 D24-5: the element type has to be a scalar. Aggregates would need a
   per-element vptr or a boxed value, so a struct, a union, an interface value or
   an array element is refused before any node is built. A pointer to one of
   them is still a scalar. */
static int range_element_bad(struct Stmt *self, const char *type, const char *dims, char *why, int cap)
{
    char tr[MAX_TEXT];
    char tmp[MAX_TEXT];
    const char *first;
    int ip = 0;
    size_t n;

    first = strchr(dims, '[');
    if (first && strchr(first + 1, '[')) {
        range_element_spelling(type, why, cap);
        n = strlen(why);
        snprintf(why + n, (size_t)cap - n, "%s", first + 1);
        return 1;
    }
    if (self->sup->iface_ref_type(type, tr, (int)sizeof tr, &ip) && !ip) {
        range_element_spelling(type, why, cap);
        return 1;
    }
    snprintf(tmp, sizeof tmp, "%s", type);
    n = strlen(tmp);
    while (n > 0 && (tmp[n - 1] == ' ' || tmp[n - 1] == '\t')) n--;
    if (n > 0 && tmp[n - 1] == '*') return 0;
    if (strstr(type, "struct ") || strstr(type, "union ")) {
        range_element_spelling(type, why, cap);
        return 1;
    }
    return 0;
}

/* Phase 29 P29-1: `Vec<T>` as a declaration type. `type` is the C spelling the
   type parser produced (`struct Vec_int`), so the instance row already holds the
   element's C type and the encoded name. 0 when the spelling is not a by-value
   `Vec` instance: a pointer (`struct Vec_int *`) or a `Map` stays on the array
   path, and the caller keeps the frozen L24-5 text. The compiler reads the
   row's *type arguments*, never the container's layout (B29-3). */
static int range_vec_target(const char *type, char *elem, int ecap,
                            char *iname, int icap)
{
    const char *base;
    int ii;
    struct StructInst *ins;

    if (strncmp(type, "struct ", 7) != 0) return 0;
    base = type + 7;
    if (strpbrk(base, " *[(")) return 0;
    ins = frontend::sym::ct_insts(0);
    ii = frontend::sym::ct_inst_find(base);
    if (!ins || ii < 0) return 0;
    if (strcmp(ins[ii].tmpl, "Vec") != 0 || ins[ii].nargs != 1) return 0;
    snprintf(elem, (size_t)ecap, "%s", ins[ii].ctype[0]);
    snprintf(iname, (size_t)icap, "%s", ins[ii].name);
    return 1;
}

/* Phase 31 S14a: the row lookup for a by-value `Map`. Its constructor takes the
   nested `MapEntry` instance: `MapEntry_` plus the `Map_` suffix (P14). */
static int map_brace_target(const char *type, char *entry, int ecap, char *iname, int icap, char *ktype, int kcap, char *vtype, int vcap)
{
    const char *base;
    int ii;
    struct StructInst *ins;

    if (strncmp(type, "struct ", 7) != 0) return 0;
    base = type + 7;
    if (strpbrk(base, " *[(")) return 0;
    ins = frontend::sym::ct_insts(0);
    ii = frontend::sym::ct_inst_find(base);
    if (!ins || ii < 0) return 0;
    if (strcmp(ins[ii].tmpl, "Map") != 0 || ins[ii].nargs != 2) return 0;
    if (strncmp(ins[ii].name, "Map_", 4) != 0) return 0;
    snprintf(entry, (size_t)ecap, "struct MapEntry_%s", ins[ii].name + 4);
    snprintf(iname, (size_t)icap, "%s", ins[ii].name);
    snprintf(ktype, (size_t)kcap, "%s", ins[ii].ctype[0]);
    snprintf(vtype, (size_t)vcap, "%s", ins[ii].ctype[1]);
    return 1;
}

/* Phase 31 S11b: two C type spellings name the same type when they only differ
   in blanks. The instance row and the expression tables spell a pointer as
   `int *` in one place and `int*` in the other, so the comparison normalises
   whitespace instead of requiring one spelling. */
static int vbrace_type_same(const char *a, const char *b)
{
    char x[MAX_TEXT];
    char y[MAX_TEXT];
    int i = 0, j = 0;

    for (; *a && i < MAX_TEXT - 1; a++)
        if (*a != ' ' && *a != '\t') x[i++] = *a;
    x[i] = 0;
    for (; *b && j < MAX_TEXT - 1; b++)
        if (*b != ' ' && *b != '\t') y[j++] = *b;
    y[j] = 0;
    return strcmp(x, y) == 0;
}

/* Phase 31 S11a/S11b: a `Vec<T>` brace initializer (`Vec<int> v = {1, 2, 3};`).
   The cursor sits on `{` and the caller already resolved the instance, so `elem`
   is the element's C type and `iname` the encoded instance name -- the same pair
   the range form carries. Elements are ordinary expressions separated by commas
   (a trailing comma is allowed) and are chained through `next`, which keeps the
   node count proportional to the source and lets the emitter stream one
   composite literal into `Vec_<enc>_from`. Nothing is flattened into raw text,
   so MAX_TEXT cannot truncate the list. An empty list has no elements and
   lowers to `from(0, 0)`.

   S11b adds the four local boundaries: a nested brace list (L31-9), the 1024
   cap (L31-8), an element whose type cannot be pinned (L31-7) and an element
   that does not match the slot (L31-6). Each element is boxed first when the
   slot is an interface value, exactly like a `push` argument (S2), so owned and
   interface elements reach the same constructor. */
static int parse_vec_brace_init(struct Stmt *self, const char *elem, const char *iname)
{
    int e, head, tail, count, line, col;

    line = self->lex->tokline;
    col = self->lex->tokstart - self->lex->lstart + 1;
    head = -1;
    tail = -1;
    count = 0;
    self->sup->lex_next();              /* `{` */
    while (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
        int el, eline, ecol;
        char ety[MAX_TEXT];
        char tr[MAX_TEXT];
        int ip = 0;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a brace list cannot appear inside another brace initializer; build the inner container first",
                self->mem->path);
        if (count >= 1024)
            return tool::diag::ct_sem_error(line, col,
                "too many initializer elements (limit 1024)", self->mem->path);
        eline = self->lex->tokline;
        ecol = self->lex->tokstart - self->lex->lstart + 1;
        el = self->ex->parse_expr();
        if (el < 0) return -1;
        if (self->sup->iface_ref_type(elem, tr, sizeof tr, &ip)) {
            el = self->sup->maybe_box(el, tr, ip);
            if (el < 0) return -1;
        }
        if (self->sup->expr_ctype(el, ety, sizeof ety) != 0) {
            char msg[256];
            snprintf(msg, sizeof msg,
                     "cannot determine the type of initializer element %d", count + 1);
            return tool::diag::ct_sem_error(eline, ecol, msg, self->mem->path);
        }
        if (!vbrace_type_same(ety, elem)) {
            char msg[512];
            snprintf(msg, sizeof msg,
                     "initializer element %d has type '%s', expected '%s'",
                     count + 1, ety, elem);
            return tool::diag::ct_sem_error(eline, ecol, msg, self->mem->path);
        }
        if (head < 0) head = el;
        else self->arena->nodes[tail].next = el;
        tail = el;
        count++;
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0))
            break;
        self->sup->lex_next();
    }
    if (self->sup->expect("}") != 0) return -1;
    e = self->sup->new_node(N_INIT_BRACE);
    if (e < 0) return -1;
    self->arena->nodes[e].a = head;
    self->arena->nodes[e].aux = count;
    self->arena->nodes[e].line = line;
    snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", elem);
    snprintf(self->arena->nodes[e].text2, MAX_TEXT, "%s", iname);
    return e;
}

/* Phase 31 S16a: fold an integer constant expression for duplicate-key
   detection (D31-14). Only the operators the card lists are folded and only
   while every intermediate value stays inside the guard range, so overflow
   gives up instead of judging. */
static int map_fold_num(struct Stmt *self, int n, long *out)
{
    struct Node *nd;
    long a, b;

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    if (nd->kind == N_NUM) {
        *out = nd->num;
        return 1;
    }
    if (nd->kind == N_UNARY) {
        if (!map_fold_num(self, nd->a, &a)) return 0;
        if (nd->aux == 1) { *out = -a; return 1; }
        if (nd->aux == 2) { *out = !a; return 1; }
        if (nd->aux == 3) { *out = ~a; return 1; }
        return 0;
    }
    if (nd->kind != N_BIN) return 0;
    if (!map_fold_num(self, nd->a, &a) || !map_fold_num(self, nd->b, &b)) return 0;
    if (a < -1099511627776L || a > 1099511627776L) return 0;   /* 2^40 */
    if (b < -1099511627776L || b > 1099511627776L) return 0;
    switch (nd->aux) {
    case B_ADD: *out = a + b; break;
    case B_SUB: *out = a - b; break;
    case B_MUL:
        if (a < -2147483647L || a > 2147483647L) return 0;
        if (b < -2147483647L || b > 2147483647L) return 0;
        *out = a * b;
        break;
    case B_DIV: if (b == 0) return 0; *out = a / b; break;
    case B_MOD: if (b == 0) return 0; *out = a % b; break;
    case B_SHL:
        if (b < 0 || b > 20) return 0;
        if (a < -524288L || a > 524288L) return 0;
        *out = a << b;
        break;
    case B_SHR:
        if (b < 0 || b > 40) return 0;
        *out = a >> b;
        break;
    case B_BAND: *out = a & b; break;
    case B_BOR: *out = a | b; break;
    case B_XOR: *out = a ^ b; break;
    default: return 0;
    }
    return 1;
}

/* Phase 31 S16a: decode a string literal node into its bytes. Adjacent
   literals are already joined in the row and each keeps its quotes, so the
   scan walks every quoted segment and normalises escapes. The result stops at
   the first NUL, matching the runtime `strcmp` the constructor uses. */
static int map_decode_str(struct Stmt *self, int n, char *out, int cap)
{
    const char *s;
    int i = 0, o = 0;

    if (n < 0 || cap < 1) return 0;
    if (self->arena->nodes[n].kind != N_STR) return 0;
    s = self->arena->str_at(self->arena->nodes[n].num);
    out[0] = 0;
    while (s[i]) {
        int c;
        if (s[i] != '"') { i++; continue; }
        i++;
        while (s[i] && s[i] != '"') {
            c = (unsigned char)s[i];
            if (c == '\\') {
                i++;
                if (!s[i]) return 0;
                c = (unsigned char)s[i];
                if (c == 'n') c = '\n';
                else if (c == 't') c = '\t';
                else if (c == 'r') c = '\r';
                else if (c == 'a') c = 7;
                else if (c == 'b') c = 8;
                else if (c == 'f') c = 12;
                else if (c == 'v') c = 11;
                else if (c == 'x') {
                    int hv = 0, nd = 0;
                    i++;
                    while (1) {
                        int d = (unsigned char)s[i];
                        if (d >= '0' && d <= '9') d = d - '0';
                        else if (d >= 'a' && d <= 'f') d = d - 'a' + 10;
                        else if (d >= 'A' && d <= 'F') d = d - 'A' + 10;
                        else break;
                        hv = (hv * 16 + d) & 255;
                        nd++;
                        i++;
                    }
                    if (!nd) return 0;
                    c = hv;
                    i--;
                } else if (c >= '0' && c <= '7') {
                    int ov = 0, nd = 0;
                    while (nd < 3 && s[i] >= '0' && s[i] <= '7') {
                        ov = ov * 8 + (s[i] - '0');
                        nd++;
                        i++;
                    }
                    c = ov & 255;
                    i--;
                }
                i++;
            } else {
                i++;
            }
            if (c == 0) return 1;          /* strcmp stops at the first NUL */
            if (o < cap - 1) out[o++] = (char)c;
        }
    }
    out[o] = 0;
    return 1;
}

/* Phase 31 S16a/S16b: 1 when key `n` repeats one of the first `count` keys by a
   statically determinable value. `disp` receives the key's spelling (decimal
   for an integer, decoded bytes for a string, the cname for an enum member) and
   `*first` the line of the first occurrence. A key that cannot be folded is not
   judged here; the constructor's inline insert overwrites it at runtime. */
static int map_dup_key(struct Stmt *self, int *keys, int count, int n, char *disp, int *first)
{
    long nv = 0, pv;
    char sbuf[MAX_TEXT];
    int j, kind = 0;

    if (self->arena->nodes[n].kind == N_STR) {
        if (!map_decode_str(self, n, sbuf, (int)sizeof sbuf)) return 0;
        kind = 2;
    } else if (self->arena->nodes[n].kind == N_VAR
               && self->sym->is_const_name(self->arena->nodes[n].text2)) {
        char cn[MAX_TEXT];
        if (self->sym->var_cname(self->arena->nodes[n].text2, cn, sizeof cn) != 0)
            return 0;
        snprintf(sbuf, (size_t)MAX_TEXT, "%s", cn);
        kind = 3;
    } else if (map_fold_num(self, n, &nv)) {
        kind = 1;
    }
    if (kind == 0) return 0;
    if (kind == 1) snprintf(disp, (size_t)MAX_TEXT, "%ld", nv);
    else snprintf(disp, (size_t)MAX_TEXT, "%s", sbuf);
    for (j = 0; j < count; j++) {
        if (kind == 1) {
            if (map_fold_num(self, keys[j], &pv) && pv == nv) {
                *first = self->arena->nodes[keys[j]].line;
                return 1;
            }
        } else if (kind == 2) {
            char pb[MAX_TEXT];
            if (map_decode_str(self, keys[j], pb, (int)sizeof pb)
                && strcmp(pb, sbuf) == 0) {
                *first = self->arena->nodes[keys[j]].line;
                return 1;
            }
        } else {
            char pb[MAX_TEXT];
            if (self->arena->nodes[keys[j]].kind == N_VAR
                && self->sym->var_cname(self->arena->nodes[keys[j]].text2, pb, sizeof pb) == 0
                && strcmp(pb, sbuf) == 0) {
                *first = self->arena->nodes[keys[j]].line;
                return 1;
            }
        }
    }
    return 0;
}

/* Phase 31 S14a/S16a: a `Map` brace initializer (`Map<char *, int> m = {"a": 1};`).
   The cursor sits on `{`; `entry` is the nested `MapEntry` struct spelling and
   `iname` the encoded `Map` name. Each `key : value` is parsed from ordinary
   expressions into one node, so the emitter streams a composite literal and the
   node count follows the source. Trailing comma allowed; empty is `(0, 0)`.
   A nested brace list in either position is the shared L31-9 refusal; type
   checks, the cap and duplicate detection are layered on later slices. */
static int parse_map_brace_init(struct Stmt *self, const char *entry, const char *iname, const char *ktype, const char *vtype)
{
    int e, head, tail, count, line, col;
    int keys[1024];

    line = self->lex->tokline;
    col = self->lex->tokstart - self->lex->lstart + 1;
    head = -1;
    tail = -1;
    count = 0;
    self->sup->lex_next();              /* `{` */
    while (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
        int it, k, v, kline, kcol, vline, vcol;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a brace list cannot appear inside another brace initializer; build the inner container first",
                self->mem->path);
        if (count >= 1024)
            return tool::diag::ct_sem_error(line, col,
                "too many initializer items (limit 1024)", self->mem->path);
        kline = self->lex->tokline;
        kcol = self->lex->tokstart - self->lex->lstart + 1;
        k = self->ex->parse_expr();
        if (k < 0) return -1;
        {
            char kty[MAX_TEXT];
            if (self->sup->expr_ctype(k, kty, sizeof kty) == 0
                && self->ex->brace_arg_ok(ktype, kty) == 1) {
                char msg[512];
                snprintf(msg, sizeof msg,
                         "initializer item %d has key type '%s', expected '%s'",
                         count + 1, kty, ktype);
                return tool::diag::ct_sem_error(kline, kcol, msg, self->mem->path);
            }
        }
        /* S16a: a repeat the compiler can prove is a hard error at the second
           key; a key it cannot fold is left to the runtime insert (D31-14). */
        {
            char dupdisp[MAX_TEXT];
            int firstline = 0;
            if (map_dup_key(self, keys, count, k, dupdisp, &firstline)) {
                char msg[256];
                snprintf(msg, sizeof msg,
                         "duplicate key '%s' in a Map initializer (first at line %d)",
                         dupdisp, firstline);
                return tool::diag::ct_sem_error(kline, kcol, msg, self->mem->path);
            }
        }
        if (count < 1024) keys[count] = k;
        if (self->sup->expect(":") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a brace list cannot appear inside another brace initializer; build the inner container first",
                self->mem->path);
        vline = self->lex->tokline;
        vcol = self->lex->tokstart - self->lex->lstart + 1;
        v = self->ex->parse_expr();
        if (v < 0) return -1;
        {
            char tr[MAX_TEXT];
            char vty[MAX_TEXT];
            int ip = 0;
            if (self->sup->iface_ref_type(vtype, tr, sizeof tr, &ip)) {
                v = self->sup->maybe_box(v, tr, ip);
                if (v < 0) return -1;
            }
            if (self->sup->expr_ctype(v, vty, sizeof vty) == 0
                && self->ex->brace_arg_ok(vtype, vty) == 1) {
                char msg[512];
                snprintf(msg, sizeof msg,
                         "initializer item %d has value type '%s', expected '%s'",
                         count + 1, vty, vtype);
                return tool::diag::ct_sem_error(vline, vcol, msg, self->mem->path);
            }
        }
        it = self->sup->new_node(N_INIT_ITEM);
        if (it < 0) return -1;
        self->arena->nodes[it].a = k;
        self->arena->nodes[it].b = v;
        if (head < 0) head = it;
        else self->arena->nodes[tail].next = it;
        tail = it;
        count++;
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0))
            break;
        self->sup->lex_next();
    }
    if (self->sup->expect("}") != 0) return -1;
    e = self->sup->new_node(N_INIT_MBRACE);
    if (e < 0) return -1;
    self->arena->nodes[e].a = head;
    self->arena->nodes[e].aux = count;
    self->arena->nodes[e].line = line;
    snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", entry);
    snprintf(self->arena->nodes[e].text2, MAX_TEXT, "%s", iname);
    return e;
}

/* `loop` and `foreach` are not in `kw[]` (D22-4, D27-1), so only a following
   `(` promotes the spelling to a statement: a label, an expression reference or
   `goto loop;` keeps the ordinary identifier meaning. The save/restore mirrors
   `label_ahead` because the lexer has no peek. */
static int kw_paren_ahead(struct Stmt *self, const char *kw)
{
    int sp, sbol, stok, sline, stokline, sstart, slstart, r;
    long snum;
    char stext[MAX_TEXT];

    if (self->lex->tok != T_ID) return 0;
    if (strcmp(self->lex->toktext, kw) != 0) return 0;
    sp = self->lex->pos;
    sbol = self->lex->bol;
    stok = self->lex->tok;
    snum = self->lex->toknum;
    sline = self->lex->line;
    stokline = self->lex->tokline;
    sstart = self->lex->tokstart;
    slstart = self->lex->lstart;
    snprintf(stext, sizeof stext, "%s", self->lex->toktext);
    self->sup->lex_next();
    r = 0;
    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) r = 1;
    self->lex->pos = sp;
    self->lex->bol = sbol;
    self->lex->tok = stok;
    self->lex->toknum = snum;
    self->lex->line = sline;
    self->lex->tokline = stokline;
    self->lex->tokstart = sstart;
    self->lex->lstart = slstart;
    snprintf(self->lex->toktext, MAX_TEXT, "%s", stext);
    return r;
}

impl StmtOps for Stmt {
    /* Phase 38: `defer` is only the keyword when the next non-space source
       character is `{`; otherwise it stays an ordinary identifier (D38-7). */
    int defer_ahead(void)
    {
        const char *p;
        (void)self;
        if (self->lex->tok != T_ID) return 0;
        if (strcmp(self->lex->toktext, "defer") != 0) return 0;
        p = self->lex->src + self->lex->tokstart + 5;
        while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
        return *p == '{';
    }

    /* Phase 40 R1: `err:` is a marker only directly after return/break/
       continue. Looking at the raw source avoids consuming `err`, which must
       stay an ordinary identifier everywhere else. */
    int err_ahead(void)
    {
        const char *p;
        (void)self;
        if (self->lex->tok != T_ID) return 0;
        if (strcmp(self->lex->toktext, "err") != 0) return 0;
        p = self->lex->src + self->lex->tokstart + 3;
        while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
        return *p == ':' && p[1] != ':';
    }

    /* Phase 40 R2: `errdefer` is a keyword only when followed by `{`; the
       same D38-7 boundary as defer keeps it an ordinary identifier otherwise. */
    int errdefer_ahead(void)
    {
        const char *p;
        (void)self;
        if (self->lex->tok != T_ID) return 0;
        if (strcmp(self->lex->toktext, "errdefer") != 0) return 0;
        p = self->lex->src + self->lex->tokstart + 8;
        while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
        return *p == '{';
    }

    /* Phase 40 R4: an `own` object must not be rolled back by errdefer; the
       cleanup chain already owns its release. Names are matched against the
       active own list; aliasing remains an accepted limitation. */
    int errdefer_own_refs(int n)
    {
        int d;
        for (; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[n].text2);
                for (d = 0; vi >= 0 && d < self->mem->nowner; d++)
                    if (self->mem->own_var[d] == vi)
                        return tool::diag::ct_sem_error(self->arena->nodes[n].line, 1,
                            "an own object cannot be rolled back by errdefer",
                            self->mem->path);
            }
            if (self->errdefer_own_refs(self->arena->nodes[n].a) != 0) return -1;
            if (self->errdefer_own_refs(self->arena->nodes[n].b) != 0) return -1;
            if (self->errdefer_own_refs(self->arena->nodes[n].c) != 0) return -1;
            if (self->errdefer_own_refs(self->arena->nodes[n].d) != 0) return -1;
        }
        return 0;
    }

    /* Phase 40 R5: rewrite `$` to the declared name inside a trailing block;
       an assignment to `$` is rejected before the rewrite. */
    int trailing_alias(int n, const char *name)
    {
        for (; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_VAR
                && strcmp(self->arena->nodes[n].text2, "$") == 0
                && strcmp(self->arena->nodes[n].text3, "range") != 0) {
                snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", name);
            }
            if (self->arena->nodes[n].kind == N_DECL
                && strcmp(self->arena->nodes[n].text2, name) == 0)
                return tool::diag::ct_sem_error(self->arena->nodes[n].line, 1,
                    "a trailing block cannot shadow the '$' name", self->mem->path);
            if (self->arena->nodes[n].kind == N_ASSIGN
                && self->arena->nodes[n].a >= 0
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR
                && strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "$") == 0)
                return tool::diag::ct_sem_error(self->arena->nodes[n].line, 1,
                    "'$' is read-only and only valid in the trailing block",
                    self->mem->path);
            if (self->trailing_alias(self->arena->nodes[n].a, name) != 0) return -1;
            if (self->trailing_alias(self->arena->nodes[n].b, name) != 0) return -1;
            if (self->trailing_alias(self->arena->nodes[n].c, name) != 0) return -1;
            if (self->trailing_alias(self->arena->nodes[n].d, name) != 0) return -1;
        }
        return 0;
    }

    /* Phase 40 R5: `Type name = expr defer/errdefer { … };`. The block is
       registered after the declaration initialiser, so it sees the variable. */
    int parse_trailing_defer(int decl)
    {
        int d, body, is_err, save_defer, save_err;
        is_err = self->errdefer_ahead();
        if (!is_err && !self->defer_ahead()) return 0;
        if (self->in_defer || self->in_errdefer)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                is_err ? "an errdefer block cannot transfer control"
                       : "a defer block cannot transfer control", self->mem->path);
        if (self->switch_depth > 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                is_err ? "errdefer is not allowed here"
                       : "defer is not allowed inside a switch", self->mem->path);
        {
            size_t pl = strlen(self->mem->path);
            if (pl >= 5 && strcmp(self->mem->path + pl - 5, ".h.ct") == 0)
                return tool::diag::ct_sem_error(self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1,
                    is_err ? "errdefer is not allowed here"
                           : "defer is not allowed in a .h.ct unit", self->mem->path);
        }
        if (self->arena->nodes[decl].kind == N_DECLS)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a trailing defer needs a single declaration", self->mem->path);
        d = self->sup->new_node(N_DEFER);
        if (d < 0) return -1;
        self->arena->nodes[d].line = self->lex->tokline;
        self->arena->nodes[d].aux = is_err ? 1 : 0;
        self->sup->lex_next();
        {
            int save_dollar = self->ex->dollar_ok;
            save_defer = self->in_defer;
            save_err = self->in_errdefer;
            self->in_defer = 1;
            self->in_errdefer = is_err;
            self->ex->dollar_ok = 1;
            body = self->parse_block();
            self->ex->dollar_ok = save_dollar;
            self->in_defer = save_defer;
            self->in_errdefer = save_err;
        }
        if (body < 0) return -1;
        if (self->trailing_alias(body, self->arena->nodes[decl].text2) != 0) return -1;
        if (is_err && self->errdefer_own_refs(body) != 0) return -1;
        self->arena->nodes[d].a = body;
        if (self->defer_add(d) != 0) return -1;
        if (is_err) self->defer_block_err[self->ndefer_blocks - 1] = 1;
        return 0;
    }

    int defer_active_depth(void)
    {
        int i, n;
        (void)self;
        n = 0;
        for (i = 0; i < self->ndefer_blocks; i++)
            if (self->defer_head[i] >= 0) n++;
        return n;
    }

    int defer_mark_block(void)
    {
        int b, i, j, id;
        (void)self;
        b = self->ndefer_blocks - 1;
        if (b < 0 || self->defer_head[b] < 0) return 0;
        id = self->defer_ids[b];
        for (i = 0; i < self->nlabels; i++)
            for (j = 0; j < self->label_path_depth[i]; j++)
                if (self->label_path[i][j] == id) self->label_path_has[i][j] = 1;
        for (i = 0; i < self->ngotos; i++)
            for (j = 0; j < self->goto_path_depth[i]; j++)
                if (self->goto_path[i][j] == id) self->goto_path_has[i][j] = 1;
        return 0;
    }

    int defer_add(int node)
    {
        int b, t;
        (void)self;
        b = self->ndefer_blocks - 1;
        if (b < 0) return -1;
        t = self->defer_tail[b];
        if (t < 0) self->defer_head[b] = node;
        else self->arena->nodes[t].next = node;
        self->defer_tail[b] = node;
        self->arena->nodes[node].next = -1;
        return 0;
    }

    int defer_run_node(int body, int line)
    {
        int r;
        (void)self;
        r = self->sup->new_node(N_DEFER_RUN);
        if (r < 0) return -1;
        self->arena->nodes[r].a = body;
        self->arena->nodes[r].line = line;
        return r;
    }

    int defer_prepend(int node, int base, int on_error)
    {
        int i, k, n, head, tail, ids[256];
        (void)self;
        head = -1;
        tail = -1;
        for (i = self->ndefer_blocks - 1; i >= base; i--) {
            n = 0;
            for (k = self->defer_head[i]; k >= 0; k = self->arena->nodes[k].next) {
                if (!on_error && self->arena->nodes[k].aux == 1) continue;
                if (n >= 256) return -1;
                ids[n] = k;
                n++;
            }
            for (k = n - 1; k >= 0; k--) {
                int r = self->defer_run_node(self->arena->nodes[ids[k]].a,
                                             self->arena->nodes[ids[k]].line);
                if (r < 0) return -1;
                if (head < 0) head = r;
                else self->arena->nodes[tail].next = r;
                tail = r;
            }
        }
        if (head >= 0) {
            self->arena->nodes[tail].next = self->arena->nodes[node].b;
            self->arena->nodes[node].b = head;
        }
        return 0;
    }

    int defer_flush_block(int blk, int *tail)
    {
        int i, k, n, ids[256];
        (void)self;
        i = self->ndefer_blocks - 1;
        if (i < 0) return 0;
        n = 0;
        for (k = self->defer_head[i]; k >= 0; k = self->arena->nodes[k].next) {
            if (self->arena->nodes[k].aux == 1) continue;
            if (n >= 256) return -1;
            ids[n] = k;
            n++;
        }
        for (k = n - 1; k >= 0; k--) {
            int r = self->defer_run_node(self->arena->nodes[ids[k]].a,
                                         self->arena->nodes[ids[k]].line);
            if (r < 0) return -1;
            if (*tail < 0) self->arena->nodes[blk].a = r;
            else self->arena->nodes[*tail].next = r;
            *tail = r;
        }
        return 0;
    }

    /* Does the current token start a declaration? A short name has to be
       resolved first: the type table only holds the mangled spelling, so
       `Arena *p` would otherwise look like an expression statement. */
    int is_decl_start(void)
    {
        char rn[MAX_TEXT];
        char save_text[MAX_TEXT];
        int save_tok, save_float, save_line, save_tokline, save_start;
        int save_lstart, save_bol, save_pos, look, i;
        long save_num;
        /* Statement keywords that may be followed by a name (`return found;`,
           `goto done;`, `own Box *b`). None of them can be a type, so they must
           not enter the unknown-type fallback below. */
        static const char *kw[] = {
            "borrow", "break", "case", "continue", "default", "delete", "do",
            "else", "extern", "for", "goto", "if", "impl", "import", "inline",
            "map", "namespace", "own", "pub", "return", "sizeof", "static",
            "switch", "trait", "typedef", "while", NULL
        };
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        /* an alignment or atomic specifier may open a block-scope declaration */
        if (strcmp(self->lex->toktext, "_Alignas") == 0) return 1;
        if (strcmp(self->lex->toktext, "_Atomic") == 0) return 1;
        if (strcmp(self->lex->toktext, "atomic") == 0) {
            /* Phase 41: `atomic` is contextual. Peek one token; a supported
               or unsupported type word makes this a declaration so parse_type
               can emit L41-1. `atomic;` / `atomic = 1` stay expressions. */
            save_tok = self->lex->tok;
            save_num = self->lex->toknum;
            save_float = self->lex->tokfloat;
            save_line = self->lex->line;
            save_tokline = self->lex->tokline;
            save_start = self->lex->tokstart;
            save_lstart = self->lex->lstart;
            save_bol = self->lex->bol;
            save_pos = self->lex->pos;
            snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
            self->sup->lex_next();
            look = self->lex->tok == T_ID
                   && (self->ex->is_type_word(self->lex->toktext)
                       || strcmp(self->lex->toktext, "_Atomic") == 0
                       || strcmp(self->lex->toktext, "own") == 0);
            self->lex->tok = save_tok;
            self->lex->toknum = save_num;
            self->lex->tokfloat = save_float;
            self->lex->line = save_line;
            self->lex->tokline = save_tokline;
            self->lex->tokstart = save_start;
            self->lex->lstart = save_lstart;
            self->lex->bol = save_bol;
            self->lex->pos = save_pos;
            snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
            return look;
        }
        if (self->ex->is_type_word(self->lex->toktext)) return 1;
        if (self->sup->resolve_type(self->lex->toktext, rn, sizeof rn) != 0) return 0;
        if (self->sym->find_type(rn) >= 0) return 1;
        for (i = 0; kw[i]; i++)
            if (strcmp(self->lex->toktext, kw[i]) == 0) return 0;
        /* A type name this unit never saw -- a typedef from a header, such as
           `time_t`. It is a type rather than an operand when the next token is
           the declarator's name, directly (`time_t now`) or behind some stars
           (`time_t *t`); a name that already resolves to a variable or a
           function is an operand, which keeps `a * b;` an expression. */
        if (self->sym->find_var(self->lex->toktext) >= 0) return 0;
        if (self->sym->find_func(self->lex->toktext) >= 0) return 0;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_float = self->lex->tokfloat;
        save_line = self->lex->line;
        save_tokline = self->lex->tokline;
        save_start = self->lex->tokstart;
        save_lstart = self->lex->lstart;
        save_bol = self->lex->bol;
        save_pos = self->lex->pos;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->sup->lex_next();
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0)
            self->sup->lex_next();
        look = (self->lex->tok == T_ID);
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokfloat = save_float;
        self->lex->line = save_line;
        self->lex->tokline = save_tokline;
        self->lex->tokstart = save_start;
        self->lex->lstart = save_lstart;
        self->lex->bol = save_bol;
        self->lex->pos = save_pos;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return look;
    }

    int parse_block(void)
    {
        int blk, tail, s, base;
        (void)self;

        if (self->sup->expect("{") != 0) return -1;
        if (self->sup->push_scope() != 0) return -1;
        if (self->ndefer_blocks >= 256) {
            self->sup->pop_scope();
            return self->sup->fail("blocks are nested too deeply");
        }
        self->defer_head[self->ndefer_blocks] = -1;
        self->defer_tail[self->ndefer_blocks] = -1;
        self->defer_block_err[self->ndefer_blocks] = 0;
        self->ndefer_next_id = self->ndefer_next_id + 1;
        self->defer_ids[self->ndefer_blocks] = self->ndefer_next_id;
        self->ndefer_blocks = self->ndefer_blocks + 1;
        base = self->mem->own_base[self->sym->nscope - 1];
        blk = self->sup->new_node(N_BLOCK);
        if (blk < 0) {
            self->sup->pop_scope();
            return -1;
        }
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            s = self->parse_stmt();
            if (s < 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (tail < 0) self->arena->nodes[blk].a = s;
            else self->arena->nodes[tail].next = s;
            tail = s;
        }
        /* Phase 38: a block's defers run (reverse source order) before its
           implicit `own` releases; both groups keep their own LIFO order. */
        if (self->defer_flush_block(blk, &tail) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* AutoDrop: append `delete v;` for this scope's `own` declarations, in
           reverse order, just before the closing brace (L2's line rewrite does
           the same). A brace that shares its line with code cannot host the
           deletes, so that layout is rejected. */
        if (self->mem->nowner > base) {
            int p, at_start;
            at_start = 1;
            for (p = self->lex->lstart; p < self->lex->tokstart; p++)
                if (self->lex->src[p] != ' ' && self->lex->src[p] != '\t' && self->lex->src[p] != '\r') at_start = 0;
            if (!at_start) {
                self->sup->pop_scope();
                return tool::diag::ct_sem_error(self->lex->tokline, 1,
                    "auto-drop requires the closing '}' at the start of a line", self->mem->path);
            }
            if (autodrop_append(self, blk, base, &tail) != 0) {
                self->sup->pop_scope();
                return -1;
            }
        }
        if (self->sup->expect("}") != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* a scope that closes with a still-owned heap object leaks it (L2
           reports it at the same point, keeping the warning order) */
        if (self->mem->leak_active && self->sup->leak_scope(self->sym->scope[self->sym->nscope - 1], self->sym->nvar) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sup->pop_scope();
        (void)self->defer_mark_block();
        self->ndefer_blocks = self->ndefer_blocks - 1;
        return blk;
    }

    int parse_stmt(void)
    {
        int s, e, c;
        (void)self;

        /* `_Static_assert(<constant>, "<message>");` -- C11, emitted as written.
           `static_assert` is the same construct under its C23 / `<assert.h>`
           spelling, and the emitter always writes the `_Static_assert` form.
           The condition follows the same constant rule as a case label, so a
           mistake is reported here instead of by the C compiler. It is accepted
           at file scope too: `top_decl` routes the keyword back into this
           branch, which keeps the construct in one place. */
        if (self->lex->tok == T_ID
            && (strcmp(self->lex->toktext, "_Static_assert") == 0
                || strcmp(self->lex->toktext, "static_assert") == 0)) {
            int cnd;
            s = self->sup->new_node(N_SASSERT);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            cnd = self->ex->parse_expr();
            if (cnd < 0) return -1;
            if (!self->ex->const_ok(cnd))
                return self->sup->fail("a static assertion needs a constant condition");
            self->arena->nodes[s].a = cnd;
            if (self->sup->accept(",")) {
                if (self->lex->tok != T_STR)
                    return self->sup->fail("a static assertion message must be a string literal");
                snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s", self->lex->toktext);
                self->sup->lex_next();
            }
            if (self->sup->expect(")") != 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            return s;
        }
        /* Phase 40 R2: errdefer is a conditional defer. It shares the single
           block stack; the on_error marker is on the N_DEFER node. */
        if (self->errdefer_ahead()) {
            int eline = self->lex->tokline;
            int ecol = self->lex->tokstart - self->lex->lstart + 1;
            int body;
            if (self->in_defer || self->in_errdefer)
                return tool::diag::ct_sem_error(eline, ecol,
                    "an errdefer block cannot transfer control", self->mem->path);
            if (self->switch_depth > 0)
                return tool::diag::ct_sem_error(eline, ecol,
                    "errdefer is not allowed here", self->mem->path);
            {
                size_t pl = strlen(self->mem->path);
                if (pl >= 5 && strcmp(self->mem->path + pl - 5, ".h.ct") == 0)
                    return tool::diag::ct_sem_error(eline, ecol,
                        "errdefer is not allowed here", self->mem->path);
            }
            if (self->ndefer_blocks == 0)
                return tool::diag::ct_sem_error(eline, ecol,
                    "errdefer is not allowed here", self->mem->path);
            s = self->sup->new_node(N_DEFER);
            if (s < 0) return -1;
            self->arena->nodes[s].line = eline;
            self->arena->nodes[s].aux = 1;   /* on_error */
            self->sup->lex_next();
            self->in_defer = 1;
            self->in_errdefer = 1;
            body = self->parse_block();
            self->in_defer = 0;
            self->in_errdefer = 0;
            if (body < 0) return -1;
            if (self->errdefer_own_refs(body) != 0) return -1;
            self->arena->nodes[s].a = body;
            if (self->defer_add(s) != 0) return -1;
            self->defer_block_err[self->ndefer_blocks - 1] = 1;
            s = self->sup->new_node(N_EMPTY);
            if (s < 0) return -1;
            return s;
        }
        /* Phase 38: `defer { … }` at statement position. The body is parsed as
           an ordinary block; a nested defer or a control transfer inside it is
           rejected here, before any code is emitted. */
        if (self->defer_ahead()) {
            int dline = self->lex->tokline;
            int dcol = self->lex->tokstart - self->lex->lstart + 1;
            int body;
            if (self->in_errdefer)
                return tool::diag::ct_sem_error(dline, dcol,
                    "an errdefer block cannot transfer control", self->mem->path);
            if (self->in_defer)
                return tool::diag::ct_sem_error(dline, dcol,
                    "a defer block cannot transfer control", self->mem->path);
            if (self->switch_depth > 0)
                return tool::diag::ct_sem_error(dline, dcol,
                    "defer is not allowed inside a switch", self->mem->path);
            {
                size_t pl = strlen(self->mem->path);
                if (pl >= 5 && strcmp(self->mem->path + pl - 5, ".h.ct") == 0)
                    return tool::diag::ct_sem_error(dline, dcol,
                        "defer is not allowed in a .h.ct unit", self->mem->path);
            }
            if (self->ndefer_blocks == 0)
                return tool::diag::ct_sem_error(dline, dcol,
                    "defer is only allowed inside a function", self->mem->path);
            s = self->sup->new_node(N_DEFER);
            if (s < 0) return -1;
            self->arena->nodes[s].line = dline;
            self->sup->lex_next();
            self->in_defer = 1;
            body = self->parse_block();
            self->in_defer = 0;
            if (body < 0) return -1;
            self->arena->nodes[s].a = body;
            if (self->defer_add(s) != 0) return -1;
            /* the deferred body runs at an exit, never in sequence */
            s = self->sup->new_node(N_EMPTY);
            if (s < 0) return -1;
            return s;
        }
        /* `;` is a statement of its own (C's empty statement): it keeps
           `for (...) ;` and `case 1: ;` on the ordinary path and emits nothing */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "$") == 0
            && !self->ex->dollar_ok && self->ex->into_node < 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "'$' is read-only and only valid in the trailing block",
                self->mem->path);
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
            self->sup->lex_next();
            s = self->sup->new_node(N_EMPTY);
            if (s < 0) return -1;
            return s;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) return self->parse_block();
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "return") == 0) {
            int rline = self->lex->tokline, rcol = self->lex->tokstart - self->lex->lstart + 1, at_start = 1, rp, cond;
            int eline = 0, ecol = 0, is_err = 0;
            if (self->in_errdefer)
                return tool::diag::ct_sem_error(rline, rcol,
                    "an errdefer block cannot transfer control", self->mem->path);
            if (self->in_defer)
                return tool::diag::ct_sem_error(rline, rcol,
                    "a defer block cannot transfer control", self->mem->path);
            for (rp = self->lex->lstart; rp < self->lex->tokstart; rp++)
                if (self->lex->src[rp] != ' ' && self->lex->src[rp] != '\t' && self->lex->src[rp] != '\r') at_start = 0;
            /* a return nested in a block (or written mid-line) may be skipped
               at run time, so it only warns about what it leaves behind */
            cond = !at_start || self->sym->nscope > self->mem->leak_frame;
            s = self->sup->new_node(N_RET);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->err_ahead()) {
                is_err = 1;
                snprintf(self->arena->nodes[s].text2, MAX_TEXT, "err");
                self->sup->lex_next();
                if (self->sup->expect(":")) return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->sup->lex_next();
                if (is_err && self->sym->ret_type[0]
                    && strcmp(self->sym->ret_type, "void") != 0)
                    return tool::diag::ct_sem_error(rline, rcol,
                        "an error return needs a value", self->mem->path);
                /* Phase 32 S5 (L32-4): a value-returning function may not
                   `return;`. The position is the `return` keyword. */
                if (self->ex->types_mode && *self->ex->types_mode
                    && self->sym->ret_type[0]
                    && strcmp(self->sym->ret_type, "void") != 0) {
                    char msg[MAX_TEXT];
                    snprintf(msg, sizeof msg,
                             "return: missing a value (function returns '%s')",
                             self->sym->ret_type);
                    if (tool::diag::ct_type_warn(rline, rcol, "", msg,
                                                 self->sup->mem->path) != 0)
                        return -1;
                }
                /* a bare `return;` leaves every owned object behind */
                if (self->mem->leak_active && borrow_escape(self, -1, rline) != 0)
                    return -1;
                if (self->mem->leak_active && self->sup->leak_return(-1, cond, rline) != 0)
                    return -1;
                if (self->mem->leak_active) {
                    s = retire_before_return(self, s, !cond);
                    if (s < 0) return -1;
                }
                if (self->defer_active_depth() > 0
                    && self->defer_prepend(s, 0, is_err) != 0) return -1;
                if (is_err) snprintf(self->arena->nodes[s].text2, MAX_TEXT, "err");
                return s;
            }
            if (is_err && self->sym->ret_type[0]
                && strcmp(self->sym->ret_type, "void") == 0)
                return tool::diag::ct_sem_error(rline, rcol,
                    "a void function cannot return a value", self->mem->path);
            self->ex->into_ok = 1;
            eline = self->lex->tokline;
            ecol = self->lex->tokstart - self->lex->lstart + 1;
            e = self->ex->parse_expr();
            self->ex->into_ok = 0;
            if (e < 0) return -1;
            /* Phase 32 S5 (L32-3/L32-5): the returned expression against the
               function's return type. A void function may not return a value,
               and the judged value is compared through the shared kernel. */
            if (self->ex->types_mode && *self->ex->types_mode
                && self->sym->ret_type[0]) {
                if (strcmp(self->sym->ret_type, "void") == 0) {
                    char msg[MAX_TEXT];
                    snprintf(msg, sizeof msg,
                             "return: a value is not allowed in a void function");
                    if (tool::diag::ct_type_warn(eline, ecol, "", msg,
                                                 self->sup->mem->path) != 0)
                        return -1;
                } else {
                    char out[MAX_TEXT];
                    int is_zero = 0;
                    if (self->ex->chk_type(e, out, sizeof out, &is_zero) == 0) {
                        self->ex->chk_line = eline;
                        self->ex->chk_col = ecol;
                        self->ex->chk_arg = 0;
                        if (self->ex->chk_assignable(self->sym->ret_type, out,
                                                     is_zero, 3) != 0)
                            return -1;
                    }
                }
            }
            /* E1: the environment lives in this frame, so handing the binding
               back loses it. Checked before the memory analysis so the closure
               diagnostic is the one the user sees. */
            if (closure_is_returned(self, e))
                return closure_error(self, self->arena->nodes[e].line, rcol,
                                     "a closure cannot escape through 'return'");
            {
                char tr[MAX_TEXT];
                int ip = 0;
                if (self->sup->iface_ref_type(self->sym->ret_type, tr, sizeof tr, &ip)) {
                    e = self->sup->maybe_box(e, tr, ip);
                    if (e < 0) return -1;
                }
            }
            self->arena->nodes[s].a = e;
            if (self->mem->leak_active && borrow_escape(self, e, rline) != 0)
                return -1;
            if (self->mem->leak_active && self->sup->leak_return(e, cond, rline) != 0)
                return -1;
            if (self->mem->leak_active && return_reads_autodrop(self, e)) {
                self->arena->nodes[s].aux = 1;
                snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s", self->sym->ret_type);
            }
            if (self->sup->expect(";") != 0) return -1;
            /* SH-33: release what is still owned before the value leaves, so
               the release is on the taken path instead of after the `return` */
            if (self->mem->leak_active) {
                s = retire_before_return(self, s, !cond);
                if (s < 0) return -1;
            }
            if (self->defer_active_depth() > 0) {
                /* D38-3: the value is evaluated before the defers run, so a
                   defer that rewrites a local cannot change what is returned */
                if (self->arena->nodes[s].a >= 0 && self->sym->ret_type[0]
                    && strcmp(self->sym->ret_type, "void") != 0) {
                    self->arena->nodes[s].aux = 1;
                    snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s",
                             self->sym->ret_type);
                }
                if (self->defer_prepend(s, 0, is_err) != 0) return -1;
            }
            if (is_err) snprintf(self->arena->nodes[s].text2, MAX_TEXT, "err");
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "delete") == 0) {
            s = self->sup->new_node(N_DELETE);
            if (s < 0) return -1;
            self->sup->lex_next();
            e = self->ex->parse_expr();
            if (e < 0) return -1;
            self->arena->nodes[s].a = e;
            /* a borrowed pointer belongs to the lender: freeing it here would
               double-free a pool slot (stage one refuses the spelling) */
            if (check_borrow_delete(self, e) != 0) return -1;
            /* the object is released: it can neither leak nor auto-drop */
            if (self->mem->leak_active && self->sup->leak_delete(e) != 0) return -1;
            /* resolve the pointee's struct now (the variable may leave scope
               before the delete is emitted) and remember it only when it uses
               Drop; otherwise the emitter stays on the plain `free` path */
            {
                char dt[MAX_TEXT];
                if (self->sup->expr_type(e, dt, sizeof dt) == 0) {
                    const char *dp = dt;
                    size_t dl;
                    int si;
                    if (strncmp(dp, "struct ", 7) == 0) dp += 7;
                    snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s", dp);
                    dl = strlen(self->arena->nodes[s].text);
                    while (dl > 0 && (self->arena->nodes[s].text[dl - 1] == '*'
                                      || self->arena->nodes[s].text[dl - 1] == ' ')) {
                        dl = dl - 1;
                        self->arena->nodes[s].text[dl] = 0;
                    }
                    si = self->sym->find_struct(self->arena->nodes[s].text);
                    if (si < 0 || !self->sym->structs[si].uses_drop) self->arena->nodes[s].text[0] = 0;
                }
            }
            if (self->sup->expect(";") != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "break") == 0) {
            int bcol = self->lex->tokstart - self->lex->lstart + 1, is_err = 0;
            if (self->in_errdefer)
                return tool::diag::ct_sem_error(self->lex->tokline, bcol,
                    "an errdefer block cannot transfer control", self->mem->path);
            if (self->in_defer)
                return tool::diag::ct_sem_error(self->lex->tokline, bcol,
                    "a defer block cannot transfer control", self->mem->path);
            s = self->sup->new_node(N_BREAK);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->err_ahead()) {
                is_err = 1;
                snprintf(self->arena->nodes[s].text2, MAX_TEXT, "err");
                self->sup->lex_next();
                if (self->sup->expect(":")) return -1;
                if (self->nbreak == 0)
                    return tool::diag::ct_sem_error(self->lex->tokline, bcol,
                        "err: break/continue is only allowed in a loop", self->mem->path);
                if (self->break_is_switch[self->nbreak - 1])
                    return tool::diag::ct_sem_error(self->lex->tokline, bcol,
                        "err: break is not allowed in a switch", self->mem->path);
            }
            if (self->sup->expect(";") != 0) return -1;
            if (self->nbreak > 0
                && retire_before_jump(self, s, self->break_base[self->nbreak - 1]) < 0) return -1;
            if (self->nbreak > 0
                && self->defer_prepend(s, self->defer_break_base[self->nbreak - 1], is_err) != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "continue") == 0) {
            int ccol = self->lex->tokstart - self->lex->lstart + 1, is_err = 0;
            if (self->in_errdefer)
                return tool::diag::ct_sem_error(self->lex->tokline, ccol,
                    "an errdefer block cannot transfer control", self->mem->path);
            if (self->in_defer)
                return tool::diag::ct_sem_error(self->lex->tokline, ccol,
                    "a defer block cannot transfer control", self->mem->path);
            s = self->sup->new_node(N_CONT);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->err_ahead()) {
                is_err = 1;
                snprintf(self->arena->nodes[s].text2, MAX_TEXT, "err");
                self->sup->lex_next();
                if (self->sup->expect(":")) return -1;
                if (self->ncont == 0)
                    return tool::diag::ct_sem_error(self->lex->tokline, ccol,
                        "err: break/continue is only allowed in a loop", self->mem->path);
            }
            if (self->sup->expect(";") != 0) return -1;
            if (self->ncont > 0
                && retire_before_jump(self, s, self->cont_base[self->ncont - 1]) < 0) return -1;
            if (self->ncont > 0
                && self->defer_prepend(s, self->defer_cont_base[self->ncont - 1], is_err) != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "goto") == 0) return self->parse_goto();
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "if") == 0) {
            s = self->sup->new_node(N_IF);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            self->ex->assign_ok = 1;
            c = self->ex->parse_expr();
            self->ex->assign_ok = 0;
            if (c < 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            self->arena->nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "else") == 0) {
                self->sup->lex_next();
                e = self->parse_branch();
                if (e < 0) return -1;
                self->arena->nodes[s].c = e;
            }
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "while") == 0) {
            s = self->sup->new_node(N_WHILE);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            self->ex->assign_ok = 1;
            c = self->ex->parse_expr();
            self->ex->assign_ok = 0;
            if (c < 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            self->arena->nodes[s].a = c;
            if (jump_push(self, self->mem->nowner, self->mem->nowner) != 0) return -1;
            e = self->parse_branch();
            jump_pop(self, 1);
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "for") == 0) {
            int for_base;
            s = self->sup->new_node(N_FOR);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            if (self->sup->push_scope() != 0) return -1;
            /* `break` leaves the loop, so the initialiser's object goes with it;
               `continue` starts the next iteration, so only the body's objects
               are released and the initialiser stays alive. */
            for_base = self->mem->own_base[self->sym->nscope - 1];
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->arena->nodes[s].a = -1;
            } else if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0) {
                /* `for (static int i = 0; …)`: the initialiser runs once and `i`
                   keeps its value across calls (D-3 of batch 10 for the marker) */
                self->sup->lex_next();
                if (!self->is_decl_start()) {
                    self->sup->pop_scope();
                    return self->sup->fail("expected a declaration after 'static'");
                }
                self->static_decl = 1;
                e = self->parse_decl_node();
                self->static_decl = 0;
                if (e < 0) {
                    self->sup->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].a = e;
            } else if (self->is_decl_start()) {
                e = self->parse_decl_node();
                if (e < 0) {
                    self->sup->pop_scope();
                    return -1;
                }
                if (self->defer_ahead() || self->errdefer_ahead()) {
                    self->sup->pop_scope();
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1,
                        "a trailing defer needs a single declaration", self->mem->path);
                }
                self->arena->nodes[s].a = e;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->sup->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].a = e;
            }
            if (self->sup->expect(";") != 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ";") == 0) {
                self->arena->nodes[s].b = -1;
            } else {
                self->ex->assign_ok = 1;
                c = self->ex->parse_expr();
                self->ex->assign_ok = 0;
                if (c < 0) {
                    self->sup->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].b = c;
            }
            if (self->sup->expect(";") != 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                self->arena->nodes[s].c = -1;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->sup->pop_scope();
                    return -1;
                }
                self->arena->nodes[s].c = e;
            }
            if (self->sup->expect(")") != 0) {
                self->sup->pop_scope();
                return -1;
            }
            if (jump_push(self, for_base, self->mem->nowner) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            e = self->parse_branch();
            jump_pop(self, 1);
            if (e < 0) {
                self->sup->pop_scope();
                return -1;
            }
            self->arena->nodes[s].d = e;
            self->sup->pop_scope();
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "switch") == 0) {
            s = self->sup->new_node(N_SWITCH);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            self->ex->assign_ok = 1;
            e = self->ex->parse_expr();
            self->ex->assign_ok = 0;
            if (e < 0) return -1;
            self->arena->nodes[s].a = e;
            if (self->sup->expect(")") != 0) return -1;
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0))
                return self->sup->fail("expected a block after switch (...)");
            e = self->parse_switch_body();
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "do") == 0) {
            s = self->sup->new_node(N_DOWHILE);
            if (s < 0) return -1;
            self->sup->lex_next();
            if (jump_push(self, self->mem->nowner, self->mem->nowner) != 0) return -1;
            e = self->parse_branch();
            jump_pop(self, 1);
            if (e < 0) return -1;
            self->arena->nodes[s].b = e;
            if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "while") == 0))
                return self->sup->fail("a do statement must be followed by while (...)");
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            self->ex->assign_ok = 1;
            e = self->ex->parse_expr();
            self->ex->assign_ok = 0;
            if (e < 0) return -1;
            self->arena->nodes[s].a = e;
            if (self->sup->expect(")") != 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            return s;
        }
        /* `parse_switch_body` consumes every label of its own body, so a label
           seen here sits outside a switch (or in a block nested inside one).
           Named here so the message says why, instead of the undeclared-variable
           report the expression path would produce (D-8). */
        if (self->lex->tok == T_ID
            && (strcmp(self->lex->toktext, "case") == 0 || strcmp(self->lex->toktext, "default") == 0))
            return self->sup->fail("a case label is only allowed inside a switch");
        /* `borrow Conn *c = …` declares a borrowed pointer whose handback runs
           at scope exit; `borrow(x);` is a call to a function of that name, so
           the next token decides (see `borrow_decl_ahead`) */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "borrow") == 0
            && borrow_decl_ahead(self)) {
            int bline = self->lex->tokline;
            int bcol = self->lex->tokstart - self->lex->lstart + 1;
            if (self->switch_depth > 0)
                return tool::diag::ct_sem_error(bline, bcol,
                                       "'borrow' is not supported inside a switch", self->mem->path);
            self->sup->lex_next();
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            if (mark_borrow(self, s, bline, bcol) != 0) return -1;
            return s;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "own") == 0) {
            int own_line = self->lex->tokline;
            if (self->in_errdefer)
                return tool::diag::ct_sem_error(own_line,
                    self->lex->tokstart - self->lex->lstart + 1,
                    "an own object cannot be rolled back by errdefer", self->mem->path);
            if (self->switch_depth > 0) return self->sup->fail("own is not supported inside a switch");
            self->sup->lex_next();
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            if (self->sup->mark_owned(s, own_line) != 0) return -1;
            return s;
        }
        /* Declaration prefixes: a GNU attribute and `_Alignas(…)` may precede
           the storage class. The attribute is held for `parse_decl_node`, the
           alignment spelling is prepended to the type; either form is legal
           before `static` (`__attribute__((unused)) static int x;`). */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "__attribute__") == 0) {
            int a, r;
            if (self->sup->attr_pool(&a) < 0) return -1;
            if (a < 0) return -1;
            if (self->decl_attr)
                return self->sup->fail("duplicate __attribute__ on one declaration");
            if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0)
                && !self->is_decl_start())
                return self->sup->fail("an attribute must prefix a declaration");
            self->decl_attr = a + 1;
            r = self->parse_stmt();
            self->decl_attr = 0;
            return r;
        }
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "_Alignas") == 0) {
            int r, np, depth;
            char tbuf[MAX_TEXT];
            if (self->ex->decl_prefix[0])
                return self->sup->fail("duplicate _Alignas on one declaration");
            np = 0;
            if (self->ex->type_append(self->ex->decl_prefix, MAX_TEXT, &np, "_Alignas") != 0)
                return -1;
            self->sup->lex_next();
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0))
                return self->sup->fail("expected '(' after _Alignas");
            depth = 0;
            for (;;) {
                if (self->lex->tok == T_EOF) return self->sup->fail("unterminated _Alignas");
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                else
                    snprintf(tbuf, sizeof tbuf, "%s", self->lex->toktext);
                if (self->ex->type_append(self->ex->decl_prefix, MAX_TEXT, &np, tbuf) != 0)
                    return -1;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) depth++;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                    depth--;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                }
                self->sup->lex_next();
            }
            r = self->parse_stmt();
            if (r < 0) {
                self->ex->decl_prefix[0] = 0;
                return r;
            }
            if (self->ex->decl_prefix[0]) {
                self->ex->decl_prefix[0] = 0;
                return self->sup->fail("an _Alignas specifier must prefix a variable declaration");
            }
            return r;
        }
        /* `static <type> name …;` -- a function-local object with static storage
           duration. The declaration itself is the ordinary one; only the
           keyword and the leak bookkeeping differ (a static object is not the
           scope's to release, and `own` would mean the opposite of static). */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0) {
            self->sup->lex_next();
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "own") == 0)
                return self->sup->fail("a static local cannot be 'own'");
            if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "borrow") == 0)
                return self->sup->fail("a static local cannot be 'borrow'");
            if (!self->is_decl_start()) return self->sup->fail("expected a declaration after 'static'");
            self->static_decl = 1;
            s = self->parse_decl_node();
            self->static_decl = 0;
            if (s < 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            return s;
        }
        /* `loop(<count>) { … }` is a contextual keyword (D22-4): only in
           statement position and only when `(` follows. The branch sits before
           `label_ahead` / `is_decl_start` because `loop` is deliberately absent
           from `kw[]`; in every other position it stays an ordinary identifier. */
        if (self->loop_ahead()) return self->parse_loop();
        if (self->foreach_ahead()) return self->parse_foreach();
        /* `name:` -- a label opens no scope and declares nothing, so this sits
           after every keyword branch and before the declaration test; the
           lookahead keeps a qualified `A::f()` on the expression path (D-2). */
        if (self->label_ahead()) return self->parse_named_label();
        if (self->is_decl_start()) {
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->parse_trailing_defer(s) != 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            return s;
        }
        s = self->parse_expr_stmt_node();
        if (s < 0) return -1;
        if (self->defer_ahead() || self->errdefer_ahead())
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a trailing defer needs a single declaration", self->mem->path);
        if (self->sup->expect(";") != 0) return -1;
        return s;
    }

    int parse_branch(void)
    {
        int b, s, base, tail;
        (void)self;

        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) return self->parse_block();
        if (self->sup->push_scope() != 0) return -1;
        if (self->ndefer_blocks >= 256) {
            self->sup->pop_scope();
            return self->sup->fail("blocks are nested too deeply");
        }
        self->defer_head[self->ndefer_blocks] = -1;
        self->defer_tail[self->ndefer_blocks] = -1;
        self->defer_block_err[self->ndefer_blocks] = 0;
        self->ndefer_next_id = self->ndefer_next_id + 1;
        self->defer_ids[self->ndefer_blocks] = self->ndefer_next_id;
        self->ndefer_blocks = self->ndefer_blocks + 1;
        base = self->mem->own_base[self->sym->nscope - 1];
        s = self->parse_stmt();
        if (s < 0) {
            self->sup->pop_scope();
            return -1;
        }
        b = self->sup->new_node(N_BLOCK);
        if (b < 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->arena->nodes[b].a = s;
        tail = s;
        if (self->defer_flush_block(b, &tail) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* a braceless branch is still a scope: its `own` has to be released, or
           it leaks with no warning (`parse_block` does the same before its `}`) */
        if (self->mem->nowner > base && autodrop_append(self, b, base, &tail) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        if (self->mem->leak_active && self->sup->leak_scope(self->sym->scope[self->sym->nscope - 1], self->sym->nvar) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sup->pop_scope();
        (void)self->defer_mark_block();
        self->ndefer_blocks = self->ndefer_blocks - 1;
        return b;
    }

    /* The body of a `switch`. `parse_block` cannot be used: `case` / `default`
       are not statements the dispatcher knows, so the labels are read here and
       the statements they guard follow as ordinary statements (declarations
       directly inside the switch block included, which C allows). The body
       still opens a scope, since its declarations do not outlive the switch. */
    int parse_switch_body(void)
    {
        int blk, s, tail;
        (void)self;

        if (self->sup->expect("{") != 0) return -1;
        if (self->sup->push_scope() != 0) return -1;
        blk = self->sup->new_node(N_BLOCK);
        if (blk < 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* `own` is refused inside a switch, so the only `own` a `break` can meet
           are none: the baseline is the body's own scope, and this entry is what
           stops a `case … break` from releasing an enclosing loop's object. */
        if (jump_push(self, self->mem->own_base[self->sym->nscope - 1], -1) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* Push the switch body's defer entry *after* the jump baseline: a
           `break` must run this body's defers, just like a loop body's. */
        if (self->ndefer_blocks >= 256) {
            self->sup->pop_scope();
            return self->sup->fail("blocks are nested too deeply");
        }
        self->defer_head[self->ndefer_blocks] = -1;
        self->defer_tail[self->ndefer_blocks] = -1;
        self->defer_block_err[self->ndefer_blocks] = 0;
        self->ndefer_next_id = self->ndefer_next_id + 1;
        self->defer_ids[self->ndefer_blocks] = self->ndefer_next_id;
        self->ndefer_blocks = self->ndefer_blocks + 1;
        self->switch_depth = self->switch_depth + 1;
        tail = -1;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (self->lex->tok == T_ID
                && (strcmp(self->lex->toktext, "case") == 0 || strcmp(self->lex->toktext, "default") == 0))
                s = self->parse_label();
            else
                s = self->parse_stmt();
            if (s < 0) {
                self->switch_depth = self->switch_depth - 1;
                jump_pop(self, 0);
                self->sup->pop_scope();
                return -1;
            }
            if (tail < 0) self->arena->nodes[blk].a = s;
            else self->arena->nodes[tail].next = s;
            tail = s;
        }
        if (self->defer_flush_block(blk, &tail) != 0) {
            self->switch_depth = self->switch_depth - 1;
            jump_pop(self, 0);
            self->sup->pop_scope();
            return -1;
        }
        self->switch_depth = self->switch_depth - 1;
        jump_pop(self, 0);
        if (self->sup->expect("}") != 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sup->pop_scope();
        (void)self->defer_mark_block();
        self->ndefer_blocks = self->ndefer_blocks - 1;
        return blk;
    }

    /* A label owns the statements up to the next label or the closing brace
       (D-3): `b` carries the case value, `aux` marks `default`, `a` the chain
       of guarded statements. A chain rather than one statement keeps
       `case 1: f(); break;` on one indentation level; an empty chain is how a
       bare `case 1:` before another label is spelled. C does not let a label
       guard a declaration (labels open no scope), so a declaration anywhere in
       the chain is rejected. */
    int parse_label(void)
    {
        int s, c, head, tail, is_def, val;
        (void)self;

        if (self->in_defer)
            return self->sup->fail("a defer block cannot declare a label");
        s = self->sup->new_node(N_CASE);
        if (s < 0) return -1;
        is_def = strcmp(self->lex->toktext, "default") == 0;
        self->arena->nodes[s].aux = is_def;
        self->sup->lex_next();
        if (!is_def) {
            val = self->parse_case_value();
            if (val < 0) return -1;
            self->arena->nodes[s].b = val;
            self->arena->nodes[s].c = self->case_hi;
        }
        if (self->sup->expect(":") != 0) return -1;
        head = -1;
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)
               && !(self->lex->tok == T_ID
                    && (strcmp(self->lex->toktext, "case") == 0
                        || strcmp(self->lex->toktext, "default") == 0))
               && !self->label_ahead()) {
            if (self->is_decl_start()
                || (self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0))
                return self->sup->fail("a declaration cannot follow a case label; wrap it in a block");
            c = self->parse_stmt();
            if (c < 0) return -1;
            if (tail < 0) head = c;
            else self->arena->nodes[tail].next = c;
            tail = c;
        }
        if (head < 0
            && (self->lex->tok == T_EOF
                || (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)))
            return self->sup->fail("a case label needs a statement");
        self->arena->nodes[s].a = head;
        return s;
    }

    /* A case value is an integer constant expression (D-7): the expression is
       parsed as usual and then judged structurally, so `case (1 << 2):` is
       accepted while `case key + 1:` is an error. A whole name is allowed
       whether or not it is a declared constant: it may be a `#define` macro or,
       as in batch 4, a global the C compiler judges. */
    int parse_case_value(void)
    {
        int e, hi;
        (void)self;

        self->case_hi = -1;
        e = self->ex->parse_expr();
        if (e < 0) return -1;
        if (!self->ex->const_ok(e) && self->arena->nodes[e].kind != N_VAR
            && self->arena->nodes[e].kind != N_RAW)
            return self->sup->fail("a case label must be an integer constant");
        /* `case <low> ... <high>:` -- a GNU / C23 range. Both ends follow the
           same constant rule, and the high end waits in `case_hi`. */
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "...") == 0)) return e;
        self->sup->lex_next();
        hi = self->ex->parse_expr();
        if (hi < 0) return -1;
        if (!self->ex->const_ok(hi) && self->arena->nodes[hi].kind != N_VAR
            && self->arena->nodes[hi].kind != N_RAW)
            return self->sup->fail("a case label must be an integer constant");
        self->case_hi = hi;
        return e;
    }

    /* Is the current token `loop` immediately followed by `(`? */
    int loop_ahead(void)
    {
        return kw_paren_ahead(self, "loop");
    }

    /* Phase 27: is the current token `foreach` immediately followed by `(`? */
    int foreach_ahead(void)
    {
        return kw_paren_ahead(self, "foreach");
    }

    /* `loop(<count>) { … }` and `loop(<start>..<stop>) { … }` -- a shorthand for
       `for (int i = 0; i < <count>; i++) { … }` and for
       `for (int i = <start>; i < <stop>; i++) { … }`. The parser records the
       shape only: `a` = count (or the lower bound), `b` = -1 for the counted
       form and the upper bound for the range form, `d` = body. `loop(0..n)` is
       folded to the counted form here. The implicit `i` enters the symbol table
       here so name resolution, closure capture and shadowing all see it, but no
       `N_DECL` is built: the emitter prints the declaration in the `for` head
       (D22-2, D22-8). Both bounds are parsed before `i` enters scope, so they
       can only name an enclosing binding. */
    int parse_loop(void)
    {
        int s, cnt, hi, body, line, col, cls, bi, nb, vi;
        int bounds[2];
        char msg[MAX_TEXT];
        char t[MAX_TEXT];
        char ct[MAX_TEXT];
        char ex[MAX_TEXT];
        const char *p;
        int bare;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        s = self->sup->new_node(N_LOOP);
        if (s < 0) return -1;
        self->sup->lex_next();
        if (self->sup->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "..") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "a loop range needs both bounds", self->mem->path);
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "loop needs a count expression", self->mem->path);
        self->ex->assign_ok = 1;
        cnt = self->ex->parse_expr();
        self->ex->assign_ok = 0;
        if (cnt < 0) return -1;
        hi = -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "..") == 0) {
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)
                return tool::diag::ct_sem_error(self->lex->tokline,
                                                self->lex->tokstart - self->lex->lstart + 1,
                                                "a loop range needs both bounds", self->mem->path);
            self->ex->assign_ok = 1;
            hi = self->ex->parse_expr();
            self->ex->assign_ok = 0;
            if (hi < 0) return -1;
            /* `loop(0..b)` is `loop(b)` (D23-2). Only a literal zero is folded,
               and the rule is purely syntactic: `-0` and `0+0` stay ranges, so
               nothing here depends on constant folding. */
            if (self->arena->nodes[cnt].kind == N_NUM && self->arena->nodes[cnt].num == 0) {
                cnt = hi;
                hi = -1;
            }
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "loop takes exactly one count; use a native for to name the counter",
                                            self->mem->path);
        if (self->sup->expect(")") != 0) return -1;
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0))
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "loop body must be a block", self->mem->path);
        /* Both bounds go through the same two checks. D23-8: a pointer, an
           array, a struct/union value or a function pointer is a hard error --
           comparing an address with the implicit `int i` is never intended, and
           a bare `loop(arr)` slipped through silently in Phase 22. L22-5 keeps
           the softer rule: a scalar that is statically known not to be an
           integer (float/double/void) still compiles, converted to `int`, and
           only warns. A spelling this layer cannot classify stays silent: a
           false positive is worse than a miss. */
        bounds[0] = cnt;
        bounds[1] = hi;
        nb = (hi == -1) ? 1 : 2;
        for (bi = 0; bi < nb; bi++) {
            int e = bounds[bi];
            /* `int a[4]` and `int *p` spell the same type string, so only the
               symbol table can tell an array bound apart. */
            vi = -1;
            if (self->arena->nodes[e].kind == N_VAR)
                vi = self->sym->find_var(self->arena->nodes[e].text2);
            if (vi >= 0 && self->sym->vars[vi].is_array) {
                snprintf(msg, sizeof msg,
                         "a loop bound must be an integer (got the array '%s')",
                         self->sym->vars[vi].name);
                return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
            }
            /* An array that is not a plain variable -- `m.cells`, a field
               declared with dimensions -- only shows its `[]` in the
               dimension-preserving type, and it must be checked before the
               `expr_type` gate below: a one-dimensional field decays to a
               pointer (`expr_type` answers), but a two-dimensional one has no
               single element type and `expr_type` gives up, which used to leave
               `loop(m.cells)` completely silent. */
            if (self->sup->expr_ctype(e, ct, sizeof ct) == 0 && strchr(ct, '[')) {
                snprintf(msg, sizeof msg,
                         "a loop bound must be an integer (got '%s')", ct);
                return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
            }
            if (self->sup->expr_type(e, t, sizeof t) != 0) continue;
            bare = 1;
            for (p = t; *p; p++)
                if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
                      || (*p >= '0' && *p <= '9') || *p == '_'))
                    bare = 0;
            if (bare && self->sym->expand_type_alias(t, ex, sizeof ex) == 0)
                snprintf(t, sizeof t, "%s", ex);
            /* `[` is a backstop here: the two checks above already reject
               arrays, but an alias could still expand to a dimensioned type. */
            if (strchr(t, '*') || strchr(t, '[') || strchr(t, '(')
                || strncmp(t, "struct ", 7) == 0 || strncmp(t, "union ", 6) == 0) {
                snprintf(msg, sizeof msg,
                         "a loop bound must be an integer (got '%s')", t);
                return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
            }
            cls = loop_count_class(t);
            if (cls == 0) {
                snprintf(msg, sizeof msg,
                         "count must be an integer (got '%s'); the value is converted to int", t);
                if (tool::diag::ct_type_warn(line, col, "loop", msg, self->mem->path) != 0)
                    return -1;
            }
        }
        if (self->sup->push_scope() != 0) return -1;
        if (self->sup->declare_var("i", "int") != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* Only `loop` inside `loop` is reported (D22-5): the inner one shadows
           the outer implicit `i`. A hand-written `int i` or a native `for` is
           ordinary C shadowing and stays silent. */
        if (self->loop_depth > 0) {
            if (tool::diag::ct_loop_warn(line, col,
                    "loop shadows the outer 'i'; use a native for to name the inner counter",
                    self->mem->path) != 0) {
                self->sup->pop_scope();
                return -1;
            }
        }
        self->loop_depth = self->loop_depth + 1;
        if (jump_push(self, self->mem->nowner, self->mem->nowner) != 0) {
            self->loop_depth = self->loop_depth - 1;
            self->sup->pop_scope();
            return -1;
        }
        body = self->parse_block();
        jump_pop(self, 1);
        self->loop_depth = self->loop_depth - 1;
        if (body < 0) {
            self->sup->pop_scope();
            return -1;
        }
        self->sup->pop_scope();
        self->arena->nodes[s].a = cnt;
        self->arena->nodes[s].b = hi;
        self->arena->nodes[s].d = body;
        return s;
    }

    /* Phase 27: `foreach (<array>) { … item … }` -- the implicit `item` binds
       the current element by value (D27-5), the loop runs over the declared
       length and the emitter prints one plain `for` (D27-6/D27-9). The parser
       records the shape only: `a` = collection, `d` = body, `text` = element
       type. `item` enters the symbol table here so name resolution, closure
       capture and shadowing all see it, but no `N_DECL` is built. The
       collection is parsed before `item` enters scope, so a nested
       `foreach (item)` still names the outer binding.
       Containers are out of scope this phase (D27-4), and every shape whose
       length `sizeof` cannot answer is refused before any C is emitted
       (D27-11). */
    int parse_foreach(void)
    {
        int s, c, body, line, col, vi, nd, ip, bare;
        int aux, inst, nargs;
        char msg[MAX_TEXT];
        char elem[MAX_TEXT];
        char ex[MAX_TEXT];
        char tr[MAX_TEXT];
        char iname[MAX_TEXT];
        char enc[MAX_TEXT];
        const char *p;
        const char *q;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        s = self->sup->new_node(N_FOREACH);
        if (s < 0) return -1;
        self->sup->lex_next();
        if (self->sup->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "foreach needs a collection expression",
                                            self->mem->path);
        self->ex->assign_ok = 1;
        c = self->ex->parse_expr();
        self->ex->assign_ok = 0;
        if (c < 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0)
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "foreach takes exactly one collection",
                                            self->mem->path);
        if (self->sup->expect(")") != 0) return -1;
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0))
            return tool::diag::ct_sem_error(self->lex->tokline,
                                            self->lex->tokstart - self->lex->lstart + 1,
                                            "foreach body must be a block",
                                            self->mem->path);
        if (self->arena->nodes[c].kind != N_VAR)
            return tool::diag::ct_sem_error(line, col,
                                            "foreach needs a plain array variable",
                                            self->mem->path);
        vi = self->sym->find_var(self->arena->nodes[c].text2);
        if (vi < 0)
            return tool::diag::ct_sem_error(line, col,
                                            "foreach needs a declared array",
                                            self->mem->path);
        /* Phase 29 (D29-13): the built-in containers iterate through their own
           protocol -- `Vec` by `len`/`get`, `Map` by `len`/`entry`. `item` is a
           by-value copy either way; `i` is a read-only binding for `Vec` only,
           and naming it in a `Map` body is the L29-18 hard error (a map has no
           natural position, and offering one would read as an order promise). */
        aux = 0;
        iname[0] = 0;
        snprintf(iname, sizeof iname, "%s", self->sym->vars[vi].type);
        if (strncmp(iname, "struct ", 7) == 0)
            memmove(iname, iname + 7, strlen(iname + 7) + 1);
        inst = frontend::sym::ct_inst_find(iname);
        if (inst >= 0) {
            struct StructInst *ins = frontend::sym::ct_insts(&nargs);
            if (strcmp(ins[inst].tmpl, "Vec") == 0) {
                aux = 1;
                snprintf(elem, sizeof elem, "%s", ins[inst].ctype[0]);
            } else if (strcmp(ins[inst].tmpl, "Map") == 0) {
                aux = 2;
            }
        }
        if (aux != 0) {
            /* L29-15: a container element would be a second owner of the same
               buffer, and an interface value would lose its vptr on the copy.
               Both are the same "the element cannot be copied by value" rule. */
            int kk;
            {
                struct StructInst *ins = frontend::sym::ct_insts(&nargs);
                for (kk = 0; kk < (aux == 1 ? 1 : 2); kk++) {
                    /* Judged by the instance tag the argument resolved to, not
                       by the source spelling: since S20b a nested argument is
                       carried as its C tag (`struct MapEntry_char_p_int`), so a
                       `ct_inst_split` on `carg` would never match. D31-4
                       unfroze interface and container elements, not the entry
                       type, so this branch stays. */
                    const char *tag = ins[inst].ctype[kk];
                    int mt = -1;
                    if (strncmp(tag, "struct ", 7) == 0 && strchr(tag, '*') == 0) {
                        tag += 7;
                        mt = frontend::sym::ct_inst_find(tag);
                    }
                    if (mt >= 0
                        && strcmp(frontend::sym::ct_insts(&nd)[mt].tmpl, "MapEntry") == 0) {
                        snprintf(msg, sizeof msg,
                                 "foreach cannot iterate a container of '%s' (interface, vptr-bearing or container element)",
                                 ins[inst].ctype[kk]);
                        return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
                    }
                }
                if (aux == 2) {
                    /* The item type is the matching `MapEntry` instance; its
                       layout is registered here so the C spelling exists even
                       when the user never wrote `MapEntry<...>` themselves. */
                    if (self->ex->inst_make("MapEntry", 2,
                                            ins[inst].carg[0], ins[inst].carg[1],
                                            ins[inst].ctype[0], ins[inst].ctype[1],
                                            enc, MAX_TEXT, 0, 0, 0) != 0)
                        return -1;
                    snprintf(elem, sizeof elem, "struct %s", enc);
                }
            }
        }
        if (aux == 0) {
        /* `int a[]` as a parameter is `int *a` in C; `sizeof` would answer the
           pointer's size and silently iterate the wrong count. */
        if (self->sym->vars[vi].is_param || self->sym->vars[vi].is_fnparam) {
            snprintf(msg, sizeof msg,
                     "foreach cannot iterate the array parameter '%s' (its length is lost)",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        if (!self->sym->vars[vi].dims[0]) {
            snprintf(msg, sizeof msg,
                     "foreach needs an array or a Vec/Map; '%s' is not iterable",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        snprintf(elem, sizeof elem, "%s", self->sym->vars[vi].type);
        /* A function-pointer array stores its declarator in `text3` instead of
           plain `[N]`; `int item = handlers[i];` would be illegal C. */
        if (self->sym->vars[vi].dims[0] != '[' || strchr(elem, '(')) {
            snprintf(msg, sizeof msg,
                     "foreach cannot iterate '%s'; its declarator is not a plain array",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        nd = 0;
        for (p = self->sym->vars[vi].dims; *p; p++)
            if (*p == '[') nd++;
        if (nd > 1) {
            snprintf(msg, sizeof msg,
                     "foreach does not support multidimensional arrays ('%s')",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        /* A file-scope `int a[];` stays incomplete; the local `int a[] = {…}`
           is completed by its initialiser, which only C sees. */
        if (self->sym->vars[vi].is_global && strstr(self->sym->vars[vi].dims, "[]")) {
            snprintf(msg, sizeof msg,
                     "foreach needs an array with a known length ('%s')",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        /* A typedef can hide an array element (`typedef int Row[4]; Row a[2];`);
           `Row item = a[i];` is not C, so refuse it like a second dimension. */
        bare = 1;
        for (q = elem; *q; q++)
            if (!((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                  || (*q >= '0' && *q <= '9') || *q == '_')) bare = 0;
        if (bare && self->sym->expand_type_alias(elem, ex, sizeof ex) == 0
            && strchr(ex, '[')) {
            snprintf(msg, sizeof msg,
                     "foreach does not support multidimensional arrays ('%s')",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        /* An interface value is a (vptr, data) pair; a by-value copy would
           bypass the vptr discipline, and the element type gives no owner. */
        if (self->sup->iface_ref_type(elem, tr, sizeof tr, &ip) && !ip) {
            snprintf(msg, sizeof msg,
                     "foreach cannot copy interface values ('%s')",
                     self->sym->vars[vi].name);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        }   /* aux == 0: the Phase 27 array path ends here */
        if (self->sup->push_scope() != 0) return -1;
        if (self->sup->declare_var("item", elem) != 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* Phase 31 S23a (L31-13): inside a container loop `item` is a borrowed
           view of the stored element, never an owner. */
        if (aux != 0) {
            int ivi = self->sym->find_var("item");
            if (ivi >= 0) self->sym->vars[ivi].cview = 1;
        }
        /* D29-14: an array or `Vec` also binds the read-only index `i`. A `Map`
           binds it too, so that naming it reports L29-18 instead of an
           undeclared name; the emitter prints no `i` line for a `Map` body. */
        if (self->sup->declare_var("i", "int") != 0) {
            self->sup->pop_scope();
            return -1;
        }
        if (self->foreach_depth > 0) {
            if (tool::diag::ct_loop_warn(line, col,
                    "foreach shadows the outer 'item'; use a native for to name the binding",
                    self->mem->path) != 0) {
                self->sup->pop_scope();
                return -1;
            }
        }
        self->foreach_depth = self->foreach_depth + 1;
        if (jump_push(self, self->mem->nowner, self->mem->nowner) != 0) {
            self->foreach_depth = self->foreach_depth - 1;
            self->sup->pop_scope();
            return -1;
        }
        /* Phase 31 S23b (L31-22): the body may not mutate the container it is
           iterating; the expression layer compares the receiver with this name. */
        frontend::parse::expr_iter_push(self->ex, self->arena->nodes[c].text2);
        body = self->parse_block();
        frontend::parse::expr_iter_pop(self->ex);
        jump_pop(self, 1);
        self->foreach_depth = self->foreach_depth - 1;
        if (body < 0) {
            self->sup->pop_scope();
            return -1;
        }
        /* D29-14: the bindings are fixed for the whole body. Redeclaring `item`
           or `i` is L29-17; assigning / incrementing / taking the address of
           the index is L29-16 (it stands for the position, not a variable); and
           a `Map` body has no `i` at all (L29-18), because insertion order is
           not an ordinal the loop promises. The scan only sees nodes the body
           itself created: the arena grows monotonically while it is parsed. */
        for (nd = body; nd < self->arena->nnode; nd++) {
            int k0 = self->arena->nodes[nd].kind;
            if (k0 == N_DECL
                && (strcmp(self->arena->nodes[nd].text2, "item") == 0
                    || strcmp(self->arena->nodes[nd].text2, "i") == 0)) {
                snprintf(msg, sizeof msg, "cannot redeclare the foreach binding '%s'",
                         self->arena->nodes[nd].text2);
            } else if (aux == 2 && k0 == N_VAR
                       && strcmp(self->arena->nodes[nd].text2, "i") == 0) {
                snprintf(msg, sizeof msg,
                         "'i' has no meaning in a Map foreach; use item.key / item.value");
            } else if (aux != 2
                       && (k0 == N_ASSIGN || k0 == N_POST || k0 == N_PRE
                           || k0 == N_ADDR)
                       && self->arena->nodes[nd].a >= 0
                       && self->arena->nodes[self->arena->nodes[nd].a].kind == N_VAR
                       && strcmp(self->arena->nodes[self->arena->nodes[nd].a].text2,
                                 "i") == 0) {
                snprintf(msg, sizeof msg, "the foreach index 'i' is read-only");
            } else {
                continue;
            }
            self->sup->pop_scope();
            return tool::diag::ct_sem_error(self->arena->nodes[nd].line, 1, msg,
                                            self->mem->path);
        }
        self->sup->pop_scope();
        snprintf(self->arena->nodes[s].text, MAX_TEXT, "%s", elem);
        /* aux: 0 = array, 1 = Vec, 2 = Map; text2 names the container instance
           the emitter calls `len` / `get` / `entry` on. */
        self->arena->nodes[s].aux = aux;
        snprintf(self->arena->nodes[s].text2, MAX_TEXT, "%s", aux ? iname : "");
        self->arena->nodes[s].a = c;
        self->arena->nodes[s].d = body;
        return s;
    }

    /* Phase 24 D24-1: does this initialiser carry a range at all? The scan runs
       to the end of the declarator (`,` / `;` at depth 0) and only a `..` at
       depth 0 opens one, so a `..` inside a call, an index or a `{ … }`
       initialiser keeps its ordinary (invalid) meaning. Scanning instead of
       peeking two tokens is what lets `= BASE..3($)` reach L24-2: the shape is
       recognised first, and the bound reader then rejects the name by spelling.
       The parse of an initialiser cannot contain a `..` of its own, so the
       fallback is `parse_expr` exactly as before. The lexer has no peek, so the
       state is saved and put back. */
    int range_init_ahead(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, sfloat, strunc, r;
        int depth = 0;
        long snum;
        char stext[MAX_TEXT];
        char ssuf[8];

        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        sfloat = self->lex->tokfloat;
        strunc = self->lex->toktrunc;
        snprintf(stext, sizeof stext, "%s", self->lex->toktext);
        snprintf(ssuf, sizeof ssuf, "%s", self->lex->toksuffix);
        r = 0;
        while (self->lex->tok != T_EOF) {
            if (self->lex->tok == T_PUNCT) {
                const char *t = self->lex->toktext;
                if (strcmp(t, "(") == 0 || strcmp(t, "[") == 0 || strcmp(t, "{") == 0) {
                    depth++;
                } else if (strcmp(t, ")") == 0 || strcmp(t, "]") == 0 || strcmp(t, "}") == 0) {
                    if (depth > 0) depth--;
                } else if (strcmp(t, "..") == 0) {
                    if (depth == 0) {
                        r = 1;
                        break;
                    }
                } else if ((strcmp(t, ",") == 0 || strcmp(t, ";") == 0) && depth == 0) {
                    break;
                }
            }
            self->sup->lex_next();
        }
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokfloat = sfloat;
        self->lex->toktrunc = strunc;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", stext);
        snprintf(self->lex->toksuffix, sizeof self->lex->toksuffix, "%s", ssuf);
        return r;
    }

    /* Phase 24 D24-2/D24-3/D24-6/D24-7/D24-10: `= <start>..<stop>($…)` on an
       array declarator. `parse_range_init` owns everything between the `=` and
       the closing `)` and returns the `N_INIT_RANGE` node; the caller stores it
       as the declarator's initialiser. The `$` flag is raised only around the
       element expression, so `$` anywhere else stays a syntax error.

       Phase 29 P29-1: the same shape also builds a `Vec<T>`. The range is still
       one element subtree, and the node names the element's C type and the
       instance, so the emitter writes a composite literal and hands it to the
       built-in constructor (`Vec_<enc>_from`). Nothing here looks at the
       container's fields (B29-3): the instance row answers both. */
    int parse_range_init(int n, const char *type)
    {
        long start, stop, dim;
        unsigned long cnt;
        int e, elem, line, col, save_dollar;
        int is_vec;
        char elemtype[MAX_TEXT];
        char iname[MAX_TEXT];
        char why[MAX_TEXT];
        char msg[256];
        const char *close;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        elemtype[0] = 0;
        iname[0] = 0;
        is_vec = 0;
        /* L24-5: an array declarator, or (P29-1) a by-value `Vec<T>` */
        if (!self->arena->nodes[n].text3[0]) {
            is_vec = range_vec_target(type, elemtype, (int)sizeof elemtype,
                                      iname, (int)sizeof iname);
            if (!is_vec)
                return tool::diag::ct_sem_error(line, col,
                                                "a range initializer declares an array", self->mem->path);
        }
        if (range_bound(self, &start) != 0) return -1;
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "..") == 0))
            return self->sup->fail("unexpected token");
        self->sup->lex_next();
        if (range_bound(self, &stop) != 0) return -1;
        /* L24-3: an empty initialiser list has no target meaning. The bounds
           fit `long`, so the difference is compared in unsigned arithmetic and
           a huge span can never wrap into a plausible count. */
        if (stop <= start)
            return tool::diag::ct_sem_error(line, col, "an empty range has no elements", self->mem->path);
        cnt = (unsigned long)stop - (unsigned long)start;
        if (cnt > 1024)
            return tool::diag::ct_sem_error(line, col, "too many range elements (limit 1024)", self->mem->path);
        /* L24-7: a numeric dimension has to agree with the range. `[]` and any
           spelling this layer cannot evaluate are left to C. A `Vec` declares
           no dimension, so the count is the only size. */
        if (!is_vec
            && range_dim_value(self->arena->nodes[n].text3, &dim) && dim != (long)cnt) {
            snprintf(msg, sizeof msg,
                     "the array size '%ld' does not match the range (%ld elements)",
                     dim, (long)cnt);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        /* L24-6: scalar elements only -- for a `Vec` the element type is the
           instance's type argument, not the container struct */
        if (range_element_bad(self, is_vec ? elemtype : type,
                              is_vec ? "" : self->arena->nodes[n].text3,
                              why, (int)sizeof why)) {
            snprintf(msg, sizeof msg, "a range initializer cannot initialize '%s' elements", why);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        /* P29-1: the element list accepts the parenthesised form Phase 24
           froze (`0..3($)`) and the brace form the request writes
           (`4..8 { $ * $ }`); the two mean the same thing, and neither can be
           confused with a declaration's brace list because `..` was already
           consumed. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            close = ")";
        } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
            close = "}";
        } else {
            return self->sup->fail("expected '(' or '{' after the range bound");
        }
        self->sup->lex_next();
        save_dollar = self->ex->dollar_ok;
        {
            int save_range = self->ex->range_ctx;
            self->ex->dollar_ok = 1;
            self->ex->range_ctx = 1;
            elem = self->ex->parse_expr();
            self->ex->range_ctx = save_range;
        }
        self->ex->dollar_ok = save_dollar;
        if (elem < 0) return -1;
        if (self->sup->expect(close) != 0) return -1;
        e = self->sup->new_node(N_INIT_RANGE);
        if (e < 0) return -1;
        /* One element subtree, however many elements: the node count does not
           grow with `count`, which is what makes the 1024 cap safe (D24-10). */
        self->arena->nodes[e].a = elem;
        self->arena->nodes[e].num = start;
        self->arena->nodes[e].aux = (int)cnt;
        self->arena->nodes[e].line = line;
        if (is_vec) {
            /* non-empty `text2` is the emitter's marker for the literal +
               constructor form */
            snprintf(self->arena->nodes[e].text, MAX_TEXT, "%s", elemtype);
            snprintf(self->arena->nodes[e].text2, MAX_TEXT, "%s", iname);
        }
        return e;
    }

    /* Is the current identifier the start of `name:`? The lexer has no peek,
       so every state field is saved, the next token is read and the cursor is
       put back. `::` is one token, so a qualified name never looks like a label
       (D-2); `default:` is handled by the case branch before this runs. */
    int label_ahead(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, r;
        long snum;
        char stext[MAX_TEXT];
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        snprintf(stext, sizeof stext, "%s", self->lex->toktext);
        self->sup->lex_next();
        r = 0;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ":") == 0) r = 1;
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", stext);
        return r;
    }

    int label_find(const char *name)
    {
        int i;
        (void)self;

        for (i = 0; i < self->nlabels; i++)
            if (strcmp(self->label_names[i], name) == 0) return i;
        return -1;
    }

    /* `name:` owns the statements up to the next label of any kind or the
       closing brace, the same chain rule `case` follows (D-3). A run of
       labels (`again: done:`) is allowed: while nothing has been taken yet the
       next label is a statement too, so the first label owns the second one.
       C opens no scope at a label, so a declaration cannot sit directly behind
       it (D-4), and C99 rejects a label that runs straight into `}` -- an
       empty chain is an error rather than an emitted `name: }`. */
    int parse_named_label(void)
    {
        int s, c, head, tail, line, i;
        char name[MAX_TEXT];
        char msg[MAX_TEXT];
        (void)self;

        if (self->in_defer)
            return self->sup->fail("a defer block cannot declare a label");
        line = self->lex->tokline;
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        if (self->nlabels >= MAX_LABELS) return self->sup->fail("too many labels in one function");
        if (self->label_find(name) >= 0) {
            snprintf(msg, sizeof msg, "duplicate label '%s'", name);
            return self->sup->fail(msg);
        }
        s = self->sup->new_node(N_LABEL);
        if (s < 0) return -1;
        snprintf(self->label_names[self->nlabels], MAX_TEXT, "%s", name);
        self->label_lines[self->nlabels] = line;
        self->label_path_depth[self->nlabels] = self->ndefer_blocks;
        for (i = 0; i < self->ndefer_blocks; i++) {
            self->label_path[self->nlabels][i] = self->defer_ids[i];
            self->label_path_has[self->nlabels][i] = 0;
        }
        self->nlabels = self->nlabels + 1;
        snprintf(self->arena->nodes[s].text2, MAX_TEXT, "%s", name);
        self->sup->lex_next();
        if (self->sup->expect(":") != 0) return -1;
        head = -1;
        tail = -1;
        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)
               && !(self->lex->tok == T_ID
                    && (strcmp(self->lex->toktext, "case") == 0
                        || strcmp(self->lex->toktext, "default") == 0))
               && !(head >= 0 && self->label_ahead())) {
            if (self->is_decl_start()
                || (self->lex->tok == T_ID && strcmp(self->lex->toktext, "static") == 0))
                return self->sup->fail("a declaration cannot follow a label; wrap it in a block");
            c = self->parse_stmt();
            if (c < 0) return -1;
            if (tail < 0) head = c;
            else self->arena->nodes[tail].next = c;
            tail = c;
        }
        if (head < 0) return self->sup->fail("a label needs a statement");
        self->arena->nodes[s].a = head;
        return s;
    }

    /* `goto name;` -- recorded for the end-of-body check, since the label may
       be defined later in the same function (D-5). */
    int parse_goto(void)
    {
        int s, i;
        char name[MAX_TEXT];
        (void)self;

        if (self->in_errdefer)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "an errdefer block cannot transfer control", self->mem->path);
        if (self->in_defer)
            return tool::diag::ct_sem_error(self->lex->tokline,
                self->lex->tokstart - self->lex->lstart + 1,
                "a defer block cannot transfer control", self->mem->path);
        s = self->sup->new_node(N_GOTO);
        if (s < 0) return -1;
        self->sup->lex_next();
        if (self->lex->tok != T_ID) return self->sup->fail("expected a label name");
        if (self->ngotos >= MAX_LABELS) return self->sup->fail("too many gotos in one function");
        snprintf(name, sizeof name, "%s", self->lex->toktext);
        snprintf(self->arena->nodes[s].text2, MAX_TEXT, "%s", name);
        snprintf(self->goto_names[self->ngotos], MAX_TEXT, "%s", name);
        self->goto_lines[self->ngotos] = self->arena->nodes[s].line;
        self->goto_path_depth[self->ngotos] = self->ndefer_blocks;
        for (i = 0; i < self->ndefer_blocks; i++) {
            self->goto_path[self->ngotos][i] = self->defer_ids[i];
            self->goto_path_has[self->ngotos][i] = 0;
        }
        self->ngotos = self->ngotos + 1;
        self->sup->lex_next();
        if (self->sup->expect(";") != 0) return -1;
        return s;
    }

    int func_begin(void)
    {
        (void)self;
        self->nlabels = 0;
        self->ngotos = 0;
        self->nbreak = 0;
        self->ncont = 0;
        self->ndefer_blocks = 0;
        self->ndefer_next_id = 0;
        self->in_defer = 0;
        self->in_errdefer = 0;
        return 0;
    }

    /* Labels are function-scoped, so an unresolved `goto` is judged here, when
       the whole body has been seen; the complaint points at the `goto` line. */
    int func_end(void)
    {
        int i, j, k, gd, ld;
        char msg[MAX_TEXT];
        (void)self;

        for (i = 0; i < self->ngotos; i++) {
            int li = self->label_find(self->goto_names[i]);
            if (li < 0) {
                snprintf(msg, sizeof msg, "label '%s' is not defined", self->goto_names[i]);
                return self->sup->fail_at(self->goto_lines[i], msg);
            }
            /* Only a path element below the label/goto LCA is a block boundary
               the jump actually crosses. A defer on an ancestor common to both
               sides is not crossed. */
            gd = self->goto_path_depth[i];
            ld = self->label_path_depth[li];
            k = 0;
            while (k < gd && k < ld
                   && self->goto_path[i][k] == self->label_path[li][k]) k++;
            for (j = k; j < gd; j++)
                if (self->goto_path_has[i][j]) {
                    int b, has_err = 0;
                    for (b = 0; b < 256; b++)
                        if (self->defer_ids[b] == self->goto_path[i][j])
                            has_err = self->defer_block_err[b];
                    return self->sup->fail_at(self->goto_lines[i],
                        has_err ? "a goto cannot cross a block with errdefer"
                                : "a goto cannot cross a block with defer");
                }
            for (j = k; j < ld; j++)
                if (self->label_path_has[li][j]) {
                    int b, has_err = 0;
                    for (b = 0; b < 256; b++)
                        if (self->defer_ids[b] == self->label_path[li][j])
                            has_err = self->defer_block_err[b];
                    return self->sup->fail_at(self->goto_lines[i],
                        has_err ? "a goto cannot cross a block with errdefer"
                                : "a goto cannot cross a block with defer");
                }
        }
        return 0;
    }

    /* `<type> name[dims] [= expr] (, name[dims] [= expr])*` without the trailing
       semicolon. Several declarators share the type and come back as an N_DECLS
       wrapper, so every consumer still sees one statement node. */
    int parse_decl_node(void)
    {
        int n, e, head, tail, base_stars, first_decl, is_fnptr, ap;
        int dcol, dline;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        /* the leading attribute belongs to this declaration and every name on
           the line; clear the slot before parsing so it cannot leak */
        ap = self->decl_attr ? self->decl_attr - 1 : -1;
        self->decl_attr = 0;
        dcol = self->lex->tokstart - self->lex->lstart + 1;
        dline = self->lex->tokline;
        if (self->ex->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        head = -1;
        tail = -1;
        base_stars = 0;
        is_fnptr = 0;
        first_decl = 1;
        for (;;) {
            int stars = 0, si;
            size_t tl;
            char t2[MAX_TEXT];

            is_fnptr = self->ex->fnptr_state;
            if (is_fnptr) {
                /* the declarator name came with the type (`int (*cb)(void *)`)
                   and a function pointer declares exactly one name */
                if (!first_decl)
                    return self->sup->fail("a function pointer declares one name");
                snprintf(name, sizeof name, "%s", self->ex->fnptr_name);
                first_decl = 0;
            } else {
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                stars++;
                self->sup->lex_next();
            }
            /* `parse_type` folds the first declarator's stars into the type; each
               later declarator brings its own, so the star suffix is rebuilt per
               declarator (`const char *p, *q;` and `int *a, **b;` both work) */
            tl = strlen(typebuf);
            while (tl > 0 && (typebuf[tl - 1] == '*' || typebuf[tl - 1] == ' ')) {
                if (first_decl && typebuf[tl - 1] == '*') base_stars++;
                tl--;
            }
            typebuf[tl] = 0;
            if (first_decl) {
                stars = base_stars;
                first_decl = 0;
            }
            for (si = 0; si < stars; si++) {
                snprintf(t2, sizeof t2, "%s *", typebuf);
                snprintf(typebuf, sizeof typebuf, "%s", t2);
            }
            if (self->lex->tok != T_ID) return self->sup->fail("expected a variable name");
            snprintf(name, sizeof name, "%s", self->lex->toktext);
            self->sup->lex_next();
            }
            n = self->sup->new_node(N_DECL);
            if (n < 0) return -1;
            if (self->static_decl) self->arena->nodes[n].aux = 1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", typebuf);
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", name);
            if (self->sup->declare_var(name, typebuf) != 0) return -1;
            if (self->static_decl) {
                int vi = self->sym->find_var(name);
                if (vi >= 0) self->sym->vars[vi].is_static = 1;
            }
            /* `int (*tbl[2])(int)`: the dimensions came with the declarator, and
               `parse_array_dims` only appends what follows the name (D-5) */
            if (self->ex->fnptr_state && self->ex->fnptr_dims[0])
                snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", self->ex->fnptr_dims);
            {
                int dim_line = self->lex->tokline;
                int dim_col = self->lex->tokstart - self->lex->lstart + 1;
                if (self->ex->parse_array_dims(n) != 0) return -1;
                /* Phase 24 L24-10: `$` has no meaning in a dimension, with or
                   without a range initialiser (`int a[$] = 5;` included). Every
                   declarator's dimensions pass here, so the text can never slip
                   through to C as an undeclared name. */
                if (strchr(self->arena->nodes[n].text3, '$'))
                    return tool::diag::ct_sem_error(dim_line, dim_col,
                                                    "'$' cannot be used in an array dimension",
                                                    self->mem->path);
            }
            {
                /* A trailing attribute on a local (`int x __attribute__((unused));`)
                   is accepted as well; a declaration may not carry both forms. */
                int ta;
                if (self->sup->attr_pool(&ta) < 0) return -1;
                if (ap >= 0 && ta >= 0)
                    return self->sup->fail("duplicate __attribute__ on one declaration");
                if (ta >= 0) self->arena->nodes[n].attr = ta;
                else if (ap >= 0) self->arena->nodes[n].attr = ap;
            }
            if (self->arena->nodes[n].text3[0]) {
                int vi = self->sym->find_var(name);
                if (vi >= 0) {
                    self->sym->vars[vi].is_array = 1;
                    snprintf(self->sym->vars[vi].dims, MAX_TEXT, "%s",
                             self->arena->nodes[n].text3);
                }
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0) {
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                    /* local `static` tables can be long, so the text goes to the
                       arena string pool (`aux = 1`, `num` = offset) */
                    char elemtype[MAX_TEXT];
                    char iname[MAX_TEXT];
                    char entrytype[MAX_TEXT];
                    char mapname[MAX_TEXT];
                    char ktype[MAX_TEXT];
                    char vtype[MAX_TEXT];
                    char raw[MAX_RAW_INIT];
                    char fixed[MAX_INIT_TEXT];
                    int off, k;
                    if (range_vec_target(typebuf, elemtype, (int)sizeof elemtype,
                                         iname, (int)sizeof iname)) {
                        /* Phase 31 S11a: `Vec<T> v = {…}` lowers to `from(…, n)`.
                           Handled before the raw capture so the element list
                           stays a structured expression chain. A `static`
                           local cannot call the constructor during C static
                           initialization, so it is refused with the global
                           text (L31-10). */
                        if (self->static_decl)
                            return tool::diag::ct_sem_error(self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1,
                                "a Vec brace initializer is only supported in a local declaration",
                                self->mem->path);
                        e = parse_vec_brace_init(self, elemtype, iname);
                        if (e < 0) return -1;
                    } else if (map_brace_target(typebuf, entrytype,
                                               (int)sizeof entrytype, mapname,
                                               (int)sizeof mapname, ktype,
                                               (int)sizeof ktype, vtype,
                                               (int)sizeof vtype)) {
                        /* Phase 31 S14a: `Map<K, V> m = {k: v, …}` lowers to
                           `Map_<enc>_from((MapEntry_<enc>[]){ … }, n)`. A
                           `static` local cannot call the constructor during C
                           static initialization (the global refusal lands in
                           its own slice). */
                        if (self->static_decl)
                            return tool::diag::ct_sem_error(self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1,
                                "a Map brace initializer is only supported in a local declaration",
                                self->mem->path);
                        e = parse_map_brace_init(self, entrytype, mapname,
                                                 ktype, vtype);
                        if (e < 0) return -1;
                    } else {
                    /* V29-4: a Map has no C aggregate initializer; the cursor
                       still sits on `{`, so the refusal is positioned. */
                    if (self->ex->container_init_check(typebuf) != 0) return -1;
                    e = self->sup->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->sup->init_raw(raw, sizeof raw) != 0) return -1;
                    if (self->sup->rewrite_init_text(typebuf, raw, fixed, sizeof fixed) != 0) return -1;
                    off = self->arena->str_begin();
                    for (k = 0; fixed[k]; k++)
                        if (self->arena->str_put(fixed[k]) != 0)
                            return self->sup->fail("initializer is too long");
                    self->arena->str_end();
                    self->arena->nodes[e].num = off;
                    self->arena->nodes[e].aux = 1;
                    }
                } else if (self->range_init_ahead()) {
                    /* Phase 24: `= 0..n($…)` on an array declarator */
                    e = self->parse_range_init(n, typebuf);
                    if (e < 0) return -1;
                } else {
                    int eline, ecol;
                    /* `int (*p)(int) = strcmp;` may name a C library function */
                    if (strstr(typebuf, "(*")) self->ex->fnval_ok = 1;
                    self->ex->into_ok = 1;
                    eline = self->lex->tokline;
                    ecol = self->lex->tokstart - self->lex->lstart + 1;
                    e = self->ex->parse_expr();
                    self->ex->into_ok = 0;
                    self->ex->fnval_ok = 0;
                    if (e < 0) return -1;
                    /* Phase 32 S3 (L32-1): the declared type against the
                       initialiser. The position is the initialiser's own
                       start, and the whole check stays behind `--types`. */
                    if (self->ex->types_mode && *self->ex->types_mode) {
                        char out[MAX_TEXT];
                        int is_zero = 0;
                        if (self->ex->chk_type(e, out, sizeof out, &is_zero) == 0) {
                            self->ex->chk_line = eline;
                            self->ex->chk_col = ecol;
                            self->ex->chk_arg = 0;
                            if (self->ex->chk_assignable(typebuf, out, is_zero, 1) != 0)
                                return -1;
                        }
                    }
                }
                self->arena->nodes[n].a = e;
            }
            /* L29-9: a container value is moved, never copied. A bare
               identifier initializer naming the same container instance is a
               copy; a function result (or `retain()`) is a move. */
            if (self->arena->nodes[n].a >= 0
                && self->arena->nodes[n].text3[0] == 0
                && frontend::sym::ct_is_container_type(typebuf)
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR) {
                int vi = self->sym->find_var(
                    self->arena->nodes[self->arena->nodes[n].a].text2);
                if (vi >= 0 && !self->sym->vars[vi].cview
                    && strcmp(self->sym->vars[vi].type, typebuf) == 0)
                    return tool::diag::ct_sem_error(dline, dcol,
                        "a container is moved, not copied; use retain() or a function result",
                        self->sup->mem->path);
            }
            /* Phase 31 S23a (L31-14): a local bound from a borrowed view keeps
               that provenance, so its later `release` is refused. An owning
               initialiser (`from`, `{}`, `retain`, `pop`, a call result) leaves
               the bit clear. */
            if (frontend::sym::ct_is_container_type(typebuf)) {
                int vi = self->sym->find_var(name);
                if (vi >= 0)
                    self->sym->vars[vi].cview =
                        frontend::parse::expr_borrow_root(self->ex,
                                                          self->arena->nodes[n].a);
            }
            /* Phase 31 S23b (L31-23): a view binding (a container, a `V *` or a
               `MapEntry` copy) is invalidated by a later mutation of its
               container; the table lives in the expression layer. */
            frontend::parse::expr_view_bind(self->ex, name, self->arena->nodes[n].a);
            /* Phase 21 S2: a closure literal on the right of a function-pointer
               declaration is bound to the declared type here; the literal is
               checked, never emitted. */
            if (self->arena->nodes[n].a >= 0
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_CLOSURE
                && self->ex->closure_bind(self->arena->nodes[self->arena->nodes[n].a].num,
                                          typebuf, name) != 0)
                return -1;
            /* E2 / E7: a declaration whose initialiser copies an existing
               binding is not a second binding; a local that outlives the source
               is the store-by-name error. */
            if (self->arena->nodes[n].a >= 0
                && self->arena->nodes[self->arena->nodes[n].a].kind != N_CLOSURE
                && check_closure_decl_init(self, n, name, dcol) != 0)
                return -1;
            if (self->arena->nodes[n].a >= 0) {
                char tr[MAX_TEXT];
                int ip = 0;
                /* A container instance whose type argument is an interface
                   value is spelled `struct Vec_Show__iface`: the `_iface` tail
                   alone must not turn the declaration into an interface slot,
                   so the name has to be a declared trait. */
                if (self->sup->iface_ref_type(typebuf, tr, sizeof tr, &ip)
                    && self->sym->find_trait(tr) >= 0) {
                    e = self->sup->maybe_box(self->arena->nodes[n].a, tr, ip);
                    if (e < 0) return -1;
                    self->arena->nodes[n].a = e;
                }
            }
            /* a static local is deliberately not tracked: it outlives the scope,
               so neither a leak warning nor AutoDrop applies (D-4) */
            if (!self->static_decl && self->mem->leak_active && self->sup->leak_decl(n) != 0) return -1;
            if (head < 0) head = n;
            else self->arena->nodes[tail].next = n;
            tail = n;
            if (!self->sup->accept(",")) break;
        }
        if (self->arena->nodes[head].next >= 0) {
            int w = self->sup->new_node(N_DECLS);
            if (w < 0) return -1;
            self->arena->nodes[w].a = head;
            return w;
        }
        return head;
    }

    int parse_expr_stmt_node(void)
    {
        int e, rhs, n, w;
        int scol;
        (void)self;

        scol = self->lex->tokstart - self->lex->lstart + 1;
        self->ex->into_ok = 1;
        e = self->ex->parse_expr();
        self->ex->into_ok = 0;
        if (e < 0) return -1;
        /* L30-6: a bare `expr into { … };` statement writes into the receiver,
           so a right-value receiver would silently lose the writes. A suffix
           turns it back into a value expression and the restriction lifts. */
        if (self->arena->nodes[e].kind == N_INTO
            && self->arena->nodes[e].aux == 3) {
            int il = self->arena->nodes[e].line;
            int ic = self->arena->nodes[e].num;
            tool::diag::ct_sem_error(il, ic,
                "an 'into' statement needs a writable receiver",
                self->sup->mem->path);
            return -1;
        }
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+=") == 0 || strcmp(self->lex->toktext, "-=") == 0
                                 || strcmp(self->lex->toktext, "*=") == 0 || strcmp(self->lex->toktext, "/=") == 0
                                 || strcmp(self->lex->toktext, "%=") == 0 || strcmp(self->lex->toktext, "&=") == 0
                                 || strcmp(self->lex->toktext, "|=") == 0 || strcmp(self->lex->toktext, "^=") == 0
                                 || strcmp(self->lex->toktext, "<<=") == 0 || strcmp(self->lex->toktext, ">>=") == 0)) {
            int op = 0, k2;
            char oc = self->lex->toktext[0];
            k2 = self->arena->nodes[e].kind;
            /* Phase 31 O3 (L31-3/L31-4): `v[i] += 1` writes the value. */
            if (self->ex->container_write_check(e) != 0) return -1;
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX
                && k2 != N_DEREF && k2 != N_INTO_SELF)
                return self->sup->fail("assignment target is not assignable");
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else if (oc == '%') op = 5;
            else if (oc == '&') op = 6;
            else if (oc == '|') op = 7;
            else if (oc == '^') op = 8;
            else if (oc == '<') op = 9;
            else op = 10;
            self->sup->lex_next();
            self->ex->into_ok = 1;
            rhs = self->ex->parse_expr();
            self->ex->into_ok = 0;
            if (rhs < 0) return -1;
            n = self->sup->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].b = rhs;
            self->arena->nodes[n].aux = op;
            if (check_closure_assign(self, n, scol) != 0) return -1;
            if (check_borrow_store(self, n) != 0) return -1;
            if (self->mem->leak_active && self->sup->leak_assign(n) != 0) return -1;
        } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0) {
            int k, ip;
            int rline, rcol;
            char tt[MAX_TEXT];
            char tr[MAX_TEXT];
            ip = 0;
            /* `N_DEREF` never fills `tt` below, and `iface_ref_type` reads it:
               an empty string is the "no type derived" case */
            tt[0] = 0;
            k = self->arena->nodes[e].kind;
            /* Phase 31 O3 (L31-3/L31-4): `v[i] = x` / `m[k] = x`. */
            if (self->ex->container_write_check(e) != 0) return -1;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX
                && k != N_DEREF && k != N_INTO_SELF)
                return self->sup->fail("assignment target is not assignable");
            self->sup->lex_next();
            /* `p = strcmp;`: when the target is a function pointer, an unknown
               bare name may be a C library function, so it is emitted as-is. */
            if (((k == N_VAR && self->sup->var_type(self->arena->nodes[e].text2, tt, sizeof tt) == 0)
                 || ((k == N_INDEX || k == N_MEMBER || k == N_ARROW)
                     && self->sup->expr_type(e, tt, sizeof tt) == 0))
                && strstr(tt, "(*"))
                self->ex->fnval_ok = 1;
            /* Phase 31 S11b: a brace list is not an expression, so an
               assignment to a `Vec` gets the dedicated text (L31-11) instead of
               the generic "expected an expression" the primary parser gives.
               `tt` is filled by the query above, so the target type is known. */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0
                && (strncmp(tt, "struct Vec_", 11) == 0 || strncmp(tt, "Vec_", 4) == 0))
                return self->sup->fail(
                    "a brace list is not an expression; use Vec<T>::from or push");
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0
                && (strncmp(tt, "struct Map_", 11) == 0 || strncmp(tt, "Map_", 4) == 0))
                return self->sup->fail(
                    "a brace list is not an expression; use Map<K, V>::from or put");
            self->ex->into_ok = 1;
            rline = self->lex->tokline;
            rcol = self->lex->tokstart - self->lex->lstart + 1;
            rhs = self->ex->parse_expr();
            self->ex->into_ok = 0;
            self->ex->fnval_ok = 0;
            if (rhs < 0) return -1;
            /* Phase 32 S4 (L32-2): the target's declared type against the
               right-hand side, before an interface slot boxes it. This same
               branch carries an `into` block's `.field = expr`, whose type
               `expr_type` derives from the receiver record. */
            if (self->ex->types_mode && *self->ex->types_mode && tt[0]) {
                char out[MAX_TEXT];
                int is_zero = 0;
                if (self->ex->chk_type(rhs, out, sizeof out, &is_zero) == 0) {
                    self->ex->chk_line = rline;
                    self->ex->chk_col = rcol;
                    self->ex->chk_arg = 0;
                    if (self->ex->chk_assignable(tt, out, is_zero, 2) != 0) return -1;
                }
            }
            if (self->sup->iface_ref_type(tt, tr, sizeof tr, &ip)
                && self->sym->find_trait(tr) >= 0) {
                rhs = self->sup->maybe_box(rhs, tr, ip);
                if (rhs < 0) return -1;
            }
            n = self->sup->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].b = rhs;
            if (check_closure_assign(self, n, scol) != 0) return -1;
            if (check_borrow_store(self, n) != 0) return -1;
            if (self->mem->leak_active && self->sup->leak_assign(n) != 0) return -1;
            /* Phase 31 S23a (L31-14): rebinding a container local takes the
               provenance of the source -- a borrowed view stays borrowed, an
               owning value (`from`, `retain`, `pop`, a call) clears the bit. */
            if (k == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[e].text2);
                if (vi >= 0
                    && frontend::sym::ct_is_container_type(self->sym->vars[vi].type))
                    self->sym->vars[vi].cview =
                        frontend::parse::expr_borrow_root(self->ex, rhs);
                /* Phase 31 S23b (L31-23): rebinding a view follows the source. */
                frontend::parse::expr_view_bind(self->ex,
                                                self->arena->nodes[e].text2, rhs);
            }
        } else if (self->arena->nodes[e].kind == N_POST) {
            n = e;
        } else {
            n = self->sup->new_node(N_EXPR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
        }
        /* A comma list is the loosest level of a full expression, and the only
           callers that need it (an expression statement, a `for` init / step)
           come through here; `parse_expr` stays comma-free because call
           arguments are comma-separated by the same token. Each operand is
           itself parsed by this function, so `a, b, c` nests to the right --
           the evaluation is left to right either way, which is all `,` says. */
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
            self->sup->lex_next();
            rhs = self->parse_expr_stmt_node();
            if (rhs < 0) return -1;
            w = self->sup->new_node(N_BIN);
            if (w < 0) return -1;
            self->arena->nodes[w].a = n;
            self->arena->nodes[w].b = rhs;
            self->arena->nodes[w].aux = B_COMMA;
            n = w;
        }
        return n;
    }

    /* The file-scope initialiser path (`Parser.parse_func`): a global lives past
       every frame, so its environment would dangle as soon as the enclosing
       function returns. A `.h.ct` reaches the same rule through a `pub` global.
       Rejecting here keeps the literal out of the emitter, which has no frame to
       build an environment in and used to fall back to `unknown expression node`. */
    int closure_global_init(int e, const char *name, int line, int col)
    {
        char msg[MAX_TEXT];

        if (e < 0 || self->arena->nodes[e].kind != N_CLOSURE) return 0;
        snprintf(msg, sizeof msg,
                 "a closure cannot be stored in '%s' (its scope outlives the closure)", name);
        return closure_error(self, line, col, msg);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Stmt g_stmt;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_stmt_bind(void *arena, void *lex, void *sym, void *mem, void *sup, void *ex);
void ct_stmt_bind(void *arena, void *lex, void *sym, void *mem, void *sup, void *ex)
{
    g_stmt.arena = (struct Arena *)arena;
    g_stmt.lex = (struct Lexer *)lex;
    g_stmt.sym = (struct Symbols *)sym;
    g_stmt.mem = (struct Memory *)mem;
    g_stmt.sup = (struct ParseSupport *)sup;
    g_stmt.ex = (struct Expr *)ex;
}

pub struct Stmt *stmt_get(void);
struct Stmt *stmt_get(void)
{
    return &g_stmt;
}
