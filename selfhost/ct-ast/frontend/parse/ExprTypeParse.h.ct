/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 8192
#define CAP_LIMIT 65536
#define MAX_FUNCS 512
#define MAX_ARG_POS 32
#define MAX_GENERIC_INSTS 64
#define MAX_TEXT 160
#define TEXT_LIMIT 65536
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
#define N_MATSEQ 73
#define N_NEWOBJ 77
#define N_INTO 63
#define N_INTO_SELF 64
#define N_TRY 71
#define N_ADTCTOR 81
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_OPT 72
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */

/* S1a-0 C2p-3: a `My::Type` redirect for the generic reader (`core::Vec`).
   The target spelling is a pool text now, so a long qualifier is not cut at
   the old 160-byte static row. NULL means "no redirect pending". */
static const char *g_expr_inst_override = 0;
pub struct ExprTypeParse {
    int unused;
}

/* S1a-0 C2p-3: `<tname><a[, b]>` as one pool text. The old canon/raw rows
   were 160 bytes, so a long template name was cut before it could become an
   instance identity. */
static const char *inst_spell(const char *tname, int nargs, char **args)
{
    char *buf = 0;
    int cap = 0, i;
    const char *pooled;

    if (tool::sh::ct_text_init(&buf, &cap, 64) != 0) return (const char *)0;
    if (tool::sh::ct_text_cat(&buf, &cap, tname) != 0
        || tool::sh::ct_text_cat(&buf, &cap, "<") != 0) goto fail;
    for (i = 0; i < nargs; i++) {
        if (i > 0 && tool::sh::ct_text_cat(&buf, &cap, ",") != 0) goto fail;
        if (tool::sh::ct_text_cat(&buf, &cap,
                args && args[i] ? args[i] : "") != 0) goto fail;
    }
    if (tool::sh::ct_text_cat(&buf, &cap, ">") != 0) goto fail;
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

/* S1a-0 C2p-3: the name a type token resolves to. The buffer form keeps its
   exact diagnostics (an ambiguous export is still a hard stop) for every name
   that fits the old row; a name past it uses the pool form, whose result is a
   whole interned spelling instead of "name is too long". */
static const char *type_resolve_name(struct Expr *self, const char *name)
{
    char buf[MAX_TEXT];
    if (strlen(name) < MAX_TEXT) {
        if (self->sup->resolve_type(name, buf, sizeof buf) != 0)
            return (const char *)0;
        return runtime::text::ct_intern(buf);
    }
    return self->sym->resolve_type_text(name);
}

/* S1a-0 C2p-3: intern the current token first, then resolve it. Keeping
   `tok_cstr()` out of a stored value also satisfies the p86 capi rule: the
   lexer scratch is valid only until the next token. */
static const char *type_resolve_token(struct Expr *self)
{
    const char *tok = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                  self->lex->tokstr.len);
    if (!tok) return (const char *)0;
    return type_resolve_name(self, tok);
}


pub int type_only_qualifiers(const char *spell)
{
    const char *p;
    int n;

    p = spell;
    while (*p == ' ' || *p == '\t') p++;
    while (*p) {
        n = 0;
        while (p[n] && p[n] != ' ' && p[n] != '\t') n++;
        if (!((n == 5 && strncmp(p, "const", 5) == 0)
              || (n == 8 && strncmp(p, "volatile", 8) == 0)
              || (n == 8 && strncmp(p, "restrict", 8) == 0)
              || (n == 10 && strncmp(p, "__restrict", 10) == 0)
              || (n == 12 && strncmp(p, "__restrict__", 12) == 0)))
            return 0;
        p += n;
        while (*p == ' ' || *p == '\t') p++;
    }
    return 1;
}


/* D-029: does the `(` at the cursor open `( ... ) =>`, the functor type
   sugar? The token stream cannot be rewound, so the answer comes from the raw
   source: scan to the matching `)`, skipping strings, chars and comments, and
   look for `=>`. This mirrors Expr.h.ct's `closure_ahead`; the type parser is
   a separate unit, so it cannot share that static. Nothing is consumed. */
static int functor_ahead(struct Expr *self)
{
    const char *s = self->lex->src;
    int i = self->lex->tokstart;
    int depth = 0;

    if (s[i] != '(') return 0;
    for (; s[i]; i++) {
        char c = s[i];
        if (c == '"' || c == '\'') {
            char q = c;
            i++;
            while (s[i] && s[i] != q) {
                if (s[i] == '\\' && s[i + 1]) i++;
                i++;
            }
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '/') {
            while (s[i] && s[i] != '\n') i++;
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '*') {
            i += 2;
            while (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++;
            if (!s[i]) return 0;
            i++;
            continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            depth--;
            if (depth == 0) {
                i++;
                break;
            }
        }
    }
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') i++;
    return s[i] == '=' && s[i + 1] == '>';
}

/* D-029: a broken functor spelling still carries an arrow on the same
   declaration. The type reader would otherwise report the generic "expected a
   type" at the `(`; naming the shape is the actionable diagnostic. A
   terminator (`;`, `{`, `}`) or the end of the line ends the search, so a
   later initializer's closure arrow is never blamed on the type. */
static int functor_arrow_on_line(struct Expr *self)
{
    const char *s = self->lex->src + self->lex->tokstart;

    if (*s != '(') return 0;
    for (; *s; s++) {
        char c = *s;
        if (c == '\n' || c == ';' || c == '{' || c == '}') return 0;
        if (c == '"' || c == '\'') {
            char q = c;
            s++;
            while (*s && *s != q) {
                if (*s == '\\' && s[1]) s++;
                s++;
            }
            if (!*s) return 0;
            continue;
        }
        if (c == '/' && s[1] == '/') {
            while (*s && *s != '\n') s++;
            if (!*s) return 0;
            continue;
        }
        if (c == '/' && s[1] == '*') {
            s += 2;
            while (*s && !(*s == '*' && s[1] == '/')) s++;
            if (!*s) return 0;
            s++;
            continue;
        }
        if (c == '=' && s[1] == '>') return 1;
    }
    return 0;
}

/* D-029: read the parenthesized parameter list of `(A, B) => R` and return
   the canonical C list. Names are optional and dropped: the list is a type,
   not a declaration. `()` / `(void)` both answer `void`; `...` keeps the
   existing variadic rule. */
static int functor_params(struct Expr *self, const char **plist_out)
{
    const char *plist = "";
    int pn = 0;

    *plist_out = "void";
    if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
        self->sup->lex_next();
        return 0;
    }
    for (;;) {
        const char *pt;
        const char *joiner;

        if (self->lex->tok == T_PUNCT && self->lex->tok_is("...")) {
            if (pn == 0 || strcmp(plist, "void") == 0)
                return self->sup->fail("a variadic functor type needs a parameter before '...'");
            plist = runtime::text::ct_intern_join(plist, ", ...");
            if (!plist) return self->sup->fail("out of memory");
            self->sup->lex_next();
            break;
        }
        if (self->parse_type_text(&pt) != 0) return -1;
        if (self->fnptr_state || strstr(pt, "(*)"))
            return self->sup->fail("nested function pointers are not supported");
        if (strcmp(pt, "void") == 0) {
            if (self->lex->tok != T_PUNCT
                || !(self->lex->tok_is(",") || self->lex->tok_is(")")))
                return self->sup->fail("a 'void' functor parameter must be the only parameter");
            if (self->lex->tok_is(","))
                return self->sup->fail("a 'void' functor parameter must be the only parameter");
        }
        /* the optional parameter name is documentation only */
        if (self->lex->tok == T_ID) self->sup->lex_next();
        joiner = (pn > 0) ? ", " : "";
        if (joiner[0]) {
            plist = runtime::text::ct_intern_join(plist, joiner);
            if (!plist) return self->sup->fail("out of memory");
        }
        plist = runtime::text::ct_intern_join(plist, pt);
        if (!plist) return self->sup->fail("out of memory");
        pn++;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
            self->sup->lex_next();
            continue;
        }
        break;
    }
    if (self->sup->expect(")") != 0) return -1;
    if (pn == 0) plist = "void";
    *plist_out = plist;
    return 0;
}

/* D-029: `(A, B) => R` parses to the same abstract declarator as
   `R (*)(A, B)`. The caller has already matched `functor_ahead`, and the
   cursor sits on `(`. The sugar is a complete type: `fnptr_state` stays 0 so
   the declaration entries read the name, dimensions and initializer exactly
   as they do for an ordinary type. */
static int functor_parse(struct Expr *self, char *out, int cap, int *n)
{
    const char *plist;
    const char *rt;
    const char *sig;

    if (self->functor_depth > 0)
        return self->sup->fail("nested function pointers are not supported");
    self->functor_depth++;
    self->sup->lex_next();                       /* the `(` */
    if (functor_params(self, &plist) != 0) return -1;
    if (self->sup->expect("=>") != 0) return -1;
    if (self->parse_type_text(&rt) != 0) return -1;
    if (self->fnptr_state || strstr(rt, "(*)"))
        return self->sup->fail("nested function pointers are not supported");
    sig = runtime::text::ct_internf("(*)(%s)", plist);
    if (!sig) return self->sup->fail("out of memory");
    if (self->type_append(out, cap, n, rt) != 0) return -1;
    if (self->type_append(out, cap, n, sig) != 0) return -1;
    self->fnptr_state = 0;
    self->fnptr_name = "";
    self->fnptr_dims = "";
    self->functor_depth--;
    return 0;
}

impl ExprTypeParse for Expr {
    int functor_type_ahead(void)
    {
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is("(")) return 0;
        /* A well-formed sugar opens a declaration. A malformed one that still
           writes the arrow on the declaration line is routed to the type
           reader too, so it gets the shape diagnostic instead of being misread
           as a parenthesised expression. */
        if (functor_ahead(self)) return 1;
        return functor_arrow_on_line(self);
    }

    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "void") == 0 || strcmp(w, "char") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
            || strcmp(w, "long") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "signed") == 0
            || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0
            || strcmp(w, "bool") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "volatile") == 0 || strcmp(w, "restrict") == 0
            || strcmp(w, "__restrict") == 0 || strcmp(w, "__restrict__") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "union") == 0
            || strcmp(w, "enum") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "ssize_t") == 0 || strcmp(w, "ptrdiff_t") == 0
            || strcmp(w, "wchar_t") == 0 || strcmp(w, "va_list") == 0
            || strcmp(w, "int8_t") == 0 || strcmp(w, "int16_t") == 0
            || strcmp(w, "int32_t") == 0 || strcmp(w, "int64_t") == 0
            || strcmp(w, "uint8_t") == 0 || strcmp(w, "uint16_t") == 0
            || strcmp(w, "uint32_t") == 0 || strcmp(w, "uint64_t") == 0
            || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0;
    }

    int type_append(char *out, int cap, int *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->sup->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, (size_t)(cap - *n), "%s", tok);
        if (w < 0 || w >= cap - *n) return self->sup->fail("type is too long");
        *n += w;
        return 0;
    }

    int parse_type(char *out, int cap)
    {
        int n;
        (void)self;

        n = 0;
        out[0] = 0;
        if (self->decl_prefix[0]) {
            int pn = snprintf(out, (size_t)cap, "%s", self->decl_prefix);
            if (pn < 0 || pn >= cap) return self->sup->fail("type is too long");
            n = pn;
            self->decl_prefix = "";
        }
        self->fnptr_state = 0;
        self->saw_trait = 0;
        self->fnptr_name = "";
        self->fnptr_dims = "";
        self->last_bare_tag = "";
        /* D-029: a broken functor spelling carries the arrow on the
           declaration line; name the shape at the `(` instead of the generic
           "expected a type". Checked before the `(*)` lookahead restores the
           token. */
        if (!self->type_no_ptr
            && self->lex->tok == T_PUNCT && self->lex->tok_is("(")
            && !functor_ahead(self) && functor_arrow_on_line(self))
            return self->sup->fail("a functor type needs a '(A, B) => R' shape");
        /* D-029: `(A, B) => R` is the function-pointer type in another
           spelling. It is a complete type, so the declarator name, array
           dimensions and initializer are read by the existing callers exactly
           as for `R (*)(A, B)`. */
        if (!self->type_no_ptr
            && self->lex->tok == T_PUNCT && self->lex->tok_is("(")
            && functor_ahead(self)) {
            int fn = 0;
            if (functor_parse(self, out, cap, &fn) != 0) return -1;
            if (fn == 0) return self->sup->fail("expected a type");
            return 0;
        }
        for (;;) {
            /* Phase 41 B′: `atomic` is a contextual modifier, not a reserved
               keyword. It only enters the type when one of the four supported
               bases follows; `int atomic = 1;` never reaches this branch. */
            if (n == 0 && self->lex->tok == T_ID
                && self->lex->tok_is("atomic")) {
                self->saw_atomic = 1;
                self->sup->lex_next();
                if (self->lex->tok == T_ID
                    && self->lex->tok_is("_Atomic"))
                    return self->sup->fail("use one atomic spelling, not both");
                if (self->lex->tok == T_ID
                    && self->lex->tok_is("own"))
                    return self->sup->fail("'own' must precede the type; an owned pointer cannot be atomic");
                if (self->lex->tok == T_ID
                    && self->lex->tok_is("int")) {
                    if (self->type_append(out, cap, &n, "_Atomic(int)") != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->lex->tok == T_ID
                    && self->lex->tok_is("long")) {
                    if (self->type_append(out, cap, &n, "_Atomic(long)") != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->lex->tok == T_ID
                    && self->lex->tok_is("bool")) {
                    if (self->type_append(out, cap, &n, "_Atomic(_Bool)") != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->lex->tok == T_ID
                    && self->lex->tok_is("void")) {
                    self->sup->lex_next();
                    if (self->lex->tok == T_PUNCT
                        && self->lex->tok_is("*")) {
                        if (self->type_append(out, cap, &n, "_Atomic(void *)") != 0) return -1;
                        self->sup->lex_next();
                        continue;
                    }
                }
                return self->sup->fail("atomic supports only int, long, void * and bool");
            }
            /* C11 `_Alignas(…)` and `_Atomic(…)`: the specifier is copied into
               the type spelling and handed to the C compiler as written (the
               argument may be a type name or a constant expression), so every
               declaration entry -- global, local, field, parameter, typedef --
               picks it up without a node of its own. `_Atomic int` is the
               qualifier spelling and is accepted too. */
            if (self->lex->tok == T_ID
                && (self->lex->tok_is("_Alignas")
                    || self->lex->tok_is("_Atomic"))) {
                int need_paren, depth;
                const char *word;
                need_paren = (self->lex->tok_is("_Alignas"));
                word = need_paren ? "_Alignas" : "_Atomic";
                if (self->type_append(out, cap, &n, word) != 0) return -1;
                self->sup->lex_next();
                if (self->lex->tok != T_PUNCT || !self->lex->tok_is("(")) {
                    if (need_paren) return self->sup->fail("expected '(' after _Alignas");
                    continue;                 /* bare `_Atomic` is the qualifier */
                }
                depth = 0;
                for (;;) {
                    char nbuf[64];
                    if (self->lex->tok == T_EOF) {
                        if (need_paren) return self->sup->fail("unterminated _Alignas");
                        return self->sup->fail("unterminated _Atomic");
                    }
                    /* an integer token keeps its value, not its spelling;
                       S1a-0 C2p-6: any other token is passed through as its
                       growable C string (never stored), so a type name between
                       the parentheses is not cut by the old 160-byte `tbuf`. */
                    if (self->lex->tok == T_NUM && !self->lex->tokfloat) {
                        snprintf(nbuf, sizeof nbuf, "%ld", self->lex->toknum);
                        if (self->type_append(out, cap, &n, nbuf) != 0) return -1;
                    } else if (self->type_append(out, cap, &n,
                                                 self->lex->tok_cstr()) != 0) {
                        return -1;
                    }
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) depth++;
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
                        depth--;
                        if (depth == 0) {
                            self->sup->lex_next();
                            break;
                        }
                    }
                    self->sup->lex_next();
                }
                continue;
            }
            if (self->lex->tok == T_ID && self->is_type_word(self->lex->tok_cstr())) {
                if (self->lex->tok_is("struct")) {
                    const char *sname;
                    self->sup->lex_next();
                    /* Phase 29: `struct Stack<int>` is the same type as
                       `Stack<int>`; the instance reader owns the spelling. */
                    if (self->lex->tok == T_ID && frontend::sym::ct_tmpl_find(self->lex->tok_cstr(), self->cur_unit) >= 0) {
                        if (self->parse_inst_type(out, cap) != 0) return -1;
                        n = (int)strlen(out);
                        continue;
                    }
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a struct name");
                    sname = type_resolve_token(self);
                    if (!sname) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 1) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, self->lex->tok_cstr()) != 0) return -1;
                if (self->lex->tok_is("enum")) {
                    /* `enum Tag` keeps its keyword the way `struct Tag` does; the
                       tag joins the table under kind 5 (D-2) */
                    const char *sname;
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected an enum name");
                    sname = type_resolve_token(self);
                    if (!sname) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 5) != 0) return -1;
                } else if (self->lex->tok_is("union")) {
                    /* a union tag is mangled like a struct tag and joins the table
                       under kind 6 */
                    const char *sname;
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a union name");
                    sname = type_resolve_token(self);
                    if (!sname) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 6) != 0) return -1;
                }
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID) {
                int ti;
                const char *rname;
                const char *iface;
                /* PH-57: `ns::Type` in a type position. The first segment is
                   still the current token; peek past it before consuming so a
                   plain name keeps the existing path below. */
                {
                    const char *qp = self->lex->src + self->lex->tokstart + self->lex->tokstr.len;
                    while (*qp == ' ' || *qp == '\t') qp++;
                    if (qp[0] == ':' && qp[1] == ':') {
                        const char *qn;
                        int qti;
                        qn = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                         self->lex->tokstr.len);
                        if (!qn) return self->sup->fail("out of memory");
                        self->sup->lex_next();
                        for (;;) {
                            if (self->lex->tok != T_PUNCT
                                || !self->lex->tok_is("::")) break;
                            self->sup->lex_next();
                            if (self->lex->tok != T_ID)
                                return self->sup->fail("expected a type name after '::'");
                            qn = runtime::text::ct_intern_join(qn, "_");
                            if (qn) qn = runtime::text::ct_intern_join(
                                             qn, self->lex->tok_cstr());
                            if (!qn) return self->sup->fail("out of memory");
                            self->sup->lex_next();
                        }
                        /* DOC-87 Stage 2: `core::Vec` / `core::String` /
                           `core::Box` (and the deprecated `core::box`) name the
                           built-in layer's source
                           namespace. During the compatibility window the C
                           symbols stay in the root namespace, so strip the
                           prefix: a template instantiates from the `<` the
                           cursor already sits on, a plain type resolves by its
                           bare spelling. */
                        {
                            const char *resq = qn;
                            /* SH-120: `core::utf16::U16String` / `U16Str`.
                               The built-in layer's C symbols stay in the root
                               namespace (lib/core is namespace-elided), so
                               the nested qualifier maps to the bare spelling
                               exactly like `core::String` does. */
                            if (strncmp(qn, "core_utf16_", 11) == 0) {
                                resq = qn + 11;
                            } else if (strncmp(qn, "core_", 5) == 0) {
                                resq = qn + 5;
                                /* LANG-24 Stage A: `core::box<T>` is the same
                                   deprecated alias as the root spelling. */
                                if (strcmp(resq, "box") == 0)
                                    return self->sup->fail("'box<T>' is no longer supported; write 'Box<T>'");
                                if (frontend::sym::ct_tmpl_find(resq, self->cur_unit) >= 0) {
                                    g_expr_inst_override = runtime::text::ct_intern(resq);
                                    if (!g_expr_inst_override)
                                        return self->sup->fail("out of memory");
                                    if (self->parse_inst_type(out, cap) != 0)
                                        return -1;
                                    n = (int)strlen(out);
                                    continue;
                                }
                            }
                            rname = type_resolve_name(self, resq);
                            if (!rname)
                                return self->sup->fail("unknown qualified type name");
                        }
                        qti = self->sym->find_type(rname);
                        if (qti < 0) return self->sup->fail("unknown qualified type name");
                        /* TypeRow.kind: 1 struct tag, 5 enum tag, 6 union tag,
                           7 ADT tag. S8B-REM-1 R8 / D4: same subject, four
                           arms; the keyword is the only per-kind effect. */
                        match (self->sym->types[qti].kind) {
                            1 => {
                                if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                            }
                            5 => {
                                if (self->type_append(out, cap, &n, "enum") != 0) return -1;
                            }
                            6 => {
                                if (self->type_append(out, cap, &n, "union") != 0) return -1;
                            }
                            7 => {
                                /* Phase 84: an ADT's C spelling is its struct. */
                                if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                            }
                            _ => { }
                        }
                        if (self->type_append(out, cap, &n, rname) != 0) return -1;
                        self->sup->add_type(rname, self->sym->types[qti].kind);
                        continue;
                    }
                }
                /* Phase 26 fix (SH-63): the declaration's type parameter wins
                   over a same-named tag; it is kept as `T` for emission. */
                {
                    int gpi, gdone = 0;
                    for (gpi = 0; !gdone && gpi < self->in_generic_ntparam; gpi++) {
                        const char *gpn = self->in_generic_tparam[gpi];
                        if (!gpn || !gpn[0] || !self->lex->tok_is(gpn)) continue;
                        if (self->type_append(out, cap, &n, gpn) != 0) return -1;
                        self->sup->lex_next();
                        gdone = 1;
                    }
                    if (gdone) continue;
                }
                /* PH-81 / LANG-24: `box` is the deprecated alias for `Box`
                   and a common identifier (`Box box;`). It is a type only when
                   a balanced `<...>` follows; otherwise this is the declarator
                   name and the type reader must stop here. The alias maps to
                   the Box template in `parse_inst_type`, which records the one
                   warning for this use. */
                if (self->lex->tok_is("box")) {
                    const char *bp = self->lex->src + self->lex->tokstart + 3;
                    int bd = 0, bclosed = 0;
                    while (*bp == ' ' || *bp == '\t') bp++;
                    if (*bp == '<') {
                        bp++;
                        while (*bp && *bp != '\n') {
                            if (*bp == '<') bd++;
                            else if (*bp == '>') {
                                if (bd == 0) { bclosed = 1; break; }
                                bd--;
                            }
                            bp++;
                        }
                    }
                    if (!bclosed) break;
                    if (frontend::sym::ct_tmpl_find("Box", self->cur_unit) < 0) break;
                    if (self->parse_inst_type(out, cap) != 0) return -1;
                    n = (int)strlen(out);
                    continue;
                }
                /* Phase 29: `Name<arg[, arg]>` names one monomorphised instance
                   of a generic struct; the reader lives in `parse_inst_type`. */
                if (frontend::sym::ct_tmpl_find(self->lex->tok_cstr(), self->cur_unit) >= 0) {
                    if (self->parse_inst_type(out, cap) != 0) return -1;
                    n = (int)strlen(out);
                    continue;
                }
                /* SH-76: when the builtin layer is not found, `Map<...>` used
                   to fall through as a plain name and the field parser then
                   reported "expected a field name". Name the real cause, and
                   refuse a bare builtin generic instead of emitting bad C. */
                {
                    const char *qp = self->lex->src + self->lex->tokstart
                                     + self->lex->tokstr.len;
                    while (*qp == ' ' || *qp == '\t') qp++;
                    if (*qp == '<' && (self->lex->tok_is("Vec")
                                       || self->lex->tok_is("Map")
                                       || self->lex->tok_is("Option")
                                       || self->lex->tok_is("Result"))) {
                        return self->sup->fail(runtime::text::ct_internf(
                                 "unresolved generic type '%.*s' (is the builtin layer missing? set CT_CORE_DIR, or the legacy CT_STD_DIR)",
                                 self->lex->tokstr.len, self->lex->tokstr.ptr));
                    }
                    if (self->lex->tok_is("Vec")
                        || self->lex->tok_is("Map")
                        || self->lex->tok_is("Option")
                        || self->lex->tok_is("Result")) {
                        return self->sup->fail(runtime::text::ct_internf(
                                 "generic struct '%.*s' needs type arguments in a type position",
                                 self->lex->tokstr.len, self->lex->tokstr.ptr));
                    }
                }
                /* A visible type alias expands before any name resolution: the
                   alias is a compile-time synonym, so the type spelling (and
                   therefore the host key) is the underlying one. */
                if (self->sym->find_type_alias(self->lex->tok_cstr()) >= 0) {
                    const char *etext;
                    if (self->sym->expand_type_alias_text(self->lex->tok_cstr(), &etext) != 0)
                        return self->sup->fail(self->sym->last_error());
                    if (self->type_append(out, cap, &n, etext) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                /* D21-1: a closure's return type comes from the declaration on
                   the left, so CT never infers one. `auto` is not a type name
                   here: refuse it instead of passing it through to `cc`, where
                   C99 would accept it as a storage class. */
                if (self->lex->tok_is("auto"))
                    return self->sup->fail("'auto' is not a type in CT (write the type explicitly)");
                /* S1a-0 C2o: once a type word has been read, a following name
                   longer than the old 160-byte row is the declarator, not a
                   second type word. Stop before the fixed `rname` lookup can
                   report "name is too long": the caller reads the whole token
                   into the symbol table. */
                if (n > 0 && self->lex->tokstr.len >= MAX_TEXT) break;
                rname = type_resolve_token(self);
                if (!rname) return -1;
                ti = self->sym->find_type(rname);
                if (ti < 0) {
                    /* A declared-but-not-imported alias must not fall through to
                       the opaque C spelling: the name means something in this
                       build, and silently emitting it would fail in `cc`. */
                    {
                        char apath[1024];
                        int aline = 0;
                        if (self->sym->find_global_type_alias(self->lex->tok_cstr(), apath,
                                                              sizeof apath, &aline) == 0) {
                            return self->sup->fail(runtime::text::ct_internf(
                                     "type alias '%s' is declared in %s:%d but this unit does not import it",
                                     self->lex->tok_cstr(), apath, aline));
                        }
                    }
                    /* A type name the unit has never seen (a typedef from a
                       header, such as `time_t`). It can only stand where a type
                       is expected, so the spelling is kept as written; the
                       cast / `sizeof` decision happens before this point, so
                       `(NAME) + x` is never turned into one. */
                    /* SH-60 / D-60-2: inside a `.m.ct` trait signature an
                       unknown bare name is not kept as an opaque C spelling.
                       It needs one of two kinds of evidence: a standard
                       typedef whose home header the unit includes, or a
                       `pub type` alias (already expanded above). A spelling
                       that is still only qualifiers after the unknown name
                       (`const TotallyBogus *`) is judged the same way, while
                       `int Foo` keeps `Foo` as the declaration's name. */
                    if (self->sup->map_sig
                        && (n == 0 || type_only_qualifiers(out))) {
                        if (!self->sup->map_std_typedef(self->lex->tok_cstr())) {
                            const char *umsg = runtime::text::ct_internf(
                                     "unknown type '%s' in a .m.ct trait signature; "
                                     "declare 'pub type %s = <C spelling>;' in this unit "
                                     "or include the header that typedefs it",
                                     self->lex->tok_cstr(), self->lex->tok_cstr());
                            if (!umsg) return self->sup->fail("out of memory");
                            return tool::diag::ct_sem_error(self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1,
                                umsg, self->sup->mem->path);
                        }
                        if (self->type_append(out, cap, &n, rname) != 0) return -1;
                        self->sup->lex_next();
                        continue;
                    }
                    if (n == 0) {
                        if (self->type_append(out, cap, &n, rname) != 0) return -1;
                        self->sup->lex_next();
                        continue;
                    }
                    break;
                }
                /* a bare struct / enum tag needs its keyword; a trait becomes
                   its iface. TypeRow.kind: 1 struct, 3 trait, 5 enum,
                   6 union, 7 ADT. S8B-REM-1 R8 / D4: same subject, five arms.
                   The 1/5/6/7 arms fall through to the shared tail below; the
                   trait arm writes its iface and continues. */
                match (self->sym->types[ti].kind) {
                    1 => {
                        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                        self->last_bare_tag = runtime::text::ct_internf("struct %s", rname);
                        if (!self->last_bare_tag) return self->sup->fail("out of memory");
                    }
                    5 => {
                        if (self->type_append(out, cap, &n, "enum") != 0) return -1;
                        self->last_bare_tag = runtime::text::ct_internf("enum %s", rname);
                        if (!self->last_bare_tag) return self->sup->fail("out of memory");
                    }
                    6 => {
                        if (self->type_append(out, cap, &n, "union") != 0) return -1;
                        self->last_bare_tag = runtime::text::ct_internf("union %s", rname);
                        if (!self->last_bare_tag) return self->sup->fail("out of memory");
                    }
                    7 => {
                        /* Phase 84: an ADT is emitted as `struct <tag>`; the tag is
                           the same one the ADT registry records. */
                        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                        self->last_bare_tag = runtime::text::ct_internf("struct %s", rname);
                        if (!self->last_bare_tag) return self->sup->fail("out of memory");
                    }
                    3 => {
                        int sti = self->sym->find_trait(rname);
                        self->saw_trait = 1;
                        if (sti >= 0 && self->sym->traits[sti].is_static)
                            return self->sup->fail("a static trait has no interface value");
                        if (sti >= 0 && self->sym->traits[sti].ntparams > 0) {
                            if (self->parse_trait_inst_type(out, cap) != 0) return -1;
                            n = (int)strlen(out);
                            continue;
                        }
                        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                        iface = runtime::text::ct_internf("%s_iface", rname);
                        if (!iface) return self->sup->fail("out of memory");
                        if (self->type_append(out, cap, &n, iface) != 0) return -1;
                        self->sup->lex_next();
                        continue;
                    }
                    _ => { }
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            if (!self->type_no_ptr && self->lex->tok == T_PUNCT
                && self->lex->tok_is("*")) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            break;
        }
        /* `ret (*name)(params)`: the declarator belongs to the type, so it is
           consumed here and the caller takes the name from `fnptr_name`. One
           level only -- a function pointer is not a return type and cannot nest
           (2b.4). A `(` that does not open `(*` is left alone: no other caller
           of `parse_type` can have one there. */
        if (!self->type_no_ptr
            && self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
            int save_tok, save_line, save_srcline, save_bol;
            long save_num;
            size_t save_pos;
            const char *save_text_ptr; int save_text_len;
            save_tok = self->lex->tok;
            save_num = self->lex->toknum;
            save_line = self->lex->tokline;
            save_pos = self->lex->pos;
            save_srcline = self->lex->line;
            save_bol = self->lex->bol;
            save_text_ptr = self->lex->tokstr.ptr; save_text_len = self->lex->tokstr.len;
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("*")) {
                /* S1a-0 C2p-4: the signature scratch is built as interned pool
                   texts, so a 2000-byte parameter type inside `(*)(...)` is not
                   cut at a 160-byte local. */
                const char *plist = "";
                const char *dname;
                const char *fdims = "";
                int pn;
                self->sup->lex_next();
                /* `int (**f)(int)` and `int (*(*f)(void))(int)` put a second
                   declarator where the name belongs: only one level is
                   supported, and the diagnostic says so (D-7). */
                if (self->lex->tok == T_PUNCT
                    && (self->lex->tok_is("*")
                        || self->lex->tok_is("(")))
                    return self->sup->fail("nested function pointers are not supported");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a name in the function-pointer declarator");
                /* keep the name here: parsing the parameter list below calls
                   `parse_type` again, which clears `fnptr_name` */
                dname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                     self->lex->tokstr.len);
                if (!dname) return self->sup->fail("out of memory");
                self->sup->lex_next();
                /* dimensions sit inside the declarator, before the `)`: a
                   function-pointer array (`int (*tbl[2])(int)`) (D-5) */
                while (self->lex->tok == T_PUNCT && self->lex->tok_is("[")) {
                    const char *dim;
                    int unsized;
                    unsized = 0;
                    self->sup->lex_next();
                    if (self->lex->tok == T_NUM) {
                        dim = runtime::text::ct_internf("[%ld]", self->lex->toknum);
                    } else if (self->lex->tok == T_ID) {
                        dim = runtime::text::ct_internf("[%.*s]", self->lex->tokstr.len,
                                                        self->lex->tokstr.ptr);
                    } else if (self->lex->tok == T_PUNCT && self->lex->tok_is("]")) {
                        dim = "[]";
                        unsized = 1;
                    } else {
                        return self->sup->fail("expected an array length");
                    }
                    if (!dim) return self->sup->fail("out of memory");
                    if (!unsized) self->sup->lex_next();
                    if (self->sup->expect("]") != 0) return -1;
                    fdims = runtime::text::ct_intern_join(fdims, dim);
                    if (!fdims) return self->sup->fail("out of memory");
                }
                if (self->sup->expect(")") != 0) return -1;
                if (self->sup->expect("(") != 0) return -1;
                pn = 0;
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")"))) {
                    for (;;) {
                        const char *pt;
                        const char *joiner;
                        /* A variadic tail belongs to the signature like any
                           other parameter (`int (*log)(const char *, ...)`), so
                           it is copied into the spelling; C requires a named
                           parameter before it, and it closes the list. */
                        if (self->lex->tok == T_PUNCT && self->lex->tok_is("...")) {
                            if (pn == 0 || strcmp(plist, "void") == 0)
                                return self->sup->fail("a variadic function pointer needs a named parameter before '...'");
                            plist = runtime::text::ct_intern_join(plist, ", ...");
                            if (!plist) return self->sup->fail("out of memory");
                            self->sup->lex_next();
                            break;
                        }
                        if (self->parse_type_text(&pt) != 0) return -1;
                        if (self->fnptr_state)
                            return self->sup->fail("nested function pointers are not supported");
                        if (self->lex->tok == T_ID) self->sup->lex_next();
                        joiner = (pn > 0) ? ", " : "";
                        plist = runtime::text::ct_intern_join(plist, joiner);
                        if (plist) plist = runtime::text::ct_intern_join(plist, pt);
                        if (!plist) return self->sup->fail("out of memory");
                        pn++;
                        if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                            self->sup->lex_next();
                            continue;
                        }
                        break;
                    }
                }
                if (self->sup->expect(")") != 0) return -1;
                if (pn == 0) plist = "void";
                {
                    const char *sig = runtime::text::ct_internf("(*)(%s)", plist);
                    if (!sig) return self->sup->fail("out of memory");
                    if (self->type_append(out, cap, &n, sig) != 0) return -1;
                }
                self->fnptr_name = dname;
                self->fnptr_dims = fdims;
                self->fnptr_state = 1;
            } else {
                self->lex->tok = save_tok;
                self->lex->toknum = save_num;
                self->lex->tokline = save_line;
                self->lex->pos = save_pos;
                self->lex->line = save_srcline;
                self->lex->bol = save_bol;
                self->lex->tokstr.ptr = save_text_ptr; self->lex->tokstr.len = save_text_len;
            }
        }
        if (n == 0) {
            /* D-029: a malformed functor spelling (`(int, int => int`) still
               writes the arrow on the declaration; name the shape instead of
               the generic "expected a type". */
            if (!self->type_no_ptr
                && self->lex->tok == T_PUNCT && self->lex->tok_is("(")
                && functor_arrow_on_line(self))
                return self->sup->fail("a functor type needs a '(A, B) => R' shape");
            return self->sup->fail(runtime::text::ct_internf(
                "expected a type (tok %d '%.*s')", self->lex->tok,
                self->lex->tokstr.len, self->lex->tokstr.ptr));
        }
        return 0;
    }

    /* S1a-0 C2p-3: the pool-text form. The old caller buffer was 160 bytes, so
       a 300-byte struct name stopped at "name is too long" before the symbol
       lookup ran. Here the reader writes into one formal-bound block, interns
       the finished spelling and hands back a pointer that outlives the call. */
    int parse_type_text(const char **out)
    {
        char *buf;
        const char *pooled;
        int rc;
        if (!out) return self->sup->fail("internal: parse_type_text without an output");
        *out = "";
        buf = (char *)malloc(TEXT_LIMIT);
        if (!buf) return self->sup->fail("out of memory");
        rc = self->parse_type(buf, TEXT_LIMIT);
        if (rc != 0) {
            free(buf);
            return rc;
        }
        pooled = runtime::text::ct_intern(buf);
        free(buf);
        if (!pooled) return self->sup->fail("out of memory");
        *out = pooled;
        return 0;
    }

    int parse_inst_type(char *out, int cap)
    {
        const char *tname;
        const char *enc;
        char **carg = 0;
        char **ctype = 0;
        const char *canon;
        const char *abuf;
        struct StructTmpl *tp;
        int ccap = 0, tccap = 0;
        int n, ti2, tn, nargs, nt2, pline, pcol;

        n = (int)strlen(out);
        /* LANG-24 Stage B: `box<T>` is a hard error; write `Box<T>`. */
        if (g_expr_inst_override) {
            tname = g_expr_inst_override;
            g_expr_inst_override = 0;
        } else {
            tname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!tname) return self->sup->fail("out of memory");
            self->sup->lex_next();
        }
        if (!tname[0]) return self->sup->fail("expected a generic type name");
        if (strcmp(tname, "box") == 0)
            return self->sup->fail("'box<T>' is no longer supported; write 'Box<T>'");
        ti2 = frontend::sym::ct_tmpl_find(tname, self->cur_unit);
        tp = frontend::sym::ct_tmpls(&tn);
        if (!tp || ti2 < 0) return self->sup->fail("internal: template row vanished");
        nt2 = tp[ti2].ntparams;
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is("<")) {
            return self->sup->fail(runtime::text::ct_internf(
                     tp[ti2].is_adt
                         ? "generic ADT '%s' needs type arguments in a type position"
                         : "generic struct '%s' needs type arguments in a type position",
                     tname));
        }
        self->sup->lex_next();
        nargs = 0;
        pline = 0;
        pcol = 1;
        for (;;) {
            carg = frontend::sym::ct_rows_reserve(carg, ccap, nargs + 1, &ccap);
            ctype = frontend::sym::ct_rows_reserve(ctype, tccap, nargs + 1, &tccap);
            if (!carg || ccap < nargs + 1 || !ctype || tccap < nargs + 1)
                return self->sup->fail("a generic struct has too many type arguments");
            if (nargs == 0) {
                pline = self->lex->tokline;
                pcol = self->lex->tokstart - self->lex->lstart + 1;
            }
            self->inst_canon = "";
            self->type_depth++;
            if (self->type_depth > 4) {
                self->type_depth--;
                return self->sup->fail("generic type arguments nest deeper than 4");
            }
            if (self->parse_type_text(&abuf) != 0) {
                self->type_depth--;
                return -1;
            }
            self->type_depth--;
            /* P-7.2 (P-4.1): a slice is a non-owning view and may not be a
               generic type argument (`Vec<int[]>`); the container stores
               elements by value and would outlive the view. Recognise the
               spelling before the generic-argument check so the diagnostic
               names the placement instead of "expected '>'". */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("[")) {
                int gl = self->lex->tokline;
                int gc = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("]"))
                    return tool::diag::ct_sem_error(gl, gc,
                        strcmp(tname, "Box") == 0
                            ? "a slice 'T[]' cannot be stored in Box<T>; it is a non-owning view"
                            : "a slice 'T[]' cannot be a generic type argument; it is a non-owning view",
                        self->sup->mem->path);
                return self->sup->fail("expected '>' after the type arguments");
            }
            if (!abuf[0] || strcmp(abuf, "void") == 0 || strchr(abuf, '[')
                || strchr(abuf, '(') || strchr(abuf, ')')
                || strncmp(abuf, "const ", 6) == 0
                || strncmp(abuf, "volatile ", 9) == 0) {
                return self->sup->fail(runtime::text::ct_internf(
                         "type argument '%s' cannot instantiate a generic struct", abuf));
            }
            /* S1a-0 C2p-3: exact rows, not 160-byte strides, so a 2000-byte
               type argument instantiates. */
            if (frontend::sym::ct_row_set(ctype, nargs, abuf) != 0)
                return self->sup->fail("out of memory");
            if (self->inst_canon && self->inst_canon[0]) {
                /* S20b: the argument is itself an instance (`Vec<int>` inside
                   `Map<char *, Vec<int>>`). Its identity is the C spelling the
                   nested instance was just given (`struct Vec_int`), so the
                   encoder sees one form here and in the nested `MapEntry`
                   registration -- encoding the source spelling would spell the
                   same type two ways (`Vec_lint_r` vs `Vec__int`). */
                if (frontend::sym::ct_row_set(carg, nargs, abuf) != 0)
                    return self->sup->fail("out of memory");
            } else {
                const char *cn = frontend::sym::ct_type_canon_text(abuf);
                if (!cn) return self->sup->fail("out of memory");
                if (frontend::sym::ct_row_set(carg, nargs, cn) != 0)
                    return self->sup->fail("out of memory");
            }
            nargs++;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        /* D29-2: `Box<Box<int>>` closes two type argument lists with one
           spelling. The lexer keeps `>>` as a single token; in a type position
           the first `>` closes this list and the cursor steps back one source
           character, so the closing `lex_next` re-reads the second `>` for the
           caller. The lexer itself is untouched. */
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(">>")) {
            self->lex->tokstr.ptr = self->lex->src + self->lex->tokstart + 1;
            self->lex->tokstr.len = 1;
            self->lex->pos = self->lex->pos - 1;
            self->lex->tokstart = self->lex->tokstart + 1;
        }
        if (self->lex->tok != T_PUNCT || !self->lex->tok_is(">"))
            return self->sup->fail("expected '>' after the type arguments");
        self->sup->lex_next();
        if (nargs != nt2) {
            /* S1a-0 C3: the arity is now the template's own count; over- and
               under-arity share one message so a user template and a built-in
               container are still judged by the same rule. */
            return self->sup->fail(runtime::text::ct_internf(
                     tp[ti2].is_adt
                         ? "generic ADT '%s' takes %d type arguments, %d given"
                         : "generic struct '%s' takes %d type arguments, %d given",
                     tname, nt2, nargs));
        }
        /* A type parameter used as a type argument stays symbolic: the instance
           is created when the surrounding template is itself instantiated, and
           the emitter resolves the substituted spelling then (D29-3). */
        {
            int gi, sym = 0;
            for (gi = 0; gi < nargs; gi++)
                if (expr_generic_param(self, carg[gi])) sym = 1;
            if (sym) {
                const char *raw = inst_spell(tname, nargs, carg);
                if (!raw) return self->sup->fail("out of memory");
                self->inst_canon = raw;
                self->last_bare_tag = raw;
                if (self->type_append(out, cap, &n, raw) != 0) return -1;
                return 0;
            }
        }
        /* L29-8 (D29-9): the built-in `Map` compares keys by content and has no
           `Hash` / `Eq` bound to widen that, so the key whitelist is enforced
           here, before an instance is registered or any C is emitted. A key
           outside it would otherwise be compared by whatever the generic block
           happens to do, which is how `long` used to reach `strcmp`.
           PH-47 L47-1: `Str` joins the roster. A struct type argument is
           canonicalized as `struct Str`, so that spelling is what the check
           sees; the message lists all four key types so a rejected spelling
           names its alternatives. */
        /* PH-80 (D-013): the owning key type is `String`. The borrowed `Str` is a
           storage position and is refused before the generic check so the
           message names the migration, not a generic whitelist. */
        if (strcmp(tname, "Map") == 0 && nargs >= 1
            && strcmp(carg[0], "struct Str") == 0) {
            return self->sup->fail(
                "Map key type 'Str' is a borrowed view; use 'String' (owning)");
        }
        if (strcmp(tname, "Map") == 0 && nargs >= 1
            && strcmp(carg[0], "int") != 0 && strcmp(carg[0], "long") != 0
            && strcmp(carg[0], "char*") != 0 && strcmp(carg[0], "struct String") != 0) {
            return self->sup->fail(runtime::text::ct_internf(
                     "Map does not support key type '%s' (key types: int, long, char *, String)",
                     carg[0]));
        }
        /* v1-PH-2 S6b: a shadowing template encodes its instances with the
           `__adt` base, so the built-in `Option_int` / `Result_int_char_p` and
           the user's layout never share a C tag. */
        enc = frontend::sym::ct_inst_encode_text(
                  (tp[ti2].shadow && tp[ti2].cbase) ? tp[ti2].cbase : tname,
                  nargs, carg);
        if (!enc) return self->sup->fail("out of memory");
        if (self->inst_make(tname, nargs, carg, ctype,
                            &enc, 0, pline, pcol) != 0)
            return -1;
        self->last_bare_tag = runtime::text::ct_internf("struct %s", enc);
        if (!self->last_bare_tag) return self->sup->fail("out of memory");
        canon = inst_spell(tname, nargs, carg);
        if (!canon) return self->sup->fail("out of memory");
        self->inst_canon = canon;
        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
        if (self->type_append(out, cap, &n, enc) != 0) return -1;
        return 0;
    }

    /* S1a-0 C2p-3: the pool-text form of the generic instance reader. */
    int parse_inst_type_text(const char **out)
    {
        char *buf;
        const char *pooled;
        int rc;
        if (!out) return self->sup->fail("internal: parse_inst_type_text without an output");
        *out = "";
        buf = (char *)malloc(TEXT_LIMIT);
        if (!buf) return self->sup->fail("out of memory");
        buf[0] = 0;                 /* parse_inst_type appends to `out` */
        rc = self->parse_inst_type(buf, TEXT_LIMIT);
        if (rc != 0) {
            free(buf);
            return rc;
        }
        pooled = runtime::text::ct_intern(buf);
        free(buf);
        if (!pooled) return self->sup->fail("out of memory");
        *out = pooled;
        return 0;
    }
}
