#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprTry {
    int unused;
}


impl ExprTry for Expr {
    int q_suffix_ahead(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, sfloat, strunc;
        long snum;
        const char *stext_ptr; int stext_len;
        const char *ssuf_ptr; int ssuf_len;
        int r;

        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        sfloat = self->lex->tokfloat;
        strunc = self->lex->toktrunc;
        stext_ptr = self->lex->tokstr.ptr; stext_len = self->lex->tokstr.len;
        ssuf_ptr = self->lex->toksuffix.ptr; ssuf_len = self->lex->toksuffix.len;
        self->sup->lex_next();          /* the token after the `?` */
        r = 1;
        if (self->lex->tok == T_ID || self->lex->tok == T_NUM
            || self->lex->tok == T_STR) {
            r = 0;
        } else if (self->lex->tok == T_PUNCT) {
            /* `&&` / `||` cannot start an expression either, but the design's
               disambiguation table rules them ternary (a missing `:` is the
               report a user sees, not a silently shifted operator). */
            if (self->lex->tok_is("(") || self->lex->tok_is("-")
                || self->lex->tok_is("!") || self->lex->tok_is("~")
                || self->lex->tok_is("&") || self->lex->tok_is("*")
                || self->lex->tok_is("++") || self->lex->tok_is("--")
                || self->lex->tok_is("&&") || self->lex->tok_is("||"))
                r = 0;
        }
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokfloat = sfloat;
        self->lex->toktrunc = strunc;
        self->lex->tokstr.ptr = stext_ptr; self->lex->tokstr.len = stext_len;
        self->lex->toksuffix.ptr = ssuf_ptr; self->lex->toksuffix.len = ssuf_len;
        return r;
    }

    const char *result_tag_text(const char *ctype)
    {
        const char *buf;
        size_t n;
        int inst, ninst;
        struct StructInst *ins;

        (void)self;
        if (!ctype || !ctype[0]) return (const char *)0;
        n = strlen(ctype);
        while (n > 0 && (ctype[n - 1] == ' ' || ctype[n - 1] == '*')) {
            if (ctype[n - 1] == '*') return (const char *)0;
            n--;
        }
        if (n == 0) return (const char *)0;
        buf = ctype;
        if (strncmp(buf, "struct ", 7) == 0) {
            buf += 7;
            n -= 7;
        } else if (strncmp(buf, "union ", 6) == 0 || strncmp(buf, "enum ", 5) == 0)
            return (const char *)0;
        buf = runtime::text::ct_intern_len(buf, (int)n);
        if (!buf) return (const char *)0;
        inst = frontend::sym::ct_inst_find(buf);
        if (inst < 0) return (const char *)0;
        ins = frontend::sym::ct_insts(&ninst);
        if (!ins || inst >= ninst) return (const char *)0;
        if (strcmp(ins[inst].tmpl, "Result") != 0 || ins[inst].nargs != 2)
            return (const char *)0;
        return buf;
    }

    int result_tag(const char *ctype, char *tag, int cap)
    {
        const char *t = self->result_tag_text(ctype);

        if (!t) return 0;
        if (snprintf(tag, (size_t)cap, "%s", t) >= cap) return 0;
        return 1;
    }

    const char *result_cols_text(int inst, const char **err)
    {
        int ninst;
        struct StructInst *ins;

        (void)self;
        if (err) *err = "";
        ins = frontend::sym::ct_insts(&ninst);
        if (!ins || inst < 0 || inst >= ninst) return (const char *)0;
        if (strcmp(ins[inst].tmpl, "Result") != 0 || ins[inst].nargs != 2)
            return (const char *)0;
        if (err) *err = ins[inst].carg[1];
        return ins[inst].ctype[0];
    }

    int result_cols(int inst, char *val, int vcap, char *err, int ecap)
    {
        const char *v, *e;

        v = self->result_cols_text(inst, &e);
        if (!v) return 0;
        if (snprintf(val, (size_t)vcap, "%s", v) >= vcap) return 0;
        if (snprintf(err, (size_t)ecap, "%s", e) >= ecap) return 0;
        return 1;
    }
}
