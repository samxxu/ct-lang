/*
 * ExprTypeText.h.ct - moved out of Expr.h.ct (PH-85 S85c M0, pure move).
 *
 * Bodies are byte-identical to the ones this unit used to hold;
 * the declaration line only loses `static` and gains a `pub`
 * prototype, the interface change the M0 card allows. See
 * docs/design/p85_m0.md for the baseline and the old->new map.
 */

#include "ExprTypeText.shim.h"
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import runtime::text::Intern;
import tool::diag::Diag;
import tool::sh::Sh;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
/* D-028: the N_IMPL method chain holds N_METHOD nodes (cap mirror; the kind
   number is runtime::arena::Arena::NodeKind's). */
#define N_METHOD 29

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprTypeText {
    int unused;
}

pub int arg_class(const char *formal, const char *actual, char *fb, int fcap, char *ab, int acap);
pub int arg_class_text(const char *formal, const char *actual, const char **fb, const char **ab);
pub const char *tbase_text(const char *k);
pub const char *tnorm_text(const char *in);
pub int id_char(int c);
pub int inst_impl_score(int ii);
pub int plist_next(const char *p, int *pos, char *out, int cap);
/* S1a-0 C2p-10: the same comma-separated item as an interned text, so a
   2000-byte function-pointer parameter type is kept whole. */
pub const char *plist_next_text(const char *p, int *pos);
pub int qual_at(const char *p, int prev_id);
pub int ref_type_is_const_value(const char *t);
pub int slice_array_len(const char *dims);
pub int subst_tparam(const char *spell, char **names, char **vals, int n, char *out, int cap);
/* D-028: the C-symbol suffix of an overloaded inherent method. `count` / `pos`
   read an N_IMPL's method chain in declaration order; `key_text` turns one
   type spelling into the injective identifier fragment used after `$`. */
pub int ct_overload_count(int impl_node, const char *name);
pub int ct_overload_pos(int impl_node, int m);
pub const char *ct_overload_key_text(const char *type);
/* S1a-0 C2p-10: the substitution as an interned text (NULL when the spelling
   mentions a parameter in a shape the restricted rule cannot decide). */
pub const char *subst_tparam_text(const char *spell, char **names, char **vals, int n);
pub void tbase(const char *k, char *out, int cap);
pub int tclass(const char *raw, const char *base);
pub void tnorm(const char *in, char *out, int cap);
pub int tnumeric(const char *in);
pub int tscalar(const char *w);
pub int tstars(const char *k);

/* Compare one formal against one actual: 0 compatible, 1 a confident
   mismatch, -1 undecidable, 2 a struct-against-struct pair the caller must
   resolve through its own struct table (the normalised bases are handed back
   in `fb` / `ab`, tag included). */
/* S1a-0 C2p-9: the comparison keys and the returned bases are pool texts.
   The old `tnorm` / `tbase` calls cut a 2000-byte spelling at 160 bytes
   before the class test, so a long type could take the wrong branch. */
const char *tnorm_text(const char *in)
{
    char *buf = 0;
    int cap = 0, prev, q;
    const char *pooled;
    char one[2];

    if (tool::sh::ct_text_init(&buf, &cap, 64) != 0) return (const char *)0;
    prev = 0;
    while (*in) {
        q = qual_at(in, prev);
        if (q) {
            in += q;
            continue;                       /* the boundary stands */
        }
        if (*in != ' ' && *in != '\t' && *in != '\n' && *in != '\r') {
            one[0] = *in;
            one[1] = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto fail;
        }
        prev = id_char((unsigned char)*in);
        in++;
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

const char *tbase_text(const char *k)
{
    char *buf = 0;
    int cap = 0;
    const char *pooled;
    char one[2];

    if (tool::sh::ct_text_init(&buf, &cap, 64) != 0) return (const char *)0;
    while (*k) {
        if (*k != '*') {
            one[0] = *k;
            one[1] = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto fail;
        }
        k++;
    }
    pooled = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return pooled;
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

pub int arg_class_text(const char *formal, const char *actual, const char **fb, const char **ab)
{
    const char *fk, *ak;
    int fd, ad, cf, ca;

    if (fb) *fb = "";
    if (ab) *ab = "";
    fk = tnorm_text(formal);
    ak = tnorm_text(actual);
    if (!fk || !ak || !fk[0] || !ak[0]) return -1;
    if (strcmp(fk, ak) == 0) return 0;
    if (strchr(fk, '(') || strchr(ak, '(')) return -1;    /* a function pointer */
    if (fb) *fb = tbase_text(fk);
    if (ab) *ab = tbase_text(ak);
    if (!fb || !ab || !*fb || !*ab || !(*fb)[0] || !(*ab)[0]) return -1;
    cf = tclass(formal, *fb);
    ca = tclass(actual, *ab);
    if (cf < 0 || ca < 0) return -1;
    if (cf == 2 || ca == 2) return -1;                    /* unions: no table */
    fd = tstars(fk);
    ad = tstars(ak);
    if (fd != ad) {
        if (cf == 3 && fd > 0 && ad > 0) return 0;
        if (ca == 3 && ad > 0 && fd > 0) return 0;
        return 1;
    }
    if (cf == 3 || ca == 3) return fd > 0 ? 0 : -1;
    if (cf == 0 && ca == 0) return 0;
    if (cf != ca) return 1;
    return 2;
}

int arg_class(const char *formal, const char *actual,
                     char *fb, int fcap, char *ab, int acap)
{
    const char *f, *a;
    int r = arg_class_text(formal, actual, &f, &a);
    if (fb) fb[0] = 0;
    if (ab) ab[0] = 0;
    if (r < 0) return r;
    if (snprintf(fb, (size_t)fcap, "%s", f) >= fcap) return -1;
    if (snprintf(ab, (size_t)acap, "%s", a) >= acap) return -1;
    return r;
}

int id_char(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

/* PH-80 (D-013): choose the most specific matching inherent block for an
   instance method. The generic `impl<K,V> Map<K,V>` is declared first in
   the layer, so a concrete key block (`Map<char *,V>`, `Map<Str,V>`,
   `Map<String,V>`) declared later must win; the count of concrete pattern
   positions is that specificity. */
int inst_impl_score(int ii)
{
    int i, j, s, tp;
    struct StructImpl *im;
    int nimpls;
    im = frontend::sym::ct_impls(&nimpls);
    if (!im || ii < 0 || ii >= nimpls) return 0;
    s = 0;
    for (i = 0; i < im[ii].nargs; i++) {
        tp = 0;
        for (j = 0; j < im[ii].ntparams; j++)
            if (im[ii].tparam[j] && strcmp(im[ii].pat[i], im[ii].tparam[j]) == 0) tp = 1;
        if (!tp) s++;
    }
    return s;
}

/* Read the next comma-separated item of a function pointer's parameter text
   (`parse_type` writes the list without parameter names) into `out`, trimming
   its surrounding spaces. Returns 0 once the list is exhausted. */
int plist_next(const char *p, int *pos, char *out, int cap)
{
    int i, n;

    i = *pos;
    while (p[i] == ' ' || p[i] == '\t') i++;
    if (!p[i]) return 0;
    n = 0;
    while (p[i] && p[i] != ',') {
        if (n + 1 < cap) out[n++] = p[i];
        i++;
    }
    out[n] = 0;
    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '\t')) out[--n] = 0;
    if (p[i] == ',') i++;
    *pos = i;
    return 1;
}

/* The qualifier word at `p`, or 0. A qualifier is recognised only at a word
   boundary, so a tag such as `constable` keeps its first five letters. */
int qual_at(const char *p, int prev_id)
{
    if (prev_id) return 0;
    if (strncmp(p, "__restrict__", 12) == 0 && !id_char(p[12])) return 12;
    if (strncmp(p, "__restrict", 10) == 0 && !id_char(p[10])) return 10;
    if (strncmp(p, "volatile", 8) == 0 && !id_char(p[8])) return 8;
    if (strncmp(p, "restrict", 8) == 0 && !id_char(p[8])) return 8;
    if (strncmp(p, "const", 5) == 0 && !id_char(p[5])) return 5;
    return 0;
}

/* Phase 78 fix SH-95: a top-level `const` object is not writable. `const int
   g` is rejected, while `const int *p` (pointer to const, itself writable) is
   left to the type check: the star means the qualifier is on the pointee. */
int ref_type_is_const_value(const char *t)
{
    if (!t || strncmp(t, "const ", 6) != 0) return 0;
    return strchr(t, '*') == NULL;
}

/* P-7.2: the literal length of a one-dimensional `[N]` spelling, or -1 when
   the dimension is `[]`, an expression or multi-dimensional. The compile-time
   subslice check only fires on the unambiguous case. */
int slice_array_len(const char *dims)
{
    int v = 0;
    int i = 0;
    if (!dims || dims[0] != '[') return -1;
    i = 1;
    if (dims[i] < '0' || dims[i] > '9') return -1;
    while (dims[i] >= '0' && dims[i] <= '9') {
        v = v * 10 + (dims[i] - '0');
        i++;
    }
    if (dims[i] != ']' || dims[i + 1] != 0) return -1;
    return v;
}

/* Phase 32 S7: a formal spelled exactly `T` / `U` (or `T *` / `U *`) takes
   the instance's concrete spelling. Any other shape that mentions a type
   parameter is undecidable here, so the caller skips it (the card's
   restricted substitution); a formal that mentions no parameter passes
   through unchanged. */
int subst_tparam(const char *spell, char **names, char **vals, int n,
                 char *out, int cap)
{
    const char *k;
    char *kbuf = 0;
    int kcap = 0, i;
    char one[2];

    /* only blanks are removed here (the original rule); qualifiers stay, so
       `const T` is still an "undecidable" spelling rather than a match */
    if (tool::sh::ct_text_init(&kbuf, &kcap, 64) != 0) return -1;
    for (i = 0; spell[i]; i++) {
        if (spell[i] == ' ' || spell[i] == '\t') continue;
        one[0] = spell[i];
        one[1] = 0;
        if (tool::sh::ct_text_cat(&kbuf, &kcap, one) != 0) {
            tool::sh::ct_text_free(&kbuf, &kcap);
            return -1;
        }
    }
    k = runtime::text::ct_intern(kbuf);
    tool::sh::ct_text_free(&kbuf, &kcap);
    if (!k) return -1;
    for (i = 0; i < n; i++) {
        const char *nv = names && names[i] ? names[i] : "";
        const char *vv = vals && vals[i] ? vals[i] : "";
        const char *p;
        if (!nv[0]) continue;
        if (strcmp(k, nv) == 0) { snprintf(out, (size_t)cap, "%s", vv); return 0; }
        p = runtime::text::ct_internf("%s*", nv);
        if (!p) return -1;
        if (strcmp(k, p) == 0) { snprintf(out, (size_t)cap, "%s *", vv); return 0; }
    }
    for (i = 0; i < n; i++) {
        const char *nv = names && names[i] ? names[i] : "";
        if (nv[0] && strstr(k, nv)) return -1;
    }
    snprintf(out, (size_t)cap, "%s", spell);
    return 0;
}

/* The normalised spelling without its stars: `struct S *` -> `struct S`. */
void tbase(const char *k, char *out, int cap)
{
    int n = 0;
    while (*k) {
        if (*k != '*') {
            if (n + 2 >= cap) {
                out[0] = 0;
                return;
            }
            out[n] = *k;
            n++;
        }
        k++;
    }
    out[n] = 0;
}

/* 0 numeric, 1 struct, 2 union, 3 void, -1 anything else (a typedef name
   stays unknown). `base` is the normalised star-less spelling, `raw` the
   spelling as written -- the tag prefix is read from `raw` so a typedef
   called `structor` is not mistaken for a struct. */
int tclass(const char *raw, const char *base)
{
    if (strcmp(base, "void") == 0) return 3;
    while (*raw == ' ') raw++;
    if (strncmp(raw, "struct ", 7) == 0) return 1;
    if (strncmp(raw, "union ", 6) == 0) return 2;
    if (strncmp(raw, "enum ", 5) == 0) return 0;
    if (tnumeric(raw)) return 0;
    return -1;
}

/* Normalise a type spelling: drop the qualifier words and every whitespace
   character. `const char *` and `char *` then compare equal, while
   `const char *` and `char **` still differ. */
void tnorm(const char *in, char *out, int cap)
{
    int n, prev, q;
    n = 0;
    prev = 0;
    while (*in) {
        q = qual_at(in, prev);
        if (q) {
            in += q;
            continue;                       /* the boundary stands */
        }
        if (*in != ' ' && *in != '\t' && *in != '\n' && *in != '\r') {
            if (n + 2 >= cap) {
                out[0] = 0;
                return;
            }
            out[n] = *in;
            n++;
        }
        prev = id_char((unsigned char)*in);
        in++;
    }
    out[n] = 0;
}

/* Every whitespace-or-star separated word of the raw spelling is a scalar
   keyword (`unsigned long`, `const char *`). */
int tnumeric(const char *in)
{
    int any = 0;
    for (;;) {
        const char *start;
        char *tok;
        while (*in == ' ' || *in == '\t' || *in == '*') in++;
        if (!*in) break;
        start = in;
        while (*in && *in != ' ' && *in != '\t' && *in != '*') in++;
        tok = tool::sh::ct_scratch_fmt("%.*s", (int)(in - start), start);
        if (!tscalar(tok)) return 0;
        any = 1;
    }
    return any;
}

/* One word of the numeric class: a C scalar keyword or a qualifier (the
   tokeniser sees the raw spelling, where qualifiers still appear). */
int tscalar(const char *w)
{
    return strcmp(w, "void") == 0 || strcmp(w, "char") == 0
        || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
        || strcmp(w, "long") == 0 || strcmp(w, "float") == 0
        || strcmp(w, "double") == 0 || strcmp(w, "signed") == 0
        || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0
        || strcmp(w, "bool") == 0 || strcmp(w, "size_t") == 0
        || strcmp(w, "ssize_t") == 0 || strcmp(w, "ptrdiff_t") == 0
        || strcmp(w, "wchar_t") == 0 || strcmp(w, "va_list") == 0
        || strcmp(w, "int8_t") == 0 || strcmp(w, "int16_t") == 0
        || strcmp(w, "int32_t") == 0 || strcmp(w, "int64_t") == 0
        || strcmp(w, "uint8_t") == 0 || strcmp(w, "uint16_t") == 0
        || strcmp(w, "uint32_t") == 0 || strcmp(w, "uint64_t") == 0
        || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0
        || strcmp(w, "const") == 0 || strcmp(w, "volatile") == 0
        || strcmp(w, "restrict") == 0 || strcmp(w, "__restrict") == 0
        || strcmp(w, "__restrict__") == 0;
}

int tstars(const char *k)
{
    int n = 0;
    while (*k) {
        if (*k == '*') n++;
        k++;
    }
    return n;
}

const char *plist_next_text(const char *p, int *pos)
{
    int i, n, start;

    i = *pos;
    while (p[i] == ' ' || p[i] == '\t') i++;
    if (!p[i]) return (const char *)0;
    start = i;
    while (p[i] && p[i] != ',') i++;
    n = i;
    while (n > start && (p[n - 1] == ' ' || p[n - 1] == '\t')) n--;
    if (p[i] == ',') i++;
    *pos = i;
    return runtime::text::ct_intern_len(p + start, n - start);
}

const char *subst_tparam_text(const char *spell, char **names, char **vals, int n)
{
    const char *k;
    char *kbuf = 0;
    int kcap = 0, i;
    char one[2];

    if (tool::sh::ct_text_init(&kbuf, &kcap, 64) != 0) return (const char *)0;
    for (i = 0; spell[i]; i++) {
        if (spell[i] == ' ' || spell[i] == '\t') continue;
        one[0] = spell[i];
        one[1] = 0;
        if (tool::sh::ct_text_cat(&kbuf, &kcap, one) != 0) {
            tool::sh::ct_text_free(&kbuf, &kcap);
            return (const char *)0;
        }
    }
    k = runtime::text::ct_intern(kbuf);
    tool::sh::ct_text_free(&kbuf, &kcap);
    if (!k) return (const char *)0;
    for (i = 0; i < n; i++) {
        const char *nv = names && names[i] ? names[i] : "";
        const char *vv = vals && vals[i] ? vals[i] : "";
        const char *p;
        if (!nv[0]) continue;
        if (strcmp(k, nv) == 0) return vv;
        p = runtime::text::ct_internf("%s*", nv);
        if (!p) return (const char *)0;
        if (strcmp(k, p) == 0) return runtime::text::ct_internf("%s *", vv);
    }
    for (i = 0; i < n; i++) {
        const char *nv = names && names[i] ? names[i] : "";
        if (nv[0] && strstr(k, nv)) return (const char *)0;
    }
    return runtime::text::ct_intern(spell);
}

/* D-028: how many methods of `impl_node` carry `name`, and which of them is
   `m`. Declaration order is the method chain order (`impl` appends), so the
   first overload keeps the old `<T>_<name>` symbol. */
int ct_overload_count(int impl_node, const char *name)
{
    struct Arena *ar;
    int m, n;

    ar = runtime::arena::arena_get();
    if (!ar || impl_node < 0 || impl_node >= ar->nnode || !name) return 0;
    n = 0;
    for (m = ar->nodes[impl_node].a; m >= 0; m = ar->nodes[m].next)
        if (ar->nodes[m].kind == N_METHOD
            && ar->nodes[m].text2 && strcmp(ar->nodes[m].text2, name) == 0)
            n++;
    return n;
}

int ct_overload_pos(int impl_node, int m)
{
    struct Arena *ar;
    int k, pos;

    ar = runtime::arena::arena_get();
    if (!ar || impl_node < 0 || impl_node >= ar->nnode || m < 0 || m >= ar->nnode)
        return -1;
    if (!ar->nodes[m].text2) return -1;
    pos = -1;
    for (k = ar->nodes[impl_node].a; k >= 0; k = ar->nodes[k].next) {
        if (ar->nodes[k].kind != N_METHOD) continue;
        if (!ar->nodes[k].text2
            || strcmp(ar->nodes[k].text2, ar->nodes[m].text2) != 0)
            continue;
        pos++;
        if (k == m) return pos;
    }
    return -1;
}

/* D-028: `type_key` -> one identifier fragment. `[A-Za-z0-9]` is kept, every
   other byte is `_hh` (lower-case hex), which is injective and cannot collide
   with a user spelling the way a plain `_` replacement could. A key whose
   encoding would exceed 120 bytes falls back to `h` + FNV-1a 32-bit, so a
   pathological 2000-byte type does not put a 6000-byte symbol into every call
   site. The result is pooled: callers only compare/concatenate it. */
const char *ct_overload_key_text(const char *type)
{
    const char *key;
    const char *hex = "0123456789abcdef";
    char *buf = 0;
    int cap = 0, i, enc_len = 0;
    char one[2];
    char hexb[4];
    unsigned int h;

    key = frontend::type::type_key_text(type ? type : "");
    if (!key) return (const char *)0;
    if (tool::sh::ct_text_init(&buf, &cap, 32) != 0) return (const char *)0;
    for (i = 0; key[i]; i++) {
        unsigned char c = (unsigned char)key[i];
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
            || (c >= '0' && c <= '9')) {
            one[0] = (char)c;
            one[1] = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, one) != 0) goto fail;
            enc_len += 1;
        } else {
            hexb[0] = '_';
            hexb[1] = hex[(c >> 4) & 15];
            hexb[2] = hex[c & 15];
            hexb[3] = 0;
            if (tool::sh::ct_text_cat(&buf, &cap, hexb) != 0) goto fail;
            enc_len += 3;
        }
        if (enc_len > 120) break;
    }
    if (enc_len > 120) {
        h = 2166136261u;
        for (i = 0; key[i]; i++) {
            h ^= (unsigned int)(unsigned char)key[i];
            h *= 16777619u;
        }
        free(buf);
        buf = 0;
        cap = 0;
        if (tool::sh::ct_text_init(&buf, &cap, 16) != 0) return (const char *)0;
        if (tool::sh::ct_text_cat(&buf, &cap, tool::sh::ct_scratch_fmt("h%08x", h)) != 0)
            goto fail;
    }
    {
        const char *pooled = runtime::text::ct_intern(buf);
        tool::sh::ct_text_free(&buf, &cap);
        return pooled;
    }
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}
