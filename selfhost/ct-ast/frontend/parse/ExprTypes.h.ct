/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 8192
#define MAX_CALLS_MAX 65536
#define MAX_FUNCS 512
#define MAX_FUNCS_MAX 65536
#define MAX_ARG_POS 32
#define MAX_ARG_POS_MAX 65536
#define MAX_GENERIC_INSTS 64
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
#define N_MATSEQ 73
#define N_NEWOBJ 77
#define N_INTO 63
#define N_INTO_SELF 64
#define N_TRY 71
#define N_ADTCTOR 81
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_OPT 72
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprTypes {
    int unused;
}

pub int closure_match(struct Expr *self, int ci, const char *host, int skip_env, int set_ret)
{
    struct Closure *c = &self->sym->closures[ci];
    char ret[MAX_TEXT];
    char plist[MAX_TEXT];
    char item[MAX_TEXT];
    const char *p;
    size_t n, hn;
    int lp, rp, pos, want, i, r;

    p = strstr(host, "(*");
    if (!p || p == host)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    n = (size_t)(p - host);
    while (n > 0 && (host[n - 1] == ' ' || host[n - 1] == '\t')) n--;
    if (n == 0 || n >= MAX_TEXT)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    snprintf(ret, sizeof ret, "%.*s", (int)n, host);
    hn = strlen(host);
    lp = -1;
    rp = -1;
    for (n = 0; n < hn; n++) {
        if (host[n] == '(') lp = (int)n;
        else if (host[n] == ')') rp = (int)n;
    }
    if (lp < 0 || rp <= lp + 1)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    snprintf(plist, sizeof plist, "%.*s", rp - lp - 1, host + lp + 1);
    if (skip_env) {
        char *comma = strchr(plist, ',');
        if (comma) snprintf(plist, sizeof plist, "%s", comma + 1);
        else plist[0] = 0;
    }
    want = 0;
    if (!(strcmp(plist, "void") == 0 || plist[0] == 0)) {
        pos = 0;
        while (plist_next(plist, &pos, item, sizeof item)) want++;
    }
    if (want != c->nparams) {
        char msg[512];
        snprintf(msg, sizeof msg,
                 "this closure takes %d parameters, but the expected type takes %d",
                 c->nparams, want);
        return self->sup->fail_at(c->line, msg);
    }
    pos = 0;
    i = 0;
    while (plist_next(plist, &pos, item, sizeof item)) {
        char fb[MAX_TEXT], ab[MAX_TEXT];
        int fs, as;
        r = arg_class(item, c->ptype[i], fb, sizeof fb, ab, sizeof ab);
        if (r == 2) {
            fs = self->sym->find_struct(fb + 6);
            as = self->sym->find_struct(ab + 6);
            r = (fs < 0 || as < 0) ? -1 : (fs != as);
        }
        if (r == 1) {
            char msg[512];
            snprintf(msg, sizeof msg,
                     "this closure's parameter %d is '%s', but the expected type is '%s'",
                     i + 1, c->ptype[i], item);
            return self->sup->fail_at(c->line, msg);
        }
        i++;
    }
    if (set_ret) snprintf(c->ret, MAX_TEXT, "%s", ret);
    return 0;
}

pub int str_handle_value(struct Expr *self, int e, char *base, int cap)
{
    char ty[MAX_TEXT];
    const char *p;
    size_t n;

    if (base != 0 && cap > 0) base[0] = 0;
    if (e < 0 || base == 0 || cap < 2) return 0;
    if (self->arena->nodes[e].kind == N_CAST) return 0;
    if (self->sup->expr_type(e, ty, sizeof ty) != 0) return 0;
    p = ty;
    while (*p == ' ' || *p == '\t') p++;
    if (strncmp(p, "struct ", 7) == 0) p += 7;
    n = strlen(p);
    while (n > 0 && (p[n - 1] == ' ' || p[n - 1] == '\t')) n--;
    if (n == 0 || n >= (size_t)cap || memchr(p, '*', n) != 0) return 0;
    memcpy(base, p, n);
    base[n] = 0;
    if (strcmp(base, "String") == 0 || strcmp(base, "Str") == 0
        || strcmp(base, "U16String") == 0 || strcmp(base, "U16Str") == 0)
        return 1;
    base[0] = 0;
    return 0;
}

pub int chk_type_static(struct Expr *self, int n, char *out, int cap)
{
    int ad;
    if (!self->static_ctype(n, out, cap, &ad, 0)) return -1;
    if (ad != 0) return -1;
    return 0;
}

impl ExprTypes for Expr {
    /* SH-115: judge a call through a function pointer. The callee's spelling
       carries its prototype (`RET (*)(params)`), so the same kernel the named
       call path uses applies here: `chk_type` for each actual, then
       `chk_assignable(diag=6)`, and `arity_warn` for a count that cannot
       match. `...` accepts extra actuals. A spelling without `(*)`, or a
       prototype the tables cannot pin, answers 0 and the call stays silent
       (D32-4's "undecidable is not an error"). */
    int chk_callptr_args(const char *ftype, const char *callee, int args,
                         int line, int col)
    {
        char ps[MAX_TEXT];
        const char *last;
        const char *lp;
        int plen, ai, k, variadic;

        if (!self->types_mode || !*self->types_mode) return 0;
        if (!ftype || strstr(ftype, "(*)") == 0) return 0;
        last = strrchr(ftype, ')');
        if (!last) return 0;
        lp = last;
        while (lp > ftype && *lp != '(') lp--;
        if (*lp != '(' || last <= lp + 1) return 0;
        plen = (int)(last - lp - 1);
        if (plen >= (int)sizeof ps) plen = (int)sizeof ps - 1;
        memcpy(ps, lp + 1, (size_t)plen);
        ps[plen] = 0;
        ai = (args == 0) ? -1 : args;
        k = 0;
        variadic = 0;
        while (ps[0]) {
            char pt[MAX_TEXT];
            int n = 0;
            char *pp = ps;
            while (*pp == ' ') pp++;
            if (strncmp(pp, "...", 3) == 0) { variadic = 1; break; }
            while (*pp && *pp != ',') {
                if (n < (int)sizeof pt - 1) pt[n++] = *pp;
                pp++;
            }
            pt[n] = 0;
            while (n > 0 && pt[n - 1] == ' ') pt[--n] = 0;
            if (*pp == ',') pp++;
            memmove(ps, pp, strlen(pp) + 1);
            if (strcmp(pt, "void") == 0 && ai < 0) break;
            if (ai < 0) {
                char amsg[MAX_TEXT];
                snprintf(amsg, sizeof amsg, "takes more arguments, %d given", k);
                if (self->sup->arity_warn(line, col, callee, amsg) != 0) return -1;
                break;
            }
            if (pt[0]) {
                char out[MAX_TEXT];
                int z = 0;
                if (self->chk_type(ai, out, sizeof out, &z) == 0) {
                    if (self->arg_base + k < self->argcap) {
                        self->chk_line = self->arg_line[self->arg_base + k];
                        self->chk_col = self->arg_col[self->arg_base + k];
                    } else {
                        self->chk_line = line;
                        self->chk_col = col;
                    }
                    self->chk_arg = k + 1;
                    if (self->chk_assignable(pt, out, z, 6) != 0) return -1;
                }
            }
            k++;
            ai = self->arena->nodes[ai].next;
        }
        if (!variadic && ai >= 0) {
            char amsg[MAX_TEXT];
            snprintf(amsg, sizeof amsg, "takes fewer arguments, %d given", k + 1);
            if (self->sup->arity_warn(line, col, callee, amsg) != 0) return -1;
        }
        return 0;
    }

    /* SH-115: walk a struct brace initializer and judge the items that are one
       literal. The type table gives each field's declared type; a positional
       item maps to the field at its index, a `.name = value` item to the named
       field. A nested brace / expression / array designator is skipped, so
       only a confidently wrong literal is reported, in the same
       `initializer:` words the non-brace path uses. */
    int chk_brace_init(const char *type, const char *raw, int line, int col)
    {
        char base[MAX_TEXT];
        char fname[MAX_TEXT];
        char actual[MAX_TEXT];
        const char *bt;
        int si, fi, pos, i, n, item_start, item_end, depth, s0, e0, k, vstart;
        int designated, is_zero, aline, acol;
        size_t bl;

        if (!self->types_mode || !*self->types_mode) return 0;
        if (!type || !raw) return 0;
        bt = type;
        if (strncmp(bt, "struct ", 7) == 0) bt += 7;
        while (*bt == ' ') bt++;
        snprintf(base, sizeof base, "%s", bt);
        bl = strlen(base);
        while (bl > 0 && base[bl - 1] == ' ') base[--bl] = 0;
        if (!base[0] || strchr(base, '*') || strchr(base, '[') || strchr(base, '('))
            return 0;
        si = self->sym->find_struct(base);
        if (si < 0) return 0;
        n = (int)strlen(raw);
        if (n < 2 || raw[0] != '{' || raw[n - 1] != '}') return 0;
        /* the first item's shape decides the whole list: C forbids mixing a
           positional item with a designator */
        i = 1;
        while (i < n - 1 && bplus_space(raw[i])) i++;
        designated = (i < n - 1 && raw[i] == '.') ? 1 : 0;
        pos = 0;
        i = 1;
        while (i < n - 1) {
            item_start = i;
            depth = 0;
            while (i < n - 1) {
                int c = raw[i];
                if (c == '"' || c == '\'') {
                    int q = c;
                    i++;
                    while (i < n - 1) {
                        if (raw[i] == '\\' && i + 1 < n - 1) { i += 2; continue; }
                        if (raw[i] == q) { i++; break; }
                        i++;
                    }
                    continue;
                }
                if (c == '(' || c == '[' || c == '{') { depth++; i++; continue; }
                if (c == ')' || c == ']' || c == '}') {
                    if (depth > 0) depth--;
                    i++;
                    continue;
                }
                if (c == ',' && depth == 0) break;
                i++;
            }
            item_end = i;
            if (i < n - 1) i++;            /* skip the comma */
            s0 = item_start;
            e0 = item_end;
            while (s0 < e0 && bplus_space(raw[s0])) s0++;
            while (e0 > s0 && bplus_space(raw[e0 - 1])) e0--;
            fi = -1;
            vstart = e0;
            if (s0 < e0 && raw[s0] == '.') {
                int fn = 0;
                k = s0 + 1;
                while (k < e0 && bplus_id(raw[k])) {
                    if (fn + 1 < (int)sizeof fname) fname[fn++] = raw[k];
                    k++;
                }
                fname[fn] = 0;
                while (k < e0 && bplus_space(raw[k])) k++;
                if (fn > 0 && k < e0 && raw[k] == '=') {
                    k++;
                    for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
                        if (strcmp(self->sym->structs[si].fields[fi].name, fname) == 0)
                            break;
                    if (fi >= self->sym->structs[si].nfields) fi = -1;
                    vstart = k;
                }
            } else if (!designated && s0 < e0) {
                fi = pos;
                vstart = s0;
            }
            pos++;
            if (fi < 0 || fi >= self->sym->structs[si].nfields) continue;
            if (self->sym->structs[si].fields[fi].dims[0]) continue;
            while (vstart < e0 && bplus_space(raw[vstart])) vstart++;
            while (e0 > vstart && bplus_space(raw[e0 - 1])) e0--;
            if (vstart >= e0) continue;
            if (!bplus_lit_type(raw + vstart, e0 - vstart, actual, sizeof actual, &is_zero))
                continue;
            /* the item's own source position, counted from the `{` the caller
               passed in; the diagnostic then names the item, not the brace */
            aline = line;
            acol = col;
            for (k = 0; k < s0; k++) {
                if (raw[k] == '\n') { aline++; acol = 1; }
                else acol++;
            }
            self->chk_line = aline;
            self->chk_col = acol;
            self->chk_arg = 0;
            /* SH-118: two legal brace-item shapes are not `chk_assignable`
               mismatches. (1) `{ 0 }` is C aggregate zero-fill: every field
               is defined, including an owning `String` field (SH-102 / D-015
               §1.2 relies on it). (2) `String` / `Str` fields take a string
               literal through the same implicit binding `String s = "x"`
               performs (PH-80 / `lit_coerce`); SH-115's brace walk missed
               both and reported the legal p80_retain / p81_box fixtures. */
            {
                char fbase[MAX_TEXT];
                const char *fp = self->sym->structs[si].fields[fi].type;
                size_t fl;
                if (is_zero) continue;
                while (*fp == ' ' || *fp == '\t') fp++;
                if (strncmp(fp, "struct ", 7) == 0) fp += 7;
                snprintf(fbase, sizeof fbase, "%s", fp);
                fl = strlen(fbase);
                while (fl > 0 && (fbase[fl - 1] == ' ' || fbase[fl - 1] == '\t'))
                    fbase[--fl] = 0;
                if (strcmp(actual, "char *") == 0
                    && (strcmp(fbase, "String") == 0 || strcmp(fbase, "Str") == 0))
                    continue;
            }
            if (self->chk_assignable(self->sym->structs[si].fields[fi].type,
                                     actual, is_zero, 1) != 0)
                return -1;
        }
        return 0;
    }

    /* Phase 32 S1: the type the optional `--types` pass judges. The core covers
       the shapes `static_ctype` already pins -- a variable, a member / arrow
       field, a deref, an address, a call and one subscript -- and reports
       "undecidable" for everything else, so a shape the tables cannot resolve
       is skipped rather than guessed (D32-4). A value that still carries array
       dimensions is not a value type either: array actuals decay in C, and the
       skip list owns that case. */
    int chk_type(int n, char *out, int cap, int *is_zero)
    {
        if (is_zero) *is_zero = 0;
        if (n < 0 || !out || cap < 2) return -1;
        out[0] = 0;
        {
            int nk;

            nk = self->arena->nodes[n].kind;
            match ((NodeKind){ .tag = nk }) {
                NodeKind.NK_UNUSED0() => { return -1; }
                NodeKind.NK_PROG() => { return -1; }
                NodeKind.NK_PP() => { return -1; }
                NodeKind.NK_FUNC() => { return -1; }
                NodeKind.NK_BLOCK() => { return -1; }
                NodeKind.NK_RET() => { return -1; }
                NodeKind.NK_EXPR() => { return -1; }
                NodeKind.NK_CALL() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_NUM() => {
                /* D32-5: every arithmetic spelling is one class, so the literal
                   stays `int` whatever its suffix. `is_zero` is the null pointer
                   constant flag the caller hands to `chk_assignable`. */
                if (is_zero) *is_zero = (self->arena->nodes[n].num == 0);
                snprintf(out, (size_t)cap, "%s", "int");
                return 0;
                }
                NodeKind.NK_STR() => {
                /* a string literal is `char *` in a value context; a character
                   literal stays the arithmetic class (`int`). PH-80: a literal
                   already bound to String/Str answers that type. */
                if (self->arena->nodes[n].aux == 1)
                    snprintf(out, (size_t)cap, "%s", "String");
                else if (self->arena->nodes[n].aux == 2)
                    snprintf(out, (size_t)cap, "%s", "Str");
                else
                    snprintf(out, (size_t)cap, "%s",
                             self->arena->str_at((int)self->arena->nodes[n].num)[0] == '\''
                             ? "int" : "char *");
                return 0;
                }
                NodeKind.NK_VAR() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_BIN() => {
    {
                int op = (int)self->arena->nodes[n].aux;
                if ((op >= B_LT && op <= B_NE) || op == B_AND || op == B_OR) {
                    snprintf(out, (size_t)cap, "%s", "int");
                    return 0;
                }
                if ((op >= B_ADD && op <= B_MOD) || op == B_XOR
                    || op == B_BAND || op == B_BOR || op == B_SHL || op == B_SHR) {
                    char l[MAX_TEXT];
                    char r[MAX_TEXT];
                    int zl = 0;
                    int zr = 0;
                    if (self->chk_type(self->arena->nodes[n].a, l, sizeof l, &zl) != 0)
                        return -1;
                    if (self->chk_type(self->arena->nodes[n].b, r, sizeof r, &zr) != 0)
                        return -1;
                    if (strcmp(l, "double") == 0 || strcmp(r, "double") == 0) {
                        snprintf(out, (size_t)cap, "%s", "double");
                        return 0;
                    }
                    if (strcmp(l, "int") == 0 && strcmp(r, "int") == 0) {
                        snprintf(out, (size_t)cap, "%s", "int");
                        return 0;
                    }
                    return -1;
                }
                return -1;
            }
                }
                NodeKind.NK_DECL() => { return -1; }
                NodeKind.NK_ASSIGN() => { return -1; }
                NodeKind.NK_IF() => { return -1; }
                NodeKind.NK_WHILE() => { return -1; }
                NodeKind.NK_FOR() => { return -1; }
                NodeKind.NK_UNARY() => {
    {
                int op = (int)self->arena->nodes[n].aux;
                if (op == U_NOT || op == U_BNOT) {
                    snprintf(out, (size_t)cap, "%s", "int");
                    return 0;
                }
                if (op == U_NEG) {
                    char t[MAX_TEXT];
                    int z = 0;
                    if (self->chk_type(self->arena->nodes[n].a, t, sizeof t, &z) != 0)
                        return -1;
                    if (strcmp(t, "int") != 0 && strcmp(t, "double") != 0) return -1;
                    snprintf(out, (size_t)cap, "%s", t);
                    return 0;
                }
                return -1;
            }
                }
                NodeKind.NK_POST() => { return -1; }
                NodeKind.NK_PARAM() => { return -1; }
                NodeKind.NK_STRUCT() => { return -1; }
                NodeKind.NK_TYPEDEF() => { return -1; }
                NodeKind.NK_GLOBAL() => { return -1; }
                NodeKind.NK_FIELD() => { return -1; }
                NodeKind.NK_MEMBER() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_ARROW() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_INDEX() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_ADDR() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_DEREF() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_METHOD() => { return -1; }
                NodeKind.NK_MCALL() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_RAW() => { return -1; }
                NodeKind.NK_UNUSED32() => { return -1; }
                NodeKind.NK_IMPL() => { return -1; }
                NodeKind.NK_BOX() => { return -1; }
                NodeKind.NK_CAST() => {
                /* PH-68-R2: a cast's type is its target spelling. */
                snprintf(out, (size_t)cap, "%s", self->arena->nodes[n].text);
                return 0;
                }
                NodeKind.NK_SIZEOF() => { return -1; }
                NodeKind.NK_TERN() => {
    {
                /* Both arms must agree; the node's value type is that type. */
                char t1[MAX_TEXT];
                char t2[MAX_TEXT];
                int z1 = 0;
                int z2 = 0;
                if (self->chk_type(self->arena->nodes[n].b, t1, sizeof t1, &z1) != 0)
                    return -1;
                if (self->chk_type(self->arena->nodes[n].c, t2, sizeof t2, &z2) != 0)
                    return -1;
                if (strcmp(t1, t2) != 0) return -1;
                snprintf(out, (size_t)cap, "%s", t1);
                return 0;
            }
                }
                NodeKind.NK_BREAK() => { return -1; }
                NodeKind.NK_CONT() => { return -1; }
                NodeKind.NK_DECLS() => { return -1; }
                NodeKind.NK_DELETE() => { return -1; }
                NodeKind.NK_SWITCH() => { return -1; }
                NodeKind.NK_CASE() => { return -1; }
                NodeKind.NK_DOWHILE() => { return -1; }
                NodeKind.NK_ENUM() => { return -1; }
                NodeKind.NK_ENUMVAL() => { return -1; }
                NodeKind.NK_OFFSETOF() => { return -1; }
                NodeKind.NK_UNION() => { return -1; }
                NodeKind.NK_LABEL() => { return -1; }
                NodeKind.NK_GOTO() => { return -1; }
                NodeKind.NK_COMPOUND() => { return -1; }
                NodeKind.NK_EMPTY() => { return -1; }
                NodeKind.NK_VAARG() => { return -1; }
                NodeKind.NK_FNUM() => {
                snprintf(out, (size_t)cap, "%s", "double");
                return 0;
                }
                NodeKind.NK_SASSERT() => { return -1; }
                NodeKind.NK_FIELDS() => { return -1; }
                NodeKind.NK_PRE() => { return -1; }
                NodeKind.NK_RAW_TEXT() => { return -1; }
                NodeKind.NK_CLOSURE() => { return -1; }
                NodeKind.NK_LOOP() => { return -1; }
                NodeKind.NK_INIT_RANGE() => { return -1; }
                NodeKind.NK_FOREACH() => { return -1; }
                NodeKind.NK_INTO() => { return -1; }
                NodeKind.NK_INTO_SELF() => { return -1; }
                NodeKind.NK_INIT_BRACE() => { return -1; }
                NodeKind.NK_INIT_ITEM() => { return -1; }
                NodeKind.NK_INIT_MBRACE() => { return -1; }
                NodeKind.NK_UNUSED68() => { return -1; }
                NodeKind.NK_DEFER() => { return -1; }
                NodeKind.NK_DEFER_RUN() => { return -1; }
                NodeKind.NK_TRY() => {
    {
                int ad = 0;
                /* Phase 44 (D44-2 / D44-5, L44-1..3): the operand must be a
                   `Result<T, E>`, and a value-returning function must answer a
                   `Result<U, E>` whose error parameter is the same `E`. A void
                   function only needs some `Result` operand: its failure has no
                   payload to carry. The judged type is `T`. */
                char opty[MAX_TEXT];
                char otag[MAX_TEXT];
                char oval[MAX_TEXT];
                char oerr[MAX_TEXT];
                char rtag[MAX_TEXT];
                char rval[MAX_TEXT];
                char rerr[MAX_TEXT];
                char msg[2 * MAX_TEXT + 64];
                int oi;
                int line = self->arena->nodes[n].line;
                int col = (int)self->arena->nodes[n].num;
    
                if (!self->static_ctype(self->arena->nodes[n].a, opty, sizeof opty, &ad, 0))
                    return tool::diag::ct_sem_error(line, col, "'?' needs a Result operand",
                                                    self->sup->mem->path);
                if (ad != 0 || !self->result_tag(opty, otag, sizeof otag))
                    return tool::diag::ct_sem_error(line, col, "'?' needs a Result operand",
                                                    self->sup->mem->path);
                oi = frontend::sym::ct_inst_find(otag);
                if (!self->result_cols(oi, oval, sizeof oval, oerr, sizeof oerr))
                    return tool::diag::ct_sem_error(line, col, "'?' needs a Result operand",
                                                    self->sup->mem->path);
                if (!self->sym->ret_type[0])
                    return tool::diag::ct_sem_error(line, col, "'?' is not allowed here",
                                                    self->sup->mem->path);
                if (strcmp(self->sym->ret_type, "void") != 0) {
                    if (!self->result_tag(self->sym->ret_type, rtag, sizeof rtag))
                        return tool::diag::ct_sem_error(line, col,
                            "postfix '?' needs a function returning Result",
                            self->sup->mem->path);
                    oi = frontend::sym::ct_inst_find(rtag);
                    if (!self->result_cols(oi, rval, sizeof rval, rerr, sizeof rerr))
                        return tool::diag::ct_sem_error(line, col,
                            "postfix '?' needs a function returning Result",
                            self->sup->mem->path);
                    if (strcmp(oerr, rerr) != 0) {
                        snprintf(msg, sizeof msg,
                                 "'?': expected error type '%s', got '%s'", rerr, oerr);
                        return tool::diag::ct_sem_error(line, col, msg,
                                                        self->sup->mem->path);
                    }
                }
                if (snprintf(out, (size_t)cap, "%s", oval) >= cap) return -1;
                return 0;
            }
                }
                NodeKind.NK_OPT() => { return -1; }
                NodeKind.NK_MATSEQ() => { return -1; }
                NodeKind.NK_SLICE_INDEX() => { return -1; }
                NodeKind.NK_SLICE_RANGE() => { return -1; }
                NodeKind.NK_SLICE_GET() => { return -1; }
                NodeKind.NK_NEWOBJ() => { return -1; }
                NodeKind.NK_MATCH() => {
                /* LANG-29 S4 / B5: an expression match carries its unified arm
                   type; the statement form still has none here. */
                if ((self->arena->nodes[n].sflags & 8) != 0
                    && self->arena->nodes[n].text2[0]) {
                    snprintf(out, (size_t)cap, "%s", self->arena->nodes[n].text2);
                    return 0;
                }
                return -1;
            }
                NodeKind.NK_ARM() => { return -1; }
                NodeKind.NK_BIND() => { return -1; }
                NodeKind.NK_ADTCTOR() => { return chk_type_static(self, n, out, cap); }
                NodeKind.NK_ADTFIELD() => { return -1; }
                NodeKind.NK_ADTMEM() => { return -1; }
            }
        }
    }

    /* Phase 32 S3: one formal against one actual through the same kernel
       `argtype_mismatch` uses (D32-2). Every skip below is a deliberate
       false negative: an interface slot boxes on its own path, a null
       pointer constant fills any pointer slot (B32-6), and two pointers are
       never compared beyond the fact that both are pointers (D32-6/T32-1).
       The base-type and depth guard has to run before `r == 1`, or a single
       sided pointer such as `int x = "s"` would be skipped (B32-8). */
    int chk_assignable(const char *formal, const char *actual, int is_zero, int diag)
    {
        char fb[MAX_TEXT], ab[MAX_TEXT], tr[MAX_TEXT];
        char msg[2 * MAX_TEXT + 64];
        const char *label;
        int r;

        if (!formal || !formal[0] || !actual || !actual[0]) return 0;
        if (self->sup->is_iface_type(formal, tr, sizeof tr)) return 0;
        if (is_zero && strchr(formal, '*')) return 0;
        r = arg_class(formal, actual, fb, sizeof fb, ab, sizeof ab);
        if (r == -1) return 0;
        if (r == 2) {
            /* different struct spellings; the same row passes like `r == 0` */
            int fs = self->sym->find_struct(fb + 6);
            int as = self->sym->find_struct(ab + 6);
            if (fs < 0 || as < 0 || fs == as) return 0;
        } else if (r != 1) {
            return 0;
        }
        if (diag == 6) {
            snprintf(msg, sizeof msg, "argument %d: expected '%s', got '%s'",
                     self->chk_arg, formal, actual);
        } else if (diag == 8) {
            snprintf(msg, sizeof msg, "'$' target: expected '%s', got '%s'",
                     formal, actual);
        } else {
            label = diag == 2 ? "assignment"
                    : ((diag == 3 || diag == 7) ? "return" : "initializer");
            snprintf(msg, sizeof msg, "%s: expected '%s', got '%s'",
                     label, formal, actual);
        }
        /* SH-115: a `$` target / hard-return mismatch is a C-invalid
           assignment, so it does not downgrade under `--check-level=warn`. */
        if (diag == 7 || diag == 8)
            return tool::diag::ct_sem_error(self->chk_line, self->chk_col, msg,
                                            self->sup->mem->path);
        return tool::diag::ct_type_warn(self->chk_line, self->chk_col, "", msg,
                                        self->sup->mem->path);
    }

    /* PH-79 fix SH-100: an array value where a `T[]` is expected is a view.
       The same `{ptr,len}` conversion the local declaration performs becomes
       an explicit AST node here, so a call actual and a return value can use
       it after their own checks have run. `N_SLICE_RANGE` aux 3 means "whole
       array, no bounds": the emitter spells the compound literal and repeats
       the lvalue for the two `sizeof`s. A function parameter written `T a[]`
       has decayed to a pointer and carries no length, so it is left to C. */
    int slice_view_from_array(int n)
    {
        char t[MAX_TEXT];
        int d = 0, vi, m;

        if (n < 0) return n;
        if (self->arena->nodes[n].kind == N_SLICE_RANGE
            || self->arena->nodes[n].kind == N_SLICE_INDEX
            || self->arena->nodes[n].kind == N_SLICE_GET)
            return n;
        if (!self->static_ctype(n, t, sizeof t, &d, 0)) return n;
        if (d != 1) return n;
        if (self->arena->nodes[n].kind == N_VAR) {
            vi = self->sym->find_var(self->arena->nodes[n].text2);
            if (vi >= 0 && self->sym->vars[vi].is_fnparam) return n;
        }
        m = self->sup->new_node(N_SLICE_RANGE);
        if (m < 0) return -1;
        self->arena->nodes[m].text = runtime::text::ct_intern(t);
        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
        self->arena->nodes[m].aux = 3;
        self->arena->nodes[m].a = n;
        self->arena->nodes[m].b = -1;
        self->arena->nodes[m].c = -1;
        self->arena->nodes[m].line = self->arena->nodes[n].line;
        self->arena->nodes[m].num = self->arena->nodes[n].num;
        return m;
    }

    /* Phase 32 S7: bind, substitute, judge. The impl block is found the same
       way `inst_inherent_method` finds the method, but here the block index
       is needed because `ct_method_bind` reads its type parameters. */
    int chk_mcall_args(const char *ibase, const char *fname, int args)
    {
        char base[MAX_TEXT];
        char **bn = 0;
        char **bv = 0;
        int bcap = 0, bvcap = 0, bnt;
        char fty[MAX_TEXT], out[MAX_TEXT];
        int ii, nimpls, inst, m, found, foundm, ai, k;
        struct StructImpl *im;

        if (strncmp(ibase, "struct ", 7) != 0) return 0;
        snprintf(base, sizeof base, "%s", ibase + 7);
        inst = frontend::sym::ct_inst_find(base);
        if (inst < 0) return 0;
        im = frontend::sym::ct_impls(&nimpls);
        found = -1;
        foundm = -1;
        {
            /* PH-80: the most specific matching block owns the signature, the
               same rule the emitter applies. Without it a concrete
               `Map<String, V>` key block loses to the generic `Map<K, V>` and
               the checker compares the borrowed `Str` argument against the
               instance's `String` key type. */
            int bestscore = -1;
            for (ii = 0; im && ii < nimpls; ii++) {
                int score;
                if (im[ii].use[0]) continue;
                if (!frontend::sym::ct_impl_matches(ii, inst)) continue;
                score = inst_impl_score(ii);
                for (m = self->arena->nodes[im[ii].node].a; m >= 0;
                     m = self->arena->nodes[m].next)
                    if (strcmp(self->arena->nodes[m].text2, fname) == 0) {
                        if (score > bestscore) {
                            bestscore = score;
                            found = ii;
                            foundm = m;
                        }
                        break;
                    }
            }
        }
        if (found < 0) return 0;
        /* SH-65/SH-67: a closure is a (trampoline, env) pair, but a struct/trait
           method emits one C argument per source argument. Builtin container
           methods (`each`) have their own expansion and are exempt. */
        {
            int pair_ok = 0;
            int np = 0, pk2;
            for (pk2 = self->arena->nodes[foundm].a; pk2 > 0; pk2 = self->arena->nodes[pk2].next) np++;
            if (np == 2) {
                pk2 = self->arena->nodes[self->arena->nodes[foundm].a].next;
                if (pk2 > 0 && strstr(self->arena->nodes[pk2].text, "void *")) pair_ok = 1;
            }
            {
            int ca;
            for (ca = args; ca >= 0; ca = self->arena->nodes[ca].next) {
                int is_cl = 0, clnode = -1;
                if (self->arena->nodes[ca].kind == N_CLOSURE) {
                    is_cl = 1;
                    clnode = ca;
                } else if (self->arena->nodes[ca].kind == N_VAR) {
                    int cv = self->sym->find_var(self->arena->nodes[ca].text2);
                    if (cv >= 0 && self->sym->vars[cv].is_closure) is_cl = 1;
                }
                if (!is_cl) continue;
                if (clnode >= 0 && pair_ok) {
                    const char *host = self->arena->nodes[self->arena->nodes[foundm].a].text;
                    if (closure_match(self, (int)self->arena->nodes[clnode].num,
                                      host, 1, 1) != 0)
                        return -1;
                    continue;
                }
                if (!frontend::sym::ct_is_container_type(ibase))
                    return tool::diag::ct_sem_error(self->chk_line, self->chk_col,
                        "a closure cannot be passed to a method argument yet (SH-65); pass '(fn, env)' explicitly",
                        self->sup->mem->path);
            }
            }
        }
        bnt = im[found].ntparams;
        if (bnt > 0) {
            bn = frontend::sym::ct_rows_reserve(bn, bcap, bnt, &bcap);
            bv = frontend::sym::ct_rows_reserve(bv, bvcap, bnt, &bvcap);
            if (!bn || bcap < bnt || !bv || bvcap < bnt) return 0;
        }
        if (frontend::sym::ct_method_bind(found, inst, bn, bv, bnt) < 0)
            return 0;
        ai = args;
        k = 0;
        {
            int pi = self->arena->nodes[foundm].a;
            while (pi >= 0 && ai > 0) {
                int is_zero = 0;
                if (subst_tparam(self->arena->nodes[pi].text, bn, bv, bnt,
                                 fty, sizeof fty) == 0
                    && self->chk_type(ai, out, sizeof out, &is_zero) == 0) {
                    if (self->arg_base + k < self->argcap) {
                        self->chk_line = self->arg_line[self->arg_base + k];
                        self->chk_col = self->arg_col[self->arg_base + k];
                    }
                    self->chk_arg = k + 1;
                    if (self->chk_assignable(fty, out, is_zero, 6) != 0) return -1;
                }
                ai = self->arena->nodes[ai].next;
                pi = self->arena->nodes[pi].next;
                k++;
            }
        }
        return 0;
    }

    /* PH-80 (D-013): expected-type-directed literal binding. `String` gets
       an immortal handle (`aux = 1`, the emitter writes the static header),
       `Str` gets a borrowed view (`aux = 2`); a UTF-16 literal is refused
       because there is no implicit conversion. The type spelling may carry
       `struct `, spaces or a trailing star; only an exact value type matches,
       so a `String *` initializer is never silently rewritten. */
    int lit_coerce(const char *type, int e)
    {
        char base[MAX_TEXT];
        char hb[MAX_TEXT];
        char msg[MAX_TEXT];
        const char *p;
        size_t n;

        /* P-3.5 (SH-117): a pointer target cannot receive a by-value
           `String` / `Str` handle. The declaration initialiser, the plain
           assignment, the return position and a declared-parameter argument
           all reach this hook with the expected type, so one check covers
           the three shapes that used to emit `char *p = s;`. */
        if (type != 0 && type[0] != 0 && strchr(type, '*') != 0
            && str_handle_value(self, e, hb, sizeof hb)) {
            snprintf(msg, sizeof msg,
                     "cannot convert '%s' to '%s': use cstr() at the C boundary",
                     hb, type);
            return tool::diag::ct_sem_error(self->arena->nodes[e].line,
                                            self->arena->nodes[e].num, msg,
                                            self->sup->mem->path);
        }
        if (e < 0 || self->arena->nodes[e].kind != N_STR) return 0;
        if (self->arena->str_at((int)self->arena->nodes[e].num)[0] == '\'')
            return 0;                          /* a character literal */
        p = type;
        while (*p == ' ' || *p == '\t') p++;
        if (strncmp(p, "struct ", 7) == 0) p += 7;
        n = strlen(p);
        while (n > 0 && (p[n - 1] == ' ' || p[n - 1] == '\t')) n--;
        if (n >= (size_t)MAX_TEXT) return 0;
        memcpy(base, p, n);
        base[n] = 0;
        if (strchr(base, '*') != 0) return 0;
        if (strcmp(base, "String") == 0) {
            self->arena->nodes[e].aux = 1;
            return 0;
        }
        if (strcmp(base, "Str") == 0) {
            self->arena->nodes[e].aux = 2;
            return 0;
        }
        if (strcmp(base, "U16String") == 0 || strcmp(base, "U16Str") == 0) {
            tool::diag::ct_sem_error(self->arena->nodes[e].line, 1,
                "a UTF-16 string literal is not implicit; use U16String.from_utf8()",
                self->sup->mem->path);
            return -1;
        }
        return 0;
    }
}
