/*
 * Expr.h.ct - the expression and type grammar, one sub-object of the parser.
 *
 * The precedence chain (`parse_expr` down to `parse_primary`), the argument
 * list and the call-graph record sit here with the type specifier reader the
 * chain leans on: `sizeof` and casts need `parse_type`, so the two share an
 * object rather than calling back into the parser. The parser keeps statements
 * and declarations and invites the chain in through `expr_get`; this object
 * only points at the cursor, the shared primitives, the symbol tables, the node
 * pool and the call table the driver reads back.
 *
 * Macros do not cross a unit boundary, so the caps, node kinds, token kinds and
 * operator codes used here are declared here; MAX_TEXT 160 is the value
 * `frontend/sym/Symbols.h.ct` lists.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>

import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import tool::diag::Diag;

#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 1024
#define MAX_FUNCS 256
/* Phase 32 S7: the argument start positions of the call being parsed. The
   array is a stack: a nested call appends after its parent's frame. */
#define MAX_ARG_POS 32
#define MAX_GENERIC_INSTS 64
#define MAX_STRUCT_TPARAMS 2
#define MAX_RAW_INIT 4096
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
/* Phase 30: the receiver-context block and the `$` / `.name` references
   inside it. `N_INTO` keeps the receiver in `a`, the block's first statement
   in `b`, the value category in `aux` and the receiver's static type in
   `text`; the emitter names the promoted variable in `text3`. */
#define N_INTO 63
#define N_INTO_SELF 64
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3

namespace frontend::parse;
/* `cur_func` and the call table stay the parser's (the driver reads them back),
   so this object points at them; `calls` points into storage that unit owns. */
pub trait ExprOps {
    int  is_type_word(const char *w);
    int  type_append(char *out, int cap, int *n, const char *tok);
    int  parse_type(char *out, int cap);
    /* Phase 29: read `Name<arg[, arg]>` (the lexer sits on `Name`) and append
       the encoded instance tag to `out`. */
    int  parse_inst_type(char *out, int cap);
    /* Phase 29: create (or reuse) the monomorphised row for `Name<c1, c2>` and
       register its struct layout. `depth` bounds nested instantiation; `line` /
       `col` are the first type argument's source position (0 when a nested
       registration has no argument list of its own). */
    int  inst_make(const char *tname, int nargs, const char *a1, const char *a2,
                   const char *c1, const char *c2, char *enc, int enc_cap,
                   int depth, int line, int col);
    /* Phase 29: a substituted field spelling may itself name an instance
       (`MapEntry<K, V>`); register it so the emitter can print its layout. */
    int  inst_register_nested(const char *spell, int depth);
    /* L29-13: 1 when this C type is a struct that carries a vptr (directly or
       through a value field). Interface values (`struct X_iface`) are not
       flagged: Phase 31 O1 stores them as a plain two-word copy. */
    int  container_vptr_type(const char *ctype, int depth);
    /* L31-1: 1 when this C type is an interface pointer (`struct X_iface *`).
       There is no boxing path from a concrete value into an interface-pointer
       slot, so such an element is refused and pointed at the value form. */
    int  container_iface_ptr(const char *ctype);
    /* Phase 31: replace the template's type parameters in `spell` with the
       instance's concrete C arguments (`T` -> `struct Show_iface`). A spelling
       that mentions no parameter passes through unchanged. */
    int  inst_subst_type(const char *ibase, const char *spell, char *out, int cap);
    /* L31-2 / Phase 33 O3: 1 when a container element (an interface value or an
       owning instance) is declared in a unit other than the container template's
       own. The emitter uses it to move the instance's helpers and methods to the
       unit that named it. */
    int  container_elem_foreign(const char *ctype, int container_tmpl);
    /* Phase 26: register (or reuse) the instance of template `gfi` for the
       concrete type spelling `targ`; returns its index in `sym->ginsts`. */
    int  generic_instance(int gfi, const char *targ, int line, int col);
    /* Phase 29: the method node `impl<T> Name<Args>` declares for the receiver
       type `ibase` (a `struct <instance>` spelling), or -1. */
    int  inst_inherent_method(const char *ibase, const char *fname);
    /* P29-2: the receiverless (static) method of an instance, and the
       lookahead that tells `Vec<int>::from(...)` from `Vec < 3`. */
    int  inst_static_method(const char *ibase, const char *fname);
    int  static_call_ahead(void);
    /* Phase 29 V29-4: a `Vec` / `Map` handle is a two-field struct in C, so the
       subscript and brace-initializer spellings C would reject (`struct Vec_int`
       is not an array, `{ "k": 1 }` is not an aggregate) are refused here with a
       position instead of being emitted. */
    int  container_index_check(int base);
    /* V29-4: one static C type for an expression, so every subscript base is
       judged by the same rules. It covers a variable, a member / arrow field,
       a deref, a call (direct or through a function pointer), a method call and
       one array / pointer subscript. Each deref or subscript peels exactly one
       layer. A base whose type the tables cannot pin is left unresolved and is
       not judged (cc stays the last word); a resolved container spelling is
       always refused. */
    int  static_ctype(int n, char *out, int cap, int *array_depth, int depth);
    /* `typedef` alias -> the spelling it was declared with (name lookup). */
    int  ctype_expand(const char *in, char *out, int cap, int depth);
    /* `RET (*)(params)` -> RET, the abstract declarator the emitter splices. */
    int  fnptr_ret(const char *ftype, char *out, int cap);
    /* one pointer layer only: `T **` -> `T *`, never `T`. */
    int  peel_ptr(const char *ty, char *out, int cap);
    int  container_init_check(const char *ctype);
    int  container_global_init_check(const char *ctype);
    /* Phase 31 O3: the write forms a subscript has no lvalue for. The kind is
       1 for a `Vec`, 2 for a `Map`, 0 when the chain holds no subscript. */
    int  container_subscript_kind(int n);
    int  container_write_check(int n);
    int  container_addr_check(int n);
    /* Phase 31 S16b: one Map literal key or value against its slot, using the
       19.2 coarse kernel. 0 compatible, 1 a confident mismatch, -1 undecidable. */
    int  brace_arg_ok(const char *formal, const char *actual);
    int  parse_array_dims(int n);
    int  next_is_type_name(void);
    int  tok_is_type_name(void);
    int  offsetof_ahead(void);
    int  fnptr_field(const char *stype, const char *field);
    int  const_ok(int n);
    int  parse_expr(void);
    /* Phase 30: consume `into { … }` (and any postfix suffix after it). The
       caller sets `into_ok` for the positions the card allows; anywhere else a
       block here is L30-1. */
    int  into_tail(int left, int allow);
    int  into_block(int recv, char *type, int line, int col);
    int  into_member_check(int base, char *fname, int line, int col);
    int  parse_bitor(void);
    int  parse_bxor(void);
    int  parse_bitand(void);
    int  parse_shift(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  parse_qual_path(char *name, int ncap, char *cname, int ccap, char *qpath, int qcap,
                         int *form);
    int  record_call(const char *callee, int line);
    int  arity_check(int line, int col, const char *callee, int got, int want);
    int  map_arity(int line, int col, const char *trait, const char *method, int got);
    int  argtype_check(int line, int col, const char *callee, int args, int fi, int ti, int mi);
    /* SH-60: a static map's actuals are compared with the host trait's
       signature (same rules as 19.2) but a confident mismatch is a hard error,
       not a warning: the recipe splices the actual into the generated call, so
       nothing else can catch it, and `ct check` never sees an imported
       mapping unit. */
    int  argtype_check_static(int line, int col, const char *callee, int args, int ti, int mi);
    /* 25.1: the silent half of `argtype_check` -- 0 compatible / undecidable,
       1 a confident mismatch written to `msg`. A type host with several
       candidate maps asks every candidate before it warns. */
    int  argtype_mismatch(int args, int fi, int ti, int mi, char *msg, int cap);
    /* Phase 21 S4: closure actuals fill a `(fn, env)` pair and count as two
       C arguments. */
    int  type_is_fnptr(const char *t);
    int  type_is_void_ptr(const char *t);
    int  formal_is_env_fn(const char *t);
    int  arg_is_closure(int a);
    int  closure_arg_count(int args);
    int  closure_arg_check(int line, int col, const char *callee, int args, int fi);
    /* 25.1: the static-recipe counterpart -- a closure actual may only fill a
       `(fn, env)` pair of the host method (L25-1). */
    int  map_closure_check(int line, int col, int args, int ti, int mi);
    int  decl_type_compat(const char *formal, const char *actual);
    /* Phase 21 S2: `(params) => expr` is parsed and checked, never emitted.
       `parse_closure` runs at the `(` that opens the literal; `closure_bind`
       compares it with the function pointer type its declaration spells. */
    int  parse_closure(void);
    int  closure_bind(int ci, const char *host, const char *vname);
    int  closure_arg_bind(int ci, const char *ftype);
}

/* Phase 35: `ExprOps` is at MAX_METHODS; trait-instance type reading gets the
   same small-trait treatment as the optional type gate below. */
trait ExprTraitInst {
    int  parse_trait_inst_type(char *out, int cap);
}

/* Phase 32: the opt-in `--types` gate. Its own trait because `ExprOps` already
   sits at MAX_METHODS, and both grammars that need the gate -- the expression
   layer and the statement layer -- hold this object. */
pub trait ExprTypes {
    /* The judged type of one expression. 0 when `out` names a value type,
       non-zero when the tables cannot pin it (D32-4: the caller then stays
       silent). `is_zero` is optional and marks the bare literal `0`, a null
       pointer constant wherever a pointer is expected. */
    int  chk_type(int n, char *out, int cap, int *is_zero);
    /* One compatibility judgement through the shared `arg_class` kernel
       (D32-2). `diag` picks the wording: 1 initializer, 2 assignment,
       3 return, 6 a container argument (the index comes from `chk_arg`).
       The position is read from `chk_line` / `chk_col`; the caller sets both
       before the call, because an AST node only records its line. */
    int  chk_assignable(const char *formal, const char *actual, int is_zero, int diag);
    /* Phase 32 S7: the arguments of one inherent method call on an instance.
       The impl's type parameters are bound to the instance's concrete C
       arguments, each formal is substituted, and each actual is judged with
       L32-6 at its own start position. */
    int  chk_mcall_args(const char *ibase, const char *fname, int args);
}

pub struct Expr {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct ParseSupport *sup;
    char *cur_func;                      /* the parser's current function name */
    struct Call *calls;  /* storage owned by parse.h.ct */
    int *ncalls;
    /* A function-pointer declarator carries its name inside the type
       (`int (*cb)(void *)`), so `parse_type` reads it and the caller takes it
       from here instead of expecting an identifier of its own. 160 is MAX_TEXT
       here: the generated header carries no macros. (D-7) */
    char fnptr_name[160];
    /* The array dimensions of a function pointer live inside its declarator
       (`int (*tbl[2])(int)`), so `parse_type` collects them here and the four
       declaration entries copy them into the node's `text3` (D-5). */
    char fnptr_dims[160];
    int  fnptr_state;
    /* Set when the type just read named a trait. `parse_type` turns a trait
       into its `struct T_iface`, which is right everywhere except a type
       alias: a synonym must name a concrete spelling, so the alias parser
       rejects the target with a message of its own. */
    int  saw_trait;
    /* A specifier captured before the storage class (`_Alignas(16) static int
       g;`) arrives here; `parse_type` prepends it and clears the slot, so the
       declaration keeps its canonical spelling (`static _Alignas(16) int g`). */
    char decl_prefix[160];
    /* Set while the expression being parsed may name a C library function
       (`p = strcmp;`, `p = &strcmp;`): an unknown bare identifier is then
       emitted verbatim instead of being rejected. */
    int  fnval_ok;
    /* Phase 26: set by the parser while a generic template's body is being
       parsed. A generic call there would need an instance of a function whose
       own instance set is not fixed yet, so it is refused (L26-5). */
    int  in_generic;
    /* Phase 26 fix (SH-62): the current template's type parameter spelling
       while its body is parsed. `next_is_type_name` otherwise treats an
       ALL_CAPS name as a C macro constant, which turned `sizeof(T)` into a
       raw expression and let `ct compile` emit `sizeof(T)`. */
    char in_generic_tparam[160];
    /* Phase 29: the second type parameter of a generic struct template
       (`struct Pair<T, U>`), empty when the template or the function has one. */
    char in_generic_tparam2[160];
    /* Phase 29: set while `parse_type` reads a type argument that is itself an
       instance. Since S20b the surrounding instance takes that argument by its
       C spelling (`struct Vec_int`), so the encoder produces one name in every
       path (`Vec_Vec__int`); this flag only tells the reader the argument was an
       instance. Empty when the last type was not an instance. */
    char inst_canon[160];
    /* Phase 29: nesting depth of `parse_type` while it reads type arguments;
       deeper than four is refused (L29-4). */
    int  type_depth;
    /* Phase 29: the unit being parsed, copied from the parser when a unit
       starts, so an instance records who created it. */
    int  cur_unit;
    /* Phase 31 L31-2: points at the driver's `ct build` flag, copied from the
       parser when a unit starts. A single-file compile sees every definition,
       so the cross-unit element guard only applies when this is 1. */
    int *build_mode;
    /* Phase 32: points at the parser's `types_mode`, set only by `ct check
       --types`. Every phase-32 judgement reads this flag and stays silent
       when it is 0. */
    int *types_mode;
    /* Phase 32: the source position of the expression under judgement and the
       argument index L32-6 names. The caller sets them just before calling
       `chk_assignable`; an AST node carries only its line. */
    int  chk_line;
    int  chk_col;
    int  chk_arg;
    /* Phase 32 S7: each argument's own start position, captured while the
       argument list is parsed. A nested call grows the frame past the
       parent's slots; the frame is popped when the list closes. */
    int  arg_line[32];
    int  arg_col[32];
    int  narg_pos;
    int  arg_base;
    /* Phase 28: the trait bound of the template whose body is being parsed.
       A method call on the type parameter resolves against this trait instead
       of failing to find a struct; empty for a plain template and outside one. */
    char in_generic_bound[160];
    /* Phase 26 fix (SH-63): the last bare struct/union/enum tag `parse_type`
       expanded into `struct <tag>`. A template whose return type was written
       bare `T` must become the type parameter, not the same-named tag. */
    char last_bare_tag[160];
    /* Phase 26 fix (SH-62, reopened): a `sizeof` / `_Alignof` / `alignof` type
       operand written without parentheses (`sizeof T`) takes one type name and
       stops before `*`, which belongs to the surrounding multiplication. */
    int  type_no_ptr;
    /* Set while a full expression may carry an assignment (`(c = f())` and a
       condition): the statement layer owns top-level assignments, so this stays
       0 there and `x = 1;` is unchanged. */
    int  assign_ok;
    /* Phase 24: non-zero only while the element expression of a range
       initialiser (`int a[] = 0..3($ * 2)`) is being parsed. `$` is not an
       identifier -- it has no scope, no symbol and no C spelling -- so it is
       accepted as a primary here and anywhere else reports the ordinary syntax
       error instead of an undeclared name. */
    int  dollar_ok;
    /* Phase 30: `> 0` only while the expression at one of the allowed value
       positions (a declaration initialiser, an assignment's right side, a
       `return`, an expression statement) is parsed. A nested expression clears
       it, so `f(x into { … })` is L30-1 instead of being accepted. */
    int  into_ok;
    /* The `N_INTO` whose block is being parsed, or -1. `$` and a leading
       `.name` bind to it, and a second `into` inside the same block is L30-7. */
    int  into_node;
    /* A compound literal is parsed where a cast would be (`(type){ … }`), but a
       postfix suffix still belongs to it (`(struct P){1,2}.y`). The cast branch
       leaves the finished node here and calls `parse_postfix`, which consumes
       the seed instead of parsing another primary. -1 = none; `ct_expr_bind`
       sets that up, since the instance is static. */
    int  postfix_seed;
    /* Phase 21 S5: a block body (`=> { … }`) is the statement layer's, and the
       expression object may not import it (that would close a cycle), so the
       parser installs a hook after both sub-objects are bound. */
    int (*body_hook)(void);
    /* Enclosing closures while a literal's body is being parsed. An inner
       literal's captures are copied up into every enclosing environment whose
       frame is outside this literal, so the inner environment can be built
       from fields instead of names that do not exist there. */
    int  cl_stack[16];
    int  cl_pstart[16];
    int  ncl_stack;
    /* The map table the parser owns. A qualified call may name a namespace
       host's method without the trait segment (`std::io::puts(...)`), and the
       namespace/recipe pair is only known from this table. */
    struct MapTable *maps;
    int *nmaps;
    /* Phase 31 S23b (L31-23): the live borrowed views of this function, keyed
       by the view variable and the container, so a shadowed name cannot alias
       either. `view_bad` refuses the next use after a mutation. */
    int  nview;
    int  view_vi[64];
    int  view_cvi[64];
    int  view_bad[64];
    /* Phase 31 S23b (L31-22): the iterated variable of each enclosing
       `foreach`, so a mutation call on it inside the body is refused. */
    int  niter;
    char iter[8][160];
} use ExprOps, ExprTypes, ExprTraitInst;

/* Phase 31 S23a: 1 when `n` is a borrowed container view -- `get` / `entry` on
   a `Vec` / `Map`, a field or deref of one, or a local carrying the provenance
   bit. An owning value (`from`, `{}`, `retain`, `pop`, a call result) answers 0.
   The statement layer records the same bit on a declaration / assignment, so
   the walk is a unit-level function instead of one more `ExprOps` method. */
pub int expr_borrow_root(struct Expr *self, int n);
/* Phase 31 S23b: record that `name` is bound from the borrowed expression
   `init` (L31-23 invalidation), and track the enclosing `foreach` variable
   (L31-22). The statement layer drives both. */
pub void expr_view_bind(struct Expr *self, const char *name, int init);
pub void expr_iter_push(struct Expr *self, const char *name);
pub void expr_iter_pop(struct Expr *self);

/* Argument count of a call: `parse_args` hands back the first node of the
   chain, or 0 for an empty list, and a fresh node carries `next = -1`. */
static int arg_count(struct Arena *a, int first)
{
    int c = 0;
    while (first > 0) {
        c++;
        first = a->nodes[first].next;
    }
    return c;
}

/* Phase 24: is `n` the range index `$`? It is the only `N_VAR` whose `text2` is
   the placeholder, and it is built only inside a range initialiser's element
   expression. `&$`, `$++` and `++$` are rejected through this predicate: `$` is
   not a variable, so none of them has an object to name. */
static int is_range_index(struct Arena *a, int n)
{
    return n >= 0 && a->nodes[n].kind == N_VAR && strcmp(a->nodes[n].text2, "$") == 0;
}

/* ---- 19.2 coarse argument types ------------------------------------------
   The helpers below are pure string work: they classify a type spelling
   without touching the symbol tables, so the caller decides what stays
   unknown. Coarse on purpose -- numerics convert freely (the usual C
   conversions), either side of a pointer may be `void`, and a struct tag
   only counts when the caller can resolve it in this unit's own table. */

static int id_char(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

/* The qualifier word at `p`, or 0. A qualifier is recognised only at a word
   boundary, so a tag such as `constable` keeps its first five letters. */
static int qual_at(const char *p, int prev_id)
{
    if (prev_id) return 0;
    if (strncmp(p, "__restrict__", 12) == 0 && !id_char(p[12])) return 12;
    if (strncmp(p, "__restrict", 10) == 0 && !id_char(p[10])) return 10;
    if (strncmp(p, "volatile", 8) == 0 && !id_char(p[8])) return 8;
    if (strncmp(p, "restrict", 8) == 0 && !id_char(p[8])) return 8;
    if (strncmp(p, "const", 5) == 0 && !id_char(p[5])) return 5;
    return 0;
}

/* Normalise a type spelling: drop the qualifier words and every whitespace
   character. `const char *` and `char *` then compare equal, while
   `const char *` and `char **` still differ. */
static void tnorm(const char *in, char *out, int cap)
{
    int n, prev, q;
    n = 0;
    prev = 0;
    while (*in) {
        q = qual_at(in, prev);
        if (q) {
            in += q;
            continue;                       /* the boundary stands */
        }
        if (*in != ' ' && *in != '\t' && *in != '\n' && *in != '\r') {
            if (n + 2 >= cap) {
                out[0] = 0;
                return;
            }
            out[n] = *in;
            n++;
        }
        prev = id_char((unsigned char)*in);
        in++;
    }
    out[n] = 0;
}

static int tstars(const char *k)
{
    int n = 0;
    while (*k) {
        if (*k == '*') n++;
        k++;
    }
    return n;
}

/* The normalised spelling without its stars: `struct S *` -> `struct S`. */
static void tbase(const char *k, char *out, int cap)
{
    int n = 0;
    while (*k) {
        if (*k != '*') {
            if (n + 2 >= cap) {
                out[0] = 0;
                return;
            }
            out[n] = *k;
            n++;
        }
        k++;
    }
    out[n] = 0;
}

/* One word of the numeric class: a C scalar keyword or a qualifier (the
   tokeniser sees the raw spelling, where qualifiers still appear). */
static int tscalar(const char *w)
{
    return strcmp(w, "void") == 0 || strcmp(w, "char") == 0
        || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
        || strcmp(w, "long") == 0 || strcmp(w, "float") == 0
        || strcmp(w, "double") == 0 || strcmp(w, "signed") == 0
        || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0
        || strcmp(w, "bool") == 0 || strcmp(w, "size_t") == 0
        || strcmp(w, "ssize_t") == 0 || strcmp(w, "ptrdiff_t") == 0
        || strcmp(w, "wchar_t") == 0 || strcmp(w, "va_list") == 0
        || strcmp(w, "int8_t") == 0 || strcmp(w, "int16_t") == 0
        || strcmp(w, "int32_t") == 0 || strcmp(w, "int64_t") == 0
        || strcmp(w, "uint8_t") == 0 || strcmp(w, "uint16_t") == 0
        || strcmp(w, "uint32_t") == 0 || strcmp(w, "uint64_t") == 0
        || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0
        || strcmp(w, "const") == 0 || strcmp(w, "volatile") == 0
        || strcmp(w, "restrict") == 0 || strcmp(w, "__restrict") == 0
        || strcmp(w, "__restrict__") == 0;
}

/* Every whitespace-or-star separated word of the raw spelling is a scalar
   keyword (`unsigned long`, `const char *`). */
static int tnumeric(const char *in)
{
    char tok[MAX_TEXT];
    int n, any;
    n = 0;
    any = 0;
    for (;;) {
        while (*in == ' ' || *in == '\t' || *in == '*') in++;
        if (!*in) break;
        n = 0;
        while (*in && *in != ' ' && *in != '\t' && *in != '*') {
            if (n + 2 >= MAX_TEXT) return 0;
            tok[n] = *in;
            n++;
            in++;
        }
        tok[n] = 0;
        if (!tscalar(tok)) return 0;
        any = 1;
    }
    return any;
}

/* 0 numeric, 1 struct, 2 union, 3 void, -1 anything else (a typedef name
   stays unknown). `base` is the normalised star-less spelling, `raw` the
   spelling as written -- the tag prefix is read from `raw` so a typedef
   called `structor` is not mistaken for a struct. */
static int tclass(const char *raw, const char *base)
{
    if (strcmp(base, "void") == 0) return 3;
    while (*raw == ' ') raw++;
    if (strncmp(raw, "struct ", 7) == 0) return 1;
    if (strncmp(raw, "union ", 6) == 0) return 2;
    if (strncmp(raw, "enum ", 5) == 0) return 0;
    if (tnumeric(raw)) return 0;
    return -1;
}

/* Compare one formal against one actual: 0 compatible, 1 a confident
   mismatch, -1 undecidable, 2 a struct-against-struct pair the caller must
   resolve through its own struct table (the normalised bases are handed back
   in `fb` / `ab`, tag included). */
static int arg_class(const char *formal, const char *actual,
                     char *fb, int fcap, char *ab, int acap)
{
    char fk[MAX_TEXT], ak[MAX_TEXT];
    int fd, ad, cf, ca;

    tnorm(formal, fk, sizeof fk);
    tnorm(actual, ak, sizeof ak);
    if (!fk[0] || !ak[0]) return -1;
    if (strcmp(fk, ak) == 0) return 0;
    if (strchr(fk, '(') || strchr(ak, '(')) return -1;    /* a function pointer */
    tbase(fk, fb, fcap);
    tbase(ak, ab, acap);
    if (!fb[0] || !ab[0]) return -1;
    cf = tclass(formal, fb);
    ca = tclass(actual, ab);
    if (cf < 0 || ca < 0) return -1;
    if (cf == 2 || ca == 2) return -1;                    /* unions: no table */
    fd = tstars(fk);
    ad = tstars(ak);
    if (fd != ad) {
        /* `void *` converts to and from any object pointer */
        if (cf == 3 && fd > 0 && ad > 0) return 0;
        if (ca == 3 && ad > 0 && fd > 0) return 0;
        return 1;
    }
    if (cf == 3 || ca == 3) return fd > 0 ? 0 : -1;
    if (cf == 0 && ca == 0) return 0;
    if (cf != ca) return 1;
    return 2;
}

/* Phase 32 S7: a formal spelled exactly `T` / `U` (or `T *` / `U *`) takes
   the instance's concrete spelling. Any other shape that mentions a type
   parameter is undecidable here, so the caller skips it (the card's
   restricted substitution); a formal that mentions no parameter passes
   through unchanged. */
static int subst_tparam(const char *spell, const char *n1, const char *v1,
                        const char *n2, const char *v2, char *out, int cap)
{
    char k[MAX_TEXT];
    char p[MAX_TEXT];
    int i, j = 0;

    for (i = 0; spell[i] && j + 1 < (int)sizeof k; i++)
        if (spell[i] != ' ' && spell[i] != '\t') k[j++] = spell[i];
    k[j] = 0;
    if (n1 && n1[0]) {
        if (strcmp(k, n1) == 0) { snprintf(out, (size_t)cap, "%s", v1); return 0; }
        snprintf(p, sizeof p, "%s*", n1);
        if (strcmp(k, p) == 0) { snprintf(out, (size_t)cap, "%s *", v1); return 0; }
    }
    if (n2 && n2[0]) {
        if (strcmp(k, n2) == 0) { snprintf(out, (size_t)cap, "%s", v2); return 0; }
        snprintf(p, sizeof p, "%s*", n2);
        if (strcmp(k, p) == 0) { snprintf(out, (size_t)cap, "%s *", v2); return 0; }
    }
    if ((n1 && n1[0] && strstr(k, n1)) || (n2 && n2[0] && strstr(k, n2)))
        return -1;
    snprintf(out, (size_t)cap, "%s", spell);
    return 0;
}

/* Read the next comma-separated item of a function pointer's parameter text
   (`parse_type` writes the list without parameter names) into `out`, trimming
   its surrounding spaces. Returns 0 once the list is exhausted. */
static int plist_next(const char *p, int *pos, char *out, int cap)
{
    int i, n;

    i = *pos;
    while (p[i] == ' ' || p[i] == '\t') i++;
    if (!p[i]) return 0;
    n = 0;
    while (p[i] && p[i] != ',') {
        if (n + 1 < cap) out[n++] = p[i];
        i++;
    }
    out[n] = 0;
    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '\t')) out[--n] = 0;
    if (p[i] == ',') i++;
    *pos = i;
    return 1;
}

/* Does the `(` at the cursor open a closure literal? The token stream cannot be
   rewound, so the answer comes from the raw source: scan to the matching `)`
   (skipping strings, chars and comments) and look for `=>`. A parenthesised
   expression is left untouched; the classifier never consumes anything. */
static int closure_ahead(struct Expr *self)
{
    const char *s = self->lex->src;
    int i = self->lex->tokstart;
    int depth = 0;

    if (s[i] != '(') return 0;
    for (; s[i]; i++) {
        char c = s[i];
        if (c == '"' || c == '\'') {
            char q = c;
            i++;
            while (s[i] && s[i] != q) {
                if (s[i] == '\\' && s[i + 1]) i++;
                i++;
            }
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '/') {
            while (s[i] && s[i] != '\n') i++;
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '*') {
            i += 2;
            while (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++;
            if (!s[i]) return 0;
            i++;
            continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            depth--;
            if (depth == 0) {
                i++;
                break;
            }
        }
    }
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') i++;
    return s[i] == '=' && s[i + 1] == '>';
}

static int closure_capture_index(struct Closure *c, const char *name)
{
    int i;

    for (i = 0; i < c->ncap; i++)
        if (strcmp(c->cap_name[i], name) == 0) return i;
    return -1;
}

/* Phase 21 S4: the same tier-1 hint the other closure errors carry, printed
   through the note channel so no counter, JSON document or exit code moves.
   R02: the recipe is self-contained -- `Callable` lives in ct-pkg and nothing
   in this repository defines it, so the hint cannot name it. It stays inside
   the 160-byte preprocessor token: a longer `#define` line is truncated when
   the compiler reads its own source. */
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

static int closure_capture_error(struct Expr *self, int line, const char *msg)
{
    tool::diag::ct_sem_error(line, 1, msg, self->sup->mem->path);
    tool::diag::ct_sem_note(line, 1, CT_EXPR_CLOSURE_HINT, self->sup->mem->path);
    return -1;
}

/* R09: a captured name or type that does not fit is a hard error. Truncating it
   would leave the environment field with a shorter type (or a name the emitter
   cannot match) and surface later as a `cc` failure with no source position. */
static int closure_copy(struct Expr *self, char *dst, const char *src, const char *what)
{
    char msg[512];

    if (strlen(src) >= MAX_TEXT) {
        snprintf(msg, sizeof msg, "%s is too long (limit %d)", what, MAX_TEXT - 1);
        return self->sup->fail(msg);
    }
    snprintf(dst, MAX_TEXT, "%s", src);
    return 0;
}

static int closure_capture_add(struct Expr *self, int ci, int vi, int line)
{
    struct Closure *c = &self->sym->closures[ci];
    const char *name = self->sym->vars[vi].name;
    char msg[512];
    int k;

    /* E4: an `own` handle would get a second owner and a `borrow` a second
       handback, so neither can be copied into the environment. The check runs
       while the capture is collected, before AutoDrop / borrow is registered. */
    if (self->sym->vars[vi].autodrop || self->sym->vars[vi].borrowed) {
        snprintf(msg, sizeof msg,
                 "a closure cannot capture '%s' (it is 'own' or 'borrow')", name);
        return closure_capture_error(self, line, msg);
    }
    /* a closure is a binding, not a value (E7 on the capture path) */
    if (self->sym->vars[vi].is_closure)
        return closure_capture_error(self, line, "a closure cannot capture another closure");
    /* An array is not a value in C: there is no assignment that would copy it
       into the env struct, and an element-wise copy has no spelling on the
       inline `(fn, env)` path. Refuse it instead of emitting an env field whose
       type lost its dimensions. */
    if (self->sym->vars[vi].is_array) {
        snprintf(msg, sizeof msg,
                 "a closure cannot capture the array '%s' (capture a pointer to it instead)", name);
        return closure_capture_error(self, line, msg);
    }
    if (closure_capture_index(c, name) >= 0) return 0;
    if (c->ncap >= 16)
        return self->sup->fail("a closure takes too many captures (limit 16)");
    if (closure_copy(self, c->cap_name[c->ncap], name, "a captured name") != 0) return -1;
    if (closure_copy(self, c->cap_type[c->ncap], self->sym->vars[vi].type,
                     "a captured type") != 0) return -1;
    c->ncap++;
    /* An inner literal is built inside the enclosing trampoline, so a name that
       comes from outside the enclosing literal must also sit in its environment;
       otherwise the inner initialiser would name a variable the trampoline does
       not have. A name local to the enclosing body (at or after its `pstart`)
       stays a plain local and is not copied up. */
    for (k = self->ncl_stack - 2; k >= 0; k--) {
        int oi = self->cl_stack[k];
        struct Closure *oc = &self->sym->closures[oi];
        int j, dup = 0;

        if (vi >= self->cl_pstart[k]) continue;
        for (j = 0; j < oc->ncap; j++)
            if (strcmp(oc->cap_name[j], name) == 0) dup = 1;
        if (dup) continue;
        if (oc->ncap >= 16)
            return self->sup->fail("a closure takes too many captures (limit 16)");
        if (closure_copy(self, oc->cap_name[oc->ncap], name, "a captured name") != 0) return -1;
        if (closure_copy(self, oc->cap_type[oc->ncap], self->sym->vars[vi].type,
                         "a captured type") != 0) return -1;
        oc->ncap++;
    }
    return 0;
}

/* Collect the free names of a closure body. The parameter scope is still open,
   so a name at or after `pstart` is the literal's own parameter -- a parameter
   that shadows an outer variable keeps the outer one out of the capture set,
   which is exactly the snapshot the rule needs. Globals are not captures. */
static int closure_walk(struct Expr *self, int ci, int n, int pstart)
{
    struct Node *nd;
    int vi;

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    /* a nested literal owns its own environment (S5) */
    if (nd->kind == N_CLOSURE) return 0;
    /* calling another binding from inside a closure is the capture path the
       call node spells in `text2`, not in a child: a closure cannot capture
       another closure (E7). */
    if (nd->kind == N_CALL) {
        vi = self->sym->find_var(nd->text2);
        if (vi >= 0 && vi < pstart && !self->sym->vars[vi].is_global
            && self->sym->vars[vi].is_closure)
            return closure_capture_error(self, nd->line,
                                         "a closure cannot capture another closure");
    }
    if (nd->kind == N_VAR) {
        vi = self->sym->find_var(nd->text2);
        if (vi < 0 || vi >= pstart) return 0;
        if (self->sym->vars[vi].is_global) return 0;
        return closure_capture_add(self, ci, vi, nd->line);
    }
    if (closure_walk(self, ci, nd->a, pstart) != 0) return -1;
    if (closure_walk(self, ci, nd->b, pstart) != 0) return -1;
    if (closure_walk(self, ci, nd->c, pstart) != 0) return -1;
    if (closure_walk(self, ci, nd->d, pstart) != 0) return -1;
    return closure_walk(self, ci, nd->next, pstart);
}

/* Phase 21 R01: a local declaration inside the body may not shadow a captured
   name. The capture walk runs after the body's own scope has been popped, so a
   shadowed name resolves to the enclosing variable and enters the capture set;
   the emitter then rewrites every same-named N_VAR in the body to the env field
   and a read of the local silently returns the snapshot. Rejecting the shadow
   keeps the snapshot rule honest (design §4.2). A nested literal owns its own
   environment and runs its own check. */
static int closure_walk_shadow(struct Expr *self, int ci, int n)
{
    struct Node *nd;
    struct Closure *c = &self->sym->closures[ci];
    char msg[512];
    int k;

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    if (nd->kind == N_CLOSURE) return 0;
    if (nd->kind == N_DECL) {
        for (k = 0; k < c->ncap; k++) {
            if (strcmp(c->cap_name[k], nd->text2) == 0) {
                snprintf(msg, sizeof msg,
                         "a local cannot shadow the captured '%s'", nd->text2);
                return closure_capture_error(self, nd->line, msg);
            }
        }
    }
    if (closure_walk_shadow(self, ci, nd->a) != 0) return -1;
    if (closure_walk_shadow(self, ci, nd->b) != 0) return -1;
    if (closure_walk_shadow(self, ci, nd->c) != 0) return -1;
    if (closure_walk_shadow(self, ci, nd->d) != 0) return -1;
    return closure_walk_shadow(self, ci, nd->next);
}

/* A captured variable belongs to the enclosing frame; the closure may read it
   but must not write the binding or take its address (D21-2). Writes through a
   captured pointer (`p->x = 1`) are reads of the binding and stay legal. */
static int closure_walk_mutate(struct Expr *self, int ci, int n)
{
    struct Node *nd;
    struct Closure *c = &self->sym->closures[ci];

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    if (nd->kind == N_CLOSURE) return 0;
    if (nd->kind == N_ASSIGN && nd->a >= 0
        && self->arena->nodes[nd->a].kind == N_VAR
        && closure_capture_index(c, self->arena->nodes[nd->a].text2) >= 0)
        return closure_capture_error(self, self->arena->nodes[nd->a].line,
                                     "a captured variable cannot be reassigned inside a closure");
    if ((nd->kind == N_PRE || nd->kind == N_POST) && nd->a >= 0
        && self->arena->nodes[nd->a].kind == N_VAR
        && closure_capture_index(c, self->arena->nodes[nd->a].text2) >= 0)
        return closure_capture_error(self, self->arena->nodes[nd->a].line,
                                     "a captured variable cannot be reassigned inside a closure");
    if (nd->kind == N_ADDR && nd->a >= 0
        && self->arena->nodes[nd->a].kind == N_VAR
        && closure_capture_index(c, self->arena->nodes[nd->a].text2) >= 0)
        return closure_capture_error(self, self->arena->nodes[nd->a].line,
                                     "the address of a captured variable cannot be taken inside a closure");
    if (closure_walk_mutate(self, ci, nd->a) != 0) return -1;
    if (closure_walk_mutate(self, ci, nd->b) != 0) return -1;
    if (closure_walk_mutate(self, ci, nd->c) != 0) return -1;
    if (closure_walk_mutate(self, ci, nd->d) != 0) return -1;
    return closure_walk_mutate(self, ci, nd->next);
}

/* 19.1 call-site arity: only a callee whose signature is known is compared.
   A call through a function pointer, an undeclared C library name, a `map`
   recipe and a static type host all stay unknown and pass. The caller passes
   the expected count it already knows (a variadic function's named part), so
   this method only reports the mismatch; warning severity keeps `ct compile`
   exit codes and artifacts unchanged (D19-4), and `ct check` (19.4) raises the
   same record to an error. */

/* Compare a closure literal's parameter list with a hosting function-pointer
   type and take the literal's return type from that host (D21-14). `skip_env`
   drops the first host parameter: the formal of a `(fn, env)` pair spells the
   environment there. The parameter comparison reuses the same normalisation
   `arg_class` gives 19.3. A mismatch reports at the source position and
   returns non-zero; on success `c->ret` is set when `set_ret` is non-zero.
   R03: comparing a declared binding with a host tail must not write the return
   type, or the binding's own trampoline would silently take the host's type
   for every other call site. */
static int closure_match(struct Expr *self, int ci, const char *host, int skip_env, int set_ret)
{
    struct Closure *c = &self->sym->closures[ci];
    char ret[MAX_TEXT];
    char plist[MAX_TEXT];
    char item[MAX_TEXT];
    const char *p;
    size_t n, hn;
    int lp, rp, pos, want, i, r;

    p = strstr(host, "(*");
    if (!p || p == host)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    n = (size_t)(p - host);
    while (n > 0 && (host[n - 1] == ' ' || host[n - 1] == '\t')) n--;
    if (n == 0 || n >= MAX_TEXT)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    snprintf(ret, sizeof ret, "%.*s", (int)n, host);
    hn = strlen(host);
    lp = -1;
    rp = -1;
    for (n = 0; n < hn; n++) {
        if (host[n] == '(') lp = (int)n;
        else if (host[n] == ')') rp = (int)n;
    }
    if (lp < 0 || rp <= lp + 1)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    snprintf(plist, sizeof plist, "%.*s", rp - lp - 1, host + lp + 1);
    if (skip_env) {
        char *comma = strchr(plist, ',');
        if (comma) snprintf(plist, sizeof plist, "%s", comma + 1);
        else plist[0] = 0;
    }
    want = 0;
    if (!(strcmp(plist, "void") == 0 || plist[0] == 0)) {
        pos = 0;
        while (plist_next(plist, &pos, item, sizeof item)) want++;
    }
    if (want != c->nparams) {
        char msg[512];
        snprintf(msg, sizeof msg,
                 "this closure takes %d parameters, but the expected type takes %d",
                 c->nparams, want);
        return self->sup->fail_at(c->line, msg);
    }
    pos = 0;
    i = 0;
    while (plist_next(plist, &pos, item, sizeof item)) {
        char fb[MAX_TEXT], ab[MAX_TEXT];
        int fs, as;
        r = arg_class(item, c->ptype[i], fb, sizeof fb, ab, sizeof ab);
        if (r == 2) {
            fs = self->sym->find_struct(fb + 6);
            as = self->sym->find_struct(ab + 6);
            r = (fs < 0 || as < 0) ? -1 : (fs != as);
        }
        if (r == 1) {
            char msg[512];
            snprintf(msg, sizeof msg,
                     "this closure's parameter %d is '%s', but the expected type is '%s'",
                     i + 1, c->ptype[i], item);
            return self->sup->fail_at(c->line, msg);
        }
        i++;
    }
    if (set_ret) snprintf(c->ret, MAX_TEXT, "%s", ret);
    return 0;
}

/* R03: a declared binding fills a `(fn, env)` pair, but unlike an inline
   literal its own trampoline already exists with the return type its
   declaration took, so the comparison is read-only (`set_ret` 0). */

/* Phase 31 S23b (L31-23): the container a borrowed initialiser came from.
   Answers its variable index in `*cvi`; 0 when `init` is not a view. */
static int view_source(struct Expr *self, int init, int *cvi)
{
    int n = init, j;

    while (n >= 0 && (self->arena->nodes[n].kind == N_MEMBER || self->arena->nodes[n].kind == N_ARROW || self->arena->nodes[n].kind == N_DEREF))
        n = self->arena->nodes[n].a;
    if (n < 0) return 0;
    if (self->arena->nodes[n].kind == N_MCALL
        && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
        && (strcmp(self->arena->nodes[n].text2, "get") == 0
            || strcmp(self->arena->nodes[n].text2, "entry") == 0)) {
        const char *ty = self->arena->nodes[n].text;
        if (!(strncmp(ty, "struct Vec_", 11) == 0 || strncmp(ty, "Vec_", 4) == 0
              || strncmp(ty, "struct Map_", 11) == 0 || strncmp(ty, "Map_", 4) == 0))
            return 0;
        n = self->arena->nodes[n].a;
        while (n >= 0 && (self->arena->nodes[n].kind == N_MEMBER || self->arena->nodes[n].kind == N_ARROW || self->arena->nodes[n].kind == N_DEREF))
            n = self->arena->nodes[n].a;
        if (n < 0 || self->arena->nodes[n].kind != N_VAR) return 0;
        *cvi = self->sym->find_var(self->arena->nodes[n].text2);
        return *cvi >= 0;
    }
    if (self->arena->nodes[n].kind == N_VAR) {
        int src = self->sym->find_var(self->arena->nodes[n].text2);
        for (j = 0; src >= 0 && j < self->nview; j++)
            if (self->view_vi[j] == src) {
                *cvi = self->view_cvi[j];
                return 1;
            }
    }
    return 0;
}

void expr_view_bind(struct Expr *self, const char *name, int init)
{
    int vi = self->sym->find_var(name);
    int idx = -1, i, cvi = -1, ok;

    if (vi < 0) return;
    for (i = 0; i < self->nview; i++)
        if (self->view_vi[i] == vi) { idx = i; break; }
    ok = view_source(self, init, &cvi);
    if (!ok) {
        if (idx >= 0) self->view_vi[idx] = -1;
        return;
    }
    if (idx < 0) {
        if (self->nview >= 64) return;
        idx = self->nview;
        self->nview = self->nview + 1;
    }
    self->view_vi[idx] = vi;
    self->view_cvi[idx] = cvi;
    self->view_bad[idx] = 0;
}

void expr_iter_push(struct Expr *self, const char *name)
{
    if (self->niter >= 8) return;
    snprintf(self->iter[self->niter], MAX_TEXT, "%s", name);
    self->niter = self->niter + 1;
}

void expr_iter_pop(struct Expr *self)
{
    if (self->niter > 0) self->niter = self->niter - 1;
}

/* L31-23: a mutation of `cont` invalidates every live view of it, and the next
   use of one is refused. */
static void view_mark(struct Expr *self, const char *cont)
{
    int cvi = self->sym->find_var(cont), j;

    if (cvi < 0) return;
    for (j = 0; j < self->nview; j++)
        if (self->view_vi[j] >= 0 && self->view_cvi[j] == cvi)
            self->view_bad[j] = 1;
}

static int view_use(struct Expr *self, const char *name, int line, int col)
{
    int vi = self->sym->find_var(name), j;

    if (vi < 0) return 0;
    for (j = 0; j < self->nview; j++)
        if (self->view_vi[j] == vi && self->view_bad[j])
            return tool::diag::ct_sem_error(line, col,
                "a borrowed view is invalidated by a later mutation of its container; copy it with retain() first",
                self->sup->mem->path);
    return 0;
}

static int iter_hit(struct Expr *self, const char *name)
{
    int i;

    for (i = 0; i < self->niter; i++)
        if (strcmp(self->iter[i], name) == 0) return 1;
    return 0;
}

impl ExprOps for Expr {
    int arity_check(int line, int col, const char *callee, int got, int want)
    {
        char msg[MAX_TEXT];
        if (got == want) return 0;
        snprintf(msg, sizeof msg, "takes %d argument(s), %d given", want, got);
        if (self->sup->arity_warn(line, col, callee, msg) != 0)
            return self->sup->fail("too many warnings");
        return 0;
    }

    /* Phase 21 S4: a closure actual is one source argument that occupies the
       `(fn, env)` pair, two C arguments. The pair is adjacent and shaped
       `ret (*P)(void *…, …)` followed by `void *E`; anything else is E6. */
    int type_is_fnptr(const char *t)
    {
        (void)self;
        return t != 0 && strstr(t, "(*") != 0;
    }

    int type_is_void_ptr(const char *t)
    {
        (void)self;
        return t != 0 && strncmp(t, "void *", 6) == 0;
    }

    /* R05: membership of a `(fn, env)` pair is decided by the first formal, not
       by the mere presence of "void *" anywhere in the type. A plain
       `int (*P)(int x, void *ctx)` also contains it, and `skip_env` would then
       drop a real parameter and shift the whole tail. The list is split with
       the same parser `closure_match` uses, and the first item must start with
       `void *` (not `void **`). */
    int formal_is_env_fn(const char *t)
    {
        char plist[MAX_TEXT];
        char item[MAX_TEXT];
        int lp, rp, pos;
        size_t n, hn;

        if (!self->type_is_fnptr(t)) return 0;
        hn = strlen(t);
        lp = -1;
        rp = -1;
        for (n = 0; n < hn; n++) {
            if (t[n] == '(') lp = (int)n;
            else if (t[n] == ')') rp = (int)n;
        }
        if (lp < 0 || rp <= lp + 1) return 0;
        snprintf(plist, sizeof plist, "%.*s", rp - lp - 1, t + lp + 1);
        pos = 0;
        if (!plist_next(plist, &pos, item, sizeof item)) return 0;
        if (strncmp(item, "void *", 6) != 0) return 0;
        return item[6] != '*';
    }

    int arg_is_closure(int a)
    {
        const char *name;
        int vi;

        if (a < 0) return 0;
        if (self->arena->nodes[a].kind == N_CLOSURE) return 1;
        if (self->arena->nodes[a].kind != N_VAR) return 0;
        name = self->arena->nodes[a].text2;
        vi = self->sym->find_var(name);
        return vi >= 0 && self->sym->vars[vi].is_closure;
    }

    int closure_arg_count(int args)
    {
        int cur, n;

        cur = args;
        n = 0;
        while (cur > 0) {
            if (self->arg_is_closure(cur)) n++;
            cur = self->arena->nodes[cur].next;
        }
        return n;
    }

    /* Returns 0 when every closure actual fills the start of a `(fn, env)`
       pair. An inline literal is bound to the host fn type right here (D21-14),
       and a declared binding fills the pair too (R03): its parameter tail is
       compared, but its return type stays the one its declaration took. The
       binding is still a binding -- it cannot be copied, renamed, stored in a
       field or returned (D21-13). A plain function-pointer slot and a position
       that is not a pair are distinct errors; the second also carries the E8
       note, because the compiler cannot see whether the callee keeps the
       environment. */
    int closure_arg_check(int line, int col, const char *callee, int args, int fi)
    {
        const char *e8;
        int cur, pos, ok, np;
        const char *ft;

        e8 = "the compiler cannot see whether the callee keeps the environment; the environment dies with this frame";
        if (fi >= 0) np = self->sym->funcs[fi].nparams;
        else np = 0;
        cur = args;
        pos = 0;
        while (cur > 0) {
            if (self->arg_is_closure(cur)) {
                ok = 0;
                ft = "";
                if (fi >= 0 && pos < np) ft = self->sym->funcs[fi].ptype[pos];
                if (fi >= 0 && pos + 1 < np)
                    ok = self->formal_is_env_fn(ft)
                         && self->type_is_void_ptr(self->sym->funcs[fi].ptype[pos + 1]);
                if (!ok) {
                    if (self->type_is_fnptr(ft) && !self->formal_is_env_fn(ft)) {
                        tool::diag::ct_sem_error(line, col,
                            "a closure cannot be used where a plain function pointer is expected",
                            self->sup->mem->path);
                        tool::diag::ct_sem_note(line, col, CT_EXPR_CLOSURE_HINT,
                                                self->sup->mem->path);
                    } else {
                        tool::diag::ct_sem_error(line, col,
                            "a closure argument must fill a '(fn, env)' parameter pair",
                            self->sup->mem->path);
                        tool::diag::ct_sem_note(line, col, CT_EXPR_CLOSURE_HINT,
                                                self->sup->mem->path);
                        tool::diag::ct_sem_note(line, col, e8, self->sup->mem->path);
                    }
                    return -1;
                }
                if (self->arena->nodes[cur].kind == N_CLOSURE) {
                    if (self->closure_arg_bind(self->arena->nodes[cur].num, ft) != 0)
                        return -1;
                } else {
                    /* R03: a declared binding fills the pair as well. Its own
                       trampoline keeps the return type its declaration took, so
                       only the parameter tail is compared. */
                    int vi = self->sym->find_var(self->arena->nodes[cur].text2);
                    if (vi >= 0 && self->sym->vars[vi].is_closure
                        && closure_match(self, self->sym->vars[vi].closure_id, ft, 1, 0) != 0)
                        return -1;
                }
                pos += 2;
            } else {
                pos++;
            }
            cur = self->arena->nodes[cur].next;
        }
        (void)callee;
        return 0;
    }

    /* 25.1: the static-recipe counterpart of `closure_arg_check`. The method's
       parameters are addressed positionally and a closure fills two slots, so
       a closure anywhere else is L25-1: the recipe has no place to put the
       `(fn, env)` pair and would silently hand the trampoline to one formal.
       A pair that does line up binds exactly as a plain call does. */
    int map_closure_check(int line, int col, int args, int ti, int mi)
    {
        char msg[MAX_TEXT];
        const char *ft;
        int cur, pos, ok, np;

        np = self->sym->traits[ti].m[mi].nparams;
        cur = args;
        pos = 0;
        while (cur > 0) {
            if (self->arg_is_closure(cur)) {
                ok = 0;
                ft = "";
                if (pos < np) ft = self->sym->traits[ti].m[mi].ptype[pos];
                /* D25-5: the `...` tail has no fixed slot pair. When the
                   method is variadic and the pair would run past its named
                   parameters, that is L25-3 -- a case of its own, not the
                   generic non-pair L25-1 (the wording would otherwise say
                   got ''). */
                if (self->sym->traits[ti].m[mi].variadic
                    && (pos >= np || pos + 1 >= np)) {
                    snprintf(msg, sizeof msg,
                             "a map recipe cannot pass a closure through '...'");
                    tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
                    tool::diag::ct_sem_note(line, col, CT_EXPR_CLOSURE_HINT,
                                            self->sup->mem->path);
                    return -1;
                }
                if (pos + 1 < np)
                    ok = self->formal_is_env_fn(ft)
                         && self->type_is_void_ptr(self->sym->traits[ti].m[mi].ptype[pos + 1]);
                if (!ok) {
                    snprintf(msg, sizeof msg,
                             "a closure argument must fill a '(fn, env)' parameter pair (got '%s')",
                             ft);
                    tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
                    tool::diag::ct_sem_note(line, col, CT_EXPR_CLOSURE_HINT,
                                            self->sup->mem->path);
                    return -1;
                }
                if (self->arena->nodes[cur].kind == N_CLOSURE) {
                    if (self->closure_arg_bind(self->arena->nodes[cur].num, ft) != 0)
                        return -1;
                } else {
                    int vi = self->sym->find_var(self->arena->nodes[cur].text2);
                    if (vi >= 0 && self->sym->vars[vi].is_closure
                        && closure_match(self, self->sym->vars[vi].closure_id, ft, 1, 0) != 0)
                        return -1;
                }
                pos += 2;
            } else {
                pos++;
            }
            cur = self->arena->nodes[cur].next;
        }
        return 0;
    }

    /* A static map is expanded into its recipe at the call site, so an actual
       the recipe does not name is simply dropped. A variadic method forwards
       the tail (`...`), which turns the count into a lower bound; a fixed one
       must match exactly. */
    int map_arity(int line, int col, const char *trait, const char *method, int got)
    {
        int ti, mi, want;
        ti = self->sym->find_trait(trait);
        if (ti < 0) return 0;
        for (mi = 0; mi < self->sym->traits[ti].nm; mi++)
            if (strcmp(self->sym->traits[ti].m[mi].name, method) == 0) break;
        if (mi >= self->sym->traits[ti].nm) return 0;
        want = self->sym->traits[ti].m[mi].nparams;
        if (self->sym->traits[ti].m[mi].variadic && got >= want) return 0;
        return self->arity_check(line, col, method, got, want);
    }

    /* 19.2: the resolved signature beside the argument chain, one position at
       a time. Only a position where both sides can name a type is compared;
       an interface formal (boxing owns it), an array on either side (decay),
       a cast argument and an argument without a derivable type all stay
       unknown and pass (D19-3). This half stays silent: it reports the first
       confident mismatch so `argtype_check` can warn once and a type host can
       try every candidate before it does (25.1). */
    int argtype_mismatch(int args, int fi, int ti, int mi, char *msg, int cap)
    {
        char at[MAX_TEXT];
        char fb[MAX_TEXT], ab[MAX_TEXT];
        const char *ft;
        int cur, k, np, skip, r;

        if (fi >= 0) np = self->sym->funcs[fi].nparams;
        else np = self->sym->traits[ti].m[mi].nparams;
        cur = args;
        k = 0;
        while (cur > 0 && k < np) {
            skip = 0;
            if (fi >= 0) ft = self->sym->funcs[fi].ptype[k];
            else ft = self->sym->traits[ti].m[mi].ptype[k];
            /* an array parameter is a pointer in disguise: the dims sit in
               `pdim` (a function) or ride in the spelling (a trait method) */
            if (fi >= 0 && self->sym->funcs[fi].pdim[k][0]) skip = 1;
            if (!skip && strchr(ft, '[')) skip = 1;
            if (!skip) {
                char itr[MAX_TEXT];
                int iip = 0;
                if (self->sup->iface_ref_type(ft, itr, sizeof itr, &iip)) skip = 1;
            }
            if (!skip && self->arena->nodes[cur].kind == N_CAST) skip = 1;
            /* a closure actual fills `(fn, env)`: its own type is not a value
               type, and it consumes two formals (see the tail of the loop) */
            if (!skip && self->arg_is_closure(cur)) skip = 1;
            /* `0` is a null pointer constant: C accepts it wherever a pointer
               is expected, so a derived `int` is not a mismatch. */
            if (!skip && self->arena->nodes[cur].kind == N_NUM
                && self->arena->nodes[cur].num == 0
                && strchr(ft, '*')) skip = 1;
            if (!skip && self->sup->expr_ctype(cur, at, sizeof at) != 0) skip = 1;
            if (!skip && strchr(at, '[')) skip = 1;   /* a decayed array */
            if (!skip) {
                r = arg_class(ft, at, fb, sizeof fb, ab, sizeof ab);
                if (r == 2) {
                    int fs = self->sym->find_struct(fb + 6);
                    int as = self->sym->find_struct(ab + 6);
                    r = (fs < 0 || as < 0) ? -1 : (fs != as);
                }
                if (r == 1) {
                    snprintf(msg, cap, "argument %d: expected '%s', got '%s'",
                             k + 1, ft, at);
                    return 1;
                }
            }
            if (self->arg_is_closure(cur)) k += 2;
            else k++;
            cur = self->arena->nodes[cur].next;
        }
        return 0;
    }

    int argtype_check(int line, int col, const char *callee, int args, int fi, int ti, int mi)
    {
        char msg[MAX_TEXT];

        if (self->argtype_mismatch(args, fi, ti, mi, msg, sizeof msg)) {
            if (self->sup->type_warn(line, col, callee, msg) != 0)
                return self->sup->fail("too many warnings");
        }
        return 0;
    }

    /* SH-60: the static-recipe form of 19.2. The call site is expanded into
       the recipe against the host trait's signature, and the mapping unit is
       usually imported, so `ct check` (single unit) can never look at this
       call. A confident mismatch therefore fails the ct stage outright
       instead of waiting for a C warning that the recipe may not even keep. */
    int argtype_check_static(int line, int col, const char *callee, int args, int ti, int mi)
    {
        char msg[MAX_TEXT];
        char full[MAX_TEXT];

        if (!self->argtype_mismatch(args, -1, ti, mi, msg, sizeof msg))
            return 0;
        snprintf(full, sizeof full, "type mismatch: '%s' %s", callee, msg);
        tool::diag::ct_sem_error(line, col, full, self->sup->mem->path);
        return -1;
    }

    /* 19.3: an impl's parameter spelling against the trait's -- two declared
       types instead of an argument expression, the same coarse rules as 19.2
       (`arg_class` plus this unit's struct table). The trait may live in an
       imported unit, so only a confident mismatch (1) counts; every
       undecidable pair passes (D19-3). */
    int decl_type_compat(const char *formal, const char *actual)
    {
        char fb[MAX_TEXT], ab[MAX_TEXT];
        int r = arg_class(formal, actual, fb, sizeof fb, ab, sizeof ab);
        if (r == 2) {
            int fs = self->sym->find_struct(fb + 6);
            int as = self->sym->find_struct(ab + 6);
            r = (fs < 0 || as < 0) ? -1 : (fs != as);
        }
        return r;
    }

    /* S2 binding: a closure literal on the right of a function-pointer
       declaration. `host` is the declared type (`int (*)(int x)`); its return
       type and parameter list are compared with the literal's. The parameter
       comparison reuses `decl_type_compat`, the same normalisation 19.3 uses.
       S5 adds the argument form: the host is the callee's formal pair
       (`int (*)(void *, int)`), whose first parameter is the environment and is
       skipped, and the return type still comes from the host fn (D21-14). */
    int closure_bind(int ci, const char *host, const char *vname)
    {
        int vi;

        if (closure_match(self, ci, host, 0, 1) != 0) return -1;
        vi = self->sym->find_var(vname);
        if (vi < 0)
            return self->sup->fail("a closure cannot be used where a plain function pointer is expected");
        if (self->sym->vars[vi].is_global || self->sym->vars[vi].is_static) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg,
                     "a closure cannot be stored in '%s' (its scope outlives the closure)", vname);
            return self->sup->fail(msg);
        }
        self->sym->vars[vi].is_closure = 1;
        self->sym->vars[vi].closure_id = ci;
        return 0;
    }

    int closure_arg_bind(int ci, const char *ftype)
    {
        return closure_match(self, ci, ftype, 1, 1);
    }

    /* The type keywords. L0 / L1 / L2 have always accepted the `stdint` /
       `stddef` / `stdbool` spellings and the qualifiers, so ct-ast lists the same
       set (`restrict` included): a program written against those headers is a
       pass-through declaration here, and the C compiler still owns the meaning.
       `DIR` is ct-ast's own addition (the directory handle `opendir` returns). */
    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "void") == 0 || strcmp(w, "char") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
            || strcmp(w, "long") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "signed") == 0
            || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0
            || strcmp(w, "bool") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "volatile") == 0 || strcmp(w, "restrict") == 0
            || strcmp(w, "__restrict") == 0 || strcmp(w, "__restrict__") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "union") == 0
            || strcmp(w, "enum") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "ssize_t") == 0 || strcmp(w, "ptrdiff_t") == 0
            || strcmp(w, "wchar_t") == 0 || strcmp(w, "va_list") == 0
            || strcmp(w, "int8_t") == 0 || strcmp(w, "int16_t") == 0
            || strcmp(w, "int32_t") == 0 || strcmp(w, "int64_t") == 0
            || strcmp(w, "uint8_t") == 0 || strcmp(w, "uint16_t") == 0
            || strcmp(w, "uint32_t") == 0 || strcmp(w, "uint64_t") == 0
            || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0;
    }

    int type_append(char *out, int cap, int *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->sup->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, (size_t)(cap - *n), "%s", tok);
        if (w < 0 || w >= cap - *n) return self->sup->fail("type is too long");
        *n += w;
        return 0;
    }

    /* Phase 26 (D26-5): monomorphise `gfi` for `targ` once per asking unit.
       The instance is a private `funcs` row with the template's signature
       substituted; its body is the template's own N_FUNC node, which the
       emitter writes under `gtparam`/`gtarg` (D26-7). The key is the triple
       (template row, owner, concrete spelling), and each owner numbers its
       static copies from one, independently of every other unit. */
    int generic_instance(int gfi, const char *targ, int line, int col)
    {
        char cname[MAX_TEXT];
        char tmp[MAX_TEXT];
        int i, k, ni, fi, suffix, taken, seq;

        seq = 1;
        for (i = 0; i < self->sym->nginsts; i++) {
            if (self->sym->ginsts[i].owner != self->cur_unit) continue;
            if (self->sym->ginsts[i].func == gfi
                && strcmp(self->sym->ginsts[i].targ, targ) == 0)
                return i;
            seq++;
        }
        if (self->sym->nginsts >= MAX_GENERIC_INSTS)
            return self->sup->fail("too many generic instances in this unit");
        if (self->sym->nfunc >= self->sym->nfunc_base + MAX_FUNCS)
            return self->sup->fail("too many functions in this unit");
        /* `<name>__ct<N>`; a user function may already hold the spelling, so a
           numeric suffix is retried a bounded number of times (R6). Another
           unit's static instance is not a collision in this unit's C file. */
        taken = 1;
        for (suffix = 0; suffix <= 8 && taken; suffix++) {
            if (suffix == 0)
                snprintf(cname, sizeof cname, "%s__ct%d",
                         self->sym->funcs[gfi].cname, seq);
            else
                snprintf(cname, sizeof cname, "%s__ct%d_%d",
                         self->sym->funcs[gfi].cname, seq, suffix);
            fi = self->sym->find_func(cname);
            taken = (fi >= 0);
            for (i = 0; taken && i < self->sym->nginsts; i++)
                if (self->sym->ginsts[i].row == fi
                    && self->sym->ginsts[i].owner != self->cur_unit)
                    taken = 0;
        }
        if (taken) return self->sup->fail("cannot name a generic instance uniquely");
        ni = self->sym->nfunc;
        self->sym->nfunc++;
        memcpy(&self->sym->funcs[ni], &self->sym->funcs[gfi], sizeof(*self->sym->funcs));
        snprintf(self->sym->funcs[ni].cname, MAX_TEXT, "%s", cname);
        snprintf(self->sym->funcs[ni].name, MAX_TEXT, "%s", cname);
        self->sym->funcs[ni].is_static = 1;
        self->sym->funcs[ni].is_pub = 0;
        self->sym->funcs[ni].ntparams = 0;
        self->sym->funcs[ni].tparam[0] = 0;
        snprintf(self->sym->funcs[ni].ret, MAX_TEXT, "%s",
                 frontend::sym::ct_generic_subst(self->sym->funcs[gfi].ret,
                                                 self->sym->funcs[gfi].tparam, targ,
                                                 tmp, sizeof tmp) == 0
                     ? tmp : self->sym->funcs[gfi].ret);
        for (k = 0; k < self->sym->funcs[gfi].nparams; k++)
            if (frontend::sym::ct_generic_subst(self->sym->funcs[gfi].ptype[k],
                                                self->sym->funcs[gfi].tparam, targ,
                                                tmp, sizeof tmp) == 0)
                snprintf(self->sym->funcs[ni].ptype[k], MAX_TEXT, "%s", tmp);
        i = self->sym->nginsts;
        self->sym->ginsts[i].func = gfi;
        self->sym->ginsts[i].row = ni;
        self->sym->ginsts[i].owner = self->cur_unit;
        snprintf(self->sym->ginsts[i].targ, MAX_TEXT, "%s", targ);
        snprintf(self->sym->ginsts[i].cname, MAX_TEXT, "%s", cname);
        self->sym->ginsts[i].line = line;
        self->sym->ginsts[i].col = col;
        self->sym->nginsts++;
        return i;
    }

    /* Capture a parenthesized C11 specifier at the cursor: `_Alignas(…)` (the
       list is required) or `_Atomic(…)` (bare `_Atomic` is the qualifier form
       and is accepted too). Both are appended to the type spelling, so every
       declaration entry -- global, local, field, parameter, typedef -- picks
       them up unchanged. */
    int parse_type(char *out, int cap)
    {
        int n;
        (void)self;

        n = 0;
        out[0] = 0;
        if (self->decl_prefix[0]) {
            int pn = snprintf(out, (size_t)cap, "%s", self->decl_prefix);
            if (pn < 0 || pn >= cap) return self->sup->fail("type is too long");
            n = pn;
            self->decl_prefix[0] = 0;
        }
        self->fnptr_state = 0;
        self->saw_trait = 0;
        self->fnptr_name[0] = 0;
        self->fnptr_dims[0] = 0;
        self->last_bare_tag[0] = 0;
        for (;;) {
            /* C11 `_Alignas(…)` and `_Atomic(…)`: the specifier is copied into
               the type spelling and handed to the C compiler as written (the
               argument may be a type name or a constant expression), so every
               declaration entry -- global, local, field, parameter, typedef --
               picks it up without a node of its own. `_Atomic int` is the
               qualifier spelling and is accepted too. */
            if (self->lex->tok == T_ID
                && (strcmp(self->lex->toktext, "_Alignas") == 0
                    || strcmp(self->lex->toktext, "_Atomic") == 0)) {
                int need_paren, depth;
                const char *word;
                need_paren = (strcmp(self->lex->toktext, "_Alignas") == 0);
                word = need_paren ? "_Alignas" : "_Atomic";
                if (self->type_append(out, cap, &n, word) != 0) return -1;
                self->sup->lex_next();
                if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
                    if (need_paren) return self->sup->fail("expected '(' after _Alignas");
                    continue;                 /* bare `_Atomic` is the qualifier */
                }
                depth = 0;
                for (;;) {
                    char tbuf[MAX_TEXT];
                    if (self->lex->tok == T_EOF) {
                        if (need_paren) return self->sup->fail("unterminated _Alignas");
                        return self->sup->fail("unterminated _Atomic");
                    }
                    /* an integer token keeps its value, not its spelling */
                    if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                        snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                    else
                        snprintf(tbuf, sizeof tbuf, "%s", self->lex->toktext);
                    if (self->type_append(out, cap, &n, tbuf) != 0) return -1;
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) depth++;
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                        depth--;
                        if (depth == 0) {
                            self->sup->lex_next();
                            break;
                        }
                    }
                    self->sup->lex_next();
                }
                continue;
            }
            if (self->lex->tok == T_ID && self->is_type_word(self->lex->toktext)) {
                if (strcmp(self->lex->toktext, "struct") == 0) {
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    /* Phase 29: `struct Stack<int>` is the same type as
                       `Stack<int>`; the instance reader owns the spelling. */
                    if (self->lex->tok == T_ID && frontend::sym::ct_tmpl_find(self->lex->toktext) >= 0) {
                        if (self->parse_inst_type(out, cap) != 0) return -1;
                        n = (int)strlen(out);
                        continue;
                    }
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a struct name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 1) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, self->lex->toktext) != 0) return -1;
                if (strcmp(self->lex->toktext, "enum") == 0) {
                    /* `enum Tag` keeps its keyword the way `struct Tag` does; the
                       tag joins the table under kind 5 (D-2) */
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected an enum name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 5) != 0) return -1;
                } else if (strcmp(self->lex->toktext, "union") == 0) {
                    /* a union tag is mangled like a struct tag and joins the table
                       under kind 6 */
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a union name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 6) != 0) return -1;
                }
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID) {
                int ti;
                char rname[MAX_TEXT];
                char iface[MAX_TEXT];
                /* Phase 26 fix (SH-63): the declaration's type parameter wins
                   over a same-named tag; it is kept as `T` for emission. */
                if (self->in_generic_tparam[0]
                    && strcmp(self->lex->toktext, self->in_generic_tparam) == 0) {
                    if (self->type_append(out, cap, &n, self->in_generic_tparam) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->in_generic_tparam2[0]
                    && strcmp(self->lex->toktext, self->in_generic_tparam2) == 0) {
                    if (self->type_append(out, cap, &n, self->in_generic_tparam2) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                /* Phase 29: `Name<arg[, arg]>` names one monomorphised instance
                   of a generic struct; the reader lives in `parse_inst_type`. */
                if (frontend::sym::ct_tmpl_find(self->lex->toktext) >= 0) {
                    if (self->parse_inst_type(out, cap) != 0) return -1;
                    n = (int)strlen(out);
                    continue;
                }
                /* A visible type alias expands before any name resolution: the
                   alias is a compile-time synonym, so the type spelling (and
                   therefore the host key) is the underlying one. */
                if (self->sym->find_type_alias(self->lex->toktext) >= 0) {
                    char etext[MAX_TEXT];
                    if (self->sym->expand_type_alias(self->lex->toktext, etext, sizeof etext) != 0)
                        return self->sup->fail(self->sym->last_error());
                    if (self->type_append(out, cap, &n, etext) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                /* D21-1: a closure's return type comes from the declaration on
                   the left, so CT never infers one. `auto` is not a type name
                   here: refuse it instead of passing it through to `cc`, where
                   C99 would accept it as a storage class. */
                if (strcmp(self->lex->toktext, "auto") == 0)
                    return self->sup->fail("'auto' is not a type in CT (write the type explicitly)");
                if (self->sup->resolve_type(self->lex->toktext, rname, sizeof rname) != 0) return -1;
                ti = self->sym->find_type(rname);
                if (ti < 0) {
                    /* A declared-but-not-imported alias must not fall through to
                       the opaque C spelling: the name means something in this
                       build, and silently emitting it would fail in `cc`. */
                    {
                        char apath[1024];
                        int aline = 0;
                        if (self->sym->find_global_type_alias(self->lex->toktext, apath,
                                                              sizeof apath, &aline) == 0) {
                            char amsg[1400];
                            snprintf(amsg, sizeof amsg,
                                     "type alias '%s' is declared in %s:%d but this unit does not import it",
                                     self->lex->toktext, apath, aline);
                            return self->sup->fail(amsg);
                        }
                    }
                    /* A type name the unit has never seen (a typedef from a
                       header, such as `time_t`). It can only stand where a type
                       is expected, so the spelling is kept as written; the
                       cast / `sizeof` decision happens before this point, so
                       `(NAME) + x` is never turned into one. */
                    if (n == 0) {
                        if (self->type_append(out, cap, &n, rname) != 0) return -1;
                        self->sup->lex_next();
                        continue;
                    }
                    break;
                }
                /* a bare struct / enum tag needs its keyword; a trait becomes
                   its iface */
                if (self->sym->type_kind[ti] == 1) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "struct %s", rname);
                } else if (self->sym->type_kind[ti] == 5) {
                    if (self->type_append(out, cap, &n, "enum") != 0) return -1;
                    snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "enum %s", rname);
                } else if (self->sym->type_kind[ti] == 6) {
                    if (self->type_append(out, cap, &n, "union") != 0) return -1;
                    snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "union %s", rname);
                } else if (self->sym->type_kind[ti] == 3) {
                    int sti = self->sym->find_trait(rname);
                    self->saw_trait = 1;
                    if (sti >= 0 && self->sym->traits[sti].is_static)
                        return self->sup->fail("a static trait has no interface value");
                    if (sti >= 0 && self->sym->traits[sti].ntparams > 0) {
                        if (self->parse_trait_inst_type(out, cap) != 0) return -1;
                        n = (int)strlen(out);
                        continue;
                    }
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (snprintf(iface, sizeof iface, "%s_iface", rname) >= (int)sizeof iface)
                        return self->sup->fail("type name is too long");
                    if (self->type_append(out, cap, &n, iface) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            if (!self->type_no_ptr && self->lex->tok == T_PUNCT
                && strcmp(self->lex->toktext, "*") == 0) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            break;
        }
        /* `ret (*name)(params)`: the declarator belongs to the type, so it is
           consumed here and the caller takes the name from `fnptr_name`. One
           level only -- a function pointer is not a return type and cannot nest
           (2b.4). A `(` that does not open `(*` is left alone: no other caller
           of `parse_type` can have one there. */
        if (!self->type_no_ptr
            && self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            int save_tok, save_line, save_srcline, save_bol;
            long save_num;
            size_t save_pos;
            char save_text[MAX_TEXT];
            save_tok = self->lex->tok;
            save_num = self->lex->toknum;
            save_line = self->lex->tokline;
            save_pos = self->lex->pos;
            save_srcline = self->lex->line;
            save_bol = self->lex->bol;
            snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                char plist[MAX_TEXT];
                char dname[MAX_TEXT];
                char fdims[MAX_TEXT];
                int pn;
                self->sup->lex_next();
                /* `int (**f)(int)` and `int (*(*f)(void))(int)` put a second
                   declarator where the name belongs: only one level is
                   supported, and the diagnostic says so (D-7). */
                if (self->lex->tok == T_PUNCT
                    && (strcmp(self->lex->toktext, "*") == 0
                        || strcmp(self->lex->toktext, "(") == 0))
                    return self->sup->fail("nested function pointers are not supported");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a name in the function-pointer declarator");
                /* keep the name here: parsing the parameter list below calls
                   `parse_type` again, which clears `fnptr_name` */
                snprintf(dname, sizeof dname, "%s", self->lex->toktext);
                self->sup->lex_next();
                /* dimensions sit inside the declarator, before the `)`: a
                   function-pointer array (`int (*tbl[2])(int)`) (D-5) */
                fdims[0] = 0;
                while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                    char dim[MAX_TEXT];
                    char cur[MAX_TEXT];
                    int unsized;
                    unsized = 0;
                    self->sup->lex_next();
                    if (self->lex->tok == T_NUM) {
                        snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
                    } else if (self->lex->tok == T_ID) {
                        snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
                    } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                        snprintf(dim, sizeof dim, "[]");
                        unsized = 1;
                    } else {
                        return self->sup->fail("expected an array length");
                    }
                    if (!unsized) self->sup->lex_next();
                    if (self->sup->expect("]") != 0) return -1;
                    if (snprintf(cur, sizeof cur, "%s%s", fdims, dim) >= MAX_TEXT)
                        return self->sup->fail("array dimensions are too long");
                    snprintf(fdims, sizeof fdims, "%s", cur);
                }
                if (self->sup->expect(")") != 0) return -1;
                if (self->sup->expect("(") != 0) return -1;
                pn = 0;
                plist[0] = 0;
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                    for (;;) {
                        char pt[MAX_TEXT];
                        const char *joiner;
                        /* A variadic tail belongs to the signature like any
                           other parameter (`int (*log)(const char *, ...)`), so
                           it is copied into the spelling; C requires a named
                           parameter before it, and it closes the list. */
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "...") == 0) {
                            if (pn == 0 || strcmp(plist, "void") == 0)
                                return self->sup->fail("a variadic function pointer needs a named parameter before '...'");
                            if (pn + 6 > MAX_TEXT)
                                return self->sup->fail("a function-pointer signature is too long");
                            snprintf(plist + pn, (size_t)(MAX_TEXT - pn), "%s", ", ...");
                            pn += 5;
                            self->sup->lex_next();
                            break;
                        }
                        if (self->parse_type(pt, sizeof pt) != 0) return -1;
                        if (self->fnptr_state)
                            return self->sup->fail("nested function pointers are not supported");
                        if (self->lex->tok == T_ID) self->sup->lex_next();
                        joiner = (pn > 0) ? ", " : "";
                        if (pn + (int)strlen(joiner) + (int)strlen(pt) + 6 > MAX_TEXT)
                            return self->sup->fail("a function-pointer signature is too long");
                        snprintf(plist + pn, (size_t)(MAX_TEXT - pn), "%s%s", joiner, pt);
                        pn += (int)(strlen(joiner) + strlen(pt));
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                            self->sup->lex_next();
                            continue;
                        }
                        break;
                    }
                }
                if (self->sup->expect(")") != 0) return -1;
                if (pn == 0) snprintf(plist, sizeof plist, "%s", "void");
                {
                    char sig[MAX_TEXT];
                    snprintf(sig, sizeof sig, "(*)(%s)", plist);
                    if (self->type_append(out, cap, &n, sig) != 0) return -1;
                }
                snprintf(self->fnptr_name, MAX_TEXT, "%s", dname);
                snprintf(self->fnptr_dims, MAX_TEXT, "%s", fdims);
                self->fnptr_state = 1;
            } else {
                self->lex->tok = save_tok;
                self->lex->toknum = save_num;
                self->lex->tokline = save_line;
                self->lex->pos = save_pos;
                self->lex->line = save_srcline;
                self->lex->bol = save_bol;
                snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
            }
        }
        if (n == 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "expected a type (tok %d '%s')", self->lex->tok, self->lex->toktext);
            return self->sup->fail(msg);
        }
        return 0;
    }

    /* Phase 29 §2.2: one generic struct instance in a type position. The lexer
       sits on the template name; the arguments are ordinary types, each parsed
       by `parse_type`, and the emitted spelling is the encoded C tag. The
       instance row is registered in this unit's struct table (so field access,
       `sizeof` and the vptr code see an ordinary struct) and, build-wide, in
       `ct_insts` so a later unit reuses the same definition (D29-10). */
    int parse_inst_type(char *out, int cap)
    {
        char tname[MAX_TEXT];
        char enc[MAX_TEXT];
        char carg[2][MAX_TEXT];
        char ctype[2][MAX_TEXT];
        char canon[MAX_TEXT];
        char abuf[MAX_TEXT];
        struct StructTmpl *tp;
        int n, ti2, tn, nargs, nt2, pline, pcol;

        n = (int)strlen(out);
        snprintf(tname, sizeof tname, "%s", self->lex->toktext);
        ti2 = frontend::sym::ct_tmpl_find(tname);
        tp = frontend::sym::ct_tmpls(&tn);
        if (!tp || ti2 < 0) return self->sup->fail("internal: template row vanished");
        nt2 = tp[ti2].ntparams;
        self->sup->lex_next();
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "<") != 0) {
            char msg[MAX_TEXT * 2];
            snprintf(msg, sizeof msg,
                     "generic struct '%s' needs type arguments in a type position", tname);
            return self->sup->fail(msg);
        }
        self->sup->lex_next();
        nargs = 0;
        pline = 0;
        pcol = 1;
        for (;;) {
            if (nargs >= MAX_STRUCT_TPARAMS)
                return self->sup->fail("a generic struct takes at most 2 type parameters");
            if (nargs == 0) {
                pline = self->lex->tokline;
                pcol = self->lex->tokstart - self->lex->lstart + 1;
            }
            self->inst_canon[0] = 0;
            self->type_depth++;
            if (self->type_depth > 4) {
                self->type_depth--;
                return self->sup->fail("generic type arguments nest deeper than 4");
            }
            if (self->parse_type(abuf, sizeof abuf) != 0) {
                self->type_depth--;
                return -1;
            }
            self->type_depth--;
            if (!abuf[0] || strcmp(abuf, "void") == 0 || strchr(abuf, '[')
                || strchr(abuf, '(') || strchr(abuf, ')')
                || strncmp(abuf, "const ", 6) == 0
                || strncmp(abuf, "volatile ", 9) == 0) {
                char msg[MAX_TEXT * 2];
                snprintf(msg, sizeof msg,
                         "type argument '%s' cannot instantiate a generic struct", abuf);
                return self->sup->fail(msg);
            }
            snprintf(ctype[nargs], MAX_TEXT, "%s", abuf);
            if (self->inst_canon[0]) {
                /* S20b: the argument is itself an instance (`Vec<int>` inside
                   `Map<char *, Vec<int>>`). Its identity is the C spelling the
                   nested instance was just given (`struct Vec_int`), so the
                   encoder sees one form here and in the nested `MapEntry`
                   registration -- encoding the source spelling would spell the
                   same type two ways (`Vec_lint_r` vs `Vec__int`). */
                if (snprintf(carg[nargs], MAX_TEXT, "%s", abuf) >= MAX_TEXT)
                    return self->sup->fail("type is too long");
            } else if (frontend::sym::ct_type_canon(abuf, carg[nargs], MAX_TEXT) != 0) {
                return self->sup->fail("type is too long");
            }
            nargs++;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        /* D29-2: `Box<Box<int>>` closes two type argument lists with one
           spelling. The lexer keeps `>>` as a single token; in a type position
           the first `>` closes this list and the cursor steps back one source
           character, so the closing `lex_next` re-reads the second `>` for the
           caller. The lexer itself is untouched. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ">>") == 0) {
            snprintf(self->lex->toktext, MAX_TEXT, "%s", ">");
            self->lex->pos = self->lex->pos - 1;
            self->lex->tokstart = self->lex->tokstart + 1;
        }
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, ">") != 0)
            return self->sup->fail("expected '>' after the type arguments");
        self->sup->lex_next();
        if (nargs != nt2) {
            char msg[MAX_TEXT * 2];
            /* L29-2 (E29-12): over-arity is the same frozen text for a
               built-in container and a user template, so `Vec<int, int>` and
               `Stack<int, int, int>` stay byte-identical. A user template
               with more than two parameters is already cut off by the loop
               above; this branch is the one-parameter container case. */
            if (nargs > nt2)
                return self->sup->fail("a generic struct takes at most 2 type parameters");
            snprintf(msg, sizeof msg,
                     "generic struct '%s' takes %d type arguments, %d given",
                     tname, nt2, nargs);
            return self->sup->fail(msg);
        }
        /* A type parameter used as a type argument stays symbolic: the instance
           is created when the surrounding template is itself instantiated, and
           the emitter resolves the substituted spelling then (D29-3). */
        if (self->in_generic_tparam[0]
            && (strcmp(carg[0], self->in_generic_tparam) == 0
                || (nargs > 1 && strcmp(carg[1], self->in_generic_tparam) == 0)
                || (self->in_generic_tparam2[0]
                    && (strcmp(carg[0], self->in_generic_tparam2) == 0
                        || (nargs > 1 && strcmp(carg[1], self->in_generic_tparam2) == 0))))) {
            char raw[MAX_TEXT];
            if (nargs == 1)
                snprintf(raw, sizeof raw, "%s<%s>", tname, carg[0]);
            else
                snprintf(raw, sizeof raw, "%s<%s,%s>", tname, carg[0], carg[1]);
            snprintf(self->inst_canon, sizeof self->inst_canon, "%s", raw);
            snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "%s", raw);
            if (self->type_append(out, cap, &n, raw) != 0) return -1;
            return 0;
        }
        /* L29-8 (D29-9): the built-in `Map` compares keys by content and has no
           `Hash` / `Eq` bound to widen that, so the key whitelist is enforced
           here, before an instance is registered or any C is emitted. A key
           outside it would otherwise be compared by whatever the generic block
           happens to do, which is how `long` used to reach `strcmp`. */
        if (strcmp(tname, "Map") == 0 && nargs >= 1
            && strcmp(carg[0], "int") != 0 && strcmp(carg[0], "long") != 0
            && strcmp(carg[0], "char*") != 0) {
            char kmsg[MAX_TEXT * 2];
            snprintf(kmsg, sizeof kmsg,
                     "Map does not support key type '%s' (use int, long or char *)",
                     carg[0]);
            return self->sup->fail(kmsg);
        }
        if (frontend::sym::ct_inst_encode(tname, nargs, carg[0], carg[1], enc, MAX_TEXT) != 0)
            return self->sup->fail(
                "the instantiated name exceeds 159 characters; shorten the template or its arguments");
        if (self->inst_make(tname, nargs, carg[0], carg[1], ctype[0], ctype[1],
                            enc, MAX_TEXT, 0, pline, pcol) != 0)
            return -1;
        snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "struct %s", enc);
        if (nargs == 1)
            snprintf(canon, sizeof canon, "%s<%s>", tname, carg[0]);
        else
            snprintf(canon, sizeof canon, "%s<%s,%s>", tname, carg[0], carg[1]);
        snprintf(self->inst_canon, sizeof self->inst_canon, "%s", canon);
        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
        if (self->type_append(out, cap, &n, enc) != 0) return -1;
        return 0;
    }

    /* L29-13: a container copies its elements (`memcpy` on growth, plain
       assignment on `set`), so a struct that carries a vptr has no defensible
       copy story. `use Drop` / `use Handback` add no vptr and never join `use`,
       so they do not trip this. Phase 31 O1 unfreezes the interface-value half:
       a `struct X_iface` is two machine words (a non-owning fat pointer) and is
       stored by value, so only vptr-bearing concrete structs are refused. */
    int container_vptr_type(const char *ctype, int depth)
    {
        char base[MAX_TEXT];
        const char *p;
        int si, fi;

        if (depth > 8) return 0;
        p = ctype;
        while (*p == ' ') p++;
        if (strncmp(p, "struct ", 7) == 0) p += 7;
        snprintf(base, sizeof base, "%s", p);
        if (strchr(base, '*') != 0) return 0;
        si = self->sym->find_struct(base);
        if (si < 0) return 0;
        if (self->sym->structs[si].is_template) return 0;
        if (self->sym->structs[si].nuse > 0) return 1;
        for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
            if (self->container_vptr_type(self->sym->structs[si].fields[fi].type,
                                          depth + 1))
                return 1;
        return 0;
    }

    /* L31-1: `struct X_iface *` cannot be a container element. Strip the
       `struct ` prefix and the trailing `*` handle; a star plus an `_iface`
       base is the shape. `Vec<struct A *>` (a concrete pointer) is untouched. */
    int container_iface_ptr(const char *ctype)
    {
        char base[MAX_TEXT];
        const char *p;
        int n, has_ptr;

        (void)self;
        p = ctype;
        while (*p == ' ') p++;
        if (strncmp(p, "struct ", 7) == 0) p += 7;
        snprintf(base, sizeof base, "%s", p);
        n = strlen(base);
        has_ptr = 0;
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            if (base[n - 1] == '*') has_ptr = 1;
            base[--n] = 0;
        }
        if (!has_ptr) return 0;
        if (n > 6 && strcmp(base + n - 6, "_iface") == 0) return 1;
        return 0;
    }

    /* Phase 31: bind `spell` to the instance's concrete C arguments. The pair
       `StructTmpl.tparam` / `StructInst.ctype` is what `inst_make` used to
       substitute the fields, so the reverse direction here is the same data. */
    int inst_subst_type(const char *ibase, const char *spell, char *out, int cap)
    {
        char base[MAX_TEXT];
        char cur[MAX_TEXT];
        char nxt[MAX_TEXT];
        int inst, ti, tn, k;
        struct StructInst *ins;
        struct StructTmpl *tp;

        (void)self;
        snprintf(cur, sizeof cur, "%s", spell);
        if (strncmp(ibase, "struct ", 7) == 0) {
            snprintf(base, sizeof base, "%s", ibase + 7);
            inst = frontend::sym::ct_inst_find(base);
            if (inst >= 0) {
                ins = frontend::sym::ct_insts(&k);
                ti = frontend::sym::ct_tmpl_find(ins[inst].tmpl);
                tp = frontend::sym::ct_tmpls(&tn);
                if (ti >= 0 && tp) {
                    if (tp[ti].ntparams > 0
                        && frontend::sym::ct_generic_subst(cur, tp[ti].tparam[0],
                                ins[inst].ctype[0], nxt, MAX_TEXT) == 0)
                        snprintf(cur, sizeof cur, "%s", nxt);
                    if (tp[ti].ntparams > 1
                        && frontend::sym::ct_generic_subst(cur, tp[ti].tparam[1],
                                ins[inst].ctype[1], nxt, MAX_TEXT) == 0)
                        snprintf(cur, sizeof cur, "%s", nxt);
                }
            }
        }
        if (snprintf(out, (size_t)cap, "%s", cur) >= cap) return 0;
        return 1;
    }

    /* Phase 31 L31-2 / Phase 33 O3: an interface element belongs to the unit
       that declares its trait; an owning instance element belongs to the unit
       that owns its template. Both are compared with the container template's
       unit, which is the unit that would otherwise write the instance methods.
       A scalar or a non-container struct element is left to the emitter's
       declaring-unit test (`StructDef.owner`). */
    int container_elem_foreign(const char *ctype, int container_tmpl)
    {
        char base[MAX_TEXT];
        char tr[MAX_TEXT];
        int ip, ti, inst, k, ti2, tn, life;
        struct StructInst *ins;
        struct StructTmpl *tps;

        tps = frontend::sym::ct_tmpls(&tn);
        if (!tps || container_tmpl < 0) return 0;
        if (self->sup->iface_ref_type(ctype, tr, sizeof tr, &ip)) {
            ti = self->sym->find_trait(tr);
            if (ti >= 0 && self->sym->traits[ti].path[0]
                && strcmp(self->sym->traits[ti].path, tps[container_tmpl].path) != 0)
                return 1;
            return 0;
        }
        if (strncmp(ctype, "struct ", 7) != 0) return 0;
        snprintf(base, sizeof base, "%s", ctype + 7);
        inst = frontend::sym::ct_inst_find(base);
        if (inst < 0) return 0;
        ins = frontend::sym::ct_insts(&k);
        ti2 = frontend::sym::ct_tmpl_find(ins[inst].tmpl);
        if (ti2 < 0 || tps[ti2].owner < 0) return 0;
        if (tps[ti2].owner == tps[container_tmpl].owner) return 0;
        /* A container element always needs the per-instance helpers; a plain
           instance needs them only when it carries a lifecycle (`retain` and
           `release`). Any other instance is copied by value and unaffected. */
        if (frontend::sym::ct_is_container_type(ctype)) return 1;
        life = self->inst_inherent_method(ctype, "retain") >= 0
            && self->inst_inherent_method(ctype, "release") >= 0;
        return life;
    }

    /* The single creation path for a concrete instance: encode, register the
       identity row, copy the template's fields with both parameters substituted
       and let every matching `use` block adopt its trait. The arity check is
       shared with the type parser, so a built-in container gets no private
       branch (E29-12). */    int inst_make(const char *tname, int nargs, const char *a1, const char *a2,
                  const char *c1, const char *c2, char *enc, int enc_cap, int depth,
                  int line, int col)
    {
        struct StructTmpl *tp;
        int tn, ti2, k, si2, fi2, nt2, carried2;
        char sub1[MAX_TEXT];
        char sub2[MAX_TEXT];

        ti2 = frontend::sym::ct_tmpl_find(tname);
        tp = frontend::sym::ct_tmpls(&tn);
        if (!tp || ti2 < 0) return self->sup->fail("internal: template row vanished");
        nt2 = tp[ti2].ntparams;
        if (nargs != nt2) {
            char msg[MAX_TEXT * 2];
            if (nargs > nt2)
                return self->sup->fail("a generic struct takes at most 2 type parameters");
            snprintf(msg, sizeof msg,
                     "generic struct '%s' takes %d type arguments, %d given",
                     tname, nt2, nargs);
            return self->sup->fail(msg);
        }
        /* L29-13 (Phase 31 O1 partial unfreeze): interface values
           (`struct X_iface`) are stored as a two-word non-owning copy, so only
           vptr-bearing concrete structs are refused here. */
        if ((strcmp(tname, "Vec") == 0 || strcmp(tname, "Map") == 0)
            && (self->container_vptr_type(c1, 0)
                || (nargs > 1 && self->container_vptr_type(c2, 0))))
            return self->sup->fail(
                "interface and vptr-bearing values cannot be stored in a container");
        /* L31-1: an interface pointer has no boxing path into the slot; the
           value form (`Vec<Show>`) is what the user wants. */
        if ((strcmp(tname, "Vec") == 0 || strcmp(tname, "Map") == 0)
            && (self->container_iface_ptr(c1)
                || (nargs > 1 && self->container_iface_ptr(c2))))
            return self->sup->fail(
                "a container of interface pointers is not supported; store the interface value itself");
        if (frontend::sym::ct_inst_encode(tname, nargs, a1, a2, enc, enc_cap) != 0)
            return self->sup->fail(
                "the instantiated name exceeds 159 characters; shorten the template or its arguments");
        /* S20b follow-up: the encoded tag is a C struct name, so it may not
           name a struct the user declared. Without this the two definitions
           collide and only cc notices, after the layouts have been merged. */
        {
            int cx = self->sym->find_struct(enc);
            if (cx >= 0 && !self->sym->structs[cx].is_inst) {
                char cmsg[MAX_TEXT * 2];
                snprintf(cmsg, sizeof cmsg,
                         "the instance name '%s' collides with a declared struct", enc);
                return self->sup->fail(cmsg);
            }
        }
        carried2 = (tp[ti2].is_pub && tp[ti2].owner == self->cur_unit) ? 1 : 0;
        k = frontend::sym::ct_inst_add(enc, tname, nargs, a1, a2, c1, c2,
                                       self->cur_unit, carried2, line, col);
        if (k == -2) {
            char msg[MAX_TEXT * 2];
            snprintf(msg, sizeof msg,
                     "two type arguments encode to the same C name '%s'", enc);
            return self->sup->fail(msg);
        }
        if (k < 0)
            return self->sup->fail(
                "the instantiated name exceeds 159 characters; shorten the template or its arguments");
        si2 = self->sym->add_struct_inst(enc);
        if (si2 < 0) return self->sup->fail(self->sym->last_error());
        if (self->sym->structs[si2].nfields == 0) {
            for (fi2 = 0; fi2 < tp[ti2].nfields; fi2++) {
                snprintf(sub1, sizeof sub1, "%s", tp[ti2].fields[fi2].type);
                if (nt2 > 0
                    && frontend::sym::ct_generic_subst(sub1, tp[ti2].tparam[0], c1,
                                        sub2, MAX_TEXT) != 0)
                    return self->sup->fail("type is too long");
                if (nt2 > 1) {
                    snprintf(sub1, sizeof sub1, "%s", sub2);
                    if (frontend::sym::ct_generic_subst(sub1, tp[ti2].tparam[1], c2,
                                         sub2, MAX_TEXT) != 0)
                        return self->sup->fail("type is too long");
                }
                snprintf(self->sym->structs[si2].fields[fi2].name, MAX_TEXT,
                         "%s", tp[ti2].fields[fi2].name);
                snprintf(self->sym->structs[si2].fields[fi2].type, MAX_TEXT,
                         "%s", sub2);
                snprintf(self->sym->structs[si2].fields[fi2].dims, MAX_TEXT,
                         "%s", tp[ti2].fields[fi2].dims);
                if (self->inst_register_nested(sub2, depth + 1) != 0) return -1;
            }
            self->sym->structs[si2].nfields = tp[ti2].nfields;
            for (fi2 = 0; fi2 < tp[ti2].nuse; fi2++)
                snprintf(self->sym->structs[si2].use[fi2], MAX_TEXT,
                         "%s", tp[ti2].use[fi2]);
            self->sym->structs[si2].nuse = tp[ti2].nuse;
        }
        self->sym->structs[si2].defined = 1;
        self->sym->structs[si2].is_pub = tp[ti2].is_pub;
        self->sym->structs[si2].declared_here = carried2;
        /* a `use` clause on a template impl adopts the trait for every matching
           instance, whichever was written first */
        {
            int ii3, nimpls3;
            struct StructImpl *im3 = frontend::sym::ct_impls(&nimpls3);
            for (ii3 = 0; im3 && ii3 < nimpls3; ii3++)
                if (im3[ii3].use[0] && frontend::sym::ct_impl_matches(ii3, k)) {
                    /* Phase 35 S5a: `use Iter<T>` becomes the instance row this
                       struct's argument names (`Iter_int`). */
                    char cuse[MAX_TEXT];
                    if (self->sym->impl_use_concrete(im3[ii3].use,
                            nargs, a1, a2, c1, c2, self->cur_unit,
                            cuse, sizeof cuse) != 0)
                        return self->sup->fail("type is too long");
                    self->sup->adopt_use(enc, cuse);
                }
        }
        if (self->sup->add_type(enc, 1) != 0) return -1;
        /* H-A (Phase 31): `Map` keeps its entries behind `h->data`, so the
           `MapEntry<K, V>` instance is no longer implied by an `entries`
           field. Both Map impl blocks spell `MapEntry<K, V>` in their method
           signatures, so register the companion row with the same C arguments
           the field used to carry. */
        if (strcmp(tname, "Map") == 0 && nt2 > 1) {
            char esub[MAX_TEXT * 2];
            snprintf(esub, sizeof esub, "struct MapEntry<%s, %s> *", c1, c2);
            if (self->inst_register_nested(esub, depth + 1) != 0) return -1;
        }
        return 0;
    }

    int inst_register_nested(const char *spell, int depth)
    {
        char name[MAX_TEXT];
        char a1[MAX_TEXT];
        char a2[MAX_TEXT];
        char tail[MAX_TEXT];
        char c1[MAX_TEXT];
        char c2[MAX_TEXT];
        char enc[MAX_TEXT];
        int nargs, ti2;

        if (depth > 4) return 0;
        if (frontend::sym::ct_inst_split(spell, name, &nargs, a1, a2, tail,
                                         sizeof tail) != 0)
            return 0;
        if (nargs <= 0 || !a1[0]) return 0;
        /* A parameter of the surrounding template stays symbolic; the emitter
           resolves it once the outer instance binds. */
        if (self->in_generic_tparam[0]
            && (strcmp(a1, self->in_generic_tparam) == 0
                || (nargs > 1 && strcmp(a2, self->in_generic_tparam) == 0)
                || (self->in_generic_tparam2[0]
                    && (strcmp(a1, self->in_generic_tparam2) == 0
                        || (nargs > 1 && strcmp(a2, self->in_generic_tparam2) == 0)))))
            return 0;
        if (self->inst_register_nested(a1, depth + 1) != 0) return -1;
        if (nargs > 1 && self->inst_register_nested(a2, depth + 1) != 0) return -1;
        if (frontend::sym::ct_type_canon(a1, c1, sizeof c1) != 0) return 0;
        if (frontend::sym::ct_type_canon(a2, c2, sizeof c2) != 0) return 0;
        ti2 = frontend::sym::ct_tmpl_find(name);
        if (ti2 < 0) return 0;
        if (frontend::sym::ct_inst_encode(name, nargs, c1, c2, enc, sizeof enc) != 0)
            return 0;
        if (frontend::sym::ct_inst_find(enc) >= 0) return 0;
        return self->inst_make(name, nargs, c1, c2, c1, c2, enc, sizeof enc, depth,
                               0, 0);
    }

    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    int parse_array_dims(int n)
    {
        (void)self;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
            char dim[MAX_TEXT];
            char cur[MAX_TEXT];
            int unsized, open, raw;
            unsized = 0;
            raw = 0;
            open = self->lex->tokstart;             /* the `[` itself */
            dim[0] = 0;
            /* SH-66: a dimension is copied verbatim and is not one of the
               seven positions `ct_generic_subst` rewrites, so a type parameter
               inside it would reach the generated C as an undeclared name.
               §4.48 promises a hard error here instead of a silent product;
               the scan runs at the `[` so the diagnostic points at the
               dimension rather than the token after it. */
            if (self->in_generic_tparam[0]) {
                int p = open + 1;
                int depth = 0;
                int tlen = (int)strlen(self->in_generic_tparam);
                while (self->lex->src[p]) {
                    char ch = self->lex->src[p];
                    int id0 = (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')
                              || ch == '_';
                    if (id0) {
                        int q = p + 1;
                        while (self->lex->src[q]) {
                            char c2 = self->lex->src[q];
                            if (!((c2 >= 'A' && c2 <= 'Z') || (c2 >= 'a' && c2 <= 'z')
                                  || (c2 >= '0' && c2 <= '9') || c2 == '_'))
                                break;
                            q++;
                        }
                        if (q - p == tlen
                            && strncmp(self->lex->src + p, self->in_generic_tparam,
                                       (size_t)tlen) == 0) {
                            char dmsg[MAX_TEXT + 96];
                            snprintf(dmsg, sizeof dmsg,
                                     "type parameter '%s' cannot be used in an array dimension",
                                     self->in_generic_tparam);
                            return self->sup->fail(dmsg);
                        }
                        p = q;
                    } else if (ch == '/' && self->lex->src[p + 1] == '*') {
                        /* a block comment is not code: a dimension may carry
                           one, so skip it before tokenising the text */
                        p += 2;
                        while (self->lex->src[p]
                               && !(self->lex->src[p] == '*'
                                    && self->lex->src[p + 1] == '/'))
                            p++;
                        if (self->lex->src[p]) p += 2;
                    } else if (ch == '[') {
                        depth++;
                        p++;
                    } else if (ch == ']') {
                        if (depth == 0) break;
                        depth--;
                        p++;
                    } else {
                        p++;
                    }
                }
            }
            self->sup->lex_next();
            if (self->lex->tok == T_NUM) {
                snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
            } else if (self->lex->tok == T_ID) {
                /* a constant (an enum member) is emitted under its C name; an
                   undeclared macro name stays as written (D-9) */
                char cn[MAX_TEXT];
                if (self->sym->var_cname(self->lex->toktext, cn, sizeof cn) == 0)
                    snprintf(dim, sizeof dim, "[%s]", cn);
                else
                    snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                /* `T a[][N]`: an unsized parameter dimension (10.6) */
                snprintf(dim, sizeof dim, "[]");
                unsized = 1;
            } else {
                raw = 1;
            }
            if (!unsized && !raw) {
                self->sup->lex_next();
                /* more than one token inside the brackets (`[MAX_NAME * 2]`):
                   the expression is kept as written */
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0)) {
                    raw = 1;
                    dim[0] = 0;
                }
            }
            if (raw) {
                /* copy the source text between the brackets, then let the lexer
                   re-read from just past the closing one */
                int p2, d2, q2;
                p2 = open + 1;
                d2 = 0;
                q2 = 0;
                dim[q2] = '[';
                q2++;
                while (self->lex->src[p2] && q2 + 2 < MAX_TEXT) {
                    char ch = self->lex->src[p2];
                    if (ch == '[') d2++;
                    else if (ch == ']') {
                        if (d2 == 0) break;
                        d2--;
                    }
                    dim[q2] = ch;
                    q2++;
                    p2++;
                }
                if (self->lex->src[p2] != ']') return self->sup->fail("expected an array length");
                dim[q2] = ']';
                q2++;
                dim[q2] = 0;
                self->lex->pos = p2 + 1;
                self->sup->lex_next();
            } else if (self->sup->expect("]") != 0) {
                return -1;
            }
            snprintf(cur, sizeof cur, "%s%s", self->arena->nodes[n].text3, dim);
            snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cur);
            self->arena->nodes[n].num = 0;      /* text3 is the authoritative spelling */
        }
        return 0;
    }

    /* Is the *current* token a type name? The rules are the cast lookahead's
       (below), shared so that a bare type parameter is a type everywhere a
       type name is expected. Nothing is consumed. */
    int tok_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res, save_start, save_lstart;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        save_start = self->lex->tokstart;
        save_lstart = self->lex->lstart;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        res = 0;
        if (self->lex->tok == T_ID) {
            char rn[MAX_TEXT];
            /* `T` inside its own template body is a type, even though the
               ALL_CAPS rule below would read it as a macro constant. */
            if (self->in_generic && self->in_generic_tparam[0]
                && strcmp(self->lex->toktext, self->in_generic_tparam) == 0) {
                res = 1;
            } else
            /* `_Atomic(type)` is a type on its own: the word is a keyword, so
               the balanced list (and optional stars) is all that stands between
               it and the cast's closing parenthesis. */
            if (strcmp(self->lex->toktext, "_Atomic") == 0) {
                int d = 0;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    for (;;) {
                        if (self->lex->tok == T_EOF) break;
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) d++;
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                            d--;
                            if (d == 0) {
                                self->sup->lex_next();
                                break;
                            }
                        }
                        self->sup->lex_next();
                    }
                    while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0)
                        self->sup->lex_next();
                    res = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0);
                }
            } else
            /* resolve first: an imported name is a type even though the table
               only holds its mangled spelling */
            if (self->is_type_word(self->lex->toktext)) {
                res = 1;
            } else if (self->sup->resolve_type(self->lex->toktext, rn, sizeof rn) == 0
                       && self->sym->find_type(rn) >= 0) {
                res = 1;
            } else {
                /* A type name only a header declares (`time_t`), used in a cast
                   or `sizeof`. A declared variable or function is an operand,
                   and an ALL_CAPS name is a macro constant by the same rule
                   `parse_primary` applies, so `(MAX) + 1` keeps reading as an
                   expression. A cast's type also has to close the parenthesis
                   (`(time_t)`, `(time_t *)`); `(f(x))` is a call in parentheses,
                   which is what an undeclared library name looks like. */
                int i, caps;
                caps = (self->lex->toktext[0] != 0);
                for (i = 0; self->lex->toktext[i]; i++) {
                    char cc = self->lex->toktext[i];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        caps = 0;
                        break;
                    }
                }
                if (!caps && self->sym->find_var(self->lex->toktext) < 0
                    && self->sym->find_func(self->lex->toktext) < 0) {
                    self->sup->lex_next();
                    while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0)
                        self->sup->lex_next();
                    res = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0);
                }
            }
        }
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        self->lex->tokstart = save_start;
        self->lex->lstart = save_lstart;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res, save_start, save_lstart;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        save_start = self->lex->tokstart;
        save_lstart = self->lex->lstart;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->sup->lex_next();
        res = self->tok_is_type_name();
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        self->lex->tokstart = save_start;
        self->lex->lstart = save_lstart;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    /* Current token is `offsetof`; does a `(` follow? The builtin has no
       operand form, so a bare name stays an ordinary identifier and the normal
       undeclared-variable path reports it (D-8). */
    int offsetof_ahead(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->sup->lex_next();
        res = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0);
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    /* Is `field` of the struct `stype` a function pointer? A field declared in
       place keeps the `(*)` in its type; a typedef field (`BinOp cb;`) is only
       known through the type table's kind 4 (D-4). */
    int fnptr_field(const char *stype, const char *field)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        int s, fi, ti;
        (void)self;

        snprintf(buf, sizeof buf, "%s", stype);
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            base[n - 1] = 0;
            n--;
        }
        s = self->sym->find_struct(base);
        if (s < 0) return 0;
        for (fi = 0; fi < self->sym->structs[s].nfields; fi++) {
            if (strcmp(self->sym->structs[s].fields[fi].name, field) != 0) continue;
            if (strstr(self->sym->structs[s].fields[fi].type, "(*")) return 1;
            ti = self->sym->find_type(self->sym->structs[s].fields[fi].type);
            return (ti >= 0 && self->sym->type_kind[ti] == 4);
        }
        return 0;
    }

    /* Is this node tree an integer constant expression? ct-ast folds nothing,
       so the judgement is structural: the emitter keeps the source spelling and
       the C compiler does the arithmetic (D-6). A lone name is the caller's
       business -- a `case` label accepts one (a macro or a global), while an
       enum initialiser only accepts a declared constant or a macro. */
    int const_ok(int n)
    {
        int k;
        (void)self;

        if (n < 0) return 0;
        k = self->arena->nodes[n].kind;
        if (k == N_NUM || k == N_RAW || k == N_SIZEOF || k == N_OFFSETOF) return 1;
        if (k == N_STR) {
            /* a character literal keeps its quotes in the pool; a string does
               not form an integer constant */
            return self->arena->str_at((int)self->arena->nodes[n].num)[0] == '\'';
        }
        if (k == N_VAR) return self->sym->is_const_name(self->arena->nodes[n].text2);
        if (k == N_UNARY)
            return (self->arena->nodes[n].aux == U_NEG || self->arena->nodes[n].aux == U_NOT
                    || self->arena->nodes[n].aux == U_BNOT)
                && self->const_ok(self->arena->nodes[n].a);
        if (k == N_BIN)
            return self->const_ok(self->arena->nodes[n].a) && self->const_ok(self->arena->nodes[n].b);
        return 0;
    }

    int parse_expr(void)
    {
        int left, right, inner, n, c;
        int into_allow;
        (void)self;

        /* Phase 30: only the outermost expression of an allowed position may
           carry `into`; every recursive call starts with the flag cleared. */
        into_allow = self->into_ok;
        self->into_ok = 0;

        /* C precedence, loosest first: `||`, `&&`, then the bitwise levels
           (`|` `^` `&`) owned by parse_bitor. The loops live here so the
           trait's method budget stays put. */
        left = self->parse_bitor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
            self->sup->lex_next();
            right = self->parse_bitor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_AND;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "||") == 0) {
            self->sup->lex_next();
            right = self->parse_bitor();
            if (right < 0) return -1;
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
                self->sup->lex_next();
                inner = self->parse_bitor();
                if (inner < 0) return -1;
                n = self->sup->new_node(N_BIN);
                if (n < 0) return -1;
                self->arena->nodes[n].a = right;
                self->arena->nodes[n].b = inner;
                self->arena->nodes[n].aux = B_AND;
                right = n;
            }
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_OR;
            left = n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "?") == 0) {
            int a, b;
            self->sup->lex_next();
            a = self->parse_expr();
            if (a < 0) return -1;
            if (self->sup->expect(":") != 0) return -1;
            b = self->parse_expr();
            if (b < 0) return -1;
            c = self->sup->new_node(N_TERN);
            if (c < 0) return -1;
            self->arena->nodes[c].a = left;
            self->arena->nodes[c].b = a;
            self->arena->nodes[c].c = b;
            return c;
        }
        /* An assignment used as a value: `(c = f())`, `(a = b = 0)`. Only the
           `(` branch below and a statement's condition turn `assign_ok` on, so a
           statement's own assignment (`x = 1;`) still goes through the statement
           layer, which is where AutoDrop keeps its bookkeeping. Parsing the right
           side here again makes the operator right-associative. */
        if (self->assign_ok && self->lex->tok == T_PUNCT
            && (strcmp(self->lex->toktext, "=") == 0
                || strcmp(self->lex->toktext, "+=") == 0 || strcmp(self->lex->toktext, "-=") == 0
                || strcmp(self->lex->toktext, "*=") == 0 || strcmp(self->lex->toktext, "/=") == 0
                || strcmp(self->lex->toktext, "%=") == 0 || strcmp(self->lex->toktext, "&=") == 0
                || strcmp(self->lex->toktext, "|=") == 0 || strcmp(self->lex->toktext, "^=") == 0
                || strcmp(self->lex->toktext, "<<=") == 0 || strcmp(self->lex->toktext, ">>=") == 0)) {
            int op = 0, k2;
            char oc = self->lex->toktext[0];
            int aline = self->lex->tokline;
            int acol = self->lex->tokstart - self->lex->lstart + 1;
            k2 = self->arena->nodes[left].kind;
            /* Phase 31 O3 (L31-3/L31-4): an assignment in a value position
               writes the target just like the statement form. */
            if (self->container_write_check(left) != 0) return -1;
            /* Phase 30 S11: inside an `into` block `$` is a writable lvalue
               (an `own` receiver never reaches here -- L30-4 refuses it). */
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX
                && k2 != N_DEREF && k2 != N_INTO_SELF)
                return self->sup->fail("assignment target is not assignable");
            /* An `own` variable is tracked by statement-level assignments; an
               assignment in a value position would slip past that bookkeeping,
               so it is refused instead of silently leaking. */
            if (k2 == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[left].text2);
                if (vi >= 0 && self->sym->vars[vi].autodrop)
                    return self->sup->fail("an 'own' variable can only be assigned in a statement");
            }
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else if (oc == '%') op = 5;
            else if (oc == '&') op = 6;
            else if (oc == '|') op = 7;
            else if (oc == '^') op = 8;
            else if (oc == '<') op = 9;
            else if (oc == '>') op = 10;
            self->sup->lex_next();
            /* the right side of an assignment is one of the value positions,
               so it may carry an `into` block (Phase 30 S3) */
            self->into_ok = into_allow;
            right = self->parse_expr();
            self->into_ok = 0;
            if (right < 0) return -1;
            /* L29-9: assigning one container binding to another copies it,
               which the container protocol forbids. */
            if (op == 0 && k2 == N_VAR
                && self->arena->nodes[right].kind == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[left].text2);
                int vj = self->sym->find_var(self->arena->nodes[right].text2);
                if (vi >= 0 && vj >= 0 && !self->sym->vars[vj].cview
                    && frontend::sym::ct_is_container_type(self->sym->vars[vi].type)
                    && strcmp(self->sym->vars[vi].type,
                              self->sym->vars[vj].type) == 0)
                    return tool::diag::ct_sem_error(aline, acol,
                        "a container is moved, not copied; use retain() or a function result",
                        self->sup->mem->path);
            }
            n = self->sup->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            return self->into_tail(n, into_allow);
        }
        return self->into_tail(left, into_allow);
    }

    /* Phase 30 S1/S2/S12: `into` is contextual -- it is only a keyword when an
       expression is directly followed by `into {`. The receiver is the whole
       expression parsed so far, so `a + b into { … }` reaches L30-2 instead of
       silently binding to `b`. */
    int into_tail(int left, int allow)
    {
        int n, recv, line, col, kind;
        char type[MAX_TEXT];

        n = left;
        for (;;) {
            if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "into") == 0))
                return n;
            line = self->lex->tokline;
            col = self->lex->tokstart - self->lex->lstart + 1;
            if (!allow) {
                tool::diag::ct_sem_error(line, col,
                    "'into' block is not allowed here", self->sup->mem->path);
                return -1;
            }
            if (self->into_node >= 0) {
                tool::diag::ct_sem_error(line, col,
                    "nested 'into' blocks are not supported", self->sup->mem->path);
                return -1;
            }
            recv = n;
            kind = self->arena->nodes[recv].kind;
            if (!(kind == N_VAR || kind == N_MEMBER || kind == N_ARROW
                  || kind == N_INDEX || kind == N_CALL || kind == N_MCALL
                  || kind == N_DEREF || kind == N_INTO)) {
                tool::diag::ct_sem_error(line, col,
                    "'into' needs a variable, field or call on its left",
                    self->sup->mem->path);
                return -1;
            }
            type[0] = 0;
            /* An indexed receiver's element type is `expr_type`'s answer: for
               an array variable `expr_ctype` keeps the `[]` decay marker,
               which is not a declarable type. Every other form needs the
               addressable spelling `expr_ctype` produces. */
            if (kind == N_INDEX) {
                if (self->sup->expr_type(recv, type, sizeof type) != 0)
                    type[0] = 0;
            } else if (self->sup->expr_ctype(recv, type, sizeof type) != 0) {
                type[0] = 0;
            }
            if (type[0] == 0) {
                tool::diag::ct_sem_error(line, col,
                    "cannot determine the receiver type of this 'into' block",
                    self->sup->mem->path);
                return -1;
            }
            /* L30-4: an interface value has no static member table, and an
               `own` receiver would run the release path on every `$ = …`. */
            {
                char ifc[MAX_TEXT];
                int vi;
                ifc[0] = 0;
                if (self->sup->is_iface_type(type, ifc, sizeof ifc)
                    || (kind == N_VAR
                        && (vi = self->sym->find_var(self->arena->nodes[recv].text2)) >= 0
                        && self->sym->vars[vi].autodrop)) {
                    tool::diag::ct_sem_error(line, col,
                        "'into' cannot take an interface or 'own' receiver",
                        self->sup->mem->path);
                    return -1;
                }
            }
            self->sup->lex_next();
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0)) {
                self->sup->fail("expected '{' after 'into'");
                return -1;
            }
            n = self->into_block(recv, type, line, col);
            if (n < 0) return -1;
            /* a suffix after the block belongs to the whole expression:
               `cfg into { … }.port` reads the promoted receiver's port */
            if (self->lex->tok == T_PUNCT
                && (strcmp(self->lex->toktext, ".") == 0
                    || strcmp(self->lex->toktext, "->") == 0
                    || strcmp(self->lex->toktext, "[") == 0
                    || strcmp(self->lex->toktext, "(") == 0
                    || strcmp(self->lex->toktext, "++") == 0
                    || strcmp(self->lex->toktext, "--") == 0)) {
                self->postfix_seed = n;
                n = self->parse_postfix();
                if (n < 0) return -1;
            }
        }
    }

    /* Build one `into` node and parse its block with `$` / `.name` bound to
       it. The receiver has already been type-checked as `type`. */
    int into_block(int recv, char *type, int line, int col)
    {
        int n, blk, save, selfn, kind, cat, len;

        kind = self->arena->nodes[recv].kind;
        cat = 1;                        /* pointer */
        len = strlen(type);
        while (len > 0 && (type[len - 1] == ' ' || type[len - 1] == '\t')) len--;
        if (!(len > 0 && type[len - 1] == '*')) {
            if (kind == N_INTO)
                /* §2.8: a chained segment re-enters the same object, so it
                   keeps the inner segment's category (an lvalue stays an
                   lvalue; only an rvalue segment stays a copy). */
                cat = self->arena->nodes[recv].aux;
            else if (kind == N_VAR || kind == N_MEMBER || kind == N_ARROW
                || kind == N_INDEX || kind == N_DEREF)
                cat = 2;                /* lvalue value type */
            else
                cat = 3;                /* rvalue value type */
        }
        n = self->sup->new_node(N_INTO);
        if (n < 0) return -1;
        self->arena->nodes[n].a = recv;
        self->arena->nodes[n].aux = cat;
        self->arena->nodes[n].line = line;
        self->arena->nodes[n].num = col;
        snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", type);
        selfn = self->sup->new_node(N_INTO_SELF);
        if (selfn < 0) return -1;
        self->arena->nodes[selfn].num = n;
        snprintf(self->arena->nodes[selfn].text, MAX_TEXT, "%s", type);
        save = self->into_node;
        self->into_node = n;
        blk = self->body_hook();
        self->into_node = save;
        if (blk < 0) return -1;
        self->arena->nodes[n].b = self->arena->nodes[blk].a;
        return n;
    }

    /* L30-5: `.name` on a CT struct receiver must name a field. An opaque C
       host has no member table; a misspelling there surfaces from `cc` on the
       generated line (R7), so only a defined CT struct is checked. */
    int into_member_check(int base, char *fname, int line, int col)
    {
        int owner, si, fi, tlen;
        char st[MAX_TEXT];
        char msg[MAX_TEXT + 96];

        (void)self;
        if (self->arena->nodes[base].kind != N_INTO_SELF
            || self->arena->nodes[base].aux != 1) return 0;
        owner = self->arena->nodes[base].num;
        if (owner < 0) return 0;
        snprintf(st, sizeof st, "%s", self->arena->nodes[owner].text);
        tlen = strlen(st);
        while (tlen > 0 && st[tlen - 1] == '*') {
            st[--tlen] = 0;
            while (tlen > 0 && (st[tlen - 1] == ' ' || st[tlen - 1] == '\t'))
                st[--tlen] = 0;
        }
        if (strncmp(st, "struct ", 7) == 0) {
            int k;
            for (k = 0; st[k + 7] != 0; k++) st[k] = st[k + 7];
            st[k] = 0;
        }
        si = self->sym->find_struct(st);
        if (si < 0 || !self->sym->structs[si].defined) return 0;
        for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
            if (strcmp(self->sym->structs[si].fields[fi].name, fname) == 0)
                return 0;
        snprintf(msg, sizeof msg, "no member '%s' on the 'into' receiver", fname);
        tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        return -1;
    }

    /* `|`, `^`, `&` are three separate levels in C, and `<<` / `>>` bind
       tighter than the comparisons but looser than `+` / `-`. */
    int parse_bitor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bxor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "|") == 0) {
            self->sup->lex_next();
            right = self->parse_bxor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BOR;
            left = n;
        }
        return left;
    }

    int parse_bxor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bitand();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "^") == 0) {
            self->sup->lex_next();
            right = self->parse_bitand();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_XOR;
            left = n;
        }
        return left;
    }

    int parse_bitand(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_cmp();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            self->sup->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BAND;
            left = n;
        }
        return left;
    }

    int parse_shift(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT
               && (strcmp(self->lex->toktext, "<<") == 0 || strcmp(self->lex->toktext, ">>") == 0)) {
            op = (self->lex->toktext[0] == '<') ? B_SHL : B_SHR;
            self->sup->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_shift();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT) {
            op = 0;
            if (strcmp(self->lex->toktext, "<") == 0) op = B_LT;
            else if (strcmp(self->lex->toktext, ">") == 0) op = B_GT;
            else if (strcmp(self->lex->toktext, "<=") == 0) op = B_LE;
            else if (strcmp(self->lex->toktext, ">=") == 0) op = B_GE;
            else if (strcmp(self->lex->toktext, "==") == 0) op = B_EQ;
            else if (strcmp(self->lex->toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->sup->lex_next();
            right = self->parse_shift();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+") == 0 || strcmp(self->lex->toktext, "-") == 0)) {
            op = (self->lex->toktext[0] == '+') ? B_ADD : B_SUB;
            self->sup->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "*") == 0
               || strcmp(self->lex->toktext, "/") == 0 || strcmp(self->lex->toktext, "%") == 0)) {
            op = B_MUL;
            if (self->lex->toktext[0] == '/') op = B_DIV;
            else if (self->lex->toktext[0] == '%') op = B_MOD;
            self->sup->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        if (self->lex->tok == T_ID && (strcmp(self->lex->toktext, "sizeof") == 0
                                       || strcmp(self->lex->toktext, "_Alignof") == 0
                                       || strcmp(self->lex->toktext, "alignof") == 0)) {
            char tbuf[MAX_TEXT];
            int kind, rc;
            /* 1 = sizeof, 2 = C11 `_Alignof`, 4 = `alignof` (stdalign.h) */
            kind = strcmp(self->lex->toktext, "sizeof") == 0 ? 1
                   : strcmp(self->lex->toktext, "_Alignof") == 0 ? 2 : 4;
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
                && self->next_is_type_name()) {
                self->sup->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->sup->expect(")") != 0) return -1;
                n = self->sup->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[n].aux = kind;
                return n;
            }
            /* A type operand does not need parentheses in CT (`sizeof T`). The
               active type parameter is a type name inside its template body, so
               this branch is what keeps `sizeof T` out of the expression path.
               `type_no_ptr` stops the type at the name: a following `*` belongs
               to the surrounding multiplication. */
            if (self->tok_is_type_name()) {
                self->type_no_ptr = 1;
                rc = self->parse_type(tbuf, sizeof tbuf);
                self->type_no_ptr = 0;
                if (rc != 0) return -1;
                n = self->sup->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[n].aux = kind;
                return n;
            }
            /* C11 spells the alignment query with a type name only; a bare
               `alignof` expression keeps its macro spelling. */
            if (kind == 2) return self->sup->fail("_Alignof needs a type in parentheses");
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_SIZEOF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = kind == 4 ? 3 : 0;
            return n;
        }
        /* `(params) => expr` opens a closure literal. The check runs before
           the cast branch: a typed parameter list starts with a type word, so
           `next_is_type_name` would otherwise read `(int x)` as a cast. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && closure_ahead(self))
            return self->parse_closure();
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->sup->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            /* `(type){ … }` is a compound literal: the braces are captured like
               a declaration initialiser, and the emitter adds the vptr items a
               trait-carrying struct needs. A postfix suffix still applies, so
               the node rides through `postfix_seed` instead of returning here. */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                /* a compound literal's braces go to the arena string pool for the
                   same reason a declaration initialiser does (`aux = 1`,
                   `num` = offset) */
                char raw[MAX_RAW_INIT];
                int rn, cn, off, k;
                size_t tl = strlen(tbuf);
                if (tl > 0 && tbuf[tl - 1] == '*')
                    return self->sup->fail("a compound literal needs an object type");
                if (self->container_init_check(tbuf) != 0) return -1;
                rn = self->sup->new_node(N_RAW);
                if (rn < 0) return -1;
                if (self->sup->init_raw(raw, sizeof raw) != 0) return -1;
                off = self->arena->str_begin();
                for (k = 0; raw[k]; k++)
                    if (self->arena->str_put(raw[k]) != 0)
                        return self->sup->fail("initializer is too long");
                self->arena->str_end();
                self->arena->nodes[rn].num = off;
                self->arena->nodes[rn].aux = 1;
                cn = self->sup->new_node(N_COMPOUND);
                if (cn < 0) return -1;
                snprintf(self->arena->nodes[cn].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[cn].a = rn;
                self->postfix_seed = cn;
                return self->parse_postfix();
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_CAST);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            self->arena->nodes[n].a = e;
            return n;
        }
        op = 0;
        /* prefix `++` / `--`: the same increment as the postfix form, but the
           value is the updated one (D-9 of this batch). It binds like the other
           unary operators, so `s[--n]` and `*--p` work as in C. */
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0
                                          || strcmp(self->lex->toktext, "--") == 0)) {
            int pre = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            if (is_range_index(self->arena, e))
                return self->sup->fail("the range index '$' is not a variable");
            /* Phase 31 O3 (L31-3/L31-4): `++v[i]` / `--v[i]` write the value. */
            if (self->container_write_check(e) != 0) return -1;
            n = self->sup->new_node(N_PRE);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = pre;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "-") == 0) op = U_NEG;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "!") == 0) op = U_NOT;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "~") == 0) op = U_BNOT;
        if (op != 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_UNARY);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = op;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            int save;
            self->sup->lex_next();
            save = self->fnval_ok;
            self->fnval_ok = 1;      /* `&handler` may name a C library function */
            e = self->parse_unary();
            self->fnval_ok = save;
            if (e < 0) return -1;
            if (is_range_index(self->arena, e))
                return self->sup->fail("the range index '$' is not a variable");
            /* Phase 31 O3 (L31-5): `&v[i]` has no object to name. */
            if (self->container_addr_check(e) != 0) return -1;
            n = self->sup->new_node(N_ADDR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_DEREF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    /* Phase 29: the method node `impl<T> Name<Args>` declares for the receiver
       type `ibase` (a `struct <instance>` spelling), or -1. Only inherent
       blocks answer here: a `use` block is a trait impl and keeps the vtable
       path, which `method_trait` resolves through the instance's use list. */
    int inst_inherent_method(const char *ibase, const char *fname)
    {
        int ii, nimpls, inst, m, ni;
        char base[MAX_TEXT];
        struct StructImpl *im;

        if (strncmp(ibase, "struct ", 7) != 0) return -1;
        snprintf(base, sizeof base, "%s", ibase + 7);
        inst = frontend::sym::ct_inst_find(base);
        if (inst >= 0) {
            im = frontend::sym::ct_impls(&nimpls);
            for (ii = 0; im && ii < nimpls; ii++) {
                if (im[ii].use[0]) continue;
                if (!frontend::sym::ct_impl_matches(ii, inst)) continue;
                for (m = self->arena->nodes[im[ii].node].a; m >= 0;
                     m = self->arena->nodes[m].next)
                    if (strcmp(self->arena->nodes[m].text2, fname) == 0) return m;
            }
        }
        /* P34 S5a: a non-generic inherent impl `impl Name { … }` (S4) is an
           N_IMPL node whose trait name is empty and whose receiver type is
           `ibase`. A non-generic struct has no `ct_inst` row, so the lookup
           falls back to scanning the arena for that block. */
        for (ni = 0; ni < self->arena->nnode; ni++) {
            if (self->arena->nodes[ni].kind != N_IMPL) continue;
            if (self->arena->nodes[ni].text2[0]) continue;
            if (self->arena->nodes[ni].aux < 0) continue;
            if (strcmp(self->arena->nodes[ni].text, ibase) != 0) continue;
            for (m = self->arena->nodes[ni].a; m >= 0;
                 m = self->arena->nodes[m].next)
                if (strcmp(self->arena->nodes[m].text2, fname) == 0) return m;
        }
        return -1;
    }

    /* Phase 29 P29-2: the static (receiverless) method `ibase::fname`, or -1.
       Same walk as `inst_inherent_method`, but only a method the impl block
       marked `static` answers: `Vec<int>::from(items, n)` must never resolve to
       an instance method, and an instance call must never resolve to `from`. */
    int inst_static_method(const char *ibase, const char *fname)
    {
        int ii, nimpls, inst, m, ni;
        char base[MAX_TEXT];
        struct StructImpl *im;

        if (strncmp(ibase, "struct ", 7) != 0) return -1;
        snprintf(base, sizeof base, "%s", ibase + 7);
        inst = frontend::sym::ct_inst_find(base);
        if (inst >= 0) {
            im = frontend::sym::ct_impls(&nimpls);
            for (ii = 0; im && ii < nimpls; ii++) {
                if (im[ii].use[0]) continue;
                if (!frontend::sym::ct_impl_matches(ii, inst)) continue;
                for (m = self->arena->nodes[im[ii].node].a; m >= 0;
                     m = self->arena->nodes[m].next)
                    if (self->arena->nodes[m].c
                        && strcmp(self->arena->nodes[m].text2, fname) == 0) return m;
            }
        }
        /* P34 S5a: non-generic inherent static method (S4 `static` marker in
           `c`). Same arena scan as `inst_inherent_method`, but a `static`
           method answers only here and never to an instance call. */
        for (ni = 0; ni < self->arena->nnode; ni++) {
            if (self->arena->nodes[ni].kind != N_IMPL) continue;
            if (self->arena->nodes[ni].text2[0]) continue;
            if (self->arena->nodes[ni].aux < 0) continue;
            if (strcmp(self->arena->nodes[ni].text, ibase) != 0) continue;
            for (m = self->arena->nodes[ni].a; m >= 0;
                 m = self->arena->nodes[m].next)
                if (self->arena->nodes[m].c
                    && strcmp(self->arena->nodes[m].text2, fname) == 0) return m;
        }
        return -1;
    }

    /* V29-4: resolve a C typedef by name to the spelling it was declared with.
       An opaque alias (a header type this unit never declares) keeps its name,
       so the caller can still decide it is not a container. */
    int ctype_expand(const char *in, char *out, int cap, int depth)
    {
        char name[MAX_TEXT];
        char target[MAX_TEXT];
        int i, len, bare;

        if (depth > 8) return 0;
        len = (int)strlen(in);
        while (len > 0 && in[len - 1] == ' ') len--;
        i = 0;
        while (i < len && in[i] == ' ') i++;
        if (i >= len || len - i >= (int)sizeof name) return 0;
        snprintf(name, sizeof name, "%.*s", len - i, in + i);
        bare = 1;
        for (i = 0; name[i]; i++) {
            int c = (unsigned char)name[i];
            if (i == 0) {
                if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_')) {
                    bare = 0;
                    break;
                }
            } else if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
                         || (c >= '0' && c <= '9') || c == '_')) {
                bare = 0;
                break;
            }
        }
        if (bare && self->sym->type_target_of(name, target, sizeof target))
            return self->ctype_expand(target, out, cap, depth + 1);
        if (snprintf(out, cap, "%s", name) >= cap) return 0;
        return 1;
    }

    /* V29-4: the return type of the abstract function-pointer declarator this
       compiler stores (`RET (*)(params)` -- the same `(*)` the emitter splices
       a name into). Anything else resolves to 0. */
    int fnptr_ret(const char *ftype, char *out, int cap)
    {
        const char *p, *q;
        int len, depth;

        (void)self;
        p = strstr(ftype, "(*)");
        if (!p || p == ftype) return 0;
        q = p + 3;
        while (*q == ' ') q++;
        if (*q != '(') return 0;
        depth = 0;
        for (; *q; q++) {
            if (*q == '(') depth++;
            else if (*q == ')') {
                depth--;
                if (depth == 0) break;
            }
        }
        if (depth != 0) return 0;
        len = (int)(p - ftype);
        while (len > 0 && ftype[len - 1] == ' ') len--;
        if (len <= 0) return 0;
        if (snprintf(out, cap, "%.*s", len, ftype) >= cap) return 0;
        return 1;
    }

    /* V29-4: strip exactly one pointer layer. A function-pointer spelling keeps
       its star inside `(*)`, so it is not peeled here. */
    int peel_ptr(const char *ty, char *out, int cap)
    {
        int len;

        (void)self;
        len = (int)strlen(ty);
        while (len > 0 && ty[len - 1] == ' ') len--;
        if (len <= 0 || ty[len - 1] != '*') return 0;
        len--;
        while (len > 0 && ty[len - 1] == ' ') len--;
        if (len <= 0) return 0;
        if (snprintf(out, cap, "%.*s", len, ty) >= cap) return 0;
        return 1;
    }

    /* V29-4: the static C type of an expression. `array_depth` counts the dims
       still attached to the value (0 for a scalar / pointer). One `[` peels one
       dimension or one `*`; one `*` peels one `*`. A shape the tables cannot
       pin returns 0 and is not judged. */
    int static_ctype(int n, char *out, int cap, int *array_depth, int depth)
    {
        char tmp[MAX_TEXT];
        char tmp2[MAX_TEXT];
        const char *ty;
        int i, si, ad;

        *array_depth = 0;
        if (n < 0 || depth > 8) return 0;
        switch (self->arena->nodes[n].kind) {
        case N_VAR:
            i = self->sym->find_var(self->arena->nodes[n].text2);
            if (i < 0) return 0;
            if (!self->ctype_expand(self->sym->vars[i].type, out, cap, 0)) return 0;
            if (self->sym->vars[i].is_array) {
                for (ty = self->sym->vars[i].dims; *ty; ty++)
                    if (*ty == '[') (*array_depth)++;
            }
            return 1;
        case N_INDEX:
            if (!self->static_ctype(self->arena->nodes[n].a, tmp, sizeof tmp, &ad, depth + 1))
                return 0;
            if (ad > 0) {
                /* one array dimension: the spelling is already the element */
                if (snprintf(out, cap, "%s", tmp) >= cap) return 0;
                *array_depth = ad - 1;
                return 1;
            }
            return self->peel_ptr(tmp, out, cap);
        case N_DEREF:
            if (!self->static_ctype(self->arena->nodes[n].a, tmp, sizeof tmp, &ad, depth + 1))
                return 0;
            if (ad > 0) {
                if (snprintf(out, cap, "%s", tmp) >= cap) return 0;
                *array_depth = ad - 1;
                return 1;
            }
            return self->peel_ptr(tmp, out, cap);
        case N_ADDR:
            if (!self->static_ctype(self->arena->nodes[n].a, tmp, sizeof tmp, &ad, depth + 1))
                return 0;
            if (ad != 0) return 0;
            if (!tmp[0] || snprintf(out, cap, "%s%s*", tmp,
                                    tmp[strlen(tmp) - 1] == '*' ? "" : " ") >= cap)
                return 0;
            return 1;
        case N_MEMBER:
        case N_ARROW:
            if (!self->static_ctype(self->arena->nodes[n].a, tmp, sizeof tmp, &ad, depth + 1))
                return 0;
            if (ad != 0) return 0;
            if (self->arena->nodes[n].kind == N_ARROW) {
                /* `->` walks through exactly one pointer */
                if (!self->peel_ptr(tmp, tmp2, sizeof tmp2)) return 0;
                snprintf(tmp, sizeof tmp, "%s", tmp2);
            }
            ty = tmp;
            if (strncmp(ty, "struct ", 7) == 0) ty += 7;
            si = self->sym->find_struct(ty);
            if (si < 0) return 0;
            for (i = 0; i < self->sym->structs[si].nfields; i++) {
                if (strcmp(self->sym->structs[si].fields[i].name,
                           self->arena->nodes[n].text2) != 0) continue;
                if (!self->ctype_expand(self->sym->structs[si].fields[i].type,
                                        out, cap, 0)) return 0;
                for (ty = self->sym->structs[si].fields[i].dims; *ty; ty++)
                    if (*ty == '[') (*array_depth)++;
                return 1;
            }
            return 0;
        case N_CALL:
            if (self->arena->nodes[n].aux == 2) {
                /* `(*fp)()` / `o.f()`: the callee is an expression whose
                   declared type is the function pointer. */
                int ci = self->arena->nodes[n].b;
                if (ci >= 0 && self->arena->nodes[ci].kind == N_DEREF) {
                    int ad2;
                    if (!self->static_ctype(self->arena->nodes[ci].a, tmp, sizeof tmp,
                                            &ad2, depth + 1))
                        return 0;
                    if (ad2 != 0) return 0;
                    if (self->fnptr_ret(tmp, out, cap)) return 1;
                    if (!self->peel_ptr(tmp, tmp2, sizeof tmp2)) return 0;
                    return self->fnptr_ret(tmp2, out, cap);
                }
                if (!self->static_ctype(ci, tmp, sizeof tmp, &ad, depth + 1)) return 0;
                if (ad != 0) return 0;
                return self->fnptr_ret(tmp, out, cap);
            }
            i = self->sym->resolve_func(self->arena->nodes[n].text2);
            if (i >= 0) {
                if (!self->sym->funcs[i].ret[0] || strcmp(self->sym->funcs[i].ret, "void") == 0)
                    return 0;
                return self->ctype_expand(self->sym->funcs[i].ret, out, cap, 0);
            }
            /* `fp()` on a function-pointer variable (a plain name). */
            i = self->sym->find_var(self->arena->nodes[n].text2);
            if (i < 0) return 0;
            if (!self->ctype_expand(self->sym->vars[i].type, tmp, sizeof tmp, 0)) return 0;
            return self->fnptr_ret(tmp, out, cap);
        case N_MCALL:
            /* An inherent method of an instantiated struct keeps its AST node
               (`text` is the declared return type); a trait method reads the
               signature. */
            if (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
                i = self->inst_inherent_method(self->arena->nodes[n].text,
                                               self->arena->nodes[n].text2);
            else
                i = -1;
            if (i >= 0) {
                char ib[MAX_TEXT];
                char rs[MAX_TEXT];
                if (!self->arena->nodes[i].text[0]) return 0;
                /* Phase 31 O3: the declared return type mentions the
                   template's parameter (`T get(int i)`), so a chained subscript
                   (`g[i][j]`) only sees `struct Vec_int` when the parameter is
                   replaced by this instance's concrete argument. */
                snprintf(ib, sizeof ib, "%s", self->arena->nodes[n].text);
                if (ib[0] && strncmp(ib, "struct ", 7) != 0) {
                    snprintf(tmp2, sizeof tmp2, "struct %s", ib);
                    snprintf(ib, sizeof ib, "%s", tmp2);
                }
                if (self->inst_subst_type(ib, self->arena->nodes[i].text,
                                          rs, sizeof rs)) {
                    if (snprintf(out, (size_t)cap, "%s", rs) >= cap) return 0;
                    return 1;
                }
                return self->ctype_expand(self->arena->nodes[i].text, out, cap, 0);
            }
            si = self->sym->find_trait(self->arena->nodes[n].text);
            if (si < 0) return 0;
            for (i = 0; i < self->sym->traits[si].nm; i++) {
                if (strcmp(self->sym->traits[si].m[i].name,
                           self->arena->nodes[n].text2) != 0) continue;
                if (!self->sym->traits[si].m[i].ret[0]
                    || strcmp(self->sym->traits[si].m[i].ret, "void") == 0) return 0;
                return self->ctype_expand(self->sym->traits[si].m[i].ret, out, cap, 0);
            }
            return 0;
        default:
            return 0;
        }
    }

    /* V29-4: `v[i]` / `m[k]` on a container handle. An array (any remaining
       dims) and a pointer keep the C meaning, so only a resolved container
       value is refused. A base this pass cannot pin is not judged. */
    int container_index_check(int base)
    {
        char ty[MAX_TEXT];
        int ad;

        if (!self->static_ctype(base, ty, sizeof ty, &ad, 0)) return 0;
        if (ad > 0) return 0;
        if (strchr(ty, '*') != 0) return 0;
        if (strncmp(ty, "struct Vec_", 11) == 0)
            return self->sup->fail("a Vec is not subscriptable: use get(i) / set(i, v)");
        if (strncmp(ty, "struct Map_", 11) == 0)
            return self->sup->fail("a Map is not subscriptable: use get(key)");
        return 0;
    }

    /* V29-4: a brace initializer for a container. `MapEntry` is an ordinary
       struct and keeps its aggregate form. */
    int container_init_check(const char *ctype)
    {
        if (strncmp(ctype, "struct Vec_", 11) == 0 || strncmp(ctype, "Vec_", 4) == 0)
            return self->sup->fail(
                "a Vec cannot be initialized from a brace list: use a range initializer or Vec<T>::from");
        if (strncmp(ctype, "struct Map_", 11) == 0 || strncmp(ctype, "Map_", 4) == 0)
            return self->sup->fail(
                "a Map cannot be initialized from a brace list: use put(key, value)");
        return 0;
    }

    /* Phase 31 S11b: a file-scope brace initializer. C static initialization
       cannot call the constructor, so a `Vec` is refused with its own text
       (L31-10) before the generic container refusal; a `Map` keeps that
       refusal until its literal path lands. */
    int container_global_init_check(const char *ctype)
    {
        if (strncmp(ctype, "struct Vec_", 11) == 0 || strncmp(ctype, "Vec_", 4) == 0)
            return self->sup->fail(
                "a Vec brace initializer is only supported in a local declaration");
        if (strncmp(ctype, "struct Map_", 11) == 0 || strncmp(ctype, "Map_", 4) == 0)
            return self->sup->fail(
                "a Map brace initializer is only supported in a local declaration");
        return 0;
    }

    /* Phase 31 O3 (L31-3/L31-4): the read-only rule for a write form. The
       target is walked down its member / arrow chain, so `v[i].field = x` blames
       the subscript; the walk stops at a deref, because `*m[k] = x` writes the
       stored object and stays legal. 0 when the chain holds no subscript. */
    int container_subscript_kind(int n)
    {
        while (n >= 0) {
            int k = self->arena->nodes[n].kind;
            if (k == N_MCALL
                && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
                && strcmp(self->arena->nodes[n].text2, "get") == 0) {
                if (strncmp(self->arena->nodes[n].text, "struct Vec_", 11) == 0
                    || strncmp(self->arena->nodes[n].text, "Vec_", 4) == 0)
                    return 1;
                if (strncmp(self->arena->nodes[n].text, "struct Map_", 11) == 0
                    || strncmp(self->arena->nodes[n].text, "Map_", 4) == 0)
                    return 2;
                return 0;
            }
            if (k != N_MEMBER && k != N_ARROW) return 0;
            n = self->arena->nodes[n].a;
        }
        return 0;
    }

    /* L31-3 / L31-4 at the subscript's own position. */
    int container_write_check(int n)
    {
        int k = self->container_subscript_kind(n);
        int at = n;
        if (k == 0) return 0;
        while (at >= 0 && (self->arena->nodes[at].kind == N_MEMBER
                           || self->arena->nodes[at].kind == N_ARROW))
            at = self->arena->nodes[at].a;
        if (k == 1)
            return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                            self->arena->nodes[at].num,
                                            "a Vec subscript is read-only; use set(i, v)",
                                            self->sup->mem->path);
        return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                        self->arena->nodes[at].num,
                                        "a Map subscript is read-only; use put(k, v)",
                                        self->sup->mem->path);
    }

    /* Phase 31 O3 (L31-5): a subscript names a value, so it has no address. */
    int container_addr_check(int n)
    {
        int at = n;
        if (self->container_subscript_kind(n) == 0) return 0;
        while (at >= 0 && (self->arena->nodes[at].kind == N_MEMBER
                           || self->arena->nodes[at].kind == N_ARROW))
            at = self->arena->nodes[at].a;
        return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                        self->arena->nodes[at].num,
                                        "cannot take the address of a container subscript; bind it to a local first",
                                        self->sup->mem->path);
    }

    /* Phase 31 S16b: the 19.2 coarse comparison for a Map literal key or value.
       It reuses the same class kernel `push` / `put` arguments use, so a numeric
       literal stays compatible with any integer slot and a struct compares by
       its declared row (not by spelling). */
    int brace_arg_ok(const char *formal, const char *actual)
    {
        char fb[MAX_TEXT];
        char ab[MAX_TEXT];
        int r, fs, as;

        r = arg_class(formal, actual, fb, sizeof fb, ab, sizeof ab);
        if (r != 2) return r;
        if (strncmp(fb, "struct", 6) != 0 || strncmp(ab, "struct", 6) != 0) return 2;
        fs = self->sym->find_struct(fb + 6);
        as = self->sym->find_struct(ab + 6);
        if (fs < 0 || as < 0) return -1;
        return fs == as ? 0 : 1;
    }

    /* P29-2 lookahead: the cursor is on a template name. 1 only when
       `<type-args>:: <name> (` follows, so `Vec < 3` keeps its comparison
       shape. The lexer has no peek, hence the save/restore. */
    int static_call_ahead(void)
    {
        int sp, sbol, stok, sline, stokline, sstart, slstart, sfloat, strunc;
        int depth, r;
        long snum;
        char stext[MAX_TEXT];
        char ssuf[8];

        sp = self->lex->pos;
        sbol = self->lex->bol;
        stok = self->lex->tok;
        snum = self->lex->toknum;
        sline = self->lex->line;
        stokline = self->lex->tokline;
        sstart = self->lex->tokstart;
        slstart = self->lex->lstart;
        sfloat = self->lex->tokfloat;
        strunc = self->lex->toktrunc;
        snprintf(stext, sizeof stext, "%s", self->lex->toktext);
        snprintf(ssuf, sizeof ssuf, "%s", self->lex->toksuffix);
        depth = 0;
        r = 0;
        self->sup->lex_next();          /* the template name */
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "<") == 0)) {
            self->lex->pos = sp;
            self->lex->bol = sbol;
            self->lex->tok = stok;
            self->lex->toknum = snum;
            self->lex->line = sline;
            self->lex->tokline = stokline;
            self->lex->tokstart = sstart;
            self->lex->lstart = slstart;
            self->lex->tokfloat = sfloat;
            self->lex->toktrunc = strunc;
            snprintf(self->lex->toktext, MAX_TEXT, "%s", stext);
            snprintf(self->lex->toksuffix, sizeof self->lex->toksuffix, "%s", ssuf);
            return 0;
        }
        self->sup->lex_next();          /* the `<` */
        depth = 1;
        while (self->lex->tok != T_EOF) {
            const char *t = self->lex->toktext;
            if (self->lex->tok == T_PUNCT) {
                if (t[0] == '<' && t[1] == 0) {
                    depth++;
                } else if (t[0] == '>' && t[1] == 0 && depth > 0) {
                    depth--;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                } else if (strcmp(t, ">>") == 0 && depth > 1) {
                    depth -= 2;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                } else if (strcmp(t, ";") == 0 || strcmp(t, "{") == 0
                           || strcmp(t, "}") == 0 || strcmp(t, "(") == 0
                           || strcmp(t, ")") == 0 || strcmp(t, "=") == 0) {
                    break;
                }
            }
            self->sup->lex_next();
        }
        if (depth == 0 && self->lex->tok == T_PUNCT
            && strcmp(self->lex->toktext, "::") == 0) {
            self->sup->lex_next();
            if (self->lex->tok == T_ID) {
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT
                    && strcmp(self->lex->toktext, "(") == 0) r = 1;
            }
        }
        self->lex->pos = sp;
        self->lex->bol = sbol;
        self->lex->tok = stok;
        self->lex->toknum = snum;
        self->lex->line = sline;
        self->lex->tokline = stokline;
        self->lex->tokstart = sstart;
        self->lex->lstart = slstart;
        self->lex->tokfloat = sfloat;
        self->lex->toktrunc = strunc;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", stext);
        snprintf(self->lex->toksuffix, sizeof self->lex->toksuffix, "%s", ssuf);
        return r;
    }

    int parse_postfix(void)
    {
        int n, m, idx, args, mline, mcol;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->postfix_seed;
        self->postfix_seed = -1;
        if (n < 0) {
            n = self->parse_primary();
            if (n < 0) return -1;
        }
        for (;;) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                /* Phase 31 O3: `v[i]` is `v.get(i)` and `m[k]` is `m.get(k)`.
                   The base's static type names the container instance, so the
                   node is built exactly as an inherent method call would be
                   (aux 9: value receiver, emitted with `&`). A base this pass
                   cannot pin keeps C's subscript meaning. */
                char bty[MAX_TEXT];
                int bd = 0;
                int known = self->static_ctype(n, bty, sizeof bty, &bd, 0);
                int sugar = 0;
                if (known && bd == 0 && strchr(bty, '*') == 0) {
                    if (strncmp(bty, "struct Vec_", 11) == 0
                        || strncmp(bty, "struct Map_", 11) == 0)
                        sugar = 1;
                }
                if (sugar) {
                    int rt, rd2;
                    int bl = self->lex->tokline;
                    int bc = self->lex->tokstart - self->lex->lstart + 1;
                    char rty[MAX_TEXT];
                    self->sup->lex_next();
                    idx = self->parse_expr();
                    if (idx < 0) return -1;
                    if (self->sup->expect("]") != 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].aux = 9;
                    /* L31-3/4: a write form points at the subscript itself */
                    self->arena->nodes[m].line = bl;
                    self->arena->nodes[m].num = bc;
                    snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", bty);
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "get");
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = idx;
                    /* A call receiver is an rvalue: the emitter names it in a
                       temporary before taking its address. The result type is
                       read here, while local names still resolve (`fp()`), and
                       left on the call node for that materialisation. */
                    rt = n;
                    while (rt >= 0 && (self->arena->nodes[rt].kind == N_MEMBER
                                       || self->arena->nodes[rt].kind == N_ARROW))
                        rt = self->arena->nodes[rt].a;
                    if (rt >= 0 && self->arena->nodes[rt].kind == N_CALL
                        && !self->arena->nodes[rt].text[0]) {
                        rd2 = 0;
                        if (self->static_ctype(rt, rty, sizeof rty, &rd2, 0)
                            && rd2 == 0)
                            snprintf(self->arena->nodes[rt].text, MAX_TEXT, "%s", rty);
                    }
                    n = m;
                    continue;
                }
                /* V29-4: `v[3]` / `m["key"]` would be emitted as a subscript of
                   a C struct; refuse before the `[` is consumed so the error
                   carries its position. */
                if (self->container_index_check(n) != 0) return -1;
                self->sup->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->sup->expect("]") != 0) return -1;
                m = self->sup->new_node(N_INDEX);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].b = idx;
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, ".") == 0
                                     || strcmp(self->lex->toktext, "->") == 0)) {
                int arrow;
                arrow = (self->lex->toktext[0] == '-') ? 1 : 0;
                /* Phase 30: `.name` is the receiver sugar, so a pointer or a
                   left-value value receiver goes through `->` (the promoted
                   variable is a pointer in both cases). */
                if (!arrow) {
                    if (self->arena->nodes[n].kind == N_INTO_SELF
                        && self->arena->nodes[n].aux == 1) {
                        int ow = self->arena->nodes[n].num;
                        if (ow >= 0 && self->arena->nodes[ow].aux != 3) arrow = 1;
                    } else if (self->arena->nodes[n].kind == N_INTO
                               && self->arena->nodes[n].aux == 1) {
                        /* §2.8: a pointer receiver keeps its `->` spelling
                           after the block (`f(...) into { … }.close()`). */
                        arrow = 1;
                    }
                }
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a field or method name");
                snprintf(fname, sizeof fname, "%s", self->lex->toktext);
                mline = self->lex->tokline;
                mcol = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                    self->arena->nodes[m].aux = arrow ? 2 : 1;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs. Inside a trait's default body the
                       adopting struct is unknown, so a call on `self` names the
                       enclosing trait directly. */
                    if (self->sym->trait_default[0]
                        && self->arena->nodes[n].kind == N_VAR
                        && strcmp(self->arena->nodes[n].text2, "self") == 0) {
                        /* a forward sibling call (`a` calling a later `b`) is
                           legal, so the trait name is recorded without looking
                           the method up; the cycle check runs after the whole
                           trait has been parsed. */
                        snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s",
                                 self->sym->trait_default);
                    } else if (self->sup->expr_type(n, rtype, sizeof rtype) == 0) {
                        char ibase[MAX_TEXT];
                        size_t il;
                        int piface = 0;
                        int inm = -1;
                        /* a pointer to an interface value dispatches through
                           `->vt` instead of `.vt` */
                        snprintf(ibase, sizeof ibase, "%s", rtype);
                        il = strlen(ibase);
                        while (il > 0 && (ibase[il - 1] == ' ' || ibase[il - 1] == '*')) {
                            if (ibase[il - 1] == '*') piface = 1;
                            il--;
                            ibase[il] = 0;
                        }
                        /* Phase 28 (D28-2): inside a bounded template body the
                           receiver is the type parameter itself. The constraint
                           answers the method statically: record the trait and
                           the receiver form, and check the call against the
                           trait signature now, while the concrete type is still
                           unknown. The emitter spells the vtable from the
                           instance's type argument. */
                        if (self->in_generic_tparam[0] && self->in_generic_bound[0]
                            && strcmp(ibase, self->in_generic_tparam) == 0) {
                            char msgb[MAX_TEXT];
                            int bt, bmi = -1, bi2, bgot;
                            bt = self->sym->find_trait(self->in_generic_bound);
                            for (bi2 = 0; bt >= 0 && bi2 < self->sym->traits[bt].nm; bi2++)
                                if (strcmp(self->sym->traits[bt].m[bi2].name, fname) == 0) {
                                    bmi = bi2;
                                    break;
                                }
                            if (bmi < 0) {
                                snprintf(msgb, sizeof msgb,
                                         "trait '%s' has no method '%s'",
                                         self->in_generic_bound, fname);
                                return tool::diag::ct_sem_error(mline, mcol, msgb,
                                                                self->sup->mem->path);
                            }
                            bgot = arg_count(self->arena, args) + self->closure_arg_count(args);
                            if (self->arity_check(mline, mcol, fname, bgot,
                                                  self->sym->traits[bt].m[bmi].nparams) != 0)
                                return -1;
                            if (self->argtype_check(mline, mcol, fname, args, -1, bt, bmi) != 0)
                                return -1;
                            self->arena->nodes[m].aux = arrow ? 8 : 7;
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s",
                                     self->in_generic_bound);
                        } else if ((inm = self->inst_inherent_method(ibase, fname)) >= 0) {
                            /* Phase 31 S23b (L31-22): the loop reads the very
                               container the body would mutate. */
                            if ((strcmp(fname, "clear") == 0
                                 || strcmp(fname, "remove") == 0
                                 || strcmp(fname, "set") == 0
                                 || strcmp(fname, "put") == 0
                                 || strcmp(fname, "push") == 0)
                                && self->arena->nodes[n].kind == N_VAR
                                && iter_hit(self, self->arena->nodes[n].text2))
                                return tool::diag::ct_sem_error(mline, mcol,
                                    "cannot mutate the container being iterated; take a copy or collect the indices first",
                                    self->sup->mem->path);
            /* Phase 31 S23b (L31-23): the mutation moves the stored values, so
               every view of this container taken earlier is stale from here. */
            if ((strcmp(fname, "put") == 0
                 || strcmp(fname, "remove") == 0
                 || strcmp(fname, "clear") == 0
                 || strcmp(fname, "release") == 0)
                && self->arena->nodes[n].kind == N_VAR)
                view_mark(self, self->arena->nodes[n].text2);
                            /* Phase 31 S23a (L31-13 / L31-14): a borrow carries
                               no ownership, so releasing it would free storage
                               the container still owns -- whether the view is
                               the receiver itself (`g.get(0).release()`,
                               `item.release()`) or a local bound earlier
                               (`x = g.get(0); x.release();`). */
                            if (strcmp(fname, "release") == 0
                                && expr_borrow_root(self, n))
                                return tool::diag::ct_sem_error(mline, mcol,
                                    "cannot release a borrowed container view; call retain() first",
                                    self->sup->mem->path);
                            /* Phase 29: an inherent method of an instantiated
                               struct dispatches statically. The receiver's
                               concrete type is already in `ibase`, so the
                               emitter spells `<Inst>_<method>` and never reads
                               a vtable (D29: `impl` is a new branch, the trait
                               vptr paths are unchanged). */
                            int want = 0, pk;
                            for (pk = self->arena->nodes[inm].a; pk > 0;
                                 pk = self->arena->nodes[pk].next)
                                want++;
                            if (self->arity_check(mline, mcol, fname,
                                    arg_count(self->arena, args)
                                        + self->closure_arg_count(args), want) != 0)
                                return -1;
                            /* Phase 32 S7 (L32-6): bind, substitute, judge. */
                            if (self->types_mode && *self->types_mode) {
                                if (self->chk_mcall_args(ibase, fname, args) != 0)
                                    return -1;
                            }
                            /* L29-10 / L29-11: a container never stores an
                               `own` / `borrow` value, nor another container. */
                            if (frontend::sym::ct_is_container_type(ibase)
                                && (strcmp(fname, "push") == 0
                                    || strcmp(fname, "set") == 0
                                    || strcmp(fname, "put") == 0)) {
                                int ai, vi;
                                for (ai = args; ai > 0; ai = self->arena->nodes[ai].next) {
                                    char anm[MAX_TEXT];
                                    if (self->arena->nodes[ai].kind != N_VAR) continue;
                                    snprintf(anm, sizeof anm, "%s",
                                             self->arena->nodes[ai].text2);
                                    vi = self->sym->find_var(anm);
                                    if (vi < 0) continue;
                                    if (self->sym->vars[vi].autodrop
                                        || self->sym->vars[vi].borrowed)
                                        return tool::diag::ct_sem_error(mline, mcol,
                                            "a container cannot hold an 'own' or 'borrow' value",
                                            self->sup->mem->path);
                                }
                            }
                            /* Phase 31 S2: an interface formal boxes its
                               actual, exactly like a free-function call, so
                               `v.push(circle)` stores the fat pointer. The
                               bind is read from the instance, not from the
                               template spelling (`T` / `V`). */
                            {
                                int pi = self->arena->nodes[inm].a;
                                int ai = args, prev = -1;
                                while (pi >= 0 && ai > 0) {
                                    char fty[MAX_TEXT];
                                    char ftr[MAX_TEXT];
                                    int fip = 0;
                                    if (self->inst_subst_type(ibase,
                                            self->arena->nodes[pi].text, fty, sizeof fty)
                                        && self->sup->iface_ref_type(fty, ftr, sizeof ftr, &fip)) {
                                        int boxed = self->sup->maybe_box(ai, ftr, fip);
                                        if (boxed < 0) return -1;
                                        if (boxed != ai) {
                                            if (prev < 0) args = boxed;
                                            else self->arena->nodes[prev].next = boxed;
                                            self->arena->nodes[boxed].next =
                                                self->arena->nodes[ai].next;
                                            ai = boxed;
                                        }
                                    }
                                    prev = ai;
                                    ai = self->arena->nodes[ai].next;
                                    pi = self->arena->nodes[pi].next;
                                }
                                self->arena->nodes[m].b = (args == 0) ? -1 : args;
                            }
                            self->arena->nodes[m].aux = arrow ? 10 : 9;
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", ibase);
                        } else if (self->sup->is_iface_type(ibase, trname, sizeof trname)) {
                            int t = self->sym->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                                    if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                self->arena->nodes[m].aux = piface ? 4 : 3;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            }
                        } else if (self->sup->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            char tr2[MAX_TEXT];
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            /* 19.3 (SH-46): a second trait of the same struct
                               declaring the method means the bare call keeps
                               the first match in `use` order silently (the spec
                               pins that resolution) -- name both in a warning.
                               A static type host and a `map` binding resolve
                               below, outside `method_trait`, so they never
                               reach this check. */
                            if (self->sup->method_trait_amb(rtype, fname, trname,
                                                            tr2, sizeof tr2) == 0) {
                                char amsg[MAX_TEXT];
                                snprintf(amsg, sizeof amsg,
                                         "declared by '%s' and '%s'; '%s' is used",
                                         trname, tr2, trname);
                                if (self->sup->amb_warn(mline, mcol, fname, amsg) != 0)
                                    return self->sup->fail("too many warnings");
                            }
                        }
                        /* No trait answered: a function-pointer field called
                           directly is the callee itself, so `o.add(2, 3)` is
                           a call through `o.add` -- the shape `p(x)` takes, but
                           with a member node as the callee (D-4). */
                        if (!self->arena->nodes[m].text[0] && self->fnptr_field(rtype, fname)) {
                            int mf;
                            mf = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                            if (mf < 0) return -1;
                            self->arena->nodes[mf].a = n;
                            snprintf(self->arena->nodes[mf].text2, MAX_TEXT, "%s", fname);
                            self->arena->nodes[m].kind = N_CALL;
                            self->arena->nodes[m].a = (args == 0) ? -1 : args;
                            self->arena->nodes[m].b = mf;
                            self->arena->nodes[m].aux = 2;
                        }
                        /* Still unresolved: the method may belong to a static
                           type host (`map ... for type char *`). Keep the call
                           as an N_MCALL, record the receiver's static type
                           (locals are gone by emit time) and let the emitter
                           match it against the visible static maps. */
                        if (!self->arena->nodes[m].text[0]
                            && self->arena->nodes[m].kind == N_MCALL) {
                            char it[MAX_TEXT];
                            if (!self->sup->is_iface_type(rtype, it, sizeof it)) {
                                char rt2[MAX_TEXT];
                                snprintf(rt2, sizeof rt2, "%s", rtype);
                                if (self->arena->nodes[n].kind == N_VAR) {
                                    int vi = self->sym->find_var(self->arena->nodes[n].text2);
                                    if (vi >= 0 && self->sym->vars[vi].is_array
                                        && strlen(rt2) + 2 < sizeof rt2)
                                        strcat(rt2, " *");
                                }
                                self->arena->nodes[m].aux = 6;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", rt2);
                                /* P20-03: the emitter picks the map, so the
                                   arity check beside the resolved-method path
                                   never sees this call. Every visible binding
                                   records the method it expands to, so the
                                   count is still knowable here: one accepting
                                   candidate is enough, and a call no candidate
                                   accepts is reported in the same words as a
                                   resolved method. The map table belongs to the
                                   parser but the type object already points at
                                   it, so this unit needs no new plumbing. */
                                {
                                    struct MapTable *hm;
                                    int hn, mi2, bi2, want = 0, seen = 0, afits = 0, fits = 0;
                                    int pt = -1, pm = -1;
                                    int got2 = arg_count(self->arena, args)
                                               + self->closure_arg_count(args);
                                    char rk[MAX_TEXT];
                                    char tk[MAX_TEXT];
                                    char msg[MAX_TEXT];
                                    char tmsg[MAX_TEXT];
                                    tmsg[0] = 0;
                                    hm = self->sup->ty->maps;
                                    hn = *self->sup->ty->nmaps;
                                    /* the same host key the emitter and the
                                       type pass compare with: `tnorm` only
                                       drops qualifiers, so `unsigned` and
                                       `unsigned int` would miss each other
                                       here while the recipe still expands,
                                       dropping a surplus actual in silence */
                                    frontend::type::type_key(rt2, rk, sizeof rk);
                                    for (mi2 = 0; mi2 < hn; mi2++) {
                                        if (!hm[mi2].is_static
                                            || !hm[mi2].type_host) continue;
                                        frontend::type::type_key(hm[mi2].host_type, tk, sizeof tk);
                                        if (strcmp(tk, rk) != 0) continue;
                                        for (bi2 = 0; bi2 < hm[mi2].nb; bi2++) {
                                            int want2, tail2, tt, tm, arity_ok;
                                            if (strcmp(hm[mi2].b[bi2].method,
                                                       fname) != 0) continue;
                                            /* a type-host binding names the
                                               receiver first */
                                            want2 = hm[mi2].b[bi2].nparams
                                                    - hm[mi2].b[bi2].recv;
                                            /* a recipe that forwards a tail
                                               (`printf(fmt, ...)`) makes the
                                               count a lower bound; the map
                                               builder only accepts `...` when
                                               the binding declares it, so the
                                               recipe text is the marker */
                                            tail2 = strstr(hm[mi2].b[bi2].call,
                                                           "...") != 0;
                                            if (!seen) want = want2;
                                            seen = 1;
                                            /* 25.1: the signature is needed
                                               for the closure check even when
                                               the closure itself makes the
                                               count miss, so resolve it before
                                               the arity gate. Two packages may
                                               bind the same host and method with
                                               different signatures, so every
                                               arity-fitting candidate is asked;
                                               one accepting is enough. */
                                            tt = self->sym->find_trait(hm[mi2].trait);
                                            tm = -1;
                                            if (tt >= 0) {
                                                for (tm = 0; tm < self->sym->traits[tt].nm; tm++)
                                                    if (strcmp(self->sym->traits[tt].m[tm].name,
                                                               fname) == 0) break;
                                                if (tm >= self->sym->traits[tt].nm) tm = -1;
                                            }
                                            if (tt >= 0 && tm >= 0 && pt < 0) {
                                                pt = tt;
                                                pm = tm;
                                            }
                                            arity_ok = tail2 ? got2 >= want2
                                                             : got2 == want2;
                                            if (!arity_ok) continue;
                                            afits = 1;
                                            if (tt < 0 || tm < 0) {
                                                fits = 1;
                                                continue;
                                            }
                                            if (!self->argtype_mismatch(args, -1, tt, tm,
                                                                        tmsg, sizeof tmsg))
                                                fits = 1;
                                        }
                                    }
                                    /* A closure in a non-pair position is
                                       L25-1 whatever the count says: the
                                       generic "fewer arguments" wording would
                                       hide the real fault. */
                                    if (seen && pt >= 0 && pm >= 0
                                        && self->map_closure_check(mline, mcol, args,
                                                                   pt, pm) != 0)
                                        return -1;
                                    if (seen && !afits) {
                                        snprintf(msg, sizeof msg,
                                                 "takes %d argument(s), %d given",
                                                 want, got2);
                                        if (self->sup->arity_warn(mline, mcol, fname,
                                                                  msg) != 0)
                                            return self->sup->fail("too many warnings");
                                    } else if (seen && afits && !fits) {
                                        /* SH-60: every arity-fitting candidate
                                           disagreed with an actual, so this is
                                           a hard error -- see
                                           `argtype_check_static`. */
                                        snprintf(msg, sizeof msg,
                                                 "type mismatch: '%s' %s", fname, tmsg);
                                        tool::diag::ct_sem_error(mline, mcol, msg,
                                                                 self->sup->mem->path);
                                        return -1;
                                    }
                                }
                            }
                        }
                    }
                } else {
                    if (self->into_member_check(n, fname, mline, mcol) != 0)
                        return -1;
                    m = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                }
                /* 19.1: a resolved trait method is compared against the call's
                   argument count. A static trait (a `.m.ct` recipe), a `map`
                   binding (the receiver's type stays in `text`) and a call
                   through a function-pointer field (`kind` became N_CALL) are
                   all unknown here and pass. `arity_check` only reports, so the
                   generated call is unchanged. */
                if (self->arena->nodes[m].kind == N_MCALL
                    && self->arena->nodes[m].text[0]) {
                    int t = self->sym->find_trait(self->arena->nodes[m].text);
                    if (t >= 0) {
                        int mi;
                        for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                            if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) break;
                        /* a static recipe must still agree on the count: the
                           surplus is only legal when the recipe forwards it */
                        if (mi < self->sym->traits[t].nm
                            && self->map_arity(mline, mcol, self->arena->nodes[m].text,
                                               fname, arg_count(self->arena, args)) != 0)
                            return -1;
                        /* 19.2: the argument types against the resolved trait
                           method, same rules as a function call. */
                        if (!self->sym->traits[t].is_static
                            && mi < self->sym->traits[t].nm
                            && self->argtype_check(mline, mcol, fname, args, -1, t, mi) != 0)
                            return -1;
                    }
                }
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                /* a call through a pointer expression: `(*p)(x)` (D-7). A plain
                   `name(...)` was already consumed by `parse_primary`. */
                args = self->parse_args();
                if (args < 0) return -1;
                m = self->sup->new_node(N_CALL);
                if (m < 0) return -1;
                self->arena->nodes[m].a = (args == 0) ? -1 : args;
                self->arena->nodes[m].b = n;
                self->arena->nodes[m].aux = 2;
                n = m;
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0 || strcmp(self->lex->toktext, "--") == 0)) {
            int k;
            if (is_range_index(self->arena, n))
                return self->sup->fail("the range index '$' is not a variable");
            /* Phase 31 O3 (L31-3/L31-4): `v[i]++` writes the value. */
            if (self->container_write_check(n) != 0) return -1;
            k = self->arena->nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->sup->fail("'++' / '--' need an assignable target");
            m = self->sup->new_node(N_POST);
            if (m < 0) return -1;
            self->arena->nodes[m].a = n;
            self->arena->nodes[m].aux = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            return m;
        }
        return n;
    }

    /* A closure literal `(params) => expr` (Phase 21 S2). The cursor sits on
       the `(`. The literal gets its own parameter scope; a name the body uses
       that resolves below `pstart` is a capture, so a parameter that shadows an
       outer variable keeps the outer one out (D21-2). Names and types are
       copied into the closure table before the scope is popped, because the
       symbol slots are reused. S2 parses and checks only: nothing is emitted. */
    int parse_closure(void)
    {
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        char owner[MAX_TEXT];
        int ci, pstart, body, n, line, col, save_assign;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        snprintf(owner, sizeof owner, "%s", self->cur_func ? self->cur_func : "");
        ci = self->sym->closure_new(owner);
        if (ci < 0) return self->sup->fail(self->sym->last_error());
        self->sym->closures[ci].line = line;
        self->sym->closures[ci].col = col;
        self->sup->lex_next();                       /* the `(` */
        pstart = self->sym->nvar;
        if (self->sym->push_scope() != 0) return self->sup->fail(self->sym->last_error());
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
            for (;;) {
                if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
                if (self->fnptr_state) {
                    if (!self->fnptr_name[0])
                        return self->sup->fail("expected a parameter name");
                    snprintf(name, sizeof name, "%s", self->fnptr_name);
                } else {
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a parameter name");
                    snprintf(name, sizeof name, "%s", self->lex->toktext);
                    self->sup->lex_next();
                }
                if (self->sym->declare_var(name, typebuf) != 0)
                    return self->sup->fail(self->sym->last_error());
                if (self->sym->closures[ci].nparams >= 16)
                    return self->sup->fail("a closure takes too many parameters (limit 16)");
                if (closure_copy(self,
                                 self->sym->closures[ci].ptype[self->sym->closures[ci].nparams],
                                 typebuf, "a closure parameter type") != 0) return -1;
                if (closure_copy(self,
                                 self->sym->closures[ci].pname[self->sym->closures[ci].nparams],
                                 name, "a closure parameter name") != 0) return -1;
                self->sym->closures[ci].nparams++;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
        }
        if (self->sup->expect(")") != 0) return -1;
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "=>") != 0)
            return self->sup->fail("expected '=>' after a closure's parameter list");
        self->sup->lex_next();
        /* R09: the nesting stack is not optional. Dropping the push would leave
           an inner literal without its parent's environment, so the emitter
           would build it against the wrong frame; the cap is a hard error. */
        if (self->ncl_stack >= 16)
            return self->sup->fail("a closure is nested too deeply (limit 16)");
        self->cl_stack[self->ncl_stack] = ci;
        self->cl_pstart[self->ncl_stack] = pstart;
        self->ncl_stack++;
        /* S5: `=> { … }` is a block body; the statement layer owns blocks and
           this object cannot import it, so the parser installed a hook. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
            if (!self->body_hook)
                return self->sup->fail("a block-bodied closure needs the statement parser");
            body = self->body_hook();
            self->sym->closures[ci].is_block = 1;
        } else {
            save_assign = self->assign_ok;
            self->assign_ok = 1;
            body = self->parse_expr();
            self->assign_ok = save_assign;
        }
        if (body < 0) return -1;
        self->sym->closures[ci].body = body;
        if (closure_walk(self, ci, body, pstart) != 0) return -1;
        if (closure_walk_shadow(self, ci, body) != 0) return -1;
        if (closure_walk_mutate(self, ci, body) != 0) return -1;
        if (self->ncl_stack > 0 && self->cl_stack[self->ncl_stack - 1] == ci)
            self->ncl_stack--;
        if (self->sym->pop_scope() != 0) return self->sup->fail(self->sym->last_error());
        n = self->sup->new_node(N_CLOSURE);
        if (n < 0) return -1;
        self->arena->nodes[n].num = ci;
        self->arena->nodes[n].a = body;
        return n;
    }

    int parse_primary(void)
    {
        int n, args, id_line, id_col;
        char qc[MAX_TEXT];
        char qv[MAX_TEXT];
        char tsrc[MAX_TEXT];
        char tag[MAX_TEXT];
        int qf;
        int nu, nl, sl;
        (void)self;

        qc[0] = 0;
        qv[0] = 0;
        /* C11 `_Generic(…)` is a pass-through: the whole selection is copied
           into the string pool (`N_RAW`, `aux = 1`, `num` = offset) and handed
           to the C compiler, which owns the arm choice. ct does not read the
           arms, so a trait call or a boxing inside one is not rewritten. */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "_Generic") == 0) {
            char gname[MAX_TEXT];
            int off, depth, k, prev_tag;
            n = self->sup->new_node(N_RAW);
            if (n < 0) return -1;
            off = self->arena->str_begin();
            snprintf(gname, sizeof gname, "%s", "_Generic");
            for (k = 0; gname[k]; k++)
                if (self->arena->str_put(gname[k]) != 0)
                    return self->sup->fail("string pool is full");
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0)
                return self->sup->fail("expected '(' after _Generic");
            depth = 0;
            prev_tag = 0;
            for (;;) {
                char tbuf[MAX_TEXT];
                int m;
                if (self->lex->tok == T_EOF) return self->sup->fail("unterminated _Generic");
                if (self->arena->str_put(' ') != 0)
                    return self->sup->fail("string pool is full");
                /* an integer token keeps its value, not its spelling */
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                else
                    snprintf(tbuf, sizeof tbuf, "%s", self->lex->toktext);
                /* the body is copied verbatim, so a bare type parameter here
                   would reach the output as an undeclared name; refuse it
                   instead of emitting bad C (SH-62). `struct T` / `union T` /
                   `enum T` is a tag, not the parameter, so it stays legal. */
                if (self->in_generic && self->in_generic_tparam[0]
                    && strcmp(tbuf, self->in_generic_tparam) == 0 && !prev_tag)
                    return self->sup->fail("type parameter cannot be used inside _Generic");
                prev_tag = strcmp(tbuf, "struct") == 0 || strcmp(tbuf, "union") == 0
                           || strcmp(tbuf, "enum") == 0;
                for (m = 0; tbuf[m]; m++)
                    if (self->arena->str_put(tbuf[m]) != 0)
                        return self->sup->fail("string pool is full");
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) depth++;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                    depth--;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            self->arena->nodes[n].aux = 1;
            return n;
        }
        if (self->lex->tok == T_NUM) {
            /* an integer keeps its value (`long`, emitted in decimal); a
               floating literal keeps its spelling, since neither the value nor
               the `f` / `L` suffix survives a `long` */
            n = self->sup->new_node(self->lex->tokfloat ? N_FNUM : N_NUM);
            if (n < 0) return -1;
            if (self->lex->tokfloat)
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->lex->toktext);
            else {
                self->arena->nodes[n].num = self->lex->toknum;
                /* An integer suffix is spelling, not value: `U` may appear once
                   and `L` twice, and the emitted form always orders them U then
                   L (`uLL`, `LLu`, `lL` all become `ULL` / `LL`). */
                nu = 0;
                nl = 0;
                for (sl = 0; self->lex->toksuffix[sl]; sl++) {
                    if (self->lex->toksuffix[sl] == 'u' || self->lex->toksuffix[sl] == 'U') nu++;
                    else nl++;
                }
                if (nu > 1 || nl > 2 || sl > 3)
                    return self->sup->fail("an integer suffix may be U, L or LL");
                if (nu && nl == 2) snprintf(self->arena->nodes[n].text, MAX_TEXT, "ULL");
                else if (nu && nl == 1) snprintf(self->arena->nodes[n].text, MAX_TEXT, "UL");
                else if (nu) snprintf(self->arena->nodes[n].text, MAX_TEXT, "U");
                else if (nl == 2) snprintf(self->arena->nodes[n].text, MAX_TEXT, "LL");
                else if (nl == 1) snprintf(self->arena->nodes[n].text, MAX_TEXT, "L");
            }
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_STR) {
            int off = self->arena->str_begin();
            n = self->sup->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (self->lex->tok == T_STR) {
                int m = 0;
                while (self->lex->toktext[m]) {
                    if (self->arena->str_put((unsigned char)self->lex->toktext[m]) != 0)
                        return self->sup->fail("string pool is full");
                    m++;
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            return n;
        }
        /* `offsetof(<struct type>, <field>)` is a builtin, not a macro: CT has
           no preprocessor, so the compiler recognises it here and the generated
           `.c` keeps the same call (D-8). */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "offsetof") == 0
            && self->offsetof_ahead()) {
            char tbuf[MAX_TEXT];
            char fname[MAX_TEXT];
            char base[MAX_TEXT];
            char msg[MAX_TEXT];
            char kw[16];
            char *bp;
            size_t bl;
            int si, fi, known;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(",") != 0) return -1;
            if (self->lex->tok != T_ID) return self->sup->fail("expected a field name");
            snprintf(fname, sizeof fname, "%s", self->lex->toktext);
            /* Phase 26 fix (SH-62): a type parameter has no field list here;
               the instance emission substitutes `T` and C checks the field. */
            if (self->in_generic && self->in_generic_tparam[0]
                && strcmp(tbuf, self->in_generic_tparam) == 0) {
                self->sup->lex_next();
                if (self->sup->expect(")") != 0) return -1;
                n = self->sup->new_node(N_OFFSETOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", fname);
                return n;
            }
            /* Both checks run while the cursor is still on the field, so the
               diagnostic points at the argument the user has to fix. */
            snprintf(base, sizeof base, "%s", tbuf);
            bp = base;
            snprintf(kw, sizeof kw, "%s", "struct");
            if (strncmp(bp, "struct ", 7) == 0) {
                bp += 7;
            } else if (strncmp(bp, "union ", 6) == 0) {
                snprintf(kw, sizeof kw, "%s", "union");
                bp += 6;
            }
            while (*bp == ' ') bp++;
            bl = strlen(bp);
            while (bl > 0 && (bp[bl - 1] == ' ' || bp[bl - 1] == '*')) {
                bl--;
                bp[bl] = 0;
            }
            si = self->sym->find_struct(bp);
            if (si < 0) return self->sup->fail("offsetof needs a struct type");
            /* a forward declaration has no field list yet: leave it to C */
            known = !self->sym->structs[si].defined;
            for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
                if (strcmp(self->sym->structs[si].fields[fi].name, fname) == 0) known = 1;
            if (!known) {
                if (snprintf(msg, sizeof msg, "%s '%s' has no field '%s'", kw, bp, fname)
                    >= (int)sizeof msg)
                    return self->sup->fail("offsetof field name is too long");
                return self->sup->fail(msg);
            }
            self->sup->lex_next();
            if (self->sup->expect(")") != 0) return -1;
            n = self->sup->new_node(N_OFFSETOF);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", fname);
            return n;
        }
        /* `va_arg(<ap>, <type>)` is the one stdarg macro that is not a call: its
           second argument is a type, so it is a builtin like `offsetof` and the
           generated `.c` keeps the same spelling (D-9). */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "va_arg") == 0
            && self->offsetof_ahead()) {
            char tbuf[MAX_TEXT];
            int ap;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            ap = self->parse_expr();
            if (ap < 0) return -1;
            if (self->sup->expect(",") != 0) return -1;
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            n = self->sup->new_node(N_VAARG);
            if (n < 0) return -1;
            self->arena->nodes[n].a = ap;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            return n;
        }
        /* Phase 24: the range index. `$` has no C spelling of its own -- the
           emitter renders it as `((int)<k>)` -- so it never reaches the symbol
           table; outside the element expression of a range initialiser it is a
           syntax error, never an undeclared name. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "$") == 0) {
            /* Phase 30: inside an `into` block `$` is the receiver itself. */
            if (self->into_node >= 0) {
                n = self->sup->new_node(N_INTO_SELF);
                if (n < 0) return -1;
                self->arena->nodes[n].num = self->into_node;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s",
                         self->arena->nodes[self->into_node].text);
                self->sup->lex_next();
                return n;
            }
            if (!self->dollar_ok) return self->sup->fail("unexpected token");
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", "$");
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_ID) {
            id_line = self->lex->tokline;
            id_col = self->lex->tokstart - self->lex->lstart + 1;
            /* P29-2: `Vec<int>::from(items, n)` -- the static (receiverless)
               method of an instantiated struct. Only a name the template table
               already holds enters here, and the lookahead insists on `:: name
               (` after the closing `>`, so `a < b` on a variable keeps its
               comparison meaning (D26-3). The node carries the instance
               spelling, so the emitter writes `<Inst>_<method>(...)`. The
               cursor is still on the template name, so `parse_inst_type` reads
               `Vec<int>` exactly as a type position would. */
            if (frontend::sym::ct_tmpl_find(self->lex->toktext) >= 0
                && self->static_call_ahead()) {
                char ibase[MAX_TEXT];
                char sm[MAX_TEXT];
                char smsg[MAX_TEXT + 64];
                int mn;
                ibase[0] = 0;
                if (self->parse_inst_type(ibase, sizeof ibase) != 0) return -1;
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0))
                    return self->sup->fail("expected '::' after the instance type");
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
                snprintf(sm, sizeof sm, "%s", self->lex->toktext);
                self->sup->lex_next();
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0))
                    return self->sup->fail("a static method call needs an argument list");
                args = self->parse_args();
                if (args < 0) return -1;
                if (self->inst_static_method(ibase, sm) < 0) {
                    snprintf(smsg, sizeof smsg, "'%s' has no static method '%s'",
                             ibase, sm);
                    return self->sup->fail(smsg);
                }
                if (self->map_arity(id_line, id_col, ibase, sm,
                                    arg_count(self->arena, args)
                                    + self->closure_arg_count(args)) != 0)
                    return -1;
                mn = self->sup->new_node(N_MCALL);
                if (mn < 0) return -1;
                self->arena->nodes[mn].a = -1;
                self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                self->arena->nodes[mn].aux = 11;
                snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s", ibase);
                snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", sm);
                return mn;
            }
            /* P34 S5a: a non-generic inherent static call `Counter.make(5)`.
               The name is a struct (not a template), followed by `.method(`.
               A bare struct name that is not a static call falls through to
               the ordinary variable path below, where it is reported as an
               undeclared variable. */
            if (self->sym->find_struct(self->lex->toktext) >= 0) {
                int sp2, sbol2, stok2, sline2, stokline2, sstart2, slstart2;
                long snum2;
                int sfloat2, strunc2;
                char stext2[MAX_TEXT], ssuf2[8];
                sp2 = self->lex->pos; sbol2 = self->lex->bol;
                stok2 = self->lex->tok; snum2 = self->lex->toknum;
                sline2 = self->lex->line; stokline2 = self->lex->tokline;
                sstart2 = self->lex->tokstart; slstart2 = self->lex->lstart;
                sfloat2 = self->lex->tokfloat; strunc2 = self->lex->toktrunc;
                snprintf(stext2, sizeof stext2, "%s", self->lex->toktext);
                snprintf(ssuf2, sizeof ssuf2, "%s", self->lex->toksuffix);
                self->sup->lex_next();   /* the struct name */
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ".") == 0) {
                    self->sup->lex_next();
                    if (self->lex->tok == T_ID) {
                        char sibase[MAX_TEXT];
                        char sm2[MAX_TEXT];
                        char smsg2[MAX_TEXT + 64];
                        int mn2;
                        snprintf(sm2, sizeof sm2, "%s", self->lex->toktext);
                        self->sup->lex_next();
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                            snprintf(sibase, sizeof sibase, "struct %s", stext2);
                            args = self->parse_args();
                            if (args < 0) return -1;
                            if (self->inst_static_method(sibase, sm2) < 0) {
                                snprintf(smsg2, sizeof smsg2, "'%s' has no static method '%s'",
                                         stext2, sm2);
                                return self->sup->fail(smsg2);
                            }
                            if (self->map_arity(id_line, id_col, sibase, sm2,
                                                arg_count(self->arena, args)
                                                    + self->closure_arg_count(args)) != 0)
                                return -1;
                            mn2 = self->sup->new_node(N_MCALL);
                            if (mn2 < 0) return -1;
                            self->arena->nodes[mn2].a = -1;
                            self->arena->nodes[mn2].b = (args == 0) ? -1 : args;
                            self->arena->nodes[mn2].aux = 11;
                            snprintf(self->arena->nodes[mn2].text, MAX_TEXT, "%s", sibase);
                            snprintf(self->arena->nodes[mn2].text2, MAX_TEXT, "%s", sm2);
                            return mn2;
                        }
                    }
                }
                /* not a static call: rewind so the variable path handles it */
                self->lex->pos = sp2; self->lex->bol = sbol2;
                self->lex->tok = stok2; self->lex->toknum = snum2;
                self->lex->line = sline2; self->lex->tokline = stokline2;
                self->lex->tokstart = sstart2; self->lex->lstart = slstart2;
                self->lex->tokfloat = sfloat2; self->lex->toktrunc = strunc2;
                snprintf(self->lex->toktext, sizeof self->lex->toktext, "%s", stext2);
                snprintf(self->lex->toksuffix, sizeof self->lex->toksuffix, "%s", ssuf2);
            }
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->lex->toktext);
            self->sup->lex_next();
            /* Phase 31 S23b (L31-23): a view whose container was mutated after
               it was taken is stale. A name followed by `=` is being rebound,
               not read, so it is not a use of the old view. */
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "=") == 0)
                && view_use(self, self->arena->nodes[n].text2, id_line, id_col) != 0)
                return -1;
            /* Phase 26 fix (SH-64): an identifier that names the current
               template's type parameter is never a value. Type operands were
               already taken by parse_unary / parse_type before this point, so
               every identifier-resolution path that starts here -- a generic
               instance, a qualified name, a call, the ALL_CAPS macro fallback,
               a bare function value, `fnval_ok` -- must reject it. One guard at
               the shared entry covers them all instead of patching each exit;
               without it `return T;` emitted the raw `T`. */
            if (self->in_generic && self->in_generic_tparam[0]
                && strcmp(self->arena->nodes[n].text2, self->in_generic_tparam) == 0) {
                char vmsg[MAX_TEXT + 64];
                snprintf(vmsg, sizeof vmsg,
                         "type parameter '%s' cannot be used as a value",
                         self->arena->nodes[n].text2);
                return self->sup->fail(vmsg);
            }
            /* Phase 26: `name<type>(...)` names a generic instance. Only a name
               the symbol table already holds as a template enters this branch,
               so `a < b` on a variable stays a comparison (D26-1/D26-3). */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "<") == 0) {
                int gfi = self->sym->find_func(self->arena->nodes[n].text2);
                if (gfi >= 0 && self->sym->funcs[gfi].ntparams == 1) {
                    char targ[MAX_TEXT];
                    char gmsg[MAX_TEXT + 64];
                    int gi;
                    if (self->in_generic)
                        return self->sup->fail("recursive generic calls are not supported");
                    self->sup->lex_next();
                    if (self->parse_type(targ, sizeof targ) != 0) return -1;
                    if (self->fnptr_state || strcmp(targ, "void") == 0
                        || strcmp(targ, self->sym->funcs[gfi].tparam) == 0) {
                        snprintf(gmsg, sizeof gmsg,
                                 "'%s' cannot be a generic type argument", targ);
                        return self->sup->fail(gmsg);
                    }
                    if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ">") == 0))
                        return self->sup->fail("expected '>' after the generic type argument");
                    self->sup->lex_next();
                    gi = self->generic_instance(gfi, targ, id_line, id_col);
                    if (gi < 0) return -1;
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s",
                             self->sym->ginsts[gi].cname);
                }
            }
            /* `Qual::fn(...)`: the qualifier names a namespace path or a type,
               and the callee lives in that namespace. Without the call it names
               a variable instead (`a::h`), whose C spelling is the mangled one. */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                snprintf(tsrc, sizeof tsrc, "%s", self->arena->nodes[n].text2);
                if (self->parse_qual_path(self->arena->nodes[n].text2, MAX_TEXT, qc, MAX_TEXT,
                                          qv, MAX_TEXT, &qf) != 0)
                    return -1;
                /* `Trait::ns`: a namespace-host interface value (SH-20). The
                   host has no object, so the node carries no operand (`a`), the
                   vtable is named after `text2` and `text3` keeps the source
                   spelling for the emitter's diagnostics. */
                if (qf == 3) {
                    char mname[MAX_TEXT];
                    int mn;
                    if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ".") == 0))
                        return self->sup->fail("a static trait has no interface value");
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a method name");
                    snprintf(mname, sizeof mname, "%s", self->lex->toktext);
                    self->sup->lex_next();
                    args = self->parse_args();
                    if (args < 0) return -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = -1;
                    self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                    self->arena->nodes[mn].aux = 5;
                    snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", mname);
                    snprintf(self->arena->nodes[mn].text3, MAX_TEXT, "%s", qv);
                    if (self->map_arity(id_line, id_col, self->arena->nodes[n].text2,
                                        mname, arg_count(self->arena, args)
                                        + self->closure_arg_count(args)) != 0)
                        return -1;
                    /* 25.1: the trait segment is explicit, so the signature
                       is this unit's to compare -- same 19.2 rules as a
                       resolved trait method, and no receiver precedes the
                       method's own parameters. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, mname) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm) {
                                if (self->map_closure_check(id_line, id_col, args,
                                                            ti3, mi3) != 0)
                                    return -1;
                                if (self->argtype_check_static(id_line, id_col, mname, args,
                                                               ti3, mi3) != 0)
                                    return -1;
                            }
                        }
                    }
                    return mn;
                }
                /* Q2-A: `ns::method(...)` with the trait segment elided. The
                   qualifier is a static map's namespace host and the method name
                   is unique (parse_qual_path checked both), so this is the same
                   recipe call `ns::Trait.method(...)` builds above. */
                if (qf == 4) {
                    int mn;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = -1;
                    self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                    self->arena->nodes[mn].aux = 5;
                    snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[mn].text3, MAX_TEXT, "%s", qv);
                    if (self->map_arity(id_line, id_col, self->arena->nodes[n].text2,
                                        qc, arg_count(self->arena, args)
                                        + self->closure_arg_count(args)) != 0)
                        return -1;
                    /* 25.1: the namespace host resolved a unique trait, so its
                       method signature is known here -- compare the actuals
                       against it, receiver-free like the form above. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, qc) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm) {
                                if (self->map_closure_check(id_line, id_col, args,
                                                            ti3, mi3) != 0)
                                    return -1;
                                if (self->argtype_check_static(id_line, id_col, qc, args,
                                                               ti3, mi3) != 0)
                                    return -1;
                            }
                        }
                    }
                    return mn;
                }
                /* P20-01: `Trait::method(recv, ...)` — the first actual is the
                   receiver, so the node is the same static-recipe call as a
                   type-host method (`aux == 6`), with the forced trait in
                   `text3`. That is what lets two packages bind `len` to
                   `char *` and the caller pick one. Writing the node directly
                   must not skip the arity check the other static-recipe forms
                   run, or an extra actual is dropped by the recipe with no
                   diagnostic. */
                if (qf == 5) {
                    char rtype[MAX_TEXT];
                    int mn, rest, got;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    if (args == 0)
                        return self->sup->fail("a qualified method call needs a receiver argument");
                    /* the receiver stands apart from the trait method's own
                       parameters, exactly as in `Trait::ns.method(...)` */
                    got = arg_count(self->arena, args) - 1;
                    if (self->sup->expr_type(args, rtype, sizeof rtype) != 0)
                        return self->sup->fail("cannot infer the receiver type of a qualified method call");
                    if (self->arena->nodes[args].kind == N_VAR) {
                        int vi = self->sym->find_var(self->arena->nodes[args].text2);
                        if (vi >= 0 && self->sym->vars[vi].is_array
                            && strlen(rtype) + 2 < sizeof rtype)
                            strcat(rtype, " *");
                    }
                    rest = self->arena->nodes[args].next;
                    self->arena->nodes[args].next = -1;
                    /* D25-3: a closure in the tail fills two recipe slots, so
                       the count the method signature is compared with grows by
                       one for each; the receiver is already out of `rest`. */
                    got += self->closure_arg_count(rest);
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = args;
                    self->arena->nodes[mn].b = rest;
                    self->arena->nodes[mn].aux = 6;
                    snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s", rtype);
                    snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[mn].text3, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    /* The trait's own signature is the judge: `nparams` counts
                       the method's parameters, never the receiver. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, qc) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm) {
                                if (self->arity_check(id_line, id_col, qc, got,
                                                      self->sym->traits[ti3].m[mi3].nparams) != 0)
                                    return -1;
                                /* 25.1: the receiver stays apart, so the
                                   remaining actuals are compared with the
                                   method's own parameters as written. */
                                if (self->map_closure_check(id_line, id_col, rest,
                                                            ti3, mi3) != 0)
                                    return -1;
                                if (self->argtype_check_static(id_line, id_col, qc, rest,
                                                               ti3, mi3) != 0)
                                    return -1;
                            }
                        }
                    }
                    return mn;
                }
                if (qf == 2) {
                    if (snprintf(tag, sizeof tag, "%s|%s", tsrc, qv) >= MAX_TEXT)
                        return self->sup->fail("qualified name is too long");
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", tag);
                    self->arena->nodes[n].kind = N_BOX;
                    self->arena->nodes[n].a = -1;
                    self->arena->nodes[n].aux = 4;
                    self->arena->nodes[n].b = -1;
                    return n;
                }
                if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
                    if (self->sym->find_qualified_global(qv, self->arena->nodes[n].text2,
                                                         qc, MAX_TEXT) != 0)
                        return self->sup->fail("no variable of that name in that namespace"
                                               " (qualified type names are not supported;"
                                               " use the bare name or an alias import)");
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", qc);
                    return n;
                }
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                int fi;
                /* L26-1: a template cannot be called without naming a type
                   argument; the instance does not exist before this point. */
                {
                    int gchk = self->sym->find_func(self->arena->nodes[n].text2);
                    if (gchk >= 0 && self->sym->funcs[gchk].ntparams == 1) {
                        char gmsg[MAX_TEXT + 64];
                        snprintf(gmsg, sizeof gmsg,
                                 "generic function '%s' needs a type argument",
                                 self->arena->nodes[n].text2);
                        return self->sup->fail(gmsg);
                    }
                }
                args = self->parse_args();
                if (args < 0) return -1;
                self->sym->errmsg[0] = 0;
                if (qc[0]) fi = self->sym->find_func(qc);
                else fi = self->sym->resolve_func(self->arena->nodes[n].text2);
                if (fi < 0) {
                    const char *why = self->sym->last_error();
                    if (why[0]) return self->sup->fail(why);
                }
                /* `p(args)` on a function-pointer variable: no function of that
                   name exists and the lookup said nothing, so the callee is the
                   variable. Calls through a pointer are emitted uniformly as
                   `(*p)(args)` (D-7). */
                if (fi < 0) {
                    char vt[MAX_TEXT];
                    if (self->sym->var_type(self->arena->nodes[n].text2, vt, sizeof vt) == 0
                        && strstr(vt, "(*"))
                        self->arena->nodes[n].aux = 1;
                }
                /* the call graph keeps the name the source wrote */
                if (fi >= 0 && self->record_call(self->arena->nodes[n].text2, id_line) != 0) return -1;
                /* Phase 21 S4: a closure actual must fill the callee's
                   `(fn, env)` pair; an unresolved callee cannot be verified. */
                if (args > 0
                    && self->closure_arg_check(id_line, id_col, self->arena->nodes[n].text2,
                                               args, fi) != 0)
                    return -1;
                /* 19.1: a resolved signature says how many arguments the callee
                   takes; a variadic tail accepts any surplus past its named
                   parameters. The message keeps the name the source wrote. */
                if (fi >= 0) {
                    int got, want, tail_ok;
                    got = arg_count(self->arena, args) + self->closure_arg_count(args);
                    want = self->sym->funcs[fi].nparams;
                    tail_ok = self->sym->funcs[fi].variadic && got > want;
                    if (!tail_ok && self->arity_check(id_line, id_col, self->arena->nodes[n].text2,
                                                      got, want) != 0)
                        return -1;
                }
                /* 19.2: the argument types against the same signature, before
                   the boxing pass rewrites interface arguments (an interface
                   formal is skipped here, boxing owns it). */
                if (fi >= 0
                    && self->argtype_check(id_line, id_col, self->arena->nodes[n].text2,
                                           args, fi, -1, -1) != 0)
                    return -1;
                /* the emitted call must spell the definition's C name */
                if (fi >= 0)
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->sym->funcs[fi].cname);
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < self->sym->funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        int ip = 0;
                        if (self->sup->iface_ref_type(self->sym->funcs[fi].ptype[k], tr, sizeof tr, &ip)) {
                            int boxed = self->sup->maybe_box(cur, tr, ip);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else self->arena->nodes[prev].next = boxed;
                                self->arena->nodes[boxed].next = self->arena->nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                self->arena->nodes[n].kind = N_CALL;
                self->arena->nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->sym->find_var(self->arena->nodes[n].text2) >= 0) {
                /* a declared variable: a namespaced global is emitted under its
                   mangled C name, which is kept on the node for the emitter; a
                   bare name may not pick between two imported exports */
                char cn[MAX_TEXT];
                const char *nm = self->arena->nodes[n].text2;
                if (self->sym->var_ambiguous(nm)) {
                    char amsg[512];
                    snprintf(amsg, sizeof amsg,
                             "variable '%s' is exported by more than one namespace; use a qualified name", nm);
                    return self->sup->fail(amsg);
                }
                if (self->sym->var_cname(nm, cn, sizeof cn) == 0 && strcmp(cn, nm) != 0)
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cn);
            } else {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps, vf;
                const char *nm = self->arena->nodes[n].text2;
                /* SH-66: a template generates no C symbol of its own, so a
                   bare template name is never a value -- only `name<type>`
                   names an instance. Without this `int (*p)(int) = id;` exited
                   0 and emitted `= id;`, which only `cc` rejected. The guard
                   sits before the ALL_CAPS fallback so an upper-case template
                   name cannot slip through as a macro either. */
                {
                    int gt = self->sym->find_func(nm);
                    if (gt >= 0 && self->sym->funcs[gt].ntparams == 1) {
                        char tmsg[MAX_TEXT + 64];
                        snprintf(tmsg, sizeof tmsg,
                                 "generic function '%s' needs a type argument", nm);
                        return self->sup->fail(tmsg);
                    }
                }
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                /* a bare function name is a value (`p = handler;`): emit the
                   C spelling the definition was given */
                vf = self->sym->resolve_func(nm);
                if (vf >= 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->sym->funcs[vf].cname);
                    return n;
                }
                /* A name this unit never declared: while a function-pointer
                   value is expected it may come from a C header (`p = strcmp;`),
                   so it is emitted verbatim and the C compiler is the judge.
                   Anywhere else it is a typo, which is reported here. */
                if (self->fnval_ok) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                return self->sup->fail("use of an undeclared variable");
            }
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            int save_assign;
            self->sup->lex_next();
            save_assign = self->assign_ok;
            self->assign_ok = 1;
            n = self->parse_expr();
            if (n < 0) return -1;
            /* A parenthesised comma list is a value (`x = (a, b);`,
               `f((a, b))`): both operands evaluate, the value is the last one.
               The node is the one the statement form builds; each operand is a
               full expression, so an assignment may appear on either side. */
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                int r, w;
                self->sup->lex_next();
                r = self->parse_expr();
                if (r < 0) return -1;
                w = self->sup->new_node(N_BIN);
                if (w < 0) return -1;
                self->arena->nodes[w].a = n;
                self->arena->nodes[w].b = r;
                self->arena->nodes[w].aux = B_COMMA;
                n = w;
            }
            self->assign_ok = save_assign;
            if (self->sup->expect(")") != 0) return -1;
            return n;
        }
        /* Phase 30 S4: a leading `.name` inside an `into` block is the
           receiver's field or method. Return the receiver marker without
           consuming the dot: `parse_postfix` then handles the rest with the
           normal member/method resolution (including trait dispatch and the
           type-host static maps), and the `N_INTO_SELF` marker's static type
           makes that resolution see the receiver's type. */
        if (self->into_node >= 0 && self->lex->tok == T_PUNCT
            && strcmp(self->lex->toktext, ".") == 0) {
            int owner, base;
            owner = self->into_node;
            base = self->sup->new_node(N_INTO_SELF);
            if (base < 0) return -1;
            self->arena->nodes[base].num = owner;
            self->arena->nodes[base].aux = 1;   /* pointer form for `.name` */
            snprintf(self->arena->nodes[base].text, MAX_TEXT, "%s",
                     self->arena->nodes[owner].text);
            return base;
        }
        return self->sup->fail("expected an expression");
    }

    /* Consume the rest of a `Qual::name` path -- the cursor sits on its first
       '::'. Writes the last segment into `name`, the namespace path in
       underscore form (`a_b`, no trailing separator) into `qpath`, and, when the
       path is followed by `(`, the callee's C spelling into `cname`. The
       qualifier is a namespace path (`runtime::arena`) or a type name (`Arena`),
       whose mangled spelling carries the namespace it belongs to. A path that is
       not followed by `(` names a variable, which the caller resolves.

       `form` tells the caller which of those the path turned out to be:
       0 = a qualified variable (resolve with `find_qualified_global`),
       1 = a qualified call (`cname` holds the callee),
       2 = a namespace-host interface value (`Trait::ns`, SH-20): `name` holds
           the trait's C name, `cname` the host's underscore prefix and `qpath`
           the host's source path, for the emitter's diagnostics. */
    int parse_qual_path(char *name, int ncap, char *cname, int ccap,
                        char *qpath, int qcap, int *form)
    {
        char seg[8][MAX_TEXT];
        char cand[MAX_TEXT];
        char tn[MAX_TEXT];
        char hp[MAX_TEXT];
        int nseg, fi, i, w, is_call;
        size_t us;
        (void)self;

        *form = 0;
        snprintf(seg[0], MAX_TEXT, "%s", name);
        nseg = 1;
        for (;;) {
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "::") != 0)
                return self->sup->fail("expected '::'");
            self->sup->lex_next();
            if (self->lex->tok != T_ID) return self->sup->fail("expected a name after '::'");
            if (nseg >= 8) return self->sup->fail("qualified name is too long");
            snprintf(seg[nseg], MAX_TEXT, "%s", self->lex->toktext);
            nseg++;
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "::") != 0) break;
        }
        /* the qualifier: every segment but the last, joined with '_' */
        w = 0;
        qpath[0] = 0;
        for (i = 0; i < nseg - 1; i++) {
            if (i > 0) {
                if (w + 1 >= qcap) return self->sup->fail("qualified name is too long");
                qpath[w] = '_';
                w++;
                qpath[w] = 0;
            }
            if (w + (int)strlen(seg[i]) >= qcap)
                return self->sup->fail("qualified name is too long");
            snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
            w += (int)strlen(seg[i]);
        }
        snprintf(name, (size_t)ncap, "%s", seg[nseg - 1]);
        is_call = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0);
        /* A static trait from a `.m.ct` unit: `host::Trait.method(...)`. The
           qualified C spelling names the trait; the source host path is what
           the emitter matches the map against. A static trait has no iface, so
           only a `.` here is legal. */
        if (!is_call && nseg >= 2 && self->lex->tok == T_PUNCT
            && strcmp(self->lex->toktext, ".") == 0) {
            char tq[MAX_TEXT];
            int st = -1;
            if (snprintf(tq, sizeof tq, "%s_%s", qpath, seg[nseg - 1]) < (int)sizeof tq)
                st = self->sym->find_trait(tq);
            if (st >= 0 && self->sym->traits[st].is_static) {
                int hw = 0;
                qpath[0] = 0;
                for (i = 0; i < nseg - 1; i++) {
                    if (i > 0) {
                        if (hw + 2 >= qcap) return self->sup->fail("qualified name is too long");
                        qpath[hw] = ':';
                        qpath[hw + 1] = ':';
                        hw += 2;
                        qpath[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= qcap)
                        return self->sup->fail("qualified name is too long");
                    snprintf(qpath + hw, (size_t)(qcap - hw), "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                snprintf(name, (size_t)ncap, "%s", self->sym->traits[st].name);
                *form = 3;
                return 0;
            }
        }
        if (is_call) {
            if (snprintf(cand, sizeof cand, "%s_%s", qpath, seg[nseg - 1]) >= (int)sizeof cand)
                return self->sup->fail("qualified name is too long");
            fi = self->sym->find_func(cand);
            if (fi < 0 && nseg == 2) {
                /* a lone segment may be a type: its C name is `<prefix><Type>`, so
                   the namespace prefix is everything up to its last '_' */
                if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0) {
                    us = strlen(tn);
                    while (us > 0 && tn[us - 1] != '_') us--;
                    tn[us] = 0;
                    if (snprintf(cand, sizeof cand, "%s%s", tn, seg[1]) < (int)sizeof cand)
                        fi = self->sym->find_func(cand);
                }
            }
            if (fi < 0) {
                /* P20-01: `Trait::method(recv, ...)` names a static trait
                   explicitly, so two packages may bind the same method to one
                   host type and the caller picks one. The qualifier is joined
                   the way symbol names are (`a::ALen` -> `a_ALen`); the last
                   segment must be a method of that trait, so a namespace
                   function of a similar name is not hijacked. */
                char tq[MAX_TEXT];
                int st = -1;
                if (nseg == 2) {
                    if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0)
                        st = self->sym->find_trait(tn);
                    if (st < 0) st = self->sym->find_trait(seg[0]);
                } else if (snprintf(tq, sizeof tq, "%s", qpath) < (int)sizeof tq) {
                    st = self->sym->find_trait(tq);
                }
                if (st >= 0 && self->sym->traits[st].is_static) {
                    int mi2, okm = 0;
                    for (mi2 = 0; mi2 < self->sym->traits[st].nm; mi2++)
                        if (strcmp(self->sym->traits[st].m[mi2].name, seg[nseg - 1]) == 0)
                            okm = 1;
                    if (okm) {
                        int hw2 = 0;
                        qpath[0] = 0;
                        for (i = 0; i < nseg - 1; i++) {
                            if (i > 0) {
                                if (hw2 + 2 >= qcap)
                                    return self->sup->fail("qualified name is too long");
                                qpath[hw2] = ':';
                                qpath[hw2 + 1] = ':';
                                hw2 += 2;
                                qpath[hw2] = 0;
                            }
                            if (hw2 + (int)strlen(seg[i]) >= qcap)
                                return self->sup->fail("qualified name is too long");
                            snprintf(qpath + hw2, (size_t)(qcap - hw2), "%s", seg[i]);
                            hw2 += (int)strlen(seg[i]);
                        }
                        snprintf(name, (size_t)ncap, "%s", self->sym->traits[st].name);
                        snprintf(cname, (size_t)ccap, "%s", seg[nseg - 1]);
                        *form = 5;
                        return 0;
                    }
                }
                /* A static namespace-host map may be called without its trait
                   segment: `std::io::puts(...)` names the host by namespace and
                   the method directly. The recipe is the same one
                   `std::io::Io.puts(...)` expands, so the emitter needs no new
                   form; only an ambiguous method name is rejected. */
                char host[MAX_TEXT];
                char only[2][MAX_TEXT];
                int hw = 0, mp, bi, hits = 0;
                host[0] = 0;
                for (i = 0; i < nseg - 1; i++) {
                    if (i > 0) {
                        if (hw + 2 >= (int)sizeof host)
                            return self->sup->fail("qualified name is too long");
                        host[hw] = ':';
                        host[hw + 1] = ':';
                        hw += 2;
                        host[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= (int)sizeof host)
                        return self->sup->fail("qualified name is too long");
                    snprintf(host + hw, sizeof host - (size_t)hw, "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                for (mp = 0; mp < *self->nmaps; mp++) {
                    if (!self->maps[mp].is_static || !self->maps[mp].ns_host)
                        continue;
                    if (strcmp(self->maps[mp].inst, host) != 0) continue;
                    for (bi = 0; bi < self->maps[mp].nb; bi++) {
                        if (strcmp(self->maps[mp].b[bi].method, seg[nseg - 1]) != 0) continue;
                        if (hits < 2)
                            snprintf(only[hits], MAX_TEXT, "%s", self->maps[mp].trait);
                        hits++;
                    }
                }
                if (hits > 1) {
                    char m[MAX_TEXT * 2];
                    snprintf(m, sizeof m, "'%s' is ambiguous on '%s': bound by %s and %s",
                             seg[nseg - 1], host, only[0], only[1]);
                    return self->sup->fail(m);
                }
                if (hits == 1) {
                    snprintf(name, (size_t)ncap, "%s", only[0]);
                    snprintf(cname, (size_t)ccap, "%s", seg[nseg - 1]);
                    snprintf(qpath, (size_t)qcap, "%s", host);
                    *form = 4;
                    return 0;
                }
                return self->sup->fail("no function of that name in that namespace");
            }
            snprintf(cname, (size_t)ccap, "%s", self->sym->funcs[fi].cname);
            *form = 1;
            return 0;
        }
        /* SH-20: `Trait::ns` names a namespace host, not a variable. Only a
           trait qualifier takes this form; a struct or typedef stays a
           (rejected) qualified variable. */
        if (nseg >= 2 && self->sym->resolve_type(seg[0], tn, sizeof tn) == 0
            && self->sym->find_trait(tn) >= 0) {
            /* A static trait has no iface to box, so `Trait::host` is always the
               wrong shape; name the form that works at the site. */
            int st = self->sym->find_trait(tn);
            if (st >= 0 && self->sym->traits[st].is_static) {
                char host[MAX_TEXT];
                char m[MAX_TEXT * 2];
                int hw = 0;
                host[0] = 0;
                for (i = 1; i < nseg; i++) {
                    if (i > 1 && hw + 2 < (int)sizeof host) {
                        host[hw] = ':';
                        host[hw + 1] = ':';
                        hw += 2;
                        host[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= (int)sizeof host)
                        return self->sup->fail("qualified name is too long");
                    snprintf(host + hw, sizeof host - (size_t)hw, "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                snprintf(m, sizeof m,
                         "a static trait has no interface value; call '%s::%s.<method>()'",
                         host, seg[0]);
                return self->sup->fail(m);
            }
            /* the host in underscore form, then the symbol prefix spelled the
               way `map` spells it: a trait that already carries the namespace
               keeps its own name (SH-20 §4) */
            w = 0;
            hp[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 1 >= (int)sizeof hp)
                        return self->sup->fail("qualified name is too long");
                    hp[w] = '_';
                    w++;
                    hp[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= (int)sizeof hp)
                    return self->sup->fail("qualified name is too long");
                snprintf(hp + w, sizeof hp - (size_t)w, "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            if (strncmp(tn, hp, strlen(hp)) == 0 && tn[strlen(hp)] == '_')
                snprintf(cname, (size_t)ccap, "%s", tn);
            else if (snprintf(cname, (size_t)ccap, "%s_%s", hp, tn) >= ccap)
                return self->sup->fail("qualified name is too long");
            /* and the host in source form, for the emitter's diagnostic */
            w = 0;
            qpath[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 2 >= qcap) return self->sup->fail("qualified name is too long");
                    qpath[w] = ':';
                    qpath[w + 1] = ':';
                    w += 2;
                    qpath[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= qcap)
                    return self->sup->fail("qualified name is too long");
                snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            snprintf(name, (size_t)ncap, "%s", tn);
            *form = 2;
            return 0;
        }
        return 0;
    }

    int parse_args(void)
    {
        int first, tail, e, base, k;
        (void)self;

        if (self->sup->expect("(") != 0) return -1;
        base = self->narg_pos;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->sup->lex_next();
            self->arg_base = base;
            return 0;
        }
        first = -1;
        tail = -1;
        k = 0;
        for (;;) {
            int aline = self->lex->tokline;
            int acol = self->lex->tokstart - self->lex->lstart + 1;
            /* the frame grows before the argument is parsed, so a nested
               call appends after this slot instead of over the earlier ones */
            self->narg_pos = base + k;
            e = self->parse_expr();
            if (e < 0) return -1;
            if (base + k < MAX_ARG_POS) {
                self->arg_line[base + k] = aline;
                self->arg_col[base + k] = acol;
            }
            k++;
            if (tail < 0) first = e;
            else self->arena->nodes[tail].next = e;
            tail = e;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->sup->expect(")") != 0) return -1;
        self->arg_base = base;
        self->narg_pos = base;   /* pop: siblings reuse the same slots */
        return first;
    }

    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!self->cur_func[0]) return 0;
        if (*self->ncalls >= MAX_CALLS) return self->sup->fail("too many calls");
        snprintf(self->calls[*self->ncalls].caller, MAX_TEXT, "%s", self->cur_func);
        snprintf(self->calls[*self->ncalls].callee, MAX_TEXT, "%s", callee);
        self->calls[*self->ncalls].line = line;
        (*self->ncalls)++;
        return 0;
    }
}

impl ExprTraitInst for Expr {
    /* Phase 35 S3a: one trait instance in a type position. Source-canonical
       arguments identify the row; their C spellings substitute the method
       signatures. Symbolic arguments belong to the later generic-impl slice. */
    int parse_trait_inst_type(char *out, int cap)
    {
        char tname[MAX_TEXT];
        char carg[2][MAX_TEXT];
        char ctype[2][MAX_TEXT];
        char canon[MAX_TEXT];
        char abuf[MAX_TEXT];
        char tail[MAX_TEXT];
        char symbolic[MAX_TEXT];
        char iface[MAX_TEXT];
        char msg[MAX_TEXT * 2];
        size_t base_len;
        int n, sti, ni, nargs;

        n = (int)strlen(out);
        if (self->sup->resolve_type(self->lex->toktext, tname, sizeof tname) != 0) return -1;
        sti = self->sym->find_trait(tname);
        if (sti < 0 || self->sym->traits[sti].ntparams == 0)
            return self->sup->fail("internal: generic trait row vanished");
        self->sup->lex_next();
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "<") != 0) {
            snprintf(msg, sizeof msg,
                     "generic trait '%s' needs type arguments in a type position", tname);
            return self->sup->fail(msg);
        }
        self->sup->lex_next();
        nargs = 0;
        for (;;) {
            if (nargs >= 2)
                return self->sup->fail("a generic trait takes at most 2 type arguments");
            self->inst_canon[0] = 0;
            self->type_depth++;
            if (self->type_depth > 4) {
                self->type_depth--;
                return self->sup->fail("generic type arguments nest deeper than 4");
            }
            if (self->parse_type(abuf, sizeof abuf) != 0) {
                self->type_depth--;
                return -1;
            }
            self->type_depth--;
            if (!abuf[0] || strcmp(abuf, "void") == 0 || strchr(abuf, '[')
                || strchr(abuf, '(') || strchr(abuf, ')')
                || strncmp(abuf, "const ", 6) == 0
                || strncmp(abuf, "volatile ", 9) == 0) {
                snprintf(msg, sizeof msg,
                         "type argument '%s' cannot instantiate a generic trait", abuf);
                return self->sup->fail(msg);
            }
            if (self->in_generic_tparam[0]) {
                if (frontend::sym::ct_generic_subst(abuf, self->in_generic_tparam, "",
                                                    symbolic, sizeof symbolic) != 0)
                    return self->sup->fail("type is too long");
                if (strcmp(symbolic, abuf) != 0)
                    return self->sup->fail("symbolic trait type arguments are not supported yet");
            }
            if (self->in_generic_tparam2[0]) {
                if (frontend::sym::ct_generic_subst(abuf, self->in_generic_tparam2, "",
                                                    symbolic, sizeof symbolic) != 0)
                    return self->sup->fail("type is too long");
                if (strcmp(symbolic, abuf) != 0)
                    return self->sup->fail("symbolic trait type arguments are not supported yet");
            }
            snprintf(ctype[nargs], MAX_TEXT, "%s", abuf);
            tail[0] = 0;
            if (self->inst_canon[0]) {
                /* Keep `Vec<int>` rather than its C tag; a pointer suffix still
                   belongs to the argument's canonical spelling. */
                base_len = strlen(self->last_bare_tag);
                if (base_len > 0 && strncmp(abuf, self->last_bare_tag, base_len) == 0
                    && frontend::sym::ct_type_canon(abuf + base_len, tail, sizeof tail) != 0)
                    return self->sup->fail("type is too long");
                if (snprintf(carg[nargs], MAX_TEXT, "%s%s", self->inst_canon, tail) >= MAX_TEXT)
                    return self->sup->fail("type is too long");
            } else if (frontend::sym::ct_type_canon(abuf, carg[nargs], MAX_TEXT) != 0) {
                return self->sup->fail("type is too long");
            }
            nargs++;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ">>") == 0) {
            snprintf(self->lex->toktext, MAX_TEXT, "%s", ">");
            self->lex->pos = self->lex->pos - 1;
            self->lex->tokstart = self->lex->tokstart + 1;
        }
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, ">") != 0)
            return self->sup->fail("expected '>' after the type arguments");
        self->sup->lex_next();
        ni = self->sym->trait_inst(tname, nargs, carg[0], carg[1],
                                   ctype[0], ctype[1], self->cur_unit);
        if (ni < 0) return self->sup->fail(self->sym->last_error());
        if (nargs == 1) {
            if (snprintf(canon, sizeof canon, "%s<%s>", tname, carg[0]) >= (int)sizeof canon)
                return self->sup->fail("type is too long");
        } else if (snprintf(canon, sizeof canon, "%s<%s,%s>", tname, carg[0], carg[1])
                   >= (int)sizeof canon) {
            return self->sup->fail("type is too long");
        }
        if (snprintf(iface, sizeof iface, "%s_iface", self->sym->traits[ni].name)
            >= (int)sizeof iface)
            return self->sup->fail("type name is too long");
        snprintf(self->inst_canon, sizeof self->inst_canon, "%s", canon);
        snprintf(self->last_bare_tag, sizeof self->last_bare_tag, "struct %s", iface);
        self->saw_trait = 1;
        if (self->type_append(out, cap, &n, "struct") != 0) return -1;
        if (self->type_append(out, cap, &n, iface) != 0) return -1;
        return 0;
    }
}

impl ExprTypes for Expr {
    /* Phase 32 S1: the type the optional `--types` pass judges. The core covers
       the shapes `static_ctype` already pins -- a variable, a member / arrow
       field, a deref, an address, a call and one subscript -- and reports
       "undecidable" for everything else, so a shape the tables cannot resolve
       is skipped rather than guessed (D32-4). A value that still carries array
       dimensions is not a value type either: array actuals decay in C, and the
       skip list owns that case. */
    int chk_type(int n, char *out, int cap, int *is_zero)
    {
        int ad;

        if (is_zero) *is_zero = 0;
        if (n < 0 || !out || cap < 2) return -1;
        out[0] = 0;
        switch (self->arena->nodes[n].kind) {
        case N_NUM:
            /* D32-5: every arithmetic spelling is one class, so the literal
               stays `int` whatever its suffix. `is_zero` is the null pointer
               constant flag the caller hands to `chk_assignable`. */
            if (is_zero) *is_zero = (self->arena->nodes[n].num == 0);
            snprintf(out, (size_t)cap, "%s", "int");
            return 0;
        case N_FNUM:
            snprintf(out, (size_t)cap, "%s", "double");
            return 0;
        case N_STR:
            /* a string literal is `char *` in a value context; a character
               literal stays the arithmetic class (`int`) */
            snprintf(out, (size_t)cap, "%s",
                     self->arena->str_at((int)self->arena->nodes[n].num)[0] == '\''
                     ? "int" : "char *");
            return 0;
        case N_VAR:
        case N_MEMBER:
        case N_ARROW:
        case N_DEREF:
        case N_ADDR:
        case N_INDEX:
        case N_CALL:
        case N_MCALL:
            break;
        default:
            return -1;                 /* S2 adds the literal and wrapper shapes */
        }
        if (!self->static_ctype(n, out, cap, &ad, 0)) return -1;
        if (ad != 0) return -1;
        return 0;
    }

    /* Phase 32 S3: one formal against one actual through the same kernel
       `argtype_mismatch` uses (D32-2). Every skip below is a deliberate
       false negative: an interface slot boxes on its own path, a null
       pointer constant fills any pointer slot (B32-6), and two pointers are
       never compared beyond the fact that both are pointers (D32-6/T32-1).
       The base-type and depth guard has to run before `r == 1`, or a single
       sided pointer such as `int x = "s"` would be skipped (B32-8). */
    int chk_assignable(const char *formal, const char *actual, int is_zero, int diag)
    {
        char fb[MAX_TEXT], ab[MAX_TEXT], tr[MAX_TEXT];
        char msg[2 * MAX_TEXT + 64];
        const char *label;
        int r;

        if (!formal || !formal[0] || !actual || !actual[0]) return 0;
        if (self->sup->is_iface_type(formal, tr, sizeof tr)) return 0;
        if (is_zero && strchr(formal, '*')) return 0;
        r = arg_class(formal, actual, fb, sizeof fb, ab, sizeof ab);
        if (r == -1) return 0;
        if (strchr(formal, '*') && strchr(actual, '*')) return 0;
        if (r == 2) {
            /* different struct spellings; the same row passes like `r == 0` */
            int fs = self->sym->find_struct(fb + 6);
            int as = self->sym->find_struct(ab + 6);
            if (fs < 0 || as < 0 || fs == as) return 0;
        } else if (r != 1) {
            return 0;
        }
        if (diag == 6) {
            snprintf(msg, sizeof msg, "argument %d: expected '%s', got '%s'",
                     self->chk_arg, formal, actual);
        } else {
            label = diag == 2 ? "assignment" : (diag == 3 ? "return" : "initializer");
            snprintf(msg, sizeof msg, "%s: expected '%s', got '%s'",
                     label, formal, actual);
        }
        return tool::diag::ct_type_warn(self->chk_line, self->chk_col, "", msg,
                                        self->sup->mem->path);
    }

    /* Phase 32 S7: bind, substitute, judge. The impl block is found the same
       way `inst_inherent_method` finds the method, but here the block index
       is needed because `ct_method_bind` reads its type parameters. */
    int chk_mcall_args(const char *ibase, const char *fname, int args)
    {
        char base[MAX_TEXT], n1[MAX_TEXT], v1[MAX_TEXT], n2[MAX_TEXT], v2[MAX_TEXT];
        char fty[MAX_TEXT], out[MAX_TEXT];
        int ii, nimpls, inst, m, found, foundm, ai, k;
        struct StructImpl *im;

        if (strncmp(ibase, "struct ", 7) != 0) return 0;
        snprintf(base, sizeof base, "%s", ibase + 7);
        inst = frontend::sym::ct_inst_find(base);
        if (inst < 0) return 0;
        im = frontend::sym::ct_impls(&nimpls);
        found = -1;
        foundm = -1;
        for (ii = 0; im && ii < nimpls && found < 0; ii++) {
            if (im[ii].use[0]) continue;
            if (!frontend::sym::ct_impl_matches(ii, inst)) continue;
            for (m = self->arena->nodes[im[ii].node].a; m >= 0;
                 m = self->arena->nodes[m].next)
                if (strcmp(self->arena->nodes[m].text2, fname) == 0) {
                    found = ii;
                    foundm = m;
                    break;
                }
        }
        if (found < 0) return 0;
        if (frontend::sym::ct_method_bind(found, inst, n1, v1, n2, v2,
                                          MAX_TEXT) < 0)
            return 0;
        ai = args;
        k = 0;
        {
            int pi = self->arena->nodes[foundm].a;
            while (pi >= 0 && ai > 0) {
                int is_zero = 0;
                if (subst_tparam(self->arena->nodes[pi].text, n1, v1, n2, v2,
                                 fty, sizeof fty) == 0
                    && self->chk_type(ai, out, sizeof out, &is_zero) == 0) {
                    if (self->arg_base + k < MAX_ARG_POS) {
                        self->chk_line = self->arg_line[self->arg_base + k];
                        self->chk_col = self->arg_col[self->arg_base + k];
                    }
                    self->chk_arg = k + 1;
                    if (self->chk_assignable(fty, out, is_zero, 6) != 0) return -1;
                }
                ai = self->arena->nodes[ai].next;
                pi = self->arena->nodes[pi].next;
                k++;
            }
        }
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Expr g_expr;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls, void *maps, void *nmaps);
void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls, void *maps, void *nmaps)
{
    g_expr.arena = (struct Arena *)arena;
    g_expr.lex = (struct Lexer *)lex;
    g_expr.sym = (struct Symbols *)sym;
    g_expr.sup = (struct ParseSupport *)sup;
    g_expr.cur_func = (char *)cur_func;
    g_expr.calls = (struct Call *)calls;
    g_expr.ncalls = (int *)ncalls;
    g_expr.maps = (struct MapTable *)maps;
    g_expr.nmaps = (int *)nmaps;
    g_expr.postfix_seed = -1;
    g_expr.into_node = -1;
}

pub struct Expr *expr_get(void);
struct Expr *expr_get(void)
{
    return &g_expr;
}

/* Phase 31 S23a: the borrowed-view provenance of an expression root. A chain
   of fields / derefs is followed to the value underneath, because a view of a
   view is still borrowed. */
int expr_borrow_root(struct Expr *self, int n)
{
    while (n >= 0) {
        int k = self->arena->nodes[n].kind;
        if (k == N_MEMBER || k == N_ARROW || k == N_DEREF) {
            n = self->arena->nodes[n].a;
            continue;
        }
        if (k == N_VAR) {
            int vi = self->sym->find_var(self->arena->nodes[n].text2);
            return vi >= 0 && self->sym->vars[vi].cview;
        }
        if (k == N_MCALL
            && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
            && (strcmp(self->arena->nodes[n].text2, "get") == 0
                || strcmp(self->arena->nodes[n].text2, "entry") == 0)) {
            const char *ty = self->arena->nodes[n].text;
            if (strncmp(ty, "struct Vec_", 11) == 0
                || strncmp(ty, "Vec_", 4) == 0
                || strncmp(ty, "struct Map_", 11) == 0
                || strncmp(ty, "Map_", 4) == 0)
                return 1;
        }
        return 0;
    }
    return 0;
}
