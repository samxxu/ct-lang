import frontend::parse::ExprStaticType;

#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
/* The call graph is one table for the whole build (build mode parses every
   unit into it). PH-65/PH-66 added detection paths of their own, and the 1024
   budget started failing on ct-ast's own source; 2048 keeps the growth room.
   The table is `MAX_CALLS * sizeof(struct Call)`, so this costs ~320 KiB in
   BSS, not a product change. */
/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_CALLS 8192
#define MAX_CALLS_MAX 65536
/* Mirror of Symbols.h.ct's whole-program budget; macros do not cross units. */
#define MAX_FUNCS 512
#define MAX_FUNCS_MAX 65536
/* Phase 32 S7: the argument start positions of the call being parsed. The
   array is a stack: a nested call appends after its parent's frame.
   S1a-0 C1: MAX_ARG_POS is the starting capacity, MAX_ARG_POS_MAX the valve. */
#define MAX_ARG_POS 32
#define MAX_ARG_POS_MAX 65536
#define MAX_GENERIC_INSTS 64
#define MAX_TEXT 160
/* S1a-0 C2o: one formal text bound (mirror of frontend/sym/Limits.h.ct). */
#define TEXT_LIMIT 65536
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
/* Phase 30: the receiver-context block and the `$` / `.name` references
   inside it. `N_INTO` keeps the receiver in `a`, the block's first statement
   in `b`, the value category in `aux` and the receiver's static type in
   `text`; the emitter names the promoted variable in `text3`. */
#define N_MATSEQ 73
/* PH-81 S1b: `new T { ... }` -- a `Box<T>` construction. `text` is the
   payload C type, `text2` the Box instance name, `text3` the Box C type and
   `a` the captured brace initialiser (N_RAW). */
#define N_NEWOBJ 77
#define N_INTO 63
#define N_INTO_SELF 64
/* Phase 44: the postfix `?` error-propagation node. `a` is the operand (a
   `Result<T, E>` value); the `?` position is kept in `line` / `num` for the
   diagnostics. */
#define N_TRY 71
/* Phase 84: `Shape.Circle(args)` builds one ADT variant. `text` is the C struct
   tag, `text2` the variant's union member, `text3` the source variant name,
   `num` the variant index and `a` the argument chain. The emit is a compound
   literal (no helper function, so no unused-static warning). */
#define N_ADTCTOR 81
/* P-7.2 (S3 slice prototype): `s[i]` (checked place), `s.get(i)` (soft
   access) and `a[lo..hi]` / `a[lo..]` (subslice construction). All three keep
   the element spelling in `text`; the C storage of a slice is the erased
   `struct __ct_slice`, so the element type only exists here and in the
   emitted cast. `aux` on N_SLICE_INDEX / N_SLICE_GET is the `const` flag;
   on N_SLICE_RANGE it is 1 for an array base and 2 for a slice base. */
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
/* Phase 53: the optional-chain node. `a` is the receiver, `aux` selects field
   (1), pointer subscript (2) or map-pointer subscript (3); `text` is the
   field / map-instance name, `text2` the result type, `text3` the emitter
   temporary, `text4` the receiver type. */
#define N_OPT 72
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3

namespace frontend::parse;

/* S1a-0 C3: the current template's type parameters are a row block, not a
   fixed pair. These two predicates replace the old `T`/`U` comparisons; every
   parser site that used to test one or two spellings now walks the whole list. */
/* Phase 31 S23a: 1 when `n` is a borrowed container view -- `get` / `entry` on
   a `Vec` / `Map`, a field or deref of one, or a local carrying the provenance
   bit. An owning value (`from`, `{}`, `retain`, `pop`, a call result) answers 0.
   The statement layer records the same bit on a declaration / assignment, so
   the walk is a unit-level function instead of one more `ExprOps` method. */
pub int expr_borrow_root(struct Expr *self, int n);
/* Phase 31 S23b: record that `name` is bound from the borrowed expression
   `init` (L31-23 invalidation), and track the enclosing `foreach` variable
   (L31-22). The statement layer drives both. */
pub void expr_view_bind(struct Expr *self, const char *name, int init);
pub void expr_iter_push(struct Expr *self, const char *name);
pub void expr_iter_pop(struct Expr *self);

/* Argument count of a call: `parse_args` hands back the first node of the
   chain, or 0 for an empty list, and a fresh node carries `next = -1`. */
/* P-7.2: does the subscript the cursor sits on (`[`) carry a top-level `..`
   before its closing `]`? The scan is textual, so the caller does not have to
   parse an expression and then rewind the arena. Strings, character literals
   and comments are skipped; nested brackets only close their own depth. */

/* Phase 24: is `n` the range index `$`? It is the only `N_VAR` whose `text2` is
   the placeholder, and it is built only inside a range initialiser's element
   expression. `&$`, `$++` and `++$` are rejected through this predicate: `$` is
   not a variable, so none of them has an object to name. */
/* ---- 19.2 coarse argument types ------------------------------------------
   The helpers below are pure string work: they classify a type spelling
   without touching the symbol tables, so the caller decides what stays
   unknown. Coarse on purpose -- numerics convert freely (the usual C
   conversions), either side of a pointer may be `void`, and a struct tag
   only counts when the caller can resolve it in this unit's own table. */












/* Does the `(` at the cursor open a closure literal? The token stream cannot be
   rewound, so the answer comes from the raw source: scan to the matching `)`
   (skipping strings, chars and comments) and look for `=>`. A parenthesised
   expression is left untouched; the classifier never consumes anything. */
static int closure_ahead(struct Expr *self)
{
    const char *s = self->lex->src;
    int i = self->lex->tokstart;
    int depth = 0;

    if (s[i] != '(') return 0;
    for (; s[i]; i++) {
        char c = s[i];
        if (c == '"' || c == '\'') {
            char q = c;
            i++;
            while (s[i] && s[i] != q) {
                if (s[i] == '\\' && s[i + 1]) i++;
                i++;
            }
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '/') {
            while (s[i] && s[i] != '\n') i++;
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '*') {
            i += 2;
            while (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++;
            if (!s[i]) return 0;
            i++;
            continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            depth--;
            if (depth == 0) {
                i++;
                break;
            }
        }
    }
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') i++;
    return s[i] == '=' && s[i + 1] == '>';
}

/* Phase 21 S4: the same tier-1 hint the other closure errors carry, printed
   through the note channel so no counter, JSON document or exit code moves.
   R02: the recipe is self-contained -- `Callable` lives in ct-pkg and nothing
   in this repository defines it, so the hint cannot name it. It stays inside
   the 160-byte preprocessor token: a longer `#define` line is truncated when
   the compiler reads its own source. */
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

/* R09: a captured name or type that does not fit is a hard error. Truncating it
   would leave the environment field with a shorter type (or a name the emitter
   cannot match) and surface later as a `cc` failure with no source position. */
/* Collect the free names of a closure body. The parameter scope is still open,
   so a name at or after `pstart` is the literal's own parameter -- a parameter
   that shadows an outer variable keeps the outer one out of the capture set,
   which is exactly the snapshot the rule needs. Globals are not captures. */
/* Phase 21 R01: a local declaration inside the body may not shadow a captured
   name. The capture walk runs after the body's own scope has been popped, so a
   shadowed name resolves to the enclosing variable and enters the capture set;
   the emitter then rewrites every same-named N_VAR in the body to the env field
   and a read of the local silently returns the snapshot. Rejecting the shadow
   keeps the snapshot rule honest (design §4.2). A nested literal owns its own
   environment and runs its own check. */
/* A captured variable belongs to the enclosing frame; the closure may read it
   but must not write the binding or take its address (D21-2). Writes through a
   captured pointer (`p->x = 1`) are reads of the binding and stay legal. */
/* 19.1 call-site arity: only a callee whose signature is known is compared.
   A call through a function pointer, an undeclared C library name, a `map`
   recipe and a static type host all stay unknown and pass. The caller passes
   the expected count it already knows (a variadic function's named part), so
   this method only reports the mismatch; warning severity keeps `ct compile`
   exit codes and artifacts unchanged (D19-4), and `ct check` (19.4) raises the
   same record to an error. */

/* Compare a closure literal's parameter list with a hosting function-pointer
   type and take the literal's return type from that host (D21-14). `skip_env`
   drops the first host parameter: the formal of a `(fn, env)` pair spells the
   environment there. The parameter comparison reuses the same normalisation
   `arg_class` gives 19.3. A mismatch reports at the source position and
   returns non-zero; on success `c->ret` is set when `set_ret` is non-zero.
   R03: comparing a declared binding with a host tail must not write the return
   type, or the binding's own trampoline would silently take the host's type
   for every other call site. */
/* R03: a declared binding fills a `(fn, env)` pair, but unlike an inline
   literal its own trampoline already exists with the return type its
   declaration took, so the comparison is read-only (`set_ret` 0). */

/* Phase 78 S2a: a `ref`/`out` actual must be an assignable place. The
   whitelist is C's: variables, fields, `*p`, array/subscript elements. A
   Vec/Map subscript is sugar (`N_MCALL` with the `[` position in line/num);
   the emitter passes its `at()` pointer instead of taking an address of a
   value. Literals, calls, casts and arithmetic are not places. */
/* 1 = a Vec subscript sugar, 2 = a Map one, 0 = not a subscript. A Vec
   element is a value (`get`), so a ref/out actual is emitted through `at()`
   (a pointer). A Map element is already a `V *` in this language (`get`
   returns the element pointer), so the source spelling for a `ref V` place is
   `*m[k]`; a bare `m[k]` is a pointer value, not a place. */
static int container_sugar_kind(struct Expr *self, int n)
{
    if (n < 0) return 0;
    if (self->arena->nodes[n].kind != N_MCALL) return 0;
    if (self->arena->nodes[n].aux != 9 && self->arena->nodes[n].aux != 10) return 0;
    /* an explicit `v.get(i)` has no `[` position; only the sugar carries one */
    if (self->arena->nodes[n].line <= 0 || self->arena->nodes[n].num <= 0) return 0;
    if (strcmp(self->arena->nodes[n].text2, "get") != 0
        && strcmp(self->arena->nodes[n].text2, "at") != 0) return 0;
    if (strncmp(self->arena->nodes[n].text, "struct Vec_", 11) == 0
        || strncmp(self->arena->nodes[n].text, "Vec_", 4) == 0) return 1;
    if (strncmp(self->arena->nodes[n].text, "struct Map_", 11) == 0
        || strncmp(self->arena->nodes[n].text, "Map_", 4) == 0) return 2;
    return 0;
}


/* Phase 78 fix SH-95: the member's own record/field facts. Answers 1 when the
   field is known, 0 when the base type is opaque (leave it to C). A bit-field
   has no address; a top-level `const` field is not writable. */
static int ref_member_flags(struct Expr *self, int n, int *is_bit, int *is_const)
{
    char t[MAX_TEXT];
    char base[MAX_TEXT];
    size_t bl;
    int si, fi;

    *is_bit = 0;
    *is_const = 0;
    if (self->sup->expr_type(self->arena->nodes[n].a, t, sizeof t) != 0) return 0;
    bl = strlen(t);
    while (bl > 0 && (t[bl - 1] == ' ' || t[bl - 1] == '*')) t[--bl] = 0;
    while (bl > 0 && (t[bl - 1] == ' ' || t[bl - 1] == '\t')) t[--bl] = 0;
    if (strncmp(t, "struct ", 7) == 0) snprintf(base, sizeof base, "%s", t + 7);
    else if (strncmp(t, "union ", 6) == 0) snprintf(base, sizeof base, "%s", t + 6);
    else snprintf(base, sizeof base, "%s", t);
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
        if (strcmp(self->sym->structs[si].fields[fi].name,
                   self->arena->nodes[n].text2) == 0) {
            *is_bit = self->sym->structs[si].fields[fi].is_bitfield;
            *is_const = ref_type_is_const_value(self->sym->structs[si].fields[fi].type);
            return 1;
        }
    return 0;
}

/* The place is checked down to its base (SH-95). A member is a place only when
   its base is a place and the member is neither a bit-field nor a top-level
   `const`; a subscript is a place only when its base is a place (or the Vec/Map
   subscript sugar, whose own protocol answers the element pointer). A call
   result or any other rvalue therefore never gets through. */
static int ref_arg_place(struct Expr *self, int n)
{
    int k, vi, sk, bit, konst;

    if (n < 0) return 0;
    k = self->arena->nodes[n].kind;
    if (k == N_VAR) {
        vi = self->sym->find_var(self->arena->nodes[n].text2);
        if (vi >= 0) {
            if (self->sym->vars[vi].is_const) return 0;
            if (ref_type_is_const_value(self->sym->vars[vi].type)) return 0;
            return 1;
        }
        /* an unknown name may be a C library global; a known function is not a
           place */
        if (self->sym->find_func(self->arena->nodes[n].text2) >= 0) return 0;
        return 1;
    }
    if (k == N_MEMBER || k == N_ARROW) {
        sk = container_sugar_kind(self, self->arena->nodes[n].a);
        /* a Vec element is a value: `v[i].field` has no address. A Map element
           is a pointer, so `m[k]->field` is an lvalue and is allowed. */
        if (sk == 1) return 0;
        if (sk == 2) {
            if (k != N_ARROW) return 0;
        } else if (!ref_arg_place(self, self->arena->nodes[n].a)) {
            return 0;
        }
        if (ref_member_flags(self, n, &bit, &konst) && (bit || konst)) return 0;
        return 1;
    }
    if (k == N_DEREF) {
        int b = self->arena->nodes[n].a;
        /* `*m[k]` is the Map element place; the sugar itself answers a V *. */
        if (container_sugar_kind(self, b) == 2) return 1;
        return ref_arg_place(self, b);
    }
    if (k == N_INDEX) return ref_arg_place(self, self->arena->nodes[n].a);
    /* PH-79 fix SH-101: `s[i]` is a checked place (spec §4.69), so a slice
       element may be a `ref`/`out` actual exactly like a C array element: the
       element lives in the underlying array and `__ct_slice_at` keeps the
       run-time bounds check in the emitted C. A `const T[]` view stays
       read-only, so its element is not a writable place. */
    if (k == N_SLICE_INDEX) {
        if (self->arena->nodes[n].aux == 1) return 0;
        return ref_arg_place(self, self->arena->nodes[n].a);
    }
    if (k == N_MCALL) return container_sugar_kind(self, n) == 1;
    return 0;
}

/* Phase 78 S2a: owning types are the ones whose value carries a resource:
   `String` / `Str`, `Box<T>`, `Vec<T>`, `Map<K,V>` and any struct with a
   `use Drop`. A pointer to one is not owning, and neither is a plain scalar
   or struct. */
static int type_is_owning(struct Expr *self, const char *type)
{
    char base[MAX_TEXT];
    size_t bl, i;
    int si;

    if (!type || !type[0]) return 0;
    if (strcmp(type, "String") == 0 || strcmp(type, "Str") == 0) return 1;
    if (strncmp(type, "Box<", 4) == 0) return 1;
    if (strncmp(type, "Vec<", 4) == 0 || strncmp(type, "struct Vec_", 11) == 0
        || strncmp(type, "Vec_", 4) == 0) return 1;
    if (strncmp(type, "Map<", 4) == 0 || strncmp(type, "struct Map_", 11) == 0
        || strncmp(type, "Map_", 4) == 0) return 1;
    snprintf(base, sizeof base, "%s", type);
    bl = strlen(base);
    while (bl > 0 && base[bl - 1] == ' ') base[--bl] = 0;
    if (bl > 0 && base[bl - 1] == '*') return 0;   /* a pointer is not owning */
    if (strncmp(base, "struct ", 7) == 0) {
        for (i = 0; base[i + 7] != 0; i++) base[i] = base[i + 7];
        base[i] = 0;
    } else if (strncmp(base, "union ", 6) == 0) {
        for (i = 0; base[i + 6] != 0; i++) base[i] = base[i + 6];
        base[i] = 0;
    }
    si = self->sym->find_struct(base);
    return si >= 0 && self->sym->structs[si].uses_drop;
}

/* P-3.5 (SH-117): a by-value `String` / `Str` / `U16String` / `U16Str` handle
   is a 16-byte struct, never a C pointer. The C boundary's only exit is
   `cstr()` (or a byte-wise `.data[i]`), so a pointer target must not receive
   the handle: `char *p = s` used to be accepted and emit `char *p = s;`.
   Answers 1 and fills `base` with the handle's spelling when `e` is a
   by-value handle; a cast is the explicit escape hatch and is left alone. */
/* One actual against one parameter's annotation. 0 = accepted, -1 = a
   diagnostic was recorded. The caller supplies the source position through
   the actual node's line. */
static int check_refout_arg(struct Expr *self, int a, int ann, const char *ptype)
{
    int vi;

    if (ann != 2 && ann != 3) return 0;
    if (!ref_arg_place(self, a))
        return tool::diag::ct_sem_error(self->arena->nodes[a].line, 1,
            "ref/out argument must be an assignable place", self->sup->mem->path);
    if (ann == 3 && type_is_owning(self, ptype)
        && self->arena->nodes[a].kind == N_VAR) {
        vi = self->sym->find_var(self->arena->nodes[a].text2);
        if (vi < 0 || !self->sym->vars[vi].initialized)
            return tool::diag::ct_sem_error(self->arena->nodes[a].line, 1,
                "out owning argument must be initialized", self->sup->mem->path);
    }
    return 0;
}

/* Phase 31 S23b (L31-23): the container a borrowed initialiser came from.
   Answers its variable index in `*cvi`; 0 when `init` is not a view. */
static int view_source(struct Expr *self, int init, int *cvi)
{
    int n = init, j;

    while (n >= 0 && (self->arena->nodes[n].kind == N_MEMBER || self->arena->nodes[n].kind == N_ARROW || self->arena->nodes[n].kind == N_DEREF))
        n = self->arena->nodes[n].a;
    if (n < 0) return 0;
    if (self->arena->nodes[n].kind == N_MCALL
        && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
        && (strcmp(self->arena->nodes[n].text2, "get") == 0
            || strcmp(self->arena->nodes[n].text2, "entry") == 0)) {
        const char *ty = self->arena->nodes[n].text;
        if (!(strncmp(ty, "struct Vec_", 11) == 0 || strncmp(ty, "Vec_", 4) == 0
              || strncmp(ty, "struct Map_", 11) == 0 || strncmp(ty, "Map_", 4) == 0))
            return 0;
        n = self->arena->nodes[n].a;
        while (n >= 0 && (self->arena->nodes[n].kind == N_MEMBER || self->arena->nodes[n].kind == N_ARROW || self->arena->nodes[n].kind == N_DEREF))
            n = self->arena->nodes[n].a;
        if (n < 0 || self->arena->nodes[n].kind != N_VAR) return 0;
        *cvi = self->sym->find_var(self->arena->nodes[n].text2);
        return *cvi >= 0;
    }
    if (self->arena->nodes[n].kind == N_VAR) {
        int src = self->sym->find_var(self->arena->nodes[n].text2);
        for (j = 0; src >= 0 && j < self->nview; j++)
            if (self->view_vi[j] == src) {
                *cvi = self->view_cvi[j];
                return 1;
            }
    }
    return 0;
}

void expr_view_bind(struct Expr *self, const char *name, int init)
{
    int vi = self->sym->find_var(name);
    int idx = -1, i, cvi = -1, ok;

    if (vi < 0) return;
    for (i = 0; i < self->nview; i++)
        if (self->view_vi[i] == vi) { idx = i; break; }
    ok = view_source(self, init, &cvi);
    if (!ok) {
        if (idx >= 0) self->view_vi[idx] = -1;
        return;
    }
    if (idx < 0) {
        if (self->nview >= 64) return;
        idx = self->nview;
        self->nview = self->nview + 1;
    }
    self->view_vi[idx] = vi;
    self->view_cvi[idx] = cvi;
    self->view_bad[idx] = 0;
}

void expr_iter_push(struct Expr *self, const char *name)
{
    if (self->niter >= 8) return;
    snprintf(self->iter[self->niter], MAX_TEXT, "%s", name);
    self->niter = self->niter + 1;
}

void expr_iter_pop(struct Expr *self)
{
    if (self->niter > 0) self->niter = self->niter - 1;
}

/* L31-23: a mutation of `cont` invalidates every live view of it, and the next
   use of one is refused. */
static void view_mark(struct Expr *self, const char *cont)
{
    int cvi = self->sym->find_var(cont), j;

    if (cvi < 0) return;
    for (j = 0; j < self->nview; j++)
        if (self->view_vi[j] >= 0 && self->view_cvi[j] == cvi)
            self->view_bad[j] = 1;
}

static int view_use(struct Expr *self, const char *name, int line, int col)
{
    int vi = self->sym->find_var(name), j;

    if (vi < 0) return 0;
    for (j = 0; j < self->nview; j++)
        if (self->view_vi[j] == vi && self->view_bad[j])
            return tool::diag::ct_sem_error(line, col,
                "a borrowed view is invalidated by a later mutation of its container; copy it with retain() first",
                self->sup->mem->path);
    return 0;
}

static int iter_hit(struct Expr *self, const char *name)
{
    int i;

    for (i = 0; i < self->niter; i++)
        if (strcmp(self->iter[i], name) == 0) return 1;
    return 0;
}

/* PH-66 R1: remember a direct call by source name (deduplicated). Only a
   callee that appears here can pull an I/O header in; taking a function's
   address never reaches this path. A free function, not a method: ExprOps is
   at its method cap. */
static int record_io_call(struct Expr *e, const char *callee, int known, int line)
{
    int i;

    if (callee == 0 || callee[0] == 0) return 0;
    for (i = 0; i < e->nio; i++)
        if (strcmp(e->io_names[i], callee) == 0) return 0;
    if (e->nio >= 1024) {
        char msg[256];
        snprintf(msg, sizeof msg,
                 "too many distinct calls in unit '%s' (limit %d)",
                 e->sym->unit_name(), 1024);
        return e->sup->fail(msg);
    }
    snprintf(e->io_names[e->nio], 64, "%s", callee);
    e->io_owner[e->nio] = e->cur_unit;
    e->io_known[e->nio] = known;
    e->io_line[e->nio] = line;
    e->nio++;
    return 0;
}



/* DOC-87 Stage 2: a qualified built-in spelling (`core::Vec<int>`) has already
   consumed the name, so its caller parks the bare template name here and
   `parse_inst_type` skips its own name read. A file-scope slot, not a struct
   field: `struct Expr` is at the 64-field cap. */
/* SH-60 / D-60-2: does the type spelling read so far hold only qualifiers
   (`const`, `volatile`, `restrict`)? Then the identifier after it is still a
   type name, not a declarator name, and the `.m.ct` evidence rule applies to
   it as well. `int Foo` / `struct S Foo` return 0 and keep `Foo` as the
   declaration's name. */
/* LANG-26 / D-020: binding-site conversion lookup. The feature is opt-in by
   declaration: a conversion exists only when the source type's inherent `as`
   method or an imported type-host `map` declares it with the target's type as
   its result. The four binding sites (declaration initialiser, assignment,
   `out` actual, `return`) call `binding_convert`; every other expression
   position keeps C's rules and gets the "binding site only" diagnostic when a
   conversion would have been needed. The generated C is the same call the
   explicit `x.as<T>()` spelling builds: `Node_as(&x)` for an inherent method,
   the map recipe for a type host. */
/* The comparison key for a conversion. `type_key` drops whitespace and folds
   the integer aliases; the tag keyword is dropped too, because the declaration
   reader and `expr_type` do not always agree on whether it is present. */
/* 1 when the spelling names a declared aggregate, so a mismatch cannot be
   settled by C's arithmetic conversions. */
/* The receiver spelling a method lookup needs: `struct Tag`, without a pointer
   layer. `0` when the source is not a struct. */
/* Find the source type's inherent `as`/`to` conversion. Answers the method
   index, -1 when there is none, -2 when it exists but is private to another
   unit, -3 when it exists with a non-zero argument list. `ret` receives the
   method's result spelling (instances substituted). */
/* Count the visible-by-table type-host maps that declare `method` on `stype`
   with exactly `target` as the result. The emitter re-checks import visibility
   and reports an ambiguity, so this only decides whether a candidate exists.
   Answers the candidate count; `ret` gets the first result spelling. */
/* LANG-29 S4 / B4: the `map binding` registry. A binding is keyed by the
   (source, target) pair alone — no method name — and sits between the source
   type's inherent `as` and an imported `map trait` (D-021 §4). The count is
   what the caller needs: > 1 is the emitter's ambiguity, since only it can
   tell which declaring unit the current unit actually imports. */
/* The conversion node for a `map binding` hit: aux 12 tells the emitter to
   look the pair up in the binding registry and expand the recipe. */
/* D-020 §6.3: the compile-time rollback switch. `CT_BINDING_CONVERSION=0`
   turns every *implicit* binding-site conversion off, returning the four sites
   to v1.0's expected/got behaviour and suppressing the expression ban; the
   explicit `as<T>()` / `to<T>()` spellings never consult this. */
/* The four binding sites share this. A type the two sides already agree on is
   not a conversion; a pointer spelling, an interface target (boxing owns it)
   and a value whose type cannot be pinned are left to the existing checks. */
/* `x.as<T>()`: the target is written, so a miss is always a diagnostic. */
static int bind_conv_explicit(struct Expr *self, int recv, const char *target, int line, int col)
{
    char st[MAX_TEXT];
    char sk[MAX_TEXT];
    char tk[MAX_TEXT];
    char ret[MAX_TEXT];
    char msg[MAX_TEXT * 2];
    int ptr = 0, nm, mm;

    if (self->sup->expr_type(recv, st, sizeof st) != 0 || !st[0])
        return tool::diag::ct_sem_error(line, col,
            "cannot resolve the source type of this conversion", self->sup->mem->path);
    bind_conv_key(st, sk, sizeof sk);
    bind_conv_key(target, tk, sizeof tk);
    if (strcmp(sk, tk) == 0) return recv;
    ret[0] = 0;
    mm = bind_conv_inherent(self, st, "as", ret, sizeof ret, &ptr);
    if (mm == -2)
        return tool::diag::ct_sem_error(line, col,
            "method is private to its unit", self->sup->mem->path);
    if (mm == -3)
        return tool::diag::ct_sem_error(line, col,
            "an 'as' conversion takes no arguments", self->sup->mem->path);
    if (mm >= 0) {
        char rk[MAX_TEXT];
        bind_conv_key(ret, rk, sizeof rk);
        if (strcmp(rk, tk) != 0) {
            snprintf(msg, sizeof msg,
                     "no conversion from '%s' to '%s': inherent 'as' answers '%s'",
                     st, target, ret);
            return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        }
        return bind_conv_call(self, recv, st, "as", target, line, col);
    }
    if (bind_conv_binding(self, st, target) > 0)
        return bind_conv_call_binding(self, recv, st, target, line, col);
    ret[0] = 0;
    nm = bind_conv_maps(self, st, "as", ret, sizeof ret);
    if (nm > 0) return bind_conv_call(self, recv, st, "as", target, line, col);
    snprintf(msg, sizeof msg,
             "no conversion from '%s' to '%s'; add an inherent 'as' method on '%s', "
             "import a mapping trait that declares 'as', or import a mapping unit "
             "with a 'map binding' for this pair",
             st, target, st);
    return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
}

/* The strict tier: `x.to<T>()` answers `Option<T>`. The expected C spelling is
   the Option instance the parser would create for `Option<T>`, encoded the
   same way `parse_inst_type` does it, so a method declared with another result
   is named rather than silently accepted. */
static int bind_conv_explicit_to(struct Expr *self, int recv, const char *target, int line, int col)
{
    char st[MAX_TEXT];
    char ret[MAX_TEXT];
    char enc[MAX_TEXT];
    char expect[MAX_TEXT];
    char ek[MAX_TEXT];
    char rk[MAX_TEXT];
    char msg[MAX_TEXT * 2];
    int ptr = 0, nm, mm;

    if (self->sup->expr_type(recv, st, sizeof st) != 0 || !st[0])
        return tool::diag::ct_sem_error(line, col,
            "cannot resolve the source type of this conversion", self->sup->mem->path);
    {
        char *aa[1];
        aa[0] = (char *)target;
        if (frontend::sym::ct_inst_encode("Option", 1, aa, enc, sizeof enc) != 0)
            return tool::diag::ct_sem_error(line, col,
                "the strict conversion target is too long", self->sup->mem->path);
    }
    if (snprintf(expect, sizeof expect, "struct %s", enc) >= (int)sizeof expect)
        return tool::diag::ct_sem_error(line, col,
            "the strict conversion target is too long", self->sup->mem->path);
    bind_conv_key(expect, ek, sizeof ek);
    ret[0] = 0;
    mm = bind_conv_inherent(self, st, "to", ret, sizeof ret, &ptr);
    if (mm == -2)
        return tool::diag::ct_sem_error(line, col,
            "method is private to its unit", self->sup->mem->path);
    if (mm == -3)
        return tool::diag::ct_sem_error(line, col,
            "a 'to' conversion takes no arguments", self->sup->mem->path);
    if (mm >= 0) {
        bind_conv_key(ret, rk, sizeof rk);
        if (strcmp(rk, ek) != 0) {
            snprintf(msg, sizeof msg,
                     "no strict conversion from '%s' to '%s': 'to' answers '%s', expected '%s'",
                     st, target, ret, expect);
            return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        }
        return bind_conv_call(self, recv, st, "to", expect, line, col);
    }
    ret[0] = 0;
    nm = bind_conv_maps(self, st, "to", ret, sizeof ret);
    if (nm > 0) return bind_conv_call(self, recv, st, "to", expect, line, col);
    snprintf(msg, sizeof msg,
             "no strict conversion from '%s' to '%s'; add an inherent 'to' method returning '%s' or import a mapping trait that declares 'to'",
             st, target, expect);
    return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
}

/* D-020 §6.1: an `out` actual whose formal and actual types convert both ways
   gets a temporary. The parser replaces the actual in the call's argument chain
   with a synthetic variable of the formal's base type and records the two
   explicit conversions plus the write-back assignment in the arena's side
   table; the emitter splices them around the call. The temp starts as the
   converted actual, so the callee reads the caller's value; the write-back runs
   after the call on every return path (an `out` formal is written on every path
   by the L1 definite-assignment rule). Either direction missing is a hard
   error, never a partial write-back. */
static int bind_outconv_rewrite(struct Expr *self, int call, int args, int kind, int a, int b, const char *retin, int line, int col)
{
    char fts[16][MAX_TEXT];
    int anns[16];
    char at[MAX_TEXT];
    char ak[MAX_TEXT];
    char fk[MAX_TEXT];
    char ret[MAX_TEXT];
    char name[MAX_TEXT];
    int cur, prev, k, np, pi;

    /* kind 0 = free function (`a` = func index), 1 = trait method
       (`a` = trait, `b` = method), 2 = inherent method (`a` = first N_PARAM) */
    np = 0;
    if (kind == 0 && a >= 0) {
        np = self->sym->funcs[a].nparams;
        for (k = 0; k < np && k < 16; k++) {
            snprintf(fts[k], MAX_TEXT, "%s", self->sym->funcs[a].ptype + (k) * MAX_TEXT);
            anns[k] = (int)(unsigned char)self->sym->funcs[a].pann[k];
        }
    } else if (kind == 1 && a >= 0 && b >= 0) {
        np = self->sym->traits[a].m[b].nparams;
        for (k = 0; k < np && k < 16; k++) {
            snprintf(fts[k], MAX_TEXT, "%s", self->sym->traits[a].m[b].ptype + (k) * MAX_TEXT);
            anns[k] = (int)(unsigned char)self->sym->traits[a].m[b].pann[k];
        }
    } else if (kind == 2) {
        for (pi = a; pi > 0 && np < 16; pi = self->arena->nodes[pi].next) {
            snprintf(fts[np], MAX_TEXT, "%s", self->arena->nodes[pi].text);
            anns[np] = (int)(unsigned char)self->arena->nodes[pi].aux;
            np++;
        }
    } else {
        return args;
    }
    if (!bind_conv_on() || call < 0 || args <= 0 || np <= 0) return args;
    ret[0] = 0;
    if (kind == 0) snprintf(ret, sizeof ret, "%s", self->sym->funcs[a].ret);
    else if (kind == 1) snprintf(ret, sizeof ret, "%s", self->sym->traits[a].m[b].ret);
    else if (retin) snprintf(ret, sizeof ret, "%s", retin);
    prev = -1;
    cur = args;
    k = 0;
    while (cur > 0 && k < np) {
        int nxt = self->arena->nodes[cur].next;
        const char *ft = fts[k];
        int ann = anns[k];
        int do_conv = 0;

        /* only `out`; a pointer spelling, an interface target and the owning
           string / container / Box families keep their existing diagnostics */
        if (ann == 3 && ft && ft[0] && strcmp(ft, "void") != 0 && !strchr(ft, '*')
            && self->sup->expr_type(cur, at, sizeof at) == 0 && at[0]
            && !strchr(at, '*')) {
            int ip = 0;
            char itr[MAX_TEXT];
            bind_conv_key(at, ak, sizeof ak);
            bind_conv_key(ft, fk, sizeof fk);
            if (strcmp(ak, fk) != 0
                && !(self->sup->iface_ref_type(ft, itr, sizeof itr, &ip)
                     && self->sym->find_trait(itr) >= 0)
                && !frontend::sym::ct_is_string_value_type(at)
                && !frontend::sym::ct_is_string_value_type(ft)
                && !frontend::sym::ct_is_container_type(at)
                && !frontend::sym::ct_is_container_type(ft)
                && strstr(at, "Box_") == 0 && strstr(ft, "Box_") == 0
                /* A source type that declares `as` is a conversion site,
                   and so is an aggregate-to-aggregate pair (that is where the
                   "no conversion / import a mapping trait" diagnostic comes
                   from). A struct against a scalar keeps v1.0's
                   `type mismatch` (p78's `out int` vs struct P). */
                && (bind_conv_any(self, at, "as")
                    || (bind_conv_struct_like(self, at)
                        && bind_conv_struct_like(self, ft))))
                do_conv = 1;
        }
        if (do_conv) {
            int fwd, rev, wb, t, vi, seq;
            /* the actual must be an assignable place before it is replaced */
            if (check_refout_arg(self, cur, ann, ft) != 0) return -1;
            fwd = bind_conv_explicit(self, cur, ft, line, col);
            if (fwd < 0) return -1;
            if (self->arena->noutconv >= 32)
                return self->sup->fail("too many 'out' conversion temporaries in one unit");
            /* a user-visible name is avoided; `__ct_` is reserved for user
               declarations, so the compiler's own temp uses `_ct_outconvN` */
            seq = self->arena->noutconv;
            for (;;) {
                snprintf(name, sizeof name, "_ct_outconv%d", seq);
                if (self->sym->find_var(name) < 0) break;
                seq++;
            }
            t = self->sup->new_node(N_VAR);
            if (t < 0) return -1;
            self->arena->nodes[t].text = runtime::text::ct_intern(ft);
            if (!self->arena->nodes[t].text) return self->sup->fail("out of memory");
            self->arena->nodes[t].text2 = runtime::text::ct_intern(name);
            if (!self->arena->nodes[t].text2) return self->sup->fail("out of memory");
            self->arena->nodes[t].line = line;
            self->arena->nodes[t].num = col;
            if (self->sym->declare_var(name, ft) != 0) return -1;
            vi = self->sym->find_var(name);
            if (vi >= 0) self->sym->vars[vi].initialized = 1;
            rev = bind_conv_explicit(self, t, at, line, col);
            if (rev < 0) return -1;
            wb = self->sup->new_node(N_ASSIGN);
            if (wb < 0) return -1;
            self->arena->nodes[wb].a = cur;
            self->arena->nodes[wb].b = rev;
            self->arena->nodes[wb].line = line;
            self->arena->nodes[wb].num = col;
            self->arena->outconv[self->arena->noutconv].call = call;
            self->arena->outconv[self->arena->noutconv].actual = cur;
            self->arena->outconv[self->arena->noutconv].temp = t;
            self->arena->outconv[self->arena->noutconv].fwd = fwd;
            self->arena->outconv[self->arena->noutconv].writeback = wb;
            self->arena->outconv[self->arena->noutconv].formal = runtime::text::ct_intern(ft);
            if (!self->arena->outconv[self->arena->noutconv].formal)
                return self->sup->fail("out of memory");
            self->arena->outconv[self->arena->noutconv].ret = runtime::text::ct_intern(ret);
            if (!self->arena->outconv[self->arena->noutconv].ret)
                return self->sup->fail("out of memory");
            self->arena->noutconv++;
            if (prev < 0) args = t;
            else self->arena->nodes[prev].next = t;
            self->arena->nodes[t].next = nxt;
            cur = t;
        }
        prev = cur;
        cur = nxt;
        k++;
    }
    return args;
}

/* D-020's expression ban: a convertible value may not be used by arithmetic.
   Only a value that actually has an `as` conversion reaches the diagnostic;
   every other struct operand keeps whatever C has always said. */
static int bind_conv_arith(struct Expr *self, int left, int right, int line, int col)
{
    char lt[MAX_TEXT];
    char rt[MAX_TEXT];
    char msg[MAX_TEXT];
    int lc = 0, rc = 0;

    if (!bind_conv_on()) return 0;
    if (left >= 0 && self->sup->expr_type(left, lt, sizeof lt) == 0 && lt[0]
        && bind_conv_struct_like(self, lt))
        lc = bind_conv_any(self, lt, "as");
    if (right >= 0 && self->sup->expr_type(right, rt, sizeof rt) == 0 && rt[0]
        && bind_conv_struct_like(self, rt))
        rc = bind_conv_any(self, rt, "as");
    if (!lc && !rc) return 0;
    snprintf(msg, sizeof msg,
             "conversion is only allowed at a binding site (declaration/assignment/out/return); '%s' cannot be converted inside an expression",
             lc ? lt : rt);
    return tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
}

/* S1a-0 C1: the per-argument position frame is two parallel int blocks.
   Both grow together and the new slots are zeroed; only allocation failure
   (or the MAX_ARG_POS_MAX valve) can stop it. */
static int ensure_arg_capacity(struct Expr *self, int need)
{
    int cap;
    int *lines, *cols;

    if (need <= self->argcap) return 0;
    cap = self->argcap > 0 ? self->argcap : MAX_ARG_POS;
    while (cap < need && cap < MAX_ARG_POS_MAX) cap *= 2;
    if (cap > MAX_ARG_POS_MAX) cap = MAX_ARG_POS_MAX;
    if (need > cap) return self->sup->fail("out of memory");
    lines = (int *)realloc(self->arg_line, (size_t)cap * sizeof(*lines));
    if (!lines) return self->sup->fail("out of memory");
    memset(lines + self->argcap, 0, (size_t)(cap - self->argcap) * sizeof(*lines));
    self->arg_line = lines;
    cols = (int *)realloc(self->arg_col, (size_t)cap * sizeof(*cols));
    if (!cols) return self->sup->fail("out of memory");
    memset(cols + self->argcap, 0, (size_t)(cap - self->argcap) * sizeof(*cols));
    self->arg_col = cols;
    self->argcap = cap;
    return 0;
}

impl ExprOps for Expr {
    /* Phase 21 S4: a closure actual is one source argument that occupies the
       `(fn, env)` pair, two C arguments. The pair is adjacent and shaped
       `ret (*P)(void *…, …)` followed by `void *E`; anything else is E6. */
    /* R05: membership of a `(fn, env)` pair is decided by the first formal, not
       by the mere presence of "void *" anywhere in the type. A plain
       `int (*P)(int x, void *ctx)` also contains it, and `skip_env` would then
       drop a real parameter and shift the whole tail. The list is split with
       the same parser `closure_match` uses, and the first item must start with
       `void *` (not `void **`). */
    /* Returns 0 when every closure actual fills the start of a `(fn, env)`
       pair. An inline literal is bound to the host fn type right here (D21-14),
       and a declared binding fills the pair too (R03): its parameter tail is
       compared, but its return type stays the one its declaration took. The
       binding is still a binding -- it cannot be copied, renamed, stored in a
       field or returned (D21-13). A plain function-pointer slot and a position
       that is not a pair are distinct errors; the second also carries the E8
       note, because the compiler cannot see whether the callee keeps the
       environment. */
    /* 25.1: the static-recipe counterpart of `closure_arg_check`. The method's
       parameters are addressed positionally and a closure fills two slots, so
       a closure anywhere else is L25-1: the recipe has no place to put the
       `(fn, env)` pair and would silently hand the trampoline to one formal.
       A pair that does line up binds exactly as a plain call does. */
    /* A static map is expanded into its recipe at the call site, so an actual
       the recipe does not name is simply dropped. A variadic method forwards
       the tail (`...`), which turns the count into a lower bound; a fixed one
       must match exactly. */
    /* 19.2: the resolved signature beside the argument chain, one position at
       a time. Only a position where both sides can name a type is compared;
       an interface formal (boxing owns it), an array on either side (decay),
       a cast argument and an argument without a derivable type all stay
       unknown and pass (D19-3). This half stays silent: it reports the first
       confident mismatch so `argtype_check` can warn once and a type host can
       try every candidate before it does (25.1). */
    /* SH-60: the static-recipe form of 19.2. The call site is expanded into
       the recipe against the host trait's signature, and the mapping unit is
       usually imported, so `ct check` (single unit) can never look at this
       call. A confident mismatch therefore fails the ct stage outright
       instead of waiting for a C warning that the recipe may not even keep. */
    /* 19.3: an impl's parameter spelling against the trait's -- two declared
       types instead of an argument expression, the same coarse rules as 19.2
       (`arg_class` plus this unit's struct table). The trait may live in an
       imported unit, so only a confident mismatch (1) counts; every
       undecidable pair passes (D19-3). */
    /* S2 binding: a closure literal on the right of a function-pointer
       declaration. `host` is the declared type (`int (*)(int x)`); its return
       type and parameter list are compared with the literal's. The parameter
       comparison reuses `decl_type_compat`, the same normalisation 19.3 uses.
       S5 adds the argument form: the host is the callee's formal pair
       (`int (*)(void *, int)`), whose first parameter is the environment and is
       skipped, and the return type still comes from the host fn (D21-14). */
    /* The type keywords. L0 / L1 / L2 have always accepted the `stdint` /
       `stddef` / `stdbool` spellings and the qualifiers, so ct-ast lists the same
       set (`restrict` included): a program written against those headers is a
       pass-through declaration here, and the C compiler still owns the meaning.
       `DIR` is ct-ast's own addition (the directory handle `opendir` returns). */
    /* Phase 26 (D26-5): monomorphise `gfi` for `targ` once per asking unit.
       The instance is a private `funcs` row with the template's signature
       substituted; its body is the template's own N_FUNC node, which the
       emitter writes under `gtparam`/`gtarg` (D26-7). The key is the triple
       (template row, owner, concrete spelling), and each owner numbers its
       static copies from one, independently of every other unit. */
    /* Capture a parenthesized C11 specifier at the cursor: `_Alignas(…)` (the
       list is required) or `_Atomic(…)` (bare `_Atomic` is the qualifier form
       and is accepted too). Both are appended to the type spelling, so every
       declaration entry -- global, local, field, parameter, typedef -- picks
       them up unchanged. */
    /* Phase 29 §2.2: one generic struct instance in a type position. The lexer
       sits on the template name; the arguments are ordinary types, each parsed
       by `parse_type`, and the emitted spelling is the encoded C tag. The
       instance row is registered in this unit's struct table (so field access,
       `sizeof` and the vptr code see an ordinary struct) and, build-wide, in
       `ct_insts` so a later unit reuses the same definition (D29-10). */
    /* L29-13: a container copies its elements (`memcpy` on growth, plain
       assignment on `set`), so a struct that carries a vptr has no defensible
       copy story. `use Drop` / `use Handback` add no vptr and never join `use`,
       so they do not trip this. Phase 31 O1 unfreezes the interface-value half:
       a `struct X_iface` is two machine words (a non-owning fat pointer) and is
       stored by value, so only vptr-bearing concrete structs are refused. */
    /* L31-1: `struct X_iface *` cannot be a container element. Strip the
       `struct ` prefix and the trailing `*` handle; a star plus an `_iface`
       base is the shape. `Vec<struct A *>` (a concrete pointer) is untouched. */
    /* Phase 31: bind `spell` to the instance's concrete C arguments. The pair
       `StructTmpl.tparam` / `StructInst.ctype` is what `inst_make` used to
       substitute the fields, so the reverse direction here is the same data. */
    /* Phase 31 L31-2 / Phase 33 O3: an interface element belongs to the unit
       that declares its trait; an owning instance element belongs to the unit
       that owns its template. Both are compared with the container template's
       unit, which is the unit that would otherwise write the instance methods.
       A scalar or a non-container struct element is left to the emitter's
       declaring-unit test (`StructDef.owner`). */
    /* The single creation path for a concrete instance: encode, register the
       identity row, copy the template's fields with every parameter substituted
       and let every matching `use` block adopt its trait. The arity check is
       shared with the type parser, so a built-in container gets no private
       branch (E29-12). `args` are the source-canonical arguments and `cargs`
       the C spellings; both hold `nargs` rows (S1a-0 C3: any arity up to the
       formal cap). */
    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    /* Is the *current* token a type name? The rules are the cast lookahead's
       (below), shared so that a bare type parameter is a type everywhere a
       type name is expected. Nothing is consumed. */
    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    /* Current token is `offsetof`; does a `(` follow? The builtin has no
       operand form, so a bare name stays an ordinary identifier and the normal
       undeclared-variable path reports it (D-8). */
    /* Is `field` of the struct `stype` a function pointer? A field declared in
       place keeps the `(*)` in its type; a typedef field (`BinOp cb;`) is only
       known through the type table's kind 4 (D-4). */
    /* Is this node tree an integer constant expression? ct-ast folds nothing,
       so the judgement is structural: the emitter keeps the source spelling and
       the C compiler does the arithmetic (D-6). A lone name is the caller's
       business -- a `case` label accepts one (a macro or a global), while an
       enum initialiser only accepts a declared constant or a macro. */
    int parse_expr(void)
    {
        int left, right, inner, n, c;
        int into_allow;
        (void)self;

        /* Phase 30: only the outermost expression of an allowed position may
           carry `into`; every recursive call starts with the flag cleared. */
        into_allow = self->into_ok;
        self->into_ok = 0;

        /* C precedence, loosest first: `||`, `&&`, then the bitwise levels
           (`|` `^` `&`) owned by parse_bitor. The loops live here so the
           trait's method budget stays put. */
        left = self->parse_bitor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("&&")) {
            self->sup->lex_next();
            /* L44-4: the right operand is short-circuited, so an early return
               there would be skipped on some paths. */
            self->try_ban++;
            right = self->parse_bitor();
            self->try_ban--;
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_AND;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("||")) {
            self->sup->lex_next();
            self->try_ban++;
            right = self->parse_bitor();
            self->try_ban--;
            if (right < 0) return -1;
            while (self->lex->tok == T_PUNCT && self->lex->tok_is("&&")) {
                self->sup->lex_next();
                self->try_ban++;
                inner = self->parse_bitor();
                self->try_ban--;
                if (inner < 0) return -1;
                n = self->sup->new_node(N_BIN);
                if (n < 0) return -1;
                self->arena->nodes[n].a = right;
                self->arena->nodes[n].b = inner;
                self->arena->nodes[n].aux = B_AND;
                right = n;
            }
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_OR;
            left = n;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("?")) {
            int a, b;
            /* L44-4: the condition is evaluated before either arm and an
               early return there would skip the arm selection. */
            if (self->arena->nodes[left].kind == N_TRY)
                return tool::diag::ct_sem_error(self->arena->nodes[left].line,
                    (int)self->arena->nodes[left].num,
                    "'?' is not allowed here", self->sup->mem->path);
            self->sup->lex_next();
            /* L44-4: both arms are conditionally evaluated. */
            self->try_ban++;
            a = self->parse_expr();
            self->try_ban--;
            if (a < 0) return -1;
            if (self->sup->expect(":") != 0) return -1;
            self->try_ban++;
            b = self->parse_expr();
            self->try_ban--;
            if (b < 0) return -1;
            c = self->sup->new_node(N_TERN);
            if (c < 0) return -1;
            self->arena->nodes[c].a = left;
            self->arena->nodes[c].b = a;
            self->arena->nodes[c].c = b;
            return c;
        }
        /* An assignment used as a value: `(c = f())`, `(a = b = 0)`. Only the
           `(` branch below and a statement's condition turn `assign_ok` on, so a
           statement's own assignment (`x = 1;`) still goes through the statement
           layer, which is where AutoDrop keeps its bookkeeping. Parsing the right
           side here again makes the operator right-associative. */
        if (self->assign_ok && self->lex->tok == T_PUNCT
            && (self->lex->tok_is("=")
                || self->lex->tok_is("+=") || self->lex->tok_is("-=")
                || self->lex->tok_is("*=") || self->lex->tok_is("/=")
                || self->lex->tok_is("%=") || self->lex->tok_is("&=")
                || self->lex->tok_is("|=") || self->lex->tok_is("^=")
                || self->lex->tok_is("<<=") || self->lex->tok_is(">>="))) {
            int op = 0, k2;
            char oc = self->lex->tok_first();
            int aline = self->lex->tokline;
            int acol = self->lex->tokstart - self->lex->lstart + 1;
            k2 = self->arena->nodes[left].kind;
            /* P-7.2: a `const T[]` view is read-only; the check is here, not
               left to cc, so the diagnostic names the slice rule. */
            if (k2 == N_SLICE_INDEX && self->arena->nodes[left].aux == 1)
                return tool::diag::ct_sem_error(self->arena->nodes[left].line,
                    self->arena->nodes[left].num,
                    "cannot write to an element of a const slice", self->sup->mem->path);
            /* PH-53 L53-6. */
            if (self->opt_lvalue_check(left, self->arena->nodes[left].line,
                                       self->arena->nodes[left].num) != 0)
                return -1;
            /* PH-52 L52-6/L52-8: a custom subscript only writes as a plain
               `=` statement; a value-position assignment has no statement for
               the void `set`, and a compound operator has no read-modify-write
               spelling in the protocol. */
            if (self->container_subscript_kind(left) == 3) {
                int cl = self->arena->nodes[left].line;
                int cc = self->arena->nodes[left].num;
                if (!self->lex->tok_is("="))
                    return tool::diag::ct_sem_error(cl, cc,
                        "a custom subscript supports only '='; use set(k, v)",
                        self->sup->mem->path);
                return tool::diag::ct_sem_error(cl, cc,
                    "a custom subscript write needs a statement and an lvalue receiver",
                    self->sup->mem->path);
            }
            /* Phase 31 O3 (L31-3/L31-4): an assignment in a value position
               writes the target just like the statement form. */
            if (self->container_write_check(left) != 0) return -1;
            /* Phase 30 S11: inside an `into` block `$` is a writable lvalue
               (an `own` receiver never reaches here -- L30-4 refuses it). */
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX
                && k2 != N_SLICE_INDEX
                && k2 != N_DEREF && k2 != N_INTO_SELF)
                return self->sup->fail("assignment target is not assignable");
            /* An `own` variable is tracked by statement-level assignments; an
               assignment in a value position would slip past that bookkeeping,
               so it is refused instead of silently leaking. */
            if (k2 == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[left].text2);
                if (vi >= 0 && self->sym->vars[vi].autodrop)
                    return self->sup->fail("an 'own' variable can only be assigned in a statement");
            }
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else if (oc == '%') op = 5;
            else if (oc == '&') op = 6;
            else if (oc == '|') op = 7;
            else if (oc == '^') op = 8;
            else if (oc == '<') op = 9;
            else if (oc == '>') op = 10;
            self->sup->lex_next();
            /* the right side of an assignment is one of the value positions,
               so it may carry an `into` block (Phase 30 S3) */
            self->into_ok = into_allow;
            right = self->parse_expr();
            self->into_ok = 0;
            if (right < 0) return -1;
            /* L29-9: assigning one container binding to another copies it,
               which the container protocol forbids. */
            if (op == 0 && k2 == N_VAR
                && self->arena->nodes[right].kind == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[left].text2);
                int vj = self->sym->find_var(self->arena->nodes[right].text2);
                if (vi >= 0 && vj >= 0 && !self->sym->vars[vj].cview
                    && frontend::sym::ct_is_container_type(self->sym->vars[vi].type)
                    && strcmp(self->sym->vars[vi].type,
                              self->sym->vars[vj].type) == 0)
                    return tool::diag::ct_sem_error(aline, acol,
                        "a container is moved, not copied; use retain() or a function result",
                        self->sup->mem->path);
            }
            n = self->sup->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            return self->into_tail(n, into_allow);
        }
        return self->into_tail(left, into_allow);
    }

    /* Phase 30 S1/S2/S12: `into` is contextual -- it is only a keyword when an
       expression is directly followed by `into {`. The receiver is the whole
       expression parsed so far, so `a + b into { … }` reaches L30-2 instead of
       silently binding to `b`. */
    int into_tail(int left, int allow)
    {
        int n, recv, line, col, kind;
        char type[MAX_TEXT];

        n = left;
        for (;;) {
            if (!(self->lex->tok == T_ID && self->lex->tok_is("into")))
                return n;
            line = self->lex->tokline;
            col = self->lex->tokstart - self->lex->lstart + 1;
            if (!allow) {
                tool::diag::ct_sem_error(line, col,
                    "'into' block is not allowed here", self->sup->mem->path);
                return -1;
            }
            if (self->into_node >= 0) {
                tool::diag::ct_sem_error(line, col,
                    "nested 'into' blocks are not supported", self->sup->mem->path);
                return -1;
            }
            recv = n;
            kind = self->arena->nodes[recv].kind;
            if (!(kind == N_VAR || kind == N_MEMBER || kind == N_ARROW
                  || kind == N_INDEX || kind == N_CALL || kind == N_MCALL
                  || kind == N_DEREF || kind == N_INTO)) {
                tool::diag::ct_sem_error(line, col,
                    "'into' needs a variable, field or call on its left",
                    self->sup->mem->path);
                return -1;
            }
            type[0] = 0;
            /* An indexed receiver's element type is `expr_type`'s answer: for
               an array variable `expr_ctype` keeps the `[]` decay marker,
               which is not a declarable type. Every other form needs the
               addressable spelling `expr_ctype` produces. */
            if (kind == N_INDEX) {
                if (self->sup->expr_type(recv, type, sizeof type) != 0)
                    type[0] = 0;
            } else if (self->sup->expr_ctype(recv, type, sizeof type) != 0) {
                type[0] = 0;
            }
            if (type[0] == 0) {
                tool::diag::ct_sem_error(line, col,
                    "cannot determine the receiver type of this 'into' block",
                    self->sup->mem->path);
                return -1;
            }
            /* L30-4: an interface value has no static member table, and an
               `own` receiver would run the release path on every `$ = …`. */
            {
                char ifc[MAX_TEXT];
                int vi;
                ifc[0] = 0;
                if (self->sup->is_iface_type(type, ifc, sizeof ifc)
                    || (kind == N_VAR
                        && (vi = self->sym->find_var(self->arena->nodes[recv].text2)) >= 0
                        && self->sym->vars[vi].autodrop)) {
                    tool::diag::ct_sem_error(line, col,
                        "'into' cannot take an interface or 'own' receiver",
                        self->sup->mem->path);
                    return -1;
                }
            }
            self->sup->lex_next();
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("{"))) {
                self->sup->fail("expected '{' after 'into'");
                return -1;
            }
            n = self->into_block(recv, type, line, col);
            if (n < 0) return -1;
            /* a suffix after the block belongs to the whole expression:
               `cfg into { … }.port` reads the promoted receiver's port */
            if (self->lex->tok == T_PUNCT
                && (self->lex->tok_is(".")
                    || self->lex->tok_is("->")
                    || self->lex->tok_is("[")
                    || self->lex->tok_is("(")
                    || self->lex->tok_is("++")
                    || self->lex->tok_is("--"))) {
                self->postfix_seed = n;
                n = self->parse_postfix();
                if (n < 0) return -1;
            }
        }
    }

    /* Build one `into` node and parse its block with `$` / `.name` bound to
       it. The receiver has already been type-checked as `type`. */
    int into_block(int recv, char *type, int line, int col)
    {
        int n, blk, save, selfn, kind, cat, len;

        kind = self->arena->nodes[recv].kind;
        cat = 1;                        /* pointer */
        len = strlen(type);
        while (len > 0 && (type[len - 1] == ' ' || type[len - 1] == '\t')) len--;
        if (!(len > 0 && type[len - 1] == '*')) {
            if (kind == N_INTO)
                /* §2.8: a chained segment re-enters the same object, so it
                   keeps the inner segment's category (an lvalue stays an
                   lvalue; only an rvalue segment stays a copy). */
                cat = self->arena->nodes[recv].aux;
            else if (kind == N_VAR || kind == N_MEMBER || kind == N_ARROW
                || kind == N_INDEX || kind == N_DEREF)
                cat = 2;                /* lvalue value type */
            else
                cat = 3;                /* rvalue value type */
        }
        n = self->sup->new_node(N_INTO);
        if (n < 0) return -1;
        self->arena->nodes[n].a = recv;
        self->arena->nodes[n].aux = cat;
        self->arena->nodes[n].line = line;
        self->arena->nodes[n].num = col;
        self->arena->nodes[n].text = runtime::text::ct_intern(type);
        if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
        selfn = self->sup->new_node(N_INTO_SELF);
        if (selfn < 0) return -1;
        self->arena->nodes[selfn].num = n;
        self->arena->nodes[selfn].text = runtime::text::ct_intern(type);
        if (!self->arena->nodes[selfn].text) return self->sup->fail("out of memory");
        save = self->into_node;
        self->into_node = n;
        blk = self->st_hook(0, 0);
        self->into_node = save;
        if (blk < 0) return -1;
        self->arena->nodes[n].b = self->arena->nodes[blk].a;
        return n;
    }

    /* L30-5: `.name` on a CT struct receiver must name a field. An opaque C
       host has no member table; a misspelling there surfaces from `cc` on the
       generated line (R7), so only a defined CT struct is checked. */
    int into_member_check(int base, char *fname, int line, int col)
    {
        int owner, si, fi, tlen;
        char st[MAX_TEXT];
        char msg[MAX_TEXT + 96];

        (void)self;
        if (self->arena->nodes[base].kind != N_INTO_SELF
            || self->arena->nodes[base].aux != 1) return 0;
        owner = self->arena->nodes[base].num;
        if (owner < 0) return 0;
        snprintf(st, sizeof st, "%s", self->arena->nodes[owner].text);
        tlen = strlen(st);
        while (tlen > 0 && st[tlen - 1] == '*') {
            st[--tlen] = 0;
            while (tlen > 0 && (st[tlen - 1] == ' ' || st[tlen - 1] == '\t'))
                st[--tlen] = 0;
        }
        if (strncmp(st, "struct ", 7) == 0) {
            int k;
            for (k = 0; st[k + 7] != 0; k++) st[k] = st[k + 7];
            st[k] = 0;
        }
        si = self->sym->find_struct(st);
        if (si < 0 || !self->sym->structs[si].defined) return 0;
        for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
            if (strcmp(self->sym->structs[si].fields[fi].name, fname) == 0)
                return 0;
        snprintf(msg, sizeof msg, "no member '%s' on the 'into' receiver", fname);
        tool::diag::ct_sem_error(line, col, msg, self->sup->mem->path);
        return -1;
    }

    /* `|`, `^`, `&` are three separate levels in C, and `<<` / `>>` bind
       tighter than the comparisons but looser than `+` / `-`. */
    int parse_bitor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bxor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("|")) {
            self->sup->lex_next();
            right = self->parse_bxor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BOR;
            left = n;
        }
        return left;
    }

    int parse_bxor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bitand();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("^")) {
            self->sup->lex_next();
            right = self->parse_bitand();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_XOR;
            left = n;
        }
        return left;
    }

    int parse_bitand(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_cmp();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("&")) {
            self->sup->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BAND;
            left = n;
        }
        return left;
    }

    int parse_shift(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT
               && (self->lex->tok_is("<<") || self->lex->tok_is(">>"))) {
            op = (self->lex->tok_first() == '<') ? B_SHL : B_SHR;
            self->sup->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_shift();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT) {
            op = 0;
            if (self->lex->tok_is("<")) op = B_LT;
            else if (self->lex->tok_is(">")) op = B_GT;
            else if (self->lex->tok_is("<=")) op = B_LE;
            else if (self->lex->tok_is(">=")) op = B_GE;
            else if (self->lex->tok_is("==")) op = B_EQ;
            else if (self->lex->tok_is("!=")) op = B_NE;
            if (op == 0) break;
            self->sup->lex_next();
            right = self->parse_shift();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (self->lex->tok_is("+") || self->lex->tok_is("-"))) {
            op = (self->lex->tok_first() == '+') ? B_ADD : B_SUB;
            self->sup->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            if (bind_conv_arith(self, left, right,
                                self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1) != 0)
                return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (self->lex->tok_is("*")
               || self->lex->tok_is("/") || self->lex->tok_is("%"))) {
            op = B_MUL;
            if (self->lex->tok_first() == '/') op = B_DIV;
            else if (self->lex->tok_first() == '%') op = B_MOD;
            self->sup->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            if (bind_conv_arith(self, left, right,
                                self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1) != 0)
                return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        /* LANG-29 S4 / B5: `match (subject) { … }` in expression position.
           The statement reader lives in the statement layer, which this unit
           may not import (a cycle), so the parser's hook is asked twice: once
           for the `match (...) {` lookahead, once for the reader. A bare
           `match(x)` call or a variable named `match` keeps the old path. */
        if (self->lex->tok == T_ID && self->lex->tok_is("match")
            && self->st_hook != 0 && self->st_hook(3, 0) != 0)
            return self->st_hook(2, 0);

        if (self->lex->tok == T_ID && (self->lex->tok_is("sizeof")
                                       || self->lex->tok_is("_Alignof")
                                       || self->lex->tok_is("alignof"))) {
            char tbuf[MAX_TEXT];
            int kind, rc;
            /* 1 = sizeof, 2 = C11 `_Alignof`, 4 = `alignof` (stdalign.h) */
            kind = self->lex->tok_is("sizeof") ? 1
                   : self->lex->tok_is("_Alignof") ? 2 : 4;
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")
                && self->next_is_type_name()) {
                self->sup->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->sup->expect(")") != 0) return -1;
                n = self->sup->new_node(N_SIZEOF);
                if (n < 0) return -1;
                self->arena->nodes[n].text = runtime::text::ct_intern(tbuf);
                if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                self->arena->nodes[n].aux = kind;
                return n;
            }
            /* A type operand does not need parentheses in CT (`sizeof T`). The
               active type parameter is a type name inside its template body, so
               this branch is what keeps `sizeof T` out of the expression path.
               `type_no_ptr` stops the type at the name: a following `*` belongs
               to the surrounding multiplication. */
            if (self->tok_is_type_name()) {
                self->type_no_ptr = 1;
                rc = self->parse_type(tbuf, sizeof tbuf);
                self->type_no_ptr = 0;
                if (rc != 0) return -1;
                n = self->sup->new_node(N_SIZEOF);
                if (n < 0) return -1;
                self->arena->nodes[n].text = runtime::text::ct_intern(tbuf);
                if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                self->arena->nodes[n].aux = kind;
                return n;
            }
            /* C11 spells the alignment query with a type name only; a bare
               `alignof` expression keeps its macro spelling. */
            if (kind == 2) return self->sup->fail("_Alignof needs a type in parentheses");
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_SIZEOF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = kind == 4 ? 3 : 0;
            return n;
        }
        /* `(params) => expr` opens a closure literal. The check runs before
           the cast branch: a typed parameter list starts with a type word, so
           `next_is_type_name` would otherwise read `(int x)` as a cast. */
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")
            && closure_ahead(self))
            return self->parse_closure();
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->sup->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            /* `(type){ … }` is a compound literal: the braces are captured like
               a declaration initialiser, and the emitter adds the vptr items a
               trait-carrying struct needs. A postfix suffix still applies, so
               the node rides through `postfix_seed` instead of returning here. */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                /* a compound literal's braces go to the arena string pool for the
                   same reason a declaration initialiser does (`aux = 1`,
                   `num` = offset) */
                char *raw;
                int rn, cn, off, k;
                size_t tl = strlen(tbuf);
                if (tl > 0 && tbuf[tl - 1] == '*')
                    return self->sup->fail("a compound literal needs an object type");
                if (self->container_init_check(tbuf) != 0) return -1;
                rn = self->sup->new_node(N_RAW);
                if (rn < 0) return -1;
                {
                    /* SH-115: a compound literal is a struct brace
                       initializer too; judge its literal items. */
                    int bl = self->lex->tokline;
                    int bc = self->lex->tokstart - self->lex->lstart + 1;
                    if (self->sup->init_raw(&raw) != 0) return -1;
                    if (self->chk_brace_init(tbuf, raw, bl, bc) != 0) return -1;
                }
                off = self->arena->str_begin();
                for (k = 0; raw[k]; k++)
                    if (self->arena->str_put(raw[k]) != 0)
                        return self->sup->fail("initializer is too long");
                self->arena->str_end();
                self->arena->nodes[rn].num = off;
                self->arena->nodes[rn].aux = 1;
                cn = self->sup->new_node(N_COMPOUND);
                if (cn < 0) return -1;
                self->arena->nodes[cn].text = runtime::text::ct_intern(tbuf);
                if (!self->arena->nodes[cn].text) return self->sup->fail("out of memory");
                self->arena->nodes[cn].a = rn;
                self->postfix_seed = cn;
                return self->parse_postfix();
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_CAST);
            if (n < 0) return -1;
            self->arena->nodes[n].text = runtime::text::ct_intern(tbuf);
            if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
            self->arena->nodes[n].a = e;
            return n;
        }
        op = 0;
        /* prefix `++` / `--`: the same increment as the postfix form, but the
           value is the updated one (D-9 of this batch). It binds like the other
           unary operators, so `s[--n]` and `*--p` work as in C. */
        if (self->lex->tok == T_PUNCT && (self->lex->tok_is("++")
                                          || self->lex->tok_is("--"))) {
            int pre = (self->lex->tok_first() == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            if (is_range_index(self->arena, e))
                return self->sup->fail("the range index '$' is not a variable");
            /* PH-53 L53-6. */
            if (self->opt_lvalue_check(e, self->arena->nodes[e].line,
                                       self->arena->nodes[e].num) != 0)
                return -1;
            /* Phase 31 O3 (L31-3/L31-4): `++v[i]` / `--v[i]` write the value. */
            if (self->container_write_check(e) != 0) return -1;
            n = self->sup->new_node(N_PRE);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = pre;
            return n;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("-")) op = U_NEG;
        else if (self->lex->tok == T_PUNCT && self->lex->tok_is("!")) op = U_NOT;
        else if (self->lex->tok == T_PUNCT && self->lex->tok_is("~")) op = U_BNOT;
        if (op != 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_UNARY);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = op;
            return n;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("&")) {
            int save;
            self->sup->lex_next();
            save = self->fnval_ok;
            self->fnval_ok = 1;      /* `&handler` may name a C library function */
            e = self->parse_unary();
            self->fnval_ok = save;
            if (e < 0) return -1;
            if (is_range_index(self->arena, e))
                return self->sup->fail("the range index '$' is not a variable");
            /* PH-53 L53-6. */
            if (self->opt_lvalue_check(e, self->arena->nodes[e].line,
                                       self->arena->nodes[e].num) != 0)
                return -1;
            /* Phase 31 O3 (L31-5): `&v[i]` has no object to name. */
            if (self->container_addr_check(e) != 0) return -1;
            n = self->sup->new_node(N_ADDR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("*")) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_DEREF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    /* Phase 29: the method node `impl<T> Name<Args>` declares for the receiver
       type `ibase` (a `struct <instance>` spelling), or -1. Only inherent
       blocks answer here: a `use` block is a trait impl and keeps the vtable
       path, which `method_trait` resolves through the instance's use list. */
    /* Phase 29 P29-2: the static (receiverless) method `ibase::fname`, or -1.
       Same walk as `inst_inherent_method`, but only a method the impl block
       marked `static` answers: `Vec<int>::from(items, n)` must never resolve to
       an instance method, and an instance call must never resolve to `from`. */
    /* V29-4: resolve a C typedef by name to the spelling it was declared with.
       An opaque alias (a header type this unit never declares) keeps its name,
       so the caller can still decide it is not a container. */
    /* V29-4: the return type of the abstract function-pointer declarator this
       compiler stores (`RET (*)(params)` -- the same `(*)` the emitter splices
       a name into). Anything else resolves to 0. */
    /* V29-4: strip exactly one pointer layer. A function-pointer spelling keeps
       its star inside `(*)`, so it is not peeled here. */
    /* V29-4: the static C type of an expression. `array_depth` counts the dims
       still attached to the value (0 for a scalar / pointer). One `[` peels one
       dimension or one `*`; one `*` peels one `*`. A shape the tables cannot
       pin returns 0 and is not judged. */
    /* PH-87 S87a: the node-kind dispatch, one slice per kind (the bodies are
       the `ctype_*` helpers above). The kind is read once; `p87_parser`
       inventories the slice set, so a kind that loses its slice fails the
       probe instead of silently answering 0. */
    /* V29-4: `v[i]` / `m[k]` on a container handle. An array (any remaining
       dims) and a pointer keep the C meaning, so only a resolved container
       value is refused. A base this pass cannot pin is not judged. */
    int container_index_check(int base)
    {
        char ty[MAX_TEXT];
        int ad;

        if (!self->static_ctype(base, ty, sizeof ty, &ad, 0)) return 0;
        if (ad > 0) return 0;
        if (strchr(ty, '*') != 0) return 0;
        if (strncmp(ty, "struct Vec_", 11) == 0)
            return self->sup->fail("a Vec is not subscriptable: use get(i) / set(i, v)");
        if (strncmp(ty, "struct Map_", 11) == 0)
            return self->sup->fail("a Map is not subscriptable: use get(key)");
        return 0;
    }

    /* V29-4: a brace initializer for a container. `MapEntry` is an ordinary
       struct and keeps its aggregate form. */
    /* Phase 31 S11b: a file-scope brace initializer. C static initialization
       cannot call the constructor, so a `Vec` is refused with its own text
       (L31-10) before the generic container refusal; a `Map` keeps that
       refusal until its literal path lands. */
    /* Phase 31 O3 (L31-3/L31-4): the read-only rule for a write form. The
       target is walked down its member / arrow chain, so `v[i].field = x` blames
       the subscript; the walk stops at a deref, because `*m[k] = x` writes the
       stored object and stays legal. 0 when the chain holds no subscript. */
    /* Phase 31 S16b: the 19.2 coarse comparison for a Map literal key or value.
       It reuses the same class kernel `push` / `put` arguments use, so a numeric
       literal stays compatible with any integer slot and a struct compares by
       its declared row (not by spelling). */
    /* P29-2 lookahead: the cursor is on a template name. 1 only when
       `<type-args>:: <name> (` follows, so `Vec < 3` keeps its comparison
       shape. The lexer has no peek, hence the save/restore. */
    int parse_postfix(void)
    {
        int n, m, idx, args, mline, mcol;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->postfix_seed;
        self->postfix_seed = -1;
        if (n < 0) {
            /* Phase 84: `Type.Variant(args)` is a constructor, not a member
               access on a value. The lookahead never consumes. */
            if (self->adt_ctor_ahead()) return self->parse_adt_ctor();
            n = self->parse_primary();
            if (n < 0) return -1;
        }
        for (;;) {
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("$")) {
                int dl = self->lex->tokline;
                int dc = self->lex->tokstart - self->lex->lstart + 1;
                char mname[MAX_TEXT];
                int mvi, mv, mas;
                if (!(self->mat_state & (1L << 62)))
                    return tool::diag::ct_sem_error(dl, dc,
                        "'$name' is only allowed in a statement expression (PH-76)",
                        self->sup->mem->path);
                if (n < 0 || (self->arena->nodes[n].kind != N_CALL
                              && self->arena->nodes[n].kind != N_MCALL))
                    return tool::diag::ct_sem_error(dl, dc,
                        "'$name' must follow a method call (PH-76)",
                        self->sup->mem->path);
                if (self->arena->nodes[n].kind == N_MCALL
                    && (self->arena->nodes[n].aux == 5 || self->arena->nodes[n].aux == 6))
                    return tool::diag::ct_sem_error(dl, dc,
                        "'$name' does not support type-host / .m.ct recipes in v1 (PH-76)",
                        self->sup->mem->path);
                self->sup->lex_next();
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a variable name after '$'");
                self->lex->tok_copy(mname, sizeof mname);
                mvi = self->sym->find_var(mname);
                if (mvi < 0)
                    return self->sup->fail("'$' target must be a declared variable");
                if (self->sym->vars[mvi].autodrop || self->sym->vars[mvi].borrowed)
                    return tool::diag::ct_sem_error(dl, dc,
                        "own/borrow cannot be a '$' target (PH-76)",
                        self->sup->mem->path);
                if (strncmp(self->sym->vars[mvi].type, "const ", 6) == 0)
                    return tool::diag::ct_sem_error(dl, dc,
                        "a const value cannot be a '$' target (PH-76)",
                        self->sup->mem->path);
                {
                    char rty[MAX_TEXT];
                    int mz = 0, mad = 0, trc;
                    rty[0] = 0;
                    trc = self->static_ctype(n, rty, sizeof rty, &mad, 0);
                    /* A void hop has no value to assign; an unresolvable call
                       has no type to check either, so v1 refuses both at `$`
                       instead of emitting `x = ...void...` for the host cc. */
                    if (trc == 0 || !rty[0])
                        return tool::diag::ct_sem_error(dl, dc,
                            "'$' needs a non-void result; this hop has none (PH-76)",
                            self->sup->mem->path);
                    if (self->types_mode && *self->types_mode) {
                        self->chk_line = dl;
                        self->chk_col = dc;
                        self->chk_arg = 0;
                        if (self->chk_assignable(self->sym->vars[mvi].type, rty, 0, 8) != 0)
                            return -1;
                    }
                    (void)mz;
                    (void)mad;
                }
                mv = self->sup->new_node(N_VAR);
                if (mv < 0) return -1;
                self->arena->nodes[mv].text2 = runtime::text::ct_intern(mname);
                if (!self->arena->nodes[mv].text2) return self->sup->fail("out of memory");
                self->arena->nodes[mv].line = dl;
                self->arena->nodes[mv].num = dc;
                mas = self->sup->new_node(N_ASSIGN);
                if (mas < 0) return -1;
                self->arena->nodes[mas].a = mv;
                self->arena->nodes[mas].b = n;
                self->arena->nodes[mas].aux = 0;
                self->arena->nodes[mas].line = dl;
                self->arena->nodes[mas].num = dc;
                {
                    long mh = self->mat_state & 0x1FFFFFL;
                    long mt = (self->mat_state >> 21) & 0x1FFFFFL;
                    if (mh == 0) {
                        self->mat_state = (self->mat_state & (1L << 62))
                                          | ((long)(mas + 1))
                                          | ((long)(mas + 1) << 21);
                    } else {
                        self->arena->nodes[(int)(mt - 1)].next = mas;
                        self->mat_state = (self->mat_state & (1L << 62))
                                          | mh | ((long)(mas + 1) << 21);
                    }
                }
                self->sup->lex_next();
                n = mv;
                continue;
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("[")) {
                /* P-7.2: a slice is its own type, so `s[i]` / `s[lo..hi]` and
                   an array's `a[lo..hi]` are recognised before the container
                   sugar. A plain `a[i]` on an array keeps C's unchecked
                   subscript (phase79 E79-4). */
                int svi = -1;
                int s_slice = 0;
                int s_array = 0;
                if (n >= 0 && self->arena->nodes[n].kind == N_VAR) {
                    svi = self->sym->find_var(self->arena->nodes[n].text2);
                    if (svi >= 0) {
                        s_slice = self->sym->vars[svi].is_slice;
                        s_array = self->sym->vars[svi].is_array && !s_slice
                                  && !self->sym->vars[svi].is_fnparam;
                    }
                }
                if (s_slice || (s_array && slice_range_ahead(self->lex))) {
                    int bl = self->lex->tokline;
                    self->sup->note_slice();
                    int bc = self->lex->tokstart - self->lex->lstart + 1;
                    char selem[MAX_TEXT];
                    int sc = s_slice ? self->sym->vars[svi].slice_const : 0;
                    int hi = -1;
                    snprintf(selem, sizeof selem, "%s",
                             s_slice ? self->sym->vars[svi].slice_elem
                                     : self->sym->vars[svi].type);
                    self->sup->lex_next();          /* `[` */
                    idx = self->parse_expr();
                    if (idx < 0) return -1;
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is("..")) {
                        self->sup->lex_next();
                        if (!(self->lex->tok == T_PUNCT
                              && self->lex->tok_is("]"))) {
                            hi = self->parse_expr();
                            if (hi < 0) return -1;
                        }
                        if (self->sup->expect("]") != 0) return -1;
                        /* P-4.1/P-7.2: a statically known array length makes
                           an out-of-range construction a hard error. An
                           inferred `[]` length and a slice base are checked at
                           run time by `__ct_slice_range` instead. */
                        if (s_array) {
                            int an = slice_array_len(self->sym->vars[svi].dims);
                            if (an >= 0 && self->arena->nodes[idx].kind == N_NUM) {
                                int lo = (int)self->arena->nodes[idx].num;
                                int hv = (hi < 0) ? an
                                         : (self->arena->nodes[hi].kind == N_NUM
                                            ? (int)self->arena->nodes[hi].num : -1);
                                if (hv >= 0 && (lo < 0 || hv < lo || hv > an)) {
                                    char semsg[MAX_TEXT + 96];
                                    snprintf(semsg, sizeof semsg,
                                             "slice construction out of bounds: [%d,%d) for length %d",
                                             lo, hv, an);
                                    return tool::diag::ct_sem_error(bl, bc, semsg,
                                                                    self->sup->mem->path);
                                }
                            }
                        }
                        m = self->sup->new_node(N_SLICE_RANGE);
                        if (m < 0) return -1;
                        self->arena->nodes[m].text = runtime::text::ct_intern(selem);
                        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                        self->arena->nodes[m].text2 = runtime::text::ct_intern(self->sym->vars[svi].cname);
                        if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                        self->arena->nodes[m].aux = s_array ? 1 : 2;
                        self->arena->nodes[m].a = n;
                        self->arena->nodes[m].b = idx;
                        self->arena->nodes[m].c = hi;
                        self->arena->nodes[m].line = bl;
                        self->arena->nodes[m].num = bc;
                        n = m;
                        continue;
                    }
                    if (!s_slice)
                        return self->sup->fail("expected '..' in a subslice");
                    if (self->sup->expect("]") != 0) return -1;
                    m = self->sup->new_node(N_SLICE_INDEX);
                    if (m < 0) return -1;
                    if (sc) {
                            self->arena->nodes[m].text = runtime::text::ct_internf("const %s", selem);
                            if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                    }
                    else
                        self->arena->nodes[m].text = runtime::text::ct_intern(selem);
                        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                    self->arena->nodes[m].aux = sc;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = idx;
                    self->arena->nodes[m].line = bl;
                    self->arena->nodes[m].num = bc;
                    n = m;
                    continue;
                }
                /* Phase 31 O3: `v[i]` is `v.get(i)` and `m[k]` is `m.get(k)`.
                   The base's static type names the container instance, so the
                   node is built exactly as an inherent method call would be
                   (aux 9: value receiver, emitted with `&`). A base this pass
                   cannot pin keeps C's subscript meaning. */
                char bty[MAX_TEXT];
                int bd = 0;
                int known = self->static_ctype(n, bty, sizeof bty, &bd, 0);
                int sugar = 0;
                /* PH-80: a built-in struct reached through a bare name can
                   still be spelled `String` / `Str` at this point (the
                   canonical `struct ` prefix is added by `parse_type` only
                   once the tag is known in this order). Normalise it so the
                   user-type subscript protocol below sees the struct. */
                if (known && bd == 0 && strchr(bty, '*') == 0
                    && strncmp(bty, "struct ", 7) != 0
                    && self->sym->find_struct(bty) >= 0) {
                    char nb[MAX_TEXT];
                    snprintf(nb, sizeof nb, "struct %s", bty);
                    snprintf(bty, sizeof bty, "%s", nb);
                }
                if (known && bd == 0 && strchr(bty, '*') == 0) {
                    if (strncmp(bty, "struct Vec_", 11) == 0
                        || strncmp(bty, "struct Map_", 11) == 0)
                        sugar = 1;
                }
                if (sugar) {
                    int rt, rd2;
                    int bl = self->lex->tokline;
                    int bc = self->lex->tokstart - self->lex->lstart + 1;
                    char rty[MAX_TEXT];
                    self->sup->lex_next();
                    idx = self->parse_expr();
                    if (idx < 0) return -1;
                    if (self->sup->expect("]") != 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].aux = 9;
                    /* L31-3/4: a write form points at the subscript itself */
                    self->arena->nodes[m].line = bl;
                    self->arena->nodes[m].num = bc;
                    self->arena->nodes[m].text = runtime::text::ct_intern(bty);
                    if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                    self->arena->nodes[m].text2 = runtime::text::ct_internf("get");
                    if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = idx;
                    /* A call receiver is an rvalue: the emitter names it in a
                       temporary before taking its address. The result type is
                       read here, while local names still resolve (`fp()`), and
                       left on the call node for that materialisation. */
                    rt = n;
                    while (rt >= 0 && (self->arena->nodes[rt].kind == N_MEMBER
                                       || self->arena->nodes[rt].kind == N_ARROW))
                        rt = self->arena->nodes[rt].a;
                    if (rt >= 0 && self->arena->nodes[rt].kind == N_CALL
                        && !self->arena->nodes[rt].text[0]) {
                        rd2 = 0;
                        if (self->static_ctype(rt, rty, sizeof rty, &rd2, 0)
                            && rd2 == 0)
                            self->arena->nodes[rt].text = runtime::text::ct_intern(rty);
                            if (!self->arena->nodes[rt].text) return self->sup->fail("out of memory");
                    }
                    n = m;
                    continue;
                }
                /* PH-62 S4: a container sugar node answers its element, so a
                   nested `Map<char *, Map<char *, int>>` lookup has a pointer
                   to the inner handle (`get` / `at` return `V *`). The next
                   subscript indexes the pointee, not the handle: wrap the
                   sugar in a deref and keep calling a method of the stripped
                   type. `at` creates a missing Map entry in place, so a write
                   chain (`m["a"]["b"] = 7`) always has a live inner handle and
                   the `put` rewrite below never emits `get(...)[k] = ...`
                   (W7). Only a sugar node is wrapped -- it carries the `[`
                   position; an explicit `x.get(k)` result keeps its C
                   meaning, exactly like the read-only rule above. */
                if (known && bd == 0 && strchr(bty, '*') != 0 && n >= 0
                    && self->arena->nodes[n].kind == N_MCALL
                    && self->arena->nodes[n].line > 0
                    && self->arena->nodes[n].num > 0
                    && (strcmp(self->arena->nodes[n].text2, "get") == 0
                        || strcmp(self->arena->nodes[n].text2, "at") == 0)) {
                    char pty[MAX_TEXT];
                    size_t pl;
                    int star, pointee_map, recv_map, bl, bc, d;
                    star = 0;
                    snprintf(pty, sizeof pty, "%s", bty);
                    pl = strlen(pty);
                    while (pl > 0 && pty[pl - 1] == ' ') {
                        pl--;
                        pty[pl] = 0;
                    }
                    if (pl > 0 && pty[pl - 1] == '*') {
                        star = 1;
                        pl--;
                        pty[pl] = 0;
                    }
                    while (pl > 0 && pty[pl - 1] == ' ') {
                        pl--;
                        pty[pl] = 0;
                    }
                    pointee_map = strncmp(pty, "struct Map_", 11) == 0 ? 1 : 0;
                    recv_map = strncmp(self->arena->nodes[n].text, "struct Map_", 11) == 0
                               || strncmp(self->arena->nodes[n].text, "Map_", 4) == 0;
                    if (star && strchr(pty, '*') == 0
                        && (pointee_map || strncmp(pty, "struct Vec_", 11) == 0)) {
                        bl = self->lex->tokline;
                        bc = self->lex->tokstart - self->lex->lstart + 1;
                        self->sup->lex_next();
                        idx = self->parse_expr();
                        if (idx < 0) return -1;
                        if (self->sup->expect("]") != 0) return -1;
                        d = self->sup->new_node(N_DEREF);
                        if (d < 0) return -1;
                        self->arena->nodes[d].a = n;
                        /* A Map receiver creates the missing entry so the
                           outer call (read `at` / write `put`) has a live
                           handle; a Vec receiver keeps `get`, whose
                           out-of-range answer is the zero handle the rest of
                           the chain reads (E31-24). The outer call itself is
                           `at` only for a Map pointee: `Vec::at` answers a
                           slot pointer, but a subscript names the value, and
                           Map's `get` pointer is the read shape the sugar has
                           always had. */
                        if (recv_map) {
                                self->arena->nodes[n].text2 = runtime::text::ct_internf("at");
                                if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
                        }
                        m = self->sup->new_node(N_MCALL);
                        if (m < 0) return -1;
                        self->arena->nodes[m].aux = 9;
                        self->arena->nodes[m].line = bl;
                        self->arena->nodes[m].num = bc;
                        self->arena->nodes[m].text = runtime::text::ct_intern(pty);
                        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                        self->arena->nodes[m].text2 = runtime::text::ct_intern(pointee_map ? "at" : "get");
                        if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                        self->arena->nodes[m].a = d;
                        self->arena->nodes[m].b = idx;
                        n = m;
                        continue;
                    }
                }
                /* PH-52 D52-2/D52-5: a non-pointer struct value with an
                   inherent `get` uses the same N_MCALL shape as the container
                   sugar. Missing / bad protocols are hard errors here -- the
                   parser never falls back to a C subscript for this branch.
                   Pointer receivers keep C pointer arithmetic (PH-51 / D52). */
                if (known && bd == 0 && strchr(bty, '*') == 0
                    && strncmp(bty, "struct ", 7) == 0
                    && strncmp(bty, "struct Vec_", 11) != 0
                    && strncmp(bty, "struct Map_", 11) != 0) {
                    int bl = self->lex->tokline;
                    int bc = self->lex->tokstart - self->lex->lstart + 1;
                    int gm, rt, rd2;
                    char rty[MAX_TEXT];
                    self->sup->lex_next();
                    idx = self->parse_expr();
                    if (idx < 0) return -1;
                    if (self->sup->expect("]") != 0) return -1;
                    gm = self->custom_index_method(bty, "get", 1, bl, bc, 0, idx);
                    if (gm < 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].aux = 9;
                    self->arena->nodes[m].line = bl;
                    self->arena->nodes[m].num = bc;
                    self->arena->nodes[m].text = runtime::text::ct_intern(bty);
                    if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                    self->arena->nodes[m].text2 = runtime::text::ct_internf("get");
                    if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = idx;
                    rt = n;
                    while (rt >= 0 && (self->arena->nodes[rt].kind == N_MEMBER
                                       || self->arena->nodes[rt].kind == N_ARROW))
                        rt = self->arena->nodes[rt].a;
                    if (rt >= 0 && self->arena->nodes[rt].kind == N_CALL
                        && !self->arena->nodes[rt].text[0]) {
                        rd2 = 0;
                        if (self->static_ctype(rt, rty, sizeof rty, &rd2, 0)
                            && rd2 == 0)
                            self->arena->nodes[rt].text = runtime::text::ct_intern(rty);
                            if (!self->arena->nodes[rt].text) return self->sup->fail("out of memory");
                    }
                    n = m;
                    continue;
                }
                /* V29-4: `v[3]` / `m["key"]` would be emitted as a subscript of
                   a C struct; refuse before the `[` is consumed so the error
                   carries its position. */
                if (self->container_index_check(n) != 0) return -1;
                self->sup->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->sup->expect("]") != 0) return -1;
                m = self->sup->new_node(N_INDEX);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].b = idx;
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && (self->lex->tok_is(".")
                                     || self->lex->tok_is("->"))) {
                int arrow;
                arrow = (self->lex->tok_first() == '-') ? 1 : 0;
                /* Phase 30: `.name` is the receiver sugar, so a pointer or a
                   left-value value receiver goes through `->` (the promoted
                   variable is a pointer in both cases). */
                if (!arrow) {
                    if (self->arena->nodes[n].kind == N_INTO_SELF
                        && self->arena->nodes[n].aux == 1) {
                        int ow = self->arena->nodes[n].num;
                        if (ow >= 0 && self->arena->nodes[ow].aux != 3) arrow = 1;
                    } else if (self->arena->nodes[n].kind == N_INTO
                               && self->arena->nodes[n].aux == 1) {
                        /* §2.8: a pointer receiver keeps its `->` spelling
                           after the block (`f(...) into { … }.close()`). */
                        arrow = 1;
                    }
                }
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a field or method name");
                self->lex->tok_copy(fname, sizeof fname);
                mline = self->lex->tokline;
                mcol = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                /* LANG-26: `x.as<T>()` is the explicit wide conversion. The
                   type argument is the target the lookup must answer; the
                   call takes no arguments. `as` only, no other method name
                   changes meaning. */
                if ((strcmp(fname, "as") == 0 || strcmp(fname, "to") == 0)
                    && self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                    char targ[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->parse_type(targ, sizeof targ) != 0) return -1;
                    if (self->sup->expect(">") != 0) return -1;
                    if (self->sup->expect("(") != 0) return -1;
                    if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")")))
                        return self->sup->fail("a conversion call takes no arguments");
                    self->sup->lex_next();
                    if (strcmp(fname, "to") == 0)
                        m = bind_conv_explicit_to(self, n, targ, mline, mcol);
                    else
                        m = bind_conv_explicit(self, n, targ, mline, mcol);
                    if (m < 0) return -1;
                    n = m;
                    continue;
                }
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
                    /* P-7.2: `s.get(i)` is the slice's soft access (out of
                       range answers 0) and is resolved before trait-method
                       dispatch; a slice has no vtable. */
                    if (!arrow && strcmp(fname, "get") == 0
                        && n >= 0 && self->arena->nodes[n].kind == N_VAR) {
                        int gvi = self->sym->find_var(self->arena->nodes[n].text2);
                        if (gvi >= 0 && self->sym->vars[gvi].is_slice) {
                            char gelem[MAX_TEXT];
                            self->sup->note_slice();
                            args = self->parse_args();
                            if (args < 0) return -1;
                            if (arg_count(self->arena, args) != 1)
                                return self->sup->fail("slice get() takes exactly one index");
                            m = self->sup->new_node(N_SLICE_GET);
                            if (m < 0) return -1;
                            snprintf(gelem, sizeof gelem, "%s",
                                     self->sym->vars[gvi].slice_elem);
                            if (self->sym->vars[gvi].slice_const) {
                                    self->arena->nodes[m].text = runtime::text::ct_internf("const %s", gelem);
                                    if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                            }
                            else
                                self->arena->nodes[m].text = runtime::text::ct_intern(gelem);
                                if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                            self->arena->nodes[m].aux = self->sym->vars[gvi].slice_const;
                            self->arena->nodes[m].a = n;
                            self->arena->nodes[m].b = args;
                            self->arena->nodes[m].line = mline;
                            self->arena->nodes[m].num = mcol;
                            n = m;
                            continue;
                        }
                    }
                    /* PH-53 L53-7: a method call whose receiver is an optional
                       chain is not supported (evaluation count undefined). */
                    if (self->arena->nodes[n].kind == N_OPT)
                        return tool::diag::ct_sem_error(mline, mcol,
                            "optional method calls are not supported; assign the receiver to a variable first",
                            self->sup->mem->path);
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                    self->arena->nodes[m].aux = arrow ? 2 : 1;
                    self->arena->nodes[m].text2 = runtime::text::ct_intern(fname);
                    if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs. Inside a trait's default body the
                       adopting struct is unknown, so a call on `self` names the
                       enclosing trait directly. */
                    if (self->sym->trait_default[0]
                        && self->arena->nodes[n].kind == N_VAR
                        && strcmp(self->arena->nodes[n].text2, "self") == 0) {
                        /* a forward sibling call (`a` calling a later `b`) is
                           legal, so the trait name is recorded without looking
                           the method up; the cycle check runs after the whole
                           trait has been parsed. */
                        self->arena->nodes[m].text = runtime::text::ct_intern(self->sym->trait_default);
                        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                    } else if (self->sup->expr_type(n, rtype, sizeof rtype) == 0) {
                        char ibase[MAX_TEXT];
                        size_t il;
                        int piface = 0;
                        int inm = -1;
                        /* a pointer to an interface value dispatches through
                           `->vt` instead of `.vt` */
                        snprintf(ibase, sizeof ibase, "%s", rtype);
                        il = strlen(ibase);
                        while (il > 0 && (ibase[il - 1] == ' ' || ibase[il - 1] == '*')) {
                            if (ibase[il - 1] == '*') piface = 1;
                            il--;
                            ibase[il] = 0;
                        }
                        /* Phase 28 (D28-2): inside a bounded template body the
                           receiver is the type parameter itself. The constraint
                           answers the method statically: record the trait and
                           the receiver form, and check the call against the
                           trait signature now, while the concrete type is still
                           unknown. The emitter spells the vtable from the
                           instance's type argument. */
                        if (self->in_generic_ntparam > 0 && self->in_generic_tparam[0]
                            && self->in_generic_bound[0]
                            && strcmp(ibase, self->in_generic_tparam[0]) == 0) {
                            char msgb[MAX_TEXT];
                            int bt, bmi = -1, bi2, bgot;
                            bt = self->sym->find_trait(self->in_generic_bound);
                            for (bi2 = 0; bt >= 0 && bi2 < self->sym->traits[bt].nm; bi2++)
                                if (strcmp(self->sym->traits[bt].m[bi2].name, fname) == 0) {
                                    bmi = bi2;
                                    break;
                                }
                            if (bmi < 0) {
                                snprintf(msgb, sizeof msgb,
                                         "trait '%s' has no method '%s'",
                                         self->in_generic_bound, fname);
                                return tool::diag::ct_sem_error(mline, mcol, msgb,
                                                                self->sup->mem->path);
                            }
                            bgot = arg_count(self->arena, args) + self->closure_arg_count(args);
                            if (self->arity_check(mline, mcol, fname, bgot,
                                                  self->sym->traits[bt].m[bmi].nparams) != 0)
                                return -1;
                            /* LANG-26 / D-020 §6.1: the constrained call is
                               a binding site too. */
                            if (self->closure_arg_count(args) == 0) {
                                int na = bind_outconv_rewrite(self, m, args, 1, bt, bmi,
                                                              "", mline, mcol);
                                if (na < 0) return -1;
                                args = na;
                                self->arena->nodes[m].b = (args == 0) ? -1 : args;
                            }
                            if (self->argtype_check(mline, mcol, fname, args, -1, bt, bmi) != 0)
                                return -1;
                            /* Phase 78 S2b: the bound trait's annotations
                               decide the actuals on a constrained call too. */
                            {
                                int ba = args;
                                int bai = 0;
                                while (ba > 0 && bai < self->sym->traits[bt].m[bmi].nparams) {
                                    if (check_refout_arg(self, ba,
                                            self->sym->traits[bt].m[bmi].pann[bai],
                                            self->sym->traits[bt].m[bmi].ptype + (bai) * MAX_TEXT) != 0)
                                        return -1;
                                    ba = self->arena->nodes[ba].next;
                                    bai++;
                                }
                            }
                            self->arena->nodes[m].aux = arrow ? 8 : 7;
                            self->arena->nodes[m].text = runtime::text::ct_intern(self->in_generic_bound);
                            if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                        } else if ((inm = self->inst_inherent_method(ibase, fname)) == -2) {
                            return tool::diag::ct_sem_error(mline, mcol,
                                "method is private to its unit", self->sup->mem->path);
                        } else if (inm >= 0) {
                            /* PH-51 D51-1 (selection A / L51-1): a pointer
                               receiver spelled with `.` would hand `S **` to
                               the method (`S_f(&p)`; the generic instance hides
                               it behind `void *self`). Require the arrow
                               spelling; the `->` path itself is unchanged. */
                            if (!arrow && piface) {
                                char pmsg[MAX_TEXT];
                                snprintf(pmsg, sizeof pmsg,
                                    "'.' cannot call method '%s' through a pointer receiver; use '->%s()'",
                                    fname, fname);
                                return tool::diag::ct_sem_error(mline, mcol, pmsg,
                                                                self->sup->mem->path);
                            }
                            /* Phase 31 S23b (L31-22): the loop reads the very
                               container the body would mutate. */
                            if ((strcmp(fname, "clear") == 0
                                 || strcmp(fname, "remove") == 0
                                 || strcmp(fname, "set") == 0
                                 || strcmp(fname, "put") == 0
                                 || strcmp(fname, "push") == 0)
                                && self->arena->nodes[n].kind == N_VAR
                                && iter_hit(self, self->arena->nodes[n].text2))
                                return tool::diag::ct_sem_error(mline, mcol,
                                    "cannot mutate the container being iterated; take a copy or collect the indices first",
                                    self->sup->mem->path);
            /* Phase 31 S23b (L31-23): the mutation moves the stored values, so
               every view of this container taken earlier is stale from here. */
            if ((strcmp(fname, "put") == 0
                 || strcmp(fname, "remove") == 0
                 || strcmp(fname, "clear") == 0
                 || strcmp(fname, "release") == 0)
                && self->arena->nodes[n].kind == N_VAR)
                view_mark(self, self->arena->nodes[n].text2);
                            /* Phase 31 S23a (L31-13 / L31-14): a borrow carries
                               no ownership, so releasing it would free storage
                               the container still owns -- whether the view is
                               the receiver itself (`g.get(0).release()`,
                               `item.release()`) or a local bound earlier
                               (`x = g.get(0); x.release();`). */
                            if (strcmp(fname, "release") == 0
                                && expr_borrow_root(self, n))
                                return tool::diag::ct_sem_error(mline, mcol,
                                    "cannot release a borrowed container view; call retain() first",
                                    self->sup->mem->path);
                            /* P-5.3 (SH-117): a `ref` parameter is an alias,
                               not an owner. The assignment site releases the
                               old value, so an explicit release through the
                               alias would free the caller's handle a second
                               time. `out` may still release: the caller hands
                               the old value over. */
                            if ((strcmp(fname, "release") == 0
                                 || strcmp(fname, "drop") == 0)
                                && self->arena->nodes[n].kind == N_VAR
                                && self->arena->nodes[n].aux == 2)
                                return tool::diag::ct_sem_error(mline, mcol,
                                    "cannot release through a 'ref' parameter; the callee does not own the handle (assign a new value instead)",
                                    self->sup->mem->path);
                            /* Phase 29: an inherent method of an instantiated
                               struct dispatches statically. The receiver's
                               concrete type is already in `ibase`, so the
                               emitter spells `<Inst>_<method>` and never reads
                               a vtable (D29: `impl` is a new branch, the trait
                               vptr paths are unchanged). */
                            int want = 0, pk;
                            for (pk = self->arena->nodes[inm].a; pk > 0;
                                 pk = self->arena->nodes[pk].next)
                                want++;
                            if (self->arity_check(mline, mcol, fname,
                                    arg_count(self->arena, args)
                                        + self->closure_arg_count(args), want) != 0)
                                return -1;
                            /* Phase 78 S2b: an inherent method carries its
                               ref/out annotations on its N_PARAM chain. */
                            {
                                int pi = self->arena->nodes[inm].a;
                                int pia = args;
                                while (pi > 0 && pia > 0) {
                                    if (check_refout_arg(self, pia,
                                            self->arena->nodes[pi].aux,
                                            self->arena->nodes[pi].text) != 0)
                                        return -1;
                                    pi = self->arena->nodes[pi].next;
                                    pia = self->arena->nodes[pia].next;
                                }
                            }
                            /* LANG-26 / D-020 §6.1: the same out write-back
                               on an inherent method's call site. The formal
                               chain is the method's own N_PARAM list and the
                               result comes from the instance substitution. */
                            {
                                char retm[MAX_TEXT];
                                retm[0] = 0;
                                if (self->sup->ty->inst_method_ret(ibase, fname,
                                                                   retm, sizeof retm)) {
                                    int na = bind_outconv_rewrite(self, m, args, 2,
                                                self->arena->nodes[inm].a, -1, retm,
                                                mline, mcol);
                                    if (na < 0) return -1;
                                    args = na;
                                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                                }
                            }
                            /* Phase 32 S7 (L32-6): bind, substitute, judge. */
                            if (self->types_mode && *self->types_mode) {
                                if (self->chk_mcall_args(ibase, fname, args) != 0)
                                    return -1;
                            }
                            /* L29-10 / L29-11: a container never stores an
                               `own` / `borrow` value, nor another container. */
                            if (frontend::sym::ct_is_container_type(ibase)
                                && (strcmp(fname, "push") == 0
                                    || strcmp(fname, "set") == 0
                                    || strcmp(fname, "put") == 0)) {
                                int ai, vi;
                                for (ai = args; ai > 0; ai = self->arena->nodes[ai].next) {
                                    char anm[MAX_TEXT];
                                    if (self->arena->nodes[ai].kind != N_VAR) continue;
                                    snprintf(anm, sizeof anm, "%s",
                                             self->arena->nodes[ai].text2);
                                    vi = self->sym->find_var(anm);
                                    if (vi < 0) continue;
                                    if (self->sym->vars[vi].autodrop
                                        || self->sym->vars[vi].borrowed)
                                        return tool::diag::ct_sem_error(mline, mcol,
                                            "a container cannot hold an 'own' or 'borrow' value",
                                            self->sup->mem->path);
                                }
                            }
                            /* Phase 31 S2: an interface formal boxes its
                               actual, exactly like a free-function call, so
                               `v.push(circle)` stores the fat pointer. The
                               bind is read from the instance, not from the
                               template spelling (`T` / `V`). */
                            {
                                int pi = self->arena->nodes[inm].a;
                                int ai = args, prev = -1, aidx = 0;
                                while (pi >= 0 && ai > 0) {
                                    char fty[MAX_TEXT];
                                    char ftr[MAX_TEXT];
                                    int fip = 0;
                                    if (self->inst_subst_type(ibase,
                                            self->arena->nodes[pi].text, fty, sizeof fty)) {
                                        /* LANG-22: the storing methods copy the
                                           element into the container; a
                                           non-immortal `Str` view there would
                                           outlive its owner. `index_of`-style
                                           readers take a `Str` too, so only the
                                           writers are judged. */
                                        if ((strcmp(fname, "push") == 0
                                             || strcmp(fname, "set") == 0
                                             || strcmp(fname, "put") == 0)
                                            && self->sup->str_store_warn(ai, fty,
                                                   (self->arg_base + aidx < self->argcap)
                                                       ? self->arg_line[self->arg_base + aidx] : mline,
                                                   (self->arg_base + aidx < self->argcap)
                                                       ? self->arg_col[self->arg_base + aidx] : mcol) != 0)
                                            return -1;
                                        if (self->sup->iface_ref_type(fty, ftr, sizeof ftr, &fip)) {
                                            int boxed = self->sup->maybe_box(ai, ftr, fip);
                                            if (boxed < 0) return -1;
                                            if (boxed != ai) {
                                                if (prev < 0) args = boxed;
                                                else self->arena->nodes[prev].next = boxed;
                                                self->arena->nodes[boxed].next =
                                                    self->arena->nodes[ai].next;
                                                ai = boxed;
                                            }
                                        }
                                    }
                                    prev = ai;
                                    ai = self->arena->nodes[ai].next;
                                    pi = self->arena->nodes[pi].next;
                                    aidx++;
                                }
                                self->arena->nodes[m].b = (args == 0) ? -1 : args;
                            }
                            self->arena->nodes[m].aux = arrow ? 10 : 9;
                            self->arena->nodes[m].text = runtime::text::ct_intern(ibase);
                            if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                        } else if (self->sup->is_iface_type(ibase, trname, sizeof trname)) {
                            int t = self->sym->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                                    if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                self->arena->nodes[m].aux = piface ? 4 : 3;
                                self->arena->nodes[m].text = runtime::text::ct_intern(trname);
                                if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                            }
                        } else if (self->sup->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            char tr2[MAX_TEXT];
                            /* PH-51 D51-1: the same pointer-receiver defect on
                               the trait dispatch path; an interface pointer
                               ('.vt' dispatch) was handled above and keeps its
                               dot spelling. */
                            if (!arrow && piface) {
                                char pmsg[MAX_TEXT];
                                snprintf(pmsg, sizeof pmsg,
                                    "'.' cannot call method '%s' through a pointer receiver; use '->%s()'",
                                    fname, fname);
                                return tool::diag::ct_sem_error(mline, mcol, pmsg,
                                                                self->sup->mem->path);
                            }
                            self->arena->nodes[m].text = runtime::text::ct_intern(trname);
                            if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                            /* 19.3 (SH-46): a second trait of the same struct
                               declaring the method means the bare call keeps
                               the first match in `use` order silently (the spec
                               pins that resolution) -- name both in a warning.
                               A static type host and a `map` binding resolve
                               below, outside `method_trait`, so they never
                               reach this check. */
                            if (self->sup->method_trait_amb(rtype, fname, trname,
                                                            tr2, sizeof tr2) == 0) {
                                char amsg[MAX_TEXT];
                                snprintf(amsg, sizeof amsg,
                                         "declared by '%s' and '%s'; '%s' is used",
                                         trname, tr2, trname);
                                if (self->sup->amb_warn(mline, mcol, fname, amsg) != 0)
                                    return self->sup->fail("too many warnings");
                            }
                        }
                        /* No trait answered: a function-pointer field called
                           directly is the callee itself, so `o.add(2, 3)` is
                           a call through `o.add` -- the shape `p(x)` takes, but
                           with a member node as the callee (D-4). */
                        if (!self->arena->nodes[m].text[0] && self->fnptr_field(rtype, fname)) {
                            int mf;
                            char fpt[MAX_TEXT];
                            int fad = 0;
                            mf = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                            if (mf < 0) return -1;
                            self->arena->nodes[mf].a = n;
                            self->arena->nodes[mf].text2 = runtime::text::ct_intern(fname);
                            if (!self->arena->nodes[mf].text2) return self->sup->fail("out of memory");
                            self->arena->nodes[m].kind = N_CALL;
                            self->arena->nodes[m].a = (args == 0) ? -1 : args;
                            self->arena->nodes[m].b = mf;
                            self->arena->nodes[m].aux = 2;
                            /* SH-115: the call is the member expression, so
                               the prototype comes from the field's type --
                               the residual path LANG-19 left open. */
                            if (self->types_mode && *self->types_mode
                                && self->static_ctype(mf, fpt, sizeof fpt, &fad, 0)
                                && fad == 0
                                && self->chk_callptr_args(fpt, fname, args, mline, mcol) != 0)
                                return -1;
                        }
                        /* Still unresolved: the method may belong to a static
                           type host (`map ... for type char *`). Keep the call
                           as an N_MCALL, record the receiver's static type
                           (locals are gone by emit time) and let the emitter
                           match it against the visible static maps. */
                        if (!self->arena->nodes[m].text[0]
                            && self->arena->nodes[m].kind == N_MCALL) {
                            char it[MAX_TEXT];
                            if (!self->sup->is_iface_type(rtype, it, sizeof it)) {
                                char rt2[MAX_TEXT];
                                snprintf(rt2, sizeof rt2, "%s", rtype);
                                if (self->arena->nodes[n].kind == N_VAR) {
                                    int vi = self->sym->find_var(self->arena->nodes[n].text2);
                                    if (vi >= 0 && self->sym->vars[vi].is_array
                                        && strlen(rt2) + 2 < sizeof rt2)
                                        strcat(rt2, " *");
                                }
                                self->arena->nodes[m].aux = 6;
                                self->arena->nodes[m].text = runtime::text::ct_intern(rt2);
                                if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                                /* P20-03: the emitter picks the map, so the
                                   arity check beside the resolved-method path
                                   never sees this call. Every visible binding
                                   records the method it expands to, so the
                                   count is still knowable here: one accepting
                                   candidate is enough, and a call no candidate
                                   accepts is reported in the same words as a
                                   resolved method. The map table belongs to the
                                   parser but the type object already points at
                                   it, so this unit needs no new plumbing. */
                                {
                                    struct MapTable *hm;
                                    int hn, mi2, bi2, want = 0, seen = 0, afits = 0, fits = 0;
                                    int pt = -1, pm = -1;
                                    /* SH-60 / D-60-1: the receiver check
                                       needs the selected method's `mut` flag.
                                       As with the type comparison, only an
                                       arity-fitting candidate can be selected;
                                       one non-`mut` candidate keeps the call
                                       quiet (the emitter may pick it). */
                                    int mut_any = 0, mut_plain = 0;
                                    int got2 = arg_count(self->arena, args)
                                               + self->closure_arg_count(args);
                                    char rk[MAX_TEXT];
                                    char tk[MAX_TEXT];
                                    char msg[MAX_TEXT];
                                    char tmsg[MAX_TEXT];
                                    tmsg[0] = 0;
                                    hm = *self->sup->ty->maps;
                                    hn = *self->sup->ty->nmaps;
                                    /* the same host key the emitter and the
                                       type pass compare with: `tnorm` only
                                       drops qualifiers, so `unsigned` and
                                       `unsigned int` would miss each other
                                       here while the recipe still expands,
                                       dropping a surplus actual in silence */
                                    frontend::type::type_key(rt2, rk, sizeof rk);
                                    for (mi2 = 0; mi2 < hn; mi2++) {
                                        if (hm[mi2].is_binding) continue;
                                        if (!hm[mi2].is_static
                                            || !hm[mi2].type_host) continue;
                                        frontend::type::type_key(hm[mi2].host_type, tk, sizeof tk);
                                        if (strcmp(tk, rk) != 0) continue;
                                        for (bi2 = 0; bi2 < hm[mi2].nb; bi2++) {
                                            int want2, tail2, tt, tm, arity_ok;
                                            if (strcmp(hm[mi2].b[bi2].method,
                                                       fname) != 0) continue;
                                            /* a type-host binding names the
                                               receiver first */
                                            want2 = hm[mi2].b[bi2].nparams
                                                    - hm[mi2].b[bi2].recv;
                                            /* a recipe that forwards a tail
                                               (`printf(fmt, ...)`) makes the
                                               count a lower bound; the map
                                               builder only accepts `...` when
                                               the binding declares it, so the
                                               recipe text is the marker */
                                            tail2 = strstr(hm[mi2].b[bi2].call,
                                                           "...") != 0;
                                            if (!seen) want = want2;
                                            seen = 1;
                                            /* 25.1: the signature is needed
                                               for the closure check even when
                                               the closure itself makes the
                                               count miss, so resolve it before
                                               the arity gate. Two packages may
                                               bind the same host and method with
                                               different signatures, so every
                                               arity-fitting candidate is asked;
                                               one accepting is enough. */
                                            tt = self->sym->find_trait(hm[mi2].trait);
                                            tm = -1;
                                            if (tt >= 0) {
                                                for (tm = 0; tm < self->sym->traits[tt].nm; tm++)
                                                    if (strcmp(self->sym->traits[tt].m[tm].name,
                                                               fname) == 0) break;
                                                if (tm >= self->sym->traits[tt].nm) tm = -1;
                                            }
                                            if (tt >= 0 && tm >= 0 && pt < 0) {
                                                pt = tt;
                                                pm = tm;
                                            }
                                            arity_ok = tail2 ? got2 >= want2
                                                             : got2 == want2;
                                            if (!arity_ok) continue;
                                            afits = 1;
                                            if (tt >= 0 && tm >= 0) {
                                                if (self->sym->traits[tt].m[tm].is_mut)
                                                    mut_any++;
                                                else mut_plain++;
                                            }
                                            if (tt < 0 || tm < 0) {
                                                fits = 1;
                                                continue;
                                            }
                                            if (!self->argtype_mismatch(args, -1, tt, tm,
                                                                        tmsg, sizeof tmsg))
                                                fits = 1;
                                        }
                                    }
                                    /* A closure in a non-pair position is
                                       L25-1 whatever the count says: the
                                       generic "fewer arguments" wording would
                                       hide the real fault. */
                                    if (seen && pt >= 0 && pm >= 0
                                        && self->map_closure_check(mline, mcol, args,
                                                                   pt, pm) != 0)
                                        return -1;
                                    if (seen && !afits) {
                                        snprintf(msg, sizeof msg,
                                                 "takes %d argument(s), %d given",
                                                 want, got2);
                                        if (self->sup->arity_warn(mline, mcol, fname,
                                                                  msg) != 0)
                                            return self->sup->fail("too many warnings");
                                    } else if (seen && afits && !fits) {
                                        /* SH-60: every arity-fitting candidate
                                           disagreed with an actual, so this is
                                           a hard error -- see
                                           `argtype_check_static`. */
                                        snprintf(msg, sizeof msg,
                                                 "type mismatch: '%s' %s", fname, tmsg);
                                        tool::diag::ct_sem_error(mline, mcol, msg,
                                                                 self->sup->mem->path);
                                        return -1;
                                    }
                                    /* SH-60 / D-60-1: a method that writes
                                       its receiver cannot target a literal or
                                       a top-level const value. */
                                    if (mut_any > 0 && mut_plain == 0
                                        && self->recv_mut_check(n, rt2, 1,
                                                                mline, mcol, fname) != 0)
                                        return -1;
                                }
                            }
                        }
                    }
                } else {
                    if (self->into_member_check(n, fname, mline, mcol) != 0)
                        return -1;
                    /* LANG-5: a `.` field access on a call / custom-subscript
                       result used to be emitted verbatim (`Box_get(...).v`).
                       For a pointer or an interface answer that C is invalid,
                       so the host cc -- not ct -- rejected it, with no
                       `file:line:col` pointing at the source. The receiver's
                       static type is still resolvable here (locals are gone by
                       emit time), so refuse the two shapes the emitter cannot
                       spell. `self.n` is exempt: inside an inherent impl the
                       emitter already spells it `_self->n` (P34 S5a). A value
                       answer needs no temporary: `f().v` is valid C. */
                    if (!arrow) {
                        char frty[MAX_TEXT];
                        char ifn[MAX_TEXT];
                        int ifp = 0;
                        int self_recv = n >= 0
                                        && self->arena->nodes[n].kind == N_VAR
                                        && strcmp(self->arena->nodes[n].text2, "self") == 0;
                        if (!self_recv
                            && self->sup->expr_type(n, frty, sizeof frty) == 0) {
                            /* `struct Vec_Show__iface` also ends in `_iface`
                               (a container of an interface element), so the
                               suffix alone is not an interface value; and an
                               interface value keeps one real field, `.self`. */
                            if (!frontend::sym::ct_is_container_type(frty)
                                && strcmp(fname, "self") != 0
                                && self->sup->iface_ref_type(frty, ifn, sizeof ifn, &ifp)
                                && self->sym->find_trait(ifn) >= 0) {
                                char imsg[MAX_TEXT];
                                snprintf(imsg, sizeof imsg,
                                    "'.' cannot access field '%s': '%s' is an interface value; "
                                    "it has methods, not fields", fname, ifn);
                                return tool::diag::ct_sem_error(mline, mcol, imsg,
                                                                self->sup->mem->path);
                            }
                            {
                                size_t fl = strlen(frty);
                                while (fl > 0 && (frty[fl - 1] == ' ' || frty[fl - 1] == '\t'))
                                    fl--;
                                if (fl > 0 && frty[fl - 1] == '*') {
                                    char pmsg[MAX_TEXT];
                                    snprintf(pmsg, sizeof pmsg,
                                        "'.' cannot access field '%s' through a pointer receiver; "
                                        "use '->%s'", fname, fname);
                                    return tool::diag::ct_sem_error(mline, mcol, pmsg,
                                                                    self->sup->mem->path);
                                }
                            }
                        }
                    }
                    /* PH-80 (D-013 §2): the handle's `ptr` is the raw
                       implementation field. Reading it would bypass the
                       read-only `.data` view and `cstr()`, so only the built-in
                       layer may name it; every other unit gets a positioned
                       diagnostic instead of a silent escape hatch. */
                    if (strcmp(fname, "ptr") == 0
                        && !(self->sup->mem->path
                             && (strstr(self->sup->mem->path, "lib/core/Str.h.ct") != 0
                                 || strstr(self->sup->mem->path, "lib/core/String.h.ct") != 0
                                 || strstr(self->sup->mem->path, "lib/core/utf16/U16Str.h.ct") != 0
                                 || strstr(self->sup->mem->path, "lib/core/utf16/U16String.h.ct") != 0
                                 || strstr(self->sup->mem->path, "lib/std/Str.h.ct") != 0))) { /* DOC-87 迁移回退 */
                        char rty[MAX_TEXT];
                        if (self->sup->expr_type(n, rty, sizeof rty) == 0) {
                            const char *rp = rty;
                            size_t rn;
                            char rb[64];
                            while (*rp == ' ' || *rp == '\t') rp++;
                            if (strncmp(rp, "struct ", 7) == 0) rp += 7;
                            rn = strlen(rp);
                            while (rn > 0 && (rp[rn - 1] == ' ' || rp[rn - 1] == '\t'))
                                rn--;
                            if (rn > 0 && rn < sizeof rb
                                && memchr(rp, '*', rn) == 0) {
                                memcpy(rb, rp, rn);
                                rb[rn] = 0;
                                if (strcmp(rb, "String") == 0 || strcmp(rb, "Str") == 0
                                    || strcmp(rb, "U16String") == 0
                                    || strcmp(rb, "U16Str") == 0)
                                    return tool::diag::ct_sem_error(mline, mcol,
                                        "'.ptr' is a raw implementation field; use s[i] / .data[i] or cstr()",
                                        self->sup->mem->path);
                            }
                        }
                    }
                    /* PH-80 (D-013 §2): `.data` is the read-only raw view, not
                       a field. Its static type is `const char *` (UTF-8) or
                       `const uint16_t *` (UTF-16); the emitter spells it as
                       the handle's `ptr`, so `String` / `Str` keep their
                       16-byte layout. It has no NUL guarantee and no implicit
                       `char *` conversion, so `cstr()` is the only C-boundary
                       exit: the value may only be indexed (`s.data[i]`), never
                       handed to a callee (`printf("%s", s.data)` is a hard
                       error). */
                    {
                        char dty[MAX_TEXT];
                        char dbase[MAX_TEXT];
                        const char *dp;
                        size_t dn;
                        if (strcmp(fname, "data") == 0
                            && self->sup->expr_type(n, dty, sizeof dty) == 0) {
                            dp = dty;
                            while (*dp == ' ' || *dp == '\t') dp++;
                            if (strncmp(dp, "struct ", 7) == 0) dp += 7;
                            dn = strlen(dp);
                            while (dn > 0 && (dp[dn - 1] == ' ' || dp[dn - 1] == '\t'))
                                dn--;
                            if (dn < sizeof dbase) {
                                int aux = 0;
                                memcpy(dbase, dp, dn);
                                dbase[dn] = 0;
                                if (strchr(dbase, '*') == 0) {
                                    if (strcmp(dbase, "String") == 0
                                        || strcmp(dbase, "Str") == 0) aux = 9;
                                    else if (strcmp(dbase, "U16String") == 0
                                             || strcmp(dbase, "U16Str") == 0) aux = 11;
                                }
                                if (aux != 0) {
                                    if (!(self->lex->tok == T_PUNCT
                                          && self->lex->tok_is("[")))
                                        return tool::diag::ct_sem_error(mline, mcol,
                                            "'.data' is a read-only raw view without a NUL guarantee; index it byte by byte or use cstr() at the C boundary",
                                            self->sup->mem->path);
                                    m = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                                    if (m < 0) return -1;
                                    self->arena->nodes[m].aux = aux;
                                    self->arena->nodes[m].line = mline;
                                    self->arena->nodes[m].num = mcol;
                                    self->arena->nodes[m].text2 = runtime::text::ct_internf("ptr");
                                    if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                                    self->arena->nodes[m].a = n;
                                    self->arena->nodes[m].b = -1;
                                    n = m;
                                    continue;
                                }
                            }
                        }
                    }
                    {
                        int bm = self->Box_member_deref(n, arrow, fname, mline, mcol, &m);
                        if (bm < 0) return -1;
                        if (!bm) {
                            m = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                            if (m < 0) return -1;
                            self->arena->nodes[m].a = n;
                            self->arena->nodes[m].text2 = runtime::text::ct_intern(fname);
                            if (!self->arena->nodes[m].text2) return self->sup->fail("out of memory");
                        }
                    }
                }
                /* 19.1: a resolved trait method is compared against the call's
                   argument count. A static trait (a `.m.ct` recipe), a `map`
                   binding (the receiver's type stays in `text`) and a call
                   through a function-pointer field (`kind` became N_CALL) are
                   all unknown here and pass. `arity_check` only reports, so the
                   generated call is unchanged. */
                if (self->arena->nodes[m].kind == N_MCALL
                    && self->arena->nodes[m].text[0]) {
                    int t = self->sym->find_trait(self->arena->nodes[m].text);
                    if (t >= 0) {
                        int mi;
                        for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                            if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) break;
                        /* a static recipe must still agree on the count: the
                           surplus is only legal when the recipe forwards it */
                        if (mi < self->sym->traits[t].nm
                            && self->map_arity(mline, mcol, self->arena->nodes[m].text,
                                               fname, arg_count(self->arena, args)
                                                     + self->closure_arg_count(args)) != 0)
                            return -1;
                        /* SH-65/SH-67: refuse a closure on a struct/trait method
                           until the pair ABI is emitted; container `each` has
                           its own expansion and is exempt. */
                        {
                            int ca;
                            int pair_ok = (mi < self->sym->traits[t].nm
                                           && self->sym->traits[t].m[mi].nparams == 2
                                           && strstr(self->sym->traits[t].m[mi].ptype + (1) * MAX_TEXT, "void *"));
                            for (ca = args; ca >= 0; ca = self->arena->nodes[ca].next) {
                                int is_cl = 0, clnode = -1;
                                if (self->arena->nodes[ca].kind == N_CLOSURE) {
                                    is_cl = 1;
                                    clnode = ca;
                                } else if (self->arena->nodes[ca].kind == N_VAR) {
                                    int cv = self->sym->find_var(self->arena->nodes[ca].text2);
                                    if (cv >= 0 && self->sym->vars[cv].is_closure) is_cl = 1;
                                }
                                if (!is_cl) continue;
                                if (clnode >= 0 && pair_ok
                                    && mi < self->sym->traits[t].nm) {
                                    if (closure_match(self,
                                            (int)self->arena->nodes[clnode].num,
                                            self->sym->traits[t].m[mi].ptype + (0) * MAX_TEXT, 1, 1) != 0)
                                        return -1;
                                    continue;
                                }
                                if (!frontend::sym::ct_is_container_type(rtype))
                                    return tool::diag::ct_sem_error(mline, mcol,
                                        "a closure cannot be passed to a method argument yet (SH-65); pass '(fn, env)' explicitly",
                                        self->sup->mem->path);
                            }
                        }
                        /* LANG-26 / D-020 §6.1: a trait method's convertible
                           `out` actual gets the same temporary + write-back. */
                        if (!self->sym->traits[t].is_static
                            && mi < self->sym->traits[t].nm
                            && self->closure_arg_count(args) == 0) {
                            int na = bind_outconv_rewrite(self, m, args, 1, t, mi,
                                                          "", mline, mcol);
                            if (na < 0) return -1;
                            args = na;
                            self->arena->nodes[m].b = (args == 0) ? -1 : args;
                        }
                        /* 19.2: the argument types against the resolved trait
                           method, same rules as a function call. */
                        if (!self->sym->traits[t].is_static
                            && mi < self->sym->traits[t].nm
                            && self->argtype_check(mline, mcol, fname, args, -1, t, mi) != 0)
                            return -1;
                        /* Phase 78 S2b: a trait method's ref/out actuals obey
                           the same place/owning rules as a free function. */
                        if (!self->sym->traits[t].is_static
                            && mi < self->sym->traits[t].nm) {
                            int ma = args;
                            int mai = 0;
                            while (ma > 0 && mai < self->sym->traits[t].m[mi].nparams) {
                                if (check_refout_arg(self, ma,
                                        self->sym->traits[t].m[mi].pann[mai],
                                        self->sym->traits[t].m[mi].ptype + (mai) * MAX_TEXT) != 0)
                                    return -1;
                                ma = self->arena->nodes[ma].next;
                                mai++;
                            }
                        }
                    }
                }
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
                /* a call through a pointer expression: `(*p)(x)` (D-7). A plain
                   `name(...)` was already consumed by `parse_primary`. */
                {
                    int pcl = self->lex->tokline;
                    int pcc = self->lex->tokstart - self->lex->lstart + 1;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->sup->new_node(N_CALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = (args == 0) ? -1 : args;
                    self->arena->nodes[m].b = n;
                    self->arena->nodes[m].aux = 2;
                    /* SH-115: the callee is an expression, so its spelling
                       carries the prototype (`int (*)(int)`); judge the
                       actuals the same way a named call judges them. A callee
                       whose type the tables cannot pin stays silent. */
                    if (self->types_mode && *self->types_mode) {
                        char ppt[MAX_TEXT];
                        char lbl[MAX_TEXT];
                        int pad = 0;
                        int typed = 0;
                        if (self->static_ctype(n, ppt, sizeof ppt, &pad, 0) && pad == 0) {
                            typed = 1;
                        } else if (self->arena->nodes[n].kind == N_DEREF) {
                            /* `(*p)` where `p` already *is* the function
                               pointer: dereferencing a function pointer
                               yields the same function pointer, so its
                               spelling is the one to judge. */
                            int dn = self->arena->nodes[n].a;
                            char dty[MAX_TEXT];
                            int dad = 0;
                            if (self->static_ctype(dn, dty, sizeof dty, &dad, 0)
                                && dad == 0 && strstr(dty, "(*")) {
                                snprintf(ppt, sizeof ppt, "%s", dty);
                                typed = 1;
                            }
                        }
                        if (typed) {
                            lbl[0] = 0;
                            if (self->arena->nodes[n].kind == N_VAR) {
                                snprintf(lbl, sizeof lbl, "%s", self->arena->nodes[n].text2);
                            } else if (self->arena->nodes[n].kind == N_DEREF
                                       && self->arena->nodes[self->arena->nodes[n].a].kind
                                          == N_VAR) {
                                snprintf(lbl, sizeof lbl, "%s",
                                         self->arena->nodes[self->arena->nodes[n].a].text2);
                            } else {
                                snprintf(lbl, sizeof lbl, "%s", "function pointer");
                            }
                            if (self->chk_callptr_args(ppt, lbl, args, pcl, pcc) != 0)
                                return -1;
                        }
                    }
                }
                n = m;
                continue;
            }
            /* Phase 44: `expr?` is the error-propagation suffix when the token
               after `?` cannot start an expression; otherwise the `?` belongs
               to the conditional operator one level up (`parse_expr`), so the
               postfix loop stops here without consuming it. */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("?")) {
                int qline, qcol;
                char qty[MAX_TEXT];
                int qad = 0;
                int okind, oline, ocol;
                /* PH-53: `?.` / `?[` are parser combinations, not lexer
                   tokens. `?.5` must fall through to the conditional operator
                   (T1), so the lookahead never consumes. */
                okind = self->opt_suffix_kind();
                if (okind != 0) {
                    oline = self->lex->tokline;
                    ocol = self->lex->tokstart - self->lex->lstart + 1;
                    self->sup->lex_next();      /* the `?` */
                    if (okind == 1) {
                        self->sup->lex_next();  /* the `.` */
                        if (self->lex->tok != T_ID)
                            return self->sup->fail("expected a field name after '?.'");
                        self->lex->tok_copy(fname, sizeof fname);
                        self->sup->lex_next();
                        if (self->lex->tok == T_PUNCT
                            && self->lex->tok_is("("))
                            return tool::diag::ct_sem_error(oline, ocol,
                                "optional method calls are not supported; assign the receiver to a variable first",
                                self->sup->mem->path);
                        m = self->opt_field(n, fname, oline, ocol);
                        if (m < 0) return -1;
                        n = m;
                        continue;
                    }
                    self->sup->lex_next();      /* the `[` */
                    idx = self->parse_expr();
                    if (idx < 0) return -1;
                    if (self->sup->expect("]") != 0) return -1;
                    m = self->opt_subscript(n, idx, oline, ocol);
                    if (m < 0) return -1;
                    n = m;
                    continue;
                }
                if (!self->q_suffix_ahead()) break;
                qline = self->lex->tokline;
                qcol = self->lex->tokstart - self->lex->lstart + 1;
                /* L44-4: the expansion returns from the function, so a `?`
                   inside an unevaluated / condition position or a deferred
                   body would change control flow; a file-scope `?` has no
                   function to return from. `ret_type` (not `cur_func`) is the
                   test: a trait default body is a function too (PH-44 §3.3). */
                if (self->try_ban > 0 || !self->sym->ret_type[0]
                    || self->into_node >= 0)
                    return tool::diag::ct_sem_error(qline, qcol,
                        "'?' is not allowed here", self->sup->mem->path);
                self->sup->lex_next();
                m = self->sup->new_node(N_TRY);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].line = qline;
                self->arena->nodes[m].num = qcol;
                /* The operand's static type is read while its locals are still
                   in scope; the emitter runs after the scopes are popped, so it
                   cannot resolve a variable operand on its own. */
                if (self->static_ctype(n, qty, sizeof qty, &qad, 0) && qad == 0) {
                        self->arena->nodes[m].text = runtime::text::ct_intern(qty);
                        if (!self->arena->nodes[m].text) return self->sup->fail("out of memory");
                }
                /* Capture the failure cleanup now, while the defer stack and
                   the `own` list still describe this point (the emitter runs
                   after the scopes are gone). */
                if (!self->st_hook)
                    return self->sup->fail("the statement parser is not bound");
                if (self->st_hook(1, m) != 0) return -1;
                n = m;
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && (self->lex->tok_is("++") || self->lex->tok_is("--"))) {
            int k;
            if (is_range_index(self->arena, n))
                return self->sup->fail("the range index '$' is not a variable");
            /* PH-53 L53-6. */
            if (self->opt_lvalue_check(n, self->arena->nodes[n].line,
                                       self->arena->nodes[n].num) != 0)
                return -1;
            /* Phase 31 O3 (L31-3/L31-4): `v[i]++` writes the value. */
            if (self->container_write_check(n) != 0) return -1;
            k = self->arena->nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->sup->fail("'++' / '--' need an assignable target");
            m = self->sup->new_node(N_POST);
            if (m < 0) return -1;
            self->arena->nodes[m].a = n;
            self->arena->nodes[m].aux = (self->lex->tok_first() == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            return m;
        }
        return n;
    }

    /* A closure literal `(params) => expr` (Phase 21 S2). The cursor sits on
       the `(`. The literal gets its own parameter scope; a name the body uses
       that resolves below `pstart` is a capture, so a parameter that shadows an
       outer variable keeps the outer one out (D21-2). Names and types are
       copied into the closure table before the scope is popped, because the
       symbol slots are reused. S2 parses and checks only: nothing is emitted. */
    int parse_primary(void)
    {
        int n, args, id_line, id_col;
        char qc[MAX_TEXT];
        char qv[MAX_TEXT];
        char tsrc[MAX_TEXT];
        /* S1a-0 C2n-2: `parse_qual_path` takes its in/out name in a scratch
           buffer now that the node row is an immutable pool pointer; the
           resulting segment is interned back into `text2`. */
        char nbuf[MAX_TEXT];
        char tag[MAX_TEXT];
        int qf;
        int nu, nl, sl;
        (void)self;

        qc[0] = 0;
        qv[0] = 0;
        /* PH-81 S1b: `new T { ... }` builds a `Box<T>`; `new` stays an ordinary
           identifier everywhere else (contextual keyword). */
        if (self->new_ahead()) return self->parse_new_expr();
        /* C11 `_Generic(…)` is a pass-through: the whole selection is copied
           into the string pool (`N_RAW`, `aux = 1`, `num` = offset) and handed
           to the C compiler, which owns the arm choice. ct does not read the
           arms, so a trait call or a boxing inside one is not rewritten. */
        if (self->lex->tok == T_ID && self->lex->tok_is("_Generic")) {
            char gname[MAX_TEXT];
            int off, depth, k, prev_tag;
            n = self->sup->new_node(N_RAW);
            if (n < 0) return -1;
            off = self->arena->str_begin();
            snprintf(gname, sizeof gname, "%s", "_Generic");
            for (k = 0; gname[k]; k++)
                if (self->arena->str_put(gname[k]) != 0)
                    return self->sup->fail("string pool is full");
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || !self->lex->tok_is("("))
                return self->sup->fail("expected '(' after _Generic");
            depth = 0;
            prev_tag = 0;
            for (;;) {
                char tbuf[MAX_TEXT];
                int m;
                if (self->lex->tok == T_EOF) return self->sup->fail("unterminated _Generic");
                if (self->arena->str_put(' ') != 0)
                    return self->sup->fail("string pool is full");
                /* an integer token keeps its value, not its spelling */
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                else
                    self->lex->tok_copy(tbuf, sizeof tbuf);
                /* the body is copied verbatim, so a bare type parameter here
                   would reach the output as an undeclared name; refuse it
                   instead of emitting bad C (SH-62). `struct T` / `union T` /
                   `enum T` is a tag, not the parameter, so it stays legal. */
                if (self->in_generic && expr_generic_param(self, tbuf) && !prev_tag)
                    return self->sup->fail("type parameter cannot be used inside _Generic");
                prev_tag = strcmp(tbuf, "struct") == 0 || strcmp(tbuf, "union") == 0
                           || strcmp(tbuf, "enum") == 0;
                for (m = 0; tbuf[m]; m++)
                    if (self->arena->str_put(tbuf[m]) != 0)
                        return self->sup->fail("string pool is full");
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) depth++;
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
                    depth--;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            self->arena->nodes[n].aux = 1;
            return n;
        }
        if (self->lex->tok == T_NUM) {
            /* an integer keeps its value (`long`, emitted in decimal); a
               floating literal keeps its spelling, since neither the value nor
               the `f` / `L` suffix survives a `long` */
            n = self->sup->new_node(self->lex->tokfloat ? N_FNUM : N_NUM);
            if (n < 0) return -1;
            if (self->lex->tokfloat) {
                    self->arena->nodes[n].text = runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len);
                    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
            }
            else {
                self->arena->nodes[n].num = self->lex->toknum;
                /* An integer suffix is spelling, not value: `U` may appear once
                   and `L` twice, and the emitted form always orders them U then
                   L (`uLL`, `LLu`, `lL` all become `ULL` / `LL`). */
                nu = 0;
                nl = 0;
                for (sl = 0; sl < self->lex->toksuffix.len; sl++) {
                    char sfx = self->lex->toksuffix.ptr[sl];
                    if (sfx == 'u' || sfx == 'U') nu++;
                    else nl++;
                }
                if (nu > 1 || nl > 2 || sl > 3)
                    return self->sup->fail("an integer suffix may be U, L or LL");
                if (nu && nl == 2) self->arena->nodes[n].text = runtime::text::ct_intern("ULL");
                else if (nu && nl == 1) self->arena->nodes[n].text = runtime::text::ct_intern("UL");
                else if (nu) self->arena->nodes[n].text = runtime::text::ct_intern("U");
                else if (nl == 2) self->arena->nodes[n].text = runtime::text::ct_intern("LL");
                else if (nl == 1) self->arena->nodes[n].text = runtime::text::ct_intern("L");
                if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
            }
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_STR) {
            int off = self->arena->str_begin();
            n = self->sup->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (self->lex->tok == T_STR) {
                int m = 0;
                if (self->lex->toktrunc)
                    return self->sup->fail("string literal exceeds 65536 bytes; split it");
                while (m < self->lex->tokstr.len) {
                    if (self->arena->str_put((unsigned char)self->lex->tokstr.ptr[m]) != 0)
                        return self->sup->fail("string pool is full");
                    m++;
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            return n;
        }
        /* `offsetof(<struct type>, <field>)` is a builtin, not a macro: CT has
           no preprocessor, so the compiler recognises it here and the generated
           `.c` keeps the same call (D-8). */
        if (self->lex->tok == T_ID && self->lex->tok_is("offsetof")
            && self->offsetof_ahead()) {
            char tbuf[MAX_TEXT];
            const char *fname;
            char base[MAX_TEXT];
            char msg[MAX_TEXT];
            char kw[16];
            char *bp;
            size_t bl;
            int si, fi, known;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(",") != 0) return -1;
            if (self->lex->tok != T_ID) return self->sup->fail("expected a field name");
            fname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!fname) return self->sup->fail("out of memory");
            /* Phase 26 fix (SH-62): a type parameter has no field list here;
               the instance emission substitutes `T` and C checks the field. */
            if (self->in_generic && expr_generic_param(self, tbuf)) {
                self->sup->lex_next();
                if (self->sup->expect(")") != 0) return -1;
                n = self->sup->new_node(N_OFFSETOF);
                if (n < 0) return -1;
                self->arena->nodes[n].text = runtime::text::ct_intern(tbuf);
                if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                self->arena->nodes[n].text2 = fname;
                return n;
            }
            /* Both checks run while the cursor is still on the field, so the
               diagnostic points at the argument the user has to fix. */
            snprintf(base, sizeof base, "%s", tbuf);
            bp = base;
            snprintf(kw, sizeof kw, "%s", "struct");
            if (strncmp(bp, "struct ", 7) == 0) {
                bp += 7;
            } else if (strncmp(bp, "union ", 6) == 0) {
                snprintf(kw, sizeof kw, "%s", "union");
                bp += 6;
            }
            while (*bp == ' ') bp++;
            bl = strlen(bp);
            while (bl > 0 && (bp[bl - 1] == ' ' || bp[bl - 1] == '*')) {
                bl--;
                bp[bl] = 0;
            }
            si = self->sym->find_struct(bp);
            if (si < 0) return self->sup->fail("offsetof needs a struct type");
            /* a forward declaration has no field list yet: leave it to C */
            known = !self->sym->structs[si].defined;
            for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
                if (strcmp(self->sym->structs[si].fields[fi].name, fname) == 0) known = 1;
            if (!known) {
                if (snprintf(msg, sizeof msg, "%s '%s' has no field '%s'", kw, bp, fname)
                    >= (int)sizeof msg)
                    return self->sup->fail("offsetof field name is too long");
                return self->sup->fail(msg);
            }
            self->sup->lex_next();
            if (self->sup->expect(")") != 0) return -1;
            n = self->sup->new_node(N_OFFSETOF);
            if (n < 0) return -1;
            self->arena->nodes[n].text = runtime::text::ct_intern(tbuf);
            if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
            self->arena->nodes[n].text2 = fname;
            return n;
        }
        /* `va_arg(<ap>, <type>)` is the one stdarg macro that is not a call: its
           second argument is a type, so it is a builtin like `offsetof` and the
           generated `.c` keeps the same spelling (D-9). */
        if (self->lex->tok == T_ID && self->lex->tok_is("va_arg")
            && self->offsetof_ahead()) {
            char tbuf[MAX_TEXT];
            int ap;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            ap = self->parse_expr();
            if (ap < 0) return -1;
            if (self->sup->expect(",") != 0) return -1;
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            n = self->sup->new_node(N_VAARG);
            if (n < 0) return -1;
            self->arena->nodes[n].a = ap;
            self->arena->nodes[n].text = runtime::text::ct_intern(tbuf);
            if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
            return n;
        }
        /* Phase 24: the range index. `$` has no C spelling of its own -- the
           emitter renders it as `((int)<k>)` -- so it never reaches the symbol
           table; outside the element expression of a range initialiser it is a
           syntax error, never an undeclared name. */
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("$")) {
            /* Phase 30: inside an `into` block `$` is the receiver itself. */
            if (self->into_node >= 0) {
                n = self->sup->new_node(N_INTO_SELF);
                if (n < 0) return -1;
                self->arena->nodes[n].num = self->into_node;
                self->arena->nodes[n].text = runtime::text::ct_intern(self->arena->nodes[self->into_node].text);
                if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                self->sup->lex_next();
                return n;
            }
            if (!self->dollar_ok) return self->sup->fail("unexpected token");
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            self->arena->nodes[n].text2 = runtime::text::ct_intern("$");
            if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
            if (self->range_ctx) self->arena->nodes[n].text3 = runtime::text::ct_intern("range");
            if (!self->arena->nodes[n].text3) return self->sup->fail("out of memory");
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_ID) {
            id_line = self->lex->tokline;
            id_col = self->lex->tokstart - self->lex->lstart + 1;
            /* P29-2: `Vec<int>::from(items, n)` -- the static (receiverless)
               method of an instantiated struct. Only a name the template table
               already holds enters here, and the lookahead insists on `:: name
               (` after the closing `>`, so `a < b` on a variable keeps its
               comparison meaning (D26-3). The node carries the instance
               spelling, so the emitter writes `<Inst>_<method>(...)`. The
               cursor is still on the template name, so `parse_inst_type` reads
               `Vec<int>` exactly as a type position would. */
            if ((frontend::sym::ct_tmpl_find(self->lex->tok_cstr()) >= 0
                 || (self->lex->tok_is("box")
                     && frontend::sym::ct_tmpl_find("Box") >= 0))
                && self->static_call_ahead()) {
                char ibase[MAX_TEXT];
                char sm[MAX_TEXT];
                char smsg[MAX_TEXT + 64];
                int mn;
                ibase[0] = 0;
                if (self->parse_inst_type(ibase, sizeof ibase) != 0) return -1;
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("::")))
                    return self->sup->fail("expected '::' after the instance type");
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
                self->lex->tok_copy(sm, sizeof sm);
                self->sup->lex_next();
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("(")))
                    return self->sup->fail("a static method call needs an argument list");
                args = self->parse_args();
                if (args < 0) return -1;
                {
                    int smi = self->inst_static_method(ibase, sm);
                    if (smi == -2)
                        return tool::diag::ct_sem_error(id_line, id_col,
                            "static method is private to its unit", self->sup->mem->path);
                    if (smi < 0) {
                        snprintf(smsg, sizeof smsg, "'%s' has no static method '%s'",
                                 ibase, sm);
                        return self->sup->fail(smsg);
                    }
                    /* Phase 78 S2b: a receiverless inherent method's ref/out
                       actuals are checked exactly like a free call. */
                    {
                        int spi = self->arena->nodes[smi].a;
                        int sai = args;
                        while (spi > 0 && sai > 0) {
                            if (check_refout_arg(self, sai,
                                    self->arena->nodes[spi].aux,
                                    self->arena->nodes[spi].text) != 0)
                                return -1;
                            spi = self->arena->nodes[spi].next;
                            sai = self->arena->nodes[sai].next;
                        }
                    }
                }
                if (self->map_arity(id_line, id_col, ibase, sm,
                                    arg_count(self->arena, args)
                                    + self->closure_arg_count(args)) != 0)
                    return -1;
                mn = self->sup->new_node(N_MCALL);
                if (mn < 0) return -1;
                self->arena->nodes[mn].a = -1;
                self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                self->arena->nodes[mn].aux = 11;
                self->arena->nodes[mn].text = runtime::text::ct_intern(ibase);
                if (!self->arena->nodes[mn].text) return self->sup->fail("out of memory");
                self->arena->nodes[mn].text2 = runtime::text::ct_intern(sm);
                if (!self->arena->nodes[mn].text2) return self->sup->fail("out of memory");
                return mn;
            }
            /* P34 S5a: a non-generic inherent static call `Counter.make(5)`.
               The name is a struct (not a template), followed by `.method(`.
               A bare struct name that is not a static call falls through to
               the ordinary variable path below, where it is reported as an
               undeclared variable. */
            /* LANG-2: the receiver may name a struct declared in the current
               namespace (`lib_Box`) or exported from an imported one, so the
               lookup goes through the same resolution the type layer uses
               instead of comparing the bare token against the struct table.
               `stext2` keeps the source spelling for diagnostics and rewind. */
            {
                char sres2[MAX_TEXT];
                char sqn2[MAX_TEXT];
                int sres2_is_type = 0;
                self->lex->tok_copy(sres2, sizeof sres2);
                if (self->sym->find_struct(sres2) < 0
                    && self->sym->resolve_type(sres2, sqn2, (int)sizeof sqn2) == 0) {
                    if (self->sym->find_struct(sqn2) >= 0)
                        snprintf(sres2, sizeof sres2, "%s", sqn2);
                    else if (self->sym->find_type(sqn2) >= 0
                             || self->sym->find_type_alias(sqn2) >= 0
                             || self->sym->find_trait(sqn2) >= 0)
                        sres2_is_type = 1;
                }
                if (self->sym->find_struct(sres2) >= 0) {
                int sp2, sbol2, stok2, sline2, stokline2, sstart2, slstart2;
                long snum2;
                int sfloat2, strunc2;
                char stext2[MAX_TEXT];
                int stext2_len;
                const char *ssuf2_ptr; int ssuf2_len;
                sp2 = self->lex->pos; sbol2 = self->lex->bol;
                stok2 = self->lex->tok; snum2 = self->lex->toknum;
                sline2 = self->lex->line; stokline2 = self->lex->tokline;
                sstart2 = self->lex->tokstart; slstart2 = self->lex->lstart;
                sfloat2 = self->lex->tokfloat; strunc2 = self->lex->toktrunc;
                self->lex->tok_copy(stext2, sizeof stext2);
                stext2_len = self->lex->tokstr.len;
                ssuf2_ptr = self->lex->toksuffix.ptr; ssuf2_len = self->lex->toksuffix.len;
                self->sup->lex_next();   /* the struct name */
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(".")) {
                    self->sup->lex_next();
                    if (self->lex->tok == T_ID) {
                        char sibase[MAX_TEXT];
                        char sm2[MAX_TEXT];
                        char smsg2[MAX_TEXT + 64];
                        int mn2;
                        self->lex->tok_copy(sm2, sizeof sm2);
                        self->sup->lex_next();
                        if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
                            snprintf(sibase, sizeof sibase, "struct %s", sres2);
                            args = self->parse_args();
                            if (args < 0) return -1;
                            {
                                int smi2 = self->inst_static_method(sibase, sm2);
                                if (smi2 == -2)
                                    return tool::diag::ct_sem_error(id_line, id_col,
                                        "static method is private to its unit", self->sup->mem->path);
                                if (smi2 < 0) {
                                    snprintf(smsg2, sizeof smsg2, "'%s' has no static method '%s'",
                                             stext2, sm2);
                                    return self->sup->fail(smsg2);
                                }
                            }
                            if (self->map_arity(id_line, id_col, sibase, sm2,
                                                arg_count(self->arena, args)
                                                    + self->closure_arg_count(args)) != 0)
                                return -1;
                            mn2 = self->sup->new_node(N_MCALL);
                            if (mn2 < 0) return -1;
                            self->arena->nodes[mn2].a = -1;
                            self->arena->nodes[mn2].b = (args == 0) ? -1 : args;
                            self->arena->nodes[mn2].aux = 11;
                            self->arena->nodes[mn2].text = runtime::text::ct_intern(sibase);
                            if (!self->arena->nodes[mn2].text) return self->sup->fail("out of memory");
                            self->arena->nodes[mn2].text2 = runtime::text::ct_intern(sm2);
                            if (!self->arena->nodes[mn2].text2) return self->sup->fail("out of memory");
                            return mn2;
                        }
                    }
                }
                /* not a static call: rewind so the variable path handles it */
                self->lex->pos = sp2; self->lex->bol = sbol2;
                self->lex->tok = stok2; self->lex->toknum = snum2;
                self->lex->line = sline2; self->lex->tokline = stokline2;
                self->lex->tokstart = sstart2; self->lex->lstart = slstart2;
                self->lex->tokfloat = sfloat2; self->lex->toktrunc = strunc2;
                self->lex->tokstr.ptr = self->lex->src + sstart2;
                self->lex->tokstr.len = stext2_len;
                self->lex->toksuffix.ptr = ssuf2_ptr; self->lex->toksuffix.len = ssuf2_len;
                } else if (sres2_is_type) {
                    /* LANG-7: the receiver names a declared type (typedef, enum,
                       trait) but not a struct with static methods. The variable
                       path would report `use of an undeclared variable` at the
                       dot, sending the reader after an import; name the type
                       instead. Only the `.method(` shape is claimed here -- any
                       other use of the name rewinds to the variable path, so an
                       enum-constant or alias typo keeps its old diagnostic. */
                    int tp2, tbol2, ttok2, tline2, ttokline2, tstart2, tlstart2;
                    long tnum2;
                    int tfloat2, ttrunc2;
                    char tm2[MAX_TEXT];
                    const char *ttext2_ptr; int ttext2_len;
                    const char *tsuf2_ptr; int tsuf2_len;
                    tp2 = self->lex->pos; tbol2 = self->lex->bol;
                    ttok2 = self->lex->tok; tnum2 = self->lex->toknum;
                    tline2 = self->lex->line; ttokline2 = self->lex->tokline;
                    tstart2 = self->lex->tokstart; tlstart2 = self->lex->lstart;
                    tfloat2 = self->lex->tokfloat; ttrunc2 = self->lex->toktrunc;
                    ttext2_ptr = self->lex->tokstr.ptr; ttext2_len = self->lex->tokstr.len;
                    tsuf2_ptr = self->lex->toksuffix.ptr; tsuf2_len = self->lex->toksuffix.len;
                    tm2[0] = 0;
                    self->sup->lex_next();   /* the type name */
                    if (self->lex->tok == T_PUNCT && self->lex->tok_is(".")) {
                        self->sup->lex_next();
                        if (self->lex->tok == T_ID) {
                            self->lex->tok_copy(tm2, sizeof tm2);
                            self->sup->lex_next();
                            if (!(self->lex->tok == T_PUNCT
                                  && self->lex->tok_is("(")))
                                tm2[0] = 0;
                        }
                    }
                    self->lex->pos = tp2; self->lex->bol = tbol2;
                    self->lex->tok = ttok2; self->lex->toknum = tnum2;
                    self->lex->line = tline2; self->lex->tokline = ttokline2;
                    self->lex->tokstart = tstart2; self->lex->lstart = tlstart2;
                    self->lex->tokfloat = tfloat2; self->lex->toktrunc = ttrunc2;
                    self->lex->tokstr.ptr = ttext2_ptr; self->lex->tokstr.len = ttext2_len;
                    self->lex->toksuffix.ptr = tsuf2_ptr; self->lex->toksuffix.len = tsuf2_len;
                    if (tm2[0]) {
                        char tmsg3[MAX_TEXT + 96];
                        snprintf(tmsg3, sizeof tmsg3,
                            "static method '%s' cannot be resolved: '%s' is a type name, "
                            "not a variable", tm2, sres2);
                        return tool::diag::ct_sem_error(id_line, id_col, tmsg3,
                                                        self->sup->mem->path);
                    }
                }
            }
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            self->arena->nodes[n].text2 = runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len);
            if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
            /* Phase 78 S2a: remember that this name is a ref/out parameter, so
               the emitter spells `(*name)` and the `out` walk can tell the
               parameter from a same-named shadow. */
            {
                int rvi = self->sym->find_var(self->arena->nodes[n].text2);
                if (rvi >= 0 && self->sym->vars[rvi].ref_param)
                    self->arena->nodes[n].aux = 2;
                else if (rvi >= 0 && self->sym->vars[rvi].out_param)
                    self->arena->nodes[n].aux = 3;
            }
            self->sup->lex_next();
            /* Phase 31 S23b (L31-23): a view whose container was mutated after
               it was taken is stale. A name followed by `=` is being rebound,
               not read, so it is not a use of the old view. */
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("="))
                && view_use(self, self->arena->nodes[n].text2, id_line, id_col) != 0)
                return -1;
            /* Phase 26 fix (SH-64): an identifier that names the current
               template's type parameter is never a value. Type operands were
               already taken by parse_unary / parse_type before this point, so
               every identifier-resolution path that starts here -- a generic
               instance, a qualified name, a call, the ALL_CAPS macro fallback,
               a bare function value, `fnval_ok` -- must reject it. One guard at
               the shared entry covers them all instead of patching each exit;
               without it `return T;` emitted the raw `T`. */
            if (self->in_generic && expr_generic_param(self, self->arena->nodes[n].text2)) {
                char vmsg[MAX_TEXT + 64];
                snprintf(vmsg, sizeof vmsg,
                         "type parameter '%s' cannot be used as a value",
                         self->arena->nodes[n].text2);
                return self->sup->fail(vmsg);
            }
            /* Phase 26: `name<type>(...)` names a generic instance. Only a name
               the symbol table already holds as a template enters this branch,
               so `a < b` on a variable stays a comparison (D26-1/D26-3). */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                int gfi = self->sym->find_func(self->arena->nodes[n].text2);
                if (gfi >= 0 && self->sym->funcs[gfi].ntparams == 1) {
                    char targ[MAX_TEXT];
                    char gmsg[MAX_TEXT + 64];
                    int gi;
                    if (self->in_generic)
                        return self->sup->fail("recursive generic calls are not supported");
                    self->sup->lex_next();
                    if (self->parse_type(targ, sizeof targ) != 0) return -1;
                    if (self->fnptr_state || strcmp(targ, "void") == 0
                        || strcmp(targ, self->sym->funcs[gfi].tparam) == 0) {
                        snprintf(gmsg, sizeof gmsg,
                                 "'%s' cannot be a generic type argument", targ);
                        return self->sup->fail(gmsg);
                    }
                    if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(">")))
                        return self->sup->fail("expected '>' after the generic type argument");
                    self->sup->lex_next();
                    gi = self->generic_instance(gfi, targ, id_line, id_col);
                    if (gi < 0) return -1;
                    self->arena->nodes[n].text2 = runtime::text::ct_intern(self->sym->ginsts[gi].cname);
                    if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
                }
            }
            /* `Qual::fn(...)`: the qualifier names a namespace path or a type,
               and the callee lives in that namespace. Without the call it names
               a variable instead (`a::h`), whose C spelling is the mangled one. */
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("::")) {
                snprintf(tsrc, sizeof tsrc, "%s", self->arena->nodes[n].text2);
                snprintf(nbuf, sizeof nbuf, "%s", self->arena->nodes[n].text2);
                if (self->parse_qual_path(nbuf, MAX_TEXT, qc, MAX_TEXT,
                                          qv, MAX_TEXT, &qf) != 0)
                    return -1;
                self->arena->nodes[n].text2 = runtime::text::ct_intern(nbuf);
                if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
                /* `Trait::ns`: a namespace-host interface value (SH-20). The
                   host has no object, so the node carries no operand (`a`), the
                   vtable is named after `text2` and `text3` keeps the source
                   spelling for the emitter's diagnostics. */
                if (qf == 3) {
                    char mname[MAX_TEXT];
                    int mn;
                    if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(".")))
                        return self->sup->fail("a static trait has no interface value");
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a method name");
                    self->lex->tok_copy(mname, sizeof mname);
                    self->sup->lex_next();
                    args = self->parse_args();
                    if (args < 0) return -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = -1;
                    self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                    self->arena->nodes[mn].aux = 5;
                    self->arena->nodes[mn].text = runtime::text::ct_intern(self->arena->nodes[n].text2);
                    if (!self->arena->nodes[mn].text) return self->sup->fail("out of memory");
                    self->arena->nodes[mn].text2 = runtime::text::ct_intern(mname);
                    if (!self->arena->nodes[mn].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[mn].text3 = runtime::text::ct_intern(qv);
                    if (!self->arena->nodes[mn].text3) return self->sup->fail("out of memory");
                    if (self->map_arity(id_line, id_col, self->arena->nodes[n].text2,
                                        mname, arg_count(self->arena, args)
                                        + self->closure_arg_count(args)) != 0)
                        return -1;
                    /* 25.1: the trait segment is explicit, so the signature
                       is this unit's to compare -- same 19.2 rules as a
                       resolved trait method, and no receiver precedes the
                       method's own parameters. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, mname) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm) {
                                if (self->map_closure_check(id_line, id_col, args,
                                                            ti3, mi3) != 0)
                                    return -1;
                                if (self->argtype_check_static(id_line, id_col, mname, args,
                                                               ti3, mi3) != 0)
                                    return -1;
                            }
                        }
                    }
                    return mn;
                }
                /* Q2-A: `ns::method(...)` with the trait segment elided. The
                   qualifier is a static map's namespace host and the method name
                   is unique (parse_qual_path checked both), so this is the same
                   recipe call `ns::Trait.method(...)` builds above. */
                if (qf == 4) {
                    int mn;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = -1;
                    self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                    self->arena->nodes[mn].aux = 5;
                    self->arena->nodes[mn].text = runtime::text::ct_intern(self->arena->nodes[n].text2);
                    if (!self->arena->nodes[mn].text) return self->sup->fail("out of memory");
                    self->arena->nodes[mn].text2 = runtime::text::ct_intern(qc);
                    if (!self->arena->nodes[mn].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[mn].text3 = runtime::text::ct_intern(qv);
                    if (!self->arena->nodes[mn].text3) return self->sup->fail("out of memory");
                    if (self->map_arity(id_line, id_col, self->arena->nodes[n].text2,
                                        qc, arg_count(self->arena, args)
                                        + self->closure_arg_count(args)) != 0)
                        return -1;
                    /* 25.1: the namespace host resolved a unique trait, so its
                       method signature is known here -- compare the actuals
                       against it, receiver-free like the form above. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, qc) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm) {
                                if (self->map_closure_check(id_line, id_col, args,
                                                            ti3, mi3) != 0)
                                    return -1;
                                if (self->argtype_check_static(id_line, id_col, qc, args,
                                                               ti3, mi3) != 0)
                                    return -1;
                            }
                        }
                    }
                    return mn;
                }
                /* P20-01: `Trait::method(recv, ...)` — the first actual is the
                   receiver, so the node is the same static-recipe call as a
                   type-host method (`aux == 6`), with the forced trait in
                   `text3`. That is what lets two packages bind `len` to
                   `char *` and the caller pick one. Writing the node directly
                   must not skip the arity check the other static-recipe forms
                   run, or an extra actual is dropped by the recipe with no
                   diagnostic. */
                if (qf == 5) {
                    char rtype[MAX_TEXT];
                    int mn, rest, got;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    if (args == 0)
                        return self->sup->fail("a qualified method call needs a receiver argument");
                    /* the receiver stands apart from the trait method's own
                       parameters, exactly as in `Trait::ns.method(...)` */
                    got = arg_count(self->arena, args) - 1;
                    if (self->sup->expr_type(args, rtype, sizeof rtype) != 0)
                        return self->sup->fail("cannot infer the receiver type of a qualified method call");
                    if (self->arena->nodes[args].kind == N_VAR) {
                        int vi = self->sym->find_var(self->arena->nodes[args].text2);
                        if (vi >= 0 && self->sym->vars[vi].is_array
                            && strlen(rtype) + 2 < sizeof rtype)
                            strcat(rtype, " *");
                    }
                    rest = self->arena->nodes[args].next;
                    self->arena->nodes[args].next = -1;
                    /* D25-3: a closure in the tail fills two recipe slots, so
                       the count the method signature is compared with grows by
                       one for each; the receiver is already out of `rest`. */
                    got += self->closure_arg_count(rest);
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = args;
                    self->arena->nodes[mn].b = rest;
                    self->arena->nodes[mn].aux = 6;
                    self->arena->nodes[mn].text = runtime::text::ct_intern(rtype);
                    if (!self->arena->nodes[mn].text) return self->sup->fail("out of memory");
                    self->arena->nodes[mn].text2 = runtime::text::ct_intern(qc);
                    if (!self->arena->nodes[mn].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[mn].text3 = runtime::text::ct_intern(self->arena->nodes[n].text2);
                    if (!self->arena->nodes[mn].text3) return self->sup->fail("out of memory");
                    /* The trait's own signature is the judge: `nparams` counts
                       the method's parameters, never the receiver. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, qc) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm) {
                                if (!(self->sym->traits[ti3].m[mi3].variadic
                                      && got >= self->sym->traits[ti3].m[mi3].nparams)
                                    && self->arity_check(id_line, id_col, qc, got,
                                                         self->sym->traits[ti3].m[mi3].nparams) != 0)
                                    return -1;
                                /* 25.1: the receiver stays apart, so the
                                   remaining actuals are compared with the
                                   method's own parameters as written. */
                                if (self->map_closure_check(id_line, id_col, rest,
                                                            ti3, mi3) != 0)
                                    return -1;
                                if (self->argtype_check_static(id_line, id_col, qc, rest,
                                                               ti3, mi3) != 0)
                                    return -1;
                                /* SH-60 / D-60-1: `Trait::method(recv, ...)`
                                   keeps the receiver as the first actual, so
                                   the same literal / top-level-const rule
                                   applies. */
                                if (self->recv_mut_check(args, rtype,
                                                         self->sym->traits[ti3].m[mi3].is_mut,
                                                         id_line, id_col, qc) != 0)
                                    return -1;
                            }
                        }
                    }
                    return mn;
                }
                if (qf == 2) {
                    if (snprintf(tag, sizeof tag, "%s|%s", tsrc, qv) >= MAX_TEXT)
                        return self->sup->fail("qualified name is too long");
                    self->arena->nodes[n].text = runtime::text::ct_intern(self->arena->nodes[n].text2);
                    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                    self->arena->nodes[n].text2 = runtime::text::ct_intern(qc);
                    if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[n].text3 = runtime::text::ct_intern(tag);
                    if (!self->arena->nodes[n].text3) return self->sup->fail("out of memory");
                    self->arena->nodes[n].kind = N_BOX;
                    self->arena->nodes[n].a = -1;
                    self->arena->nodes[n].aux = 4;
                    self->arena->nodes[n].b = -1;
                    return n;
                }
                if (self->lex->tok != T_PUNCT || !self->lex->tok_is("(")) {
                    if (self->sym->find_qualified_global(qv, self->arena->nodes[n].text2,
                                                         qc, MAX_TEXT) != 0) {
                        char etn[MAX_TEXT];
                        int eti;
                        if (self->sym->resolve_type(qv, etn, sizeof etn) == 0
                            && (eti = self->sym->find_type(etn)) >= 0
                            && self->sym->type_kind[eti] == 5) {
                            char emsg[MAX_TEXT * 2];
                            snprintf(emsg, sizeof emsg, "'%s' has no member '%s'",
                                     qv, self->arena->nodes[n].text2);
                            return self->sup->fail(emsg);
                        }

                        return self->sup->fail("no variable of that name in that namespace"
                                               " (qualified type names are not supported;"
                                               " use the bare name or an alias import)");
                    }
                    self->arena->nodes[n].text3 = runtime::text::ct_intern(qc);
                    if (!self->arena->nodes[n].text3) return self->sup->fail("out of memory");
                    return n;
                }
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
                int fi;
                /* L26-1: a template cannot be called without naming a type
                   argument; the instance does not exist before this point. */
                {
                    int gchk = self->sym->find_func(self->arena->nodes[n].text2);
                    if (gchk >= 0 && self->sym->funcs[gchk].ntparams == 1) {
                        char gmsg[MAX_TEXT + 64];
                        snprintf(gmsg, sizeof gmsg,
                                 "generic function '%s' needs a type argument",
                                 self->arena->nodes[n].text2);
                        return self->sup->fail(gmsg);
                    }
                }
                {
                    int cl_line = self->lex->tokline;
                    int cl_col = self->lex->tokstart - self->lex->lstart + 1;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    self->call_line = cl_line;
                    self->call_col = cl_col;
                }
                /* PH-69-R2 (LANG-19): a call through a function-pointer
                   variable has no symbol row, so its prototype is parsed from
                   the variable's type (`int (*)(int, char *)`) and the same
                   arity/type kernel is applied. A `...` tail accepts extras.
                   SH-115 moved the kernel into `chk_callptr_args`, which the
                   field and pointer-expression paths share. */
                if (self->types_mode && *self->types_mode
                    && self->sym->find_func(self->arena->nodes[n].text2) < 0) {
                    char ft[MAX_TEXT];
                    const char *an0 = self->arena->nodes[n].text2;
                    if (self->sym->var_type(an0, ft, sizeof ft) == 0
                        && self->chk_callptr_args(ft, an0, args,
                                                  self->call_line, self->call_col) != 0)
                        return -1;
                }
                {
                    const char *an = self->arena->nodes[n].text2;
                    if (strcmp(an, "ct_atomic_load") == 0
                        || strcmp(an, "ct_atomic_store") == 0
                        || strcmp(an, "ct_atomic_cas") == 0) {
                        const char *aop;
                        const char *asuf;
                        char t[MAX_TEXT], base[MAX_TEXT], helper[MAX_TEXT];
                        char *ap, *aq;
                        size_t alen;
                        int a1, a2, a3, got;
                        static const char *at_ints[] = {
                            "char", "signed char", "unsigned char", "short",
                            "unsigned short", "int", "unsigned", "long",
                            "unsigned long", "long long", "unsigned long long",
                            "_Bool", NULL
                        };
                        got = arg_count(self->arena, args);
                        a1 = args;
                        a2 = a1 >= 0 ? self->arena->nodes[a1].next : -1;
                        a3 = a2 >= 0 ? self->arena->nodes[a2].next : -1;
                        if (strcmp(an, "ct_atomic_load") == 0) {
                            if (got != 1)
                                return tool::diag::ct_sem_error(id_line, id_col,
                                    "ct_atomic_load takes one argument", self->sup->mem->path);
                            aop = "load";
                        } else if (strcmp(an, "ct_atomic_store") == 0) {
                            if (got != 2)
                                return tool::diag::ct_sem_error(id_line, id_col,
                                    "ct_atomic_store takes two arguments", self->sup->mem->path);
                            aop = "store";
                        } else {
                            if (got != 3)
                                return tool::diag::ct_sem_error(id_line, id_col,
                                    "ct_atomic_cas takes three arguments", self->sup->mem->path);
                            aop = "cas";
                        }
                        t[0] = 0;
                        if (!self->sup->expr_type(a1, t, sizeof t)) {
                            if (self->arena->nodes[a1].kind == N_ADDR) {
                                int ain = self->arena->nodes[a1].a;
                                char vt[MAX_TEXT];
                                if (!self->sup->expr_type(ain, vt, sizeof vt)
                                    && self->arena->nodes[ain].kind == N_VAR
                                    && self->sym->var_type(self->arena->nodes[ain].text2,
                                                           vt, sizeof vt) == 0)
                                    snprintf(t, sizeof t, "%s *", vt);
                                else if (vt[0])
                                    snprintf(t, sizeof t, "%s *", vt);
                            } else if (self->arena->nodes[a1].kind == N_VAR) {
                                self->sym->var_type(self->arena->nodes[a1].text2,
                                                    t, sizeof t);
                            }
                        }
                        ap = strstr(t, "_Atomic(");
                        if (!ap)
                            return tool::diag::ct_sem_error(id_line, id_col,
                                "the first argument of 'ct_atomic_load' must be the address of an atomic variable",
                                self->sup->mem->path);
                        ap += 8;
                        aq = strchr(ap, ')');
                        if (!aq || (alen = (size_t)(aq - ap)) == 0
                            || alen >= sizeof base)
                            return tool::diag::ct_sem_error(id_line, id_col,
                                "the first argument of 'ct_atomic_load' must be the address of an atomic variable",
                                self->sup->mem->path);
                        memcpy(base, ap, alen);
                        base[alen] = 0;
                        for (aq++; *aq == ' '; aq++)
                            ;
                        if (*aq != '*')
                            return tool::diag::ct_sem_error(id_line, id_col,
                                "the first argument of 'ct_atomic_load' must be the address of an atomic variable",
                                self->sup->mem->path);
                        if (strcmp(base, "int") == 0) asuf = "int";
                        else if (strcmp(base, "long") == 0) asuf = "long";
                        else if (strcmp(base, "_Bool") == 0) asuf = "bool";
                        else if (strcmp(base, "void *") == 0) asuf = "ptr";
                        else
                            return tool::diag::ct_sem_error(id_line, id_col,
                                "the first argument of 'ct_atomic_load' must be the address of an atomic variable",
                                self->sup->mem->path);
                        if (strcmp(aop, "store") == 0 || strcmp(aop, "cas") == 0) {
                            int valarg = (strcmp(aop, "store") == 0) ? a2 : a3;
                            char vt[MAX_TEXT];
                            int ok = 0, vi;
                            vt[0] = 0;
                            if (!self->sup->expr_type(valarg, vt, sizeof vt)) {
                                int vk = self->arena->nodes[valarg].kind;
                                if (vk == N_NUM) {
                                    const char *s = self->arena->nodes[valarg].text;
                                    snprintf(vt, sizeof vt, "%s",
                                             strcmp(s, "L") == 0 ? "long"
                                             : strcmp(s, "U") == 0 ? "unsigned" : "int");
                                } else if (vk == N_FNUM) {
                                    snprintf(vt, sizeof vt, "double");
                                } else if (vk == N_ADDR
                                           && self->arena->nodes[self->arena->nodes[valarg].a].kind == N_VAR) {
                                    char it[MAX_TEXT];
                                    if (self->sym->var_type(self->arena->nodes[self->arena->nodes[valarg].a].text2,
                                                            it, sizeof it) == 0)
                                        snprintf(vt, sizeof vt, "%s *", it);
                                }
                            }
                            if (vt[0]) {
                                ok = strcmp(vt, base) == 0;
                                if (!ok && strcmp(base, "void *") == 0 && strchr(vt, '*')) ok = 1;
                                if (!ok && (strcmp(base, "int") == 0
                                            || strcmp(base, "long") == 0
                                            || strcmp(base, "_Bool") == 0))
                                    for (vi = 0; at_ints[vi]; vi++)
                                        if (strcmp(vt, at_ints[vi]) == 0) { ok = 1; break; }
                            } else ok = 1;
                            if (!ok)
                                return tool::diag::ct_sem_error(id_line, id_col,
                                    "atomic value type mismatch", self->sup->mem->path);
                        }
                        if (strcmp(aop, "cas") == 0) {
                            char et[MAX_TEXT];
                            int has_ptr = 0;
                            size_t bl;
                            et[0] = 0;
                            if (!self->sup->expr_type(a2, et, sizeof et)
                                && self->arena->nodes[a2].kind == N_ADDR
                                && self->arena->nodes[self->arena->nodes[a2].a].kind == N_VAR) {
                                char it[MAX_TEXT];
                                if (self->sym->var_type(self->arena->nodes[self->arena->nodes[a2].a].text2,
                                                        it, sizeof it) == 0)
                                    snprintf(et, sizeof et, "%s *", it);
                            }
                            if (et[0]) {
                                bl = strlen(base);
                                has_ptr = strcmp(et, base) != 0
                                          && strncmp(et, base, bl) == 0
                                          && (et[bl] == ' ' || et[bl] == '*')
                                          && strchr(et, '*') != 0;
                            }
                            if (!has_ptr)
                                return tool::diag::ct_sem_error(id_line, id_col,
                                    "pass &expected: a CAS needs the address of 'expected' to write the observed value back",
                                    self->sup->mem->path);
                        }
                        snprintf(helper, sizeof helper, "__ct_atomic_%s_%s", aop, asuf);
                        self->arena->nodes[n].kind = N_CALL;
                        self->arena->nodes[n].a = args;
                        self->arena->nodes[n].b = -1;
                        self->arena->nodes[n].aux = 0;
                        self->arena->nodes[n].text3 = runtime::text::ct_intern("");
                        if (!self->arena->nodes[n].text3) return self->sup->fail("out of memory");
                        self->arena->nodes[n].text2 = runtime::text::ct_intern(helper);
                        if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
                        self->sym->atomic_used = 1;
                        return n;
                    }
                }
                self->sym->errmsg[0] = 0;
                if (qc[0]) fi = self->sym->find_func(qc);
                else fi = self->sym->resolve_func(self->arena->nodes[n].text2);
                if (fi < 0) {
                    const char *why = self->sym->last_error();
                    if (why[0]) return self->sup->fail(why);
                }
                /* `p(args)` on a function-pointer variable: no function of that
                   name exists and the lookup said nothing, so the callee is the
                   variable. Calls through a pointer are emitted uniformly as
                   `(*p)(args)` (D-7). */
                if (fi < 0) {
                    char vt[MAX_TEXT];
                    if (self->sym->var_type(self->arena->nodes[n].text2, vt, sizeof vt) == 0
                        && strstr(vt, "(*"))
                        self->arena->nodes[n].aux = 1;
                }
                if (record_io_call(self, self->arena->nodes[n].text2, fi >= 0, id_line) != 0) return -1;
                /* P-3.5 (SH-117): an unresolved callee is a C function. A
                   by-value `String` / `Str` handle has no implicit conversion
                   to the `char *` the C boundary spells, and a variadic
                   position cannot declare one, so `printf("%s", s)` used to
                   pass the struct by value. A call through a function-pointer
                   variable (aux 1) has its own signature and is left alone. */
                if (fi < 0 && self->arena->nodes[n].aux != 1 && args > 0) {
                    int hcur = args;
                    while (hcur > 0) {
                        char hb[MAX_TEXT];
                        if (str_handle_value(self, hcur, hb, sizeof hb)) {
                            char hmsg[MAX_TEXT + 64];
                            snprintf(hmsg, sizeof hmsg,
                                     "cannot pass a '%s' handle to C function '%s': use cstr() at the C boundary",
                                     hb, self->arena->nodes[n].text2);
                            return tool::diag::ct_sem_error(id_line, id_col, hmsg,
                                                            self->sup->mem->path);
                        }
                        hcur = self->arena->nodes[hcur].next;
                    }
                }
                /* the call graph keeps the name the source wrote */
                if (fi >= 0 && self->record_call(self->arena->nodes[n].text2, id_line) != 0) return -1;
                /* Phase 21 S4: a closure actual must fill the callee's
                   `(fn, env)` pair; an unresolved callee cannot be verified. */
                if (args > 0
                    && self->closure_arg_check(id_line, id_col, self->arena->nodes[n].text2,
                                               args, fi) != 0)
                    return -1;
                /* 19.1: a resolved signature says how many arguments the callee
                   takes; a variadic tail accepts any surplus past its named
                   parameters. The message keeps the name the source wrote. */
                if (fi >= 0) {
                    int got, want, tail_ok;
                    got = arg_count(self->arena, args) + self->closure_arg_count(args);
                    want = self->sym->funcs[fi].nparams;
                    tail_ok = self->sym->funcs[fi].variadic && got > want;
                    if (!tail_ok && self->arity_check(id_line, id_col, self->arena->nodes[n].text2,
                                                      got, want) != 0)
                        return -1;
                }
                /* PH-80 (E80-2): an expected-type-directed literal binds at a
                   call argument too, so `str_dup("x")` reaches a `Str` formal
                   and `String.from_utf16(...)`-style helpers stay usable. It
                   runs before the argument-type pass, which would otherwise
                   reject the `char *` spelling against a by-value struct. */
                if (fi >= 0 && args > 0) {
                    int lc = args, lk = 0;
                    while (lc > 0 && lk < self->sym->funcs[fi].nparams) {
                        int lcl = self->arg_is_closure(lc);
                        if (!lcl
                            && self->lit_coerce(self->sym->funcs[fi].ptype + (lk) * MAX_TEXT, lc) != 0)
                            return -1;
                        lc = self->arena->nodes[lc].next;
                        lk += lcl ? 2 : 1;
                    }
                }
                /* LANG-26: an `out` formal is a binding site; a plain formal is
                   not, so a convertible actual there gets the expression-ban
                   diagnostic instead of the generic type mismatch. A closure
                   actual occupies a `(fn, env)` pair, so the index walk is
                   skipped when one is present. */
                if (fi >= 0 && args > 0 && self->closure_arg_count(args) == 0
                    && bind_conv_on()) {
                    int pc2 = args, pk3 = 0;
                    while (pc2 > 0 && pk3 < self->sym->funcs[fi].nparams) {
                        int apos = self->arg_base + pk3;
                        int aline2 = apos < self->argcap ? self->arg_line[apos] : id_line;
                        int acol2 = apos < self->argcap ? self->arg_col[apos] : id_col;
                        if (self->sym->funcs[fi].pann[pk3] != 3) {
                            char at[MAX_TEXT];
                            char fk[MAX_TEXT];
                            char ak[MAX_TEXT];
                            if (self->sup->expr_type(pc2, at, sizeof at) == 0 && at[0]
                                && bind_conv_struct_like(self, at)
                                && bind_conv_any(self, at, "as")) {
                                bind_conv_key(at, ak, sizeof ak);
                                bind_conv_key(self->sym->funcs[fi].ptype + (pk3) * MAX_TEXT, fk, sizeof fk);
                                if (strcmp(ak, fk) != 0) {
                                    char pmsg[MAX_TEXT * 2];
                                    snprintf(pmsg, sizeof pmsg,
                                        "conversion is only allowed at a binding site (declaration/assignment/out/return); argument %d of '%s' is not one",
                                        pk3 + 1, self->arena->nodes[n].text2);
                                    return tool::diag::ct_sem_error(aline2, acol2, pmsg,
                                                                    self->sup->mem->path);
                                }
                            }
                        }
                        pc2 = self->arena->nodes[pc2].next;
                        pk3++;
                    }
                }
                /* LANG-26 / D-020 §6.1: a convertible `out` actual becomes a
                   formal-typed temporary plus a write-back. Done before the
                   argument-type pass, which then sees a formal-typed variable;
                   the place was judged above, before the replacement. */
                if (fi >= 0 && args > 0 && self->closure_arg_count(args) == 0) {
                    int na = bind_outconv_rewrite(self, n, args, 0, fi, -1, "", id_line, id_col);
                    if (na < 0) return -1;
                    args = na;
                    self->arena->nodes[n].a = args;
                }
                /* 19.2: the argument types against the same signature, before
                   the boxing pass rewrites interface arguments (an interface
                   formal is skipped here, boxing owns it). */
                if (fi >= 0
                    && self->argtype_check(id_line, id_col, self->arena->nodes[n].text2,
                                           args, fi, -1, -1) != 0)
                    return -1;
                /* Phase 78 S2a: a ref/out actual is a place, and an owning
                   `out` actual must already hold a value. Checked on the
                   arguments as written, before boxing rewrites a formal. */
                if (fi >= 0) {
                    int ra = args;
                    int rai = 0;
                    while (ra > 0 && rai < self->sym->funcs[fi].nparams) {
                        if (check_refout_arg(self, ra,
                                (int)(unsigned char)self->sym->funcs[fi].pann[rai],
                                self->sym->funcs[fi].ptype + (rai) * MAX_TEXT) != 0)
                            return -1;
                        ra = self->arena->nodes[ra].next;
                        rai++;
                    }
                }
                /* the emitted call must spell the definition's C name */
                if (fi >= 0) {
                        self->arena->nodes[n].text2 = runtime::text::ct_intern(self->sym->funcs[fi].cname);
                        if (!self->arena->nodes[n].text2) return self->sup->fail("out of memory");
                }
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < self->sym->funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        int ip = 0;
                        if (self->sup->iface_ref_type(self->sym->funcs[fi].ptype + (k) * MAX_TEXT, tr, sizeof tr, &ip)) {
                            int boxed = self->sup->maybe_box(cur, tr, ip);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else self->arena->nodes[prev].next = boxed;
                                self->arena->nodes[boxed].next = self->arena->nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                /* PH-79 fix SH-100: an array actual for a `T[]` formal is a
                   view, exactly like the local-declaration initialiser. Done
                   after the checks above, which judge the source spelling. */
                if (fi >= 0 && args > 0) {
                    int cur = args, prev = -1, k = 0, first_arg = args;
                    while (cur > 0 && k < self->sym->funcs[fi].nparams) {
                        int is_cl = self->arg_is_closure(cur);
                        if (!is_cl
                            && strcmp(self->sym->funcs[fi].ptype + (k) * MAX_TEXT, "struct __ct_slice") == 0) {
                            int view = self->slice_view_from_array(cur);
                            if (view < 0) return -1;
                            if (view != cur) {
                                if (prev < 0) first_arg = view;
                                else self->arena->nodes[prev].next = view;
                                self->arena->nodes[view].next = self->arena->nodes[cur].next;
                                cur = view;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        /* a closure fills the host's `(fn, env)` pair */
                        k += is_cl ? 2 : 1;
                    }
                    args = first_arg;
                }
                self->arena->nodes[n].kind = N_CALL;
                self->arena->nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->sym->find_var(self->arena->nodes[n].text2) >= 0) {
                /* a declared variable: a namespaced global is emitted under its
                   mangled C name, which is kept on the node for the emitter; a
                   bare name may not pick between two imported exports */
                char cn[MAX_TEXT];
                const char *nm = self->arena->nodes[n].text2;
                if (self->sym->var_ambiguous(nm)) {
                    char amsg[512];
                    snprintf(amsg, sizeof amsg,
                             "variable '%s' is exported by more than one namespace; use a qualified name", nm);
                    return self->sup->fail(amsg);
                }
                if (self->sym->var_cname(nm, cn, sizeof cn) == 0 && strcmp(cn, nm) != 0) {
                        self->arena->nodes[n].text3 = runtime::text::ct_intern(cn);
                        if (!self->arena->nodes[n].text3) return self->sup->fail("out of memory");
                }
            } else {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps, vf;
                const char *nm = self->arena->nodes[n].text2;
                /* SH-114: a generic template used before its definition keeps
                   the "must be defined first" rule, but the diagnostic names
                   that rule instead of the generic undeclared-variable text.
                   Only the `name<...>(` shape is eligible. The scan is inline:
                   `v1-PH-0` is at the 512-function budget, so this diagnostic
                   may not add a top-level helper (SH-109). */
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("<")) {
                    const char *gsrc = self->sup->lex->src;
                    int guse = self->sup->lex->pos;
                    int gpos = 0, gdepth = 0, ghint = 0;
                    int gnlen = (int)strlen(nm);
                    while (gsrc[gpos] && !ghint) {
                        char gc = gsrc[gpos];
                        if (gc == '"' || gc == '\'') {
                            char gq = gc;
                            gpos++;
                            while (gsrc[gpos] && gsrc[gpos] != gq) {
                                if (gsrc[gpos] == '\\' && gsrc[gpos + 1]) gpos++;
                                gpos++;
                            }
                            if (gsrc[gpos]) gpos++;
                            continue;
                        }
                        if (gc == '/' && gsrc[gpos + 1] == '*') {
                            gpos += 2;
                            while (gsrc[gpos]
                                   && !(gsrc[gpos] == '*' && gsrc[gpos + 1] == '/'))
                                gpos++;
                            if (gsrc[gpos]) gpos += 2;
                            continue;
                        }
                        if (gc == '/' && gsrc[gpos + 1] == '/') {
                            while (gsrc[gpos] && gsrc[gpos] != '\n') gpos++;
                            continue;
                        }
                        if (gc == '{') { gdepth++; gpos++; continue; }
                        if (gc == '}') {
                            if (gdepth > 0) gdepth--;
                            gpos++;
                            continue;
                        }
                        if (gpos > guse && gdepth == 0
                            && ((gc >= 'A' && gc <= 'Z') || (gc >= 'a' && gc <= 'z')
                                || gc == '_')) {
                            int gq = gpos + 1, gp, gd, gtp0, gtp1, gb;
                            char gtp[MAX_TEXT];
                            while (gsrc[gq]
                                   && ((gsrc[gq] >= 'A' && gsrc[gq] <= 'Z')
                                       || (gsrc[gq] >= 'a' && gsrc[gq] <= 'z')
                                       || (gsrc[gq] >= '0' && gsrc[gq] <= '9')
                                       || gsrc[gq] == '_'))
                                gq++;
                            if (gq - gpos == gnlen
                                && strncmp(gsrc + gpos, nm, (size_t)gnlen) == 0) {
                                gp = gq;
                                while (gsrc[gp] == ' ' || gsrc[gp] == '\t'
                                       || gsrc[gp] == '\n' || gsrc[gp] == '\r')
                                    gp++;
                                if (gsrc[gp] == '<') {
                                    gp++;
                                    while (gsrc[gp] == ' ' || gsrc[gp] == '\t'
                                           || gsrc[gp] == '\n' || gsrc[gp] == '\r')
                                        gp++;
                                    gtp0 = gp;
                                    while (gsrc[gp]
                                           && ((gsrc[gp] >= 'A' && gsrc[gp] <= 'Z')
                                               || (gsrc[gp] >= 'a' && gsrc[gp] <= 'z')
                                               || (gsrc[gp] >= '0' && gsrc[gp] <= '9')
                                               || gsrc[gp] == '_'))
                                        gp++;
                                    gtp1 = gp;
                                    gd = 0;
                                    while (gsrc[gp]) {
                                        if (gsrc[gp] == '<') gd++;
                                        else if (gsrc[gp] == '>') {
                                            if (gd == 0) { gp++; break; }
                                            gd--;
                                        }
                                        gp++;
                                    }
                                    while (gsrc[gp] == ' ' || gsrc[gp] == '\t'
                                           || gsrc[gp] == '\n' || gsrc[gp] == '\r')
                                        gp++;
                                    if (gsrc[gp] == '(') {
                                        gb = gpos - 1;
                                        while (gb >= 0 && (gsrc[gb] == ' '
                                               || gsrc[gb] == '\t'
                                               || gsrc[gb] == '\n'
                                               || gsrc[gb] == '\r')) gb--;
                                        if (gb >= 0 && gsrc[gb] == '*') gb--;
                                        while (gb >= 0 && (gsrc[gb] == ' '
                                               || gsrc[gb] == '\t'
                                               || gsrc[gb] == '\n'
                                               || gsrc[gb] == '\r')) gb--;
                                        if (gb >= 0 && gsrc[gb] == '>') ghint = 1;
                                        if (!ghint && gb >= 0
                                            && ((gsrc[gb] >= 'A' && gsrc[gb] <= 'Z')
                                                || (gsrc[gb] >= 'a' && gsrc[gb] <= 'z')
                                                || (gsrc[gb] >= '0' && gsrc[gb] <= '9')
                                                || gsrc[gb] == '_')) {
                                            int gw0 = gb;
                                            while (gw0 > 0
                                                   && ((gsrc[gw0 - 1] >= 'A'
                                                        && gsrc[gw0 - 1] <= 'Z')
                                                       || (gsrc[gw0 - 1] >= 'a'
                                                           && gsrc[gw0 - 1] <= 'z')
                                                       || (gsrc[gw0 - 1] >= '0'
                                                           && gsrc[gw0 - 1] <= '9')
                                                       || gsrc[gw0 - 1] == '_'))
                                                gw0--;
                                            snprintf(gtp, sizeof gtp, "%.*s",
                                                     gb - gw0 + 1, gsrc + gw0);
                                            if ((gtp1 > gtp0
                                                 && gtp1 - gtp0 == (int)strlen(gtp)
                                                 && strncmp(gsrc + gtp0, gtp,
                                                            (size_t)(gtp1 - gtp0)) == 0)
                                                || strcmp(gtp, "void") == 0
                                                || strcmp(gtp, "char") == 0
                                                || strcmp(gtp, "short") == 0
                                                || strcmp(gtp, "int") == 0
                                                || strcmp(gtp, "long") == 0
                                                || strcmp(gtp, "float") == 0
                                                || strcmp(gtp, "double") == 0
                                                || strcmp(gtp, "signed") == 0
                                                || strcmp(gtp, "unsigned") == 0
                                                || strcmp(gtp, "_Bool") == 0
                                                || self->sym->find_type(gtp) >= 0
                                                || self->sym->find_struct(gtp) >= 0
                                                || self->sym->find_trait(gtp) >= 0
                                                || self->sym->find_type_alias(gtp) >= 0)
                                                ghint = 1;
                                        }
                                    }
                                }
                            }
                            gpos = gq;
                            continue;
                        }
                        gpos++;
                    }
                    if (ghint) {
                        char gmsg[MAX_TEXT + 96];
                        snprintf(gmsg, sizeof gmsg,
                                 "generic template '%s' must be defined before its first instantiation",
                                 nm);
                        return tool::diag::ct_sem_error(id_line, id_col, gmsg,
                                                        self->sup->mem->path);
                    }
                }
                /* SH-66: a template generates no C symbol of its own, so a
                   bare template name is never a value -- only `name<type>`
                   names an instance. Without this `int (*p)(int) = id;` exited
                   0 and emitted `= id;`, which only `cc` rejected. The guard
                   sits before the ALL_CAPS fallback so an upper-case template
                   name cannot slip through as a macro either. */
                {
                    int gt = self->sym->find_func(nm);
                    if (gt >= 0 && self->sym->funcs[gt].ntparams == 1) {
                        char tmsg[MAX_TEXT + 64];
                        snprintf(tmsg, sizeof tmsg,
                                 "generic function '%s' needs a type argument", nm);
                        return self->sup->fail(tmsg);
                    }
                }
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    self->arena->nodes[n].text = runtime::text::ct_intern(nm);
                    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                    return n;
                }
                /* a bare function name is a value (`p = handler;`): emit the
                   C spelling the definition was given */
                vf = self->sym->resolve_func(nm);
                if (vf >= 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    self->arena->nodes[n].text = runtime::text::ct_intern(self->sym->funcs[vf].cname);
                    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                    return n;
                }
                /* A name this unit never declared: while a function-pointer
                   value is expected it may come from a C header (`p = strcmp;`),
                   so it is emitted verbatim and the C compiler is the judge.
                   Anywhere else it is a typo, which is reported here. */
                if (self->fnval_ok) {
                    self->arena->nodes[n].kind = N_RAW;
                    self->arena->nodes[n].text = runtime::text::ct_intern(nm);
                    if (!self->arena->nodes[n].text) return self->sup->fail("out of memory");
                    return n;
                }
                return self->sup->fail("use of an undeclared variable");
            }
            return n;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
            int save_assign;
            self->sup->lex_next();
            save_assign = self->assign_ok;
            self->assign_ok = 1;
            n = self->parse_expr();
            if (n < 0) return -1;
            /* A parenthesised comma list is a value (`x = (a, b);`,
               `f((a, b))`): both operands evaluate, the value is the last one.
               The node is the one the statement form builds; each operand is a
               full expression, so an assignment may appear on either side. */
            while (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                int r, w;
                self->sup->lex_next();
                r = self->parse_expr();
                if (r < 0) return -1;
                w = self->sup->new_node(N_BIN);
                if (w < 0) return -1;
                self->arena->nodes[w].a = n;
                self->arena->nodes[w].b = r;
                self->arena->nodes[w].aux = B_COMMA;
                n = w;
            }
            self->assign_ok = save_assign;
            if (self->sup->expect(")") != 0) return -1;
            return n;
        }
        /* Phase 30 S4: a leading `.name` inside an `into` block is the
           receiver's field or method. Return the receiver marker without
           consuming the dot: `parse_postfix` then handles the rest with the
           normal member/method resolution (including trait dispatch and the
           type-host static maps), and the `N_INTO_SELF` marker's static type
           makes that resolution see the receiver's type. */
        if (self->into_node >= 0 && self->lex->tok == T_PUNCT
            && self->lex->tok_is(".")) {
            int owner, base;
            owner = self->into_node;
            base = self->sup->new_node(N_INTO_SELF);
            if (base < 0) return -1;
            self->arena->nodes[base].num = owner;
            self->arena->nodes[base].aux = 1;   /* pointer form for `.name` */
            self->arena->nodes[base].text = runtime::text::ct_intern(self->arena->nodes[owner].text);
            if (!self->arena->nodes[base].text) return self->sup->fail("out of memory");
            return base;
        }
        return self->sup->fail("expected an expression");
    }

    /* Consume the rest of a `Qual::name` path -- the cursor sits on its first
       '::'. Writes the last segment into `name`, the namespace path in
       underscore form (`a_b`, no trailing separator) into `qpath`, and, when the
       path is followed by `(`, the callee's C spelling into `cname`. The
       qualifier is a namespace path (`runtime::arena`) or a type name (`Arena`),
       whose mangled spelling carries the namespace it belongs to. A path that is
       not followed by `(` names a variable, which the caller resolves.

       `form` tells the caller which of those the path turned out to be:
       0 = a qualified variable (resolve with `find_qualified_global`),
       1 = a qualified call (`cname` holds the callee),
       2 = a namespace-host interface value (`Trait::ns`, SH-20): `name` holds
           the trait's C name, `cname` the host's underscore prefix and `qpath`
           the host's source path, for the emitter's diagnostics. */
    int parse_qual_path(char *name, int ncap, char *cname, int ccap,
                        char *qpath, int qcap, int *form)
    {
        char cand[MAX_TEXT];
        char tn[MAX_TEXT];
        char hp[MAX_TEXT];
        const char **seg;
        int nseg, fi, i, w, is_call;
        size_t us;
        (void)self;

        *form = 0;
        /* S1a-0 C2o: the segments live in a growing row block. The old
           `seg[8][160]` cut a qualified path at eight segments; only the
           formal text bound applies now. */
        seg = self->qseg;
        if (self->qsegcap < 8) {
            const char **grown = (const char **)realloc(seg, 8 * sizeof(*grown));
            if (!grown) return self->sup->fail("out of memory");
            seg = grown;
            self->qseg = seg;
            self->qsegcap = 8;
        }
        seg[0] = runtime::text::ct_intern(name);
        if (!seg[0]) return self->sup->fail("out of memory");
        nseg = 1;
        for (;;) {
            if (self->lex->tok != T_PUNCT || !self->lex->tok_is("::"))
                return self->sup->fail("expected '::'");
            self->sup->lex_next();
            if (self->lex->tok != T_ID) return self->sup->fail("expected a name after '::'");
            if (nseg >= self->qsegcap) {
                int ncap = self->qsegcap * 2;
                const char **grown;
                if (ncap > TEXT_LIMIT) ncap = TEXT_LIMIT;
                if (nseg >= ncap) return self->sup->fail("qualified name is too long");
                grown = (const char **)realloc(self->qseg, (size_t)ncap * sizeof(*grown));
                if (!grown) return self->sup->fail("out of memory");
                self->qseg = grown;
                self->qsegcap = ncap;
                seg = grown;
            }
            seg[nseg] = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                     self->lex->tokstr.len);
            if (!seg[nseg]) return self->sup->fail("out of memory");
            nseg++;
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || !self->lex->tok_is("::")) break;
        }
        /* the qualifier: every segment but the last, joined with '_' */
        w = 0;
        qpath[0] = 0;
        for (i = 0; i < nseg - 1; i++) {
            if (i > 0) {
                if (w + 1 >= qcap) return self->sup->fail("qualified name is too long");
                qpath[w] = '_';
                w++;
                qpath[w] = 0;
            }
            if (w + (int)strlen(seg[i]) >= qcap)
                return self->sup->fail("qualified name is too long");
            snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
            w += (int)strlen(seg[i]);
        }
        snprintf(name, (size_t)ncap, "%s", seg[nseg - 1]);
        /* SH-120: `core::utf16::U16String::from_utf8` / `U16Str` name the
           built-in layer's nested namespace; its C symbols stay in the root
           namespace, so the qualifier maps to the bare spelling exactly like
           the type position does. */
        if (strncmp(qpath, "core_utf16_", 11) == 0) {
            memmove(qpath, qpath + 11, strlen(qpath + 11) + 1);
        }
        is_call = (self->lex->tok == T_PUNCT && self->lex->tok_is("("));
        /* A static trait from a `.m.ct` unit: `host::Trait.method(...)`. The
           qualified C spelling names the trait; the source host path is what
           the emitter matches the map against. A static trait has no iface, so
           only a `.` here is legal. */
        if (!is_call && nseg >= 2 && self->lex->tok == T_PUNCT
            && self->lex->tok_is(".")) {
            char tq[MAX_TEXT];
            int st = -1;
            if (snprintf(tq, sizeof tq, "%s_%s", qpath, seg[nseg - 1]) < (int)sizeof tq)
                st = self->sym->find_trait(tq);
            if (st >= 0 && self->sym->traits[st].is_static) {
                int hw = 0;
                qpath[0] = 0;
                for (i = 0; i < nseg - 1; i++) {
                    if (i > 0) {
                        if (hw + 2 >= qcap) return self->sup->fail("qualified name is too long");
                        qpath[hw] = ':';
                        qpath[hw + 1] = ':';
                        hw += 2;
                        qpath[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= qcap)
                        return self->sup->fail("qualified name is too long");
                    snprintf(qpath + hw, (size_t)(qcap - hw), "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                snprintf(name, (size_t)ncap, "%s", self->sym->traits[st].name);
                *form = 3;
                return 0;
            }
        }
        if (is_call) {
            if (snprintf(cand, sizeof cand, "%s_%s", qpath, seg[nseg - 1]) >= (int)sizeof cand)
                return self->sup->fail("qualified name is too long");
            fi = self->sym->find_func(cand);
            if (fi < 0 && nseg == 2) {
                /* a lone segment may be a type: its C name is `<prefix><Type>`, so
                   the namespace prefix is everything up to its last '_' */
                if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0) {
                    us = strlen(tn);
                    while (us > 0 && tn[us - 1] != '_') us--;
                    tn[us] = 0;
                    if (snprintf(cand, sizeof cand, "%s%s", tn, seg[1]) < (int)sizeof cand)
                        fi = self->sym->find_func(cand);
                }
            }
            if (fi < 0) {
                /* P20-01: `Trait::method(recv, ...)` names a static trait
                   explicitly, so two packages may bind the same method to one
                   host type and the caller picks one. The qualifier is joined
                   the way symbol names are (`a::ALen` -> `a_ALen`); the last
                   segment must be a method of that trait, so a namespace
                   function of a similar name is not hijacked. */
                char tq[MAX_TEXT];
                int st = -1;
                if (nseg == 2) {
                    if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0)
                        st = self->sym->find_trait(tn);
                    if (st < 0) st = self->sym->find_trait(seg[0]);
                } else if (snprintf(tq, sizeof tq, "%s", qpath) < (int)sizeof tq) {
                    st = self->sym->find_trait(tq);
                }
                if (st >= 0 && self->sym->traits[st].is_static) {
                    int mi2, okm = 0;
                    for (mi2 = 0; mi2 < self->sym->traits[st].nm; mi2++)
                        if (strcmp(self->sym->traits[st].m[mi2].name, seg[nseg - 1]) == 0)
                            okm = 1;
                    if (okm) {
                        int hw2 = 0;
                        qpath[0] = 0;
                        for (i = 0; i < nseg - 1; i++) {
                            if (i > 0) {
                                if (hw2 + 2 >= qcap)
                                    return self->sup->fail("qualified name is too long");
                                qpath[hw2] = ':';
                                qpath[hw2 + 1] = ':';
                                hw2 += 2;
                                qpath[hw2] = 0;
                            }
                            if (hw2 + (int)strlen(seg[i]) >= qcap)
                                return self->sup->fail("qualified name is too long");
                            snprintf(qpath + hw2, (size_t)(qcap - hw2), "%s", seg[i]);
                            hw2 += (int)strlen(seg[i]);
                        }
                        snprintf(name, (size_t)ncap, "%s", self->sym->traits[st].name);
                        snprintf(cname, (size_t)ccap, "%s", seg[nseg - 1]);
                        *form = 5;
                        return 0;
                    }
                }
                /* A static namespace-host map may be called without its trait
                   segment: `std::io::puts(...)` names the host by namespace and
                   the method directly. The recipe is the same one
                   `std::io::Io.puts(...)` expands, so the emitter needs no new
                   form; only an ambiguous method name is rejected. */
                char host[MAX_TEXT];
                char only[2][MAX_TEXT];
                int hw = 0, mp, bi, hits = 0;
                host[0] = 0;
                for (i = 0; i < nseg - 1; i++) {
                    if (i > 0) {
                        if (hw + 2 >= (int)sizeof host)
                            return self->sup->fail("qualified name is too long");
                        host[hw] = ':';
                        host[hw + 1] = ':';
                        hw += 2;
                        host[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= (int)sizeof host)
                        return self->sup->fail("qualified name is too long");
                    snprintf(host + hw, sizeof host - (size_t)hw, "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                for (mp = 0; mp < *self->nmaps; mp++) {
                    if (!(*self->maps)[mp].is_static || !(*self->maps)[mp].ns_host)
                        continue;
                    if (strcmp((*self->maps)[mp].inst, host) != 0) continue;
                    for (bi = 0; bi < (*self->maps)[mp].nb; bi++) {
                        if (strcmp((*self->maps)[mp].b[bi].method, seg[nseg - 1]) != 0) continue;
                        if (hits < 2)
                            snprintf(only[hits], MAX_TEXT, "%s", (*self->maps)[mp].trait);
                        hits++;
                    }
                }
                if (hits > 1) {
                    char m[MAX_TEXT * 2];
                    snprintf(m, sizeof m, "'%s' is ambiguous on '%s': bound by %s and %s",
                             seg[nseg - 1], host, only[0], only[1]);
                    return self->sup->fail(m);
                }
                if (hits == 1) {
                    snprintf(name, (size_t)ncap, "%s", only[0]);
                    snprintf(cname, (size_t)ccap, "%s", seg[nseg - 1]);
                    snprintf(qpath, (size_t)qcap, "%s", host);
                    *form = 4;
                    return 0;
                }
                return self->sup->fail("no function of that name in that namespace");
            }
            snprintf(cname, (size_t)ccap, "%s", self->sym->funcs[fi].cname);
            *form = 1;
            return 0;
        }
        /* SH-20: `Trait::ns` names a namespace host, not a variable. Only a
           trait qualifier takes this form; a struct or typedef stays a
           (rejected) qualified variable. */
        if (nseg >= 2 && self->sym->resolve_type(seg[0], tn, sizeof tn) == 0
            && self->sym->find_trait(tn) >= 0) {
            /* A static trait has no iface to box, so `Trait::host` is always the
               wrong shape; name the form that works at the site. */
            int st = self->sym->find_trait(tn);
            if (st >= 0 && self->sym->traits[st].is_static) {
                char host[MAX_TEXT];
                char m[MAX_TEXT * 2];
                int hw = 0;
                host[0] = 0;
                for (i = 1; i < nseg; i++) {
                    if (i > 1 && hw + 2 < (int)sizeof host) {
                        host[hw] = ':';
                        host[hw + 1] = ':';
                        hw += 2;
                        host[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= (int)sizeof host)
                        return self->sup->fail("qualified name is too long");
                    snprintf(host + hw, sizeof host - (size_t)hw, "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                snprintf(m, sizeof m,
                         "a static trait has no interface value; call '%s::%s.<method>()'",
                         host, seg[0]);
                return self->sup->fail(m);
            }
            /* the host in underscore form, then the symbol prefix spelled the
               way `map` spells it: a trait that already carries the namespace
               keeps its own name (SH-20 §4) */
            w = 0;
            hp[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 1 >= (int)sizeof hp)
                        return self->sup->fail("qualified name is too long");
                    hp[w] = '_';
                    w++;
                    hp[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= (int)sizeof hp)
                    return self->sup->fail("qualified name is too long");
                snprintf(hp + w, sizeof hp - (size_t)w, "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            if (strncmp(tn, hp, strlen(hp)) == 0 && tn[strlen(hp)] == '_')
                snprintf(cname, (size_t)ccap, "%s", tn);
            else if (snprintf(cname, (size_t)ccap, "%s_%s", hp, tn) >= ccap)
                return self->sup->fail("qualified name is too long");
            /* and the host in source form, for the emitter's diagnostic */
            w = 0;
            qpath[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 2 >= qcap) return self->sup->fail("qualified name is too long");
                    qpath[w] = ':';
                    qpath[w + 1] = ':';
                    w += 2;
                    qpath[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= qcap)
                    return self->sup->fail("qualified name is too long");
                snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            snprintf(name, (size_t)ncap, "%s", tn);
            *form = 2;
            return 0;
        }
        return 0;
    }

    int parse_args(void)
    {
        int first, tail, e, base, k;
        (void)self;

        if (self->sup->expect("(") != 0) return -1;
        base = self->narg_pos;
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
            self->sup->lex_next();
            self->arg_base = base;
            return 0;
        }
        first = -1;
        tail = -1;
        k = 0;
        for (;;) {
            int aline = self->lex->tokline;
            int acol = self->lex->tokstart - self->lex->lstart + 1;
            /* the frame grows before the argument is parsed, so a nested
               call appends after this slot instead of over the earlier ones */
            if (ensure_arg_capacity(self, base + k + 1) != 0) return -1;
            self->narg_pos = base + k;
            e = self->parse_expr();
            if (e < 0) return -1;
            if (base + k < self->argcap) {
                self->arg_line[base + k] = aline;
                self->arg_col[base + k] = acol;
            }
            k++;
            if (tail < 0) first = e;
            else self->arena->nodes[tail].next = e;
            tail = e;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->sup->expect(")") != 0) return -1;
        self->arg_base = base;
        self->narg_pos = base;   /* pop: siblings reuse the same slots */
        return first;
    }

}

/* LANG-24: only the built-in `lib/core/Box.h.ct` template auto-dereferences
   as the owning handle. A project may still declare its own `struct Box<T>`
   (the historical fixtures do); those instances share the `Box_` prefix but
   are ordinary structs. */


/* Phase 84 (D84-1/D84-3): `Type.Variant(args)` constructs one ADT variant. The
   variant's payload fields are typed, so arity and a confident type mismatch are
   hard errors at the constructor's own position (E84-2). The C form is a
   compound literal, which needs no helper function and therefore no
   unused-static allowance; the emitter owns that spelling. */

/* SH-115: the brace-initializer item scanner below is plain text work. It
   never re-parses an expression; it only recognises an item that is one
   literal and answers the C type `chk_assignable` needs. Anything else is
   "undecidable" and skipped, which is what keeps the check free of false
   positives. */
/* `s[0..n)` is one literal exactly when it is a string, a character constant,
   or a decimal integer / floating literal with an optional suffix. `out` is
   the C value type, `is_zero` marks the integer constant 0 (the null pointer
   constant). 0 means "not one literal". */
/* v1-PH-0 S0.5b: the shared tail of the kinds whose type is judged by
   `static_ctype` (the old `break` group). */
/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
/* LANG-26: the four binding sites reach the lookup through this method. */
static struct Expr g_expr;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls, void *callcap, void *maps, void *nmaps);
void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls, void *callcap, void *maps, void *nmaps)
{
    g_expr.arena = (struct Arena *)arena;
    g_expr.lex = (struct Lexer *)lex;
    g_expr.sym = (struct Symbols *)sym;
    g_expr.sup = (struct ParseSupport *)sup;
    g_expr.cur_func = (const char **)cur_func;
    g_expr.calls = (struct Call **)calls;
    g_expr.ncalls = (int *)ncalls;
    g_expr.callcap = (int *)callcap;
    g_expr.maps = (struct MapTable **)maps;
    g_expr.nmaps = (int *)nmaps;
    g_expr.postfix_seed = -1;
    g_expr.into_node = -1;
}

pub struct Expr *expr_get(void);
struct Expr *expr_get(void)
{
    return &g_expr;
}

/* Phase 31 S23a: the borrowed-view provenance of an expression root. A chain
   of fields / derefs is followed to the value underneath, because a view of a
   view is still borrowed. */
int expr_borrow_root(struct Expr *self, int n)
{
    while (n >= 0) {
        int k = self->arena->nodes[n].kind;
        if (k == N_MEMBER || k == N_ARROW || k == N_DEREF) {
            n = self->arena->nodes[n].a;
            continue;
        }
        if (k == N_VAR) {
            int vi = self->sym->find_var(self->arena->nodes[n].text2);
            return vi >= 0 && self->sym->vars[vi].cview;
        }
        if (k == N_MCALL
            && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
            && (strcmp(self->arena->nodes[n].text2, "get") == 0
                || strcmp(self->arena->nodes[n].text2, "entry") == 0)) {
            const char *ty = self->arena->nodes[n].text;
            /* SH-102: the receiver is spelled as the template (`Vec<String>`)
               while the method body still sees the type, and as the encoded
               instance (`Vec_String`) once the row exists; either spelling is
               the same container. */
            if (strncmp(ty, "struct Vec_", 11) == 0
                || strncmp(ty, "Vec_", 4) == 0
                || strncmp(ty, "struct Vec<", 10) == 0
                || strncmp(ty, "Vec<", 4) == 0
                || strncmp(ty, "struct Map_", 11) == 0
                || strncmp(ty, "Map_", 4) == 0
                || strncmp(ty, "struct Map<", 10) == 0
                || strncmp(ty, "Map<", 4) == 0)
                return 1;
        }
        return 0;
    }
    return 0;
}

