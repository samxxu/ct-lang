/*
 * Expr.h.ct - the expression and type grammar, one sub-object of the parser.
 *
 * The precedence chain (`parse_expr` down to `parse_primary`), the argument
 * list and the call-graph record sit here with the type specifier reader the
 * chain leans on: `sizeof` and casts need `parse_type`, so the two share an
 * object rather than calling back into the parser. The parser keeps statements
 * and declarations and invites the chain in through `expr_get`; this object
 * only points at the cursor, the shared primitives, the symbol tables, the node
 * pool and the call table the driver reads back.
 *
 * Macros do not cross a unit boundary, so the caps, node kinds, token kinds and
 * operator codes used here are declared here; MAX_TEXT 160 is the value
 * `frontend/sym/Symbols.h.ct` lists.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>

import frontend::lex::Lexer;
import frontend::module::Map::Call as Call;
import frontend::module::Map;
import frontend::parse::ParseSupport;
import frontend::sym::Symbols;
import runtime::arena::Arena;

#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 1024
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DEREF 28
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define P_DEC 2
#define P_INC 1
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3

namespace frontend::parse;
/* `cur_func` and the call table stay the parser's (the driver reads them back),
   so this object points at them; `calls` points into storage that unit owns. */
pub trait ExprOps {
    int  is_type_word(const char *w);
    int  type_append(char *out, int cap, int *n, const char *tok);
    int  parse_type(char *out, int cap);
    int  parse_array_dims(int n);
    int  next_is_type_name(void);
    int  parse_expr(void);
    int  parse_bitor(void);
    int  parse_bxor(void);
    int  parse_bitand(void);
    int  parse_shift(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  parse_qual_path(char *name, int ncap, char *cname, int ccap, char *qpath, int qcap,
                         int *form);
    int  record_call(const char *callee, int line);
}

pub struct Expr {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct ParseSupport *sup;
    char *cur_func;                      /* the parser's current function name */
    struct Call *calls;  /* storage owned by parse.h.ct */
    int *ncalls;
    /* A function-pointer declarator carries its name inside the type
       (`int (*cb)(void *)`), so `parse_type` reads it and the caller takes it
       from here instead of expecting an identifier of its own. 160 is MAX_TEXT
       here: the generated header carries no macros. (D-7) */
    char fnptr_name[160];
    int  fnptr_state;
    /* Set while the expression being parsed may name a C library function
       (`p = strcmp;`, `p = &strcmp;`): an unknown bare identifier is then
       emitted verbatim instead of being rejected. */
    int  fnval_ok;
} use ExprOps;

impl ExprOps for Expr {
    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "int") == 0 || strcmp(w, "void") == 0
            || strcmp(w, "char") == 0 || strcmp(w, "unsigned") == 0
            || strcmp(w, "signed") == 0 || strcmp(w, "long") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "enum") == 0
            || strcmp(w, "union") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0;
    }

    int type_append(char *out, int cap, int *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->sup->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, (size_t)(cap - *n), "%s", tok);
        if (w < 0 || w >= cap - *n) return self->sup->fail("type is too long");
        *n += w;
        return 0;
    }

    /* Consume a type specifier. `struct X` keeps the tag; a known typedef name
       is part of the type; `*` accumulates (9.3 supports a single pointer). */
    int parse_type(char *out, int cap)
    {
        int n;
        (void)self;

        n = 0;
        out[0] = 0;
        self->fnptr_state = 0;
        self->fnptr_name[0] = 0;
        for (;;) {
            if (self->lex->tok == T_ID && self->is_type_word(self->lex->toktext)) {
                if (self->type_append(out, cap, &n, self->lex->toktext) != 0) return -1;
                if (strcmp(self->lex->toktext, "struct") == 0) {
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a struct name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 1) != 0) return -1;
                }
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID) {
                int ti;
                char rname[MAX_TEXT];
                char iface[MAX_TEXT];
                if (self->sup->resolve_type(self->lex->toktext, rname, sizeof rname) != 0) return -1;
                ti = self->sym->find_type(rname);
                if (ti < 0) break;
                /* a bare struct tag needs `struct`; a trait becomes its iface */
                if (self->sym->type_kind[ti] == 1) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                } else if (self->sym->type_kind[ti] == 3) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (snprintf(iface, sizeof iface, "%s_iface", rname) >= (int)sizeof iface)
                        return self->sup->fail("type name is too long");
                    if (self->type_append(out, cap, &n, iface) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            break;
        }
        /* `ret (*name)(params)`: the declarator belongs to the type, so it is
           consumed here and the caller takes the name from `fnptr_name`. One
           level only -- a function pointer is not a return type and cannot nest
           (2b.4). A `(` that does not open `(*` is left alone: no other caller
           of `parse_type` can have one there. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            int save_tok, save_line, save_srcline, save_bol;
            long save_num;
            size_t save_pos;
            char save_text[MAX_TEXT];
            save_tok = self->lex->tok;
            save_num = self->lex->toknum;
            save_line = self->lex->tokline;
            save_pos = self->lex->pos;
            save_srcline = self->lex->line;
            save_bol = self->lex->bol;
            snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                char plist[MAX_TEXT];
                char dname[MAX_TEXT];
                int pn;
                self->sup->lex_next();
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a name in the function-pointer declarator");
                /* keep the name here: parsing the parameter list below calls
                   `parse_type` again, which clears `fnptr_name` */
                snprintf(dname, sizeof dname, "%s", self->lex->toktext);
                self->sup->lex_next();
                if (self->sup->expect(")") != 0) return -1;
                if (self->sup->expect("(") != 0) return -1;
                pn = 0;
                plist[0] = 0;
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                    for (;;) {
                        char pt[MAX_TEXT];
                        const char *joiner;
                        if (self->parse_type(pt, sizeof pt) != 0) return -1;
                        if (self->fnptr_state)
                            return self->sup->fail("nested function pointers are not supported");
                        if (self->lex->tok == T_ID) self->sup->lex_next();
                        joiner = (pn > 0) ? ", " : "";
                        if (pn + (int)strlen(joiner) + (int)strlen(pt) + 6 > MAX_TEXT)
                            return self->sup->fail("a function-pointer signature is too long");
                        snprintf(plist + pn, (size_t)(MAX_TEXT - pn), "%s%s", joiner, pt);
                        pn += (int)(strlen(joiner) + strlen(pt));
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                            self->sup->lex_next();
                            continue;
                        }
                        break;
                    }
                }
                if (self->sup->expect(")") != 0) return -1;
                if (pn == 0) snprintf(plist, sizeof plist, "%s", "void");
                {
                    char sig[MAX_TEXT];
                    snprintf(sig, sizeof sig, "(*)(%s)", plist);
                    if (self->type_append(out, cap, &n, sig) != 0) return -1;
                }
                snprintf(self->fnptr_name, MAX_TEXT, "%s", dname);
                self->fnptr_state = 1;
            } else {
                self->lex->tok = save_tok;
                self->lex->toknum = save_num;
                self->lex->tokline = save_line;
                self->lex->pos = save_pos;
                self->lex->line = save_srcline;
                self->lex->bol = save_bol;
                snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
            }
        }
        if (n == 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "expected a type (tok %d '%s')", self->lex->tok, self->lex->toktext);
            return self->sup->fail(msg);
        }
        return 0;
    }

    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    int parse_array_dims(int n)
    {
        (void)self;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
            char dim[MAX_TEXT];
            char cur[MAX_TEXT];
            int unsized;
            unsized = 0;
            self->sup->lex_next();
            if (self->lex->tok == T_NUM) {
                snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
            } else if (self->lex->tok == T_ID) {
                snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                /* `T a[][N]`: an unsized parameter dimension (10.6) */
                snprintf(dim, sizeof dim, "[]");
                unsized = 1;
            } else {
                return self->sup->fail("expected an array length");
            }
            if (!unsized) self->sup->lex_next();
            if (self->sup->expect("]") != 0) return -1;
            snprintf(cur, sizeof cur, "%s%s", self->arena->nodes[n].text3, dim);
            snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cur);
            self->arena->nodes[n].num = 0;      /* text3 is the authoritative spelling */
        }
        return 0;
    }

    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->sup->lex_next();
        res = 0;
        if (self->lex->tok == T_ID) {
            char rn[MAX_TEXT];
            /* resolve first: an imported name is a type even though the table
               only holds its mangled spelling */
            if (self->is_type_word(self->lex->toktext)) {
                res = 1;
            } else if (self->sup->resolve_type(self->lex->toktext, rn, sizeof rn) == 0
                       && self->sym->find_type(rn) >= 0) {
                res = 1;
            }
        }
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    int parse_expr(void)
    {
        int left, right, inner, n, c;
        (void)self;

        /* C precedence, loosest first: `||`, `&&`, then the bitwise levels
           (`|` `^` `&`) owned by parse_bitor. The loops live here so the
           trait's method budget stays put. */
        left = self->parse_bitor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
            self->sup->lex_next();
            right = self->parse_bitor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_AND;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "||") == 0) {
            self->sup->lex_next();
            right = self->parse_bitor();
            if (right < 0) return -1;
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
                self->sup->lex_next();
                inner = self->parse_bitor();
                if (inner < 0) return -1;
                n = self->sup->new_node(N_BIN);
                if (n < 0) return -1;
                self->arena->nodes[n].a = right;
                self->arena->nodes[n].b = inner;
                self->arena->nodes[n].aux = B_AND;
                right = n;
            }
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_OR;
            left = n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "?") == 0) {
            int a, b;
            self->sup->lex_next();
            a = self->parse_expr();
            if (a < 0) return -1;
            if (self->sup->expect(":") != 0) return -1;
            b = self->parse_expr();
            if (b < 0) return -1;
            c = self->sup->new_node(N_TERN);
            if (c < 0) return -1;
            self->arena->nodes[c].a = left;
            self->arena->nodes[c].b = a;
            self->arena->nodes[c].c = b;
            return c;
        }
        return left;
    }

    /* `|`, `^`, `&` are three separate levels in C, and `<<` / `>>` bind
       tighter than the comparisons but looser than `+` / `-`. */
    int parse_bitor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bxor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "|") == 0) {
            self->sup->lex_next();
            right = self->parse_bxor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BOR;
            left = n;
        }
        return left;
    }

    int parse_bxor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bitand();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "^") == 0) {
            self->sup->lex_next();
            right = self->parse_bitand();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_XOR;
            left = n;
        }
        return left;
    }

    int parse_bitand(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_cmp();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            self->sup->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BAND;
            left = n;
        }
        return left;
    }

    int parse_shift(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT
               && (strcmp(self->lex->toktext, "<<") == 0 || strcmp(self->lex->toktext, ">>") == 0)) {
            op = (self->lex->toktext[0] == '<') ? B_SHL : B_SHR;
            self->sup->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_shift();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT) {
            op = 0;
            if (strcmp(self->lex->toktext, "<") == 0) op = B_LT;
            else if (strcmp(self->lex->toktext, ">") == 0) op = B_GT;
            else if (strcmp(self->lex->toktext, "<=") == 0) op = B_LE;
            else if (strcmp(self->lex->toktext, ">=") == 0) op = B_GE;
            else if (strcmp(self->lex->toktext, "==") == 0) op = B_EQ;
            else if (strcmp(self->lex->toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->sup->lex_next();
            right = self->parse_shift();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+") == 0 || strcmp(self->lex->toktext, "-") == 0)) {
            op = (self->lex->toktext[0] == '+') ? B_ADD : B_SUB;
            self->sup->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "*") == 0
               || strcmp(self->lex->toktext, "/") == 0 || strcmp(self->lex->toktext, "%") == 0)) {
            op = B_MUL;
            if (self->lex->toktext[0] == '/') op = B_DIV;
            else if (self->lex->toktext[0] == '%') op = B_MOD;
            self->sup->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "sizeof") == 0) {
            char tbuf[MAX_TEXT];
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
                && self->next_is_type_name()) {
                self->sup->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->sup->expect(")") != 0) return -1;
                n = self->sup->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[n].aux = 1;
                return n;
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_SIZEOF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->sup->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_CAST);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            self->arena->nodes[n].a = e;
            return n;
        }
        op = 0;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "-") == 0) op = U_NEG;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "!") == 0) op = U_NOT;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "~") == 0) op = U_BNOT;
        if (op != 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_UNARY);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = op;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            int save;
            self->sup->lex_next();
            save = self->fnval_ok;
            self->fnval_ok = 1;      /* `&handler` may name a C library function */
            e = self->parse_unary();
            self->fnval_ok = save;
            if (e < 0) return -1;
            n = self->sup->new_node(N_ADDR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_DEREF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    int parse_postfix(void)
    {
        int n, m, idx, args;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->parse_primary();
        if (n < 0) return -1;
        for (;;) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                self->sup->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->sup->expect("]") != 0) return -1;
                m = self->sup->new_node(N_INDEX);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].b = idx;
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, ".") == 0
                                     || strcmp(self->lex->toktext, "->") == 0)) {
                int arrow;
                arrow = (self->lex->toktext[0] == '-') ? 1 : 0;
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a field or method name");
                snprintf(fname, sizeof fname, "%s", self->lex->toktext);
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                    self->arena->nodes[m].aux = arrow ? 2 : 1;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs */
                    if (self->sup->expr_type(n, rtype, sizeof rtype) == 0) {
                        char ibase[MAX_TEXT];
                        size_t il;
                        int piface = 0;
                        /* a pointer to an interface value dispatches through
                           `->vt` instead of `.vt` */
                        snprintf(ibase, sizeof ibase, "%s", rtype);
                        il = strlen(ibase);
                        while (il > 0 && (ibase[il - 1] == ' ' || ibase[il - 1] == '*')) {
                            if (ibase[il - 1] == '*') piface = 1;
                            il--;
                            ibase[il] = 0;
                        }
                        if (self->sup->is_iface_type(ibase, trname, sizeof trname)) {
                            int t = self->sym->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                                    if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                self->arena->nodes[m].aux = piface ? 4 : 3;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            }
                        } else if (self->sup->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                        }
                    }
                } else {
                    m = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                }
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                /* a call through a pointer expression: `(*p)(x)` (D-7). A plain
                   `name(...)` was already consumed by `parse_primary`. */
                args = self->parse_args();
                if (args < 0) return -1;
                m = self->sup->new_node(N_CALL);
                if (m < 0) return -1;
                self->arena->nodes[m].a = (args == 0) ? -1 : args;
                self->arena->nodes[m].b = n;
                self->arena->nodes[m].aux = 2;
                n = m;
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0 || strcmp(self->lex->toktext, "--") == 0)) {
            int k;
            k = self->arena->nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->sup->fail("'++' / '--' need an assignable target");
            m = self->sup->new_node(N_POST);
            if (m < 0) return -1;
            self->arena->nodes[m].a = n;
            self->arena->nodes[m].aux = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            return m;
        }
        return n;
    }

    int parse_primary(void)
    {
        int n, args, id_line;
        char qc[MAX_TEXT];
        char qv[MAX_TEXT];
        char tsrc[MAX_TEXT];
        char tag[MAX_TEXT];
        int qf;
        (void)self;

        qc[0] = 0;
        qv[0] = 0;
        if (self->lex->tok == T_NUM) {
            n = self->sup->new_node(N_NUM);
            if (n < 0) return -1;
            self->arena->nodes[n].num = self->lex->toknum;
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_STR) {
            int off = self->arena->str_begin();
            n = self->sup->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (self->lex->tok == T_STR) {
                int m = 0;
                while (self->lex->toktext[m]) {
                    if (self->arena->str_put((unsigned char)self->lex->toktext[m]) != 0)
                        return self->sup->fail("string pool is full");
                    m++;
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            return n;
        }
        if (self->lex->tok == T_ID) {
            id_line = self->lex->tokline;
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->lex->toktext);
            self->sup->lex_next();
            /* `Qual::fn(...)`: the qualifier names a namespace path or a type,
               and the callee lives in that namespace. Without the call it names
               a variable instead (`a::h`), whose C spelling is the mangled one. */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                snprintf(tsrc, sizeof tsrc, "%s", self->arena->nodes[n].text2);
                if (self->parse_qual_path(self->arena->nodes[n].text2, MAX_TEXT, qc, MAX_TEXT,
                                          qv, MAX_TEXT, &qf) != 0)
                    return -1;
                /* `Trait::ns`: a namespace-host interface value (SH-20). The
                   host has no object, so the node carries no operand (`a`), the
                   vtable is named after `text2` and `text3` keeps the source
                   spelling for the emitter's diagnostics. */
                if (qf == 2) {
                    if (snprintf(tag, sizeof tag, "%s|%s", tsrc, qv) >= MAX_TEXT)
                        return self->sup->fail("qualified name is too long");
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", tag);
                    self->arena->nodes[n].kind = N_BOX;
                    self->arena->nodes[n].a = -1;
                    self->arena->nodes[n].aux = 4;
                    self->arena->nodes[n].b = -1;
                    return n;
                }
                if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
                    if (self->sym->find_qualified_global(qv, self->arena->nodes[n].text2,
                                                         qc, MAX_TEXT) != 0)
                        return self->sup->fail("no variable of that name in that namespace"
                                               " (qualified type names are not supported;"
                                               " use the bare name or an alias import)");
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", qc);
                    return n;
                }
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                int fi;
                args = self->parse_args();
                if (args < 0) return -1;
                self->sym->errmsg[0] = 0;
                if (qc[0]) fi = self->sym->find_func(qc);
                else fi = self->sym->resolve_func(self->arena->nodes[n].text2);
                if (fi < 0) {
                    const char *why = self->sym->last_error();
                    if (why[0]) return self->sup->fail(why);
                }
                /* `p(args)` on a function-pointer variable: no function of that
                   name exists and the lookup said nothing, so the callee is the
                   variable. Calls through a pointer are emitted uniformly as
                   `(*p)(args)` (D-7). */
                if (fi < 0) {
                    char vt[MAX_TEXT];
                    if (self->sym->var_type(self->arena->nodes[n].text2, vt, sizeof vt) == 0
                        && strstr(vt, "(*"))
                        self->arena->nodes[n].aux = 1;
                }
                /* the call graph keeps the name the source wrote */
                if (fi >= 0 && self->record_call(self->arena->nodes[n].text2, id_line) != 0) return -1;
                /* the emitted call must spell the definition's C name */
                if (fi >= 0)
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->sym->funcs[fi].cname);
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < self->sym->funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        int ip = 0;
                        if (self->sup->iface_ref_type(self->sym->funcs[fi].ptype[k], tr, sizeof tr, &ip)) {
                            int boxed = self->sup->maybe_box(cur, tr, ip);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else self->arena->nodes[prev].next = boxed;
                                self->arena->nodes[boxed].next = self->arena->nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                self->arena->nodes[n].kind = N_CALL;
                self->arena->nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->sym->find_var(self->arena->nodes[n].text2) >= 0) {
                /* a declared variable: a namespaced global is emitted under its
                   mangled C name, which is kept on the node for the emitter; a
                   bare name may not pick between two imported exports */
                char cn[MAX_TEXT];
                const char *nm = self->arena->nodes[n].text2;
                if (self->sym->var_ambiguous(nm)) {
                    char amsg[512];
                    snprintf(amsg, sizeof amsg,
                             "variable '%s' is exported by more than one namespace; use a qualified name", nm);
                    return self->sup->fail(amsg);
                }
                if (self->sym->var_cname(nm, cn, sizeof cn) == 0 && strcmp(cn, nm) != 0)
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cn);
            } else {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps, vf;
                const char *nm = self->arena->nodes[n].text2;
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                /* a bare function name is a value (`p = handler;`): emit the
                   C spelling the definition was given */
                vf = self->sym->resolve_func(nm);
                if (vf >= 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->sym->funcs[vf].cname);
                    return n;
                }
                /* A name this unit never declared: while a function-pointer
                   value is expected it may come from a C header (`p = strcmp;`),
                   so it is emitted verbatim and the C compiler is the judge.
                   Anywhere else it is a typo, which is reported here. */
                if (self->fnval_ok) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                return self->sup->fail("use of an undeclared variable");
            }
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            self->sup->lex_next();
            n = self->parse_expr();
            if (n < 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            return n;
        }
        return self->sup->fail("expected an expression");
    }

    /* Consume the rest of a `Qual::name` path -- the cursor sits on its first
       '::'. Writes the last segment into `name`, the namespace path in
       underscore form (`a_b`, no trailing separator) into `qpath`, and, when the
       path is followed by `(`, the callee's C spelling into `cname`. The
       qualifier is a namespace path (`runtime::arena`) or a type name (`Arena`),
       whose mangled spelling carries the namespace it belongs to. A path that is
       not followed by `(` names a variable, which the caller resolves.

       `form` tells the caller which of those the path turned out to be:
       0 = a qualified variable (resolve with `find_qualified_global`),
       1 = a qualified call (`cname` holds the callee),
       2 = a namespace-host interface value (`Trait::ns`, SH-20): `name` holds
           the trait's C name, `cname` the host's underscore prefix and `qpath`
           the host's source path, for the emitter's diagnostics. */
    int parse_qual_path(char *name, int ncap, char *cname, int ccap,
                        char *qpath, int qcap, int *form)
    {
        char seg[8][MAX_TEXT];
        char cand[MAX_TEXT];
        char tn[MAX_TEXT];
        char hp[MAX_TEXT];
        int nseg, fi, i, w, is_call;
        size_t us;
        (void)self;

        *form = 0;
        snprintf(seg[0], MAX_TEXT, "%s", name);
        nseg = 1;
        for (;;) {
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "::") != 0)
                return self->sup->fail("expected '::'");
            self->sup->lex_next();
            if (self->lex->tok != T_ID) return self->sup->fail("expected a name after '::'");
            if (nseg >= 8) return self->sup->fail("qualified name is too long");
            snprintf(seg[nseg], MAX_TEXT, "%s", self->lex->toktext);
            nseg++;
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "::") != 0) break;
        }
        /* the qualifier: every segment but the last, joined with '_' */
        w = 0;
        qpath[0] = 0;
        for (i = 0; i < nseg - 1; i++) {
            if (i > 0) {
                if (w + 1 >= qcap) return self->sup->fail("qualified name is too long");
                qpath[w] = '_';
                w++;
                qpath[w] = 0;
            }
            if (w + (int)strlen(seg[i]) >= qcap)
                return self->sup->fail("qualified name is too long");
            snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
            w += (int)strlen(seg[i]);
        }
        snprintf(name, (size_t)ncap, "%s", seg[nseg - 1]);
        is_call = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0);
        if (is_call) {
            if (snprintf(cand, sizeof cand, "%s_%s", qpath, seg[nseg - 1]) >= (int)sizeof cand)
                return self->sup->fail("qualified name is too long");
            fi = self->sym->find_func(cand);
            if (fi < 0 && nseg == 2) {
                /* a lone segment may be a type: its C name is `<prefix><Type>`, so
                   the namespace prefix is everything up to its last '_' */
                if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0) {
                    us = strlen(tn);
                    while (us > 0 && tn[us - 1] != '_') us--;
                    tn[us] = 0;
                    if (snprintf(cand, sizeof cand, "%s%s", tn, seg[1]) < (int)sizeof cand)
                        fi = self->sym->find_func(cand);
                }
            }
            if (fi < 0) return self->sup->fail("no function of that name in that namespace");
            snprintf(cname, (size_t)ccap, "%s", self->sym->funcs[fi].cname);
            *form = 1;
            return 0;
        }
        /* SH-20: `Trait::ns` names a namespace host, not a variable. Only a
           trait qualifier takes this form; a struct or typedef stays a
           (rejected) qualified variable. */
        if (nseg >= 2 && self->sym->resolve_type(seg[0], tn, sizeof tn) == 0
            && self->sym->find_trait(tn) >= 0) {
            /* the host in underscore form, then the symbol prefix spelled the
               way `map` spells it: a trait that already carries the namespace
               keeps its own name (SH-20 §4) */
            w = 0;
            hp[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 1 >= (int)sizeof hp)
                        return self->sup->fail("qualified name is too long");
                    hp[w] = '_';
                    w++;
                    hp[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= (int)sizeof hp)
                    return self->sup->fail("qualified name is too long");
                snprintf(hp + w, sizeof hp - (size_t)w, "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            if (strncmp(tn, hp, strlen(hp)) == 0 && tn[strlen(hp)] == '_')
                snprintf(cname, (size_t)ccap, "%s", tn);
            else if (snprintf(cname, (size_t)ccap, "%s_%s", hp, tn) >= ccap)
                return self->sup->fail("qualified name is too long");
            /* and the host in source form, for the emitter's diagnostic */
            w = 0;
            qpath[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 2 >= qcap) return self->sup->fail("qualified name is too long");
                    qpath[w] = ':';
                    qpath[w + 1] = ':';
                    w += 2;
                    qpath[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= qcap)
                    return self->sup->fail("qualified name is too long");
                snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            snprintf(name, (size_t)ncap, "%s", tn);
            *form = 2;
            return 0;
        }
        return 0;
    }

    int parse_args(void)
    {
        int first, tail, e;
        (void)self;

        if (self->sup->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->sup->lex_next();
            return 0;
        }
        first = -1;
        tail = -1;
        for (;;) {
            e = self->parse_expr();
            if (e < 0) return -1;
            if (tail < 0) first = e;
            else self->arena->nodes[tail].next = e;
            tail = e;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->sup->expect(")") != 0) return -1;
        return first;
    }

    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!self->cur_func[0]) return 0;
        if (*self->ncalls >= MAX_CALLS) return self->sup->fail("too many calls");
        snprintf(self->calls[*self->ncalls].caller, MAX_TEXT, "%s", self->cur_func);
        snprintf(self->calls[*self->ncalls].callee, MAX_TEXT, "%s", callee);
        self->calls[*self->ncalls].line = line;
        (*self->ncalls)++;
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Expr g_expr;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls);
void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls)
{
    g_expr.arena = (struct Arena *)arena;
    g_expr.lex = (struct Lexer *)lex;
    g_expr.sym = (struct Symbols *)sym;
    g_expr.sup = (struct ParseSupport *)sup;
    g_expr.cur_func = (char *)cur_func;
    g_expr.calls = (struct Call *)calls;
    g_expr.ncalls = (int *)ncalls;
}

pub struct Expr *expr_get(void);
struct Expr *expr_get(void)
{
    return &g_expr;
}
