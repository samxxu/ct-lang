/*
 * Expr.h.ct - the expression and type grammar, one sub-object of the parser.
 *
 * The precedence chain (`parse_expr` down to `parse_primary`), the argument
 * list and the call-graph record sit here with the type specifier reader the
 * chain leans on: `sizeof` and casts need `parse_type`, so the two share an
 * object rather than calling back into the parser. The parser keeps statements
 * and declarations and invites the chain in through `expr_get`; this object
 * only points at the cursor, the shared primitives, the symbol tables, the node
 * pool and the call table the driver reads back.
 *
 * Macros do not cross a unit boundary, so the caps, node kinds, token kinds and
 * operator codes used here are declared here; MAX_TEXT 160 is the value
 * `frontend/sym/Symbols.h.ct` lists.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>

import frontend::lex::Lexer;
import frontend::module::Map::Call as Call;
import frontend::module::Map;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Closure as Closure;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import tool::diag::Diag;

#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 1024
#define MAX_RAW_INIT 4096
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3

namespace frontend::parse;
/* `cur_func` and the call table stay the parser's (the driver reads them back),
   so this object points at them; `calls` points into storage that unit owns. */
pub trait ExprOps {
    int  is_type_word(const char *w);
    int  type_append(char *out, int cap, int *n, const char *tok);
    int  parse_type(char *out, int cap);
    int  parse_array_dims(int n);
    int  next_is_type_name(void);
    int  offsetof_ahead(void);
    int  fnptr_field(const char *stype, const char *field);
    int  const_ok(int n);
    int  parse_expr(void);
    int  parse_bitor(void);
    int  parse_bxor(void);
    int  parse_bitand(void);
    int  parse_shift(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  parse_qual_path(char *name, int ncap, char *cname, int ccap, char *qpath, int qcap,
                         int *form);
    int  record_call(const char *callee, int line);
    int  arity_check(int line, int col, const char *callee, int got, int want);
    int  map_arity(int line, int col, const char *trait, const char *method, int got);
    int  argtype_check(int line, int col, const char *callee, int args, int fi, int ti, int mi);
    /* Phase 21 S4: closure actuals fill a `(fn, env)` pair and count as two
       C arguments. */
    int  type_is_fnptr(const char *t);
    int  type_is_void_ptr(const char *t);
    int  formal_is_env_fn(const char *t);
    int  arg_is_closure(int a);
    int  closure_arg_count(int args);
    int  closure_arg_check(int line, int col, const char *callee, int args, int fi);
    int  decl_type_compat(const char *formal, const char *actual);
    /* Phase 21 S2: `(params) => expr` is parsed and checked, never emitted.
       `parse_closure` runs at the `(` that opens the literal; `closure_bind`
       compares it with the function pointer type its declaration spells. */
    int  parse_closure(void);
    int  closure_bind(int ci, const char *host, const char *vname);
    int  closure_arg_bind(int ci, const char *ftype);
}

pub struct Expr {
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct ParseSupport *sup;
    char *cur_func;                      /* the parser's current function name */
    struct Call *calls;  /* storage owned by parse.h.ct */
    int *ncalls;
    /* A function-pointer declarator carries its name inside the type
       (`int (*cb)(void *)`), so `parse_type` reads it and the caller takes it
       from here instead of expecting an identifier of its own. 160 is MAX_TEXT
       here: the generated header carries no macros. (D-7) */
    char fnptr_name[160];
    /* The array dimensions of a function pointer live inside its declarator
       (`int (*tbl[2])(int)`), so `parse_type` collects them here and the four
       declaration entries copy them into the node's `text3` (D-5). */
    char fnptr_dims[160];
    int  fnptr_state;
    /* Set when the type just read named a trait. `parse_type` turns a trait
       into its `struct T_iface`, which is right everywhere except a type
       alias: a synonym must name a concrete spelling, so the alias parser
       rejects the target with a message of its own. */
    int  saw_trait;
    /* A specifier captured before the storage class (`_Alignas(16) static int
       g;`) arrives here; `parse_type` prepends it and clears the slot, so the
       declaration keeps its canonical spelling (`static _Alignas(16) int g`). */
    char decl_prefix[160];
    /* Set while the expression being parsed may name a C library function
       (`p = strcmp;`, `p = &strcmp;`): an unknown bare identifier is then
       emitted verbatim instead of being rejected. */
    int  fnval_ok;
    /* Set while a full expression may carry an assignment (`(c = f())` and a
       condition): the statement layer owns top-level assignments, so this stays
       0 there and `x = 1;` is unchanged. */
    int  assign_ok;
    /* Phase 24: non-zero only while the element expression of a range
       initialiser (`int a[] = 0..3($ * 2)`) is being parsed. `$` is not an
       identifier -- it has no scope, no symbol and no C spelling -- so it is
       accepted as a primary here and anywhere else reports the ordinary syntax
       error instead of an undeclared name. */
    int  dollar_ok;
    /* A compound literal is parsed where a cast would be (`(type){ … }`), but a
       postfix suffix still belongs to it (`(struct P){1,2}.y`). The cast branch
       leaves the finished node here and calls `parse_postfix`, which consumes
       the seed instead of parsing another primary. -1 = none; `ct_expr_bind`
       sets that up, since the instance is static. */
    int  postfix_seed;
    /* Phase 21 S5: a block body (`=> { … }`) is the statement layer's, and the
       expression object may not import it (that would close a cycle), so the
       parser installs a hook after both sub-objects are bound. */
    int (*body_hook)(void);
    /* Enclosing closures while a literal's body is being parsed. An inner
       literal's captures are copied up into every enclosing environment whose
       frame is outside this literal, so the inner environment can be built
       from fields instead of names that do not exist there. */
    int  cl_stack[16];
    int  cl_pstart[16];
    int  ncl_stack;
    /* The map table the parser owns. A qualified call may name a namespace
       host's method without the trait segment (`std::io::puts(...)`), and the
       namespace/recipe pair is only known from this table. */
    struct Map *maps;
    int *nmaps;
} use ExprOps;

/* Argument count of a call: `parse_args` hands back the first node of the
   chain, or 0 for an empty list, and a fresh node carries `next = -1`. */
static int arg_count(struct Arena *a, int first)
{
    int c = 0;
    while (first > 0) {
        c++;
        first = a->nodes[first].next;
    }
    return c;
}

/* Phase 24: is `n` the range index `$`? It is the only `N_VAR` whose `text2` is
   the placeholder, and it is built only inside a range initialiser's element
   expression. `&$`, `$++` and `++$` are rejected through this predicate: `$` is
   not a variable, so none of them has an object to name. */
static int is_range_index(struct Arena *a, int n)
{
    return n >= 0 && a->nodes[n].kind == N_VAR && strcmp(a->nodes[n].text2, "$") == 0;
}

/* ---- 19.2 coarse argument types ------------------------------------------
   The helpers below are pure string work: they classify a type spelling
   without touching the symbol tables, so the caller decides what stays
   unknown. Coarse on purpose -- numerics convert freely (the usual C
   conversions), either side of a pointer may be `void`, and a struct tag
   only counts when the caller can resolve it in this unit's own table. */

static int id_char(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

/* The qualifier word at `p`, or 0. A qualifier is recognised only at a word
   boundary, so a tag such as `constable` keeps its first five letters. */
static int qual_at(const char *p, int prev_id)
{
    if (prev_id) return 0;
    if (strncmp(p, "__restrict__", 12) == 0 && !id_char(p[12])) return 12;
    if (strncmp(p, "__restrict", 10) == 0 && !id_char(p[10])) return 10;
    if (strncmp(p, "volatile", 8) == 0 && !id_char(p[8])) return 8;
    if (strncmp(p, "restrict", 8) == 0 && !id_char(p[8])) return 8;
    if (strncmp(p, "const", 5) == 0 && !id_char(p[5])) return 5;
    return 0;
}

/* Normalise a type spelling: drop the qualifier words and every whitespace
   character. `const char *` and `char *` then compare equal, while
   `const char *` and `char **` still differ. */
static void tnorm(const char *in, char *out, int cap)
{
    int n, prev, q;
    n = 0;
    prev = 0;
    while (*in) {
        q = qual_at(in, prev);
        if (q) {
            in += q;
            continue;                       /* the boundary stands */
        }
        if (*in != ' ' && *in != '\t' && *in != '\n' && *in != '\r') {
            if (n + 2 >= cap) {
                out[0] = 0;
                return;
            }
            out[n] = *in;
            n++;
        }
        prev = id_char((unsigned char)*in);
        in++;
    }
    out[n] = 0;
}

static int tstars(const char *k)
{
    int n = 0;
    while (*k) {
        if (*k == '*') n++;
        k++;
    }
    return n;
}

/* The normalised spelling without its stars: `struct S *` -> `struct S`. */
static void tbase(const char *k, char *out, int cap)
{
    int n = 0;
    while (*k) {
        if (*k != '*') {
            if (n + 2 >= cap) {
                out[0] = 0;
                return;
            }
            out[n] = *k;
            n++;
        }
        k++;
    }
    out[n] = 0;
}

/* One word of the numeric class: a C scalar keyword or a qualifier (the
   tokeniser sees the raw spelling, where qualifiers still appear). */
static int tscalar(const char *w)
{
    return strcmp(w, "void") == 0 || strcmp(w, "char") == 0
        || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
        || strcmp(w, "long") == 0 || strcmp(w, "float") == 0
        || strcmp(w, "double") == 0 || strcmp(w, "signed") == 0
        || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0
        || strcmp(w, "bool") == 0 || strcmp(w, "size_t") == 0
        || strcmp(w, "ssize_t") == 0 || strcmp(w, "ptrdiff_t") == 0
        || strcmp(w, "wchar_t") == 0 || strcmp(w, "va_list") == 0
        || strcmp(w, "int8_t") == 0 || strcmp(w, "int16_t") == 0
        || strcmp(w, "int32_t") == 0 || strcmp(w, "int64_t") == 0
        || strcmp(w, "uint8_t") == 0 || strcmp(w, "uint16_t") == 0
        || strcmp(w, "uint32_t") == 0 || strcmp(w, "uint64_t") == 0
        || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0
        || strcmp(w, "const") == 0 || strcmp(w, "volatile") == 0
        || strcmp(w, "restrict") == 0 || strcmp(w, "__restrict") == 0
        || strcmp(w, "__restrict__") == 0;
}

/* Every whitespace-or-star separated word of the raw spelling is a scalar
   keyword (`unsigned long`, `const char *`). */
static int tnumeric(const char *in)
{
    char tok[MAX_TEXT];
    int n, any;
    n = 0;
    any = 0;
    for (;;) {
        while (*in == ' ' || *in == '\t' || *in == '*') in++;
        if (!*in) break;
        n = 0;
        while (*in && *in != ' ' && *in != '\t' && *in != '*') {
            if (n + 2 >= MAX_TEXT) return 0;
            tok[n] = *in;
            n++;
            in++;
        }
        tok[n] = 0;
        if (!tscalar(tok)) return 0;
        any = 1;
    }
    return any;
}

/* 0 numeric, 1 struct, 2 union, 3 void, -1 anything else (a typedef name
   stays unknown). `base` is the normalised star-less spelling, `raw` the
   spelling as written -- the tag prefix is read from `raw` so a typedef
   called `structor` is not mistaken for a struct. */
static int tclass(const char *raw, const char *base)
{
    if (strcmp(base, "void") == 0) return 3;
    while (*raw == ' ') raw++;
    if (strncmp(raw, "struct ", 7) == 0) return 1;
    if (strncmp(raw, "union ", 6) == 0) return 2;
    if (strncmp(raw, "enum ", 5) == 0) return 0;
    if (tnumeric(raw)) return 0;
    return -1;
}

/* Compare one formal against one actual: 0 compatible, 1 a confident
   mismatch, -1 undecidable, 2 a struct-against-struct pair the caller must
   resolve through its own struct table (the normalised bases are handed back
   in `fb` / `ab`, tag included). */
static int arg_class(const char *formal, const char *actual,
                     char *fb, int fcap, char *ab, int acap)
{
    char fk[MAX_TEXT], ak[MAX_TEXT];
    int fd, ad, cf, ca;

    tnorm(formal, fk, sizeof fk);
    tnorm(actual, ak, sizeof ak);
    if (!fk[0] || !ak[0]) return -1;
    if (strcmp(fk, ak) == 0) return 0;
    if (strchr(fk, '(') || strchr(ak, '(')) return -1;    /* a function pointer */
    tbase(fk, fb, fcap);
    tbase(ak, ab, acap);
    if (!fb[0] || !ab[0]) return -1;
    cf = tclass(formal, fb);
    ca = tclass(actual, ab);
    if (cf < 0 || ca < 0) return -1;
    if (cf == 2 || ca == 2) return -1;                    /* unions: no table */
    fd = tstars(fk);
    ad = tstars(ak);
    if (fd != ad) {
        /* `void *` converts to and from any object pointer */
        if (cf == 3 && fd > 0 && ad > 0) return 0;
        if (ca == 3 && ad > 0 && fd > 0) return 0;
        return 1;
    }
    if (cf == 3 || ca == 3) return fd > 0 ? 0 : -1;
    if (cf == 0 && ca == 0) return 0;
    if (cf != ca) return 1;
    return 2;
}

/* Read the next comma-separated item of a function pointer's parameter text
   (`parse_type` writes the list without parameter names) into `out`, trimming
   its surrounding spaces. Returns 0 once the list is exhausted. */
static int plist_next(const char *p, int *pos, char *out, int cap)
{
    int i, n;

    i = *pos;
    while (p[i] == ' ' || p[i] == '\t') i++;
    if (!p[i]) return 0;
    n = 0;
    while (p[i] && p[i] != ',') {
        if (n + 1 < cap) out[n++] = p[i];
        i++;
    }
    out[n] = 0;
    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '\t')) out[--n] = 0;
    if (p[i] == ',') i++;
    *pos = i;
    return 1;
}

/* Does the `(` at the cursor open a closure literal? The token stream cannot be
   rewound, so the answer comes from the raw source: scan to the matching `)`
   (skipping strings, chars and comments) and look for `=>`. A parenthesised
   expression is left untouched; the classifier never consumes anything. */
static int closure_ahead(struct Expr *self)
{
    const char *s = self->lex->src;
    int i = self->lex->tokstart;
    int depth = 0;

    if (s[i] != '(') return 0;
    for (; s[i]; i++) {
        char c = s[i];
        if (c == '"' || c == '\'') {
            char q = c;
            i++;
            while (s[i] && s[i] != q) {
                if (s[i] == '\\' && s[i + 1]) i++;
                i++;
            }
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '/') {
            while (s[i] && s[i] != '\n') i++;
            if (!s[i]) return 0;
            continue;
        }
        if (c == '/' && s[i + 1] == '*') {
            i += 2;
            while (s[i] && !(s[i] == '*' && s[i + 1] == '/')) i++;
            if (!s[i]) return 0;
            i++;
            continue;
        }
        if (c == '(' || c == '[' || c == '{') depth++;
        else if (c == ')' || c == ']' || c == '}') {
            depth--;
            if (depth == 0) {
                i++;
                break;
            }
        }
    }
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') i++;
    return s[i] == '=' && s[i + 1] == '>';
}

static int closure_capture_index(struct Closure *c, const char *name)
{
    int i;

    for (i = 0; i < c->ncap; i++)
        if (strcmp(c->cap_name[i], name) == 0) return i;
    return -1;
}

/* Phase 21 S4: the same tier-1 hint the other closure errors carry, printed
   through the note channel so no counter, JSON document or exit code moves.
   R02: the recipe is self-contained -- `Callable` lives in ct-pkg and nothing
   in this repository defines it, so the hint cannot name it. It stays inside
   the 160-byte preprocessor token: a longer `#define` line is truncated when
   the compiler reads its own source. */
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

static int closure_capture_error(struct Expr *self, int line, const char *msg)
{
    tool::diag::ct_sem_error(line, 1, msg, self->sup->mem->path);
    tool::diag::ct_sem_note(line, 1, CT_EXPR_CLOSURE_HINT, self->sup->mem->path);
    return -1;
}

/* R09: a captured name or type that does not fit is a hard error. Truncating it
   would leave the environment field with a shorter type (or a name the emitter
   cannot match) and surface later as a `cc` failure with no source position. */
static int closure_copy(struct Expr *self, char *dst, const char *src, const char *what)
{
    char msg[512];

    if (strlen(src) >= MAX_TEXT) {
        snprintf(msg, sizeof msg, "%s is too long (limit %d)", what, MAX_TEXT - 1);
        return self->sup->fail(msg);
    }
    snprintf(dst, MAX_TEXT, "%s", src);
    return 0;
}

static int closure_capture_add(struct Expr *self, int ci, int vi, int line)
{
    struct Closure *c = &self->sym->closures[ci];
    const char *name = self->sym->vars[vi].name;
    char msg[512];
    int k;

    /* E4: an `own` handle would get a second owner and a `borrow` a second
       handback, so neither can be copied into the environment. The check runs
       while the capture is collected, before AutoDrop / borrow is registered. */
    if (self->sym->vars[vi].autodrop || self->sym->vars[vi].borrowed) {
        snprintf(msg, sizeof msg,
                 "a closure cannot capture '%s' (it is 'own' or 'borrow')", name);
        return closure_capture_error(self, line, msg);
    }
    /* a closure is a binding, not a value (E7 on the capture path) */
    if (self->sym->vars[vi].is_closure)
        return closure_capture_error(self, line, "a closure cannot capture another closure");
    /* An array is not a value in C: there is no assignment that would copy it
       into the env struct, and an element-wise copy has no spelling on the
       inline `(fn, env)` path. Refuse it instead of emitting an env field whose
       type lost its dimensions. */
    if (self->sym->vars[vi].is_array) {
        snprintf(msg, sizeof msg,
                 "a closure cannot capture the array '%s' (capture a pointer to it instead)", name);
        return closure_capture_error(self, line, msg);
    }
    if (closure_capture_index(c, name) >= 0) return 0;
    if (c->ncap >= 16)
        return self->sup->fail("a closure takes too many captures (limit 16)");
    if (closure_copy(self, c->cap_name[c->ncap], name, "a captured name") != 0) return -1;
    if (closure_copy(self, c->cap_type[c->ncap], self->sym->vars[vi].type,
                     "a captured type") != 0) return -1;
    c->ncap++;
    /* An inner literal is built inside the enclosing trampoline, so a name that
       comes from outside the enclosing literal must also sit in its environment;
       otherwise the inner initialiser would name a variable the trampoline does
       not have. A name local to the enclosing body (at or after its `pstart`)
       stays a plain local and is not copied up. */
    for (k = self->ncl_stack - 2; k >= 0; k--) {
        int oi = self->cl_stack[k];
        struct Closure *oc = &self->sym->closures[oi];
        int j, dup = 0;

        if (vi >= self->cl_pstart[k]) continue;
        for (j = 0; j < oc->ncap; j++)
            if (strcmp(oc->cap_name[j], name) == 0) dup = 1;
        if (dup) continue;
        if (oc->ncap >= 16)
            return self->sup->fail("a closure takes too many captures (limit 16)");
        if (closure_copy(self, oc->cap_name[oc->ncap], name, "a captured name") != 0) return -1;
        if (closure_copy(self, oc->cap_type[oc->ncap], self->sym->vars[vi].type,
                         "a captured type") != 0) return -1;
        oc->ncap++;
    }
    return 0;
}

/* Collect the free names of a closure body. The parameter scope is still open,
   so a name at or after `pstart` is the literal's own parameter -- a parameter
   that shadows an outer variable keeps the outer one out of the capture set,
   which is exactly the snapshot the rule needs. Globals are not captures. */
static int closure_walk(struct Expr *self, int ci, int n, int pstart)
{
    struct Node *nd;
    int vi;

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    /* a nested literal owns its own environment (S5) */
    if (nd->kind == N_CLOSURE) return 0;
    /* calling another binding from inside a closure is the capture path the
       call node spells in `text2`, not in a child: a closure cannot capture
       another closure (E7). */
    if (nd->kind == N_CALL) {
        vi = self->sym->find_var(nd->text2);
        if (vi >= 0 && vi < pstart && !self->sym->vars[vi].is_global
            && self->sym->vars[vi].is_closure)
            return closure_capture_error(self, nd->line,
                                         "a closure cannot capture another closure");
    }
    if (nd->kind == N_VAR) {
        vi = self->sym->find_var(nd->text2);
        if (vi < 0 || vi >= pstart) return 0;
        if (self->sym->vars[vi].is_global) return 0;
        return closure_capture_add(self, ci, vi, nd->line);
    }
    if (closure_walk(self, ci, nd->a, pstart) != 0) return -1;
    if (closure_walk(self, ci, nd->b, pstart) != 0) return -1;
    if (closure_walk(self, ci, nd->c, pstart) != 0) return -1;
    if (closure_walk(self, ci, nd->d, pstart) != 0) return -1;
    return closure_walk(self, ci, nd->next, pstart);
}

/* Phase 21 R01: a local declaration inside the body may not shadow a captured
   name. The capture walk runs after the body's own scope has been popped, so a
   shadowed name resolves to the enclosing variable and enters the capture set;
   the emitter then rewrites every same-named N_VAR in the body to the env field
   and a read of the local silently returns the snapshot. Rejecting the shadow
   keeps the snapshot rule honest (design §4.2). A nested literal owns its own
   environment and runs its own check. */
static int closure_walk_shadow(struct Expr *self, int ci, int n)
{
    struct Node *nd;
    struct Closure *c = &self->sym->closures[ci];
    char msg[512];
    int k;

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    if (nd->kind == N_CLOSURE) return 0;
    if (nd->kind == N_DECL) {
        for (k = 0; k < c->ncap; k++) {
            if (strcmp(c->cap_name[k], nd->text2) == 0) {
                snprintf(msg, sizeof msg,
                         "a local cannot shadow the captured '%s'", nd->text2);
                return closure_capture_error(self, nd->line, msg);
            }
        }
    }
    if (closure_walk_shadow(self, ci, nd->a) != 0) return -1;
    if (closure_walk_shadow(self, ci, nd->b) != 0) return -1;
    if (closure_walk_shadow(self, ci, nd->c) != 0) return -1;
    if (closure_walk_shadow(self, ci, nd->d) != 0) return -1;
    return closure_walk_shadow(self, ci, nd->next);
}

/* A captured variable belongs to the enclosing frame; the closure may read it
   but must not write the binding or take its address (D21-2). Writes through a
   captured pointer (`p->x = 1`) are reads of the binding and stay legal. */
static int closure_walk_mutate(struct Expr *self, int ci, int n)
{
    struct Node *nd;
    struct Closure *c = &self->sym->closures[ci];

    if (n < 0) return 0;
    nd = &self->arena->nodes[n];
    if (nd->kind == N_CLOSURE) return 0;
    if (nd->kind == N_ASSIGN && nd->a >= 0
        && self->arena->nodes[nd->a].kind == N_VAR
        && closure_capture_index(c, self->arena->nodes[nd->a].text2) >= 0)
        return closure_capture_error(self, self->arena->nodes[nd->a].line,
                                     "a captured variable cannot be reassigned inside a closure");
    if ((nd->kind == N_PRE || nd->kind == N_POST) && nd->a >= 0
        && self->arena->nodes[nd->a].kind == N_VAR
        && closure_capture_index(c, self->arena->nodes[nd->a].text2) >= 0)
        return closure_capture_error(self, self->arena->nodes[nd->a].line,
                                     "a captured variable cannot be reassigned inside a closure");
    if (nd->kind == N_ADDR && nd->a >= 0
        && self->arena->nodes[nd->a].kind == N_VAR
        && closure_capture_index(c, self->arena->nodes[nd->a].text2) >= 0)
        return closure_capture_error(self, self->arena->nodes[nd->a].line,
                                     "the address of a captured variable cannot be taken inside a closure");
    if (closure_walk_mutate(self, ci, nd->a) != 0) return -1;
    if (closure_walk_mutate(self, ci, nd->b) != 0) return -1;
    if (closure_walk_mutate(self, ci, nd->c) != 0) return -1;
    if (closure_walk_mutate(self, ci, nd->d) != 0) return -1;
    return closure_walk_mutate(self, ci, nd->next);
}

/* 19.1 call-site arity: only a callee whose signature is known is compared.
   A call through a function pointer, an undeclared C library name, a `map`
   recipe and a static type host all stay unknown and pass. The caller passes
   the expected count it already knows (a variadic function's named part), so
   this method only reports the mismatch; warning severity keeps `ct compile`
   exit codes and artifacts unchanged (D19-4), and `ct check` (19.4) raises the
   same record to an error. */

/* Compare a closure literal's parameter list with a hosting function-pointer
   type and take the literal's return type from that host (D21-14). `skip_env`
   drops the first host parameter: the formal of a `(fn, env)` pair spells the
   environment there. The parameter comparison reuses the same normalisation
   `arg_class` gives 19.3. A mismatch reports at the source position and
   returns non-zero; on success `c->ret` is set when `set_ret` is non-zero.
   R03: comparing a declared binding with a host tail must not write the return
   type, or the binding's own trampoline would silently take the host's type
   for every other call site. */
static int closure_match(struct Expr *self, int ci, const char *host, int skip_env, int set_ret)
{
    struct Closure *c = &self->sym->closures[ci];
    char ret[MAX_TEXT];
    char plist[MAX_TEXT];
    char item[MAX_TEXT];
    const char *p;
    size_t n, hn;
    int lp, rp, pos, want, i, r;

    p = strstr(host, "(*");
    if (!p || p == host)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    n = (size_t)(p - host);
    while (n > 0 && (host[n - 1] == ' ' || host[n - 1] == '\t')) n--;
    if (n == 0 || n >= MAX_TEXT)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    snprintf(ret, sizeof ret, "%.*s", (int)n, host);
    hn = strlen(host);
    lp = -1;
    rp = -1;
    for (n = 0; n < hn; n++) {
        if (host[n] == '(') lp = (int)n;
        else if (host[n] == ')') rp = (int)n;
    }
    if (lp < 0 || rp <= lp + 1)
        return self->sup->fail_at(c->line,
            "a closure cannot be used where a plain function pointer is expected");
    snprintf(plist, sizeof plist, "%.*s", rp - lp - 1, host + lp + 1);
    if (skip_env) {
        char *comma = strchr(plist, ',');
        if (comma) snprintf(plist, sizeof plist, "%s", comma + 1);
        else plist[0] = 0;
    }
    want = 0;
    if (!(strcmp(plist, "void") == 0 || plist[0] == 0)) {
        pos = 0;
        while (plist_next(plist, &pos, item, sizeof item)) want++;
    }
    if (want != c->nparams) {
        char msg[512];
        snprintf(msg, sizeof msg,
                 "this closure takes %d parameters, but the expected type takes %d",
                 c->nparams, want);
        return self->sup->fail_at(c->line, msg);
    }
    pos = 0;
    i = 0;
    while (plist_next(plist, &pos, item, sizeof item)) {
        char fb[MAX_TEXT], ab[MAX_TEXT];
        int fs, as;
        r = arg_class(item, c->ptype[i], fb, sizeof fb, ab, sizeof ab);
        if (r == 2) {
            fs = self->sym->find_struct(fb + 6);
            as = self->sym->find_struct(ab + 6);
            r = (fs < 0 || as < 0) ? -1 : (fs != as);
        }
        if (r == 1) {
            char msg[512];
            snprintf(msg, sizeof msg,
                     "this closure's parameter %d is '%s', but the expected type is '%s'",
                     i + 1, c->ptype[i], item);
            return self->sup->fail_at(c->line, msg);
        }
        i++;
    }
    if (set_ret) snprintf(c->ret, MAX_TEXT, "%s", ret);
    return 0;
}

/* R03: a declared binding fills a `(fn, env)` pair, but unlike an inline
   literal its own trampoline already exists with the return type its
   declaration took, so the comparison is read-only (`set_ret` 0). */

impl ExprOps for Expr {
    int arity_check(int line, int col, const char *callee, int got, int want)
    {
        char msg[MAX_TEXT];
        if (got == want) return 0;
        snprintf(msg, sizeof msg, "takes %d argument(s), %d given", want, got);
        if (self->sup->arity_warn(line, col, callee, msg) != 0)
            return self->sup->fail("too many warnings");
        return 0;
    }

    /* Phase 21 S4: a closure actual is one source argument that occupies the
       `(fn, env)` pair, two C arguments. The pair is adjacent and shaped
       `ret (*P)(void *…, …)` followed by `void *E`; anything else is E6. */
    int type_is_fnptr(const char *t)
    {
        (void)self;
        return t != 0 && strstr(t, "(*") != 0;
    }

    int type_is_void_ptr(const char *t)
    {
        (void)self;
        return t != 0 && strncmp(t, "void *", 6) == 0;
    }

    /* R05: membership of a `(fn, env)` pair is decided by the first formal, not
       by the mere presence of "void *" anywhere in the type. A plain
       `int (*P)(int x, void *ctx)` also contains it, and `skip_env` would then
       drop a real parameter and shift the whole tail. The list is split with
       the same parser `closure_match` uses, and the first item must start with
       `void *` (not `void **`). */
    int formal_is_env_fn(const char *t)
    {
        char plist[MAX_TEXT];
        char item[MAX_TEXT];
        int lp, rp, pos;
        size_t n, hn;

        if (!self->type_is_fnptr(t)) return 0;
        hn = strlen(t);
        lp = -1;
        rp = -1;
        for (n = 0; n < hn; n++) {
            if (t[n] == '(') lp = (int)n;
            else if (t[n] == ')') rp = (int)n;
        }
        if (lp < 0 || rp <= lp + 1) return 0;
        snprintf(plist, sizeof plist, "%.*s", rp - lp - 1, t + lp + 1);
        pos = 0;
        if (!plist_next(plist, &pos, item, sizeof item)) return 0;
        if (strncmp(item, "void *", 6) != 0) return 0;
        return item[6] != '*';
    }

    int arg_is_closure(int a)
    {
        const char *name;
        int vi;

        if (a < 0) return 0;
        if (self->arena->nodes[a].kind == N_CLOSURE) return 1;
        if (self->arena->nodes[a].kind != N_VAR) return 0;
        name = self->arena->nodes[a].text2;
        vi = self->sym->find_var(name);
        return vi >= 0 && self->sym->vars[vi].is_closure;
    }

    int closure_arg_count(int args)
    {
        int cur, n;

        cur = args;
        n = 0;
        while (cur > 0) {
            if (self->arg_is_closure(cur)) n++;
            cur = self->arena->nodes[cur].next;
        }
        return n;
    }

    /* Returns 0 when every closure actual fills the start of a `(fn, env)`
       pair. An inline literal is bound to the host fn type right here (D21-14),
       and a declared binding fills the pair too (R03): its parameter tail is
       compared, but its return type stays the one its declaration took. The
       binding is still a binding -- it cannot be copied, renamed, stored in a
       field or returned (D21-13). A plain function-pointer slot and a position
       that is not a pair are distinct errors; the second also carries the E8
       note, because the compiler cannot see whether the callee keeps the
       environment. */
    int closure_arg_check(int line, int col, const char *callee, int args, int fi)
    {
        const char *e8;
        int cur, pos, ok, np;
        const char *ft;

        e8 = "the compiler cannot see whether the callee keeps the environment; the environment dies with this frame";
        if (fi >= 0) np = self->sym->funcs[fi].nparams;
        else np = 0;
        cur = args;
        pos = 0;
        while (cur > 0) {
            if (self->arg_is_closure(cur)) {
                ok = 0;
                ft = "";
                if (fi >= 0 && pos < np) ft = self->sym->funcs[fi].ptype[pos];
                if (fi >= 0 && pos + 1 < np)
                    ok = self->formal_is_env_fn(ft)
                         && self->type_is_void_ptr(self->sym->funcs[fi].ptype[pos + 1]);
                if (!ok) {
                    if (self->type_is_fnptr(ft) && !self->formal_is_env_fn(ft)) {
                        tool::diag::ct_sem_error(line, col,
                            "a closure cannot be used where a plain function pointer is expected",
                            self->sup->mem->path);
                        tool::diag::ct_sem_note(line, col, CT_EXPR_CLOSURE_HINT,
                                                self->sup->mem->path);
                    } else {
                        tool::diag::ct_sem_error(line, col,
                            "a closure argument must fill a '(fn, env)' parameter pair",
                            self->sup->mem->path);
                        tool::diag::ct_sem_note(line, col, CT_EXPR_CLOSURE_HINT,
                                                self->sup->mem->path);
                        tool::diag::ct_sem_note(line, col, e8, self->sup->mem->path);
                    }
                    return -1;
                }
                if (self->arena->nodes[cur].kind == N_CLOSURE) {
                    if (self->closure_arg_bind(self->arena->nodes[cur].num, ft) != 0)
                        return -1;
                } else {
                    /* R03: a declared binding fills the pair as well. Its own
                       trampoline keeps the return type its declaration took, so
                       only the parameter tail is compared. */
                    int vi = self->sym->find_var(self->arena->nodes[cur].text2);
                    if (vi >= 0 && self->sym->vars[vi].is_closure
                        && closure_match(self, self->sym->vars[vi].closure_id, ft, 1, 0) != 0)
                        return -1;
                }
                pos += 2;
            } else {
                pos++;
            }
            cur = self->arena->nodes[cur].next;
        }
        (void)callee;
        return 0;
    }

    /* A static map is expanded into its recipe at the call site, so an actual
       the recipe does not name is simply dropped. A variadic method forwards
       the tail (`...`), which turns the count into a lower bound; a fixed one
       must match exactly. */
    int map_arity(int line, int col, const char *trait, const char *method, int got)
    {
        int ti, mi, want;
        ti = self->sym->find_trait(trait);
        if (ti < 0) return 0;
        for (mi = 0; mi < self->sym->traits[ti].nm; mi++)
            if (strcmp(self->sym->traits[ti].m[mi].name, method) == 0) break;
        if (mi >= self->sym->traits[ti].nm) return 0;
        want = self->sym->traits[ti].m[mi].nparams;
        if (self->sym->traits[ti].m[mi].variadic && got >= want) return 0;
        return self->arity_check(line, col, method, got, want);
    }

    /* 19.2: the resolved signature beside the argument chain, one position at
       a time. Only a position where both sides can name a type is compared;
       an interface formal (boxing owns it), an array on either side (decay),
       a cast argument and an argument without a derivable type all stay
       unknown and pass (D19-3). One warning per call is enough. Warning
       severity like 19.1 (D19-4): `ct check` (19.4) raises it to an error. */
    int argtype_check(int line, int col, const char *callee, int args, int fi, int ti, int mi)
    {
        char at[MAX_TEXT];
        char fb[MAX_TEXT], ab[MAX_TEXT];
        char msg[MAX_TEXT];
        const char *ft;
        int cur, k, np, skip, r;

        if (fi >= 0) np = self->sym->funcs[fi].nparams;
        else np = self->sym->traits[ti].m[mi].nparams;
        cur = args;
        k = 0;
        while (cur > 0 && k < np) {
            skip = 0;
            if (fi >= 0) ft = self->sym->funcs[fi].ptype[k];
            else ft = self->sym->traits[ti].m[mi].ptype[k];
            /* an array parameter is a pointer in disguise: the dims sit in
               `pdim` (a function) or ride in the spelling (a trait method) */
            if (fi >= 0 && self->sym->funcs[fi].pdim[k][0]) skip = 1;
            if (!skip && strchr(ft, '[')) skip = 1;
            if (!skip) {
                char itr[MAX_TEXT];
                int iip = 0;
                if (self->sup->iface_ref_type(ft, itr, sizeof itr, &iip)) skip = 1;
            }
            if (!skip && self->arena->nodes[cur].kind == N_CAST) skip = 1;
            /* a closure actual fills `(fn, env)`: its own type is not a value
               type, and it consumes two formals (see the tail of the loop) */
            if (!skip && self->arg_is_closure(cur)) skip = 1;
            /* `0` is a null pointer constant: C accepts it wherever a pointer
               is expected, so a derived `int` is not a mismatch. */
            if (!skip && self->arena->nodes[cur].kind == N_NUM
                && self->arena->nodes[cur].num == 0
                && strchr(ft, '*')) skip = 1;
            if (!skip && self->sup->expr_ctype(cur, at, sizeof at) != 0) skip = 1;
            if (!skip && strchr(at, '[')) skip = 1;   /* a decayed array */
            if (!skip) {
                r = arg_class(ft, at, fb, sizeof fb, ab, sizeof ab);
                if (r == 2) {
                    int fs = self->sym->find_struct(fb + 6);
                    int as = self->sym->find_struct(ab + 6);
                    r = (fs < 0 || as < 0) ? -1 : (fs != as);
                }
                if (r == 1) {
                    snprintf(msg, sizeof msg, "argument %d: expected '%s', got '%s'",
                             k + 1, ft, at);
                    if (self->sup->type_warn(line, col, callee, msg) != 0)
                        return self->sup->fail("too many warnings");
                    return 0;
                }
            }
            if (self->arg_is_closure(cur)) k += 2;
            else k++;
            cur = self->arena->nodes[cur].next;
        }
        return 0;
    }

    /* 19.3: an impl's parameter spelling against the trait's -- two declared
       types instead of an argument expression, the same coarse rules as 19.2
       (`arg_class` plus this unit's struct table). The trait may live in an
       imported unit, so only a confident mismatch (1) counts; every
       undecidable pair passes (D19-3). */
    int decl_type_compat(const char *formal, const char *actual)
    {
        char fb[MAX_TEXT], ab[MAX_TEXT];
        int r = arg_class(formal, actual, fb, sizeof fb, ab, sizeof ab);
        if (r == 2) {
            int fs = self->sym->find_struct(fb + 6);
            int as = self->sym->find_struct(ab + 6);
            r = (fs < 0 || as < 0) ? -1 : (fs != as);
        }
        return r;
    }

    /* S2 binding: a closure literal on the right of a function-pointer
       declaration. `host` is the declared type (`int (*)(int x)`); its return
       type and parameter list are compared with the literal's. The parameter
       comparison reuses `decl_type_compat`, the same normalisation 19.3 uses.
       S5 adds the argument form: the host is the callee's formal pair
       (`int (*)(void *, int)`), whose first parameter is the environment and is
       skipped, and the return type still comes from the host fn (D21-14). */
    int closure_bind(int ci, const char *host, const char *vname)
    {
        int vi;

        if (closure_match(self, ci, host, 0, 1) != 0) return -1;
        vi = self->sym->find_var(vname);
        if (vi < 0)
            return self->sup->fail("a closure cannot be used where a plain function pointer is expected");
        if (self->sym->vars[vi].is_global || self->sym->vars[vi].is_static) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg,
                     "a closure cannot be stored in '%s' (its scope outlives the closure)", vname);
            return self->sup->fail(msg);
        }
        self->sym->vars[vi].is_closure = 1;
        self->sym->vars[vi].closure_id = ci;
        return 0;
    }

    int closure_arg_bind(int ci, const char *ftype)
    {
        return closure_match(self, ci, ftype, 1, 1);
    }

    /* The type keywords. L0 / L1 / L2 have always accepted the `stdint` /
       `stddef` / `stdbool` spellings and the qualifiers, so ct-ast lists the same
       set (`restrict` included): a program written against those headers is a
       pass-through declaration here, and the C compiler still owns the meaning.
       `DIR` is ct-ast's own addition (the directory handle `opendir` returns). */
    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "void") == 0 || strcmp(w, "char") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "int") == 0
            || strcmp(w, "long") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "signed") == 0
            || strcmp(w, "unsigned") == 0 || strcmp(w, "_Bool") == 0
            || strcmp(w, "bool") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "volatile") == 0 || strcmp(w, "restrict") == 0
            || strcmp(w, "__restrict") == 0 || strcmp(w, "__restrict__") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "union") == 0
            || strcmp(w, "enum") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "ssize_t") == 0 || strcmp(w, "ptrdiff_t") == 0
            || strcmp(w, "wchar_t") == 0 || strcmp(w, "va_list") == 0
            || strcmp(w, "int8_t") == 0 || strcmp(w, "int16_t") == 0
            || strcmp(w, "int32_t") == 0 || strcmp(w, "int64_t") == 0
            || strcmp(w, "uint8_t") == 0 || strcmp(w, "uint16_t") == 0
            || strcmp(w, "uint32_t") == 0 || strcmp(w, "uint64_t") == 0
            || strcmp(w, "FILE") == 0 || strcmp(w, "DIR") == 0;
    }

    int type_append(char *out, int cap, int *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->sup->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, (size_t)(cap - *n), "%s", tok);
        if (w < 0 || w >= cap - *n) return self->sup->fail("type is too long");
        *n += w;
        return 0;
    }

    /* Capture a parenthesized C11 specifier at the cursor: `_Alignas(…)` (the
       list is required) or `_Atomic(…)` (bare `_Atomic` is the qualifier form
       and is accepted too). Both are appended to the type spelling, so every
       declaration entry -- global, local, field, parameter, typedef -- picks
       them up unchanged. */
    int parse_type(char *out, int cap)
    {
        int n;
        (void)self;

        n = 0;
        out[0] = 0;
        if (self->decl_prefix[0]) {
            int pn = snprintf(out, (size_t)cap, "%s", self->decl_prefix);
            if (pn < 0 || pn >= cap) return self->sup->fail("type is too long");
            n = pn;
            self->decl_prefix[0] = 0;
        }
        self->fnptr_state = 0;
        self->saw_trait = 0;
        self->fnptr_name[0] = 0;
        self->fnptr_dims[0] = 0;
        for (;;) {
            /* C11 `_Alignas(…)` and `_Atomic(…)`: the specifier is copied into
               the type spelling and handed to the C compiler as written (the
               argument may be a type name or a constant expression), so every
               declaration entry -- global, local, field, parameter, typedef --
               picks it up without a node of its own. `_Atomic int` is the
               qualifier spelling and is accepted too. */
            if (self->lex->tok == T_ID
                && (strcmp(self->lex->toktext, "_Alignas") == 0
                    || strcmp(self->lex->toktext, "_Atomic") == 0)) {
                int need_paren, depth;
                const char *word;
                need_paren = (strcmp(self->lex->toktext, "_Alignas") == 0);
                word = need_paren ? "_Alignas" : "_Atomic";
                if (self->type_append(out, cap, &n, word) != 0) return -1;
                self->sup->lex_next();
                if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
                    if (need_paren) return self->sup->fail("expected '(' after _Alignas");
                    continue;                 /* bare `_Atomic` is the qualifier */
                }
                depth = 0;
                for (;;) {
                    char tbuf[MAX_TEXT];
                    if (self->lex->tok == T_EOF) {
                        if (need_paren) return self->sup->fail("unterminated _Alignas");
                        return self->sup->fail("unterminated _Atomic");
                    }
                    /* an integer token keeps its value, not its spelling */
                    if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                        snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                    else
                        snprintf(tbuf, sizeof tbuf, "%s", self->lex->toktext);
                    if (self->type_append(out, cap, &n, tbuf) != 0) return -1;
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) depth++;
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                        depth--;
                        if (depth == 0) {
                            self->sup->lex_next();
                            break;
                        }
                    }
                    self->sup->lex_next();
                }
                continue;
            }
            if (self->lex->tok == T_ID && self->is_type_word(self->lex->toktext)) {
                if (self->type_append(out, cap, &n, self->lex->toktext) != 0) return -1;
                if (strcmp(self->lex->toktext, "struct") == 0) {
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a struct name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 1) != 0) return -1;
                } else if (strcmp(self->lex->toktext, "enum") == 0) {
                    /* `enum Tag` keeps its keyword the way `struct Tag` does; the
                       tag joins the table under kind 5 (D-2) */
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected an enum name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 5) != 0) return -1;
                } else if (strcmp(self->lex->toktext, "union") == 0) {
                    /* a union tag is mangled like a struct tag and joins the table
                       under kind 6 */
                    char sname[MAX_TEXT];
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a union name");
                    if (self->sup->resolve_type(self->lex->toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->sup->add_type(sname, 6) != 0) return -1;
                }
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_ID) {
                int ti;
                char rname[MAX_TEXT];
                char iface[MAX_TEXT];
                /* A visible type alias expands before any name resolution: the
                   alias is a compile-time synonym, so the type spelling (and
                   therefore the host key) is the underlying one. */
                if (self->sym->find_type_alias(self->lex->toktext) >= 0) {
                    char etext[MAX_TEXT];
                    if (self->sym->expand_type_alias(self->lex->toktext, etext, sizeof etext) != 0)
                        return self->sup->fail(self->sym->last_error());
                    if (self->type_append(out, cap, &n, etext) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                /* D21-1: a closure's return type comes from the declaration on
                   the left, so CT never infers one. `auto` is not a type name
                   here: refuse it instead of passing it through to `cc`, where
                   C99 would accept it as a storage class. */
                if (strcmp(self->lex->toktext, "auto") == 0)
                    return self->sup->fail("'auto' is not a type in CT (write the type explicitly)");
                if (self->sup->resolve_type(self->lex->toktext, rname, sizeof rname) != 0) return -1;
                ti = self->sym->find_type(rname);
                if (ti < 0) {
                    /* A declared-but-not-imported alias must not fall through to
                       the opaque C spelling: the name means something in this
                       build, and silently emitting it would fail in `cc`. */
                    {
                        char apath[1024];
                        int aline = 0;
                        if (self->sym->find_global_type_alias(self->lex->toktext, apath,
                                                              sizeof apath, &aline) == 0) {
                            char amsg[1400];
                            snprintf(amsg, sizeof amsg,
                                     "type alias '%s' is declared in %s:%d but this unit does not import it",
                                     self->lex->toktext, apath, aline);
                            return self->sup->fail(amsg);
                        }
                    }
                    /* A type name the unit has never seen (a typedef from a
                       header, such as `time_t`). It can only stand where a type
                       is expected, so the spelling is kept as written; the
                       cast / `sizeof` decision happens before this point, so
                       `(NAME) + x` is never turned into one. */
                    if (n == 0) {
                        if (self->type_append(out, cap, &n, rname) != 0) return -1;
                        self->sup->lex_next();
                        continue;
                    }
                    break;
                }
                /* a bare struct / enum tag needs its keyword; a trait becomes
                   its iface */
                if (self->sym->type_kind[ti] == 1) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                } else if (self->sym->type_kind[ti] == 5) {
                    if (self->type_append(out, cap, &n, "enum") != 0) return -1;
                } else if (self->sym->type_kind[ti] == 6) {
                    if (self->type_append(out, cap, &n, "union") != 0) return -1;
                } else if (self->sym->type_kind[ti] == 3) {
                    int sti = self->sym->find_trait(rname);
                    self->saw_trait = 1;
                    if (sti >= 0 && self->sym->traits[sti].is_static)
                        return self->sup->fail("a static trait has no interface value");
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (snprintf(iface, sizeof iface, "%s_iface", rname) >= (int)sizeof iface)
                        return self->sup->fail("type name is too long");
                    if (self->type_append(out, cap, &n, iface) != 0) return -1;
                    self->sup->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->sup->lex_next();
                continue;
            }
            break;
        }
        /* `ret (*name)(params)`: the declarator belongs to the type, so it is
           consumed here and the caller takes the name from `fnptr_name`. One
           level only -- a function pointer is not a return type and cannot nest
           (2b.4). A `(` that does not open `(*` is left alone: no other caller
           of `parse_type` can have one there. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            int save_tok, save_line, save_srcline, save_bol;
            long save_num;
            size_t save_pos;
            char save_text[MAX_TEXT];
            save_tok = self->lex->tok;
            save_num = self->lex->toknum;
            save_line = self->lex->tokline;
            save_pos = self->lex->pos;
            save_srcline = self->lex->line;
            save_bol = self->lex->bol;
            snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
                char plist[MAX_TEXT];
                char dname[MAX_TEXT];
                char fdims[MAX_TEXT];
                int pn;
                self->sup->lex_next();
                /* `int (**f)(int)` and `int (*(*f)(void))(int)` put a second
                   declarator where the name belongs: only one level is
                   supported, and the diagnostic says so (D-7). */
                if (self->lex->tok == T_PUNCT
                    && (strcmp(self->lex->toktext, "*") == 0
                        || strcmp(self->lex->toktext, "(") == 0))
                    return self->sup->fail("nested function pointers are not supported");
                if (self->lex->tok != T_ID)
                    return self->sup->fail("expected a name in the function-pointer declarator");
                /* keep the name here: parsing the parameter list below calls
                   `parse_type` again, which clears `fnptr_name` */
                snprintf(dname, sizeof dname, "%s", self->lex->toktext);
                self->sup->lex_next();
                /* dimensions sit inside the declarator, before the `)`: a
                   function-pointer array (`int (*tbl[2])(int)`) (D-5) */
                fdims[0] = 0;
                while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                    char dim[MAX_TEXT];
                    char cur[MAX_TEXT];
                    int unsized;
                    unsized = 0;
                    self->sup->lex_next();
                    if (self->lex->tok == T_NUM) {
                        snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
                    } else if (self->lex->tok == T_ID) {
                        snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
                    } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                        snprintf(dim, sizeof dim, "[]");
                        unsized = 1;
                    } else {
                        return self->sup->fail("expected an array length");
                    }
                    if (!unsized) self->sup->lex_next();
                    if (self->sup->expect("]") != 0) return -1;
                    if (snprintf(cur, sizeof cur, "%s%s", fdims, dim) >= MAX_TEXT)
                        return self->sup->fail("array dimensions are too long");
                    snprintf(fdims, sizeof fdims, "%s", cur);
                }
                if (self->sup->expect(")") != 0) return -1;
                if (self->sup->expect("(") != 0) return -1;
                pn = 0;
                plist[0] = 0;
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                    for (;;) {
                        char pt[MAX_TEXT];
                        const char *joiner;
                        /* A variadic tail belongs to the signature like any
                           other parameter (`int (*log)(const char *, ...)`), so
                           it is copied into the spelling; C requires a named
                           parameter before it, and it closes the list. */
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "...") == 0) {
                            if (pn == 0 || strcmp(plist, "void") == 0)
                                return self->sup->fail("a variadic function pointer needs a named parameter before '...'");
                            if (pn + 6 > MAX_TEXT)
                                return self->sup->fail("a function-pointer signature is too long");
                            snprintf(plist + pn, (size_t)(MAX_TEXT - pn), "%s", ", ...");
                            pn += 5;
                            self->sup->lex_next();
                            break;
                        }
                        if (self->parse_type(pt, sizeof pt) != 0) return -1;
                        if (self->fnptr_state)
                            return self->sup->fail("nested function pointers are not supported");
                        if (self->lex->tok == T_ID) self->sup->lex_next();
                        joiner = (pn > 0) ? ", " : "";
                        if (pn + (int)strlen(joiner) + (int)strlen(pt) + 6 > MAX_TEXT)
                            return self->sup->fail("a function-pointer signature is too long");
                        snprintf(plist + pn, (size_t)(MAX_TEXT - pn), "%s%s", joiner, pt);
                        pn += (int)(strlen(joiner) + strlen(pt));
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                            self->sup->lex_next();
                            continue;
                        }
                        break;
                    }
                }
                if (self->sup->expect(")") != 0) return -1;
                if (pn == 0) snprintf(plist, sizeof plist, "%s", "void");
                {
                    char sig[MAX_TEXT];
                    snprintf(sig, sizeof sig, "(*)(%s)", plist);
                    if (self->type_append(out, cap, &n, sig) != 0) return -1;
                }
                snprintf(self->fnptr_name, MAX_TEXT, "%s", dname);
                snprintf(self->fnptr_dims, MAX_TEXT, "%s", fdims);
                self->fnptr_state = 1;
            } else {
                self->lex->tok = save_tok;
                self->lex->toknum = save_num;
                self->lex->tokline = save_line;
                self->lex->pos = save_pos;
                self->lex->line = save_srcline;
                self->lex->bol = save_bol;
                snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
            }
        }
        if (n == 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "expected a type (tok %d '%s')", self->lex->tok, self->lex->toktext);
            return self->sup->fail(msg);
        }
        return 0;
    }

    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    int parse_array_dims(int n)
    {
        (void)self;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
            char dim[MAX_TEXT];
            char cur[MAX_TEXT];
            int unsized, open, raw;
            unsized = 0;
            raw = 0;
            open = self->lex->tokstart;             /* the `[` itself */
            dim[0] = 0;
            self->sup->lex_next();
            if (self->lex->tok == T_NUM) {
                snprintf(dim, sizeof dim, "[%ld]", self->lex->toknum);
            } else if (self->lex->tok == T_ID) {
                /* a constant (an enum member) is emitted under its C name; an
                   undeclared macro name stays as written (D-9) */
                char cn[MAX_TEXT];
                if (self->sym->var_cname(self->lex->toktext, cn, sizeof cn) == 0)
                    snprintf(dim, sizeof dim, "[%s]", cn);
                else
                    snprintf(dim, sizeof dim, "[%s]", self->lex->toktext);
            } else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0) {
                /* `T a[][N]`: an unsized parameter dimension (10.6) */
                snprintf(dim, sizeof dim, "[]");
                unsized = 1;
            } else {
                raw = 1;
            }
            if (!unsized && !raw) {
                self->sup->lex_next();
                /* more than one token inside the brackets (`[MAX_NAME * 2]`):
                   the expression is kept as written */
                if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "]") == 0)) {
                    raw = 1;
                    dim[0] = 0;
                }
            }
            if (raw) {
                /* copy the source text between the brackets, then let the lexer
                   re-read from just past the closing one */
                int p2, d2, q2;
                p2 = open + 1;
                d2 = 0;
                q2 = 0;
                dim[q2] = '[';
                q2++;
                while (self->lex->src[p2] && q2 + 2 < MAX_TEXT) {
                    char ch = self->lex->src[p2];
                    if (ch == '[') d2++;
                    else if (ch == ']') {
                        if (d2 == 0) break;
                        d2--;
                    }
                    dim[q2] = ch;
                    q2++;
                    p2++;
                }
                if (self->lex->src[p2] != ']') return self->sup->fail("expected an array length");
                dim[q2] = ']';
                q2++;
                dim[q2] = 0;
                self->lex->pos = p2 + 1;
                self->sup->lex_next();
            } else if (self->sup->expect("]") != 0) {
                return -1;
            }
            snprintf(cur, sizeof cur, "%s%s", self->arena->nodes[n].text3, dim);
            snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cur);
            self->arena->nodes[n].num = 0;      /* text3 is the authoritative spelling */
        }
        return 0;
    }

    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res, save_start, save_lstart;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        save_start = self->lex->tokstart;
        save_lstart = self->lex->lstart;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->sup->lex_next();
        res = 0;
        if (self->lex->tok == T_ID) {
            char rn[MAX_TEXT];
            /* `_Atomic(type)` is a type on its own: the word is a keyword, so
               the balanced list (and optional stars) is all that stands between
               it and the cast's closing parenthesis. */
            if (strcmp(self->lex->toktext, "_Atomic") == 0) {
                int d = 0;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    for (;;) {
                        if (self->lex->tok == T_EOF) break;
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) d++;
                        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                            d--;
                            if (d == 0) {
                                self->sup->lex_next();
                                break;
                            }
                        }
                        self->sup->lex_next();
                    }
                    while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0)
                        self->sup->lex_next();
                    res = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0);
                }
            } else
            /* resolve first: an imported name is a type even though the table
               only holds its mangled spelling */
            if (self->is_type_word(self->lex->toktext)) {
                res = 1;
            } else if (self->sup->resolve_type(self->lex->toktext, rn, sizeof rn) == 0
                       && self->sym->find_type(rn) >= 0) {
                res = 1;
            } else {
                /* A type name only a header declares (`time_t`), used in a cast
                   or `sizeof`. A declared variable or function is an operand,
                   and an ALL_CAPS name is a macro constant by the same rule
                   `parse_primary` applies, so `(MAX) + 1` keeps reading as an
                   expression. A cast's type also has to close the parenthesis
                   (`(time_t)`, `(time_t *)`); `(f(x))` is a call in parentheses,
                   which is what an undeclared library name looks like. */
                int i, caps;
                caps = (self->lex->toktext[0] != 0);
                for (i = 0; self->lex->toktext[i]; i++) {
                    char cc = self->lex->toktext[i];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        caps = 0;
                        break;
                    }
                }
                if (!caps && self->sym->find_var(self->lex->toktext) < 0
                    && self->sym->find_func(self->lex->toktext) < 0) {
                    self->sup->lex_next();
                    while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0)
                        self->sup->lex_next();
                    res = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0);
                }
            }
        }
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        self->lex->tokstart = save_start;
        self->lex->lstart = save_lstart;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    /* Current token is `offsetof`; does a `(` follow? The builtin has no
       operand form, so a bare name stays an ordinary identifier and the normal
       undeclared-variable path reports it (D-8). */
    int offsetof_ahead(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        snprintf(save_text, sizeof save_text, "%s", self->lex->toktext);
        self->sup->lex_next();
        res = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0);
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        snprintf(self->lex->toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    /* Is `field` of the struct `stype` a function pointer? A field declared in
       place keeps the `(*)` in its type; a typedef field (`BinOp cb;`) is only
       known through the type table's kind 4 (D-4). */
    int fnptr_field(const char *stype, const char *field)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        int s, fi, ti;
        (void)self;

        snprintf(buf, sizeof buf, "%s", stype);
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            base[n - 1] = 0;
            n--;
        }
        s = self->sym->find_struct(base);
        if (s < 0) return 0;
        for (fi = 0; fi < self->sym->structs[s].nfields; fi++) {
            if (strcmp(self->sym->structs[s].fields[fi].name, field) != 0) continue;
            if (strstr(self->sym->structs[s].fields[fi].type, "(*")) return 1;
            ti = self->sym->find_type(self->sym->structs[s].fields[fi].type);
            return (ti >= 0 && self->sym->type_kind[ti] == 4);
        }
        return 0;
    }

    /* Is this node tree an integer constant expression? ct-ast folds nothing,
       so the judgement is structural: the emitter keeps the source spelling and
       the C compiler does the arithmetic (D-6). A lone name is the caller's
       business -- a `case` label accepts one (a macro or a global), while an
       enum initialiser only accepts a declared constant or a macro. */
    int const_ok(int n)
    {
        int k;
        (void)self;

        if (n < 0) return 0;
        k = self->arena->nodes[n].kind;
        if (k == N_NUM || k == N_RAW || k == N_SIZEOF || k == N_OFFSETOF) return 1;
        if (k == N_STR) {
            /* a character literal keeps its quotes in the pool; a string does
               not form an integer constant */
            return self->arena->str_at((int)self->arena->nodes[n].num)[0] == '\'';
        }
        if (k == N_VAR) return self->sym->is_const_name(self->arena->nodes[n].text2);
        if (k == N_UNARY)
            return (self->arena->nodes[n].aux == U_NEG || self->arena->nodes[n].aux == U_NOT
                    || self->arena->nodes[n].aux == U_BNOT)
                && self->const_ok(self->arena->nodes[n].a);
        if (k == N_BIN)
            return self->const_ok(self->arena->nodes[n].a) && self->const_ok(self->arena->nodes[n].b);
        return 0;
    }

    int parse_expr(void)
    {
        int left, right, inner, n, c;
        (void)self;

        /* C precedence, loosest first: `||`, `&&`, then the bitwise levels
           (`|` `^` `&`) owned by parse_bitor. The loops live here so the
           trait's method budget stays put. */
        left = self->parse_bitor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
            self->sup->lex_next();
            right = self->parse_bitor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_AND;
            left = n;
        }
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "||") == 0) {
            self->sup->lex_next();
            right = self->parse_bitor();
            if (right < 0) return -1;
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&&") == 0) {
                self->sup->lex_next();
                inner = self->parse_bitor();
                if (inner < 0) return -1;
                n = self->sup->new_node(N_BIN);
                if (n < 0) return -1;
                self->arena->nodes[n].a = right;
                self->arena->nodes[n].b = inner;
                self->arena->nodes[n].aux = B_AND;
                right = n;
            }
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_OR;
            left = n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "?") == 0) {
            int a, b;
            self->sup->lex_next();
            a = self->parse_expr();
            if (a < 0) return -1;
            if (self->sup->expect(":") != 0) return -1;
            b = self->parse_expr();
            if (b < 0) return -1;
            c = self->sup->new_node(N_TERN);
            if (c < 0) return -1;
            self->arena->nodes[c].a = left;
            self->arena->nodes[c].b = a;
            self->arena->nodes[c].c = b;
            return c;
        }
        /* An assignment used as a value: `(c = f())`, `(a = b = 0)`. Only the
           `(` branch below and a statement's condition turn `assign_ok` on, so a
           statement's own assignment (`x = 1;`) still goes through the statement
           layer, which is where AutoDrop keeps its bookkeeping. Parsing the right
           side here again makes the operator right-associative. */
        if (self->assign_ok && self->lex->tok == T_PUNCT
            && (strcmp(self->lex->toktext, "=") == 0
                || strcmp(self->lex->toktext, "+=") == 0 || strcmp(self->lex->toktext, "-=") == 0
                || strcmp(self->lex->toktext, "*=") == 0 || strcmp(self->lex->toktext, "/=") == 0
                || strcmp(self->lex->toktext, "%=") == 0 || strcmp(self->lex->toktext, "&=") == 0
                || strcmp(self->lex->toktext, "|=") == 0 || strcmp(self->lex->toktext, "^=") == 0
                || strcmp(self->lex->toktext, "<<=") == 0 || strcmp(self->lex->toktext, ">>=") == 0)) {
            int op = 0, k2;
            char oc = self->lex->toktext[0];
            k2 = self->arena->nodes[left].kind;
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX && k2 != N_DEREF)
                return self->sup->fail("assignment target is not assignable");
            /* An `own` variable is tracked by statement-level assignments; an
               assignment in a value position would slip past that bookkeeping,
               so it is refused instead of silently leaking. */
            if (k2 == N_VAR) {
                int vi = self->sym->find_var(self->arena->nodes[left].text2);
                if (vi >= 0 && self->sym->vars[vi].autodrop)
                    return self->sup->fail("an 'own' variable can only be assigned in a statement");
            }
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else if (oc == '%') op = 5;
            else if (oc == '&') op = 6;
            else if (oc == '|') op = 7;
            else if (oc == '^') op = 8;
            else if (oc == '<') op = 9;
            else if (oc == '>') op = 10;
            self->sup->lex_next();
            right = self->parse_expr();
            if (right < 0) return -1;
            n = self->sup->new_node(N_ASSIGN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            return n;
        }
        return left;
    }

    /* `|`, `^`, `&` are three separate levels in C, and `<<` / `>>` bind
       tighter than the comparisons but looser than `+` / `-`. */
    int parse_bitor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bxor();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "|") == 0) {
            self->sup->lex_next();
            right = self->parse_bxor();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BOR;
            left = n;
        }
        return left;
    }

    int parse_bxor(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_bitand();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "^") == 0) {
            self->sup->lex_next();
            right = self->parse_bitand();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_XOR;
            left = n;
        }
        return left;
    }

    int parse_bitand(void)
    {
        int left, right, n;
        (void)self;

        left = self->parse_cmp();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            self->sup->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = B_BAND;
            left = n;
        }
        return left;
    }

    int parse_shift(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT
               && (strcmp(self->lex->toktext, "<<") == 0 || strcmp(self->lex->toktext, ">>") == 0)) {
            op = (self->lex->toktext[0] == '<') ? B_SHL : B_SHR;
            self->sup->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_shift();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT) {
            op = 0;
            if (strcmp(self->lex->toktext, "<") == 0) op = B_LT;
            else if (strcmp(self->lex->toktext, ">") == 0) op = B_GT;
            else if (strcmp(self->lex->toktext, "<=") == 0) op = B_LE;
            else if (strcmp(self->lex->toktext, ">=") == 0) op = B_GE;
            else if (strcmp(self->lex->toktext, "==") == 0) op = B_EQ;
            else if (strcmp(self->lex->toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->sup->lex_next();
            right = self->parse_shift();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "+") == 0 || strcmp(self->lex->toktext, "-") == 0)) {
            op = (self->lex->toktext[0] == '+') ? B_ADD : B_SUB;
            self->sup->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "*") == 0
               || strcmp(self->lex->toktext, "/") == 0 || strcmp(self->lex->toktext, "%") == 0)) {
            op = B_MUL;
            if (self->lex->toktext[0] == '/') op = B_DIV;
            else if (self->lex->toktext[0] == '%') op = B_MOD;
            self->sup->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->sup->new_node(N_BIN);
            if (n < 0) return -1;
            self->arena->nodes[n].a = left;
            self->arena->nodes[n].b = right;
            self->arena->nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        if (self->lex->tok == T_ID && (strcmp(self->lex->toktext, "sizeof") == 0
                                       || strcmp(self->lex->toktext, "_Alignof") == 0)) {
            char tbuf[MAX_TEXT];
            int align = (self->lex->toktext[0] == '_');
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
                && self->next_is_type_name()) {
                self->sup->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->sup->expect(")") != 0) return -1;
                n = self->sup->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[n].aux = align ? 2 : 1;
                return n;
            }
            /* C11 spells the alignment query with a type name only, so the
               operand form stays `sizeof`'s alone. */
            if (align) return self->sup->fail("_Alignof needs a type in parentheses");
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_SIZEOF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        /* `(params) => expr` opens a closure literal. The check runs before
           the cast branch: a typed parameter list starts with a type word, so
           `next_is_type_name` would otherwise read `(int x)` as a cast. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && closure_ahead(self))
            return self->parse_closure();
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->sup->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            /* `(type){ … }` is a compound literal: the braces are captured like
               a declaration initialiser, and the emitter adds the vptr items a
               trait-carrying struct needs. A postfix suffix still applies, so
               the node rides through `postfix_seed` instead of returning here. */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
                /* a compound literal's braces go to the arena string pool for the
                   same reason a declaration initialiser does (`aux = 1`,
                   `num` = offset) */
                char raw[MAX_RAW_INIT];
                int rn, cn, off, k;
                size_t tl = strlen(tbuf);
                if (tl > 0 && tbuf[tl - 1] == '*')
                    return self->sup->fail("a compound literal needs an object type");
                rn = self->sup->new_node(N_RAW);
                if (rn < 0) return -1;
                if (self->sup->init_raw(raw, sizeof raw) != 0) return -1;
                off = self->arena->str_begin();
                for (k = 0; raw[k]; k++)
                    if (self->arena->str_put(raw[k]) != 0)
                        return self->sup->fail("initializer is too long");
                self->arena->str_end();
                self->arena->nodes[rn].num = off;
                self->arena->nodes[rn].aux = 1;
                cn = self->sup->new_node(N_COMPOUND);
                if (cn < 0) return -1;
                snprintf(self->arena->nodes[cn].text, MAX_TEXT, "%s", tbuf);
                self->arena->nodes[cn].a = rn;
                self->postfix_seed = cn;
                return self->parse_postfix();
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_CAST);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            self->arena->nodes[n].a = e;
            return n;
        }
        op = 0;
        /* prefix `++` / `--`: the same increment as the postfix form, but the
           value is the updated one (D-9 of this batch). It binds like the other
           unary operators, so `s[--n]` and `*--p` work as in C. */
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0
                                          || strcmp(self->lex->toktext, "--") == 0)) {
            int pre = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            if (is_range_index(self->arena, e))
                return self->sup->fail("the range index '$' is not a variable");
            n = self->sup->new_node(N_PRE);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = pre;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "-") == 0) op = U_NEG;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "!") == 0) op = U_NOT;
        else if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "~") == 0) op = U_BNOT;
        if (op != 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_UNARY);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            self->arena->nodes[n].aux = op;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "&") == 0) {
            int save;
            self->sup->lex_next();
            save = self->fnval_ok;
            self->fnval_ok = 1;      /* `&handler` may name a C library function */
            e = self->parse_unary();
            self->fnval_ok = save;
            if (e < 0) return -1;
            if (is_range_index(self->arena, e))
                return self->sup->fail("the range index '$' is not a variable");
            n = self->sup->new_node(N_ADDR);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "*") == 0) {
            self->sup->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->sup->new_node(N_DEREF);
            if (n < 0) return -1;
            self->arena->nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    int parse_postfix(void)
    {
        int n, m, idx, args, mline, mcol;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->postfix_seed;
        self->postfix_seed = -1;
        if (n < 0) {
            n = self->parse_primary();
            if (n < 0) return -1;
        }
        for (;;) {
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "[") == 0) {
                self->sup->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->sup->expect("]") != 0) return -1;
                m = self->sup->new_node(N_INDEX);
                if (m < 0) return -1;
                self->arena->nodes[m].a = n;
                self->arena->nodes[m].b = idx;
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, ".") == 0
                                     || strcmp(self->lex->toktext, "->") == 0)) {
                int arrow;
                arrow = (self->lex->toktext[0] == '-') ? 1 : 0;
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a field or method name");
                snprintf(fname, sizeof fname, "%s", self->lex->toktext);
                mline = self->lex->tokline;
                mcol = self->lex->tokstart - self->lex->lstart + 1;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->sup->new_node(N_MCALL);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    self->arena->nodes[m].b = (args == 0) ? -1 : args;
                    self->arena->nodes[m].aux = arrow ? 2 : 1;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs. Inside a trait's default body the
                       adopting struct is unknown, so a call on `self` names the
                       enclosing trait directly. */
                    if (self->sym->trait_default[0]
                        && self->arena->nodes[n].kind == N_VAR
                        && strcmp(self->arena->nodes[n].text2, "self") == 0) {
                        /* a forward sibling call (`a` calling a later `b`) is
                           legal, so the trait name is recorded without looking
                           the method up; the cycle check runs after the whole
                           trait has been parsed. */
                        snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s",
                                 self->sym->trait_default);
                    } else if (self->sup->expr_type(n, rtype, sizeof rtype) == 0) {
                        char ibase[MAX_TEXT];
                        size_t il;
                        int piface = 0;
                        /* a pointer to an interface value dispatches through
                           `->vt` instead of `.vt` */
                        snprintf(ibase, sizeof ibase, "%s", rtype);
                        il = strlen(ibase);
                        while (il > 0 && (ibase[il - 1] == ' ' || ibase[il - 1] == '*')) {
                            if (ibase[il - 1] == '*') piface = 1;
                            il--;
                            ibase[il] = 0;
                        }
                        if (self->sup->is_iface_type(ibase, trname, sizeof trname)) {
                            int t = self->sym->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                                    if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                self->arena->nodes[m].aux = piface ? 4 : 3;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            }
                        } else if (self->sup->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            char tr2[MAX_TEXT];
                            snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", trname);
                            /* 19.3 (SH-46): a second trait of the same struct
                               declaring the method means the bare call keeps
                               the first match in `use` order silently (the spec
                               pins that resolution) -- name both in a warning.
                               A static type host and a `map` binding resolve
                               below, outside `method_trait`, so they never
                               reach this check. */
                            if (self->sup->method_trait_amb(rtype, fname, trname,
                                                            tr2, sizeof tr2) == 0) {
                                char amsg[MAX_TEXT];
                                snprintf(amsg, sizeof amsg,
                                         "declared by '%s' and '%s'; '%s' is used",
                                         trname, tr2, trname);
                                if (self->sup->amb_warn(mline, mcol, fname, amsg) != 0)
                                    return self->sup->fail("too many warnings");
                            }
                        }
                        /* No trait answered: a function-pointer field called
                           directly is the callee itself, so `o.add(2, 3)` is
                           a call through `o.add` -- the shape `p(x)` takes, but
                           with a member node as the callee (D-4). */
                        if (!self->arena->nodes[m].text[0] && self->fnptr_field(rtype, fname)) {
                            int mf;
                            mf = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                            if (mf < 0) return -1;
                            self->arena->nodes[mf].a = n;
                            snprintf(self->arena->nodes[mf].text2, MAX_TEXT, "%s", fname);
                            self->arena->nodes[m].kind = N_CALL;
                            self->arena->nodes[m].a = (args == 0) ? -1 : args;
                            self->arena->nodes[m].b = mf;
                            self->arena->nodes[m].aux = 2;
                        }
                        /* Still unresolved: the method may belong to a static
                           type host (`map ... for type char *`). Keep the call
                           as an N_MCALL, record the receiver's static type
                           (locals are gone by emit time) and let the emitter
                           match it against the visible static maps. */
                        if (!self->arena->nodes[m].text[0]
                            && self->arena->nodes[m].kind == N_MCALL) {
                            char it[MAX_TEXT];
                            if (!self->sup->is_iface_type(rtype, it, sizeof it)) {
                                char rt2[MAX_TEXT];
                                snprintf(rt2, sizeof rt2, "%s", rtype);
                                if (self->arena->nodes[n].kind == N_VAR) {
                                    int vi = self->sym->find_var(self->arena->nodes[n].text2);
                                    if (vi >= 0 && self->sym->vars[vi].is_array
                                        && strlen(rt2) + 2 < sizeof rt2)
                                        strcat(rt2, " *");
                                }
                                self->arena->nodes[m].aux = 6;
                                snprintf(self->arena->nodes[m].text, MAX_TEXT, "%s", rt2);
                                /* P20-03: the emitter picks the map, so the
                                   arity check beside the resolved-method path
                                   never sees this call. Every visible binding
                                   records the method it expands to, so the
                                   count is still knowable here: one accepting
                                   candidate is enough, and a call no candidate
                                   accepts is reported in the same words as a
                                   resolved method. The map table belongs to the
                                   parser but the type object already points at
                                   it, so this unit needs no new plumbing. */
                                {
                                    struct Map *hm;
                                    int hn, mi2, bi2, want = 0, seen = 0, fits = 0;
                                    int got2 = arg_count(self->arena, args);
                                    char rk[MAX_TEXT];
                                    char tk[MAX_TEXT];
                                    char msg[MAX_TEXT];
                                    hm = self->sup->ty->maps;
                                    hn = *self->sup->ty->nmaps;
                                    /* the same host key the emitter and the
                                       type pass compare with: `tnorm` only
                                       drops qualifiers, so `unsigned` and
                                       `unsigned int` would miss each other
                                       here while the recipe still expands,
                                       dropping a surplus actual in silence */
                                    frontend::type::type_key(rt2, rk, sizeof rk);
                                    for (mi2 = 0; mi2 < hn; mi2++) {
                                        if (!hm[mi2].is_static
                                            || !hm[mi2].type_host) continue;
                                        frontend::type::type_key(hm[mi2].host_type, tk, sizeof tk);
                                        if (strcmp(tk, rk) != 0) continue;
                                        for (bi2 = 0; bi2 < hm[mi2].nb; bi2++) {
                                            int want2, tail2;
                                            if (strcmp(hm[mi2].b[bi2].method,
                                                       fname) != 0) continue;
                                            /* a type-host binding names the
                                               receiver first */
                                            want2 = hm[mi2].b[bi2].nparams
                                                    - hm[mi2].b[bi2].recv;
                                            /* a recipe that forwards a tail
                                               (`printf(fmt, ...)`) makes the
                                               count a lower bound; the map
                                               builder only accepts `...` when
                                               the binding declares it, so the
                                               recipe text is the marker */
                                            tail2 = strstr(hm[mi2].b[bi2].call,
                                                           "...") != 0;
                                            if (!seen) want = want2;
                                            seen = 1;
                                            if (tail2 ? got2 >= want2 : got2 == want2)
                                                fits = 1;
                                        }
                                    }
                                    if (seen && !fits) {
                                        snprintf(msg, sizeof msg,
                                                 "takes %d argument(s), %d given",
                                                 want, got2);
                                        if (self->sup->arity_warn(mline, mcol, fname,
                                                                  msg) != 0)
                                            return self->sup->fail("too many warnings");
                                    }
                                }
                            }
                        }
                    }
                } else {
                    m = self->sup->new_node(arrow ? N_ARROW : N_MEMBER);
                    if (m < 0) return -1;
                    self->arena->nodes[m].a = n;
                    snprintf(self->arena->nodes[m].text2, MAX_TEXT, "%s", fname);
                }
                /* 19.1: a resolved trait method is compared against the call's
                   argument count. A static trait (a `.m.ct` recipe), a `map`
                   binding (the receiver's type stays in `text`) and a call
                   through a function-pointer field (`kind` became N_CALL) are
                   all unknown here and pass. `arity_check` only reports, so the
                   generated call is unchanged. */
                if (self->arena->nodes[m].kind == N_MCALL
                    && self->arena->nodes[m].text[0]) {
                    int t = self->sym->find_trait(self->arena->nodes[m].text);
                    if (t >= 0) {
                        int mi;
                        for (mi = 0; mi < self->sym->traits[t].nm; mi++)
                            if (strcmp(self->sym->traits[t].m[mi].name, fname) == 0) break;
                        /* a static recipe must still agree on the count: the
                           surplus is only legal when the recipe forwards it */
                        if (mi < self->sym->traits[t].nm
                            && self->map_arity(mline, mcol, self->arena->nodes[m].text,
                                               fname, arg_count(self->arena, args)) != 0)
                            return -1;
                        /* 19.2: the argument types against the resolved trait
                           method, same rules as a function call. */
                        if (!self->sym->traits[t].is_static
                            && mi < self->sym->traits[t].nm
                            && self->argtype_check(mline, mcol, fname, args, -1, t, mi) != 0)
                            return -1;
                    }
                }
                n = m;
                continue;
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                /* a call through a pointer expression: `(*p)(x)` (D-7). A plain
                   `name(...)` was already consumed by `parse_primary`. */
                args = self->parse_args();
                if (args < 0) return -1;
                m = self->sup->new_node(N_CALL);
                if (m < 0) return -1;
                self->arena->nodes[m].a = (args == 0) ? -1 : args;
                self->arena->nodes[m].b = n;
                self->arena->nodes[m].aux = 2;
                n = m;
                continue;
            }
            break;
        }
        if (self->lex->tok == T_PUNCT && (strcmp(self->lex->toktext, "++") == 0 || strcmp(self->lex->toktext, "--") == 0)) {
            int k;
            if (is_range_index(self->arena, n))
                return self->sup->fail("the range index '$' is not a variable");
            k = self->arena->nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->sup->fail("'++' / '--' need an assignable target");
            m = self->sup->new_node(N_POST);
            if (m < 0) return -1;
            self->arena->nodes[m].a = n;
            self->arena->nodes[m].aux = (self->lex->toktext[0] == '+') ? P_INC : P_DEC;
            self->sup->lex_next();
            return m;
        }
        return n;
    }

    /* A closure literal `(params) => expr` (Phase 21 S2). The cursor sits on
       the `(`. The literal gets its own parameter scope; a name the body uses
       that resolves below `pstart` is a capture, so a parameter that shadows an
       outer variable keeps the outer one out (D21-2). Names and types are
       copied into the closure table before the scope is popped, because the
       symbol slots are reused. S2 parses and checks only: nothing is emitted. */
    int parse_closure(void)
    {
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        char owner[MAX_TEXT];
        int ci, pstart, body, n, line, col, save_assign;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        snprintf(owner, sizeof owner, "%s", self->cur_func ? self->cur_func : "");
        ci = self->sym->closure_new(owner);
        if (ci < 0) return self->sup->fail(self->sym->last_error());
        self->sym->closures[ci].line = line;
        self->sym->closures[ci].col = col;
        self->sup->lex_next();                       /* the `(` */
        pstart = self->sym->nvar;
        if (self->sym->push_scope() != 0) return self->sup->fail(self->sym->last_error());
        if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
            for (;;) {
                if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
                if (self->fnptr_state) {
                    if (!self->fnptr_name[0])
                        return self->sup->fail("expected a parameter name");
                    snprintf(name, sizeof name, "%s", self->fnptr_name);
                } else {
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a parameter name");
                    snprintf(name, sizeof name, "%s", self->lex->toktext);
                    self->sup->lex_next();
                }
                if (self->sym->declare_var(name, typebuf) != 0)
                    return self->sup->fail(self->sym->last_error());
                if (self->sym->closures[ci].nparams >= 16)
                    return self->sup->fail("a closure takes too many parameters (limit 16)");
                if (closure_copy(self,
                                 self->sym->closures[ci].ptype[self->sym->closures[ci].nparams],
                                 typebuf, "a closure parameter type") != 0) return -1;
                if (closure_copy(self,
                                 self->sym->closures[ci].pname[self->sym->closures[ci].nparams],
                                 name, "a closure parameter name") != 0) return -1;
                self->sym->closures[ci].nparams++;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                    self->sup->lex_next();
                    continue;
                }
                break;
            }
        }
        if (self->sup->expect(")") != 0) return -1;
        if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "=>") != 0)
            return self->sup->fail("expected '=>' after a closure's parameter list");
        self->sup->lex_next();
        /* R09: the nesting stack is not optional. Dropping the push would leave
           an inner literal without its parent's environment, so the emitter
           would build it against the wrong frame; the cap is a hard error. */
        if (self->ncl_stack >= 16)
            return self->sup->fail("a closure is nested too deeply (limit 16)");
        self->cl_stack[self->ncl_stack] = ci;
        self->cl_pstart[self->ncl_stack] = pstart;
        self->ncl_stack++;
        /* S5: `=> { … }` is a block body; the statement layer owns blocks and
           this object cannot import it, so the parser installed a hook. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "{") == 0) {
            if (!self->body_hook)
                return self->sup->fail("a block-bodied closure needs the statement parser");
            body = self->body_hook();
            self->sym->closures[ci].is_block = 1;
        } else {
            save_assign = self->assign_ok;
            self->assign_ok = 1;
            body = self->parse_expr();
            self->assign_ok = save_assign;
        }
        if (body < 0) return -1;
        self->sym->closures[ci].body = body;
        if (closure_walk(self, ci, body, pstart) != 0) return -1;
        if (closure_walk_shadow(self, ci, body) != 0) return -1;
        if (closure_walk_mutate(self, ci, body) != 0) return -1;
        if (self->ncl_stack > 0 && self->cl_stack[self->ncl_stack - 1] == ci)
            self->ncl_stack--;
        if (self->sym->pop_scope() != 0) return self->sup->fail(self->sym->last_error());
        n = self->sup->new_node(N_CLOSURE);
        if (n < 0) return -1;
        self->arena->nodes[n].num = ci;
        self->arena->nodes[n].a = body;
        return n;
    }

    int parse_primary(void)
    {
        int n, args, id_line, id_col;
        char qc[MAX_TEXT];
        char qv[MAX_TEXT];
        char tsrc[MAX_TEXT];
        char tag[MAX_TEXT];
        int qf;
        int nu, nl, sl;
        (void)self;

        qc[0] = 0;
        qv[0] = 0;
        /* C11 `_Generic(…)` is a pass-through: the whole selection is copied
           into the string pool (`N_RAW`, `aux = 1`, `num` = offset) and handed
           to the C compiler, which owns the arm choice. ct does not read the
           arms, so a trait call or a boxing inside one is not rewritten. */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "_Generic") == 0) {
            char gname[MAX_TEXT];
            int off, depth, k;
            n = self->sup->new_node(N_RAW);
            if (n < 0) return -1;
            off = self->arena->str_begin();
            snprintf(gname, sizeof gname, "%s", "_Generic");
            for (k = 0; gname[k]; k++)
                if (self->arena->str_put(gname[k]) != 0)
                    return self->sup->fail("string pool is full");
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0)
                return self->sup->fail("expected '(' after _Generic");
            depth = 0;
            for (;;) {
                char tbuf[MAX_TEXT];
                int m;
                if (self->lex->tok == T_EOF) return self->sup->fail("unterminated _Generic");
                if (self->arena->str_put(' ') != 0)
                    return self->sup->fail("string pool is full");
                /* an integer token keeps its value, not its spelling */
                if (self->lex->tok == T_NUM && !self->lex->tokfloat)
                    snprintf(tbuf, sizeof tbuf, "%ld", self->lex->toknum);
                else
                    snprintf(tbuf, sizeof tbuf, "%s", self->lex->toktext);
                for (m = 0; tbuf[m]; m++)
                    if (self->arena->str_put(tbuf[m]) != 0)
                        return self->sup->fail("string pool is full");
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) depth++;
                if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
                    depth--;
                    if (depth == 0) {
                        self->sup->lex_next();
                        break;
                    }
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            self->arena->nodes[n].aux = 1;
            return n;
        }
        if (self->lex->tok == T_NUM) {
            /* an integer keeps its value (`long`, emitted in decimal); a
               floating literal keeps its spelling, since neither the value nor
               the `f` / `L` suffix survives a `long` */
            n = self->sup->new_node(self->lex->tokfloat ? N_FNUM : N_NUM);
            if (n < 0) return -1;
            if (self->lex->tokfloat)
                snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->lex->toktext);
            else {
                self->arena->nodes[n].num = self->lex->toknum;
                /* An integer suffix is spelling, not value: `U` may appear once
                   and `L` twice, and the emitted form always orders them U then
                   L (`uLL`, `LLu`, `lL` all become `ULL` / `LL`). */
                nu = 0;
                nl = 0;
                for (sl = 0; self->lex->toksuffix[sl]; sl++) {
                    if (self->lex->toksuffix[sl] == 'u' || self->lex->toksuffix[sl] == 'U') nu++;
                    else nl++;
                }
                if (nu > 1 || nl > 2 || sl > 3)
                    return self->sup->fail("an integer suffix may be U, L or LL");
                if (nu && nl == 2) snprintf(self->arena->nodes[n].text, MAX_TEXT, "ULL");
                else if (nu && nl == 1) snprintf(self->arena->nodes[n].text, MAX_TEXT, "UL");
                else if (nu) snprintf(self->arena->nodes[n].text, MAX_TEXT, "U");
                else if (nl == 2) snprintf(self->arena->nodes[n].text, MAX_TEXT, "LL");
                else if (nl == 1) snprintf(self->arena->nodes[n].text, MAX_TEXT, "L");
            }
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_STR) {
            int off = self->arena->str_begin();
            n = self->sup->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (self->lex->tok == T_STR) {
                int m = 0;
                while (self->lex->toktext[m]) {
                    if (self->arena->str_put((unsigned char)self->lex->toktext[m]) != 0)
                        return self->sup->fail("string pool is full");
                    m++;
                }
                self->sup->lex_next();
            }
            self->arena->str_end();
            self->arena->nodes[n].num = off;
            return n;
        }
        /* `offsetof(<struct type>, <field>)` is a builtin, not a macro: CT has
           no preprocessor, so the compiler recognises it here and the generated
           `.c` keeps the same call (D-8). */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "offsetof") == 0
            && self->offsetof_ahead()) {
            char tbuf[MAX_TEXT];
            char fname[MAX_TEXT];
            char base[MAX_TEXT];
            char msg[MAX_TEXT];
            char kw[16];
            char *bp;
            size_t bl;
            int si, fi, known;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(",") != 0) return -1;
            if (self->lex->tok != T_ID) return self->sup->fail("expected a field name");
            snprintf(fname, sizeof fname, "%s", self->lex->toktext);
            /* Both checks run while the cursor is still on the field, so the
               diagnostic points at the argument the user has to fix. */
            snprintf(base, sizeof base, "%s", tbuf);
            bp = base;
            snprintf(kw, sizeof kw, "%s", "struct");
            if (strncmp(bp, "struct ", 7) == 0) {
                bp += 7;
            } else if (strncmp(bp, "union ", 6) == 0) {
                snprintf(kw, sizeof kw, "%s", "union");
                bp += 6;
            }
            while (*bp == ' ') bp++;
            bl = strlen(bp);
            while (bl > 0 && (bp[bl - 1] == ' ' || bp[bl - 1] == '*')) {
                bl--;
                bp[bl] = 0;
            }
            si = self->sym->find_struct(bp);
            if (si < 0) return self->sup->fail("offsetof needs a struct type");
            /* a forward declaration has no field list yet: leave it to C */
            known = !self->sym->structs[si].defined;
            for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
                if (strcmp(self->sym->structs[si].fields[fi].name, fname) == 0) known = 1;
            if (!known) {
                if (snprintf(msg, sizeof msg, "%s '%s' has no field '%s'", kw, bp, fname)
                    >= (int)sizeof msg)
                    return self->sup->fail("offsetof field name is too long");
                return self->sup->fail(msg);
            }
            self->sup->lex_next();
            if (self->sup->expect(")") != 0) return -1;
            n = self->sup->new_node(N_OFFSETOF);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", fname);
            return n;
        }
        /* `va_arg(<ap>, <type>)` is the one stdarg macro that is not a call: its
           second argument is a type, so it is a builtin like `offsetof` and the
           generated `.c` keeps the same spelling (D-9). */
        if (self->lex->tok == T_ID && strcmp(self->lex->toktext, "va_arg") == 0
            && self->offsetof_ahead()) {
            char tbuf[MAX_TEXT];
            int ap;
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            ap = self->parse_expr();
            if (ap < 0) return -1;
            if (self->sup->expect(",") != 0) return -1;
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->sup->expect(")") != 0) return -1;
            n = self->sup->new_node(N_VAARG);
            if (n < 0) return -1;
            self->arena->nodes[n].a = ap;
            snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", tbuf);
            return n;
        }
        /* Phase 24: the range index. `$` has no C spelling of its own -- the
           emitter renders it as `((int)<k>)` -- so it never reaches the symbol
           table; outside the element expression of a range initialiser it is a
           syntax error, never an undeclared name. */
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "$") == 0) {
            if (!self->dollar_ok) return self->sup->fail("unexpected token");
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", "$");
            self->sup->lex_next();
            return n;
        }
        if (self->lex->tok == T_ID) {
            id_line = self->lex->tokline;
            id_col = self->lex->tokstart - self->lex->lstart + 1;
            n = self->sup->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->lex->toktext);
            self->sup->lex_next();
            /* `Qual::fn(...)`: the qualifier names a namespace path or a type,
               and the callee lives in that namespace. Without the call it names
               a variable instead (`a::h`), whose C spelling is the mangled one. */
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                snprintf(tsrc, sizeof tsrc, "%s", self->arena->nodes[n].text2);
                if (self->parse_qual_path(self->arena->nodes[n].text2, MAX_TEXT, qc, MAX_TEXT,
                                          qv, MAX_TEXT, &qf) != 0)
                    return -1;
                /* `Trait::ns`: a namespace-host interface value (SH-20). The
                   host has no object, so the node carries no operand (`a`), the
                   vtable is named after `text2` and `text3` keeps the source
                   spelling for the emitter's diagnostics. */
                if (qf == 3) {
                    char mname[MAX_TEXT];
                    int mn;
                    if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ".") == 0))
                        return self->sup->fail("a static trait has no interface value");
                    self->sup->lex_next();
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a method name");
                    snprintf(mname, sizeof mname, "%s", self->lex->toktext);
                    self->sup->lex_next();
                    args = self->parse_args();
                    if (args < 0) return -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = -1;
                    self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                    self->arena->nodes[mn].aux = 5;
                    snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", mname);
                    snprintf(self->arena->nodes[mn].text3, MAX_TEXT, "%s", qv);
                    if (self->map_arity(id_line, id_col, self->arena->nodes[n].text2,
                                        mname, arg_count(self->arena, args)) != 0)
                        return -1;
                    return mn;
                }
                /* Q2-A: `ns::method(...)` with the trait segment elided. The
                   qualifier is a static map's namespace host and the method name
                   is unique (parse_qual_path checked both), so this is the same
                   recipe call `ns::Trait.method(...)` builds above. */
                if (qf == 4) {
                    int mn;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = -1;
                    self->arena->nodes[mn].b = (args == 0) ? -1 : args;
                    self->arena->nodes[mn].aux = 5;
                    snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[mn].text3, MAX_TEXT, "%s", qv);
                    if (self->map_arity(id_line, id_col, self->arena->nodes[n].text2,
                                        qc, arg_count(self->arena, args)) != 0)
                        return -1;
                    return mn;
                }
                /* P20-01: `Trait::method(recv, ...)` — the first actual is the
                   receiver, so the node is the same static-recipe call as a
                   type-host method (`aux == 6`), with the forced trait in
                   `text3`. That is what lets two packages bind `len` to
                   `char *` and the caller pick one. Writing the node directly
                   must not skip the arity check the other static-recipe forms
                   run, or an extra actual is dropped by the recipe with no
                   diagnostic. */
                if (qf == 5) {
                    char rtype[MAX_TEXT];
                    int mn, rest, got;
                    args = self->parse_args();
                    if (args < 0) return -1;
                    if (args == 0)
                        return self->sup->fail("a qualified method call needs a receiver argument");
                    /* the receiver stands apart from the trait method's own
                       parameters, exactly as in `Trait::ns.method(...)` */
                    got = arg_count(self->arena, args) - 1;
                    if (self->sup->expr_type(args, rtype, sizeof rtype) != 0)
                        return self->sup->fail("cannot infer the receiver type of a qualified method call");
                    if (self->arena->nodes[args].kind == N_VAR) {
                        int vi = self->sym->find_var(self->arena->nodes[args].text2);
                        if (vi >= 0 && self->sym->vars[vi].is_array
                            && strlen(rtype) + 2 < sizeof rtype)
                            strcat(rtype, " *");
                    }
                    rest = self->arena->nodes[args].next;
                    self->arena->nodes[args].next = -1;
                    mn = self->sup->new_node(N_MCALL);
                    if (mn < 0) return -1;
                    self->arena->nodes[mn].a = args;
                    self->arena->nodes[mn].b = rest;
                    self->arena->nodes[mn].aux = 6;
                    snprintf(self->arena->nodes[mn].text, MAX_TEXT, "%s", rtype);
                    snprintf(self->arena->nodes[mn].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[mn].text3, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    /* The trait's own signature is the judge: `nparams` counts
                       the method's parameters, never the receiver. */
                    {
                        int ti3, mi3;
                        ti3 = self->sym->find_trait(self->arena->nodes[n].text2);
                        if (ti3 >= 0) {
                            for (mi3 = 0; mi3 < self->sym->traits[ti3].nm; mi3++)
                                if (strcmp(self->sym->traits[ti3].m[mi3].name, qc) == 0) break;
                            if (mi3 < self->sym->traits[ti3].nm
                                && self->arity_check(id_line, id_col, qc, got,
                                                     self->sym->traits[ti3].m[mi3].nparams) != 0)
                                return -1;
                        }
                    }
                    return mn;
                }
                if (qf == 2) {
                    if (snprintf(tag, sizeof tag, "%s|%s", tsrc, qv) >= MAX_TEXT)
                        return self->sup->fail("qualified name is too long");
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s",
                             self->arena->nodes[n].text2);
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", qc);
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", tag);
                    self->arena->nodes[n].kind = N_BOX;
                    self->arena->nodes[n].a = -1;
                    self->arena->nodes[n].aux = 4;
                    self->arena->nodes[n].b = -1;
                    return n;
                }
                if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "(") != 0) {
                    if (self->sym->find_qualified_global(qv, self->arena->nodes[n].text2,
                                                         qc, MAX_TEXT) != 0)
                        return self->sup->fail("no variable of that name in that namespace"
                                               " (qualified type names are not supported;"
                                               " use the bare name or an alias import)");
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", qc);
                    return n;
                }
            }
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
                int fi;
                args = self->parse_args();
                if (args < 0) return -1;
                self->sym->errmsg[0] = 0;
                if (qc[0]) fi = self->sym->find_func(qc);
                else fi = self->sym->resolve_func(self->arena->nodes[n].text2);
                if (fi < 0) {
                    const char *why = self->sym->last_error();
                    if (why[0]) return self->sup->fail(why);
                }
                /* `p(args)` on a function-pointer variable: no function of that
                   name exists and the lookup said nothing, so the callee is the
                   variable. Calls through a pointer are emitted uniformly as
                   `(*p)(args)` (D-7). */
                if (fi < 0) {
                    char vt[MAX_TEXT];
                    if (self->sym->var_type(self->arena->nodes[n].text2, vt, sizeof vt) == 0
                        && strstr(vt, "(*"))
                        self->arena->nodes[n].aux = 1;
                }
                /* the call graph keeps the name the source wrote */
                if (fi >= 0 && self->record_call(self->arena->nodes[n].text2, id_line) != 0) return -1;
                /* Phase 21 S4: a closure actual must fill the callee's
                   `(fn, env)` pair; an unresolved callee cannot be verified. */
                if (args > 0
                    && self->closure_arg_check(id_line, id_col, self->arena->nodes[n].text2,
                                               args, fi) != 0)
                    return -1;
                /* 19.1: a resolved signature says how many arguments the callee
                   takes; a variadic tail accepts any surplus past its named
                   parameters. The message keeps the name the source wrote. */
                if (fi >= 0) {
                    int got, want, tail_ok;
                    got = arg_count(self->arena, args) + self->closure_arg_count(args);
                    want = self->sym->funcs[fi].nparams;
                    tail_ok = self->sym->funcs[fi].variadic && got > want;
                    if (!tail_ok && self->arity_check(id_line, id_col, self->arena->nodes[n].text2,
                                                      got, want) != 0)
                        return -1;
                }
                /* 19.2: the argument types against the same signature, before
                   the boxing pass rewrites interface arguments (an interface
                   formal is skipped here, boxing owns it). */
                if (fi >= 0
                    && self->argtype_check(id_line, id_col, self->arena->nodes[n].text2,
                                           args, fi, -1, -1) != 0)
                    return -1;
                /* the emitted call must spell the definition's C name */
                if (fi >= 0)
                    snprintf(self->arena->nodes[n].text2, MAX_TEXT, "%s", self->sym->funcs[fi].cname);
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < self->sym->funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        int ip = 0;
                        if (self->sup->iface_ref_type(self->sym->funcs[fi].ptype[k], tr, sizeof tr, &ip)) {
                            int boxed = self->sup->maybe_box(cur, tr, ip);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else self->arena->nodes[prev].next = boxed;
                                self->arena->nodes[boxed].next = self->arena->nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = self->arena->nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                self->arena->nodes[n].kind = N_CALL;
                self->arena->nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->sym->find_var(self->arena->nodes[n].text2) >= 0) {
                /* a declared variable: a namespaced global is emitted under its
                   mangled C name, which is kept on the node for the emitter; a
                   bare name may not pick between two imported exports */
                char cn[MAX_TEXT];
                const char *nm = self->arena->nodes[n].text2;
                if (self->sym->var_ambiguous(nm)) {
                    char amsg[512];
                    snprintf(amsg, sizeof amsg,
                             "variable '%s' is exported by more than one namespace; use a qualified name", nm);
                    return self->sup->fail(amsg);
                }
                if (self->sym->var_cname(nm, cn, sizeof cn) == 0 && strcmp(cn, nm) != 0)
                    snprintf(self->arena->nodes[n].text3, MAX_TEXT, "%s", cn);
            } else {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps, vf;
                const char *nm = self->arena->nodes[n].text2;
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                /* a bare function name is a value (`p = handler;`): emit the
                   C spelling the definition was given */
                vf = self->sym->resolve_func(nm);
                if (vf >= 0) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", self->sym->funcs[vf].cname);
                    return n;
                }
                /* A name this unit never declared: while a function-pointer
                   value is expected it may come from a C header (`p = strcmp;`),
                   so it is emitted verbatim and the C compiler is the judge.
                   Anywhere else it is a typo, which is reported here. */
                if (self->fnval_ok) {
                    self->arena->nodes[n].kind = N_RAW;
                    snprintf(self->arena->nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                return self->sup->fail("use of an undeclared variable");
            }
            return n;
        }
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0) {
            int save_assign;
            self->sup->lex_next();
            save_assign = self->assign_ok;
            self->assign_ok = 1;
            n = self->parse_expr();
            if (n < 0) return -1;
            /* A parenthesised comma list is a value (`x = (a, b);`,
               `f((a, b))`): both operands evaluate, the value is the last one.
               The node is the one the statement form builds; each operand is a
               full expression, so an assignment may appear on either side. */
            while (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                int r, w;
                self->sup->lex_next();
                r = self->parse_expr();
                if (r < 0) return -1;
                w = self->sup->new_node(N_BIN);
                if (w < 0) return -1;
                self->arena->nodes[w].a = n;
                self->arena->nodes[w].b = r;
                self->arena->nodes[w].aux = B_COMMA;
                n = w;
            }
            self->assign_ok = save_assign;
            if (self->sup->expect(")") != 0) return -1;
            return n;
        }
        return self->sup->fail("expected an expression");
    }

    /* Consume the rest of a `Qual::name` path -- the cursor sits on its first
       '::'. Writes the last segment into `name`, the namespace path in
       underscore form (`a_b`, no trailing separator) into `qpath`, and, when the
       path is followed by `(`, the callee's C spelling into `cname`. The
       qualifier is a namespace path (`runtime::arena`) or a type name (`Arena`),
       whose mangled spelling carries the namespace it belongs to. A path that is
       not followed by `(` names a variable, which the caller resolves.

       `form` tells the caller which of those the path turned out to be:
       0 = a qualified variable (resolve with `find_qualified_global`),
       1 = a qualified call (`cname` holds the callee),
       2 = a namespace-host interface value (`Trait::ns`, SH-20): `name` holds
           the trait's C name, `cname` the host's underscore prefix and `qpath`
           the host's source path, for the emitter's diagnostics. */
    int parse_qual_path(char *name, int ncap, char *cname, int ccap,
                        char *qpath, int qcap, int *form)
    {
        char seg[8][MAX_TEXT];
        char cand[MAX_TEXT];
        char tn[MAX_TEXT];
        char hp[MAX_TEXT];
        int nseg, fi, i, w, is_call;
        size_t us;
        (void)self;

        *form = 0;
        snprintf(seg[0], MAX_TEXT, "%s", name);
        nseg = 1;
        for (;;) {
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "::") != 0)
                return self->sup->fail("expected '::'");
            self->sup->lex_next();
            if (self->lex->tok != T_ID) return self->sup->fail("expected a name after '::'");
            if (nseg >= 8) return self->sup->fail("qualified name is too long");
            snprintf(seg[nseg], MAX_TEXT, "%s", self->lex->toktext);
            nseg++;
            self->sup->lex_next();
            if (self->lex->tok != T_PUNCT || strcmp(self->lex->toktext, "::") != 0) break;
        }
        /* the qualifier: every segment but the last, joined with '_' */
        w = 0;
        qpath[0] = 0;
        for (i = 0; i < nseg - 1; i++) {
            if (i > 0) {
                if (w + 1 >= qcap) return self->sup->fail("qualified name is too long");
                qpath[w] = '_';
                w++;
                qpath[w] = 0;
            }
            if (w + (int)strlen(seg[i]) >= qcap)
                return self->sup->fail("qualified name is too long");
            snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
            w += (int)strlen(seg[i]);
        }
        snprintf(name, (size_t)ncap, "%s", seg[nseg - 1]);
        is_call = (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "(") == 0);
        /* A static trait from a `.m.ct` unit: `host::Trait.method(...)`. The
           qualified C spelling names the trait; the source host path is what
           the emitter matches the map against. A static trait has no iface, so
           only a `.` here is legal. */
        if (!is_call && nseg >= 2 && self->lex->tok == T_PUNCT
            && strcmp(self->lex->toktext, ".") == 0) {
            char tq[MAX_TEXT];
            int st = -1;
            if (snprintf(tq, sizeof tq, "%s_%s", qpath, seg[nseg - 1]) < (int)sizeof tq)
                st = self->sym->find_trait(tq);
            if (st >= 0 && self->sym->traits[st].is_static) {
                int hw = 0;
                qpath[0] = 0;
                for (i = 0; i < nseg - 1; i++) {
                    if (i > 0) {
                        if (hw + 2 >= qcap) return self->sup->fail("qualified name is too long");
                        qpath[hw] = ':';
                        qpath[hw + 1] = ':';
                        hw += 2;
                        qpath[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= qcap)
                        return self->sup->fail("qualified name is too long");
                    snprintf(qpath + hw, (size_t)(qcap - hw), "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                snprintf(name, (size_t)ncap, "%s", self->sym->traits[st].name);
                *form = 3;
                return 0;
            }
        }
        if (is_call) {
            if (snprintf(cand, sizeof cand, "%s_%s", qpath, seg[nseg - 1]) >= (int)sizeof cand)
                return self->sup->fail("qualified name is too long");
            fi = self->sym->find_func(cand);
            if (fi < 0 && nseg == 2) {
                /* a lone segment may be a type: its C name is `<prefix><Type>`, so
                   the namespace prefix is everything up to its last '_' */
                if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0) {
                    us = strlen(tn);
                    while (us > 0 && tn[us - 1] != '_') us--;
                    tn[us] = 0;
                    if (snprintf(cand, sizeof cand, "%s%s", tn, seg[1]) < (int)sizeof cand)
                        fi = self->sym->find_func(cand);
                }
            }
            if (fi < 0) {
                /* P20-01: `Trait::method(recv, ...)` names a static trait
                   explicitly, so two packages may bind the same method to one
                   host type and the caller picks one. The qualifier is joined
                   the way symbol names are (`a::ALen` -> `a_ALen`); the last
                   segment must be a method of that trait, so a namespace
                   function of a similar name is not hijacked. */
                char tq[MAX_TEXT];
                int st = -1;
                if (nseg == 2) {
                    if (self->sym->resolve_type(seg[0], tn, sizeof tn) == 0)
                        st = self->sym->find_trait(tn);
                    if (st < 0) st = self->sym->find_trait(seg[0]);
                } else if (snprintf(tq, sizeof tq, "%s", qpath) < (int)sizeof tq) {
                    st = self->sym->find_trait(tq);
                }
                if (st >= 0 && self->sym->traits[st].is_static) {
                    int mi2, okm = 0;
                    for (mi2 = 0; mi2 < self->sym->traits[st].nm; mi2++)
                        if (strcmp(self->sym->traits[st].m[mi2].name, seg[nseg - 1]) == 0)
                            okm = 1;
                    if (okm) {
                        int hw2 = 0;
                        qpath[0] = 0;
                        for (i = 0; i < nseg - 1; i++) {
                            if (i > 0) {
                                if (hw2 + 2 >= qcap)
                                    return self->sup->fail("qualified name is too long");
                                qpath[hw2] = ':';
                                qpath[hw2 + 1] = ':';
                                hw2 += 2;
                                qpath[hw2] = 0;
                            }
                            if (hw2 + (int)strlen(seg[i]) >= qcap)
                                return self->sup->fail("qualified name is too long");
                            snprintf(qpath + hw2, (size_t)(qcap - hw2), "%s", seg[i]);
                            hw2 += (int)strlen(seg[i]);
                        }
                        snprintf(name, (size_t)ncap, "%s", self->sym->traits[st].name);
                        snprintf(cname, (size_t)ccap, "%s", seg[nseg - 1]);
                        *form = 5;
                        return 0;
                    }
                }
                /* A static namespace-host map may be called without its trait
                   segment: `std::io::puts(...)` names the host by namespace and
                   the method directly. The recipe is the same one
                   `std::io::Io.puts(...)` expands, so the emitter needs no new
                   form; only an ambiguous method name is rejected. */
                char host[MAX_TEXT];
                char only[2][MAX_TEXT];
                int hw = 0, mp, bi, hits = 0;
                host[0] = 0;
                for (i = 0; i < nseg - 1; i++) {
                    if (i > 0) {
                        if (hw + 2 >= (int)sizeof host)
                            return self->sup->fail("qualified name is too long");
                        host[hw] = ':';
                        host[hw + 1] = ':';
                        hw += 2;
                        host[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= (int)sizeof host)
                        return self->sup->fail("qualified name is too long");
                    snprintf(host + hw, sizeof host - (size_t)hw, "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                for (mp = 0; mp < *self->nmaps; mp++) {
                    if (!self->maps[mp].is_static || !self->maps[mp].ns_host)
                        continue;
                    if (strcmp(self->maps[mp].inst, host) != 0) continue;
                    for (bi = 0; bi < self->maps[mp].nb; bi++) {
                        if (strcmp(self->maps[mp].b[bi].method, seg[nseg - 1]) != 0) continue;
                        if (hits < 2)
                            snprintf(only[hits], MAX_TEXT, "%s", self->maps[mp].trait);
                        hits++;
                    }
                }
                if (hits > 1) {
                    char m[MAX_TEXT * 2];
                    snprintf(m, sizeof m, "'%s' is ambiguous on '%s': bound by %s and %s",
                             seg[nseg - 1], host, only[0], only[1]);
                    return self->sup->fail(m);
                }
                if (hits == 1) {
                    snprintf(name, (size_t)ncap, "%s", only[0]);
                    snprintf(cname, (size_t)ccap, "%s", seg[nseg - 1]);
                    snprintf(qpath, (size_t)qcap, "%s", host);
                    *form = 4;
                    return 0;
                }
                return self->sup->fail("no function of that name in that namespace");
            }
            snprintf(cname, (size_t)ccap, "%s", self->sym->funcs[fi].cname);
            *form = 1;
            return 0;
        }
        /* SH-20: `Trait::ns` names a namespace host, not a variable. Only a
           trait qualifier takes this form; a struct or typedef stays a
           (rejected) qualified variable. */
        if (nseg >= 2 && self->sym->resolve_type(seg[0], tn, sizeof tn) == 0
            && self->sym->find_trait(tn) >= 0) {
            /* A static trait has no iface to box, so `Trait::host` is always the
               wrong shape; name the form that works at the site. */
            int st = self->sym->find_trait(tn);
            if (st >= 0 && self->sym->traits[st].is_static) {
                char host[MAX_TEXT];
                char m[MAX_TEXT * 2];
                int hw = 0;
                host[0] = 0;
                for (i = 1; i < nseg; i++) {
                    if (i > 1 && hw + 2 < (int)sizeof host) {
                        host[hw] = ':';
                        host[hw + 1] = ':';
                        hw += 2;
                        host[hw] = 0;
                    }
                    if (hw + (int)strlen(seg[i]) >= (int)sizeof host)
                        return self->sup->fail("qualified name is too long");
                    snprintf(host + hw, sizeof host - (size_t)hw, "%s", seg[i]);
                    hw += (int)strlen(seg[i]);
                }
                snprintf(m, sizeof m,
                         "a static trait has no interface value; call '%s::%s.<method>()'",
                         host, seg[0]);
                return self->sup->fail(m);
            }
            /* the host in underscore form, then the symbol prefix spelled the
               way `map` spells it: a trait that already carries the namespace
               keeps its own name (SH-20 §4) */
            w = 0;
            hp[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 1 >= (int)sizeof hp)
                        return self->sup->fail("qualified name is too long");
                    hp[w] = '_';
                    w++;
                    hp[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= (int)sizeof hp)
                    return self->sup->fail("qualified name is too long");
                snprintf(hp + w, sizeof hp - (size_t)w, "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            if (strncmp(tn, hp, strlen(hp)) == 0 && tn[strlen(hp)] == '_')
                snprintf(cname, (size_t)ccap, "%s", tn);
            else if (snprintf(cname, (size_t)ccap, "%s_%s", hp, tn) >= ccap)
                return self->sup->fail("qualified name is too long");
            /* and the host in source form, for the emitter's diagnostic */
            w = 0;
            qpath[0] = 0;
            for (i = 1; i < nseg; i++) {
                if (i > 1) {
                    if (w + 2 >= qcap) return self->sup->fail("qualified name is too long");
                    qpath[w] = ':';
                    qpath[w + 1] = ':';
                    w += 2;
                    qpath[w] = 0;
                }
                if (w + (int)strlen(seg[i]) >= qcap)
                    return self->sup->fail("qualified name is too long");
                snprintf(qpath + w, (size_t)(qcap - w), "%s", seg[i]);
                w += (int)strlen(seg[i]);
            }
            snprintf(name, (size_t)ncap, "%s", tn);
            *form = 2;
            return 0;
        }
        return 0;
    }

    int parse_args(void)
    {
        int first, tail, e;
        (void)self;

        if (self->sup->expect("(") != 0) return -1;
        if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0) {
            self->sup->lex_next();
            return 0;
        }
        first = -1;
        tail = -1;
        for (;;) {
            e = self->parse_expr();
            if (e < 0) return -1;
            if (tail < 0) first = e;
            else self->arena->nodes[tail].next = e;
            tail = e;
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                self->sup->lex_next();
                continue;
            }
            break;
        }
        if (self->sup->expect(")") != 0) return -1;
        return first;
    }

    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!self->cur_func[0]) return 0;
        if (*self->ncalls >= MAX_CALLS) return self->sup->fail("too many calls");
        snprintf(self->calls[*self->ncalls].caller, MAX_TEXT, "%s", self->cur_func);
        snprintf(self->calls[*self->ncalls].callee, MAX_TEXT, "%s", callee);
        self->calls[*self->ncalls].line = line;
        (*self->ncalls)++;
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Expr g_expr;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls, void *maps, void *nmaps);
void ct_expr_bind(void *arena, void *lex, void *sym, void *sup, void *cur_func, void *calls, void *ncalls, void *maps, void *nmaps)
{
    g_expr.arena = (struct Arena *)arena;
    g_expr.lex = (struct Lexer *)lex;
    g_expr.sym = (struct Symbols *)sym;
    g_expr.sup = (struct ParseSupport *)sup;
    g_expr.cur_func = (char *)cur_func;
    g_expr.calls = (struct Call *)calls;
    g_expr.ncalls = (int *)ncalls;
    g_expr.maps = (struct Map *)maps;
    g_expr.nmaps = (int *)nmaps;
    g_expr.postfix_seed = -1;
}

pub struct Expr *expr_get(void);
struct Expr *expr_get(void)
{
    return &g_expr;
}
