/*
 * MapBuild.h.ct - the `map` construct, one sub-object of the parser.
 *
 * `map trait T for instance x { m() -> CALL; }` takes no expression from the
 * grammar: it validates the binding set against the trait (every method bound
 * exactly once, arity matching) and the RHS call against the names in scope,
 * then records the binding for the emitter. It only reads the token cursor, the
 * parser's shared primitives and the symbol tables, so it is its own object;
 * the parser hands it the unit index and reaches it through `mapbuild_get`.
 *
 * Macros do not cross a unit boundary, so the caps, token kinds and node kind
 * used here are declared here; MAX_TEXT 160, MAX_PARAMS 16 and MAX_METHODS 64
 * are the values `frontend/sym/Symbols.h.ct` lists.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>

import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Map::MapBind as MapBind;
import frontend::module::Map;
import frontend::parse::ParseSupport;
import frontend::sym::Symbols;
import tool::diag::diag;

#define MAX_TEXT   160
#define MAX_PARAMS 16
#define MAX_METHODS 64
#define MAX_MAPS   64

/* token kinds (the scanner only needs these three) */
#define T_EOF    0
#define T_ID     1
#define T_PUNCT  4

/* `parse` returns this when the declaration produced no node. */
#define NO_NODE (-2)

namespace frontend::parse;
pub trait MapBuildOps {
    int  check_call(char *b, const char *inst);
    int  rewrite_globals(char *s);
    int  parse(int unit);
}

/* The tables the mapper fills belong to the parser (they are part of the unit
   record), so this object points at them; `unit` is the index of the unit being
   parsed, handed in by the caller. */
pub struct MapBuild {
    struct Lexer *lex;
    struct ParseSupport *sup;
    struct Symbols *sym;
    struct Map *maps;
    int *nmaps;
} use MapBuildOps;

impl MapBuildOps for MapBuild {
    int check_call(char *b, const char *inst)
    {
        char msg[MAX_TEXT];
        char arg[MAX_TEXT];
        char root[MAX_TEXT];
        const char *p;
        const char *w;
        const char *b4;
        struct MapBind *bb;
        int n, depth, k, ai, ok;
        int rl;
        int q;
        int qq, ci;
        (void)self;

        bb = (struct MapBind *)b;
        p = bb->call;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || *p == '_'))
            return self->sup->fail("a map call must name a function");
        while ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
               || (*p >= '0' && *p <= '9') || *p == '_') p++;
        while (*p == ' ' || *p == '\t') p++;
        if (*p != '(') return self->sup->fail("a map call must be a single call");
        p++;
        for (;;) {
            while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
            if (*p == ')') { p++; break; }
            if (!*p) return self->sup->fail("unterminated map call");
            n = 0;
            depth = 0;
            while (*p) {
                if (depth == 0 && (*p == ',' || *p == ')')) break;
                if (*p == '"' || *p == '\'') {
                    q = *p;
                    if (n + 1 >= MAX_TEXT) return self->sup->fail("a map argument is too long");
                    arg[n] = (char)q; n++; p++;
                    while (*p && *p != (char)q) {
                        if (*p == '\\' && *(p + 1)) {
                            if (n + 2 >= MAX_TEXT) return self->sup->fail("a map argument is too long");
                            arg[n] = *p; n++; p++;
                            arg[n] = *p; n++; p++;
                            continue;
                        }
                        if (n + 1 >= MAX_TEXT) return self->sup->fail("a map argument is too long");
                        arg[n] = *p; n++; p++;
                    }
                    if (*p != (char)q) return self->sup->fail("unterminated literal in a map call");
                    if (n + 1 >= MAX_TEXT) return self->sup->fail("a map argument is too long");
                    arg[n] = *p; n++; p++;
                    continue;
                }
                if (*p == '(') depth++;
                else if (*p == ')') depth--;
                if (n + 1 >= MAX_TEXT) return self->sup->fail("a map argument is too long");
                arg[n] = *p; n++; p++;
            }
            arg[n] = 0;
            while (n > 0 && (arg[n - 1] == ' ' || arg[n - 1] == '\t'
                             || arg[n - 1] == '\n' || arg[n - 1] == '\r')) {
                n--;
                arg[n] = 0;
            }
            ai = 0;
            while (arg[ai] == ' ' || arg[ai] == '\t') ai++;
            /* 2b.2: the argument may be an expression. Every identifier in it
               must resolve - a binding parameter, this map's instance, a
               declared variable, an ALL_CAPS macro constant or a qualified
               name - while literals and member names are skipped. */
            w = arg + ai;
            ok = 1;
            while (*w && ok) {
                if (*w == '"' || *w == '\'') {
                    qq = *w;
                    w++;
                    while (*w && *w != qq) {
                        if (*w == '\\' && *(w + 1)) w++;
                        w++;
                    }
                    if (*w != qq)
                        return self->sup->fail("unterminated literal in a map call");
                    w++;
                    continue;
                }
                /* a numeric literal, including a hex or suffixed spelling */
                if (*w >= '0' && *w <= '9') {
                    while ((*w >= '0' && *w <= '9') || (*w >= 'a' && *w <= 'z')
                           || (*w >= 'A' && *w <= 'Z') || *w == '.')
                        w++;
                    continue;
                }
                if (!((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z') || *w == '_')) {
                    w++;
                    continue;
                }
                /* `x.field` / `x->field`: a field name is not a symbol here */
                b4 = w;
                while (b4 > arg + ai && (*(b4 - 1) == ' ' || *(b4 - 1) == '\t')) b4--;
                if (b4 > arg + ai
                    && (*(b4 - 1) == '.'
                        || (*(b4 - 1) == '>' && b4 - 1 > arg + ai && *(b4 - 2) == '-'))) {
                    while ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                           || (*w >= '0' && *w <= '9') || *w == '_')
                        w++;
                    continue;
                }
                rl = 0;
                while ((*w >= 'a' && *w <= 'z') || (*w >= 'A' && *w <= 'Z')
                       || (*w >= '0' && *w <= '9') || *w == '_') {
                    if (rl + 1 < MAX_TEXT) { root[rl] = *w; rl++; }
                    w++;
                }
                root[rl] = 0;
                if (*w == ':' && *(w + 1) == ':') {
                    /* a qualified name (`A::B::x`): the expression side resolves it */
                    while (*w == ':' || (*w >= 'a' && *w <= 'z')
                           || (*w >= 'A' && *w <= 'Z') || (*w >= '0' && *w <= '9') || *w == '_')
                        w++;
                    continue;
                }
                ok = 0;
                if (strcmp(root, inst) == 0) ok = 1;
                for (k = 0; !ok && k < bb->nparams; k++)
                    if (strcmp(root, bb->params[k]) == 0) ok = 1;
                if (!ok && self->sym->find_var(root) >= 0) ok = 1;
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_TEXT, NULL, ...), accepted verbatim by the expression
                   side too (frontend::parse::Expr). */
                if (!ok) {
                    ci = (root[0] != 0);
                    for (k = 0; root[k]; k++) {
                        char rc = root[k];
                        if (!((rc >= 'A' && rc <= 'Z') || (rc >= '0' && rc <= '9') || rc == '_')) {
                            ci = 0;
                            break;
                        }
                    }
                    if (ci) ok = 1;
                }
            }
            if (!ok) {
                snprintf(msg, sizeof msg, "map argument '%s' is not allowed", arg + ai);
                return self->sup->fail(msg);
            }
            if (*p == ',') { p++; continue; }
            if (*p == ')') continue;
            return self->sup->fail("unterminated map call");
        }
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        if (*p) return self->sup->fail("trailing text after the map call");
        return 0;
    }

    /* The wrapper body is the bound call copied verbatim, so a global it names
       must be spelled the way the declaration was emitted (mangled by its
       namespace). Identifiers after `.` / `->` are member names and literals are
       skipped; everything else is looked up, and an unknown name is left alone
       (it is a C function or macro the `#include` brought in). */
    int rewrite_globals(char *s)
    {
        char out[MAX_TEXT];
        char cn[MAX_TEXT];
        char tok[MAX_TEXT];
        int i, o, k, prev, member, q;
        (void)self;

        i = 0;
        o = 0;
        out[0] = 0;
        while (s[i]) {
            if (s[i] == '"' || s[i] == '\'') {
                q = (unsigned char)s[i];
                if (o + 2 >= MAX_TEXT) return self->sup->fail("the bound call is too long");
                out[o] = s[i];
                o++;
                i++;
                while (s[i]) {
                    if (o + 2 >= MAX_TEXT) return self->sup->fail("the bound call is too long");
                    out[o] = s[i];
                    o++;
                    if (s[i] == '\\' && s[i + 1]) {
                        out[o] = s[i + 1];
                        o++;
                        i += 2;
                        continue;
                    }
                    if ((unsigned char)s[i] == q) { i++; break; }
                    i++;
                }
                out[o] = 0;
                continue;
            }
            if (!((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z') || s[i] == '_')) {
                if (o + 2 >= MAX_TEXT) return self->sup->fail("the bound call is too long");
                out[o] = s[i];
                o++;
                out[o] = 0;
                i++;
                continue;
            }
            prev = o - 1;
            while (prev >= 0 && (out[prev] == ' ' || out[prev] == '\t')) prev--;
            member = 0;
            if (prev >= 0 && out[prev] == '.') member = 1;
            if (prev > 0 && out[prev] == '>' && out[prev - 1] == '-') member = 1;
            k = 0;
            while ((s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z')
                   || (s[i] >= '0' && s[i] <= '9') || s[i] == '_') {
                if (k + 1 < MAX_TEXT) { tok[k] = s[i]; k++; }
                i++;
            }
            tok[k] = 0;
            if (!member && self->sym->var_cname(tok, cn, sizeof cn) == 0) {
                if (o + (int)strlen(cn) + 1 >= MAX_TEXT)
                    return self->sup->fail("the bound call is too long");
                snprintf(out + o, (size_t)(MAX_TEXT - o), "%s", cn);
                o += (int)strlen(cn);
            } else {
                if (o + k + 1 >= MAX_TEXT) return self->sup->fail("the bound call is too long");
                snprintf(out + o, (size_t)(MAX_TEXT - o), "%s", tok);
                o += k;
            }
        }
        snprintf(s, MAX_TEXT, "%s", out);
        return 0;
    }

    int parse(int unit)
    {
        char tname[MAX_TEXT];
        char rtrait[MAX_TEXT];
        char inst[MAX_TEXT];
        char icn[MAX_TEXT];
        char wname[MAX_TEXT];
        char msg[MAX_TEXT];
        struct Map *m;
        struct MapBind *b;
        int line, ti, mi, np, k, i, j, n, q, depth, eof, long_call, c, bound, col, k2, j2, ident;
        (void)self;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        self->sup->lex_next();                       /* consume `map` */
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "trait") == 0))
            return self->sup->fail("expected 'trait'");
        self->sup->lex_next();
        if (self->lex->tok != T_ID) return self->sup->fail("expected a trait name");
        snprintf(tname, sizeof tname, "%s", self->lex->toktext);
        if (self->sup->resolve_type(tname, rtrait, sizeof rtrait) != 0) return -1;
        ti = self->sym->find_trait(rtrait);
        if (ti < 0) return self->sup->fail("map of an unknown trait");
        self->sup->lex_next();
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "for") == 0))
            return self->sup->fail("expected 'for'");
        self->sup->lex_next();
        if (!(self->lex->tok == T_ID && strcmp(self->lex->toktext, "instance") == 0))
            return self->sup->fail("expected 'instance'");
        self->sup->lex_next();
        if (self->lex->tok != T_ID) return self->sup->fail("expected an instance name");
        /* 2b.3: the instance may be spelled namespace-qualified (`hal::uart1`).
           The declared name is the last segment; the C spelling is the one the
           global was emitted under (mangled by its namespace). */
        for (;;) {
            snprintf(inst, sizeof inst, "%s", self->lex->toktext);
            self->sup->lex_next();
            if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "::") == 0) {
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a name after '::'");
                continue;
            }
            break;
        }
        if (self->sym->find_var(inst) < 0) {
            snprintf(msg, sizeof msg, "map instance '%s' is not a declared variable", inst);
            return self->sup->fail(msg);
        }
        if (self->sym->var_cname(inst, icn, sizeof icn) != 0)
            snprintf(icn, sizeof icn, "%s", inst);
        /* One map per (instance, trait), across units: two declarations would
           emit the same wrappers and the same vtable twice. */
        for (k2 = 0; k2 < *self->nmaps; k2++)
            if (strcmp(self->maps[k2].trait, rtrait) == 0 && strcmp(self->maps[k2].inst, inst) == 0) {
                char dmsg[512];
                snprintf(dmsg, sizeof dmsg,
                         "duplicate map of trait '%s' for instance '%s' (first at %s:%d)",
                         tname, inst, self->maps[k2].path, self->maps[k2].line);
                tool::diag::ct_sem_error(line, col, dmsg, self->sup->mem->path);
                if (self->sup->skip_body() != 0) return -1;
                return NO_NODE;
            }
        if (self->sup->expect("{") != 0) return -1;
        if (*self->nmaps >= MAX_MAPS) return self->sup->fail("too many maps");
        m = &self->maps[*self->nmaps];
        snprintf(m->trait, MAX_TEXT, "%s", rtrait);
        snprintf(m->inst, MAX_TEXT, "%s", inst);
        snprintf(m->cname, MAX_TEXT, "%s", icn);
        snprintf(m->vtable, MAX_TEXT, "%s_%s_vtable", icn, rtrait);
        snprintf(m->path, MAX_TEXT, "%s", self->sup->mem->path);
        m->nb = 0;
        m->line = line;
        m->unit = unit;

        while (self->lex->tok != T_EOF && !(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "}") == 0)) {
            if (m->nb >= MAX_METHODS) return self->sup->fail("too many map bindings");
            b = &m->b[m->nb];
            b->line = self->lex->tokline;
            if (self->lex->tok != T_ID) return self->sup->fail("expected a method name");
            snprintf(b->method, MAX_TEXT, "%s", self->lex->toktext);
            mi = -1;
            for (k = 0; k < self->sym->traits[ti].nm; k++)
                if (strcmp(self->sym->traits[ti].m[k].name, b->method) == 0) { mi = k; break; }
            if (mi < 0) {
                snprintf(msg, sizeof msg, "'%s' is not a method of trait '%s'",
                         b->method, rtrait);
                return self->sup->fail(msg);
            }
            self->sup->lex_next();
            if (self->sup->expect("(") != 0) return -1;
            np = 0;
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ")") == 0)) {
                for (;;) {
                    if (self->lex->tok != T_ID) return self->sup->fail("expected a parameter name");
                    if (np >= MAX_PARAMS) return self->sup->fail("too many map parameters");
                    snprintf(b->params[np], MAX_TEXT, "%s", self->lex->toktext);
                    np++;
                    self->sup->lex_next();
                    if (self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, ",") == 0) {
                        self->sup->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->sup->expect(")") != 0) return -1;
            b->nparams = np;
            if (np != self->sym->traits[ti].m[mi].nparams) {
                snprintf(msg, sizeof msg,
                         "map binding for '%s' takes %d parameter(s), the trait declares %d",
                         b->method, np, self->sym->traits[ti].m[mi].nparams);
                return self->sup->fail(msg);
            }
            if (!(self->lex->tok == T_PUNCT && strcmp(self->lex->toktext, "->") == 0))
                return self->sup->fail("expected '->'");
            /* Capture the RHS verbatim from self->lex->pos: no lex_next has run since the
               '->' token, so self->lex->pos sits just past it (the parse_init_raw trick). */
            i = self->lex->pos;
            n = 0;
            q = 0;
            depth = 0;
            eof = 0;
            long_call = 0;
            while (self->lex->src[i] == ' ' || self->lex->src[i] == '\t'
                   || self->lex->src[i] == '\n' || self->lex->src[i] == '\r') i++;
            for (;;) {
                c = (unsigned char)self->lex->src[i];
                if (c == 0) { eof = 1; break; }
                if (q == 0 && depth == 0 && c == ';') break;
                if (n + 1 >= MAX_TEXT) { long_call = 1; break; }
                if (q == 0 && (c == '"' || c == '\'')) {
                    q = c;
                } else if (q != 0 && c == q) {
                    q = 0;
                } else if (q != 0 && c == '\\' && self->lex->src[i + 1]) {
                    b->call[n] = (char)c; n++; i++;
                    c = (unsigned char)self->lex->src[i];
                } else if (q == 0 && c == '(') {
                    depth++;
                } else if (q == 0 && c == ')') {
                    depth--;
                }
                b->call[n] = (char)c; n++; i++;
            }
            if (eof) return self->sup->fail("unterminated map call");
            if (long_call) return self->sup->fail("map call is too long");
            while (n > 0 && (b->call[n - 1] == ' ' || b->call[n - 1] == '\t'
                             || b->call[n - 1] == '\n' || b->call[n - 1] == '\r')) n--;
            b->call[n] = 0;
            self->lex->pos = i;
            self->sup->lex_next();
            /* `-> f` with a bare name binds the C function itself: no wrapper is
               generated, so the target's first parameter must already be
               `void *` (the slot type). Its prototype may come from an
               `#include`, so ct does not look it up or check the signature. */
            b->direct = 0;
            ident = (b->call[0] != 0) && !(b->call[0] >= '0' && b->call[0] <= '9');
            for (j2 = 0; ident && b->call[j2]; j2++) {
                char cc = b->call[j2];
                if (!((cc >= 'a' && cc <= 'z') || (cc >= 'A' && cc <= 'Z')
                      || (cc >= '0' && cc <= '9') || cc == '_'))
                    ident = 0;
            }
            if (ident) b->direct = 1;
            if (!b->direct && self->check_call((char *)b, inst) != 0) return -1;
            if (!b->direct && self->rewrite_globals(b->call) != 0) return -1;
            if (self->sup->expect(";") != 0) return -1;
            /* `wrapper` and `method` are sibling arrays of the same struct, so
               GCC's -Wrestrict cannot prove they miss each other; build the
               name aside and copy it in. */
            snprintf(wname, sizeof wname, "%s_%s_%s", icn, rtrait, b->method);
            snprintf(b->wrapper, MAX_TEXT, "%s", wname);
            b->ti = ti;
            b->mi = mi;
            m->nb++;
        }
        if (self->sup->expect("}") != 0) return -1;
        /* A map must bind every trait method exactly once: an unbound slot stays
           a null pointer (calling it crashes at run time), and a duplicate
           binding would emit the wrapper function twice (a C redefinition). */
        for (i = 0; i < m->nb; i++) {
            for (j = i + 1; j < m->nb; j++)
                if (strcmp(m->b[i].method, m->b[j].method) == 0) {
                    snprintf(msg, sizeof msg, "duplicate binding for method '%s'",
                             m->b[i].method);
                    return self->sup->fail(msg);
                }
        }
        for (k = 0; k < self->sym->traits[ti].nm; k++) {
            bound = 0;
            for (i = 0; i < m->nb; i++)
                if (strcmp(m->b[i].method, self->sym->traits[ti].m[k].name) == 0) {
                    bound = 1;
                    break;
                }
            if (!bound) {
                snprintf(msg, sizeof msg, "trait method '%s' is not bound by the map",
                         self->sym->traits[ti].m[k].name);
                return self->sup->fail(msg);
            }
        }
        (*self->nmaps)++;
        return NO_NODE;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct MapBuild g_mapbuild;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_mapbuild_bind(void *lex, void *sup, void *sym, void *maps, int *nmaps);
void ct_mapbuild_bind(void *lex, void *sup, void *sym, void *maps, int *nmaps)
{
    g_mapbuild.lex = (struct Lexer *)lex;
    g_mapbuild.sup = (struct ParseSupport *)sup;
    g_mapbuild.sym = (struct Symbols *)sym;
    g_mapbuild.maps = (struct Map *)maps;
    g_mapbuild.nmaps = nmaps;
}

pub struct MapBuild *mapbuild_get(void);
struct MapBuild *mapbuild_get(void)
{
    return &g_mapbuild;
}
