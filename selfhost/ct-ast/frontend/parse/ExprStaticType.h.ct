#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprStaticType {
    int unused;
}

pub int expr_generic_token(struct Expr *self)
{
    int i;
    if (!self->in_generic_tparam) return 0;
    for (i = 0; i < self->in_generic_ntparam; i++)
        if (self->in_generic_tparam[i] && self->in_generic_tparam[i][0]
            && self->lex->tok_is(self->in_generic_tparam[i]))
            return 1;
    return 0;
}

/* S1a-0 C2p-10: the static-type chain returns pool texts. Each helper used to
   write into a caller row of `MAX_TEXT`; a 2000-byte struct spelling was cut at
   159 bytes and the row was then looked up (or compared) under the cut name.
   The text form never truncates: the only bound is the pool's `TEXT_LIMIT`,
   and NULL is the one "this shape cannot be pinned" answer. */
/* PH-87 S87a slice: `ADTCTOR` (static C type). */
pub const char *ctype_adtctor(struct Expr *self, int n, int *array_depth, int depth)
{
    (void)array_depth;
    (void)depth;
    /* Phase 84: a constructor's value has the ADT's C struct spelling;
       `text` is the struct tag the registry holds. */
    return runtime::text::ct_internf("struct %s", self->arena->nodes[n].text);
}

/* PH-87 S87a slice: `VAR` (static C type). */
pub const char *ctype_var(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *ty;
    const char *dim;
    int i;
    (void)depth;
    i = self->sym->find_var(self->arena->nodes[n].text2);
    if (i < 0) return (const char *)0;
    ty = self->ctype_expand_text(self->sym->vars[i].type, 0);
    if (!ty) return (const char *)0;
    if (self->sym->vars[i].is_array) {
        for (dim = self->sym->vars[i].dims; *dim; dim++)
            if (*dim == '[') (*array_depth)++;
    }
    return ty;
}

/* PH-87 S87a slice: `TRY` (static C type). */
pub const char *ctype_try(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *tmp;
    const char *qtag;
    const char *qval;
    const char *qerr;
    int ad;
    (void)array_depth;
    /* Phase 44: `expr?` answers the operand's `value` type, so a chained form
       (`f()?.x`) resolves the same spelling the operand's payload has. The
       operand itself has to be a `Result<T, E>`. */
    tmp = self->static_ctype_text(self->arena->nodes[n].a, &ad, depth + 1);
    if (!tmp || ad != 0) return (const char *)0;
    qtag = self->result_tag_text(tmp);
    if (!qtag) return (const char *)0;
    qval = self->result_cols_text(frontend::sym::ct_inst_find(qtag), &qerr);
    if (!qval) return (const char *)0;
    return qval;
}

/* PH-87 S87a slice: `INDEX` (static C type). */
pub const char *ctype_index(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *tmp;
    int ad;
    tmp = self->static_ctype_text(self->arena->nodes[n].a, &ad, depth + 1);
    if (!tmp) return (const char *)0;
    if (ad > 0) {
        /* one array dimension: the spelling is already the element */
        *array_depth = ad - 1;
        return tmp;
    }
    return self->peel_ptr_text(tmp);
}

/* PH-87 S87a slice: `DEREF` (static C type). */
pub const char *ctype_deref(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *tmp;
    int ad;
    tmp = self->static_ctype_text(self->arena->nodes[n].a, &ad, depth + 1);
    if (!tmp) return (const char *)0;
    if (ad > 0) {
        *array_depth = ad - 1;
        return tmp;
    }
    return self->peel_ptr_text(tmp);
}

/* PH-87 S87a slice: `ADDR` (static C type). */
pub const char *ctype_addr(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *tmp;
    int ad;
    (void)array_depth;
    tmp = self->static_ctype_text(self->arena->nodes[n].a, &ad, depth + 1);
    if (!tmp || ad != 0) return (const char *)0;
    if (!tmp[0]) return (const char *)0;
    return runtime::text::ct_internf("%s%s*", tmp,
                                     tmp[strlen(tmp) - 1] == '*' ? "" : " ");
}

/* PH-87 S87a slice: `MEMBER` (static C type). */
pub const char *ctype_member_or_arrow(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *tmp;
    const char *ty;
    const char *f;
    int i;
    int si;
    int ad;
    /* PH-80 (D-013 §2): the synthesised `.data` view keeps the handle's
       raw pointer but reports a read-only static type, so no `char *`
       consumer can take it without a cast. `aux` 9 is the UTF-8 pair,
       11 the UTF-16 pair (see the member-access synthesis). */
    if (self->arena->nodes[n].aux == 9) {
        *array_depth = 0;
        return runtime::text::ct_intern("const char *");
    }
    if (self->arena->nodes[n].aux == 11) {
        *array_depth = 0;
        return runtime::text::ct_intern("const uint16_t *");
    }
    tmp = self->static_ctype_text(self->arena->nodes[n].a, &ad, depth + 1);
    if (!tmp || ad != 0) return (const char *)0;
    if (self->arena->nodes[n].kind == N_ARROW) {
        /* `->` walks through exactly one pointer */
        tmp = self->peel_ptr_text(tmp);
        if (!tmp) return (const char *)0;
    }
    ty = tmp;
    if (strncmp(ty, "struct ", 7) == 0) ty += 7;
    si = self->sym->find_struct(ty);
    if (si < 0) return (const char *)0;
    for (i = 0; i < self->sym->structs[si].nfields; i++) {
        if (strcmp(self->sym->structs[si].fields[i].name,
                   self->arena->nodes[n].text2) != 0) continue;
        f = self->ctype_expand_text(self->sym->structs[si].fields[i].type, 0);
        if (!f) return (const char *)0;
        for (ty = self->sym->structs[si].fields[i].dims; *ty; ty++)
            if (*ty == '[') (*array_depth)++;
        return f;
    }
    return (const char *)0;
}

/* PH-87 S87a slice: `CALL` (static C type). */
pub const char *ctype_call(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *tmp;
    const char *r;
    int i;
    int ad;
    (void)array_depth;
    if (self->arena->nodes[n].aux == 2) {
        /* `(*fp)()` / `o.f()`: the callee is an expression whose
           declared type is the function pointer. */
        int ci = self->arena->nodes[n].b;
        if (ci >= 0 && self->arena->nodes[ci].kind == N_DEREF) {
            int ad2;
            tmp = self->static_ctype_text(self->arena->nodes[ci].a, &ad2, depth + 1);
            if (!tmp || ad2 != 0) return (const char *)0;
            r = self->fnptr_ret_text(tmp);
            if (r) return r;
            tmp = self->peel_ptr_text(tmp);
            if (!tmp) return (const char *)0;
            return self->fnptr_ret_text(tmp);
        }
        tmp = self->static_ctype_text(ci, &ad, depth + 1);
        if (!tmp || ad != 0) return (const char *)0;
        return self->fnptr_ret_text(tmp);
    }
    i = self->sym->resolve_func(self->arena->nodes[n].text2);
    if (i >= 0) {
        if (!self->sym->funcs[i].ret[0] || strcmp(self->sym->funcs[i].ret, "void") == 0)
            return (const char *)0;
        return self->ctype_expand_text(self->sym->funcs[i].ret, 0);
    }
    /* `fp()` on a function-pointer variable (a plain name). */
    i = self->sym->find_var(self->arena->nodes[n].text2);
    if (i < 0) return (const char *)0;
    tmp = self->ctype_expand_text(self->sym->vars[i].type, 0);
    if (!tmp) return (const char *)0;
    return self->fnptr_ret_text(tmp);
}

/* PH-87 S87a slice: `OPT` (static C type). */
pub const char *ctype_opt(struct Expr *self, int n, int *array_depth, int depth)
{
    (void)array_depth;
    (void)depth;
    /* PH-53: the optional result is recorded at parse time (the
       emitter and chained `?.` both need it). */
    if (!self->arena->nodes[n].text2[0]) return (const char *)0;
    return self->arena->nodes[n].text2;
}

/* PH-87 S87a slice: `MCALL` (static C type). */
pub const char *ctype_mcall(struct Expr *self, int n, int *array_depth, int depth)
{
    const char *ib;
    const char *rs;
    int si;
    int i;
    (void)array_depth;
    (void)depth;
    /* An inherent method of an instantiated struct keeps its AST node
       (`text` is the declared return type); a trait method reads the
       signature. */
    if (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
        i = self->inst_inherent_method(self->arena->nodes[n].text,
                                       self->arena->nodes[n].text2);
    else
        i = -1;
    if (i >= 0) {
        if (!self->arena->nodes[i].text[0]) return (const char *)0;
        /* Phase 31 O3: the declared return type mentions the
           template's parameter (`T get(int i)`), so a chained subscript
           (`g[i][j]`) only sees `struct Vec_int` when the parameter is
           replaced by this instance's concrete argument. */
        ib = self->arena->nodes[n].text;
        if (ib[0] && strncmp(ib, "struct ", 7) != 0) {
            ib = runtime::text::ct_internf("struct %s", ib);
            if (!ib) return (const char *)0;
        }
        rs = self->inst_subst_type_text(ib, self->arena->nodes[i].text);
        if (rs) return rs;
        return self->ctype_expand_text(self->arena->nodes[i].text, 0);
    }
    si = self->sym->find_trait(self->arena->nodes[n].text);
    if (si < 0) return (const char *)0;
    for (i = 0; i < self->sym->traits[si].nm; i++) {
        if (strcmp(self->sym->traits[si].m[i].name,
                   self->arena->nodes[n].text2) != 0) continue;
        if (!self->sym->traits[si].m[i].ret[0]
            || strcmp(self->sym->traits[si].m[i].ret, "void") == 0) return (const char *)0;
        return self->ctype_expand_text(self->sym->traits[si].m[i].ret, 0);
    }
    return (const char *)0;
    /* PH-79 fix SH-100: the element spelling travels on the node, so the
       value/pointer/storage types are all recoverable. `s[i]` is the
       element value, `s.get(i)` its pointer, and a subslice (including
       the whole-array view aux 3) the erased slice struct. */
}

/* PH-87 S87a slice: `SLICE_INDEX` (static C type). */
pub const char *ctype_slice_index(struct Expr *self, int n, int *array_depth, int depth)
{
    (void)array_depth;
    (void)depth;
    if (!self->arena->nodes[n].text[0]) return (const char *)0;
    return self->arena->nodes[n].text;
}

/* PH-87 S87a slice: `SLICE_GET` (static C type). */
pub const char *ctype_slice_get(struct Expr *self, int n, int *array_depth, int depth)
{
    (void)array_depth;
    (void)depth;
    if (!self->arena->nodes[n].text[0]) return (const char *)0;
    return runtime::text::ct_internf("%s *", self->arena->nodes[n].text);
}

/* PH-87 S87a slice: `SLICE_RANGE` (static C type). */
pub const char *ctype_slice_range(struct Expr *self, int n, int *array_depth, int depth)
{
    (void)self;
    (void)n;
    (void)array_depth;
    (void)depth;
    return runtime::text::ct_intern("struct __ct_slice");
}


/* D-029: split the abstract function-pointer spelling `R (*)(A, B)` into its
   return type and parenthesised parameter list. Only one non-nested abstract
   declarator is accepted; anything else answers 0 and the checker stays
   silent. */
static int fnptr_sig_parts(const char *t, const char **ret, const char **params)
{
    const char *p;
    const char *q;
    const char *lp;
    int len, depth;

    if (!t) return 0;
    p = strstr(t, "(*)");
    if (!p || p == t) return 0;
    len = (int)(p - t);
    while (len > 0 && (t[len - 1] == ' ' || t[len - 1] == '\t')) len--;
    if (len <= 0) return 0;
    q = p + 3;
    while (*q == ' ' || *q == '\t') q++;
    if (*q != '(') return 0;
    lp = q;
    depth = 0;
    for (; *q; q++) {
        if (*q == '(') depth++;
        else if (*q == ')') {
            depth--;
            if (depth == 0) break;
        }
    }
    if (depth != 0) return 0;
    *ret = runtime::text::ct_intern_len(t, len);
    *params = runtime::text::ct_intern_len(lp + 1, (int)(q - lp - 1));
    if (!*ret || !*params) return 0;
    return 1;
}

/* D-029: `(void)` / `()` count as zero parameters; otherwise a list splits on
   top-level commas so a nested aggregate spelling stays one row. */
static int fnptr_param_count(const char *ps)
{
    const char *p;
    int n, depth, seen;

    if (!ps || !ps[0]) return 0;
    p = ps;
    while (*p == ' ' || *p == '\t') p++;
    if (strcmp(p, "void") == 0) return 0;
    n = 1; depth = 0; seen = 0;
    for (; *p; p++) {
        if (*p == '(' || *p == '[' || *p == '<') depth++;
        else if (*p == ')' || *p == ']' || *p == '>') depth--;
        else if (*p == ',' && depth == 0) n++;
        if (*p != ' ' && *p != '\t') seen = 1;
    }
    return seen ? n : 0;
}

impl ExprStaticType for Expr {
    int parse_array_dims(int n)
    {
        int warned = 0;
        int ndims = 0;
        (void)self;
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("[")) {
            const char *dim;
            const char *cur;
            int unsized, open, raw, dline, dcol, first_dim;
            unsized = 0;
            raw = 0;
            /* SH-108: only a single empty dimension is the deprecated `T a[]`
               slice spelling. `char x[][MAX]` already carries a dimension on
               its element type, so its first `[]` is ordinary C. */
            first_dim = (ndims == 0);
            ndims++;
            open = self->lex->tokstart;             /* the `[` itself */
            dline = self->lex->tokline;
            dcol = self->lex->tokstart - self->lex->lstart + 1;
            dim = "";
            /* SH-66: a dimension is copied verbatim and is not one of the
               seven positions `ct_generic_subst` rewrites, so a type parameter
               inside it would reach the generated C as an undeclared name.
               §4.48 promises a hard error here instead of a silent product;
               the scan runs at the `[` so the diagnostic points at the
               dimension rather than the token after it. */
            if (self->in_generic_ntparam > 0) {
                int p = open + 1;
                int depth = 0;
                while (self->lex->src[p]) {
                    char ch = self->lex->src[p];
                    int id0 = (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')
                              || ch == '_';
                    if (id0) {
                        int q = p + 1;
                        int gpi, hit = 0;
                        const char *hitn = 0;
                        while (self->lex->src[q]) {
                            char c2 = self->lex->src[q];
                            if (!((c2 >= 'A' && c2 <= 'Z') || (c2 >= 'a' && c2 <= 'z')
                                  || (c2 >= '0' && c2 <= '9') || c2 == '_'))
                                break;
                            q++;
                        }
                        for (gpi = 0; gpi < self->in_generic_ntparam; gpi++) {
                            const char *gpn = self->in_generic_tparam[gpi];
                            int tlen;
                            if (!gpn || !gpn[0]) continue;
                            tlen = (int)strlen(gpn);
                            if (q - p == tlen
                                && strncmp(self->lex->src + p, gpn, (size_t)tlen) == 0) {
                                hit = 1;
                                hitn = gpn;
                                break;
                            }
                        }
                        if (hit)
                            return self->sup->fail(tool::sh::ct_scratch_fmt(
                                "type parameter '%s' cannot be used in an array dimension",
                                hitn));
                        p = q;
                    } else if (ch == '/' && self->lex->src[p + 1] == '*') {
                        /* a block comment is not code: a dimension may carry
                           one, so skip it before tokenising the text */
                        p += 2;
                        while (self->lex->src[p]
                               && !(self->lex->src[p] == '*'
                                    && self->lex->src[p + 1] == '/'))
                            p++;
                        if (self->lex->src[p]) p += 2;
                    } else if (ch == '[') {
                        depth++;
                        p++;
                    } else if (ch == ']') {
                        if (depth == 0) break;
                        depth--;
                        p++;
                    } else {
                        p++;
                    }
                }
            }
            self->sup->lex_next();
            if (self->lex->tok == T_NUM) {
                dim = runtime::text::ct_internf("[%ld]", self->lex->toknum);
            } else if (self->lex->tok == T_ID) {
                /* a constant (an enum member) is emitted under its C name; an
                   undeclared macro name stays as written (D-9) */
                const char *tok = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                              self->lex->tokstr.len);
                const char *cn = tok ? self->sym->var_cname_text(tok) : (const char *)0;
                if (cn)
                    dim = runtime::text::ct_internf("[%s]", cn);
                else
                    dim = runtime::text::ct_internf("[%.*s]", self->lex->tokstr.len,
                                                    self->lex->tokstr.ptr);
            } else if (self->lex->tok == T_PUNCT && self->lex->tok_is("]")) {
                /* `T a[][N]`: an unsized parameter dimension (10.6) */
                dim = "[]";
                unsized = 1;
            } else {
                raw = 1;
            }
            if (!unsized && !raw) {
                self->sup->lex_next();
                /* more than one token inside the brackets (`[MAX_NAME * 2]`):
                   the expression is kept as written */
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("]"))) {
                    raw = 1;
                    dim = "";
                }
            }
            if (raw) {
                /* the source text between the brackets (both included) is
                   interned whole, then the lexer re-reads from just past the
                   closing one; the old copy stopped at 160 bytes */
                int p2, d2;
                p2 = open + 1;
                d2 = 0;
                while (self->lex->src[p2]) {
                    char ch = self->lex->src[p2];
                    if (ch == '[') d2++;
                    else if (ch == ']') {
                        if (d2 == 0) break;
                        d2--;
                    }
                    p2++;
                }
                if (self->lex->src[p2] != ']') return self->sup->fail("expected an array length");
                dim = runtime::text::ct_intern_len(self->lex->src + open, p2 - open + 1);
                if (!dim) return self->sup->fail("out of memory");
                self->lex->pos = p2 + 1;
                self->sup->lex_next();
            } else if (self->sup->expect("]") != 0) {
                return -1;
            }
            if (!dim) return self->sup->fail("out of memory");
            cur = runtime::text::ct_intern_join(self->arena->nodes[n].text3, dim);
            self->arena->nodes[n].text3 = cur;
            if (!self->arena->nodes[n].text3) return self->sup->fail("out of memory");
            self->arena->nodes[n].num = 0;      /* text3 is the authoritative spelling */
            /* E79-1: `T a[]` is the old spelling. With an initializer it is an
               inferred-length array and stays; a parameter, field or
               uninitialised declaration is deprecated in favour of `T[]`.
               SH-108: a multi-dimensional declarator (`T a[][N]`, `T a[N][]`)
               is not this spelling -- the empty dimension belongs to an
               element type that already has dimensions, or is a later
               dimension. Only a lone empty `[]` warns. */
            if (unsized && !warned && first_dim
                && !(self->lex->tok == T_PUNCT
                     && (self->lex->tok_is("[") || self->lex->tok_is("=")))) {
                warned = 1;
                if (tool::diag::ct_slice_warn(dline, dcol,
                        "'T a[]' is deprecated; write 'T[]' for a slice or 'T a[N]' for an array",
                        self->sup->mem->path) != 0)
                    return -1;
            }
        }
        return 0;
    }

    int tok_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res, save_start, save_lstart;
        long save_num;
        size_t save_pos;
        const char *save_text_ptr; int save_text_len;
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        save_start = self->lex->tokstart;
        save_lstart = self->lex->lstart;
        save_text_ptr = self->lex->tokstr.ptr; save_text_len = self->lex->tokstr.len;
        res = 0;
        if (self->lex->tok == T_ID) {
            const char *rtn;
            /* DOC-87 Stage 2: `core::Vec v;` in a statement position. The
               declaration lookahead reads one name, so walk an `ns::` prefix to
               the final segment; the lexer state is restored below. */
            {
                const char *qp = self->lex->src + self->lex->tokstart
                                 + self->lex->tokstr.len;
                while (*qp == ' ' || *qp == '\t') qp++;
                if (qp[0] == ':' && qp[1] == ':') {
                    for (;;) {
                        const char *nq;
                        self->sup->lex_next();       /* `::` */
                        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("::"))) break;
                        self->sup->lex_next();       /* the segment */
                        if (self->lex->tok != T_ID) break;
                        nq = self->lex->src + self->lex->tokstart + self->lex->tokstr.len;
                        while (*nq == ' ' || *nq == '\t') nq++;
                        if (!(nq[0] == ':' && nq[1] == ':')) break;
                    }
                }
            }
            /* P-7.2 / LANG-24: `Box<T>` (and the deprecated `box<T>` alias)
               is a type in every type position (`sizeof(Box<T>)`, a cast, a
               field). Recognise only a balanced `<...>` after the name, so
               `Box < 3` / `box < 3` stay comparisons. */
            if ((self->lex->tok_is("Box") || self->lex->tok_is("box"))
                && frontend::sym::ct_tmpl_find("Box", self->cur_unit) >= 0) {
                size_t p2 = self->lex->pos;
                int d2 = 0;
                int closed = 0;
                while (self->lex->src[p2] == ' ' || self->lex->src[p2] == '\t') p2++;
                if (self->lex->src[p2] == '<') {
                    p2++;
                    while (self->lex->src[p2] && self->lex->src[p2] != '\n') {
                        if (self->lex->src[p2] == '<') d2++;
                        else if (self->lex->src[p2] == '>') {
                            if (d2 == 0) { p2++; closed = 1; break; }
                            d2--;
                        }
                        p2++;
                    }
                }
                if (closed) res = 1;
            } else
            /* `T` inside its own template body is a type, even though the
               ALL_CAPS rule below would read it as a macro constant. */
            if (self->in_generic && expr_generic_token(self)) {
                res = 1;
            } else
            /* `_Atomic(type)` is a type on its own: the word is a keyword, so
               the balanced list (and optional stars) is all that stands between
               it and the cast's closing parenthesis. */
            if (self->lex->tok_is("_Atomic")) {
                int d = 0;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) {
                    for (;;) {
                        if (self->lex->tok == T_EOF) break;
                        if (self->lex->tok == T_PUNCT && self->lex->tok_is("(")) d++;
                        if (self->lex->tok == T_PUNCT && self->lex->tok_is(")")) {
                            d--;
                            if (d == 0) {
                                self->sup->lex_next();
                                break;
                            }
                        }
                        self->sup->lex_next();
                    }
                    while (self->lex->tok == T_PUNCT && self->lex->tok_is("*"))
                        self->sup->lex_next();
                    res = (self->lex->tok == T_PUNCT && self->lex->tok_is(")"));
                }
            } else
            /* resolve first: an imported name is a type even though the table
               only holds its mangled spelling */
            if (self->is_type_word(self->lex->tok_cstr())) {
                res = 1;
            } else if ((rtn = self->sym->resolve_type_text(runtime::text::ct_intern_len(self->lex->tokstr.ptr, self->lex->tokstr.len))) != 0
                       && self->sym->find_type(rtn) >= 0) {
                res = 1;
            } else {
                /* A type name only a header declares (`time_t`), used in a cast
                   or `sizeof`. A declared variable or function is an operand,
                   and an ALL_CAPS name is a macro constant by the same rule
                   `parse_primary` applies, so `(MAX) + 1` keeps reading as an
                   expression. A cast's type also has to close the parenthesis
                   (`(time_t)`, `(time_t *)`); `(f(x))` is a call in parentheses,
                   which is what an undeclared library name looks like. */
                int i, caps;
                caps = (self->lex->tok_first() != 0);
                for (i = 0; i < self->lex->tokstr.len; i++) {
                    char cc = self->lex->tokstr.ptr[i];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        caps = 0;
                        break;
                    }
                }
                if (!caps && self->sym->find_var(self->lex->tok_cstr()) < 0
                    && self->sym->find_func(self->lex->tok_cstr()) < 0) {
                    self->sup->lex_next();
                    while (self->lex->tok == T_PUNCT && self->lex->tok_is("*"))
                        self->sup->lex_next();
                    res = (self->lex->tok == T_PUNCT && self->lex->tok_is(")"));
                }
            }
        }
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        self->lex->tokstart = save_start;
        self->lex->lstart = save_lstart;
        self->lex->tokstr.ptr = save_text_ptr; self->lex->tokstr.len = save_text_len;
        return res;
    }

    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res, save_start, save_lstart;
        long save_num;
        size_t save_pos;
        const char *save_text_ptr; int save_text_len;
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        save_start = self->lex->tokstart;
        save_lstart = self->lex->lstart;
        save_text_ptr = self->lex->tokstr.ptr; save_text_len = self->lex->tokstr.len;
        self->sup->lex_next();
        res = self->tok_is_type_name();
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        self->lex->tokstart = save_start;
        self->lex->lstart = save_lstart;
        self->lex->tokstr.ptr = save_text_ptr; self->lex->tokstr.len = save_text_len;
        return res;
    }

    int offsetof_ahead(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        const char *save_text_ptr; int save_text_len;
        (void)self;
        save_tok = self->lex->tok;
        save_num = self->lex->toknum;
        save_line = self->lex->tokline;
        save_pos = self->lex->pos;
        save_srcline = self->lex->line;
        save_bol = self->lex->bol;
        save_text_ptr = self->lex->tokstr.ptr; save_text_len = self->lex->tokstr.len;
        self->sup->lex_next();
        res = (self->lex->tok == T_PUNCT && self->lex->tok_is("("));
        self->lex->tok = save_tok;
        self->lex->toknum = save_num;
        self->lex->tokline = save_line;
        self->lex->pos = save_pos;
        self->lex->line = save_srcline;
        self->lex->bol = save_bol;
        self->lex->tokstr.ptr = save_text_ptr; self->lex->tokstr.len = save_text_len;
        return res;
    }

    int fnptr_field(const char *stype, const char *field)
    {
        const char *base;
        size_t n;
        int s, fi, ti;
        (void)self;

        base = stype;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) n--;
        if (n == 0) return 0;
        base = runtime::text::ct_intern_len(base, (int)n);
        if (!base) return 0;
        s = self->sym->find_struct(base);
        if (s < 0) return 0;
        for (fi = 0; fi < self->sym->structs[s].nfields; fi++) {
            if (strcmp(self->sym->structs[s].fields[fi].name, field) != 0) continue;
            if (strstr(self->sym->structs[s].fields[fi].type, "(*")) return 1;
            ti = self->sym->find_type(self->sym->structs[s].fields[fi].type);
            return (ti >= 0 && self->sym->type_kind[ti] == 4);
        }
        return 0;
    }

    int const_ok(int n)
    {
        int k;
        (void)self;

        if (n < 0) return 0;
        k = self->arena->nodes[n].kind;
        if (k == N_NUM || k == N_RAW || k == N_SIZEOF || k == N_OFFSETOF) return 1;
        if (k == N_STR) {
            /* a character literal keeps its quotes in the pool; a string does
               not form an integer constant */
            return self->arena->str_at((int)self->arena->nodes[n].num)[0] == '\'';
        }
        if (k == N_VAR) return self->sym->is_const_name(self->arena->nodes[n].text2);
        if (k == N_UNARY)
            return (self->arena->nodes[n].aux == U_NEG || self->arena->nodes[n].aux == U_NOT
                    || self->arena->nodes[n].aux == U_BNOT)
                && self->const_ok(self->arena->nodes[n].a);
        if (k == N_BIN)
            return self->const_ok(self->arena->nodes[n].a) && self->const_ok(self->arena->nodes[n].b);
        return 0;
    }

    const char *ctype_expand_text(const char *in, int depth)
    {
        const char *name;
        const char *target;
        int i, len, bare;

        if (depth > 8) return (const char *)0;
        len = (int)strlen(in);
        while (len > 0 && in[len - 1] == ' ') len--;
        i = 0;
        while (i < len && in[i] == ' ') i++;
        if (i >= len) return (const char *)0;
        name = runtime::text::ct_intern_len(in + i, len - i);
        if (!name) return (const char *)0;
        bare = 1;
        for (i = 0; name[i]; i++) {
            int c = (unsigned char)name[i];
            if (i == 0) {
                if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_')) {
                    bare = 0;
                    break;
                }
            } else if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
                         || (c >= '0' && c <= '9') || c == '_')) {
                bare = 0;
                break;
            }
        }
        if (bare && (target = self->sym->type_target_text(name)) != 0)
            return self->ctype_expand_text(target, depth + 1);
        return name;
    }

    int ctype_expand(const char *in, char *out, int cap, int depth)
    {
        const char *t = self->ctype_expand_text(in, depth);

        if (!t) return 0;
        if (snprintf(out, (size_t)cap, "%s", t) >= cap) return 0;
        return 1;
    }

    const char *fnptr_ret_text(const char *ftype)
    {
        const char *p, *q;
        int len, depth;

        (void)self;
        p = strstr(ftype, "(*)");
        if (!p || p == ftype) return (const char *)0;
        q = p + 3;
        while (*q == ' ') q++;
        if (*q != '(') return (const char *)0;
        depth = 0;
        for (; *q; q++) {
            if (*q == '(') depth++;
            else if (*q == ')') {
                depth--;
                if (depth == 0) break;
            }
        }
        if (depth != 0) return (const char *)0;
        len = (int)(p - ftype);
        while (len > 0 && ftype[len - 1] == ' ') len--;
        if (len <= 0) return (const char *)0;
        return runtime::text::ct_intern_len(ftype, len);
    }

    int fnptr_ret(const char *ftype, char *out, int cap)
    {
        const char *t = self->fnptr_ret_text(ftype);

        if (!t) return 0;
        if (snprintf(out, (size_t)cap, "%s", t) >= cap) return 0;
        return 1;
    }

    const char *peel_ptr_text(const char *ty)
    {
        int len;

        (void)self;
        len = (int)strlen(ty);
        while (len > 0 && ty[len - 1] == ' ') len--;
        if (len <= 0 || ty[len - 1] != '*') return (const char *)0;
        len--;
        while (len > 0 && ty[len - 1] == ' ') len--;
        if (len <= 0) return (const char *)0;
        return runtime::text::ct_intern_len(ty, len);
    }

    int peel_ptr(const char *ty, char *out, int cap)
    {
        const char *t = self->peel_ptr_text(ty);

        if (!t) return 0;
        if (snprintf(out, (size_t)cap, "%s", t) >= cap) return 0;
        return 1;
    }

    const char *static_ctype_text(int n, int *array_depth, int depth)
    {
        int k;

        *array_depth = 0;
        if (n < 0 || depth > 8) return (const char *)0;
        k = self->arena->nodes[n].kind;
        if (k == N_ADTCTOR) return ctype_adtctor(self, n, array_depth, depth);
        if (k == N_VAR) return ctype_var(self, n, array_depth, depth);
        if (k == N_TRY) return ctype_try(self, n, array_depth, depth);
        if (k == N_INDEX) return ctype_index(self, n, array_depth, depth);
        if (k == N_DEREF) return ctype_deref(self, n, array_depth, depth);
        if (k == N_ADDR) return ctype_addr(self, n, array_depth, depth);
        if (k == N_MEMBER || k == N_ARROW) return ctype_member_or_arrow(self, n, array_depth, depth);
        if (k == N_CALL) return ctype_call(self, n, array_depth, depth);
        if (k == N_OPT) return ctype_opt(self, n, array_depth, depth);
        if (k == N_MCALL) return ctype_mcall(self, n, array_depth, depth);
        if (k == N_SLICE_INDEX) return ctype_slice_index(self, n, array_depth, depth);
        if (k == N_SLICE_GET) return ctype_slice_get(self, n, array_depth, depth);
        if (k == N_SLICE_RANGE) return ctype_slice_range(self, n, array_depth, depth);
        return (const char *)0;
    }

    int static_ctype(int n, char *out, int cap, int *array_depth, int depth)
    {
        const char *t = self->static_ctype_text(n, array_depth, depth);

        if (!t) return 0;
        if (snprintf(out, (size_t)cap, "%s", t) >= cap) return 0;
        return 1;
    }

    int container_init_check(const char *ctype)
    {
        if (strncmp(ctype, "struct Vec_", 11) == 0 || strncmp(ctype, "Vec_", 4) == 0)
            return self->sup->fail(
                "a Vec cannot be initialized from a brace list: use a range initializer or Vec<T>::from");
        if (strncmp(ctype, "struct Map_", 11) == 0 || strncmp(ctype, "Map_", 4) == 0)
            return self->sup->fail(
                "a Map cannot be initialized from a brace list: use put(key, value)");
        return 0;
    }

    int container_global_init_check(const char *ctype)
    {
        if (strncmp(ctype, "struct Vec_", 11) == 0 || strncmp(ctype, "Vec_", 4) == 0)
            return self->sup->fail(
                "a Vec brace initializer is only supported in a local declaration");
        if (strncmp(ctype, "struct Map_", 11) == 0 || strncmp(ctype, "Map_", 4) == 0)
            return self->sup->fail(
                "a Map brace initializer is only supported in a local declaration");
        return 0;
    }

    int container_subscript_kind(int n)
    {
        while (n >= 0) {
            int k = self->arena->nodes[n].kind;
            /* PH-62 S4: a nested write's receiver is `at` (the slot-creating
               form); the write path must rewrite that node to `put` as well,
               so both names mark a writable container subscript. */
            if (k == N_MCALL
                && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
                && (strcmp(self->arena->nodes[n].text2, "get") == 0
                    || strcmp(self->arena->nodes[n].text2, "at") == 0)) {
                if (strncmp(self->arena->nodes[n].text, "struct Vec_", 11) == 0
                    || strncmp(self->arena->nodes[n].text, "Vec_", 4) == 0)
                    return 1;
                if (strncmp(self->arena->nodes[n].text, "struct Map_", 11) == 0
                    || strncmp(self->arena->nodes[n].text, "Map_", 4) == 0)
                    return 2;
                /* PH-52: a sugar node carries the `[` position; an explicit
                   `x.get(k)` call does not, so it keeps the generic
                   "not assignable" wording instead of the subscript rule. */
                if (self->arena->nodes[n].line > 0 && self->arena->nodes[n].num > 0)
                    return 3;
                return 0;
            }
            if (k != N_MEMBER && k != N_ARROW) return 0;
            n = self->arena->nodes[n].a;
        }
        return 0;
    }

    /* L31-3 / L31-4 at the subscript's own position. */
    int container_write_check(int n)
    {
        int k = self->container_subscript_kind(n);
        int at = n;
        if (k == 0) return 0;
        while (at >= 0 && (self->arena->nodes[at].kind == N_MEMBER
                           || self->arena->nodes[at].kind == N_ARROW))
            at = self->arena->nodes[at].a;
        if (k == 1)
            return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                            self->arena->nodes[at].num,
                                            "a Vec subscript is read-only; use set(i, v)",
                                            self->sup->mem->path);
        if (k == 3)
            return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                            self->arena->nodes[at].num,
                                            "a custom subscript supports only '='; use set(k, v)",
                                            self->sup->mem->path);
        return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                        self->arena->nodes[at].num,
                                        "a Map subscript is read-only; use put(k, v)",
                                        self->sup->mem->path);
    }

    /* Phase 31 O3 (L31-5): a subscript names a value, so it has no address. */
    int container_addr_check(int n)
    {
        int k = self->container_subscript_kind(n);
        int at = n;
        if (k == 0) return 0;
        while (at >= 0 && (self->arena->nodes[at].kind == N_MEMBER
                           || self->arena->nodes[at].kind == N_ARROW))
            at = self->arena->nodes[at].a;
        if (k == 3)
            return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                            self->arena->nodes[at].num,
                                            "cannot take the address of a custom subscript; bind it to a local first",
                                            self->sup->mem->path);
        return tool::diag::ct_sem_error(self->arena->nodes[at].line,
                                        self->arena->nodes[at].num,
                                        "cannot take the address of a container subscript; bind it to a local first",
                                        self->sup->mem->path);
    }

    int brace_arg_ok(const char *formal, const char *actual)
    {
        const char *fb;
        const char *ab;
        int r, fs, as;

        r = arg_class_text(formal, actual, &fb, &ab);
        if (r != 2) return r;
        if (strncmp(fb, "struct", 6) != 0 || strncmp(ab, "struct", 6) != 0) return 2;
        fs = self->sym->find_struct(fb + 6);
        as = self->sym->find_struct(ab + 6);
        if (fs < 0 || as < 0) return -1;
        return fs == as ? 0 : 1;
    }

    /* D-029: the abstract signature an initializer / assignment right side
       names. A named function answers `R (*)(A, B)`; a function-pointer
       variable answers its declared spelling; `&f` looks through. Closures,
       C library names, aliases, `ref`/`out` and variadic functions answer 0:
       the checker must not guess. */
    const char *expr_fnptr_sig(int e)
    {
        int k, vi, fi, i, n;
        const char *name;
        char *buf;
        int cap;
        const char *pooled;

        buf = 0;
        cap = 0;

        if (e < 0) return (const char *)0;
        k = self->arena->nodes[e].kind;
        if (k == N_ADDR) return self->expr_fnptr_sig(self->arena->nodes[e].a);
        if (k == N_RAW) {
            /* a bare function name is emitted as an N_RAW carrying its C name */
            name = self->arena->nodes[e].text;
            fi = self->sym->find_func(name);
            if (fi < 0) return (const char *)0;
            goto named_func;
        }
        if (k != N_VAR) return (const char *)0;
        name = self->arena->nodes[e].text2;
        vi = self->sym->find_var(name);
        if (vi >= 0) {
            if (self->sym->vars[vi].is_closure) return (const char *)0;
            if (self->sym->vars[vi].type
                && strstr(self->sym->vars[vi].type, "(*)"))
                return self->sym->vars[vi].type;
            return (const char *)0;
        }
        fi = self->sym->find_func(name);
        if (fi < 0) return (const char *)0;
    named_func:
        if (self->sym->funcs[fi].variadic) return (const char *)0;
        n = self->sym->funcs[fi].nparams;
        for (i = 0; i < n; i++) {
            /* pann 1 is `borrow`: it changes no C signature, so the address of
               such a function is still spellable. Only `ref` / `out` add the
               pointer the C function-pointer type cannot express. */
            if (self->sym->funcs[fi].pann[i] == 2
                || self->sym->funcs[fi].pann[i] == 3) return (const char *)0;
            if (self->sym->funcs[fi].pdim[i] && self->sym->funcs[fi].pdim[i][0])
                return (const char *)0;
        }
        if (tool::sh::ct_text_init(&buf, &cap, 64) != 0) return (const char *)0;
        if (tool::sh::ct_text_cat(&buf, &cap, self->sym->funcs[fi].ret) != 0)
            goto fail;
        if (tool::sh::ct_text_cat(&buf, &cap, " (*)(") != 0) goto fail;
        for (i = 0; i < n; i++) {
            if (i > 0 && tool::sh::ct_text_cat(&buf, &cap, ", ") != 0) goto fail;
            if (tool::sh::ct_text_cat(&buf, &cap,
                                      self->sym->funcs[fi].ptype[i]) != 0)
                goto fail;
        }
        if (n == 0 && tool::sh::ct_text_cat(&buf, &cap, "void") != 0) goto fail;
        if (tool::sh::ct_text_cat(&buf, &cap, ")") != 0) goto fail;
        pooled = runtime::text::ct_intern(buf);
        tool::sh::ct_text_free(&buf, &cap);
        return pooled;
    fail:
        tool::sh::ct_text_free(&buf, &cap);
        return (const char *)0;
    }

    /* D-029: the sugar is the same type as a hand-written function pointer, so
       a mismatch between the declared signature and a deducible actual is a
       positioned error. Only arity and return type are judged here; parameter
       spellings are left to C (a typedef alias is not expanded by the parser,
       and a false positive would be worse than the C compiler's own error). */
    int fnptr_sig_check(const char *formal, int e, int line, int col)
    {
        const char *actual;
        const char *fret;
        const char *fps;
        const char *aret;
        const char *aps;
        const char *fk;
        const char *ak;
        int fn, an;

        if (!formal || !strstr(formal, "(*)")) return 0;
        actual = self->expr_fnptr_sig(e);
        if (!actual) return 0;
        if (!fnptr_sig_parts(formal, &fret, &fps)) return 0;
        if (!fnptr_sig_parts(actual, &aret, &aps)) return 0;
        fn = fnptr_param_count(fps);
        an = fnptr_param_count(aps);
        if (fn != an)
            return tool::diag::ct_sem_error(line, col,
                runtime::text::ct_internf(
                    "function pointer arity mismatch: expected '%s', got '%s'",
                    formal, actual), self->sup->mem->path);
        fk = frontend::type::type_key_text(fret);
        ak = frontend::type::type_key_text(aret);
        if (!fk || !ak) return 0;
        if (strcmp(fk, ak) != 0)
            return tool::diag::ct_sem_error(line, col,
                runtime::text::ct_internf(
                    "function pointer type mismatch: expected '%s', got '%s': return type differs",
                    formal, actual), self->sup->mem->path);
        return 0;
    }
}
