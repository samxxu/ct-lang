/*
 * StmtMatch.h.ct - the match statement/expression grammar (SH-94 S1a-1, pure move out of Stmt.h.ct).
 *
 * The method bodies are byte-identical to the ones Stmt.h.ct held; the
 * `Stmt` type and every trait declaration live in StmtCore.h.ct, so this unit
 * imports Core instead of the host and the import graph stays acyclic.
 * Stmt.h.ct imports this unit for the vtable.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import frontend::sym::SymbolsTypeText;
import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import frontend::lex::Lexer;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::sym::Symbols::StructInst as StructInst;
import backend::mem::Memory;
import frontend::parse::ParseSupport;
import frontend::parse::Expr;
import tool::diag::Diag;
import frontend::parse::StmtRangeText;
import frontend::parse::StmtRangeScan;
import frontend::parse::StmtScope;
import frontend::parse::StmtCore;
import frontend::parse::StmtDefer;
import frontend::type::TypeCheck;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
#define MAX_ADT_FIELDS_MAX 65536
#define MAX_LABELS 64
#define MAX_LABELS_MAX 65536
#define B_COMMA 19
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_MOD 11
#define B_SHL 17
#define B_SHR 18
#define B_BAND 15
#define B_BOR 16
#define B_XOR 14
#define N_INDEX 26
#define N_CALL 7
#define N_MCALL 30
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BLOCK 4
#define N_CLOSURE 59
#define N_BREAK 38
#define N_CASE 43
#define N_CONT 39
#define N_DECL 12
#define N_DECLS 40
#define N_DELETE 41
#define N_DEREF 28
#define N_DOWHILE 44
#define N_EMPTY 52
#define N_SASSERT 55
#define N_EXPR 6
#define N_FOR 16
#define N_GOTO 50
#define N_IF 14
#define N_INIT_RANGE 61
#define N_MATSEQ 73
#define N_INIT_BRACE 65
#define N_INIT_ITEM 66
#define N_DEFER 69
#define N_DEFER_RUN 70
#define N_INIT_MBRACE 67
#define N_LABEL 49
#define N_LOOP 60
#define N_FOREACH 62
#define N_MEMBER 24
#define N_NUM 8
#define N_STR 9
#define N_UNARY 17
#define N_POST 18
#define N_PRE 57
#define N_ADDR 27
#define N_RAW 31
#define N_RET 5
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_SWITCH 42
#define N_MATCH 78
#define N_ARM 79
#define N_BIND 80
#define N_VAR 10
#define N_WHILE 15
#define N_INTO 63
#define N_INTO_SELF 64
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define CT_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct StmtMatch {
    int unused;
}

pub void match_expr_type_key(const char *in, char *out, int cap)
{
    char k[MAX_TEXT];

    frontend::type::type_key(in, k, sizeof k);
    if (strncmp(k, "struct", 6) == 0) memmove(k, k + 6, strlen(k + 6) + 1);
    else if (strncmp(k, "union", 5) == 0) memmove(k, k + 5, strlen(k + 5) + 1);
    else if (strncmp(k, "enum", 4) == 0) memmove(k, k + 4, strlen(k + 4) + 1);
    snprintf(out, (size_t)cap, "%s", k);
}

impl StmtMatch for Stmt {
    int match_ahead(void)
    {
        const char *p;
        int depth;
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        if (!self->lex->tok_is("match")) return 0;
        p = self->lex->src + self->lex->tokstart + 5;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (*p != '(') return 0;
        depth = 0;
        while (*p) {
            if (*p == '"' || *p == '\'') {
                char q = *p;
                p++;
                while (*p && *p != q) {
                    if (*p == '\\' && p[1]) p++;
                    p++;
                }
                if (*p) p++;
                continue;
            }
            if (*p == '/' && p[1] == '*') {
                p += 2;
                while (*p && !(*p == '*' && p[1] == '/')) p++;
                if (*p) p += 2;
                continue;
            }
            if (*p == '/' && p[1] == '/') {
                while (*p && *p != '\n') p++;
                continue;
            }
            if (*p == '(') depth++;
            else if (*p == ')') {
                depth--;
                if (depth == 0) { p++; break; }
            }
            p++;
        }
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        return *p == '{';
    }

    int parse_match(void)
    {
        int s, e, arms, tail, arm, adt, v, line, col, i;
        int *covered;
        int ncov, wild, seen_wild, is_ptr, a2;
        int aline, acol;
        char tybuf[MAX_TEXT];
        char tname[MAX_TEXT];
        char aname[MAX_TEXT];
        char rn[MAX_TEXT];
        char vname[MAX_TEXT];
        char msg[3 * MAX_TEXT];
        struct Adt *adts;
        int nadts;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        self->sup->lex_next();                       /* consume `match` */
        if (self->sup->expect("(") != 0) return -1;
        self->ex->assign_ok = 1;
        self->ex->try_ban++;
        e = self->ex->parse_expr();
        self->ex->try_ban--;
        self->ex->assign_ok = 0;
        if (e < 0) return -1;
        if (self->sup->expect(")") != 0) return -1;
        /* the subject type is read now, while its local is still in scope */
        if (self->sup->expr_type(e, tybuf, sizeof tybuf) != 0)
            return tool::diag::ct_sem_error(line, col,
                "cannot determine the type of the match subject", self->mem->path);
        {
            const char *b;
            char *w;
            size_t n;
            b = tybuf;
            while (*b == ' ' || *b == '\t') b++;
            snprintf(tname, sizeof tname, "%s", b);
            n = strlen(tname);
            is_ptr = 0;
            while (n > 0 && (tname[n - 1] == ' ' || tname[n - 1] == '*')) {
                if (tname[n - 1] == '*') is_ptr = 1;
                n--;
                tname[n] = 0;
            }
            w = tname;
            if (strncmp(w, "struct ", 7) == 0) w += 7;
            if (w != tname) memmove(tname, w, strlen(w) + 1);
        }
        adt = frontend::sym::ct_adt_from_type(tname);
        if (adt < 0) {
            snprintf(msg, sizeof msg, "match needs an ADT value, but '%s' is not an ADT",
                     tybuf);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        adts = frontend::sym::ct_adts(&nadts);
        /* S1a-0 C3: the variant count is dynamic, so the coverage scratch grows
           with it instead of stopping at a fixed 96 rows. */
        covered = calloc((size_t)(adts[adt].nvariants > 0 ? adts[adt].nvariants : 1),
                         sizeof(*covered));
        if (!covered) return self->sup->fail("out of memory");
        for (i = 0; i < adts[adt].nvariants; i++) covered[i] = 0;
        ncov = 0;
        wild = -1;
        seen_wild = 0;
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("{")))
            return self->sup->fail("expected a block after match (...)");
        self->sup->lex_next();
        s = self->sup->new_node(N_MATCH);
        if (s < 0) return -1;
        self->arena->nodes[s].text = runtime::text::ct_intern(adts[adt].full);
        if (!self->arena->nodes[s].text) return self->sup->fail("out of memory");
        self->arena->nodes[s].aux = is_ptr;
        self->arena->nodes[s].a = e;
        self->arena->nodes[s].line = line;
        self->arena->nodes[s].num = col;
        arms = -1;
        tail = -1;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            int arm_line, arm_col;
            arm_line = self->lex->tokline;
            arm_col = self->lex->tokstart - self->lex->lstart + 1;
            if (self->lex->tok == T_ID && self->lex->tok_is("_")) {
                int body;
                if (seen_wild)
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "duplicate wildcard match arm", self->mem->path);
                seen_wild = 1;
                self->sup->lex_next();
                if (self->sup->expect("=>") != 0) return -1;
                body = self->parse_block();
                if (body < 0) return -1;
                arm = self->sup->new_node(N_ARM);
                if (arm < 0) return -1;
                self->arena->nodes[arm].aux = 1;
                self->arena->nodes[arm].b = body;
                self->arena->nodes[arm].line = arm_line;
                self->arena->nodes[arm].num = arm_col;
                wild = arm;
            } else {
                int body, nb, first_bind, last_bind, w;
                int nbind;
                char *bind_names;
                if (seen_wild)
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "a wildcard match arm must be the last arm", self->mem->path);
                if (self->lex->tok != T_ID) return self->sup->fail("expected a match arm");
                self->lex->tok_copy(aname, sizeof aname);
                aline = self->lex->tokline;
                acol = self->lex->tokstart - self->lex->lstart + 1;
                if (self->sup->resolve_type(aname, rn, sizeof rn) != 0)
                    return self->sup->fail("unknown ADT type in a match arm");
                a2 = frontend::sym::ct_adt_from_type(rn);
                if (a2 < 0) {
                    snprintf(msg, sizeof msg,
                             "match arm names '%s', which is not an ADT", aname);
                    return tool::diag::ct_sem_error(aline, acol, msg, self->mem->path);
                }
                if (a2 != adt) {
                    snprintf(msg, sizeof msg,
                             "match arm names ADT '%s', but the subject is '%s'",
                             adts[a2].name, adts[adt].name);
                    return tool::diag::ct_sem_error(aline, acol, msg, self->mem->path);
                }
                self->sup->lex_next();
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(".")))
                    return self->sup->fail("expected '.' after the ADT name");
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a variant name");
                self->lex->tok_copy(vname, sizeof vname);
                v = frontend::sym::ct_adt_variant(adt, vname);
                if (v < 0) {
                    snprintf(msg, sizeof msg, "unknown variant '%s' of ADT '%s'",
                             vname, adts[adt].name);
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1, msg, self->mem->path);
                }
                if (covered[v]) {
                    snprintf(msg, sizeof msg, "duplicate match arm for variant '%s.%s'",
                             adts[adt].name, vname);
                    return tool::diag::ct_sem_error(aline, acol, msg, self->mem->path);
                }
                covered[v] = 1;
                ncov++;
                self->sup->lex_next();
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("(")))
                    return self->sup->fail("expected '(' after a variant name");
                self->sup->lex_next();
                first_bind = -1;
                last_bind = -1;
                nb = 0;
                /* S1a-0 C3: the binding-name block grows on demand. It starts
                   above the old 8-slot fixed array, and it is NOT bounded by
                   the payload field count: a mismatched arm must still reach
                   the arity diagnostic below ("binds 2 names, but the variant
                   has 1 field"), not a generic capacity failure. */
                nbind = adts[adt].variants[v].nfields > 8
                            ? adts[adt].variants[v].nfields : 8;
                bind_names = calloc((size_t)nbind, MAX_TEXT);
                if (!bind_names) return self->sup->fail("out of memory");
                while (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")"))) {
                    char *grown;
                    int ncap;
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a binding name");
                    if (nb >= nbind) {
                        ncap = nbind > MAX_ADT_FIELDS_MAX / 2
                                   ? MAX_ADT_FIELDS_MAX : nbind * 2;
                        if (nb >= ncap)
                            return self->sup->fail("too many bindings in one match arm");
                        grown = realloc(bind_names, (size_t)ncap * MAX_TEXT);
                        if (!grown) return self->sup->fail("out of memory");
                        bind_names = grown;
                        nbind = ncap;
                    }
                    self->lex->tok_copy(bind_names + (size_t)nb * MAX_TEXT, MAX_TEXT);
                    for (w = 0; w < nb; w++)
                        if (strcmp(bind_names + (size_t)w * MAX_TEXT,
                                   bind_names + (size_t)nb * MAX_TEXT) == 0) {
                            snprintf(msg, sizeof msg, "duplicate binding '%s' in a match arm",
                                     bind_names + (size_t)nb * MAX_TEXT);
                            return tool::diag::ct_sem_error(self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1, msg,
                                self->mem->path);
                        }
                    w = self->sup->new_node(N_BIND);
                    if (w < 0) return -1;
                    self->arena->nodes[w].text = runtime::text::ct_intern(bind_names + (size_t)nb * MAX_TEXT);
                    if (!self->arena->nodes[w].text) return self->sup->fail("out of memory");
                    if (first_bind < 0) first_bind = w;
                    else self->arena->nodes[last_bind].next = w;
                    last_bind = w;
                    nb++;
                    self->sup->lex_next();
                    if (self->sup->accept(",")) continue;
                    break;
                }
                if (self->sup->expect(")") != 0) return -1;
                if (nb != adts[adt].variants[v].nfields) {
                    snprintf(msg, sizeof msg,
                             "match arm for '%s.%s' binds %d name%s, but the variant has %d field%s",
                             adts[adt].name, vname, nb, nb == 1 ? "" : "s",
                             adts[adt].variants[v].nfields,
                             adts[adt].variants[v].nfields == 1 ? "" : "s");
                    return tool::diag::ct_sem_error(aline, acol, msg, self->mem->path);
                }
                if (self->sup->expect("=>") != 0) return -1;
                if (self->sup->push_scope() != 0) return -1;
                w = 0;
                for (i = first_bind; i >= 0; i = self->arena->nodes[i].next, w++) {
                    int vi, decl, raw;
                    self->arena->nodes[i].text2 = runtime::text::ct_intern(adts[adt].variants[v].fields[w].type);
                    if (!self->arena->nodes[i].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[i].text3 = runtime::text::ct_intern(adts[adt].variants[v].fields[w].name);
                    if (!self->arena->nodes[i].text3) return self->sup->fail("out of memory");
                    if (self->sym->declare_var(self->arena->nodes[i].text,
                                               self->arena->nodes[i].text2) != 0) {
                        self->sup->pop_scope();
                        return self->sup->fail(self->sym->last_error());
                    }
                    vi = self->sym->find_var(self->arena->nodes[i].text);
                    if (vi >= 0) self->sym->vars[vi].initialized = 1;
                    decl = self->sup->new_node(N_DECL);
                    raw = self->sup->new_node(N_RAW);
                    if (decl < 0 || raw < 0) {
                        self->sup->pop_scope();
                        return -1;
                    }
                    self->arena->nodes[decl].text = runtime::text::ct_intern(self->arena->nodes[i].text2);
                    if (!self->arena->nodes[decl].text) return self->sup->fail("out of memory");
                    self->arena->nodes[decl].text2 = runtime::text::ct_intern(self->arena->nodes[i].text);
                    if (!self->arena->nodes[decl].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[decl].aux = 3;   /* unused marker */
                    self->arena->nodes[decl].a = raw;
                    self->arena->nodes[raw].aux = 0;
                    self->arena->nodes[i].a = decl;
                    self->arena->nodes[i].b = raw;
                }
                body = self->parse_block();
                self->sup->pop_scope();
                if (body < 0) return -1;
                arm = self->sup->new_node(N_ARM);
                if (arm < 0) return -1;
                self->arena->nodes[arm].text = runtime::text::ct_intern(vname);
                if (!self->arena->nodes[arm].text) return self->sup->fail("out of memory");
                self->arena->nodes[arm].text2 = runtime::text::ct_intern(adts[adt].variants[v].cname);
                if (!self->arena->nodes[arm].text2) return self->sup->fail("out of memory");
                self->arena->nodes[arm].text3 = runtime::text::ct_intern(adts[adt].full);
                if (!self->arena->nodes[arm].text3) return self->sup->fail("out of memory");
                self->arena->nodes[arm].num = v;
                self->arena->nodes[arm].a = first_bind;
                self->arena->nodes[arm].b = body;
                self->arena->nodes[arm].line = aline;
            }
            if (arms < 0) arms = arm;
            else self->arena->nodes[tail].next = arm;
            tail = arm;
        }
        if (self->sup->expect("}") != 0) return -1;
        self->arena->nodes[s].b = arms;
        /* exhaustiveness: `_` is the only fallback, and it has to be written */
        if (wild < 0) {
            for (i = 0; i < adts[adt].nvariants; i++) {
                if (covered[i]) continue;
                snprintf(msg, sizeof msg, "match does not cover variant '%s.%s'"
                         " (add the arm or write '_ => { … }')",
                         adts[adt].name, adts[adt].variants[i].name);
                return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
            }
        } else if (self->ex->types_mode && *self->ex->types_mode && ncov == adts[adt].nvariants) {
            /* R84-2: the wildcard hides a variant being added later */
            snprintf(msg, sizeof msg,
                     "match covers every variant of '%s'; the wildcard arm is unnecessary",
                     adts[adt].name);
            if (tool::diag::ct_type_warn(line, col, "", msg, self->mem->path) != 0)
                return -1;
        }
        return s;
    }

    int expr_match_ahead(void)
    {
        const char *p;
        int depth;
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        if (!self->lex->tok_is("match")) return 0;
        p = self->lex->src + self->lex->tokstart + 5;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (*p != '(') return 0;
        depth = 0;
        while (*p) {
            if (*p == '"' || *p == '\'') {
                char q = *p;
                p++;
                while (*p && *p != q) {
                    if (*p == '\\' && p[1]) p++;
                    p++;
                }
                if (*p) p++;
                continue;
            }
            if (*p == '/' && p[1] == '*') {
                p += 2;
                while (*p && !(*p == '*' && p[1] == '/')) p++;
                if (*p) p += 2;
                continue;
            }
            if (*p == '/' && p[1] == '/') {
                while (*p && *p != '\n') p++;
                continue;
            }
            if (*p == '(') depth++;
            else if (*p == ')') {
                depth--;
                if (depth == 0) { p++; break; }
            }
            p++;
        }
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        return *p == '{';
    }

    int parse_match_expr(void)
    {
        int s, e, arms, tail, arm, adt, v, line, col, i;
        int *covered;
        int ncov, wild, seen_wild, is_ptr, a2;
        int body, asg, yexpr, have_type, ytyped, block_form;
        int yline, ycol;
        char tybuf[MAX_TEXT];
        char tname[MAX_TEXT];
        char aname[MAX_TEXT];
        char rn[MAX_TEXT];
        char vname[MAX_TEXT];
        char msg[3 * MAX_TEXT];
        char rtype[MAX_TEXT];
        char rkey[MAX_TEXT];
        char ytype[MAX_TEXT];
        char ykey[MAX_TEXT];
        struct Adt *adts;
        int nadts;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        self->sup->lex_next();                       /* consume `match` */
        if (self->sup->expect("(") != 0) return -1;
        self->ex->assign_ok = 1;
        self->ex->try_ban++;
        e = self->ex->parse_expr();
        self->ex->try_ban--;
        self->ex->assign_ok = 0;
        if (e < 0) return -1;
        if (self->sup->expect(")") != 0) return -1;
        if (self->sup->expr_type(e, tybuf, sizeof tybuf) != 0)
            return tool::diag::ct_sem_error(line, col,
                "cannot determine the type of the match subject", self->mem->path);
        {
            const char *b;
            char *w;
            size_t n;
            b = tybuf;
            while (*b == ' ' || *b == '\t') b++;
            snprintf(tname, sizeof tname, "%s", b);
            n = strlen(tname);
            is_ptr = 0;
            while (n > 0 && (tname[n - 1] == ' ' || tname[n - 1] == '*')) {
                if (tname[n - 1] == '*') is_ptr = 1;
                n--;
                tname[n] = 0;
            }
            w = tname;
            if (strncmp(w, "struct ", 7) == 0) w += 7;
            if (w != tname) memmove(tname, w, strlen(w) + 1);
        }
        adt = frontend::sym::ct_adt_from_type(tname);
        if (adt < 0) {
            snprintf(msg, sizeof msg, "match needs an ADT value, but '%s' is not an ADT",
                     tybuf);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        adts = frontend::sym::ct_adts(&nadts);
        /* S1a-0 C3: the variant count is dynamic, so the coverage scratch grows
           with it instead of stopping at a fixed 96 rows. */
        covered = calloc((size_t)(adts[adt].nvariants > 0 ? adts[adt].nvariants : 1),
                         sizeof(*covered));
        if (!covered) return self->sup->fail("out of memory");
        for (i = 0; i < adts[adt].nvariants; i++) covered[i] = 0;
        ncov = 0;
        wild = -1;
        seen_wild = 0;
        have_type = 0;
        rtype[0] = 0;
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("{")))
            return self->sup->fail("expected a block after match (...)");
        self->sup->lex_next();
        s = self->sup->new_node(N_MATCH);
        if (s < 0) return -1;
        self->arena->nodes[s].text = runtime::text::ct_intern(adts[adt].full);
        if (!self->arena->nodes[s].text) return self->sup->fail("out of memory");
        self->arena->nodes[s].aux = is_ptr;
        self->arena->nodes[s].a = e;
        self->arena->nodes[s].line = line;
        self->arena->nodes[s].num = col;
        self->arena->nodes[s].sflags = self->arena->nodes[s].sflags | 8;  /* expression form */
        arms = -1;
        tail = -1;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            int arm_line, arm_col, variant;
            int bind_head;
            arm_line = self->lex->tokline;
            arm_col = self->lex->tokstart - self->lex->lstart + 1;
            bind_head = -1;
            variant = -1;
            if (self->lex->tok == T_ID && self->lex->tok_is("_")) {
                if (seen_wild)
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "duplicate wildcard match arm", self->mem->path);
                seen_wild = 1;
                self->sup->lex_next();
            } else {
                int nb, first_bind, last_bind, w;
                int nbind;
                char *bind_names;
                if (seen_wild)
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "a wildcard match arm must be the last arm", self->mem->path);
                if (self->lex->tok != T_ID) return self->sup->fail("expected a match arm");
                self->lex->tok_copy(aname, sizeof aname);
                if (self->sup->resolve_type(aname, rn, sizeof rn) != 0)
                    return self->sup->fail("unknown ADT type in a match arm");
                a2 = frontend::sym::ct_adt_from_type(rn);
                if (a2 < 0) {
                    snprintf(msg, sizeof msg,
                             "match arm names '%s', which is not an ADT", aname);
                    return tool::diag::ct_sem_error(arm_line, arm_col, msg, self->mem->path);
                }
                if (a2 != adt) {
                    snprintf(msg, sizeof msg,
                             "match arm names ADT '%s', but the subject is '%s'",
                             adts[a2].name, adts[adt].name);
                    return tool::diag::ct_sem_error(arm_line, arm_col, msg, self->mem->path);
                }
                self->sup->lex_next();
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(".")))
                    return self->sup->fail("expected '.' after the ADT name");
                self->sup->lex_next();
                if (self->lex->tok != T_ID) return self->sup->fail("expected a variant name");
                self->lex->tok_copy(vname, sizeof vname);
                v = frontend::sym::ct_adt_variant(adt, vname);
                if (v < 0) {
                    snprintf(msg, sizeof msg, "unknown variant '%s' of ADT '%s'",
                             vname, adts[adt].name);
                    return tool::diag::ct_sem_error(self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1, msg, self->mem->path);
                }
                if (covered[v]) {
                    snprintf(msg, sizeof msg, "duplicate match arm for variant '%s.%s'",
                             adts[adt].name, vname);
                    return tool::diag::ct_sem_error(arm_line, arm_col, msg, self->mem->path);
                }
                covered[v] = 1;
                ncov++;
                self->sup->lex_next();
                if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("(")))
                    return self->sup->fail("expected '(' after a variant name");
                self->sup->lex_next();
                first_bind = -1;
                last_bind = -1;
                nb = 0;
                /* S1a-0 C3: the binding-name block grows on demand. It starts
                   above the old 8-slot fixed array, and it is NOT bounded by
                   the payload field count: a mismatched arm must still reach
                   the arity diagnostic below ("binds 2 names, but the variant
                   has 1 field"), not a generic capacity failure. */
                nbind = adts[adt].variants[v].nfields > 8
                            ? adts[adt].variants[v].nfields : 8;
                bind_names = calloc((size_t)nbind, MAX_TEXT);
                if (!bind_names) return self->sup->fail("out of memory");
                while (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")"))) {
                    char *grown;
                    int ncap;
                    if (self->lex->tok != T_ID)
                        return self->sup->fail("expected a binding name");
                    if (nb >= nbind) {
                        ncap = nbind > MAX_ADT_FIELDS_MAX / 2
                                   ? MAX_ADT_FIELDS_MAX : nbind * 2;
                        if (nb >= ncap)
                            return self->sup->fail("too many bindings in one match arm");
                        grown = realloc(bind_names, (size_t)ncap * MAX_TEXT);
                        if (!grown) return self->sup->fail("out of memory");
                        bind_names = grown;
                        nbind = ncap;
                    }
                    self->lex->tok_copy(bind_names + (size_t)nb * MAX_TEXT, MAX_TEXT);
                    for (w = 0; w < nb; w++)
                        if (strcmp(bind_names + (size_t)w * MAX_TEXT,
                                   bind_names + (size_t)nb * MAX_TEXT) == 0) {
                            snprintf(msg, sizeof msg, "duplicate binding '%s' in a match arm",
                                     bind_names + (size_t)nb * MAX_TEXT);
                            return tool::diag::ct_sem_error(self->lex->tokline,
                                self->lex->tokstart - self->lex->lstart + 1, msg,
                                self->mem->path);
                        }
                    w = self->sup->new_node(N_BIND);
                    if (w < 0) return -1;
                    self->arena->nodes[w].text = runtime::text::ct_intern(bind_names + (size_t)nb * MAX_TEXT);
                    if (!self->arena->nodes[w].text) return self->sup->fail("out of memory");
                    if (first_bind < 0) first_bind = w;
                    else self->arena->nodes[last_bind].next = w;
                    last_bind = w;
                    nb++;
                    self->sup->lex_next();
                    if (self->sup->accept(",")) continue;
                    break;
                }
                if (self->sup->expect(")") != 0) return -1;
                if (nb != adts[adt].variants[v].nfields) {
                    snprintf(msg, sizeof msg,
                             "match arm for '%s.%s' binds %d name%s, but the variant has %d field%s",
                             adts[adt].name, vname, nb, nb == 1 ? "" : "s",
                             adts[adt].variants[v].nfields,
                             adts[adt].variants[v].nfields == 1 ? "" : "s");
                    return tool::diag::ct_sem_error(arm_line, arm_col, msg, self->mem->path);
                }
                variant = v;
                bind_head = first_bind;
                (void)last_bind;
            }
            if (self->sup->expect("=>") != 0) return -1;
            if (variant >= 0) {
                int w;
                if (self->sup->push_scope() != 0) return -1;
                w = 0;
                for (i = bind_head; i >= 0; i = self->arena->nodes[i].next, w++) {
                    int vi, decl, raw;
                    self->arena->nodes[i].text2 = runtime::text::ct_intern(adts[adt].variants[variant].fields[w].type);
                    if (!self->arena->nodes[i].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[i].text3 = runtime::text::ct_intern(adts[adt].variants[variant].fields[w].name);
                    if (!self->arena->nodes[i].text3) return self->sup->fail("out of memory");
                    if (self->sym->declare_var(self->arena->nodes[i].text,
                                               self->arena->nodes[i].text2) != 0) {
                        self->sup->pop_scope();
                        return self->sup->fail(self->sym->last_error());
                    }
                    vi = self->sym->find_var(self->arena->nodes[i].text);
                    if (vi >= 0) self->sym->vars[vi].initialized = 1;
                    decl = self->sup->new_node(N_DECL);
                    raw = self->sup->new_node(N_RAW);
                    if (decl < 0 || raw < 0) {
                        self->sup->pop_scope();
                        return -1;
                    }
                    self->arena->nodes[decl].text = runtime::text::ct_intern(self->arena->nodes[i].text2);
                    if (!self->arena->nodes[decl].text) return self->sup->fail("out of memory");
                    self->arena->nodes[decl].text2 = runtime::text::ct_intern(self->arena->nodes[i].text);
                    if (!self->arena->nodes[decl].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[decl].aux = 3;   /* unused marker */
                    self->arena->nodes[decl].a = raw;
                    self->arena->nodes[raw].aux = 0;
                    self->arena->nodes[i].a = decl;
                    self->arena->nodes[i].b = raw;
                }
            }
            yexpr = -1;
            ytyped = 0;
            block_form = 0;
            yline = arm_line;
            ycol = arm_col;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                block_form = 1;
                int q, last, deferring;
                self->match_arm_pending = 1;
                body = self->parse_block();
                if (body < 0) {
                    if (variant >= 0) self->sup->pop_scope();
                    return -1;
                }
                /* A `defer` / `own` in the arm would run before the value
                   leaves the block; this slice refuses the combination
                   instead of emitting an assignment after the cleanup. */
                deferring = 0;
                for (q = self->arena->nodes[body].a; q >= 0; q = self->arena->nodes[q].next)
                    if (self->arena->nodes[q].kind == N_DEFER_RUN
                        || self->arena->nodes[q].kind == N_DELETE)
                        deferring = 1;
                if (deferring && self->last_yield_count > 0) {
                    if (variant >= 0) self->sup->pop_scope();
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "defer / own is not supported inside an expression-match arm",
                        self->mem->path);
                }
                if (self->last_yield_count > 0) {
                    yexpr = self->last_yield_expr;
                    yline = self->last_yield_line;
                    ycol = self->last_yield_col;
                    snprintf(ytype, sizeof ytype, "%s", self->last_yield_type);
                    ytyped = 1;
                } else {
                    last = -1;
                    for (q = self->arena->nodes[body].a; q >= 0; q = self->arena->nodes[q].next)
                        last = q;
                    if (last >= 0 && (self->arena->nodes[last].kind == N_RET
                                      || self->arena->nodes[last].kind == N_BREAK
                                      || self->arena->nodes[last].kind == N_CONT)) {
                        yexpr = -1;             /* diverging arm */
                    } else {
                        if (variant >= 0) self->sup->pop_scope();
                        return tool::diag::ct_sem_error(arm_line, arm_col,
                            "an expression-match arm must yield a value (add 'yield <expr>;' or end with 'return')",
                            self->mem->path);
                    }
                }
            } else {
                yline = self->lex->tokline;
                ycol = self->lex->tokstart - self->lex->lstart + 1;
                self->ex->assign_ok = 1;
                self->ex->try_ban++;
                yexpr = self->ex->parse_expr();
                self->ex->try_ban--;
                self->ex->assign_ok = 0;
                if (yexpr < 0) {
                    if (variant >= 0) self->sup->pop_scope();
                    return -1;
                }
                {
                    int yz = 0;
                    if (self->sup->expr_type(yexpr, ytype, sizeof ytype) != 0
                        && self->ex->chk_type(yexpr, ytype, sizeof ytype, &yz) != 0) {
                        if (variant >= 0) self->sup->pop_scope();
                        return tool::diag::ct_sem_error(yline, ycol,
                            "cannot determine the type yielded by this match arm",
                            self->mem->path);
                    }
                    ytyped = 1;
                }
                body = self->sup->new_node(N_BLOCK);
                if (body < 0) {
                    if (variant >= 0) self->sup->pop_scope();
                    return -1;
                }
                self->arena->nodes[body].a = -1;
            }
            asg = -1;
            if (yexpr >= 0) {
                if (!ytyped) {
                    if (variant >= 0) self->sup->pop_scope();
                    return tool::diag::ct_sem_error(yline, ycol,
                        "cannot determine the type yielded by this match arm",
                        self->mem->path);
                }
                match_expr_type_key(ytype, ykey, sizeof ykey);
                if (!have_type) {
                    snprintf(rtype, sizeof rtype, "%s", ytype);
                    snprintf(rkey, sizeof rkey, "%s", ykey);
                    have_type = 1;
                } else if (strcmp(ykey, rkey) != 0) {
                    if (variant >= 0) self->sup->pop_scope();
                    snprintf(msg, sizeof msg,
                             "match arm yields '%s', but an earlier arm yields '%s'",
                             ytype, rtype);
                    return tool::diag::ct_sem_error(arm_line, arm_col, msg,
                                                    self->mem->path);
                }
                /* `__ct_mres` is a placeholder: the emitter patches it to the
                   result temporary it actually declares. */
                {
                    int tv, last;
                    tv = self->sup->new_node(N_VAR);
                    asg = self->sup->new_node(N_ASSIGN);
                    if (tv < 0 || asg < 0) {
                        if (variant >= 0) self->sup->pop_scope();
                        return -1;
                    }
                    self->arena->nodes[tv].text2 = runtime::text::ct_intern("__ct_mres");
                    if (!self->arena->nodes[tv].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[tv].line = yline;
                    self->arena->nodes[tv].num = ycol;
                    self->arena->nodes[asg].a = tv;
                    self->arena->nodes[asg].b = yexpr;
                    self->arena->nodes[asg].text = runtime::text::ct_intern(ytype);
                    if (!self->arena->nodes[asg].text) return self->sup->fail("out of memory");
                    self->arena->nodes[asg].line = yline;
                    self->arena->nodes[asg].num = ycol;
                    last = -1;
                    for (i = self->arena->nodes[body].a; i >= 0; i = self->arena->nodes[i].next)
                        last = i;
                    if (last < 0) self->arena->nodes[body].a = asg;
                    else self->arena->nodes[last].next = asg;
                }
            }
            arm = self->sup->new_node(N_ARM);
            if (arm < 0) {
                if (variant >= 0) self->sup->pop_scope();
                return -1;
            }
            self->arena->nodes[arm].aux = (variant < 0 ? 1 : 0) | 2;
            self->arena->nodes[arm].num = variant;
            self->arena->nodes[arm].a = bind_head;
            self->arena->nodes[arm].b = body;
            self->arena->nodes[arm].c = asg;
            self->arena->nodes[arm].line = arm_line;
            self->arena->nodes[arm].num = (variant < 0) ? -1 : variant;
            if (variant >= 0) {
                self->arena->nodes[arm].text = runtime::text::ct_intern(vname);
                if (!self->arena->nodes[arm].text) return self->sup->fail("out of memory");
                self->arena->nodes[arm].text2 = runtime::text::ct_intern(adts[adt].variants[variant].cname);
                if (!self->arena->nodes[arm].text2) return self->sup->fail("out of memory");
                self->arena->nodes[arm].text3 = runtime::text::ct_intern(adts[adt].full);
                if (!self->arena->nodes[arm].text3) return self->sup->fail("out of memory");
            }
            if (variant < 0) wild = arm;
            if (variant >= 0) self->sup->pop_scope();
            if (arms < 0) arms = arm;
            else self->arena->nodes[tail].next = arm;
            tail = arm;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("}")) break;
            /* a braced arm ends at its `}`: the comma is optional, the next
               token already starts the following pattern */
            if (block_form) continue;
            return self->sup->fail("expected ',' or '}' after an expression-match arm");
        }
        if (self->sup->expect("}") != 0) return -1;
        self->arena->nodes[s].b = arms;
        if (!have_type) {
            return tool::diag::ct_sem_error(line, col,
                "an expression match needs at least one arm that yields a value",
                self->mem->path);
        }
        self->arena->nodes[s].text2 = runtime::text::ct_intern(rtype);
        if (!self->arena->nodes[s].text2) return self->sup->fail("out of memory");
        if (wild < 0) {
            for (i = 0; i < adts[adt].nvariants; i++) {
                if (covered[i]) continue;
                snprintf(msg, sizeof msg, "match does not cover variant '%s.%s'"
                         " (add the arm or write '_ => { … }')",
                         adts[adt].name, adts[adt].variants[i].name);
                return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
            }
        } else if (self->ex->types_mode && *self->ex->types_mode && ncov == adts[adt].nvariants) {
            snprintf(msg, sizeof msg,
                     "match covers every variant of '%s'; the wildcard arm is unnecessary",
                     adts[adt].name);
            if (tool::diag::ct_type_warn(line, col, "", msg, self->mem->path) != 0)
                return -1;
        }
        return s;
    }
}
