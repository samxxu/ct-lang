import frontend::parse::StmtDefer;
import frontend::type::TypeCheck;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
#define CAP_LIMIT 65536
#define MAX_LABELS 64
#define B_COMMA 19
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_MOD 11
#define B_SHL 17
#define B_SHR 18
#define B_BAND 15
#define B_BOR 16
#define B_XOR 14
#define N_INDEX 26
#define N_CALL 7
#define N_MCALL 30
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BLOCK 4
#define N_CLOSURE 59
#define N_BREAK 38
#define N_CASE 43
#define N_CONT 39
#define N_DECL 12
#define N_DECLS 40
#define N_DELETE 41
#define N_DEREF 28
#define N_DOWHILE 44
#define N_EMPTY 52
#define N_SASSERT 55
#define N_EXPR 6
#define N_FOR 16
#define N_GOTO 50
#define N_IF 14
#define N_INIT_RANGE 61
#define N_MATSEQ 73
#define N_INIT_BRACE 65
#define N_INIT_ITEM 66
#define N_DEFER 69
#define N_DEFER_RUN 70
#define N_INIT_MBRACE 67
#define N_LABEL 49
#define N_LOOP 60
#define N_FOREACH 62
#define N_MEMBER 24
#define N_NUM 8
#define N_STR 9
#define N_UNARY 17
#define N_POST 18
#define N_PRE 57
#define N_ADDR 27
#define N_RAW 31
#define N_RET 5
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_SWITCH 42
#define N_MATCH 78
#define N_ARM 79
#define N_BIND 80
#define N_VAR 10
#define N_WHILE 15
#define N_INTO 63
#define N_INTO_SELF 64
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define CT_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct StmtMatch {
    int unused;
}

/* S1a-0 C2p-6: the comparison key as a pool text. The old fixed 160-byte key
   row cut two arm types that differ after byte 159 down to one key; the
   growable `type_key_text` keeps them apart. */
pub const char *match_expr_type_key_text(const char *in)
{
    const char *k;

    k = frontend::type::type_key_text(in);
    if (!k) return (const char *)0;
    if (strncmp(k, "struct", 6) == 0) k += 6;
    else if (strncmp(k, "union", 5) == 0) k += 5;
    else if (strncmp(k, "enum", 4) == 0) k += 4;
    return runtime::text::ct_intern(k);
}

/* ------------------------------------------------------------------------- */
/* v1-PH-2 S5: the pattern scratch is a DNF of alternatives.                  */
/*                                                                            */
/* One arm at a time: the subject kind is fixed by `pat_begin`; the recursive */
/* reader appends runtime tests (`path=value;` rows) and bindings (name /     */
/* type / access path) to every alternative in the current set, and `|` forks */
/* the set. An `|` at any depth multiplies the alternatives, so the final     */
/* set is the disjunctive normal form of the arm's pattern: each group is one */
/* conjunction of tests. `pat_bind_finish` checks that all alternatives bind  */
/* the same names with the same types; `pat_commit` turns the prepared rows   */
/* into the N_BIND -> N_DECL/N_RAW chain the emitter already reads.            */
/*                                                                            */
/* The emitter ORs the group conditions and picks a binding accessor per      */
/* group when the alternatives read the same name from different payloads.    */
/* The pattern descriptors are N_BIND rows hung off `N_ARM.d` only; no        */
/* statement or expression walker reaches them.                               */
/* ------------------------------------------------------------------------- */
#define PAT_VARIANT 1
#define PAT_STRUCT  2
#define PAT_LITERAL 3
#define PAT_WILD    4
#define PAT_BINDER  5
#define PAT_FIELD   6
#define PAT_OR      7

#define PAT_K_OTHER 0
#define PAT_K_ADT   1
#define PAT_K_STRUCT 2
#define PAT_K_INT   3
#define PAT_K_PTR   4

/* One binding of one alternative: name, declared type and the accessor after
   the match temporary (`.` / `->`, `*` for a pointer subject bound whole). */
struct PatBind {
    const char *name;
    const char *type;
    const char *path;
};

/* One DNF alternative: a conjunction of `path=value;` rows, its canonical
   spelling for duplicate detection, and the bindings it introduces. */
struct PatGroup {
    char *conds;
    int condlen;
    int condcap;
    char *sig;
    int siglen;
    int sigcap;
    int root_form;              /* the root atom's PAT_* form, 0 when unset */
    int root_variant;           /* root variant index, -1 */
    struct PatBind *binds;
    int nbinds;
    int bcap;
};

struct PatCtx {
    int adt;                    /* subject ADT row, -1 for a non-ADT subject */
    const char *subject_type;   /* the subject type spelling */
    int is_ptr;                 /* the subject spelling ended in `*` */
    int non_adt;                /* statement match on a struct / integer value */
    int bind_head;
    struct PatGroup *grp;       /* the current alternative set */
    int ngrp;
    int grpcap;
    const char **bname;         /* prepared binding rows for pat_commit */
    const char **btype;
    const char **bpath;
    int nbind;
    int bcap;
    const char *arm_conds;      /* interned arm condition text (groups, `|`) */
    const char *arm_sig;        /* interned duplicate-detection signature */
    const char *cbase;          /* pat_classify's stripped base, pooled */
};

static struct PatCtx g_pat;

static int pat_int_base(const char *b);

static int pat_buf_put(char **buf, int *len, int *cap, const char *s)
{
    int n, need, ncap;
    char *grown;

    n = (int)strlen(s);
    need = *len + n + 1;
    if (need > *cap) {
        ncap = *cap > 0 ? *cap : 128;
        while (ncap < need && ncap < CAP_LIMIT) ncap *= 2;
        if (ncap < need) return -1;
        grown = (char *)realloc(*buf, (size_t)ncap);
        if (!grown) return -1;
        *buf = grown;
        *cap = ncap;
    }
    memcpy(*buf + *len, s, (size_t)n);
    *len += n;
    (*buf)[*len] = 0;
    return 0;
}

static void pat_group_clear(struct PatGroup *g)
{
    free(g->conds);
    free(g->sig);
    free((void *)g->binds);
    g->conds = (char *)0;
    g->condlen = 0;
    g->condcap = 0;
    g->sig = (char *)0;
    g->siglen = 0;
    g->sigcap = 0;
    g->binds = (struct PatBind *)0;
    g->nbinds = 0;
    g->bcap = 0;
    g->root_form = 0;
    g->root_variant = -1;
}

static void pat_groups_clear(struct PatGroup *grp, int n)
{
    int i;

    if (!grp) return;
    for (i = 0; i < n; i++) pat_group_clear(&grp[i]);
    free(grp);
}

static int pat_group_init(struct PatGroup *g)
{
    g->conds = (char *)0;
    g->condlen = 0;
    g->condcap = 0;
    g->sig = (char *)0;
    g->siglen = 0;
    g->sigcap = 0;
    g->binds = (struct PatBind *)0;
    g->nbinds = 0;
    g->bcap = 0;
    g->root_form = 0;
    g->root_variant = -1;
    if (pat_buf_put(&g->conds, &g->condlen, &g->condcap, "")) return -1;
    if (pat_buf_put(&g->sig, &g->siglen, &g->sigcap, "")) return -1;
    return 0;
}

/* Allocate `n` empty groups (a fresh alternative set). */
static int pat_groups_alloc(int n, struct PatGroup **out)
{
    struct PatGroup *g;
    int i;

    if (n <= 0) n = 1;
    g = (struct PatGroup *)calloc((size_t)n, sizeof(*g));
    if (!g) return -1;
    for (i = 0; i < n; i++)
        if (pat_group_init(&g[i])) { pat_groups_clear(g, n); return -1; }
    *out = g;
    return 0;
}

static int pat_group_copy(struct PatGroup *dst, const struct PatGroup *src)
{
    dst->conds = (char *)0;
    dst->condlen = 0;
    dst->condcap = 0;
    dst->sig = (char *)0;
    dst->siglen = 0;
    dst->sigcap = 0;
    dst->binds = (struct PatBind *)0;
    dst->nbinds = 0;
    dst->bcap = 0;
    dst->root_form = src->root_form;
    dst->root_variant = src->root_variant;
    if (pat_buf_put(&dst->conds, &dst->condlen, &dst->condcap,
                    src->conds ? src->conds : "")) return -1;
    if (pat_buf_put(&dst->sig, &dst->siglen, &dst->sigcap,
                    src->sig ? src->sig : "")) return -1;
    if (src->nbinds > 0) {
        dst->binds = (struct PatBind *)malloc(
            (size_t)src->nbinds * sizeof(*dst->binds));
        if (!dst->binds) return -1;
        memcpy(dst->binds, src->binds,
               (size_t)src->nbinds * sizeof(*dst->binds));
        dst->nbinds = src->nbinds;
        dst->bcap = src->nbinds;
    }
    return 0;
}

/* Deep copy of a whole alternative set. */
static int pat_groups_copy(struct PatGroup **out, int *nout,
                           const struct PatGroup *src, int n)
{
    struct PatGroup *g;
    int i;

    if (n <= 0) n = 1;
    g = (struct PatGroup *)calloc((size_t)n, sizeof(*g));
    if (!g) return -1;
    for (i = 0; i < n; i++) {
        if (pat_group_copy(&g[i], &src[i])) {
            pat_groups_clear(g, n);
            return -1;
        }
    }
    *out = g;
    *nout = n;
    return 0;
}

/* Append copies of `src` to the accumulation set. */
static int pat_groups_append(struct PatGroup **acc, int *nacc,
                             const struct PatGroup *src, int n)
{
    struct PatGroup *grown;
    int i, base;

    if (n <= 0) return 0;
    grown = (struct PatGroup *)realloc(*acc,
                (size_t)(*nacc + n) * sizeof(*grown));
    if (!grown) return -1;
    base = *nacc;
    memset(grown + base, 0, (size_t)n * sizeof(*grown));
    for (i = 0; i < n; i++) {
        if (pat_group_copy(&grown[base + i], &src[i])) {
            pat_groups_clear(grown + base, i);
            *acc = grown;
            return -1;
        }
    }
    *acc = grown;
    *nacc = base + n;
    return 0;
}

/* Append one runtime test row to every alternative. */
static int pat_cond_add(const char *row)
{
    int i;

    for (i = 0; i < g_pat.ngrp; i++)
        if (pat_buf_put(&g_pat.grp[i].conds, &g_pat.grp[i].condlen,
                        &g_pat.grp[i].condcap, row)) return -1;
    return 0;
}

/* Append one canonical-spelling token to every alternative. */
static int pat_sig_add(const char *s)
{
    int i;

    for (i = 0; i < g_pat.ngrp; i++)
        if (pat_buf_put(&g_pat.grp[i].sig, &g_pat.grp[i].siglen,
                        &g_pat.grp[i].sigcap, s)) return -1;
    return 0;
}

/* Record the root atom form of the current alternative(s). */
static void pat_root_set(int form, int variant)
{
    int i;

    for (i = 0; i < g_pat.ngrp; i++) {
        g_pat.grp[i].root_form = form;
        g_pat.grp[i].root_variant = variant;
    }
}

/* A binding of the current alternative set: duplicate names within one
   alternative are an error (-2). */
static int pat_group_bind_add(const char *name, const char *type,
                              const char *path)
{
    int i, j;

    for (i = 0; i < g_pat.ngrp; i++) {
        struct PatGroup *g = &g_pat.grp[i];
        struct PatBind *grown;
        int ncap;

        for (j = 0; j < g->nbinds; j++)
            if (strcmp(g->binds[j].name, name) == 0) return -2;
        if (g->nbinds >= g->bcap) {
            ncap = g->bcap > 0 ? g->bcap * 2 : 8;
            if (ncap > CAP_LIMIT) return -1;
            grown = (struct PatBind *)realloc(g->binds,
                        (size_t)ncap * sizeof(*grown));
            if (!grown) return -1;
            g->binds = grown;
            g->bcap = ncap;
        }
        g->binds[g->nbinds].name = name;
        g->binds[g->nbinds].type = type;
        g->binds[g->nbinds].path = path;
        g->nbinds++;
    }
    return 0;
}

/* The test's existing type surface: only an integer-family payload can be
   re-read through a different union member for an or-pattern binding. */
static int pat_cond_bind_ok(struct Symbols *sym, const char *type)
{
    const char *r;

    if (pat_int_base(type)) return 1;
    r = sym->resolve_type_text(type);
    if (r && pat_int_base(r)) return 1;
    return 0;
}

/* Cross-alternative binding consistency and the prepared accessor rows.
   The DNF groups are the alternatives: every group must bind the same name
   set with the same types. A name read through different accessors is legal
   for an integer-family payload (the emitter emits a conditional accessor);
   anything else is refused rather than silently shallow-copied. */
static int pat_bind_finish(struct Stmt *self, int line, int col)
{
    char msgbuf[3 * MAX_TEXT];
    struct PatGroup *ref;
    int i, k, j, ncap;
    const char **grown;

    g_pat.nbind = 0;
    g_pat.bind_head = -1;
    if (g_pat.ngrp <= 0) return 0;
    ref = &g_pat.grp[0];
    for (i = 0; i < ref->nbinds; i++) {
        const char *nm = ref->binds[i].name;
        const char *ty = ref->binds[i].type;
        const char *path = ref->binds[i].path;
        int same = 1;

        for (k = 1; k < g_pat.ngrp; k++) {
            struct PatGroup *g = &g_pat.grp[k];
            int found = -1;
            for (j = 0; j < g->nbinds; j++)
                if (strcmp(g->binds[j].name, nm) == 0) { found = j; break; }
            if (found < 0) {
                snprintf(msgbuf, sizeof msgbuf,
                         "or-pattern alternatives bind different names ('%s' is missing)",
                         nm);
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            if (strcmp(g->binds[found].type, ty) != 0) {
                snprintf(msgbuf, sizeof msgbuf,
                         "or-pattern alternatives bind '%s' as different types ('%s' and '%s')",
                         nm, ty, g->binds[found].type);
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            if (strcmp(g->binds[found].path, path) != 0) same = 0;
        }
        for (k = 1; k < g_pat.ngrp; k++) {
            struct PatGroup *g = &g_pat.grp[k];
            for (j = 0; j < g->nbinds; j++) {
                int inref = 0, q;
                for (q = 0; q < ref->nbinds; q++)
                    if (strcmp(ref->binds[q].name, g->binds[j].name) == 0) {
                        inref = 1;
                        break;
                    }
                if (!inref) {
                    snprintf(msgbuf, sizeof msgbuf,
                             "or-pattern alternatives bind different names ('%s' is missing)",
                             g->binds[j].name);
                    return tool::diag::ct_sem_error(line, col, msgbuf,
                                                    self->mem->path);
                }
            }
        }
        if (!same) {
            char *enc;
            int elen, ecap;
            if (!pat_cond_bind_ok(self->sym, ty)) {
                snprintf(msgbuf, sizeof msgbuf,
                         "an or-pattern cannot bind '%s' of type '%s' at different offsets"
                         " (S5: integer payloads only)", nm, ty);
                return tool::diag::ct_sem_error(line, col, msgbuf,
                                                self->mem->path);
            }
            enc = (char *)0;
            elen = 0;
            ecap = 0;
            for (k = 0; k < g_pat.ngrp; k++) {
                char head[32];
                int found = -1, q;
                for (q = 0; q < g_pat.grp[k].nbinds; q++)
                    if (strcmp(g_pat.grp[k].binds[q].name, nm) == 0) {
                        found = q;
                        break;
                    }
                snprintf(head, sizeof head, "%s%d:", k == 0 ? "?" : ",", k);
                if (pat_buf_put(&enc, &elen, &ecap, head)
                    || pat_buf_put(&enc, &elen, &ecap,
                                   found >= 0 ? g_pat.grp[k].binds[found].path : "")) {
                    free(enc);
                    return self->sup->fail("out of memory");
                }
            }
            path = runtime::text::ct_intern(enc ? enc : "");
            free(enc);
            if (!path) return self->sup->fail("out of memory");
        }
        if (g_pat.nbind >= g_pat.bcap) {
            ncap = g_pat.bcap > 0 ? g_pat.bcap * 2 : 8;
            if (ncap > CAP_LIMIT) return -1;
            grown = (const char **)realloc((void *)g_pat.bname,
                                           (size_t)ncap * sizeof(*grown));
            if (!grown) return -1;
            g_pat.bname = grown;
            grown = (const char **)realloc((void *)g_pat.btype,
                                           (size_t)ncap * sizeof(*grown));
            if (!grown) return -1;
            g_pat.btype = grown;
            grown = (const char **)realloc((void *)g_pat.bpath,
                                           (size_t)ncap * sizeof(*grown));
            if (!grown) return -1;
            g_pat.bpath = grown;
            g_pat.bcap = ncap;
        }
        g_pat.bname[g_pat.nbind] = nm;
        g_pat.btype[g_pat.nbind] = ty;
        g_pat.bpath[g_pat.nbind] = path;
        g_pat.nbind++;
    }
    return 0;
}

/* Which variant does this alternative cover? A root variant pattern covers
   its variant only when every nested test is irrefutable, i.e. the group has
   no runtime rows left. Returns -1 when the group covers no single variant. */
static int pat_group_variant(int gi)
{
    struct PatGroup *g;

    if (gi < 0 || gi >= g_pat.ngrp) return -1;
    g = &g_pat.grp[gi];
    if (g->root_form != PAT_VARIANT || g->root_variant < 0) return -1;
    if (g->condlen != 0) return -1;
    return g->root_variant;
}

/* The variant the alternative names, covered or not (for diagnostics). */
static int pat_group_mention(int gi)
{
    struct PatGroup *g;

    if (gi < 0 || gi >= g_pat.ngrp) return -1;
    g = &g_pat.grp[gi];
    if (g->root_form != PAT_VARIANT || g->root_variant < 0) return -1;
    return g->root_variant;
}

/* Does this alternative catch every value of the subject? */
static int pat_group_catch(int gi)
{
    struct PatGroup *g;

    if (gi < 0 || gi >= g_pat.ngrp) return 0;
    g = &g_pat.grp[gi];
    if (g->root_form == PAT_WILD || g->root_form == PAT_BINDER) return 1;
    /* a struct pattern with every field unconstrained (or `..`) is a catch */
    if (g_pat.adt < 0 && g->root_form == PAT_STRUCT && g->condlen == 0) return 1;
    return 0;
}

/* Build the arm's runtime condition text and duplicate signature.
   `*arm_num` is the single root variant when every alternative names the same
   one (the caller still prints that tag test); otherwise it becomes -1 and
   every variant alternative carries its own `.tag=<v>` row so the OR set
   stays self-contained. */
static int pat_arm_finish(int *arm_num)
{
    struct PatGroup *grp;
    char *out;
    int i, len, cap, all_same, firstv;

    grp = g_pat.grp;
    *arm_num = -1;
    if (g_pat.ngrp <= 0) {
        g_pat.arm_conds = runtime::text::ct_intern("");
        g_pat.arm_sig = runtime::text::ct_intern("");
        return 0;
    }
    if (g_pat.ngrp == 1) {
        if (g_pat.adt >= 0 && grp[0].root_form == PAT_VARIANT)
            *arm_num = grp[0].root_variant;
        g_pat.arm_conds = runtime::text::ct_intern(grp[0].conds ? grp[0].conds : "");
        g_pat.arm_sig = runtime::text::ct_intern(grp[0].sig ? grp[0].sig : "");
        if (!g_pat.arm_conds || !g_pat.arm_sig) return -1;
        return 0;
    }
    all_same = 1;
    firstv = -1;
    for (i = 0; i < g_pat.ngrp; i++) {
        if (grp[i].root_form != PAT_VARIANT) { all_same = 0; continue; }
        if (firstv < 0) firstv = grp[i].root_variant;
        else if (firstv != grp[i].root_variant) all_same = 0;
    }
    if (all_same && g_pat.adt >= 0 && firstv >= 0) *arm_num = firstv;
    out = (char *)0;
    len = 0;
    cap = 0;
    for (i = 0; i < g_pat.ngrp; i++) {
        if (i > 0 && pat_buf_put(&out, &len, &cap, "|")) {
            free(out);
            return -1;
        }
        if (!all_same && grp[i].root_form == PAT_VARIANT) {
            char row[64];
            snprintf(row, sizeof row, "%stag=%d;",
                     g_pat.is_ptr ? "->" : ".", grp[i].root_variant);
            if (pat_buf_put(&out, &len, &cap, row)) { free(out); return -1; }
        }
        if (pat_buf_put(&out, &len, &cap, grp[i].conds ? grp[i].conds : "")) {
            free(out);
            return -1;
        }
    }
    g_pat.arm_conds = runtime::text::ct_intern(out ? out : "");
    free(out);
    out = (char *)0;
    len = 0;
    cap = 0;
    for (i = 0; i < g_pat.ngrp; i++) {
        if (i > 0 && pat_buf_put(&out, &len, &cap, "|")) {
            free(out);
            return -1;
        }
        if (pat_buf_put(&out, &len, &cap, grp[i].sig ? grp[i].sig : "")) {
            free(out);
            return -1;
        }
    }
    g_pat.arm_sig = runtime::text::ct_intern(out ? out : "");
    free(out);
    if (!g_pat.arm_conds || !g_pat.arm_sig) return -1;
    return 0;
}

/* A single-byte character literal: `'a'`, `'\n'`, `'\0'`. Returns the byte
   value, or -1 when the spelling is not one character / a known escape. */
static int pat_char_value(const char *p, int len)
{
    char c;

    if (len < 3 || p[0] != '\'' || p[len - 1] != '\'') return -1;
    if (len == 3) return (unsigned char)p[1];
    if (p[1] != '\\' || len != 4) return -1;
    c = p[2];
    if (c == 'n') return '\n';
    if (c == 't') return '\t';
    if (c == 'r') return '\r';
    if (c == '0') return 0;
    if (c == '\\') return '\\';
    if (c == '\'') return '\'';
    if (c == '"') return '"';
    if (c == 'a') return 7;
    if (c == 'b') return 8;
    if (c == 'f') return 12;
    if (c == 'v') return 11;
    return -1;
}

/* Is the stripped base spelling an integer-family C type? The list is the
   type surface `match` accepts for a literal pattern; a typedef alias that
   resolves to one of these reaches the same row through `resolve_type_text`
   only for the spellings Ct itself emits. */
static int pat_int_base(const char *b)
{
    static const char *names[] = {
        "int", "char", "bool", "_Bool", "short", "long", "signed",
        "unsigned", "int8_t", "int16_t", "int32_t", "int64_t",
        "uint8_t", "uint16_t", "uint32_t", "uint64_t",
        "size_t", "ssize_t", "ptrdiff_t", "intptr_t", "uintptr_t",
        "char16_t", "char32_t", (const char *)0
    };
    int i, j;
    char buf[256];
    int n;

    n = (int)strlen(b);
    if (n <= 0 || n >= (int)sizeof(buf)) return 0;
    for (i = 0; i <= n; i++) {
        char c = (i < n) ? b[i] : ' ';
        buf[i] = (c == '\t' || c == '\n' || c == '\r') ? ' ' : c;
    }
    /* collapse repeated spaces so `unsigned   long` matches the table */
    j = 0;
    for (i = 0; i < n; i++) {
        if (buf[i] == ' ' && j > 0 && buf[j - 1] == ' ') continue;
        buf[j++] = buf[i];
    }
    buf[j] = 0;
    while (j > 0 && buf[j - 1] == ' ') buf[--j] = 0;
    for (i = 0; names[i]; i++)
        if (strcmp(buf, names[i]) == 0) return 1;
    /* the multi-word integer spellings */
    if (strcmp(buf, "unsigned int") == 0 || strcmp(buf, "unsigned char") == 0
        || strcmp(buf, "unsigned short") == 0 || strcmp(buf, "unsigned long") == 0
        || strcmp(buf, "long long") == 0 || strcmp(buf, "unsigned long long") == 0
        || strcmp(buf, "signed int") == 0 || strcmp(buf, "signed char") == 0
        || strcmp(buf, "signed short") == 0 || strcmp(buf, "signed long") == 0
        || strcmp(buf, "long int") == 0 || strcmp(buf, "short int") == 0)
        return 1;
    return 0;
}

impl StmtMatch for Stmt {
    int pat_begin(int adt, const char *subject_type, int is_ptr)
    {
        pat_groups_clear(g_pat.grp, g_pat.ngrp);
        free((void *)g_pat.bname);
        free((void *)g_pat.btype);
        free((void *)g_pat.bpath);
        g_pat.adt = adt;
        g_pat.subject_type = runtime::text::ct_intern(subject_type ? subject_type : "");
        g_pat.is_ptr = is_ptr;
        g_pat.non_adt = adt < 0;
        g_pat.bind_head = -1;
        g_pat.grp = (struct PatGroup *)0;
        g_pat.ngrp = 0;
        g_pat.grpcap = 0;
        g_pat.bname = (const char **)0;
        g_pat.btype = (const char **)0;
        g_pat.bpath = (const char **)0;
        g_pat.nbind = 0;
        g_pat.bcap = 0;
        g_pat.arm_conds = "";
        g_pat.arm_sig = "";
        g_pat.cbase = "";
        if (pat_groups_alloc(1, &g_pat.grp)) return -1;
        g_pat.ngrp = 1;
        g_pat.grpcap = 1;
        return 0;
    }

    /* The kind of `type` (PAT_K_*) and its stripped base in g_pat.cbase.
       `adt_out` / `si_out` get the ADT / struct row and `is_ptr_out` the
       trailing-`*` fact. The base is what a struct pattern names and what an
       ADT row is looked up by. */
    int pat_classify(const char *type, int *adt_out, int *si_out, int *is_ptr_out)
    {
        char *buf;
        int n, adt, si, ptr, result;
        const char *b;
        const char *res;

        adt = -1;
        si = -1;
        ptr = 0;
        if (!type) type = "";
        n = (int)strlen(type);
        buf = (char *)malloc((size_t)n + 1);
        if (!buf) return PAT_K_OTHER;
        memcpy(buf, type, (size_t)n + 1);
        while (n > 0 && (buf[n - 1] == ' ' || buf[n - 1] == '\t'
                         || buf[n - 1] == '\n' || buf[n - 1] == '\r')) buf[--n] = 0;
        while (n > 0 && buf[n - 1] == '*') {
            ptr = 1;
            buf[--n] = 0;
            while (n > 0 && (buf[n - 1] == ' ' || buf[n - 1] == '\t')) buf[--n] = 0;
        }
        b = buf;
        for (;;) {
            if (strncmp(b, "const ", 6) == 0) { b += 6; continue; }
            if (strncmp(b, "volatile ", 9) == 0) { b += 9; continue; }
            if (strncmp(b, "restrict ", 9) == 0) { b += 9; continue; }
            break;
        }
        while (*b == ' ' || *b == '\t') b++;
        *adt_out = -1;
        *si_out = -1;
        *is_ptr_out = ptr;
        result = PAT_K_OTHER;
        /* an ADT tag is `struct T` too, so try the whole spelling first */
        adt = frontend::sym::ct_adt_from_type(b);
        if (adt < 0) {
            res = self->sym->resolve_type_text(b);
            if (res && res[0]) {
                const char *r = res;
                if (strncmp(r, "struct ", 7) == 0) r += 7;
                else if (strncmp(r, "union ", 6) == 0) r += 6;
                else if (strncmp(r, "enum ", 5) == 0) r += 5;
                adt = frontend::sym::ct_adt_from_type(r);
                if (adt < 0) si = self->sym->find_struct(r);
            }
        }
        if (adt < 0 && si < 0) {
            if (strncmp(b, "struct ", 7) == 0) {
                const char *base = b + 7;
                si = self->sym->find_struct(base);
                if (si < 0) {
                    const char *rr = self->sym->resolve_type_text(base);
                    if (rr && strncmp(rr, "struct ", 7) == 0)
                        si = self->sym->find_struct(rr + 7);
                }
                g_pat.cbase = runtime::text::ct_intern(base);
            } else if (strncmp(b, "union ", 6) == 0 || strncmp(b, "enum ", 5) == 0) {
                g_pat.cbase = runtime::text::ct_intern(b);
            } else {
                si = self->sym->find_struct(b);
                g_pat.cbase = runtime::text::ct_intern(b);
            }
        } else {
            const char *tag = b;
            if (strncmp(tag, "struct ", 7) == 0) tag += 7;
            g_pat.cbase = runtime::text::ct_intern(tag);
        }
        if (!g_pat.cbase) { free(buf); return PAT_K_OTHER; }
        *adt_out = adt;
        *si_out = si;
        if (adt >= 0) result = PAT_K_ADT;
        else if (si >= 0) result = PAT_K_STRUCT;
        else if (ptr) result = PAT_K_PTR;
        else if (pat_int_base(b)) result = PAT_K_INT;
        free(buf);
        return result;
    }

    int pat_desc(int form, const char *text, const char *text2, long num)
    {
        int id;

        id = self->sup->new_node(N_BIND);
        if (id < 0) return -1;
        self->arena->nodes[id].aux = form;
        self->arena->nodes[id].text = text ? text : "";
        self->arena->nodes[id].text2 = text2 ? text2 : "";
        self->arena->nodes[id].num = num;
        self->arena->nodes[id].a = -1;
        self->arena->nodes[id].b = 0;
        self->arena->nodes[id].next = -1;
        self->arena->nodes[id].line = self->lex->tokline;
        self->arena->nodes[id].num = num;
        return id;
    }

    /* v1-PH-2 S5: one pattern, possibly an or-pattern. The first alternative
       is parsed against the current set, then every `|` forks a fresh copy of
       that base and the alternatives are concatenated (DNF). Bindings are
       merged per alternative; `pat_bind_finish` checks them. */
    int pat_parse_one(const char *type, const char *path)
    {
        struct PatGroup *base;
        struct PatGroup *acc;
        int nbase, nacc, rc;

        if (pat_groups_copy(&base, &nbase, g_pat.grp, g_pat.ngrp)) return -1;
        rc = self->pat_parse_atom(type, path);
        if (rc < 0) { pat_groups_clear(base, nbase); return -1; }
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("|")))
            { pat_groups_clear(base, nbase); return rc; }
        acc = (struct PatGroup *)0;
        nacc = 0;
        if (pat_groups_append(&acc, &nacc, g_pat.grp, g_pat.ngrp)) {
            pat_groups_clear(base, nbase);
            return -1;
        }
        while (self->lex->tok == T_PUNCT && self->lex->tok_is("|")) {
            self->sup->lex_next();
            pat_groups_clear(g_pat.grp, g_pat.ngrp);
            g_pat.grp = (struct PatGroup *)0;
            g_pat.ngrp = 0;
            if (pat_groups_copy(&g_pat.grp, &g_pat.ngrp, base, nbase)) {
                pat_groups_clear(acc, nacc);
                pat_groups_clear(base, nbase);
                return -1;
            }
            rc = self->pat_parse_atom(type, path);
            if (rc < 0) {
                pat_groups_clear(acc, nacc);
                pat_groups_clear(base, nbase);
                return -1;
            }
            if (pat_groups_append(&acc, &nacc, g_pat.grp, g_pat.ngrp)) {
                pat_groups_clear(acc, nacc);
                pat_groups_clear(base, nbase);
                return -1;
            }
        }
        pat_groups_clear(g_pat.grp, g_pat.ngrp);
        g_pat.grp = acc;
        g_pat.ngrp = nacc;
        g_pat.grpcap = nacc;
        pat_groups_clear(base, nbase);
        return rc;
    }

    /* One pattern atom at `path` (empty = the subject itself, otherwise `.f` /
       `->f` accessors). Appends the runtime test rows to every current
       alternative and the bindings to every alternative; sets the root form on
       the alternatives when this is the arm's root atom. */
    int pat_parse_atom(const char *type, const char *path)
    {
        int line, col, kind, adt, si, ptr, id, first, last, i, rc;
        int gpat, adt_override;
        const char *bname;
        const char *gtb;
        char msgbuf[3 * MAX_TEXT];
        char lit[64];

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        kind = self->pat_classify(type, &adt, &si, &ptr);
        if (kind == PAT_K_PTR) {
            /* a pointer payload can only be bound whole or ignored */
            if (self->lex->tok != T_ID)
                return tool::diag::ct_sem_error(line, col,
                    "a pointer payload cannot be matched by a pattern (use '_' or bind the whole value)",
                    self->mem->path);
        }
        if (self->lex->tok == T_ID && self->lex->tok_is("_")) {
            self->sup->lex_next();
            id = self->pat_desc(PAT_WILD, "", "", 0);
            if (id < 0) return -1;
            self->arena->nodes[id].b = 1;
            if (pat_sig_add("*")) return -1;
            if (path[0] == 0) pat_root_set(PAT_WILD, -1);
            return id;
        }
        if (self->lex->tok == T_NUM
            || (self->lex->tok == T_PUNCT && self->lex->tok_is("-"))
            || (self->lex->tok == T_STR
                && self->lex->tokstr.len > 0
                && self->lex->tokstr.ptr[0] == '\'')) {
            long val;
            int is_char, neg;

            neg = 0;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("-")) {
                neg = 1;
                self->sup->lex_next();
                if (self->lex->tok != T_NUM)
                    return self->sup->fail("expected an integer after '-' in a pattern");
            }
            is_char = !neg && self->lex->tok == T_STR;
            if (is_char) {
                char cview[MAX_TEXT];
                val = pat_char_value(self->lex->tokstr.ptr, self->lex->tokstr.len);
                if (val < 0)
                    return self->sup->fail("expected a one-character pattern literal");
                if (self->lex->tok_copy(cview, (int)sizeof cview) != 0)
                    return self->sup->fail("a character pattern literal is too long");
                snprintf(lit, sizeof lit, "'%s'", cview);
            } else {
                if (self->lex->tokfloat)
                    return self->sup->fail("a floating literal cannot be a pattern");
                val = self->lex->toknum;
                if (neg) val = -val;
                snprintf(lit, sizeof lit, "%ld", val);
            }
            if (kind != PAT_K_INT) {
                snprintf(msgbuf, sizeof msgbuf,
                         "literal pattern '%s' does not match type '%s'", lit, type);
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            self->sup->lex_next();
            id = self->pat_desc(PAT_LITERAL, runtime::text::ct_intern(lit), "", val);
            if (id < 0) return -1;
            self->arena->nodes[id].b = 0;
            snprintf(msgbuf, sizeof msgbuf, "#%ld", val);
            if (pat_sig_add(msgbuf)) return -1;
            if (path[0] != 0) {
                size_t need;
                char *row;
                need = strlen(path) + strlen(msgbuf) + 4;
                row = (char *)malloc(need);
                if (!row) return self->sup->fail("out of memory");
                snprintf(row, need, "%s=%ld;", path, val);
                rc = pat_cond_add(row);
                free(row);
                if (rc) return -1;
            } else {
                snprintf(msgbuf, sizeof msgbuf, "=%ld;", val);
                if (g_pat.non_adt && pat_cond_add(msgbuf)) return -1;
            }
            if (path[0] == 0) pat_root_set(PAT_LITERAL, -1);
            return id;
        }
        if (self->lex->tok == T_STR && self->lex->tokstr.len > 0
            && self->lex->tokstr.ptr[0] == '"')
            return tool::diag::ct_sem_error(line, col,
                "string literal patterns are not supported (S4: int/char/bool only)",
                self->mem->path);
        if (self->lex->tok != T_ID)
            return tool::diag::ct_sem_error(line, col, "expected a pattern",
                                            self->mem->path);
        /* v1-PH-2 S6: `Opt<int>.Some(v)` names the instance explicitly. The
           raw source decides before the token is consumed, because the type
           reader starts at the identifier; `Opt.Some(v)` (the inferred form)
           keeps the old path. */
        gpat = 0;
        adt_override = -1;
        {
            const char *gp = self->lex->src + self->lex->tokstart
                             + self->lex->tokstr.len;
            while (*gp == ' ' || *gp == '\t' || *gp == '\n' || *gp == '\r') gp++;
            if (*gp == '<') {
                int gd = 0;
                for (;;) {
                    if (!*gp) break;
                    if (*gp == '<') gd++;
                    else if (*gp == '>') {
                        gd--;
                        gp++;
                        if (gd == 0) break;
                        continue;
                    }
                    gp++;
                }
                while (*gp == ' ' || *gp == '\t' || *gp == '\n' || *gp == '\r')
                    gp++;
                if (*gp == '.') gpat = 1;
            }
        }
        if (gpat) {
            int nadts2;
            struct Adt *adts2;
            if (self->ex->parse_type_text(&gtb) != 0) return -1;
            adt_override = frontend::sym::ct_adt_from_type(gtb);
            if (adt_override < 0) {
                const char *lt = strchr(gtb, '<');
                if (lt) {
                    gtb = runtime::text::ct_intern_len(gtb, (int)(lt - gtb));
                    if (!gtb) return self->sup->fail("out of memory");
                    adt_override = frontend::sym::ct_adt_find(gtb);
                }
            }
            if (adt_override < 0)
                return tool::diag::ct_sem_error(line, col,
                    tool::sh::ct_scratch_fmt("'%s' is not an ADT", gtb),
                    self->mem->path);
            adts2 = frontend::sym::ct_adts(&nadts2);
            if (!adts2 || adt_override >= nadts2)
                return self->sup->fail("the ADT row is missing");
            bname = adts2[adt_override].full;
        } else {
            bname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!bname) return self->sup->fail("out of memory");
            self->sup->lex_next();
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is(".")) {
            /* a variant pattern */
            const char *vname;
            int v;
            struct Adt *adts;
            int nadts;

            if (kind != PAT_K_ADT) {
                int other;
                other = frontend::sym::ct_adt_from_type(bname);
                if (other < 0)
                    snprintf(msgbuf, sizeof msgbuf,
                             "match arm names '%s', which is not an ADT", bname);
                else
                    snprintf(msgbuf, sizeof msgbuf,
                             "match arm names ADT '%s', but the subject is '%s'",
                             bname, type);
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            {
                const char *rn;
                int other;
                rn = self->sym->resolve_type_text(bname);
                if (!rn) rn = bname;
                other = frontend::sym::ct_adt_from_type(rn);
                if (other < 0) {
                    snprintf(msgbuf, sizeof msgbuf,
                             "match arm names '%s', which is not an ADT", bname);
                    return tool::diag::ct_sem_error(line, col, msgbuf,
                                                    self->mem->path);
                }
                if (other != adt) {
                    adts = frontend::sym::ct_adts(&nadts);
                    /* v1-PH-2 S6: `Opt.Some(v)` names the template while the
                       subject is `Opt<int>`. The pattern is about the same
                       declared sum type, so it reads the subject's concrete
                       variant rows (the variant order is the template's). */
                    if (adts && other >= 0 && other < nadts
                        && adt >= 0 && adt < nadts
                        && adts[other].is_template
                        && adts[adt].tmpl == other) {
                        other = adt;
                    } else if (adts && other >= 0 && other < nadts
                               && adt >= 0 && adt < nadts
                               && adts[adt].is_template
                               && adts[other].tmpl == adt) {
                        other = adt;
                    }
                }
                if (other != adt) {
                    adts = frontend::sym::ct_adts(&nadts);
                    snprintf(msgbuf, sizeof msgbuf,
                             "match arm names ADT '%s', but the subject is '%s'",
                             adts[other].name, adts[adt].name);
                    return tool::diag::ct_sem_error(line, col, msgbuf,
                                                    self->mem->path);
                }
            }
            self->sup->lex_next();
            if (self->lex->tok != T_ID)
                return self->sup->fail("expected a variant name");
            vname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                 self->lex->tokstr.len);
            if (!vname) return self->sup->fail("out of memory");
            v = frontend::sym::ct_adt_variant(adt, vname);
            if (v < 0) {
                adts = frontend::sym::ct_adts(&nadts);
                snprintf(msgbuf, sizeof msgbuf, "unknown variant '%s' of ADT '%s'",
                         vname, adts[adt].name);
                return tool::diag::ct_sem_error(
                    self->lex->tokline,
                    self->lex->tokstart - self->lex->lstart + 1, msgbuf,
                    self->mem->path);
            }
            adts = frontend::sym::ct_adts(&nadts);
            self->sup->lex_next();
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("(")))
                return self->sup->fail("expected '(' after a variant name");
            self->sup->lex_next();
            id = self->pat_desc(PAT_VARIANT, vname,
                                adts[adt].variants[v].cname, v);
            if (id < 0) return -1;
            first = -1;
            last = -1;
            snprintf(msgbuf, sizeof msgbuf, "V%d(", v);
            if (pat_sig_add(msgbuf)) return -1;
            if (path[0] != 0) {
                /* the inner tag test goes before the payload tests so the C
                   union read always follows its discriminator */
                size_t need;
                char *row;
                need = strlen(path) + 32;
                row = (char *)malloc(need);
                if (!row) return self->sup->fail("out of memory");
                snprintf(row, need, "%s.tag=%d;", path, v);
                rc = pat_cond_add(row);
                free(row);
                if (rc) return -1;
            }
            for (i = 0; i < adts[adt].variants[v].nfields; i++) {
                char *cp;
                size_t need;
                const char *sep;
                int child;

                if (i > 0) {
                    if (!self->sup->accept(",")) {
                        snprintf(msgbuf, sizeof msgbuf,
                                 "match arm for '%s.%s' binds %d name%s, but the variant has %d field%s",
                                 adts[adt].name, vname, i, i == 1 ? "" : "s",
                                 adts[adt].variants[v].nfields,
                                 adts[adt].variants[v].nfields == 1 ? "" : "s");
                        return tool::diag::ct_sem_error(line, col, msgbuf,
                                                        self->mem->path);
                    }
                }
                sep = (path[0] == 0) ? (g_pat.is_ptr ? "->" : ".") : ".";
                need = strlen(path) + strlen(sep) + strlen(adts[adt].variants[v].cname)
                       + strlen(adts[adt].variants[v].fields[i].name) + 8;
                cp = (char *)malloc(need);
                if (!cp) return self->sup->fail("out of memory");
                snprintf(cp, need, "%s%su.%s.%s", path, sep,
                         adts[adt].variants[v].cname,
                         adts[adt].variants[v].fields[i].name);
                child = self->pat_parse_one(adts[adt].variants[v].fields[i].type, cp);
                free(cp);
                if (child < 0) return -1;
                if (first < 0) first = child;
                else self->arena->nodes[last].next = child;
                last = child;
                if (!self->arena->nodes[child].b) self->arena->nodes[id].b = 0;
                else if (i == 0 && adts[adt].variants[v].nfields > 0) {
                    /* keep the flag; a later refutable child clears it */
                }
            }
            if (self->sup->accept(",")) { /* trailing comma */ }
            if (!(self->lex->tok == T_PUNCT && self->lex->tok_is(")"))) {
                snprintf(msgbuf, sizeof msgbuf,
                         "match arm for '%s.%s' binds %d name%s, but the variant has %d field%s",
                         adts[adt].name, vname,
                         adts[adt].variants[v].nfields + 1,
                         adts[adt].variants[v].nfields + 1 == 1 ? "" : "s",
                         adts[adt].variants[v].nfields,
                         adts[adt].variants[v].nfields == 1 ? "" : "s");
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            if (self->sup->expect(")") != 0) return -1;
            if (adts[adt].variants[v].nfields > 0) {
                int all = 1;
                int q;
                for (q = first; q >= 0; q = self->arena->nodes[q].next) {
                    if (!self->arena->nodes[q].b) all = 0;
                }
                self->arena->nodes[id].b = all;
            } else {
                self->arena->nodes[id].b = 1;
            }
            /* A nested variant pattern is refutable unless the inner ADT has a
               single variant: `One(Val.Leaf(n))` says nothing about the other
               `Val` variants. At the arm root the flag means "covers this
               variant", so the single-variant restriction does not apply. */
            if (path[0] != 0 && adts[adt].nvariants > 1)
                self->arena->nodes[id].b = 0;
            self->arena->nodes[id].a = first;
            if (pat_sig_add(")")) return -1;
            if (path[0] == 0) pat_root_set(PAT_VARIANT, v);
            return id;
        }
        if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
            /* a struct pattern */
            struct StructDef *sd;
            int seen_n, rest, any_refutable;
            int *seen;

            if (kind != PAT_K_STRUCT) {
                int other;
                other = self->sym->find_struct(bname);
                if (other < 0)
                    snprintf(msgbuf, sizeof msgbuf,
                             "struct pattern names '%s', which is not a declared struct",
                             bname);
                else
                    snprintf(msgbuf, sizeof msgbuf,
                             "struct pattern names '%s', but the subject is '%s'",
                             bname, type);
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            sd = &self->sym->structs[si];
            if (strcmp(bname, sd->name) != 0 && strcmp(bname, g_pat.cbase) != 0) {
                /* an alias spelling (`typedef struct Point P`) is legal too */
                const char *rr;
                char rbase[512];
                rr = self->sym->resolve_type_text(bname);
                if (!rr) rr = bname;
                if (strncmp(rr, "struct ", 7) == 0) rr += 7;
                snprintf(rbase, sizeof rbase, "%s", rr);
                if (strcmp(rbase, sd->name) != 0) {
                    snprintf(msgbuf, sizeof msgbuf,
                             "struct pattern names '%s', but the subject is '%s'",
                             bname, type);
                    return tool::diag::ct_sem_error(line, col, msgbuf,
                                                    self->mem->path);
                }
            }
            self->sup->lex_next();
            id = self->pat_desc(PAT_STRUCT, sd->name, type, 0);
            if (id < 0) return -1;
            snprintf(msgbuf, sizeof msgbuf, "S%d{", si);
            if (pat_sig_add(msgbuf)) return -1;
            seen = (int *)calloc((size_t)(sd->nfields > 0 ? sd->nfields : 1),
                                 sizeof(*seen));
            if (!seen) return self->sup->fail("out of memory");
            first = -1;
            last = -1;
            seen_n = 0;
            rest = 0;
            any_refutable = 0;
            for (;;) {
                int fi, child, wrap;
                const char *fname;

                if (self->lex->tok == T_PUNCT && self->lex->tok_is("..")) {
                    self->sup->lex_next();
                    rest = 1;
                    break;
                }
                if (self->lex->tok == T_PUNCT && self->lex->tok_is("}")) break;
                if (self->lex->tok != T_ID) {
                    free(seen);
                    return self->sup->fail("expected a struct pattern field");
                }
                fname = runtime::text::ct_intern_len(self->lex->tokstr.ptr,
                                                     self->lex->tokstr.len);
                if (!fname) { free(seen); return self->sup->fail("out of memory"); }
                fi = -1;
                {
                    int q;
                    for (q = 0; q < sd->nfields; q++)
                        if (strcmp(sd->fields[q].name, fname) == 0) { fi = q; break; }
                }
                if (fi < 0) {
                    snprintf(msgbuf, sizeof msgbuf,
                             "unknown field '%s' in a struct pattern for '%s'",
                             fname, sd->name);
                    free(seen);
                    return tool::diag::ct_sem_error(
                        self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1, msgbuf,
                        self->mem->path);
                }
                if (seen[fi]) {
                    snprintf(msgbuf, sizeof msgbuf,
                             "duplicate field '%s' in a struct pattern", fname);
                    free(seen);
                    return tool::diag::ct_sem_error(
                        self->lex->tokline,
                        self->lex->tokstart - self->lex->lstart + 1, msgbuf,
                        self->mem->path);
                }
                seen[fi] = 1;
                seen_n++;
                self->sup->lex_next();
                if (self->lex->tok == T_PUNCT && self->lex->tok_is(":")) {
                    char *fp;
                    size_t need;
                    const char *sep;
                    self->sup->lex_next();
                    sep = (path[0] == 0) ? (g_pat.is_ptr ? "->" : ".") : ".";
                    need = strlen(path) + strlen(sep) + strlen(sd->fields[fi].name) + 8;
                    fp = (char *)malloc(need);
                    if (!fp) { free(seen); return self->sup->fail("out of memory"); }
                    snprintf(fp, need, "%s%s%s", path, sep, sd->fields[fi].name);
                    child = self->pat_parse_one(sd->fields[fi].type, fp);
                    free(fp);
                } else {
                    char *fp;
                    size_t need;
                    const char *sep;
                    sep = (path[0] == 0) ? (g_pat.is_ptr ? "->" : ".") : ".";
                    need = strlen(path) + strlen(sep) + strlen(sd->fields[fi].name) + 8;
                    fp = (char *)malloc(need);
                    if (!fp) { free(seen); return self->sup->fail("out of memory"); }
                    snprintf(fp, need, "%s%s%s", path, sep, sd->fields[fi].name);
                    child = self->pat_desc(PAT_BINDER, fname, sd->fields[fi].type, 0);
                    if (child >= 0 && pat_group_bind_add(fname, sd->fields[fi].type,
                                                   runtime::text::ct_intern(fp)) == -2) {
                        free(fp);
                        free(seen);
                        snprintf(msgbuf, sizeof msgbuf,
                                 "duplicate binding '%s' in a match arm", fname);
                        return tool::diag::ct_sem_error(line, col, msgbuf,
                                                        self->mem->path);
                    }
                    free(fp);
                    if (child >= 0) self->arena->nodes[child].b = 1;
                    if (pat_sig_add("*")) {
                        free(seen);
                        return -1;
                    }
                }
                if (child < 0) { free(seen); return -1; }
                wrap = self->pat_desc(PAT_FIELD, fname, sd->fields[fi].type, fi);
                if (wrap < 0) { free(seen); return -1; }
                self->arena->nodes[wrap].a = child;
                self->arena->nodes[wrap].b = self->arena->nodes[child].b;
                if (!self->arena->nodes[child].b) any_refutable = 1;
                snprintf(msgbuf, sizeof msgbuf, "%d:", fi);
                if (pat_sig_add(msgbuf)) {
                    free(seen);
                    return -1;
                }
                if (first < 0) first = wrap;
                else self->arena->nodes[last].next = wrap;
                last = wrap;
                if (self->sup->accept(",")) continue;
                break;
            }
            if (self->sup->expect("}") != 0) { free(seen); return -1; }
            if (!rest && seen_n != sd->nfields) {
                int q;
                for (q = 0; q < sd->nfields; q++)
                    if (!seen[q]) break;
                snprintf(msgbuf, sizeof msgbuf,
                         "struct pattern for '%s' is missing field '%s' (name it or write '..')",
                         sd->name, sd->fields[q].name);
                free(seen);
                return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
            }
            free(seen);            /* A struct pattern is irrefutable when every field is constrained
               by an irrefutable subpattern; `..` leaves the rest unconstrained
               and is therefore still irrefutable. */
            self->arena->nodes[id].b = any_refutable ? 0 : 1;
            self->arena->nodes[id].a = first;
            if (pat_sig_add("}")) return -1;
            if (path[0] == 0) pat_root_set(PAT_STRUCT, -1);
            return id;
        }
        /* a binder */
        if (kind == PAT_K_ADT || kind == PAT_K_STRUCT) {
            /* a bare name binds the whole value; this is allowed */
        }
        id = self->pat_desc(PAT_BINDER, bname, type, 0);
        if (id < 0) return -1;
        self->arena->nodes[id].b = 1;
        {
            const char *bp;
            if (path[0] == 0 && g_pat.is_ptr) bp = "*";
            else bp = path[0] != 0 ? runtime::text::ct_intern(path) : "";
            rc = pat_group_bind_add(bname, type, bp);
        }
        if (rc == -2) {
            snprintf(msgbuf, sizeof msgbuf,
                     "duplicate binding '%s' in a match arm", bname);
            return tool::diag::ct_sem_error(line, col, msgbuf, self->mem->path);
        }
        if (rc < 0) return self->sup->fail("out of memory");
        if (pat_sig_add("*")) return -1;
        if (path[0] == 0) pat_root_set(PAT_BINDER, -1);
        return id;
    }

    int pat_parse_top(void)
    {
        int rc, kind, adt, si, ptr;
        int line, col;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        if (g_pat.adt >= 0) {
            struct Adt *adts;
            int nadts;
            const char *ctag;
            adts = frontend::sym::ct_adts(&nadts);
            ctag = runtime::text::ct_internf("struct %s", adts[g_pat.adt].full);
            if (!ctag) return self->sup->fail("out of memory");
            /* a root binder declares the subject as a C value, so the stored
               spelling must carry the `struct` tag */
            g_pat.subject_type = ctag;
        }
        kind = self->pat_classify(g_pat.subject_type, &adt, &si, &ptr);
        if (kind == PAT_K_OTHER || kind == PAT_K_PTR) {
            g_pat.cbase = g_pat.subject_type ? g_pat.subject_type : "";
            return tool::diag::ct_sem_error(line, col,
                tool::sh::ct_scratch_fmt(
                    "match needs an ADT, struct, or integer-like value, but '%s' is not supported",
                    g_pat.subject_type ? g_pat.subject_type : ""),
                self->mem->path);
        }
        rc = self->pat_parse_one(g_pat.subject_type, "");
        if (rc < 0) return -1;
        if (g_pat.ngrp <= 0) return self->sup->fail("expected a pattern");
        return 0;
    }

    /* Turn the recorded bindings into the N_BIND -> N_DECL/N_RAW chain and
       open the arm's scope. The caller parses the body and pops the scope. */
    int pat_commit(void)
    {
        int i, first, last, tail;

        if (self->sup->push_scope() != 0) return -1;
        first = -1;
        last = -1;
        for (i = 0; i < g_pat.nbind; i++) {
            int bind, decl, raw, vi;
            bind = self->sup->new_node(N_BIND);
            decl = self->sup->new_node(N_DECL);
            raw = self->sup->new_node(N_RAW);
            if (bind < 0 || decl < 0 || raw < 0) {
                self->sup->pop_scope();
                return -1;
            }
            self->arena->nodes[bind].text = runtime::text::ct_intern(g_pat.bname[i]);
            self->arena->nodes[bind].text2 = runtime::text::ct_intern(g_pat.btype[i]);
            self->arena->nodes[bind].text3 = runtime::text::ct_intern(g_pat.bname[i]);
            self->arena->nodes[bind].text4 = runtime::text::ct_intern(g_pat.bpath[i]);
            if (!self->arena->nodes[bind].text || !self->arena->nodes[bind].text2
                || !self->arena->nodes[bind].text3 || !self->arena->nodes[bind].text4) {
                self->sup->pop_scope();
                return self->sup->fail("out of memory");
            }
            if (self->sym->declare_var(self->arena->nodes[bind].text,
                                       self->arena->nodes[bind].text2) != 0) {
                const char *e = self->sym->last_error();
                self->sup->pop_scope();
                return self->sup->fail(e);
            }
            vi = self->sym->find_var(self->arena->nodes[bind].text);
            if (vi >= 0) self->sym->vars[vi].initialized = 1;
            self->arena->nodes[decl].text = runtime::text::ct_intern(g_pat.btype[i]);
            self->arena->nodes[decl].text2 = runtime::text::ct_intern(g_pat.bname[i]);
            self->arena->nodes[decl].aux = 3;
            self->arena->nodes[decl].a = raw;
            self->arena->nodes[raw].aux = 0;
            self->arena->nodes[bind].a = decl;
            self->arena->nodes[bind].b = raw;
            self->arena->nodes[bind].next = -1;
            if (first < 0) first = bind;
            else self->arena->nodes[last].next = bind;
            last = bind;
        }
        g_pat.bind_head = first;
        (void)tail;
        return 0;
    }

    int match_ahead(void)
    {
        const char *p;
        int depth;
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        if (!self->lex->tok_is("match")) return 0;
        p = self->lex->src + self->lex->tokstart + 5;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (*p != '(') return 0;
        depth = 0;
        while (*p) {
            if (*p == '"' || *p == '\'') {
                char q = *p;
                p++;
                while (*p && *p != q) {
                    if (*p == '\\' && p[1]) p++;
                    p++;
                }
                if (*p) p++;
                continue;
            }
            if (*p == '/' && p[1] == '*') {
                p += 2;
                while (*p && !(*p == '*' && p[1] == '/')) p++;
                if (*p) p += 2;
                continue;
            }
            if (*p == '/' && p[1] == '/') {
                while (*p && *p != '\n') p++;
                continue;
            }
            if (*p == '(') depth++;
            else if (*p == ')') {
                depth--;
                if (depth == 0) { p++; break; }
            }
            p++;
        }
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        return *p == '{';
    }

    int parse_match(void)
    {
        int s, e, arms, tail, arm, adt, line, col, i;
        int *covered;
        int *mention;
        int ncov, seen_catch, is_ptr, kind, si, ptr;
        int arm_line, arm_col, body;
        int arm_num, arm_bind, guard, arm_wild, arm_catch, ncatch, ngi;
        int guarded;
        int guarded_catch;
        const char *arm_sig, *arm_conds, *arm_name;
        int a, b;
        const char *tybuf = "";
        const char *subject = "";
        char *subjbuf;
        char msg[3 * MAX_TEXT];
        struct Adt *adts;
        int nadts;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        self->sup->lex_next();                       /* consume `match` */
        if (self->sup->expect("(") != 0) return -1;
        self->ex->assign_ok = 1;
        self->ex->try_ban++;
        e = self->ex->parse_expr();
        self->ex->try_ban--;
        self->ex->assign_ok = 0;
        if (e < 0) return -1;
        if (self->sup->expect(")") != 0) return -1;
        /* the subject type is read now, while its local is still in scope */
        if (self->sup->expr_type_text(e, &tybuf) != 0)
            return tool::diag::ct_sem_error(line, col,
                "cannot determine the type of the match subject", self->mem->path);
        {
            const char *bp;
            size_t n;
            bp = tybuf;
            while (*bp == ' ' || *bp == '\t') bp++;
            n = strlen(bp);
            is_ptr = 0;
            while (n > 0 && (bp[n - 1] == ' ' || bp[n - 1] == '*')) {
                if (bp[n - 1] == '*') is_ptr = 1;
                n--;
            }
            subjbuf = (char *)malloc(n + 1);
            if (!subjbuf) return self->sup->fail("out of memory");
            memcpy(subjbuf, bp, n);
            subjbuf[n] = 0;
            subject = runtime::text::ct_intern(subjbuf);
            free(subjbuf);
            if (!subject) return self->sup->fail("out of memory");
        }
        adt = frontend::sym::ct_adt_from_type(subject);
        kind = self->pat_classify(subject, &adt, &si, &ptr);
        if (kind != PAT_K_OTHER && kind != PAT_K_PTR
            && is_ptr && adt < 0 && kind != PAT_K_STRUCT) {
            /* a pointer to a scalar has no pattern surface (a pointer to a
               struct is read through `->`; an ADT pointer keeps its variants) */
            kind = PAT_K_PTR;
        }
        if (kind == PAT_K_OTHER || kind == PAT_K_PTR) {
            snprintf(msg, sizeof msg,
                     "match needs an ADT, struct, or integer-like value, but '%s' is not supported",
                     tybuf);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        if (adt >= 0) {
            int nv;
            adts = frontend::sym::ct_adts(&nadts);
            nv = adts[adt].nvariants > 0 ? adts[adt].nvariants : 1;
            covered = (int *)calloc((size_t)(2 * nv), sizeof(*covered));
            if (!covered) return self->sup->fail("out of memory");
            for (i = 0; i < nv; i++) covered[i] = 0;
            mention = covered + nv;
            for (i = 0; i < nv; i++) mention[i] = 0;
        } else {
            adts = (struct Adt *)0;
            nadts = 0;
            covered = (int *)calloc(2, sizeof(*covered));
            if (!covered) return self->sup->fail("out of memory");
            mention = covered + 1;
            mention[0] = 0;
        }
        ncov = 0;
        seen_catch = 0;
        guarded_catch = 0;
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("{"))) {
            free(covered);
            return self->sup->fail("expected a block after match (...)");
        }
        self->sup->lex_next();
        s = self->sup->new_node(N_MATCH);
        if (s < 0) { free(covered); return -1; }
        self->arena->nodes[s].text = adt >= 0
            ? runtime::text::ct_intern(adts[adt].full) : "";
        self->arena->nodes[s].text2 = adt >= 0 ? "" : subject;
        if (!self->arena->nodes[s].text || !self->arena->nodes[s].text2) {
            free(covered);
            return self->sup->fail("out of memory");
        }
        self->arena->nodes[s].aux = (is_ptr ? 1 : 0) | (adt < 0 ? 4 : 0);
        self->arena->nodes[s].a = e;
        self->arena->nodes[s].line = line;
        self->arena->nodes[s].num = col;
        arms = -1;
        tail = -1;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            arm_line = self->lex->tokline;
            arm_col = self->lex->tokstart - self->lex->lstart + 1;
            arm_num = -1;
            arm_sig = "";
            arm_conds = "";
            arm_name = "";
            arm_bind = -1;
            guard = -1;
            arm_wild = 0;
            arm_catch = 0;
            ncatch = 0;
            if (self->pat_begin(adt, subject, is_ptr) != 0) { free(covered); return -1; }
            if (self->pat_parse_top() != 0) { free(covered); return -1; }
            for (ngi = 0; ngi < g_pat.ngrp; ngi++)
                if (pat_group_catch(ngi)) ncatch++;
            arm_catch = ncatch > 0;
            arm_wild = (g_pat.ngrp == 1 && g_pat.grp[0].root_form == PAT_WILD);
            if (seen_catch) {
                free(covered);
                if (arm_wild)
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "duplicate wildcard match arm", self->mem->path);
                return tool::diag::ct_sem_error(arm_line, arm_col,
                    "a wildcard match arm must be the last arm", self->mem->path);
            }
            /* bindings enter scope before the guard: `p if cond` may name a
               binding, and the emitter writes the declarations before it. */
            if (pat_bind_finish(self, arm_line, arm_col) != 0) {
                free(covered);
                return -1;
            }
            if (self->pat_commit() != 0) { free(covered); return -1; }
            arm_bind = g_pat.bind_head;
            guarded = (self->lex->tok == T_ID && self->lex->tok_is("if"));
            if (!guarded) {
                if (adt >= 0) {
                    for (ngi = 0; ngi < g_pat.ngrp; ngi++) {
                        int v = pat_group_variant(ngi);
                        if (v < 0) continue;
                        if (covered[v]) {
                            snprintf(msg, sizeof msg,
                                     "duplicate match arm for variant '%s.%s'",
                                     adts[adt].name, adts[adt].variants[v].name);
                            self->sup->pop_scope();
                            free(covered);
                            return tool::diag::ct_sem_error(arm_line, arm_col,
                                                            msg, self->mem->path);
                        }
                        covered[v] = 1;
                        ncov++;
                    }
                }
                if (arm_catch) seen_catch = 1;
            } else {
                /* a guarded arm never covers a variant: the guard may be false
                   at run time, so the next arm must still be able to take it */
                if (adt >= 0) {
                    for (ngi = 0; ngi < g_pat.ngrp; ngi++) {
                        int v = pat_group_mention(ngi);
                        if (v >= 0) mention[v] = 1;
                    }
                }
                if (arm_catch) guarded_catch = 1;
            }
            /* Freeze the arm's facts before the guard or body parses a nested
               match: that parser reuses this same scratch. */
            if (pat_arm_finish(&arm_num) != 0) {
                self->sup->pop_scope();
                free(covered);
                return -1;
            }
            arm_sig = g_pat.arm_sig;
            arm_conds = g_pat.arm_conds;
            if (adt >= 0 && arm_num >= 0)
                arm_name = runtime::text::ct_intern(adts[adt].variants[arm_num].name);
            else
                arm_name = runtime::text::ct_intern(subject);
            if (!arm_sig || !arm_conds || !arm_name) {
                self->sup->pop_scope();
                free(covered);
                return self->sup->fail("out of memory");
            }
            if (guarded) {
                self->sup->lex_next();
                self->ex->assign_ok = 1;
                self->ex->try_ban++;
                guard = self->ex->parse_expr();
                self->ex->try_ban--;
                self->ex->assign_ok = 0;
                if (guard < 0) {
                    self->sup->pop_scope();
                    free(covered);
                    return -1;
                }
            }
            if (self->sup->expect("=>") != 0) {
                self->sup->pop_scope();
                free(covered);
                return -1;
            }
            body = self->parse_block();
            self->sup->pop_scope();
            if (body < 0) { free(covered); return -1; }
            arm = self->sup->new_node(N_ARM);
            if (arm < 0) { free(covered); return -1; }
            self->arena->nodes[arm].num = arm_num;
            self->arena->nodes[arm].text = arm_name;
            self->arena->nodes[arm].text2 = arm_sig;
            self->arena->nodes[arm].text3 = adt >= 0
                ? runtime::text::ct_intern(adts[adt].full) : "";
            self->arena->nodes[arm].text4 = arm_conds;
            if (!self->arena->nodes[arm].text || !self->arena->nodes[arm].text2
                || !self->arena->nodes[arm].text3 || !self->arena->nodes[arm].text4) {
                free(covered);
                return self->sup->fail("out of memory");
            }
            self->arena->nodes[arm].aux = (arm_wild ? 1 : 0) | (adt < 0 ? 4 : 0);
            self->arena->nodes[arm].a = arm_bind;
            self->arena->nodes[arm].b = body;
            /* S5: `d` carries the guard expression, -1 when there is none.
               The pattern descriptors stay parse-time only. */
            self->arena->nodes[arm].d = guard;
            self->arena->nodes[arm].c = -1;
            self->arena->nodes[arm].attr = arm_col;
            self->arena->nodes[arm].line = arm_line;
            if (arms < 0) arms = arm;
            else self->arena->nodes[tail].next = arm;
            tail = arm;
        }
        if (self->sup->expect("}") != 0) { free(covered); return -1; }
        self->arena->nodes[s].b = arms;
        /* the same complete pattern twice is a mistake even when it is not an
           irrefutable variant arm (e.g. two `Circle(0)` arms) */
        for (a = arms; a >= 0; a = self->arena->nodes[a].next) {
            if (self->arena->nodes[a].aux & 1) continue;
            if (self->arena->nodes[a].d >= 0) continue;   /* guarded arms may repeat */
            for (b = self->arena->nodes[a].next; b >= 0; b = self->arena->nodes[b].next) {
                if (self->arena->nodes[b].aux & 1) continue;
                if (self->arena->nodes[b].d >= 0) continue;
                if (self->arena->nodes[a].text2 && self->arena->nodes[b].text2
                    && strcmp(self->arena->nodes[a].text2,
                              self->arena->nodes[b].text2) == 0) {
                    snprintf(msg, sizeof msg, "duplicate match arm pattern '%s'",
                             self->arena->nodes[b].text2);
                    free(covered);
                    return tool::diag::ct_sem_error(self->arena->nodes[b].line,
                        self->arena->nodes[b].attr, msg, self->mem->path);
                }
            }
        }
        if (adt >= 0) {
            /* exhaustiveness: `_` / a root binder is the only catch-all, and a
               guarded arm never counts as coverage (S5) */
            if (!seen_catch) {
                for (i = 0; i < adts[adt].nvariants; i++) {
                    if (covered[i]) continue;
                    if (mention[i])
                        snprintf(msg, sizeof msg,
                                 "match does not cover variant '%s.%s'"
                                 " (a guarded arm does not count as coverage;"
                                 " add an unguarded arm or write '_ => { … }')",
                                 adts[adt].name, adts[adt].variants[i].name);
                    else
                        snprintf(msg, sizeof msg, "match does not cover variant '%s.%s'"
                                 " (add the arm or write '_ => { … }')",
                                 adts[adt].name, adts[adt].variants[i].name);
                    free(covered);
                    return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
                }
            } else if (self->ex->types_mode && *self->ex->types_mode
                       && ncov == adts[adt].nvariants) {
                snprintf(msg, sizeof msg,
                         "match covers every variant of '%s'; the wildcard arm is unnecessary",
                         adts[adt].name);
                if (tool::diag::ct_type_warn(line, col, "", msg, self->mem->path) != 0) {
                    free(covered);
                    return -1;
                }
            }
        } else if (!seen_catch) {
            if (guarded_catch)
                snprintf(msg, sizeof msg,
                         "match on '%s' needs a final unguarded '_ => { … }' arm"
                         " (a guarded arm does not count as coverage)", subject);
            else
                snprintf(msg, sizeof msg,
                         "match on '%s' needs a final '_ => { … }' arm", subject);
            free(covered);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        free(covered);
        return s;
    }

    int expr_match_ahead(void)
    {
        const char *p;
        int depth;
        (void)self;

        if (self->lex->tok != T_ID) return 0;
        if (!self->lex->tok_is("match")) return 0;
        p = self->lex->src + self->lex->tokstart + 5;
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        if (*p != '(') return 0;
        depth = 0;
        while (*p) {
            if (*p == '"' || *p == '\'') {
                char q = *p;
                p++;
                while (*p && *p != q) {
                    if (*p == '\\' && p[1]) p++;
                    p++;
                }
                if (*p) p++;
                continue;
            }
            if (*p == '/' && p[1] == '*') {
                p += 2;
                while (*p && !(*p == '*' && p[1] == '/')) p++;
                if (*p) p += 2;
                continue;
            }
            if (*p == '/' && p[1] == '/') {
                while (*p && *p != '\n') p++;
                continue;
            }
            if (*p == '(') depth++;
            else if (*p == ')') {
                depth--;
                if (depth == 0) { p++; break; }
            }
            p++;
        }
        for (;;) {
            if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { p++; continue; }
            break;
        }
        return *p == '{';
    }

    int parse_match_expr(void)
    {
        int s, e, arms, tail, arm, adt, line, col, i;
        int *covered;
        int *mention;
        int ncov, seen_wild, is_ptr;
        int body, asg, yexpr, have_type, ytyped, block_form;
        int yline, ycol;
        int arm_wild, arm_catch, guard, ncatch, ngi;
        int guarded;
        const char *arm_sig, *arm_conds;
        const char *tybuf = "";
        const char *tname = "";
        char msg[3 * MAX_TEXT];
        const char *rtype = "";
        const char *rkey = "";
        const char *ytype = "";
        const char *ykey = "";
        struct Adt *adts;
        int nadts;

        line = self->lex->tokline;
        col = self->lex->tokstart - self->lex->lstart + 1;
        self->sup->lex_next();                       /* consume `match` */
        if (self->sup->expect("(") != 0) return -1;
        self->ex->assign_ok = 1;
        self->ex->try_ban++;
        e = self->ex->parse_expr();
        self->ex->try_ban--;
        self->ex->assign_ok = 0;
        if (e < 0) return -1;
        if (self->sup->expect(")") != 0) return -1;
        if (self->sup->expr_type_text(e, &tybuf) != 0)
            return tool::diag::ct_sem_error(line, col,
                "cannot determine the type of the match subject", self->mem->path);
        {
            const char *b;
            size_t n;
            b = tybuf;
            while (*b == ' ' || *b == '\t') b++;
            n = strlen(b);
            is_ptr = 0;
            while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '*')) {
                if (b[n - 1] == '*') is_ptr = 1;
                n--;
            }
            if (n >= 7 && strncmp(b, "struct ", 7) == 0) {
                b += 7;
                n -= 7;
            }
            tname = runtime::text::ct_intern_len(b, (int)n);
            if (!tname) return self->sup->fail("out of memory");
        }
        adt = frontend::sym::ct_adt_from_type(tname);
        if (adt < 0) {
            snprintf(msg, sizeof msg, "match needs an ADT value, but '%s' is not an ADT",
                     tybuf);
            return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
        }
        adts = frontend::sym::ct_adts(&nadts);
        /* S1a-0 C3: the variant count is dynamic, so the coverage scratch grows
           with it instead of stopping at a fixed 96 rows. */
        {
            int nv = adts[adt].nvariants > 0 ? adts[adt].nvariants : 1;
            covered = (int *)calloc((size_t)(2 * nv), sizeof(*covered));
            if (!covered) return self->sup->fail("out of memory");
            for (i = 0; i < nv; i++) covered[i] = 0;
            mention = covered + nv;
            for (i = 0; i < nv; i++) mention[i] = 0;
        }
        ncov = 0;
        seen_wild = 0;
        have_type = 0;
        rtype = "";
        if (!(self->lex->tok == T_PUNCT && self->lex->tok_is("{")))
            return self->sup->fail("expected a block after match (...)");
        self->sup->lex_next();
        s = self->sup->new_node(N_MATCH);
        if (s < 0) return -1;
        self->arena->nodes[s].text = runtime::text::ct_intern(adts[adt].full);
        if (!self->arena->nodes[s].text) return self->sup->fail("out of memory");
        self->arena->nodes[s].aux = is_ptr;
        self->arena->nodes[s].a = e;
        self->arena->nodes[s].line = line;
        self->arena->nodes[s].num = col;
        self->arena->nodes[s].sflags = self->arena->nodes[s].sflags | 8;  /* expression form */
        arms = -1;
        tail = -1;
        while (self->lex->tok != T_EOF
               && !(self->lex->tok == T_PUNCT && self->lex->tok_is("}"))) {
            int arm_line, arm_col, variant;
            int bind_head;
            int pushed;
            arm_line = self->lex->tokline;
            arm_col = self->lex->tokstart - self->lex->lstart + 1;
            variant = -1;
            bind_head = -1;
            pushed = 0;
            arm_wild = 0;
            arm_catch = 0;
            ncatch = 0;
            guard = -1;
            arm_sig = "";
            arm_conds = "";
            if (self->pat_begin(adt, tname, is_ptr) != 0) return -1;
            if (self->pat_parse_top() != 0) return -1;
            for (ngi = 0; ngi < g_pat.ngrp; ngi++)
                if (pat_group_catch(ngi)) ncatch++;
            arm_catch = ncatch > 0;
            arm_wild = (g_pat.ngrp == 1 && g_pat.grp[0].root_form == PAT_WILD);
            if (seen_wild) {
                if (arm_wild)
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "duplicate wildcard match arm", self->mem->path);
                return tool::diag::ct_sem_error(arm_line, arm_col,
                    "a wildcard match arm must be the last arm", self->mem->path);
            }
            if (pat_bind_finish(self, arm_line, arm_col) != 0) return -1;
            if (self->pat_commit() != 0) return -1;
            pushed = 1;
            bind_head = g_pat.bind_head;
            guarded = (self->lex->tok == T_ID && self->lex->tok_is("if"));
            if (!guarded) {
                for (ngi = 0; ngi < g_pat.ngrp; ngi++) {
                    int v = pat_group_variant(ngi);
                    if (v < 0) continue;
                    if (covered[v]) {
                        snprintf(msg, sizeof msg,
                                 "duplicate match arm for variant '%s.%s'",
                                 adts[adt].name, adts[adt].variants[v].name);
                        self->sup->pop_scope();
                        return tool::diag::ct_sem_error(arm_line, arm_col, msg,
                                                        self->mem->path);
                    }
                    covered[v] = 1;
                    ncov++;
                }
                if (arm_catch) seen_wild = 1;
            } else {
                /* a guarded arm never covers a variant (S5) */
                for (ngi = 0; ngi < g_pat.ngrp; ngi++) {
                    int v = pat_group_mention(ngi);
                    if (v >= 0) mention[v] = 1;
                }
            }
            /* Freeze the arm's facts before the guard or body parses a nested
               match: that parser reuses this same scratch. */
            if (pat_arm_finish(&variant) != 0) {
                self->sup->pop_scope();
                return -1;
            }
            arm_sig = g_pat.arm_sig;
            arm_conds = g_pat.arm_conds;
            if (!arm_sig || !arm_conds) {
                self->sup->pop_scope();
                return self->sup->fail("out of memory");
            }
            if (guarded) {
                self->sup->lex_next();
                self->ex->assign_ok = 1;
                self->ex->try_ban++;
                guard = self->ex->parse_expr();
                self->ex->try_ban--;
                self->ex->assign_ok = 0;
                if (guard < 0) {
                    self->sup->pop_scope();
                    return -1;
                }
            }
            if (self->sup->expect("=>") != 0) return -1;
            yexpr = -1;
            ytyped = 0;
            block_form = 0;
            yline = arm_line;
            ycol = arm_col;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("{")) {
                block_form = 1;
                int q, last, deferring;
                self->match_arm_pending = 1;
                body = self->parse_block();
                if (body < 0) {
                    if (pushed) self->sup->pop_scope();
                    return -1;
                }
                /* A `defer` / `own` in the arm would run before the value
                   leaves the block; this slice refuses the combination
                   instead of emitting an assignment after the cleanup. */
                deferring = 0;
                for (q = self->arena->nodes[body].a; q >= 0; q = self->arena->nodes[q].next)
                    if (self->arena->nodes[q].kind == N_DEFER_RUN
                        || self->arena->nodes[q].kind == N_DELETE)
                        deferring = 1;
                if (deferring && self->last_yield_count > 0) {
                    if (pushed) self->sup->pop_scope();
                    return tool::diag::ct_sem_error(arm_line, arm_col,
                        "defer / own is not supported inside an expression-match arm",
                        self->mem->path);
                }
                if (self->last_yield_count > 0) {
                    yexpr = self->last_yield_expr;
                    yline = self->last_yield_line;
                    ycol = self->last_yield_col;
                    ytype = self->last_yield_type;
                    ytyped = 1;
                } else {
                    last = -1;
                    for (q = self->arena->nodes[body].a; q >= 0; q = self->arena->nodes[q].next)
                        last = q;
                    if (last >= 0 && (self->arena->nodes[last].kind == N_RET
                                      || self->arena->nodes[last].kind == N_BREAK
                                      || self->arena->nodes[last].kind == N_CONT)) {
                        yexpr = -1;             /* diverging arm */
                    } else {
                        if (pushed) self->sup->pop_scope();
                        return tool::diag::ct_sem_error(arm_line, arm_col,
                            "an expression-match arm must yield a value (add 'yield <expr>;' or end with 'return')",
                            self->mem->path);
                    }
                }
            } else {
                yline = self->lex->tokline;
                ycol = self->lex->tokstart - self->lex->lstart + 1;
                self->ex->assign_ok = 1;
                self->ex->try_ban++;
                yexpr = self->ex->parse_expr();
                self->ex->try_ban--;
                self->ex->assign_ok = 0;
                if (yexpr < 0) {
                    if (pushed) self->sup->pop_scope();
                    return -1;
                }
                {
                    int yz = 0;
                    if (self->sup->expr_type_text(yexpr, &ytype) != 0) {
                        ytype = self->ex->chk_type_text(yexpr, &yz);
                        if (!ytype) {
                            if (pushed) self->sup->pop_scope();
                            return tool::diag::ct_sem_error(yline, ycol,
                                "cannot determine the type yielded by this match arm",
                                self->mem->path);
                        }
                    }
                    ytyped = 1;
                }
                body = self->sup->new_node(N_BLOCK);
                if (body < 0) {
                    if (pushed) self->sup->pop_scope();
                    return -1;
                }
                self->arena->nodes[body].a = -1;
            }
            asg = -1;
            if (yexpr >= 0) {
                if (!ytyped) {
                    if (pushed) self->sup->pop_scope();
                    return tool::diag::ct_sem_error(yline, ycol,
                        "cannot determine the type yielded by this match arm",
                        self->mem->path);
                }
                ykey = match_expr_type_key_text(ytype);
                if (!ykey) return self->sup->fail("out of memory");
                if (!have_type) {
                    /* `ytype` may still point at the arm's `ybuf` fallback;
                       intern it so the node's row outlives the frame. */
                    rtype = runtime::text::ct_intern(ytype);
                    if (!rtype) return self->sup->fail("out of memory");
                    rkey = ykey;
                    have_type = 1;
                } else if (strcmp(ykey, rkey) != 0) {
                    if (pushed) self->sup->pop_scope();
                    snprintf(msg, sizeof msg,
                             "match arm yields '%s', but an earlier arm yields '%s'",
                             ytype, rtype);
                    return tool::diag::ct_sem_error(arm_line, arm_col, msg,
                                                    self->mem->path);
                }
                /* `__ct_mres` is a placeholder: the emitter patches it to the
                   result temporary it actually declares. */
                {
                    int tv, last;
                    tv = self->sup->new_node(N_VAR);
                    asg = self->sup->new_node(N_ASSIGN);
                    if (tv < 0 || asg < 0) {
                        if (pushed) self->sup->pop_scope();
                        return -1;
                    }
                    self->arena->nodes[tv].text2 = runtime::text::ct_intern("__ct_mres");
                    if (!self->arena->nodes[tv].text2) return self->sup->fail("out of memory");
                    self->arena->nodes[tv].line = yline;
                    self->arena->nodes[tv].num = ycol;
                    self->arena->nodes[asg].a = tv;
                    self->arena->nodes[asg].b = yexpr;
                    self->arena->nodes[asg].text = runtime::text::ct_intern(ytype);
                    if (!self->arena->nodes[asg].text) return self->sup->fail("out of memory");
                    self->arena->nodes[asg].line = yline;
                    self->arena->nodes[asg].num = ycol;
                    last = -1;
                    for (i = self->arena->nodes[body].a; i >= 0; i = self->arena->nodes[i].next)
                        last = i;
                    if (last < 0) self->arena->nodes[body].a = asg;
                    else self->arena->nodes[last].next = asg;
                }
            }
            arm = self->sup->new_node(N_ARM);
            if (arm < 0) {
                if (pushed) self->sup->pop_scope();
                return -1;
            }
            self->arena->nodes[arm].aux = ((variant < 0 && arm_wild) ? 1 : 0) | 2;
            self->arena->nodes[arm].num = variant;
            self->arena->nodes[arm].a = bind_head;
            self->arena->nodes[arm].b = body;
            self->arena->nodes[arm].c = asg;
            self->arena->nodes[arm].line = arm_line;
            self->arena->nodes[arm].attr = arm_col;
            self->arena->nodes[arm].d = guard;   /* S5: the guard expression, -1 none */
            self->arena->nodes[arm].text4 = arm_conds;
            if (variant >= 0) {
                self->arena->nodes[arm].text = runtime::text::ct_intern(
                    adts[adt].variants[variant].name);
                self->arena->nodes[arm].text3 = runtime::text::ct_intern(adts[adt].full);
            } else {
                self->arena->nodes[arm].text = runtime::text::ct_intern(tname);
                self->arena->nodes[arm].text3 = runtime::text::ct_intern(adts[adt].full);
            }
            self->arena->nodes[arm].text2 = arm_sig;
            if (!self->arena->nodes[arm].text || !self->arena->nodes[arm].text2
                || !self->arena->nodes[arm].text3 || !self->arena->nodes[arm].text4)
                return self->sup->fail("out of memory");
            if (pushed) self->sup->pop_scope();
            if (arms < 0) arms = arm;
            else self->arena->nodes[tail].next = arm;
            tail = arm;
            if (self->lex->tok == T_PUNCT && self->lex->tok_is(",")) {
                self->sup->lex_next();
                continue;
            }
            if (self->lex->tok == T_PUNCT && self->lex->tok_is("}")) break;
            /* a braced arm ends at its `}`: the comma is optional, the next
               token already starts the following pattern */
            if (block_form) continue;
            return self->sup->fail("expected ',' or '}' after an expression-match arm");
        }
        if (self->sup->expect("}") != 0) return -1;
        self->arena->nodes[s].b = arms;
        if (!have_type) {
            return tool::diag::ct_sem_error(line, col,
                "an expression match needs at least one arm that yields a value",
                self->mem->path);
        }
        self->arena->nodes[s].text2 = rtype;
        if (!self->arena->nodes[s].text2) return self->sup->fail("out of memory");
        if (!seen_wild) {
            for (i = 0; i < adts[adt].nvariants; i++) {
                if (covered[i]) continue;
                if (mention[i])
                    snprintf(msg, sizeof msg, "match does not cover variant '%s.%s'"
                             " (a guarded arm does not count as coverage;"
                             " add an unguarded arm or write '_ => { … }')",
                             adts[adt].name, adts[adt].variants[i].name);
                else
                    snprintf(msg, sizeof msg, "match does not cover variant '%s.%s'"
                             " (add the arm or write '_ => { … }')",
                             adts[adt].name, adts[adt].variants[i].name);
                return tool::diag::ct_sem_error(line, col, msg, self->mem->path);
            }
        } else if (self->ex->types_mode && *self->ex->types_mode && ncov == adts[adt].nvariants) {
            snprintf(msg, sizeof msg,
                     "match covers every variant of '%s'; the wildcard arm is unnecessary",
                     adts[adt].name);
            if (tool::diag::ct_type_warn(line, col, "", msg, self->mem->path) != 0)
                return -1;
        }
        return s;
    }
}
