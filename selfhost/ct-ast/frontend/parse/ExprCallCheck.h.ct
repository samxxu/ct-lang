import frontend::parse::ExprTypes;
import frontend::parse::ExprBinding;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define B_ADD 1
#define B_AND 12
#define B_BAND 15
#define B_BOR 16
#define B_COMMA 19
#define B_DIV 4
#define B_EQ 9
#define B_GE 8
#define B_GT 6
#define B_LE 7
#define B_LT 5
#define B_MOD 11
#define B_MUL 3
#define B_NE 10
#define B_OR 13
#define B_SHL 17
#define B_SHR 18
#define B_SUB 2
#define B_XOR 14
#define MAX_CALLS 8192
#define MAX_CALLS_MAX 65536
#define MAX_FUNCS 512
#define MAX_FUNCS_MAX 65536
#define MAX_ARG_POS 32
#define MAX_ARG_POS_MAX 65536
#define MAX_GENERIC_INSTS 64
#define MAX_TEXT 160
#define N_ADDR 27
#define N_ARROW 25
#define N_ASSIGN 13
#define N_BIN 11
#define N_BOX 34
#define N_CALL 7
#define N_CAST 35
#define N_DECL 12
#define N_DEREF 28
#define N_FUNC 3
#define N_IMPL 33
#define N_INDEX 26
#define N_MCALL 30
#define N_MEMBER 24
#define N_NUM 8
#define N_OFFSETOF 47
#define N_POST 18
#define N_RAW 31
#define N_SIZEOF 36
#define N_STR 9
#define N_TERN 37
#define N_UNARY 17
#define N_VAR 10
#define N_COMPOUND 51
#define N_VAARG 53
#define N_FNUM 54
#define N_PRE 57
#define N_CLOSURE 59
#define N_MATSEQ 73
#define N_NEWOBJ 77
#define N_INTO 63
#define N_INTO_SELF 64
#define N_TRY 71
#define N_ADTCTOR 81
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define N_OPT 72
#define P_DEC 2
#define P_INC 1
#define T_EOF 0
#define T_ID 1
#define T_NUM 2
#define T_PUNCT 4
#define T_STR 3
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define CT_EXPR_CLOSURE_HINT "tier 1: trait Op { int call(int x); } struct A { int n; } use Op; impl Op for A { int call(int x) { return x + self->n; } }"

namespace frontend::parse;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct ExprCallCheck {
    int unused;
}


impl ExprCallCheck for Expr {
    int arity_check(int line, int col, const char *callee, int got, int want)
    {
        char msg[MAX_TEXT];
        if (got == want) return 0;
        snprintf(msg, sizeof msg, "takes %d argument(s), %d given", want, got);
        if (self->sup->arity_warn(line, col, callee, msg) != 0)
            return self->sup->fail("too many warnings");
        return 0;
    }

    int map_arity(int line, int col, const char *trait, const char *method, int got)
    {
        int ti, mi, want;
        ti = self->sym->find_trait(trait);
        if (ti < 0) return 0;
        for (mi = 0; mi < self->sym->traits[ti].nm; mi++)
            if (strcmp(self->sym->traits[ti].m[mi].name, method) == 0) break;
        if (mi >= self->sym->traits[ti].nm) return 0;
        want = self->sym->traits[ti].m[mi].nparams;
        if (self->sym->traits[ti].m[mi].variadic && got >= want) return 0;
        return self->arity_check(line, col, method, got, want);
    }

    int argtype_mismatch(int args, int fi, int ti, int mi, char *msg, int cap)
    {
        char at[MAX_TEXT];
        char fb[MAX_TEXT], ab[MAX_TEXT];
        const char *ft;
        int cur, k, np, skip, r;

        if (fi >= 0) np = self->sym->funcs[fi].nparams;
        else np = self->sym->traits[ti].m[mi].nparams;
        cur = args;
        k = 0;
        while (cur > 0 && k < np) {
            skip = 0;
            if (fi >= 0) ft = self->sym->funcs[fi].ptype + (k) * MAX_TEXT;
            else ft = self->sym->traits[ti].m[mi].ptype + (k) * MAX_TEXT;
            /* an array parameter is a pointer in disguise: the dims sit in
               `pdim` (a function) or ride in the spelling (a trait method) */
            if (fi >= 0 && (self->sym->funcs[fi].pdim + (size_t)k * MAX_TEXT)[0]) skip = 1;
            if (!skip && strchr(ft, '[')) skip = 1;
            if (!skip) {
                char itr[MAX_TEXT];
                int iip = 0;
                if (self->sup->iface_ref_type(ft, itr, sizeof itr, &iip)) skip = 1;
            }
            if (!skip && self->arena->nodes[cur].kind == N_CAST) skip = 1;
            /* a closure actual fills `(fn, env)`: its own type is not a value
               type, and it consumes two formals (see the tail of the loop) */
            if (!skip && self->arg_is_closure(cur)) skip = 1;
            /* `0` is a null pointer constant: C accepts it wherever a pointer
               is expected, so a derived `int` is not a mismatch. */
            if (!skip && self->arena->nodes[cur].kind == N_NUM
                && self->arena->nodes[cur].num == 0
                && strchr(ft, '*')) skip = 1;
            if (!skip && self->sup->expr_ctype(cur, at, sizeof at) != 0) skip = 1;
            if (!skip && strchr(at, '[')) skip = 1;   /* a decayed array */
            if (!skip) {
                int fdp = 0, adp = 0;
                const char *q;
                /* LANG-14: a pointer mismatch between structs is still
                   convertible in C (with a diagnostic), only a by-value
                   struct against anything else is not. */
                for (q = ft; *q; q++) if (*q == '*') fdp++;
                for (q = at; *q; q++) if (*q == '*') adp++;
                r = arg_class(ft, at, fb, sizeof fb, ab, sizeof ab);
                if (r == 2) {
                    int fs = self->sym->find_struct(fb + 6);
                    int as = self->sym->find_struct(ab + 6);
                    r = (fs < 0 || as < 0) ? -1 : ((fs != as) ? 2 : 0);
                }
                if (r == 2) {
                    snprintf(msg, cap, "argument %d: expected '%s', got '%s'",
                             k + 1, ft, at);
                    if (fdp == 0 || adp == 0) return 2;
                    return 1;
                }
                if (r == 1) {
                    snprintf(msg, cap, "argument %d: expected '%s', got '%s'",
                             k + 1, ft, at);
                    /* LANG-14: C rejects a by-value struct actual / formal
                       against anything but the same struct, so the ct stage
                       stops here instead of leaving the error to `cc`. The
                       arithmetic and pointer spellings keep the warning level:
                       C accepts those with a diagnostic and converts. `tclass`
                       reads the tag from the source spelling (`fb` is
                       whitespace-free, so `struct S` is `structS` there). */
                    if ((fdp == 0 || adp == 0)
                        && (tclass(ft, fb) == 1 || tclass(at, ab) == 1)) return 2;
                    return 1;
                }
            }
            if (self->arg_is_closure(cur)) k += 2;
            else k++;
            cur = self->arena->nodes[cur].next;
        }
        return 0;
    }

    int argtype_check(int line, int col, const char *callee, int args, int fi, int ti, int mi)
    {
        char msg[MAX_TEXT];
        char full[MAX_TEXT];
        int r;

        r = self->argtype_mismatch(args, fi, ti, mi, msg, sizeof msg);
        if (r == 2) {
            /* LANG-14: a struct on either side cannot be converted by C, so
               this is a hard error with the same wording the static-recipe
               path uses (`argtype_check_static`). SH-115: it stays hard at
               every `--check-level`; a `warn` downgrade would let the C
               compiler (which is not run with -Werror) build a bad call. */
            snprintf(full, sizeof full, "type mismatch: '%s' %s", callee, msg);
            return tool::diag::ct_sem_error(line, col, full, self->sup->mem->path);
        }
        if (r == 1) {
            if (self->sup->type_warn(line, col, callee, msg) != 0)
                return self->sup->fail("too many warnings");
        }
        return 0;
    }

    int argtype_check_static(int line, int col, const char *callee, int args, int ti, int mi)
    {
        char msg[MAX_TEXT];
        char full[MAX_TEXT];

        if (!self->argtype_mismatch(args, -1, ti, mi, msg, sizeof msg))
            return 0;
        snprintf(full, sizeof full, "type mismatch: '%s' %s", callee, msg);
        /* SH-115: hard at every level -- the recipe may splice the actual into
           the generated call and cc will not necessarily reject it. */
        return tool::diag::ct_sem_error(line, col, full, self->sup->mem->path);
    }

    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!self->cur_func || !(*self->cur_func)[0]) return 0;
        if (*self->ncalls >= *self->callcap) {
            int cap;
            struct Call *grown;
            if (*self->ncalls >= MAX_CALLS_MAX) return self->sup->fail("out of memory");
            cap = *self->callcap > 0 ? *self->callcap : MAX_CALLS;
            while (cap <= *self->ncalls && cap < MAX_CALLS_MAX) cap *= 2;
            if (cap > MAX_CALLS_MAX) cap = MAX_CALLS_MAX;
            grown = (struct Call *)realloc(*self->calls, (size_t)cap * sizeof(*grown));
            if (!grown) return self->sup->fail("out of memory");
            memset(grown + *self->callcap, 0,
                   (size_t)(cap - *self->callcap) * sizeof(*grown));
            *self->calls = grown;
            *self->callcap = cap;
        }
        (*self->calls)[*self->ncalls].caller =
            runtime::text::ct_intern(*self->cur_func);
        if (!(*self->calls)[*self->ncalls].caller)
            return self->sup->fail("out of memory");
        (*self->calls)[*self->ncalls].callee = runtime::text::ct_intern(callee);
        if (!(*self->calls)[*self->ncalls].callee)
            return self->sup->fail("out of memory");
        (*self->calls)[*self->ncalls].line = line;
        (*self->ncalls)++;
        return 0;
    }
}
