/*
 * Lexer.h.ct - the source cursor and the current token, one class of its own.
 *
 * The lexer owns the source buffer, the byte cursor and the one-token lookahead
 * the parser reads (`tok`, `toktext`, `toknum`, the token's line and its start
 * offset). The parser reaches it through a pointer to the singleton and asks it
 * for the next token; `accept` / `expect` / `fail` stay on the parser object
 * because they are about grammar, not about characters.
 *
 * Macros do not cross a unit boundary, so the capacity and the token kinds are
 * declared here: MAX_TEXT 160 is the value `frontend/sym/Symbols.h.ct` lists and
 * T_EOF..T_PP 0..5 are the kinds `frontend/parse/ParseSupport.h.ct` and the
 * parser spell. The `toktext` length is spelled out as a literal because a
 * `pub struct` lands in the generated header, which carries no macros.
 */
#include <stdio.h>
#include <limits.h>
#include <assert.h>

#define MAX_TEXT   160
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

namespace frontend::lex;

/* The text of the current token is a view into the source buffer: `ptr` is
   its first byte and `len` its byte count. It is deliberately not
   NUL-terminated; `src` is, so a consumer that wants a C string still has to
   convert at its own boundary. `TokView` has the same `{ptr,len}` layout as
   the built-in `Str` borrowed view (lib/std/Str.h.ct); it is spelled locally
   because the bootstrap compiler (L2) does not know the std layer and CT
   forbids a `Str` struct field anyway (PH-81), so a `Str` cannot be stored
   here. The token bytes are still never copied. */
pub struct TokView {
    const char *ptr;
    int len;
}

pub trait LexOps {
    void next(void);
}

pub struct Lexer {
    const char *src;
    int  pos;
    int  bol;
    int  tok;
    TokView tokstr;             /* the token's bytes, a view into `src` */
    char toktext[160];
    long toknum;
    /* the `U` / `L` suffix of an integer literal, as written (`uLL`, `LLu`):
       the parser validates and normalizes it. 8 fits any invalid run too, so a
       suffix that is too long is never silently truncated into a legal one. */
    TokView toksuffix;          /* the integer suffix, a view into `src` */
    /* 1 when the current identifier did not fit in `toktext`: the parser turns
       it into `identifier is too long` instead of letting a silently truncated
       name collide with another one. */
    int  toktrunc;
    int  srclen;                /* bytes in `src`, excluding the final NUL */
    int  line;                  /* 1-based */
    int  tokline;               /* line of the current token */
    int  tokstart;
    int  lstart;                /* column = tokstart - lstart + 1 */
    /* 1 when the T_NUM token just read is a floating literal (`1.5`, `1e9`,
       `2.25f`, `.5`): the parser stores those as text, since a `long` cannot
       hold the value and re-printing it would lose the spelling */
    int  tokfloat;
} use LexOps;

/* The view has to stay inside the source buffer. `srclen` is set by
   `read_file`, so the check is skipped only before a buffer exists. */
static int lex_view_ok(struct Lexer *l)
{
    return l->tokstr.len >= 0
        && l->tokstr.ptr >= l->src
        && l->tokstr.ptr + l->tokstr.len <= l->src + l->srclen;
}

/* Record the token as `[start, start+len)` of `src`. `len` is clamped to what
   the cursor actually consumed and to MAX_TEXT-1, the old fixed buffer's cap:
   the long-token diagnostics therefore keep their exact trigger point while
   the bytes stay in place. */
static void lex_view(struct Lexer *l, int start, int len)
{
    int avail = l->pos - start;
    if (len < 0) len = 0;
    if (len > avail) len = avail;
    if (len > MAX_TEXT - 1) len = MAX_TEXT - 1;
    l->tokstr.ptr = l->src + start;
    l->tokstr.len = len;
    if (l->srclen > 0) assert(lex_view_ok(l));
}

/* The integer suffix keeps at most 7 bytes, the old `toksuffix[8]` capacity;
   the parser still rejects more than U + LL from the view length. */
static void lex_suffix(struct Lexer *l, int start, int len)
{
    if (len < 0) len = 0;
    if (len > 7) len = 7;
    l->toksuffix.ptr = l->src + start;
    l->toksuffix.len = len;
    if (l->srclen > 0)
        assert(l->toksuffix.ptr >= l->src
               && l->toksuffix.ptr + l->toksuffix.len <= l->src + l->srclen);
}

pub struct Lexer *lexer_get(void);

/* A literal wider than `long` is reported by whoever needs the value
   (`range_bound_value` re-reads the spelling); the scanner itself must not
   invoke signed overflow on the way there (UBSAN gate, SH-86 follow-up). */
static long num_accumulate(long v, int base, int d)
{
    if (v > (LONG_MAX - d) / base) return LONG_MAX;
    return v * base + d;
}

impl LexOps for Lexer {
    /* Whitespace, comments and preprocessor lines are skipped before the token
       starts; every branch leaves `tok` and, where it applies, `toktext` /
       `toknum` set for the parser to read. */
    void next(void)
    {
        int c, n;
        (void)self;

        for (;;) {
            c = (unsigned char)self->src[self->pos];
            if (c == 0) { self->tok = T_EOF; self->toktext[0] = 0; lex_view(self, self->pos, 0); return; }
            if (c == '\n') { self->bol = 1; self->line++; self->pos++; self->lstart = self->pos; continue; }
            if (c == ' ' || c == '\t' || c == '\r') { self->pos++; continue; }
            if (c == '/' && self->src[self->pos + 1] == '/') {
                while (self->src[self->pos] && self->src[self->pos] != '\n') self->pos++;
                continue;
            }
            if (c == '/' && self->src[self->pos + 1] == '*') {
                self->pos += 2;
                while (self->src[self->pos] && !(self->src[self->pos] == '*' && self->src[self->pos + 1] == '/')) {
                    if (self->src[self->pos] == '\n') {
                        self->line++;
                        /* LANG-16: the next line starts here, so a token after
                           the comment must not inherit the old line's column. */
                        self->lstart = self->pos + 1;
                        self->bol = 1;
                    }
                    self->pos++;
                }
                if (self->src[self->pos]) self->pos += 2;
                continue;
            }
            break;
        }
        self->tokstart = self->pos;
        self->tokline = self->line;
        self->toktrunc = 0;
        if (self->bol && c == '#') {
            n = 0;
            self->toktrunc = 0;
            while (self->src[self->pos] && self->src[self->pos] != '\n') {
                if (n + 1 < MAX_TEXT) { self->toktext[n] = self->src[self->pos]; n++; }
                else self->toktrunc = 1;
                self->pos++;
            }
            self->toktext[n] = 0;
            self->tok = T_PP;
            self->bol = 0;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        self->bol = 0;
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
            n = 0;
            while (self->src[self->pos] && ((self->src[self->pos] >= 'a' && self->src[self->pos] <= 'z')
                   || (self->src[self->pos] >= 'A' && self->src[self->pos] <= 'Z')
                   || (self->src[self->pos] >= '0' && self->src[self->pos] <= '9')
                   || self->src[self->pos] == '_')) {
                if (n + 1 < MAX_TEXT) { self->toktext[n] = self->src[self->pos]; n++; }
                else self->toktrunc = 1;
                self->pos++;
            }
            self->toktext[n] = 0;
            self->tok = T_ID;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        if (c >= '0' && c <= '9') {
            int nstart = self->pos;
            self->toknum = 0;
            self->tokfloat = 0;
            lex_suffix(self, self->pos, 0);
            if (c == '0' && (self->src[self->pos + 1] == 'x' || self->src[self->pos + 1] == 'X')) {
                self->pos += 2;
                for (;;) {
                    char h = self->src[self->pos];
                    int dv;
                    if (h >= '0' && h <= '9') dv = h - '0';
                    else if (h >= 'a' && h <= 'f') dv = h - 'a' + 10;
                    else if (h >= 'A' && h <= 'F') dv = h - 'A' + 10;
                    else break;
                    self->toknum = num_accumulate(self->toknum, 16, dv);
                    self->pos++;
                }
            } else if (c == '0' && self->src[self->pos + 1] >= '0' && self->src[self->pos + 1] <= '7') {
                /* a leading zero makes the literal octal in C; reading it as
                   decimal changed 0755 into 755 (a mode argument silently became
                   a decimal value) */
                self->pos++;
                while (self->src[self->pos] >= '0' && self->src[self->pos] <= '7') {
                    self->toknum = num_accumulate(self->toknum, 8, self->src[self->pos] - '0');
                    self->pos++;
                }
            } else {
                int isflt = 0;
                while (self->src[self->pos] >= '0' && self->src[self->pos] <= '9') {
                    self->toknum = num_accumulate(self->toknum, 10, self->src[self->pos] - '0');
                    self->pos++;
                }
                /* A fraction or an exponent makes the literal floating. `1...5`
                   stays an integer: three dots are a range or a variadic tail,
                   not a decimal point. */
                if (self->src[self->pos] == '.' && self->src[self->pos + 1] != '.') {
                    isflt = 1;
                    self->pos++;
                    while (self->src[self->pos] >= '0' && self->src[self->pos] <= '9') self->pos++;
                }
                if (self->src[self->pos] == 'e' || self->src[self->pos] == 'E') {
                    int k = self->pos + 1;
                    if (self->src[k] == '+' || self->src[k] == '-') k++;
                    if (self->src[k] >= '0' && self->src[k] <= '9') {
                        isflt = 1;
                        self->pos = k;
                        while (self->src[self->pos] >= '0' && self->src[self->pos] <= '9') self->pos++;
                    }
                }
                if (isflt) {
                    int q = 0;
                    if (self->src[self->pos] == 'f' || self->src[self->pos] == 'F'
                        || self->src[self->pos] == 'l' || self->src[self->pos] == 'L')
                        self->pos++;
                    /* keep the spelling: the parser stores floats as text */
                    while (nstart + q < self->pos && q + 1 < MAX_TEXT) {
                        self->toktext[q] = self->src[nstart + q];
                        q++;
                    }
                    self->toktext[q] = 0;
                    self->tokfloat = 1;
                }
            }
            /* An integer literal may carry `U` / `L` letters (case-insensitive,
               in any order). They do not affect the value, so they are collected
               verbatim for the parser; the spelling is what the emitter keeps. */
            if (!self->tokfloat) {
                int sstart = self->pos;
                while (self->src[self->pos] == 'u' || self->src[self->pos] == 'U'
                       || self->src[self->pos] == 'l' || self->src[self->pos] == 'L')
                    self->pos++;
                lex_suffix(self, sstart, self->pos - sstart);
            }
            self->tok = T_NUM;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        if (c == '"' || c == '\'') {
            char q = (char)c;
            int toolong = 0;
            n = 0;
            self->toktext[n] = q;
            n++;
            self->pos++;
            while (self->src[self->pos] && self->src[self->pos] != q) {
                if (self->src[self->pos] == '\\' && self->src[self->pos + 1]) {
                    if (n + 1 < MAX_TEXT) { self->toktext[n] = self->src[self->pos]; n++; }
                    else toolong = 1;
                    self->pos++;
                }
                if (n + 1 < MAX_TEXT) { self->toktext[n] = self->src[self->pos]; n++; }
                else toolong = 1;
                self->pos++;
            }
            if (self->src[self->pos] == q) {
                if (n + 1 < MAX_TEXT) { self->toktext[n] = q; n++; }
                else toolong = 1;
                self->pos++;
            }
            self->toktext[n] = 0;
            if (toolong) self->toktrunc = 1;
            self->tok = T_STR;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* `...` (a variadic parameter list) has to be one token: the parser
           cannot tell three `.` tokens from three field accesses */
        if (c == '.' && self->src[self->pos + 1] == '.' && self->src[self->pos + 2] == '.') {
            self->toktext[0] = '.';
            self->toktext[1] = '.';
            self->toktext[2] = '.';
            self->toktext[3] = 0;
            self->tok = T_PUNCT;
            self->pos += 3;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* `..` (a half-open range bound in `loop(a..b)`) has to be one token,
           and it must be tried after `...` and before `.5`: `...` already owns
           the three-dot form, and a number scanner only treats a trailing `.`
           as a float when the next character is not a `.`. */
        if (c == '.' && self->src[self->pos + 1] == '.') {
            self->toktext[0] = '.';
            self->toktext[1] = '.';
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* `.5` -- a floating literal that starts with the point. The `...` and
           `..` cases above already took the multi-dot forms, so this one is
           unambiguous. */
        if (c == '.' && self->src[self->pos + 1] >= '0' && self->src[self->pos + 1] <= '9') {
            int q = 0;
            self->tokfloat = 1;
            self->toknum = 0;
            while (q + 1 < MAX_TEXT && (self->src[self->pos] == '.'
                   || (self->src[self->pos] >= '0' && self->src[self->pos] <= '9'))) {
                self->toktext[q] = self->src[self->pos];
                q++;
                self->pos++;
            }
            if (self->src[self->pos] == 'e' || self->src[self->pos] == 'E') {
                if (q + 1 < MAX_TEXT) { self->toktext[q] = self->src[self->pos]; q++; self->pos++; }
                if (self->src[self->pos] == '+' || self->src[self->pos] == '-') {
                    if (q + 1 < MAX_TEXT) { self->toktext[q] = self->src[self->pos]; q++; self->pos++; }
                }
                while (q + 1 < MAX_TEXT && self->src[self->pos] >= '0' && self->src[self->pos] <= '9') {
                    self->toktext[q] = self->src[self->pos];
                    q++;
                    self->pos++;
                }
            }
            if (self->src[self->pos] == 'f' || self->src[self->pos] == 'F'
                || self->src[self->pos] == 'l' || self->src[self->pos] == 'L') {
                if (q + 1 < MAX_TEXT) { self->toktext[q] = self->src[self->pos]; q++; self->pos++; }
            }
            self->toktext[q] = 0;
            self->tok = T_NUM;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        if (c == '-' && self->src[self->pos + 1] == '>') {
            self->toktext[0] = '-';
            self->toktext[1] = '>';
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        if (c == ':' && self->src[self->pos + 1] == ':') {
            self->toktext[0] = ':';
            self->toktext[1] = ':';
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* `=>` opens a closure body. It is lexed on its own, before the
           two-character comparisons below, because those only take `=` as their
           second character (`==`, `<=`, `>=`); `->` keeps the branch above. */
        if (c == '=' && self->src[self->pos + 1] == '>') {
            self->toktext[0] = '=';
            self->toktext[1] = '>';
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* shifts: `<<=` / `>>=` first, then `<<` / `>>`, then the comparisons
           `<=` / `>=` below must not swallow the first character */
        if ((c == '<' || c == '>') && self->src[self->pos + 1] == c) {
            self->toktext[0] = (char)c;
            self->toktext[1] = (char)c;
            if (self->src[self->pos + 2] == '=') {
                self->toktext[2] = '=';
                self->toktext[3] = 0;
                self->tok = T_PUNCT;
                self->pos += 3;
            } else {
                self->toktext[2] = 0;
                self->tok = T_PUNCT;
                self->pos += 2;
            }
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        if ((c == '=' || c == '!' || c == '<' || c == '>') && self->src[self->pos + 1] == '=') {
            self->toktext[0] = (char)c;
            self->toktext[1] = '=';
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        if ((c == '+' || c == '-') && self->src[self->pos + 1] == c) {
            self->toktext[0] = (char)c;
            self->toktext[1] = (char)c;
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* `&&` and `||` are their own tokens; a lone `&` / `|` stays literal */
        if ((c == '&' || c == '|') && self->src[self->pos + 1] == c) {
            self->toktext[0] = (char)c;
            self->toktext[1] = (char)c;
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        /* compound assignment: `+=` `-=` `*=` `/=` `%=` `&=` `|=` `^=` */
        if ((c == '+' || c == '-' || c == '*' || c == '/' || c == '%'
             || c == '&' || c == '|' || c == '^')
            && self->src[self->pos + 1] == '=') {
            self->toktext[0] = (char)c;
            self->toktext[1] = '=';
            self->toktext[2] = 0;
            self->tok = T_PUNCT;
            self->pos += 2;
            lex_view(self, self->tokstart, self->pos - self->tokstart);
            return;
        }
        self->toktext[0] = (char)c;
        self->toktext[1] = 0;
        self->tok = T_PUNCT;
        self->pos++;
        lex_view(self, self->tokstart, self->pos - self->tokstart);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Lexer g_lexer;

struct Lexer *lexer_get(void)
{
    return &g_lexer;
}
