/*
 * Memory.h.ct - AutoDrop and the leak analysis, one unit of its own.
 *
 * The rules are deliberately the conservative ones L2 uses (D40), so the
 * warnings match its output byte for byte. The analysis needs the node pool and
 * the symbol tables, so it holds pointers to both, and it writes warnings
 * through the pub wrappers tool::diag exports. Macros do not cross a unit
 * boundary, so the caps are declared here (MAX_TEXT 160 and MAX_VARS 4096 are
 * the values `frontend/sym/Symbols.h.ct` lists); the array lengths are spelled
 * out as literals because a `pub struct` lands in the generated header, which
 * carries no macros.
 */

#include "Memory.shim.h"
import frontend::sym::Symbols;
import runtime::text::Intern;
import runtime::arena::Arena;
import runtime::arena::Arena::NodeKind as NodeKind;
import tool::diag::Diag;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT  160
#define MAX_VARS  4096
/* only the node kinds this unit reads; the numbers are the ones the parser
   builds and the emitter dispatches on */
#define N_CALL   7
#define N_NUM    8
#define N_DECLS  40
#define N_VAR    10

namespace backend::mem;
pub trait MemoryOps {
    int  mark_owned(int n, int line);
    /* PH-49 D49-1a/b: 1 when `e` is a call whose Symbols row returns the
       literal `struct <si> *`. Memory has no expression type inferencer, so
       only the row's return string is read. */
    int  own_factory_ok(int e, int si);
    int  expr_alloc(int e);
    int  expr_mentions(int e, const char *name);
    int  expr_returns(int e, const char *name);
    int  ret_same_struct(const char *ret, int si);
    int  leak_decl(int n);
    int  leak_scope(int from, int to);
    int  leak_assign(int n);
    int  leak_return(int ret, int conditional, int line);
    int  leak_delete(int e);
    int  warn_leak(int vi, int path_line);
    int  fail(const char *msg);
    const char *last_error(void);
}

pub struct Memory {
    struct Arena *arena;
    struct Symbols *sym;
    const char *path;            /* the file name diagnostics report, kept by the driver */
    int  own_decl[4096];         /* where each scope's `own` declarations start */
    int  nowner;
    int  own_kind[4096];         /* 0 = `own` (drop + free), 1 = `borrow` (handback only) */
    /* The symbol each entry resolved to when it was declared. Looking the name
       up again at release time is wrong once a nested declaration shadows it:
       both entries would find the inner symbol (D40's flags, and the release
       itself, must follow the declaration). */
    int  own_var[4096];
    int  own_base[256];
    /* Leak analysis, active only inside a function or method body. `leak_frame`
       is the body's own scope number -- a return in a deeper block is
       conditional. `ret_owned` is the current function's ownership hint. */
    int  leak_active;
    int  leak_frame;
    int  leak_impl;              /* 1 while parsing an impl method body */
    int  ret_owned;
    const char *errmsg;         /* S1a-0 C2p: pool text, no 160-byte cut */
} use MemoryOps;

pub struct Memory *memory_get(void);

impl MemoryOps for Memory {
    /* `own T *x = malloc(...)`: the declaration is validated and remembered so
       the enclosing block can append its release (L2's AutoDrop). */
    int mark_owned(int n, int line)
    {
        int d;
        (void)self;
        d = n;
        if (self->arena->nodes[n].kind == N_DECLS) d = self->arena->nodes[n].a;
        while (d >= 0) {
            const char *base;
            const char *msg;
            const char *tp = self->arena->nodes[d].text;
            const char *name = self->arena->nodes[d].text2;
            size_t bl;
            int si, vi, i, zero;
            if (strncmp(tp, "_Atomic(", 8) == 0)
                return tool::diag::ct_sem_error(line, 1,
                    "an owned value cannot be atomic: 'own' needs a struct that uses Drop",
                    self->path);
            if (self->arena->nodes[d].text3[0] != 0)
                return tool::diag::ct_sem_error(line, 1, "'own' does not support arrays", self->path);
            /* The declared base is needed before the initializer test: PH-49
               matches a factory call's return spelling against this struct. */
            if (strncmp(tp, "struct ", 7) == 0) tp += 7;
            /* S1a-0 C2p-11: the declared base as a trimmed view, not a
               160-byte row; a 2000-byte struct name reaches find_struct and
               the diagnostic whole. */
            bl = strlen(tp);
            while (bl > 0 && (tp[bl - 1] == '*' || tp[bl - 1] == ' ')) bl--;
            base = runtime::text::ct_intern_len(tp, (int)bl);
            if (!base) return self->fail("out of memory");
            si = self->sym->find_struct(base);
            /* D49-1d: a zero initializer owns nothing, so it neither needs an
               allocation nor enters the AutoDrop ledger; the release's `if (p)`
               guard already makes a runtime zero a no-op. */
            zero = self->arena->nodes[d].a >= 0
                   && self->arena->nodes[self->arena->nodes[d].a].kind == N_NUM
                   && self->arena->nodes[self->arena->nodes[d].a].num == 0;
            if (!self->expr_alloc(self->arena->nodes[d].a)
                && !(si >= 0 && self->own_factory_ok(self->arena->nodes[d].a, si))
                && !zero) {
                if (si >= 0)
                    msg = runtime::text::ct_internf(
                        "'own' requires a malloc, calloc or factory call returning 'struct %s *'",
                        base);
                else
                    msg = runtime::text::ct_internf(
                        "'own' requires a malloc or calloc initialiser");
                if (!msg) return self->fail("out of memory");
                return tool::diag::ct_sem_error(line, 1, msg, self->path);
            }
            if (si < 0 || !self->sym->struct_at(si)->uses_drop) {
                msg = runtime::text::ct_internf(
                    "struct '%s' does not use trait 'Drop'", base);
                if (!msg) return self->fail("out of memory");
                return tool::diag::ct_sem_error(line, 1, msg, self->path);
            }
            if (zero) {
                d = self->arena->nodes[d].next;
                continue;
            }
            vi = self->sym->find_var(name);
            /* L49-2: a second `own` for the same identifier in the same scope
               would emit two C declarations and two releases for one object.
               A nested shadow is a different row in a different scope and is
               left alone. */
            if (vi >= 0) {
                int sbase = self->sym->nscope > 0
                            ? self->sym->scope_at(self->sym->nscope - 1) : 0;
                /* Any earlier same-scope row with this name is a C
                   redeclaration; when the new one is `own` the pair is exactly
                   L49-2 (a zero-initialised first binding counts too). */
                for (i = self->sym->nvar - 1; i >= sbase; i--) {
                    if (i == vi || strcmp(self->sym->var_at(i)->name, name) != 0) continue;
                    msg = runtime::text::ct_internf(
                        "duplicate 'own' binding for '%s'", name);
                    if (!msg) return self->fail("out of memory");
                    return tool::diag::ct_sem_error(line, 1, msg, self->path);
                }
            }
            if (vi >= 0) self->sym->var_at(vi)->autodrop = 1;
            if (self->nowner >= MAX_VARS) return self->fail("too many owned variables");
            self->own_kind[self->nowner] = 0;
            self->own_var[self->nowner] = vi;
            self->own_decl[self->nowner] = d;
            self->nowner++;
            d = self->arena->nodes[d].next;
        }
        return 0;
    }

    /* Is this expression a direct `malloc` / `calloc` call? Only that spelling
       counts, exactly as in L2 (a cast in front already hides the allocation). */
    int expr_alloc(int e)
    {
        (void)self;
        if (e < 0) return 0;
        if (self->arena->nodes[e].kind != N_CALL) return 0;
        if (strcmp(self->arena->nodes[e].text2, "malloc") == 0) return 1;
        if (strcmp(self->arena->nodes[e].text2, "calloc") == 0) return 1;
        return 0;
    }

    /* PH-49 D49-1a/b: the factory-call form of an `own` initializer. The only
       accepted spelling is a call whose Symbols row returns the literal
       `struct <si> *` (exactly one star, no alias, no extra indirection); the
       declared base must equal that struct. Memory has no expression type
       inferencer, so nothing else is consulted. */
    int own_factory_ok(int e, int si)
    {
        int fi, i;
        const char *ret;
        const char *rt;
        size_t bl;

        if (si < 0 || si >= self->sym->nstructs) return 0;
        if (e < 0 || self->arena->nodes[e].kind != N_CALL) return 0;
        fi = self->sym->find_func(self->arena->nodes[e].text2);
        if (fi < 0)
            for (i = 0; i < self->sym->nfunc; i++)
                if (strcmp(self->sym->fn_at(i)->name, self->arena->nodes[e].text2) == 0) {
                    fi = i;
                    break;
                }
        if (fi < 0) return 0;
        ret = self->sym->fn_at(fi)->ret;
        if (strncmp(ret, "struct ", 7) != 0) return 0;
        bl = strlen(ret);
        while (bl > 0 && ret[bl - 1] == ' ') bl--;
        if (bl == 0 || ret[bl - 1] != '*') return 0;
        bl--;
        while (bl > 0 && ret[bl - 1] == ' ') bl--;
        rt = runtime::text::ct_intern_len(ret, (int)bl);
        if (!rt) return 0;
        if (strchr(rt, '*')) return 0;
        if (strncmp(rt, "struct ", 7) != 0) return 0;
        return strcmp(rt + 7, self->sym->struct_at(si)->name) == 0;
    }

    /* Does any name in the expression spell `name`? Field names count too: L2
       scans words on the line, not values. */
    int expr_mentions(int e, const char *name)
    {
        int p, k;
        (void)self;
        if (e < 0) return 0;
        /* D4: the closed node-kind set is read through the ADT view
           (`Arena.NodeKind`), not through the flat kind numbers: the node pool
           keeps its int tag and the match is the exhaustiveness check. The
           kind is bound first: the emitter rewrites `self` to `_self` in
           expressions, not inside a compound literal (dogfooding sharp edge). */
        k = self->arena->nodes[e].kind;
        match ((NodeKind){ .tag = k }) {
            NodeKind.NK_VAR() => {
                return strcmp(self->arena->nodes[e].text2, name) == 0;
            }
            NodeKind.NK_MEMBER() | NodeKind.NK_ARROW() => {
                if (strcmp(self->arena->nodes[e].text2, name) == 0) return 1;
                return self->expr_mentions(self->arena->nodes[e].a, name);
            }
            NodeKind.NK_CALL() => {
                if (strcmp(self->arena->nodes[e].text2, name) == 0) return 1;
                for (p = self->arena->nodes[e].a; p >= 0; p = self->arena->nodes[p].next)
                    if (self->expr_mentions(p, name)) return 1;
                return 0;
            }
            _ => { }
        }
        if (self->expr_mentions(self->arena->nodes[e].a, name)) return 1;
        if (self->expr_mentions(self->arena->nodes[e].b, name)) return 1;
        if (self->expr_mentions(self->arena->nodes[e].c, name)) return 1;
        if (self->expr_mentions(self->arena->nodes[e].d, name)) return 1;
        return 0;
    }

    /* Does the expression hand `name` back by value? A field or member read
       (`p->n`, `p.n`) is not a transfer; `p` and `p[0]` are, matching the
       character test L2 applies after the name. */
    int expr_returns(int e, const char *name)
    {
        int p, k;
        (void)self;
        if (e < 0) return 0;
        k = self->arena->nodes[e].kind;
        match ((NodeKind){ .tag = k }) {
            NodeKind.NK_VAR() => {
                return strcmp(self->arena->nodes[e].text2, name) == 0;
            }
            NodeKind.NK_MEMBER() | NodeKind.NK_ARROW() => { return 0; }
            NodeKind.NK_INDEX() => {
                return self->expr_returns(self->arena->nodes[e].a, name);
            }
            NodeKind.NK_CALL() => {
                for (p = self->arena->nodes[e].a; p >= 0; p = self->arena->nodes[p].next)
                    if (self->expr_returns(p, name)) return 1;
                return 0;
            }
            _ => { }
        }
        if (self->expr_returns(self->arena->nodes[e].a, name)) return 1;
        if (self->expr_returns(self->arena->nodes[e].b, name)) return 1;
        if (self->expr_returns(self->arena->nodes[e].c, name)) return 1;
        if (self->expr_returns(self->arena->nodes[e].d, name)) return 1;
        return 0;
    }

    /* Is `ret` a pointer to struct `si`? L2 compares the recorded return type
       with the variable's struct before trusting its `ret_owned` hint. */
    int ret_same_struct(const char *ret, int si)
    {
        const char *rt;
        size_t bl;
        (void)self;
        bl = strlen(ret);
        if (bl == 0 || ret[bl - 1] != '*') return 0;
        while (bl > 0 && (ret[bl - 1] == '*' || ret[bl - 1] == ' ')) bl--;
        rt = runtime::text::ct_intern_len(ret, (int)bl);
        if (!rt) return 0;
        if (strncmp(rt, "struct ", 7) == 0)
            return strcmp(rt + 7, self->sym->struct_at(si)->name) == 0;
        return strcmp(rt, self->sym->struct_at(si)->name) == 0;
    }

    /* A declaration: `struct T *p = malloc(...)` (or a call to a function that
       returns an owned pointer of the same struct) starts tracking `p`. Any
       other owned variable named in the initialiser escapes here, because L2
       runs its assignment scan on the declaration line as well. */
    int leak_decl(int n)
    {
        int e, vi, i, si, heap, call_owned;
        (void)self;

        e = self->arena->nodes[n].a;
        if (e < 0) return 0;
        heap = self->expr_alloc(e);
        call_owned = 0;
        si = -1;
        {
            const char *base;
            const char *sname;
            const char *tp = self->arena->nodes[n].text;
            size_t bl = strlen(tp);
            if (bl > 0 && tp[bl - 1] == '*' && self->arena->nodes[n].text3[0] == 0) {
                while (bl > 0 && (tp[bl - 1] == '*' || tp[bl - 1] == ' ')) bl--;
                base = runtime::text::ct_intern_len(tp, (int)bl);
                if (!base) return -1;
                if (strncmp(base, "struct ", 7) == 0) sname = base + 7;
                else sname = base;
                si = self->sym->find_struct(sname);
                if (!heap && si >= 0 && self->arena->nodes[e].kind == N_CALL) {
                    int fi = self->sym->find_func(self->arena->nodes[e].text2);
                    if (fi >= 0 && self->sym->fn_at(fi)->ret_owned)
                        call_owned = self->ret_same_struct(self->sym->fn_at(fi)->ret, si);
                }
            }
        }
        vi = self->sym->find_var(self->arena->nodes[n].text2);
        if (vi >= 0 && si >= 0) {
            self->sym->var_at(vi)->st = si;
            if (heap || call_owned) {
                self->sym->var_at(vi)->owned = 1;
                self->sym->var_at(vi)->own_line = self->arena->nodes[n].line;
            }
        }
        for (i = 0; i < self->sym->nvar; i++) {
            if (i == vi) continue;
            /* a borrow keeps its handback (SH-35) */
            if (self->sym->var_at(i)->borrowed) continue;
            if (!self->sym->var_at(i)->owned && !self->sym->var_at(i)->autodrop) continue;
            if (!self->expr_mentions(e, self->sym->var_at(i)->name)) continue;
            self->sym->var_at(i)->owned = 0;
            if (self->expr_returns(e, self->sym->var_at(i)->name)) self->sym->var_at(i)->autodrop = 0;
        }
        return 0;
    }

    /* A scope is closing: a still-owned object in it is unreachable. */
    int leak_scope(int from, int to)
    {
        int i;
        (void)self;
        for (i = from; i < to; i++)
            if (self->sym->var_at(i)->owned && !self->sym->var_at(i)->autodrop && !self->sym->var_at(i)->path_warned)
                if (self->warn_leak(i, 0) != 0) return -1;
        return 0;
    }

    /* An assignment: the target keeps ownership (`p = x` only stops AutoDrop),
       anything else owned and named on the line escapes. */
    int leak_assign(int n)
    {
        int lhs, rhs, bv, i, k;
        (void)self;
        lhs = self->arena->nodes[n].a;
        rhs = self->arena->nodes[n].b;
        bv = -1;
        if (lhs >= 0) {
            k = self->arena->nodes[lhs].kind;
            match ((NodeKind){ .tag = k }) {
                NodeKind.NK_VAR() => {
                    bv = self->sym->find_var(self->arena->nodes[lhs].text2);
                }
                NodeKind.NK_MEMBER() | NodeKind.NK_ARROW() => {
                    int b = self->arena->nodes[lhs].a;
                    if (b >= 0 && self->arena->nodes[b].kind == N_VAR)
                        bv = self->sym->find_var(self->arena->nodes[b].text2);
                }
                _ => { }
            }
        }
        for (i = 0; i < self->sym->nvar; i++) {
            /* a borrow keeps its handback: its escape rules live in
               check_borrow_store, and the exit must still hand the object back
               (SH-35) */
            if (self->sym->var_at(i)->borrowed) continue;
            if (i == bv) {
                if (self->sym->var_at(i)->autodrop && lhs >= 0 && self->arena->nodes[lhs].kind == N_VAR)
                    self->sym->var_at(i)->autodrop = 0;
                continue;
            }
            if (!self->sym->var_at(i)->owned && !self->sym->var_at(i)->autodrop) continue;
            if (!self->expr_mentions(lhs, self->sym->var_at(i)->name)
                && !self->expr_mentions(rhs, self->sym->var_at(i)->name)) continue;
            self->sym->var_at(i)->owned = 0;
            if (self->expr_returns(rhs, self->sym->var_at(i)->name)) self->sym->var_at(i)->autodrop = 0;
        }
        return 0;
    }

    /* A return: at the body's own level it moves the returned object's
       ownership out and tells the caller (one level, via `ret_owned`); nested in
       a block it may be skipped, so everything it leaves behind is reported once
       as a possible leak. */
    int leak_return(int ret, int conditional, int line)
    {
        int i;
        (void)self;
        for (i = 0; i < self->sym->nvar; i++) {
            int pos = 0;
            if (self->sym->var_at(i)->autodrop) {
                /* Only a real transfer cancels the exit call: `return b->n;`
                   reads a field and still has to release (SH-36); a returned
                   `p` moves the ownership to the caller, so it must not be
                   reported as a leak either (SH-41). */
                if (ret >= 0 && self->expr_returns(ret, self->sym->var_at(i)->name)) {
                    self->sym->var_at(i)->autodrop = 0;
                    self->sym->var_at(i)->owned = 0;
                }
                continue;
            }
            if (!self->sym->var_at(i)->owned) continue;
            if (ret >= 0 && self->expr_returns(ret, self->sym->var_at(i)->name)) pos = 1;
            if (!conditional) {
                if (pos) {
                    self->sym->var_at(i)->owned = 0;
                    if (!self->leak_impl) self->ret_owned = 1;
                }
                continue;
            }
            if (!pos && !self->sym->var_at(i)->path_warned) {
                self->sym->var_at(i)->path_warned = 1;
                if (self->warn_leak(i, line) != 0) return -1;
            }
        }
        return 0;
    }

    int leak_delete(int e)
    {
        int vi;
        (void)self;
        if (e < 0 || self->arena->nodes[e].kind != N_VAR) return 0;
        vi = self->sym->find_var(self->arena->nodes[e].text2);
        if (vi < 0) return 0;
        self->sym->var_at(vi)->owned = 0;
        self->sym->var_at(vi)->autodrop = 0;
        return 0;
    }

    /* Record one leak warning. `path_line` 0 means a definite leak; otherwise it
       is the conditional return that leaves the object behind. The store lives in
       Diag.h.ct; this method only computes the fields it needs. */
    int warn_leak(int vi, int path_line)
    {
        int kind;
        const char *tname;
        (void)self;
        kind = (path_line > 0) ? 2 : 0;
        if (self->sym->var_at(vi)->st >= 0)
            tname = self->sym->struct_at(self->sym->var_at(vi)->st)->name;
        else
            tname = "";
        if (tool::diag::ct_leak_warn(kind, self->sym->var_at(vi)->own_line, path_line, self->path,
                         self->sym->var_at(vi)->name, tname) != 0)
            return self->fail("too many warnings");
        return 0;
    }

    /* The bare reason; the driver wraps it with the current position. */
    int fail(const char *msg)
    {
        (void)self;
        if (!self->errmsg || !self->errmsg[0])
            self->errmsg = runtime::text::ct_internf("%s", msg);
        return -1;
    }

    const char *last_error(void)
    {
        return self->errmsg ? self->errmsg : "";
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Memory g_memory;

struct Memory *memory_get(void)
{
    return &g_memory;
}
