pub int emit_Box_protos(struct Emitter *self, int u);
pub int emit_adt_life_defs(struct Emitter *self, int u);
pub int emit_generic_defs(struct Emitter *self, int u);
pub int emit_map_prologues(struct Emitter *e, int u);
