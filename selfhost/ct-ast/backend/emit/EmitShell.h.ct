namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitShell {
    int unused;
}

/* S8 emitter contract: built-in liveness is an input, not a decision. The
   plan is filled by the module layer from the semantic dependency graph and
   bound once per run; the emitter only reads `plan->live`. */
pub struct LModulePlan *g_plan;
/* PH-64 / P-7.2: the `slice` runtime helpers are emitted once, when the
   parser reports the slice runtime was used. Bound by the module layer; the
   shell only reads it. */
pub int *g_slice_used;

/* exported prototypes: a pub callee may be defined after its caller */
pub int Box_emit_copy_at(struct Emitter *self, const char *ctype, const char *dst, const char *src, int depth);
pub int Box_emit_release_at(struct Emitter *self, const char *ctype, const char *expr, int depth);
