/*
 * EmitHeader.h.ct - the header / map / ABI writers (SH-94 S1a-1 Phase D4,
 * pure move out of Emitter.h.ct).
 *
 * This is the S8 D4 slice: `header_guard`, the trait and struct forwards,
 * `emit_proto`, `emit_vtable_fwd`, the JSON map/model writers, the
 * compile-mode header and the ABI header now live here. The D4 move kept the
 * bodies byte-identical; the S8 closeout then made the forwards / vtable
 * writer read `LModulePlan` rows and turned the map/model writers into row
 * renderers (their selection moved to `frontend/module/Module.h.ct`). The
 * `Emitter` type
 * and the `EmitOps` / `EmitHeader` declarations live in EmitterCore.h.ct, so
 * this unit imports Core instead of the host and the import graph stays
 * acyclic. Emitter.h.ct imports this unit for the vtable.
 *
 * `write_unit_header` and its `write_unit_header_body` helper stay in the host
 * for now: their instance-closure / ADT-glue walk still reads the unit-scope
 * `g_sb` lifecycle state, so a pure move needs the shell LModule-ization
 * completed first (recorded in the S8 remaining list, not faked here).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

#include "EmitHeader.shim.h"
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable;
import frontend::module::Unit;
import frontend::sym::Symbols::Field as Field;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import backend::emit::EmitterText;
import backend::emit::EmitterQuery;
import backend::emit::EmitterMapText;
import backend::emit::EmitterCore;
import tool::sh::Sh;
import backend::lir::LModule;
import backend::lir::LModule::LModulePlan as LModulePlan;
import backend::lir::LModule::LMapRow as LMapRow;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define TEXT_LIMIT 65536
#define MAX_TEXT   160
/* the node kinds these writers filter on (mirror of Emitter.h.ct / Arena) */
#define N_NUM     8
#define N_STRUCT  20
#define N_IMPL    33
#define N_ENUM    45
#define N_UNION   48
/* S8 closeout: map / model plan row kinds (mirror of backend/lir/LModule.h.ct). */
#define LMP_TRAIT          1
#define LMP_TRAIT_M        2
#define LMP_STRUCT         3
#define LMP_STRUCT_USE     4
#define LMP_FUNC           5
#define LMP_IMPL           6
#define LMP_CALL           7
#define LMP_MAP            8
#define LMP_MAP_BIND       9
#define LMP_MSTRUCT       10
#define LMP_MSTRUCT_FIELD 11
#define LMP_MENUM         12
#define LMP_MENUM_M       13
#define LMP_MFUNC         14
#define LMP_MFUNC_PARAM   15
#define LMP_MAP_STATIC     1
#define LMP_MAP_TYPE_HOST  2
#define LMP_MAP_NS_HOST    4
#define LMP_MAP_SHIM       8
#define LMP_MAP_SHIM_SRC  16
/* the shell rows these writers now read (mirror of LModule.h.ct) */
#define LPS_STRUCTFWD  20
#define LPS_TRAITDECL  21
#define LPS_VTBLFWD    22
#define LPS_DROPPROTO  23
#define LPS_HANDBAK    24
#define LPS_LINKEXTERN 25

namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitHeader {
    int unused;
}

pub int adoption_default_only(struct Emitter *e, int si, const char *tname)
{
    int ti, mi;
    ti = e->sym->find_trait(tname);
    if (ti < 0) return 0;
    if (impl_exists_anywhere(e->arena, si, tname)) return 0;
    if (e->sym->traits[ti].nm == 0) return 0;
    for (mi = 0; mi < e->sym->traits[ti].nm; mi++)
        if (e->sym->traits[ti].m[mi].body < 0) return 0;
    return 1;
}

impl EmitHeader for Emitter {
    int emit_proto(int i)
    {
        int k;
        (void)self;

        /* a generic template is never a C symbol of its own (Phase 26) */
        if (self->sym->fn_at(i)->ntparams > 0) return 0;
        if (self->sym->fn_at(i)->is_static
            || (self->abi_mode && *self->abi_mode && !self->sym->fn_at(i)->is_pub))
            fputs("static ", self->out);
        fprintf(self->out, "%s %s(", self->sym->fn_at(i)->ret, self->sym->fn_at(i)->cname);
        if (self->sym->fn_at(i)->nparams == 0) {
            fputs("void", self->out);
        } else {
            for (k = 0; k < self->sym->fn_at(i)->nparams; k++) {
                if (k > 0) fputs(", ", self->out);
                fputs(self->sym->fn_ptype(i, k), self->out);
                if (self->sym->fn_pann(i, k) == 2
                    || self->sym->fn_pann(i, k) == 3)
                    fputs(" *", self->out);
                fputs(self->sym->fn_pdim(i, k), self->out);
            }
            if (self->sym->fn_at(i)->variadic) fputs(", ...", self->out);
        }
        fputs(")", self->out);
        /* a GNU attribute rides after the parameter list, where the source had it */
        if (self->sym->fn_at(i)->attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->sym->fn_at(i)->attr));
        fputs(";\n", self->out);
        return 0;
    }

    int emit_vtable_fwd(int prog)
    {
        int nr = backend::lir::lmod_plan_row_count(), r;
        int u = backend::lir::lmod_plan_shell_u();
        (void)prog;
        (void)self;

        /* S8 closeout: impl / adoption vtables, the `Drop` prototypes and the
           `Handback` prototypes are module-selected rows, printed in order. */
        for (r = 0; r < nr; r++) {
            int kind, si;
            const char *tname;
            if (backend::lir::lmod_plan_row_unit(r) != u) continue;
            kind = backend::lir::lmod_plan_row_kind(r);
            si = backend::lir::lmod_plan_row_node(r);
            if (kind == LPS_VTBLFWD) {
                if (si < 0 || si >= self->sym->nstructs) continue;
                tname = backend::lir::lmod_plan_row_text(r);
                if (backend::lir::lmod_plan_row_aux(r))
                    fprintf(self->out, "const struct %s_vtbl %s_%s_vtable;\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                            tname, self->sym->structs[si].name, tname);
            } else if (kind == LPS_DROPPROTO) {
                if (si < 0 || si >= self->sym->nstructs) continue;
                if (backend::lir::lmod_plan_row_aux(r) == 2)
                    fprintf(self->out, "void %s_Drop_drop(void *self);\n",
                            self->sym->structs[si].name);
                else if (backend::lir::lmod_plan_row_aux(r) == 3)
                    fprintf(self->out, "extern void %s_Drop_drop(void *self);\n",
                            self->sym->structs[si].name);
                else
                    fprintf(self->out, "static void __attribute__((unused)) %s_Drop_drop(void *self);\n",
                            self->sym->structs[si].name);
            } else if (kind == LPS_HANDBAK) {
                if (si < 0 || si >= self->sym->nstructs) continue;
                fprintf(self->out, "static void __attribute__((unused)) %s_Handback_handback(void *self);\n",
                        self->sym->structs[si].name);
            }
        }
        if (self->sym->nstructs) fputs("\n", self->out);
        return 0;
    }

    int emit_struct_fwd(void)
    {
        int nr = backend::lir::lmod_plan_row_count(), r;
        int u = backend::lir::lmod_plan_shell_u();
        (void)self;

        /* S8 closeout: the forward declarations are module-selected rows. */
        for (r = 0; r < nr; r++) {
            int si;
            if (backend::lir::lmod_plan_row_kind(r) != LPS_STRUCTFWD) continue;
            if (backend::lir::lmod_plan_row_unit(r) != u) continue;
            si = backend::lir::lmod_plan_row_node(r);
            if (si < 0 || si >= self->sym->nstructs) continue;
            if (backend::lir::lmod_plan_row_aux(r))
                fprintf(self->out, "union %s;\n", self->sym->structs[si].name);
            else
                fprintf(self->out, "struct %s;\n", self->sym->structs[si].name);
        }
        return 0;
    }

    int header_guard(const char *base, char **out)
    {
        size_t n, i, m;
        char *buf;
        (void)self;

        n = strlen(base);
        buf = tool::sh::ct_scratch_alloc((int)n + 6);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            buf[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            buf[m] = c;
            m++;
        }
        buf[m] = '_';
        buf[m + 1] = 'H';
        buf[m + 2] = 0;
        *out = buf;
        return 0;
    }

    int emit_json_str(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
        return 0;
    }

    int write_model(const char *dest, int prog)
    {
        if (self->no_write) return 0;
        FILE *f;
        const char *path;
        int i, j, nrows, first;
        (void)self;
        (void)prog;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the model");
        }
        path = self->path;
        /* S8 closeout: the three sections are plan rows selected by the module
           layer; this writer no longer reads the symbol table or the AST. */
        nrows = backend::lir::lmod_map_plan_count();
        fputs("{\n  \"schema\": \"ct.model\",\n  \"schema_version\": 1,\n", f);
        fputs("  \"compiler\": \"ct v", f);
        self->emit_json_str(f, self->version);
        fputs("\",\n  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n  \"structs\": [", f);

        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            int ffirst = 1;
            if (!r || r->kind != LMP_MSTRUCT) continue;
            if (!first) fputc(',', f);
            fputs("{\"kind\":\"", f);
            fputs(r->b ? "union" : "struct", f);
            fputs("\",\"name\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"fields\":[", r->line);
            for (j = 0; j < nrows; j++) {
                struct LMapRow *c = backend::lir::lmod_map_plan_row(j);
                if (!c || c->kind != LMP_MSTRUCT_FIELD || c->parent != i) continue;
                if (!ffirst) fputc(',', f);
                ffirst = 0;
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, c->t1);
                fputs("\",\"type\":\"", f);
                self->emit_json_str(f, c->t2);
                fputs("\",\"visibility\":\"unknown\",\"loc\":{\"file\":\"", f);
                self->emit_json_str(f, path);
                fprintf(f, "\",\"line\":%d,\"col\":%d}}", c->a, c->b);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n  \"enums\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            int ffirst = 1;
            if (!r || r->kind != LMP_MENUM) continue;
            if (!first) fputc(',', f);
            fputs("{\"kind\":\"enum\",\"name\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"members\":[", r->line);
            for (j = 0; j < nrows; j++) {
                struct LMapRow *c = backend::lir::lmod_map_plan_row(j);
                if (!c || c->kind != LMP_MENUM_M || c->parent != i) continue;
                if (!ffirst) fputc(',', f);
                ffirst = 0;
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, c->t1);
                fprintf(f, "\",\"value\":%d}", c->a);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n  \"functions\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            int ffirst = 1;
            if (!r || r->kind != LMP_MFUNC) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, r->t2);
            fputs("\",\"visibility\":\"unknown\",\"returns\":\"", f);
            self->emit_json_str(f, r->t3);
            fprintf(f, "\",\"line\":%d,\"params\":[", r->line);
            for (j = 0; j < nrows; j++) {
                struct LMapRow *c = backend::lir::lmod_map_plan_row(j);
                if (!c || c->kind != LMP_MFUNC_PARAM || c->parent != i) continue;
                if (!ffirst) fputc(',', f);
                ffirst = 0;
                fputs("{\"type\":\"", f);
                self->emit_json_str(f, c->t1);
                fputs("\"}", f);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("]\n}\n", f);
        if (f != stdout && fclose(f) != 0) return self->fail("cannot write the model");
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        if (self->no_write) return 0;
        FILE *f;
        const char *path;
        int i, j, nrows, first;
        (void)self;
        (void)prog;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the map");
        }
        path = self->path;
        /* S8 closeout: the six sections are plan rows selected by the module
           layer; this writer no longer reads the symbol table or the AST. */
        nrows = backend::lir::lmod_map_plan_count();
        fputs("{\n", f);
        fprintf(f, "  \"compiler\": \"ct v%s\",\n", self->version);
        fputs("  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n", f);

        fputs("  \"traits\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            int mfirst = 1;
            if (!r || r->kind != LMP_TRAIT || r->unit != u) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, r->t2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"methods\":[", r->line);
            for (j = 0; j < nrows; j++) {
                struct LMapRow *c = backend::lir::lmod_map_plan_row(j);
                if (!c || c->kind != LMP_TRAIT_M || c->parent != i) continue;
                if (!mfirst) fputc(',', f);
                mfirst = 0;
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, c->t1);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, c->t2);
                fprintf(f, "\",\"params\":%d}", c->a);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"structs\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            int ufirst = 1;
            if (!r || r->kind != LMP_STRUCT || r->unit != u) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, r->t2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"uses\":[", r->line);
            for (j = 0; j < nrows; j++) {
                struct LMapRow *c = backend::lir::lmod_map_plan_row(j);
                if (!c || c->kind != LMP_STRUCT_USE || c->parent != i) continue;
                if (!ufirst) fputc(',', f);
                ufirst = 0;
                fputc('"', f);
                self->emit_json_str(f, c->t1);
                fputc('"', f);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"functions\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            if (!r || r->kind != LMP_FUNC || r->unit != u) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"ret\":\"", r->line);
            self->emit_json_str(f, r->t2);
            fprintf(f, "\",\"params\":%d}", r->b);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"impls\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            if (!r || r->kind != LMP_IMPL || r->unit != u) continue;
            if (!first) fputc(',', f);
            fputs("{\"struct\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"trait\":\"", f);
            self->emit_json_str(f, r->t2);
            fputs("\",\"method\":\"", f);
            self->emit_json_str(f, r->t3);
            fputs("\",\"symbol\":\"", f);
            fprintf(f, "%s_%s_%s", r->t1, r->t2, r->t3);
            fputs("\",\"ret\":\"", f);
            self->emit_json_str(f, r->t4);
            fprintf(f, "\",\"params\":%d,\"file\":\"", r->a);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", r->line);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"calls\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            if (!r || r->kind != LMP_CALL || r->unit != u) continue;
            if (!first) fputc(',', f);
            fputs("{\"caller\":\"", f);
            self->emit_json_str(f, r->t1);
            fputs("\",\"callee\":\"", f);
            self->emit_json_str(f, r->t2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", r->line);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"maps\": [", f);
        first = 1;
        for (i = 0; i < nrows; i++) {
            struct LMapRow *r = backend::lir::lmod_map_plan_row(i);
            int bfirst = 1;
            if (!r || r->kind != LMP_MAP) continue;
            if (!first) fputc(',', f);
            fputs("{\"trait\":\"", f);
            self->emit_json_str(f, r->t1);
            if (r->b & LMP_MAP_STATIC) {
                fputs("\",\"static\":true", f);
                /* A mapping unit's shim is part of that map's definition, so
                   the JSON names the files a consumer build has to carry. */
                if (r->b & LMP_MAP_SHIM) {
                    fputs(",\"shim\":{\"header\":\"", f);
                    self->emit_json_str(f, r->t4);
                    if (r->b & LMP_MAP_SHIM_SRC) {
                        fputs("\",\"source\":\"", f);
                        self->emit_json_str(f, r->t5);
                    }
                    fputs("\"}", f);
                }
                fputs(",\"instance\":\"", f);
            } else {
                fputs("\",\"instance\":\"", f);
            }
            self->emit_json_str(f, r->t2);
            fputs("\",\"host\":\"", f);
            if (r->b & LMP_MAP_TYPE_HOST) fputs("type", f);
            else if (r->b & LMP_MAP_NS_HOST) fputs("namespace", f);
            else fputs("instance", f);
            if (r->b & LMP_MAP_TYPE_HOST) {
                fputs("\",\"type\":\"", f);
                self->emit_json_str(f, r->t3);
            }
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"bindings\":[", r->line);
            for (j = 0; j < nrows; j++) {
                struct LMapRow *c = backend::lir::lmod_map_plan_row(j);
                if (!c || c->kind != LMP_MAP_BIND || c->parent != i) continue;
                if (!bfirst) fputc(',', f);
                bfirst = 0;
                fputs("{\"method\":\"", f);
                self->emit_json_str(f, c->t1);
                fputs("\",\"symbol\":\"", f);
                self->emit_json_str(f, c->t2);
                if (r->b & LMP_MAP_STATIC)
                    fputs("\",\"wrapper\":false,\"inline\":true}", f);
                else
                    fprintf(f, "\",\"wrapper\":%s}", c->b ? "false" : "true");
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("]\n", f);
        fputs("}\n", f);

        if (f != stdout) {
            if (fclose(f) != 0) return self->fail("cannot write the map");
        }
        return 0;
    }

    int write_abi_header(const char *path)
    {
        int i, j, k, n, ns, root, fi;
        int order[256];
        char *upper;
        const char *fwd[64];
        unsigned long h;
        FILE *f;

        (void)self;
        /* S8 emitter contract: the module layer selected the export set and
           handed it over in the plan; the writer no longer re-derives it. */
        root = backend::lir::lmod_plan_abi_root();
        n = backend::lir::lmod_plan_abi_n();
        if (root < 0 || n <= 0) {
            if (!self->abi_root || !self->abi_exports || !self->abi_n)
                return self->fail("ABI tables are not bound");
            root = *self->abi_root;
            n = *self->abi_n;
        }
        if (root < 0 || root >= *self->nunits) return self->fail("bad ABI root unit");
        upper = tool::sh::ct_scratch_alloc((int)strlen(self->units[root].base) + 1);
        {
            const char *ub = self->units[root].base;
            size_t ul = strlen(ub);
            for (i = 0; i < (int)ul; i++) {
                char c = ub[i];
                if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
                else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
                upper[i] = c;
            }
            upper[ul] = 0;
        }
        for (i = 0; upper[i]; i++) {
            char c = upper[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            upper[i] = c;
        }
        if (n > 256) n = 256;
        for (i = 0; i < n; i++) {
            order[i] = backend::lir::lmod_plan_abi_export(i);
            if (order[i] < 0) order[i] = self->abi_exports[i];
        }
        /* Stable, deterministic order: C symbol name. */
        for (i = 0; i < n; i++)
            for (j = i + 1; j < n; j++)
                if (strcmp(self->sym->fn_at(order[i])->cname,
                           self->sym->fn_at(order[j])->cname) > 0) {
                    k = order[i]; order[i] = order[j]; order[j] = k;
                }
        h = 2166136261UL;
        for (i = 0; i < n; i++) {
            const char *s = self->sym->fn_at(order[i])->cname;
            while (*s) {
                h = (h ^ (unsigned char)*s) * 16777619UL;
                h = h & 0xffffffffUL;
                s++;
            }
        }
        f = fopen(path, "wb");
        if (!f) return self->fail("cannot write the ABI header");
        fprintf(f, "/* Generated by ct v%s from %s -- ABI surface; do not edit. */\n",
                self->version, self->path);
        fputs("/* Only the declarations in this file are ABI; the archive nm surface may be larger. */\n", f);
        fprintf(f, "#ifndef %s_ABI_H\n#define %s_ABI_H\n\n", upper, upper);
        fprintf(f, "#define %s_ABI_VERSION 1\n", upper);
        fprintf(f, "#define %s_ABI_HASH 0x%08lx\n\n", upper, h);
        /* Opaque forwards for named structs used by the exported signatures. */
        ns = 0;
        for (i = 0; i < n; i++) {
            int p;
            for (p = -1; p < self->sym->fn_at(order[i])->nparams; p++) {
                const char *tp = p < 0 ? self->sym->fn_at(order[i])->ret
                                       : self->sym->fn_ptype(order[i], p);
                const char *nm;
                int q = 0;
                /* REQ-ABI-3/4: struct, union and enum parameters all need a
                   tag forward declaration in the exported header. */
                if (strncmp(tp, "struct ", 7) == 0) {
                    nm = runtime::text::ct_internf("struct %s", tp + 7);
                } else if (strncmp(tp, "union ", 6) == 0) {
                    nm = runtime::text::ct_internf("union %s", tp + 6);
                } else if (strncmp(tp, "enum ", 5) == 0) {
                    nm = runtime::text::ct_internf("enum %s", tp + 5);
                } else {
                    continue;
                }
                if (!nm) return self->fail("out of memory");
                /* keep only the tag spelling (drop trailing stars/space) */
                q = (int)strlen(nm);
                while (q > 0 && !(isalnum((unsigned char)nm[q - 1]) || nm[q - 1] == '_')) q--;
                if (!q) continue;
                nm = runtime::text::ct_intern_len(nm, q);
                if (!nm) return self->fail("out of memory");
                for (j = 0; j < ns; j++) if (strcmp(fwd[j], nm) == 0) break;
                if (j == ns && ns < 64) fwd[ns++] = nm;
            }
        }
        for (i = 0; i < ns; i++)
            for (j = i + 1; j < ns; j++)
                if (strcmp(fwd[i], fwd[j]) > 0) {
                    const char *tmp = fwd[i];
                    fwd[i] = fwd[j];
                    fwd[j] = tmp;
                }
        for (i = 0; i < ns; i++) fprintf(f, "%s;\n", fwd[i]);
        if (ns > 0) fputs("\n", f);
        for (i = 0; i < n; i++) {
            fi = order[i];
            fprintf(f, "%s %s(", self->sym->fn_at(fi)->ret, self->sym->fn_at(fi)->cname);
            if (self->sym->fn_at(fi)->nparams == 0) fputs("void", f);
            for (j = 0; j < self->sym->fn_at(fi)->nparams; j++) {
                if (j > 0) fputs(", ", f);
                fputs(self->sym->fn_ptype(fi, j), f);
                /* Phase 78 S2: the ABI surface spells a ref/out parameter as
                   the pointer the definition actually takes. */
                if (self->sym->fn_pann(fi, j) == 2
                    || self->sym->fn_pann(fi, j) == 3)
                    fputs(" *", f);
            }
            fputs(");\n", f);
        }
        fputs("\n#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot close the ABI header");
        return 0;
    }

    int write_header(const char *outc)
    {
        if (self->no_write) return 0;
        char *path;
        if (self->abi_mode && *self->abi_mode)
            return self->write_abi_header(outc);
        char *base;
        char *guard;
        const char *name;
        FILE *f;
        size_t n;

        (void)self;
        /* S1a-0 C2l: the compile-mode `-o` becomes a run-scoped block; the
           `.c` -> `.h` spelling and the header guard are derived from it. */
        path = tool::sh::ct_scratch_dup(outc);
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        base = tool::sh::ct_scratch_dup(name);
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        if (self->header_guard(base, &guard) != 0) return -1;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                self->version, self->path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }

}
