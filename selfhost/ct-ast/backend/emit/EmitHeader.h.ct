/*
 * EmitHeader.h.ct - the header / map / ABI writers (SH-94 S1a-1 Phase D4,
 * pure move out of Emitter.h.ct).
 *
 * This is the S8 D4 slice: `header_guard`, the trait and struct forwards,
 * `emit_proto`, `emit_vtable_fwd`, `emit_trait_range`, the JSON map/model
 * writers, the compile-mode header and the ABI header now live here. The
 * bodies are byte-identical to the ones Emitter.h.ct held; the `Emitter` type
 * and the `EmitOps` / `EmitHeader` declarations live in EmitterCore.h.ct, so
 * this unit imports Core instead of the host and the import graph stays
 * acyclic. Emitter.h.ct imports this unit for the vtable.
 *
 * `write_unit_header` and its `write_unit_header_body` helper stay in the host
 * for now: their instance-closure / ADT-glue walk still reads the unit-scope
 * `g_sb` lifecycle state, so a pure move needs the shell LModule-ization
 * completed first (recorded in the S8 remaining list, not faked here).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

#include "EmitHeader.shim.h"
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable;
import frontend::module::Unit;
import frontend::sym::Symbols::Field as Field;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import backend::emit::EmitterText;
import backend::emit::EmitterQuery;
import backend::emit::EmitterMapText;
import backend::emit::EmitterCore;
import tool::sh::Sh;
import backend::lir::LModule;
import backend::lir::LModule::LModulePlan as LModulePlan;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define TEXT_LIMIT 65536
#define MAX_TEXT   160
/* the node kinds these writers filter on (mirror of Emitter.h.ct / Arena) */
#define N_NUM     8
#define N_STRUCT  20
#define N_IMPL    33
#define N_ENUM    45
#define N_UNION   48

namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitHeader {
    int unused;
}

pub int adoption_default_only(struct Emitter *e, int si, const char *tname)
{
    int ti, mi;
    ti = e->sym->find_trait(tname);
    if (ti < 0) return 0;
    if (impl_exists_anywhere(e->arena, si, tname)) return 0;
    if (e->sym->traits[ti].nm == 0) return 0;
    for (mi = 0; mi < e->sym->traits[ti].nm; mi++)
        if (e->sym->traits[ti].m[mi].body < 0) return 0;
    return 1;
}

impl EmitHeader for Emitter {
    int emit_proto(int i)
    {
        int k;
        (void)self;

        /* a generic template is never a C symbol of its own (Phase 26) */
        if (self->sym->funcs[i].ntparams > 0) return 0;
        if (self->sym->funcs[i].is_static
            || (self->abi_mode && *self->abi_mode && !self->sym->funcs[i].is_pub))
            fputs("static ", self->out);
        fprintf(self->out, "%s %s(", self->sym->funcs[i].ret, self->sym->funcs[i].cname);
        if (self->sym->funcs[i].nparams == 0) {
            fputs("void", self->out);
        } else {
            for (k = 0; k < self->sym->funcs[i].nparams; k++) {
                if (k > 0) fputs(", ", self->out);
                fputs(self->sym->funcs[i].ptype[k], self->out);
                if (self->sym->funcs[i].pann[k] == 2
                    || self->sym->funcs[i].pann[k] == 3)
                    fputs(" *", self->out);
                fputs(self->sym->funcs[i].pdim[k], self->out);
            }
            if (self->sym->funcs[i].variadic) fputs(", ...", self->out);
        }
        fputs(")", self->out);
        /* a GNU attribute rides after the parameter list, where the source had it */
        if (self->sym->funcs[i].attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->sym->funcs[i].attr));
        fputs(";\n", self->out);
        return 0;
    }

    int emit_vtable_fwd(int prog)
    {
        int n, si;
        const char *tname;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl: no struct row to name */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0)
                continue;   /* no vptr, no vtable */
            if (self->vtable_exported(si, tname))
                fprintf(self->out, "const struct %s_vtbl %s_%s_vtable;\n",
                        tname, self->sym->structs[si].name, tname);
            else
                fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                        tname, self->sym->structs[si].name, tname);
        }
        /* adoptions that need no impl: an all-default trait fills its own
           slots, so the vtable must be visible to the initialisers below */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int ui;
            const char *tname;
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                if (!adoption_default_only(self, si, tname)) continue;
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "const struct %s_vtbl %s_%s_vtable;\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                            tname, self->sym->structs[si].name, tname);
            }
        }
        /* a `delete` in a function body runs before the drop definition below.
           PH-48 D48-2: in build mode the definition is owned by exactly one
           unit, so only that unit writes the non-static prototype; every other
           unit declares `extern` and calls the owner's body (compile mode keeps
           the old static pair byte for byte, and generic instance rows keep
           their legacy writer). */
        for (si = 0; si < self->sym->nstructs; si++) {
            int owner, legacy;
            if (!self->sym->structs[si].uses_drop
                || self->sym->structs[si].is_template) continue;
            owner = self->sym->structs[si].owner;
            legacy = (self->cur_unit < 0 || owner < 0);
            if (self->cur_unit < 0) {
                fprintf(self->out,
                        "static void __attribute__((unused)) %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            } else if (legacy) {
                /* the legacy writer emits a static body in every unit; the
                   instance body is written before its first use, so a static
                   prototype in a unit that never defines it is only a gcc
                   -Wunused-function warning (Box in build mode, CI-18). */
                if (self->sym->structs[si].is_inst) continue;
                fprintf(self->out,
                        "static void __attribute__((unused)) %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            } else if (owner == self->cur_unit) {
                /* no local body: the impl lives elsewhere (L48-2, rejected by
                   the module layer) and a stale prototype would be a lie */
                if (self->sym->structs[si].has_drop_impl
                    && !self->unit_has_drop_impl(self->cur_unit, si))
                    continue;
                fprintf(self->out, "void %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            } else {
                fprintf(self->out, "extern void %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            }
        }
        /* a `borrow` release runs before the handback definition below */
        for (si = 0; si < self->sym->nstructs; si++)
            if (self->sym->structs[si].has_handback_impl)
                fprintf(self->out, "static void __attribute__((unused)) %s_Handback_handback(void *self);\n",
                        self->sym->structs[si].name);
        if (self->sym->nstructs) fputs("\n", self->out);
        return 0;
    }

    int emit_trait_range(int start, int end, int mode)
    {
        int t, m, k;
        (void)self;

        for (t = start; t < end; t++) {
            if (self->sym->traits[t].is_static || self->sym->traits[t].ntparams > 0) continue;
            if (mode == 1 && !self->sym->traits[t].is_pub) continue;
            if (mode == 2 && self->sym->traits[t].is_pub) continue;
            fprintf(self->out, "struct %s_vtbl {\n", self->sym->traits[t].name);
            for (m = 0; m < self->sym->traits[t].nm; m++) {
                fprintf(self->out, "    %s (*%s)(void *", self->sym->traits[t].m[m].ret,
                        self->sym->traits[t].m[m].name);
                for (k = 0; k < self->sym->traits[t].m[m].nparams; k++) {
                    fprintf(self->out, ", %s", self->sym->traits[t].m[m].ptype[k]);
                    if (self->sym->traits[t].m[m].pann[k] == 2
                        || self->sym->traits[t].m[m].pann[k] == 3)
                        fputs(" *", self->out);
                }
                fputs(");\n", self->out);
            }
            fputs("};\n", self->out);
            fprintf(self->out, "struct %s_iface {\n    void *self;\n    const struct %s_vtbl *vt;\n};\n\n",
                    self->sym->traits[t].name, self->sym->traits[t].name);
        }
        return 0;
    }

    int emit_struct_fwd(void)
    {
        int i, ti;
        (void)self;

        for (i = 0; i < self->sym->nstructs; i++) {
            if (self->sym->structs[i].is_template) continue;
            ti = self->sym->find_type(self->sym->structs[i].name);
            if (ti < 0) continue;
            if (self->sym->type_kind[ti] == 1) fprintf(self->out, "struct %s;\n", self->sym->structs[i].name);
            else if (self->sym->type_kind[ti] == 6) fprintf(self->out, "union %s;\n", self->sym->structs[i].name);
        }
        return 0;
    }

    int header_guard(const char *base, char **out)
    {
        size_t n, i, m;
        char *buf;
        (void)self;

        n = strlen(base);
        buf = tool::sh::ct_scratch_alloc((int)n + 6);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            buf[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            buf[m] = c;
            m++;
        }
        buf[m] = '_';
        buf[m + 1] = 'H';
        buf[m + 2] = 0;
        *out = buf;
        return 0;
    }

    int emit_json_str(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
        return 0;
    }

    int write_model(const char *dest, int prog)
    {
        if (self->no_write) return 0;
        FILE *f;
        const char *path;
        int n, i, j, first;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the model");
        }
        path = self->path;
        fputs("{\n  \"schema\": \"ct.model\",\n  \"schema_version\": 1,\n", f);
        fputs("  \"compiler\": \"ct v", f);
        self->emit_json_str(f, self->version);
        fputs("\",\n  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n  \"structs\": [", f);

        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, bi, bn, skip = 0;
            if (self->arena->nodes[n].kind != N_STRUCT
                && self->arena->nodes[n].kind != N_UNION) continue;
            for (bi = 0; bi < self->nbuiltin && !skip; bi++) {
                int bu = self->builtins[bi];
                if (bu < 0 || bu >= *self->nunits) continue;
                for (bn = self->arena->nodes[self->units[bu].prog].a; bn >= 0;
                     bn = self->arena->nodes[bn].next)
                    if (bn == n) { skip = 1; break; }
            }
            if (skip) continue;
            if (strcmp(self->arena->nodes[n].text2, "ct_buf") == 0
                || strcmp(self->arena->nodes[n].text2, "Vec") == 0
                || strcmp(self->arena->nodes[n].text2, "Map") == 0
                || strcmp(self->arena->nodes[n].text2, "MapEntry") == 0
                || strcmp(self->arena->nodes[n].text2, "Option") == 0
                || strcmp(self->arena->nodes[n].text2, "Result") == 0
                || strcmp(self->arena->nodes[n].text2, "Str") == 0) continue;
            if (!first) fputc(',', f);
            fputs("{\"kind\":\"", f);
            fputs(self->arena->nodes[n].kind == N_UNION ? "union" : "struct", f);
            fputs("\",\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"fields\":[", self->arena->nodes[n].line);
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < self->sym->structs[si].nfields; i++) {
                    if (i > 0) fputc(',', f);
                    fputs("{\"name\":\"", f);
                    self->emit_json_str(f, self->sym->structs[si].fields[i].name);
                    fputs("\",\"type\":\"", f);
                    self->emit_json_str(f, self->sym->structs[si].fields[i].type);
                    fputs("\",\"visibility\":\"unknown\",\"loc\":{\"file\":\"", f);
                    self->emit_json_str(f, path);
                    fprintf(f, "\",\"line\":%d,\"col\":%d}}",
                            self->sym->structs[si].fields[i].line,
                            self->sym->structs[si].fields[i].col);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n  \"enums\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int m, bi, bn, skip = 0;
            if (self->arena->nodes[n].kind != N_ENUM) continue;
            /* Phase 84: the model's `enums` list stays C enums; an ADT's layout
               is documented in the spec, not in this export. */
            if (self->arena->nodes[n].aux & 2) continue;
            for (bi = 0; bi < self->nbuiltin && !skip; bi++) {
                int bu = self->builtins[bi];
                if (bu < 0 || bu >= *self->nunits) continue;
                for (bn = self->arena->nodes[self->units[bu].prog].a; bn >= 0;
                     bn = self->arena->nodes[bn].next)
                    if (bn == n) { skip = 1; break; }
            }
            if (skip) continue;
            if (!first) fputc(',', f);
            fputs("{\"kind\":\"enum\",\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"members\":[", self->arena->nodes[n].line);
            for (m = self->arena->nodes[n].a, i = 0; m >= 0; m = self->arena->nodes[m].next, i++) {
                int val = 0;
                if (i > 0) fputc(',', f);
                if (self->arena->nodes[m].a >= 0
                    && self->arena->nodes[self->arena->nodes[m].a].kind == N_NUM)
                    val = (int)self->arena->nodes[self->arena->nodes[m].a].num;
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text2);
                fprintf(f, "\",\"value\":%d}", val);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n  \"functions\": [", f);
        first = 1;
        for (i = 0; i < self->sym->nfunc; i++) {
            if (strncmp(self->sym->funcs[i].name, "str_", 4) == 0
                || strncmp(self->sym->funcs[i].name, "vec_", 4) == 0
                || strncmp(self->sym->funcs[i].name, "map_", 4) == 0
                || strncmp(self->sym->funcs[i].name, "option_", 7) == 0
                || strncmp(self->sym->funcs[i].name, "result_", 7) == 0) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].cname);
            fputs("\",\"visibility\":\"unknown\",\"returns\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].ret);
            fprintf(f, "\",\"line\":%d,\"params\":[", self->sym->funcs[i].line);
            for (j = 0; j < self->sym->funcs[i].nparams; j++) {
                if (j > 0) fputc(',', f);
                fputs("{\"type\":\"", f);
                self->emit_json_str(f, self->sym->funcs[i].ptype[j]);
                fputs("\"}", f);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("]\n}\n", f);
        if (f != stdout && fclose(f) != 0) return self->fail("cannot write the model");
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        if (self->no_write) return 0;
        FILE *f;
        const char *path;
        int trs, tre, fns, fne, cls, cle;
        int i, j, m, n, first, si, count;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the map");
        }
        if (u >= 0) {
            path = self->units[u].path;
            trs = self->units[u].tr_start;
            tre = self->units[u].tr_end;
            fns = self->units[u].fn_start;
            fne = self->units[u].fn_end;
            cls = self->units[u].call_start;
            cle = self->units[u].call_end;
        } else {
            path = self->path;
            trs = 0;
            tre = self->sym->ntraits;
            fns = 0;
            fne = self->sym->nfunc;
            cls = 0;
            cle = (*self->ncalls);
        }

        fputs("{\n", f);
        fprintf(f, "  \"compiler\": \"ct v%s\",\n", self->version);
        fputs("  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n", f);

        fputs("  \"traits\": [", f);
        first = 1;
        for (i = trs; i < tre; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->traits[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->sym->traits[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"methods\":[", self->sym->traits[i].line);
            for (m = 0; m < self->sym->traits[i].nm; m++) {
                if (m > 0) fputc(',', f);
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, self->sym->traits[i].m[m].name);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->sym->traits[i].m[m].ret);
                fprintf(f, "\",\"params\":%d}", self->sym->traits[i].m[m].nparams);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"structs\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_STRUCT) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"uses\":[", self->arena->nodes[n].line);
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < self->sym->structs[si].nuse; i++) {
                    if (i > 0) fputc(',', f);
                    fputc('"', f);
                    self->emit_json_str(f, self->sym->structs[si].use[i]);
                    fputc('"', f);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"functions\": [", f);
        first = 1;
        for (i = fns; i < fne; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"ret\":\"", self->sym->funcs[i].line);
            self->emit_json_str(f, self->sym->funcs[i].ret);
            fprintf(f, "\",\"params\":%d}", self->sym->funcs[i].nparams);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"impls\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            const char *tname;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl has no single struct symbol */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no trait */
            tname = self->arena->nodes[n].text2;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                if (!first) fputc(',', f);
                fputs("{\"struct\":\"", f);
                self->emit_json_str(f, self->sym->structs[si].name);
                fputs("\",\"trait\":\"", f);
                self->emit_json_str(f, tname);
                fputs("\",\"method\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text2);
                fputs("\",\"symbol\":\"", f);
                fprintf(f, "%s_%s_%s", self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text);
                count = 0;
                for (i = self->arena->nodes[m].a; i > 0; i = self->arena->nodes[i].next) count++;
                fprintf(f, "\",\"params\":%d,\"file\":\"", count);
                self->emit_json_str(f, path);
                fprintf(f, "\",\"line\":%d}", self->arena->nodes[n].line);
                first = 0;
            }
        }
        fputs("],\n", f);

        fputs("  \"calls\": [", f);
        for (i = cls; i < cle; i++) {
            if (i > cls) fputc(',', f);
            fputs("{\"caller\":\"", f);
            self->emit_json_str(f, (*self->calls)[i].caller);
            fputs("\",\"callee\":\"", f);
            self->emit_json_str(f, (*self->calls)[i].callee);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", (*self->calls)[i].line);
        }
        fputs("],\n", f);

        fputs("  \"maps\": [", f);
        first = 1;
        for (i = 0; i < (*self->nmaps); i++) {
            /* LANG-29 S4 / B4: a `map binding` is a conversion registry entry,
               not a trait map; the `--emit-map` contract stays the Phase 11
               shape (its own reporting is out of the B4 slice). */
            if ((*self->maps)[i].is_binding) continue;
            if (!first) fputc(',', f);
            first = 0;
            fputs("{\"trait\":\"", f);
            self->emit_json_str(f, (*self->maps)[i].trait);
            if ((*self->maps)[i].is_static) {
                int su = (*self->maps)[i].unit;
                fputs("\",\"static\":true", f);
                /* A mapping unit's shim is part of that map's definition, so the
                   JSON names the files a consumer build has to carry. */
                if (self->units && su >= 0 && su < *self->nunits
                    && self->units[su].has_shim) {
                    fputs(",\"shim\":{\"header\":\"", f);
                    self->emit_json_str(f, self->units[su].shim_h);
                    if (self->units[su].shim_c) {
                        fputs("\",\"source\":\"", f);
                        self->emit_json_str(f, self->units[su].shim_c);
                    }
                    fputs("\"}", f);
                }
                fputs(",\"instance\":\"", f);
            } else {
                fputs("\",\"instance\":\"", f);
            }
            self->emit_json_str(f, (*self->maps)[i].inst);
            fputs("\",\"host\":\"", f);
            if ((*self->maps)[i].type_host) fputs("type", f);
            else fputs((*self->maps)[i].ns_host ? "namespace" : "instance", f);
            if ((*self->maps)[i].type_host) {
                fputs("\",\"type\":\"", f);
                self->emit_json_str(f, (*self->maps)[i].host_type);
            }
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"bindings\":[", (*self->maps)[i].line);
            for (j = 0; j < (*self->maps)[i].nb; j++) {
                if (j > 0) fputc(',', f);
                fputs("{\"method\":\"", f);
                self->emit_json_str(f, (*self->maps)[i].b[j].method);
                fputs("\",\"symbol\":\"", f);
                if ((*self->maps)[i].is_static) {
                    const char *callee;
                    callee = map_recipe_callee_text((*self->maps)[i].b[j].call);
                    if (!callee) return self->fail("out of memory");
                    self->emit_json_str(f, callee);
                } else {
                    self->emit_json_str(f, (*self->maps)[i].b[j].direct
                                              ? (*self->maps)[i].b[j].call
                                              : (*self->maps)[i].b[j].wrapper);
                }
                if ((*self->maps)[i].is_static)
                    fputs("\",\"wrapper\":false,\"inline\":true}", f);
                else
                    fprintf(f, "\",\"wrapper\":%s}",
                            (*self->maps)[i].b[j].direct ? "false" : "true");
            }
            fputs("]}", f);
        }
        fputs("]\n", f);
        fputs("}\n", f);

        if (f != stdout) {
            if (fclose(f) != 0) return self->fail("cannot write the map");
        }
        return 0;
    }

    int write_abi_header(const char *path)
    {
        int i, j, k, n, ns, root, fi;
        int order[256];
        char *upper;
        const char *fwd[64];
        unsigned long h;
        FILE *f;

        (void)self;
        if (!self->abi_root || !self->abi_exports || !self->abi_n)
            return self->fail("ABI tables are not bound");
        root = *self->abi_root;
        if (root < 0 || root >= *self->nunits) return self->fail("bad ABI root unit");
        upper = tool::sh::ct_scratch_alloc((int)strlen(self->units[root].base) + 1);
        {
            const char *ub = self->units[root].base;
            size_t ul = strlen(ub);
            for (i = 0; i < (int)ul; i++) {
                char c = ub[i];
                if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
                else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
                upper[i] = c;
            }
            upper[ul] = 0;
        }
        for (i = 0; upper[i]; i++) {
            char c = upper[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            upper[i] = c;
        }
        n = *self->abi_n;
        if (n > 256) n = 256;
        for (i = 0; i < n; i++) order[i] = self->abi_exports[i];
        /* Stable, deterministic order: C symbol name. */
        for (i = 0; i < n; i++)
            for (j = i + 1; j < n; j++)
                if (strcmp(self->sym->funcs[order[i]].cname,
                           self->sym->funcs[order[j]].cname) > 0) {
                    k = order[i]; order[i] = order[j]; order[j] = k;
                }
        h = 2166136261UL;
        for (i = 0; i < n; i++) {
            const char *s = self->sym->funcs[order[i]].cname;
            while (*s) {
                h = (h ^ (unsigned char)*s) * 16777619UL;
                h = h & 0xffffffffUL;
                s++;
            }
        }
        f = fopen(path, "wb");
        if (!f) return self->fail("cannot write the ABI header");
        fprintf(f, "/* Generated by ct v%s from %s -- ABI surface; do not edit. */\n",
                self->version, self->path);
        fputs("/* Only the declarations in this file are ABI; the archive nm surface may be larger. */\n", f);
        fprintf(f, "#ifndef %s_ABI_H\n#define %s_ABI_H\n\n", upper, upper);
        fprintf(f, "#define %s_ABI_VERSION 1\n", upper);
        fprintf(f, "#define %s_ABI_HASH 0x%08lx\n\n", upper, h);
        /* Opaque forwards for named structs used by the exported signatures. */
        ns = 0;
        for (i = 0; i < n; i++) {
            int p;
            for (p = -1; p < self->sym->funcs[order[i]].nparams; p++) {
                const char *tp = p < 0 ? self->sym->funcs[order[i]].ret
                                       : self->sym->funcs[order[i]].ptype[p];
                const char *nm;
                int q = 0;
                /* REQ-ABI-3/4: struct, union and enum parameters all need a
                   tag forward declaration in the exported header. */
                if (strncmp(tp, "struct ", 7) == 0) {
                    nm = runtime::text::ct_internf("struct %s", tp + 7);
                } else if (strncmp(tp, "union ", 6) == 0) {
                    nm = runtime::text::ct_internf("union %s", tp + 6);
                } else if (strncmp(tp, "enum ", 5) == 0) {
                    nm = runtime::text::ct_internf("enum %s", tp + 5);
                } else {
                    continue;
                }
                if (!nm) return self->fail("out of memory");
                /* keep only the tag spelling (drop trailing stars/space) */
                q = (int)strlen(nm);
                while (q > 0 && !(isalnum((unsigned char)nm[q - 1]) || nm[q - 1] == '_')) q--;
                if (!q) continue;
                nm = runtime::text::ct_intern_len(nm, q);
                if (!nm) return self->fail("out of memory");
                for (j = 0; j < ns; j++) if (strcmp(fwd[j], nm) == 0) break;
                if (j == ns && ns < 64) fwd[ns++] = nm;
            }
        }
        for (i = 0; i < ns; i++)
            for (j = i + 1; j < ns; j++)
                if (strcmp(fwd[i], fwd[j]) > 0) {
                    const char *tmp = fwd[i];
                    fwd[i] = fwd[j];
                    fwd[j] = tmp;
                }
        for (i = 0; i < ns; i++) fprintf(f, "%s;\n", fwd[i]);
        if (ns > 0) fputs("\n", f);
        for (i = 0; i < n; i++) {
            fi = order[i];
            fprintf(f, "%s %s(", self->sym->funcs[fi].ret, self->sym->funcs[fi].cname);
            if (self->sym->funcs[fi].nparams == 0) fputs("void", f);
            for (j = 0; j < self->sym->funcs[fi].nparams; j++) {
                if (j > 0) fputs(", ", f);
                fputs(self->sym->funcs[fi].ptype[j], f);
                /* Phase 78 S2: the ABI surface spells a ref/out parameter as
                   the pointer the definition actually takes. */
                if (self->sym->funcs[fi].pann[j] == 2
                    || self->sym->funcs[fi].pann[j] == 3)
                    fputs(" *", f);
            }
            fputs(");\n", f);
        }
        fputs("\n#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot close the ABI header");
        return 0;
    }

    int write_header(const char *outc)
    {
        if (self->no_write) return 0;
        char *path;
        if (self->abi_mode && *self->abi_mode)
            return self->write_abi_header(outc);
        char *base;
        char *guard;
        const char *name;
        FILE *f;
        size_t n;

        (void)self;
        /* S1a-0 C2l: the compile-mode `-o` becomes a run-scoped block; the
           `.c` -> `.h` spelling and the header guard are derived from it. */
        path = tool::sh::ct_scratch_dup(outc);
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        base = tool::sh::ct_scratch_dup(name);
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        if (self->header_guard(base, &guard) != 0) return -1;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                self->version, self->path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }

}
