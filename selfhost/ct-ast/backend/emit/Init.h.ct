/*
 * Init.h.ct - the vptr and initialiser writer, one sub-object of the emitter.
 *
 * A CT object carries one vptr per trait it uses, and a plain C initialiser
 * cannot always fill them: an array element and a heap object have no
 * designator to reach, so they need statements after the declaration. This
 * object owns every such write -- the designator items, the statement form,
 * and the per-field / per-array-element recursion. `Emitter` keeps the rest and
 * calls in through `init_get`.
 *
 * The output stream belongs to `Emitter` and changes per unit, so this object
 * holds a pointer to that pointer, never a copy.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

#include "Init.shim.h"
import frontend::sym::Symbols;
import runtime::text::Intern;
import tool::sh::Sh;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */

namespace backend::emit;
pub trait InitOps {
    int type_has_vptr(const char *type);
    int type_needs_init(const char *type);
    int emit_vptr_items(const char *prefix, const char *type);
    int emit_vptr_stmts(const char *recv, const char *type, int ind);
    int emit_field_vptrs(int si, int started, const char *raw);
    int emit_array_field_vptrs(int si, const char *recv, int ind);
    int type_needs_nested_init(const char *type);
    int emit_elem_vptrs(const char *raw, const char *type);
    const char *strip_quals(const char *type);
}

pub struct Init {
    struct Symbols *sym;
    void **out;                 /* points at the emitter's current FILE * */
} use InitOps;

static void put_indent(FILE *f, int n)
{
    int i;
    for (i = 0; i < n * 4; i++) fputc(' ', f);
}

/* A declaration's type text can carry `const`; the struct lookup and the vtable
   name only need the base type, so drop the qualifier once here. */
static const char *unqual(const char *type)
{
    while (strncmp(type, "const ", 6) == 0) type += 6;
    while (*type == ' ') type++;
    return type;
}

/* S1a-0 C2p-3: the base struct key as one pool text. The old `ft`/`tb`
   MAX_TEXT copies cut a 2000-byte struct name, so `type_needs_init` answered
   0 and the locals of a trait-carrying long-named struct never got their vptr
   initialiser. */
static const char *base_type_key(const char *type, int strip_stars)
{
    const char *b;
    size_t tl;

    b = unqual(type);
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    while (*b == ' ') b++;
    tl = strlen(b);
    while (tl > 0 && (b[tl - 1] == ' ' || (strip_stars && b[tl - 1] == '*'))) tl--;
    return runtime::text::ct_intern_len(b, (int)tl);
}

impl InitOps for Init {
    const char *strip_quals(const char *type)
    {
        (void)self;
        return unqual(type);
    }

    int type_has_vptr(const char *type)
    {
        const char *base;
        int si;
        (void)self;

        base = unqual(type);
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->sym->find_struct(base);
        return (si >= 0 && self->sym->struct_at(si)->nuse > 0) ? 1 : 0;
    }

    /* Does this *value* type need a vptr written somewhere -- itself or through a
       nested value field? `Outer { Inner in; }` needs one even though Outer uses
       no trait of its own. Pointer types are not initialised this way. */
    int type_needs_init(const char *type)
    {
        const char *tb;
        int si, fi;
        (void)self;

        tb = base_type_key(type, 0);
        if (!tb) return 0;
        if (strchr(tb, '*') != 0) return 0;
        si = self->sym->find_struct(tb);
        if (si < 0) return 0;
        if (self->sym->struct_at(si)->nuse > 0) return 1;
        for (fi = 0; fi < self->sym->struct_at(si)->nfields; fi++) {
            const char *ft = self->sym->struct_field_at(si, fi)->type;
            if (strchr(ft, '*') != 0) continue;
            if (self->type_needs_init(ft)) return 1;
        }
        return 0;
    }

    int emit_vptr_items(const char *prefix, const char *type)
    {
        const char *base;
        FILE *f = (FILE *)(*self->out);
        int si, u, i;
        (void)self;

        base = unqual(type);
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->sym->find_struct(base);
        if (si < 0) return 0;
        for (u = 0; u < self->sym->struct_at(si)->nuse; u++) {
            char *low = tool::sh::ct_scratch_alloc(
                (int)strlen(self->sym->struct_at(si)->use[u]) + 1);
            for (i = 0; self->sym->struct_at(si)->use[u][i]; i++) {
                char c = self->sym->struct_at(si)->use[u][i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            if (u > 0) fputs(", ", f);
            fprintf(f, "%s.__%s_vptr = &%s_%s_vtable", prefix, low, base, self->sym->struct_at(si)->use[u]);
        }
        return 0;
    }

    /* The statement form of `emit_vptr_items`: write `recv.__x_vptr = ...` (and
       one level of nested value fields) for an object that could not carry an
       initialiser -- an array element, or a heap object after malloc. */
    int emit_vptr_stmts(const char *recv, const char *type, int ind)
    {
        const char *tb;
        FILE *f = (FILE *)(*self->out);
        int si, u, i, fi;
        (void)self;

        tb = base_type_key(type, 1);
        if (!tb) return 0;
        si = self->sym->find_struct(tb);
        if (si < 0) return 0;
        for (u = 0; u < self->sym->struct_at(si)->nuse; u++) {
            char *low = tool::sh::ct_scratch_alloc(
                (int)strlen(self->sym->struct_at(si)->use[u]) + 1);
            for (i = 0; self->sym->struct_at(si)->use[u][i]; i++) {
                char c = self->sym->struct_at(si)->use[u][i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            put_indent(f, ind);
            fprintf(f, "%s.__%s_vptr = &%s_%s_vtable;\n", recv, low, tb, self->sym->struct_at(si)->use[u]);
        }
        for (fi = 0; fi < self->sym->struct_at(si)->nfields; fi++) {
            const char *ft;
            const char *sub;
            ft = self->sym->struct_field_at(si, fi)->type;
            if (strchr(ft, '*') != 0) continue;
            if (self->sym->struct_field_at(si, fi)->dims[0]) continue;  /* handled by the loop form */
            if (!self->type_needs_init(ft)) continue;
            /* S1a-0 C2n-3: `recv + "." + field` is a generated member path, not
               a source identifier. Both halves may be 159 bytes, so a 160-byte
               row cut the path and the statement named a member that does not
               exist. Build it run-scoped instead; the pool lives until the
               command returns, and the recursion only reads it. */
            sub = tool::sh::ct_scratch_fmt("%s.%s", recv,
                                           self->sym->struct_field_at(si, fi)->name);
            if (self->emit_vptr_stmts(sub, ft, ind) != 0) return -1;
        }
        return self->emit_array_field_vptrs(si, recv, ind);
    }

    /* A struct-typed field with traits of its own needs a nested designator
       (`.owner.__greeter_vptr = ...`), or `s.owner.greet()` dereferences NULL.

       `raw` is the captured initialiser (`{ .who = p }`), or NULL when the
       declaration had none. A field the initialiser already assigns by value
       carries its vptr in the struct copy, so adding the nested designator on
       top would only re-write the same value and make clang warn
       (-Winitializer-overrides). A brace initialiser for the field is the
       exception: it starts the sub-object from scratch, so the vptr is needed. */
    int emit_field_vptrs(int si, int started, const char *raw)
    {
        FILE *f = (FILE *)(*self->out);
        int fi, i, j, n, depth, skip;
        (void)self;
        for (fi = 0; fi < self->sym->struct_at(si)->nfields; fi++) {
            const char *ft;
            const char *prefix;
            ft = self->sym->struct_field_at(si, fi)->type;
            if (strchr(ft, '*') != 0) continue;          /* a borrowed pointer, not a value */
            if (self->sym->struct_field_at(si, fi)->dims[0]) continue;  /* an array: no designator reaches it */
            if (!self->type_needs_init(ft)) continue;
            skip = 0;
            depth = 0;
            for (i = 0; raw && raw[i]; i++) {
                if (raw[i] == '"' || raw[i] == '\'') {
                    char q = raw[i];
                    i++;
                    while (raw[i] && raw[i] != q) {
                        if (raw[i] == '\\' && raw[i + 1]) i++;
                        i++;
                    }
                    continue;
                }
                if (raw[i] == '{' || raw[i] == '(' || raw[i] == '[') { depth++; continue; }
                if (raw[i] == '}' || raw[i] == ')' || raw[i] == ']') { depth--; continue; }
                if (raw[i] != '.' || depth != 1) continue;
                /* a top-level designator: `.name`
                   (whitespace after the dot is legal C) */
                j = i + 1;
                while (raw[j] == ' ' || raw[j] == '\t' || raw[j] == '\n' || raw[j] == '\r') j++;
                n = j;
                while ((raw[j] >= 'a' && raw[j] <= 'z') || (raw[j] >= 'A' && raw[j] <= 'Z')
                       || (raw[j] >= '0' && raw[j] <= '9') || raw[j] == '_') j++;
                /* S1a-0 C2n-3: compare the designator with the field name by
                   length, not through a 160-byte row; a 159-byte field name
                   plus the dot would not fit the old row. */
                i = j - 1;
                {
                    const char *fname = self->sym->struct_field_at(si, fi)->name;
                    size_t nl = (size_t)(j - n);
                    if (nl == 0 || nl != strlen(fname)
                        || memcmp(raw + n, fname, nl) != 0) continue;
                }
                while (raw[j] == ' ' || raw[j] == '\t' || raw[j] == '\n' || raw[j] == '\r') j++;
                if (raw[j] != '=' || raw[j + 1] == '=') continue;
                j++;
                while (raw[j] == ' ' || raw[j] == '\t' || raw[j] == '\n' || raw[j] == '\r') j++;
                skip = (raw[j] != '{');
                break;
            }
            if (skip) continue;
            /* `.field` is generated text (`1 + 159` exceeds the old row). */
            prefix = tool::sh::ct_scratch_fmt(".%s", self->sym->struct_field_at(si, fi)->name);
            if (started) fputs(", ", f);
            if (self->emit_vptr_items(prefix, ft) != 0) return -1;
            started = 1;
        }
        return 0;
    }

    /* vptr writes for struct-typed array fields. A designated initialiser cannot
       reach an array element (`.f.__x_vptr` is not valid C), so the caller emits
       these as statements after the declaration. One loop per dimension. */
    int emit_array_field_vptrs(int si, const char *recv, int ind)
    {
        FILE *f = (FILE *)(*self->out);
        int fi;
        (void)self;
        for (fi = 0; fi < self->sym->struct_at(si)->nfields; fi++) {
            const char *ft;
            const char *sub;
            const char *next;
            const char *d;
            int depth, started;
            if (!self->sym->struct_field_at(si, fi)->dims[0]) continue;
            ft = self->sym->struct_field_at(si, fi)->type;
            if (strchr(ft, '*') != 0) continue;
            if (!self->type_needs_init(ft)) continue;
            /* S1a-0 C2n-3: the member path is generated text. Keep it in the
               run-scoped pool so `recv + "." + field + "[__ct_jN]"` of any
               length stays one exact name; the old 160-byte row cut it and the
               emitted statement named a member that does not exist. */
            sub = tool::sh::ct_scratch_fmt("%s.%s", recv,
                                           self->sym->struct_field_at(si, fi)->name);
            d = self->sym->struct_field_at(si, fi)->dims;
            depth = 0;
            started = 0;
            while (*d == '[') {
                const char *close = strchr(d, ']');
                size_t bl;
                if (!close) break;
                bl = (size_t)(close - d - 1);
                if (bl == 0) break;   /* `[]`: not a definition */
                put_indent(f, ind + depth);
                /* The bound is a slice of the declaration's suffix; print it
                   directly rather than copying it into a 160-byte row. */
                fprintf(f, "for (unsigned long __ct_j%d = 0; __ct_j%d < %.*s; __ct_j%d++) {\n",
                        depth, depth, (int)bl, d + 1, depth);
                next = tool::sh::ct_scratch_fmt("%s[__ct_j%d]", sub, depth);
                sub = next;
                depth++;
                d = close + 1;
                started = 1;
            }
            if (!started) continue;
            if (self->emit_vptr_stmts(sub, ft, ind + depth) != 0) return -1;
            while (depth > 0) {
                depth--;
                put_indent(f, ind + depth);
                fputs("}\n", f);
            }
        }
        return 0;
    }

    /* True when a value of `type` needs vptrs that a single designator cannot
       reach: a non-pointer, non-array field of struct-with-traits type. Such an
       element keeps the constructor path, because an array element has no
       designator for its nested fields. */
    int type_needs_nested_init(const char *type)
    {
        const char *tb;
        int si, fi;
        (void)self;

        tb = base_type_key(type, 0);
        if (!tb) return 0;
        if (strchr(tb, '*') != 0) return 0;
        si = self->sym->find_struct(tb);
        if (si < 0) return 0;
        for (fi = 0; fi < self->sym->struct_at(si)->nfields; fi++) {
            const char *ft;
            if (self->sym->struct_field_at(si, fi)->dims[0]) continue;
            ft = self->sym->struct_field_at(si, fi)->type;
            if (strchr(ft, '*') != 0) continue;
            if (self->type_needs_init(ft)) return 1;
        }
        return 0;
    }

    /* Write a captured `{ … }` initialiser for a one-dimensional array, adding
       the element vptrs where C can actually reach them: inside each element's
       own braces. A designator after the closing `}` of the array is not valid
       C, which is what the old code emitted.

       String and character literals are copied verbatim, so a `"}"` in a name
       does not move the brace depth. Only the element level is extended; a
       nested value field keeps the constructor path (see
       `type_needs_nested_init`). */
    int emit_elem_vptrs(const char *raw, const char *type)
    {
        FILE *f = (FILE *)(*self->out);
        int i, depth;
        (void)self;

        depth = 0;
        for (i = 0; raw[i]; i++) {
            char c = raw[i];
            if (c == '"' || c == '\'') {
                char q = c;
                fputc(c, f);
                i++;
                while (raw[i] && raw[i] != q) {
                    fputc(raw[i], f);
                    if (raw[i] == '\\' && raw[i + 1]) {
                        i++;
                        fputc(raw[i], f);
                    }
                    i++;
                }
                if (raw[i]) fputc(raw[i], f);
                continue;
            }
            if (c == '(' || c == '[') { depth++; fputc(c, f); continue; }
            if (c == ')' || c == ']') { depth--; fputc(c, f); continue; }
            if (c == '{') { depth++; fputc(c, f); continue; }
            if (c == '}') {
                if (depth == 2) {
                    int j = i - 1;
                    while (j > 0 && (raw[j] == ' ' || raw[j] == '\t' || raw[j] == '\n' || raw[j] == '\r'))
                        j--;
                    if (raw[j] != '{') fputs(", ", f);
                    if (self->emit_vptr_items("", type) != 0) return -1;
                }
                depth--;
                fputc(c, f);
                continue;
            }
            fputc(c, f);
        }
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Init g_init;

/* Only primitives cross the unit boundary (a generated header carries no
   #include, so the collaborators arrive as `void *` and are cast here). */
pub void ct_init_bind(void *sym, void **out);
void ct_init_bind(void *sym, void **out)
{
    g_init.sym = (struct Symbols *)sym;
    g_init.out = out;
}

pub struct Init *init_get(void);
struct Init *init_get(void)
{
    return &g_init;
}
