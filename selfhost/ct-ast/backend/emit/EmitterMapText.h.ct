/*
 * EmitterMapText.h.ct - map-recipe text and repeatability helpers moved out of Emitter.h.ct
 * (SH-94 S1, pure move).
 *
 * Bodies are byte-identical to the ones Emitter.h.ct used to hold; the
 * declaration line only loses `static` and gains a `pub` prototype, and the
 * call sites stay unchanged (same namespace, host imports this unit).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>

import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
#define N_VAR 10
#define N_NUM 8
#define N_STR 9
#define N_INTO 63
#define N_INTO_SELF 64
#define N_MEMBER 24
#define N_ARROW 25
#define N_ADDR 27
#define N_INDEX 26

namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitterMapText {
    int unused;
}

pub void map_path_base(const char *p, char *out, int cap);
pub void map_bind_key(const char *in, char *out, int cap);
/* S1a-0 C2p-5: the full-length binding pair key as a pool text. */
pub const char *map_bind_key_text(const char *in);
pub void map_clean_type(const char *in, char *out);
pub void map_recipe_callee(const char *call, char *out);
pub int map_is_ident(int c);
pub int map_repeatable(struct Arena *a, int n);

pub void map_path_base(const char *p, char *out, int cap)
{
    const char *b = p;
    const char *q;
    for (q = p; *q; q++)
        if (*q == '/' || *q == '\\') b = q + 1;
    snprintf(out, (size_t)cap, "%s", b);
}

pub void map_bind_key(const char *in, char *out, int cap)
{
    char k[MAX_TEXT];

    frontend::type::type_key(in, k, sizeof k);
    if (strncmp(k, "struct", 6) == 0) memmove(k, k + 6, strlen(k + 6) + 1);
    else if (strncmp(k, "union", 5) == 0) memmove(k, k + 5, strlen(k + 5) + 1);
    else if (strncmp(k, "enum", 4) == 0) memmove(k, k + 4, strlen(k + 4) + 1);
    snprintf(out, (size_t)cap, "%s", k);
}

const char *map_bind_key_text(const char *in)
{
    const char *k = frontend::type::type_key_text(in);

    if (!k) return (const char *)0;
    if (strncmp(k, "struct", 6) == 0) return runtime::text::ct_intern(k + 6);
    if (strncmp(k, "union", 5) == 0) return runtime::text::ct_intern(k + 5);
    if (strncmp(k, "enum", 4) == 0) return runtime::text::ct_intern(k + 4);
    return k;
}

pub void map_clean_type(const char *in, char *out)
{
    int n = 0;
    while (*in && *in != '[') {
        out[n] = *in;
        n++;
        in++;
    }
    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '\t')) n--;
    out[n] = 0;
}

pub void map_recipe_callee(const char *call, char *out)
{
    int n = 0;
    while (*call == ' ' || *call == '\t' || *call == '\n' || *call == '\r') call++;
    while (((*call >= 'a' && *call <= 'z') || (*call >= 'A' && *call <= 'Z')
            || (*call >= '0' && *call <= '9') || *call == '_') && n + 1 < MAX_TEXT) {
        out[n] = *call;
        n++;
        call++;
    }
    out[n] = 0;
}

pub int map_is_ident(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
        || c == '_';
}

pub int map_repeatable(struct Arena *a, int n)
{
    int k;
    if (n < 0) return 0;
    k = a->nodes[n].kind;
    if (k == N_VAR || k == N_NUM || k == N_STR) return 1;
    /* Phase 30: the receiver is a promoted local by the time a recipe runs, so
       repeating it is pure (§2.7 rule 3; a category-2 receiver is `(*recv)`). */
    if (k == N_INTO || k == N_INTO_SELF) return 1;
    if (k == N_MEMBER || k == N_ARROW || k == N_ADDR) return map_repeatable(a, a->nodes[n].a);
    if (k == N_INDEX) return map_repeatable(a, a->nodes[n].a) && map_repeatable(a, a->nodes[n].b);
    return 0;
}
