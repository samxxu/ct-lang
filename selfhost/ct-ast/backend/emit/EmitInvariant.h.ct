/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160
#define MAX_HOISTS 4
#define CAP_LIMIT 65536
#define N_MATSEQ 73
#define N_INTO 63
#define N_INTO_SELF 64
#define MAX_INTOS 4
#define MAX_PARAMS 16
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_MCALL   30
#define N_RAW     31
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_OPT     72
#define N_NEWOBJ  77
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41
#define N_SWITCH  42
#define N_ADTCTOR 81
#define N_ARM     79
#define N_BIND    80
#define N_MATCH   78
#define N_CASE    43
#define N_DOWHILE 44
#define N_ENUM    45
#define N_ENUMVAL 46
#define N_OFFSETOF 47
#define N_UNION   48
#define N_LABEL   49
#define N_GOTO    50
#define N_COMPOUND 51
#define N_EMPTY   52
#define N_VAARG   53
#define N_FNUM    54
#define N_SASSERT 55
#define N_FIELDS  56
#define N_PRE     57
#define N_RAW_TEXT 58
#define N_CLOSURE 59
#define N_LOOP    60
#define N_FOREACH 62
#define N_INIT_RANGE 61
#define N_INIT_BRACE 65
#define N_INIT_MBRACE 67
#define N_DEFER_RUN 70
#define N_DEFER 69
#define N_TRY 71
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
