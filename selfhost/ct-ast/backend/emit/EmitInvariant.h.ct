namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitInvariant {
    int unused;
}


impl EmitInvariant for Emitter {
    int invariant_edge(int head, int err_exit, int at)
    {
        int c, ck, guard, seen_release;
        (void)self;

        guard = 0;
        seen_release = 0;
        for (c = head; c >= 0; c = self->arena->nodes[c].next) {
            guard = guard + 1;
            if (c >= self->arena->nnode)
                return self->fail_from(at, "lowering invariant I1: a cleanup edge points outside the node pool");
            if (guard > 70000)
                return self->fail_from(at, "lowering invariant I1: a cleanup edge is cyclic");
            ck = self->arena->nodes[c].kind;
            if (ck == N_DELETE) {
                seen_release = 1;
                continue;
            }
            if (ck != N_DEFER_RUN)
                return self->fail_from(at, "lowering invariant I1: control transfer inside a cleanup edge");
            if (seen_release)
                return self->fail_from(at, "lowering invariant I2: a deferred body runs after a release on the same edge");
            if (!err_exit && self->arena->nodes[c].aux == 1)
                return self->fail_from(at, "lowering invariant I3: an errdefer body runs on a normal exit");
            if (self->arena->nodes[c].a < 0
                || self->arena->nodes[self->arena->nodes[c].a].kind != N_BLOCK)
                return self->fail_from(at, "lowering invariant I1: a deferred run has no block body");
            {
                int bg;
                for (bg = self->arena->nodes[self->arena->nodes[c].a].a; bg >= 0;
                     bg = self->arena->nodes[bg].next) {
                    int bk = self->arena->nodes[bg].kind;
                    if (bk == N_RET || bk == N_BREAK || bk == N_CONT || bk == N_GOTO)
                        return self->fail_from(at, "lowering invariant I1: control transfer inside a deferred body");
                }
            }
        }
        return 0;
    }

    int invariant_scan(int n, int depth)
    {
        int k, h, err_exit;
        (void)self;

        /* `n` walks a sibling chain iteratively: a 3000-call fixture makes a
           3000-statement block, and recursion on `next` would exhaust the
           stack on a legal program. `depth` counts nesting, not siblings. */
        while (n >= 0) {
            if (depth > 2048) {
                /* S1a-0 C2n-3: a message is not a fixed row. */
                const char *dmsg;
                dmsg = tool::sh::ct_scratch_fmt(
                         "lowering invariant I1: AST walk is deeper than 2048 at node %d", n);
                return self->fail(dmsg);
            }
            if (n >= self->arena->nnode)
                return self->fail("lowering invariant I1: a child index is outside the node pool");
            k = self->arena->nodes[n].kind;
            if (k == N_RET || k == N_BREAK || k == N_CONT) {
                err_exit = strcmp(self->arena->nodes[n].text2, "err") == 0;
                if (self->invariant_edge(self->arena->nodes[n].b, err_exit, n) != 0) return -1;
                if (k == N_RET) {
                    if (self->arena->nodes[n].aux == 1 && !self->arena->nodes[n].text[0])
                        return self->fail_from(n,
                            "lowering invariant I4: a return marked for materialisation has no type");
                    if (self->invariant_scan(self->arena->nodes[n].a, depth + 1) != 0) return -1;
                }
                n = self->arena->nodes[n].next;
                continue;
            }
            if (k == N_GOTO) {
                if (self->arena->nodes[n].b >= 0)
                    return self->fail_from(n, "lowering invariant I1: a goto carries a cleanup edge");
                n = self->arena->nodes[n].next;
                continue;
            }
            if (k == N_TRY) {
                h = self->try_cleanup(n);
                if (self->invariant_edge(h, 1, n) != 0) return -1;
            }
            /* Declaration containers are not an executable tree: their child
               slots carry field / declarator lists whose `next` links are not
               statement siblings. They hold no jump and no `?`, so the walk
               stops at the two that own a body. */
            if (k == N_STRUCT || k == N_FIELD || k == N_FIELDS || k == N_TYPEDEF
                || k == N_GLOBAL || k == N_PP || k == N_ENUM || k == N_ENUMVAL
                || k == N_UNION) {
                n = self->arena->nodes[n].next;
                continue;
            }
            if (k == N_IMPL) {
                if (self->invariant_scan(self->arena->nodes[n].a, depth + 1) != 0) return -1;
                n = self->arena->nodes[n].next;
                continue;
            }
            if (k == N_FUNC) {
                if (self->invariant_scan(self->arena->nodes[n].b, depth + 1) != 0) return -1;
                n = self->arena->nodes[n].next;
                continue;
            }
            if (k == N_DEFER_RUN && self->arena->nodes[n].aux == 1)
                return self->fail_from(n, "lowering invariant I3: an errdefer body reaches a normal block tail");
            if (self->invariant_scan(self->arena->nodes[n].a, depth + 1) != 0) return -1;
            if (self->invariant_scan(self->arena->nodes[n].b, depth + 1) != 0) return -1;
            if (self->invariant_scan(self->arena->nodes[n].c, depth + 1) != 0) return -1;
            if (self->invariant_scan(self->arena->nodes[n].d, depth + 1) != 0) return -1;
            /* Only a statement list uses `next` as a sibling link. Expression
               nodes reuse the slot for internal lists (an argument / call
               table), so following it there can revisit a node. */
            if (k == N_EXPR || k == N_ASSIGN || k == N_DECL || k == N_DECLS
                || k == N_DELETE || k == N_EMPTY || k == N_SASSERT
                || k == N_LABEL || k == N_IF || k == N_WHILE || k == N_FOR
                || k == N_LOOP || k == N_FOREACH || k == N_MATCH || k == N_SWITCH
                || k == N_CASE || k == N_DOWHILE || k == N_DEFER_RUN || k == N_RAW
                || k == N_BLOCK || k == N_POST
                || (k == N_BIN && self->arena->nodes[n].aux == B_COMMA)) {
                n = self->arena->nodes[n].next;
                continue;
            }
            return 0;
        }
        return 0;
    }

    int invariant_check(int prog)
    {
        const char *fault;
        int i, j, tail, r, del, run, er, nj;
        (void)self;
        r = -1;

        fault = getenv("CT_EMIT_INVARIANT_FAULT");
        if (fault && fault[0]) {
            j = -1;
            del = -1;
            run = -1;
            er = -1;
            nj = -1;
            if (strcmp(fault, "cleanup-jump") == 0
                || strcmp(fault, "cleanup-cycle") == 0
                || strcmp(fault, "cleanup-drop-first") == 0) {
                for (i = 0; i < self->arena->nnode; i++) {
                    int k = self->arena->nodes[i].kind;
                    if (j < 0 && (k == N_RET || k == N_BREAK || k == N_CONT)
                        && self->arena->nodes[i].b >= 0)
                        j = i;
                    if (del < 0 && k == N_DELETE) del = i;
                    if (run < 0 && k == N_DEFER_RUN) run = i;
                }
                if (j >= 0) {
                    tail = self->arena->nodes[j].b;
                    while (self->arena->nodes[tail].next >= 0)
                        tail = self->arena->nodes[tail].next;
                    if (strcmp(fault, "cleanup-cycle") == 0) {
                        self->arena->nodes[self->arena->nodes[j].b].next = self->arena->nodes[j].b;
                    } else if (strcmp(fault, "cleanup-jump") == 0) {
                        for (i = 0; i < self->arena->nnode; i++)
                            if (i != j && self->arena->nodes[i].kind == N_RET) {
                                r = i;
                                break;
                            }
                        if (r >= 0) self->arena->nodes[tail].next = r;
                    } else if (del >= 0 && run >= 0) {
                        self->arena->nodes[j].b = del;
                        self->arena->nodes[del].next = run;
                        self->arena->nodes[run].next = -1;
                    }
                }
            } else if (strcmp(fault, "errdefer-normal") == 0) {
                for (i = 0; i < self->arena->nnode; i++) {
                    int k = self->arena->nodes[i].kind;
                    if (er < 0 && k == N_DEFER_RUN && self->arena->nodes[i].aux == 1)
                        er = i;
                    if (k == N_RET
                        && strcmp(self->arena->nodes[i].text2, "err") != 0)
                        nj = i;
                }
                if (er >= 0 && nj >= 0) {
                    if (self->arena->nodes[nj].b < 0) {
                        self->arena->nodes[nj].b = er;
                    } else {
                        tail = self->arena->nodes[nj].b;
                        while (self->arena->nodes[tail].next >= 0)
                            tail = self->arena->nodes[tail].next;
                        self->arena->nodes[tail].next = er;
                    }
                    self->arena->nodes[er].next = -1;
                }
            }
        }
        /* Start at the two top-level nodes that own a body. Walking the whole
           declaration list generically is unsafe: a struct's field chain and
           the template tables reuse `next` for non-sibling links. */
        for (i = self->arena->nodes[prog].a; i >= 0; i = self->arena->nodes[i].next) {
            if (self->arena->nodes[i].kind == N_FUNC) {
                if (self->invariant_scan(self->arena->nodes[i].b, 0) != 0) return -1;
            } else if (self->arena->nodes[i].kind == N_IMPL) {
                for (j = self->arena->nodes[i].a; j >= 0; j = self->arena->nodes[j].next)
                    if (self->arena->nodes[j].kind == N_FUNC
                        && self->invariant_scan(self->arena->nodes[j].b, 0) != 0)
                        return -1;
            }
        }
        return 0;
    }

    int invariant_temp_check(void)
    {
        const char *fault;
        int i, j, c;
        (void)self;

        fault = getenv("CT_EMIT_INVARIANT_FAULT");
        if (fault && strcmp(fault, "temp-missing") == 0 && self->nhoist > 0) {
            self->arena->nodes[self->hoist_calls[0]].text3 = runtime::text::ct_intern("");
            if (!self->arena->nodes[self->hoist_calls[0]].text3) return self->fail("out of memory");
        }
        if (fault && strcmp(fault, "temp-dup") == 0 && self->nhoist > 1) {
            self->arena->nodes[self->hoist_calls[1]].text3 = runtime::text::ct_intern(self->arena->nodes[self->hoist_calls[0]].text3);
            if (!self->arena->nodes[self->hoist_calls[1]].text3) return self->fail("out of memory");
        }
        for (i = 0; i < self->nhoist; i++) {
            c = self->hoist_calls[i];
            if (!self->arena->nodes[c].text3[0])
                return self->fail_from(c,
                    "lowering invariant I4: a hoisted receiver has no temporary name");
            for (j = 0; j < i; j++)
                if (strcmp(self->arena->nodes[c].text3,
                           self->arena->nodes[self->hoist_calls[j]].text3) == 0)
                    return self->fail_from(c,
                        "lowering invariant I4: two hoisted receivers share a temporary name");
        }
        for (i = 0; i < self->ninto; i++) {
            c = self->into_nodes[i];
            if (!self->arena->nodes[c].text3[0])
                return self->fail_from(c,
                    "lowering invariant I4: an 'into' receiver has no temporary name");
        }
        for (i = 0; i < self->nopt; i++) {
            c = self->opt_nodes[i];
            if (!self->arena->nodes[c].text3[0] || !self->arena->nodes[c].text4[0])
                return self->fail_from(c,
                    "lowering invariant I4: an optional-chain receiver has no temporary declaration");
        }
        for (i = 0; i < self->nhoist; i++)
            for (j = 0; j < self->ninto; j++)
                if (strcmp(self->arena->nodes[self->hoist_calls[i]].text3,
                           self->arena->nodes[self->into_nodes[j]].text3) == 0)
                    return self->fail_from(self->hoist_calls[i],
                        "lowering invariant I4: two receivers share a temporary name");
        return 0;
    }
}
