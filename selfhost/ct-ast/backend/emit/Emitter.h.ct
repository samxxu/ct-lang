    int emit_unit(int u)
    {
        if (self->no_write) return 0;
        char *path;
        FILE *f;
        int rc;
        (void)self;

        self->errmsg = "";
        self->failline = 0;
        self->gprefix = self->units[u].nsprefix;
        path = tool::sh::ct_scratch_fmt("%s/%s.c", *self->outdir, self->units[u].base);
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the output file");
        self->out = f;
        self->path = self->units[u].path;
        self->cur_unit = u;
        rc = emit_unit_body(self, u);
        if (fclose(f) != 0 && rc == 0) rc = self->fail("cannot write the output file");
        return rc;
    }

    /* Build mode: the unit's exported surface (D34 fixes the naming rules, not
       the wording of the header). */
    int write_unit_header(int u)
    {
        if (self->no_write) return 0;
        char *path;
        char *guard;
        FILE *f;
        int rc;
        (void)self;

        self->gprefix = self->units[u].nsprefix;
        /* SH-120: the `String` unit's header would be `String.h`, which a
           case-insensitive filesystem resolves for every `#include
           <string.h>` once the output directory is on the include path. The
           C unit stays `String.c` (the acceptance name); only its header is
           `String_.h`, so libc's `string.h` is always the real one. */
        {
            const char *hb = strcmp(self->units[u].base, "String") == 0
                             ? "String_" : self->units[u].base;
            path = tool::sh::ct_scratch_fmt("%s/%s.h", *self->outdir, hb);
            if (self->header_guard(hb, &guard) != 0) return -1;
        }
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        self->out = f;
        self->path = self->units[u].path;
        rc = write_unit_header_body(self, u, guard);
        if (fclose(f) != 0 && rc == 0) rc = self->fail("cannot write the header");
        return rc;
    }

    /* JSON string body (no surrounding quotes). */

    /* `--emit-map`: the published JSON shape (compiler / file / traits /
       structs / functions / impls / calls). `u < 0` means compile mode, where
       the tables cover the single unit. */
    /* PH-59 M1: the language-neutral declaration model. Deliberately narrower
       than the map: struct/union fields, enum members and function signatures.
       `visibility` stays `unknown` until LANG-9 lands; `loc` carries file+line
       (LANG-10 7c's column is the documented degradation). */


    /* Compile mode: a placeholder header (types only; the .c is self-contained). */
    /* Phase 39 R3: the ABI header is a separate artefact. It contains only
       the root unit's C-compatible pub functions, the ABI version/hash and the
       opaque forwards they need; the module `.h` contract is untouched. */



    /* SH-111 I1/I2/I3: walk one cleanup edge. The edge is a statement chain in
       the jump node's `b` slot (or the `?` side table). Only releases and
       materialised deferred bodies may appear; all deferred bodies precede all
       releases; a normal exit carries no `errdefer`. `at` is the node blamed. */
    /* SH-111: one pre-emission walk over the statement/expression tree. Every
       invariant is a condition the emitter already relies on; the walk only
       turns a silent bad product into a positioned diagnostic. */
    /* SH-111: the test seam for the invariants themselves. A program the
       parser accepts cannot break them, so the gate injects one concrete AST
       fault here (only when the environment variable is set) and lets the
       independent walk report it. Production runs leave the variable unset. */
    /* SH-111 I4: every hoisted receiver (method-chain level, `into` receiver,
       optional receiver) has one distinct temporary name by the time the
       declarations are written. Runs inside `emit_hoists`, after the scan has
       named the nodes and before any output. */
    /* A failure is recorded without a position; the driver's facade wraps the
       first message with the current line and token. */
    int fail(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            /* S1a-0 C2n-3: the message can name a 159-byte trait plus a
               159-byte struct plus the method, so a 160-byte row cut it. The
               pool holds one message per run (the emitter stops at the first
               failure), so this does not grow with output. */
            self->errmsg = runtime::text::ct_intern(msg);
            if (!self->errmsg) self->errmsg = "out of memory";
        }
        return -1;
    }

    /* The failure is about a source node, so its line is the position to report.
       The lexer is useless here: parsing finished long before emission. */
    int fail_from(int n, const char *msg)
    {
        (void)self;
        if (n >= 0 && !self->errmsg[0]) self->failline = self->arena->nodes[n].line;
        return self->fail(msg);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Emitter g_emit;

/* Only primitives cross the unit boundary. Every pointer to another unit's
   type goes in as `void *` and is cast here, because a generated header carries
   no #include and a prototype that named `struct Symbols *` would
   scope a fresh, incompatible type. The bind calls are split so no signature
   exceeds MAX_PARAMS. */
pub void ct_emit_bind(void *arena, void *sym, void *ty, void *lex, const char *version, char **outdir, const char *prog);
void ct_emit_bind(void *arena, void *sym, void *ty, void *lex,
                  const char *version, char **outdir, const char *prog)
{
    g_emit.arena = (struct Arena *)arena;
    g_emit.sym = (struct Symbols *)sym;
    g_emit.ty = (struct TypeCheck *)ty;
    g_emit.lex = (struct Lexer *)lex;
    g_emit.version = version;
    g_emit.outdir = outdir;
    g_emit.prog = prog;
    /* the vptr writer follows the emitter's output stream, which changes per
       unit, so it holds the address of the field rather than a copy */
    ct_init_bind(sym, (void **)&g_emit.out);
    g_emit.init = init_get();
    /* S1a-0 C2n-3: an unset pool text reads as the empty string, so the
       `text[0]` / `strcmp(text, "void")` readers keep their meaning. */
    g_emit.errmsg = "";
    g_emit.cur_ret = "";
    g_emit.gtname = "";
    g_emit.ginst = "";
    g_sb.method = "";
    g_sb.recv = "";
}

pub void ct_emit_bind_tables(void *units, int *nunits, void *maps, int *nmaps, void *calls, int *ncalls, int *build_mode, int *line_mode, int *runtime_checks, int *abi_mode, int *abi_root, int *abi_exports, int *abi_n);
void ct_emit_bind_tables(void *units, int *nunits, void *maps, int *nmaps,
                         void *calls, int *ncalls, int *build_mode, int *line_mode,
                         int *runtime_checks, int *abi_mode, int *abi_root,
                         int *abi_exports, int *abi_n)
{
    g_emit.units = (struct Unit *)units;
    g_emit.nunits = nunits;
    g_emit.maps = (struct MapTable **)maps;
    g_emit.nmaps = nmaps;
    g_emit.calls = (struct Call **)calls;
    g_emit.ncalls = ncalls;
    g_emit.build_mode = build_mode;
    g_emit.line_mode = line_mode;
    g_emit.runtime_checks = runtime_checks;
    g_emit.io_mask = 0;
    g_emit.abi_mode = abi_mode;
    g_emit.abi_root = abi_root;
    g_emit.abi_exports = abi_exports;
    g_emit.abi_n = abi_n;
}

/* S1a-0 C1: the module layer's unit table grows; a realloc moves it, so the
   emitter (which holds it as a pointer) is re-pointed after every move. */
pub void ct_emit_bind_units(void *units);
void ct_emit_bind_units(void *units)
{
    g_emit.units = (struct Unit *)units;
}

/* PH-64: the bare-metal flags live in their own bind, so the long table
   signature above does not grow for two scalars. */
pub void ct_emit_bind_flags(int *freestanding, char *alloc_map, int *slice_used);
void ct_emit_bind_flags(int *freestanding, char *alloc_map, int *slice_used)
{
    g_emit.freestanding = freestanding;
    g_emit.alloc_map = alloc_map;
    g_slice_used = slice_used;
}

pub void ct_emit_bind_plan(struct LModulePlan *plan);
pub void ct_emit_bind_io_mask(int mask);
void ct_emit_bind_plan(struct LModulePlan *plan)
{
    g_plan = plan;
}


/* `--alloc A[,B[,C[,D]]]` is parsed at emission time, not at bind time: the
   bind runs before the driver has read the command line. Defaults keep libc, so
   a build without --alloc is byte-identical to before. */
static void sync_alloc(struct Emitter *e)
{
    const char *p;
    int which;

    snprintf(e->alloc_m, sizeof e->alloc_m, "malloc");
    snprintf(e->alloc_f, sizeof e->alloc_f, "free");
    snprintf(e->alloc_r, sizeof e->alloc_r, "realloc");
    snprintf(e->alloc_c, sizeof e->alloc_c, "calloc");
    if (!e->alloc_map || !e->alloc_map[0]) return;
    p = e->alloc_map;
    which = 0;
    while (which < 4) {
        const char *comma = strchr(p, ',');
        size_t n = comma ? (size_t)(comma - p) : strlen(p);
        char *dst = which == 0 ? e->alloc_m
                  : which == 1 ? e->alloc_f
                  : which == 2 ? e->alloc_r : e->alloc_c;
        size_t cap = which == 0 ? sizeof e->alloc_m
                   : which == 1 ? sizeof e->alloc_f
                   : which == 2 ? sizeof e->alloc_r : sizeof e->alloc_c;
        if (n > 0 && n < cap) {
            memcpy(dst, p, n);
            dst[n] = 0;
        }
        if (!comma) break;
        p = comma + 1;
        which++;
    }
}

pub void ct_emit_bind_parse(int *nparams, void *pend_fields, int *npend);
void ct_emit_bind_parse(int *nparams, void *pend_fields, int *npend)
{
    g_emit.nparams = nparams;
    g_emit.pend_fields = (struct Field *)pend_fields;
    g_emit.npend = npend;
}

pub int ct_emit_ntmp(void);
int ct_emit_ntmp(void)
{
    return g_emit.ntmp;
}

pub void ct_emit_set_out(void *out);
void ct_emit_set_out(void *out)
{
    g_emit.out = (FILE *)out;
}

/* S1b-S2b: the body seam. When set, a function whose body the LIR lowerer
   covered end to end is printed from LIR; the signature, attributes and every
   declaration stay with this writer, so the switch cannot change their text.
   `fn` returns 1 when it printed the body, 0 to let this writer print it, -1
   on an I/O error. `void *` keeps the pointer type out of the unit boundary. */
pub void ct_emit_set_body_hook(int (*fn)(const char *, void *, int, int, int *, int));
void ct_emit_set_body_hook(int (*fn)(const char *, void *, int, int, int *, int))
{
    g_body_hook = fn;
}

pub int ct_emit_body_hook(const char *name, void *out, int ind, int ntmp,
                          int *new_ntmp, int stmts);
int ct_emit_body_hook(const char *name, void *out, int ind, int ntmp,
                      int *new_ntmp, int stmts)
{
    {
        int (*body_hook)(const char *, void *, int, int, int *, int) = g_body_hook;
        if (!body_hook) return 0;
        return body_hook(name, out, ind, ntmp, new_ntmp, stmts);
    }
}

/* Phase 29 E29-5 / P34 S9a: the built-in layer units. The module layer clears
   the set when a run starts and adds one index per layer file it loaded. */
pub void ct_emit_clear_builtins(void);
void ct_emit_clear_builtins(void)
{
    g_emit.nbuiltin = 0;
}

pub void ct_emit_add_builtin(int u);
void ct_emit_add_builtin(int u)
{
    /* SH-116: the array holds every layer unit; the cap once said four, so Box
       was loaded and then dropped here, and a user unit never included
       `Box.h` (its instances stayed local, with only a forward declaration of
       `struct ct_Box_hdr`). SH-120 raises the array/cap to eight. */
    if (g_emit.nbuiltin < 8) {
        g_emit.builtins[g_emit.nbuiltin] = u;
        g_emit.nbuiltin += 1;
    }
}

pub void ct_emit_set_path(const char *path);
void ct_emit_set_path(const char *path)
{
    g_emit.path = path;
}

pub int ct_emit_program(int prog);
int ct_emit_program(int prog)
{
    sync_alloc(&g_emit);
    return g_emit.emit_program(prog);
}

pub int ct_emit_unit(int u);
int ct_emit_unit(int u)
{
    sync_alloc(&g_emit);
    return g_emit.emit_unit(u);
}

pub int ct_emit_unit_header(int u);
int ct_emit_unit_header(int u)
{
    return g_emit.write_unit_header(u);
}

pub int ct_emit_header(const char *outc);
int ct_emit_header(const char *outc)
{
    return g_emit.write_header(outc);
}

pub int ct_emit_map(const char *dest, int prog, int u);
int ct_emit_map(const char *dest, int prog, int u)
{
    return g_emit.write_map(dest, prog, u);
}

pub int ct_emit_model(const char *dest, int prog);
int ct_emit_model(const char *dest, int prog)
{
    return g_emit.write_model(dest, prog);
}

pub const char *ct_emit_last_error(void);
const char *ct_emit_last_error(void)
{
    return g_emit.errmsg;
}

/* The source line the failure blames; 0 means it is not about the source. */
pub int ct_emit_error_line(void);
int ct_emit_error_line(void)
{
    return g_emit.failline;
}

void ct_emit_bind_io_mask(int mask)
{
    g_emit.io_mask = mask;
}

pub void ct_emit_set_no_write(int on);
void ct_emit_set_no_write(int on)
{
    g_emit.no_write = on;
}

pub int ct_emit_no_write(void);
