/*
 * Emitter.h.ct - the C emitter, one class of its own.
 *
 * It turns the AST into C: it reads the node pool, the symbol tables, the type
 * queries and the module tables, and writes the `.c`/`.h` files and the map
 * JSON. Macros do not cross a unit boundary, so the node kinds, the operator
 * tags and the caps are declared here; MAX_TEXT 160 and MAX_PARAMS 16 are the
 * values `frontend/sym/Symbols.h.ct` lists.
 *
 * The instance is private to this unit: a generated header carries no
 * #include, so neither the FILE * nor the trait may appear in its surface.
 * The driver reaches it through the `pub` primitives at the end of the file.
 */
#include <stdio.h>
#include <string.h>

import backend::emit::Init;
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable::MapBind as MapBind;
import frontend::module::MapTable;
import frontend::module::Unit;
import frontend::parse::Expr;
import frontend::sym::Symbols::Field as Field;
import frontend::sym::Symbols::MethodSig as MethodSig;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::sym::Symbols;
import frontend::type::TypeCheck;
import runtime::arena::Arena;

#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_HOISTS 4
/* Phase 30: the receiver block and its `$` / `.name` reference. */
#define N_INTO 63
#define N_INTO_SELF 64
#define MAX_INTOS 4
#define MAX_PARAMS 16
#define MAX_UNITS  64

/* the node kinds this unit dispatches on (D32: one tag, one dispatch) */
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_MCALL   30
#define N_RAW     31
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41
#define N_SWITCH  42
#define N_CASE    43
#define N_DOWHILE 44
#define N_ENUM    45
#define N_ENUMVAL 46
#define N_OFFSETOF 47
#define N_UNION   48
#define N_LABEL   49
#define N_GOTO    50
#define N_COMPOUND 51
#define N_EMPTY   52
#define N_VAARG   53
#define N_FNUM    54
#define N_SASSERT 55
#define N_FIELDS  56
#define N_PRE     57
#define N_RAW_TEXT 58
/* the parser's closure literal (Phase 21 S2); the emitter never prints a node
   of this kind by itself -- S3 expands it at the declaration and at the call */
#define N_CLOSURE 59
/* `loop(<count>) { … }` (Phase 22) and `loop(<start>..<stop>) { … }` (Phase 23):
   parsed as their own node, printed as a native `for` whose head declares the
   implicit counter and the private bound temporary (one for the counted form,
   two for the range form). */
#define N_LOOP    60
#define N_FOREACH 62
#define N_INIT_RANGE 61
/* Phase 31 S11a: a `Vec<T>` brace initializer. `text` is the element's C type,
   `text2` the encoded instance name, `aux` the element count and `a` the first
   element expression (the rest hang off `next`). */
#define N_INIT_BRACE 65
/* Phase 31 S14a: a `Map` brace initializer. `text` is the nested `MapEntry`
   struct spelling, `text2` the encoded `Map` name, `aux` the item count, `a` the
   first `N_INIT_ITEM` (`a` = key expression, `b` = value expression, items
   chain through `next`). */
#define N_INIT_MBRACE 67

/* binary operators (stored in `aux`) */
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13
#define B_XOR 14
#define B_BAND 15
#define B_BOR  16
#define B_SHL  17
#define B_SHR  18
#define B_COMMA 19

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define P_INC 1

namespace backend::emit;
/* The whole emitter API. The vptr / initialiser writer lives on a sub-object
   (`Init.h.ct`), which keeps this trait clear of the method ceiling; `last_error`
   is not a method -- the driver reads the message through
   `ct_emit_last_error`. */
trait EmitOps {
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  emit_struct_fwd(void);
    int  emit_trait_range(int start, int end, int mode);
    int  emit_proto(int i);
    int  emit_vtable_fwd(int prog);
    int  header_guard(const char *base, char *out, int cap);
    int  write_map(const char *dest, int prog, int u);
    int  emit_json_str(FILE *f, const char *s);
    int  emit_node(int n, int ind);
    int  emit_field(int n, int ind);
    int  emit_inline(int n);
    int  emit_type_name(const char *type, const char *name);
    int  emit_type_name_dims(const char *type, const char *name, const char *dims);
    int  emit_expr(int n);
    int  hoist_rvalue(int n);
    int  hoist_scan(int n, int top);
    int  emit_hoists(int ind);
    int  emit_cond(int n);
    int  emit_indent(int n);
    int  emit_type_decl(int n, int ind, int with_semi);
    int  emit_global_decl(int n);
    int  emit_global_extern(int n);
    int  decl_is_pub(int kind, const char *name);
    int  vtable_exported(int si, const char *tname);
    int  map_vtable_exported(int i);
    int  emit_link_externs(int prog, int u);
    int  emit_inherent_protos(int prog);
    int  node_mentions(int n, const char *name);
    int  emit_trait_decls(void);
    int  emit_impls(int prog);
    int  emit_maps(int u);
    int  emit_unit_init(int prog);
    int  emit_raw_init(int raw, const char *type, int assign);
    int  emit_range_init(int n);
    int  emit_brace_init(int n);
    int  emit_map_brace_init(int n);
    int  write_header(const char *outc);
    int  fail(const char *msg);
    int  fail_from(int n, const char *msg);
}

/* The driver points the collaborators, the module tables, the options and the
   output sink at one run's state. The emission scratch (hoisted temporaries)
   lives here too; the parser's signature/field scratch is only *pointed at*
   (it belongs to the driver), and so is the version string. */
struct Emitter {
    struct Arena *arena;
    struct Symbols *sym;
    struct TypeCheck *ty;
    struct Lexer *lex;
    FILE *out;
    const char *path;
    const char *version;
    struct Unit *units;  int *nunits;
    /* Phase 29 E29-5: the built-in container unit is loaded in `ct build` but is
       not an import edge of any unit (it must not key the cache), so the
       emitter includes its header explicitly. -1 when the layer is absent. */
    int  builtins[4];   /* P34 S9a: Vec / Option / Result layer units */
    int  nbuiltin;
    struct MapTable  *maps;   int *nmaps;
    struct Call *calls;  int *ncalls;
    int  *build_mode;
    int  *line_mode;
    char *outdir;
    const char *prog;
    /* parse-time scratch owned by the driver */
    int  *nparams;
    struct Field *pend_fields;
    int  *npend;
    /* emission scratch */
    int  hoist_calls[4];
    int  nhoist;
    /* Phase 30: receivers whose block is spliced at the statement head */
    int  into_nodes[4];
    int  ninto;
    int  ntmp;
    int  raw_call;
    int  failline;              /* the source line of the node that failed, 0 = none */
    char errmsg[160];
    /* The mangled prefix of the unit being written (`a_b_`, empty at the root).
       A namespaced global is emitted as `<prefix><name>`; `emit_program` sets
       this from `sym->ns`, the build writers from `units[u].nsprefix`. */
    const char *gprefix;
    /* the vptr / initialiser writer (Init.h.ct) */
    struct Init *init;
    /* the unit being written: `-1` in compile mode, which has no map closure */
    int  cur_unit;
    /* Phase 21 S3: the closure whose body is being written (`ci + 1`, 0 = none)
       so a captured name prints `__ct_cl_e->name`, and the closure variables in
       scope at the current statement (name -> id) for call-site expansion. */
    int  closure_ci;
    char clvar[64][160];
    int  clid[64];
    int  nclvar;
    /* Phase 24: `> 0` while an `N_INIT_RANGE` initialiser is being written, and
       the index of the element being written. `$` prints `((int)<range_k>)`, so
       the placeholder never reaches C and the element subtree is emitted once
       per element without being copied. */
    int  range_depth;
    int  range_k;
    /* Phase 26: the template being written as a monomorphised instance. All
       three are empty when no instance is active; the type-printing paths
       substitute `gtparam` with `gtarg`, and `N_FUNC` prints `gtname` in place
       of the template's own C name. No AST field is touched (D26-7). */
    char gtparam[160];
    char gtarg[160];
    char gtname[160];
    /* Phase 29: the second parameter of a generic struct template. A method of
       `impl<T, U> Pair<T, U>` is monomorphised once per instance, and both
       parameters are substituted in the same body. */
    char gtparam2[160];
    char gtarg2[160];
    /* Phase 31: the instance whose inherent method is being written. The
       reserved element-lifecycle calls (`__ct_elem_retain` /
       `__ct_elem_release`) in a container's body bind to this instance's
       per-instance helper, so no AST copy is needed. Empty outside an instance
       method. */
    char ginst[160];
} use EmitOps;

/* Does the impl node `node` write `name`? */
static int impl_writes(struct Arena *arena, int node, const char *name)
{
    int m;
    for (m = arena->nodes[node].a; m >= 0; m = arena->nodes[m].next)
        if (strcmp(arena->nodes[m].text2, name) == 0) return 1;
    return 0;
}

/* Is there an impl of `tname` for struct `si` in any unit of this run? A struct
   may be defined in one unit and implemented in another (`test/modules/split`),
   so a per-unit view would wrongly synthesise defaults twice. The arena holds
   every unit's nodes. */
static int impl_exists_anywhere(struct Arena *arena, int si, const char *tname)
{
    int n;
    for (n = 0; n < arena->nnode; n++)
        if (arena->nodes[n].kind == N_IMPL && arena->nodes[n].aux == si
            && strcmp(arena->nodes[n].text2, tname) == 0) return 1;
    return 0;
}

/* Phase 26: the type spelling with the active template's parameter replaced.
   Returns 0 when `buf` holds the substituted spelling, -1 when no instance is
   active or the result does not fit (the caller keeps the original). */
static int emit_gsub_type(struct Emitter *self, const char *type, char *buf, int cap)
{
    char mid[160];
    char fin[160];
    char res[160];
    if (!self->gtarg[0] || !self->gtparam[0]) return -1;
    if (frontend::sym::ct_generic_subst(type, self->gtparam, self->gtarg, mid, sizeof mid) != 0)
        return -1;
    if (self->gtarg2[0] && self->gtparam2[0]) {
        if (frontend::sym::ct_generic_subst(mid, self->gtparam2, self->gtarg2, fin, sizeof fin) != 0)
            return -1;
    } else {
        snprintf(fin, sizeof fin, "%s", mid);
    }
    /* A substituted spelling may still name an instance (`Vec<T>` -> `Vec<int>`).
       The variable that made it concrete already registered the row, so print
       its monomorphised C spelling instead of a template-shaped type. */
    if (strchr(fin, '<') && frontend::sym::ct_inst_resolve(fin, res, sizeof res) == 0) {
        snprintf(buf, (size_t)cap, "%s", res);
        return 0;
    }
    snprintf(buf, (size_t)cap, "%s", fin);
    return 0;
}

/* A (struct, trait) pair that needs no `impl` at all: every method has a
   default body (D-3: the `use` clause is the adoption). */
static int adoption_default_only(struct Emitter *e, int si, const char *tname)
{
    int ti, mi;
    ti = e->sym->find_trait(tname);
    if (ti < 0) return 0;
    if (impl_exists_anywhere(e->arena, si, tname)) return 0;
    if (e->sym->traits[ti].nm == 0) return 0;
    for (mi = 0; mi < e->sym->traits[ti].nm; mi++)
        if (e->sym->traits[ti].m[mi].body < 0) return 0;
    return 1;
}

/* The first `self->field` a default body names that `struct si` does not
   define. The body is written once against an unknown struct, so this is the
   per-struct check D-7 turns into an expansion diagnostic. */
static int default_missing_field(struct Arena *arena, int n, struct Symbols *sym,
                                 int si, char *out)
{
    for (; n >= 0; n = arena->nodes[n].next) {
        if (arena->nodes[n].kind == N_ARROW && arena->nodes[n].a >= 0) {
            int r = arena->nodes[n].a;
            if (arena->nodes[r].kind == N_VAR && strcmp(arena->nodes[r].text2, "self") == 0) {
                int fi, found = 0;
                for (fi = 0; fi < sym->structs[si].nfields; fi++)
                    if (strcmp(sym->structs[si].fields[fi].name, arena->nodes[n].text2) == 0) found = 1;
                if (!found) {
                    snprintf(out, MAX_TEXT, "%s", arena->nodes[n].text2);
                    return 1;
                }
            }
        }
        if (default_missing_field(arena, arena->nodes[n].a, sym, si, out)) return 1;
        if (default_missing_field(arena, arena->nodes[n].b, sym, si, out)) return 1;
        if (default_missing_field(arena, arena->nodes[n].c, sym, si, out)) return 1;
        if (default_missing_field(arena, arena->nodes[n].d, sym, si, out)) return 1;
    }
    return 0;
}

/* Expand trait method `mi` of `ti` for struct `si`: the default body is a
   normal impl body once `self` is bound to `struct <S> *`, so dispatch inside
   it keeps the existing emission rule and the vtable slot stays unchanged. */
static int emit_default_method(struct Emitter *e, int si, const char *stype, int ti, int mi, int at)
{
    struct MethodSig *sig;
    int p, k, ai;
    char uname[32];
    char fld[MAX_TEXT];
    char msg[512];

    sig = &e->sym->traits[ti].m[mi];
    if (default_missing_field(e->arena, sig->body, e->sym, si, fld)) {
        snprintf(msg, sizeof msg,
                 "trait %s::%s (declared at %s:%d) cannot be expanded for struct %s: no field '%s'",
                 e->sym->traits[ti].name, sig->name, e->sym->traits[ti].path,
                 sig->line, e->sym->structs[si].name, fld);
        return e->fail_from(at, msg);
    }
    fprintf(e->out, "static %s ", sig->ret);
    fprintf(e->out, "%s_%s_%s(void *self",
            e->sym->structs[si].name, e->sym->traits[ti].name, sig->name);
    ai = 0;
    for (p = sig->pnode; p >= 0; p = e->arena->nodes[p].next) {
        fputs(", ", e->out);
        if (e->arena->nodes[p].text2[0]) {
            if (e->emit_type_name_dims(e->arena->nodes[p].text, e->arena->nodes[p].text2,
                                       e->arena->nodes[p].text3) != 0) return -1;
        } else {
            snprintf(uname, sizeof uname, "__arg%d", ai);
            if (e->emit_type_name_dims(e->arena->nodes[p].text, uname,
                                       e->arena->nodes[p].text3) != 0) return -1;
        }
        ai++;
    }
    fputs(") {\n", e->out);
    fprintf(e->out, "    %s *_self = (%s *)self;\n", stype, stype);
    e->sym->self_mode = 1;
    ai = 0;
    for (p = sig->pnode; p >= 0; p = e->arena->nodes[p].next) {
        if (e->arena->nodes[p].text2[0]) {
            if (!e->node_mentions(sig->body, e->arena->nodes[p].text2))
                fprintf(e->out, "    (void)%s;\n", e->arena->nodes[p].text2);
        } else {
            snprintf(uname, sizeof uname, "__arg%d", ai);
            fprintf(e->out, "    (void)%s;\n", uname);
        }
        ai++;
    }
    if (!e->node_mentions(sig->body, "self")) fputs("    (void)_self;\n", e->out);
    k = e->arena->nodes[sig->body].a;
    while (k >= 0) {
        if (e->emit_node(k, 1) != 0) {
            e->sym->self_mode = 0;
            return -1;
        }
        k = e->arena->nodes[k].next;
    }
    e->sym->self_mode = 0;
    fputs("}\n\n", e->out);
    return 0;
}

/* Is map `i` declared by a unit in the current unit's transitive import
   closure? Compile mode (`cur_unit < 0`) has one unit, so every map belongs to
   it. A `.m.ct` unit can only be used through `import`. */
static int map_visible(struct Emitter *e, int i)
{
    char reach[MAX_UNITS];
    int u, d, k, changed;
    if (e->cur_unit < 0) return 1;
    if (e->maps[i].unit == e->cur_unit) return 1;
    for (u = 0; u < MAX_UNITS; u++) reach[u] = 0;
    reach[e->cur_unit] = 1;
    changed = 1;
    while (changed) {
        changed = 0;
        for (d = 0; d < (*e->nunits); d++) {
            if (!reach[d]) continue;
            for (k = 0; k < e->units[d].ndep; k++) {
                int dep = e->units[d].depu[k];
                if (dep >= 0 && dep < MAX_UNITS && !reach[dep]) {
                    reach[dep] = 1;
                    changed = 1;
                }
            }
        }
    }
    return e->maps[i].unit >= 0 && e->maps[i].unit < MAX_UNITS && reach[e->maps[i].unit];
}

/* The prologue of the map closure: every `#include` / `#define` line of an
   imported `.m.ct` unit, deduplicated by whole line. Emitted only in build
   mode, where the unit table exists. */
static int emit_map_prologues(struct Emitter *e, int u)
{
    char reach[MAX_UNITS];
    char seen[64][256];
    char line[256];
    int nseen, d, k, n, i, dup, changed;
    for (i = 0; i < MAX_UNITS; i++) reach[i] = 0;
    reach[u] = 1;
    changed = 1;
    while (changed) {
        changed = 0;
        for (d = 0; d < (*e->nunits); d++) {
            if (!reach[d]) continue;
            for (k = 0; k < e->units[d].ndep; k++) {
                int dep = e->units[d].depu[k];
                if (dep >= 0 && dep < MAX_UNITS && !reach[dep]) {
                    reach[dep] = 1;
                    changed = 1;
                }
            }
        }
    }
    nseen = 0;
    for (d = 0; d < (*e->nunits); d++) {
        if (!reach[d] || !e->units[d].is_map || e->units[d].prog < 0) continue;
        /* A sibling `.shim.h` declares what a recipe cannot spell: macro
           wrappers, global accessors, variadic forwarders. It leads the unit's
           prologue, because that unit's `#include`s may feed the shim. */
        if (e->units[d].has_shim) {
            snprintf(line, sizeof line, "#include \"%s.shim.h\"", e->units[d].base);
            dup = 0;
            for (i = 0; i < nseen; i++)
                if (strcmp(seen[i], line) == 0) dup = 1;
            if (!dup) {
                if (nseen < 64) {
                    snprintf(seen[nseen], 256, "%s", line);
                    nseen++;
                }
                fprintf(e->out, "%s\n", line);
            }
        }
        for (n = e->arena->nodes[e->units[d].prog].a; n >= 0; n = e->arena->nodes[n].next) {
            if (e->arena->nodes[n].kind != N_PP) continue;
            dup = 0;
            for (i = 0; i < nseen; i++)
                if (strcmp(seen[i], e->arena->nodes[n].text) == 0) dup = 1;
            if (dup) continue;
            if (nseen < 64) {
                snprintf(seen[nseen], 256, "%s", e->arena->nodes[n].text);
                nseen++;
            }
            fprintf(e->out, "%s\n", e->arena->nodes[n].text);
        }
    }
    if (nseen > 0) fputs("\n", e->out);
    return 0;
}

/* The parameter's declared type, without array dims (a compound literal needs
   the base type). */
static void map_clean_type(const char *in, char *out)
{
    int n = 0;
    while (*in && *in != '[') {
        out[n] = *in;
        n++;
        in++;
    }
    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '\t')) n--;
    out[n] = 0;
}

/* The C spelling of a trait (`a_ALen`) for diagnostics. The source spelling
   (`a::ALen`) cannot be rebuilt from the recorded name: a namespace segment may
   itself contain `_`, so turning every `_` back into `::` invents segments
   (`my_lib` would print as `my::lib`, which no source line can resolve). The C
   name is what the generated file actually uses, and it stays unambiguous. */
static void trait_qual_name(struct Symbols *sym, int ti, char *out, int cap)
{
    snprintf(out, (size_t)cap, "%s", sym->traits[ti].name);
}

/* Phase 25.2: the two halves of a closure actual and the scope table that says
   whether a name is one are written further down, but the recipe expansion
   needs them here. */
static int closure_var_lookup(struct Emitter *self, const char *name);
static int emit_closure_fn(struct Emitter *self, int n);
static int emit_closure_env(struct Emitter *self, int n);

/* How many recipe slots an actual fills: a closure literal, or a variable bound
   to one, is a `(fn, env)` pair and takes two (D25-4); everything else one. */
static int map_actual_slots(struct Emitter *e, int n)
{
    if (n < 0) return 1;
    if (e->arena->nodes[n].kind == N_CLOSURE) return 2;
    if (e->arena->nodes[n].kind == N_VAR
        && closure_var_lookup(e, e->arena->nodes[n].text2) >= 0) return 2;
    return 1;
}

/* The actual for binding parameter `idx`: a type host's parameter 0 is the
   receiver, the rest walk the call's argument chain counting a closure actual
   as the two slots it fills. `*half` reports which slot of that actual `idx`
   asks for: 0 a whole actual, 1 the `fn` half, 2 the `env` half. */
static int map_actual_span(struct Emitter *e, int recv, int args, int type_host, int idx, int *half)
{
    int n = args;
    int slot = 0;
    int span;

    *half = 0;
    if (type_host) {
        if (idx == 0) return recv;
        idx--;
    }
    while (n >= 0) {
        span = map_actual_slots(e, n);
        if (idx < slot + span) {
            if (span == 2) *half = (idx == slot) ? 1 : 2;
            return n;
        }
        slot += span;
        n = e->arena->nodes[n].next;
    }
    return -1;
}

/* Emit one recipe slot: a closure half prints a single symbol of the pair, so
   the recipe can place `fn` and `env` independently (D25-4 / D25-7). A closure
   variable prints the same pair from its own stack instance. */
static int map_emit_actual(struct Emitter *e, int n, int half)
{
    int cv;

    if (half == 0) {
        int k = e->arena->nodes[n].kind;
        if (k == N_INTO || k == N_INTO_SELF) {
            /* A type host's first binding parameter is by value, so the
               receiver prints its value form even when the block spelled it
               with a leading `.` (aux==1, the pointer role). */
            int ow = (k == N_INTO) ? n : e->arena->nodes[n].num;
            const char *nm = e->arena->nodes[ow].text3;
            if (e->arena->nodes[ow].aux == 2) fprintf(e->out, "(*%s)", nm);
            else fputs(nm, e->out);
            return 0;
        }
        return e->emit_expr(n);
    }
    if (e->arena->nodes[n].kind == N_CLOSURE) {
        if (half == 1) return emit_closure_fn(e, n);
        return emit_closure_env(e, n);
    }
    cv = closure_var_lookup(e, e->arena->nodes[n].text2);
    if (cv < 0) return e->fail_from(n, "cannot resolve a closure argument");
    if (half == 1) fprintf(e->out, "__ct_cl_tramp_%d", cv);
    else fprintf(e->out, "&__ct_cl_env_v_%d", cv);
    return 0;
}

/* A repeated recipe occurrence may not evaluate a side effect twice. */
static int map_repeatable(struct Arena *a, int n)
{
    int k;
    if (n < 0) return 0;
    k = a->nodes[n].kind;
    if (k == N_VAR || k == N_NUM || k == N_STR) return 1;
    /* Phase 30: the receiver is a promoted local by the time a recipe runs, so
       repeating it is pure (§2.7 rule 3; a category-2 receiver is `(*recv)`). */
    if (k == N_INTO || k == N_INTO_SELF) return 1;
    if (k == N_MEMBER || k == N_ARROW || k == N_ADDR) return map_repeatable(a, a->nodes[n].a);
    if (k == N_INDEX) return map_repeatable(a, a->nodes[n].a) && map_repeatable(a, a->nodes[n].b);
    return 0;
}

static int map_param_index(struct MapBind *b, const char *name)
{
    int i;
    for (i = 0; i < b->nparams; i++)
        if (strcmp(b->params[i], name) == 0) return i;
    return -1;
}

/* The callee of a recipe (`atoi` in `atoi(s)`), for the map JSON. */
static void map_recipe_callee(const char *call, char *out)
{
    int n = 0;
    while (*call == ' ' || *call == '\t' || *call == '\n' || *call == '\r') call++;
    while (((*call >= 'a' && *call <= 'z') || (*call >= 'A' && *call <= 'Z')
            || (*call >= '0' && *call <= '9') || *call == '_') && n + 1 < MAX_TEXT) {
        out[n] = *call;
        n++;
        call++;
    }
    out[n] = 0;
}

static int map_param_type(struct Emitter *e, struct MapTable *m, struct MapBind *b, int i, char *out)
{
    int k;
    if (m->type_host && i == 0) {
        snprintf(out, MAX_TEXT, "%s", m->host_type);
        return 0;
    }
    k = m->type_host ? i - 1 : i;
    if (k < 0 || k >= e->sym->traits[b->ti].m[b->mi].nparams) return -1;
    snprintf(out, MAX_TEXT, "%s", e->sym->traits[b->ti].m[b->mi].ptype[k]);
    return 0;
}

static int map_is_ident(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
        || c == '_';
}

/* Copy one balanced `[…]` group from `s`; returns the position after it. */
static const char *map_copy_brackets(struct Emitter *e, const char *s)
{
    int depth = 0;
    do {
        if (*s == '\'' || *s == '"') {
            int q = (unsigned char)*s;
            fputc(*s, e->out);
            s++;
            while (*s) {
                fputc(*s, e->out);
                if (*s == '\\' && *(s + 1)) {
                    s++;
                    fputc(*s, e->out);
                } else if ((unsigned char)*s == q) {
                    s++;
                    break;
                }
                s++;
            }
            continue;
        }
        if (*s == '[') depth++;
        if (*s == ']') depth--;
        fputc(*s, e->out);
        s++;
    } while (depth > 0 && *s);
    return s;
}

/* Emit one recipe argument span, substituting the binding parameters (spec
   §4.10): `p`, `&p`, `&p[…]`, `sizeof p`, `p.field` / `p->field` / `p[i]`. */
static int map_subst_arg(struct Emitter *e, const char *s, struct MapTable *m, struct MapBind *b, int *actual, int *half)
{
    char tok[MAX_TEXT];
    char tp[MAX_TEXT];
    char suf[MAX_TEXT];
    int i, n, sl;

    while (*s) {
        if (*s == '\'' || *s == '"') {
            int q = (unsigned char)*s;
            fputc(*s, e->out);
            s++;
            while (*s) {
                fputc(*s, e->out);
                if (*s == '\\' && *(s + 1)) {
                    s++;
                    fputc(*s, e->out);
                } else if ((unsigned char)*s == q) {
                    s++;
                    break;
                }
                s++;
            }
            continue;
        }
        if (*s == '&') {
            const char *q = s + 1;
            while (*q == ' ' || *q == '\t') q++;
            n = 0;
            while (map_is_ident((unsigned char)q[n]) && n + 1 < MAX_TEXT) {
                tok[n] = q[n];
                n++;
            }
            tok[n] = 0;
            i = (n > 0) ? map_param_index(b, tok) : -1;
            if (i >= 0) {
                const char *r = q + n;
                while (*r == ' ' || *r == '\t') r++;
                if (*r == '[') {
                    if (map_param_type(e, m, b, i, tp) != 0) return -1;
                    fputs("&((", e->out);
                    if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
                    fputc(')', e->out);
                    s = map_copy_brackets(e, r);
                    fputc(')', e->out);
                    continue;
                }
                if (map_param_type(e, m, b, i, tp) != 0) return -1;
                map_clean_type(tp, tok);
                fprintf(e->out, "&(%s){", tok);
                if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
                fputc('}', e->out);
                s = r;
                continue;
            }
        }
        if (map_is_ident((unsigned char)*s)
            && !(*s >= '0' && *s <= '9')) {
            n = 0;
            while (map_is_ident((unsigned char)*s) && n + 1 < MAX_TEXT) {
                tok[n] = *s;
                n++;
                s++;
            }
            tok[n] = 0;
            /* `sizeof p` -> `sizeof(TP)`: no evaluation */
            if (strcmp(tok, "sizeof") == 0) {
                const char *q = s;
                while (*q == ' ' || *q == '\t') q++;
                n = 0;
                while (map_is_ident((unsigned char)q[n]) && n + 1 < MAX_TEXT) {
                    suf[n] = q[n];
                    n++;
                }
                suf[n] = 0;
                i = (n > 0) ? map_param_index(b, suf) : -1;
                if (i >= 0) {
                    if (map_param_type(e, m, b, i, tp) != 0) return -1;
                    map_clean_type(tp, suf);
                    fprintf(e->out, "sizeof(%s)", suf);
                    s = q + n;
                    continue;
                }
                fputs("sizeof", e->out);
                continue;
            }
            i = map_param_index(b, tok);
            if (i < 0) {
                fputs(tok, e->out);
                continue;
            }
            /* a member / index suffix keeps the table's parenthesised shape */
            sl = 0;
            for (;;) {
                if (*s == '.') {
                    suf[sl] = '.';
                    sl++;
                    s++;
                    while (map_is_ident((unsigned char)*s) && sl + 1 < MAX_TEXT) {
                        suf[sl] = *s;
                        sl++;
                        s++;
                    }
                    continue;
                }
                if (*s == '-' && *(s + 1) == '>') {
                    suf[sl] = '-';
                    suf[sl + 1] = '>';
                    sl += 2;
                    s += 2;
                    while (map_is_ident((unsigned char)*s) && sl + 1 < MAX_TEXT) {
                        suf[sl] = *s;
                        sl++;
                        s++;
                    }
                    continue;
                }
                if (*s == '[') {
                    int depth = 0;
                    do {
                        if (*s == '[') depth++;
                        if (*s == ']') depth--;
                        if (sl + 1 < MAX_TEXT) {
                            suf[sl] = *s;
                            sl++;
                        }
                        s++;
                    } while (depth > 0 && *s);
                    continue;
                }
                break;
            }
            suf[sl] = 0;
            if (sl > 0) fputs("((", e->out);
            else fputc('(', e->out);
            if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
            if (sl > 0) {
                fputc(')', e->out);
                fputs(suf, e->out);
                fputc(')', e->out);
            } else {
                fputc(')', e->out);
            }
            continue;
        }
        fputc(*s, e->out);
        s++;
    }
    return 0;
}

/* Expand one static recipe at the call site (spec §4.10): no wrapper,
   no vtable, the call is what a hand-written `.c` would say. */
static int emit_recipe(struct Emitter *e, struct MapTable *m, struct MapBind *b, int recv, int args, int at)
{
    char tok[MAX_TEXT];
    char arg[MAX_TEXT];
    char msg[512];
    int actual[16];
    int half[16];
    int i, hk, unused, first, depth, n, q;
    const char *p;

    for (i = 0; i < b->nparams; i++) {
        actual[i] = map_actual_span(e, recv, args, m->type_host, i, &half[i]);
        if (actual[i] < 0)
            return e->fail_from(at, "a map call has fewer arguments than its binding");
        /* A closure half that the recipe never names would fall into the
           `(void)(…)` branch, which has no C spelling for one half of the pair:
           the whole pair must be used (D25-5). */
        if (half[i] != 0 && b->uses[i] == 0)
            return e->fail_from(at, "a map recipe must use both halves of a closure argument");
        /* D25-5: a closure pair is referenced at most once per half; a second
           mention would hand the same trampoline to two formals. */
        if (half[i] != 0 && b->uses[i] >= 2)
            return e->fail_from(at, "a map recipe must use a closure argument exactly once");
        if (b->uses[i] >= 2 && !map_repeatable(e->arena, actual[i])) {
            snprintf(msg, sizeof msg,
                     "map recipe uses '%s' more than once; bind the argument to a local first",
                     b->params[i]);
            return e->fail_from(at, msg);
        }
    }
    unused = 0;
    for (i = 0; i < b->nparams; i++) if (b->uses[i] == 0) unused = 1;
    if (unused) fputc('(', e->out);
    for (i = 0; i < b->nparams; i++)
        if (b->uses[i] == 0) {
            fputs("(void)(", e->out);
            if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
            fputs("), ", e->out);
        }
    p = b->call;
    while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
    n = 0;
    while (map_is_ident((unsigned char)*p) && n + 1 < MAX_TEXT) {
        tok[n] = *p;
        n++;
        p++;
    }
    tok[n] = 0;
    fputs(tok, e->out);
    while (*p == ' ' || *p == '\t') p++;
    if (*p != '(') return e->fail_from(at, "a map recipe must be a single call");
    fputc('(', e->out);
    p++;
    first = 1;
    for (;;) {
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        if (*p == ')') { p++; break; }
        if (*p == 0) return e->fail_from(at, "a map recipe must be a single call");
        n = 0;
        depth = 0;
        while (*p) {
            if (depth == 0 && (*p == ',' || *p == ')')) break;
            if (*p == '\'' || *p == '"') {
                q = (unsigned char)*p;
                if (n + 1 < MAX_TEXT) arg[n++] = *p;
                p++;
                while (*p) {
                    if (n + 1 < MAX_TEXT) arg[n++] = *p;
                    if (*p == '\\' && *(p + 1)) {
                        p++;
                        if (n + 1 < MAX_TEXT) arg[n++] = *p;
                    } else if ((unsigned char)*p == q) {
                        p++;
                        break;
                    }
                    p++;
                }
                continue;
            }
            if (*p == '(') depth++;
            else if (*p == ')') depth--;
            if (n + 1 < MAX_TEXT) arg[n++] = *p;
            p++;
        }
        while (n > 0 && (arg[n - 1] == ' ' || arg[n - 1] == '\t')) n--;
        arg[n] = 0;
        /* `...` forwards every actual the binding parameters did not consume;
           an empty tail emits nothing, not a dangling separator. A closure
           cannot be forwarded: the tail has no fixed slot for its two halves
           (D25-5). */
        if (strcmp(arg, "...") == 0) {
            int k, a;
            for (k = b->nparams; (a = map_actual_span(e, recv, args,
                                                      m->type_host, k, &hk)) >= 0; k++) {
                if (hk != 0)
                    return e->fail_from(at, "a map recipe cannot pass a closure through '...'");
                if (!first) fputs(", ", e->out);
                fputc('(', e->out);
                e->emit_expr(a);
                fputc(')', e->out);
                first = 0;
            }
        } else {
            if (!first) fputs(", ", e->out);
            if (map_subst_arg(e, arg, m, b, actual, half) != 0) return -1;
            first = 0;
        }
        if (*p == ',') { p++; continue; }
        if (*p == ')') { p++; break; }
        return e->fail_from(at, "a map recipe must be a single call");
    }
    fputc(')', e->out);
    if (unused) fputc(')', e->out);
    return 0;
}

/* A raw block is written byte for byte, never indented or rewritten. Its
   lines are not the source's lines, so `#line` is re-anchored on the line
   after the closing marker: the block starts on the line after `#ct-raw`
   (directive line + 1), spans `nl` newlines, and the next line follows the
   `#ct-endraw` line. */
static int emit_raw_text(struct Emitter *self, int n)
{
    const char *text;
    int i;
    int nl = 0;

    text = self->arena->str_at((int)self->arena->nodes[n].num);
    for (i = 0; text[i]; i++)
        if (text[i] == '\n') nl++;
    fputs(text, self->out);
    if (i > 0 && text[i - 1] != '\n') fputc('\n', self->out);
    if ((*self->line_mode))
        fprintf(self->out, "#line %d \"%s\"\n", self->arena->nodes[n].line + nl + 2, self->path);
    return 0;
}

/* Does this closure belong to the function the emitter is writing? `owner` is
   the parser's `cur_func` (the short name of a function, or
   `<Struct>_<Trait>_<method>` for an impl method); the node carries the C
   spelling, which is the mangled one inside a namespace. */
static int closure_owned(struct Emitter *self, const char *owner, const char *cname)
{
    int fi;
    char mangled[MAX_TEXT];

    if (strcmp(owner, cname) == 0) return 1;
    fi = self->sym->find_func(owner);
    if (fi >= 0 && strcmp(self->sym->funcs[fi].cname, cname) == 0) return 1;
    /* A closure inside a namespaced function records the short name, while the
       function is written under its mangled C spelling (`ns_apply`). Without
       this branch the lookup misses and the products are silently dropped,
       leaving `cc` to report an incomplete environment (R06). */
    if (self->gprefix && self->gprefix[0]
        && snprintf(mangled, sizeof mangled, "%s%s", self->gprefix, owner) < (int)sizeof mangled
        && strcmp(mangled, cname) == 0)
        return 1;
    return 0;
}

/* Is `name` one of the closure variables in scope right now? */
static int closure_var_lookup(struct Emitter *self, const char *name)
{
    int i;

    for (i = self->nclvar - 1; i >= 0; i--)
        if (strcmp(self->clvar[i], name) == 0) return self->clid[i];
    return -1;
}

/* Phase 21 S3/S5: the per-function closure products. A bound literal becomes a
   struct on the caller's stack plus a `static` trampoline; nothing is allocated
   and nothing is freed. The struct and the trampoline are keyed by the closure
   id, which is monotone across the unit, so the ABI carries no function or
   namespace name. Three passes keep a nested literal's struct complete before
   the enclosing trampoline that builds an instance of it, and give every
   trampoline a prototype before any definition (D21-15: outer before inner,
   struct before trampoline). `restore_line` re-anchors `#line` on the
   definition that follows. */
static int emit_closures(struct Emitter *self, const char *owner, int restore_line)
{
    int ci, k, wrote, pass, base_cl;

    wrote = 0;
    for (pass = 0; pass < 3; pass++) {
        for (ci = 0; ci < self->sym->nclosure; ci++) {
            struct Closure *c = &self->sym->closures[ci];
            if (!c->ret[0]) continue;              /* not bound to a host type */
            if (!closure_owned(self, c->owner, owner)) continue;
            wrote = 1;
            if (pass == 0) {
                if ((*self->line_mode))
                    fprintf(self->out, "#line %d \"%s\"\n", c->line, self->path);
                fprintf(self->out, "/* closure at %s:%d */\n", self->path, c->line);
                fprintf(self->out, "struct __ct_cl_env_%d {\n", ci);
                if (c->ncap == 0)
                    fputs("    char __ct_cl_pad;\n", self->out);
                for (k = 0; k < c->ncap; k++)
                    fprintf(self->out, "    %s %s;\n", c->cap_type[k], c->cap_name[k]);
                fputs("};\n", self->out);
                continue;
            }
            if (pass == 1) {
                /* An enclosing trampoline may call one defined later, so every
                   product gets a prototype before any definition. */
                fprintf(self->out, "static %s __attribute__((unused)) __ct_cl_tramp_%d(void *self",
                        c->ret, ci);
                for (k = 0; k < c->nparams; k++)
                    fprintf(self->out, ", %s %s", c->ptype[k], c->pname[k]);
                fputs(");\n", self->out);
                continue;
            }
            if ((*self->line_mode))
                fprintf(self->out, "#line %d \"%s\"\n", c->line, self->path);
            fprintf(self->out, "static %s __attribute__((unused)) __ct_cl_tramp_%d(void *self",
                    c->ret, ci);
            for (k = 0; k < c->nparams; k++)
                fprintf(self->out, ", %s %s", c->ptype[k], c->pname[k]);
            fputs(")\n{\n", self->out);
            if (c->ncap > 0)
                fprintf(self->out, "    struct __ct_cl_env_%d *__ct_cl_e = self;\n", ci);
            else
                fputs("    (void)self;\n", self->out);
            /* an ignored parameter would trip -Wextra, the same way an impl casts
               its unused parameters */
            for (k = 0; k < c->nparams; k++)
                if (!self->node_mentions(c->body, c->pname[k]))
                    fprintf(self->out, "    (void)%s;\n", c->pname[k]);
            self->closure_ci = ci + 1;
            base_cl = self->nclvar;
            if (c->is_block) {
                int s;
                for (s = self->arena->nodes[c->body].a; s >= 0;
                     s = self->arena->nodes[s].next)
                    if (self->emit_node(s, 1) != 0) { self->nclvar = base_cl; self->closure_ci = 0; return -1; }
            } else if (strcmp(c->ret, "void") == 0) {
                fputs("    ", self->out);
                if (self->emit_expr(c->body) != 0) { self->nclvar = base_cl; self->closure_ci = 0; return -1; }
                fputs(";\n", self->out);
            } else {
                fputs("    return ", self->out);
                if (self->emit_expr(c->body) != 0) { self->nclvar = base_cl; self->closure_ci = 0; return -1; }
                fputs(";\n", self->out);
            }
            self->nclvar = base_cl;
            self->closure_ci = 0;
            fputs("}\n", self->out);
        }
    }
    /* only a unit that actually emitted products needs the line re-anchor */
    if (wrote && (*self->line_mode))
        fprintf(self->out, "#line %d \"%s\"\n", restore_line, self->path);
    return 0;
}

/* The initialiser list of a closure environment. A capture that the enclosing
   trampoline already holds is read from its environment field (`__ct_cl_e->x`);
   that is how a nested literal copies a value out of the outer environment
   instead of carrying a pointer to it (D21-2). Everything else is a plain name
   in the current frame. */
static int emit_closure_values(struct Emitter *self, int ci)
{
    struct Closure *c = &self->sym->closures[ci];
    int k, j;

    if (c->ncap == 0) {
        fputs("0", self->out);
        return 0;
    }
    for (k = 0; k < c->ncap; k++) {
        if (k > 0) fputs(", ", self->out);
        if (self->closure_ci > 0) {
            struct Closure *oc = &self->sym->closures[self->closure_ci - 1];
            int found = 0;
            for (j = 0; j < oc->ncap; j++)
                if (strcmp(oc->cap_name[j], c->cap_name[k]) == 0) found = 1;
            if (found) {
                fprintf(self->out, "__ct_cl_e->%s", c->cap_name[k]);
                continue;
            }
        }
        /* `self` has no C spelling of its own in an impl body */
        if (self->sym->self_mode && strcmp(c->cap_name[k], "self") == 0)
            fputs("_self", self->out);
        else
            fputs(c->cap_name[k], self->out);
    }
    return 0;
}

/* A closure declaration is a binding, not a value: the declared name never
   becomes a C variable. Its stack instance is the environment, and every call
   through the name expands to the trampoline with that instance (D21-14). The
   `unused` attribute keeps a never-called literal warning-free. */
static int emit_closure_decl(struct Emitter *self, int n)
{
    int ci = self->arena->nodes[self->arena->nodes[n].a].num;

    fprintf(self->out, "struct __ct_cl_env_%d __attribute__((unused)) __ct_cl_env_v_%d = { ",
            ci, ci);
    if (emit_closure_values(self, ci) != 0) return -1;
    fputs(" }", self->out);
    /* R09: the scope table is how a later `add(x)` and a later pair actual find
       this binding. Dropping the row would emit a plain call to a name that has
       no C variable, so the cap is a hard error. */
    if (self->nclvar >= 64)
        return self->fail_from(n, "too many closure bindings in one frame (limit 64)");
    snprintf(self->clvar[self->nclvar], MAX_TEXT, "%s", self->arena->nodes[n].text2);
    self->clid[self->nclvar] = ci;
    self->nclvar++;
    return 0;
}

/* One half of the `(fn, env)` pair. A static recipe places the two halves in
   their own slots, so each is written on its own; the plain call path below
   writes them back to back, byte for byte as before (D25-7). */
static int emit_closure_fn(struct Emitter *self, int n)
{
    int ci = self->arena->nodes[n].num;

    fprintf(self->out, "__ct_cl_tramp_%d", ci);
    return 0;
}

static int emit_closure_env(struct Emitter *self, int n)
{
    int ci = self->arena->nodes[n].num;

    fprintf(self->out, "&(struct __ct_cl_env_%d){ ", ci);
    if (emit_closure_values(self, ci) != 0) return -1;
    fputs(" }", self->out);
    return 0;
}

/* An inline literal as an actual: the `(fn, env)` pair is two C arguments, and
   the environment is a compound literal whose address lives until the end of
   the enclosing block -- long enough for the call and nothing is allocated
   (D21-14). Nested literals read their captures from `__ct_cl_e`. */
static int emit_closure_arg(struct Emitter *self, int n)
{
    if (emit_closure_fn(self, n) != 0) return -1;
    fputs(", ", self->out);
    return emit_closure_env(self, n);
}

static int emit_struct_insts(struct Emitter *self, int u, int header);
/* Phase 33 O3: 1 when an instance's element belongs to a unit other than the
   container template's own, so its helpers and methods move to the consumer. */
static int inst_elem_foreign(struct Emitter *self, int ii);
/* Phase 29: write the methods of the template impl blocks. `header` writes the
   prototypes an exported template's consumer needs; otherwise the definitions. */
static int emit_struct_impls(struct Emitter *self, int u, int header);

/* Phase 26: write one definition per generic instance owned by unit `u`
   (-1 = the single compile-mode unit). The template's own N_FUNC node is
   reused with `gtparam`/`gtarg`/`gtname` set for the duration, so no AST copy
   is made and the non-generic path is untouched (D26-7). */
static int emit_generic_defs(struct Emitter *self, int u)
{
    int i, t;
    for (i = 0; i < self->sym->nginsts; i++) {
        if (u >= 0 && self->sym->ginsts[i].owner != u)
            continue;
        t = self->sym->funcs[self->sym->ginsts[i].func].body;
        if (t < 0) continue;
        snprintf(self->gtparam, sizeof self->gtparam, "%s",
                 self->sym->funcs[self->sym->ginsts[i].func].tparam);
        snprintf(self->gtarg, sizeof self->gtarg, "%s", self->sym->ginsts[i].targ);
        snprintf(self->gtname, sizeof self->gtname, "%s", self->sym->ginsts[i].cname);
        if (self->emit_node(t, 0) != 0) {
            self->gtparam[0] = 0;
            self->gtarg[0] = 0;
            self->gtname[0] = 0;
            return -1;
        }
        self->gtparam[0] = 0;
        self->gtarg[0] = 0;
        self->gtname[0] = 0;
    }
    return 0;
}

/* The per-unit emission proper: everything from the banner to the last
   function, run with `self->out` already pointing at an open file. Every
   failure is a bare `return -1`; the method that opened the file closes it and
   drops the half-written artefact, so a failed build leaves nothing that looks
   like a real unit. */
static int emit_unit_body(struct Emitter *self, int u)
{
    int n, i;

    fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
            self->version, self->path);
    fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
          self->out);
    /* The imported `.m.ct` prologue leads the unit: the recipes call C
       functions whose declarations (and macros) come from those lines. */
    if (emit_map_prologues(self, u) != 0) return -1;
    /* Only a `.h.ct` unit publishes a header, so only it includes one of
       its own; an implementation unit's `.c` carries every declaration it
       needs (the types are emitted below, no longer skipped as `pub`). */
    if (self->units[u].is_hdr)
        fprintf(self->out, "#include \"%s.h\"\n", self->units[u].base);
    for (i = 0; i < self->units[u].ndep; i++) {
        if (self->units[self->units[u].depu[i]].is_map) continue;
        fprintf(self->out, "#include \"%s.h\"\n", self->units[u].dep[i]);
    }
    /* Phase 29 E29-5: instances of the built-in templates are defined in the
       layer's headers; the unit sees them although there is no import edge.
       P34 S9a: the layer may span several files, so every layer header the
       unit does not own is included. */
    for (i = 0; i < self->nbuiltin; i++) {
        int bu = self->builtins[i];
        if (bu < 0 || bu >= *self->nunits || bu == u) continue;
        fprintf(self->out, "#include \"%s.h\"\n", self->units[bu].base);
    }
    fputs("\n", self->out);
    if ((*self->line_mode)) fprintf(self->out, "#line 1 \"%s\"\n", self->path);

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_PP) fprintf(self->out, "%s\n", self->arena->nodes[n].text);

    if (self->emit_struct_fwd() != 0) return -1;
    if (self->emit_trait_range(self->units[u].tr_start, self->units[u].tr_end, 2) != 0) return -1;
    if (self->emit_vtable_fwd(self->units[u].prog) != 0) return -1;

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        /* raw blocks keep their source position relative to the declarations */
        if (self->arena->nodes[n].kind == N_RAW_TEXT) {
            if (emit_raw_text(self, n) != 0) return -1;
            continue;
        }
        /* A `pub` struct/typedef/enum/union is in the header of a header
           unit, so only a private one is emitted here; an implementation
           unit has no header, so it emits all of them. */
        if ((self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
             || self->arena->nodes[n].kind == N_ENUM || self->arena->nodes[n].kind == N_UNION)
            && (self->arena->nodes[n].d != 1 || !self->units[u].is_hdr)) {
            if (self->emit_type_decl(n, 0, 1) != 0) return -1;
        }
    }

    /* Phase 29: the monomorphised structs this unit must define, after every
       plain type and before the prototypes that name them. */
    if (emit_struct_insts(self, u, 0) != 0) return -1;
    if (emit_struct_impls(self, u, 0) != 0) return -1;

    for (i = self->units[u].fn_start; i < self->units[u].fn_end; i++)
        if (self->emit_proto(i) != 0) return -1;

    /* file-scope static assertions, after every type of this unit */
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_SASSERT)
            if (self->emit_node(n, 0) != 0) return -1;

    /* A `pub` global still needs its definition here (the header only
       declares it), and an `extern` global needs nothing at all. The
       initialiser may name a prototype emitted just above (D-6). */
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_GLOBAL || self->arena->nodes[n].aux == 2) continue;
        if (self->emit_type_decl(n, 0, 1) != 0) return -1;
    }

    if (self->emit_impls(self->units[u].prog) != 0) return -1;

    if (self->emit_maps(u) != 0) return -1;

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_FUNC) {
            int cur = self->sym->find_func(self->arena->nodes[n].text2);
            /* a generic template has no C body of its own (Phase 26) */
            if (cur >= 0 && self->sym->funcs[cur].ntparams > 0) continue;
            /* the closure products of this function land above its definition */
            if (emit_closures(self, self->arena->nodes[n].text2, self->arena->nodes[n].line) != 0)
                return -1;
            if (self->emit_node(n, 0) != 0) return -1;
        }
    if (emit_generic_defs(self, u) != 0) return -1;

    return 0;
}

/* The header writer's body, likewise with the sink already open. */
static int write_unit_header_body(struct Emitter *self, int u, const char *guard)
{
    int n, i, pp;

    fprintf(self->out, "#ifndef %s\n", guard);
    fprintf(self->out, "#define %s\n\n", guard);
    fprintf(self->out, "/* Generated by ct v%s from %s (multi-file mode: exported types; the matching .c\n"
                   "   includes this header).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
            self->version, self->path);
    /* The exported types may name types from the source's own C includes,
       so those lines lead the header. Only `#include` is copied: other `#`
       lines belong to the implementation and would be duplicated. */
    pp = 0;
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_PP) continue;
        if (strncmp(self->arena->nodes[n].text, "#include", 8) != 0) continue;
        fprintf(self->out, "%s\n", self->arena->nodes[n].text);
        pp++;
    }
    if (pp > 0) fputs("\n", self->out);
    for (i = 0; i < self->units[u].ndep; i++) {
        if (self->units[self->units[u].depu[i]].is_map) continue;
        fprintf(self->out, "#include \"%s.h\"\n", self->units[u].dep[i]);
    }
    if (self->units[u].ndep > 0) fputs("\n", self->out);
    /* Phase 29 E29-5: a `pub` signature may name an instance defined in the
       built-in layer's header. P34 S9a: include every layer header the unit
       does not own. */
    for (i = 0; i < self->nbuiltin; i++) {
        int bu = self->builtins[i];
        if (bu < 0 || bu >= *self->nunits || bu == u) continue;
        fprintf(self->out, "#include \"%s.h\"\n", self->units[bu].base);
    }
    if (self->nbuiltin > 0) fputs("\n", self->out);

    if (self->emit_struct_fwd() != 0) return -1;
    if (self->emit_trait_range(self->units[u].tr_start, self->units[u].tr_end, 1) != 0) return -1;
    if (self->emit_link_externs(self->units[u].prog, u) != 0) return -1;

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        if ((self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
             || self->arena->nodes[n].kind == N_ENUM || self->arena->nodes[n].kind == N_UNION)
            && self->arena->nodes[n].d == 1) {
            if (self->emit_type_decl(n, 0, 1) != 0) return -1;
        } else if (self->arena->nodes[n].kind == N_GLOBAL
                   && (self->arena->nodes[n].d == 1 || self->arena->nodes[n].aux == 2)) {
            if (self->emit_global_extern(n) != 0) return -1;
        }
    }

    /* Phase 29: a `pub` template publishes every instance of it here, so a
       consumer only includes this header instead of repeating the layout. */
    if (emit_struct_insts(self, u, 1) != 0) return -1;
    if (emit_struct_impls(self, u, 1) != 0) return -1;

    for (i = self->units[u].fn_start; i < self->units[u].fn_end; i++) {
        if (!self->sym->funcs[i].is_pub || self->sym->funcs[i].is_static) continue;
        if (self->emit_proto(i) != 0) return -1;
    }
    if (self->emit_inherent_protos(self->units[u].prog) != 0) return -1;

    fputs("\n#endif\n", self->out);
    return 0;
}

/* Phase 29 §2.3: one definition per monomorphised struct. The symbol table is
   build-wide, so the filter decides which unit owns which definition:
     - a `pub` template's instances live in its owner's header, and only there;
     - a private template's instances live in the `.c` of the unit that first
       named them (the dependency-first emit order puts an inner instance's
       unit ahead of the outer one's).
   Field spellings were substituted when the instance was created, so this
   writer only prints; it never re-derives a layout. */
static int inst_emit_one(struct Emitter *self, int ii)
{
    int ti, j, v, n;
    struct StructInst *insts;

    insts = frontend::sym::ct_insts(&n);
    if (!insts || ii < 0 || ii >= n) return 0;
    if (insts[ii].emitted) return 0;
    ti = self->sym->find_struct(insts[ii].name);
    if (ti < 0) return 0;
    insts[ii].emitted = 1;
    fprintf(self->out, "struct %s {\n", self->sym->structs[ti].name);
    for (j = 0; j < self->sym->structs[ti].nfields; j++) {
        fputs("    ", self->out);
        {
            const char *ft = self->sym->structs[ti].fields[j].type;
            char ibuf[160];
            if (strchr(ft, '<') && frontend::sym::ct_inst_resolve(ft, ibuf, sizeof ibuf) == 0)
                ft = ibuf;
            fprintf(self->out, "%s %s%s;\n", ft,
                    self->sym->structs[ti].fields[j].name,
                    self->sym->structs[ti].fields[j].dims);
        }
    }
    for (v = 0; v < self->sym->structs[ti].nuse; v++) {
        char low[MAX_TEXT];
        int k;
        for (k = 0; self->sym->structs[ti].use[v][k] && k + 1 < MAX_TEXT; k++) {
            char c = self->sym->structs[ti].use[v][k];
            if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
            low[k] = c;
        }
        low[k] = 0;
        fprintf(self->out, "    struct %s_vtbl *__%s_vptr;\n",
                self->sym->structs[ti].use[v], low);
    }
    fputs("};\n\n", self->out);
    return 0;
}

/* A plain struct whose field is an instance (`struct Bag { Vec<int> v; }`)
   needs that definition before its own, while an instance whose field is a plain
   struct by pointer only needs the forward declaration `emit_struct_fwd`
   already wrote. Emitting on first mention keeps both cases legal without a
   whole-type dependency sort. */
static int preemit_insts_for(struct Emitter *self, const char *type)
{
    int i, n;
    struct StructInst *insts;
    char pat[MAX_TEXT + 16];

    insts = frontend::sym::ct_insts(&n);
    if (!insts) return 0;
    for (i = 0; i < n; i++) {
        if (insts[i].emitted) continue;
        snprintf(pat, sizeof pat, "struct %s", insts[i].name);
        if (strstr(type, pat)) {
            if (inst_emit_one(self, i) != 0) return -1;
        }
    }
    return 0;
}

static int emit_struct_insts(struct Emitter *self, int u, int header)
{
    int i, n, tn, tmpl;
    struct StructInst *insts;
    struct StructTmpl *tps;

    insts = frontend::sym::ct_insts(&n);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!insts || !tps) return 0;
    for (i = 0; i < n; i++) {
        int via_hdr;
        if (insts[i].emitted) continue;
        tmpl = frontend::sym::ct_tmpl_find(insts[i].tmpl);
        if (tmpl < 0) continue;
        via_hdr = tps[tmpl].is_pub && tps[tmpl].owner >= 0
                  && self->units[tps[tmpl].owner].is_hdr;
        if (header) {
            if (!via_hdr || tps[tmpl].owner != u) continue;
            /* P34 S8: an `Option` / `Result` instance whose element lives in the
               consumer cannot be defined in the layer's header (the field is
               incomplete there); the consumer writes it after the element. */
            if (inst_elem_foreign(self, i)) continue;
        } else {
            /* P34 S8: a foreign-element instance is written by the unit that
               named it -- the only one that can print the element. The
               container layout is handle-only, so moving it costs the layer
               nothing; `Option` / `Result` need it or the field is
               incomplete. */
            if (inst_elem_foreign(self, i)) {
                if (u >= 0 && insts[i].owner != u) continue;
            } else {
                if (via_hdr) continue;
                /* `u < 0` is compile mode: the one file owns every instance. */
                if (u >= 0 && insts[i].owner != u) continue;
            }
        }
        if (inst_emit_one(self, i) != 0) return -1;
    }
    return 0;
}

/* Bind the block's type parameters to the instance's arguments. The type
   printing paths read these two pairs, so a method's signature and body are
   written with `T`/`U` replaced by the concrete C spellings. */
static void impl_inst_bind(struct Emitter *self, int ki, int ii)
{
    int k, n, nins, pi, bind_at[2];
    struct StructImpl *im;
    struct StructInst *ins;

    im = frontend::sym::ct_impls(&n);
    ins = frontend::sym::ct_insts(&nins);
    self->gtparam[0] = 0;
    self->gtarg[0] = 0;
    self->gtparam2[0] = 0;
    self->gtarg2[0] = 0;
    self->ginst[0] = 0;
    if (!im || !ins || ki < 0 || ki >= n || ii < 0 || ii >= nins) return;
    snprintf(self->ginst, sizeof self->ginst, "%s", ins[ii].name);
    bind_at[0] = -1;
    bind_at[1] = -1;
    for (k = 0; k < ins[ii].nargs; k++) {
        pi = -1;
        if (im[ki].ntparams > 0 && strcmp(im[ki].pat[k], im[ki].tparam[0]) == 0) pi = 0;
        else if (im[ki].ntparams > 1 && strcmp(im[ki].pat[k], im[ki].tparam[1]) == 0) pi = 1;
        if (pi >= 0) bind_at[pi] = k;
    }
    if (bind_at[0] >= 0) {
        snprintf(self->gtparam, MAX_TEXT, "%s", im[ki].tparam[0]);
        snprintf(self->gtarg, MAX_TEXT, "%s", ins[ii].ctype[bind_at[0]]);
    }
    if (bind_at[1] >= 0) {
        snprintf(self->gtparam2, MAX_TEXT, "%s", im[ki].tparam[1]);
        snprintf(self->gtarg2, MAX_TEXT, "%s", ins[ii].ctype[bind_at[1]]);
    }
}

/* P29-14 (V29-1): two inherent blocks can cover one instance -- `impl<V>
   Map<char *, V>` and `impl<K, V> Map<K, V>` both match `Map<char *, int>`.
   Resolution takes the first block in declaration order that declares the name
   (`inst_inherent_method`), so the emitter must not emit the later duplicate:
   1 when an earlier matching block already owns `fname` for this instance. */
static int impl_method_shadowed(struct Emitter *self, int ki, int ii, const char *fname)
{
    int k, m, nimpls;
    struct StructImpl *im;

    im = frontend::sym::ct_impls(&nimpls);
    if (!im) return 0;
    for (k = 0; k < ki; k++) {
        if (im[k].use[0]) continue;
        if (!frontend::sym::ct_impl_matches(k, ii)) continue;
        for (m = self->arena->nodes[im[k].node].a; m >= 0; m = self->arena->nodes[m].next)
            if (strcmp(self->arena->nodes[m].text2, fname) == 0) return 1;
    }
    return 0;
}

/* One method of a template impl for one instance. An inherent method takes the
   `<Inst>_<method>` symbol and is dispatched statically; a `use` block keeps the
   `<Inst>_<Trait>_<method>` spelling plus its vtable, so the vptr path stays
   exactly what a concrete impl already produces. */
static int impl_emit_method(struct Emitter *self, int ki, int ii, int m, int header)
{
    int k, nimpls, ninsts, ntmpls, body, tmpl;
    char iname[MAX_TEXT];
    char cname[MAX_TEXT];
    char cuse[MAX_TEXT];
    char mret[MAX_TEXT];
    char one[MAX_TEXT];
    const char *tname;
    struct StructInst *ins;
    struct StructTmpl *tps;
    int exported;
    int statik;

    ins = frontend::sym::ct_insts(&ninsts);
    tps = frontend::sym::ct_tmpls(&ntmpls);
    (void)nimpls;
    (void)ntmpls;
    snprintf(iname, sizeof iname, "%s", ins[ii].name);
    tmpl = frontend::sym::ct_tmpl_find(ins[ii].tmpl);
    exported = tmpl >= 0 && tps[tmpl].is_pub && tps[tmpl].owner >= 0
               && self->units[tps[tmpl].owner].is_hdr;
    /* Phase 33 O3: a consumer copy is private to the unit that writes it, so it
       stays `static` even when the template's header normally exports the name;
       one copy per consumer unit links fine, two globals would not. */
    if (inst_elem_foreign(self, ii)) exported = 0;
    tname = frontend::sym::ct_impls(&nimpls)[ki].use;
    /* Phase 35 S5a: a template impl's `use Iter<T>` is spelled per instance. */
    if (self->sym->impl_use_concrete(tname, ins[ii].nargs,
                             ins[ii].carg[0], ins[ii].carg[1],
                             ins[ii].ctype[0], ins[ii].ctype[1], -1,
                             cuse, sizeof cuse) != 0)
        return -1;
    tname = cuse;
    /* An inherent name a more specific block already owns for this instance is
       not emitted twice (V29-1); a trait method keeps its own symbol. */
    if (!tname[0] && impl_method_shadowed(self, ki, ii, self->arena->nodes[m].text2))
        return 0;
    snprintf(mret, sizeof mret, "%s", self->arena->nodes[m].text[0]
             ? self->arena->nodes[m].text : "void");
    if (tname[0])
        snprintf(cname, sizeof cname, "%s_%s_%s", iname, tname,
                 self->arena->nodes[m].text2);
    else
        snprintf(cname, sizeof cname, "%s_%s", iname, self->arena->nodes[m].text2);
    impl_inst_bind(self, ki, ii);
    /* P29-2: `c` marks a static (receiverless) method -- `Vec_int_from` takes
       only its own parameters and gets no `_self` local. */
    statik = self->arena->nodes[m].c;
    if (header) {
        if (self->emit_type_name(mret, cname) != 0) return -1;
        if (statik) fputs("(", self->out);
        else fputs("(void *self", self->out);
        for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next) {
            fputs(statik ? (k == self->arena->nodes[m].a ? "" : ", ") : ", ", self->out);
            if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                          self->arena->nodes[k].text2,
                                          self->arena->nodes[k].text3) != 0) return -1;
        }
        fputs(");\n", self->out);
        return 0;
    }
    if (!exported) fputs("static ", self->out);
    /* A private method nothing calls is dead code; the attribute keeps the
       output clean under -Wall, exactly like the Drop / Handback bodies. */
    if (!exported) fputs("__attribute__((unused)) ", self->out);
    if (self->emit_type_name(mret, cname) != 0) return -1;
    if (statik) fputs("(", self->out);
    else fputs("(void *self", self->out);
    for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next) {
        fputs(statik ? (k == self->arena->nodes[m].a ? "" : ", ") : ", ", self->out);
        if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                      self->arena->nodes[k].text2,
                                      self->arena->nodes[k].text3) != 0) return -1;
    }
    fputs(") {\n", self->out);
    if (!statik) {
        snprintf(one, sizeof one, "struct %s", iname);
        fprintf(self->out, "    %s *_self = (%s *)self;\n", one, one);
    }
    self->sym->self_mode = statik ? 0 : 1;
    body = self->arena->nodes[m].b;
    for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next)
        if (!self->node_mentions(body, self->arena->nodes[k].text2))
            fprintf(self->out, "    (void)%s;\n", self->arena->nodes[k].text2);
    if (!statik && !self->node_mentions(body, "self")) fputs("    (void)_self;\n", self->out);
    for (k = self->arena->nodes[body].a; k >= 0; k = self->arena->nodes[k].next)
        if (self->emit_node(k, 1) != 0) {
            self->sym->self_mode = 0;
            return -1;
        }
    self->sym->self_mode = 0;
    fputs("}\n\n", self->out);
    return 0;
}

static int impl_emit_one(struct Emitter *self, int ki, int ii)
{
    int m, nimpls, ninsts;
    char cuse[MAX_TEXT];
    struct StructImpl *im;
    struct StructInst *ins;

    im = frontend::sym::ct_impls(&nimpls);
    ins = frontend::sym::ct_insts(&ninsts);
    if (!im || !ins || ki < 0 || ki >= nimpls || ii < 0 || ii >= ninsts) return 0;
    for (m = self->arena->nodes[im[ki].node].a; m >= 0; m = self->arena->nodes[m].next)
        if (impl_emit_method(self, ki, ii, m, 0) != 0) return -1;
    if (im[ki].use[0]) {
        int first = 1;
        int builtin = (strcmp(im[ki].use, "Drop") == 0 || strcmp(im[ki].use, "Handback") == 0)
                      && self->sym->find_trait(im[ki].use) < 0;
        /* P36 S1a: the built-in `Drop`/`Handback` have no vptr, no vtable and
           no vtable type, so a generic impl of them emits only the methods. */
        if (!builtin) {
            if (self->sym->impl_use_concrete(im[ki].use, ins[ii].nargs,
                                     ins[ii].carg[0], ins[ii].carg[1],
                                     ins[ii].ctype[0], ins[ii].ctype[1], -1,
                                     cuse, sizeof cuse) != 0)
                return -1;
            fprintf(self->out, "static struct %s_vtbl %s_%s_vtable __attribute__((unused)) = {\n",
                    cuse, ins[ii].name, cuse);
            for (m = self->arena->nodes[im[ki].node].a; m >= 0; m = self->arena->nodes[m].next) {
                if (!first) fputs(",\n", self->out);
                fprintf(self->out, "    .%s = %s_%s_%s", self->arena->nodes[m].text2,
                        ins[ii].name, cuse, self->arena->nodes[m].text2);
                first = 0;
            }
            fputs("\n};\n\n", self->out);
        }
    }
    return 0;
}

/* Phase 31 O3 (S5b): the declared return type of an inherent method, with the
   instance's type arguments substituted and any nested instance resolved. */
static int elem_ret_ctype(int inst, const char *text, char *out, int cap)
{
    char cur[MAX_TEXT];
    char nxt[MAX_TEXT];
    char res[MAX_TEXT];
    int ti, tn, k;
    struct StructInst *ins;
    struct StructTmpl *tps;

    ins = frontend::sym::ct_insts(&k);
    ti = frontend::sym::ct_tmpl_find(ins[inst].tmpl);
    tps = frontend::sym::ct_tmpls(&tn);
    snprintf(cur, sizeof cur, "%s", text);
    if (ti >= 0 && tps) {
        if (tps[ti].ntparams > 0
            && frontend::sym::ct_generic_subst(cur, tps[ti].tparam[0],
                    ins[inst].ctype[0], nxt, sizeof nxt) == 0)
            snprintf(cur, sizeof cur, "%s", nxt);
        if (tps[ti].ntparams > 1
            && frontend::sym::ct_generic_subst(cur, tps[ti].tparam[1],
                    ins[inst].ctype[1], nxt, sizeof nxt) == 0)
            snprintf(cur, sizeof cur, "%s", nxt);
    }
    if (strchr(cur, '<') && frontend::sym::ct_inst_resolve(cur, res, sizeof res) == 0)
        snprintf(cur, sizeof cur, "%s", res);
    if (snprintf(out, (size_t)cap, "%s", cur) >= cap) return 0;
    return 1;
}

/* Phase 31 O3 (S5b): a user element type owns a resource when it declares both
   `retain` (returning its own type) and `release`. The built-in containers
   always qualify. The return-type test keeps an unrelated `retain` from being
   mistaken for this protocol.

   Phase 36 S1a: a plain (non-generic) struct is not in the instance table, so
   when `ct_inst_find` misses we fall back to the struct row and match inherent
   impls by their N_IMPL `aux` (the struct row index). Without this,
   `Vec<Probe>` / `Vec<Str>` would never release their elements. */
static int elem_has_life(struct Emitter *self, const char *elem)
{
    char base[MAX_TEXT];
    char want[MAX_TEXT];
    char ret[MAX_TEXT];
    int inst, si, k, n, m, got_r, got_rel;
    struct StructImpl *im;

    if (frontend::sym::ct_is_container_type(elem)) return 1;
    if (strncmp(elem, "struct ", 7) != 0) return 0;
    snprintf(base, sizeof base, "%s", elem + 7);
    snprintf(want, sizeof want, "struct %s", base);
    im = frontend::sym::ct_impls(&n);
    inst = frontend::sym::ct_inst_find(base);
    if (inst >= 0) {
        got_r = 0;
        got_rel = 0;
        for (k = 0; im && k < n; k++) {
            if (im[k].use[0]) continue;
            if (!frontend::sym::ct_impl_matches(k, inst)) continue;
            for (m = self->arena->nodes[im[k].node].a; m >= 0;
                 m = self->arena->nodes[m].next) {
                if (strcmp(self->arena->nodes[m].text2, "release") == 0) got_rel = 1;
                if (strcmp(self->arena->nodes[m].text2, "retain") == 0
                    && self->arena->nodes[m].text[0]
                    && elem_ret_ctype(inst, self->arena->nodes[m].text,
                                      ret, sizeof ret)
                    && strcmp(ret, want) == 0)
                    got_r = 1;
            }
            if (got_r && got_rel) return 1;
        }
        return 0;
    }
    /* Plain struct: inherent impls are N_IMPL nodes in the arena (they are not
       registered in the global ct_impls table, which only holds generic
       impls). Walk the arena for N_IMPL nodes whose aux is this struct row. */
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    got_r = 0;
    got_rel = 0;
    for (k = 0; k < self->arena->nnode; k++) {
        if (self->arena->nodes[k].kind != N_IMPL) continue;
        if (self->arena->nodes[k].aux != si) continue;
        if (self->arena->nodes[k].text2[0]) continue;  /* trait impl */
        for (m = self->arena->nodes[k].a; m >= 0;
             m = self->arena->nodes[m].next) {
            if (strcmp(self->arena->nodes[m].text2, "release") == 0) got_rel = 1;
            if (strcmp(self->arena->nodes[m].text2, "retain") == 0
                && self->arena->nodes[m].text[0]
                && (strcmp(self->arena->nodes[m].text, base) == 0
                    || strcmp(self->arena->nodes[m].text, want) == 0))
                got_r = 1;
        }
        if (got_r && got_rel) return 1;
    }
    return 0;
}

/* Phase 31 O3: the unit that writes an instance's methods owns its helpers, so
   the filter follows the impl owner, not the instance owner (a Vec instance is
   created in the user's unit while `impl<T> Vec<T>` lives in the built-in
   unit). */
static int inst_touched_by_unit(struct Emitter *self, int u, int ii)
{
    int k, n;
    struct StructImpl *im;

    (void)self;
    if (u < 0) return 1;
    im = frontend::sym::ct_impls(&n);
    for (k = 0; im && k < n; k++) {
        if (im[k].owner != u) continue;
        if (frontend::sym::ct_impl_matches(k, ii)) return 1;
    }
    return 0;
}

/* Phase 33 O3: an instance whose element belongs to a unit other than the
   container template's own. The template's unit cannot print the element's
   definition, so the per-instance helpers and methods move to the unit that
   named the instance (the only one that sees the element). */
/* The unit that declares a plain `struct` element, or -1 when the spelling is
   not one (a scalar, an interface value, an instance row, an unknown tag). */
static int elem_plain_owner(struct Emitter *self, const char *ctype)
{
    char base[MAX_TEXT];
    int si;

    if (strncmp(ctype, "struct ", 7) != 0) return -1;
    snprintf(base, sizeof base, "%s", ctype + 7);
    if (frontend::sym::ct_inst_find(base) >= 0) return -1;
    si = self->sym->find_struct(base);
    if (si < 0) return -1;
    return self->sym->structs[si].owner;
}

static int inst_elem_foreign(struct Emitter *self, int ii)
{
    int n, tn, tmpl, o1, o2;
    struct StructInst *ins;
    struct StructTmpl *tps;
    struct Expr *ex;
    const char *e1;
    const char *e2;

    ins = frontend::sym::ct_insts(&n);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!ins || !tps || ii < 0 || ii >= n) return 0;
    /* The containers keep the element behind a buffer handle, so their layout
       is printable anywhere; `Option` / `Result` store it by value (P34 S8),
       which makes a foreign element just as unprintable. Every other template
       keeps the Phase 33 rule. */
    if (strcmp(ins[ii].tmpl, "Vec") != 0 && strcmp(ins[ii].tmpl, "Map") != 0
        && strcmp(ins[ii].tmpl, "Option") != 0 && strcmp(ins[ii].tmpl, "Result") != 0)
        return 0;
    tmpl = frontend::sym::ct_tmpl_find(ins[ii].tmpl);
    if (tmpl < 0 || tps[tmpl].owner < 0) return 0;
    e1 = ins[ii].ctype[0];
    e2 = (strcmp(ins[ii].tmpl, "Map") == 0 && ins[ii].nargs > 1)
         ? ins[ii].ctype[1] : 0;
    /* An interface value (its trait's unit) or an owning instance (its
       template's unit) is judged by the Phase 31 reader. */
    ex = frontend::parse::expr_get();
    if (ex->container_elem_foreign(e1, tmpl)) return 1;
    if (e2 != 0 && ex->container_elem_foreign(e2, tmpl)) return 1;
    /* A plain struct carries its declaring unit directly (Phase 33): its
       definition travels only through that unit's header, which the container's
       unit does not include unless it is the same unit. */
    o1 = elem_plain_owner(self, e1);
    if (o1 >= 0 && o1 != tps[tmpl].owner) return 1;
    o2 = (e2 != 0) ? elem_plain_owner(self, e2) : -1;
    return o2 >= 0 && o2 != tps[tmpl].owner;
}

/* Phase 33 O3: which unit writes the element-lifecycle helper pair. A foreign
   element moves the pair to the unit that named the instance; every other case
   keeps the Phase 31 rule (the impl owner writes it). */
static int inst_writes_helpers(struct Emitter *self, int u, int ii)
{
    int n;
    struct StructInst *ins;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (!inst_elem_foreign(self, ii)) return inst_touched_by_unit(self, u, ii);
    if (u < 0) return 1;
    return ins[ii].owner == u;
}

/* Phase 36 S1a: forward-declare a plain-struct element's retain/release so the
   elem helpers (emitted before the inherent method bodies) compile. The return
   type is read straight off the method node, the same spelling the definition
   uses. */
static int inst_emit_elem_method_protos(struct Emitter *self, const char *elem)
{
    char base[MAX_TEXT];
    char want[MAX_TEXT];
    int si, k, m;

    if (frontend::sym::ct_is_container_type(elem)) return 0;
    if (strncmp(elem, "struct ", 7) != 0) return 0;
    snprintf(base, sizeof base, "%s", elem + 7);
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    snprintf(want, sizeof want, "struct %s", base);
    for (k = 0; k < self->arena->nnode; k++) {
        if (self->arena->nodes[k].kind != N_IMPL) continue;
        if (self->arena->nodes[k].aux != si) continue;
        if (self->arena->nodes[k].text2[0]) continue;
        for (m = self->arena->nodes[k].a; m >= 0; m = self->arena->nodes[m].next) {
            const char *mname = self->arena->nodes[m].text2;
            const char *rtype;
            if (strcmp(mname, "retain") != 0 && strcmp(mname, "release") != 0)
                continue;
            rtype = self->arena->nodes[m].text[0]
                    ? self->arena->nodes[m].text : "void";
            /* Match the definition's linkage: private structs emit static
               methods, pub structs emit external-linkage ones. */
            if (!self->decl_is_pub(N_STRUCT, base))
                fputs("static ", self->out);
            fprintf(self->out, "%s %s_%s(%s *);\n", rtype, base, mname, want);
        }
    }
    return 0;
}

/* Phase 31 O3: the definitions live after the instance methods, so a prototype
   pair must precede every body that calls them (compile mode has no header). */
static int inst_emit_elem_protos(struct Emitter *self, int ii)
{
    int n;
    struct StructInst *ins;
    const char *elem;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (strcmp(ins[ii].tmpl, "Vec") == 0) elem = ins[ii].ctype[0];
    else if (strcmp(ins[ii].tmpl, "Map") == 0) elem = ins[ii].ctype[1];
    else return 0;
    /* Phase 36 S1a: a plain-struct element's retain/release are inherent
       methods emitted after the elem helpers, so forward-declare them.
       Container elements get their methods from the instance impls above. */
    if (elem_has_life(self, elem) && inst_emit_elem_method_protos(self, elem) != 0)
        return -1;
    fprintf(self->out, "static void %s__elem_retain(%s *e);\n",
            ins[ii].name, elem);
    fprintf(self->out, "static void %s__elem_release(%s *e);\n",
            ins[ii].name, elem);
    return 0;
}

/* Phase 31 O3: one pair of element lifecycle helpers per container instance.
   `retain`/`release` on an element type that owns a resource copy the bumped
   handle and guard a release whose handle is already empty when the element is
   itself a Vec / Map; every other element is non-owning and gets empty bodies.
   The calls in lib/std spell the reserved names and bind to these at emission
   time (`ginst`). */
static int inst_emit_elem_helpers(struct Emitter *self, int ii)
{
    int n, life, handle;
    struct StructInst *ins;
    const char *elem;
    char iname[MAX_TEXT];
    char ename[MAX_TEXT];

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (strcmp(ins[ii].tmpl, "Vec") == 0) elem = ins[ii].ctype[0];
    else if (strcmp(ins[ii].tmpl, "Map") == 0) elem = ins[ii].ctype[1];
    else return 0;
    snprintf(iname, sizeof iname, "%s", ins[ii].name);
    handle = frontend::sym::ct_is_container_type(elem);
    life = elem_has_life(self, elem);
    snprintf(ename, sizeof ename, "%s",
             strncmp(elem, "struct ", 7) == 0 ? elem + 7 : elem);
    fprintf(self->out,
            "static void __attribute__((unused)) %s__elem_retain(%s *e)\n{\n",
            iname, elem);
    if (life) fprintf(self->out, "    *e = %s_retain(e);\n}\n\n", ename);
    else fputs("    (void)e;\n}\n\n", self->out);
    fprintf(self->out,
            "static void __attribute__((unused)) %s__elem_release(%s *e)\n{\n",
            iname, elem);
    if (life && handle)
        fprintf(self->out, "    if (e->h == 0) return;\n    (void)%s_release(e);\n}\n\n",
                ename);
    else if (life)
        fprintf(self->out, "    (void)%s_release(e);\n}\n\n", ename);
    else fputs("    (void)e;\n}\n\n", self->out);
    return 0;
}

static int emit_struct_impls(struct Emitter *self, int u, int header)
{
    int ki, nimpls, i, ninsts, ntmpls, tmpl;
    struct StructImpl *im;
    struct StructInst *ins;
    struct StructTmpl *tps;

    im = frontend::sym::ct_impls(&nimpls);
    ins = frontend::sym::ct_insts(&ninsts);
    tps = frontend::sym::ct_tmpls(&ntmpls);
    (void)ntmpls;
    if (!im || !tps) return 0;
    if (!header) {
        for (i = 0; i < ninsts; i++) {
            if (!inst_writes_helpers(self, u, i)) continue;
            if (inst_emit_elem_protos(self, i) != 0) return -1;
        }
    }
    for (ki = 0; ki < nimpls; ki++) {
        tmpl = frontend::sym::ct_tmpl_find(im[ki].tmpl);
        if (header) {
            int via_hdr;
            if (tmpl < 0 || (u >= 0 && im[ki].owner != u)) continue;
            via_hdr = tps[tmpl].is_pub && tps[tmpl].owner >= 0
                      && self->units[tps[tmpl].owner].is_hdr;
            if (!via_hdr || tps[tmpl].owner != u) continue;
            for (i = 0; i < ninsts; i++) {
                int m;
                if (!frontend::sym::ct_impl_matches(ki, i)) continue;
                /* Phase 33 O3: a foreign-element instance's methods are a
                   private copy in the consumer, so the header declares none. */
                if (inst_elem_foreign(self, i)) continue;
                for (m = self->arena->nodes[im[ki].node].a; m >= 0;
                     m = self->arena->nodes[m].next)
                    if (impl_emit_method(self, ki, i, m, 1) != 0) return -1;
            }
            continue;
        }
        for (i = 0; i < ninsts; i++) {
            if (!frontend::sym::ct_impl_matches(ki, i)) continue;
            /* Phase 33 O3: the unit that named a foreign-element instance
               writes its methods; every other instance belongs to the impl
               owner (Phase 29/31). */
            if (inst_elem_foreign(self, i)) {
                if (u >= 0 && ins[i].owner != u) continue;
            } else if (u >= 0 && im[ki].owner != u) {
                continue;
            }
            if (impl_emit_one(self, ki, i) != 0) return -1;
        }
    }
    if (!header) {
        for (i = 0; i < ninsts; i++) {
            if (!inst_writes_helpers(self, u, i)) continue;
            if (inst_emit_elem_helpers(self, i) != 0) return -1;
        }
    }
    return 0;
}

/* Phase 31 O3: the shared static type reader, reached through its singleton.
   A trait method is dispatched through a named receiver only, so the pointer is
   held in a local. */
static int hoist_ctype(int n, char *out, int cap, int *depth)
{
    struct Expr *ex;
    ex = frontend::parse::expr_get();
    return ex->static_ctype(n, out, cap, depth, 0);
}

impl EmitOps for Emitter {
    int emit_indent(int n)
    {
        int i;
        (void)self;
        for (i = 0; i < n * 4; i++) fputc(' ', self->out);
        return 0;
    }

    /* Fresh state for one statement's hoist scan. The statement's `next` is the
       following statement (not part of this expression), so it is cut off
       while the children are walked.

       Only the statement's own expression root may be hoisted: at the start of
       a statement's expression, or at the start of an assignment / declaration
       initialiser, evaluation is unconditional and ordered, so moving the
       receiver to the line before cannot change what it reads. Anywhere else
       the hoist would reorder it, so `hoist_scan` reports instead. */
    int hoist_rvalue(int n)
    {
        int saved, root;
        (void)self;
        self->nhoist = 0;
        root = (self->arena->nodes[n].kind == N_ASSIGN) ? self->arena->nodes[n].b : self->arena->nodes[n].a;
        saved = self->arena->nodes[n].next;
        self->arena->nodes[n].next = -1;
        if (self->hoist_scan(root, 1) != 0) {
            self->arena->nodes[n].next = saved;
            return -1;
        }
        self->arena->nodes[n].next = saved;
        return 0;
    }

    /* A chain like `f().a.b` as a method receiver has to be materialised: C
       will not take the address of the call result. Root calls are recorded
       and named `__ct_tmpN`. `top` marks the statement's expression root; an
       rvalue receiver found below it has no defined evaluation point to hoist
       to, so it is an error rather than a silent reordering. */
    int hoist_scan(int n, int top)
    {
        int root;
        (void)self;

        if (n < 0) return 0;
        /* Phase 30: an `into` receiver is materialised once, and its block is
           spliced in front of the statement. Do not walk `b` here -- those are
           statements, and they get their own hoists when they are emitted. */
        if (self->arena->nodes[n].kind == N_INTO) {
            if (self->ninto >= MAX_INTOS)
                return self->fail_from(n, "too many 'into' receivers in one statement");
            /* §2.8: a chained segment's receiver is the inner segment, so the
               inner promotion is recorded (and numbered) first. */
            if (self->arena->nodes[n].a >= 0
                && self->hoist_scan(self->arena->nodes[n].a, 0) != 0) return -1;
            snprintf(self->arena->nodes[n].text3, MAX_TEXT, "__ct_recv%d", self->ntmp);
            self->ntmp++;
            self->into_nodes[self->ninto] = n;
            self->ninto++;
            return 0;
        }
        /* A type-host call (aux 6) expands as a straight textual recipe: the
           receiver is substituted once and nothing takes its address, so a
           call result in an argument position compiles as written and needs
           no temporary. Only dynamic dispatch materialises its receiver. */
        if (self->arena->nodes[n].kind == N_MCALL
            && self->arena->nodes[n].aux != 6) {
            int ok = 0;
            char bt[MAX_TEXT];
            root = self->arena->nodes[n].a;
            while (root >= 0 && (self->arena->nodes[root].kind == N_MEMBER
                                 || self->arena->nodes[root].kind == N_ARROW))
                root = self->arena->nodes[root].a;
            bt[0] = 0;
            if (root >= 0 && !self->arena->nodes[root].text3[0]) {
                if (self->arena->nodes[root].kind == N_CALL) {
                    ok = self->sym->find_func(self->arena->nodes[root].text2) >= 0;
                    /* a call through a function pointer: the parser left the
                       result type on the node, so it can be named */
                    if (!ok && self->arena->nodes[root].text[0]
                        && (self->arena->nodes[n].aux == 9
                            || self->arena->nodes[n].aux == 10)) ok = 1;
                }
                /* Phase 31 O3: a chained subscript (`g[i][j]`, `b.mv()[0]`)
                   puts the inner call in receiver position; its result is an
                   rvalue, so it must be named before its address is taken.
                   aux 5/6 reuse `text3` for their own spelling and never
                   materialise. */
                if (!ok && self->arena->nodes[root].kind == N_MCALL
                    && self->arena->nodes[root].aux != 5
                    && self->arena->nodes[root].aux != 6) {
                    int rd = 0;
                    if (hoist_ctype(root, bt, sizeof bt, &rd) && rd == 0) ok = 1;
                }
            }
            if (ok) {
                if (!top)
                    return self->fail_from(n, "a method call on a temporary is only allowed at the start of a statement or of an assignment");
                if (self->nhoist >= MAX_HOISTS)
                    return self->fail_from(n, "too many hoisted receivers in one statement");
                snprintf(self->arena->nodes[root].text3, MAX_TEXT, "__ct_tmp%d", self->ntmp);
                self->ntmp++;
                self->hoist_calls[self->nhoist] = root;
                self->nhoist++;
            }
        }
        if (self->arena->nodes[n].a >= 0 && self->hoist_scan(self->arena->nodes[n].a, 0) != 0) return -1;
        if (self->arena->nodes[n].b >= 0 && self->hoist_scan(self->arena->nodes[n].b, 0) != 0) return -1;
        if (self->arena->nodes[n].c >= 0 && self->hoist_scan(self->arena->nodes[n].c, 0) != 0) return -1;
        if (self->arena->nodes[n].d >= 0 && self->hoist_scan(self->arena->nodes[n].d, 0) != 0) return -1;
        if (self->arena->nodes[n].next >= 0 && self->hoist_scan(self->arena->nodes[n].next, 0) != 0) return -1;
        return 0;
    }

    int emit_hoists(int ind)
    {
        int i, f, k, cat, s;
        char hty[MAX_TEXT];
        int hd;
        (void)self;

        for (i = 0; i < self->nhoist; i++) {
            hd = 0;
            hty[0] = 0;
            f = (self->arena->nodes[self->hoist_calls[i]].kind == N_CALL)
                    ? self->sym->find_func(self->arena->nodes[self->hoist_calls[i]].text2)
                    : -1;
            if (f >= 0) snprintf(hty, sizeof hty, "%s", self->sym->funcs[f].ret);
            else if (self->arena->nodes[self->hoist_calls[i]].kind == N_CALL
                     && self->arena->nodes[self->hoist_calls[i]].text[0])
                snprintf(hty, sizeof hty, "%s",
                         self->arena->nodes[self->hoist_calls[i]].text);
            else if (!hoist_ctype(self->hoist_calls[i], hty, sizeof hty, &hd)
                     || hd != 0)
                return self->fail_from(self->hoist_calls[i], "cannot infer the type of a hoisted receiver");
            self->emit_indent(ind);
            fprintf(self->out, "%s %s = ", hty, self->arena->nodes[self->hoist_calls[i]].text3);
            self->raw_call = self->hoist_calls[i];
            if (self->emit_expr(self->hoist_calls[i]) != 0) {
                self->raw_call = -1;
                return -1;
            }
            self->raw_call = -1;
            fputs(";\n", self->out);
        }
        /* Phase 30 §2.3: promote by value category. A pointer receiver is
           copied; a left-value value receiver is addressed in place; a
           right-value value receiver is moved into a fresh local. The block's
           statements then splice in at the same indentation. */
        for (i = 0; i < self->ninto; i++) {
            int save;
            k = self->into_nodes[i];
            cat = self->arena->nodes[k].aux;
            self->emit_indent(ind);
            if (cat == 2) {
                /* addressed in place, spelled like a user declaration */
                fprintf(self->out, "%s * %s = &(", self->arena->nodes[k].text,
                        self->arena->nodes[k].text3);
            } else {
                /* a promoted receiver is spelled exactly like a user
                   declaration (`struct AppConfig * __ct_recv0`), so E30-9 can
                   compare the two products after normalisation */
                fprintf(self->out, "%s %s = ", self->arena->nodes[k].text,
                        self->arena->nodes[k].text3);
            }
            if (self->emit_expr(self->arena->nodes[k].a) != 0) return -1;
            if (cat == 2) fputs(")", self->out);
            fputs(";\n", self->out);
            /* the spliced statements run their own hoist pass; the receiver
               list must not be re-emitted from inside the block */
            save = self->ninto;
            self->ninto = 0;
            for (s = self->arena->nodes[k].b; s >= 0; s = self->arena->nodes[s].next)
                if (self->emit_node(s, ind) != 0) return -1;
            self->ninto = save;
        }
        self->nhoist = 0;
        self->ninto = 0;
        return 0;
    }

    /* PP lines, then types/globals in source order, then prototypes, then the
       definitions. Prototypes come after the type declarations they may use. */
    int emit_program(int prog)
    {
        int n, i;
        (void)self;

        self->errmsg[0] = 0;
        self->failline = 0;
        self->cur_unit = -1;
        /* compile mode is one file: the parser's prefix is this file's */
        self->gprefix = self->sym->ns;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_PP) fprintf(self->out, "%s\n", self->arena->nodes[n].text);

        if (self->emit_struct_fwd() != 0) return -1;
        if (self->emit_trait_decls() != 0) return -1;
        if (self->emit_vtable_fwd(prog) != 0) return -1;

        /* Types first, then every prototype, then the globals: a file-scope
           initialiser may name a function of this unit (`int (*gp)(int) = plus;`)
           and C needs that declaration in scope (D-6). */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_RAW_TEXT) {
                if (emit_raw_text(self, n) != 0) return -1;
                continue;
            }
            if (self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
                || self->arena->nodes[n].kind == N_ENUM || self->arena->nodes[n].kind == N_UNION) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        /* Phase 29: compile mode is one unit, so every instance is its own. */
        if (emit_struct_insts(self, -1, 0) != 0) return -1;
        if (emit_struct_impls(self, -1, 0) != 0) return -1;

        /* Prototypes come before the impl bodies: an impl method may call a
           free function declared earlier in the unit, and C needs the prototype
           in scope at the call site. */
        for (i = 0; i < self->sym->nfunc; i++)
            if (self->emit_proto(i) != 0) return -1;
        if (self->emit_inherent_protos(prog) != 0) return -1;

        /* A file-scope `_Static_assert` lands here: after every type, so an
           assertion about a struct or enum declared above it still resolves. */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_SASSERT)
                if (self->emit_node(n, 0) != 0) return -1;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            /* an `extern` global is a declaration only: it adds no definition */
            if (self->arena->nodes[n].kind != N_GLOBAL || self->arena->nodes[n].aux == 2) continue;
            if (self->emit_type_decl(n, 0, 1) != 0) return -1;
        }

        if (self->emit_impls(prog) != 0) return -1;

        if (self->emit_maps(-1) != 0) return -1;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_FUNC) {
                int cur = self->sym->find_func(self->arena->nodes[n].text2);
                /* a generic template has no C body of its own (Phase 26) */
                if (cur >= 0 && self->sym->funcs[cur].ntparams > 0) continue;
                /* the closure products of this function land above its definition */
                if (emit_closures(self, self->arena->nodes[n].text2, self->arena->nodes[n].line) != 0)
                    return -1;
                if (self->emit_node(n, 0) != 0) return -1;
            }
        }
        if (emit_generic_defs(self, -1) != 0) return -1;
        if (self->emit_unit_init(prog) != 0) return -1;
        return 0;
    }

    /* One prototype line for `self->sym->funcs[i]`. */
    int emit_proto(int i)
    {
        int k;
        (void)self;

        /* a generic template is never a C symbol of its own (Phase 26) */
        if (self->sym->funcs[i].ntparams > 0) return 0;
        if (self->sym->funcs[i].is_static) fputs("static ", self->out);
        fprintf(self->out, "%s %s(", self->sym->funcs[i].ret, self->sym->funcs[i].cname);
        if (self->sym->funcs[i].nparams == 0) {
            fputs("void", self->out);
        } else {
            for (k = 0; k < self->sym->funcs[i].nparams; k++) {
                if (k > 0) fputs(", ", self->out);
                fputs(self->sym->funcs[i].ptype[k], self->out);
                fputs(self->sym->funcs[i].pdim[k], self->out);
            }
            if (self->sym->funcs[i].variadic) fputs(", ...", self->out);
        }
        fputs(")", self->out);
        /* a GNU attribute rides after the parameter list, where the source had it */
        if (self->sym->funcs[i].attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->sym->funcs[i].attr));
        fputs(";\n", self->out);
        return 0;
    }

    /* Tentative definitions so a global declared above an impl can already
       point at its vtable; C99 6.9.2 lets the definition below complete them. */
    int emit_vtable_fwd(int prog)
    {
        int n, si;
        const char *tname;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl: no struct row to name */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0)
                continue;   /* no vptr, no vtable */
            if (self->vtable_exported(si, tname))
                fprintf(self->out, "struct %s_vtbl %s_%s_vtable;\n",
                        tname, self->sym->structs[si].name, tname);
            else
                fprintf(self->out, "static struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                        tname, self->sym->structs[si].name, tname);
        }
        /* adoptions that need no impl: an all-default trait fills its own
           slots, so the vtable must be visible to the initialisers below */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int ui;
            const char *tname;
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                if (!adoption_default_only(self, si, tname)) continue;
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "struct %s_vtbl %s_%s_vtable;\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                            tname, self->sym->structs[si].name, tname);
            }
        }
        /* a `delete` in a function body runs before the drop definition below */
        for (si = 0; si < self->sym->nstructs; si++)
            if (self->sym->structs[si].uses_drop && !self->sym->structs[si].is_template)
                fprintf(self->out, "static void __attribute__((unused)) %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
        /* a `borrow` release runs before the handback definition below */
        for (si = 0; si < self->sym->nstructs; si++)
            if (self->sym->structs[si].has_handback_impl)
                fprintf(self->out, "static void __attribute__((unused)) %s_Handback_handback(void *self);\n",
                        self->sym->structs[si].name);
        if (self->sym->nstructs) fputs("\n", self->out);
        return 0;
    }

    /* One vtable type and one interface type per trait. */
    int emit_trait_decls(void)
    {
        (void)self;
        return self->emit_trait_range(0, self->sym->ntraits, 0);
    }

    /* A vtable field may name a struct by pointer (`void (*m)(void *, struct S *)`)
       before that struct is defined, and a tag first seen inside a parameter
       list would get prototype scope. Declare every tag up front. */
    int emit_struct_fwd(void)
    {
        int i, ti;
        (void)self;

        for (i = 0; i < self->sym->nstructs; i++) {
            if (self->sym->structs[i].is_template) continue;
            ti = self->sym->find_type(self->sym->structs[i].name);
            if (ti < 0) continue;
            if (self->sym->type_kind[ti] == 1) fprintf(self->out, "struct %s;\n", self->sym->structs[i].name);
            else if (self->sym->type_kind[ti] == 6) fprintf(self->out, "union %s;\n", self->sym->structs[i].name);
        }
        return 0;
    }

    /* `mode`: 0 = every trait, 1 = exported only, 2 = private only. */
    int emit_trait_range(int start, int end, int mode)
    {
        int t, m, k;
        (void)self;

        for (t = start; t < end; t++) {
            if (self->sym->traits[t].is_static || self->sym->traits[t].ntparams > 0) continue;
            if (mode == 1 && !self->sym->traits[t].is_pub) continue;
            if (mode == 2 && self->sym->traits[t].is_pub) continue;
            fprintf(self->out, "struct %s_vtbl {\n", self->sym->traits[t].name);
            for (m = 0; m < self->sym->traits[t].nm; m++) {
                fprintf(self->out, "    %s (*%s)(void *", self->sym->traits[t].m[m].ret,
                        self->sym->traits[t].m[m].name);
                for (k = 0; k < self->sym->traits[t].m[m].nparams; k++)
                    fprintf(self->out, ", %s", self->sym->traits[t].m[m].ptype[k]);
                fputs(");\n", self->out);
            }
            fputs("};\n", self->out);
            fprintf(self->out, "struct %s_iface {\n    void *self;\n    struct %s_vtbl *vt;\n};\n\n",
                    self->sym->traits[t].name, self->sym->traits[t].name);
        }
        return 0;
    }

    /* File-scope arrays cannot carry per-element writes in an initialiser, so
       they go into the per-unit constructor (the same shape as D5=A in the old
       pipeline). Emitted only when such an array exists. */
    int emit_unit_init(int prog)
    {
        int n, any;
        (void)self;

        any = 0;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_GLOBAL && self->init->type_needs_init(self->arena->nodes[n].text)
                && (self->arena->nodes[n].text3[0]
                    || self->ty->type_has_array_init(self->arena->nodes[n].text))) any = 1;
        if (!any) return 0;
        fputs("static void __ct_init(void) __attribute__((constructor));\n", self->out);
        fputs("static void __ct_init(void) {\n", self->out);
        fputs("    unsigned long __ct_i;\n", self->out);
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            char cnt[MAX_TEXT];
            char recv[MAX_TEXT];
            int i, k;
            if (self->arena->nodes[n].kind != N_GLOBAL) continue;
            if (!self->init->type_needs_init(self->arena->nodes[n].text)) continue;
            if (!self->arena->nodes[n].text3[0]) {
                /* a scalar object whose struct has array fields */
                if (self->ty->type_has_array_init(self->arena->nodes[n].text)
                    && self->init->emit_vptr_stmts(self->arena->nodes[n].text2, self->arena->nodes[n].text, 2) != 0)
                    return -1;
                continue;
            }
            /* the count is the first bracket group of the suffix */
            k = 0;
            for (i = 1; self->arena->nodes[n].text3[i] && self->arena->nodes[n].text3[i] != ']' && k + 1 < MAX_TEXT; i++) {
                cnt[k] = self->arena->nodes[n].text3[i];
                k++;
            }
            cnt[k] = 0;
            snprintf(recv, sizeof recv, "%s[__ct_i]", self->arena->nodes[n].text2);
            fprintf(self->out, "    for (__ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
            if (self->init->emit_vptr_stmts(recv, self->arena->nodes[n].text, 2) != 0) return -1;
            fputs("    }\n", self->out);
        }
        fputs("}\n\n", self->out);
        return 0;
    }

    /* Write a captured `{ … }` initialiser for `type`, adding the vptr items a
       trait-carrying struct needs. `assign` writes the declaration's leading
       ` = `; a compound literal calls it with 0, since the braces follow the
       `(type)` directly. */
    int emit_raw_init(int raw, const char *type, int assign)
    {
        const char *t;
        const char *base;
        int len, i, only_space, si;
        (void)self;

        /* A captured initialiser may be longer than `text` holds; the parser
           then keeps it in the arena string pool and sets `aux = 1` with the
           offset in `num`. An `N_RAW` naming a macro or a function keeps its
           spelling in `text` as before. */
        t = self->arena->nodes[raw].aux
                ? self->arena->str_at((int)self->arena->nodes[raw].num)
                : self->arena->nodes[raw].text;
        len = (int)strlen(t);
        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->sym->find_struct(base);
        if (assign) fputs(" = ", self->out);
        if (len < 2 || t[len - 1] != '}') {
            fputs(t, self->out);
            return 0;
        }
        only_space = 1;
        for (i = 1; i < len - 1; i++)
            if (t[i] != ' ' && t[i] != '\t' && t[i] != '\n' && t[i] != '\r') only_space = 0;
        if (only_space) {
            fputs("{ ", self->out);
            if (self->init->type_has_vptr(type)) {
                if (self->init->emit_vptr_items("", type) != 0) return -1;
            }
            if (si >= 0 && self->init->emit_field_vptrs(si, self->init->type_has_vptr(type), 0) != 0) return -1;
            fputs(" }", self->out);
            return 0;
        }
        fwrite(t, 1, (size_t)(len - 1), self->out);
        if (self->init->type_has_vptr(type)) {
            fputs(", ", self->out);
            if (self->init->emit_vptr_items("", type) != 0) return -1;
        }
        /* the captured text already has members, so a nested item needs its comma */
        if (si >= 0 && self->init->emit_field_vptrs(si, 1, t) != 0) return -1;
        fputs("}", self->out);
        return 0;
    }

    /* Phase 24: `int a[] = 0..n($ * 2 + 1)` as ` = { <elem>, <elem>, … }`.
       The node keeps one element subtree, and every element re-emits it with
       `range_k` set to the current index, so `$` prints as `((int)<k>)` and the
       node count stays independent of how many elements the range has. Streaming
       the list also keeps it out of the rewritten-initialiser text pool.

       Phase 29 P29-1: a `Vec<T>` target carries the element's C type and the
       instance name, so the same list becomes a composite literal handed to the
       built-in constructor: `Vec_int_from((int[4]){ … }, 4)`. The compiler knows
       only the entry's name and the type argument, never `Vec`'s fields. */
    int emit_range_init(int n)
    {
        long k, start;
        int count, save_k, save_depth;
        const char *elem, *iname;
        (void)self;

        start = self->arena->nodes[n].num;
        count = self->arena->nodes[n].aux;
        elem = self->arena->nodes[n].text;
        iname = self->arena->nodes[n].text2;
        if (iname[0])
            fprintf(self->out, " = %s_from((%s[%d]){ ", iname, elem, count);
        else
            fputs(" = { ", self->out);
        save_k = self->range_k;
        save_depth = self->range_depth;
        for (k = start; k < start + count; k++) {
            if (k != start) fputs(", ", self->out);
            self->range_k = (int)k;
            self->range_depth = save_depth + 1;
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        }
        self->range_k = save_k;
        self->range_depth = save_depth;
        if (iname[0]) fprintf(self->out, " }, %d)", count);
        else fputs(" }", self->out);
        return 0;
    }

    /* Phase 31 S11a: a `Vec<T>` brace initializer. The node carries the element
       type, the instance name and the element expressions chained through
       `next` (`aux` is the count), so the list streams exactly like the range
       form and the node count follows the source. An empty list hands the
       constructor `(0, 0)`: `Vec_<enc>_from` answers an empty handle, a shape
       the range form can never spell (`stop <= start` is refused). */
    int emit_brace_init(int n)
    {
        int e, count;
        const char *elem, *iname;
        (void)self;

        elem = self->arena->nodes[n].text;
        iname = self->arena->nodes[n].text2;
        count = self->arena->nodes[n].aux;
        if (count <= 0) {
            fprintf(self->out, " = %s_from(0, 0)", iname);
            return 0;
        }
        fprintf(self->out, " = %s_from((%s[%d]){ ", iname, elem, count);
        for (e = self->arena->nodes[n].a; e >= 0; e = self->arena->nodes[e].next) {
            if (e != self->arena->nodes[n].a) fputs(", ", self->out);
            if (self->emit_expr(e) != 0) return -1;
        }
        fprintf(self->out, " }, %d)", count);
        return 0;
    }

    /* Phase 31 S14b: a `Map` brace initializer. The node names the `MapEntry`
       struct and the `Map` instance; each item node carries its key in `a` and
       its value in `b`, chained through `next`. The list is streamed as one
       composite literal, and an empty list hands the constructor `(0, 0)` so the
       empty map still owns a releasable header. */
    int emit_map_brace_init(int n)
    {
        int it, count;
        const char *entry, *iname;
        (void)self;

        entry = self->arena->nodes[n].text;
        iname = self->arena->nodes[n].text2;
        count = self->arena->nodes[n].aux;
        if (count <= 0) {
            fprintf(self->out, " = %s_from(0, 0)", iname);
            return 0;
        }
        fprintf(self->out, " = %s_from((%s[%d]){ ", iname, entry, count);
        for (it = self->arena->nodes[n].a; it >= 0; it = self->arena->nodes[it].next) {
            if (it != self->arena->nodes[n].a) fputs(", ", self->out);
            fputc('{', self->out);
            if (self->emit_expr(self->arena->nodes[it].a) != 0) return -1;
            fputs(", ", self->out);
            if (self->emit_expr(self->arena->nodes[it].b) != 0) return -1;
            fputc('}', self->out);
        }
        fprintf(self->out, " }, %d)", count);
        return 0;
    }

    /* Impl methods and their vtables, emitted before the ordinary functions so
       `main` can already dispatch through them. */
    int emit_impls(int prog)
    {
        int n, m, k, u, body, dm;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, ti;
            const char *tname;
            const char *sname;
            const char *mret;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* template impls are written by emit_struct_impls */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            ti = -1;
            for (k = 0; k < self->sym->ntraits; k++)
                if (strcmp(self->sym->traits[k].name, tname) == 0) ti = k;
            if (ti < 0 && strcmp(tname, "Drop") != 0 && strcmp(tname, "Handback") != 0)
                return self->fail_from(n, "impl of an unknown trait");
            sname = self->arena->nodes[n].text;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                char owner[MAX_TEXT];
                mret = self->arena->nodes[m].text3[0] ? self->arena->nodes[m].text3 : self->arena->nodes[m].text;
                /* the parser keys an impl closure by `<Struct>_<Trait>_<method>`,
                   the same spelling the definition below takes */
                snprintf(owner, sizeof owner, "%s_%s_%s", self->sym->structs[si].name, tname,
                         self->arena->nodes[m].text2);
                if (emit_closures(self, owner, self->arena->nodes[m].line) != 0) return -1;
                self->nclvar = 0;
                self->closure_ci = 0;
                fprintf(self->out, "static %s ", mret);
                /* A drop that nothing deletes is dead code; marking it keeps the
                   output clean under -Wall without changing what is emitted. The
                   attribute goes before the declarator: clang rejects the
                   trailing position on a definition (-Wgcc-compat). */
                if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0)
                    fputs("__attribute__((unused)) ", self->out);
                fprintf(self->out, "%s_%s_%s(void *self",
                        self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                k = self->arena->nodes[m].a;
                while (k > 0) {
                    fputs(", ", self->out);
                    if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                                  self->arena->nodes[k].text2,
                                                  self->arena->nodes[k].text3) != 0) return -1;
                    k = self->arena->nodes[k].next;
                }
                fputs(") {\n", self->out);
                fprintf(self->out, "    %s *_self = (%s *)self;\n", sname, sname);
                self->sym->self_mode = 1;
                /* The trait fixes the signature, so an implementation may ignore
                   a parameter. The cast to void has to lead the body: a trailing
                   one would sit after the `return` and be dead code. */
                body = self->arena->nodes[m].b;
                for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next)
                    if (!self->node_mentions(body, self->arena->nodes[k].text2))
                        fprintf(self->out, "    (void)%s;\n", self->arena->nodes[k].text2);
                if (!self->node_mentions(body, "self")) fputs("    (void)_self;\n", self->out);
                k = self->arena->nodes[body].a;
                while (k >= 0) {
                    if (self->emit_node(k, 1) != 0) {
                        self->sym->self_mode = 0;
                        return -1;
                    }
                    k = self->arena->nodes[k].next;
                }
                self->sym->self_mode = 0;
                fputs("}\n\n", self->out);
            }
            /* A trait method the impl does not write inherits its default body
               (override priority: the impl's version wins, D-4). */
            if (ti >= 0)
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++) {
                    if (self->sym->traits[ti].m[dm].body < 0) continue;
                    if (impl_writes(self->arena, n, self->sym->traits[ti].m[dm].name)) continue;
                    if (emit_default_method(self, si, sname, ti, dm, n) != 0) return -1;
                }
            if (strcmp(tname, "Drop") != 0 && strcmp(tname, "Handback") != 0) {
                /* a trait nothing dispatches leaves the table unreferenced; an
                   exported one is reachable from the consumer unit instead */
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "struct %s_vtbl %s_%s_vtable = {\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static struct %s_vtbl %s_%s_vtable __attribute__((unused)) = {\n",
                            tname, self->sym->structs[si].name, tname);
                u = 0;
                for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                    if (u > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s_%s_%s", self->arena->nodes[m].text2,
                            self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                    u++;
                }
                /* inherited defaults fill the remaining slots */
                if (ti >= 0)
                    for (dm = 0; dm < self->sym->traits[ti].nm; dm++) {
                        if (self->sym->traits[ti].m[dm].body < 0) continue;
                        if (impl_writes(self->arena, n, self->sym->traits[ti].m[dm].name)) continue;
                        if (u > 0) fputs(",\n", self->out);
                        fprintf(self->out, "    .%s = %s_%s_%s", self->sym->traits[ti].m[dm].name,
                                self->sym->structs[si].name, tname, self->sym->traits[ti].m[dm].name);
                        u++;
                    }
                fputs("\n};\n\n", self->out);
            }
        }
        /* P34 S5a: non-generic inherent impl `impl Name { … }` (S4). The block
           has no trait and no vtable; its methods are plain C functions named
           `<Struct>_<method>`. Instance methods take `void *self` and cast it
           to the struct pointer; static methods take no receiver. The body's
           `self.field` (N_MEMBER) is rewritten to `_self->field` by the
           self_mode-aware member emitter below. */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si;
            const char *sname;
            const char *mret;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            if (self->arena->nodes[n].text2[0]) continue;   /* trait impl: above */
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* template impl: emit_struct_impls */
            sname = self->arena->nodes[n].text;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                char owner[MAX_TEXT];
                int is_static;
                mret = self->arena->nodes[m].text[0] ? self->arena->nodes[m].text : "void";
                is_static = self->arena->nodes[m].c;
                snprintf(owner, sizeof owner, "%s_%s", self->sym->structs[si].name,
                         self->arena->nodes[m].text2);
                if (emit_closures(self, owner, self->arena->nodes[m].line) != 0) return -1;
                self->nclvar = 0;
                self->closure_ci = 0;
                /* P34 S5b: a `pub` struct publishes its methods, so they carry
                   external linkage for importers; a private one stays static. */
                if (!self->decl_is_pub(N_STRUCT, self->sym->structs[si].name))
                    fputs("static __attribute__((unused)) ", self->out);
                fprintf(self->out, "%s %s_%s(", mret, self->sym->structs[si].name,
                        self->arena->nodes[m].text2);
                if (!is_static)
                    fprintf(self->out, "struct %s *self", self->sym->structs[si].name);
                k = self->arena->nodes[m].a;
                while (k > 0) {
                    if (!is_static || k != self->arena->nodes[m].a) fputs(", ", self->out);
                    if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                                  self->arena->nodes[k].text2,
                                                  self->arena->nodes[k].text3) != 0) return -1;
                    k = self->arena->nodes[k].next;
                }
                fputs(") {\n", self->out);
                if (!is_static)
                    fprintf(self->out, "    %s *_self = (%s *)self;\n", sname, sname);
                self->sym->self_mode = is_static ? 0 : 1;
                body = self->arena->nodes[m].b;
                for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next)
                    if (!self->node_mentions(body, self->arena->nodes[k].text2))
                        fprintf(self->out, "    (void)%s;\n", self->arena->nodes[k].text2);
                if (!is_static && !self->node_mentions(body, "self")) fputs("    (void)_self;\n", self->out);
                k = self->arena->nodes[body].a;
                while (k >= 0) {
                    if (self->emit_node(k, 1) != 0) {
                        self->sym->self_mode = 0;
                        return -1;
                    }
                    k = self->arena->nodes[k].next;
                }
                self->sym->self_mode = 0;
                fputs("}\n\n", self->out);
            }
        }
        /* D-3: a struct that only `use`s an all-default trait needs no `impl`.
           The slot bodies are expanded here, once per struct, and the `use`
           clause is the sole adoption. A trait with an abstract method in this
           position is still SH-8 (`trait method 'x' is not implemented`). */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, ti, ui, type_index;
            const char *tname;
            char stype[MAX_TEXT];
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                ti = self->sym->find_trait(tname);
                if (ti < 0) continue;
                if (impl_exists_anywhere(self->arena, si, tname)) continue;
                if (self->sym->traits[ti].nm == 0) continue;
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++)
                    if (self->sym->traits[ti].m[dm].body < 0) {
                        char emsg[MAX_TEXT];
                        snprintf(emsg, sizeof emsg,
                                 "trait method '%s' is not implemented for struct '%s'",
                                 self->sym->traits[ti].m[dm].name, self->sym->structs[si].name);
                        return self->fail_from(n, emsg);
                    }
                type_index = self->sym->find_type(self->sym->structs[si].name);
                if (type_index >= 0 && self->sym->type_kind[type_index] == 1)
                    snprintf(stype, sizeof stype, "struct %s", self->sym->structs[si].name);
                else
                    snprintf(stype, sizeof stype, "%s", self->sym->structs[si].name);
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++)
                    if (emit_default_method(self, si, stype, ti, dm, n) != 0) return -1;
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "struct %s_vtbl %s_%s_vtable = {\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static struct %s_vtbl %s_%s_vtable __attribute__((unused)) = {\n",
                            tname, self->sym->structs[si].name, tname);
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++) {
                    if (dm > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s_%s_%s", self->sym->traits[ti].m[dm].name,
                            self->sym->structs[si].name, tname, self->sym->traits[ti].m[dm].name);
                }
                fputs("\n};\n\n", self->out);
            }
        }
        /* A struct that `use Drop` but writes no impl gets a drop that recurses
           into its Drop-using value fields, the same shape L2 generates. */
        {
        int si;
        for (si = 0; si < self->sym->nstructs; si++) {
            int has = 0, fi, used = 0;
            if (!self->sym->structs[si].uses_drop) continue;
            /* P36 S2a2: a template row (`struct Box<T>`) has no concrete C type,
               so no glue is emitted for it; instances carry the flag instead. */
            if (self->sym->structs[si].is_template) continue;
            has = self->sym->structs[si].has_drop_impl;
            if (!has)
                for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
                    if (self->arena->nodes[n].kind == N_IMPL && self->arena->nodes[n].aux == si
                        && strcmp(self->arena->nodes[n].text2, "Drop") == 0) has = 1;
            if (has) continue;
            fprintf(self->out, "static void __attribute__((unused)) %s_Drop_drop(void *self) {\n",
                    self->sym->structs[si].name);
            fprintf(self->out, "    struct %s *_self = (struct %s *)self;\n",
                    self->sym->structs[si].name, self->sym->structs[si].name);
            for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
                char base[MAX_TEXT];
                const char *ft = self->sym->structs[si].fields[fi].type;
                size_t bl;
                int ci;
                if (strncmp(ft, "struct ", 7) == 0) ft += 7;
                snprintf(base, sizeof base, "%s", ft);
                bl = strlen(base);
                while (bl > 0 && (base[bl - 1] == '*' || base[bl - 1] == ' ')) {
                    bl = bl - 1;
                    base[bl] = 0;
                }
                ci = self->sym->find_struct(base);
                if (ci >= 0 && self->sym->structs[ci].uses_drop) {
                    fprintf(self->out, "    %s_Drop_drop(&_self->%s);\n",
                            self->sym->structs[ci].name, self->sym->structs[si].fields[fi].name);
                    used = 1;
                }
            }
            if (!used) fputs("    (void)_self;\n", self->out);
            fputs("}\n\n", self->out);
        }
        }
        return 0;
    }

    /* The instance-level wrappers and vtable of every `map` (Phase 11.1). Emitted
       after the prototypes so a bound call may name any top-level function.
       `u` is the unit being emitted in build mode (only its own maps belong in
       its `.c`); `-1` emits every map, which is what compile mode wants. */
    int emit_maps(int u)
    {
        int i, j, k;
        (void)self;

        for (i = 0; i < (*self->nmaps); i++) {
            if (u >= 0 && self->maps[i].unit != u) continue;
            if (self->maps[i].is_static) continue;
            for (j = 0; j < self->maps[i].nb; j++) {
                struct MapBind *b;
                struct MethodSig *sig;
                b = &self->maps[i].b[j];
                sig = &self->sym->traits[b->ti].m[b->mi];
                /* a direct binding fills the slot with the C function itself */
                if (b->direct) continue;
                fprintf(self->out, "static %s %s(void *self", sig->ret, b->wrapper);
                for (k = 0; k < b->nparams; k++) {
                    fputs(", ", self->out);
                    if (self->emit_type_name(sig->ptype[k], b->params[k]) != 0) return -1;
                }
                fputs(") {\n", self->out);
                fputs("    (void)self;\n", self->out);
                if (strcmp(sig->ret, "void") != 0)
                    fprintf(self->out, "    return %s;\n", b->call);
                else
                    fprintf(self->out, "    %s;\n", b->call);
                fputs("}\n", self->out);
            }
            if (self->maps[i].nb > 0) {
                /* an instance nothing boxes leaves its table unreferenced; a
                   mapped `pub` global is reachable from every importing unit */
                if (self->map_vtable_exported(i))
                    fprintf(self->out, "struct %s_vtbl %s = {\n",
                            self->maps[i].trait, self->maps[i].vtable);
                else
                    fprintf(self->out, "static struct %s_vtbl %s __attribute__((unused)) = {\n",
                            self->maps[i].trait, self->maps[i].vtable);
                for (j = 0; j < self->maps[i].nb; j++) {
                    if (j > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s", self->maps[i].b[j].method,
                            self->maps[i].b[j].direct
                                ? self->maps[i].b[j].call
                                : self->maps[i].b[j].wrapper);
                }
                fputs("\n};\n\n", self->out);
            }
        }
        return 0;
    }

    /* One row of a record body. An anonymous member (`aux == 2`) prints its own
       `struct {` / `union {`, the inner fields one level deeper and its closing
       brace; the caller adds the `;\n`, so the row still reads as one member. */
    int emit_field(int n, int ind)
    {
        int c;
        (void)self;

        /* `size_t a, b;` or `int *a, b;`: the first declarator's spelling (stars
           included) is the wrapper's `text`, and each later one prints its own
           stars before its name */
        if (self->arena->nodes[n].kind == N_FIELDS) {
            int first = 1;
            fputs(self->arena->nodes[n].text, self->out);
            for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next) {
                fputs(first ? " " : ", ", self->out);
                if (!first) {
                    /* a later declarator carries its own stars (`int a, *b;`) */
                    const char *tp = self->arena->nodes[c].text;
                    size_t tl = strlen(tp);
                    while (tl > 0 && (tp[tl - 1] == '*' || tp[tl - 1] == ' ')) {
                        if (tp[tl - 1] == '*') fputc('*', self->out);
                        tl--;
                    }
                }
                first = 0;
                fputs(self->arena->nodes[c].text2, self->out);
                if (self->arena->nodes[c].text3[0]) fputs(self->arena->nodes[c].text3, self->out);
                if (self->arena->nodes[c].aux == 1) {
                    fputs(" : ", self->out);
                    if (self->emit_expr(self->arena->nodes[c].a) != 0) return -1;
                }
                /* the attribute follows the width for a bit-field, else the dims */
                if (self->arena->nodes[c].attr >= 0)
                    fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[c].attr));
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_FIELD && self->arena->nodes[n].aux == 2) {
            fprintf(self->out, "%s {\n", self->arena->nodes[n].text);
            for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next) {
                self->emit_indent(ind + 1);
                if (self->emit_field(c, ind + 1) != 0) return -1;
                fputs(";\n", self->out);
            }
            self->emit_indent(ind);
            fputs("}", self->out);
            return 0;
        }
        return self->emit_inline(n);
    }

    /* Top-level declarations: struct / typedef / global (with a semicolon as
       appropriate). */
    int emit_type_decl(int n, int ind, int with_semi)
    {
        int m;
        (void)self;

        if (self->arena->nodes[n].kind == N_STRUCT) {
            int si, u;
            /* Phase 29: a template emits nothing; its instances have their own
               rows and their own writer (`emit_struct_insts`). */
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0 && self->sym->structs[si].is_template) return 0;
            /* Phase 29: a field of an instance type needs that instance's
               definition first (`struct Bag { Vec<int> items; }`). */
            for (u = self->arena->nodes[n].a; u >= 0; u = self->arena->nodes[u].next) {
                if (self->arena->nodes[u].kind == N_FIELD) {
                    if (preemit_insts_for(self, self->arena->nodes[u].text) != 0) return -1;
                }
            }
            if (self->arena->nodes[n].aux) {
                /* `typedef struct Tag { ... } Name;` keeps the tag so a
                   `struct Tag` reference (or self-reference) stays valid */
                if (self->arena->nodes[n].text[0]) {
                    fprintf(self->out, "typedef struct %s {\n", self->arena->nodes[n].text);
                } else {
                    fputs("typedef struct {\n", self->out);
                }
            } else {
                fprintf(self->out, "struct %s {\n", self->arena->nodes[n].text2);
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                self->emit_indent(ind + 1);
                if (self->emit_field(m, ind + 1) != 0) return -1;
                fputs(";\n", self->out);
            }
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (u = 0; u < self->sym->structs[si].nuse; u++) {
                    char low[MAX_TEXT];
                    int i;
                    for (i = 0; self->sym->structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                        char c = self->sym->structs[si].use[u][i];
                        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                        low[i] = c;
                    }
                    low[i] = 0;
                    self->emit_indent(ind + 1);
                    fprintf(self->out, "struct %s_vtbl *__%s_vptr;\n",
                            self->sym->structs[si].use[u], low);
                }
            }
            self->emit_indent(ind);
            fputs("}", self->out);
            /* `struct S { … } __attribute__((packed));` — a typedef form puts it
               between the body and the alias, the one position clang and GCC
               both honour for `packed` / `aligned` on the type */
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
            if (self->arena->nodes[n].aux) fprintf(self->out, " %s", self->arena->nodes[n].text2);
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_UNION) {
            /* no `use` clause, so no vptr fields; `text` is the tag of a
               `typedef union Tag { … } Alias;` and `text2` the emitted name */
            if (self->arena->nodes[n].aux) {
                if (self->arena->nodes[n].text[0]) {
                    fprintf(self->out, "typedef union %s {\n", self->arena->nodes[n].text);
                } else {
                    fputs("typedef union {\n", self->out);
                }
            } else {
                fprintf(self->out, "union %s {\n", self->arena->nodes[n].text2);
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                self->emit_indent(ind + 1);
                if (self->emit_field(m, ind + 1) != 0) return -1;
                fputs(";\n", self->out);
            }
            self->emit_indent(ind);
            fputs("}", self->out);
            /* `struct S { … } __attribute__((packed));` — a typedef form puts it
               between the body and the alias, the one position clang and GCC
               both honour for `packed` / `aligned` on the type */
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
            if (self->arena->nodes[n].aux) fprintf(self->out, " %s", self->arena->nodes[n].text2);
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ENUM) {
            /* `text2` is the name the type is known by (`text3` the tag of a
               `typedef enum Tag { … } Alias;`, empty when it had none) */
            if (self->arena->nodes[n].aux) {
                if (self->arena->nodes[n].text3[0]) {
                    fprintf(self->out, "typedef enum %s {\n", self->arena->nodes[n].text3);
                } else {
                    fputs("typedef enum {\n", self->out);
                }
            } else {
                fprintf(self->out, "enum %s {\n", self->arena->nodes[n].text2);
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                self->emit_indent(ind + 1);
                fputs(self->arena->nodes[m].text, self->out);
                /* an explicit value keeps the source expression; no value
                   means "one more than the previous", which C computes */
                if (self->arena->nodes[m].a >= 0) {
                    fputs(" = ", self->out);
                    if (self->emit_expr(self->arena->nodes[m].a) != 0) return -1;
                }
                if (self->arena->nodes[m].next >= 0) fputs(",", self->out);
                fputs("\n", self->out);
            }
            self->emit_indent(ind);
            fputs("}", self->out);
            /* `struct S { … } __attribute__((packed));` — a typedef form puts it
               between the body and the alias, the one position clang and GCC
               both honour for `packed` / `aligned` on the type */
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
            if (self->arena->nodes[n].aux) fprintf(self->out, " %s", self->arena->nodes[n].text2);
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_TYPEDEF) {
            fputs("typedef ", self->out);
            if (self->emit_type_name_dims(self->arena->nodes[n].text, self->arena->nodes[n].text2,
                                          self->arena->nodes[n].text3) != 0) return -1;
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_GLOBAL) {
            self->emit_indent(ind);
            if (self->arena->nodes[n].aux == 1) fputs("static ", self->out);
            if (self->emit_global_decl(n) != 0) return -1;
            if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_RANGE) {
                if (self->emit_range_init(self->arena->nodes[n].a) != 0) return -1;
            } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW) {
                if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text, 1) != 0) return -1;
            } else if (self->arena->nodes[n].a >= 0) {
                fputs(" = ", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            } else if (self->init->type_needs_init(self->arena->nodes[n].text) && !self->arena->nodes[n].text3[0]) {
                /* an array gets per-element writes (local) or a constructor
                   (file scope); a designator on the array itself is invalid */
                fputs(" = { ", self->out);
                if (self->init->emit_vptr_items("", self->arena->nodes[n].text) != 0) return -1;
                if (self->init->emit_field_vptrs(self->sym->find_struct(
                        strncmp(self->arena->nodes[n].text, "struct ", 7) == 0
                            ? self->arena->nodes[n].text + 7 : self->arena->nodes[n].text),
                        self->init->type_has_vptr(self->arena->nodes[n].text), 0) != 0) return -1;
                fputs(" }", self->out);
            }
            if (with_semi) fputs(";\n", self->out);
            return 0;
        }
        return self->fail_from(n, "unknown declaration node");
    }

    /* The header's view of a global: a declaration, never the definition and
       never the initialiser. A `pub` global is defined in its unit's `.c`; an
       `extern` global is defined by the C library the source includes. */
    int emit_global_extern(int n)
    {
        (void)self;

        fputs("extern ", self->out);
        if (self->emit_global_decl(n) != 0) return -1;
        fputs(";\n", self->out);
        return 0;
    }

    /* `<type> <name>[dims]` for a file-scope variable. A namespaced global is
       spelled with the unit's mangled prefix (the same rule `pub` functions
       follow); `extern` keeps the C library's own name. The declarator may also
       be a function pointer, so the name goes through `emit_type_name`. */
    int emit_global_decl(int n)
    {
        char cn[MAX_TEXT];
        const char *nm = self->arena->nodes[n].text2;
        (void)self;

        if (self->arena->nodes[n].aux != 2 && self->gprefix && self->gprefix[0]) {
            if (snprintf(cn, sizeof cn, "%s%s", self->gprefix, nm) >= (int)sizeof cn)
                return self->fail("variable name is too long");
        } else {
            snprintf(cn, sizeof cn, "%s", nm);
        }
        if (self->emit_type_name_dims(self->arena->nodes[n].text, cn,
                                      self->arena->nodes[n].text3) != 0) return -1;
        if (self->arena->nodes[n].attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
        return 0;
    }

    /* A declaration is exported when its node carries `pub`. The arena holds
       every unit's nodes, so the declaring unit need not be the current one --
       a header unit usually is not the implementing unit. */
    int decl_is_pub(int kind, const char *name)
    {
        int n;
        (void)self;

        for (n = 0; n < self->arena->nnode; n++)
            if (self->arena->nodes[n].kind == kind && self->arena->nodes[n].d == 1
                && strcmp(self->arena->nodes[n].text2, name) == 0) return 1;
        return 0;
    }

    /* Linkage rule (D-2): export only when both halves of the pair are public.
       A private struct cannot even be named by a consumer, so its vtable stays
       static and encapsulated. `Drop` never has a vtable. */
    int vtable_exported(int si, const char *tname)
    {
        int t;
        (void)self;

        if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0) return 0;
        t = self->sym->find_trait(tname);
        if (t < 0 || !self->sym->traits[t].is_pub) return 0;
        return self->decl_is_pub(N_STRUCT, self->sym->structs[si].name);
    }

    int map_vtable_exported(int i)
    {
        int t;
        (void)self;

        t = self->sym->find_trait(self->maps[i].trait);
        if (t < 0 || !self->sym->traits[t].is_pub) return 0;
        /* a namespace host has no object to be private: `pub trait` is the
           whole contract (SH-20) */
        if (self->maps[i].ns_host) return 1;
        return self->decl_is_pub(N_GLOBAL, self->maps[i].inst);
    }

    /* The header's half of the external-linkage contract: the consumer unit
       boxes with `&S_T_vtable`, so the implementation unit declares it here.
       `u < 0` is compile mode, which writes no header. */
    int emit_link_externs(int prog, int u)
    {
        int n, i, si, any;
        const char *tname;
        (void)self;

        any = 0;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl exports no struct vtable */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            if (!self->vtable_exported(si, tname)) continue;
            fprintf(self->out, "extern struct %s_vtbl %s_%s_vtable;\n",
                    tname, self->sym->structs[si].name, tname);
            any = 1;
        }
        /* an all-default adoption exports its vtable under the same rule */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int ui;
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                if (!adoption_default_only(self, si, tname)) continue;
                if (!self->vtable_exported(si, tname)) continue;
                fprintf(self->out, "extern struct %s_vtbl %s_%s_vtable;\n",
                        tname, self->sym->structs[si].name, tname);
                any = 1;
            }
        }
        if (u >= 0)
            for (i = 0; i < (*self->nmaps); i++) {
                if (self->maps[i].unit != u) continue;
                if (self->maps[i].is_static) continue;
                if (!self->map_vtable_exported(i)) continue;
                fprintf(self->out, "extern struct %s_vtbl %s;\n",
                        self->maps[i].trait, self->maps[i].vtable);
                any = 1;
            }
        if (any) fputs("\n", self->out);
        return 0;
    }

    /* P34 S5b: one prototype per inherent method of a `pub` struct. A consumer
       unit may not carry the owner's impl node, so the header exports these
       declarations and every importer links `<Struct>_<method>` by symbol. The
       receiver is spelled `struct <Struct> *` -- the same pointer the definition
       binds `self` to. Private structs keep their methods `static` and get no
       prototype here. */
    int emit_inherent_protos(int prog)
    {
        int n, m, k, si, is_static;

        (void)self;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            if (self->arena->nodes[n].text2[0]) continue;   /* trait impl */
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* template impl */
            if (!self->decl_is_pub(N_STRUCT, self->sym->structs[si].name)) continue;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                is_static = self->arena->nodes[m].c;
                fprintf(self->out, "%s %s_%s(",
                        self->arena->nodes[m].text[0] ? self->arena->nodes[m].text : "void",
                        self->sym->structs[si].name, self->arena->nodes[m].text2);
                if (!is_static) fprintf(self->out, "struct %s *", self->sym->structs[si].name);
                for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next) {
                    if (!is_static || k != self->arena->nodes[m].a) fputs(", ", self->out);
                    if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                                  self->arena->nodes[k].text2,
                                                  self->arena->nodes[k].text3) != 0) return -1;
                }
                fputs(");\n", self->out);
            }
        }
        return 0;
    }

    /* Does this subtree name `name` as a variable? An impl parameter is a
       variable too, so the same walk decides the `(void)` casts. Field names
       are stored in `text2` as well but keep their own node kind, so only N_VAR
       matches; the child slots of a body node are all node indexes. */
    int node_mentions(int n, const char *name)
    {
        (void)self;

        for (; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_VAR && strcmp(self->arena->nodes[n].text2, name) == 0)
                return 1;
            if (self->node_mentions(self->arena->nodes[n].a, name)) return 1;
            if (self->node_mentions(self->arena->nodes[n].b, name)) return 1;
            if (self->node_mentions(self->arena->nodes[n].c, name)) return 1;
            if (self->node_mentions(self->arena->nodes[n].d, name)) return 1;
        }
        return 0;
    }

    int emit_node(int n, int ind)
    {
        int c;
        (void)self;

        if (self->arena->nodes[n].kind == N_FUNC) {
            char rbuf[160];
            const char *rname;
            /* a new body starts with no closure variable bound (Phase 21 S3) */
            self->nclvar = 0;
            self->closure_ci = 0;
            if (self->arena->nodes[n].aux) fputs("static ", self->out);
            /* `num` carries the `inline` specifier (0 = plain function) */
            if (self->arena->nodes[n].num) fputs("inline ", self->out);
            /* Phase 26: an active instance substitutes the return type and
               writes its own C name instead of the template's. */
            rname = self->arena->nodes[n].text;
            if (emit_gsub_type(self, rname, rbuf, sizeof rbuf) == 0) rname = rbuf;
            fprintf(self->out, "%s %s(", rname,
                    self->gtname[0] ? self->gtname : self->arena->nodes[n].text2);
            c = self->arena->nodes[n].a;
            if (c == 0) {
                fputs("void) ", self->out);
            } else {
                int first;
                first = 1;
                while (c > 0) {
                    if (!first) fputs(", ", self->out);
                    if (self->emit_type_name_dims(self->arena->nodes[c].text,
                                                  self->arena->nodes[c].text2,
                                                  self->arena->nodes[c].text3) != 0) return -1;
                    if (self->arena->nodes[c].attr >= 0)
                        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[c].attr));
                    first = 0;
                    c = self->arena->nodes[c].next;
                }
                if (self->arena->nodes[n].c) fputs(", ...", self->out);
                fputs(") ", self->out);
            }
            /* a GNU attribute rides between the parameter list and the body */
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, "%s ", self->arena->str_at(self->arena->nodes[n].attr));
            return self->emit_node(self->arena->nodes[n].b, ind);
        }
        if (self->arena->nodes[n].kind == N_BLOCK) {
            int save_nclvar;
            save_nclvar = self->nclvar;   /* a closure bound here dies with the block */
            fputs("{\n", self->out);
            for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            self->nclvar = save_nclvar;
            self->emit_indent(ind);
            fputs("}\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_RET) {
            char tmp[MAX_TEXT];
            int r, rtv;
            rtv = -1;
            if (self->hoist_rvalue(n) != 0) return -1;
            if (self->emit_hoists(ind) != 0) return -1;
            /* SH-45: the expression reads a value the releases below would
               free, so materialise it first and return the temporary */
            if (self->arena->nodes[n].aux == 1 && self->arena->nodes[n].a >= 0
                && self->arena->nodes[n].text[0]) {
                rtv = self->ntmp;
                self->ntmp++;
                self->emit_indent(ind);
                snprintf(tmp, sizeof tmp, "%s __ct_ret%d = ", self->arena->nodes[n].text, rtv);
                fputs(tmp, self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(";\n", self->out);
            }
            /* the parser hangs the scope's releases off `b`; they run at the
               return's own indentation, before the value leaves (SH-33) */
            for (r = self->arena->nodes[n].b; r >= 0; r = self->arena->nodes[r].next)
                if (self->emit_node(r, ind) != 0) return -1;
            self->emit_indent(ind);
            if (self->arena->nodes[n].a < 0) {
                fputs("return;\n", self->out);
                return 0;
            }
            if (rtv >= 0) {
                snprintf(tmp, sizeof tmp, "return __ct_ret%d;\n", rtv);
                fputs(tmp, self->out);
                return 0;
            }
            fputs("return ", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DELETE) {
            int si;
            int e0, asg;
            si = -1;
            e0 = self->arena->nodes[n].a;
            /* The nulling below is only C when the argument is assignable:
               `delete get();` is a legal call, but `get() = 0` is not (SH-40).
               The five kinds are the assignment targets parse_stmt accepts. */
            asg = e0 >= 0 && (self->arena->nodes[e0].kind == N_VAR
                              || self->arena->nodes[e0].kind == N_MEMBER
                              || self->arena->nodes[e0].kind == N_ARROW
                              || self->arena->nodes[e0].kind == N_INDEX
                              || self->arena->nodes[e0].kind == N_DEREF);
            if (self->arena->nodes[n].text[0]) si = self->sym->find_struct(self->arena->nodes[n].text);
            /* a `borrow` release hands the object back to its pool: the
               memory is not ours to free, and an unresolvable type must fail
               rather than fall back to `free` (design 5) */
            if (self->arena->nodes[n].aux == 1) {
                if (si < 0)
                    return self->fail_from(n, "cannot resolve the borrowed type");
                self->emit_indent(ind);
                fputs("if (", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ") { %s_Handback_handback(", self->sym->structs[si].name);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs("); ", self->out);
                if (asg) {
                    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                    fputs(" = 0; ", self->out);
                }
                fputs("}\n", self->out);
                return 0;
            }
            self->emit_indent(ind);
            if (si >= 0 && self->sym->structs[si].uses_drop) {
                /* a Drop struct runs its drop before the memory goes away */
                fputs("if (", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ") { %s_Drop_drop(", self->sym->structs[si].name);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs("); free(", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                /* null the pointer: L2's shape (README / language-spec list it),
                   and the second release on another path is then a no-op */
                fputs("); ", self->out);
                if (asg) {
                    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                    fputs(" = 0; ", self->out);
                }
                fputs("}\n", self->out);
                return 0;
            }
            fputs("if (", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(") { free(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs("); ", self->out);
            if (asg) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(" = 0; ", self->out);
            }
            fputs("}\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_BREAK) {
            int r;
            /* the releases `retire_before_jump` hung off `b` run before the
               jump leaves the loop (same shape as `return`, SH-33) */
            for (r = self->arena->nodes[n].b; r >= 0; r = self->arena->nodes[r].next)
                if (self->emit_node(r, ind) != 0) return -1;
            self->emit_indent(ind);
            fputs("break;\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CONT) {
            int r;
            for (r = self->arena->nodes[n].b; r >= 0; r = self->arena->nodes[r].next)
                if (self->emit_node(r, ind) != 0) return -1;
            self->emit_indent(ind);
            fputs("continue;\n", self->out);
            return 0;
        }
        /* `;` prints nothing at all: the surrounding block (or the `if` body
           `parse_branch` wrapped it in) already carries the braces */
        if (self->arena->nodes[n].kind == N_EMPTY) return 0;
        if (self->arena->nodes[n].kind == N_SASSERT) {
            self->emit_indent(ind);
            fputs("_Static_assert(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            if (self->arena->nodes[n].text[0])
                fprintf(self->out, ", %s", self->arena->nodes[n].text);
            fputs(");\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_GOTO) {
            self->emit_indent(ind);
            fprintf(self->out, "goto %s;\n", self->arena->nodes[n].text2);
            return 0;
        }
        /* A label owns its statements, so it prints the name and then walks the
           chain one level deeper (the same shape a `case` label uses). */
        if (self->arena->nodes[n].kind == N_LABEL) {
            self->emit_indent(ind);
            fprintf(self->out, "%s:\n", self->arena->nodes[n].text2);
            for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DECLS) {
            int c = self->arena->nodes[n].a;
            while (c >= 0) {
                self->emit_indent(ind);
                if (self->emit_inline(c) != 0) return -1;
                fputs(";\n", self->out);
                c = self->arena->nodes[c].next;
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DECL) {
            const char *tp = self->arena->nodes[n].text;
            size_t tl = strlen(tp);
            int heap_ptr = 0;

            /* `T *p = malloc(..)` writes its vptrs on the next line */
            if (tl > 0 && tp[tl - 1] == '*' && self->arena->nodes[n].a >= 0
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_CALL
                && (strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "malloc") == 0
                    || strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "calloc") == 0))
                heap_ptr = 1;

            if (self->arena->nodes[n].text3[0] && self->arena->nodes[n].a < 0 && self->init->type_needs_init(tp)) {
                /* a local array of trait-carrying values: one loop writes every
                   element's vptr (`Type name[n];` has no initialiser to extend) */
                char cnt[MAX_TEXT];
                char recv[MAX_TEXT];
                size_t ci;
                int k = 0;
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", self->out);
                for (ci = 1; self->arena->nodes[n].text3[ci] && self->arena->nodes[n].text3[ci] != ']'
                           && k + 1 < MAX_TEXT; ci++) {
                    cnt[k] = self->arena->nodes[n].text3[ci];
                    k++;
                }
                cnt[k] = 0;
                snprintf(recv, sizeof recv, "%s[__ct_i]", self->arena->nodes[n].text2);
                self->emit_indent(ind);
                fprintf(self->out, "for (unsigned long __ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
                if (self->init->emit_vptr_stmts(recv, tp, ind + 1) != 0) return -1;
                self->emit_indent(ind);
                fputs("}\n", self->out);
                return 0;
            }
            if (!self->arena->nodes[n].text3[0] && self->init->type_needs_init(tp)
                && (self->arena->nodes[n].a < 0
                    || self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW)
                && self->ty->type_has_array_init(tp)) {
                /* a struct-typed array field cannot be reached by a designator,
                   so its elements get their vptrs on the lines after */
                const char *base = tp;
                int si;
                if (strncmp(base, "struct ", 7) == 0) base += 7;
                si = self->sym->find_struct(base);
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", self->out);
                return self->init->emit_array_field_vptrs(si, self->arena->nodes[n].text2, ind);
            }
            if (heap_ptr) {
                char recv[MAX_TEXT];
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", self->out);
                snprintf(recv, sizeof recv, "(*%s)", self->arena->nodes[n].text2);
                return self->init->emit_vptr_stmts(recv, tp, ind);
            }
        }
        if (self->arena->nodes[n].kind == N_DECL || self->arena->nodes[n].kind == N_ASSIGN
            || self->arena->nodes[n].kind == N_EXPR || self->arena->nodes[n].kind == N_POST
            || (self->arena->nodes[n].kind == N_BIN && self->arena->nodes[n].aux == B_COMMA)) {
            if (self->hoist_rvalue(n) != 0) return -1;
            if (self->emit_hoists(ind) != 0) return -1;
            /* a bare `expr into { … };` statement is the block alone: the
               receiver expression has already been evaluated exactly once */
            if (self->arena->nodes[n].kind == N_EXPR
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_INTO)
                return 0;
            self->emit_indent(ind);
            if (self->emit_inline(n) != 0) return -1;
            fputs(";\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_IF) {
            self->emit_indent(ind);
            fputs("if (", self->out);
            if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
            fputs(") ", self->out);
            if (self->emit_node(self->arena->nodes[n].b, ind) != 0) return -1;
            if (self->arena->nodes[n].c >= 0) {
                self->emit_indent(ind);
                fputs("else ", self->out);
                if (self->emit_node(self->arena->nodes[n].c, ind) != 0) return -1;
            }
            return 0;
        }
        if (self->arena->nodes[n].kind == N_WHILE) {
            self->emit_indent(ind);
            fputs("while (", self->out);
            if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
            fputs(") ", self->out);
            return self->emit_node(self->arena->nodes[n].b, ind);
        }
        if (self->arena->nodes[n].kind == N_FOR) {
            int init = self->arena->nodes[n].a;
            /* C only allows `register` or no storage class in a for's first
               declaration (C99 6.8.5.3), so `for (static int i = 0; ...)` is a
               GNU extension that gcc rejects under -std=c99. Emit the
               declaration in a block of its own: the initialiser still runs
               once, the name keeps the same scope, and the loop is plain C. */
            if (init >= 0 && self->arena->nodes[init].kind == N_DECL
                && self->arena->nodes[init].aux) {
                int q;
                self->emit_indent(ind);
                fputs("{\n", self->out);
                for (q = init; q >= 0; q = self->arena->nodes[q].next)
                    if (self->emit_node(q, ind + 1) != 0) return -1;
                self->emit_indent(ind + 1);
                fputs("for (; ", self->out);
                if (self->arena->nodes[n].b >= 0
                    && self->emit_cond(self->arena->nodes[n].b) != 0) return -1;
                fputs("; ", self->out);
                if (self->arena->nodes[n].c >= 0
                    && self->emit_inline(self->arena->nodes[n].c) != 0) return -1;
                fputs(") ", self->out);
                if (self->emit_node(self->arena->nodes[n].d, ind + 1) != 0) return -1;
                self->emit_indent(ind);
                fputs("}\n", self->out);
                return 0;
            }
            self->emit_indent(ind);
            fputs("for (", self->out);
            if (self->arena->nodes[n].a >= 0 && self->emit_inline(self->arena->nodes[n].a) != 0) return -1;
            fputs("; ", self->out);
            if (self->arena->nodes[n].b >= 0 && self->emit_cond(self->arena->nodes[n].b) != 0) return -1;
            fputs("; ", self->out);
            if (self->arena->nodes[n].c >= 0 && self->emit_inline(self->arena->nodes[n].c) != 0) return -1;
            fputs(") ", self->out);
            return self->emit_node(self->arena->nodes[n].d, ind);
        }
        /* `loop(<count>) { … }` and `loop(<start>..<stop>) { … }` print as a
           single-line `for` header:
             for (int i = 0, __ct_loop_n_K = (<count>); i < __ct_loop_n_K; i++)
             for (int __ct_loop_n_K, __ct_loop_hi_K,
                      i = ((__ct_loop_n_K = (<start>)), (__ct_loop_hi_K = (<stop>)), __ct_loop_n_K);
                  i < __ct_loop_hi_K; i++)
           The counted form evaluates its bound once, before the first test. The
           range form evaluates each bound exactly once, lower first: both
           assignments are operands of one comma expression -- `i`'s single
           initializer -- and the comma operator sequences them left to right
           (C99 §6.5.17), so the order does not depend on the unspecified
           evaluation order of declarator initializers (§6.7.8). The two
           declarators stay uninitialised on purpose: an `= 0` there would race
           with the assignments inside `i`'s initializer. `i` is an ordinary
           `int`, so break/continue/return and the `i--`/`++i` forms behave
           exactly as in the desugared source. `K` is a monotonic per-emitter
           counter, so nested loops get distinct names without a pre-scan; the
           range form derives both names from the same `K`, so it consumes no
           extra temporary and `loop(0..n)` (folded at parse time) still prints
           the counted form byte for byte. */
        if (self->arena->nodes[n].kind == N_LOOP) {
            int k;
            k = self->ntmp;
            self->ntmp++;
            self->emit_indent(ind);
            if (self->arena->nodes[n].b == -1) {
                fprintf(self->out, "for (int i = 0, __ct_loop_n_%d = (", k);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, "); i < __ct_loop_n_%d; i++) ", k);
            } else {
                fprintf(self->out,
                        "for (int __ct_loop_n_%d, __ct_loop_hi_%d, i = ((__ct_loop_n_%d = (",
                        k, k, k);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ")), (__ct_loop_hi_%d = (", k);
                if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
                fprintf(self->out, ")), __ct_loop_n_%d); i < __ct_loop_hi_%d; i++) ", k, k);
            }
            return self->emit_node(self->arena->nodes[n].d, ind);
        }
        /* Phase 27: `foreach` expands to one plain `for`. The length is
           `sizeof(x) / sizeof((x)[0])`, read once into `__ct_foreach_n_K`
           (D27-9/D27-7), so a VLA's length is snapshotted before the first
           iteration and a normal array folds to a constant. `item` is a plain
           by-value copy (D27-5); `break` / `continue` / `return` inside the body
           are ordinary C jumps, and the per-emitter `K` keeps nested loops
           distinct (D27-8). The outer block keeps both temporaries out of the
           user's scope. */
        if (self->arena->nodes[n].kind == N_FOREACH) {
            int k;
            int faux;
            const char *fname;
            faux = self->arena->nodes[n].aux;
            fname = self->arena->nodes[n].text2;
            k = self->ntmp;
            self->ntmp++;
            self->emit_indent(ind);
            fputs("{\n", self->out);
            if (faux == 1 || faux == 2) {
                /* Phase 29 (D29-13): a built-in container snapshots its length
                   once and reads each element through the inherent `get` /
                   `entry`, so modifying the container in the body cannot run
                   the loop past the snapshot. */
                self->emit_indent(ind + 1);
                fprintf(self->out, "struct %s *__ct_foreach_c_%d = &(", fname, k);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(");\n", self->out);
                self->emit_indent(ind + 1);
                fprintf(self->out, "int __ct_foreach_n_%d = %s_len(__ct_foreach_c_%d);\n",
                        k, fname, k);
            } else {
                self->emit_indent(ind + 1);
                fprintf(self->out, "int __ct_foreach_n_%d = (int)(sizeof(", k);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(") / sizeof((", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(")[0]));\n", self->out);
            }
            self->emit_indent(ind + 1);
            fprintf(self->out,
                    "for (int __ct_foreach_i_%d = 0; __ct_foreach_i_%d < __ct_foreach_n_%d; __ct_foreach_i_%d++) {\n",
                    k, k, k, k);
            /* An array and a `Vec` also bind the read-only index (D29-14); a
               `Map` body has none, and the parser already refused any use. */
            if (faux != 2) {
                self->emit_indent(ind + 2);
                fprintf(self->out, "int i = __ct_foreach_i_%d;\n", k);
            }
            self->emit_indent(ind + 2);
            if (faux == 1)
                fprintf(self->out,
                        "%s item = %s_get(__ct_foreach_c_%d, __ct_foreach_i_%d);\n",
                        self->arena->nodes[n].text, fname, k, k);
            else if (faux == 2)
                fprintf(self->out,
                        "%s item = %s_entry(__ct_foreach_c_%d, __ct_foreach_i_%d);\n",
                        self->arena->nodes[n].text, fname, k, k);
            else {
                fprintf(self->out, "%s item = (", self->arena->nodes[n].text);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ")[__ct_foreach_i_%d];\n", k);
            }
            /* `item` and `i` may go unused (`foreach (xs) { puts("x"); }`, or a
               binding hidden by a nested one). A plain `(void)x;` keeps the
               generated C `-Wall -Wextra` clean without a GCC-only attribute. */
            self->emit_indent(ind + 2);
            fputs("(void)item;\n", self->out);
            if (faux != 2) {
                self->emit_indent(ind + 2);
                fputs("(void)i;\n", self->out);
            }
            for (c = self->arena->nodes[self->arena->nodes[n].d].a; c >= 0;
                 c = self->arena->nodes[c].next)
                if (self->emit_node(c, ind + 2) != 0) return -1;
            self->emit_indent(ind + 1);
            fputs("}\n", self->out);
            self->emit_indent(ind);
            fputs("}\n", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_SWITCH) {
            self->emit_indent(ind);
            fputs("switch (", self->out);
            if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
            fputs(") ", self->out);
            return self->emit_node(self->arena->nodes[n].b, ind);
        }
        if (self->arena->nodes[n].kind == N_CASE) {
            int c;
            self->emit_indent(ind);
            if (self->arena->nodes[n].aux) {
                fputs("default:", self->out);
            } else {
                /* the label is whatever the constant expression printed: a
                   literal, an enum member's C name, or a folded-by-C form.
                   `c >= 0` makes it a range (`case 1 ... 5:`). */
                fputs("case ", self->out);
                if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
                if (self->arena->nodes[n].c >= 0) {
                    fputs(" ... ", self->out);
                    if (self->emit_expr(self->arena->nodes[n].c) != 0) return -1;
                }
                fputs(":", self->out);
            }
            fputs("\n", self->out);
            for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DOWHILE) {
            int b, c;
            self->emit_indent(ind);
            fputs("do {\n", self->out);
            /* `parse_branch` wraps even a single statement in an N_BLOCK, so
               the body always walks here instead of going through
               `emit_node`, which would put the closing brace on its own line */
            b = self->arena->nodes[n].b;
            for (c = self->arena->nodes[b].a; c >= 0; c = self->arena->nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            self->emit_indent(ind);
            fputs("} while (", self->out);
            if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
            fputs(");\n", self->out);
            return 0;
        }
        {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "unknown statement node (kind %d)", self->arena->nodes[n].kind);
            return self->fail(msg);
        }
    }

    /* `<type> <name>`, except that a function-pointer type keeps its
       declarator around the name: `int (*)(void *)` + `cb` becomes
       `int (*cb)(void *)` (D-7). The dimensions of a function-pointer array sit
       inside the same declarator (`int (*tbl[2])(int)`), so they are part of
       the name here rather than a suffix; without a `(*)` they trail the name
       exactly as `fputs(text3)` did before (D-5). */
    int emit_type_name_dims(const char *type, const char *name, const char *dims)
    {
        const char *star;
        char tbuf[160];
        (void)self;

        if (emit_gsub_type(self, type, tbuf, sizeof tbuf) == 0) {
            type = tbuf;
        } else if (strchr(type, '<')) {
            /* An instance spelling that reached the emitter without a template
               substitution (a field of a monomorphised struct, say). */
            char ibuf[160];
            if (frontend::sym::ct_inst_resolve(type, ibuf, sizeof ibuf) == 0) type = ibuf;
        }
        star = strstr(type, "(*)");
        if (!star) {
            fprintf(self->out, "%s %s%s", type, name, dims);
            return 0;
        }
        fprintf(self->out, "%.*s(*%s%s)%s", (int)(star - type), type, name, dims, star + 3);
        return 0;
    }

    int emit_type_name(const char *type, const char *name)
    {
        return self->emit_type_name_dims(type, name, "");
    }

    int emit_inline(int n)
    {
        (void)self;

        if (self->arena->nodes[n].kind == N_DECLS) {
            /* a `for` initialiser: one shared type, then bare declarators */
            int c = self->arena->nodes[n].a, first = 1;
            while (c >= 0) {
                if (first) {
                    if (self->emit_inline(c) != 0) return -1;
                } else {
                    fputs(", ", self->out);
                    fputs(self->arena->nodes[c].text2, self->out);
                    if (self->arena->nodes[c].text3[0]) fputs(self->arena->nodes[c].text3, self->out);
                    if (self->arena->nodes[c].a >= 0) {
                        if (self->arena->nodes[self->arena->nodes[c].a].kind == N_INIT_RANGE) {
                            if (self->emit_range_init(self->arena->nodes[c].a) != 0) return -1;
                        } else if (self->arena->nodes[self->arena->nodes[c].a].kind == N_INIT_BRACE) {
                            if (self->emit_brace_init(self->arena->nodes[c].a) != 0) return -1;
                        } else if (self->arena->nodes[self->arena->nodes[c].a].kind == N_INIT_MBRACE) {
                            if (self->emit_map_brace_init(self->arena->nodes[c].a) != 0) return -1;
                        } else if (self->arena->nodes[self->arena->nodes[c].a].kind == N_RAW) {
                            if (self->emit_raw_init(self->arena->nodes[c].a, self->arena->nodes[c].text, 1) != 0) return -1;
                        } else {
                            fputs(" = ", self->out);
                            if (self->emit_expr(self->arena->nodes[c].a) != 0) return -1;
                        }
                    }
                }
                first = 0;
                c = self->arena->nodes[c].next;
            }
            return 0;
        }
        /* A bit-field keeps its width in `a` (`aux` marks the form); the width
           is an expression so `(1 << 2)` and macro names print as written. */
        if (self->arena->nodes[n].kind == N_FIELD && self->arena->nodes[n].aux == 1) {
            fputs(self->arena->nodes[n].text, self->out);
            if (self->arena->nodes[n].text2[0]) fprintf(self->out, " %s", self->arena->nodes[n].text2);
            fputs(" : ", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DECL || self->arena->nodes[n].kind == N_FIELD) {
            /* A closure binding declares no C variable: only its environment's
               stack instance is written, and the name is recorded so a later
               call expands to the trampoline (Phase 21 S3). */
            if (self->arena->nodes[n].kind == N_DECL && self->arena->nodes[n].a >= 0
                && self->arena->nodes[self->arena->nodes[n].a].kind == N_CLOSURE)
                return emit_closure_decl(self, n);
            /* `aux == 1` marks a function-local with static storage duration */
            if (self->arena->nodes[n].kind == N_DECL && self->arena->nodes[n].aux == 1)
                fputs("static ", self->out);
            if (self->emit_type_name_dims(self->arena->nodes[n].text, self->arena->nodes[n].text2,
                                          self->arena->nodes[n].text3) != 0) return -1;
            if (self->arena->nodes[n].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
            if (self->arena->nodes[n].kind == N_DECL) {
                if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_RANGE) {
                    if (self->emit_range_init(self->arena->nodes[n].a) != 0) return -1;
                } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_BRACE) {
                    if (self->emit_brace_init(self->arena->nodes[n].a) != 0) return -1;
                } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_MBRACE) {
                    if (self->emit_map_brace_init(self->arena->nodes[n].a) != 0) return -1;
                } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW) {
                    if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text, 1) != 0) return -1;
                } else if (self->arena->nodes[n].a >= 0) {
                    fputs(" = ", self->out);
                    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                } else if (self->init->type_needs_init(self->arena->nodes[n].text) && !self->arena->nodes[n].text3[0]) {
                    fputs(" = { ", self->out);
                    if (self->init->emit_vptr_items("", self->arena->nodes[n].text) != 0) return -1;
                    if (self->init->emit_field_vptrs(self->sym->find_struct(
                            strncmp(self->arena->nodes[n].text, "struct ", 7) == 0
                                ? self->arena->nodes[n].text + 7 : self->arena->nodes[n].text),
                            self->init->type_has_vptr(self->arena->nodes[n].text), 0) != 0) return -1;
                    fputs(" }", self->out);
                }
                /* `aux == 2`: an auto-dropped declaration whose name is shadowed
                   where some release runs. The private alias addresses the object
                   from the shadowing scope (see `autodrop_append`). */
                if (self->arena->nodes[n].aux == 2)
                    fprintf(self->out, ", *__ct_own_%d = %s", n, self->arena->nodes[n].text2);
            }
            return 0;
        }
        /* A comma list (`a, b`): each operand is itself a statement-shaped node
           (an assignment, a postfix form or an `N_EXPR`), so the same writer
           prints it. The parentheses keep the precedence right wherever the
           list lands -- a `for` init / step clause. */
        if (self->arena->nodes[n].kind == N_BIN && self->arena->nodes[n].aux == B_COMMA) {
            fputs("(", self->out);
            if (self->emit_inline(self->arena->nodes[n].a) != 0) return -1;
            fputs(", ", self->out);
            if (self->emit_inline(self->arena->nodes[n].b) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ASSIGN) {
            const char *aop = " = ";
            if (self->arena->nodes[n].aux == 1) aop = " += ";
            else if (self->arena->nodes[n].aux == 2) aop = " -= ";
            else if (self->arena->nodes[n].aux == 3) aop = " *= ";
            else if (self->arena->nodes[n].aux == 4) aop = " /= ";
            else if (self->arena->nodes[n].aux == 5) aop = " %= ";
            else if (self->arena->nodes[n].aux == 6) aop = " &= ";
            else if (self->arena->nodes[n].aux == 7) aop = " |= ";
            else if (self->arena->nodes[n].aux == 8) aop = " ^= ";
            else if (self->arena->nodes[n].aux == 9) aop = " <<= ";
            else if (self->arena->nodes[n].aux == 10) aop = " >>= ";
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(aop, self->out);
            return self->emit_expr(self->arena->nodes[n].b);
        }
        if (self->arena->nodes[n].kind == N_EXPR) return self->emit_expr(self->arena->nodes[n].a);
        if (self->arena->nodes[n].kind == N_POST) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
            return 0;
        }
        return self->fail_from(n, "cannot inline this node");
    }

    int emit_cond(int n)
    {
        const char *op;
        (void)self;

        if (self->arena->nodes[n].kind == N_BIN && self->arena->nodes[n].aux >= B_LT && self->arena->nodes[n].aux <= B_NE) {
            op = "<";
            if (self->arena->nodes[n].aux == B_GT) op = ">";
            else if (self->arena->nodes[n].aux == B_LE) op = "<=";
            else if (self->arena->nodes[n].aux == B_GE) op = ">=";
            else if (self->arena->nodes[n].aux == B_EQ) op = "==";
            else if (self->arena->nodes[n].aux == B_NE) op = "!=";
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, " %s ", op);
            return self->emit_expr(self->arena->nodes[n].b);
        }
        return self->emit_expr(n);
    }

    int emit_expr(int n)
    {
        int c;
        const char *op;
        (void)self;

        if (self->arena->nodes[n].kind == N_NUM) {
            /* `text` holds the normalized integer suffix (`U`, `UL`, `LL`, …) */
            fprintf(self->out, "%ld%s", self->arena->nodes[n].num, self->arena->nodes[n].text);
            return 0;
        }
        /* a floating literal is emitted with its spelling (`1.5`, `2.25f`, `1e9`) */
        if (self->arena->nodes[n].kind == N_FNUM) {
            fputs(self->arena->nodes[n].text, self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_STR) {
            fputs(self->arena->str_at(self->arena->nodes[n].num), self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_RAW) {
            /* a pooled initialiser (`aux = 1`) or a bare spelling in `text` */
            fputs(self->arena->nodes[n].aux
                      ? self->arena->str_at((int)self->arena->nodes[n].num)
                      : self->arena->nodes[n].text, self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_VAR) {
            int ci, k;
            /* Phase 24: `$` is the index of the element being written. The cast
               is deliberate -- `((int)k)` keeps a `char` or an unsigned element
               printing exactly like a hand-written `(int)k` would. */
            if (self->range_depth > 0 && strcmp(self->arena->nodes[n].text2, "$") == 0) {
                fprintf(self->out, "((int)%d)", self->range_k);
                return 0;
            }
            /* inside a trampoline body a captured name is a field of the
               environment (Phase 21 S3) */
            ci = self->closure_ci;
            if (ci > 0) {
                struct Closure *cc = &self->sym->closures[ci - 1];
                for (k = 0; k < cc->ncap; k++)
                    if (strcmp(cc->cap_name[k], self->arena->nodes[n].text2) == 0) {
                        fprintf(self->out, "__ct_cl_e->%s", self->arena->nodes[n].text2);
                        return 0;
                    }
            }
            if (self->sym->self_mode && strcmp(self->arena->nodes[n].text2, "self") == 0) {
                fputs("_self", self->out);
            } else if (self->arena->nodes[n].text3[0]) {
                /* a namespaced global: `text3` carries the mangled C spelling */
                fputs(self->arena->nodes[n].text3, self->out);
            } else {
                fputs(self->arena->nodes[n].text2, self->out);
            }
            return 0;
        }
        /* Phase 30: the promoted receiver, or the receiver itself in `$` /
           `.name` position. For a left-value value receiver `__ct_recvN` is a
           pointer, so the value form dereferences it while the member form
           keeps the pointer. */
        if (self->arena->nodes[n].kind == N_INTO) {
            if (!self->arena->nodes[n].text3[0])
                return self->fail_from(n, "an 'into' receiver was not promoted");
            if (self->arena->nodes[n].aux == 2)
                fprintf(self->out, "(*%s)", self->arena->nodes[n].text3);
            else
                fputs(self->arena->nodes[n].text3, self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_INTO_SELF) {
            int owner = self->arena->nodes[n].num;
            const char *nm;
            if (owner < 0 || !self->arena->nodes[owner].text3[0])
                return self->fail_from(n, "an 'into' receiver was not promoted");
            nm = self->arena->nodes[owner].text3;
            if (self->arena->nodes[n].aux == 1)
                fputs(nm, self->out);
            else if (self->arena->nodes[owner].aux == 2)
                fprintf(self->out, "(*%s)", nm);
            else
                fputs(nm, self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_MEMBER) {
            int a = self->arena->nodes[n].a;
            /* P34 S5a: inside an inherent impl method `self` is a struct value
               in the source but a pointer (`_self`) in the emitted C, so the
               first member access on `self` spells `->`; deeper links keep `.`. */
            int self_arrow = self->sym->self_mode && a >= 0
                             && self->arena->nodes[a].kind == N_VAR
                             && strcmp(self->arena->nodes[a].text2, "self") == 0;
            if (self->emit_expr(a) != 0) return -1;
            fprintf(self->out, "%s%s", self_arrow ? "->" : ".",
                    self->arena->nodes[n].text2);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ARROW) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, "->%s", self->arena->nodes[n].text2);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_INDEX) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs("[", self->out);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs("]", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_ADDR) {
            fputs("(&", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_DEREF) {
            fputs("(*", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CAST) {
            char tbuf[160];
            const char *ct = self->arena->nodes[n].text;
            if (emit_gsub_type(self, ct, tbuf, sizeof tbuf) == 0) ct = tbuf;
            fprintf(self->out, "(%s)(", ct);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_COMPOUND) {
            /* `(type){ … }`: the braces go through the same writer a declaration
               uses, so a trait-carrying struct gets its vptr items here too */
            fprintf(self->out, "(%s)", self->arena->nodes[n].text);
            return self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text, 0);
        }
        if (self->arena->nodes[n].kind == N_VAARG) {
            char tbuf[160];
            const char *vt = self->arena->nodes[n].text;
            /* Phase 26 fix (SH-62): `va_arg(ap, T)` is a fifth type position;
               it had the same silent `T` leak as `sizeof(T)`. */
            if (emit_gsub_type(self, vt, tbuf, sizeof tbuf) == 0) vt = tbuf;
            fputs("va_arg(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ", %s)", vt);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_SIZEOF) {
            /* `aux` 1 is `sizeof(type)`, 2 is `_Alignof(type)`, 4 is
               `alignof(type)` (stdalign.h); 3 is `alignof(expr)`, 0 is
               `sizeof(expr)` */
            if (self->arena->nodes[n].aux && self->arena->nodes[n].a < 0) {
                static const char *const kw[5] = {"sizeof", "sizeof", "_Alignof",
                                                  "alignof", "alignof"};
                char tbuf[160];
                const char *st = self->arena->nodes[n].text;
                int a = self->arena->nodes[n].aux;
                if (emit_gsub_type(self, st, tbuf, sizeof tbuf) == 0) st = tbuf;
                fprintf(self->out, "%s(%s)", kw[a < 0 || a > 4 ? 1 : a], st);
                return 0;
            }
            fputs(self->arena->nodes[n].aux == 3 ? "alignof(" : "sizeof(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_OFFSETOF) {
            /* the source carried the call, so the generated `.c` keeps it; the
               source unit supplies `#include <stddef.h>` (D-8) */
            char tbuf[160];
            const char *ot = self->arena->nodes[n].text;
            if (emit_gsub_type(self, ot, tbuf, sizeof tbuf) == 0) ot = tbuf;
            fprintf(self->out, "offsetof(%s, %s)", ot, self->arena->nodes[n].text2);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_POST) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
            return 0;
        }
        /* prefix form: the operator comes first, the operand follows */
        if (self->arena->nodes[n].kind == N_PRE) {
            fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
            return self->emit_expr(self->arena->nodes[n].a);
        }
        if (self->arena->nodes[n].kind == N_TERN) {
            fputs("(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(" ? ", self->out);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs(" : ", self->out);
            if (self->emit_expr(self->arena->nodes[n].c) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        /* An assignment used as a value (`(c = f())`, `(a = b = 0)`): the
           parentheses come from here, because the node no longer sits where a
           statement would put it. A top-level assignment is printed by
           `emit_inline` instead. */
        if (self->arena->nodes[n].kind == N_ASSIGN) {
            const char *aop = " = ";
            if (self->arena->nodes[n].aux == 1) aop = " += ";
            else if (self->arena->nodes[n].aux == 2) aop = " -= ";
            else if (self->arena->nodes[n].aux == 3) aop = " *= ";
            else if (self->arena->nodes[n].aux == 4) aop = " /= ";
            else if (self->arena->nodes[n].aux == 5) aop = " %= ";
            else if (self->arena->nodes[n].aux == 6) aop = " &= ";
            else if (self->arena->nodes[n].aux == 7) aop = " |= ";
            else if (self->arena->nodes[n].aux == 8) aop = " ^= ";
            else if (self->arena->nodes[n].aux == 9) aop = " <<= ";
            else if (self->arena->nodes[n].aux == 10) aop = " >>= ";
            fputs("(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(aop, self->out);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        /* A comma list in a value position (`x = (a, b);`): both operands
           evaluate in order and the value is the last one, which is exactly what
           C's `,` does, so the spelling is kept. Its operands are ordinary
           expressions here; the statement form's operands go through
           `emit_inline` instead. */
        if (self->arena->nodes[n].kind == N_BIN && self->arena->nodes[n].aux == B_COMMA) {
            fputs("(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(", ", self->out);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_BIN) {
            op = "+";
            if (self->arena->nodes[n].aux == B_SUB) op = "-";
            else if (self->arena->nodes[n].aux == B_MUL) op = "*";
            else if (self->arena->nodes[n].aux == B_DIV) op = "/";
            else if (self->arena->nodes[n].aux == B_MOD) op = "%";
            else if (self->arena->nodes[n].aux == B_LT) op = "<";
            else if (self->arena->nodes[n].aux == B_GT) op = ">";
            else if (self->arena->nodes[n].aux == B_LE) op = "<=";
            else if (self->arena->nodes[n].aux == B_GE) op = ">=";
            else if (self->arena->nodes[n].aux == B_EQ) op = "==";
            else if (self->arena->nodes[n].aux == B_NE) op = "!=";
            else if (self->arena->nodes[n].aux == B_AND) op = "&&";
            else if (self->arena->nodes[n].aux == B_OR) op = "||";
            else if (self->arena->nodes[n].aux == B_XOR) op = "^";
            else if (self->arena->nodes[n].aux == B_BAND) op = "&";
            else if (self->arena->nodes[n].aux == B_BOR) op = "|";
            else if (self->arena->nodes[n].aux == B_SHL) op = "<<";
            else if (self->arena->nodes[n].aux == B_SHR) op = ">>";
            fputs("(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, " %s ", op);
            if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_UNARY) {
            if (self->arena->nodes[n].aux == U_NEG) fputs("(-", self->out);
            else if (self->arena->nodes[n].aux == U_BNOT) fputs("(~", self->out);
            else fputs("(!", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_BOX) {
            /* aux: bit 0 = the source operand is a pointer, bit 1 = take the
               address of the literal (a pointer-to-interface target),
               bit 2 = a namespace host (SH-20): no operand, self is NULL,
               bit 3 = the value reached an interface context (see maybe_box) */
            int a = self->arena->nodes[n].aux;
            if (a & 4) {
                int i, found, bar;
                char dmsg[512];
                if (!(a & 8))
                    return self->fail_from(n, "a namespace host value is only usable as an interface value");
                found = 0;
                for (i = 0; i < (*self->nmaps); i++)
                    if (self->maps[i].ns_host
                        && strcmp(self->maps[i].trait, self->arena->nodes[n].text) == 0
                        && strcmp(self->maps[i].prefix, self->arena->nodes[n].text2) == 0) {
                        found = 1;
                        break;
                    }
                if (!found) {
                    bar = -1;
                    for (i = 0; self->arena->nodes[n].text3[i]; i++)
                        if (self->arena->nodes[n].text3[i] == '|') { bar = i; break; }
                    if (bar >= 0)
                        snprintf(dmsg, sizeof dmsg, "no map binds trait '%.*s' to namespace '%s'",
                                 bar, self->arena->nodes[n].text3,
                                 self->arena->nodes[n].text3 + bar + 1);
                    else
                        snprintf(dmsg, sizeof dmsg, "no map binds trait '%s' to namespace ''",
                                 self->arena->nodes[n].text3);
                    return self->fail_from(n, dmsg);
                }
                fprintf(self->out, "(struct %s_iface){ (void *)0, &%s_vtable }",
                        self->arena->nodes[n].text, self->arena->nodes[n].text2);
                return 0;
            }
            if (a & 2) fputs("&", self->out);
            fprintf(self->out, "(struct %s_iface){ (void *)", self->arena->nodes[n].text);
            if (a & 1) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            } else {
                fputs("&", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            }
            fprintf(self->out, ", &%s_%s_vtable }", self->arena->nodes[n].text2, self->arena->nodes[n].text);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_MCALL) {
            char tname[MAX_TEXT];
            char low[MAX_TEXT];
            int i, c2, rk;
            /* Static mapping calls: no iface, no vtable, the recipe is expanded
               at the call site (spec §6.1 / §6.2). */
            if (self->arena->nodes[n].aux == 5) {
                char msg[MAX_TEXT];
                int mi, bj, found = -1, bind = -1;
                for (mi = 0; mi < (*self->nmaps); mi++) {
                    if (!self->maps[mi].is_static || self->maps[mi].type_host) continue;
                    if (!map_visible(self, mi)) continue;
                    if (strcmp(self->maps[mi].trait, self->arena->nodes[n].text) != 0) continue;
                    if (strcmp(self->maps[mi].inst, self->arena->nodes[n].text3) != 0) continue;
                    for (bj = 0; bj < self->maps[mi].nb; bj++)
                        if (strcmp(self->maps[mi].b[bj].method, self->arena->nodes[n].text2) == 0) {
                            found = mi;
                            bind = bj;
                            break;
                        }
                    if (found >= 0) break;
                }
                if (found < 0) {
                    snprintf(msg, sizeof msg, "no map binds trait '%s' to namespace '%s'",
                             self->arena->nodes[n].text, self->arena->nodes[n].text3);
                    return self->fail_from(n, msg);
                }
                return emit_recipe(self, &self->maps[found], &self->maps[found].b[bind],
                                   -1, self->arena->nodes[n].b, n);
            }
            if (self->arena->nodes[n].aux == 6) {
                char rt[MAX_TEXT];
                char rk[MAX_TEXT];
                char tk[MAX_TEXT];
                char msg[512];
                int r, mi, bj, cand = -1, cand2 = -1, bind = -1, bind2 = -1;
                r = self->arena->nodes[n].a;
                snprintf(rt, sizeof rt, "%s", self->arena->nodes[n].text);
                if (r < 0 || !rt[0])
                    return self->fail_from(n, "cannot infer the receiver type for a type-host map");
                /* the host key is the one the parser's arity pre-check and
                   the type pass compare with, so a spelling cannot expand here
                   and be missed there */
                frontend::type::type_key(rt, rk, MAX_TEXT);
                for (mi = 0; mi < (*self->nmaps); mi++) {
                    if (!self->maps[mi].is_static || !self->maps[mi].type_host) continue;
                    if (!map_visible(self, mi)) continue;
                    /* P20-01: a qualified call names the trait, so only its map
                       is a candidate even when the host type has others. */
                    if (self->arena->nodes[n].text3[0]
                        && strcmp(self->maps[mi].trait, self->arena->nodes[n].text3) != 0)
                        continue;
                    frontend::type::type_key(self->maps[mi].host_type, tk, MAX_TEXT);
                    if (strcmp(tk, rk) != 0) continue;
                    for (bj = 0; bj < self->maps[mi].nb; bj++)
                        if (strcmp(self->maps[mi].b[bj].method, self->arena->nodes[n].text2) == 0) {
                            if (cand < 0) {
                                cand = mi;
                                bind = bj;
                            } else if (cand2 < 0) {
                                cand2 = mi;
                                bind2 = bj;
                            }
                            break;
                        }
                }
                if (cand < 0) {
                    snprintf(msg, sizeof msg, "no method '%s' for type '%s'",
                             self->arena->nodes[n].text2, rt);
                    return self->fail_from(n, msg);
                }
                if (cand2 >= 0) {
                    char q1[MAX_TEXT];
                    char q2[MAX_TEXT];
                    char m1[MAX_TEXT];
                    char m2[MAX_TEXT];
                    int t1 = self->maps[cand].b[bind].ti;
                    int t2 = self->maps[cand2].b[bind2].ti;
                    trait_qual_name(self->sym, t1, q1, sizeof q1);
                    trait_qual_name(self->sym, t2, q2, sizeof q2);
                    snprintf(m1, sizeof m1, "%s::%s", q1, self->arena->nodes[n].text2);
                    snprintf(m2, sizeof m2, "%s::%s", q2, self->arena->nodes[n].text2);
                    /* The hint leads: a diagnostic is capped at MAX_TEXT, and
                       the two map paths are the part that may be cut. */
                    snprintf(msg, sizeof msg,
                             "use '%s' or '%s'; ambiguous type-host map for method '%s' on type '%s':"
                             " '%s' and '%s'",
                             m1, m2, self->arena->nodes[n].text2, rt,
                             self->maps[cand].path, self->maps[cand2].path);
                    return self->fail_from(n, msg);
                }
                return emit_recipe(self, &self->maps[cand], &self->maps[cand].b[bind],
                                   r, self->arena->nodes[n].b, n);
            }
            /* Phase 28 (D28-3): a call on the type parameter inside a bounded
               template body. The instance's type argument names the struct and
               the recorded trait names the vtable, so the slot call is a plain
               C call -- no vptr read, no boxing, no layout change. */
            if (self->arena->nodes[n].aux == 7 || self->arena->nodes[n].aux == 8) {
                char base[MAX_TEXT];
                char tg[MAX_TEXT];
                char msgb[MAX_TEXT];
                size_t tl;
                int si;
                if (!self->gtarg[0])
                    return self->fail_from(n, "a constrained call needs an instance");
                snprintf(tg, sizeof tg, "%s", self->gtarg);
                tl = strlen(tg);
                while (tl > 0 && (tg[tl - 1] == ' ' || tg[tl - 1] == '*')) {
                    tl--;
                    tg[tl] = 0;
                }
                if (strncmp(tg, "struct ", 7) == 0) snprintf(base, sizeof base, "%s", tg + 7);
                else if (strncmp(tg, "union ", 6) == 0) snprintf(base, sizeof base, "%s", tg + 6);
                else snprintf(base, sizeof base, "%s", tg);
                si = self->sym->find_struct(base);
                if (si < 0) {
                    snprintf(msgb, sizeof msgb,
                             "type argument '%s' cannot satisfy trait '%s' (not a struct)",
                             self->gtarg, self->arena->nodes[n].text);
                    return self->fail_from(n, msgb);
                }
                fprintf(self->out, "%s_%s_vtable.%s(", self->sym->structs[si].name,
                        self->arena->nodes[n].text, self->arena->nodes[n].text2);
                if (self->arena->nodes[n].aux == 7) fputs("&", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                c2 = self->arena->nodes[n].b;
                while (c2 >= 0) {
                    fputs(", ", self->out);
                    if (self->emit_expr(c2) != 0) return -1;
                    c2 = self->arena->nodes[c2].next;
                }
                fputs(")", self->out);
                return 0;
            }
            /* Phase 29: an inherent method of an instantiated struct. There is
               no vtable at all -- the receiver's concrete type names the
               monomorphised function (`<Inst>_<method>`), so the call is a plain
               C call. `.` passes the address, `->` passes the pointer. */
            if (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10) {
                char base[MAX_TEXT];
                char msg2[MAX_TEXT];
                int si;
                /* Phase 31 O3: a chained subscript's inner `get` was named by
                   `emit_hoists`, so every later emission prints the temporary
                   instead of the call. */
                if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
                    fputs(self->arena->nodes[n].text3, self->out);
                    return 0;
                }
                snprintf(base, sizeof base, "%s", self->arena->nodes[n].text);
                if (strncmp(base, "struct ", 7) == 0)
                    snprintf(base, sizeof base, "%s", self->arena->nodes[n].text + 7);
                si = self->sym->find_struct(base);
                if (si < 0) {
                    snprintf(msg2, sizeof msg2, "no method '%s' for type '%s'",
                             self->arena->nodes[n].text2, self->arena->nodes[n].text);
                    return self->fail_from(n, msg2);
                }
                fprintf(self->out, "%s_%s(", self->sym->structs[si].name,
                        self->arena->nodes[n].text2);
                if (self->arena->nodes[n].aux == 9) fputs("&", self->out);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                c2 = self->arena->nodes[n].b;
                while (c2 >= 0) {
                    fputs(", ", self->out);
                    if (self->emit_expr(c2) != 0) return -1;
                    c2 = self->arena->nodes[c2].next;
                }
                fputs(")", self->out);
                return 0;
            }
            /* P29-2: a static inherent method (`Vec<int>::from(...)`) -- no
               receiver, so the call is `<Inst>_<method>(<args>)` and the first
               argument is an ordinary one, not `self`. */
            if (self->arena->nodes[n].aux == 11) {
                char base[MAX_TEXT];
                char msg2[MAX_TEXT];
                int si;
                snprintf(base, sizeof base, "%s", self->arena->nodes[n].text);
                if (strncmp(base, "struct ", 7) == 0)
                    snprintf(base, sizeof base, "%s", self->arena->nodes[n].text + 7);
                si = self->sym->find_struct(base);
                if (si < 0) {
                    snprintf(msg2, sizeof msg2, "no static method '%s' for type '%s'",
                             self->arena->nodes[n].text2, self->arena->nodes[n].text);
                    return self->fail_from(n, msg2);
                }
                fprintf(self->out, "%s_%s(", self->sym->structs[si].name,
                        self->arena->nodes[n].text2);
                c2 = self->arena->nodes[n].b;
                while (c2 >= 0) {
                    if (c2 != self->arena->nodes[n].b) fputs(", ", self->out);
                    if (self->emit_expr(c2) != 0) return -1;
                    c2 = self->arena->nodes[c2].next;
                }
                fputs(")", self->out);
                return 0;
            }
            /* Phase 31 O3: a materialised method receiver (trait dispatch)
               prints its temporary instead of the call. */
            if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
                fputs(self->arena->nodes[n].text3, self->out);
                return 0;
            }
            if (self->arena->nodes[n].a < 0) return self->fail_from(n, "method call without a receiver");
            rk = self->arena->nodes[self->arena->nodes[n].a].kind;
            if (rk != N_VAR && rk != N_INDEX && rk != N_CALL
                && rk != N_MEMBER && rk != N_ARROW && rk != N_INTO_SELF
                && rk != N_INTO)
                return self->fail_from(n, "method receiver must be a variable, an element, a call or a field chain");
            if (!self->arena->nodes[n].text[0])
                return self->fail_from(n, "cannot resolve the method trait (unknown receiver type)");
            snprintf(tname, sizeof tname, "%s", self->arena->nodes[n].text);
            for (i = 0; tname[i] && i + 1 < MAX_TEXT; i++) {
                char c = tname[i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            if (self->arena->nodes[n].aux == 4) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, "->vt->%s(", self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs("->self", self->out);
            } else if (self->arena->nodes[n].aux == 3) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ".vt->%s(", self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fputs(".self", self->out);
            } else if (self->arena->nodes[n].aux == 2) {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, "->__%s_vptr->%s(", low, self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            } else {
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
                fprintf(self->out, ".__%s_vptr->%s(&", low, self->arena->nodes[n].text2);
                if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            }
            c2 = self->arena->nodes[n].b;
            while (c2 >= 0) {
                fputs(", ", self->out);
                if (self->emit_expr(c2) != 0) return -1;
                c2 = self->arena->nodes[c2].next;
            }
            fputs(")", self->out);
            return 0;
        }
        if (self->arena->nodes[n].kind == N_CALL) {
            int cl;
            /* A call through a closure variable expands to the trampoline with
               that variable's environment: `f(a)` becomes
               `__ct_cl_tramp_<ci>(&__ct_cl_env_v_<ci>, a)` (D21-14). */
            cl = -1;
            if (self->arena->nodes[n].aux != 2 && !self->arena->nodes[n].text3[0])
                cl = closure_var_lookup(self, self->arena->nodes[n].text2);
            if (cl >= 0) {
                fprintf(self->out, "__ct_cl_tramp_%d(&__ct_cl_env_v_%d", cl, cl);
                c = self->arena->nodes[n].a;
                while (c >= 0) {
                    fputs(", ", self->out);
                    if (self->emit_expr(c) != 0) return -1;
                    c = self->arena->nodes[c].next;
                }
                fputs(")", self->out);
                return 0;
            }
            if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
                fputs(self->arena->nodes[n].text3, self->out);
                return 0;
            }
            /* aux 1: `p(args)` on a function-pointer variable; aux 2: the
               callee is an expression, `(*p)(args)`. Both spell the call the
               same way (D-7). */
            if (self->arena->nodes[n].aux == 1) {
                fprintf(self->out, "(*%s)(", self->arena->nodes[n].text2);
            } else if (self->arena->nodes[n].aux == 2) {
                if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
                fputs("(", self->out);
            } else if (strcmp(self->arena->nodes[n].text2, "__ct_elem_retain") == 0
                       && self->ginst[0]) {
                fprintf(self->out, "%s__elem_retain(", self->ginst);
            } else if (strcmp(self->arena->nodes[n].text2, "__ct_elem_release") == 0
                       && self->ginst[0]) {
                fprintf(self->out, "%s__elem_release(", self->ginst);
            } else {
                fprintf(self->out, "%s(", self->arena->nodes[n].text2);
            }
            c = self->arena->nodes[n].a;
            while (c >= 0) {
                int cv;
                /* S5: an inline literal is two C arguments, the trampoline and
                   the address of its stack environment (D21-14). R03: a declared
                   binding fills the same pair from its own stack instance. */
                cv = -1;
                if (self->arena->nodes[c].kind == N_VAR)
                    cv = closure_var_lookup(self, self->arena->nodes[c].text2);
                if (self->arena->nodes[c].kind == N_CLOSURE) {
                    if (emit_closure_arg(self, c) != 0) return -1;
                } else if (cv >= 0) {
                    fprintf(self->out, "__ct_cl_tramp_%d, &__ct_cl_env_v_%d", cv, cv);
                } else if (self->emit_expr(c) != 0) {
                    return -1;
                }
                c = self->arena->nodes[c].next;
                if (c >= 0) fputs(", ", self->out);
            }
            fputs(")", self->out);
            return 0;
        }
        return self->fail_from(n, "unknown expression node");
    }

    /* `foo` -> `FOO_H`; a leading digit gets an underscore so the guard is a
       valid identifier. */
    int header_guard(const char *base, char *out, int cap)
    {
        size_t n, i, m;
        (void)self;

        n = strlen(base);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            out[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            if (m + 1 >= (size_t)cap) return self->fail("output name too long");
            out[m] = c;
            m++;
        }
        if (m + 3 >= (size_t)cap) return self->fail("output name too long");
        out[m] = '_';
        out[m + 1] = 'H';
        out[m + 2] = 0;
        return 0;
    }

    /* Build mode: one `.c` per unit. It includes its own header (so the `pub`
       declarations are visible exactly once) and the headers of its imports.
       The body runs with the sink open; on failure the file is closed before it
       is dropped, so the unlink does not strand the buffer in a dead inode. */
    int emit_unit(int u)
    {
        char path[MAX_PATH];
        FILE *f;
        int rc;
        (void)self;

        self->errmsg[0] = 0;
        self->failline = 0;
        self->gprefix = self->units[u].nsprefix;
        if (snprintf(path, sizeof path, "%s/%s.c", self->outdir, self->units[u].base) >= (int)sizeof path)
            return self->fail("output path is too long");
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the output file");
        self->out = f;
        self->path = self->units[u].path;
        self->cur_unit = u;
        rc = emit_unit_body(self, u);
        if (fclose(f) != 0 && rc == 0) rc = self->fail("cannot write the output file");
        return rc;
    }

    /* Build mode: the unit's exported surface (D34 fixes the naming rules, not
       the wording of the header). */
    int write_unit_header(int u)
    {
        char path[MAX_PATH];
        char guard[MAX_PATH];
        FILE *f;
        int rc;
        (void)self;

        self->gprefix = self->units[u].nsprefix;
        if (snprintf(path, sizeof path, "%s/%s.h", self->outdir, self->units[u].base) >= (int)sizeof path)
            return self->fail("output path is too long");
        if (self->header_guard(self->units[u].base, guard, sizeof guard) != 0) return -1;
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        self->out = f;
        self->path = self->units[u].path;
        rc = write_unit_header_body(self, u, guard);
        if (fclose(f) != 0 && rc == 0) rc = self->fail("cannot write the header");
        return rc;
    }

    /* JSON string body (no surrounding quotes). */
    int emit_json_str(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
        return 0;
    }

    /* `--emit-map`: the published JSON shape (compiler / file / traits /
       structs / functions / impls / calls). `u < 0` means compile mode, where
       the tables cover the single unit. */
    int write_map(const char *dest, int prog, int u)
    {
        FILE *f;
        const char *path;
        int trs, tre, fns, fne, cls, cle;
        int i, j, m, n, first, si, count;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the map");
        }
        if (u >= 0) {
            path = self->units[u].path;
            trs = self->units[u].tr_start;
            tre = self->units[u].tr_end;
            fns = self->units[u].fn_start;
            fne = self->units[u].fn_end;
            cls = self->units[u].call_start;
            cle = self->units[u].call_end;
        } else {
            path = self->path;
            trs = 0;
            tre = self->sym->ntraits;
            fns = 0;
            fne = self->sym->nfunc;
            cls = 0;
            cle = (*self->ncalls);
        }

        fputs("{\n", f);
        fprintf(f, "  \"compiler\": \"ct v%s\",\n", self->version);
        fputs("  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n", f);

        fputs("  \"traits\": [", f);
        first = 1;
        for (i = trs; i < tre; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->traits[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->sym->traits[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"methods\":[", self->sym->traits[i].line);
            for (m = 0; m < self->sym->traits[i].nm; m++) {
                if (m > 0) fputc(',', f);
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, self->sym->traits[i].m[m].name);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->sym->traits[i].m[m].ret);
                fprintf(f, "\",\"params\":%d}", self->sym->traits[i].m[m].nparams);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"structs\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_STRUCT) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"uses\":[", self->arena->nodes[n].line);
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < self->sym->structs[si].nuse; i++) {
                    if (i > 0) fputc(',', f);
                    fputc('"', f);
                    self->emit_json_str(f, self->sym->structs[si].use[i]);
                    fputc('"', f);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"functions\": [", f);
        first = 1;
        for (i = fns; i < fne; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"ret\":\"", self->sym->funcs[i].line);
            self->emit_json_str(f, self->sym->funcs[i].ret);
            fprintf(f, "\",\"params\":%d}", self->sym->funcs[i].nparams);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"impls\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            const char *tname;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl has no single struct symbol */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no trait */
            tname = self->arena->nodes[n].text2;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                if (!first) fputc(',', f);
                fputs("{\"struct\":\"", f);
                self->emit_json_str(f, self->sym->structs[si].name);
                fputs("\",\"trait\":\"", f);
                self->emit_json_str(f, tname);
                fputs("\",\"method\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text2);
                fputs("\",\"symbol\":\"", f);
                fprintf(f, "%s_%s_%s", self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text);
                count = 0;
                for (i = self->arena->nodes[m].a; i > 0; i = self->arena->nodes[i].next) count++;
                fprintf(f, "\",\"params\":%d,\"file\":\"", count);
                self->emit_json_str(f, path);
                fprintf(f, "\",\"line\":%d}", self->arena->nodes[n].line);
                first = 0;
            }
        }
        fputs("],\n", f);

        fputs("  \"calls\": [", f);
        for (i = cls; i < cle; i++) {
            if (i > cls) fputc(',', f);
            fputs("{\"caller\":\"", f);
            self->emit_json_str(f, self->calls[i].caller);
            fputs("\",\"callee\":\"", f);
            self->emit_json_str(f, self->calls[i].callee);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", self->calls[i].line);
        }
        fputs("],\n", f);

        fputs("  \"maps\": [", f);
        for (i = 0; i < (*self->nmaps); i++) {
            if (i > 0) fputc(',', f);
            fputs("{\"trait\":\"", f);
            self->emit_json_str(f, self->maps[i].trait);
            if (self->maps[i].is_static) {
                int su = self->maps[i].unit;
                fputs("\",\"static\":true", f);
                /* A mapping unit's shim is part of that map's definition, so the
                   JSON names the files a consumer build has to carry. */
                if (self->units && su >= 0 && su < *self->nunits
                    && self->units[su].has_shim) {
                    fputs(",\"shim\":{\"header\":\"", f);
                    self->emit_json_str(f, self->units[su].shim_h);
                    if (self->units[su].shim_c[0]) {
                        fputs("\",\"source\":\"", f);
                        self->emit_json_str(f, self->units[su].shim_c);
                    }
                    fputs("\"}", f);
                }
                fputs(",\"instance\":\"", f);
            } else {
                fputs("\",\"instance\":\"", f);
            }
            self->emit_json_str(f, self->maps[i].inst);
            fputs("\",\"host\":\"", f);
            if (self->maps[i].type_host) fputs("type", f);
            else fputs(self->maps[i].ns_host ? "namespace" : "instance", f);
            if (self->maps[i].type_host) {
                fputs("\",\"type\":\"", f);
                self->emit_json_str(f, self->maps[i].host_type);
            }
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"bindings\":[", self->maps[i].line);
            for (j = 0; j < self->maps[i].nb; j++) {
                char callee[MAX_TEXT];
                if (j > 0) fputc(',', f);
                fputs("{\"method\":\"", f);
                self->emit_json_str(f, self->maps[i].b[j].method);
                fputs("\",\"symbol\":\"", f);
                if (self->maps[i].is_static) {
                    map_recipe_callee(self->maps[i].b[j].call, callee);
                    self->emit_json_str(f, callee);
                } else {
                    self->emit_json_str(f, self->maps[i].b[j].direct
                                              ? self->maps[i].b[j].call
                                              : self->maps[i].b[j].wrapper);
                }
                if (self->maps[i].is_static)
                    fputs("\",\"wrapper\":false,\"inline\":true}", f);
                else
                    fprintf(f, "\",\"wrapper\":%s}",
                            self->maps[i].b[j].direct ? "false" : "true");
            }
            fputs("]}", f);
        }
        fputs("]\n", f);
        fputs("}\n", f);

        if (f != stdout) {
            if (fclose(f) != 0) return self->fail("cannot write the map");
        }
        return 0;
    }

    /* Compile mode: a placeholder header (types only; the .c is self-contained). */
    int write_header(const char *outc)
    {
        char path[MAX_PATH];
        char base[MAX_PATH];
        char guard[MAX_PATH];
        const char *name;
        FILE *f;
        size_t n;

        (void)self;
        if (snprintf(path, sizeof path, "%s", outc) >= (int)sizeof path)
            return self->fail("output path too long");
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        if (snprintf(base, sizeof base, "%s", name) >= (int)sizeof base)
            return self->fail("output path too long");
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        if (self->header_guard(base, guard, sizeof guard) != 0) return -1;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                self->version, self->path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }

    /* A failure is recorded without a position; the driver's facade wraps the
       first message with the current line and token. */
    int fail(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0])
            snprintf(self->errmsg, sizeof self->errmsg, "%s", msg);
        return -1;
    }

    /* The failure is about a source node, so its line is the position to report.
       The lexer is useless here: parsing finished long before emission. */
    int fail_from(int n, const char *msg)
    {
        (void)self;
        if (n >= 0 && !self->errmsg[0]) self->failline = self->arena->nodes[n].line;
        return self->fail(msg);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Emitter g_emit;

/* Only primitives cross the unit boundary. Every pointer to another unit's
   type goes in as `void *` and is cast here, because a generated header carries
   no #include and a prototype that named `struct Symbols *` would
   scope a fresh, incompatible type. The bind calls are split so no signature
   exceeds MAX_PARAMS. */
pub void ct_emit_bind(void *arena, void *sym, void *ty, void *lex, const char *version, char *outdir, const char *prog);
void ct_emit_bind(void *arena, void *sym, void *ty, void *lex,
                  const char *version, char *outdir, const char *prog)
{
    g_emit.arena = (struct Arena *)arena;
    g_emit.sym = (struct Symbols *)sym;
    g_emit.ty = (struct TypeCheck *)ty;
    g_emit.lex = (struct Lexer *)lex;
    g_emit.version = version;
    g_emit.outdir = outdir;
    g_emit.prog = prog;
    /* the vptr writer follows the emitter's output stream, which changes per
       unit, so it holds the address of the field rather than a copy */
    ct_init_bind(sym, (void **)&g_emit.out);
    g_emit.init = init_get();
}

pub void ct_emit_bind_tables(void *units, int *nunits, void *maps, int *nmaps, void *calls, int *ncalls, int *build_mode, int *line_mode);
void ct_emit_bind_tables(void *units, int *nunits, void *maps, int *nmaps,
                         void *calls, int *ncalls, int *build_mode, int *line_mode)
{
    g_emit.units = (struct Unit *)units;
    g_emit.nunits = nunits;
    g_emit.maps = (struct MapTable *)maps;
    g_emit.nmaps = nmaps;
    g_emit.calls = (struct Call *)calls;
    g_emit.ncalls = ncalls;
    g_emit.build_mode = build_mode;
    g_emit.line_mode = line_mode;
}

pub void ct_emit_bind_parse(int *nparams, void *pend_fields, int *npend);
void ct_emit_bind_parse(int *nparams, void *pend_fields, int *npend)
{
    g_emit.nparams = nparams;
    g_emit.pend_fields = (struct Field *)pend_fields;
    g_emit.npend = npend;
}

pub void ct_emit_set_out(void *out);
void ct_emit_set_out(void *out)
{
    g_emit.out = (FILE *)out;
}

/* Phase 29 E29-5 / P34 S9a: the built-in layer units. The module layer clears
   the set when a run starts and adds one index per layer file it loaded. */
pub void ct_emit_clear_builtins(void);
void ct_emit_clear_builtins(void)
{
    g_emit.nbuiltin = 0;
}

pub void ct_emit_add_builtin(int u);
void ct_emit_add_builtin(int u)
{
    if (g_emit.nbuiltin < 4) {
        g_emit.builtins[g_emit.nbuiltin] = u;
        g_emit.nbuiltin += 1;
    }
}

pub void ct_emit_set_path(const char *path);
void ct_emit_set_path(const char *path)
{
    g_emit.path = path;
}

pub int ct_emit_program(int prog);
int ct_emit_program(int prog)
{
    return g_emit.emit_program(prog);
}

pub int ct_emit_unit(int u);
int ct_emit_unit(int u)
{
    return g_emit.emit_unit(u);
}

pub int ct_emit_unit_header(int u);
int ct_emit_unit_header(int u)
{
    return g_emit.write_unit_header(u);
}

pub int ct_emit_header(const char *outc);
int ct_emit_header(const char *outc)
{
    return g_emit.write_header(outc);
}

pub int ct_emit_map(const char *dest, int prog, int u);
int ct_emit_map(const char *dest, int prog, int u)
{
    return g_emit.write_map(dest, prog, u);
}

pub const char *ct_emit_last_error(void);
const char *ct_emit_last_error(void)
{
    return g_emit.errmsg;
}

/* The source line the failure blames; 0 means it is not about the source. */
pub int ct_emit_error_line(void);
int ct_emit_error_line(void)
