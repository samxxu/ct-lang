            NodeKind.NK_ENUM() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ENUMVAL() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_OFFSETOF() => { return self->fail_from(n, "cannot inline this node"); }
