            for (r = 0; r < nr; r++) {
                int fn;
                if (backend::lir::lmod_plan_row_kind(r) != LPS_FUNC || backend::lir::lmod_plan_row_unit(r) != -1) continue;
                /* a generic template has no C body of its own (Phase 26) */
