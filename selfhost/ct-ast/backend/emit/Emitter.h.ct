/*
 * Emitter.h.ct - the C emitter, one class of its own.
 *
 * It turns the AST into C: it reads the node pool, the symbol tables, the type
 * queries and the module tables, and writes the `.c`/`.h` files and the map
 * JSON. Macros do not cross a unit boundary, so the node kinds, the operator
 * tags and the caps are declared here; MAX_TEXT 160 and MAX_PARAMS 16 are the
 * values `frontend/sym/Symbols.h.ct` lists.
 *
 * The instance is private to this unit: a generated header carries no
 * #include, so neither the FILE * nor the trait may appear in its surface.
 * The driver reaches it through the `pub` primitives at the end of the file.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
import frontend::sym::SymbolsTypeText;

import backend::emit::Init;
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable::MapBind as MapBind;
import frontend::module::MapTable;
import frontend::module::Unit;
import frontend::parse::Expr;
import frontend::parse::ExprTypeText;
import frontend::sym::Symbols::Field as Field;
import frontend::sym::Symbols::MethodSig as MethodSig;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import backend::emit::EmitterText;
import backend::emit::EmitterQuery;
import backend::emit::EmitterMapText;
import backend::emit::EmitterCore;
import tool::sh::Sh;
import backend::emit::EmitterTry;
import backend::emit::EmitInvariant;
import backend::emit::EmitHoist;
import backend::emit::EmitInit;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160
/* S1a-0 C2p-5: the formal text bound (mirror of Symbols/Limits). */
#define TEXT_LIMIT 65536
#define MAX_HOISTS 4
#define CAP_LIMIT 65536
/* Phase 30: the receiver block and its `$` / `.name` reference. */
#define N_MATSEQ 73
#define N_INTO 63
#define N_INTO_SELF 64
#define MAX_INTOS 4
#define MAX_PARAMS 16

/* the node kinds this unit dispatches on (D32: one tag, one dispatch) */
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_MCALL   30
#define N_RAW     31
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_OPT     72
#define N_NEWOBJ  77
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41
#define N_SWITCH  42
/* Phase 84: the ADT/match nodes (shared numbers with the parser). */
#define N_ADTCTOR 81
#define N_ARM     79
#define N_BIND    80
#define N_MATCH   78
#define N_CASE    43
#define N_DOWHILE 44
#define N_ENUM    45
#define N_ENUMVAL 46
#define N_OFFSETOF 47
#define N_UNION   48
#define N_LABEL   49
#define N_GOTO    50
#define N_COMPOUND 51
#define N_EMPTY   52
#define N_VAARG   53
#define N_FNUM    54
#define N_SASSERT 55
#define N_FIELDS  56
#define N_PRE     57
#define N_RAW_TEXT 58
/* the parser's closure literal (Phase 21 S2); the emitter never prints a node
   of this kind by itself -- S3 expands it at the declaration and at the call */
#define N_CLOSURE 59
/* `loop(<count>) { … }` (Phase 22) and `loop(<start>..<stop>) { … }` (Phase 23):
   parsed as their own node, printed as a native `for` whose head declares the
   implicit counter and the private bound temporary (one for the counted form,
   two for the range form). */
#define N_LOOP    60
#define N_FOREACH 62
#define N_INIT_RANGE 61
/* Phase 31 S11a: a `Vec<T>` brace initializer. `text` is the element's C type,
   `text2` the encoded instance name, `aux` the element count and `a` the first
   element expression (the rest hang off `next`). */
#define N_INIT_BRACE 65
/* Phase 31 S14a: a `Map` brace initializer. `text` is the nested `MapEntry`
   struct spelling, `text2` the encoded `Map` name, `aux` the item count, `a` the
   first `N_INIT_ITEM` (`a` = key expression, `b` = value expression, items
   chain through `next`). */
#define N_INIT_MBRACE 67
/* Phase 38: a materialised `defer` body at a block exit (`a` = N_BLOCK). */
#define N_DEFER_RUN 70
#define N_DEFER 69
/* Phase 44: the postfix `?` error-propagation node (`a` = operand). */
#define N_TRY 71
/* P-7.2: slice nodes. `N_SLICE_INDEX` (`a` base, `b` index, `text` element
   including `const` when read-only) prints as a checked place;
   `N_SLICE_RANGE` (`a` base, `b` lo, `c` hi or -1, `aux` 1 array / 2 slice)
   prints a `{ptr,len}` construction; `N_SLICE_GET` (`a` base, `b` index)
   prints the soft access returning 0 when out of range. */
#define N_SLICE_INDEX 74
#define N_SLICE_RANGE 75
#define N_SLICE_GET   76

/* binary operators (stored in `aux`) */
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13
#define B_XOR 14
#define B_BAND 15
#define B_BOR  16
#define B_SHL  17
#define B_SHR  18
#define B_COMMA 19

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define U_BNOT 3
#define P_INC 1

namespace backend::emit;

/* PH-80 SH-102 (D-013 §3): the automatic retain / release bookkeeping for the
   two owning built-in string handles. It is a nested value rather than a dozen
   more fields on `Emitter`, whose `pub struct` field budget is 64:
     - `name` / `type` / `own`: the owning bindings in the body being written
       (`own` 0 marks a borrowed view, which is never retained or released);
     - `blk`: the binding depth at each statement block, so a `break` /
       `continue` can release what the skipped closing brace would;
     - `ln` / `lname` / `ltype`: every local and parameter in scope, so a field
       target such as `h.tag = s` resolves the struct's field type after the
       parser's symbol table has popped the block;
     - `hitparam`: the assignment target is the enclosing template's type
       parameter, whose lifecycle the container glue already manages;
     - `method` / `recv`: the body being written, so the built-in borrow / move
       protocols (`Vec.get`, `Vec.pop`, `Map.entry`) keep their semantics.
   The array lengths are the documented caps. */
/* A snapshot of the field-definition table, used to merge the two arms of an
   `if` (`defined_after = defined_before || (then_defined && else_defined)`). */
pub struct FldSnap {
    int  n;
    /* S1a-0 C2n-3: field paths are pool text; the snapshot copies pointers. */
    const char *path[128];
    int  owner[128];
    int  defined[128];
}

pub struct StrRetain {
    int  n;
    /* S1a-0 C2n-3: names, types and field paths are pool text. A name or type
       is a source identifier (already interned upstream); a field path is a
       generated `base.field` and is interned where it is built. */
    const char *name[256];
    const char *type[256];
    int  own[256];
    int  blk[256];
    int  bkind[256];    /* 1 = loop body, 2 = switch body, 0 = plain block */
    int  nblk;
    int  pending;       /* the next N_BLOCK is a function body: retain params */
    int  loop_pending;  /* the next N_BLOCK is a loop body */
    int  switch_pending;/* the next N_BLOCK is a switch body */
    /* field reassignment: the string fields of a local / global struct that
       are known to hold an owning handle, so a later assignment releases the
       old value. Only straight-line member / arrow targets are tracked. */
    int  nfield;
    const char *fpath[128];
    int  fowner[128];   /* binding index of the base local; -1 = global */
    int  fdepth[128];   /* block depth where the field was defined */
    int  fmaybe[128];   /* 1 = only conditionally defined (branch / loop body) */
    int  branch_hold;   /* the next N_BLOCK close keeps its marks for an if-merge */
    int  ln;
    const char *lname[512];
    const char *ltype[512];
    int  lblk[256];
    int  hitparam;
    const char *method;
    const char *recv;
}


/* SH-102: one bookkeeping block for the whole emitter (the instance itself is
   private to this unit and single-threaded), so the `pub struct Emitter`
   field budget is untouched. */
static struct StrRetain g_sb;

/* LANG-26: the call node whose own `out`-conversion statement expression is
   being written, so the intercept does not fire again for that node while a
   different nested call still gets its own statement expression. -1 = none.
   A file-scope flag keeps the `pub struct Emitter` field budget untouched (the
   emitter is single-threaded). */
static int g_oc_bypass_node = -1;
/* S1b-S2b body seam: set through `ct_emit_set_body_hook` at the end of the
   unit, read by `em_node_func`. Declared here so the dispatch can see it. */
static int (*g_body_hook)(const char *name, void *out, int ind, int ntmp,
                          int *new_ntmp, int stmts);

/* defined further down; `sb_norm_text` needs it to substitute a template
   spelling. NULL means "no substitution applies". */
static const char *emit_gsub_type_text(struct Emitter *self, const char *type);

/* The innermost tracked binding named `name`, or -1. */
static int sb_find(struct Emitter *self, const char *name)
{
    (void)self;
    int i;
    for (i = g_sb.n - 1; i >= 0; i--)
        if (strcmp(g_sb.name[i], name) == 0) return i;
    return -1;
}

static void sb_push(struct Emitter *self, const char *name, const char *type, int own)
{
    (void)self;
    int i;
    const char *pname, *ptype;
    if (g_sb.n >= 256) return;
    i = g_sb.n;
    pname = runtime::text::ct_intern(name);
    ptype = runtime::text::ct_intern(type);
    if (!pname || !ptype) return;   /* OOM: the row is not pushed */
    g_sb.name[i] = pname;
    g_sb.type[i] = ptype;
    g_sb.own[i] = own;
    g_sb.n++;
}

/* The innermost local / parameter of `name`, or -1. */
static int sb_lfind(struct Emitter *self, const char *name)
{
    (void)self;
    int i;
    for (i = g_sb.ln - 1; i >= 0; i--)
        if (strcmp(g_sb.lname[i], name) == 0) return i;
    return -1;
}

static void sb_lpush(struct Emitter *self, const char *name, const char *type)
{
    (void)self;
    int i;
    const char *pname, *ptype;
    if (g_sb.ln >= 512) return;
    i = g_sb.ln;
    pname = runtime::text::ct_intern(name);
    ptype = runtime::text::ct_intern(type);
    if (!pname || !ptype) return;   /* OOM: the row is not pushed */
    g_sb.lname[i] = pname;
    g_sb.ltype[i] = ptype;
    g_sb.ln++;
}

/* S1a-0 C2p-8: the C base tag of a type spelling as one interned text --
   the `struct` / `union` / `enum` keyword, leading blanks and trailing blanks
   are dropped. This is the pointer form of the old 160-byte `base` copy: a
   2000-byte tag reaches the struct / ADT lookup whole. */
static const char *base_type_text(const char *type)
{
    const char *b;
    size_t n;

    b = type ? type : "";
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    else if (strncmp(b, "union ", 6) == 0) b += 6;
    else if (strncmp(b, "enum ", 5) == 0) b += 5;
    while (*b == ' ' || *b == '\t') b++;
    n = strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
    return runtime::text::ct_intern_len(b, (int)n);
}

/* S1a-0 C2p-8: the file-name part of a path as a view (the diagnostic
   spelling `map_path_base` used to copy through a 160-byte row). */
static const char *path_base_ptr(const char *p)
{
    const char *b = p;
    const char *q;

    for (q = p; *q; q++)
        if (*q == '/' || *q == '\\') b = q + 1;
    return b;
}

/* S1a-0 C2p-5: the pool-text form of the old `sb_norm`, so a 2000-byte
   spelling is not cut by a caller row. Returns `in` itself when nothing
   changes. */
static const char *sb_norm_text(struct Emitter *self, const char *in)
{
    const char *t = in;
    const char *sub = emit_gsub_type_text(self, in);
    if (sub) t = sub;
    if (strchr(t, '<')) {
        char *res = (char *)malloc(TEXT_LIMIT);
        const char *pooled;
        if (!res) return (const char *)0;
        if (frontend::sym::ct_inst_resolve(t, res, TEXT_LIMIT) == 0) {
            pooled = runtime::text::ct_intern(res);
            free(res);
            return pooled;
        }
        free(res);
    }
    return t;
}

/* LANG-29 S2 / B3 (D-021 §3): the ADT value protocol.
 *
 * An ADT value shares its owning payload leaves -- `String` / `U16String`, a
 * built-in container, a built-in `Box`, or a nested ADT -- so every copy needs
 * its own reference and the last value releases it. The emitter writes one
 * `struct T T_retain(struct T *)` / `void T_release(struct T *)` pair per ADT
 * that owns anything (the same spelling an explicit `impl T { retain/release }`
 * would use, and the protocol the container element glue already calls). This
 * predicate and `sb_life_prefix` are the two readers; a non-owning ADT emits
 * nothing, so a scalar-only ADT's generated C is unchanged.
 *
 * Deliberately not owning here: a plain struct payload (its copy / Drop glue is
 * the author's explicit protocol) and `Option` / `Result` (their payload is a
 * value and they expose no `retain`). Both are registered as out of B3 scope.
 */
static int adt_owns(struct Emitter *self, int adi, int depth);
static int adt_own_kind(struct Emitter *self, const char *type, int depth);

/* The C base tag of a type spelling after template substitution:
   `struct Vec_N` / `Vec<N>` -> `Vec_N`, as one interned text. */
static const char *adt_base_type_text(struct Emitter *self, const char *type)
{
    const char *t = sb_norm_text(self, type);

    if (!t) return (const char *)0;
    return base_type_text(t);
}

/* 1 when an ADT field / value of this spelling carries an owning leaf. */
static int adt_own_kind(struct Emitter *self, const char *type, int depth)
{
    const char *base;
    int ai;
    if (!type || !type[0] || depth > 16) return 0;
    if (strchr(type, '*') || strchr(type, '[')) return 0;
    if (frontend::sym::ct_is_string_value_type(type)) return 1;
    base = adt_base_type_text(self, type);
    if (base && (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0)) return 1;
    if (base && inst_is_builtin_Box(base)) return 1;
    ai = frontend::sym::ct_adt_from_type(type);
    if (ai >= 0 && adt_owns(self, ai, depth + 1)) return 1;
    return 0;
}

/* 1 when any variant of this ADT carries an owning payload field. */
static int adt_owns(struct Emitter *self, int adi, int depth)
{
    int v, f, n;
    struct Adt *adts;
    adts = frontend::sym::ct_adts(&n);
    if (!adts || adi < 0 || adi >= n || depth > 16) return 0;
    for (v = 0; v < adts[adi].nvariants; v++)
        for (f = 0; f < adts[adi].variants[v].nfields; f++)
            if (adt_own_kind(self, adts[adi].variants[v].fields[f].type, depth))
                return 1;
    return 0;
}

/* The `<prefix>_retain` / `<prefix>_release` names of an owning value type, or
   0 when the type owns nothing (its copies are plain C assignments). The
   result is a pool text (`String` / `U16String` use their static prefix, an
   ADT its whole `full` tag), so no caller row decides the length. */
static const char *sb_life_prefix_text(struct Emitter *self, const char *type)
{
    const char *base;
    int k, ai, n;
    struct Adt *adts;
    if (!type || !type[0] || strchr(type, '*')) return 0;
    k = frontend::sym::ct_is_string_value_type(type);
    if (k) return sb_prefix(k);
    base = adt_base_type_text(self, type);
    if (base && (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0
                 || inst_is_builtin_Box(base)))
        return base;
    ai = frontend::sym::ct_adt_from_type(type);
    if (ai < 0 || !adt_owns(self, ai, 0)) return 0;
    adts = frontend::sym::ct_adts(&n);
    if (!adts || ai >= n) return 0;
    return adts[ai].full;
}

/* 1 when a *local* value of this spelling is tracked automatically (the two
   string handles and an owning ADT). Containers and Box keep their explicit
   `release()` contract for ordinary locals, so a by-value container return or
   parameter must not gain an automatic retain/release here. */
static int sb_value_type_owns(struct Emitter *self, const char *type)
{
    int ai;
    if (!type || !type[0] || strchr(type, '*')) return 0;
    if (frontend::sym::ct_is_string_value_type(type)) return 1;
    ai = frontend::sym::ct_adt_from_type(type);
    return ai >= 0 && adt_owns(self, ai, 0);
}

/* S1a-0 C2p-5: normalise an owning value type to its C spelling for a
   temporary declaration: an ADT reached through a bare field spelling (`Msg`)
   needs `struct Msg`. The pool-text form replaced the 160-byte buffer. */
static const char *sb_norm_own_type_text(struct Emitter *self, const char *t)
{
    int ai, n;
    struct Adt *adts;
    (void)self;
    if (strncmp(t, "struct ", 7) == 0) return t;
    ai = frontend::sym::ct_adt_from_type(t);
    if (ai < 0) return t;
    adts = frontend::sym::ct_adts(&n);
    if (!adts || ai >= n) return t;
    return runtime::text::ct_internf("struct %s", adts[ai].full);
}

/* 1 when a container / Box lvalue owns a heap handle its `release` must guard:
   the built-in `Vec` / `Map` abort on a zero handle (D29-12), unlike `String`
   and `Box`, whose release already tolerates it. */
/* 1 when the declared (pre-substitution) spelling is one of the template
   parameters in scope, i.e. the place is a container element the templates
   already retain/release themselves. Compare a (pointer, length) view so a
   2000-byte declaration is not cut at a fixed row. */
static int sb_is_tparam(struct Emitter *self, const char *raw)
{
    size_t n;
    int i;
    if (!raw) return 0;
    n = strlen(raw);
    while (n > 0 && (raw[n - 1] == ' ' || raw[n - 1] == '\t' || raw[n - 1] == '*')) n--;
    if (n == 0) return 0;
    for (i = 0; i < self->gtntparam; i++)
        if (self->gtparam[i] && self->gtparam[i][0]
            && strlen(self->gtparam[i]) == n
            && strncmp(raw, self->gtparam[i], n) == 0) return 1;
    return 0;
}

/* The static C type of a place-shaped expression (a variable, a field, a
   deref or a subscript), or -1 when it cannot be resolved. Only the destination
   of a string assignment needs this; an rvalue is classified by its node kind. */
static const char *sb_expr_type_text(struct Emitter *self, int n)
{
    const char *t;
    const char *out;
    int k, i;
    size_t ln;

    if (n < 0) return (const char *)0;
    k = self->arena->nodes[n].kind;
    if (k == N_VAR) {
        i = sb_lfind(self, self->arena->nodes[n].text2);
        if (i >= 0) {
            if (sb_is_tparam(self, g_sb.ltype[i])) g_sb.hitparam = 1;
            return sb_norm_text(self, g_sb.ltype[i]);
        }
        i = self->sym->find_var(self->arena->nodes[n].text2);
        if (i >= 0) {
            if (sb_is_tparam(self, self->sym->vars[i].type)) g_sb.hitparam = 1;
            return sb_norm_text(self, self->sym->vars[i].type);
        }
        return (const char *)0;
    }
    if (k == N_MEMBER || k == N_ARROW) {
        const char *sname;
        int is_ptr, si, fi;
        t = sb_expr_type_text(self, self->arena->nodes[n].a);
        if (!t) return (const char *)0;
        is_ptr = (k == N_ARROW);
        if (!self->ty->concrete_struct_text(t, &sname, &is_ptr)) return (const char *)0;
        si = self->sym->find_struct(sname);
        if (si < 0) return (const char *)0;
        for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
            if (strcmp(self->sym->structs[si].fields[fi].name,
                       self->arena->nodes[n].text2) == 0) {
                if (self->sym->structs[si].fields[fi].dims[0]) return (const char *)0;
                /* an instance row carries substituted field types; the
                   template row keeps `T` / `V`, which is how a container
                   element assignment is recognised */
                if (self->sym->structs[si].is_inst) {
                    int i2, nt;
                    struct StructInst *ins2 = frontend::sym::ct_insts(&nt);
                    int k2 = ins2 ? frontend::sym::ct_inst_find(self->sym->structs[si].name) : -1;
                    if (k2 >= 0) {
                        int tm = frontend::sym::ct_tmpl_find(ins2[k2].tmpl);
                        int ntm, tf;
                        struct StructTmpl *tps2 = frontend::sym::ct_tmpls(&ntm);
                        if (tm >= 0 && tps2) {
                            for (tf = 0; tf < tps2[tm].nfields; tf++)
                                if (strcmp(tps2[tm].fields[tf].name, self->arena->nodes[n].text2) == 0)
                                    if (sb_is_tparam(self, tps2[tm].fields[tf].type))
                                        g_sb.hitparam = 1;
                        }
                        (void)i2;
                    }
                }
                return sb_norm_text(self, self->sym->structs[si].fields[fi].type);
            }
        return (const char *)0;
    }
    if (k == N_DEREF) {
        out = sb_expr_type_text(self, self->arena->nodes[n].a);
        if (!out) return (const char *)0;
        ln = strlen(out);
        while (ln > 0 && out[ln - 1] == ' ') ln--;
        if (ln == 0 || out[ln - 1] != '*') return (const char *)0;
        ln--;
        while (ln > 0 && out[ln - 1] == ' ') ln--;
        return runtime::text::ct_intern_len(out, (int)ln);
    }
    if (k == N_INDEX) {
        out = sb_expr_type_text(self, self->arena->nodes[n].a);
        if (!out) return (const char *)0;
        /* an array declarator's type carries no star, so only a pointer base
           loses one; an array base already names the element */
        ln = strlen(out);
        while (ln > 0 && out[ln - 1] == ' ') ln--;
        if (ln > 0 && out[ln - 1] == '*') {
            ln--;
            while (ln > 0 && out[ln - 1] == ' ') ln--;
            return runtime::text::ct_intern_len(out, (int)ln);
        }
        return out;
    }
    return (const char *)0;
}

/* 1 when the expression hands over a fresh owning reference (a call result, a
   literal or a null handle); 0 when it is a place that still owns its own
   reference and must be retained by the destination. */
static int sb_rhs_fresh(struct Emitter *self, int n)
{
    int k;
    if (n < 0) return 1;
    k = self->arena->nodes[n].kind;
    if (k == N_CALL || k == N_MCALL || k == N_STR || k == N_NUM) return 1;
    /* LANG-29 S2 / B3: a constructor result is a freshly built ADT value, so
       its own reference (and its payload's) moves into the destination. */
    if (k == N_ADTCTOR) return 1;
    /* the postfix `?` hands its payload over (it clears the carrier) */
    if (k == N_TRY) return 1;
    /* LANG-29 S4 / B5: an expression match hands over the value its result
       temporary already owns; the temporary is raw C, so no release follows. */
    if (k == N_MATCH) return 1;
    if (k == N_CAST) return sb_rhs_fresh(self, self->arena->nodes[n].a);
    return 0;
}

/* 1 when the expression is a C place, so `&(expr)` is legal. Anything else is
   read into a temporary before it is retained. */
static int sb_is_place(struct Emitter *self, int n)
{
    int k;
    if (n < 0) return 0;
    k = self->arena->nodes[n].kind;
    return k == N_VAR || k == N_MEMBER || k == N_ARROW || k == N_INDEX
           || k == N_DEREF || k == N_SLICE_INDEX;
}

/* defined below; the field bookkeeping helpers call each other */
static int sb_field_find(struct Emitter *self, int owner, const char *base, const char *field);
static void sb_field_mark(struct Emitter *self, const char *base, const char *field, int owner);

/* The captured text of an N_RAW initialiser. */
static const char *sb_raw_text(struct Emitter *self, int n)
{
    if (n < 0 || self->arena->nodes[n].kind != N_RAW) return 0;
    if (self->arena->nodes[n].aux) return self->arena->str_at((int)self->arena->nodes[n].num);
    return self->arena->nodes[n].text;
}

/* The `<base>.<field>` key of a member / arrow target whose base is a plain
   variable. 0 when the target is indexed or otherwise dynamic. */
static int sb_field_key(struct Emitter *self, int lhs, const char **base,
                        const char **field, int *owner)
{
    int b, vi;
    if (lhs < 0) return 0;
    if (self->arena->nodes[lhs].kind != N_MEMBER && self->arena->nodes[lhs].kind != N_ARROW)
        return 0;
    b = self->arena->nodes[lhs].a;
    if (b < 0 || self->arena->nodes[b].kind != N_VAR) return 0;
    /* S1a-0 C2p-8: both halves are already pool texts; hand them out as
       views so a 2000-byte local / field name is not cut at a 160 row. */
    *base = self->arena->nodes[b].text2;
    *field = self->arena->nodes[lhs].text2;
    vi = sb_lfind(self, *base);
    if (vi >= 0) {
        *owner = vi;
        return 1;
    }
    vi = self->sym->find_var(*base);
    if (vi >= 0 && self->sym->vars[vi].is_global) {
        *owner = -1;
        return 1;
    }
    return 0;
}

/* The field's mark, or -1. `*maybe` reports a conditional definition (a branch
   or a loop body), which must not drive a release. */
static int sb_field_state(struct Emitter *self, int owner, const char *base, const char *field, int *maybe)
{
    int i = sb_field_find(self, owner, base, field);
    *maybe = 0;
    if (i < 0) return -1;
    *maybe = g_sb.fmaybe[i] || g_sb.fdepth[i] > g_sb.nblk;
    return i;
}


/* 1 when the field assignment sits inside a loop body and the base local was
   declared outside that loop: the first iteration would release an undefined
   old value, so this is refused unless the field was defined before the loop. */
static int sb_field_loop_unsafe(struct Emitter *self, int owner)
{
    int i;
    (void)self;
    if (owner < 0) return 0;
    for (i = g_sb.nblk - 1; i >= 0; i--) {
        if (g_sb.bkind[i] != 1) continue;
        if (owner < g_sb.lblk[i]) return 1;
    }
    return 0;
}

/* 1 when `type` is a by-value struct carrying an owning String-typed field. */
static int sb_owning_struct_type(struct Emitter *self, const char *type)
{
    const char *t, *sname;
    int is_ptr, si, fi;
    if (!type || !type[0]) return 0;
    if (strchr(type, '*') || strchr(type, '[')) return 0;
    t = sb_norm_text(self, type);
    if (!t) return 0;
    if (!self->ty->concrete_struct_text(t, &sname, &is_ptr)) return 0;
    if (is_ptr) return 0;
    si = self->sym->find_struct(sname);
    if (si < 0) return 0;
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++)
        if (!self->sym->structs[si].fields[fi].dims[0]
            && frontend::sym::ct_is_string_value_type(self->sym->structs[si].fields[fi].type))
            return 1;
    return 0;
}


/* Rewrite a captured struct initialiser so an owning string field's place
   initialiser is retained, exactly like `h.tag = x`. Positional and
   `.field = expr` items are matched against the struct's fields; a field whose
   initialiser is a call result moves (no retain). Returns 1 when it printed
   the rewritten `{ … }` text (without the closing brace, which the caller's
   vptr suffix path appends), 0 when nothing needed rewriting. */
/* Release the tracked bindings [base, sb_n) in reverse declaration order,
   skipping `skip` (a handle that a `return` moves out). */
static int sb_release_from(struct Emitter *self, int base, int skip, int ind)
{
    int i;
    const char *pfx;
    if (base < 0) base = 0;
    for (i = g_sb.n - 1; i >= base; i--) {
        if (i == skip || !g_sb.own[i]) continue;
        pfx = sb_life_prefix_text(self, g_sb.type[i]);
        if (!pfx) continue;
        self->emit_indent(ind);
        if (sb_life_needs_handle_guard(pfx))
            fprintf(self->out, "if (%s.h != 0) (void)%s_release(&%s);\n",
                    g_sb.name[i], pfx, g_sb.name[i]);
        else
            fprintf(self->out, "%s_release(&%s);\n", pfx, g_sb.name[i]);
    }
    return 0;
}

/* 1 when the method being written is one of the built-in container protocols
   whose by-value return is a borrow (`get`, `entry`) or a move (`pop`). The
   element glue already carries the reference, so the automatic retain must not
   add a second one. */
static int sb_container_view(const char *method)
{
    if (!g_sb.recv[0]) return 0;
    if (strncmp(g_sb.recv, "Vec_", 4) != 0 && strncmp(g_sb.recv, "Map_", 4) != 0)
        return 0;
    return strcmp(g_sb.method, method) == 0;
}




/* Does the returned expression name `name`? A compound literal's fields are
   captured as text (`emit_raw_init`), so the node walk alone cannot see them. */
static int sb_ret_mentions(struct Emitter *self, int expr, const char *name)
{
    int r;
    if (expr < 0) return 0;
    if (self->node_mentions(expr, name)) return 1;
    r = expr;
    if (self->arena->nodes[r].kind == N_COMPOUND) r = self->arena->nodes[r].a;
    if (r >= 0 && self->arena->nodes[r].kind == N_RAW) {
        const char *txt = self->arena->str_at((int)self->arena->nodes[r].num);
        if (txt && sb_text_has_word(txt, name)) return 1;
    }
    return 0;
}

/* The releases before a `return`: everything in scope except the moved handle
   and, for a view / aggregate return, the handles the returned expression still
   names. */
static int sb_ret_release(struct Emitter *self, int expr, int view, int skip, int ind)
{
    int i;
    const char *pfx;
    for (i = g_sb.n - 1; i >= 0; i--) {
        if (i == skip || !g_sb.own[i]) continue;
        if (view && sb_ret_mentions(self, expr, g_sb.name[i])) continue;
        pfx = sb_life_prefix_text(self, g_sb.type[i]);
        if (!pfx) continue;
        self->emit_indent(ind);
        if (sb_life_needs_handle_guard(pfx))
            fprintf(self->out, "if (%s.h != 0) (void)%s_release(&%s);\n",
                    g_sb.name[i], pfx, g_sb.name[i]);
        else
            fprintf(self->out, "%s_release(&%s);\n", pfx, g_sb.name[i]);
    }
    return 0;
}

/* A `return` moving a tracked binding out: the handle leaves with the caller,
   so the callee must not release it. */
static int sb_ret_move(struct Emitter *self, int e)
{
    if (e < 0) return -1;
    if (self->arena->nodes[e].kind != N_VAR) return -1;
    return sb_find(self, self->arena->nodes[e].text2);
}

/* A `break` / `continue` leaves at least the innermost statement block, whose
   closing brace the jump skips: release that block's bindings first. */
/* The binding depth a `break` / `continue` must unwind to: the enclosing loop
   body (a `continue`) or the enclosing loop / switch body (a `break`), so a
   jump from a nested `if` releases every owning scope it leaves. */
static int sb_jump_base(struct Emitter *self, int is_cont)
{
    int i;
    (void)self;
    for (i = g_sb.nblk - 1; i >= 0; i--) {
        if (is_cont) {
            if (g_sb.bkind[i] == 1) return g_sb.blk[i];
        } else {
            if (g_sb.bkind[i] == 1 || g_sb.bkind[i] == 2) return g_sb.blk[i];
        }
    }
    if (g_sb.nblk > 0) return g_sb.blk[g_sb.nblk - 1];
    return 0;
}

static int sb_jump_release(struct Emitter *self, int ind, int is_cont)
{
    return sb_release_from(self, sb_jump_base(self, is_cont), -1, ind);
}

/* field-path bookkeeping: the key is (owner binding, `<base>.<field>`); a
   global base is known zero-initialised, a local base is known only after a
   definitely executed assignment. `fdepth` is the block depth of that
   assignment and `fmaybe` marks one made inside a branch / loop body, so a
   release never touches an undefined field. */
/* S1a-0 C2n-3: compare a stored `base.field` path with its two halves without
   building a 160-byte row. Both halves may be 159 bytes, so the old row cut
   the key and a field's definition state was looked up under a wrong path. */
static int sb_path_is(const char *path, const char *base, const char *field)
{
    size_t lb, lf;
    if (!path) return 0;
    lb = strlen(base);
    lf = strlen(field);
    return strlen(path) == lb + 1 + lf
        && strncmp(path, base, lb) == 0
        && path[lb] == '.'
        && strcmp(path + lb + 1, field) == 0;
}

static int sb_field_find(struct Emitter *self, int owner, const char *base, const char *field)
{
    int i;
    (void)self;
    for (i = g_sb.nfield - 1; i >= 0; i--)
        if (g_sb.fowner[i] == owner && sb_path_is(g_sb.fpath[i], base, field)) return i;
    return -1;
}

static void sb_field_mark(struct Emitter *self, const char *base, const char *field, int owner)
{
    int i;
    const char *want;
    if (g_sb.nfield >= 128) return;
    i = sb_field_find(self, owner, base, field);
    if (i >= 0) {
        /* a field already definitely defined at this or a shallower depth
           keeps that definition; only a conditional one is upgraded here */
        if (g_sb.fmaybe[i] || g_sb.fdepth[i] > g_sb.nblk) {
            g_sb.fdepth[i] = g_sb.nblk;
            g_sb.fmaybe[i] = 0;
        }
        return;
    }
    want = runtime::text::ct_intern_join(base, ".");
    want = want ? runtime::text::ct_intern_join(want, field) : (const char *)0;
    if (!want) return;              /* OOM: the field is not tracked */
    g_sb.fpath[g_sb.nfield] = want;
    g_sb.fowner[g_sb.nfield] = owner;
    g_sb.fdepth[g_sb.nfield] = g_sb.nblk;
    g_sb.fmaybe[g_sb.nfield] = 0;
    g_sb.nfield++;
}

/* A block is closing: drop the fields of locals declared inside it, and turn
   the fields only defined inside it into "maybe defined" at the enclosing
   depth. `keep_depth` is the surviving block depth, `keep_ln` the binding
   depth of the surviving locals. */
static void sb_field_merge(struct Emitter *self, int keep_depth, int keep_ln)
{
    int i, j = 0;
    (void)self;
    for (i = 0; i < g_sb.nfield; i++) {
        if (g_sb.fowner[i] >= keep_ln && g_sb.fowner[i] >= 0) continue;
        if (g_sb.fdepth[i] > keep_depth) {
            g_sb.fdepth[i] = keep_depth;
            g_sb.fmaybe[i] = 1;
        }
        /* the pool owns the text: compacting only moves the pointer */
        g_sb.fpath[j] = g_sb.fpath[i];
        g_sb.fowner[j] = g_sb.fowner[i];
        g_sb.fdepth[j] = g_sb.fdepth[i];
        g_sb.fmaybe[j] = g_sb.fmaybe[i];
        j++;
    }
    g_sb.nfield = j;
}

/* Snapshot the field table for an if-arm merge. */
static void sb_field_snap(struct Emitter *self, struct FldSnap *s)
{
    int i;
    (void)self;
    s->n = g_sb.nfield;
    for (i = 0; i < g_sb.nfield && i < 128; i++) {
        s->path[i] = g_sb.fpath[i];
        s->owner[i] = g_sb.fowner[i];
        s->defined[i] = g_sb.fmaybe[i] ? 0 : 1;
    }
}

static void sb_field_restore(struct Emitter *self, struct FldSnap *s)
{
    int i;
    (void)self;
    g_sb.nfield = s->n;
    for (i = 0; i < s->n && i < 128; i++) {
        g_sb.fpath[i] = s->path[i];
        g_sb.fowner[i] = s->owner[i];
        g_sb.fdepth[i] = g_sb.nblk;
        g_sb.fmaybe[i] = s->defined[i] ? 0 : 1;
    }
}

/* Look a key up in a snapshot; -1 when absent. */
static int sb_snap_find(struct FldSnap *s, int owner, const char *path)
{
    int i;
    for (i = 0; i < s->n; i++)
        if (s->owner[i] == owner && strcmp(s->path[i], path) == 0) return i;
    return -1;
}

/* Merge the two arms back into the live table: a field is defined after the
   `if` when it was defined before, or when both arms define it. */
static void sb_field_if_merge(struct Emitter *self, struct FldSnap *pre, struct FldSnap *thn, struct FldSnap *els)
{
    int i, j;
    (void)self;
    g_sb.nfield = 0;
    for (i = 0; i < pre->n; i++) {
        int ti = sb_snap_find(thn, pre->owner[i], pre->path[i]);
        int ei = sb_snap_find(els, pre->owner[i], pre->path[i]);
        int def = pre->defined[i] || ((ti >= 0 && thn->defined[ti]) && (ei >= 0 && els->defined[ei]));
        g_sb.fpath[g_sb.nfield] = pre->path[i];
        g_sb.fowner[g_sb.nfield] = pre->owner[i];
        g_sb.fdepth[g_sb.nfield] = g_sb.nblk;
        g_sb.fmaybe[g_sb.nfield] = def ? 0 : 1;
        g_sb.nfield++;
    }
    for (i = 0; i < thn->n; i++) {
        int pi = sb_snap_find(pre, thn->owner[i], thn->path[i]);
        int ei = sb_snap_find(els, thn->owner[i], thn->path[i]);
        int def;
        if (pi >= 0) continue;   /* already merged with the pre state */
        def = (thn->defined[i] && ei >= 0 && els->defined[ei]);
        if (g_sb.nfield >= 128) break;
        g_sb.fpath[g_sb.nfield] = thn->path[i];
        g_sb.fowner[g_sb.nfield] = thn->owner[i];
        g_sb.fdepth[g_sb.nfield] = g_sb.nblk;
        g_sb.fmaybe[g_sb.nfield] = def ? 0 : 1;
        g_sb.nfield++;
    }
    for (i = 0; i < els->n; i++) {
        int pi = sb_snap_find(pre, els->owner[i], els->path[i]);
        int ti = sb_snap_find(thn, els->owner[i], els->path[i]);
        if (pi >= 0 || ti >= 0) continue;   /* merged above */
        if (g_sb.nfield >= 128) break;
        g_sb.fpath[g_sb.nfield] = els->path[i];
        g_sb.fowner[g_sb.nfield] = els->owner[i];
        g_sb.fdepth[g_sb.nfield] = g_sb.nblk;
        g_sb.fmaybe[g_sb.nfield] = 1;
        g_sb.nfield++;
    }
    (void)j;
}

/* Mark the string fields of a struct local initialised by an aggregate
   literal: C zero-fills the omitted members, so every string field holds a
   valid (null or retained) handle after the initialiser. */
static void sb_mark_aggregate(struct Emitter *self, int decl)
{
    const char *tp = self->arena->nodes[decl].text;
    const char *txt;
    int si, fi, owner;
    if (self->arena->nodes[decl].a < 0) return;
    txt = sb_raw_text(self, self->arena->nodes[decl].a);
    if (!txt) return;
    while (*txt == ' ' || *txt == '\t' || *txt == '\n' || *txt == '\r') txt++;
    if (*txt != '{') return;
    /* S1a-0 C2p-8: a view of the declared spelling, not a 160-byte copy. */
    txt = tp;
    if (strncmp(txt, "struct ", 7) == 0) txt += 7;
    while (*txt == ' ') txt++;
    si = self->sym->find_struct(txt);
    if (si < 0) return;
    owner = g_sb.ln - 1;
    if (owner < 0) return;
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
        if (self->sym->structs[si].fields[fi].dims[0]) continue;
        if (!frontend::sym::ct_is_string_value_type(self->sym->structs[si].fields[fi].type))
            continue;
        sb_field_mark(self, g_sb.lname[owner], self->sym->structs[si].fields[fi].name, owner);
    }
}

/* Refuse a whole-struct assignment when the type owns a string field: a plain
   `h = other` would shallow-copy the handle and the field release would then
   free a buffer the source still owns. Assign the field explicitly instead. */
static int sb_struct_assign_check(struct Emitter *self, int n)
{
    const char *t;
    int lhs, rhs, rk;
    if (self->arena->nodes[n].kind != N_ASSIGN || self->arena->nodes[n].aux != 0) return 0;
    lhs = self->arena->nodes[n].a;
    if (lhs < 0 || self->arena->nodes[lhs].kind != N_VAR) return 0;
    t = sb_expr_type_text(self, lhs);
    if (!t) return 0;
    if (!sb_owning_struct_type(self, t)) return 0;
    /* a call result is a view / freshly handed-over aggregate (the documented
       `Map.entry` copy, a returned Result payload); only copying a stored
       place aliases an owning handle the source still owns */
    rhs = self->arena->nodes[n].b;
    if (rhs < 0) return 0;
    rk = self->arena->nodes[rhs].kind;
    if (rk != N_VAR && rk != N_MEMBER && rk != N_ARROW && rk != N_INDEX
        && rk != N_DEREF && rk != N_SLICE_INDEX) return 0;
    return self->fail_from(n,
        "whole-struct assignment would shallow-copy its owning String field;"
        " assign the field individually or use an explicit protocol");
}

/* The `String` / `U16String` declaration statement: retain the initialiser when
   it is another owner's place, zero-initialise a bare declaration so the scope
   release is always safe, and record the binding. 0 = not ours. */
static int sb_decl(struct Emitter *self, int n, int ind)
{
    const char *tp;
    const char *pfx;
    int kind, init, borrowed, adt, bind;
    if (self->arena->nodes[n].kind != N_DECL) return 0;
    tp = self->arena->nodes[n].text;
    kind = frontend::sym::ct_is_string_value_type(tp);
    /* LANG-29 S2 / B3: an ADT local is an owning binding; a match binding
       (aux 3) owns its payload copy for every owning payload type, including
       the containers and Box that an ordinary local still releases explicitly. */
    adt = !strchr(tp, '*') && (frontend::sym::ct_adt_from_type(tp) >= 0)
          && adt_owns(self, frontend::sym::ct_adt_from_type(tp), 0);
    bind = (self->arena->nodes[n].aux == 3) && sb_life_prefix_text(self, tp) != 0;
    /* a static local outlives the block; a shadowed auto-drop alias is not a
       plain binding; an array is not a value */
    if (self->arena->nodes[n].text3[0] || self->arena->nodes[n].aux == 1
        || self->arena->nodes[n].aux == 2) return 0;
    init = self->arena->nodes[n].a;
    if (!kind && !adt && !bind) {
        /* a plain local still records its declared type: `h.tag = s` needs it,
           and an aggregate initialiser defines every owning field (C zero-fills
           the omitted members) */
        sb_lpush(self, self->arena->nodes[n].text2, tp);
        sb_mark_aggregate(self, n);
        return 0;
    }
    if (kind && !bind && init >= 0) {
        int k = self->arena->nodes[init].kind;
        if (k == N_INIT_RANGE || k == N_INIT_BRACE || k == N_INIT_MBRACE
            || k == N_RAW || k == N_CLOSURE) return 0;
    }
    pfx = sb_life_prefix_text(self, tp);
    if (!pfx) {
        /* a pointer / otherwise untracked spelling is still a local whose type
           later member assignments resolve: fall back to the plain record. */
        sb_lpush(self, self->arena->nodes[n].text2, tp);
        sb_mark_aggregate(self, n);
        return 0;
    }
    if (self->hoist_rvalue(n) != 0) return -1;
    if (self->emit_hoists(ind) != 0) return -1;
    self->emit_indent(ind);
    if (self->emit_type_name_dims(tp, self->arena->nodes[n].text2,
                                  self->arena->nodes[n].text3) != 0) return -1;
    if (self->arena->nodes[n].aux == 3)
        fputs(" __attribute__((unused))", self->out);
    borrowed = 0;
    if (init < 0) {
        fputs(" = { 0 }", self->out);
    } else {
        int wrap, ik;
        ik = self->arena->nodes[init].kind;
        borrowed = (self->arena->nodes[n].sflags & 2) ? 1 : 0;
        wrap = !borrowed && !sb_rhs_fresh(self, init)
               && (sb_is_place(self, init)
                   || (ik == N_RAW
                       && sb_text_place_p(self->arena->nodes[init].aux
                              ? self->arena->str_at((int)self->arena->nodes[init].num)
                              : self->arena->nodes[init].text)));
        fputs(" = ", self->out);
        if (wrap) fprintf(self->out, "%s_retain(&(", pfx);
        if (self->emit_expr(init) != 0) return -1;
        if (wrap) fputs("))", self->out);
    }
    fputs(";\n", self->out);
    sb_lpush(self, self->arena->nodes[n].text2, tp);
    sb_push(self, self->arena->nodes[n].text2, tp, borrowed ? 0 : 1);
    return 1;
}

/* The `String` / `U16String` assignment statement. Reassignment keeps the
   contract order: hold the old handle, retain (or move) the right-hand side,
   then release the old value. A field / global / deref target is a storage
   position: a borrowed source is retained there so the view cannot outlive its
   container. A local bound to a borrowed view stays a view. */
static int sb_assign(struct Emitter *self, int n, int ind)
{
    const char *t;
    const char *fbase, *ffield;
    int kind, lhs, rhs, idx, borrowed, wrap, release_old, needsrc, k, fowner, param_own, ai;
    const char *pfx;

    if (self->arena->nodes[n].kind != N_ASSIGN || self->arena->nodes[n].aux != 0)
        return 0;
    lhs = self->arena->nodes[n].a;
    rhs = self->arena->nodes[n].b;
    if (lhs < 0 || rhs < 0) return 0;
    k = self->arena->nodes[lhs].kind;
    if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX
        && k != N_DEREF && k != N_SLICE_INDEX) return 0;
    g_sb.hitparam = 0;
    t = sb_expr_type_text(self, lhs);
    if (!t) {
        /* LANG-29 S4 / B5: the expression-match result temporary is declared
           by the compiler's own statement expression, so it is not in the
           symbol table; the parser stamped its type on the assignment. */
        if (!(k == N_VAR && self->arena->nodes[n].text[0])) return 0;
        t = self->arena->nodes[n].text;
    }
    kind = frontend::sym::ct_is_string_value_type(t);
    /* LANG-29 S2 / B3: rebinding an owning ADT follows the same contract as a
       String rebind (hold the old value, retain or move the source, release
       the old). A container local still releases explicitly (unchanged). */
    if (!kind) {
        ai = frontend::sym::ct_adt_from_type(t);
        if (ai < 0 || !adt_owns(self, ai, 0)) return 0;
    }
    if (g_sb.hitparam) return 0;
    pfx = sb_life_prefix_text(self, t);
    if (!pfx) return 0;
    t = sb_norm_own_type_text(self, t);
    if (!t) return -1;
    if (self->hoist_rvalue(n) != 0) return -1;
    if (self->emit_hoists(ind) != 0) return -1;
    idx = (k == N_VAR) ? sb_find(self, self->arena->nodes[lhs].text2) : -1;
    /* P-5.2 (SH-117): an `out` / `ref` owning string target is the caller's
       storage, not a tracked local. The caller-side rule already requires an
       owning `out` actual to hold a value, and a `ref` alias names the
       caller's value. The assignment site therefore follows the same order as
       a local rebind: hold the old handle, retain (or move) the right-hand
       side, write, then release the old value. Without the release the
       caller's previous buffer leaks; without the retain two handles share one
       reference. */
    param_own = (k == N_VAR
                 && (self->arena->nodes[lhs].aux == 2
                     || self->arena->nodes[lhs].aux == 3));
    borrowed = (self->arena->nodes[n].sflags & 2) ? 1 : 0;
    /* a storage position owns a reference even for a borrowed source; a local
       keeps the borrow. Only a place can be address-taken directly, so a
       borrowed rvalue (`h.tag = v.get(0)`) goes through a temporary. */
    if (k != N_VAR) wrap = (borrowed || sb_is_place(self, rhs));
    else wrap = (!borrowed && sb_is_place(self, rhs));
    needsrc = wrap && !sb_is_place(self, rhs);
    release_old = (idx >= 0 && g_sb.own[idx] && !borrowed) || param_own;
    fbase = "";
    ffield = "";
    fowner = -1;
    /* Only a `member` target of a plain variable base is tracked. An arrow
       (`p->tag`) may alias any object, so its old value is not released (the
       leak is registered); an index target is the container glue's job. */
    if (!borrowed && k == N_MEMBER && sb_field_key(self, lhs, &fbase, &ffield, &fowner)) {
        int maybe = 0, st = sb_field_state(self, fowner, fbase, ffield, &maybe);
        if (fowner >= 0 && (maybe || (st < 0 && sb_field_loop_unsafe(self, fowner)))) {
            /* S1a-0 C2n-3: the message repeats a generated `base.field`
               key; both halves can be 159 bytes, so the 320-byte row cut it. */
            const char *fmsg;
            fmsg = tool::sh::ct_scratch_fmt(
                     "field '%s.%s' may be undefined before this assignment;"
                     " the compiler cannot release the old owning value safely"
                     " (initialise the struct with '{ 0 }', or release it explicitly)",
                     fbase, ffield);
            return self->fail_from(n, fmsg);
        }
        if (st >= 0 && !maybe) release_old = 1;
    }
    self->emit_indent(ind);
    fputs("{ ", self->out);
    if (release_old) {
        fprintf(self->out, "%s __ct_sold%d = ", t, self->ntmp);
        if (self->emit_expr(lhs) != 0) return -1;
        fputs("; ", self->out);
        self->ntmp++;
    }
    if (needsrc) {
        fprintf(self->out, "%s __ct_src%d = ", t, self->ntmp);
        if (self->emit_expr(rhs) != 0) return -1;
        fputs("; ", self->out);
        self->ntmp++;
    }
    if (self->emit_expr(lhs) != 0) return -1;
    fputs(" = ", self->out);
    if (wrap) fprintf(self->out, "%s_retain(&(", pfx);
    if (needsrc) fprintf(self->out, "__ct_src%d", self->ntmp - 1);
    else if (self->emit_expr(rhs) != 0) return -1;
    if (wrap) fputs("))", self->out);
    fputs("; ", self->out);
    if (release_old)
        fprintf(self->out, "%s_release(&__ct_sold%d); ", pfx, self->ntmp - 1);
    fputs("}\n", self->out);
    if (idx >= 0) g_sb.own[idx] = borrowed ? 0 : 1;
    if ((k == N_MEMBER || k == N_ARROW) && fbase[0])
        sb_field_mark(self, fbase, ffield, fowner);
    return 1;
}
/* Register a body's by-value string parameters (the retain is written by
   `sb_retain_params` once the opening brace exists). */
static int sb_push_params(struct Emitter *self, int first, int anon)
{
    int p, ai, ai2;
    char uname[32];
    g_sb.n = 0;
    g_sb.ln = 0;
    g_sb.nblk = 0;
    ai = 0;
    for (p = first; p >= 0; p = self->arena->nodes[p].next) {
        const char *nm = self->arena->nodes[p].text2;
        if (!nm[0] && anon) {
            snprintf(uname, sizeof uname, "__arg%d", ai);
            nm = uname;
        }
        if (nm[0] && self->arena->nodes[p].text3[0] == 0) {
            /* P-5.2 (SH-117): a `ref` / `out` parameter is not an owning
               binding (no entry retain, no scope release), but its base type
               must stay resolvable: the assignment to `(*name)` is an owning
               assignment for `sb_assign`, exactly like a local rebind. */
            sb_lpush(self, nm, self->arena->nodes[p].text);
            if (self->arena->nodes[p].aux != 2 && self->arena->nodes[p].aux != 3) {
                /* LANG-29 S2 / B3: a by-value ADT parameter owns a reference
                   for the duration of the body, exactly like a String one. */
                ai2 = strchr(self->arena->nodes[p].text, '*')
                        ? -1 : frontend::sym::ct_adt_from_type(self->arena->nodes[p].text);
                if (frontend::sym::ct_is_string_value_type(self->arena->nodes[p].text)
                    || (ai2 >= 0 && adt_owns(self, ai2, 0)))
                    sb_push(self, nm, self->arena->nodes[p].text, 1);
            }
        }
        ai++;
    }
    return 0;
}

/* The entry retain of every registered by-value owning parameter. */
static int sb_retain_params(struct Emitter *self, int ind)
{
    int i;
    const char *pfx;
    for (i = 0; i < g_sb.n; i++) {
        if (!g_sb.own[i]) continue;
        pfx = sb_life_prefix_text(self, g_sb.type[i]);
        if (!pfx) continue;
        self->emit_indent(ind);
        fprintf(self->out, "%s = %s_retain(&%s);\n", g_sb.name[i], pfx, g_sb.name[i]);
    }
    return 0;
}

/* Release every binding in scope before a `return` (or at the body's end). */
static int sb_end_body(struct Emitter *self, int ind)
{
    int r;
    r = sb_release_from(self, 0, -1, ind);
    g_sb.n = 0;
    g_sb.ln = 0;
    g_sb.nblk = 0;
    return r;
}

/* Does the impl node `node` write `name`? */



/* Does this file-scope global still need a constructor write? An initialised
   array whose literal carries the element vptrs does not (`emit_elem_vptrs`);
   neither does a scalar, a `{ 0 }` array, or anything without a reachable slot.
   Both passes below must agree, or the constructor is emitted without a body. */
static int unit_init_needed(struct Emitter *e, int n)
{
    const char *lit;
    int a;

    if (e->arena->nodes[n].kind != N_GLOBAL) return 0;
    if (!e->init->type_needs_init(e->arena->nodes[n].text)) return 0;
    if (!e->arena->nodes[n].text3[0] && !e->ty->type_has_array_init(e->arena->nodes[n].text)) return 0;
    a = e->arena->nodes[n].a;
    if (a >= 0 && e->arena->nodes[a].kind == N_RAW && e->arena->nodes[n].text3[0]
        && e->init->type_has_vptr(e->arena->nodes[n].text)
        && !e->init->type_needs_nested_init(e->arena->nodes[n].text)) {
        lit = e->arena->nodes[a].aux ? e->arena->str_at((int)e->arena->nodes[a].num)
                                     : e->arena->nodes[a].text;
        if (init_has_elem_groups(lit)) return 0;
    }
    return 1;
}

/* Is there an impl of `tname` for struct `si` in any unit of this run? A struct
   may be defined in one unit and implemented in another (`test/modules/split`),
   so a per-unit view would wrongly synthesise defaults twice. The arena holds
   every unit's nodes. */
/* S1a-0 C2p-5: the pool-text form of `emit_gsub_type`, built with the growable
   text builder so a 2000-byte type argument is not cut at 160. NULL means no
   substitution applies (the caller keeps its own spelling). */
static const char *emit_gsub_type_text(struct Emitter *self, const char *type)
{
    const char *cur;
    int i;

    if (self->gtntparam <= 0) return (const char *)0;
    cur = type ? type : "";
    for (i = 0; i < self->gtntparam; i++) {
        if (!self->gtparam[i] || !self->gtparam[i][0]) continue;
        if (!self->gtarg[i]) continue;
        cur = frontend::sym::ct_generic_subst_text(cur, self->gtparam[i],
                                                    self->gtarg[i]);
        if (!cur) return (const char *)0;
    }
    /* A substituted spelling may still name an instance. The char* reader is
       given a formal-limit block so an ordinary instance still resolves; a
       spelling past it keeps the template-shaped answer, exactly as before. */
    if (strchr(cur, '<')) {
        char *res = (char *)malloc(TEXT_LIMIT);
        const char *pooled;
        if (!res) return (const char *)0;
        if (frontend::sym::ct_inst_resolve(cur, res, TEXT_LIMIT) != 0) {
            free(res);
            return (const char *)0;
        }
        pooled = runtime::text::ct_intern(res);
        free(res);
        return pooled;
    }
    return cur;
}

/* A (struct, trait) pair that needs no `impl` at all: every method has a
   default body (D-3: the `use` clause is the adoption). */
static int adoption_default_only(struct Emitter *e, int si, const char *tname)
{
    int ti, mi;
    ti = e->sym->find_trait(tname);
    if (ti < 0) return 0;
    if (impl_exists_anywhere(e->arena, si, tname)) return 0;
    if (e->sym->traits[ti].nm == 0) return 0;
    for (mi = 0; mi < e->sym->traits[ti].nm; mi++)
        if (e->sym->traits[ti].m[mi].body < 0) return 0;
    return 1;
}

/* The first `self->field` a default body names that `struct si` does not
   define. The body is written once against an unknown struct, so this is the
   per-struct check D-7 turns into an expansion diagnostic. */
/* Expand trait method `mi` of `ti` for struct `si`: the default body is a
   normal impl body once `self` is bound to `struct <S> *`, so dispatch inside
   it keeps the existing emission rule and the vtable slot stays unchanged. */
static int emit_default_method(struct Emitter *e, int si, const char *stype, int ti, int mi, int at)
{
    struct MethodSig *sig;
    int p, k, ai;
    char uname[32];
    const char *fld;
    const char *msg;

    sig = &e->sym->traits[ti].m[mi];
    fld = default_missing_field_text(e->arena, sig->body, e->sym, si);
    if (fld) {
        /* S1a-0 C2n-3: five symbols, each up to 159 bytes; the old 512-byte
           row could still cut the tail. */
        msg = tool::sh::ct_scratch_fmt(
                 "trait %s::%s (declared at %s:%d) cannot be expanded for struct %s: no field '%s'",
                 e->sym->traits[ti].name, sig->name, e->sym->traits[ti].path,
                 sig->line, e->sym->structs[si].name, fld);
        return e->fail_from(at, msg);
    }
    fprintf(e->out, "static %s ", sig->ret);
    fprintf(e->out, "%s_%s_%s(void *self",
            e->sym->structs[si].name, e->sym->traits[ti].name, sig->name);
    ai = 0;
    for (p = sig->pnode; p >= 0; p = e->arena->nodes[p].next) {
        fputs(", ", e->out);
        if (e->arena->nodes[p].text2[0]) {
            if (e->arena->nodes[p].aux == 2 || e->arena->nodes[p].aux == 3) {
                /* S1a-0 C2n-3: `type + " *"` is generated text (`159 + 2`); a
                   160-byte row could drop the pointer. */
                const char *pbuf;
                pbuf = tool::sh::ct_scratch_fmt("%s *", e->arena->nodes[p].text);
                if (e->emit_type_name_dims(pbuf, e->arena->nodes[p].text2,
                                           e->arena->nodes[p].text3) != 0) return -1;
            } else if (e->emit_type_name_dims(e->arena->nodes[p].text, e->arena->nodes[p].text2,
                                              e->arena->nodes[p].text3) != 0) return -1;
        } else {
            snprintf(uname, sizeof uname, "__arg%d", ai);
            if (e->arena->nodes[p].aux == 2 || e->arena->nodes[p].aux == 3) {
                /* S1a-0 C2n-3: `type + " *"` is generated text (`159 + 2`); a
                   160-byte row could drop the pointer. */
                const char *pbuf;
                pbuf = tool::sh::ct_scratch_fmt("%s *", e->arena->nodes[p].text);
                if (e->emit_type_name_dims(pbuf, uname,
                                           e->arena->nodes[p].text3) != 0) return -1;
            } else if (e->emit_type_name_dims(e->arena->nodes[p].text, uname,
                                              e->arena->nodes[p].text3) != 0) return -1;
        }
        ai++;
    }
    fputs(") {\n", e->out);
    fprintf(e->out, "    %s *_self = (%s *)self;\n", stype, stype);
    /* SH-102: retain the method's by-value string parameters at entry. */
    g_sb.method = runtime::text::ct_intern(sig->name);
    g_sb.recv = runtime::text::ct_intern(stype);
    if (!g_sb.method || !g_sb.recv) return e->fail("out of memory");
    sb_push_params(e, sig->pnode, 1);
    sb_retain_params(e, 1);
    e->sym->self_mode = 1;
    ai = 0;
    for (p = sig->pnode; p >= 0; p = e->arena->nodes[p].next) {
        if (e->arena->nodes[p].text2[0]) {
            if (!e->node_mentions(sig->body, e->arena->nodes[p].text2))
                fprintf(e->out, "    (void)%s;\n", e->arena->nodes[p].text2);
        } else {
            snprintf(uname, sizeof uname, "__arg%d", ai);
            fprintf(e->out, "    (void)%s;\n", uname);
        }
        ai++;
    }
    if (!e->node_mentions(sig->body, "self")) fputs("    (void)_self;\n", e->out);
    /* Phase 44: a postfix `?` in a default body propagates the method's own
       return type. */
    e->cur_ret = runtime::text::ct_intern(sig->ret);
    if (!e->cur_ret) return e->fail("out of memory");
    k = e->arena->nodes[sig->body].a;
    while (k >= 0) {
        if (e->emit_node(k, 1) != 0) {
            e->sym->self_mode = 0;
            return -1;
        }
        k = e->arena->nodes[k].next;
    }
    sb_end_body(e, 1);
    e->sym->self_mode = 0;
    fputs("}\n\n", e->out);
    return 0;
}

/* Is map `i` declared by a unit in the current unit's transitive import
   closure? Compile mode (`cur_unit < 0`) has one unit, so every map belongs to
   it. A `.m.ct` unit can only be used through `import`. */
static int map_visible(struct Emitter *e, int i)
{
    char *reach;
    int u, d, k, changed;
    if (e->cur_unit < 0) return 1;
    if ((*e->maps)[i].unit == e->cur_unit) return 1;
    if (ensure_reach(e, *e->nunits) != 0) return e->fail("out of memory");
    reach = e->reach;
    for (u = 0; u < *e->nunits; u++) reach[u] = 0;
    reach[e->cur_unit] = 1;
    changed = 1;
    while (changed) {
        changed = 0;
        for (d = 0; d < (*e->nunits); d++) {
            if (!reach[d]) continue;
            for (k = 0; k < e->units[d].ndep; k++) {
                int dep = e->units[d].depu[k];
                if (dep >= 0 && dep < *e->nunits && !reach[dep]) {
                    reach[dep] = 1;
                    changed = 1;
                }
            }
        }
    }
    return (*e->maps)[i].unit >= 0 && (*e->maps)[i].unit < *e->nunits
           && reach[(*e->maps)[i].unit];
}

/* The file name of a unit path, for a diagnostic that must name both
   candidates inside the 160-byte message cap. */
/* LANG-29 S4 / B4: the comparison key of a `map binding` pair. Same
   normalisation as the parser's `bind_conv_key`: `type_key` folds whitespace
   and integer aliases, then the aggregate tag is dropped so `Node` and
   `struct Node` are the same key. */
/* The prologue of the map closure: every `#include` / `#define` line of an
   imported `.m.ct` unit, deduplicated by whole line. Emitted only in build
   mode, where the unit table exists. */
static int emit_map_prologues(struct Emitter *e, int u)
{
    char *reach;
    char seen[64][256];
    char line[256];
    int nseen, d, k, n, i, dup, changed;
    if (ensure_reach(e, *e->nunits) != 0) return e->fail("out of memory");
    reach = e->reach;
    for (i = 0; i < *e->nunits; i++) reach[i] = 0;
    reach[u] = 1;
    changed = 1;
    while (changed) {
        changed = 0;
        for (d = 0; d < (*e->nunits); d++) {
            if (!reach[d]) continue;
            for (k = 0; k < e->units[d].ndep; k++) {
                int dep = e->units[d].depu[k];
                if (dep >= 0 && dep < *e->nunits && !reach[dep]) {
                    reach[dep] = 1;
                    changed = 1;
                }
            }
        }
    }
    nseen = 0;
    for (d = 0; d < (*e->nunits); d++) {
        if (!reach[d] || !e->units[d].is_map || e->units[d].prog < 0) continue;
        /* A sibling `.shim.h` declares what a recipe cannot spell: macro
           wrappers, global accessors, variadic forwarders. It leads the unit's
           prologue, because that unit's `#include`s may feed the shim. */
        if (e->units[d].has_shim) {
            snprintf(line, sizeof line, "#include \"%s.shim.h\"", e->units[d].base);
            dup = 0;
            for (i = 0; i < nseen; i++)
                if (strcmp(seen[i], line) == 0) dup = 1;
            if (!dup) {
                if (nseen < 64) {
                    snprintf(seen[nseen], 256, "%s", line);
                    nseen++;
                }
                fprintf(e->out, "%s\n", line);
            }
        }
        for (n = e->arena->nodes[e->units[d].prog].a; n >= 0; n = e->arena->nodes[n].next) {
            if (e->arena->nodes[n].kind != N_PP) continue;
            if ((e->io_mask & 1)
                && strcmp(e->arena->nodes[n].text, "#include <stdio.h>") == 0) continue;
            if ((e->io_mask & 2)
                && strcmp(e->arena->nodes[n].text, "#include <wchar.h>") == 0) continue;
            dup = 0;
            for (i = 0; i < nseen; i++)
                if (strcmp(seen[i], e->arena->nodes[n].text) == 0) dup = 1;
            if (dup) continue;
            if (nseen < 64) {
                snprintf(seen[nseen], 256, "%s", e->arena->nodes[n].text);
                nseen++;
            }
            fprintf(e->out, "%s\n", e->arena->nodes[n].text);
        }
    }
    if (nseen > 0) fputs("\n", e->out);
    return 0;
}

/* The parameter's declared type, without array dims (a compound literal needs
   the base type). */
/* The C spelling of a trait (`a_ALen`) for diagnostics. The source spelling
   (`a::ALen`) cannot be rebuilt from the recorded name: a namespace segment may
   itself contain `_`, so turning every `_` back into `::` invents segments
   (`my_lib` would print as `my::lib`, which no source line can resolve). The C
   name is what the generated file actually uses, and it stays unambiguous. */
/* Phase 25.2: the two halves of a closure actual and the scope table that says
   whether a name is one are written further down, but the recipe expansion
   needs them here. */
static int closure_var_lookup(struct Emitter *self, const char *name);
static int emit_closure_fn(struct Emitter *self, int n);
static int emit_closure_env(struct Emitter *self, int n);

/* How many recipe slots an actual fills: a closure literal, or a variable bound
   to one, is a `(fn, env)` pair and takes two (D25-4); everything else one. */
static int map_actual_slots(struct Emitter *e, int n)
{
    if (n < 0) return 1;
    if (e->arena->nodes[n].kind == N_CLOSURE) return 2;
    if (e->arena->nodes[n].kind == N_VAR
        && closure_var_lookup(e, e->arena->nodes[n].text2) >= 0) return 2;
    return 1;
}

/* The actual for binding parameter `idx`: a type host's parameter 0 is the
   receiver, the rest walk the call's argument chain counting a closure actual
   as the two slots it fills. `*half` reports which slot of that actual `idx`
   asks for: 0 a whole actual, 1 the `fn` half, 2 the `env` half. */
static int map_actual_span(struct Emitter *e, int recv, int args, int type_host, int idx, int *half)
{
    int n = args;
    int slot = 0;
    int span;

    *half = 0;
    if (type_host) {
        if (idx == 0) return recv;
        idx--;
    }
    while (n >= 0) {
        span = map_actual_slots(e, n);
        if (idx < slot + span) {
            if (span == 2) *half = (idx == slot) ? 1 : 2;
            return n;
        }
        slot += span;
        n = e->arena->nodes[n].next;
    }
    return -1;
}

/* Emit one recipe slot: a closure half prints a single symbol of the pair, so
   the recipe can place `fn` and `env` independently (D25-4 / D25-7). A closure
   variable prints the same pair from its own stack instance. */
static int map_emit_actual(struct Emitter *e, int n, int half)
{
    int cv;

    if (half == 0) {
        int k = e->arena->nodes[n].kind;
        if (k == N_INTO || k == N_INTO_SELF) {
            /* A type host's first binding parameter is by value, so the
               receiver prints its value form even when the block spelled it
               with a leading `.` (aux==1, the pointer role). */
            int ow = (k == N_INTO) ? n : e->arena->nodes[n].num;
            const char *nm = e->arena->nodes[ow].text3;
            if (e->arena->nodes[ow].aux == 2) fprintf(e->out, "(*%s)", nm);
            else fputs(nm, e->out);
            return 0;
        }
        return e->emit_expr(n);
    }
    if (e->arena->nodes[n].kind == N_CLOSURE) {
        if (half == 1) return emit_closure_fn(e, n);
        return emit_closure_env(e, n);
    }
    cv = closure_var_lookup(e, e->arena->nodes[n].text2);
    if (cv < 0) return e->fail_from(n, "cannot resolve a closure argument");
    if (half == 1) fprintf(e->out, "__ct_cl_tramp_%d", cv);
    else fprintf(e->out, "&__ct_cl_env_v_%d", cv);
    return 0;
}

/* A repeated recipe occurrence may not evaluate a side effect twice. */
/* The callee of a recipe (`atoi` in `atoi(s)`), for the map JSON.
   S1a-0 C2p-8: the parameter spelling is already a pool text on both rows
   (`MapTable.host_type`, `MethodSig.ptype`), so return it whole; a caller
   row was the last 160-byte cut on a 2000-byte host type. */
static const char *map_param_type_text(struct Emitter *e, struct MapTable *m,
                                       struct MapBind *b, int i)
{
    int k;
    if (m->type_host && i == 0) return m->host_type;
    k = m->type_host ? i - 1 : i;
    if (k < 0 || k >= e->sym->traits[b->ti].m[b->mi].nparams) return (const char *)0;
    return e->sym->traits[b->ti].m[b->mi].ptype[k];
}

/* Copy one balanced `[…]` group from `s`; returns the position after it. */
static const char *map_copy_brackets(struct Emitter *e, const char *s)
{
    int depth = 0;
    do {
        if (*s == '\'' || *s == '"') {
            int q = (unsigned char)*s;
            fputc(*s, e->out);
            s++;
            while (*s) {
                fputc(*s, e->out);
                if (*s == '\\' && *(s + 1)) {
                    s++;
                    fputc(*s, e->out);
                } else if ((unsigned char)*s == q) {
                    s++;
                    break;
                }
                s++;
            }
            continue;
        }
        if (*s == '[') depth++;
        if (*s == ']') depth--;
        fputc(*s, e->out);
        s++;
    } while (depth > 0 && *s);
    return s;
}

/* Emit one recipe argument span, substituting the binding parameters (spec
   §4.10): `p`, `&p`, `&p[…]`, `sizeof p`, `p.field` / `p->field` / `p[i]`. */
static int map_subst_arg(struct Emitter *e, const char *s, struct MapTable *m, struct MapBind *b, int *actual, int *half)
{
    const char *tok;
    const char *tp;
    int i, n;

    while (*s) {
        if (*s == '\'' || *s == '"') {
            int q = (unsigned char)*s;
            fputc(*s, e->out);
            s++;
            while (*s) {
                fputc(*s, e->out);
                if (*s == '\\' && *(s + 1)) {
                    s++;
                    fputc(*s, e->out);
                } else if ((unsigned char)*s == q) {
                    s++;
                    break;
                }
                s++;
            }
            continue;
        }
        if (*s == '&') {
            const char *q = s + 1;
            while (*q == ' ' || *q == '\t') q++;
            n = 0;
            while (map_is_ident((unsigned char)q[n])) n++;
            tok = n > 0 ? runtime::text::ct_intern_len(q, n) : (const char *)0;
            if (n > 0 && !tok) return -1;
            i = (n > 0) ? map_param_index(b, tok) : -1;
            if (i >= 0) {
                const char *r = q + n;
                const char *clean;
                while (*r == ' ' || *r == '\t') r++;
                if (*r == '[') {
                    tp = map_param_type_text(e, m, b, i);
                    if (!tp) return -1;
                    fputs("&((", e->out);
                    if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
                    fputc(')', e->out);
                    s = map_copy_brackets(e, r);
                    fputc(')', e->out);
                    continue;
                }
                tp = map_param_type_text(e, m, b, i);
                if (!tp) return -1;
                clean = map_clean_type_text(tp);
                if (!clean) return -1;
                fprintf(e->out, "&(%s){", clean);
                if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
                fputc('}', e->out);
                s = r;
                continue;
            }
        }
        if (map_is_ident((unsigned char)*s)
            && !(*s >= '0' && *s <= '9')) {
            const char *tokstart = s;
            n = 0;
            while (map_is_ident((unsigned char)*s)) {
                n++;
                s++;
            }
            tok = runtime::text::ct_intern_len(tokstart, n);
            if (!tok) return -1;
            /* `sizeof p` -> `sizeof(TP)`: no evaluation */
            if (strcmp(tok, "sizeof") == 0) {
                const char *q = s;
                const char *nm;
                int nn;
                while (*q == ' ' || *q == '\t') q++;
                nn = 0;
                while (map_is_ident((unsigned char)q[nn])) nn++;
                nm = nn > 0 ? runtime::text::ct_intern_len(q, nn) : (const char *)0;
                if (nn > 0 && !nm) return -1;
                i = (nn > 0) ? map_param_index(b, nm) : -1;
                if (i >= 0) {
                    const char *clean;
                    tp = map_param_type_text(e, m, b, i);
                    if (!tp) return -1;
                    clean = map_clean_type_text(tp);
                    if (!clean) return -1;
                    fprintf(e->out, "sizeof(%s)", clean);
                    s = q + nn;
                    continue;
                }
                fputs("sizeof", e->out);
                continue;
            }
            i = map_param_index(b, tok);
            if (i < 0) {
                fputs(tok, e->out);
                continue;
            }
            /* a member / index suffix keeps the table's parenthesised shape;
               the suffix is printed straight from the source span (no row). */
            {
                const char *sufstart = s;
                for (;;) {
                    if (*s == '.') {
                        s++;
                        while (map_is_ident((unsigned char)*s)) s++;
                        continue;
                    }
                    if (*s == '-' && *(s + 1) == '>') {
                        s += 2;
                        while (map_is_ident((unsigned char)*s)) s++;
                        continue;
                    }
                    if (*s == '[') {
                        int depth = 0;
                        do {
                            if (*s == '[') depth++;
                            if (*s == ']') depth--;
                            s++;
                        } while (depth > 0 && *s);
                        continue;
                    }
                    break;
                }
                if (s > sufstart) fputs("((", e->out);
                else fputc('(', e->out);
                if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
                if (s > sufstart) {
                    fputc(')', e->out);
                    fprintf(e->out, "%.*s", (int)(s - sufstart), sufstart);
                    fputc(')', e->out);
                } else {
                    fputc(')', e->out);
                }
            }
            continue;
        }
        fputc(*s, e->out);
        s++;
    }
    return 0;
}

/* Expand one static recipe at the call site (spec §4.10): no wrapper,
   no vtable, the call is what a hand-written `.c` would say. `actual`/`half`
   are the caller's per-parameter scratch (see `emit_recipe`). */
static int emit_recipe_impl(struct Emitter *e, struct MapTable *m, struct MapBind *b,
                            int recv, int args, int at, int *actual, int *half)
{
    const char *arg;
    char msg[512];
    int i, hk, unused, first, depth, n, q;
    const char *p;

    for (i = 0; i < b->nparams; i++) {
        actual[i] = map_actual_span(e, recv, args, m->type_host, i, &half[i]);
        if (actual[i] < 0)
            return e->fail_from(at, "a map call has fewer arguments than its binding");
        /* A closure half that the recipe never names would fall into the
           `(void)(…)` branch, which has no C spelling for one half of the pair:
           the whole pair must be used (D25-5). */
        if (half[i] != 0 && b->uses[i] == 0)
            return e->fail_from(at, "a map recipe must use both halves of a closure argument");
        /* D25-5: a closure pair is referenced at most once per half; a second
           mention would hand the same trampoline to two formals. */
        if (half[i] != 0 && b->uses[i] >= 2)
            return e->fail_from(at, "a map recipe must use a closure argument exactly once");
        if (b->uses[i] >= 2 && !map_repeatable(e->arena, actual[i])) {
            snprintf(msg, sizeof msg,
                     "map recipe uses '%s' more than once; bind the argument to a local first",
                     b->params[i]);
            return e->fail_from(at, msg);
        }
    }
    unused = 0;
    for (i = 0; i < b->nparams; i++) if (b->uses[i] == 0) unused = 1;
    if (unused) fputc('(', e->out);
    for (i = 0; i < b->nparams; i++)
        if (b->uses[i] == 0) {
            fputs("(void)(", e->out);
            if (map_emit_actual(e, actual[i], half[i]) != 0) return -1;
            fputs("), ", e->out);
        }
    p = b->call;
    while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
    {
        const char *cal = p;
        n = 0;
        while (map_is_ident((unsigned char)*p)) {
            n++;
            p++;
        }
        fprintf(e->out, "%.*s", n, cal);
    }
    while (*p == ' ' || *p == '\t') p++;
    if (*p != '(') return e->fail_from(at, "a map recipe must be a single call");
    fputc('(', e->out);
    p++;
    first = 1;
    for (;;) {
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
        if (*p == ')') { p++; break; }
        if (*p == 0) return e->fail_from(at, "a map recipe must be a single call");
        {
            const char *astart = p;
            const char *aend;
            n = 0;
            depth = 0;
            while (*p) {
                if (depth == 0 && (*p == ',' || *p == ')')) break;
                if (*p == '\'' || *p == '"') {
                    q = (unsigned char)*p;
                    p++;
                    while (*p) {
                        if (*p == '\\' && *(p + 1)) {
                            p += 2;
                            continue;
                        }
                        if ((unsigned char)*p == q) {
                            p++;
                            break;
                        }
                        p++;
                    }
                    continue;
                }
                if (*p == '(') depth++;
                else if (*p == ')') depth--;
                p++;
            }
            aend = p;
            while (aend > astart && (aend[-1] == ' ' || aend[-1] == '\t')) aend--;
            arg = tool::sh::ct_scratch_fmt("%.*s", (int)(aend - astart), astart);
            n = (int)(aend - astart);
            (void)n;
        }
        /* `...` forwards every actual the binding parameters did not consume;
           an empty tail emits nothing, not a dangling separator. A closure
           cannot be forwarded: the tail has no fixed slot for its two halves
           (D25-5). */
        if (strcmp(arg, "...") == 0) {
            int k, a;
            for (k = b->nparams; (a = map_actual_span(e, recv, args,
                                                      m->type_host, k, &hk)) >= 0; k++) {
                if (hk != 0)
                    return e->fail_from(at, "a map recipe cannot pass a closure through '...'");
                if (!first) fputs(", ", e->out);
                fputc('(', e->out);
                e->emit_expr(a);
                fputc(')', e->out);
                first = 0;
            }
        } else {
            if (!first) fputs(", ", e->out);
            if (map_subst_arg(e, arg, m, b, actual, half) != 0) return -1;
            first = 0;
        }
        if (*p == ',') { p++; continue; }
        if (*p == ')') { p++; break; }
        return e->fail_from(at, "a map recipe must be a single call");
    }
    fputc(')', e->out);
    if (unused) fputc(')', e->out);
    return 0;
}

/* S1a-0 C1: one recipe's per-parameter scratch, sized to the binding (the old
   `int actual[16]` overflowed past 16 parameters). It is a per-invocation block
   rather than shared state because a recipe may name another map call as its
   receiver: the nested expansion must not overwrite the outer call's spans. */
static int emit_recipe(struct Emitter *e, struct MapTable *m, struct MapBind *b,
                       int recv, int args, int at)
{
    int n, rc;
    int *actual;
    int *half;
    n = b->nparams > 0 ? b->nparams : 1;
    actual = (int *)calloc((size_t)n, sizeof(*actual));
    half = (int *)calloc((size_t)n, sizeof(*half));
    if (!actual || !half) {
        free(actual);
        free(half);
        return e->fail("out of memory");
    }
    rc = emit_recipe_impl(e, m, b, recv, args, at, actual, half);
    free(actual);
    free(half);
    return rc;
}

/* A raw block is written byte for byte, never indented or rewritten. Its
   lines are not the source's lines, so `#line` is re-anchored on the line
   after the closing marker: the block starts on the line after `#ct-raw`
   (directive line + 1), spans `nl` newlines, and the next line follows the
   `#ct-endraw` line. */
static int emit_raw_text(struct Emitter *self, int n)
{
    const char *text;
    int i;
    int nl = 0;

    text = self->arena->str_at((int)self->arena->nodes[n].num);
    for (i = 0; text[i]; i++)
        if (text[i] == '\n') nl++;
    fputs(text, self->out);
    if (i > 0 && text[i - 1] != '\n') fputc('\n', self->out);
    if ((*self->line_mode))
        fprintf(self->out, "#line %d \"%s\"\n", self->arena->nodes[n].line + nl + 2, self->path);
    return 0;
}

/* Does this closure belong to the function the emitter is writing? `owner` is
   the parser's `cur_func` (the short name of a function, or
   `<Struct>_<Trait>_<method>` for an impl method); the node carries the C
   spelling, which is the mangled one inside a namespace. */
static int closure_owned(struct Emitter *self, const char *owner, const char *cname)
{
    int fi;
    const char *mangled;

    if (strcmp(owner, cname) == 0) return 1;
    fi = self->sym->find_func(owner);
    if (fi >= 0 && strcmp(self->sym->funcs[fi].cname, cname) == 0) return 1;
    /* A closure inside a namespaced function records the short name, while the
       function is written under its mangled C spelling (`ns_apply`). Without
       this branch the lookup misses and the products are silently dropped,
       leaving `cc` to report an incomplete environment (R06).
       S1a-0 C2p-8: the whole joined spelling is interned, so a 2000-byte
       function name is not cut at a 160-byte row. */
    if (self->gprefix && self->gprefix[0]) {
        mangled = runtime::text::ct_intern_join(self->gprefix, owner);
        if (mangled && strcmp(mangled, cname) == 0) return 1;
    }
    return 0;
}

/* Is `name` one of the closure variables in scope right now? */
static int closure_var_lookup(struct Emitter *self, const char *name)
{
    int i;

    for (i = self->nclvar - 1; i >= 0; i--)
        if (strcmp(self->clvar[i], name) == 0) return self->clid[i];
    return -1;
}

/* Phase 21 S3/S5: the per-function closure products. A bound literal becomes a
   struct on the caller's stack plus a `static` trampoline; nothing is allocated
   and nothing is freed. The struct and the trampoline are keyed by the closure
   id, which is monotone across the unit, so the ABI carries no function or
   namespace name. Three passes keep a nested literal's struct complete before
   the enclosing trampoline that builds an instance of it, and give every
   trampoline a prototype before any definition (D21-15: outer before inner,
   struct before trampoline). `restore_line` re-anchors `#line` on the
   definition that follows. */
static int emit_closures(struct Emitter *self, const char *owner, int restore_line)
{
    int ci, k, wrote, pass, base_cl;
    const char *save_ret;

    wrote = 0;
    for (pass = 0; pass < 3; pass++) {
        for (ci = 0; ci < self->sym->nclosure; ci++) {
            struct Closure *c = &self->sym->closures[ci];
            if (!c->ret[0]) continue;              /* not bound to a host type */
            if (!closure_owned(self, c->owner, owner)) continue;
            wrote = 1;
            if (pass == 0) {
                if ((*self->line_mode))
                    fprintf(self->out, "#line %d \"%s\"\n", c->line, self->path);
                fprintf(self->out, "/* closure at %s:%d */\n", self->path, c->line);
                fprintf(self->out, "struct __ct_cl_env_%d {\n", ci);
                if (c->ncap == 0)
                    fputs("    char __ct_cl_pad;\n", self->out);
                for (k = 0; k < c->ncap; k++)
                    fprintf(self->out, "    %s %s;\n", c->cap_type[k], c->cap_name[k]);
                fputs("};\n", self->out);
                continue;
            }
            if (pass == 1) {
                /* An enclosing trampoline may call one defined later, so every
                   product gets a prototype before any definition. */
                fprintf(self->out, "static %s __attribute__((unused)) __ct_cl_tramp_%d(void *self",
                        c->ret, ci);
                for (k = 0; k < c->nparams; k++)
                    fprintf(self->out, ", %s %s", c->ptype[k], c->pname[k]);
                fputs(");\n", self->out);
                continue;
            }
            if ((*self->line_mode))
                fprintf(self->out, "#line %d \"%s\"\n", c->line, self->path);
            fprintf(self->out, "static %s __attribute__((unused)) __ct_cl_tramp_%d(void *self",
                    c->ret, ci);
            for (k = 0; k < c->nparams; k++)
                fprintf(self->out, ", %s %s", c->ptype[k], c->pname[k]);
            fputs(")\n{\n", self->out);
            if (c->ncap > 0)
                fprintf(self->out, "    struct __ct_cl_env_%d *__ct_cl_e = self;\n", ci);
            else
                fputs("    (void)self;\n", self->out);
            /* an ignored parameter would trip -Wextra, the same way an impl casts
               its unused parameters */
            for (k = 0; k < c->nparams; k++)
                if (!self->node_mentions(c->body, c->pname[k]))
                    fprintf(self->out, "    (void)%s;\n", c->pname[k]);
            self->closure_ci = ci + 1;
            base_cl = self->nclvar;
            /* Phase 44 (D44-10): a closure body has no Result return target of
               its own, so a postfix `?` there is refused rather than emitted as
               a `return` inside the trampoline. */
            save_ret = self->cur_ret;
            self->cur_ret = "";
            if (c->is_block) {
                int s;
                for (s = self->arena->nodes[c->body].a; s >= 0;
                     s = self->arena->nodes[s].next)
                    if (self->emit_node(s, 1) != 0) { self->nclvar = base_cl; self->closure_ci = 0; return -1; }
            } else if (strcmp(c->ret, "void") == 0) {
                fputs("    ", self->out);
                if (self->emit_expr(c->body) != 0) { self->nclvar = base_cl; self->closure_ci = 0; return -1; }
                fputs(";\n", self->out);
            } else {
                fputs("    return ", self->out);
                if (self->emit_expr(c->body) != 0) { self->nclvar = base_cl; self->closure_ci = 0; return -1; }
                fputs(";\n", self->out);
            }
            self->cur_ret = save_ret;
            self->nclvar = base_cl;
            self->closure_ci = 0;
            fputs("}\n", self->out);
        }
    }
    /* only a unit that actually emitted products needs the line re-anchor */
    if (wrote && (*self->line_mode))
        fprintf(self->out, "#line %d \"%s\"\n", restore_line, self->path);
    return 0;
}

/* The initialiser list of a closure environment. A capture that the enclosing
   trampoline already holds is read from its environment field (`__ct_cl_e->x`);
   that is how a nested literal copies a value out of the outer environment
   instead of carrying a pointer to it (D21-2). Everything else is a plain name
   in the current frame. */
static int emit_closure_values(struct Emitter *self, int ci)
{
    struct Closure *c = &self->sym->closures[ci];
    int k, j;

    if (c->ncap == 0) {
        fputs("0", self->out);
        return 0;
    }
    for (k = 0; k < c->ncap; k++) {
        if (k > 0) fputs(", ", self->out);
        if (self->closure_ci > 0) {
            struct Closure *oc = &self->sym->closures[self->closure_ci - 1];
            int found = 0;
            for (j = 0; j < oc->ncap; j++)
                if (strcmp(oc->cap_name[j], c->cap_name[k]) == 0) found = 1;
            if (found) {
                fprintf(self->out, "__ct_cl_e->%s", c->cap_name[k]);
                continue;
            }
        }
        /* `self` has no C spelling of its own in an impl body */
        if (self->sym->self_mode && strcmp(c->cap_name[k], "self") == 0)
            fputs("_self", self->out);
        else
            fputs(c->cap_name[k], self->out);
    }
    return 0;
}

/* A closure declaration is a binding, not a value: the declared name never
   becomes a C variable. Its stack instance is the environment, and every call
   through the name expands to the trampoline with that instance (D21-14). The
   `unused` attribute keeps a never-called literal warning-free. */
static int emit_closure_decl(struct Emitter *self, int n)
{
    int ci = self->arena->nodes[self->arena->nodes[n].a].num;

    fprintf(self->out, "struct __ct_cl_env_%d __attribute__((unused)) __ct_cl_env_v_%d = { ",
            ci, ci);
    if (emit_closure_values(self, ci) != 0) return -1;
    fputs(" }", self->out);
    /* R09: the scope table is how a later `add(x)` and a later pair actual find
       this binding. Dropping the row would emit a plain call to a name that has
       no C variable, so the cap is a hard error. */
    if (self->nclvar >= 64)
        return self->fail_from(n, "too many closure bindings in one frame (limit 64)");
    self->clvar[self->nclvar] = runtime::text::ct_intern(self->arena->nodes[n].text2);
    if (!self->clvar[self->nclvar]) return self->fail("out of memory");
    self->clid[self->nclvar] = ci;
    self->nclvar++;
    return 0;
}

/* One half of the `(fn, env)` pair. A static recipe places the two halves in
   their own slots, so each is written on its own; the plain call path below
   writes them back to back, byte for byte as before (D25-7). */
static int emit_closure_fn(struct Emitter *self, int n)
{
    int ci = self->arena->nodes[n].num;

    fprintf(self->out, "__ct_cl_tramp_%d", ci);
    return 0;
}

static int emit_closure_env(struct Emitter *self, int n)
{
    int ci = self->arena->nodes[n].num;

    fprintf(self->out, "&(struct __ct_cl_env_%d){ ", ci);
    if (emit_closure_values(self, ci) != 0) return -1;
    fputs(" }", self->out);
    return 0;
}

/* An inline literal as an actual: the `(fn, env)` pair is two C arguments, and
   the environment is a compound literal whose address lives until the end of
   the enclosing block -- long enough for the call and nothing is allocated
   (D21-14). Nested literals read their captures from `__ct_cl_e`. */
static int emit_closure_arg(struct Emitter *self, int n)
{
    if (emit_closure_fn(self, n) != 0) return -1;
    fputs(", ", self->out);
    return emit_closure_env(self, n);
}

/* Phase 84: the ADT layout writer, the match-arm writer and the include test. */
static int emit_adt_decl(struct Emitter *self, int n, int ind, int with_semi);
static int emit_match_arm(struct Emitter *self, int arm, int ind, int k, int ptr);

static int emit_struct_insts(struct Emitter *self, int u, int header);
/* Phase 33 O3: 1 when an instance's element belongs to a unit other than the
   container template's own, so its helpers and methods move to the consumer. */
static int inst_elem_foreign(struct Emitter *self, int ii);
/* Phase 29: write the methods of the template impl blocks. `header` writes the
   prototypes an exported template's consumer needs; otherwise the definitions. */
static int emit_struct_impls(struct Emitter *self, int u, int header);

/* Phase 26: write one definition per generic instance owned by unit `u`
   (-1 = the single compile-mode unit). The template's own N_FUNC node is
   reused with `gtparam`/`gtarg`/`gtname` set for the duration, so no AST copy
   is made and the non-generic path is untouched (D26-7). */
static int emit_generic_defs(struct Emitter *self, int u)
{
    int i, t;
    for (i = 0; i < self->sym->nginsts; i++) {
        if (u >= 0 && self->sym->ginsts[i].owner != u)
            continue;
        t = self->sym->funcs[self->sym->ginsts[i].func].body;
        if (t < 0) continue;
        self->gtparam = frontend::sym::ct_text_rows_reserve(self->gtparam, self->gtcap,
                                                            1, &self->gtcap);
        self->gtarg = frontend::sym::ct_text_rows_reserve(self->gtarg, self->gtacap,
                                                          1, &self->gtacap);
        if (!self->gtparam || self->gtcap < 1 || !self->gtarg || self->gtacap < 1)
            return self->fail("out of memory");
        /* S1a-0 C2p-6: `Func.tparam` / `GenericInst.targ` are pool texts, so
           the row is a reference and the whole 2000-byte argument survives. */
        self->gtparam[0] = self->sym->funcs[self->sym->ginsts[i].func].tparam;
        self->gtarg[0] = self->sym->ginsts[i].targ;
        self->gtntparam = 1;
        self->gtname = runtime::text::ct_intern(self->sym->ginsts[i].cname);
        if (!self->gtname) return self->fail("out of memory");
        if (self->emit_node(t, 0) != 0) {
            self->gtntparam = 0;
            self->gtname = "";
            return -1;
        }
        self->gtntparam = 0;
        self->gtname = "";
    }
    return 0;
}

/* Phase 41 R2: the 12 seq_cst helpers. They strip `_Atomic(T)` before calling
   the builtin because Clang 21 rejects `__atomic_load_n(_Atomic(int) *, ...)`.
   The parser only sets `atomic_used` after it has accepted a ct_atomic_* call;
   the block is therefore absent from every non-atomic product. */


/* LANG-29 S1 / B1: the writer whose types are being emitted and whether it is
   the header writer, so the ADT payload pre-emission knows if an instance
   definition is already visible through an included header. Declared before
   `emit_unit_body`, which runs before the emit helpers below. */
static int g_shell_u = -1;
static int g_shell_header;

/* P-7.2: the parser's slice-use flag. It lives as a file-scope pointer rather
   than in `struct Emitter` (that struct is at the build's 64-field cap), and
   is declared up here because `emit_unit_body` runs before the bind at the end
   of the unit. */
static int *g_slice_used;

/* P-7.2: emitted only when the parser noted a slice use; defined below with
   the other emission helpers, declared here because `emit_unit_body` runs
   before it in the translation unit. */
static void emit_slice_helpers(struct Emitter *self);

/* PH-80: one static block per `String` literal. The header sits immediately
   before the payload, so `String.ptr - 8` always names `ct_str_hdr`; `refs` is
   -1, which makes `release()` a no-op and never frees read-only literal data.
   `__attribute__((unused))` keeps `-Wall -Wextra` quiet when the scan sees a
   literal whose unit is not the one currently being written. */
static int emit_string_literals(struct Emitter *self, int prog)
{
    int n, any = 0;
    (void)prog;

    for (n = 0; n < self->arena->nnode; n++) {
        const char *lit;
        if (self->arena->nodes[n].kind != N_STR) continue;
        if (self->arena->nodes[n].aux != 1) continue;
        lit = self->arena->str_at((int)self->arena->nodes[n].num);
        if (!any) fputs("\n/* PH-80: immortal String literal headers */\n", self->out);
        fprintf(self->out,
                "static struct { struct ct_str_hdr h; char d[sizeof(%s)]; }"
                " ct_str_lit_%d __attribute__((unused)) = { { -1, 0 }, %s };\n",
                lit, n, lit);
        any = 1;
    }
    if (any) fputs("\n", self->out);
    return 0;
}

/* ---- PH-81 / S1: `Box<T>` per-instance helpers -------------------------
   The template lives in `lib/core/Box.h.ct`; the compiler writes two static
   functions per instance because both need the concrete payload spelling:
     - `Box_X__new(T *v)` allocates the shared `ct_Box_hdr` plus payload and
       copies the captured initializer into it (refs = 1);
     - `Box_X__payload_release(T *p)` releases the payload's owning fields when
       the last handle goes away. This is the "release by static type" half:
       a `String` field calls `String_Drop_drop`, a container / Box field calls
       its `release`, and a plain struct recurses into its own fields. */
/* LANG-24: only the built-in `lib/core/Box.h.ct` template is the owning
   handle. A project may still declare its own `struct Box<T>` (the historical
   fixtures do); its instances share the `Box_` prefix but must not inherit the
   built-in retain/release/auto-deref rules. */
static int Box_type_owns(struct Emitter *self, const char *ctype, int depth)
{
    const char *base;
    const char *b;
    int si, fi;

    if (!ctype || !ctype[0] || depth > 16) return 0;
    if (strchr(ctype, '*')) return 0;
    b = ctype;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    else if (strncmp(b, "union ", 6) == 0) return 0;
    else if (strncmp(b, "enum ", 5) == 0) return 0;
    base = base_type_text(b);
    if (!base) return 0;
    if (strcmp(base, "String") == 0 || strcmp(base, "U16String") == 0) return 1;
    if (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0
        || strncmp(base, "Option_", 7) == 0
        || strncmp(base, "Result_", 7) == 0)
        return 1;
    if (inst_is_builtin_Box(base)) return 1;
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    if (self->sym->structs[si].is_inst) {
        /* a user generic instance: judge its concrete fields */
    } else if (self->sym->structs[si].has_drop_impl) {
        return 1;
    }
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
        const char *ft = self->sym->structs[si].fields[fi].type;
        const char *dims = self->sym->structs[si].fields[fi].dims;
        if (dims[0]) {
            if (Box_type_owns(self, ft, depth + 1)) return 1;
        } else if (Box_type_owns(self, ft, depth + 1)) {
            return 1;
        }
    }
    return 0;
}

/* Release the payload field at `expr` (a pointer expression of type T *). */
static int Box_emit_release_at(struct Emitter *self, const char *ctype, const char *expr, int depth)
{
    const char *base;
    const char *b;
    char *at = 0;
    int acap = 0;
    int si, fi;

    if (!Box_type_owns(self, ctype, depth) || depth > 16) return 0;
    b = ctype;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    base = base_type_text(b);
    if (!base) return 0;
    if (strcmp(base, "String") == 0 || strcmp(base, "U16String") == 0) {
        fprintf(self->out, "    %s_Drop_drop(%s);\n", base, expr);
        return 0;
    }
    if (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0
        || strncmp(base, "Option_", 7) == 0
        || strncmp(base, "Result_", 7) == 0
        || inst_is_builtin_Box(base)) {
        fprintf(self->out, "    %s_release(%s);\n", base, expr);
        return 0;
    }
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    if (!self->sym->structs[si].is_inst && self->sym->structs[si].has_drop_impl) {
        fprintf(self->out, "    %s_Drop_drop(%s);\n", base, expr);
        return 0;
    }
    /* S1a-0 C2p-8: the nested field expression is generated text whose depth
       is the payload's, so it is built in a growable block, not a row. */
    if (tool::sh::ct_text_init(&at, &acap, 64) != 0) return -1;
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
        const char *ft = self->sym->structs[si].fields[fi].type;
        const char *dims = self->sym->structs[si].fields[fi].dims;
        const char *fn = self->sym->structs[si].fields[fi].name;
        if (dims[0]) {
            /* one dimension of owning elements; a multi-dimensional array is
               left to the explicit Drop body (the same rule the Drop glue
               follows for pointer arrays). */
            if (strchr(dims + 1, '[')) continue;
            if (!Box_type_owns(self, ft, depth + 1)) continue;
            fprintf(self->out,
                    "    { int __ct_i; for (__ct_i = 0; __ct_i < "
                    "(int)(sizeof((%s)->%s) / sizeof((%s)->%s[0])); __ct_i++)\n",
                    expr, fn, expr, fn);
            if (tool::sh::ct_text_reset(&at, &acap, 64) != 0
                || tool::sh::ct_text_printf(&at, &acap, "&((%s)->%s[__ct_i])",
                                            expr, fn) != 0) {
                tool::sh::ct_text_free(&at, &acap);
                return -1;
            }
            if (Box_emit_release_at(self, ft, at, depth + 1) != 0) {
                tool::sh::ct_text_free(&at, &acap);
                return -1;
            }
            fputs("    }\n", self->out);
        } else if (Box_type_owns(self, ft, depth + 1)) {
            if (tool::sh::ct_text_reset(&at, &acap, 64) != 0
                || tool::sh::ct_text_printf(&at, &acap, "&((%s)->%s)",
                                            expr, fn) != 0) {
                tool::sh::ct_text_free(&at, &acap);
                return -1;
            }
            if (Box_emit_release_at(self, ft, at, depth + 1) != 0) {
                tool::sh::ct_text_free(&at, &acap);
                return -1;
            }
        }
    }
    tool::sh::ct_text_free(&at, &acap);
    return 0;
}

/* Copy one payload value into `*dst`, retaining the owning leaves. `dst` and
   `src` are pointer expressions of type T *. Scalar / pointer payloads are a
   plain assignment; a `String` / `U16String` bumps the shared header inline
   (its `retain` method is written later than these helpers); a container or
   Box takes its own reference through `retain`; a plain struct copies every
   field and then fixes up the owning ones. */
static int Box_emit_copy_at(struct Emitter *self, const char *ctype, const char *dst, const char *src, int depth)
{
    const char *base;
    const char *b;
    char *nd = 0;
    char *ns = 0;
    int ndcap = 0, nscap = 0;
    int si, fi;

    if (!ctype || !ctype[0] || depth > 16) return 0;
    if (strchr(ctype, '*')) {
        fprintf(self->out, "    *(%s) = *(%s);\n", dst, src);
        return 0;
    }
    b = ctype;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    else if (strncmp(b, "union ", 6) == 0 || strncmp(b, "enum ", 5) == 0) {
        fprintf(self->out, "    *(%s) = *(%s);\n", dst, src);
        return 0;
    }
    base = base_type_text(b);
    if (!base) return 0;
    if (strcmp(base, "String") == 0 || strcmp(base, "U16String") == 0) {
        fprintf(self->out, "    *(%s) = *(%s);\n", dst, src);
        fprintf(self->out,
                "    if ((*(%s)).ptr != 0) {\n"
                "        struct ct_str_hdr *__ct_h = (struct ct_str_hdr *)"
                "((char *)(*(%s)).ptr - sizeof(struct ct_str_hdr));\n"
                "        if (__ct_h->refs >= 0) __ct_h->refs = __ct_h->refs + 1;\n"
                "    }\n", src, src);
        return 0;
    }
    if (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0
        || strncmp(base, "Option_", 7) == 0
        || strncmp(base, "Result_", 7) == 0
        || inst_is_builtin_Box(base)) {
        fprintf(self->out, "    *(%s) = %s_retain(%s);\n", dst, base, src);
        return 0;
    }
    si = self->sym->find_struct(base);
    if (si < 0) {
        fprintf(self->out, "    *(%s) = *(%s);\n", dst, src);
        return 0;
    }
    fprintf(self->out, "    *(%s) = *(%s);\n", dst, src);
    /* S1a-0 C2p-8: both nested field expressions are generated text whose
       length follows the payload depth, so they grow instead of being cut. */
    if (tool::sh::ct_text_init(&nd, &ndcap, 64) != 0) return -1;
    if (tool::sh::ct_text_init(&ns, &nscap, 64) != 0) {
        tool::sh::ct_text_free(&nd, &ndcap);
        return -1;
    }
    for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
        const char *ft = self->sym->structs[si].fields[fi].type;
        const char *dims = self->sym->structs[si].fields[fi].dims;
        const char *fn = self->sym->structs[si].fields[fi].name;
        int rc;
        if (dims[0]) continue;          /* arrays are the explicit Drop body's */
        if (!Box_type_owns(self, ft, depth + 1)) continue;
        if (tool::sh::ct_text_reset(&nd, &ndcap, 64) != 0
            || tool::sh::ct_text_printf(&nd, &ndcap, "&((%s)->%s)", dst, fn) != 0
            || tool::sh::ct_text_reset(&ns, &nscap, 64) != 0
            || tool::sh::ct_text_printf(&ns, &nscap, "&((%s)->%s)", src, fn) != 0) {
            tool::sh::ct_text_free(&nd, &ndcap);
            tool::sh::ct_text_free(&ns, &nscap);
            return -1;
        }
        rc = Box_emit_copy_at(self, ft, nd, ns, depth + 1);
        if (rc != 0) {
            tool::sh::ct_text_free(&nd, &ndcap);
            tool::sh::ct_text_free(&ns, &nscap);
            return -1;
        }
    }
    tool::sh::ct_text_free(&nd, &ndcap);
    tool::sh::ct_text_free(&ns, &nscap);
    return 0;
}

static int emit_Box_protos(struct Emitter *self, int u)
{
    int i, n;
    struct StructInst *ins;
    (void)u;

    ins = frontend::sym::ct_insts(&n);
    for (i = 0; ins && i < n; i++) {
        if (!inst_is_builtin_Box(ins[i].name)) continue;
        if (u >= 0 && ins[i].owner != u) continue;
        fprintf(self->out,
                "static __attribute__((unused)) struct %s %s__new(%s *);\n",
                ins[i].name, ins[i].name, ins[i].ctype[0]);
        fprintf(self->out,
                "static __attribute__((unused)) struct %s %s__copy(%s *);\n",
                ins[i].name, ins[i].name, ins[i].ctype[0]);
        fprintf(self->out,
                "static void __attribute__((unused)) %s__payload_release(%s *);\n",
                ins[i].name, ins[i].ctype[0]);
    }
    return 0;
}

static int emit_Box_helpers(struct Emitter *self, int u)
{
    int i, n;
    struct StructInst *ins;

    ins = frontend::sym::ct_insts(&n);
    for (i = 0; ins && i < n; i++) {
        const char *ctype;
        if (!inst_is_builtin_Box(ins[i].name)) continue;
        if (u >= 0 && ins[i].owner != u) continue;
        ctype = ins[i].ctype[0];
        fprintf(self->out,
                "static void __attribute__((unused)) %s__payload_release(%s *p)\n{\n",
                ins[i].name, ctype);
        if (!Box_type_owns(self, ctype, 0)) {
            fputs("    (void)p;\n", self->out);
        } else if (Box_emit_release_at(self, ctype, "p", 0) != 0) {
            return -1;
        }
        fputs("}\n\n", self->out);
        fprintf(self->out,
                "static __attribute__((unused)) struct %s %s__new(%s *v)\n{\n",
                ins[i].name, ins[i].name, ctype);
        fputs("    struct ct_Box_hdr *h;\n", self->out);
        fprintf(self->out, "    struct %s b;\n", ins[i].name);
        fputs("    size_t off;\n", self->out);
        fprintf(self->out,
                "    off = ((sizeof(struct ct_Box_hdr) + _Alignof(%s) - 1)"
                " / _Alignof(%s)) * _Alignof(%s);\n", ctype, ctype, ctype);
        fputs("    h = (struct ct_Box_hdr *)malloc(off + sizeof(*v));\n"
              "    if (h == 0) abort();\n"
              "    h->refs = 1;\n"
              "    h->aux = 0;\n"
              "    b.h = h;\n", self->out);
        fprintf(self->out, "    b.ptr = (%s *)((char *)h + off);\n", ctype);
        fputs("    *b.ptr = *v;\n"
              "    return b;\n"
              "}\n\n", self->out);
        fprintf(self->out,
                "static __attribute__((unused)) struct %s %s__copy(%s *v)\n{\n",
                ins[i].name, ins[i].name, ctype);
        fputs("    struct ct_Box_hdr *h;\n", self->out);
        fprintf(self->out, "    struct %s b;\n", ins[i].name);
        fputs("    size_t off;\n", self->out);
        fprintf(self->out,
                "    off = ((sizeof(struct ct_Box_hdr) + _Alignof(%s) - 1)"
                " / _Alignof(%s)) * _Alignof(%s);\n", ctype, ctype, ctype);
        fputs("    h = (struct ct_Box_hdr *)malloc(off + sizeof(*v));\n"
              "    if (h == 0) abort();\n"
              "    h->refs = 1;\n"
              "    h->aux = 0;\n"
              "    b.h = h;\n", self->out);
        fprintf(self->out, "    b.ptr = (%s *)((char *)h + off);\n", ctype);
        if (Box_emit_copy_at(self, ctype, "b.ptr", "v", 0) != 0) return -1;
        fputs("    return b;\n"
              "}\n\n", self->out);
    }
    return 0;
}

/* ---- LANG-29 S2 / B3: the per-ADT retain / release glue ----------------
   One pair per owning ADT (the predicate is `adt_owns`), emitted with the same
   `<T>_retain` / `<T>_release` spelling an explicit `impl T { … }` would use so
   the container element glue needs no special case. `retain` walks only the
   current variant and bumps every owning leaf; `release` drops the same leaves
   and lets the last reference free the tree. A `Vec` / `Map` leaf is guarded on
   its zero handle: the built-in `release` aborts on `h == 0` (D29-12), while a
   zero-initialised ADT value legitimately holds one. */
/* 1 when this variant carries at least one owning payload field. */
static int adt_own_kind_variant(struct Emitter *self, int adi, int v)
{
    int f, n;
    struct Adt *adts;
    adts = frontend::sym::ct_adts(&n);
    if (!adts || adi < 0 || adi >= n || v < 0 || v >= adts[adi].nvariants) return 0;
    for (f = 0; f < adts[adi].variants[v].nfields; f++)
        if (adt_own_kind(self, adts[adi].variants[v].fields[f].type, 0)) return 1;
    return 0;
}

static int adt_emit_variant_life(struct Emitter *self, int adi, int v, int retain)
{
    int f, n;
    struct Adt *adts;
    char *lv = 0;
    int lcap = 0;
    adts = frontend::sym::ct_adts(&n);
    if (!adts || adi < 0 || adi >= n || v < 0 || v >= adts[adi].nvariants) return 0;
    if (tool::sh::ct_text_init(&lv, &lcap, 64) != 0) return -1;
    for (f = 0; f < adts[adi].variants[v].nfields; f++) {
        const char *ft = adts[adi].variants[v].fields[f].type;
        const char *base;
        const char *pfx;
        if (!adt_own_kind(self, ft, 0)) continue;
        pfx = sb_life_prefix_text(self, ft);
        if (!pfx) continue;
        base = adt_base_type_text(self, ft);
        if (!base) { tool::sh::ct_text_free(&lv, &lcap); return -1; }
        if (tool::sh::ct_text_reset(&lv, &lcap, 64) != 0
            || tool::sh::ct_text_printf(&lv, &lcap, "self->u.%s.%s",
                    adts[adi].variants[v].cname,
                    adts[adi].variants[v].fields[f].name) != 0) {
            tool::sh::ct_text_free(&lv, &lcap);
            return -1;
        }
        if (retain)
            fprintf(self->out, "        %s = %s_retain(&%s);\n", lv, pfx, lv);
        else if (strncmp(base, "Vec_", 4) == 0 || strncmp(base, "Map_", 4) == 0)
            fprintf(self->out, "        if ((%s).h != 0) (void)%s_release(&%s);\n",
                    lv, pfx, lv);
        else
            fprintf(self->out, "        %s_release(&%s);\n", pfx, lv);
    }
    tool::sh::ct_text_free(&lv, &lcap);
    return 0;
}

static int emit_adt_life_defs(struct Emitter *self, int u)
{
    int i, n, v, d;
    struct Adt *adts;
    adts = frontend::sym::ct_adts(&n);
    if (!adts) return 0;
    for (i = 0; i < n; i++) {
        if (u >= 0 && adts[i].owner != u) continue;
        if (!adt_owns(self, i, 0)) continue;
        d = (u >= 0 && adts[i].is_pub) ? 0 : 1;
        if (d)
            fprintf(self->out, "static __attribute__((unused)) struct %s %s_retain(struct %s *self)\n{\n",
                    adts[i].full, adts[i].full, adts[i].full);
        else
            fprintf(self->out, "struct %s %s_retain(struct %s *self)\n{\n",
                    adts[i].full, adts[i].full, adts[i].full);
        for (v = 0; v < adts[i].nvariants; v++) {
            if (!adt_own_kind_variant(self, i, v)) continue;
            fprintf(self->out, "    if (self->tag == %d) {\n", v);
            if (adt_emit_variant_life(self, i, v, 1) != 0) return -1;
            fputs("    }\n", self->out);
        }
        fputs("    return *self;\n}\n\n", self->out);
        if (d)
            fprintf(self->out, "static __attribute__((unused)) void %s_release(struct %s *self)\n{\n",
                    adts[i].full, adts[i].full);
        else
            fprintf(self->out, "void %s_release(struct %s *self)\n{\n",
                    adts[i].full, adts[i].full);
        fputs("    if (self == 0) return;\n", self->out);
        for (v = 0; v < adts[i].nvariants; v++) {
            if (!adt_own_kind_variant(self, i, v)) continue;
            fprintf(self->out, "    if (self->tag == %d) {\n", v);
            if (adt_emit_variant_life(self, i, v, 0) != 0) return -1;
            fputs("    }\n", self->out);
        }
        fputs("}\n\n", self->out);
    }
    return 0;
}

/* The per-unit emission proper: everything from the banner to the last
   function, run with `self->out` already pointing at an open file. Every
   failure is a bare `return -1`; the method that opened the file closes it and
   drops the half-written artefact, so a failed build leaves nothing that looks
   like a real unit. */
static int emit_unit_body(struct Emitter *self, int u)
{
    int n, i;

    /* LANG-29 S1 / B1: the type writer runs per unit; record which unit and
       which product so the ADT payload pre-emission places each shell once. */
    g_shell_u = u;
    g_shell_header = 0;

    /* SH-111: the same pre-emission assertion as compile mode, per unit. It
       runs before the banner, so a refusal leaves no half-written product. */
    if (self->invariant_check(self->units[u].prog) != 0) return -1;
    fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
            self->version, self->path);
    fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
          self->out);
    /* PH-66 R2: the headers the unit's own direct calls need, before anything
       that may repeat them (the layer prologues below). */
    if (self->io_mask & 1) fputs("#include <stdio.h>\n", self->out);
    if (self->io_mask & 2) fputs("#include <wchar.h>\n", self->out);
    /* Phase 84: this unit writes an ADT layout plus its offsetof assertions. */
    if (unit_has_adt(u, 0)) fputs("#include <stddef.h>\n", self->out);
    /* PH-64: with --alloc the target's allocator is declared here, so the
       mapped calls below have a prototype without pulling <stdlib.h>. */
    if (self->alloc_map && self->alloc_map[0]) {
        fprintf(self->out, "extern void *%s(__SIZE_TYPE__);\n", self->alloc_m);
        fprintf(self->out, "extern void %s(void *);\n", self->alloc_f);
    }
    if (self->runtime_checks && *self->runtime_checks) {
        fputs("#include <stdio.h>\n#include <stdlib.h>\n", self->out);
        fputs("static void *__attribute__((unused)) __ct_vt_guard(void *vt, const char *file, int line, const char *method)\n"
              "{\n"
              "    if (!vt) {\n"
              "        fprintf(stderr, \"%s:%d: runtime check: null vtable in call to '%s'\\n\", file, line, method);\n"
              "        abort();\n"
              "    }\n"
              "    return vt;\n"
              "}\n\n",
              self->out);
    }
    /* The imported `.m.ct` prologue leads the unit: the recipes call C
       functions whose declarations (and macros) come from those lines. */
    if (emit_map_prologues(self, u) != 0) return -1;
    /* Only a `.h.ct` unit publishes a header, so only it includes one of
       its own; an implementation unit's `.c` carries every declaration it
       needs (the types are emitted below, no longer skipped as `pub`). */
    if (self->units[u].is_hdr) {
        int priv = 0;
        int si2, fi2;
        for (si2 = 0; si2 < self->sym->nstructs; si2++) {
            int hp = 0, hv = 0;
            if (self->sym->structs[si2].owner != u) continue;
            if (self->sym->structs[si2].nuse > 0) continue;
            for (fi2 = 0; fi2 < self->sym->structs[si2].nfields; fi2++) {
                if (self->sym->structs[si2].fields[fi2].is_pub) hp = 1;
                else hv = 1;
            }
            if (hp && hv) priv = 1;
        }
        if (priv) fputs("#define CT_UNIT_PRIVATE 1\n", self->out);
        fprintf(self->out, "#include \"%s.h\"\n",
                strcmp(self->units[u].base, "String") == 0
                    ? "String_" : self->units[u].base);
    }
    for (i = 0; i < self->units[u].ndep; i++) {
        if (self->units[self->units[u].depu[i]].is_map) continue;
        fprintf(self->out, "#include \"%s.h\"\n",
                self->units[u].dep + (size_t)i * MAX_TEXT);
    }
    /* Phase 29 E29-5: instances of the built-in templates are defined in the
       layer's headers; the unit sees them although there is no import edge.
       P34 S9a: the layer may span several files, so every layer header the
       unit does not own is included. */
    for (i = 0; i < self->nbuiltin; i++) {
        int bu = self->builtins[i];
        if (self->builtin_live && !self->builtin_live[i]) continue;
        if (bu < 0 || bu >= *self->nunits || bu == u) continue;
        fprintf(self->out, "#include \"%s.h\"\n",
                strcmp(self->units[bu].base, "String") == 0
                    ? "String_" : self->units[bu].base);
    }
    fputs("\n", self->out);
    if ((*self->line_mode)) fprintf(self->out, "#line 1 \"%s\"\n", self->path);

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_PP) {
            if ((self->io_mask & 1)
                && strcmp(self->arena->nodes[n].text, "#include <stdio.h>") == 0) continue;
            if ((self->io_mask & 2)
                && strcmp(self->arena->nodes[n].text, "#include <wchar.h>") == 0) continue;
            fprintf(self->out, "%s\n", self->arena->nodes[n].text);
        }
    if (self->sym->atomic_used) {
        fputs(
"static inline __attribute__((unused)) int __ct_atomic_load_int(_Atomic(int) *p)\n"
"{\n"
"    return __atomic_load_n((int *)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_int(_Atomic(int) *p, int v)\n"
"{\n"
"    __atomic_store_n((int *)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_int(_Atomic(int) *p, int *e, int v)\n"
"{\n"
"    return __atomic_compare_exchange_n((int *)p, e, v, 0,\n"
"                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) long __ct_atomic_load_long(_Atomic(long) *p)\n"
"{\n"
"    return __atomic_load_n((long *)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_long(_Atomic(long) *p, long v)\n"
"{\n"
"    __atomic_store_n((long *)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_long(_Atomic(long) *p, long *e, long v)\n"
"{\n"
"    return __atomic_compare_exchange_n((long *)p, e, v, 0,\n"
"                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_load_bool(_Atomic(_Bool) *p)\n"
"{\n"
"    return __atomic_load_n((_Bool *)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_bool(_Atomic(_Bool) *p, _Bool v)\n"
"{\n"
"    __atomic_store_n((_Bool *)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_bool(_Atomic(_Bool) *p, _Bool *e, _Bool v)\n"
"{\n"
"    return __atomic_compare_exchange_n((_Bool *)p, e, v, 0,\n"
"                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void *__ct_atomic_load_ptr(_Atomic(void *) *p)\n"
"{\n"
"    return __atomic_load_n((void **)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_ptr(_Atomic(void *) *p, void *v)\n"
"{\n"
"    __atomic_store_n((void **)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_ptr(_Atomic(void *) *p, void **e, void *v)\n"
"{\n"
"    return __atomic_compare_exchange_n((void **)p, e, v, 0,\n"
"                              __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
        , self->out);
    }

    if (g_slice_used && *g_slice_used) emit_slice_helpers(self);

    if (self->emit_struct_fwd() != 0) return -1;
    if (self->emit_trait_range(self->units[u].tr_start, self->units[u].tr_end, 2) != 0) return -1;
    if (self->emit_vtable_fwd(self->units[u].prog) != 0) return -1;

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        /* raw blocks keep their source position relative to the declarations */
        if (self->arena->nodes[n].kind == N_RAW_TEXT) {
            if (emit_raw_text(self, n) != 0) return -1;
            continue;
        }
        /* A `pub` struct/typedef/enum/union is in the header of a header
           unit, so only a private one is emitted here; an implementation
           unit has no header, so it emits all of them. */
        if ((self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
             || self->arena->nodes[n].kind == N_ENUM || self->arena->nodes[n].kind == N_UNION)
            && (self->arena->nodes[n].d != 1 || !self->units[u].is_hdr)) {
            if (self->emit_type_decl(n, 0, 1) != 0) return -1;
        }
    }

    /* Phase 29: the monomorphised structs this unit must define, after every
       plain type and before the prototypes that name them. */
    if (emit_struct_insts(self, u, 0) != 0) return -1;
    /* PH-81: the Box helpers are defined after the instance methods (which
       call the payload-release helper), so their prototypes lead them. */
    if (emit_Box_protos(self, u) != 0) return -1;
    if (emit_struct_impls(self, u, 0) != 0) return -1;
    if (emit_Box_helpers(self, u) != 0) return -1;
    /* LANG-29 S2 / B3: after the container instance methods the glue calls. */
    if (emit_adt_life_defs(self, u) != 0) return -1;
    /* PH-80: literal blocks (the built-in layer header is already included). */
    if (emit_string_literals(self, self->units[u].prog) != 0) return -1;

    for (i = self->units[u].fn_start; i < self->units[u].fn_end; i++)
        if (self->emit_proto(i) != 0) return -1;

    /* file-scope static assertions, after every type of this unit */
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_SASSERT)
            if (self->emit_node(n, 0) != 0) return -1;

    /* A `pub` global still needs its definition here (the header only
       declares it), and an `extern` global needs nothing at all. The
       initialiser may name a prototype emitted just above (D-6). */
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_GLOBAL || self->arena->nodes[n].aux == 2) continue;
        if (self->emit_type_decl(n, 0, 1) != 0) return -1;
    }

    if (self->emit_impls(self->units[u].prog) != 0) return -1;

    if (self->emit_maps(u) != 0) return -1;

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next)
        if (self->arena->nodes[n].kind == N_FUNC) {
            int cur = self->sym->find_func(self->arena->nodes[n].text2);
            /* a generic template has no C body of its own (Phase 26) */
            if (cur >= 0 && self->sym->funcs[cur].ntparams > 0) continue;
            /* the closure products of this function land above its definition */
            if (emit_closures(self, self->arena->nodes[n].text2, self->arena->nodes[n].line) != 0)
                return -1;
            if (self->emit_node(n, 0) != 0) return -1;
        }
    if (emit_generic_defs(self, u) != 0) return -1;

    return 0;
}

/* The header writer's body, likewise with the sink already open. */
static int write_unit_header_body(struct Emitter *self, int u, const char *guard)
{
    int n, i, pp;

    /* LANG-29 S1 / B1: this is the header writer; the instance shells a pub
       ADT needs may have to land in this header rather than the matching .c. */
    g_shell_u = u;
    g_shell_header = 1;

    fprintf(self->out, "#ifndef %s\n", guard);
    fprintf(self->out, "#define %s\n", guard);
    /* Phase 84: a `pub` ADT publishes its layout and `offsetof` assertions. */
    if (unit_has_adt(u, 1)) fputs("#include <stddef.h>\n", self->out);
    fputs("\n", self->out);
    fprintf(self->out, "/* Generated by ct v%s from %s (multi-file mode: exported types; the matching .c\n"
                   "   includes this header).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
            self->version, self->path);
    /* The exported types may name types from the source's own C includes,
       so those lines lead the header. Only `#include` is copied: other `#`
       lines belong to the implementation and would be duplicated. */
    pp = 0;
    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        if (self->arena->nodes[n].kind != N_PP) continue;
        if (strncmp(self->arena->nodes[n].text, "#include", 8) != 0) continue;
        fprintf(self->out, "%s\n", self->arena->nodes[n].text);
        pp++;
    }
    /* PH-65 R5: a `.h.ct` that owns a shim publishes it, so a consumer that
       only sees the generated header still gets the C surface. Avoid the
       duplicate when the author already wrote the include. */
    if (self->units[u].has_shim) {
        char line[256];
        int dup = 0;
        snprintf(line, sizeof line, "#include \"%s.shim.h\"", self->units[u].base);
        for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_PP) continue;
            if (strcmp(self->arena->nodes[n].text, line) == 0) {
                dup = 1;
                break;
            }
        }
        if (!dup) fprintf(self->out, "%s\n", line);
    }
    if (pp > 0) fputs("\n", self->out);
    for (i = 0; i < self->units[u].ndep; i++) {
        if (self->units[self->units[u].depu[i]].is_map) continue;
        fprintf(self->out, "#include \"%s.h\"\n",
                self->units[u].dep + (size_t)i * MAX_TEXT);
    }
    if (self->units[u].ndep > 0) fputs("\n", self->out);
    /* Phase 29 E29-5: a `pub` signature may name an instance defined in the
       built-in layer's header. P34 S9a: include every layer header the unit
       does not own. */
    for (i = 0; i < self->nbuiltin; i++) {
        int bu = self->builtins[i];
        if (self->builtin_live && !self->builtin_live[i]) continue;
        if (bu < 0 || bu >= *self->nunits || bu == u) continue;
        fprintf(self->out, "#include \"%s.h\"\n",
                strcmp(self->units[bu].base, "String") == 0
                    ? "String_" : self->units[bu].base);
    }
    if (self->nbuiltin > 0) fputs("\n", self->out);

    if (self->emit_struct_fwd() != 0) return -1;
    if (self->emit_trait_range(self->units[u].tr_start, self->units[u].tr_end, 1) != 0) return -1;
    if (self->emit_link_externs(self->units[u].prog, u) != 0) return -1;

    for (n = self->arena->nodes[self->units[u].prog].a; n >= 0; n = self->arena->nodes[n].next) {
        if ((self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
             || self->arena->nodes[n].kind == N_ENUM || self->arena->nodes[n].kind == N_UNION)
            && self->arena->nodes[n].d == 1) {
            if (self->emit_type_decl(n, 0, 1) != 0) return -1;
        } else if (self->arena->nodes[n].kind == N_GLOBAL
                   && (self->arena->nodes[n].d == 1 || self->arena->nodes[n].aux == 2)) {
            if (self->emit_global_extern(n) != 0) return -1;
        }
    }

    /* PH-48 D48-2: the exported Drop surface. A `pub` struct that `use Drop`
       and is declared here publishes the real non-static prototype iff this
       unit emits its body (an explicit impl here, or the recursive glue when
       there is no impl anywhere). The prototype is the visibility bit a
       consumer's `delete` relies on; an impl written in another unit leaves
       the header silent, which is L48-2. */
    for (i = 0; i < self->sym->nstructs; i++) {
        if (!self->sym->structs[i].uses_drop) continue;
        if (self->sym->structs[i].is_template || self->sym->structs[i].is_inst) continue;
        if (!self->sym->structs[i].is_pub) continue;
        if (self->sym->structs[i].owner != u) continue;
        if (self->sym->structs[i].has_drop_impl
            && !self->unit_has_drop_impl(u, i)) continue;
        fprintf(self->out, "void %s_Drop_drop(void *);\n",
                self->sym->structs[i].name);
    }

    /* Phase 29: a `pub` template publishes every instance of it here, so a
       consumer only includes this header instead of repeating the layout. */
    if (emit_struct_insts(self, u, 1) != 0) return -1;
    if (emit_struct_impls(self, u, 1) != 0) return -1;

    for (i = self->units[u].fn_start; i < self->units[u].fn_end; i++) {
        if (!self->sym->funcs[i].is_pub || self->sym->funcs[i].is_static) continue;
        if (self->emit_proto(i) != 0) return -1;
    }
    if (self->emit_inherent_protos(self->units[u].prog) != 0) return -1;

    fputs("\n#endif\n", self->out);
    return 0;
}

/* Phase 29 §2.3: one definition per monomorphised struct. The symbol table is
   build-wide, so the filter decides which unit owns which definition:
     - a `pub` template's instances live in its owner's header, and only there;
     - a private template's instances live in the `.c` of the unit that first
       named them (the dependency-first emit order puts an inner instance's
       unit ahead of the outer one's).
   Field spellings were substituted when the instance was created, so this
   writer only prints; it never re-derives a layout. */
static int inst_emit_one(struct Emitter *self, int ii)
{
    int ti, j, v, n;
    struct StructInst *insts;

    insts = frontend::sym::ct_insts(&n);
    if (!insts || ii < 0 || ii >= n) return 0;
    if (insts[ii].emitted) return 0;
    ti = self->sym->find_struct(insts[ii].name);
    if (ti < 0) return 0;
    insts[ii].emitted = 1;
    fprintf(self->out, "struct %s {\n", self->sym->structs[ti].name);
    for (j = 0; j < self->sym->structs[ti].nfields; j++) {
        fputs("    ", self->out);
        {
            const char *ft = self->sym->structs[ti].fields[j].type;
            if (strchr(ft, '<')) {
                char *res = (char *)malloc(TEXT_LIMIT);
                if (res && frontend::sym::ct_inst_resolve(ft, res, TEXT_LIMIT) == 0) {
                    const char *pooled = runtime::text::ct_intern(res);
                    if (pooled) ft = pooled;
                }
                free(res);
            }
            fprintf(self->out, "%s %s%s;\n", ft,
                    self->sym->structs[ti].fields[j].name,
                    self->sym->structs[ti].fields[j].dims);
        }
    }
    for (v = 0; v < self->sym->structs[ti].nuse; v++) {
        const char *use = self->sym->structs[ti].use[v];
        size_t ul = strlen(use);
        char *low = tool::sh::ct_scratch_alloc((int)ul + 1);
        int k;
        for (k = 0; k < (int)ul; k++) {
            char c = use[k];
            if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
            low[k] = c;
        }
        low[k] = 0;
        fprintf(self->out, "    const struct %s_vtbl *__%s_vptr;\n", use, low);
    }
    fputs("};\n\n", self->out);
    return 0;
}

/* A plain struct whose field is an instance (`struct Bag { Vec<int> v; }`)
   needs that definition before its own, while an instance whose field is a plain
   struct by pointer only needs the forward declaration `emit_struct_fwd`
   already wrote. Emitting on first mention keeps both cases legal without a
   whole-type dependency sort. */
static int preemit_insts_for(struct Emitter *self, const char *type)
{
    int i, n;
    struct StructInst *insts;
    char pat[MAX_TEXT + 16];

    insts = frontend::sym::ct_insts(&n);
    if (!insts) return 0;
    for (i = 0; i < n; i++) {
        if (insts[i].emitted) continue;
        snprintf(pat, sizeof pat, "struct %s", insts[i].name);
        if (strstr(type, pat)) {
            if (inst_emit_one(self, i) != 0) return -1;
        }
    }
    return 0;
}

static int emit_struct_insts(struct Emitter *self, int u, int header)
{
    int i, n, tn, tmpl;
    struct StructInst *insts;
    struct StructTmpl *tps;

    insts = frontend::sym::ct_insts(&n);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!insts || !tps) return 0;
    for (i = 0; i < n; i++) {
        int via_hdr;
        if (insts[i].emitted) continue;
        tmpl = frontend::sym::ct_tmpl_find(insts[i].tmpl);
        if (tmpl < 0) continue;
        via_hdr = tps[tmpl].is_pub && tps[tmpl].owner >= 0
                  && self->units[tps[tmpl].owner].is_hdr;
        if (header) {
            if (!via_hdr || tps[tmpl].owner != u) continue;
            /* P34 S8: an `Option` / `Result` instance whose element lives in the
               consumer cannot be defined in the layer's header (the field is
               incomplete there); the consumer writes it after the element. */
            if (inst_elem_foreign(self, i)) continue;
        } else {
            /* P34 S8: a foreign-element instance is written by the unit that
               named it -- the only one that can print the element. The
               container layout is handle-only, so moving it costs the layer
               nothing; `Option` / `Result` need it or the field is
               incomplete. */
            if (inst_elem_foreign(self, i)) {
                if (u >= 0 && insts[i].owner != u) continue;
            } else {
                if (via_hdr) continue;
                /* `u < 0` is compile mode: the one file owns every instance. */
                if (u >= 0 && insts[i].owner != u) continue;
            }
        }
        if (inst_emit_one(self, i) != 0) return -1;
    }
    return 0;
}

/* Bind the block's type parameters to the instance's arguments. The type
   printing paths read these two pairs, so a method's signature and body are
   written with `T`/`U` replaced by the concrete C spellings. */
static void impl_inst_bind(struct Emitter *self, int ki, int ii)
{
    int k, n, nins, pi, at, nt;
    struct StructImpl *im;
    struct StructInst *ins;

    im = frontend::sym::ct_impls(&n);
    ins = frontend::sym::ct_insts(&nins);
    self->gtntparam = 0;
    self->ginst = "";
    if (!im || !ins || ki < 0 || ki >= n || ii < 0 || ii >= nins) return;
    nt = im[ki].ntparams;
    self->gtparam = frontend::sym::ct_text_rows_reserve(self->gtparam, self->gtcap,
                                                        nt, &self->gtcap);
    self->gtarg = frontend::sym::ct_text_rows_reserve(self->gtarg, self->gtacap,
                                                      nt, &self->gtacap);
    if (nt > 0 && (!self->gtparam || self->gtcap < nt
                   || !self->gtarg || self->gtacap < nt)) return;
    {
        /* keep the previous spelling on OOM: every reader indexes `ginst[0]` */
        const char *g = runtime::text::ct_intern(ins[ii].name);
        if (!g) return;
        self->ginst = g;
    }
    self->gtntparam = nt;
    for (pi = 0; pi < nt; pi++) {
        at = -1;
        for (k = 0; k < ins[ii].nargs; k++)
            if (im[ki].tparam[pi] && im[ki].pat[k]
                && strcmp(im[ki].pat[k], im[ki].tparam[pi]) == 0) {
                at = k;
                break;
            }
        if (at >= 0 && ins[ii].ctype[at]) {
            self->gtparam[pi] = im[ki].tparam[pi];
            self->gtarg[pi] = ins[ii].ctype[at];
        } else {
            self->gtparam[pi] = (const char *)0;
            self->gtarg[pi] = (const char *)0;
        }
    }
}

/* P29-14 (V29-1): two inherent blocks can cover one instance -- `impl<V>
   Map<char *, V>` and `impl<K, V> Map<K, V>` both match `Map<char *, int>`.
   Resolution takes the first block in declaration order that declares the name
   (`inst_inherent_method`), so the emitter must not emit the later duplicate:
   1 when an earlier matching block already owns `fname` for this instance. */
/* PH-80 (D-013): how many of a block's pattern positions are concrete rather than
   type parameters. The generic `impl<K,V> Map<K,V>` scores 0; a key block
   `impl<V> Map<String,V>` scores 1. A concrete block may be declared after the
   generic one and still own the method. */
static int impl_method_shadowed(struct Emitter *self, int ki, int ii, const char *fname)
{
    int k, m, nimpls;
    struct StructImpl *im;

    im = frontend::sym::ct_impls(&nimpls);
    if (!im) return 0;
    for (k = 0; k < nimpls; k++) {
        if (k == ki) continue;
        if (im[k].use[0]) continue;
        if (!frontend::sym::ct_impl_matches(k, ii)) continue;
        /* Earlier blocks shadow only when they are at least as specific; a
           later block shadows only when it is strictly more specific. This
           lets the concrete `Map<String,V>` key block own the name no matter
           which side of the generic block it is declared on. */
        if (k < ki) {
            if (emit_impl_score(im, k) < emit_impl_score(im, ki)) continue;
        } else {
            if (emit_impl_score(im, k) <= emit_impl_score(im, ki)) continue;
        }
        for (m = self->arena->nodes[im[k].node].a; m >= 0; m = self->arena->nodes[m].next)
            if (strcmp(self->arena->nodes[m].text2, fname) == 0) return 1;
    }
    return 0;
}

/* D-028: the C-symbol suffix of an overloaded inherent method. The first
   declaration of a name in the block keeps `<T>_<name>` (byte-identical to
   v0-PH-52); each later one appends `$<enc(param-key)>...`, so two overloads
   never share a C function. The generic substitution is applied first, so an
   instance's method name is concrete. */
static const char *emit_overload_suffix(struct Emitter *self, int impl_node, int m)
{
    char *buf = 0;
    int cap = 0, n, pos, p;
    const char *out;

    if (impl_node < 0 || m < 0 || m >= self->arena->nnode) return "";
    n = frontend::parse::ct_overload_count(impl_node, self->arena->nodes[m].text2);
    if (n <= 1) return "";
    pos = frontend::parse::ct_overload_pos(impl_node, m);
    if (pos <= 0) return "";
    if (tool::sh::ct_text_init(&buf, &cap, 32) != 0) return (const char *)0;
    for (p = self->arena->nodes[m].a; p > 0; p = self->arena->nodes[p].next) {
        const char *ty = emit_gsub_type_text(self, self->arena->nodes[p].text);
        const char *ek;
        if (!ty) ty = self->arena->nodes[p].text;
        ek = frontend::parse::ct_overload_key_text(ty);
        if (!ek) goto fail;
        if (tool::sh::ct_text_cat(&buf, &cap, "$") != 0) goto fail;
        if (tool::sh::ct_text_cat(&buf, &cap, ek) != 0) goto fail;
    }
    out = runtime::text::ct_intern(buf);
    tool::sh::ct_text_free(&buf, &cap);
    return out ? out : "";
fail:
    tool::sh::ct_text_free(&buf, &cap);
    return (const char *)0;
}

/* One method of a template impl for one instance. An inherent method takes the
   `<Inst>_<method>` symbol and is dispatched statically; a `use` block keeps the
   `<Inst>_<Trait>_<method>` spelling plus its vtable, so the vptr path stays
   exactly what a concrete impl already produces. */
static int impl_emit_method(struct Emitter *self, int ki, int ii, int m, int header)
{
    int k, nimpls, ninsts, ntmpls, body, tmpl;
    const char *iname;
    const char *cname;
    const char *cuse;
    const char *mret;
    const char *one;
    const char *tname;
    struct StructInst *ins;
    struct StructTmpl *tps;
    struct StructImpl *im;
    int exported;
    int statik;

    ins = frontend::sym::ct_insts(&ninsts);
    tps = frontend::sym::ct_tmpls(&ntmpls);
    im = frontend::sym::ct_impls(&nimpls);
    (void)nimpls;
    (void)ntmpls;
    iname = ins[ii].name;
    tmpl = frontend::sym::ct_tmpl_find(ins[ii].tmpl);
    exported = tmpl >= 0 && tps[tmpl].is_pub && tps[tmpl].owner >= 0
               && self->units[tps[tmpl].owner].is_hdr;
    /* Phase 33 O3: a consumer copy is private to the unit that writes it, so it
       stays `static` even when the template's header normally exports the name;
       one copy per consumer unit links fine, two globals would not. */
    if (inst_elem_foreign(self, ii)) exported = 0;
    tname = frontend::sym::ct_impls(&nimpls)[ki].use;
    /* Phase 35 S5a: a template impl's `use Iter<T>` is spelled per instance.
       S1a-0 C2p-8: a formal-limit scratch block, so a 2000-byte trait
       argument is not cut at the old 160-byte caller row. */
    cuse = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
    if (self->sym->impl_use_concrete(tname, ins[ii].nargs,
                             ins[ii].carg, ins[ii].ctype, -1,
                             (char *)cuse, TEXT_LIMIT) != 0)
        return -1;
    tname = cuse;
    /* Phase 42: an inherent method is exported only when the source wrote
       `pub` on it; trait methods keep their trait/vtable rules. */
    if (!tname[0] && self->arena->nodes[m].d != 1) exported = 0;
    /* An inherent name a more specific block already owns for this instance is
       not emitted twice (V29-1); a trait method keeps its own symbol. */
    if (!tname[0] && impl_method_shadowed(self, ki, ii, self->arena->nodes[m].text2))
        return 0;
    mret = self->arena->nodes[m].text[0] ? self->arena->nodes[m].text : "void";
    /* D-028: the suffix needs the instance substitution, so bind before the
       name is built. A unique method name answers "" and keeps the symbol. */
    impl_inst_bind(self, ki, ii);
    if (tname[0])
        cname = runtime::text::ct_internf("%s_%s_%s", iname, tname,
                                          self->arena->nodes[m].text2);
    else {
        const char *suf = emit_overload_suffix(self, im[ki].node, m);
        if (!suf) return self->fail("out of memory");
        cname = runtime::text::ct_internf("%s_%s%s", iname,
                                          self->arena->nodes[m].text2, suf);
    }
    if (!cname) return self->fail("out of memory");
    g_sb.method = runtime::text::ct_intern(self->arena->nodes[m].text2);
    g_sb.recv = iname;
    if (!g_sb.method || !g_sb.recv) return self->fail("out of memory");
    /* Phase 44: a postfix `?` in the body propagates the (instance-bound)
       return type of the method. */
    {
        const char *sub = emit_gsub_type_text(self, mret);
        self->cur_ret = sub ? sub : runtime::text::ct_intern(mret);
        if (!self->cur_ret) return self->fail("out of memory");
    }
    /* P29-2: `c` marks a static (receiverless) method -- `Vec_int_from` takes
       only its own parameters and gets no `_self` local. */
    statik = self->arena->nodes[m].c;
    if (header) {
        if (!tname[0] && self->arena->nodes[m].d != 1) return 0;
        if (self->emit_type_name(mret, cname) != 0) return -1;
        if (statik) fputs("(", self->out);
        else fputs("(void *self", self->out);
        for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next) {
            fputs(statik ? (k == self->arena->nodes[m].a ? "" : ", ") : ", ", self->out);
            if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                          self->arena->nodes[k].text2,
                                          self->arena->nodes[k].text3) != 0) return -1;
        }
        fputs(");\n", self->out);
        return 0;
    }
    if (!exported) fputs("static ", self->out);
    /* A private method nothing calls is dead code; the attribute keeps the
       output clean under -Wall, exactly like the Drop / Handback bodies. */
    if (!exported) fputs("__attribute__((unused)) ", self->out);
    if (self->emit_type_name(mret, cname) != 0) return -1;
    if (statik) fputs("(", self->out);
    else fputs("(void *self", self->out);
    for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next) {
        fputs(statik ? (k == self->arena->nodes[m].a ? "" : ", ") : ", ", self->out);
        if (self->arena->nodes[k].aux == 2 || self->arena->nodes[k].aux == 3) {
            const char *pbuf;
            pbuf = tool::sh::ct_scratch_fmt("%s *", self->arena->nodes[k].text);
            if (self->emit_type_name_dims(pbuf, self->arena->nodes[k].text2,
                                          self->arena->nodes[k].text3) != 0) return -1;
        } else if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                             self->arena->nodes[k].text2,
                                             self->arena->nodes[k].text3) != 0) return -1;
    }
    fputs(") {\n", self->out);
    if (!statik) {
        one = tool::sh::ct_scratch_fmt("struct %s", iname);
        fprintf(self->out, "    %s *_self = (%s *)self;\n", one, one);
    }
    /* SH-102: a by-value `String` / `U16String` parameter owns its reference
       for the body; the same list is released before the closing brace. */
    sb_push_params(self, self->arena->nodes[m].a, 0);
    sb_retain_params(self, 1);
    self->sym->self_mode = statik ? 0 : 1;
    body = self->arena->nodes[m].b;
    for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next)
        if (!self->node_mentions(body, self->arena->nodes[k].text2))
            fprintf(self->out, "    (void)%s;\n", self->arena->nodes[k].text2);
    if (!statik && !self->node_mentions(body, "self")) fputs("    (void)_self;\n", self->out);
    for (k = self->arena->nodes[body].a; k >= 0; k = self->arena->nodes[k].next)
        if (self->emit_node(k, 1) != 0) {
            self->sym->self_mode = 0;
            return -1;
        }
    sb_end_body(self, 1);
    self->sym->self_mode = 0;
    fputs("}\n\n", self->out);
    return 0;
}

static int impl_emit_one(struct Emitter *self, int ki, int ii)
{
    int m, nimpls, ninsts;
    const char *cuse;
    struct StructImpl *im;
    struct StructInst *ins;

    im = frontend::sym::ct_impls(&nimpls);
    ins = frontend::sym::ct_insts(&ninsts);
    if (!im || !ins || ki < 0 || ki >= nimpls || ii < 0 || ii >= ninsts) return 0;
    for (m = self->arena->nodes[im[ki].node].a; m >= 0; m = self->arena->nodes[m].next)
        if (impl_emit_method(self, ki, ii, m, 0) != 0) return -1;
    if (im[ki].use[0]) {
        int first = 1;
        int builtin = (strcmp(im[ki].use, "Drop") == 0 || strcmp(im[ki].use, "Handback") == 0)
                      && self->sym->find_trait(im[ki].use) < 0;
        /* P36 S1a: the built-in `Drop`/`Handback` have no vptr, no vtable and
           no vtable type, so a generic impl of them emits only the methods. */
        if (!builtin) {
            cuse = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
            if (self->sym->impl_use_concrete(im[ki].use, ins[ii].nargs,
                                     ins[ii].carg, ins[ii].ctype, -1,
                                     (char *)cuse, TEXT_LIMIT) != 0)
                return -1;
            fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused)) = {\n",
                    cuse, ins[ii].name, cuse);
            for (m = self->arena->nodes[im[ki].node].a; m >= 0; m = self->arena->nodes[m].next) {
                if (!first) fputs(",\n", self->out);
                fprintf(self->out, "    .%s = %s_%s_%s", self->arena->nodes[m].text2,
                        ins[ii].name, cuse, self->arena->nodes[m].text2);
                first = 0;
            }
            fputs("\n};\n\n", self->out);
        }
    }
    return 0;
}


/* Phase 31 O3 (S5b): a user element type owns a resource when it declares both
   `retain` (returning its own type) and `release`. The built-in containers
   always qualify. The return-type test keeps an unrelated `retain` from being
   mistaken for this protocol.

   Phase 36 S1a: a plain (non-generic) struct is not in the instance table, so
   when `ct_inst_find` misses we fall back to the struct row and match inherent
   impls by their N_IMPL `aux` (the struct row index). Without this,
   `Vec<Probe>` / `Vec<Str>` would never release their elements. */
static int elem_has_life(struct Emitter *self, const char *elem)
{
    const char *base;
    const char *want;
    int inst, si, k, n, m, got_r, got_rel;
    struct StructImpl *im;

    if (frontend::sym::ct_is_container_type(elem)) return 1;
    /* LANG-29 S2 / B3: an ADT element carries the compiler-written
       `T_retain` / `T_release` pair, so the container glue binds to it. */
    {
        int adi = frontend::sym::ct_adt_from_type(elem);
        if (adi >= 0) return adt_owns(self, adi, 0);
    }
    if (strncmp(elem, "struct ", 7) != 0) return 0;
    /* S1a-0 C2p-8: a view of the element spelling plus one interned prefix,
       so a 2000-byte element type is not cut at a 160 row. */
    base = elem + 7;
    want = runtime::text::ct_internf("struct %s", base);
    if (!want) return 0;
    im = frontend::sym::ct_impls(&n);
    inst = frontend::sym::ct_inst_find(base);
    if (inst >= 0) {
        got_r = 0;
        got_rel = 0;
        for (k = 0; im && k < n; k++) {
            if (im[k].use[0]) continue;
            if (!frontend::sym::ct_impl_matches(k, inst)) continue;
            for (m = self->arena->nodes[im[k].node].a; m >= 0;
                 m = self->arena->nodes[m].next) {
                if (strcmp(self->arena->nodes[m].text2, "release") == 0) got_rel = 1;
                if (strcmp(self->arena->nodes[m].text2, "retain") == 0
                    && self->arena->nodes[m].text[0]) {
                    const char *ret = elem_ret_ctype(inst, self->arena->nodes[m].text);
                    if (ret && strcmp(ret, want) == 0) got_r = 1;
                }
            }
            if (got_r && got_rel) return 1;
        }
        return 0;
    }
    /* Plain struct: inherent impls are N_IMPL nodes in the arena (they are not
       registered in the global ct_impls table, which only holds generic
       impls). Walk the arena for N_IMPL nodes whose aux is this struct row. */
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    got_r = 0;
    got_rel = 0;
    for (k = 0; k < self->arena->nnode; k++) {
        if (self->arena->nodes[k].kind != N_IMPL) continue;
        if (self->arena->nodes[k].aux != si) continue;
        if (self->arena->nodes[k].text2[0]) continue;  /* trait impl */
        for (m = self->arena->nodes[k].a; m >= 0;
             m = self->arena->nodes[m].next) {
            if (strcmp(self->arena->nodes[m].text2, "release") == 0) got_rel = 1;
            if (strcmp(self->arena->nodes[m].text2, "retain") == 0
                && self->arena->nodes[m].text[0]
                && (strcmp(self->arena->nodes[m].text, base) == 0
                    || strcmp(self->arena->nodes[m].text, want) == 0))
                got_r = 1;
        }
        if (got_r && got_rel) return 1;
    }
    return 0;
}

/* Phase 31 O3: the unit that writes an instance's methods owns its helpers, so
   the filter follows the impl owner, not the instance owner (a Vec instance is
   created in the user's unit while `impl<T> Vec<T>` lives in the built-in
   unit). */
static int inst_touched_by_unit(struct Emitter *self, int u, int ii)
{
    int k, n;
    struct StructImpl *im;

    (void)self;
    if (u < 0) return 1;
    im = frontend::sym::ct_impls(&n);
    for (k = 0; im && k < n; k++) {
        if (im[k].owner != u) continue;
        if (frontend::sym::ct_impl_matches(k, ii)) return 1;
    }
    return 0;
}

/* Phase 33 O3: an instance whose element belongs to a unit other than the
   container template's own. The template's unit cannot print the element's
   definition, so the per-instance helpers and methods move to the unit that
   named the instance (the only one that sees the element). */
/* The unit that declares a plain `struct` element, or -1 when the spelling is
   not one (a scalar, an interface value, an instance row, an unknown tag). */
static int elem_plain_owner(struct Emitter *self, const char *ctype)
{
    const char *base;
    int si;

    if (strncmp(ctype, "struct ", 7) != 0) return -1;
    base = ctype + 7;
    if (frontend::sym::ct_inst_find(base) >= 0) return -1;
    si = self->sym->find_struct(base);
    if (si < 0) return -1;
    return self->sym->structs[si].owner;
}

static int inst_elem_foreign(struct Emitter *self, int ii)
{
    int n, tn, tmpl, o1, o2;
    struct StructInst *ins;
    struct StructTmpl *tps;
    struct Expr *ex;
    const char *e1;
    const char *e2;

    ins = frontend::sym::ct_insts(&n);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!ins || !tps || ii < 0 || ii >= n) return 0;
    /* The containers keep the element behind a buffer handle, so their layout
       is printable anywhere; `Option` / `Result` store it by value (P34 S8),
       which makes a foreign element just as unprintable. `MapEntry` (PH-46)
       spells both slot types by value, so a foreign value makes its body
       unprintable in the built-in header too. Every other template keeps the
       Phase 33 rule. */
    /* PH-81: a built-in Box instance carries per-instance helpers that need
       the payload spelling, so it is always written by the unit that named it. */
    if (inst_is_builtin_Box(ins[ii].name)) return 1;
    if (strcmp(ins[ii].tmpl, "Vec") != 0 && strcmp(ins[ii].tmpl, "Map") != 0
        && strcmp(ins[ii].tmpl, "MapEntry") != 0
        && strcmp(ins[ii].tmpl, "Option") != 0 && strcmp(ins[ii].tmpl, "Result") != 0)
        return 0;
    tmpl = frontend::sym::ct_tmpl_find(ins[ii].tmpl);
    if (tmpl < 0 || tps[tmpl].owner < 0) return 0;
    e1 = ins[ii].ctype[0];
    e2 = ((strcmp(ins[ii].tmpl, "Map") == 0 || strcmp(ins[ii].tmpl, "MapEntry") == 0)
          && ins[ii].nargs > 1) ? ins[ii].ctype[1] : 0;
    /* An interface value (its trait's unit) or an owning instance (its
       template's unit) is judged by the Phase 31 reader. */
    ex = frontend::parse::expr_get();
    if (ex->container_elem_foreign(e1, tmpl)) return 1;
    if (e2 != 0 && ex->container_elem_foreign(e2, tmpl)) return 1;
    /* A plain struct carries its declaring unit directly (Phase 33): its
       definition travels only through that unit's header, which the container's
       unit does not include unless it is the same unit. */
    o1 = elem_plain_owner(self, e1);
    if (o1 >= 0 && o1 != tps[tmpl].owner) return 1;
    o2 = (e2 != 0) ? elem_plain_owner(self, e2) : -1;
    return o2 >= 0 && o2 != tps[tmpl].owner;
}

/* LANG-27: 1 when this unit can see the concrete C definition of instance
   `ii`. A `pub` template's non-foreign instance lives in its owner's header;
   the unit sees it when the header is built-in (every generated `.c` includes
   every layer header, E29-5), when the unit owns it, or when it is in the
   unit's transitive import closure (a generated `.c` / `.h` includes only
   its own header and its direct deps). A foreign-element or private-template
   instance lives only in its owner's `.c` (Phase 33 O3 / P34 S8). The Drop
   glue asks this before it reads an instance's fields, so a duplicated
   per-unit glue copy in a consumer that cannot see the element type stays
   empty instead of failing `cc` on an incomplete type. Compile mode
   (`cur_unit < 0`) owns every instance in the one file and needs no filter. */
static int inst_visible_in_unit(struct Emitter *self, int ii)
{
    char *reach;
    int n, tn, tmpl, d, k, changed, owner, bi;
    struct StructInst *ins;
    struct StructTmpl *tps;

    if (self->cur_unit < 0) return 1;
    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    tmpl = frontend::sym::ct_tmpl_find(ins[ii].tmpl);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!(tps && tmpl >= 0 && tps[tmpl].is_pub && tps[tmpl].owner >= 0
          && self->units[tps[tmpl].owner].is_hdr
          && !inst_elem_foreign(self, ii)))
        return ins[ii].owner == self->cur_unit;
    owner = tps[tmpl].owner;
    if (owner == self->cur_unit) return 1;
    for (bi = 0; bi < self->nbuiltin; bi++)
        if (self->builtins[bi] == owner) return 1;
    if (ensure_reach(self, *self->nunits) != 0) return self->fail("out of memory");
    reach = self->reach;
    for (d = 0; d < *self->nunits; d++) reach[d] = 0;
    reach[self->cur_unit] = 1;
    changed = 1;
    while (changed) {
        changed = 0;
        for (d = 0; d < (*self->nunits); d++) {
            if (!reach[d]) continue;
            for (k = 0; k < self->units[d].ndep; k++) {
                int dep = self->units[d].depu[k];
                if (dep >= 0 && dep < *self->nunits && !reach[dep]) {
                    reach[dep] = 1;
                    changed = 1;
                }
            }
        }
    }
    return reach[owner];
}

/* Phase 33 O3: which unit writes the element-lifecycle helper pair. A foreign
   element moves the pair to the unit that named the instance; every other case
   keeps the Phase 31 rule (the impl owner writes it). */
static int inst_writes_helpers(struct Emitter *self, int u, int ii)
{
    int n;
    struct StructInst *ins;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (!inst_elem_foreign(self, ii)) return inst_touched_by_unit(self, u, ii);
    if (u < 0) return 1;
    return ins[ii].owner == u;
}

/* Phase 36 S1a: forward-declare a plain-struct element's retain/release so the
   elem helpers (emitted before the inherent method bodies) compile. The return
   type is read straight off the method node, the same spelling the definition
   uses. */
static int inst_emit_elem_method_protos(struct Emitter *self, const char *elem)
{
    const char *base;
    const char *want;
    int si, k, m;

    if (frontend::sym::ct_is_container_type(elem)) return 0;
    if (strncmp(elem, "struct ", 7) != 0) return 0;
    base = elem + 7;
    si = self->sym->find_struct(base);
    if (si < 0) return 0;
    want = runtime::text::ct_internf("struct %s", base);
    if (!want) return -1;
    for (k = 0; k < self->arena->nnode; k++) {
        if (self->arena->nodes[k].kind != N_IMPL) continue;
        if (self->arena->nodes[k].aux != si) continue;
        if (self->arena->nodes[k].text2[0]) continue;
        for (m = self->arena->nodes[k].a; m >= 0; m = self->arena->nodes[m].next) {
            const char *mname = self->arena->nodes[m].text2;
            const char *rtype;
            if (strcmp(mname, "retain") != 0 && strcmp(mname, "release") != 0)
                continue;
            rtype = self->arena->nodes[m].text[0]
                    ? self->arena->nodes[m].text : "void";
            /* Match the definition's linkage: private structs emit static
               methods, pub structs emit external-linkage ones. */
            if (!self->decl_is_pub(N_STRUCT, base)
                || self->arena->nodes[m].d != 1)
                fputs("static ", self->out);
            fprintf(self->out, "%s %s_%s(%s *);\n", rtype, base, mname, want);
        }
    }
    return 0;
}

/* Phase 31 O3: the definitions live after the instance methods, so a prototype
   pair must precede every body that calls them (compile mode has no header). */
static int inst_emit_elem_protos(struct Emitter *self, int ii)
{
    int n;
    struct StructInst *ins;
    const char *elem;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (strcmp(ins[ii].tmpl, "Vec") == 0) elem = ins[ii].ctype[0];
    else if (strcmp(ins[ii].tmpl, "Map") == 0) elem = ins[ii].ctype[1];
    else return 0;
    /* Phase 36 S1a: a plain-struct element's retain/release are inherent
       methods emitted after the elem helpers, so forward-declare them.
       Container elements get their methods from the instance impls above. */
    if (elem_has_life(self, elem) && inst_emit_elem_method_protos(self, elem) != 0)
        return -1;
    /* PH-47: a `Map` also stores its key by value. An owning key (`Str`) is
       deep-copied and released by the key block in `lib/core/Vec.h.ct`, whose
       bodies sit with the instance methods and call the key's `retain` /
       `release` before those inherent definitions are written; compile mode has
       no header to supply the prototypes, so forward-declare them here too.
       The key is only a plain struct for the `Str` block (the other keys are
       `int`, `long` or `char *`), so the other key blocks are unchanged. */
    if (strcmp(ins[ii].tmpl, "Map") == 0
        && elem_has_life(self, ins[ii].ctype[0])
        && inst_emit_elem_method_protos(self, ins[ii].ctype[0]) != 0)
        return -1;
    fprintf(self->out, "static void %s__elem_retain(%s *e);\n",
            ins[ii].name, elem);
    fprintf(self->out, "static void %s__elem_release(%s *e);\n",
            ins[ii].name, elem);
    return 0;
}

/* Phase 31 O3: one pair of element lifecycle helpers per container instance.
   `retain`/`release` on an element type that owns a resource copy the bumped
   handle and guard a release whose handle is already empty when the element is
   itself a Vec / Map; every other element is non-owning and gets empty bodies.
   The calls in lib/core spell the reserved names and bind to these at emission
   time (`ginst`). */
static int inst_emit_elem_helpers(struct Emitter *self, int ii)
{
    int n, life, handle;
    struct StructInst *ins;
    const char *elem;
    const char *iname;
    const char *ename;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (strcmp(ins[ii].tmpl, "Vec") == 0) elem = ins[ii].ctype[0];
    else if (strcmp(ins[ii].tmpl, "Map") == 0) elem = ins[ii].ctype[1];
    else return 0;
    iname = ins[ii].name;
    handle = frontend::sym::ct_is_container_type(elem);
    life = elem_has_life(self, elem);
    ename = elem;
    if (strncmp(ename, "struct ", 7) == 0) ename += 7;
    fprintf(self->out,
            "static void __attribute__((unused)) %s__elem_retain(%s *e)\n{\n",
            iname, elem);
    if (life) fprintf(self->out, "    *e = %s_retain(e);\n}\n\n", ename);
    else fputs("    (void)e;\n}\n\n", self->out);
    fprintf(self->out,
            "static void __attribute__((unused)) %s__elem_release(%s *e)\n{\n",
            iname, elem);
    if (life && handle)
        fprintf(self->out, "    if (e->h == 0) return;\n    (void)%s_release(e);\n}\n\n",
                ename);
    else if (life)
        fprintf(self->out, "    (void)%s_release(e);\n}\n\n", ename);
    else fputs("    (void)e;\n}\n\n", self->out);
    return 0;
}

static int emit_struct_impls(struct Emitter *self, int u, int header)
{
    int ki, nimpls, i, ninsts, ntmpls, tmpl;
    struct StructImpl *im;
    struct StructInst *ins;
    struct StructTmpl *tps;

    im = frontend::sym::ct_impls(&nimpls);
    ins = frontend::sym::ct_insts(&ninsts);
    tps = frontend::sym::ct_tmpls(&ntmpls);
    (void)ntmpls;
    if (!im || !tps) return 0;
    if (!header) {
        /* SH-102 (compile mode): one merged program emits a container impl
           (`Result<String, …>`) before the String layer's own prototypes, so a
           call the automatic retain added had no declaration. Every struct is
           complete by now (types are written before the impls), so declare the
           four entry points here; an identical later prototype is harmless. */
        if (self->cur_unit < 0
            && self->sym->find_struct("String") >= 0
            && self->sym->find_struct("U16String") >= 0)
            fputs("struct String String_retain(struct String *);\n"
                  "void String_release(struct String *);\n"
                  "struct U16String U16String_retain(struct U16String *);\n"
                  "void U16String_release(struct U16String *);\n", self->out);
        for (i = 0; i < ninsts; i++) {
            if (!inst_writes_helpers(self, u, i)) continue;
            if (inst_emit_elem_protos(self, i) != 0) return -1;
        }
    }
    for (ki = 0; ki < nimpls; ki++) {
        tmpl = frontend::sym::ct_tmpl_find(im[ki].tmpl);
        if (header) {
            int via_hdr;
            if (tmpl < 0 || (u >= 0 && im[ki].owner != u)) continue;
            via_hdr = tps[tmpl].is_pub && tps[tmpl].owner >= 0
                      && self->units[tps[tmpl].owner].is_hdr;
            if (!via_hdr || tps[tmpl].owner != u) continue;
            for (i = 0; i < ninsts; i++) {
                int m;
                if (!frontend::sym::ct_impl_matches(ki, i)) continue;
                /* Phase 33 O3: a foreign-element instance's methods are a
                   private copy in the consumer, so the header declares none. */
                if (inst_elem_foreign(self, i)) continue;
                for (m = self->arena->nodes[im[ki].node].a; m >= 0;
                     m = self->arena->nodes[m].next)
                    if (impl_emit_method(self, ki, i, m, 1) != 0) return -1;
            }
            continue;
        }
        for (i = 0; i < ninsts; i++) {
            if (!frontend::sym::ct_impl_matches(ki, i)) continue;
            /* Phase 33 O3: the unit that named a foreign-element instance
               writes its methods; every other instance belongs to the impl
               owner (Phase 29/31). */
            if (inst_elem_foreign(self, i)) {
                if (u >= 0 && ins[i].owner != u) continue;
            } else if (u >= 0 && im[ki].owner != u) {
                continue;
            }
            if (impl_emit_one(self, ki, i) != 0) return -1;
        }
    }
    if (!header) {
        for (i = 0; i < ninsts; i++) {
            if (!inst_writes_helpers(self, u, i)) continue;
            if (inst_emit_elem_helpers(self, i) != 0) return -1;
        }
    }
    return 0;
}


/* P-7.2: the erased slice representation and its helpers. A slice is
   `{ptr,len}`; the element type is erased here and restored by the cast at
   each use, so one struct serves every `T[]` and no per-element name is
   registered. `__ct_slice_at` is the checked place (`s[i]`), `__ct_slice_get`
   the soft access (`s.get(i)`), `__ct_slice_range` the subslice constructor
   (the bounds a literal array length already proved are checked again here
   for the forms only a length at run time can judge). All three are `static`
   and marked unused, so a program that never calls one stays warning-free. */
static void emit_slice_helpers(struct Emitter *self)
{
    fputs("#include <stdio.h>\n#include <stdlib.h>\n", self->out);
    fputs("struct __ct_slice { void *ptr; int len; };\n", self->out);
    fputs("static void __attribute__((unused)) __ct_slice_check(struct __ct_slice *s, int i)\n"
          "{\n"
          "    if (i < 0 || i >= s->len) {\n"
          "        fprintf(stderr, \"ct: slice index %d out of bounds (length %d)\\n\", i, s->len);\n"
          "        exit(1);\n"
          "    }\n"
          "}\n"
          "__attribute__((unused)) static void *__ct_slice_at(struct __ct_slice *s, int i, unsigned long esz)\n"
          "{\n"
          "    __ct_slice_check(s, i);\n"
          "    return (char *)s->ptr + (unsigned long)i * esz;\n"
          "}\n"
          "__attribute__((unused)) static void *__ct_slice_get(struct __ct_slice s, int i, unsigned long esz)\n"
          "{\n"
          "    if (i < 0 || i >= s.len) return 0;\n"
          "    return (char *)s.ptr + (unsigned long)i * esz;\n"
          "}\n"
          "__attribute__((unused)) static struct __ct_slice __ct_slice_range(void *p, int len, int lo, int hi, unsigned long esz, const char *where)\n"
          "{\n"
          "    struct __ct_slice s;\n"
          "    if (lo < 0 || hi < lo || hi > len) {\n"
          "        fprintf(stderr, \"%s: slice construction out of bounds: [%d,%d) for length %d\\n\", where, lo, hi, len);\n"
          "        exit(1);\n"
          "    }\n"
          "    s.ptr = (char *)p + (unsigned long)lo * esz;\n"
          "    s.len = hi - lo;\n"
          "    return s;\n"
          "}\n\n", self->out);
}



/* LANG-29 S1 / B1: the ADT payload layout closure.
 *
 * A payload is stored by value, so a concrete generic instance it names
 * (`Vec<N>` / `Map<String, N>`) must be a complete type when the union is
 * written. The instance writer (`emit_struct_insts`) runs after every plain
 * type, so without this walk the ADT would hold an incomplete `struct Vec_N`.
 * The walk pre-emits exactly the instance *shell* -- the struct definition --
 * before the ADT, in dependency order; the instance bodies (its methods and
 * helpers) and `MapEntry_*` stay in their usual place, and the shared
 * `emitted` flag keeps the later writer from repeating the definition.
 *
 * A by-value cycle (direct self reference, mutual reference, or a cycle that
 * only closes through an instance field) is not lawfully laid out by C: it is
 * refused here instead of leaving invalid C. A chain longer than the depth
 * limit is refused for the same reason a recursive walk needs a bound. A
 * pointer field (`N *next`) is not a layout dependency, so it is skipped.
 *
 * `g_shell_u` / `g_shell_header` name the writer that is running. An instance
 * the template owner's header already defines is not repeated here; when the
 * owner's header is the one being written, it is not visible yet and the shell
 * must be emitted. Caps are the starting capacities (`MAX_LAYOUT_ADTS` 64,
 * `MAX_LAYOUT_INSTS` 128); the ADT/instance tables grow beyond them. */
#define MAX_LAYOUT_DEPTH 32
#define MAX_LAYOUT_ADTS 64
#define MAX_LAYOUT_INSTS 128

/* S1a-0 C1: the three layout-state arrays grow with the actual table counts.
   `MAX_LAYOUT_*` is only the starting capacity; a layout walk never silently
   skips an ADT or instance because its index is past a fixed bound. */
static int *g_adt_layout_state;
static int g_adt_layout_cap;
static int *g_inst_layout_state;
static int g_inst_layout_cap;
static int *g_shell_emit_state;
static int g_shell_emit_cap;

static int ensure_adt_layout_state(int need)
{
    int cap;
    int *grown;
    if (need <= g_adt_layout_cap) return 0;
    cap = g_adt_layout_cap > 0 ? g_adt_layout_cap : MAX_LAYOUT_ADTS;
    while (cap < need && cap < CAP_LIMIT) cap *= 2;
    if (cap > CAP_LIMIT) cap = CAP_LIMIT;
    if (need > cap) return -1;
    grown = (int *)realloc(g_adt_layout_state, (size_t)cap * sizeof(*grown));
    if (!grown) return -1;
    memset(grown + g_adt_layout_cap, 0, (size_t)(cap - g_adt_layout_cap) * sizeof(*grown));
    g_adt_layout_state = grown;
    g_adt_layout_cap = cap;
    return 0;
}

static int ensure_inst_layout_state(int need)
{
    int cap;
    int *grown;
    if (need <= g_inst_layout_cap) return 0;
    cap = g_inst_layout_cap > 0 ? g_inst_layout_cap : MAX_LAYOUT_INSTS;
    while (cap < need && cap < CAP_LIMIT) cap *= 2;
    if (cap > CAP_LIMIT) cap = CAP_LIMIT;
    if (need > cap) return -1;
    grown = (int *)realloc(g_inst_layout_state, (size_t)cap * sizeof(*grown));
    if (!grown) return -1;
    memset(grown + g_inst_layout_cap, 0, (size_t)(cap - g_inst_layout_cap) * sizeof(*grown));
    g_inst_layout_state = grown;
    g_inst_layout_cap = cap;
    return 0;
}

static int ensure_shell_emit_state(int need)
{
    int cap;
    int *grown;
    if (need <= g_shell_emit_cap) return 0;
    cap = g_shell_emit_cap > 0 ? g_shell_emit_cap : MAX_LAYOUT_INSTS;
    while (cap < need && cap < CAP_LIMIT) cap *= 2;
    if (cap > CAP_LIMIT) cap = CAP_LIMIT;
    if (need > cap) return -1;
    grown = (int *)realloc(g_shell_emit_state, (size_t)cap * sizeof(*grown));
    if (!grown) return -1;
    memset(grown + g_shell_emit_cap, 0, (size_t)(cap - g_shell_emit_cap) * sizeof(*grown));
    g_shell_emit_state = grown;
    g_shell_emit_cap = cap;
    return 0;
}

/* S1a-0 C1: one scratch byte per unit for the reachability walks. The block
   follows `*self->nunits`, which grows past the old 64-unit cap. */
static int ensure_reach(struct Emitter *self, int need)
{
    int cap;
    char *grown;
    if (need <= self->reachcap) return 0;
    cap = self->reachcap > 0 ? self->reachcap : 64;
    while (cap < need && cap < 65536) cap *= 2;
    if (cap > 65536) cap = 65536;
    if (need > cap) return -1;
    grown = (char *)realloc(self->reach, (size_t)cap);
    if (!grown) return -1;
    memset(grown + self->reachcap, 0, (size_t)(cap - self->reachcap));
    self->reach = grown;
    self->reachcap = cap;
    return 0;
}

/* 1 when `type` names `struct <name>` by value, so the named layout must be
   complete before a field of `type` can be written. A pointer field, an array
   of pointers and a function-pointer parameter need only a forward
   declaration, so they are not dependencies. */
/* The instance a by-value type spelling names, or -1. */
static int adt_layout_closure(struct Emitter *self, int adi, int depth);
static int inst_layout_closure(struct Emitter *self, int ii, int depth);

/* One by-value type edge: an ADT or an instance, else nothing. */
static int type_layout_closure(struct Emitter *self, const char *type, int depth)
{
    int ai, ii;

    if (!type || !type[0] || strchr(type, '*') || strchr(type, '(')) return 0;
    ai = frontend::sym::ct_adt_from_type(type);
    if (ai >= 0) return adt_layout_closure(self, ai, depth);
    ii = type_inst_index(type);
    if (ii >= 0) return inst_layout_closure(self, ii, depth);
    return 0;
}

static int adt_layout_closure(struct Emitter *self, int adi, int depth)
{
    int v, f, nadts;
    struct Adt *adts;

    adts = frontend::sym::ct_adts(&nadts);
    if (!adts || adi < 0 || adi >= nadts) return 0;
    if (ensure_adt_layout_state(nadts) != 0)
        return self->fail("out of memory");
    if (depth > MAX_LAYOUT_DEPTH)
        return self->fail(tool::sh::ct_scratch_fmt(
            "a by-value ADT payload nests deeper than %d; use a pointer or a container",
            MAX_LAYOUT_DEPTH));
    if (g_adt_layout_state[adi] == 2) return 0;
    if (g_adt_layout_state[adi] == 1)
        return self->fail(tool::sh::ct_scratch_fmt(
            "ADT '%s' is recursive by value; store a pointer or a container instead",
            adts[adi].name));
    g_adt_layout_state[adi] = 1;
    for (v = 0; v < adts[adi].nvariants; v++)
        for (f = 0; f < adts[adi].variants[v].nfields; f++)
            if (type_layout_closure(self, adts[adi].variants[v].fields[f].type,
                                    depth + 1) != 0)
                return -1;
    g_adt_layout_state[adi] = 2;
    return 0;
}

/* An instance's fields are concrete C spellings, so a by-value edge to another
   instance is walked the same way; a self edge is a layout cycle. */
static int inst_layout_closure(struct Emitter *self, int ii, int depth)
{
    int ti, j, n;
    struct StructInst *ins;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n || ii >= MAX_LAYOUT_INSTS) return 0;
    if (depth > MAX_LAYOUT_DEPTH)
        return self->fail(tool::sh::ct_scratch_fmt(
            "a by-value ADT payload nests deeper than %d; use a pointer or a container",
            MAX_LAYOUT_DEPTH));
    if (g_inst_layout_state[ii] == 2) return 0;
    if (g_inst_layout_state[ii] == 1)
        return self->fail(tool::sh::ct_scratch_fmt(
            "generic instance '%s' is recursive by value; store a pointer instead",
            ins[ii].name));
    g_inst_layout_state[ii] = 1;
    ti = self->sym->find_struct(ins[ii].name);
    if (ti >= 0) {
        for (j = 0; j < self->sym->structs[ti].nfields; j++)
            if (type_layout_closure(self, self->sym->structs[ti].fields[j].type,
                                    depth + 1) != 0)
                return -1;
    }
    g_inst_layout_state[ii] = 2;
    return 0;
}

/* 1 when this writer must print the instance definition: its template owner's
   header already carries it otherwise. */
static int shell_owned_here(struct Emitter *self, int ii)
{
    int tmpl, tn, n, already;
    struct StructInst *ins;
    struct StructTmpl *tps;

    ins = frontend::sym::ct_insts(&n);
    tps = frontend::sym::ct_tmpls(&tn);
    if (!ins || !tps || ii < 0 || ii >= n) return 0;
    tmpl = frontend::sym::ct_tmpl_find(ins[ii].tmpl);
    if (tmpl < 0) return 0;
    already = tps[tmpl].is_pub && tps[tmpl].owner >= 0
              && self->units[tps[tmpl].owner].is_hdr
              && !inst_elem_foreign(self, ii);
    /* The owner's header is included before the types, except when it is the
       file being written now: that definition has not been reached yet. */
    if (already && g_shell_header && tps[tmpl].owner == g_shell_u) already = 0;
    if (already) return 0;
    if (g_shell_u < 0) return 1;
    return ins[ii].owner == g_shell_u;
}

/* Emit `ii`'s shell after the shells its own by-value fields need. */
static int shell_preemit(struct Emitter *self, int ii, int depth)
{
    int ti, j, n;
    struct StructInst *ins;

    ins = frontend::sym::ct_insts(&n);
    if (!ins || ii < 0 || ii >= n) return 0;
    if (ensure_inst_layout_state(n) != 0 || ensure_shell_emit_state(n) != 0)
        return self->fail("out of memory");
    if (depth > MAX_LAYOUT_DEPTH)
        return self->fail(tool::sh::ct_scratch_fmt(
            "a by-value ADT payload nests deeper than %d; use a pointer or a container",
            MAX_LAYOUT_DEPTH));
    if (g_shell_emit_state[ii] == 2) return 0;
    if (g_shell_emit_state[ii] == 1)
        return self->fail(tool::sh::ct_scratch_fmt(
            "generic instance '%s' is recursive by value; store a pointer instead",
            ins[ii].name));
    g_shell_emit_state[ii] = 1;
    ti = self->sym->find_struct(ins[ii].name);
    if (ti >= 0) {
        for (j = 0; j < self->sym->structs[ti].nfields; j++) {
            int dep = type_inst_index(self->sym->structs[ti].fields[j].type);
            if (dep >= 0 && shell_preemit(self, dep, depth + 1) != 0) return -1;
        }
    }
    if (!ins[ii].emitted && shell_owned_here(self, ii))
        if (inst_emit_one(self, ii) != 0) return -1;
    g_shell_emit_state[ii] = 2;
    return 0;
}

/* Pre-emit every instance shell the ADT's payload names by value. */
static int preemit_adt_payload(struct Emitter *self, int adi)
{
    int v, f, i, n, nadts;
    struct Adt *adts;
    struct StructInst *ins;

    adts = frontend::sym::ct_adts(&nadts);
    ins = frontend::sym::ct_insts(&n);
    if (!adts || !ins || adi < 0 || adi >= nadts) return 0;
    if (ensure_shell_emit_state(n) != 0) return self->fail("out of memory");
    for (i = 0; i < n; i++) g_shell_emit_state[i] = 0;
    for (v = 0; v < adts[adi].nvariants; v++)
        for (f = 0; f < adts[adi].variants[v].nfields; f++)
            for (i = 0; i < n; i++) {
                if (!type_needs_layout(adts[adi].variants[v].fields[f].type,
                                       ins[i].name))
                    continue;
                if (shell_preemit(self, i, 0) != 0) return -1;
            }
    return 0;
}

/* `with_semi` is accepted for signature parity with the type writer. */
static int emit_adt_decl(struct Emitter *self, int n, int ind, int with_semi)
{
    int adi, v, f, i, n_inst;
    struct Adt *adts;
    int nadts;
    const char *tag;
    const char *alias;
    int is_typedef;
    (void)with_semi;

    adi = (int)self->arena->nodes[n].num - 1;
    adts = frontend::sym::ct_adts(&nadts);
    if (!adts || adi < 0 || adi >= nadts)
        return self->fail_from(n, "the ADT row is missing");
    /* LANG-29 S1 / B1: refuse a layout that cannot close, then write the
       instance shells its payload holds before the union. The state arrays
       grow to the actual counts; only the live prefix is reset. */
    n_inst = 0;
    (void)frontend::sym::ct_insts(&n_inst);
    if (ensure_adt_layout_state(nadts) != 0
        || ensure_inst_layout_state(n_inst) != 0)
        return self->fail("out of memory");
    for (i = 0; i < nadts; i++) g_adt_layout_state[i] = 0;
    for (i = 0; i < n_inst; i++) g_inst_layout_state[i] = 0;
    if (adt_layout_closure(self, adi, 0) != 0) return -1;
    if (preemit_adt_payload(self, adi) != 0) return -1;
    is_typedef = (self->arena->nodes[n].aux & 1) ? 1 : 0;
    tag = adts[adi].full;
    alias = self->arena->nodes[n].text2;
    if (is_typedef) {
        fprintf(self->out, "typedef struct %s {\n", tag);
    } else {
        fprintf(self->out, "struct %s {\n", tag);
    }
    self->emit_indent(ind + 1);
    fputs("int tag;\n", self->out);
    self->emit_indent(ind + 1);
    fputs("union {\n", self->out);
    for (v = 0; v < adts[adi].nvariants; v++) {
        if (adts[adi].variants[v].nfields == 0) continue;
        self->emit_indent(ind + 2);
        fputs("struct {\n", self->out);
        for (f = 0; f < adts[adi].variants[v].nfields; f++) {
            self->emit_indent(ind + 3);
            fprintf(self->out, "%s %s;\n", adts[adi].variants[v].fields[f].type,
                    adts[adi].variants[v].fields[f].name);
        }
        self->emit_indent(ind + 2);
        fprintf(self->out, "} %s;\n", adts[adi].variants[v].cname);
    }
    self->emit_indent(ind + 1);
    fputs("} u;\n", self->out);
    self->emit_indent(ind);
    fputs("}", self->out);
    if (is_typedef) fprintf(self->out, " %s", alias);
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    fputs(";\n", self->out);
    /* E84-5: the ABI promises exactly two facts about the layout, and both are
       assertable without naming a platform number. */
    fprintf(self->out,
            "_Static_assert(offsetof(struct %s, tag) == 0, \"%s: the tag must come first\");\n",
            tag, tag);
    fprintf(self->out,
            "_Static_assert(offsetof(struct %s, u) >= sizeof(int), \"%s: the payload union must follow the tag\");\n",
            tag, tag);
    fprintf(self->out,
            "_Static_assert(offsetof(struct %s, u) >= offsetof(struct %s, tag) + sizeof(int), \"%s: the tag must end before the payload union\");\n",
            tag, tag, tag);
    fprintf(self->out,
            "_Static_assert(sizeof(struct %s) >= offsetof(struct %s, u) + sizeof(((struct %s *)0)->u), \"%s: the payload must fit\");\n",
            tag, tag, tag, tag);
    /* LANG-29 S2 / B3: the owning-value protocol is declared with the layout so
       the element glue and every copy site see it before its definition. A pub
       ADT publishes it from the header; a private one keeps it static. */
    if (adt_owns(self, adi, 0)) {
        int link = adts[adi].is_pub && !g_shell_header ? 0 : 1;
        fputs(link ? "static " : "", self->out);
        fprintf(self->out, "struct %s %s_retain(struct %s *);\n", tag, tag, tag);
        fputs(link ? "static " : "", self->out);
        fprintf(self->out, "void %s_release(struct %s *);\n", tag, tag);
    }
    return 0;
}

/* One arm of a `match`. The bindings belong to the arm's own block, so the
   emitter prepends one N_DECL per binding (aux 3 marks "may be unused") whose
   N_RAW initialiser carries the accessor, then lets the ordinary block writer
   emit the block: scope release, `defer` and AutoDrop behave exactly as in a
   hand-written block. The chain is restored after the write. */
/* v1-PH-2 S4: the arm's extra runtime tests. The parser serialises them as
   `path=value;` rows (path empty = the subject itself, otherwise an accessor
   beginning with `.` or `->`). The tag test of a root variant is emitted by
   the caller; everything nested or literal lands here. */
static int emit_arm_conds(struct Emitter *self, int arm, int k, int *ncond)
{
    const char *enc;

    *ncond = 0;
    enc = self->arena->nodes[arm].text4;
    if (!enc || !enc[0]) return 0;
    while (*enc) {
        const char *eq;
        const char *semi;

        eq = strchr(enc, '=');
        semi = strchr(enc, ';');
        if (!eq || !semi || eq > semi)
            return self->fail_from(arm, "malformed match pattern test");
        fputs(" && (", self->out);
        fprintf(self->out, "__ct_match%d", k);
        fwrite(enc, 1, (size_t)(eq - enc), self->out);
        fputs(" == ", self->out);
        fwrite(eq + 1, 1, (size_t)(semi - eq - 1), self->out);
        fputs(")", self->out);
        (*ncond)++;
        enc = semi + 1;
    }
    return 0;
}

static int emit_match_arm(struct Emitter *self, int arm, int ind, int k, int ptr)
{
    int b, i, first, last, save, r;
    struct Adt *adts;
    int nadts;

    (void)adts;
    (void)nadts;
    (void)ptr;
    b = self->arena->nodes[arm].b;
    if (b < 0) return self->fail_from(arm, "the match arm has no body");
    /* LANG-29 S4 / B5: bit 1 is the wildcard; bit 2 marks an expression-match
       arm (whose block carries the yield assignment), so only bit 1 skips the
       binding prefix. */
    if (self->arena->nodes[arm].aux & 1) return self->emit_node(b, ind);
    first = -1;
    last = -1;
    for (i = self->arena->nodes[arm].a; i >= 0; i = self->arena->nodes[i].next) {
        int decl = self->arena->nodes[i].a;
        int raw = self->arena->nodes[i].b;
        if (decl < 0 || raw < 0) continue;
        {
            const char *path;
            path = self->arena->nodes[i].text4;
            if (path && strcmp(path, "*") == 0)
                self->arena->nodes[raw].text = runtime::text::ct_internf(
                    "(*__ct_match%d)", k);
            else if (path && path[0])
                self->arena->nodes[raw].text = runtime::text::ct_internf(
                    "__ct_match%d%s", k, path);
            else
                self->arena->nodes[raw].text = runtime::text::ct_internf(
                    "__ct_match%d", k);
        }
        if (!self->arena->nodes[raw].text) return self->fail("out of memory");
        self->arena->nodes[decl].next = -1;
        if (first < 0) first = decl;
        else self->arena->nodes[last].next = decl;
        last = decl;
    }
    save = self->arena->nodes[b].a;
    if (first >= 0) {
        self->arena->nodes[last].next = save;
        self->arena->nodes[b].a = first;
    }
    r = self->emit_node(b, ind);
    self->arena->nodes[b].a = save;
    for (i = first; i >= 0; ) {
        int nxt = self->arena->nodes[i].next;
        self->arena->nodes[i].next = -1;
        if (nxt == save) break;
        i = nxt;
    }
    return r;
}


/* ======================================================================
 * PH-88 (v0.88.0): the emitter's node-kind dispatch, one slice per kind.
 *
 * `emit_node` / `emit_expr` / `emit_type_decl` / `emit_inline` /
 * `emit_field` used to be if-chains that re-read `nodes[n].kind` at every
 * arm. Each arm is now a function of its own, and the dispatcher reads
 * the kind once and passes it in. A new kind without a slice is a visible
 * hole (`p88_emit` pins the inventory), and the rewrite is byte-identical
 * for the test corpus (D-017 A1 layer 1). These are free functions, not
 * trait methods: the compiler's MAX_FUNCS budget counts top-level
 * signatures, and the trait surface must not grow.
 * ====================================================================== */

/* PH-88/v1-PH-0 S0.5: the shared body for a kind the statement emitter does
   not accept. The exhaustive match keeps every kind an explicit arm; the
   non-statement arms share this one body. */
static int fail_unknown_statement(struct Emitter *self, int nk)
{
    /* Short fixed diagnostic: the only variable is a kind number. */
    char msg[MAX_TEXT];
    snprintf(msg, sizeof msg, "unknown statement node (kind %d)", nk);
    return self->fail(msg);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_adtctor(struct Emitter *self, int n, int nk)
{
    (void)nk;


    int adi2, v2, f2, a2;
    const char *pfx;
    struct Adt *adts2;
    int nadts2;
    adi2 = frontend::sym::ct_adt_find(self->arena->nodes[n].text);
    adts2 = frontend::sym::ct_adts(&nadts2);
    if (!adts2 || adi2 < 0 || adi2 >= nadts2)
        return self->fail_from(n, "the ADT row is missing");
    v2 = (int)self->arena->nodes[n].num;
    if (v2 < 0 || v2 >= adts2[adi2].nvariants)
        return self->fail_from(n, "the ADT variant row is missing");
    fprintf(self->out, "((struct %s){ .tag = %d", adts2[adi2].full, v2);
    if (adts2[adi2].variants[v2].nfields > 0) {
        fprintf(self->out, ", .u = { .%s = { ", adts2[adi2].variants[v2].cname);
        a2 = self->arena->nodes[n].a;
        for (f2 = 0; f2 < adts2[adi2].variants[v2].nfields; f2++) {
            int retain;
            if (f2 > 0) fputs(", ", self->out);
            if (a2 < 0) return self->fail_from(n, "an ADT argument is missing");
            /* LANG-29 S2 / B3: the payload stores the value, so an owning
               argument that stays owned elsewhere is retained here (a fresh
               call result / nested constructor moves its own reference in). */
            pfx = sb_life_prefix_text(self, adts2[adi2].variants[v2].fields[f2].type);
            retain = pfx && !sb_rhs_fresh(self, a2)
                     && (sb_is_place(self, a2)
                         || self->arena->nodes[a2].kind == N_RAW);
            fprintf(self->out, ".%s = (", adts2[adi2].variants[v2].fields[f2].name);
            if (retain) fprintf(self->out, "%s_retain(&(", pfx);
            if (self->emit_expr(a2) != 0) return -1;
            if (retain) fputs("))", self->out);
            fputs(")", self->out);
            a2 = self->arena->nodes[a2].next;
        }
        fputs(" } }", self->out);
    }
    fputs(" })", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_num(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* `text` holds the normalized integer suffix (`U`, `UL`, `LL`, …) */
    fprintf(self->out, "%ld%s", self->arena->nodes[n].num, self->arena->nodes[n].text);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_fnum(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs(self->arena->nodes[n].text, self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_str(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *lit = self->arena->str_at(self->arena->nodes[n].num);
    /* PH-80: a literal bound to String / Str becomes the matching
       handle. The String form names the static block above; the Str
       form is a borrowed view over the C literal itself. */
    if (self->arena->nodes[n].aux == 1) {
        fprintf(self->out,
                "((struct String){ (char *)ct_str_lit_%d.d,"
                " (int)(sizeof(ct_str_lit_%d.d) - 1) })", n, n);
        return 0;
    }
    if (self->arena->nodes[n].aux == 2) {
        fprintf(self->out,
                "((struct Str){ (char *)%s, (int)(sizeof(%s) - 1) })",
                lit, lit);
        return 0;
    }
    fputs(lit, self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_raw(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* a pooled initialiser (`aux = 1`) or a bare spelling in `text` */
    fputs(self->arena->nodes[n].aux
              ? self->arena->str_at((int)self->arena->nodes[n].num)
              : self->arena->nodes[n].text, self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_var(struct Emitter *self, int n, int nk)
{
    (void)nk;


    int ci, k;
    /* Phase 24: `$` is the index of the element being written. The cast
       is deliberate -- `((int)k)` keeps a `char` or an unsigned element
       printing exactly like a hand-written `(int)k` would. */
    if (self->range_depth > 0 && strcmp(self->arena->nodes[n].text2, "$") == 0) {
        fprintf(self->out, "((int)%d)", self->range_k);
        return 0;
    }
    /* inside a trampoline body a captured name is a field of the
       environment (Phase 21 S3) */
    ci = self->closure_ci;
    if (ci > 0) {
        struct Closure *cc = &self->sym->closures[ci - 1];
        for (k = 0; k < cc->ncap; k++)
            if (strcmp(cc->cap_name[k], self->arena->nodes[n].text2) == 0) {
                fprintf(self->out, "__ct_cl_e->%s", self->arena->nodes[n].text2);
                return 0;
            }
    }
    if (self->sym->self_mode && strcmp(self->arena->nodes[n].text2, "self") == 0) {
        fputs("_self", self->out);
    } else if (self->arena->nodes[n].aux == 2
               || self->arena->nodes[n].aux == 3) {
        /* Phase 78 S2: a ref/out parameter is a pointer in the C
           signature, so every read and write goes through `*`. */
        fprintf(self->out, "(*%s)", self->arena->nodes[n].text2);
    } else if (self->arena->nodes[n].text3[0]) {
        /* a namespaced global: `text3` carries the mangled C spelling */
        fputs(self->arena->nodes[n].text3, self->out);
    } else {
        fputs(self->arena->nodes[n].text2, self->out);
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_into(struct Emitter *self, int n, int nk)
{
    (void)nk;


    if (!self->arena->nodes[n].text3[0])
        return self->fail_from(n, "an 'into' receiver was not promoted");
    if (self->arena->nodes[n].aux == 2)
        fprintf(self->out, "(*%s)", self->arena->nodes[n].text3);
    else
        fputs(self->arena->nodes[n].text3, self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_into_self(struct Emitter *self, int n, int nk)
{
    (void)nk;


    int owner = self->arena->nodes[n].num;
    const char *nm;
    if (owner < 0 || !self->arena->nodes[owner].text3[0])
        return self->fail_from(n, "an 'into' receiver was not promoted");
    nm = self->arena->nodes[owner].text3;
    if (self->arena->nodes[n].aux == 1)
        fputs(nm, self->out);
    else if (self->arena->nodes[owner].aux == 2)
        fprintf(self->out, "(*%s)", nm);
    else
        fputs(nm, self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_member(struct Emitter *self, int n, int nk)
{
    (void)nk;


    int a = self->arena->nodes[n].a;
    /* P34 S5a: inside an inherent impl method `self` is a struct value
       in the source but a pointer (`_self`) in the emitted C, so the
       first member access on `self` spells `->`; deeper links keep `.`. */
    int self_arrow = self->sym->self_mode && a >= 0
                     && self->arena->nodes[a].kind == N_VAR
                     && strcmp(self->arena->nodes[a].text2, "self") == 0;
    if (self->emit_expr(a) != 0) return -1;
    fprintf(self->out, "%s%s", self_arrow ? "->" : ".",
            self->arena->nodes[n].text2);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_arrow(struct Emitter *self, int n, int nk)
{
    (void)nk;


    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fprintf(self->out, "->%s", self->arena->nodes[n].text2);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_index(struct Emitter *self, int n, int nk)
{
    (void)nk;


    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs("[", self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs("]", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_slice_index(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *et = self->arena->nodes[n].text;
    fputs("(*(", self->out);
    fputs(et, self->out);
    fputs(" *)__ct_slice_at(&(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs("), ", self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(", sizeof(", self->out);
    fputs(et, self->out);
    fputs(")))", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_slice_get(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *et = self->arena->nodes[n].text;
    fputs("((", self->out);
    fputs(et, self->out);
    fputs(" *)__ct_slice_get(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(", ", self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(", sizeof(", self->out);
    fputs(et, self->out);
    fputs(")))", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_slice_range(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *et = self->arena->nodes[n].text;
    /* SH-100: a whole-array view (`return a;`, `sum(a)`) is a plain
       `{ptr,len}` pair with no bounds to check; the array's own
       `sizeof` gives the inferred length. */
    if (self->arena->nodes[n].aux == 3) {
        fputs("(struct __ct_slice){ (void *)(", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs("), (int)(sizeof(", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(") / sizeof((", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(")[0])) }", self->out);
        return 0;
    }
    fputs("__ct_slice_range((void *)(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(self->arena->nodes[n].aux == 1 ? "), " : ").ptr, ", self->out);
    if (self->arena->nodes[n].aux == 1) {
        fputs("(int)(sizeof(", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(") / sizeof((", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(")[0]))", self->out);
    } else {
        fputs("(", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(").len", self->out);
    }
    fputs(", ", self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(", ", self->out);
    if (self->arena->nodes[n].c >= 0) {
        if (self->emit_expr(self->arena->nodes[n].c) != 0) return -1;
    } else if (self->arena->nodes[n].aux == 1) {
        fputs("(int)(sizeof(", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(") / sizeof((", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        /* SH-99: the whole `(int)(` cast must close here. The `len`
           branch above spells the identical `[0]))`. */
        fputs(")[0]))", self->out);
    } else {
        fputs("(", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(").len", self->out);
    }
    fprintf(self->out, ", sizeof(%s), \"%s:%d\")", et, self->path,
            self->arena->nodes[n].line);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_addr(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs("(&", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_deref(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs("(*", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_cast(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *ct = self->arena->nodes[n].text;
    const char *ctsub;
    int save_disc;
    ctsub = emit_gsub_type_text(self, ct);
    if (ctsub) ct = ctsub;
    fprintf(self->out, "(%s)(", ct);
    /* Phase 44: `(void)f()?` discards the payload, so the `?` must
       release it. Only the direct operand qualifies: `(void)(f()? + 1)`
       uses the value before the cast drops the sum. */
    save_disc = self->try_discard;
    if (strcmp(ct, "void") == 0 && self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_TRY)
        self->try_discard = 1;
    if (self->emit_expr(self->arena->nodes[n].a) != 0) {
        self->try_discard = save_disc;
        return -1;
    }
    self->try_discard = save_disc;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_compound(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* `(type){ … }`: the braces go through the same writer a declaration
       uses, so a trait-carrying struct gets its vptr items here too */
    fprintf(self->out, "(%s)", self->arena->nodes[n].text);
    return self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text, "", 0);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_vaarg(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *vt = self->arena->nodes[n].text;
    const char *vtsub;
    /* Phase 26 fix (SH-62): `va_arg(ap, T)` is a fifth type position;
       it had the same silent `T` leak as `sizeof(T)`. */
    vtsub = emit_gsub_type_text(self, vt);
    if (vtsub) vt = vtsub;
    fputs("va_arg(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fprintf(self->out, ", %s)", vt);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_sizeof(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* `aux` 1 is `sizeof(type)`, 2 is `_Alignof(type)`, 4 is
       `alignof(type)` (stdalign.h); 3 is `alignof(expr)`, 0 is
       `sizeof(expr)` */
    if (self->arena->nodes[n].aux && self->arena->nodes[n].a < 0) {
        static const char *const kw[5] = {"sizeof", "sizeof", "_Alignof",
                                          "alignof", "alignof"};
        const char *st = self->arena->nodes[n].text;
        const char *stsub;
        int a = self->arena->nodes[n].aux;
        stsub = emit_gsub_type_text(self, st);
        if (stsub) st = stsub;
        fprintf(self->out, "%s(%s)", kw[a < 0 || a > 4 ? 1 : a], st);
        return 0;
    }
    fputs(self->arena->nodes[n].aux == 3 ? "alignof(" : "sizeof(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_offsetof(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* the source carried the call, so the generated `.c` keeps it; the
       source unit supplies `#include <stddef.h>` (D-8) */
    const char *ot = self->arena->nodes[n].text;
    const char *otsub;
    otsub = emit_gsub_type_text(self, ot);
    if (otsub) ot = otsub;
    fprintf(self->out, "offsetof(%s, %s)", ot, self->arena->nodes[n].text2);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_post(struct Emitter *self, int n, int nk)
{
    (void)nk;


    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_pre(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
    return self->emit_expr(self->arena->nodes[n].a);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_try(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* S1a-0 C2p-8: the operand type and the Result columns are pool texts
       (or one formal-limit scratch when the parser did not stamp the type);
       the only fixed row left is the `__ct_q<N>` temporary, whose shape is
       a short integer. */
    const char *opty;
    const char *otag;
    char *oval;
    char *oerr;
    const char *rtag;
    char *rval;
    char *rerr;
    const char *vty;
    const char *ety;
    char qt[MAX_TEXT];
    int od = 0;
    int q, si, fi, h, save_disc;

    if (self->arena->nodes[n].text[0]) {
        /* the parser stamped the operand type while its locals were in
           scope; the emitter runs after the scopes are popped */
        opty = self->arena->nodes[n].text;
    } else {
        char *tb = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
        if (!hoist_ctype(self->arena->nodes[n].a, tb, TEXT_LIMIT, &od) || od != 0)
            return self->fail_from(n, "'?' needs a Result operand");
        opty = tb;
    }
    otag = self->try_result_tag(opty);
    oval = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
    oerr = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
    if (!otag
        || !self->try_result_cols(frontend::sym::ct_inst_find(otag),
                                  oval, TEXT_LIMIT, oerr, TEXT_LIMIT))
        return self->fail_from(n, "'?' needs a Result operand");
    if (!self->cur_ret[0])
        return self->fail_from(n, "'?' is not allowed here");
    /* the instance's field spellings, used for the move and the
       zero that invalidates the temporary */
    vty = "";
    ety = "";
    si = self->sym->find_struct(otag);
    for (fi = 0; si >= 0 && fi < self->sym->structs[si].nfields; fi++) {
        if (strcmp(self->sym->structs[si].fields[fi].name, "value") == 0)
            vty = self->sym->structs[si].fields[fi].type;
        else if (strcmp(self->sym->structs[si].fields[fi].name, "err") == 0)
            ety = self->sym->structs[si].fields[fi].type;
    }
    if (strcmp(self->cur_ret, "void") != 0) {
        rtag = self->try_result_tag(self->cur_ret);
        rval = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
        rerr = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
        if (!rtag
            || !self->try_result_cols(frontend::sym::ct_inst_find(rtag),
                                      rval, TEXT_LIMIT, rerr, TEXT_LIMIT))
            return self->fail_from(n,
                "postfix '?' needs a function returning Result");
        if (strcmp(oerr, rerr) != 0) {
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "'?': expected error type '%s', got '%s'", rerr, oerr));
        }
    }
    q = self->ntmp;
    self->ntmp++;
    snprintf(qt, sizeof qt, "__ct_q%d", q);
    fprintf(self->out, "({ %s %s = ", opty, qt);
    /* the operand is an ordinary value context, so an inner `?` must
       not inherit the outer statement's discard */
    save_disc = self->try_discard;
    self->try_discard = 0;
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    self->try_discard = save_disc;
    fputs(";\n", self->out);
    fprintf(self->out, "if (!%s.ok) {\n", qt);
    h = self->try_cleanup(n);
    while (h >= 0) {
        if (self->arena->nodes[h].kind == N_DEFER_RUN)
            self->emit_indent(1);
        if (self->emit_node(h, 1) != 0) return -1;
        h = self->arena->nodes[h].next;
    }
    if (strcmp(self->cur_ret, "void") == 0) {
        /* D44-5: a void function carries no payload; the error is
           discarded (released when the type owns something). */
        self->emit_indent(1);
        if (self->try_release_payload(ety, qt, "err") != 0) return -1;
        fputs("\n", self->out);
        self->emit_indent(1);
        fprintf(self->out, "%s = (%s){0};\n", qt, opty);
        self->emit_indent(1);
        fputs("return;\n", self->out);
    } else if (ety[0]) {
        self->emit_indent(1);
        fprintf(self->out, "%s __ct_e%d = %s.err;\n", ety, q, qt);
        self->emit_indent(1);
        fprintf(self->out, "%s = (%s){0};\n", qt, opty);
        self->emit_indent(1);
        fprintf(self->out, "return %s_err(__ct_e%d);\n", rtag, q);
    } else {
        self->emit_indent(1);
        fprintf(self->out, "return %s_err(%s.err);\n", rtag, qt);
    }
    fputs("}\n", self->out);
    if (self->try_discard) {
        self->emit_indent(1);
        if (self->try_release_payload(vty, qt, "value") != 0) return -1;
        fputs("\n", self->out);
        self->emit_indent(1);
        fprintf(self->out, "%s = (%s){0};\n", qt, opty);
        self->emit_indent(1);
        fputs("(void)0;\n", self->out);
    } else if (vty[0]) {
        self->emit_indent(1);
        fprintf(self->out, "%s __ct_v%d = %s.value;\n", vty, q, qt);
        self->emit_indent(1);
        fprintf(self->out, "%s = (%s){0};\n", qt, opty);
        self->emit_indent(1);
        fprintf(self->out, "__ct_v%d;\n", q);
    } else {
        self->emit_indent(1);
        fprintf(self->out, "%s = (%s){0};\n", qt, opty);
        self->emit_indent(1);
        fprintf(self->out, "%s.value;\n", qt);
    }
    fputs("})", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_opt(struct Emitter *self, int n, int nk)
{
    (void)nk;


    int use_temp = self->arena->nodes[n].text3[0] != 0;
    fputs("(", self->out);
    if (use_temp) {
        fputs("(", self->out);
        fputs(self->arena->nodes[n].text3, self->out);
        fputs(" = ", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(")", self->out);
    } else if (self->emit_expr(self->arena->nodes[n].a) != 0) {
        return -1;
    }
    fputs(" ? ", self->out);
    if (self->arena->nodes[n].aux == 1) {
        if (use_temp) fputs(self->arena->nodes[n].text3, self->out);
        else if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fprintf(self->out, "->%s", self->arena->nodes[n].text);
    } else if (self->arena->nodes[n].aux == 2) {
        if (use_temp) fputs(self->arena->nodes[n].text3, self->out);
        else if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs("[", self->out);
        if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
        fputs("]", self->out);
    } else {
        fprintf(self->out, "%s_get(", self->arena->nodes[n].text);
        if (use_temp) fputs(self->arena->nodes[n].text3, self->out);
        else if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(", ", self->out);
        if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
        fputs(")", self->out);
    }
    fputs(" : 0)", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_tern(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs("(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(" ? ", self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(" : ", self->out);
    if (self->emit_expr(self->arena->nodes[n].c) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_assign(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *aop = " = ";
    if (self->arena->nodes[n].aux == 1) aop = " += ";
    else if (self->arena->nodes[n].aux == 2) aop = " -= ";
    else if (self->arena->nodes[n].aux == 3) aop = " *= ";
    else if (self->arena->nodes[n].aux == 4) aop = " /= ";
    else if (self->arena->nodes[n].aux == 5) aop = " %= ";
    else if (self->arena->nodes[n].aux == 6) aop = " &= ";
    else if (self->arena->nodes[n].aux == 7) aop = " |= ";
    else if (self->arena->nodes[n].aux == 8) aop = " ^= ";
    else if (self->arena->nodes[n].aux == 9) aop = " <<= ";
    else if (self->arena->nodes[n].aux == 10) aop = " >>= ";
    fputs("(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(aop, self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_bin_comma(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs("(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(", ", self->out);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_bin(struct Emitter *self, int n, int nk)
{
    (void)nk;
    const char *op;
    (void)op;


    op = "+";
    if (self->arena->nodes[n].aux == B_SUB) op = "-";
    else if (self->arena->nodes[n].aux == B_MUL) op = "*";
    else if (self->arena->nodes[n].aux == B_DIV) op = "/";
    else if (self->arena->nodes[n].aux == B_MOD) op = "%";
    else if (self->arena->nodes[n].aux == B_LT) op = "<";
    else if (self->arena->nodes[n].aux == B_GT) op = ">";
    else if (self->arena->nodes[n].aux == B_LE) op = "<=";
    else if (self->arena->nodes[n].aux == B_GE) op = ">=";
    else if (self->arena->nodes[n].aux == B_EQ) op = "==";
    else if (self->arena->nodes[n].aux == B_NE) op = "!=";
    else if (self->arena->nodes[n].aux == B_AND) op = "&&";
    else if (self->arena->nodes[n].aux == B_OR) op = "||";
    else if (self->arena->nodes[n].aux == B_XOR) op = "^";
    else if (self->arena->nodes[n].aux == B_BAND) op = "&";
    else if (self->arena->nodes[n].aux == B_BOR) op = "|";
    else if (self->arena->nodes[n].aux == B_SHL) op = "<<";
    else if (self->arena->nodes[n].aux == B_SHR) op = ">>";
    fputs("(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fprintf(self->out, " %s ", op);
    if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_unary(struct Emitter *self, int n, int nk)
{
    (void)nk;


    if (self->arena->nodes[n].aux == U_NEG) fputs("(-", self->out);
    else if (self->arena->nodes[n].aux == U_BNOT) fputs("(~", self->out);
    else fputs("(!", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_newobj(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* PH-81 S1b: `new T { ... }` becomes a statement expression that
       calls the instance constructor with the compound literal. The
       payload is copied by move; the literal's owning place
       initialisers were already retained by `emit_raw_init`. */
    char tmp[MAX_TEXT];
    const char *ctype;
    int k;
    if (!self->cur_ret[0])
        return self->fail_from(n,
            "'new' is only supported in a local initializer; a file-scope or static object cannot allocate at run time");
    k = self->ntmp;
    self->ntmp++;
    snprintf(tmp, sizeof tmp, "__ct_new%d", k);
    ctype = runtime::text::ct_internf("struct %s", self->arena->nodes[n].text2);
    if (!ctype) return self->fail_from(n, "out of memory");
    fprintf(self->out, "({ %s %s = %s__new(&(%s)", ctype, tmp,
            self->arena->nodes[n].text2, self->arena->nodes[n].text);
    if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text,
                            "", 0) != 0)
        return -1;
    fprintf(self->out, "); %s; })", tmp);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_box(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* aux: bit 0 = the source operand is a pointer, bit 1 = take the
       address of the literal (a pointer-to-interface target),
       bit 2 = a namespace host (SH-20): no operand, self is NULL,
       bit 3 = the value reached an interface context (see maybe_box) */
    int a = self->arena->nodes[n].aux;
    int src = self->arena->nodes[n].a;
    /* SH-74: inside an impl body `self` is spelled `_self` -- a
       pointer to the receiver object -- whatever the source type
       says. Boxing it must hand the interface that pointer, not the
       address of the local `_self` slot (`&_self`), which dies with
       the method frame. `&self` names the object itself, so it is
       the same pointer. */
    if (self->sym->self_mode && !(a & 4) && src >= 0) {
        int inner = src;
        if (self->arena->nodes[inner].kind == N_ADDR
            && self->arena->nodes[inner].a >= 0)
            inner = self->arena->nodes[inner].a;
        if (self->arena->nodes[inner].kind == N_VAR
            && strcmp(self->arena->nodes[inner].text2, "self") == 0) {
            src = inner;
            a |= 1;
        }
    }
    if (a & 4) {
        int i, found, bar;
        char dmsg[512];
        if (!(a & 8))
            return self->fail_from(n, "a namespace host value is only usable as an interface value");
        found = 0;
        for (i = 0; i < (*self->nmaps); i++)
            if ((*self->maps)[i].ns_host
                && strcmp((*self->maps)[i].trait, self->arena->nodes[n].text) == 0
                && strcmp((*self->maps)[i].prefix, self->arena->nodes[n].text2) == 0) {
                found = 1;
                break;
            }
        if (!found) {
            bar = -1;
            for (i = 0; self->arena->nodes[n].text3[i]; i++)
                if (self->arena->nodes[n].text3[i] == '|') { bar = i; break; }
            if (bar >= 0)
                snprintf(dmsg, sizeof dmsg, "no map binds trait '%.*s' to namespace '%s'",
                         bar, self->arena->nodes[n].text3,
                         self->arena->nodes[n].text3 + bar + 1);
            else
                snprintf(dmsg, sizeof dmsg, "no map binds trait '%s' to namespace ''",
                         self->arena->nodes[n].text3);
            return self->fail_from(n, dmsg);
        }
        fprintf(self->out, "(struct %s_iface){ (void *)0, &%s_vtable }",
                self->arena->nodes[n].text, self->arena->nodes[n].text2);
        return 0;
    }
    if (a & 2) fputs("&", self->out);
    fprintf(self->out, "(struct %s_iface){ (void *)", self->arena->nodes[n].text);
    if (a & 1) {
        if (self->emit_expr(src) != 0) return -1;
    } else {
        fputs("&", self->out);
        if (self->emit_expr(src) != 0) return -1;
    }
    fprintf(self->out, ", &%s_%s_vtable }", self->arena->nodes[n].text2, self->arena->nodes[n].text);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_mcall(struct Emitter *self, int n, int nk)
{
    (void)nk;
    int c;
    (void)c;


    const char *tname;
    const char *low;
    int i, c2, rk, tm2, mm2, ai2;
    /* Static mapping calls: no iface, no vtable, the recipe is expanded
       at the call site (spec §6.1 / §6.2). */
    if (self->arena->nodes[n].aux == 5) {
        int mi, bj, found = -1, bind = -1;
        for (mi = 0; mi < (*self->nmaps); mi++) {
            if (!(*self->maps)[mi].is_static || (*self->maps)[mi].type_host) continue;
            if (!map_visible(self, mi)) continue;
            if (strcmp((*self->maps)[mi].trait, self->arena->nodes[n].text) != 0) continue;
            if (strcmp((*self->maps)[mi].inst, self->arena->nodes[n].text3) != 0) continue;
            for (bj = 0; bj < (*self->maps)[mi].nb; bj++)
                if (strcmp((*self->maps)[mi].b[bj].method, self->arena->nodes[n].text2) == 0) {
                    found = mi;
                    bind = bj;
                    break;
                }
            if (found >= 0) break;
        }
        if (found < 0) {
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "no map binds trait '%s' to namespace '%s'",
                self->arena->nodes[n].text, self->arena->nodes[n].text3));
        }
        return emit_recipe(self, &(*self->maps)[found], &(*self->maps)[found].b[bind],
                           -1, self->arena->nodes[n].b, n);
    }
    /* LANG-29 S4 / B4: a binding-site conversion served by a `map binding`.
       Only the pair matters; the recipe is expanded exactly like a static
       type-host map, so the generated C is the hand-written call. Two visible
       bindings for the same pair are a hard error that names both units. */
    if (self->arena->nodes[n].aux == 12) {
        /* S1a-0 C2p-4: the pair is read as the pool texts the parser stored,
           so a 2000-byte host type is not cut by a MAX_TEXT copy before the
           key is computed (both sides then truncate identically). */
        const char *rt = self->arena->nodes[n].text;
        const char *tg = self->arena->nodes[n].text4;
        const char *rk;
        const char *tk;
        const char *hk;
        const char *dk;
        int mi, cand = -1, cand2 = -1;

        if (!rt || !rt[0] || !tg || !tg[0])
            return self->fail_from(n, "a map binding conversion lost its pair");
        rk = map_bind_key_text(rt);
        tk = map_bind_key_text(tg);
        if (!rk || !tk) return self->fail_from(n, "out of memory");
        for (mi = 0; mi < (*self->nmaps); mi++) {
            if (!(*self->maps)[mi].is_binding) continue;
            if (!map_visible(self, mi)) continue;
            hk = map_bind_key_text((*self->maps)[mi].host_type);
            if (!hk) return self->fail_from(n, "out of memory");
            if (strcmp(hk, rk) != 0) continue;
            dk = map_bind_key_text((*self->maps)[mi].bind_dst);
            if (!dk) return self->fail_from(n, "out of memory");
            if (strcmp(dk, tk) != 0) continue;
            if (cand < 0) cand = mi;
            else if (cand2 < 0) cand2 = mi;
        }
        if (cand < 0) {
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "no conversion from '%s' to '%s'; import a mapping unit with "
                "a 'map binding' for this pair, import a mapping trait that "
                "declares 'as', or add an inherent 'as' method", rt, tg));
        }
        if (cand2 >= 0) {
            const char *p1 = path_base_ptr((*self->maps)[cand].path);
            const char *p2 = path_base_ptr((*self->maps)[cand2].path);
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "ambiguous map binding for '%s' -> '%s': %s and %s; exactly one imported binding may serve a pair",
                rt, tg, p1, p2));
        }
        return emit_recipe(self, &(*self->maps)[cand], &(*self->maps)[cand].b[0],
                           self->arena->nodes[n].a, -1, n);
    }
    if (self->arena->nodes[n].aux == 6) {
        const char *rt;
        const char *rk;
        const char *tk;
        int r, mi, bj, cand = -1, cand2 = -1, bind = -1, bind2 = -1;
        r = self->arena->nodes[n].a;
        rt = self->arena->nodes[n].text;
        if (r < 0 || !rt || !rt[0])
            return self->fail_from(n, "cannot infer the receiver type for a type-host map");
        /* the host key is the one the parser's arity pre-check and
           the type pass compare with, so a spelling cannot expand here
           and be missed there */
        rk = frontend::type::type_key_text(rt);
        if (!rk) return self->fail_from(n, "out of memory");
        for (mi = 0; mi < (*self->nmaps); mi++) {
            if ((*self->maps)[mi].is_binding) continue;
            if (!(*self->maps)[mi].is_static || !(*self->maps)[mi].type_host) continue;
            if (!map_visible(self, mi)) continue;
            /* P20-01: a qualified call names the trait, so only its map
               is a candidate even when the host type has others. */
            if (self->arena->nodes[n].text3[0]
                && strcmp((*self->maps)[mi].trait, self->arena->nodes[n].text3) != 0)
                continue;
            tk = frontend::type::type_key_text((*self->maps)[mi].host_type);
            if (!tk) return self->fail_from(n, "out of memory");
            if (strcmp(tk, rk) != 0) continue;
            for (bj = 0; bj < (*self->maps)[mi].nb; bj++)
                if (strcmp((*self->maps)[mi].b[bj].method, self->arena->nodes[n].text2) == 0) {
                    if (cand < 0) {
                        cand = mi;
                        bind = bj;
                    } else if (cand2 < 0) {
                        cand2 = mi;
                        bind2 = bj;
                    }
                    break;
                }
        }
        if (cand < 0) {
            /* LANG-26: a binding-site conversion whose mapping unit is not in
               this unit's import closure is not "an unknown method"; the
               source wrote no method at all. Name the missing import. */
            if ((self->arena->nodes[n].sflags & 4) != 0) {
                return self->fail_from(n, tool::sh::ct_scratch_fmt(
                    "no conversion from '%s' to '%s'; import the mapping trait that declares '%s' or add an inherent '%s' method",
                    rt, self->arena->nodes[n].text4,
                    self->arena->nodes[n].text2, self->arena->nodes[n].text2));
            }
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "no method '%s' for type '%s'",
                self->arena->nodes[n].text2, rt));
        }
        if (cand2 >= 0) {
            const char *q1, *q2, *m1, *m2;
            int t1 = (*self->maps)[cand].b[bind].ti;
            int t2 = (*self->maps)[cand2].b[bind2].ti;
            q1 = self->sym->traits[t1].name;
            q2 = self->sym->traits[t2].name;
            m1 = tool::sh::ct_scratch_fmt("%s::%s", q1, self->arena->nodes[n].text2);
            m2 = tool::sh::ct_scratch_fmt("%s::%s", q2, self->arena->nodes[n].text2);
            /* The hint leads: the two map paths are the part that may be
               long, so the whole message is built in a growable block. */
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "use '%s' or '%s'; ambiguous type-host map for method '%s' on type '%s':"
                " '%s' and '%s'",
                m1, m2, self->arena->nodes[n].text2, rt,
                (*self->maps)[cand].path, (*self->maps)[cand2].path));
        }
        return emit_recipe(self, &(*self->maps)[cand], &(*self->maps)[cand].b[bind],
                           r, self->arena->nodes[n].b, n);
    }
    /* Phase 28 (D28-3): a call on the type parameter inside a bounded
       template body. The instance's type argument names the struct and
       the recorded trait names the vtable, so the slot call is a plain
       C call -- no vptr read, no boxing, no layout change. */
    if (self->arena->nodes[n].aux == 7 || self->arena->nodes[n].aux == 8) {
        const char *base;
        const char *tg;
        size_t tl;
        int si;
        if (self->gtntparam <= 0 || !self->gtarg[0])
            return self->fail_from(n, "a constrained call needs an instance");
        /* S1a-0 C2p-6: `gtarg` is a pool text, so the base name is a slice of
           it rather than a copy through a 160-byte row. */
        tg = self->gtarg[0];
        tl = strlen(tg);
        while (tl > 0 && (tg[tl - 1] == ' ' || tg[tl - 1] == '*')) tl--;
        if (tl > 7 && strncmp(tg, "struct ", 7) == 0)
            base = runtime::text::ct_intern_len(tg + 7, (int)tl - 7);
        else if (tl > 6 && strncmp(tg, "union ", 6) == 0)
            base = runtime::text::ct_intern_len(tg + 6, (int)tl - 6);
        else
            base = runtime::text::ct_intern_len(tg, (int)tl);
        if (!base) return self->fail_from(n, "out of memory");
        si = self->sym->find_struct(base);
        if (si < 0) {
            return self->fail_from(n, tool::sh::ct_scratch_fmt(
                "type argument '%s' cannot satisfy trait '%s' (not a struct)",
                self->gtarg[0], self->arena->nodes[n].text));
        }
        fprintf(self->out, "%s_%s_vtable.%s(", self->sym->structs[si].name,
                self->arena->nodes[n].text, self->arena->nodes[n].text2);
        /* SH-98: inside an impl body `self` is already the receiver
           pointer (`_self`), so a method call on it must not take the
           address of the local slot (`&_self` would be `T **`). */
        if (self->arena->nodes[n].aux == 7
            && !(self->sym->self_mode
                 && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR
                 && strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "self") == 0))
            fputs("&", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        {
            int bt2 = self->sym->find_trait(self->arena->nodes[n].text);
            int bm2 = -1, ai = 0, j;
            if (bt2 >= 0)
                for (j = 0; j < self->sym->traits[bt2].nm; j++)
                    if (strcmp(self->sym->traits[bt2].m[j].name,
                               self->arena->nodes[n].text2) == 0) {
                        bm2 = j;
                        break;
                    }
            c2 = self->arena->nodes[n].b;
            while (c2 >= 0) {
                fputs(", ", self->out);
                if (bm2 >= 0 && ai < self->sym->traits[bt2].m[bm2].nparams
                    && (self->sym->traits[bt2].m[bm2].pann[ai] == 2
                        || self->sym->traits[bt2].m[bm2].pann[ai] == 3)) {
                    if (self->emit_ref_arg(c2) != 0) return -1;
                } else if (bm2 >= 0 && ai < self->sym->traits[bt2].m[bm2].nparams) {
                    if (self->emit_value_for(
                            self->sym->traits[bt2].m[bm2].ptype[ai], c2) != 0)
                        return -1;
                } else if (self->emit_expr(c2) != 0) {
                    return -1;
                }
                ai++;
                c2 = self->arena->nodes[c2].next;
            }
        }
        fputs(")", self->out);
        return 0;
    }
    /* Phase 29: an inherent method of an instantiated struct. There is
       no vtable at all -- the receiver's concrete type names the
       monomorphised function (`<Inst>_<method>`), so the call is a plain
       C call. `.` passes the address, `->` passes the pointer. */
    if (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10) {
        const char *base;
        int si;
        /* Phase 31 O3: a chained subscript's inner `get` was named by
           `emit_hoists`, so every later emission prints the temporary
           instead of the call. */
        if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
            fputs(self->arena->nodes[n].text3, self->out);
            return 0;
        }
        base = self->arena->nodes[n].text;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        si = self->sym->find_struct(base);
        if (si < 0) {
            /* LANG-29 S3 / B2: an enum ADT is not in the struct table, but its
               inherent methods are named by the ADT's C tag (`<tag>_<method>`). */
            int adi = frontend::sym::ct_adt_from_type(self->arena->nodes[n].text);
            struct Adt *adts;
            int nadts;
            if (adi < 0) {
                return self->fail_from(n, runtime::text::ct_internf(
                         "no method '%s' for type '%s'",
                         self->arena->nodes[n].text2, self->arena->nodes[n].text));
            }
            adts = frontend::sym::ct_adts(&nadts);
            if (!adts || adi >= nadts)
                return self->fail_from(n, "the ADT row is missing");
            fprintf(self->out, "%s_%s%s(", adts[adi].full,
                    self->arena->nodes[n].text2,
                    self->arena->nodes[n].suffix ? self->arena->nodes[n].suffix : "");
        } else {
            fprintf(self->out, "%s_%s%s(", self->sym->structs[si].name,
                    self->arena->nodes[n].text2,
                    self->arena->nodes[n].suffix ? self->arena->nodes[n].suffix : "");
        }
        if (self->arena->nodes[n].aux == 9
            && !(self->sym->self_mode
                 && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR
                 && strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "self") == 0))
            fputs("&", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        {
            int *pann = 0, pai = 0, has, nargs = 0;
            /* S1a-0 C1: a method may carry more than 16 parameters now, so
               the annotation buffer is sized by the actual argument count. */
            for (c2 = self->arena->nodes[n].b; c2 >= 0; c2 = self->arena->nodes[c2].next)
                nargs++;
            if (nargs > 0) {
                pann = (int *)calloc((size_t)nargs, sizeof(*pann));
                if (!pann) return self->fail("out of memory");
            }
            has = self->sym->find_meth_ann(self->arena->nodes[n].text,
                                           self->arena->nodes[n].text2,
                                           pann, nargs);
            c2 = self->arena->nodes[n].b;
            while (c2 >= 0) {
                fputs(", ", self->out);
                if (has == 0 && (pann[pai] == 2 || pann[pai] == 3)) {
                    if (self->emit_ref_arg(c2) != 0) return -1;
                } else if (self->emit_expr(c2) != 0) {
                    return -1;
                }
                pai++;
                c2 = self->arena->nodes[c2].next;
            }
            free(pann);
        }
        fputs(")", self->out);
        return 0;
    }
    /* P29-2: a static inherent method (`Vec<int>::from(...)`) -- no
       receiver, so the call is `<Inst>_<method>(<args>)` and the first
       argument is an ordinary one, not `self`. */
    if (self->arena->nodes[n].aux == 11) {
        const char *base;
        int si;
        base = self->arena->nodes[n].text;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        si = self->sym->find_struct(base);
        if (si < 0) {
            int adi = frontend::sym::ct_adt_from_type(self->arena->nodes[n].text);
            struct Adt *adts;
            int nadts;
            if (adi < 0) {
                return self->fail_from(n, runtime::text::ct_internf(
                         "no static method '%s' for type '%s'",
                         self->arena->nodes[n].text2, self->arena->nodes[n].text));
            }
            adts = frontend::sym::ct_adts(&nadts);
            if (!adts || adi >= nadts)
                return self->fail_from(n, "the ADT row is missing");
            fprintf(self->out, "%s_%s(", adts[adi].full,
                    self->arena->nodes[n].text2);
        } else {
            fprintf(self->out, "%s_%s(", self->sym->structs[si].name,
                    self->arena->nodes[n].text2);
        }
        {
            int *pann = 0, pai = 0, has, nargs = 0;
            for (c2 = self->arena->nodes[n].b; c2 >= 0; c2 = self->arena->nodes[c2].next)
                nargs++;
            if (nargs > 0) {
                pann = (int *)calloc((size_t)nargs, sizeof(*pann));
                if (!pann) return self->fail("out of memory");
            }
            has = self->sym->find_meth_ann(self->arena->nodes[n].text,
                                           self->arena->nodes[n].text2,
                                           pann, nargs);
            c2 = self->arena->nodes[n].b;
            while (c2 >= 0) {
                if (c2 != self->arena->nodes[n].b) fputs(", ", self->out);
                if (has == 0 && (pann[pai] == 2 || pann[pai] == 3)) {
                    if (self->emit_ref_arg(c2) != 0) return -1;
                } else if (self->emit_expr(c2) != 0) {
                    return -1;
                }
                pai++;
                c2 = self->arena->nodes[c2].next;
            }
            free(pann);
        }
        fputs(")", self->out);
        return 0;
    }
    /* Phase 31 O3: a materialised method receiver (trait dispatch)
       prints its temporary instead of the call. */
    if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
        fputs(self->arena->nodes[n].text3, self->out);
        return 0;
    }
    if (self->arena->nodes[n].a < 0) return self->fail_from(n, "method call without a receiver");
    rk = self->arena->nodes[self->arena->nodes[n].a].kind;
    /* SH-110: a method-call result the hoist pass named (`text3`) is already a
       temporary, so it is a stable receiver like a variable. An unmaterialised
       N_MCALL (array / function-pointer result, static-map recipe, or a
       position the hoist pass cannot move) keeps the old refusal. */
    if (rk == N_MCALL && self->arena->nodes[self->arena->nodes[n].a].text3[0])
        rk = N_VAR;
    if (rk != N_VAR && rk != N_INDEX && rk != N_CALL
        && rk != N_MEMBER && rk != N_ARROW && rk != N_INTO_SELF
        && rk != N_INTO)
        return self->fail_from(n, "method receiver must be a variable, an element, a call or a field chain");
    /* battle p38-1 B′: a runtime guard needs a stable receiver; a
       side-effectful receiver would guard one value and call another. */
    if (self->runtime_checks && *self->runtime_checks
        && self->expr_unstable(self->arena->nodes[n].a))
        return self->fail_from(n,
            "runtime checks need a stable receiver; bind it to a local first");
    if (!self->arena->nodes[n].text[0])
        return self->fail_from(n, "cannot resolve the method trait (unknown receiver type)");
    tname = self->arena->nodes[n].text;
    {
        size_t tl = strlen(tname);
        char *tmp = tool::sh::ct_scratch_alloc((int)tl + 1);
        for (i = 0; i < (int)tl; i++) {
            char c = tname[i];
            if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
            tmp[i] = c;
        }
        tmp[i] = 0;
        low = tmp;
    }
    if (self->arena->nodes[n].aux == 4) {
        if (self->runtime_checks && *self->runtime_checks) {
            fputs("((struct ", self->out);
            fputs(tname, self->out);
            fputs("_vtbl *)__ct_vt_guard((void *)(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ")->vt, __FILE__, %d, \"", self->arena->nodes[n].line);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("\"))->", self->out);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("((", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")->self", self->out);
        } else {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, "->vt->%s(", self->arena->nodes[n].text2);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs("->self", self->out);
        }
    } else if (self->arena->nodes[n].aux == 3) {
        if (self->runtime_checks && *self->runtime_checks) {
            fputs("((struct ", self->out);
            fputs(tname, self->out);
            fputs("_vtbl *)__ct_vt_guard((void *)(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ").vt, __FILE__, %d, \"", self->arena->nodes[n].line);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("\"))->", self->out);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("((", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(").self", self->out);
        } else {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ".vt->%s(", self->arena->nodes[n].text2);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(".self", self->out);
        }
    } else if (self->arena->nodes[n].aux == 2) {
        if (self->runtime_checks && *self->runtime_checks) {
            fputs("((struct ", self->out);
            fputs(tname, self->out);
            fputs("_vtbl *)__ct_vt_guard((void *)(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ")->__%s_vptr, __FILE__, %d, \"", low, self->arena->nodes[n].line);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("\"))->", self->out);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("((", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
        } else {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, "->__%s_vptr->%s(", low, self->arena->nodes[n].text2);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        }
    } else {
        if (self->runtime_checks && *self->runtime_checks) {
            fputs("((struct ", self->out);
            fputs(tname, self->out);
            fputs("_vtbl *)__ct_vt_guard((void *)(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ").__%s_vptr, __FILE__, %d, \"", low, self->arena->nodes[n].line);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("\"))->", self->out);
            fputs(self->arena->nodes[n].text2, self->out);
            fputs("(&(", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(")", self->out);
        } else {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, ".__%s_vptr->%s(&", low, self->arena->nodes[n].text2);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        }
    }
    /* Phase 78 S2b: resolve the trait method's ref/out annotations
       once; the call site takes the address of each such actual. */
    tm2 = self->sym->find_trait(tname);
    mm2 = -1;
    ai2 = 0;
    if (tm2 >= 0)
        for (i = 0; i < self->sym->traits[tm2].nm; i++)
            if (strcmp(self->sym->traits[tm2].m[i].name,
                       self->arena->nodes[n].text2) == 0) {
                mm2 = i;
                break;
            }
    c2 = self->arena->nodes[n].b;
    while (c2 >= 0) {
        int cv2 = -1;
        fputs(", ", self->out);
        /* SH-65: a pair-form method (`f(env, x), env`) takes the
           closure as two C arguments, exactly like a free call. */
        if (self->arena->nodes[c2].kind == N_CLOSURE) {
            if (emit_closure_arg(self, c2) != 0) return -1;
        } else {
            if (self->arena->nodes[c2].kind == N_VAR)
                cv2 = closure_var_lookup(self, self->arena->nodes[c2].text2);
            if (cv2 >= 0) {
                fprintf(self->out, "__ct_cl_tramp_%d, &__ct_cl_env_v_%d", cv2, cv2);
            } else if (mm2 >= 0 && ai2 < self->sym->traits[tm2].m[mm2].nparams
                       && (self->sym->traits[tm2].m[mm2].pann[ai2] == 2
                           || self->sym->traits[tm2].m[mm2].pann[ai2] == 3)) {
                if (self->emit_ref_arg(c2) != 0) return -1;
            } else if (mm2 >= 0 && ai2 < self->sym->traits[tm2].m[mm2].nparams) {
                if (self->emit_value_for(
                        self->sym->traits[tm2].m[mm2].ptype[ai2], c2) != 0)
                    return -1;
            } else if (self->emit_expr(c2) != 0) {
                return -1;
            }
        }
        ai2++;
        c2 = self->arena->nodes[c2].next;
    }
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_expr_call(struct Emitter *self, int n, int nk)
{
    (void)nk;
    int c;
    (void)c;


    int cl, fi, ai;
    /* A call through a closure variable expands to the trampoline with
       that variable's environment: `f(a)` becomes
       `__ct_cl_tramp_<ci>(&__ct_cl_env_v_<ci>, a)` (D21-14). */
    cl = -1;
    if (self->arena->nodes[n].aux != 2 && !self->arena->nodes[n].text3[0])
        cl = closure_var_lookup(self, self->arena->nodes[n].text2);
    if (cl >= 0) {
        fprintf(self->out, "__ct_cl_tramp_%d(&__ct_cl_env_v_%d", cl, cl);
        c = self->arena->nodes[n].a;
        while (c >= 0) {
            fputs(", ", self->out);
            if (self->emit_expr(c) != 0) return -1;
            c = self->arena->nodes[c].next;
        }
        fputs(")", self->out);
        return 0;
    }
    if (self->arena->nodes[n].text3[0] && n != self->raw_call) {
        fputs(self->arena->nodes[n].text3, self->out);
        return 0;
    }
    /* aux 1: `p(args)` on a function-pointer variable; aux 2: the
       callee is an expression, `(*p)(args)`. Both spell the call the
       same way (D-7). */
    if (self->arena->nodes[n].aux == 1) {
        fprintf(self->out, "(*%s)(", self->arena->nodes[n].text2);
    } else if (self->arena->nodes[n].aux == 2) {
        if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
        fputs("(", self->out);
    } else if (strcmp(self->arena->nodes[n].text2, "__ct_elem_retain") == 0
               && self->ginst[0]) {
        fprintf(self->out, "%s__elem_retain(", self->ginst);
    } else if (strcmp(self->arena->nodes[n].text2, "__ct_elem_release") == 0
               && self->ginst[0]) {
        fprintf(self->out, "%s__elem_release(", self->ginst);
    } else if (strcmp(self->arena->nodes[n].text2, "__ct_Box_payload_release") == 0
               && self->ginst[0]) {
        /* PH-81: the Box template's `release` binds to the instance's
           compiler-generated payload helper. */
        fprintf(self->out, "%s__payload_release(", self->ginst);
    } else if (strcmp(self->arena->nodes[n].text2, "__ct_Box_copy") == 0
               && self->ginst[0]) {
        fprintf(self->out, "%s__copy(", self->ginst);
    } else if (self->alloc_map && self->alloc_map[0]
               && strcmp(self->arena->nodes[n].text2, "malloc") == 0) {
        /* PH-64: `--alloc` renames the allocation calls the source
           makes too, or the product still carries an undefined
           `malloc` and cannot link under -nostdlib. */
        fprintf(self->out, "%s(", self->alloc_m);
    } else if (self->alloc_map && self->alloc_map[0]
               && strcmp(self->arena->nodes[n].text2, "free") == 0) {
        fprintf(self->out, "%s(", self->alloc_f);
    } else {
        fprintf(self->out, "%s(", self->arena->nodes[n].text2);
    }
    c = self->arena->nodes[n].a;
    fi = self->arena->nodes[n].aux == 0
             ? self->sym->find_func(self->arena->nodes[n].text2) : -1;
    ai = 0;
    while (c >= 0) {
        int cv;
        /* S5: an inline literal is two C arguments, the trampoline and
           the address of its stack environment (D21-14). R03: a declared
           binding fills the same pair from its own stack instance. */
        cv = -1;
        if (self->arena->nodes[c].kind == N_VAR)
            cv = closure_var_lookup(self, self->arena->nodes[c].text2);
        if (self->arena->nodes[c].kind == N_CLOSURE) {
            if (emit_closure_arg(self, c) != 0) return -1;
        } else if (cv >= 0) {
            fprintf(self->out, "__ct_cl_tramp_%d, &__ct_cl_env_v_%d", cv, cv);
        } else if (fi >= 0 && ai < self->sym->funcs[fi].nparams
                   && (self->sym->funcs[fi].pann[ai] == 2
                       || self->sym->funcs[fi].pann[ai] == 3)) {
            if (self->emit_ref_arg(c) != 0) return -1;
        } else if (fi >= 0 && ai < self->sym->funcs[fi].nparams) {
            if (self->emit_value_for(self->sym->funcs[fi].ptype[ai], c) != 0)
                return -1;
        } else if (self->emit_expr(c) != 0) {
            return -1;
        }
        ai++;
        c = self->arena->nodes[c].next;
        if (c >= 0) fputs(", ", self->out);
    }
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_func(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;
    int c;
    (void)c;


    const char *rname;
    const char *rnamesub;
    /* a new body starts with no closure variable bound (Phase 21 S3) */
    self->nclvar = 0;
    self->closure_ci = 0;
    if (self->arena->nodes[n].aux
        || (self->abi_mode && *self->abi_mode
            && self->arena->nodes[n].d == 0))
        fputs("static ", self->out);
    /* Phase 39 R4: exactly one visibility attribute on each root
       export definition; non-exports stay hidden by the compiler flag. */
    if (self->abi_mode && *self->abi_mode && self->abi_root
        && self->abi_exports && self->abi_n
        && self->cur_unit == *self->abi_root
        && self->arena->nodes[n].d == 1) {
        int ai;
        for (ai = 0; ai < *self->abi_n; ai++)
            if (strcmp(self->sym->funcs[self->abi_exports[ai]].cname,
                       self->arena->nodes[n].text2) == 0) {
                fputs("__attribute__((visibility(\"default\"))) ", self->out);
                break;
            }
    }
    /* `num` carries the `inline` specifier (0 = plain function) */
    if (self->arena->nodes[n].num) fputs("inline ", self->out);
    /* Phase 26: an active instance substitutes the return type and
       writes its own C name instead of the template's. */
    rname = self->arena->nodes[n].text;
    rnamesub = emit_gsub_type_text(self, rname);
    if (rnamesub) rname = rnamesub;
    fprintf(self->out, "%s %s(", rname,
            self->gtname[0] ? self->gtname : self->arena->nodes[n].text2);
    c = self->arena->nodes[n].a;
    if (c == 0) {
        fputs("void) ", self->out);
    } else {
        int first;
        first = 1;
        while (c > 0) {
            if (!first) fputs(", ", self->out);
            if (self->arena->nodes[c].aux == 2
                || self->arena->nodes[c].aux == 3) {
                const char *pbuf;
                pbuf = tool::sh::ct_scratch_fmt("%s *", self->arena->nodes[c].text);
                if (self->emit_type_name_dims(pbuf, self->arena->nodes[c].text2,
                                              self->arena->nodes[c].text3) != 0)
                    return -1;
            } else if (self->emit_type_name_dims(self->arena->nodes[c].text,
                                                 self->arena->nodes[c].text2,
                                                 self->arena->nodes[c].text3) != 0)
                return -1;
            if (self->arena->nodes[c].attr >= 0)
                fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[c].attr));
            first = 0;
            c = self->arena->nodes[c].next;
        }
        if (self->arena->nodes[n].c) fputs(", ...", self->out);
        fputs(") ", self->out);
    }
    /* a GNU attribute rides between the parameter list and the body */
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, "%s ", self->arena->str_at(self->arena->nodes[n].attr));
    /* S1b-S2b: an active instance (`gtname`) is generated C that the lowerer
       does not model, so only a plain source function may use the body seam.
       The hook is consulted before any body state is pushed; a body it does
       not print keeps this writer's own state machine untouched. */
    {
        int (*body_hook)(const char *, void *, int, int, int *, int) = g_body_hook;
    if (body_hook && !self->gtname[0]) {
        int new_ntmp = self->ntmp;
        int hr = body_hook(self->arena->nodes[n].text2, self->out, ind,
                           self->ntmp, &new_ntmp, 0);
        if (hr > 0) {
            /* the LIR body allocated its own `__ct_*N` from the same
               module-wide counter, so the next writer resumes where the
               unswitched program would have been. */
            self->ntmp = new_ntmp;
            return 0;
        }
        if (hr < 0) return -1;
    }
    }
    /* Phase 44: remember the (substituted) return type for a postfix
       `?` in the body. */
    self->cur_ret = runtime::text::ct_intern(rname);
    if (!self->cur_ret) return self->fail("out of memory");
    /* SH-102: the by-value string parameters own a reference for the
       duration of the body; the opening block writes the retains. */
    g_sb.method = runtime::text::ct_intern(self->arena->nodes[n].text2);
    if (!g_sb.method) return self->fail("out of memory");
    g_sb.recv = "";
    sb_push_params(self, self->arena->nodes[n].a, 0);
    g_sb.pending = 1;
    return self->emit_node(self->arena->nodes[n].b, ind);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_defer_run(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;

    /* S1b-S2: aux >= 3 is the source-ordered metadata copy TIR reads; it is
       never a normal-exit run, so it prints nothing. */
    if (self->arena->nodes[n].aux >= 3) return 0;
    return self->emit_node(self->arena->nodes[n].a, ind);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_defer(struct Emitter *self, int n, int ind, int nk)
{
    (void)self;
    (void)n;
    (void)ind;
    (void)nk;

    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_block(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;
    int c;
    (void)c;


    int save_nclvar, save_sb, save_l, funcbody, holdblk;
    save_nclvar = self->nclvar;   /* a closure bound here dies with the block */
    funcbody = g_sb.pending;
    g_sb.pending = 0;
    /* the arm block of an `if` keeps its marks for `sb_field_if_merge`;
       the depth match keeps a nested `if` from consuming an outer
       arm's marker */
    holdblk = (g_sb.branch_hold == g_sb.nblk + 1);
    if (holdblk) g_sb.branch_hold = 0;
    /* a function body's closing brace ends the parameters' lives too */
    save_sb = funcbody ? 0 : g_sb.n;
    save_l = g_sb.ln;
    {
        int bk = 0;
        if (g_sb.loop_pending) { bk = 1; g_sb.loop_pending = 0; }
        else if (g_sb.switch_pending) { bk = 2; g_sb.switch_pending = 0; }
        if (g_sb.nblk < 256) {
            g_sb.blk[g_sb.nblk] = save_sb;
            g_sb.lblk[g_sb.nblk] = save_l;
            g_sb.bkind[g_sb.nblk] = bk;
            g_sb.nblk++;
        }
    }
    fputs("{\n", self->out);
    if (funcbody) sb_retain_params(self, ind + 1);
    for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
        if (self->emit_node(c, ind + 1) != 0) return -1;
    /* SH-102: release the owning string handles declared in this block
       unless a return already moved them out (that path has left) */
    sb_release_from(self, save_sb, -1, ind + 1);
    if (g_sb.nblk > 0) g_sb.nblk--;
    g_sb.n = save_sb;
    g_sb.ln = save_l;
    if (holdblk) {
        /* the if-arm keeps its marks (their depth stays inside the
           arm) for `sb_field_if_merge`; only dead locals are dropped */
        int i2, j2 = 0;
        for (i2 = 0; i2 < g_sb.nfield; i2++) {
            if (g_sb.fowner[i2] >= save_l && g_sb.fowner[i2] >= 0) continue;
            /* the pool owns the path; compacting moves the pointer */
            g_sb.fpath[j2] = g_sb.fpath[i2];
            g_sb.fowner[j2] = g_sb.fowner[i2];
            g_sb.fdepth[j2] = g_sb.fdepth[i2];
            g_sb.fmaybe[j2] = g_sb.fmaybe[i2];
            j2++;
        }
        g_sb.nfield = j2;
    } else {
        sb_field_merge(self, g_sb.nblk, save_l);
    }
    self->nclvar = save_nclvar;
    self->emit_indent(ind);
    fputs("}\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_matseq(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    /* PH-76: materialise each `$name` once, then run the final
       expression. A block keeps a single-statement context valid. */
    int ms, last_ms = -1;
    fputs("{\n", self->out);
    ind++;
    for (ms = self->arena->nodes[n].a; ms >= 0; ms = self->arena->nodes[ms].next) {
        last_ms = ms;
        self->emit_indent(ind);
        if (self->emit_expr(self->arena->nodes[ms].a) != 0) return -1;
        fputs(" = ", self->out);
        if (self->emit_expr(self->arena->nodes[ms].b) != 0) return -1;
        fputs(";\n", self->out);
    }
    if (self->arena->nodes[n].b >= 0
        && !(last_ms >= 0
             && self->arena->nodes[last_ms].a == self->arena->nodes[n].b)) {
        self->emit_indent(ind);
        if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
        fputs(";\n", self->out);
    }
    ind--;
    self->emit_indent(ind);
    fputs("}\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_ret(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    const char *rpfx;
    int r, rtv, wrap;
    /* SH-102 (D-013 §3): the owning handle this return hands back. A
       local / parameter handle is moved (its scope release is skipped);
       a place (a field, a global, a deref) is retained so the caller
       gets its own reference; a call result or literal moves. `sret` is
       materialised before the releases so a release cannot run under
       the value it feeds. LANG-29 S2 / B3 extends the same contract to an
       owning ADT return type. */
    int srk, smove, sretain, sret;
    rpfx = sb_value_type_owns(self, self->cur_ret)
           ? sb_life_prefix_text(self, self->cur_ret) : 0;
    srk = rpfx ? 1 : 0;
    smove = srk ? sb_ret_move(self, self->arena->nodes[n].a) : -1;
    /* an escape: a borrowed-string function hands back a `Str` view
       where the caller expects an owning `String` */
    if (srk && self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR) {
        const char *et = sb_expr_type_text(self, self->arena->nodes[n].a);
        if (et
            && sb_view_ret(et) && !strchr(et, '*')
            && frontend::sym::ct_is_string_value_type(et) == 0)
            return self->fail_from(n,
                "cannot return a borrowed view as an owning string; call to_string()");
    }
    /* moving a borrowed local out still needs a reference for the
       caller, so it is retained instead of moved */
    if (smove >= 0 && !g_sb.own[smove]) smove = -1;
    sretain = (srk && self->arena->nodes[n].a >= 0 && smove < 0
               && (((self->arena->nodes[n].sflags & 2) != 0)
                   || !sb_rhs_fresh(self, self->arena->nodes[n].a)));
    if (sretain && (sb_container_view("get")
                    || sb_container_view("entry")
                    || sb_container_view("pop")))
        sretain = 0;
    sret = -1;
    /* any value a release could invalidate is materialised first: a
       `String` handle, or a scalar read out of one (`a.len()`). */
    if (self->arena->nodes[n].a >= 0
        && (sretain || g_sb.n > 0
            || (self->arena->nodes[n].aux != 1
                && self->arena->nodes[n].text[0])))
        sret = self->ntmp;
    if (sret >= 0) self->ntmp++;
    rtv = -1;
    wrap = (self->arena->nodes[n].aux == 1 && self->arena->nodes[n].a >= 0
            && self->arena->nodes[n].text[0]);
    if (sret >= 0 && !wrap) {
        wrap = 1;
    }
    if (self->hoist_rvalue(n) != 0) return -1;
    if (self->emit_hoists(ind) != 0) return -1;
    /* A label (case/default) may not be followed by a declaration.
       Wrapping the temp, releases and return in a block keeps the
       product valid C99 even when the return is the first statement
       after a label. */
    if (wrap) {
        fputs("{\n", self->out);
        ind++;
    }
    /* SH-45: the expression reads a value the releases below would
       free, so materialise it first and return the temporary */
    if (self->arena->nodes[n].aux == 1 && self->arena->nodes[n].a >= 0
        && self->arena->nodes[n].text[0]) {
        rtv = self->ntmp;
        self->ntmp++;
        self->emit_indent(ind);
        fprintf(self->out, "%s __ct_ret%d = ", self->arena->nodes[n].text, rtv);
        if (self->emit_value_for(self->arena->nodes[n].text,
                                 self->arena->nodes[n].a) != 0) return -1;
        fputs(";\n", self->out);
    }
    /* SH-102: the value first, then its own reference, then the other
       handles' releases below. A parser materialisation (`rtv`) already
       read the value above, so only its retain is left. */
    if (sret >= 0 && rtv < 0) {
        self->emit_indent(ind);
        fprintf(self->out, "%s __ct_sret%d = ", self->cur_ret, sret);
        if (self->emit_value_for(self->cur_ret, self->arena->nodes[n].a) != 0)
            return -1;
        fputs(";\n", self->out);
        if (sretain) {
            self->emit_indent(ind);
            fprintf(self->out, "__ct_sret%d = %s_retain(&__ct_sret%d);\n",
                    sret, rpfx, sret);
        }
    } else if (sretain && rtv >= 0) {
        self->emit_indent(ind);
        fprintf(self->out, "__ct_ret%d = %s_retain(&__ct_ret%d);\n",
                rtv, rpfx, rtv);
    }
    /* the parser hangs the scope's releases off `b`; they run at the
       return's own indentation, before the value leaves (SH-33) */
    for (r = self->arena->nodes[n].b; r >= 0; r = self->arena->nodes[r].next)
        if (self->emit_node(r, ind) != 0) return -1;
    /* SH-75: a block-scope struct must not be boxed by address -- the
       frame dies as this return leaves. The parser marks that box
       (bit 3); copy the value into a heap object the interface points
       at. The box has program lifetime (there is no owner handle to
       release it), which LeakSanitizer can report. */
    if (self->arena->nodes[n].a >= 0) {
        int b = self->arena->nodes[n].a;
        if (self->arena->nodes[b].kind == N_BOX
            && self->arena->nodes[b].aux == 8
            && self->arena->nodes[b].text2[0]) {
            int v = self->arena->nodes[b].a;
            fputs("{\n", self->out);
            ind++;
            if (self->freestanding && *self->freestanding
                && strcmp(self->alloc_m, "malloc") == 0)
                return self->fail_from(n,
                    "boxing needs a heap allocator; pass --alloc <malloc-symbol>,<free-symbol>");
            self->emit_indent(ind);
            fprintf(self->out, "extern void *%s(__SIZE_TYPE__);\n", self->alloc_m);
            self->emit_indent(ind);
            fprintf(self->out,
                    "struct %s *__ct_box = (struct %s *)%s(sizeof *__ct_box);\n",
                    self->arena->nodes[b].text2, self->arena->nodes[b].text2,
                    self->alloc_m);
            self->emit_indent(ind);
            fputs("*__ct_box = ", self->out);
            if (self->emit_expr(v) != 0) return -1;
            fputs(";\n", self->out);
            self->emit_indent(ind);
            fprintf(self->out, "return (struct %s_iface){ (void *)__ct_box, &%s_%s_vtable };\n",
                    self->arena->nodes[b].text, self->arena->nodes[b].text2,
                    self->arena->nodes[b].text);
            ind--;
            self->emit_indent(ind);
            fputs("}\n", self->out);
            return 0;
        }
    }
    /* SH-102: every other owning string handle in scope is released
       before the frame dies; the moved one left with the value, and a
       view return leaves the handles it still names alive. */
    if (g_sb.n > 0)
        sb_ret_release(self, self->arena->nodes[n].a,
                       (!srk && sb_view_ret(self->cur_ret)), smove, ind);
    self->emit_indent(ind);
    if (self->arena->nodes[n].a < 0) {
        fputs("return;\n", self->out);
        return 0;
    }
    if (rtv >= 0) {
        fprintf(self->out, "return __ct_ret%d;\n", rtv);
        if (wrap) {
            ind--;
            self->emit_indent(ind);
            fputs("}\n", self->out);
        }
        return 0;
    }
    if (sret >= 0) {
        fprintf(self->out, "return __ct_sret%d;\n", sret);
        if (wrap) {
            ind--;
            self->emit_indent(ind);
            fputs("}\n", self->out);
        }
        return 0;
    }
    if (rtv >= 0) {
        fprintf(self->out, "return __ct_ret%d;\n", rtv);
        if (wrap) {
            ind--;
            self->emit_indent(ind);
            fputs("}\n", self->out);
        }
        return 0;
    }
    fputs("return ", self->out);
    if (self->emit_value_for(self->cur_ret, self->arena->nodes[n].a) != 0)
        return -1;
    fputs(";\n", self->out);
    if (wrap) {
        ind--;
        self->emit_indent(ind);
        fputs("}\n", self->out);
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_delete(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int si;
    int e0, asg;
    si = -1;
    e0 = self->arena->nodes[n].a;
    /* The nulling below is only C when the argument is assignable:
       `delete get();` is a legal call, but `get() = 0` is not (SH-40).
       The five kinds are the assignment targets parse_stmt accepts. */
    asg = e0 >= 0 && (self->arena->nodes[e0].kind == N_VAR
                      || self->arena->nodes[e0].kind == N_MEMBER
                      || self->arena->nodes[e0].kind == N_ARROW
                      || self->arena->nodes[e0].kind == N_INDEX
                      || self->arena->nodes[e0].kind == N_DEREF);
    if (self->arena->nodes[n].text[0]) si = self->sym->find_struct(self->arena->nodes[n].text);
    /* a `borrow` release hands the object back to its pool: the
       memory is not ours to free, and an unresolvable type must fail
       rather than fall back to `free` (design 5) */
    if (self->arena->nodes[n].aux == 1) {
        if (si < 0)
            return self->fail_from(n, "cannot resolve the borrowed type");
        self->emit_indent(ind);
        fputs("if (", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fprintf(self->out, ") { %s_Handback_handback(", self->sym->structs[si].name);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs("); ", self->out);
        if (asg) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(" = 0; ", self->out);
        }
        fputs("}\n", self->out);
        return 0;
    }
    self->emit_indent(ind);
    if (si >= 0 && self->sym->structs[si].uses_drop) {
        /* PH-48 D48-2 (L48-2): never turn an unreachable body into a
           local stub. The module layer rejects the exported case before
           emission; this guard covers a row reached some other way. */
        if (!self->drop_visible(si)) {
            const char *vmsg;
            vmsg = tool::sh::ct_scratch_fmt(
                     "Drop body for 'struct %s' is not visible in this unit;"
                     " move 'impl Drop for %s' into the unit that declares the struct",
                     self->sym->structs[si].name, self->sym->structs[si].name);
            return self->fail_from(n, vmsg);
        }
        /* a Drop struct runs its drop before the memory goes away */
        fputs("if (", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fprintf(self->out, ") { %s_Drop_drop(", self->sym->structs[si].name);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        if (self->freestanding && *self->freestanding
            && strcmp(self->alloc_f, "free") == 0)
            return self->fail_from(n,
                "releasing needs a heap allocator; pass --alloc <malloc-symbol>,<free-symbol>");
        fprintf(self->out, "); %s(", self->alloc_f);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        /* null the pointer: L2's shape (README / language-spec list it),
           and the second release on another path is then a no-op */
        fputs("); ", self->out);
        if (asg) {
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fputs(" = 0; ", self->out);
        }
        fputs("}\n", self->out);
        return 0;
    }
    fputs("if (", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    if (self->freestanding && *self->freestanding
        && strcmp(self->alloc_f, "free") == 0)
        return self->fail_from(n,
            "releasing needs a heap allocator; pass --alloc <malloc-symbol>,<free-symbol>");
    fprintf(self->out, ") { %s(", self->alloc_f);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs("); ", self->out);
    if (asg) {
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(" = 0; ", self->out);
    }
    fputs("}\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_break(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int r;
    /* the releases `retire_before_jump` hung off `b` run before the
       jump leaves the loop (same shape as `return`, SH-33) */
    for (r = self->arena->nodes[n].b; r >= 0; r = self->arena->nodes[r].next)
        if (self->emit_node(r, ind) != 0) return -1;
    /* SH-102: the jump skips the current block's closing brace, so its
       owning string handles are released here instead. */
    if (sb_jump_release(self, ind, 0) != 0) return -1;
    self->emit_indent(ind);
    fputs("break;\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_cont(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int r;
    for (r = self->arena->nodes[n].b; r >= 0; r = self->arena->nodes[r].next)
        if (self->emit_node(r, ind) != 0) return -1;
    if (sb_jump_release(self, ind, 1) != 0) return -1;
    self->emit_indent(ind);
    fputs("continue;\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_empty(struct Emitter *self, int n, int ind, int nk)
{
    (void)self;
    (void)n;
    (void)ind;
    (void)nk;

    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_sassert(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    self->emit_indent(ind);
    fputs("_Static_assert(", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    if (self->arena->nodes[n].text[0])
        fprintf(self->out, ", %s", self->arena->nodes[n].text);
    fputs(");\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_goto(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    self->emit_indent(ind);
    fprintf(self->out, "goto %s;\n", self->arena->nodes[n].text2);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_label(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;
    int c;
    (void)c;


    self->emit_indent(ind);
    fprintf(self->out, "%s:\n", self->arena->nodes[n].text2);
    /* C99 forbids a label at the end of a compound statement. A
       statement after the label is always legal, and an empty one is
       harmless when the label already owns statements. */
    self->emit_indent(ind + 1);
    fputs(";\n", self->out);
    for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
        if (self->emit_node(c, ind + 1) != 0) return -1;
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_decls(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int c = self->arena->nodes[n].a;
    while (c >= 0) {
        /* SH-102: `String y = x, z = y;` is two declarations here; each
           one retains its place initialiser and registers its own
           binding, so the later declarator sees the earlier one. */
        int sh = sb_decl(self, c, ind);
        if (sh < 0) return -1;
        if (sh == 0) {
            /* PH-53: each declarator's initialiser may carry an optional
               chain; its temporary declaration goes before that line. */
            if (self->hoist_rvalue(c) != 0) return -1;
            if (self->emit_hoists(ind) != 0) return -1;
            self->emit_indent(ind);
            if (self->emit_inline(c) != 0) return -1;
            fputs(";\n", self->out);
        }
        c = self->arena->nodes[c].next;
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_decl(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    const char *tp = self->arena->nodes[n].text;
    size_t tl = strlen(tp);
    int heap_ptr = 0;

    if (self->init->type_needs_init(tp) && dims_depth(self->arena->nodes[n].text3) > 1)
        return self->fail_from(n, "a multi-dimensional array cannot hold trait-carrying values");

    /* `T *p = malloc(..)` writes its vptrs on the next line */
    if (tl > 0 && tp[tl - 1] == '*' && self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_CALL
        && (strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "malloc") == 0
            || strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "calloc") == 0))
        heap_ptr = 1;

    if (self->arena->nodes[n].text3[0] && self->arena->nodes[n].a < 0 && self->init->type_needs_init(tp)) {
        /* a local array of trait-carrying values: one loop writes every
           element's vptr (`Type name[n];` has no initialiser to extend) */
        const char *cnt;
        const char *recv;
        size_t ci, cl;
        self->emit_indent(ind);
        if (self->emit_inline(n) != 0) return -1;
        fputs(";\n", self->out);
        ci = 1;
        while (self->arena->nodes[n].text3[ci] && self->arena->nodes[n].text3[ci] != ']') ci++;
        cl = ci - 1;
        cnt = runtime::text::ct_intern_len(self->arena->nodes[n].text3 + 1, (int)cl);
        recv = runtime::text::ct_internf("%s[__ct_i]", self->arena->nodes[n].text2);
        if (!cnt || !recv) return self->fail_from(n, "out of memory");
        self->emit_indent(ind);
        fprintf(self->out, "for (unsigned long __ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
        if (self->init->emit_vptr_stmts(recv, tp, ind + 1) != 0) return -1;
        self->emit_indent(ind);
        fputs("}\n", self->out);
        return 0;
    }
    if (!self->arena->nodes[n].text3[0] && self->init->type_needs_init(tp)
        && (self->arena->nodes[n].a < 0
            || self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW)
        && self->ty->type_has_array_init(tp)) {
        /* a struct-typed array field cannot be reached by a designator,
           so its elements get their vptrs on the lines after */
        const char *base = tp;
        int si;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        si = self->sym->find_struct(base);
        self->emit_indent(ind);
        if (self->emit_inline(n) != 0) return -1;
        fputs(";\n", self->out);
        return self->init->emit_array_field_vptrs(si, self->arena->nodes[n].text2, ind);
    }
    if (heap_ptr) {
        const char *recv;
        self->emit_indent(ind);
        if (self->emit_inline(n) != 0) return -1;
        fputs(";\n", self->out);
        recv = runtime::text::ct_internf("(*%s)", self->arena->nodes[n].text2);
        if (!recv) return self->fail_from(n, "out of memory");
        return self->init->emit_vptr_stmts(recv, tp, ind);
    }
    return 2;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_expr_matseq(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;

    return self->emit_node(self->arena->nodes[n].a, ind);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_expression_statement(struct Emitter *self, int n, int ind, int nk)
{

    /* SH-102: the owning string handles get their retain / zero-init /
       old-value release here, in statement position only. */
    {
        int sh;
        if (sb_struct_assign_check(self, n) != 0) return -1;
        sh = sb_decl(self, n, ind);
        if (sh < 0) return -1;
        if (sh > 0) return 0;
        sh = sb_assign(self, n, ind);
        if (sh < 0) return -1;
        if (sh > 0) return 0;
    }
    if (self->hoist_rvalue(n) != 0) return -1;
    if (self->emit_hoists(ind) != 0) return -1;
    /* a bare `expr into { … };` statement is the block alone: the
       receiver expression has already been evaluated exactly once */
    if (nk == N_EXPR
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_INTO)
        return 0;
    self->emit_indent(ind);
    if (self->emit_inline(n) != 0) return -1;
    fputs(";\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_if(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    struct FldSnap pre, thn, els;
    if (self->hoist_expr(self->arena->nodes[n].a, ind) != 0) return -1;
    self->emit_indent(ind);
    fputs("if (", self->out);
    if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
    fputs(") ", self->out);
    /* SH-102 R6: merge the two arms' field definitions so a field
       defined before the `if` (or in both arms) stays defined. */
    sb_field_snap(self, &pre);
    g_sb.branch_hold = g_sb.nblk + 1;
    if (self->emit_node(self->arena->nodes[n].b, ind) != 0) return -1;
    g_sb.branch_hold = 0;
    sb_field_snap(self, &thn);
    if (self->arena->nodes[n].c >= 0) {
        sb_field_restore(self, &pre);
        self->emit_indent(ind);
        fputs("else ", self->out);
        g_sb.branch_hold = g_sb.nblk + 1;
        if (self->emit_node(self->arena->nodes[n].c, ind) != 0) return -1;
        g_sb.branch_hold = 0;
        sb_field_snap(self, &els);
    } else {
        sb_field_restore(self, &pre);
        sb_field_snap(self, &els);
    }
    sb_field_if_merge(self, &pre, &thn, &els);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_while(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    if (self->hoist_expr(self->arena->nodes[n].a, ind) != 0) return -1;
    self->emit_indent(ind);
    fputs("while (", self->out);
    if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
    fputs(") ", self->out);
    g_sb.loop_pending = 1;
    {
        int r = self->emit_node(self->arena->nodes[n].b, ind);
        g_sb.loop_pending = 0;
        return r;
    }
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_for(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int init = self->arena->nodes[n].a;
    if (self->hoist_expr(self->arena->nodes[n].a, ind) != 0) return -1;
    if (self->hoist_expr(self->arena->nodes[n].b, ind) != 0) return -1;
    if (self->hoist_expr(self->arena->nodes[n].c, ind) != 0) return -1;
    /* C only allows `register` or no storage class in a for's first
       declaration (C99 6.8.5.3), so `for (static int i = 0; ...)` is a
       GNU extension that gcc rejects under -std=c99. Emit the
       declaration in a block of its own: the initialiser still runs
       once, the name keeps the same scope, and the loop is plain C. */
    if (init >= 0 && self->arena->nodes[init].kind == N_DECL
        && self->arena->nodes[init].aux) {
        int q;
        self->emit_indent(ind);
        fputs("{\n", self->out);
        for (q = init; q >= 0; q = self->arena->nodes[q].next)
            if (self->emit_node(q, ind + 1) != 0) return -1;
        self->emit_indent(ind + 1);
        fputs("for (; ", self->out);
        if (self->arena->nodes[n].b >= 0
            && self->emit_cond(self->arena->nodes[n].b) != 0) return -1;
        fputs("; ", self->out);
        if (self->arena->nodes[n].c >= 0
            && self->emit_inline(self->arena->nodes[n].c) != 0) return -1;
        fputs(") ", self->out);
        g_sb.loop_pending = 1;
        {
            int r = self->emit_node(self->arena->nodes[n].d, ind + 1);
            g_sb.loop_pending = 0;
            if (r != 0) return -1;
        }
        self->emit_indent(ind);
        fputs("}\n", self->out);
        return 0;
    }
    self->emit_indent(ind);
    fputs("for (", self->out);
    if (self->arena->nodes[n].a >= 0 && self->emit_inline(self->arena->nodes[n].a) != 0) return -1;
    fputs("; ", self->out);
    if (self->arena->nodes[n].b >= 0 && self->emit_cond(self->arena->nodes[n].b) != 0) return -1;
    fputs("; ", self->out);
    if (self->arena->nodes[n].c >= 0 && self->emit_inline(self->arena->nodes[n].c) != 0) return -1;
    fputs(") ", self->out);
    g_sb.loop_pending = 1;
    {
        int r = self->emit_node(self->arena->nodes[n].d, ind);
        g_sb.loop_pending = 0;
        return r;
    }
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_loop(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int k;
    k = self->ntmp;
    self->ntmp++;
    self->emit_indent(ind);
    if (self->arena->nodes[n].b == -1) {
        fprintf(self->out, "for (int i = 0, __ct_loop_n_%d = (", k);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fprintf(self->out, "); i < __ct_loop_n_%d; i++) ", k);
    } else {
        fprintf(self->out,
                "for (int __ct_loop_n_%d, __ct_loop_hi_%d, i = ((__ct_loop_n_%d = (",
                k, k, k);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fprintf(self->out, ")), (__ct_loop_hi_%d = (", k);
        if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
        fprintf(self->out, ")), __ct_loop_n_%d); i < __ct_loop_hi_%d; i++) ", k, k);
    }
    g_sb.loop_pending = 1;
    {
        int r = self->emit_node(self->arena->nodes[n].d, ind);
        g_sb.loop_pending = 0;
        return r;
    }
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_foreach(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;
    int c;
    (void)c;


    int k;
    int faux;
    const char *fname;
    faux = self->arena->nodes[n].aux;
    fname = self->arena->nodes[n].text2;
    k = self->ntmp;
    self->ntmp++;
    self->emit_indent(ind);
    fputs("{\n", self->out);
    if (faux == 3) {
        /* P-7.2: a slice carries its own length; the view is
           address-taken once and every element read goes through the
           checked helper, so the loop cannot run past the view. */
        self->emit_indent(ind + 1);
        fprintf(self->out, "struct __ct_slice *__ct_foreach_c_%d = &(", k);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(");\n", self->out);
        self->emit_indent(ind + 1);
        fprintf(self->out, "int __ct_foreach_n_%d = __ct_foreach_c_%d->len;\n",
                k, k);
    } else if (faux == 1 || faux == 2) {
        /* Phase 29 (D29-13): a built-in container snapshots its length
           once and reads each element through the inherent `get` /
           `entry`, so modifying the container in the body cannot run
           the loop past the snapshot. */
        self->emit_indent(ind + 1);
        fprintf(self->out, "struct %s *__ct_foreach_c_%d = &(", fname, k);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(");\n", self->out);
        self->emit_indent(ind + 1);
        fprintf(self->out, "int __ct_foreach_n_%d = %s_len(__ct_foreach_c_%d);\n",
                k, fname, k);
    } else {
        self->emit_indent(ind + 1);
        fprintf(self->out, "int __ct_foreach_n_%d = (int)(sizeof(", k);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(") / sizeof((", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fputs(")[0]));\n", self->out);
    }
    self->emit_indent(ind + 1);
    fprintf(self->out,
            "for (int __ct_foreach_i_%d = 0; __ct_foreach_i_%d < __ct_foreach_n_%d; __ct_foreach_i_%d++) {\n",
            k, k, k, k);
    /* An array and a `Vec` also bind the read-only index (D29-14); a
       `Map` body has none, and the parser already refused any use. */
    if (faux != 2) {
        self->emit_indent(ind + 2);
        fprintf(self->out, "int i = __ct_foreach_i_%d;\n", k);
    }
    self->emit_indent(ind + 2);
    if (faux == 1)
        fprintf(self->out,
                "%s item = %s_get(__ct_foreach_c_%d, __ct_foreach_i_%d);\n",
                self->arena->nodes[n].text, fname, k, k);
    else if (faux == 2)
        fprintf(self->out,
                "%s item = %s_entry(__ct_foreach_c_%d, __ct_foreach_i_%d);\n",
                self->arena->nodes[n].text, fname, k, k);
    else if (faux == 3)
        fprintf(self->out,
                "%s item = (*(%s *)__ct_slice_at(__ct_foreach_c_%d, __ct_foreach_i_%d, sizeof(%s)));\n",
                self->arena->nodes[n].text, self->arena->nodes[n].text,
                k, k, self->arena->nodes[n].text);
    else {
        fprintf(self->out, "%s item = (", self->arena->nodes[n].text);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        fprintf(self->out, ")[__ct_foreach_i_%d];\n", k);
    }
    /* `item` and `i` may go unused (`foreach (xs) { puts("x"); }`, or a
       binding hidden by a nested one). A plain `(void)x;` keeps the
       generated C `-Wall -Wextra` clean without a GCC-only attribute. */
    self->emit_indent(ind + 2);
    fputs("(void)item;\n", self->out);
    if (faux != 2) {
        self->emit_indent(ind + 2);
        fputs("(void)i;\n", self->out);
    }
    /* SH-102: this body is written without an N_BLOCK, so the break /
       continue baseline is pushed (and released) here. `item` is not a
       tracked binding: for a `Vec` / `Map` it is a borrowed view. */
    {
        int sbase = g_sb.n, lbase = g_sb.ln;
        if (g_sb.nblk < 256) {
            g_sb.blk[g_sb.nblk] = sbase;
            g_sb.lblk[g_sb.nblk] = lbase;
            g_sb.bkind[g_sb.nblk] = 1;
            g_sb.nblk++;
        }
        for (c = self->arena->nodes[self->arena->nodes[n].d].a; c >= 0;
             c = self->arena->nodes[c].next)
            if (self->emit_node(c, ind + 2) != 0) return -1;
        sb_release_from(self, sbase, -1, ind + 2);
        g_sb.n = sbase;
        g_sb.ln = lbase;
        if (g_sb.nblk > 0) g_sb.nblk--;
        sb_field_merge(self, g_sb.nblk, lbase);
    }
    self->emit_indent(ind + 1);
    fputs("}\n", self->out);
    self->emit_indent(ind);
    fputs("}\n", self->out);
    return 0;
}

/* LANG-29 S4 / B5: `match` in expression position. The statement writer's
   arm machinery is reused (bindings are injected into the arm's block, scope
   release stays the block writer's), but the whole form is a GNU statement
   expression with two temporaries: the subject (evaluated exactly once) and
   the result. Each value arm assigns its `yield` expression to the result;
   the final `__ct_mresN;` is the value the surrounding expression sees. The
   name is patched here because the parser runs before the emitter's
   temporary numbering. */
static int match_expr_emit(struct Emitter *self, int n)
{
    int k, arm, narm, idx, ptr, tagi, self_deref;
    const char *rtype;
    const char *rnorm;
    struct Adt *adts;
    int nadts;

    if ((self->arena->nodes[n].sflags & 8) == 0)
        return self->fail_from(n, "a statement match is not an expression");
    adts = frontend::sym::ct_adts(&nadts);
    tagi = frontend::sym::ct_adt_find(self->arena->nodes[n].text);
    if (!adts || tagi < 0 || tagi >= nadts)
        return self->fail_from(n, "the ADT row is missing");
    k = self->ntmp;
    self->ntmp++;
    ptr = self->arena->nodes[n].aux;
    /* S1a-0 C2p-6: the result type is a pool text; the old 160-byte rows cut
       a 2000-byte struct name into an incomplete type in `__ct_mresN`. */
    rtype = self->arena->nodes[n].text2;
    rnorm = sb_norm_own_type_text(self, rtype);
    if (!rnorm) rnorm = rtype;
    fputs("({ ", self->out);
    fprintf(self->out, "struct %s%s__ct_match%d = (", adts[tagi].full,
            ptr ? " *" : " ", k);
    self_deref = self->sym->self_mode
        && self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR
        && strcmp(self->arena->nodes[self->arena->nodes[n].a].text2, "self") == 0;
    if (self_deref) fputs("*(_self)", self->out);
    else if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs("); ", self->out);
    if (rnorm[0] && strcmp(rnorm, "void") != 0)
        fprintf(self->out, "%s __ct_mres%d = (%s){0}; ", rnorm, k, rnorm);
    narm = 0;
    for (arm = self->arena->nodes[n].b; arm >= 0; arm = self->arena->nodes[arm].next)
        narm++;
    idx = 0;
    for (arm = self->arena->nodes[n].b; arm >= 0;
         arm = self->arena->nodes[arm].next, idx++) {
        /* the parser's placeholder name -> this match's result temporary */
        if (self->arena->nodes[arm].c >= 0) {
            int asg = self->arena->nodes[arm].c;
            int tv = self->arena->nodes[asg].a;
            if (tv >= 0) {
                char nm[32];
                snprintf(nm, sizeof nm, "__ct_mres%d", k);
                self->arena->nodes[tv].text2 = runtime::text::ct_intern(nm);
                if (!self->arena->nodes[tv].text2) return self->fail("out of memory");
            }
        }
        if (idx < narm - 1) {
            if (self->arena->nodes[arm].aux & 1)
                return self->fail_from(arm, "a wildcard match arm must be the last arm");
            int exncond;
            fputs(idx == 0 ? "if (" : "else if (", self->out);
            fprintf(self->out, "__ct_match%d%stag == %d",
                    k, ptr ? "->" : ".", (int)self->arena->nodes[arm].num);
            if (emit_arm_conds(self, arm, k, &exncond) != 0) return -1;
            fputs(") ", self->out);
        } else if (narm > 1) {
            fputs("else ", self->out);
        }
        if (emit_match_arm(self, arm, 0, k, ptr) != 0) return -1;
    }
    if (rnorm[0] && strcmp(rnorm, "void") != 0)
        fprintf(self->out, "__ct_mres%d; ", k);
    fputs("})", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_match(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;

    int k, arm, narm, idx, ptr, tagi, nonadt, ncond, self_deref;
    struct Adt *adts;
    int nadts;

    adts = frontend::sym::ct_adts(&nadts);
    tagi = -1;
    nonadt = self->arena->nodes[n].aux & 4;
    if (!nonadt) {
        tagi = frontend::sym::ct_adt_find(self->arena->nodes[n].text);
        if (!adts || tagi < 0 || tagi >= nadts)
            return self->fail_from(n, "the ADT row is missing");
    }
    k = self->ntmp;
    self->ntmp++;
    ptr = self->arena->nodes[n].aux & 1;
    self_deref = self->sym->self_mode
        && self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_VAR
        && strcmp(self->arena->nodes[self->arena->nodes[n].a].text2,
                  "self") == 0;
    self->emit_indent(ind);
    if (nonadt)
        fprintf(self->out, "%s%s__ct_match%d __attribute__((unused)) = (",
                self->arena->nodes[n].text2, ptr ? " *" : " ", k);
    else
        fprintf(self->out, "struct %s%s__ct_match%d __attribute__((unused)) = (",
                adts[tagi].full, ptr ? " *" : " ", k);
    /* LANG-29 S3 / B2: inside an inherent (or trait) method the source `self`
       is a value, but `self_mode` spells it `_self`, a pointer. A match over
       that receiver keeps the value form and dereferences here, so the same
       body compiles inside and outside an impl. */
    if (self_deref) fputs("*(_self)", self->out);
    else if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(");\n", self->out);
    narm = 0;
    for (arm = self->arena->nodes[n].b; arm >= 0; arm = self->arena->nodes[arm].next)
        narm++;
    idx = 0;
    for (arm = self->arena->nodes[n].b; arm >= 0;
         arm = self->arena->nodes[arm].next, idx++) {
        if (idx < narm - 1) {
            if (self->arena->nodes[arm].aux & 1)
                return self->fail_from(arm, "a wildcard match arm must be the last arm");
            self->emit_indent(ind);
            fputs(idx == 0 ? "if (" : "else if (", self->out);
            if (!nonadt && self->arena->nodes[arm].num >= 0)
                fprintf(self->out, "__ct_match%d%stag == %d",
                        k, ptr ? "->" : ".", (int)self->arena->nodes[arm].num);
            else
                fputs("1", self->out);
            if (emit_arm_conds(self, arm, k, &ncond) != 0) return -1;
            fputs(") ", self->out);
        } else if (narm > 1) {
            self->emit_indent(ind);
            fputs("else ", self->out);
        } else {
            self->emit_indent(ind);
        }
        if (emit_match_arm(self, arm, ind, k, ptr) != 0) return -1;
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_switch(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    if (self->hoist_expr(self->arena->nodes[n].a, ind) != 0) return -1;
    self->emit_indent(ind);
    fputs("switch (", self->out);
    if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
    fputs(") ", self->out);
    g_sb.switch_pending = 1;
    {
        int r = self->emit_node(self->arena->nodes[n].b, ind);
        g_sb.switch_pending = 0;
        return r;
    }
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_case(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int c;
    self->emit_indent(ind);
    if (self->arena->nodes[n].aux) {
        fputs("default:", self->out);
    } else {
        /* the label is whatever the constant expression printed: a
           literal, an enum member's C name, or a folded-by-C form.
           `c >= 0` makes it a range (`case 1 ... 5:`). */
        fputs("case ", self->out);
        if (self->emit_expr(self->arena->nodes[n].b) != 0) return -1;
        if (self->arena->nodes[n].c >= 0) {
            fputs(" ... ", self->out);
            if (self->emit_expr(self->arena->nodes[n].c) != 0) return -1;
        }
        fputs(":", self->out);
    }
    fputs("\n", self->out);
    /* SH-102: a case body has no N_BLOCK of its own; a `break` here must
       not release the enclosing scope's handles. */
    {
        int sbase = g_sb.n, lbase = g_sb.ln;
        if (g_sb.nblk < 256) {
            g_sb.blk[g_sb.nblk] = sbase;
            g_sb.lblk[g_sb.nblk] = lbase;
            g_sb.bkind[g_sb.nblk] = 0;
            g_sb.nblk++;
        }
        for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next)
            if (self->emit_node(c, ind + 1) != 0) return -1;
        sb_release_from(self, sbase, -1, ind + 1);
        g_sb.n = sbase;
        g_sb.ln = lbase;
        if (g_sb.nblk > 0) g_sb.nblk--;
        sb_field_merge(self, g_sb.nblk, lbase);
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_node_dowhile(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;


    int b, c;
    if (self->hoist_expr(self->arena->nodes[n].a, ind) != 0) return -1;
    self->emit_indent(ind);
    fputs("do {\n", self->out);
    /* `parse_branch` wraps even a single statement in an N_BLOCK, so
       the body always walks here instead of going through
       `emit_node`, which would put the closing brace on its own line */
    b = self->arena->nodes[n].b;
    {
        int sbase = g_sb.n, lbase = g_sb.ln;
        if (g_sb.nblk < 256) {
            g_sb.blk[g_sb.nblk] = sbase;
            g_sb.lblk[g_sb.nblk] = lbase;
            g_sb.bkind[g_sb.nblk] = 1;
            g_sb.nblk++;
        }
        for (c = self->arena->nodes[b].a; c >= 0; c = self->arena->nodes[c].next)
            if (self->emit_node(c, ind + 1) != 0) return -1;
        sb_release_from(self, sbase, -1, ind + 1);
        g_sb.n = sbase;
        g_sb.ln = lbase;
        if (g_sb.nblk > 0) g_sb.nblk--;
        sb_field_merge(self, g_sb.nblk, lbase);
    }
    self->emit_indent(ind);
    fputs("} while (", self->out);
    if (self->emit_cond(self->arena->nodes[n].a) != 0) return -1;
    fputs(");\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_decl_struct(struct Emitter *self, int n, int ind, int with_semi, int nk)
{
    (void)with_semi;
    (void)nk;
    int m;
    (void)m;


    int si, u;
    /* Phase 29: a template emits nothing; its instances have their own
       rows and their own writer (`emit_struct_insts`). */
    si = self->sym->find_struct(self->arena->nodes[n].text2);
    if (si >= 0 && self->sym->structs[si].is_template) return 0;
    /* Phase 29: a field of an instance type needs that instance's
       definition first (`struct Bag { Vec<int> items; }`). */
    for (u = self->arena->nodes[n].a; u >= 0; u = self->arena->nodes[u].next) {
        if (self->arena->nodes[u].kind == N_FIELD) {
            if (preemit_insts_for(self, self->arena->nodes[u].text) != 0) return -1;
        }
    }
    if (self->arena->nodes[n].aux) {
        /* `typedef struct Tag { ... } Name;` keeps the tag so a
           `struct Tag` reference (or self-reference) stays valid */
        if (self->arena->nodes[n].text[0]) {
            fprintf(self->out, "typedef struct %s {\n", self->arena->nodes[n].text);
        } else {
            fputs("typedef struct {\n", self->out);
        }
    } else {
        fprintf(self->out, "struct %s {\n", self->arena->nodes[n].text2);
    }
    {
        int si_p = self->sym->find_struct(self->arena->nodes[n].text2);
        int privp = 0;
        int m2;
        if (si_p >= 0 && self->sym->structs[si_p].nuse == 0) {
            int has_pub = 0, has_priv = 0;
            for (m2 = 0; m2 < self->sym->structs[si_p].nfields; m2++) {
                if (self->sym->structs[si_p].fields[m2].is_pub) has_pub = 1;
                else has_priv = 1;
            }
            privp = has_pub && has_priv;
        }
        if (privp) fputs("#ifdef CT_UNIT_PRIVATE\n", self->out);
        for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
            self->emit_indent(ind + 1);
            if (self->emit_field(m, ind + 1) != 0) return -1;
            fputs(";\n", self->out);
        }
        if (privp) {
            fputs("#else\n", self->out);
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                if (self->arena->nodes[m].kind == N_FIELD
                    && !self->arena->nodes[m].d) continue;
                self->emit_indent(ind + 1);
                if (self->emit_field(m, ind + 1) != 0) return -1;
                fputs(";\n", self->out);
            }
        }
        if (privp) fputs("#endif\n", self->out);
    }
    si = self->sym->find_struct(self->arena->nodes[n].text2);
    if (si >= 0) {
        for (u = 0; u < self->sym->structs[si].nuse; u++) {
            const char *use = self->sym->structs[si].use[u];
            size_t ul = strlen(use);
            char *low = tool::sh::ct_scratch_alloc((int)ul + 1);
            int i;
            for (i = 0; i < (int)ul; i++) {
                char c = use[i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            self->emit_indent(ind + 1);
            fprintf(self->out, "const struct %s_vtbl *__%s_vptr;\n", use, low);
        }
    }
    self->emit_indent(ind);
    fputs("}", self->out);
    /* `struct S { … } __attribute__((packed));` — a typedef form puts it
       between the body and the alias, the one position clang and GCC
       both honour for `packed` / `aligned` on the type */
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    if (self->arena->nodes[n].aux) fprintf(self->out, " %s", self->arena->nodes[n].text2);
    fputs(";\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_decl_union(struct Emitter *self, int n, int ind, int with_semi, int nk)
{
    (void)with_semi;
    (void)nk;
    int m;
    (void)m;


    /* no `use` clause, so no vptr fields; `text` is the tag of a
       `typedef union Tag { … } Alias;` and `text2` the emitted name */
    if (self->arena->nodes[n].aux) {
        if (self->arena->nodes[n].text[0]) {
            fprintf(self->out, "typedef union %s {\n", self->arena->nodes[n].text);
        } else {
            fputs("typedef union {\n", self->out);
        }
    } else {
        fprintf(self->out, "union %s {\n", self->arena->nodes[n].text2);
    }
    for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
        self->emit_indent(ind + 1);
        if (self->emit_field(m, ind + 1) != 0) return -1;
        fputs(";\n", self->out);
    }
    self->emit_indent(ind);
    fputs("}", self->out);
    /* `struct S { … } __attribute__((packed));` — a typedef form puts it
       between the body and the alias, the one position clang and GCC
       both honour for `packed` / `aligned` on the type */
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    if (self->arena->nodes[n].aux) fprintf(self->out, " %s", self->arena->nodes[n].text2);
    fputs(";\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_decl_enum_adt(struct Emitter *self, int n, int ind, int with_semi, int nk)
{
    (void)nk;


    /* Phase 84: a payload-bearing enum is an ADT; its layout is a
       struct, not a C enum (the two forms never mix, D84-1). */
    return emit_adt_decl(self, n, ind, with_semi);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_decl_enum(struct Emitter *self, int n, int ind, int with_semi, int nk)
{
    (void)with_semi;
    (void)nk;
    int m;
    (void)m;


    /* `text2` is the name the type is known by (`text3` the tag of a
       `typedef enum Tag { … } Alias;`, empty when it had none) */
    if (self->arena->nodes[n].aux & 1) {
        if (self->arena->nodes[n].text3[0]) {
            fprintf(self->out, "typedef enum %s {\n", self->arena->nodes[n].text3);
        } else {
            fputs("typedef enum {\n", self->out);
        }
    } else {
        fprintf(self->out, "enum %s {\n", self->arena->nodes[n].text2);
    }
    for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
        self->emit_indent(ind + 1);
        fputs(self->arena->nodes[m].text, self->out);
        /* an explicit value keeps the source expression; no value
           means "one more than the previous", which C computes */
        if (self->arena->nodes[m].a >= 0) {
            fputs(" = ", self->out);
            if (self->emit_expr(self->arena->nodes[m].a) != 0) return -1;
        }
        if (self->arena->nodes[m].next >= 0) fputs(",", self->out);
        fputs("\n", self->out);
    }
    self->emit_indent(ind);
    fputs("}", self->out);
    /* `struct S { … } __attribute__((packed));` — a typedef form puts it
       between the body and the alias, the one position clang and GCC
       both honour for `packed` / `aligned` on the type */
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    if (self->arena->nodes[n].aux) fprintf(self->out, " %s", self->arena->nodes[n].text2);
    fputs(";\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_decl_typedef(struct Emitter *self, int n, int ind, int with_semi, int nk)
{
    (void)ind;
    (void)with_semi;
    (void)nk;


    fputs("typedef ", self->out);
    if (self->emit_type_name_dims(self->arena->nodes[n].text, self->arena->nodes[n].text2,
                                  self->arena->nodes[n].text3) != 0) return -1;
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    fputs(";\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_decl_global(struct Emitter *self, int n, int ind, int with_semi, int nk)
{
    (void)nk;


    /* Phase 44: a file-scope initialiser has no outer function, so a
       `?` there has no error target (L44-4). */
    self->cur_ret = "";
    if (self->init->type_needs_init(self->arena->nodes[n].text)
        && dims_depth(self->arena->nodes[n].text3) > 1)
        return self->fail_from(n, "a multi-dimensional array cannot hold trait-carrying values");
    if (self->freestanding && *self->freestanding && unit_init_needed(self, n))
        return self->fail_from(n,
            "this file-scope object needs a constructor to fill its vptrs, "
            "which --freestanding does not emit; give it an initialiser");
    self->emit_indent(ind);
    if (self->arena->nodes[n].aux == 1) fputs("static ", self->out);
    if (self->emit_global_decl(n) != 0) return -1;
    if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_RANGE) {
        if (self->emit_range_init(self->arena->nodes[n].a) != 0) return -1;
    } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW) {
        if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text,
                                  self->arena->nodes[n].text3, 1) != 0) return -1;
    } else if (self->arena->nodes[n].a >= 0) {
        fputs(" = ", self->out);
        if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    } else if (self->init->type_needs_init(self->arena->nodes[n].text) && !self->arena->nodes[n].text3[0]) {
        /* an array gets per-element writes (local) or a constructor
           (file scope); a designator on the array itself is invalid */
        fputs(" = { ", self->out);
        if (self->init->emit_vptr_items("", self->arena->nodes[n].text) != 0) return -1;
        if (self->init->emit_field_vptrs(self->sym->find_struct(
                strncmp(self->arena->nodes[n].text, "struct ", 7) == 0
                    ? self->arena->nodes[n].text + 7 : self->arena->nodes[n].text),
                self->init->type_has_vptr(self->arena->nodes[n].text), 0) != 0) return -1;
        fputs(" }", self->out);
    }
    if (with_semi) fputs(";\n", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_try(struct Emitter *self, int n, int nk)
{
    (void)nk;


    int save, r;
    save = self->try_discard;
    self->try_discard = 1;
    r = self->emit_expr(n);
    self->try_discard = save;
    return r;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_decls(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* a `for` initialiser: one shared type, then bare declarators */
    int c = self->arena->nodes[n].a, first = 1;
    while (c >= 0) {
        if (first) {
            if (self->emit_inline(c) != 0) return -1;
        } else {
            fputs(", ", self->out);
            fputs(self->arena->nodes[c].text2, self->out);
            if (self->arena->nodes[c].text3[0]) fputs(self->arena->nodes[c].text3, self->out);
            if (self->arena->nodes[c].a >= 0) {
                if (self->arena->nodes[self->arena->nodes[c].a].kind == N_INIT_RANGE) {
                    if (self->emit_range_init(self->arena->nodes[c].a) != 0) return -1;
                } else if (self->arena->nodes[self->arena->nodes[c].a].kind == N_INIT_BRACE) {
                    if (self->emit_brace_init(self->arena->nodes[c].a) != 0) return -1;
                } else if (self->arena->nodes[self->arena->nodes[c].a].kind == N_INIT_MBRACE) {
                    if (self->emit_map_brace_init(self->arena->nodes[c].a) != 0) return -1;
                } else if (self->arena->nodes[self->arena->nodes[c].a].kind == N_RAW) {
                    if (self->emit_raw_init(self->arena->nodes[c].a, self->arena->nodes[c].text,
                            self->arena->nodes[c].text3, 1) != 0) return -1;
                } else {
                    fputs(" = ", self->out);
                    if (self->emit_expr(self->arena->nodes[c].a) != 0) return -1;
                }
            }
        }
        first = 0;
        c = self->arena->nodes[c].next;
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_field_bitfield(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs(self->arena->nodes[n].text, self->out);
    if (self->arena->nodes[n].text2[0]) fprintf(self->out, " %s", self->arena->nodes[n].text2);
    fputs(" : ", self->out);
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_decl_field(struct Emitter *self, int n, int nk)
{

    /* A closure binding declares no C variable: only its environment's
       stack instance is written, and the name is recorded so a later
       call expands to the trampoline (Phase 21 S3). */
    if (nk == N_DECL && self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_CLOSURE)
        return emit_closure_decl(self, n);
    /* `aux == 1` marks a function-local with static storage duration */
    if (nk == N_DECL && self->arena->nodes[n].aux == 1)
        fputs("static ", self->out);
    if (self->emit_type_name_dims(self->arena->nodes[n].text, self->arena->nodes[n].text2,
                                  self->arena->nodes[n].text3) != 0) return -1;
    /* Phase 84: a match binding the body never reads is still an
       ordinary local; the attribute keeps `-Wunused-variable` quiet
       without a `(void)x;` statement of its own. */
    if (nk == N_DECL && self->arena->nodes[n].aux == 3)
        fputs(" __attribute__((unused))", self->out);
    if (self->arena->nodes[n].attr >= 0)
        fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
    if (nk == N_DECL) {
        if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_RANGE) {
            if (self->emit_range_init(self->arena->nodes[n].a) != 0) return -1;
        } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_BRACE) {
            if (self->emit_brace_init(self->arena->nodes[n].a) != 0) return -1;
        } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_INIT_MBRACE) {
            if (self->emit_map_brace_init(self->arena->nodes[n].a) != 0) return -1;
        } else if (self->arena->nodes[n].a >= 0 && self->arena->nodes[self->arena->nodes[n].a].kind == N_RAW) {
            if (self->emit_raw_init(self->arena->nodes[n].a, self->arena->nodes[n].text,
                                  self->arena->nodes[n].text3, 1) != 0) return -1;
        } else if (self->arena->nodes[n].a >= 0) {
            fputs(" = ", self->out);
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
        } else if (frontend::sym::ct_is_string_value_type(self->arena->nodes[n].text)
                   && !self->arena->nodes[n].text3[0]
                   && self->arena->nodes[n].aux != 1) {
            /* SH-102: a bare handle is a null handle, so a scope release
               of a declaration this writer does not track (a multiple
               declarator or a `for` initialiser) is still safe. */
            fputs(" = { 0 }", self->out);
        } else if (self->init->type_needs_init(self->arena->nodes[n].text) && !self->arena->nodes[n].text3[0]) {
            fputs(" = { ", self->out);
            if (self->init->emit_vptr_items("", self->arena->nodes[n].text) != 0) return -1;
            if (self->init->emit_field_vptrs(self->sym->find_struct(
                    strncmp(self->arena->nodes[n].text, "struct ", 7) == 0
                        ? self->arena->nodes[n].text + 7 : self->arena->nodes[n].text),
                    self->init->type_has_vptr(self->arena->nodes[n].text), 0) != 0) return -1;
            fputs(" }", self->out);
        }
        /* `aux == 2`: an auto-dropped declaration whose name is shadowed
           where some release runs. The private alias addresses the object
           from the shadowing scope (see `autodrop_append`). */
        if (self->arena->nodes[n].aux == 2)
            fprintf(self->out, ", *__ct_own_%d = %s", n, self->arena->nodes[n].text2);
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_bin_comma(struct Emitter *self, int n, int nk)
{
    (void)nk;


    fputs("(", self->out);
    if (self->emit_inline(self->arena->nodes[n].a) != 0) return -1;
    fputs(", ", self->out);
    if (self->emit_inline(self->arena->nodes[n].b) != 0) return -1;
    fputs(")", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_assign(struct Emitter *self, int n, int nk)
{
    (void)nk;


    const char *aop = " = ";
    if (self->arena->nodes[n].aux == 1) aop = " += ";
    else if (self->arena->nodes[n].aux == 2) aop = " -= ";
    else if (self->arena->nodes[n].aux == 3) aop = " *= ";
    else if (self->arena->nodes[n].aux == 4) aop = " /= ";
    else if (self->arena->nodes[n].aux == 5) aop = " %= ";
    else if (self->arena->nodes[n].aux == 6) aop = " &= ";
    else if (self->arena->nodes[n].aux == 7) aop = " |= ";
    else if (self->arena->nodes[n].aux == 8) aop = " ^= ";
    else if (self->arena->nodes[n].aux == 9) aop = " <<= ";
    else if (self->arena->nodes[n].aux == 10) aop = " >>= ";
    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(aop, self->out);
    return self->emit_expr(self->arena->nodes[n].b);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_expr(struct Emitter *self, int n, int nk)
{
    (void)nk;


    /* Phase 44: route a discarded `expr?` through the discard-aware
       branch above. */
    if (self->arena->nodes[n].a >= 0
        && self->arena->nodes[self->arena->nodes[n].a].kind == N_TRY)
        return self->emit_inline(self->arena->nodes[n].a);
    return self->emit_expr(self->arena->nodes[n].a);
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_inline_post(struct Emitter *self, int n, int nk)
{
    (void)nk;


    if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
    fputs(self->arena->nodes[n].aux == P_INC ? "++" : "--", self->out);
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_field_fields(struct Emitter *self, int n, int ind, int nk)
{
    (void)ind;
    (void)nk;
    int c;
    (void)c;


    int first = 1;
    fputs(self->arena->nodes[n].text, self->out);
    for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next) {
        fputs(first ? " " : ", ", self->out);
        if (!first) {
            /* a later declarator carries its own stars (`int a, *b;`) */
            const char *tp = self->arena->nodes[c].text;
            size_t tl = strlen(tp);
            while (tl > 0 && (tp[tl - 1] == '*' || tp[tl - 1] == ' ')) {
                if (tp[tl - 1] == '*') fputc('*', self->out);
                tl--;
            }
        }
        first = 0;
        fputs(self->arena->nodes[c].text2, self->out);
        if (self->arena->nodes[c].text3[0]) fputs(self->arena->nodes[c].text3, self->out);
        if (self->arena->nodes[c].aux == 1) {
            fputs(" : ", self->out);
            if (self->emit_expr(self->arena->nodes[c].a) != 0) return -1;
        }
        /* the attribute follows the width for a bit-field, else the dims */
        if (self->arena->nodes[c].attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[c].attr));
    }
    return 0;
}

/* PH-88: one node kind; the dispatcher read `kind` once. */
static int em_field_field_union(struct Emitter *self, int n, int ind, int nk)
{
    (void)nk;
    int c;
    (void)c;


    fprintf(self->out, "%s {\n", self->arena->nodes[n].text);
    for (c = self->arena->nodes[n].a; c >= 0; c = self->arena->nodes[c].next) {
        self->emit_indent(ind + 1);
        if (self->emit_field(c, ind + 1) != 0) return -1;
        fputs(";\n", self->out);
    }
    self->emit_indent(ind);
    fputs("}", self->out);
    return 0;
}

/* SH-110: a materialised receiver is written as `TYPE __ct_tmpN = call;`, so
   the static type must be a simple declarator. An array spelling (`...[]`) or
   a function-pointer declarator (`... (*)(...)`) cannot be spliced that way;
   those hop shapes stay refused instead of emitting bad C. */
/* S1a-0 C1: the per-statement hoist and `into` lists are heap blocks that
   double from MAX_HOISTS/MAX_INTOS; the new slots are zeroed. */
impl EmitOps for Emitter {
    /* Phase 38 battle p38-1: a receiver is unstable when evaluating it twice
       can observe a different value. Calls are stable once the hoist pass has
       materialised them (text3); post/pre/assignment and calls buried inside a
       subscript/member base are not. */
    int emit_indent(int n)
    {
        int i;
        (void)self;
        for (i = 0; i < n * 4; i++) fputc(' ', self->out);
        return 0;
    }

    /* Fresh state for one statement's hoist scan. The statement's `next` is the
       following statement (not part of this expression), so it is cut off
       while the children are walked.

       Only the statement's own expression root may be hoisted: at the start of
       a statement's expression, or at the start of an assignment / declaration
       initialiser, evaluation is unconditional and ordered, so moving the
       receiver to the line before cannot change what it reads. Anywhere else
       the hoist would reorder it, so `hoist_scan` reports instead. */
    /* A chain like `f().a.b` as a method receiver has to be materialised: C
       will not take the address of the call result. Root calls are recorded
       and named `__ct_tmpN`. `top` marks the statement's expression root; an
       rvalue receiver found below it has no defined evaluation point to hoist
       to, so it is an error rather than a silent reordering. */
    /* PH-53: run the optional-temp scan for one condition / for-header
       expression and write the declarations at `ind`. */
    /* PP lines, then types/globals in source order, then prototypes, then the
       definitions. Prototypes come after the type declarations they may use. */
    int emit_program(int prog)
    {
        if (self->no_write) return 0;
        int n, i;
        (void)self;

        self->errmsg = "";
        self->failline = 0;
        self->cur_unit = -1;
        g_shell_u = -1;
        g_shell_header = 0;
        /* SH-111: assert the lowering invariants before the first byte is
           written. A legal program cannot fail this; a failure means the
           parser/lowering built an AST the emitter's contract does not cover. */
        if (self->invariant_check(prog) != 0) return -1;
        /* compile mode is one file: the parser's prefix is this file's */
        self->gprefix = self->sym->ns;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_PP) {
            if ((self->io_mask & 1)
                && strcmp(self->arena->nodes[n].text, "#include <stdio.h>") == 0) continue;
            if ((self->io_mask & 2)
                && strcmp(self->arena->nodes[n].text, "#include <wchar.h>") == 0) continue;
            fprintf(self->out, "%s\n", self->arena->nodes[n].text);
        }
        if (self->alloc_map && self->alloc_map[0]) {
            fprintf(self->out, "extern void *%s(__SIZE_TYPE__);\n", self->alloc_m);
            fprintf(self->out, "extern void %s(void *);\n", self->alloc_f);
        }
        if (self->sym->atomic_used) {
        fputs(
"static inline __attribute__((unused)) int __ct_atomic_load_int(_Atomic(int) *p)\n"
"{\n"
"    return __atomic_load_n((int *)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_int(_Atomic(int) *p, int v)\n"
"{\n"
"    __atomic_store_n((int *)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_int(_Atomic(int) *p, int *e, int v)\n"
"{\n"
"    return __atomic_compare_exchange_n((int *)p, e, v, 0,\n"
"                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) long __ct_atomic_load_long(_Atomic(long) *p)\n"
"{\n"
"    return __atomic_load_n((long *)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_long(_Atomic(long) *p, long v)\n"
"{\n"
"    __atomic_store_n((long *)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_long(_Atomic(long) *p, long *e, long v)\n"
"{\n"
"    return __atomic_compare_exchange_n((long *)p, e, v, 0,\n"
"                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_load_bool(_Atomic(_Bool) *p)\n"
"{\n"
"    return __atomic_load_n((_Bool *)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_bool(_Atomic(_Bool) *p, _Bool v)\n"
"{\n"
"    __atomic_store_n((_Bool *)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_bool(_Atomic(_Bool) *p, _Bool *e, _Bool v)\n"
"{\n"
"    return __atomic_compare_exchange_n((_Bool *)p, e, v, 0,\n"
"                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void *__ct_atomic_load_ptr(_Atomic(void *) *p)\n"
"{\n"
"    return __atomic_load_n((void **)p, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) void __ct_atomic_store_ptr(_Atomic(void *) *p, void *v)\n"
"{\n"
"    __atomic_store_n((void **)p, v, __ATOMIC_SEQ_CST);\n"
"}\n"
"static inline __attribute__((unused)) _Bool __ct_atomic_cas_ptr(_Atomic(void *) *p, void **e, void *v)\n"
"{\n"
"    return __atomic_compare_exchange_n((void **)p, e, v, 0,\n"
"                              __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n"
"}\n"
        , self->out);
    }

    if (g_slice_used && *g_slice_used) emit_slice_helpers(self);

        if (self->emit_struct_fwd() != 0) return -1;
        if (self->emit_trait_decls() != 0) return -1;
        if (self->emit_vtable_fwd(prog) != 0) return -1;

        /* Types first, then every prototype, then the globals: a file-scope
           initialiser may name a function of this unit (`int (*gp)(int) = plus;`)
           and C needs that declaration in scope (D-6). */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_RAW_TEXT) {
                if (emit_raw_text(self, n) != 0) return -1;
                continue;
            }
            if (self->arena->nodes[n].kind == N_STRUCT || self->arena->nodes[n].kind == N_TYPEDEF
                || self->arena->nodes[n].kind == N_ENUM || self->arena->nodes[n].kind == N_UNION) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        /* SH-120: generic instance glue (`Result<String, E>`,
           `Option<String>`, ...) is written before the inherent-method
           prototype pass and calls the owning handles' retain/release
           protocol. Declare that protocol here; the four handles are already
           defined by the type pass above. (The same prototypes reappear with
           the unit bodies, exactly as the pre-SH-120 output did.) */
        if (self->sym->find_struct("String") >= 0) {
            fputs("struct String String_retain(struct String *);\n", self->out);
            fputs("void String_release(struct String *);\n", self->out);
        }
        if (self->sym->find_struct("U16String") >= 0) {
            fputs("struct U16String U16String_retain(struct U16String *);\n", self->out);
            fputs("void U16String_release(struct U16String *);\n", self->out);
        }

        /* Phase 29: compile mode is one unit, so every instance is its own. */
        if (emit_struct_insts(self, -1, 0) != 0) return -1;
        if (emit_Box_protos(self, -1) != 0) return -1;
        if (emit_struct_impls(self, -1, 0) != 0) return -1;
        if (emit_Box_helpers(self, -1) != 0) return -1;
        /* LANG-29 S2 / B3: the per-ADT retain / release definitions. */
        if (emit_adt_life_defs(self, -1) != 0) return -1;
        /* PH-80: the literal blocks need `struct ct_str_hdr` / `struct String`
           to be visible, which the two calls above guarantee. */
        if (emit_string_literals(self, prog) != 0) return -1;

        /* Prototypes come before the impl bodies: an impl method may call a
           free function declared earlier in the unit, and C needs the prototype
           in scope at the call site. */
        for (i = 0; i < self->sym->nfunc; i++)
            if (self->emit_proto(i) != 0) return -1;
        if (self->emit_inherent_protos(prog) != 0) return -1;

        /* A file-scope `_Static_assert` lands here: after every type, so an
           assertion about a struct or enum declared above it still resolves. */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_SASSERT)
                if (self->emit_node(n, 0) != 0) return -1;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            /* an `extern` global is a declaration only: it adds no definition */
            if (self->arena->nodes[n].kind != N_GLOBAL || self->arena->nodes[n].aux == 2) continue;
            if (self->emit_type_decl(n, 0, 1) != 0) return -1;
        }

        if (self->emit_impls(prog) != 0) return -1;

        if (self->emit_maps(-1) != 0) return -1;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind == N_FUNC) {
                int cur = self->sym->find_func(self->arena->nodes[n].text2);
                /* a generic template has no C body of its own (Phase 26) */
                if (cur >= 0 && self->sym->funcs[cur].ntparams > 0) continue;
                /* the closure products of this function land above its definition */
                if (emit_closures(self, self->arena->nodes[n].text2, self->arena->nodes[n].line) != 0)
                    return -1;
                if (self->emit_node(n, 0) != 0) return -1;
            }
        }
        if (emit_generic_defs(self, -1) != 0) return -1;
        if (self->emit_unit_init(prog) != 0) return -1;
        return 0;
    }

    /* One prototype line for `self->sym->funcs[i]`. */
    int emit_proto(int i)
    {
        int k;
        (void)self;

        /* a generic template is never a C symbol of its own (Phase 26) */
        if (self->sym->funcs[i].ntparams > 0) return 0;
        if (self->sym->funcs[i].is_static
            || (self->abi_mode && *self->abi_mode && !self->sym->funcs[i].is_pub))
            fputs("static ", self->out);
        fprintf(self->out, "%s %s(", self->sym->funcs[i].ret, self->sym->funcs[i].cname);
        if (self->sym->funcs[i].nparams == 0) {
            fputs("void", self->out);
        } else {
            for (k = 0; k < self->sym->funcs[i].nparams; k++) {
                if (k > 0) fputs(", ", self->out);
                fputs(self->sym->funcs[i].ptype[k], self->out);
                if (self->sym->funcs[i].pann[k] == 2
                    || self->sym->funcs[i].pann[k] == 3)
                    fputs(" *", self->out);
                fputs(self->sym->funcs[i].pdim[k], self->out);
            }
            if (self->sym->funcs[i].variadic) fputs(", ...", self->out);
        }
        fputs(")", self->out);
        /* a GNU attribute rides after the parameter list, where the source had it */
        if (self->sym->funcs[i].attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->sym->funcs[i].attr));
        fputs(";\n", self->out);
        return 0;
    }

    /* PH-48 D48-2: 1 when unit `u` declares a concrete `impl Drop for S` at its
       top level. Concrete impls are AST nodes (they have no `ct_impls` row), so
       the owning unit is found by walking that unit's program, not by a field
       on the struct row. */
    int unit_has_drop_impl(int u, int si)
    {
        int n;
        if (u < 0 || u >= *self->nunits || si < 0) return 0;
        for (n = self->arena->nodes[self->units[u].prog].a; n >= 0;
             n = self->arena->nodes[n].next)
            if (self->arena->nodes[n].kind == N_IMPL
                && self->arena->nodes[n].aux == si
                && strcmp(self->arena->nodes[n].text2, "Drop") == 0)
                return 1;
        return 0;
    }

    /* PH-48 D48-2: 1 when this unit may call `<S>_Drop_drop`. Compile mode is
       one TU, so everything is visible. In build mode the body is emitted once,
       by the struct's owner unit, and only there (or through the owner's
       header); an impl that lives in some other unit has no prototype in the
       type's header, which is the L48-2 case the module layer rejects before
       emission. Generic instance rows keep the legacy path (their writer is
       decided by the instance ownership rules, not by the struct owner). */
    int drop_visible(int si)
    {
        int owner;

        if (self->cur_unit < 0) return 1;
        if (si < 0 || si >= self->sym->nstructs) return 1;
        if (!self->sym->structs[si].uses_drop) return 1;
        if (self->sym->structs[si].is_inst) return 1;
        owner = self->sym->structs[si].owner;
        if (owner < 0) return 1;
        if (owner == self->cur_unit) return 1;
        if (!self->sym->structs[si].has_drop_impl) return 1;
        return self->unit_has_drop_impl(owner, si);
    }

    /* Tentative definitions so a global declared above an impl can already
       point at its vtable; C99 6.9.2 lets the definition below complete them. */
    int emit_vtable_fwd(int prog)
    {
        int n, si;
        const char *tname;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl: no struct row to name */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0)
                continue;   /* no vptr, no vtable */
            if (self->vtable_exported(si, tname))
                fprintf(self->out, "const struct %s_vtbl %s_%s_vtable;\n",
                        tname, self->sym->structs[si].name, tname);
            else
                fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                        tname, self->sym->structs[si].name, tname);
        }
        /* adoptions that need no impl: an all-default trait fills its own
           slots, so the vtable must be visible to the initialisers below */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int ui;
            const char *tname;
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                if (!adoption_default_only(self, si, tname)) continue;
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "const struct %s_vtbl %s_%s_vtable;\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused));\n",
                            tname, self->sym->structs[si].name, tname);
            }
        }
        /* a `delete` in a function body runs before the drop definition below.
           PH-48 D48-2: in build mode the definition is owned by exactly one
           unit, so only that unit writes the non-static prototype; every other
           unit declares `extern` and calls the owner's body (compile mode keeps
           the old static pair byte for byte, and generic instance rows keep
           their legacy writer). */
        for (si = 0; si < self->sym->nstructs; si++) {
            int owner, legacy;
            if (!self->sym->structs[si].uses_drop
                || self->sym->structs[si].is_template) continue;
            owner = self->sym->structs[si].owner;
            legacy = (self->cur_unit < 0 || owner < 0);
            if (self->cur_unit < 0) {
                fprintf(self->out,
                        "static void __attribute__((unused)) %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            } else if (legacy) {
                /* the legacy writer emits a static body in every unit; the
                   instance body is written before its first use, so a static
                   prototype in a unit that never defines it is only a gcc
                   -Wunused-function warning (Box in build mode, CI-18). */
                if (self->sym->structs[si].is_inst) continue;
                fprintf(self->out,
                        "static void __attribute__((unused)) %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            } else if (owner == self->cur_unit) {
                /* no local body: the impl lives elsewhere (L48-2, rejected by
                   the module layer) and a stale prototype would be a lie */
                if (self->sym->structs[si].has_drop_impl
                    && !self->unit_has_drop_impl(self->cur_unit, si))
                    continue;
                fprintf(self->out, "void %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            } else {
                fprintf(self->out, "extern void %s_Drop_drop(void *self);\n",
                        self->sym->structs[si].name);
            }
        }
        /* a `borrow` release runs before the handback definition below */
        for (si = 0; si < self->sym->nstructs; si++)
            if (self->sym->structs[si].has_handback_impl)
                fprintf(self->out, "static void __attribute__((unused)) %s_Handback_handback(void *self);\n",
                        self->sym->structs[si].name);
        if (self->sym->nstructs) fputs("\n", self->out);
        return 0;
    }

    /* One vtable type and one interface type per trait. */
    int emit_trait_decls(void)
    {
        (void)self;
        return self->emit_trait_range(0, self->sym->ntraits, 0);
    }

    /* A vtable field may name a struct by pointer (`void (*m)(void *, struct S *)`)
       before that struct is defined, and a tag first seen inside a parameter
       list would get prototype scope. Declare every tag up front. */
    int emit_struct_fwd(void)
    {
        int i, ti;
        (void)self;

        for (i = 0; i < self->sym->nstructs; i++) {
            if (self->sym->structs[i].is_template) continue;
            ti = self->sym->find_type(self->sym->structs[i].name);
            if (ti < 0) continue;
            if (self->sym->type_kind[ti] == 1) fprintf(self->out, "struct %s;\n", self->sym->structs[i].name);
            else if (self->sym->type_kind[ti] == 6) fprintf(self->out, "union %s;\n", self->sym->structs[i].name);
        }
        return 0;
    }

    /* `mode`: 0 = every trait, 1 = exported only, 2 = private only. */
    int emit_trait_range(int start, int end, int mode)
    {
        int t, m, k;
        (void)self;

        for (t = start; t < end; t++) {
            if (self->sym->traits[t].is_static || self->sym->traits[t].ntparams > 0) continue;
            if (mode == 1 && !self->sym->traits[t].is_pub) continue;
            if (mode == 2 && self->sym->traits[t].is_pub) continue;
            fprintf(self->out, "struct %s_vtbl {\n", self->sym->traits[t].name);
            for (m = 0; m < self->sym->traits[t].nm; m++) {
                fprintf(self->out, "    %s (*%s)(void *", self->sym->traits[t].m[m].ret,
                        self->sym->traits[t].m[m].name);
                for (k = 0; k < self->sym->traits[t].m[m].nparams; k++) {
                    fprintf(self->out, ", %s", self->sym->traits[t].m[m].ptype[k]);
                    if (self->sym->traits[t].m[m].pann[k] == 2
                        || self->sym->traits[t].m[m].pann[k] == 3)
                        fputs(" *", self->out);
                }
                fputs(");\n", self->out);
            }
            fputs("};\n", self->out);
            fprintf(self->out, "struct %s_iface {\n    void *self;\n    const struct %s_vtbl *vt;\n};\n\n",
                    self->sym->traits[t].name, self->sym->traits[t].name);
        }
        return 0;
    }

    /* File-scope arrays cannot carry per-element writes in an initialiser, so
       they go into the per-unit constructor (the same shape as D5=A in the old
       pipeline). Emitted only when such an array exists. */
    int emit_unit_init(int prog)
    {
        int n, any;
        (void)self;

        /* PH-64: a bare-metal reset path never calls the constructor, so
           `--freestanding` emits none; every object that would have needed one
           is rejected above, with a position. */
        if (self->freestanding && *self->freestanding) return 0;
        any = 0;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
            if (unit_init_needed(self, n)) any = 1;
        if (!any) return 0;
        fputs("static void __ct_init(void) __attribute__((constructor));\n", self->out);
        fputs("static void __ct_init(void) {\n", self->out);
        fputs("    unsigned long __ct_i;\n", self->out);
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            const char *cnt;
            const char *recv;
            size_t ci;
            if (!unit_init_needed(self, n)) continue;
            if (!self->arena->nodes[n].text3[0]) {
                /* a scalar object whose struct has array fields */
                if (self->ty->type_has_array_init(self->arena->nodes[n].text)
                    && self->init->emit_vptr_stmts(self->arena->nodes[n].text2, self->arena->nodes[n].text, 2) != 0)
                    return -1;
                continue;
            }
            /* the count is the first bracket group of the suffix */
            ci = 1;
            while (self->arena->nodes[n].text3[ci] && self->arena->nodes[n].text3[ci] != ']') ci++;
            cnt = runtime::text::ct_intern_len(self->arena->nodes[n].text3 + 1,
                                              (int)(ci - 1));
            recv = runtime::text::ct_internf("%s[__ct_i]", self->arena->nodes[n].text2);
            if (!cnt || !recv) return self->fail("out of memory");
            fprintf(self->out, "    for (__ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
            if (self->init->emit_vptr_stmts(recv, self->arena->nodes[n].text, 2) != 0) return -1;
            fputs("    }\n", self->out);
        }
        fputs("}\n\n", self->out);
        return 0;
    }

    /* Write a captured `{ … }` initialiser for `type`, adding the vptr items a
       trait-carrying struct needs. `assign` writes the declaration's leading
       ` = `; a compound literal calls it with 0, since the braces follow the
       `(type)` directly. */
    /* Phase 24: `int a[] = 0..n($ * 2 + 1)` as ` = { <elem>, <elem>, … }`.
       The node keeps one element subtree, and every element re-emits it with
       `range_k` set to the current index, so `$` prints as `((int)<k>)` and the
       node count stays independent of how many elements the range has. Streaming
       the list also keeps it out of the rewritten-initialiser text pool.

       Phase 29 P29-1: a `Vec<T>` target carries the element's C type and the
       instance name, so the same list becomes a composite literal handed to the
       built-in constructor: `Vec_int_from((int[4]){ … }, 4)`. The compiler knows
       only the entry's name and the type argument, never `Vec`'s fields. */
    /* Phase 31 S11a: a `Vec<T>` brace initializer. The node carries the element
       type, the instance name and the element expressions chained through
       `next` (`aux` is the count), so the list streams exactly like the range
       form and the node count follows the source. An empty list hands the
       constructor `(0, 0)`: `Vec_<enc>_from` answers an empty handle, a shape
       the range form can never spell (`stop <= start` is refused). */
    /* Phase 31 S14b: a `Map` brace initializer. The node names the `MapEntry`
       struct and the `Map` instance; each item node carries its key in `a` and
       its value in `b`, chained through `next`. The list is streamed as one
       composite literal, and an empty list hands the constructor `(0, 0)` so the
       empty map still owns a releasable header. */
    /* Impl methods and their vtables, emitted before the ordinary functions so
       `main` can already dispatch through them. */
    int emit_impls(int prog)
    {
        int n, m, k, u, body, dm;
        (void)self;

        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, ti;
            const char *tname;
            const char *sname;
            const char *mret;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* template impls are written by emit_struct_impls */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            ti = -1;
            for (k = 0; k < self->sym->ntraits; k++)
                if (strcmp(self->sym->traits[k].name, tname) == 0) ti = k;
            if (ti < 0 && strcmp(tname, "Drop") != 0 && strcmp(tname, "Handback") != 0)
                return self->fail_from(n, "impl of an unknown trait");
            sname = self->arena->nodes[n].text;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                const char *owner;
                mret = self->arena->nodes[m].text3[0] ? self->arena->nodes[m].text3 : self->arena->nodes[m].text;
                /* the parser keys an impl closure by `<Struct>_<Trait>_<method>`,
                   the same spelling the definition below takes */
                owner = runtime::text::ct_internf("%s_%s_%s",
                         self->sym->structs[si].name, tname,
                         self->arena->nodes[m].text2);
                if (!owner) return self->fail("out of memory");
                if (emit_closures(self, owner, self->arena->nodes[m].line) != 0) return -1;
                self->nclvar = 0;
                self->closure_ci = 0;
                /* PH-48 D48-2 (U-2 A): a concrete Drop body is one link symbol,
                   not a per-unit static copy. Compile mode keeps the static pair
                   byte for byte; in build mode the owner unit exports the body
                   (the struct's header carries its prototype) so a consumer's
                   `delete` reaches the real implementation. Handback keeps the
                   old linkage: PH-38 owns its channel. */
                if (strcmp(tname, "Drop") == 0 && self->cur_unit >= 0) {
                    fprintf(self->out, "%s ", mret);
                } else {
                    fprintf(self->out, "static %s ", mret);
                    /* A drop that nothing deletes is dead code; marking it keeps
                       the output clean under -Wall without changing what is
                       emitted. The attribute goes before the declarator: clang
                       rejects the trailing position on a definition
                       (-Wgcc-compat). */
                    if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0)
                        fputs("__attribute__((unused)) ", self->out);
                }
                fprintf(self->out, "%s_%s_%s(void *self",
                        self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                k = self->arena->nodes[m].a;
                while (k > 0) {
                    fputs(", ", self->out);
                    if (self->arena->nodes[k].aux == 2
                        || self->arena->nodes[k].aux == 3) {
                        const char *pbuf;
                        pbuf = tool::sh::ct_scratch_fmt("%s *", self->arena->nodes[k].text);
                        if (self->emit_type_name_dims(pbuf, self->arena->nodes[k].text2,
                                                      self->arena->nodes[k].text3) != 0)
                            return -1;
                    } else if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                                         self->arena->nodes[k].text2,
                                                         self->arena->nodes[k].text3) != 0)
                        return -1;
                    k = self->arena->nodes[k].next;
                }
                fputs(") {\n", self->out);
                fprintf(self->out, "    %s *_self = (%s *)self;\n", sname, sname);
                /* SH-102: retain the by-value string parameters at entry. */
                g_sb.method = runtime::text::ct_intern(self->arena->nodes[m].text2);
                g_sb.recv = runtime::text::ct_intern(sname);
                if (!g_sb.method || !g_sb.recv) return self->fail("out of memory");
                sb_push_params(self, self->arena->nodes[m].a, 0);
                sb_retain_params(self, 1);
                self->sym->self_mode = 1;
                /* Phase 44: a postfix `?` in an impl body propagates the
                   method's declared return type. */
                self->cur_ret = runtime::text::ct_intern(mret);
                if (!self->cur_ret) return self->fail("out of memory");
                /* The trait fixes the signature, so an implementation may ignore
                   a parameter. The cast to void has to lead the body: a trailing
                   one would sit after the `return` and be dead code. */
                body = self->arena->nodes[m].b;
                for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next)
                    if (!self->node_mentions(body, self->arena->nodes[k].text2))
                        fprintf(self->out, "    (void)%s;\n", self->arena->nodes[k].text2);
                if (!self->node_mentions(body, "self")) fputs("    (void)_self;\n", self->out);
                /* S1b-S2c: an impl method body is the same statement list the
                   lowerer carries, under its TIR key `<Base>.<method>`; the
                   signature and the `_self` / void-cast prologue stay here. */
                {
                    int (*body_hook)(const char *, void *, int, int, int *, int) = g_body_hook;
                    int printed = 0;
                    if (body_hook) {
                        const char *key = tool::sh::ct_scratch_fmt("%s_%s%s%s",
                                self->sym->structs[si].name, tname,
                                (tname && tname[0]) ? "_" : "",
                                self->arena->nodes[m].text2);
                        int new_ntmp = self->ntmp;
                        int hr = body_hook(key, self->out, 1, self->ntmp,
                                           &new_ntmp, 1);
                        if (hr < 0) { self->sym->self_mode = 0; return -1; }
                        if (hr > 0) { self->ntmp = new_ntmp; printed = 1; }
                    }
                    if (!printed) {
                        k = self->arena->nodes[body].a;
                        while (k >= 0) {
                            if (self->emit_node(k, 1) != 0) {
                                self->sym->self_mode = 0;
                                return -1;
                            }
                            k = self->arena->nodes[k].next;
                        }
                    }
                }
                sb_end_body(self, 1);
                self->sym->self_mode = 0;
                fputs("}\n\n", self->out);
            }
            /* A trait method the impl does not write inherits its default body
               (override priority: the impl's version wins, D-4). */
            if (ti >= 0)
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++) {
                    if (self->sym->traits[ti].m[dm].body < 0) continue;
                    if (impl_writes(self->arena, n, self->sym->traits[ti].m[dm].name)) continue;
                    if (emit_default_method(self, si, sname, ti, dm, n) != 0) return -1;
                }
            if (strcmp(tname, "Drop") != 0 && strcmp(tname, "Handback") != 0) {
                /* a trait nothing dispatches leaves the table unreferenced; an
                   exported one is reachable from the consumer unit instead */
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "const struct %s_vtbl %s_%s_vtable = {\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused)) = {\n",
                            tname, self->sym->structs[si].name, tname);
                u = 0;
                for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                    if (u > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s_%s_%s", self->arena->nodes[m].text2,
                            self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                    u++;
                }
                /* inherited defaults fill the remaining slots */
                if (ti >= 0)
                    for (dm = 0; dm < self->sym->traits[ti].nm; dm++) {
                        if (self->sym->traits[ti].m[dm].body < 0) continue;
                        if (impl_writes(self->arena, n, self->sym->traits[ti].m[dm].name)) continue;
                        if (u > 0) fputs(",\n", self->out);
                        fprintf(self->out, "    .%s = %s_%s_%s", self->sym->traits[ti].m[dm].name,
                                self->sym->structs[si].name, tname, self->sym->traits[ti].m[dm].name);
                        u++;
                    }
                fputs("\n};\n\n", self->out);
            }
        }
        /* P34 S5a: non-generic inherent impl `impl Name { … }` (S4). The block
           has no trait and no vtable; its methods are plain C functions named
           `<Struct>_<method>`. Instance methods take `void *self` and cast it
           to the struct pointer; static methods take no receiver. The body's
           `self.field` (N_MEMBER) is rewritten to `_self->field` by the
           self_mode-aware member emitter below. */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, type_pub;
            const char *sname;
            const char *tag;
            const char *mret;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            if (self->arena->nodes[n].text2[0]) continue;   /* trait impl: above */
            si = self->arena->nodes[n].aux;
            if (si == -1) continue;   /* template impl: emit_struct_impls */
            sname = self->arena->nodes[n].text;
            /* LANG-29 S3 / B2: an ADT impl has no struct row (`aux = -2 - adt`);
               its methods are named and typed by the ADT's C tag just like a
               plain struct's, and its body uses the same `self_mode`. */
            if (si <= -2) {
                struct Adt *adts;
                int nadts;
                int type_adt = -2 - si;
                adts = frontend::sym::ct_adts(&nadts);
                if (!adts || type_adt >= nadts)
                    return self->fail_from(n, "the ADT row is missing");
                tag = adts[type_adt].full;
                type_pub = adts[type_adt].is_pub;
            } else {
                tag = self->sym->structs[si].name;
                type_pub = self->decl_is_pub(N_STRUCT, tag);
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                const char *owner;
                const char *suf;
                int is_static;
                mret = self->arena->nodes[m].text[0] ? self->arena->nodes[m].text : "void";
                is_static = self->arena->nodes[m].c;
                /* D-028: an overloaded name carries the key suffix here, on
                   its closure owner and on the LIR body seam, so the second
                   overload gets its own function and its own body. */
                suf = emit_overload_suffix(self, n, m);
                if (!suf) return self->fail("out of memory");
                owner = runtime::text::ct_internf("%s_%s%s", tag,
                                                  self->arena->nodes[m].text2, suf);
                if (!owner) return self->fail("out of memory");
                if (emit_closures(self, owner, self->arena->nodes[m].line) != 0) return -1;
                self->nclvar = 0;
                self->closure_ci = 0;
                /* P34 S5b: a `pub` struct publishes its methods, so they carry
                   external linkage for importers; a private one stays static. */
                if (!type_pub
                    || self->arena->nodes[m].d != 1)
                    fputs("static __attribute__((unused)) ", self->out);
                fprintf(self->out, "%s %s_%s%s(", mret, tag,
                        self->arena->nodes[m].text2, suf);
                if (!is_static)
                    fprintf(self->out, "struct %s *self", tag);
                k = self->arena->nodes[m].a;
                while (k > 0) {
                    if (!is_static || k != self->arena->nodes[m].a) fputs(", ", self->out);
                    if (self->arena->nodes[k].aux == 2
                        || self->arena->nodes[k].aux == 3) {
                        const char *pbuf;
                        pbuf = tool::sh::ct_scratch_fmt("%s *", self->arena->nodes[k].text);
                        if (self->emit_type_name_dims(pbuf, self->arena->nodes[k].text2,
                                                      self->arena->nodes[k].text3) != 0)
                            return -1;
                    } else if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                                         self->arena->nodes[k].text2,
                                                         self->arena->nodes[k].text3) != 0)
                        return -1;
                    k = self->arena->nodes[k].next;
                }
                fputs(") {\n", self->out);
                if (!is_static)
                    fprintf(self->out, "    %s *_self = (%s *)self;\n", sname, sname);
                /* SH-102: retain the by-value string parameters at entry. */
                g_sb.method = runtime::text::ct_intern(self->arena->nodes[m].text2);
                g_sb.recv = runtime::text::ct_intern(sname);
                if (!g_sb.method || !g_sb.recv) return self->fail("out of memory");
                sb_push_params(self, self->arena->nodes[m].a, 0);
                sb_retain_params(self, 1);
                self->sym->self_mode = is_static ? 0 : 1;
                /* Phase 44: a postfix `?` in an inherent method body
                   propagates the method's declared return type. */
                self->cur_ret = runtime::text::ct_intern(mret);
                if (!self->cur_ret) return self->fail("out of memory");
                body = self->arena->nodes[m].b;
                for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next)
                    if (!self->node_mentions(body, self->arena->nodes[k].text2))
                        fprintf(self->out, "    (void)%s;\n", self->arena->nodes[k].text2);
                if (!is_static && !self->node_mentions(body, "self")) fputs("    (void)_self;\n", self->out);
                /* S1b-S2c: an inherent method body is the same statement list
                   the lowerer carries under `<Struct>_<method>`; the signature
                   and prologue stay here. */
                {
                    int (*body_hook)(const char *, void *, int, int, int *, int) = g_body_hook;
                    int printed = 0;
                    if (body_hook) {
                        const char *key = tool::sh::ct_scratch_fmt("%s_%s%s", tag,
                                self->arena->nodes[m].text2, suf);
                        int new_ntmp = self->ntmp;
                        int hr = body_hook(key, self->out, 1, self->ntmp,
                                           &new_ntmp, 1);
                        if (hr < 0) { self->sym->self_mode = 0; return -1; }
                        if (hr > 0) { self->ntmp = new_ntmp; printed = 1; }
                    }
                    if (!printed) {
                        k = self->arena->nodes[body].a;
                        while (k >= 0) {
                            if (self->emit_node(k, 1) != 0) {
                                self->sym->self_mode = 0;
                                return -1;
                            }
                            k = self->arena->nodes[k].next;
                        }
                    }
                }
                sb_end_body(self, 1);
                self->sym->self_mode = 0;
                fputs("}\n\n", self->out);
            }
        }
        /* D-3: a struct that only `use`s an all-default trait needs no `impl`.
           The slot bodies are expanded here, once per struct, and the `use`
           clause is the sole adoption. A trait with an abstract method in this
           position is still SH-8 (`trait method 'x' is not implemented`). */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, ti, ui, type_index;
            const char *tname;
            const char *stype;
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                ti = self->sym->find_trait(tname);
                if (ti < 0) continue;
                if (impl_exists_anywhere(self->arena, si, tname)) continue;
                if (self->sym->traits[ti].nm == 0) continue;
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++)
                    if (self->sym->traits[ti].m[dm].body < 0) {
                        /* S1a-0 C2n-3: the message names two symbols that
                           can each be 159 bytes; a 160-byte row cut the
                           struct half. Build it run-scoped. */
                        const char *emsg;
                        emsg = tool::sh::ct_scratch_fmt(
                                 "trait method '%s' is not implemented for struct '%s'",
                                 self->sym->traits[ti].m[dm].name, self->sym->structs[si].name);
                        return self->fail_from(n, emsg);
                    }
                type_index = self->sym->find_type(self->sym->structs[si].name);
                if (type_index >= 0 && self->sym->type_kind[type_index] == 1)
                    stype = tool::sh::ct_scratch_fmt("struct %s", self->sym->structs[si].name);
                else
                    stype = tool::sh::ct_scratch_dup(self->sym->structs[si].name);
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++)
                    if (emit_default_method(self, si, stype, ti, dm, n) != 0) return -1;
                if (self->vtable_exported(si, tname))
                    fprintf(self->out, "const struct %s_vtbl %s_%s_vtable = {\n",
                            tname, self->sym->structs[si].name, tname);
                else
                    fprintf(self->out, "static const struct %s_vtbl %s_%s_vtable __attribute__((unused)) = {\n",
                            tname, self->sym->structs[si].name, tname);
                for (dm = 0; dm < self->sym->traits[ti].nm; dm++) {
                    if (dm > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s_%s_%s", self->sym->traits[ti].m[dm].name,
                            self->sym->structs[si].name, tname, self->sym->traits[ti].m[dm].name);
                }
                fputs("\n};\n\n", self->out);
            }
        }
        /* A struct that `use Drop` but writes no impl gets a drop that recurses
           into its Drop-using fields, the same shape L2 generates.
           PH-48 D48-1: a pointer field passes the child object, never its
           address: `if (_self->f) Child_Drop_drop(_self->f);`. The child is not
           freed here -- ownership stays with the explicit Drop body (D48-1).
           PH-48 D48-2: in build mode only the struct's owner unit emits the
           body; consumers call it through the owner's non-static symbol. The
           legacy shapes (compile mode, generic instance rows and a row with no
           owner) keep the old static body so their products stay byte-identical
           (E48-4). */
        {
        int si;
        for (si = 0; si < self->sym->nstructs; si++) {
            int has = 0, fi, used = 0, legacy, host_hidden = 0;
            const char *sname;
            if (!self->sym->structs[si].uses_drop) continue;
            /* P36 S2a2: a template row (`struct Box<T>`) has no concrete C type,
               so no glue is emitted for it; instances carry the flag instead. */
            if (self->sym->structs[si].is_template) continue;
            legacy = (self->cur_unit < 0 || self->sym->structs[si].owner < 0
                      || self->sym->structs[si].is_inst);
            if (!legacy) {
                if (self->sym->structs[si].owner != self->cur_unit) continue;
                /* an explicit impl owns the body; an impl elsewhere is L48-2
                   and the module layer already refused the build */
                if (self->sym->structs[si].has_drop_impl) continue;
            } else {
                has = self->sym->structs[si].has_drop_impl;
                if (!has)
                    for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next)
                        if (self->arena->nodes[n].kind == N_IMPL
                            && self->arena->nodes[n].aux == si
                            && strcmp(self->arena->nodes[n].text2, "Drop") == 0) has = 1;
                if (has) continue;
            }
            /* LANG-27: in build mode every unit carries a static copy of each
               instance's glue (the legacy shape, E48-4). Only the copy in a unit
               that can see the instance's own definition may read its fields;
               elsewhere the host struct is incomplete, so the copy stays an
               empty `(void)_self;` body. Plain structs keep the owner filter
               above and are always visible where their body is written. */
            if (self->sym->structs[si].is_inst && self->cur_unit >= 0) {
                int hi = frontend::sym::ct_inst_find(self->sym->structs[si].name);
                if (hi < 0 || !inst_visible_in_unit(self, hi)) host_hidden = 1;
            }
            sname = self->sym->structs[si].name;
            if (legacy)
                fprintf(self->out,
                        "static void __attribute__((unused)) %s_Drop_drop(void *self) {\n",
                        sname);
            else
                fprintf(self->out, "void %s_Drop_drop(void *self) {\n", sname);
            fprintf(self->out, "    struct %s *_self = (struct %s *)self;\n", sname, sname);
            if (host_hidden) {
                fputs("    (void)_self;\n}\n\n", self->out);
                continue;
            }
            for (fi = 0; fi < self->sym->structs[si].nfields; fi++) {
                const char *base;
                const char *ft = self->sym->structs[si].fields[fi].type;
                int stars = 0;
                const char *q;
                size_t bl;
                int ci;
                /* LANG-27: an instance row keeps the source spelling of a
                   generic field (`Vec<int>`), so resolve it to the concrete
                   `struct Vec_int` before the field is classified. */
                if (strchr(ft, '<')) {
                    const char *sub = sb_norm_text(self, ft);
                    if (sub) ft = sub;
                }
                for (q = ft; *q; q++)
                    if (*q == '*') stars++;
                /* a pointer array has no single child object; leave it to the
                   explicit Drop body */
                if (stars > 0 && self->sym->structs[si].fields[fi].dims[0]) continue;
                /* LANG-27: a by-value built-in container releases its elements
                   through its own `release()` (the per-instance helper keeps
                   the `h == 0` guard for zero handles). A container row does
                   not carry `uses_drop`, so it is named here, in declaration
                   order, instead of falling through to the field branch below.
                   An explicit `impl Drop` already skipped this whole body, so
                   the author still owns it. An array of containers has no
                   single handle and stays with the explicit Drop body. */
                if (stars == 0 && !self->sym->structs[si].fields[fi].dims[0]
                    && frontend::sym::ct_is_container_type(ft)) {
                    const char *cn = strncmp(ft, "struct ", 7) == 0 ? ft + 7 : ft;
                    bl = strlen(cn);
                    while (bl > 0 && (cn[bl - 1] == ' ' || cn[bl - 1] == '\t')) bl--;
                    base = runtime::text::ct_intern_len(cn, (int)bl);
                    if (!base) return self->fail("out of memory");
                    /* A duplicated glue copy in a unit that cannot see the
                       instance's definition stays empty (Phase 33 O3). */
                    ci = frontend::sym::ct_inst_find(base);
                    if (ci < 0 || !inst_visible_in_unit(self, ci)) continue;
                    fprintf(self->out,
                            "    if (_self->%s.h != 0) (void)%s_release(&_self->%s);\n",
                            self->sym->structs[si].fields[fi].name, base,
                            self->sym->structs[si].fields[fi].name);
                    used = 1;
                    continue;
                }
                if (strncmp(ft, "struct ", 7) == 0) ft += 7;
                bl = strlen(ft);
                while (bl > 0 && (ft[bl - 1] == '*' || ft[bl - 1] == ' ')) bl--;
                base = runtime::text::ct_intern_len(ft, (int)bl);
                if (!base) return self->fail("out of memory");
                ci = self->sym->find_struct(base);
                if (ci < 0 || !self->sym->structs[ci].uses_drop) continue;
                if (stars == 1) {
                    fprintf(self->out, "    if (_self->%s) %s_Drop_drop(_self->%s);\n",
                            self->sym->structs[si].fields[fi].name,
                            self->sym->structs[ci].name,
                            self->sym->structs[si].fields[fi].name);
                    used = 1;
                } else if (stars == 0) {
                    fprintf(self->out, "    %s_Drop_drop(&_self->%s);\n",
                            self->sym->structs[ci].name, self->sym->structs[si].fields[fi].name);
                    used = 1;
                }
            }
            if (!used) fputs("    (void)_self;\n", self->out);
            fputs("}\n\n", self->out);
        }
        }
        return 0;
    }

    /* The instance-level wrappers and vtable of every `map` (Phase 11.1). Emitted
       after the prototypes so a bound call may name any top-level function.
       `u` is the unit being emitted in build mode (only its own maps belong in
       its `.c`); `-1` emits every map, which is what compile mode wants. */
    int emit_maps(int u)
    {
        int i, j, k;
        (void)self;

        for (i = 0; i < (*self->nmaps); i++) {
            if (u >= 0 && (*self->maps)[i].unit != u) continue;
            if ((*self->maps)[i].is_static) continue;
            for (j = 0; j < (*self->maps)[i].nb; j++) {
                struct MapBind *b;
                struct MethodSig *sig;
                b = &(*self->maps)[i].b[j];
                sig = &self->sym->traits[b->ti].m[b->mi];
                /* a direct binding fills the slot with the C function itself */
                if (b->direct) continue;
                fprintf(self->out, "static %s %s(void *self", sig->ret, b->wrapper);
                for (k = 0; k < b->nparams; k++) {
                    fputs(", ", self->out);
                    if (sig->pann[k] == 2 || sig->pann[k] == 3) {
                        const char *pbuf;
                        pbuf = tool::sh::ct_scratch_fmt("%s *", sig->ptype[k]);
                        if (self->emit_type_name(pbuf, b->params[k]) != 0) return -1;
                    } else if (self->emit_type_name(sig->ptype[k], b->params[k]) != 0) {
                        return -1;
                    }
                }
                fputs(") {\n", self->out);
                fputs("    (void)self;\n", self->out);
                if (strcmp(sig->ret, "void") != 0)
                    fprintf(self->out, "    return %s;\n", b->call);
                else
                    fprintf(self->out, "    %s;\n", b->call);
                fputs("}\n", self->out);
            }
            if ((*self->maps)[i].nb > 0) {
                /* an instance nothing boxes leaves its table unreferenced; a
                   mapped `pub` global is reachable from every importing unit */
                if (self->map_vtable_exported(i))
                    fprintf(self->out, "const struct %s_vtbl %s = {\n",
                            (*self->maps)[i].trait, (*self->maps)[i].vtable);
                else
                    fprintf(self->out, "static const struct %s_vtbl %s __attribute__((unused)) = {\n",
                            (*self->maps)[i].trait, (*self->maps)[i].vtable);
                for (j = 0; j < (*self->maps)[i].nb; j++) {
                    if (j > 0) fputs(",\n", self->out);
                    fprintf(self->out, "    .%s = %s", (*self->maps)[i].b[j].method,
                            (*self->maps)[i].b[j].direct
                                ? (*self->maps)[i].b[j].call
                                : (*self->maps)[i].b[j].wrapper);
                }
                fputs("\n};\n\n", self->out);
            }
        }
        return 0;
    }

    /* One row of a record body. An anonymous member (`aux == 2`) prints its own
       `struct {` / `union {`, the inner fields one level deeper and its closing
       brace; the caller adds the `;\n`, so the row still reads as one member. */
    int emit_field(int n, int ind)
    {
        int nk;
        (void)self;

        nk = self->arena->nodes[n].kind;

        match ((NodeKind){ .tag = nk }) {
            NodeKind.NK_UNUSED0() => { return self->emit_inline(n); }
            NodeKind.NK_PROG() => { return self->emit_inline(n); }
            NodeKind.NK_PP() => { return self->emit_inline(n); }
            NodeKind.NK_FUNC() => { return self->emit_inline(n); }
            NodeKind.NK_BLOCK() => { return self->emit_inline(n); }
            NodeKind.NK_RET() => { return self->emit_inline(n); }
            NodeKind.NK_EXPR() => { return self->emit_inline(n); }
            NodeKind.NK_CALL() => { return self->emit_inline(n); }
            NodeKind.NK_NUM() => { return self->emit_inline(n); }
            NodeKind.NK_STR() => { return self->emit_inline(n); }
            NodeKind.NK_VAR() => { return self->emit_inline(n); }
            NodeKind.NK_BIN() => { return self->emit_inline(n); }
            NodeKind.NK_DECL() => { return self->emit_inline(n); }
            NodeKind.NK_ASSIGN() => { return self->emit_inline(n); }
            NodeKind.NK_IF() => { return self->emit_inline(n); }
            NodeKind.NK_WHILE() => { return self->emit_inline(n); }
            NodeKind.NK_FOR() => { return self->emit_inline(n); }
            NodeKind.NK_UNARY() => { return self->emit_inline(n); }
            NodeKind.NK_POST() => { return self->emit_inline(n); }
            NodeKind.NK_PARAM() => { return self->emit_inline(n); }
            NodeKind.NK_STRUCT() => { return self->emit_inline(n); }
            NodeKind.NK_TYPEDEF() => { return self->emit_inline(n); }
            NodeKind.NK_GLOBAL() => { return self->emit_inline(n); }
            NodeKind.NK_FIELD() => {
                if (self->arena->nodes[n].aux == 2) return em_field_field_union(self, n, ind, N_FIELD);
                return self->emit_inline(n);
            }
            NodeKind.NK_MEMBER() => { return self->emit_inline(n); }
            NodeKind.NK_ARROW() => { return self->emit_inline(n); }
            NodeKind.NK_INDEX() => { return self->emit_inline(n); }
            NodeKind.NK_ADDR() => { return self->emit_inline(n); }
            NodeKind.NK_DEREF() => { return self->emit_inline(n); }
            NodeKind.NK_METHOD() => { return self->emit_inline(n); }
            NodeKind.NK_MCALL() => { return self->emit_inline(n); }
            NodeKind.NK_RAW() => { return self->emit_inline(n); }
            NodeKind.NK_UNUSED32() => { return self->emit_inline(n); }
            NodeKind.NK_IMPL() => { return self->emit_inline(n); }
            NodeKind.NK_BOX() => { return self->emit_inline(n); }
            NodeKind.NK_CAST() => { return self->emit_inline(n); }
            NodeKind.NK_SIZEOF() => { return self->emit_inline(n); }
            NodeKind.NK_TERN() => { return self->emit_inline(n); }
            NodeKind.NK_BREAK() => { return self->emit_inline(n); }
            NodeKind.NK_CONT() => { return self->emit_inline(n); }
            NodeKind.NK_DECLS() => { return self->emit_inline(n); }
            NodeKind.NK_DELETE() => { return self->emit_inline(n); }
            NodeKind.NK_SWITCH() => { return self->emit_inline(n); }
            NodeKind.NK_CASE() => { return self->emit_inline(n); }
            NodeKind.NK_DOWHILE() => { return self->emit_inline(n); }
            NodeKind.NK_ENUM() => { return self->emit_inline(n); }
            NodeKind.NK_ENUMVAL() => { return self->emit_inline(n); }
            NodeKind.NK_OFFSETOF() => { return self->emit_inline(n); }
            NodeKind.NK_UNION() => { return self->emit_inline(n); }
            NodeKind.NK_LABEL() => { return self->emit_inline(n); }
            NodeKind.NK_GOTO() => { return self->emit_inline(n); }
            NodeKind.NK_COMPOUND() => { return self->emit_inline(n); }
            NodeKind.NK_EMPTY() => { return self->emit_inline(n); }
            NodeKind.NK_VAARG() => { return self->emit_inline(n); }
            NodeKind.NK_FNUM() => { return self->emit_inline(n); }
            NodeKind.NK_SASSERT() => { return self->emit_inline(n); }
            NodeKind.NK_FIELDS() => {
                return em_field_fields(self, n, ind, N_FIELDS);
            }
            NodeKind.NK_PRE() => { return self->emit_inline(n); }
            NodeKind.NK_RAW_TEXT() => { return self->emit_inline(n); }
            NodeKind.NK_CLOSURE() => { return self->emit_inline(n); }
            NodeKind.NK_LOOP() => { return self->emit_inline(n); }
            NodeKind.NK_INIT_RANGE() => { return self->emit_inline(n); }
            NodeKind.NK_FOREACH() => { return self->emit_inline(n); }
            NodeKind.NK_INTO() => { return self->emit_inline(n); }
            NodeKind.NK_INTO_SELF() => { return self->emit_inline(n); }
            NodeKind.NK_INIT_BRACE() => { return self->emit_inline(n); }
            NodeKind.NK_INIT_ITEM() => { return self->emit_inline(n); }
            NodeKind.NK_INIT_MBRACE() => { return self->emit_inline(n); }
            NodeKind.NK_UNUSED68() => { return self->emit_inline(n); }
            NodeKind.NK_DEFER() => { return self->emit_inline(n); }
            NodeKind.NK_DEFER_RUN() => { return self->emit_inline(n); }
            NodeKind.NK_TRY() => { return self->emit_inline(n); }
            NodeKind.NK_OPT() => { return self->emit_inline(n); }
            NodeKind.NK_MATSEQ() => { return self->emit_inline(n); }
            NodeKind.NK_SLICE_INDEX() => { return self->emit_inline(n); }
            NodeKind.NK_SLICE_RANGE() => { return self->emit_inline(n); }
            NodeKind.NK_SLICE_GET() => { return self->emit_inline(n); }
            NodeKind.NK_NEWOBJ() => { return self->emit_inline(n); }
            NodeKind.NK_MATCH() => { return self->emit_inline(n); }
            NodeKind.NK_ARM() => { return self->emit_inline(n); }
            NodeKind.NK_BIND() => { return self->emit_inline(n); }
            NodeKind.NK_ADTCTOR() => { return self->emit_inline(n); }
            NodeKind.NK_ADTFIELD() => { return self->emit_inline(n); }
            NodeKind.NK_ADTMEM() => { return self->emit_inline(n); }
        }
    }

    /* Top-level declarations: struct / typedef / global (with a semicolon as
       appropriate). */
    int emit_type_decl(int n, int ind, int with_semi)
    {
        int nk;
        (void)self;

        nk = self->arena->nodes[n].kind;

        match ((NodeKind){ .tag = nk }) {
            NodeKind.NK_UNUSED0() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_PROG() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_PP() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_FUNC() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_BLOCK() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_RET() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_EXPR() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_CALL() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_NUM() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_STR() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_VAR() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_BIN() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DECL() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ASSIGN() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_IF() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_WHILE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_FOR() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_UNARY() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_POST() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_PARAM() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_STRUCT() => {
                return em_decl_struct(self, n, ind, with_semi, N_STRUCT);
            }
            NodeKind.NK_TYPEDEF() => {
                return em_decl_typedef(self, n, ind, with_semi, N_TYPEDEF);
            }
            NodeKind.NK_GLOBAL() => {
                return em_decl_global(self, n, ind, with_semi, N_GLOBAL);
            }
            NodeKind.NK_FIELD() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_MEMBER() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ARROW() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INDEX() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ADDR() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DEREF() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_METHOD() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_MCALL() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_RAW() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_UNUSED32() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_IMPL() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_BOX() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_CAST() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_SIZEOF() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_TERN() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_BREAK() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_CONT() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DECLS() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DELETE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_SWITCH() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_CASE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DOWHILE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ENUM() => {
                if (self->arena->nodes[n].aux & 2) return em_decl_enum_adt(self, n, ind, with_semi, N_ENUM);
                return em_decl_enum(self, n, ind, with_semi, N_ENUM);
            }
            NodeKind.NK_ENUMVAL() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_OFFSETOF() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_UNION() => {
                return em_decl_union(self, n, ind, with_semi, N_UNION);
            }
            NodeKind.NK_LABEL() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_GOTO() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_COMPOUND() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_EMPTY() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_VAARG() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_FNUM() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_SASSERT() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_FIELDS() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_PRE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_RAW_TEXT() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_CLOSURE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_LOOP() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INIT_RANGE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_FOREACH() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INTO() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INTO_SELF() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INIT_BRACE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INIT_ITEM() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_INIT_MBRACE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_UNUSED68() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DEFER() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_DEFER_RUN() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_TRY() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_OPT() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_MATSEQ() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_SLICE_INDEX() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_SLICE_RANGE() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_SLICE_GET() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_NEWOBJ() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_MATCH() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ARM() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_BIND() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ADTCTOR() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ADTFIELD() => { return self->fail_from(n, "unknown declaration node"); }
            NodeKind.NK_ADTMEM() => { return self->fail_from(n, "unknown declaration node"); }
        }
    }

    /* The header's view of a global: a declaration, never the definition and
       never the initialiser. A `pub` global is defined in its unit's `.c`; an
       `extern` global is defined by the C library the source includes. */
    int emit_global_extern(int n)
    {
        (void)self;

        fputs("extern ", self->out);
        if (self->emit_global_decl(n) != 0) return -1;
        fputs(";\n", self->out);
        return 0;
    }

    /* `<type> <name>[dims]` for a file-scope variable. A namespaced global is
       spelled with the unit's mangled prefix (the same rule `pub` functions
       follow); `extern` keeps the C library's own name. The declarator may also
       be a function pointer, so the name goes through `emit_type_name`. */
    int emit_global_decl(int n)
    {
        const char *cn;
        const char *nm = self->arena->nodes[n].text2;
        (void)self;

        if (self->arena->nodes[n].aux != 2 && self->gprefix && self->gprefix[0]) {
            cn = runtime::text::ct_intern_join(self->gprefix, nm);
            if (!cn) return self->fail("out of memory");
        } else {
            cn = nm;
        }
        if (self->emit_type_name_dims(self->arena->nodes[n].text, cn,
                                      self->arena->nodes[n].text3) != 0) return -1;
        if (self->arena->nodes[n].attr >= 0)
            fprintf(self->out, " %s", self->arena->str_at(self->arena->nodes[n].attr));
        return 0;
    }

    /* A declaration is exported when its node carries `pub`. The arena holds
       every unit's nodes, so the declaring unit need not be the current one --
       a header unit usually is not the implementing unit. */
    int decl_is_pub(int kind, const char *name)
    {
        int n;
        (void)self;

        for (n = 0; n < self->arena->nnode; n++)
            if (self->arena->nodes[n].kind == kind && self->arena->nodes[n].d == 1
                && strcmp(self->arena->nodes[n].text2, name) == 0) return 1;
        return 0;
    }

    /* Linkage rule (D-2): export only when both halves of the pair are public.
       A private struct cannot even be named by a consumer, so its vtable stays
       static and encapsulated. `Drop` never has a vtable. */
    int vtable_exported(int si, const char *tname)
    {
        int t;
        (void)self;

        if (strcmp(tname, "Drop") == 0 || strcmp(tname, "Handback") == 0) return 0;
        t = self->sym->find_trait(tname);
        if (t < 0 || !self->sym->traits[t].is_pub) return 0;
        return self->decl_is_pub(N_STRUCT, self->sym->structs[si].name);
    }

    int map_vtable_exported(int i)
    {
        int t;
        (void)self;

        t = self->sym->find_trait((*self->maps)[i].trait);
        if (t < 0 || !self->sym->traits[t].is_pub) return 0;
        /* a namespace host has no object to be private: `pub trait` is the
           whole contract (SH-20) */
        if ((*self->maps)[i].ns_host) return 1;
        return self->decl_is_pub(N_GLOBAL, (*self->maps)[i].inst);
    }

    /* The header's half of the external-linkage contract: the consumer unit
       boxes with `&S_T_vtable`, so the implementation unit declares it here.
       `u < 0` is compile mode, which writes no header. */
    int emit_link_externs(int prog, int u)
    {
        int n, i, si, any;
        const char *tname;
        (void)self;

        any = 0;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl exports no struct vtable */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no vtable */
            tname = self->arena->nodes[n].text2;
            if (!self->vtable_exported(si, tname)) continue;
            fprintf(self->out, "extern const struct %s_vtbl %s_%s_vtable;\n",
                    tname, self->sym->structs[si].name, tname);
            any = 1;
        }
        /* an all-default adoption exports its vtable under the same rule */
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int ui;
            if (self->arena->nodes[n].kind != N_STRUCT || !self->arena->nodes[n].text2[0]) continue;
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si < 0) continue;
            for (ui = 0; ui < self->sym->structs[si].nuse; ui++) {
                tname = self->sym->structs[si].use[ui];
                if (!adoption_default_only(self, si, tname)) continue;
                if (!self->vtable_exported(si, tname)) continue;
                fprintf(self->out, "extern const struct %s_vtbl %s_%s_vtable;\n",
                        tname, self->sym->structs[si].name, tname);
                any = 1;
            }
        }
        if (u >= 0)
            for (i = 0; i < (*self->nmaps); i++) {
                if ((*self->maps)[i].unit != u) continue;
                if ((*self->maps)[i].is_static) continue;
                if (!self->map_vtable_exported(i)) continue;
                fprintf(self->out, "extern const struct %s_vtbl %s;\n",
                        (*self->maps)[i].trait, (*self->maps)[i].vtable);
                any = 1;
            }
        if (any) fputs("\n", self->out);
        return 0;
    }

    /* P34 S5b: one prototype per inherent method of a `pub` struct. A consumer
       unit may not carry the owner's impl node, so the header exports these
       declarations and every importer links `<Struct>_<method>` by symbol. The
       receiver is spelled `struct <Struct> *` -- the same pointer the definition
       binds `self` to. Private structs keep their methods `static` and get no
       prototype here. */
    int emit_inherent_protos(int prog)
    {
        int n, m, k, si, is_static, adi;
        const char *tagp;

        (void)self;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            if (self->arena->nodes[n].text2[0]) continue;   /* trait impl */
            si = self->arena->nodes[n].aux;
            if (si == -1) continue;   /* template impl */
            /* LANG-29 S3 / B2: a pub enum ADT publishes its inherent methods
               through the same header contract as a pub struct. */
            if (si <= -2) {
                struct Adt *adts;
                int adts_n;
                adi = -2 - si;
                adts = frontend::sym::ct_adts(&adts_n);
                if (!adts || adi >= adts_n) continue;
                if (!adts[adi].is_pub) continue;
                tagp = adts[adi].full;
            } else {
                if (!self->decl_is_pub(N_STRUCT, self->sym->structs[si].name)) continue;
                tagp = self->sym->structs[si].name;
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                const char *suf;
                if (self->arena->nodes[m].d != 1) continue;
                is_static = self->arena->nodes[m].c;
                suf = emit_overload_suffix(self, n, m);
                if (!suf) return self->fail("out of memory");
                fprintf(self->out, "%s %s_%s%s(",
                        self->arena->nodes[m].text[0] ? self->arena->nodes[m].text : "void",
                        tagp, self->arena->nodes[m].text2, suf);
                if (!is_static) fprintf(self->out, "struct %s *", tagp);
                for (k = self->arena->nodes[m].a; k > 0; k = self->arena->nodes[k].next) {
                    if (!is_static || k != self->arena->nodes[m].a) fputs(", ", self->out);
                    if (self->arena->nodes[k].aux == 2
                        || self->arena->nodes[k].aux == 3) {
                        const char *pbuf;
                        pbuf = tool::sh::ct_scratch_fmt("%s *", self->arena->nodes[k].text);
                        if (self->emit_type_name_dims(pbuf, self->arena->nodes[k].text2,
                                                      self->arena->nodes[k].text3) != 0)
                            return -1;
                    } else if (self->emit_type_name_dims(self->arena->nodes[k].text,
                                                         self->arena->nodes[k].text2,
                                                         self->arena->nodes[k].text3) != 0)
                        return -1;
                }
                fputs(");\n", self->out);
            }
        }
        return 0;
    }

    /* Does this subtree name `name` as a variable? An impl parameter is a
       variable too, so the same walk decides the `(void)` casts. Field names
       are stored in `text2` as well but keep their own node kind, so only N_VAR
       matches; the child slots of a body node are all node indexes. */
    int node_mentions(int n, const char *name)
    {
        (void)self;

        for (; n >= 0; n = self->arena->nodes[n].next) {
            /* a TIR metadata copy is not part of the emitted body */
            if (self->arena->nodes[n].kind == N_DEFER_RUN
                && self->arena->nodes[n].aux >= 3) continue;
            if (self->arena->nodes[n].kind == N_VAR && strcmp(self->arena->nodes[n].text2, name) == 0)
                return 1;
            if (self->node_mentions(self->arena->nodes[n].a, name)) return 1;
            if (self->node_mentions(self->arena->nodes[n].b, name)) return 1;
            if (self->node_mentions(self->arena->nodes[n].c, name)) return 1;
            if (self->node_mentions(self->arena->nodes[n].d, name)) return 1;
        }
        return 0;
    }

    int emit_node(int n, int ind)
    {
        int nk;
        (void)self;

        nk = self->arena->nodes[n].kind;

        match ((NodeKind){ .tag = nk }) {
            NodeKind.NK_UNUSED0() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_PROG() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_PP() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_FUNC() => {
                return em_node_func(self, n, ind, N_FUNC);
            }
            NodeKind.NK_BLOCK() => {
                return em_node_block(self, n, ind, N_BLOCK);
            }
            NodeKind.NK_RET() => {
                return em_node_ret(self, n, ind, N_RET);
            }
            NodeKind.NK_EXPR() => {
                if (self->arena->nodes[self->arena->nodes[n].a].kind == N_MATSEQ) return em_node_expr_matseq(self, n, ind, N_EXPR);
                return em_node_expression_statement(self, n, ind, N_EXPR);
            }
            NodeKind.NK_CALL() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_NUM() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_STR() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_VAR() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_BIN() => {
                if (self->arena->nodes[n].aux == B_COMMA) return em_node_expression_statement(self, n, ind, N_BIN);
                return fail_unknown_statement(self, nk);
            }
            NodeKind.NK_DECL() => {
                int r = em_node_decl(self, n, ind, N_DECL);
                if (r != 2) return r;
                return em_node_expression_statement(self, n, ind, N_DECL);
            }
            NodeKind.NK_ASSIGN() => {
                return em_node_expression_statement(self, n, ind, N_ASSIGN);
            }
            NodeKind.NK_IF() => {
                return em_node_if(self, n, ind, N_IF);
            }
            NodeKind.NK_WHILE() => {
                return em_node_while(self, n, ind, N_WHILE);
            }
            NodeKind.NK_FOR() => {
                return em_node_for(self, n, ind, N_FOR);
            }
            NodeKind.NK_UNARY() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_POST() => {
                return em_node_expression_statement(self, n, ind, N_POST);
            }
            NodeKind.NK_PARAM() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_STRUCT() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_TYPEDEF() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_GLOBAL() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_FIELD() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_MEMBER() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_ARROW() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_INDEX() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_ADDR() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_DEREF() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_METHOD() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_MCALL() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_RAW() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_UNUSED32() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_IMPL() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_BOX() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_CAST() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_SIZEOF() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_TERN() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_BREAK() => {
                return em_node_break(self, n, ind, N_BREAK);
            }
            NodeKind.NK_CONT() => {
                return em_node_cont(self, n, ind, N_CONT);
            }
            NodeKind.NK_DECLS() => {
                return em_node_decls(self, n, ind, N_DECLS);
            }
            NodeKind.NK_DELETE() => {
                return em_node_delete(self, n, ind, N_DELETE);
            }
            NodeKind.NK_SWITCH() => {
                return em_node_switch(self, n, ind, N_SWITCH);
            }
            NodeKind.NK_CASE() => {
                return em_node_case(self, n, ind, N_CASE);
            }
            NodeKind.NK_DOWHILE() => {
                return em_node_dowhile(self, n, ind, N_DOWHILE);
            }
            NodeKind.NK_ENUM() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_ENUMVAL() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_OFFSETOF() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_UNION() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_LABEL() => {
                return em_node_label(self, n, ind, N_LABEL);
            }
            NodeKind.NK_GOTO() => {
                return em_node_goto(self, n, ind, N_GOTO);
            }
            NodeKind.NK_COMPOUND() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_EMPTY() => {
                return em_node_empty(self, n, ind, N_EMPTY);
            }
            NodeKind.NK_VAARG() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_FNUM() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_SASSERT() => {
                return em_node_sassert(self, n, ind, N_SASSERT);
            }
            NodeKind.NK_FIELDS() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_PRE() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_RAW_TEXT() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_CLOSURE() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_LOOP() => {
                return em_node_loop(self, n, ind, N_LOOP);
            }
            NodeKind.NK_INIT_RANGE() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_FOREACH() => {
                return em_node_foreach(self, n, ind, N_FOREACH);
            }
            NodeKind.NK_INTO() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_INTO_SELF() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_INIT_BRACE() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_INIT_ITEM() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_INIT_MBRACE() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_UNUSED68() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_DEFER() => {
                return em_node_defer(self, n, ind, N_DEFER);
            }
            NodeKind.NK_DEFER_RUN() => {
                return em_node_defer_run(self, n, ind, N_DEFER_RUN);
            }
            NodeKind.NK_TRY() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_OPT() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_MATSEQ() => {
                return em_node_matseq(self, n, ind, N_MATSEQ);
            }
            NodeKind.NK_SLICE_INDEX() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_SLICE_RANGE() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_SLICE_GET() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_NEWOBJ() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_MATCH() => {
                return em_node_match(self, n, ind, N_MATCH);
            }
            NodeKind.NK_ARM() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_BIND() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_ADTCTOR() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_ADTFIELD() => { return fail_unknown_statement(self, nk); }
            NodeKind.NK_ADTMEM() => { return fail_unknown_statement(self, nk); }
        }
    }

    /* `<type> <name>`, except that a function-pointer type keeps its
       declarator around the name: `int (*)(void *)` + `cb` becomes
       `int (*cb)(void *)` (D-7). The dimensions of a function-pointer array sit
       inside the same declarator (`int (*tbl[2])(int)`), so they are part of
       the name here rather than a suffix; without a `(*)` they trail the name
       exactly as `fputs(text3)` did before (D-5). */
    int emit_type_name_dims(const char *type, const char *name, const char *dims)
    {
        const char *star;
        const char *sub;
        (void)self;

        sub = emit_gsub_type_text(self, type);
        if (sub) {
            type = sub;
        } else if (strchr(type, '<')) {
            /* An instance spelling that reached the emitter without a template
               substitution (a field of a monomorphised struct, say). */
            char *ibuf = (char *)malloc(TEXT_LIMIT);
            if (ibuf && frontend::sym::ct_inst_resolve(type, ibuf, TEXT_LIMIT) == 0) {
                const char *pooled = runtime::text::ct_intern(ibuf);
                if (pooled) type = pooled;
            }
            free(ibuf);
        }
        star = strstr(type, "(*)");
        if (!star) {
            fprintf(self->out, "%s %s%s", type, name, dims);
            return 0;
        }
        fprintf(self->out, "%.*s(*%s%s)%s", (int)(star - type), type, name, dims, star + 3);
        return 0;
    }

    int emit_type_name(const char *type, const char *name)
    {
        return self->emit_type_name_dims(type, name, "");
    }

    int emit_inline(int n)
    {
        int nk;
        (void)self;

        nk = self->arena->nodes[n].kind;

        match ((NodeKind){ .tag = nk }) {
            NodeKind.NK_UNUSED0() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_PROG() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_PP() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_FUNC() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_BLOCK() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_RET() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_EXPR() => {
                return em_inline_expr(self, n, N_EXPR);
            }
            NodeKind.NK_CALL() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_NUM() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_STR() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_VAR() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_BIN() => {
                if (self->arena->nodes[n].aux == B_COMMA) return em_inline_bin_comma(self, n, N_BIN);
                return self->fail_from(n, "cannot inline this node");
            }
            NodeKind.NK_DECL() => {
                return em_inline_decl_field(self, n, N_DECL);
            }
            NodeKind.NK_ASSIGN() => {
                return em_inline_assign(self, n, N_ASSIGN);
            }
            NodeKind.NK_IF() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_WHILE() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_FOR() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_UNARY() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_POST() => {
                return em_inline_post(self, n, N_POST);
            }
            NodeKind.NK_PARAM() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_STRUCT() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_TYPEDEF() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_GLOBAL() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_FIELD() => {
                if (self->arena->nodes[n].aux == 1) return em_inline_field_bitfield(self, n, N_FIELD);
                return em_inline_decl_field(self, n, N_FIELD);
            }
            NodeKind.NK_MEMBER() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ARROW() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_INDEX() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ADDR() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_DEREF() => { return self->fail_from(n, "cannot inline this node"); }
