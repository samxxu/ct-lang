            NodeKind.NK_INIT_BRACE() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_INIT_ITEM() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_INIT_MBRACE() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_UNUSED68() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_DEFER() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_DEFER_RUN() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_TRY() => {
                return em_inline_try(self, n, N_TRY);
            }
            NodeKind.NK_OPT() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_MATSEQ() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_SLICE_INDEX() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_SLICE_RANGE() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_SLICE_GET() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_NEWOBJ() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_MATCH() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ARM() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_BIND() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ADTCTOR() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ADTFIELD() => { return self->fail_from(n, "cannot inline this node"); }
            NodeKind.NK_ADTMEM() => { return self->fail_from(n, "cannot inline this node"); }
        }
    }

    int emit_cond(int n)
    {
        const char *op;
        (void)self;

        if (self->arena->nodes[n].kind == N_BIN && self->arena->nodes[n].aux >= B_LT && self->arena->nodes[n].aux <= B_NE) {
            op = "<";
            if (self->arena->nodes[n].aux == B_GT) op = ">";
            else if (self->arena->nodes[n].aux == B_LE) op = "<=";
            else if (self->arena->nodes[n].aux == B_GE) op = ">=";
            else if (self->arena->nodes[n].aux == B_EQ) op = "==";
            else if (self->arena->nodes[n].aux == B_NE) op = "!=";
            if (self->emit_expr(self->arena->nodes[n].a) != 0) return -1;
            fprintf(self->out, " %s ", op);
            return self->emit_expr(self->arena->nodes[n].b);
        }
        return self->emit_expr(n);
    }

    /* Phase 78 S2: emit one actual whose formal is `ref` / `out`. Taking the
       address of a Vec subscript sugar would be the address of an rvalue; the
       sugar's own `at()` call already answers the element pointer, so it is
       emitted without a second `&`. (A Map element is already a `V *`; the
       source spelling for a place is `*m[k]`, which goes through N_DEREF.) */
    int emit_ref_arg(int n)
    {
        int k;

        if (n < 0) return self->fail("a ref/out argument is missing");
        k = self->arena->nodes[n].kind;
        if (k == N_MCALL
            && (self->arena->nodes[n].aux == 9 || self->arena->nodes[n].aux == 10)
            && self->arena->nodes[n].line > 0 && self->arena->nodes[n].num > 0
            && (strcmp(self->arena->nodes[n].text2, "get") == 0
                || strcmp(self->arena->nodes[n].text2, "at") == 0)
            && (strncmp(self->arena->nodes[n].text, "struct Vec_", 11) == 0
                || strncmp(self->arena->nodes[n].text, "Vec_", 4) == 0)) {
            self->arena->nodes[n].text2 = runtime::text::ct_intern("at");
            if (!self->arena->nodes[n].text2) return self->fail("out of memory");
            return self->emit_expr(n);
        }
        /* Phase 78 fix SH-96: `self` is already the receiver pointer in the
           emitted C (`_self`), so `self.bump(self)` must pass `_self`, not
           `&_self` (which would be `S **`). */
        if (k == N_VAR && self->sym->self_mode
            && strcmp(self->arena->nodes[n].text2, "self") == 0)
            return self->emit_expr(n);
        fputs("&", self->out);
        return self->emit_expr(n);
    }

    /* PH-79 fix SH-100: an array expression where a `T[]` is expected is a
       view. The C storage is the erased `struct __ct_slice`, so the element
       type is not in `want`; the array's own `sizeof` still gives the inferred
       length. The lvalue is repeated for the two `sizeof`s exactly as the
       local-declaration conversion does. A parameter written `T a[]` has
       already decayed to a pointer and carries no length, so it is left to C;
       a slice value (depth 0) passes through untouched. */
    int emit_value_for(const char *want, int n)
    {
        char *t = tool::sh::ct_scratch_alloc(TEXT_LIMIT);
        int d = 0;
        int vi;

        if (want && strcmp(want, "struct __ct_slice") == 0 && n >= 0) {
            if (self->arena->nodes[n].kind == N_VAR) {
                vi = self->sym->find_var(self->arena->nodes[n].text2);
                if (vi >= 0 && self->sym->vars[vi].is_fnparam)
                    return self->emit_expr(n);
            }
            if (hoist_ctype(n, t, TEXT_LIMIT, &d) && d == 1) {
                fputs("(struct __ct_slice){ (void *)(", self->out);
                if (self->emit_expr(n) != 0) return -1;
                fputs("), (int)(sizeof(", self->out);
                if (self->emit_expr(n) != 0) return -1;
                fputs(") / sizeof((", self->out);
                if (self->emit_expr(n) != 0) return -1;
                fputs(")[0])) }", self->out);
                return 0;
            }
        }
        return self->emit_expr(n);
    }

    int emit_outconv(int n)
    {
        int i, rid;
        const char *ret;
        const char *rt;

        ret = "";
        for (i = 0; i < self->arena->noutconv; i++)
            if (self->arena->outconv[i].call == n && !ret[0]) {
                ret = self->arena->outconv[i].ret;
                if (!ret) ret = "";
            }
        /* the temporary declarations and the forward conversions run first, in
           argument order; the call sees `&temp` for each converted actual */
        fputs("({ ", self->out);
        for (i = 0; i < self->arena->noutconv; i++) {
            if (self->arena->outconv[i].call != n) continue;
            fprintf(self->out, "%s %s = ", self->arena->outconv[i].formal,
                    self->arena->nodes[self->arena->outconv[i].temp].text2);
            if (self->emit_expr(self->arena->outconv[i].fwd) != 0) return -1;
            fputs("; ", self->out);
        }
        /* a value the caller uses survives the write-back through a result
           temporary; a void call needs none */
        rt = ret;
        {
            const char *retsub = emit_gsub_type_text(self, ret);
            if (retsub) rt = retsub;
        }
        rid = -1;
        if (ret[0] && strcmp(ret, "void") != 0) {
            rid = self->ntmp;
            self->ntmp++;
            fprintf(self->out, "%s __ct_outret%d = ", rt, rid);
        }
        {
            int save_bypass = g_oc_bypass_node;
            g_oc_bypass_node = n;
            if (self->emit_expr(n) != 0) {
                g_oc_bypass_node = save_bypass;
                return -1;
            }
            g_oc_bypass_node = save_bypass;
        }
        fputs("; ", self->out);
        /* every converted actual is written back after the call, on every
           return path: the L1 rule already guarantees the callee assigned it */
        for (i = 0; i < self->arena->noutconv; i++) {
            if (self->arena->outconv[i].call != n) continue;
            if (self->emit_expr(self->arena->outconv[i].writeback) != 0) return -1;
            fputs("; ", self->out);
        }
        if (rid >= 0) fprintf(self->out, "__ct_outret%d; ", rid);
        fputs("})", self->out);
        return 0;
    }

    int emit_expr(int n)
    {
        int nk;
        (void)self;

        /* LANG-26: a call with a converted `out` actual is one statement
           expression; the bypass flag keeps the inner call from re-entering. */
        if (n != g_oc_bypass_node && self->arena->noutconv > 0) {
            int oi;
            for (oi = 0; oi < self->arena->noutconv; oi++)
                if (self->arena->outconv[oi].call == n)
                    return self->emit_outconv(n);
        }
        nk = self->arena->nodes[n].kind;

        match ((NodeKind){ .tag = nk }) {
            NodeKind.NK_UNUSED0() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_PROG() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_PP() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_FUNC() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_BLOCK() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_RET() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_EXPR() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_CALL() => {
                return em_expr_call(self, n, N_CALL);
            }
            NodeKind.NK_NUM() => {
                return em_expr_num(self, n, N_NUM);
            }
            NodeKind.NK_STR() => {
                return em_expr_str(self, n, N_STR);
            }
            NodeKind.NK_VAR() => {
                return em_expr_var(self, n, N_VAR);
            }
            NodeKind.NK_BIN() => {
                if (self->arena->nodes[n].aux == B_COMMA) return em_expr_bin_comma(self, n, N_BIN);
                return em_expr_bin(self, n, N_BIN);
            }
            NodeKind.NK_DECL() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_ASSIGN() => {
                return em_expr_assign(self, n, N_ASSIGN);
            }
            NodeKind.NK_IF() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_WHILE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_FOR() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_UNARY() => {
                return em_expr_unary(self, n, N_UNARY);
            }
            NodeKind.NK_POST() => {
                return em_expr_post(self, n, N_POST);
            }
            NodeKind.NK_PARAM() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_STRUCT() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_TYPEDEF() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_GLOBAL() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_FIELD() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_MEMBER() => {
                return em_expr_member(self, n, N_MEMBER);
            }
            NodeKind.NK_ARROW() => {
                return em_expr_arrow(self, n, N_ARROW);
            }
            NodeKind.NK_INDEX() => {
                return em_expr_index(self, n, N_INDEX);
            }
            NodeKind.NK_ADDR() => {
                return em_expr_addr(self, n, N_ADDR);
            }
            NodeKind.NK_DEREF() => {
                return em_expr_deref(self, n, N_DEREF);
            }
            NodeKind.NK_METHOD() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_MCALL() => {
                return em_expr_mcall(self, n, N_MCALL);
            }
            NodeKind.NK_RAW() => {
                return em_expr_raw(self, n, N_RAW);
            }
            NodeKind.NK_UNUSED32() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_IMPL() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_BOX() => {
                return em_expr_box(self, n, N_BOX);
            }
            NodeKind.NK_CAST() => {
                return em_expr_cast(self, n, N_CAST);
            }
            NodeKind.NK_SIZEOF() => {
                return em_expr_sizeof(self, n, N_SIZEOF);
            }
            NodeKind.NK_TERN() => {
                return em_expr_tern(self, n, N_TERN);
            }
            NodeKind.NK_BREAK() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_CONT() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_DECLS() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_DELETE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_SWITCH() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_CASE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_DOWHILE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_ENUM() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_ENUMVAL() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_OFFSETOF() => {
                return em_expr_offsetof(self, n, N_OFFSETOF);
            }
            NodeKind.NK_UNION() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_LABEL() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_GOTO() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_COMPOUND() => {
                return em_expr_compound(self, n, N_COMPOUND);
            }
            NodeKind.NK_EMPTY() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_VAARG() => {
                return em_expr_vaarg(self, n, N_VAARG);
            }
            NodeKind.NK_FNUM() => {
                return em_expr_fnum(self, n, N_FNUM);
            }
            NodeKind.NK_SASSERT() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_FIELDS() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_PRE() => {
                return em_expr_pre(self, n, N_PRE);
            }
            NodeKind.NK_RAW_TEXT() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_CLOSURE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_LOOP() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_INIT_RANGE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_FOREACH() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_INTO() => {
                return em_expr_into(self, n, N_INTO);
            }
            NodeKind.NK_INTO_SELF() => {
                return em_expr_into_self(self, n, N_INTO_SELF);
            }
            NodeKind.NK_INIT_BRACE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_INIT_ITEM() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_INIT_MBRACE() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_UNUSED68() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_DEFER() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_DEFER_RUN() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_TRY() => {
                return em_expr_try(self, n, N_TRY);
            }
            NodeKind.NK_OPT() => {
                return em_expr_opt(self, n, N_OPT);
            }
            NodeKind.NK_MATSEQ() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_SLICE_INDEX() => {
                return em_expr_slice_index(self, n, N_SLICE_INDEX);
            }
            NodeKind.NK_SLICE_RANGE() => {
                return em_expr_slice_range(self, n, N_SLICE_RANGE);
            }
            NodeKind.NK_SLICE_GET() => {
                return em_expr_slice_get(self, n, N_SLICE_GET);
            }
            NodeKind.NK_NEWOBJ() => {
                return em_expr_newobj(self, n, N_NEWOBJ);
            }
            NodeKind.NK_MATCH() => {
                return match_expr_emit(self, n);
            }
            NodeKind.NK_ARM() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_BIND() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_ADTCTOR() => {
                return em_expr_adtctor(self, n, N_ADTCTOR);
            }
            NodeKind.NK_ADTFIELD() => { return self->fail_from(n, "unknown expression node"); }
            NodeKind.NK_ADTMEM() => { return self->fail_from(n, "unknown expression node"); }
        }
    }

    /* `foo` -> `FOO_H`; a leading digit gets an underscore so the guard is a
       valid identifier. */
    /* S1a-0 C2l: the guard is a run-scoped block sized from the name, not a
       `char[MAX_PATH]` argument; a long header name is no longer a failure. */
    int header_guard(const char *base, char **out)
    {
        size_t n, i, m;
        char *buf;
        (void)self;

        n = strlen(base);
        buf = tool::sh::ct_scratch_alloc((int)n + 6);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            buf[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            buf[m] = c;
            m++;
        }
        buf[m] = '_';
        buf[m + 1] = 'H';
        buf[m + 2] = 0;
        *out = buf;
        return 0;
    }

    /* Build mode: one `.c` per unit. It includes its own header (so the `pub`
       declarations are visible exactly once) and the headers of its imports.
       The body runs with the sink open; on failure the file is closed before it
       is dropped, so the unlink does not strand the buffer in a dead inode. */
    int emit_unit(int u)
    {
        if (self->no_write) return 0;
        char *path;
        FILE *f;
        int rc;
        (void)self;

        self->errmsg = "";
        self->failline = 0;
        self->gprefix = self->units[u].nsprefix;
        path = tool::sh::ct_scratch_fmt("%s/%s.c", *self->outdir, self->units[u].base);
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the output file");
        self->out = f;
        self->path = self->units[u].path;
        self->cur_unit = u;
        rc = emit_unit_body(self, u);
        if (fclose(f) != 0 && rc == 0) rc = self->fail("cannot write the output file");
        return rc;
    }

    /* Build mode: the unit's exported surface (D34 fixes the naming rules, not
       the wording of the header). */
    int write_unit_header(int u)
    {
        if (self->no_write) return 0;
        char *path;
        char *guard;
        FILE *f;
        int rc;
        (void)self;

        self->gprefix = self->units[u].nsprefix;
        /* SH-120: the `String` unit's header would be `String.h`, which a
           case-insensitive filesystem resolves for every `#include
           <string.h>` once the output directory is on the include path. The
           C unit stays `String.c` (the acceptance name); only its header is
           `String_.h`, so libc's `string.h` is always the real one. */
        {
            const char *hb = strcmp(self->units[u].base, "String") == 0
                             ? "String_" : self->units[u].base;
            path = tool::sh::ct_scratch_fmt("%s/%s.h", *self->outdir, hb);
            if (self->header_guard(hb, &guard) != 0) return -1;
        }
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        self->out = f;
        self->path = self->units[u].path;
        rc = write_unit_header_body(self, u, guard);
        if (fclose(f) != 0 && rc == 0) rc = self->fail("cannot write the header");
        return rc;
    }

    /* JSON string body (no surrounding quotes). */
    int emit_json_str(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
        return 0;
    }

    /* `--emit-map`: the published JSON shape (compiler / file / traits /
       structs / functions / impls / calls). `u < 0` means compile mode, where
       the tables cover the single unit. */
    /* PH-59 M1: the language-neutral declaration model. Deliberately narrower
       than the map: struct/union fields, enum members and function signatures.
       `visibility` stays `unknown` until LANG-9 lands; `loc` carries file+line
       (LANG-10 7c's column is the documented degradation). */
    int write_model(const char *dest, int prog)
    {
        if (self->no_write) return 0;
        FILE *f;
        const char *path;
        int n, i, j, first;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the model");
        }
        path = self->path;
        fputs("{\n  \"schema\": \"ct.model\",\n  \"schema_version\": 1,\n", f);
        fputs("  \"compiler\": \"ct v", f);
        self->emit_json_str(f, self->version);
        fputs("\",\n  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n  \"structs\": [", f);

        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int si, bi, bn, skip = 0;
            if (self->arena->nodes[n].kind != N_STRUCT
                && self->arena->nodes[n].kind != N_UNION) continue;
            for (bi = 0; bi < self->nbuiltin && !skip; bi++) {
                int bu = self->builtins[bi];
                if (bu < 0 || bu >= *self->nunits) continue;
                for (bn = self->arena->nodes[self->units[bu].prog].a; bn >= 0;
                     bn = self->arena->nodes[bn].next)
                    if (bn == n) { skip = 1; break; }
            }
            if (skip) continue;
            if (strcmp(self->arena->nodes[n].text2, "ct_buf") == 0
                || strcmp(self->arena->nodes[n].text2, "Vec") == 0
                || strcmp(self->arena->nodes[n].text2, "Map") == 0
                || strcmp(self->arena->nodes[n].text2, "MapEntry") == 0
                || strcmp(self->arena->nodes[n].text2, "Option") == 0
                || strcmp(self->arena->nodes[n].text2, "Result") == 0
                || strcmp(self->arena->nodes[n].text2, "Str") == 0) continue;
            if (!first) fputc(',', f);
            fputs("{\"kind\":\"", f);
            fputs(self->arena->nodes[n].kind == N_UNION ? "union" : "struct", f);
            fputs("\",\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"fields\":[", self->arena->nodes[n].line);
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < self->sym->structs[si].nfields; i++) {
                    if (i > 0) fputc(',', f);
                    fputs("{\"name\":\"", f);
                    self->emit_json_str(f, self->sym->structs[si].fields[i].name);
                    fputs("\",\"type\":\"", f);
                    self->emit_json_str(f, self->sym->structs[si].fields[i].type);
                    fputs("\",\"visibility\":\"unknown\",\"loc\":{\"file\":\"", f);
                    self->emit_json_str(f, path);
                    fprintf(f, "\",\"line\":%d,\"col\":%d}}",
                            self->sym->structs[si].fields[i].line,
                            self->sym->structs[si].fields[i].col);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n  \"enums\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            int m, bi, bn, skip = 0;
            if (self->arena->nodes[n].kind != N_ENUM) continue;
            /* Phase 84: the model's `enums` list stays C enums; an ADT's layout
               is documented in the spec, not in this export. */
            if (self->arena->nodes[n].aux & 2) continue;
            for (bi = 0; bi < self->nbuiltin && !skip; bi++) {
                int bu = self->builtins[bi];
                if (bu < 0 || bu >= *self->nunits) continue;
                for (bn = self->arena->nodes[self->units[bu].prog].a; bn >= 0;
                     bn = self->arena->nodes[bn].next)
                    if (bn == n) { skip = 1; break; }
            }
            if (skip) continue;
            if (!first) fputc(',', f);
            fputs("{\"kind\":\"enum\",\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"members\":[", self->arena->nodes[n].line);
            for (m = self->arena->nodes[n].a, i = 0; m >= 0; m = self->arena->nodes[m].next, i++) {
                int val = 0;
                if (i > 0) fputc(',', f);
                if (self->arena->nodes[m].a >= 0
                    && self->arena->nodes[self->arena->nodes[m].a].kind == N_NUM)
                    val = (int)self->arena->nodes[self->arena->nodes[m].a].num;
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text2);
                fprintf(f, "\",\"value\":%d}", val);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n  \"functions\": [", f);
        first = 1;
        for (i = 0; i < self->sym->nfunc; i++) {
            if (strncmp(self->sym->funcs[i].name, "str_", 4) == 0
                || strncmp(self->sym->funcs[i].name, "vec_", 4) == 0
                || strncmp(self->sym->funcs[i].name, "map_", 4) == 0
                || strncmp(self->sym->funcs[i].name, "option_", 7) == 0
                || strncmp(self->sym->funcs[i].name, "result_", 7) == 0) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].cname);
            fputs("\",\"visibility\":\"unknown\",\"returns\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].ret);
            fprintf(f, "\",\"line\":%d,\"params\":[", self->sym->funcs[i].line);
            for (j = 0; j < self->sym->funcs[i].nparams; j++) {
                if (j > 0) fputc(',', f);
                fputs("{\"type\":\"", f);
                self->emit_json_str(f, self->sym->funcs[i].ptype[j]);
                fputs("\"}", f);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("]\n}\n", f);
        if (f != stdout && fclose(f) != 0) return self->fail("cannot write the model");
        return 0;
    }

    int write_map(const char *dest, int prog, int u)
    {
        if (self->no_write) return 0;
        FILE *f;
        const char *path;
        int trs, tre, fns, fne, cls, cle;
        int i, j, m, n, first, si, count;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the map");
        }
        if (u >= 0) {
            path = self->units[u].path;
            trs = self->units[u].tr_start;
            tre = self->units[u].tr_end;
            fns = self->units[u].fn_start;
            fne = self->units[u].fn_end;
            cls = self->units[u].call_start;
            cle = self->units[u].call_end;
        } else {
            path = self->path;
            trs = 0;
            tre = self->sym->ntraits;
            fns = 0;
            fne = self->sym->nfunc;
            cls = 0;
            cle = (*self->ncalls);
        }

        fputs("{\n", f);
        fprintf(f, "  \"compiler\": \"ct v%s\",\n", self->version);
        fputs("  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n", f);

        fputs("  \"traits\": [", f);
        first = 1;
        for (i = trs; i < tre; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->traits[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->sym->traits[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"methods\":[", self->sym->traits[i].line);
            for (m = 0; m < self->sym->traits[i].nm; m++) {
                if (m > 0) fputc(',', f);
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, self->sym->traits[i].m[m].name);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->sym->traits[i].m[m].ret);
                fprintf(f, "\",\"params\":%d}", self->sym->traits[i].m[m].nparams);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"structs\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            if (self->arena->nodes[n].kind != N_STRUCT) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, self->arena->nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"uses\":[", self->arena->nodes[n].line);
            si = self->sym->find_struct(self->arena->nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < self->sym->structs[si].nuse; i++) {
                    if (i > 0) fputc(',', f);
                    fputc('"', f);
                    self->emit_json_str(f, self->sym->structs[si].use[i]);
                    fputc('"', f);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"functions\": [", f);
        first = 1;
        for (i = fns; i < fne; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, self->sym->funcs[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"ret\":\"", self->sym->funcs[i].line);
            self->emit_json_str(f, self->sym->funcs[i].ret);
            fprintf(f, "\",\"params\":%d}", self->sym->funcs[i].nparams);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"impls\": [", f);
        first = 1;
        for (n = self->arena->nodes[prog].a; n >= 0; n = self->arena->nodes[n].next) {
            const char *tname;
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            si = self->arena->nodes[n].aux;
            if (si < 0) continue;   /* a template impl has no single struct symbol */
            if (!self->arena->nodes[n].text2[0]) continue;   /* P34 S4: inherent, no trait */
            tname = self->arena->nodes[n].text2;
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                if (!first) fputc(',', f);
                fputs("{\"struct\":\"", f);
                self->emit_json_str(f, self->sym->structs[si].name);
                fputs("\",\"trait\":\"", f);
                self->emit_json_str(f, tname);
                fputs("\",\"method\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text2);
                fputs("\",\"symbol\":\"", f);
                fprintf(f, "%s_%s_%s", self->sym->structs[si].name, tname, self->arena->nodes[m].text2);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, self->arena->nodes[m].text);
                count = 0;
                for (i = self->arena->nodes[m].a; i > 0; i = self->arena->nodes[i].next) count++;
                fprintf(f, "\",\"params\":%d,\"file\":\"", count);
                self->emit_json_str(f, path);
                fprintf(f, "\",\"line\":%d}", self->arena->nodes[n].line);
                first = 0;
            }
        }
        fputs("],\n", f);

        fputs("  \"calls\": [", f);
        for (i = cls; i < cle; i++) {
            if (i > cls) fputc(',', f);
            fputs("{\"caller\":\"", f);
            self->emit_json_str(f, (*self->calls)[i].caller);
            fputs("\",\"callee\":\"", f);
            self->emit_json_str(f, (*self->calls)[i].callee);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", (*self->calls)[i].line);
        }
        fputs("],\n", f);

        fputs("  \"maps\": [", f);
        first = 1;
        for (i = 0; i < (*self->nmaps); i++) {
            /* LANG-29 S4 / B4: a `map binding` is a conversion registry entry,
               not a trait map; the `--emit-map` contract stays the Phase 11
               shape (its own reporting is out of the B4 slice). */
            if ((*self->maps)[i].is_binding) continue;
            if (!first) fputc(',', f);
            first = 0;
            fputs("{\"trait\":\"", f);
            self->emit_json_str(f, (*self->maps)[i].trait);
            if ((*self->maps)[i].is_static) {
                int su = (*self->maps)[i].unit;
                fputs("\",\"static\":true", f);
                /* A mapping unit's shim is part of that map's definition, so the
                   JSON names the files a consumer build has to carry. */
                if (self->units && su >= 0 && su < *self->nunits
                    && self->units[su].has_shim) {
                    fputs(",\"shim\":{\"header\":\"", f);
                    self->emit_json_str(f, self->units[su].shim_h);
                    if (self->units[su].shim_c) {
                        fputs("\",\"source\":\"", f);
                        self->emit_json_str(f, self->units[su].shim_c);
                    }
                    fputs("\"}", f);
                }
                fputs(",\"instance\":\"", f);
            } else {
                fputs("\",\"instance\":\"", f);
            }
            self->emit_json_str(f, (*self->maps)[i].inst);
            fputs("\",\"host\":\"", f);
            if ((*self->maps)[i].type_host) fputs("type", f);
            else fputs((*self->maps)[i].ns_host ? "namespace" : "instance", f);
            if ((*self->maps)[i].type_host) {
                fputs("\",\"type\":\"", f);
                self->emit_json_str(f, (*self->maps)[i].host_type);
            }
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"bindings\":[", (*self->maps)[i].line);
            for (j = 0; j < (*self->maps)[i].nb; j++) {
                if (j > 0) fputc(',', f);
                fputs("{\"method\":\"", f);
                self->emit_json_str(f, (*self->maps)[i].b[j].method);
                fputs("\",\"symbol\":\"", f);
                if ((*self->maps)[i].is_static) {
                    const char *callee;
                    callee = map_recipe_callee_text((*self->maps)[i].b[j].call);
                    if (!callee) return self->fail("out of memory");
                    self->emit_json_str(f, callee);
                } else {
                    self->emit_json_str(f, (*self->maps)[i].b[j].direct
                                              ? (*self->maps)[i].b[j].call
                                              : (*self->maps)[i].b[j].wrapper);
                }
                if ((*self->maps)[i].is_static)
                    fputs("\",\"wrapper\":false,\"inline\":true}", f);
                else
                    fprintf(f, "\",\"wrapper\":%s}",
                            (*self->maps)[i].b[j].direct ? "false" : "true");
            }
            fputs("]}", f);
        }
        fputs("]\n", f);
        fputs("}\n", f);

        if (f != stdout) {
            if (fclose(f) != 0) return self->fail("cannot write the map");
        }
        return 0;
    }

    /* Compile mode: a placeholder header (types only; the .c is self-contained). */
    /* Phase 39 R3: the ABI header is a separate artefact. It contains only
       the root unit's C-compatible pub functions, the ABI version/hash and the
       opaque forwards they need; the module `.h` contract is untouched. */
    int write_abi_header(const char *path)
    {
        int i, j, k, n, ns, root, fi;
        int order[256];
        char *upper;
        const char *fwd[64];
        unsigned long h;
        FILE *f;

        (void)self;
        if (!self->abi_root || !self->abi_exports || !self->abi_n)
            return self->fail("ABI tables are not bound");
        root = *self->abi_root;
        if (root < 0 || root >= *self->nunits) return self->fail("bad ABI root unit");
        upper = tool::sh::ct_scratch_alloc((int)strlen(self->units[root].base) + 1);
        {
            const char *ub = self->units[root].base;
            size_t ul = strlen(ub);
            for (i = 0; i < (int)ul; i++) {
                char c = ub[i];
                if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
                else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
                upper[i] = c;
            }
            upper[ul] = 0;
        }
        for (i = 0; upper[i]; i++) {
            char c = upper[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            upper[i] = c;
        }
        n = *self->abi_n;
        if (n > 256) n = 256;
        for (i = 0; i < n; i++) order[i] = self->abi_exports[i];
        /* Stable, deterministic order: C symbol name. */
        for (i = 0; i < n; i++)
            for (j = i + 1; j < n; j++)
                if (strcmp(self->sym->funcs[order[i]].cname,
                           self->sym->funcs[order[j]].cname) > 0) {
                    k = order[i]; order[i] = order[j]; order[j] = k;
                }
        h = 2166136261UL;
        for (i = 0; i < n; i++) {
            const char *s = self->sym->funcs[order[i]].cname;
            while (*s) {
                h = (h ^ (unsigned char)*s) * 16777619UL;
                h = h & 0xffffffffUL;
                s++;
            }
        }
        f = fopen(path, "wb");
        if (!f) return self->fail("cannot write the ABI header");
        fprintf(f, "/* Generated by ct v%s from %s -- ABI surface; do not edit. */\n",
                self->version, self->path);
        fputs("/* Only the declarations in this file are ABI; the archive nm surface may be larger. */\n", f);
        fprintf(f, "#ifndef %s_ABI_H\n#define %s_ABI_H\n\n", upper, upper);
        fprintf(f, "#define %s_ABI_VERSION 1\n", upper);
        fprintf(f, "#define %s_ABI_HASH 0x%08lx\n\n", upper, h);
        /* Opaque forwards for named structs used by the exported signatures. */
        ns = 0;
        for (i = 0; i < n; i++) {
            int p;
            for (p = -1; p < self->sym->funcs[order[i]].nparams; p++) {
                const char *tp = p < 0 ? self->sym->funcs[order[i]].ret
                                       : self->sym->funcs[order[i]].ptype[p];
                const char *nm;
                int q = 0;
                /* REQ-ABI-3/4: struct, union and enum parameters all need a
                   tag forward declaration in the exported header. */
                if (strncmp(tp, "struct ", 7) == 0) {
                    nm = runtime::text::ct_internf("struct %s", tp + 7);
                } else if (strncmp(tp, "union ", 6) == 0) {
                    nm = runtime::text::ct_internf("union %s", tp + 6);
                } else if (strncmp(tp, "enum ", 5) == 0) {
                    nm = runtime::text::ct_internf("enum %s", tp + 5);
                } else {
                    continue;
                }
                if (!nm) return self->fail("out of memory");
                /* keep only the tag spelling (drop trailing stars/space) */
                q = (int)strlen(nm);
                while (q > 0 && !(isalnum((unsigned char)nm[q - 1]) || nm[q - 1] == '_')) q--;
                if (!q) continue;
                nm = runtime::text::ct_intern_len(nm, q);
                if (!nm) return self->fail("out of memory");
                for (j = 0; j < ns; j++) if (strcmp(fwd[j], nm) == 0) break;
                if (j == ns && ns < 64) fwd[ns++] = nm;
            }
        }
        for (i = 0; i < ns; i++)
            for (j = i + 1; j < ns; j++)
                if (strcmp(fwd[i], fwd[j]) > 0) {
                    const char *tmp = fwd[i];
                    fwd[i] = fwd[j];
                    fwd[j] = tmp;
                }
        for (i = 0; i < ns; i++) fprintf(f, "%s;\n", fwd[i]);
        if (ns > 0) fputs("\n", f);
        for (i = 0; i < n; i++) {
            fi = order[i];
            fprintf(f, "%s %s(", self->sym->funcs[fi].ret, self->sym->funcs[fi].cname);
            if (self->sym->funcs[fi].nparams == 0) fputs("void", f);
            for (j = 0; j < self->sym->funcs[fi].nparams; j++) {
                if (j > 0) fputs(", ", f);
                fputs(self->sym->funcs[fi].ptype[j], f);
                /* Phase 78 S2: the ABI surface spells a ref/out parameter as
                   the pointer the definition actually takes. */
                if (self->sym->funcs[fi].pann[j] == 2
                    || self->sym->funcs[fi].pann[j] == 3)
                    fputs(" *", f);
            }
            fputs(");\n", f);
        }
        fputs("\n#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot close the ABI header");
        return 0;
    }

    int write_header(const char *outc)
    {
        if (self->no_write) return 0;
        char *path;
        if (self->abi_mode && *self->abi_mode)
            return self->write_abi_header(outc);
        char *base;
        char *guard;
        const char *name;
        FILE *f;
        size_t n;

        (void)self;
        /* S1a-0 C2l: the compile-mode `-o` becomes a run-scoped block; the
           `.c` -> `.h` spelling and the header guard are derived from it. */
        path = tool::sh::ct_scratch_dup(outc);
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        base = tool::sh::ct_scratch_dup(name);
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        if (self->header_guard(base, &guard) != 0) return -1;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                self->version, self->path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }


    /* SH-111 I1/I2/I3: walk one cleanup edge. The edge is a statement chain in
       the jump node's `b` slot (or the `?` side table). Only releases and
       materialised deferred bodies may appear; all deferred bodies precede all
       releases; a normal exit carries no `errdefer`. `at` is the node blamed. */
    /* SH-111: one pre-emission walk over the statement/expression tree. Every
       invariant is a condition the emitter already relies on; the walk only
       turns a silent bad product into a positioned diagnostic. */
    /* SH-111: the test seam for the invariants themselves. A program the
       parser accepts cannot break them, so the gate injects one concrete AST
       fault here (only when the environment variable is set) and lets the
       independent walk report it. Production runs leave the variable unset. */
    /* SH-111 I4: every hoisted receiver (method-chain level, `into` receiver,
       optional receiver) has one distinct temporary name by the time the
       declarations are written. Runs inside `emit_hoists`, after the scan has
       named the nodes and before any output. */
    /* A failure is recorded without a position; the driver's facade wraps the
       first message with the current line and token. */
    int fail(const char *msg)
    {
        (void)self;
        if (!self->errmsg[0]) {
            /* S1a-0 C2n-3: the message can name a 159-byte trait plus a
               159-byte struct plus the method, so a 160-byte row cut it. The
               pool holds one message per run (the emitter stops at the first
               failure), so this does not grow with output. */
            self->errmsg = runtime::text::ct_intern(msg);
            if (!self->errmsg) self->errmsg = "out of memory";
        }
        return -1;
    }

    /* The failure is about a source node, so its line is the position to report.
       The lexer is useless here: parsing finished long before emission. */
    int fail_from(int n, const char *msg)
    {
        (void)self;
        if (n >= 0 && !self->errmsg[0]) self->failline = self->arena->nodes[n].line;
        return self->fail(msg);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Emitter g_emit;

/* Only primitives cross the unit boundary. Every pointer to another unit's
   type goes in as `void *` and is cast here, because a generated header carries
   no #include and a prototype that named `struct Symbols *` would
   scope a fresh, incompatible type. The bind calls are split so no signature
   exceeds MAX_PARAMS. */
pub void ct_emit_bind(void *arena, void *sym, void *ty, void *lex, const char *version, char **outdir, const char *prog);
void ct_emit_bind(void *arena, void *sym, void *ty, void *lex,
                  const char *version, char **outdir, const char *prog)
{
    g_emit.arena = (struct Arena *)arena;
    g_emit.sym = (struct Symbols *)sym;
    g_emit.ty = (struct TypeCheck *)ty;
    g_emit.lex = (struct Lexer *)lex;
    g_emit.version = version;
    g_emit.outdir = outdir;
    g_emit.prog = prog;
    /* the vptr writer follows the emitter's output stream, which changes per
       unit, so it holds the address of the field rather than a copy */
    ct_init_bind(sym, (void **)&g_emit.out);
    g_emit.init = init_get();
    /* S1a-0 C2n-3: an unset pool text reads as the empty string, so the
       `text[0]` / `strcmp(text, "void")` readers keep their meaning. */
    g_emit.errmsg = "";
    g_emit.cur_ret = "";
    g_emit.gtname = "";
    g_emit.ginst = "";
    g_sb.method = "";
    g_sb.recv = "";
}

pub void ct_emit_bind_tables(void *units, int *nunits, void *maps, int *nmaps, void *calls, int *ncalls, int *build_mode, int *line_mode, int *runtime_checks, int *abi_mode, int *abi_root, int *abi_exports, int *abi_n);
void ct_emit_bind_tables(void *units, int *nunits, void *maps, int *nmaps,
                         void *calls, int *ncalls, int *build_mode, int *line_mode,
                         int *runtime_checks, int *abi_mode, int *abi_root,
                         int *abi_exports, int *abi_n)
{
    g_emit.units = (struct Unit *)units;
    g_emit.nunits = nunits;
    g_emit.maps = (struct MapTable **)maps;
    g_emit.nmaps = nmaps;
    g_emit.calls = (struct Call **)calls;
    g_emit.ncalls = ncalls;
    g_emit.build_mode = build_mode;
    g_emit.line_mode = line_mode;
    g_emit.runtime_checks = runtime_checks;
    g_emit.io_mask = 0;
    g_emit.abi_mode = abi_mode;
    g_emit.abi_root = abi_root;
    g_emit.abi_exports = abi_exports;
    g_emit.abi_n = abi_n;
}

/* S1a-0 C1: the module layer's unit table grows; a realloc moves it, so the
   emitter (which holds it as a pointer) is re-pointed after every move. */
pub void ct_emit_bind_units(void *units);
void ct_emit_bind_units(void *units)
{
    g_emit.units = (struct Unit *)units;
}

/* PH-64: the bare-metal flags live in their own bind, so the long table
   signature above does not grow for two scalars. */
pub void ct_emit_bind_flags(int *freestanding, char *alloc_map, int *slice_used);
void ct_emit_bind_flags(int *freestanding, char *alloc_map, int *slice_used)
{
    g_emit.freestanding = freestanding;
    g_emit.alloc_map = alloc_map;
    g_slice_used = slice_used;
}

pub void ct_emit_bind_builtin_live(int *live);
pub void ct_emit_bind_io_mask(int mask);
void ct_emit_bind_builtin_live(int *live)
{
    g_emit.builtin_live = live;
}


/* `--alloc A[,B[,C[,D]]]` is parsed at emission time, not at bind time: the
   bind runs before the driver has read the command line. Defaults keep libc, so
   a build without --alloc is byte-identical to before. */
static void sync_alloc(struct Emitter *e)
{
    const char *p;
    int which;

    snprintf(e->alloc_m, sizeof e->alloc_m, "malloc");
    snprintf(e->alloc_f, sizeof e->alloc_f, "free");
    snprintf(e->alloc_r, sizeof e->alloc_r, "realloc");
    snprintf(e->alloc_c, sizeof e->alloc_c, "calloc");
    if (!e->alloc_map || !e->alloc_map[0]) return;
    p = e->alloc_map;
    which = 0;
    while (which < 4) {
        const char *comma = strchr(p, ',');
        size_t n = comma ? (size_t)(comma - p) : strlen(p);
        char *dst = which == 0 ? e->alloc_m
                  : which == 1 ? e->alloc_f
                  : which == 2 ? e->alloc_r : e->alloc_c;
        size_t cap = which == 0 ? sizeof e->alloc_m
                   : which == 1 ? sizeof e->alloc_f
                   : which == 2 ? sizeof e->alloc_r : sizeof e->alloc_c;
        if (n > 0 && n < cap) {
            memcpy(dst, p, n);
            dst[n] = 0;
        }
        if (!comma) break;
        p = comma + 1;
        which++;
    }
}

pub void ct_emit_bind_parse(int *nparams, void *pend_fields, int *npend);
void ct_emit_bind_parse(int *nparams, void *pend_fields, int *npend)
{
    g_emit.nparams = nparams;
    g_emit.pend_fields = (struct Field *)pend_fields;
    g_emit.npend = npend;
}

pub int ct_emit_ntmp(void);
int ct_emit_ntmp(void)
{
    return g_emit.ntmp;
}

pub void ct_emit_set_out(void *out);
void ct_emit_set_out(void *out)
{
    g_emit.out = (FILE *)out;
}

/* S1b-S2b: the body seam. When set, a function whose body the LIR lowerer
   covered end to end is printed from LIR; the signature, attributes and every
   declaration stay with this writer, so the switch cannot change their text.
   `fn` returns 1 when it printed the body, 0 to let this writer print it, -1
   on an I/O error. `void *` keeps the pointer type out of the unit boundary. */
pub void ct_emit_set_body_hook(int (*fn)(const char *, void *, int, int, int *, int));
void ct_emit_set_body_hook(int (*fn)(const char *, void *, int, int, int *, int))
{
    g_body_hook = fn;
}

pub int ct_emit_body_hook(const char *name, void *out, int ind, int ntmp,
                          int *new_ntmp, int stmts);
int ct_emit_body_hook(const char *name, void *out, int ind, int ntmp,
                      int *new_ntmp, int stmts)
{
    {
        int (*body_hook)(const char *, void *, int, int, int *, int) = g_body_hook;
        if (!body_hook) return 0;
        return body_hook(name, out, ind, ntmp, new_ntmp, stmts);
    }
}

/* Phase 29 E29-5 / P34 S9a: the built-in layer units. The module layer clears
   the set when a run starts and adds one index per layer file it loaded. */
pub void ct_emit_clear_builtins(void);
void ct_emit_clear_builtins(void)
{
    g_emit.nbuiltin = 0;
}

pub void ct_emit_add_builtin(int u);
void ct_emit_add_builtin(int u)
{
    /* SH-116: the array holds every layer unit; the cap once said four, so Box
       was loaded and then dropped here, and a user unit never included
       `Box.h` (its instances stayed local, with only a forward declaration of
       `struct ct_Box_hdr`). SH-120 raises the array/cap to eight. */
    if (g_emit.nbuiltin < 8) {
        g_emit.builtins[g_emit.nbuiltin] = u;
        g_emit.nbuiltin += 1;
    }
}

