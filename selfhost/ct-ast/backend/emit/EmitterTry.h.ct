/*
 * EmitterTry.h.ct - the postfix `?` support, moved out of Emitter.h.ct
 * (SH-94 S1, pure move).
 *
 * The four methods hold `self`; the `Emitter` type and both traits live in
 * EmitterCore.h.ct, so this unit imports Core instead of the host and the
 * import graph stays acyclic. They read the parser's `Result` instance rows
 * and its `?` cleanup side table, and release a discarded payload through the
 * type's own `release` method or the local Drop glue. Bodies are
 * byte-identical to the ones Emitter.h.ct used to hold.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

#include "EmitterTry.shim.h"
import backend::emit::EmitterCore;
import frontend::parse::Expr;
import frontend::sym::Symbols;
import frontend::sym::Symbols::StructInst as StructInst;
import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import runtime::text::Intern;
import tool::sh::Sh;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT 160
#define N_IMPL 33

namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitterTry {
    int unused;
}

impl EmitterTryOps for Emitter {
    /* Phase 44: the `Result<T, E>` instance behind a C type spelling. `tag`
       is the bare instance name, which is also the prefix of every static
       method (`Result_int_char_p_err`); a pointer to a Result is not a Result
       value, so a trailing `*` answers 0 (L44-1). */
    const char *try_result_tag(const char *ctype)
    {
        /* S1a-0 C2n-3: trim a run-scoped copy of the caller's spelling; the
           trimmed answer is a type name and is returned as pool text. */
        char *buf;
        size_t n;
        int inst, ninst;
        struct StructInst *ins;

        (void)self;
        if (!ctype || !ctype[0]) return (const char *)0;
        buf = tool::sh::ct_scratch_dup(ctype);
        n = strlen(buf);
        while (n > 0 && (buf[n - 1] == ' ' || buf[n - 1] == '*')) {
            if (buf[n - 1] == '*') return (const char *)0;
            buf[--n] = 0;
        }
        if (strncmp(buf, "struct ", 7) == 0) memmove(buf, buf + 7, strlen(buf + 7) + 1);
        else if (strncmp(buf, "union ", 6) == 0 || strncmp(buf, "enum ", 5) == 0) return (const char *)0;
        inst = frontend::sym::ct_inst_find(buf);
        if (inst < 0) return (const char *)0;
        ins = frontend::sym::ct_insts(&ninst);
        if (!ins || inst >= ninst) return (const char *)0;
        if (strcmp(ins[inst].tmpl, "Result") != 0 || ins[inst].nargs != 2) return (const char *)0;
        if (ins[inst].tmpl_row < 0
            || ins[inst].tmpl_row >= self->sym->builtin_tmpl_hi) return (const char *)0;
        return runtime::text::ct_intern(buf);
    }

    /* `value` is the C spelling `T`; `err` is the canonical source spelling of
       `E`, the identity D44-2 compares. */
    int try_result_cols(int inst, char *val, int vcap, char *err, int ecap)
    {
        int ninst;
        struct StructInst *ins;

        (void)self;
        ins = frontend::sym::ct_insts(&ninst);
        if (!ins || inst < 0 || inst >= ninst) return 0;
        if (strcmp(ins[inst].tmpl, "Result") != 0 || ins[inst].nargs != 2) return 0;
        if (ins[inst].tmpl_row < 0
            || ins[inst].tmpl_row >= self->sym->builtin_tmpl_hi) return 0;
        if (snprintf(val, (size_t)vcap, "%s", ins[inst].ctype[0]) >= vcap) return 0;
        if (snprintf(err, (size_t)ecap, "%s", ins[inst].carg[1]) >= ecap) return 0;
        return 1;
    }

    /* Phase 44: the failure cleanup captured at the `?` (defer bodies first,
       then the `own` releases, the same order a source `return err:` takes). */
    int try_cleanup(int n)
    {
        struct Expr *ex;
        int i;

        (void)self;
        ex = frontend::parse::expr_get();
        for (i = 0; i < ex->ntry_cleanup; i++)
            if (ex->try_cleanup_node[i] == n) return ex->try_cleanup_head[i];
        return -1;
    }

    /* Phase 44: a discarded payload still owns its resources. `release` is the
       type's own exported invalidation (Str, Vec, Map, a user type that writes
       one); otherwise the Drop glue of this unit is the only available path, so
       use it (it is a no-op in a unit that never parsed the explicit impl, and
       never a double free because the temporary owns the only copy). */
    int try_release_payload(const char *ctype, const char *tmp, const char *field)
    {
        char *base;
        int si, inst, ninst, n, m;
        struct StructInst *ins;

        (void)self;
        if (!ctype || strncmp(ctype, "struct ", 7) != 0) return 0;
        /* S1a-0 C2n-3: the base type is a generated spelling, not a 160-byte
           row; trim a run-scoped copy. */
        base = tool::sh::ct_scratch_dup(ctype + 7);
        {
            size_t bl = strlen(base);
            while (bl > 0 && (base[bl - 1] == ' ' || base[bl - 1] == '*')) {
                if (base[bl - 1] == '*') return 0;
                bl--;
                base[bl] = 0;
            }
        }
        si = self->sym->find_struct(base);
        if (si < 0) return 0;
        inst = frontend::sym::ct_inst_find(base);
        ins = frontend::sym::ct_insts(&ninst);
        for (n = 0; n < self->arena->nnode; n++) {
            if (self->arena->nodes[n].kind != N_IMPL) continue;
            if (self->arena->nodes[n].text2[0]) continue;   /* trait impl */
            if (self->arena->nodes[n].aux == si) {
                /* a concrete inherent impl for this struct */
            } else if (self->arena->nodes[n].aux == -1 && inst >= 0 && inst < ninst
                       && strcmp(self->arena->nodes[n].text, ins[inst].tmpl) == 0) {
                /* the template's inherent impl, applied to this instance */
            } else {
                continue;
            }
            for (m = self->arena->nodes[n].a; m >= 0; m = self->arena->nodes[m].next) {
                if (strcmp(self->arena->nodes[m].text2, "release") != 0) continue;
                /* an instance method: 0 (the empty chain) or -1 means no
                   parameters beyond the receiver */
                if (self->arena->nodes[m].a > 0 || self->arena->nodes[m].c) continue;
                /* an exported method is callable from another unit; a private
                   one only when its struct lives in this unit */
                if (!(self->arena->nodes[m].d == 1 || self->cur_unit == -1
                      || self->sym->struct_at(si)->owner == self->cur_unit))
                    continue;
                fprintf(self->out, "%s_release(&%s.%s); ", base, tmp, field);
                return 0;
            }
        }
        if (self->sym->struct_at(si)->uses_drop)
            fprintf(self->out, "%s_Drop_drop(&%s.%s); ", base, tmp, field);
        return 0;
    }
}
