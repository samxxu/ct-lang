/*
 * EmitterText.h.ct - moved out of Emitter.h.ct (PH-85 S85c M0, pure move).
 *
 * Bodies are byte-identical to the ones this unit used to hold;
 * the declaration line only loses `static` and gains a `pub`
 * prototype, the interface change the M0 card allows. See
 * docs/design/p85_m0.md for the baseline and the old->new map.
 */
#include <stdio.h>
#include <string.h>
#include <ctype.h>

import backend::emit::Init;
import frontend::lex::Lexer;
import frontend::module::MapTable::Call as Call;
import frontend::module::MapTable::MapBind as MapBind;
import frontend::module::MapTable;
import frontend::module::Unit;
import frontend::parse::Expr;
import frontend::sym::Symbols::Field as Field;
import frontend::sym::Symbols::MethodSig as MethodSig;
import frontend::sym::Symbols::Closure as Closure;
import frontend::sym::Symbols::StructTmpl as StructTmpl;
import frontend::sym::Symbols::StructInst as StructInst;
import frontend::sym::Symbols::StructImpl as StructImpl;
import frontend::sym::Symbols;
import frontend::sym::Symbols::Adt as Adt;
import frontend::type::TypeCheck;
import runtime::arena::Arena;
import runtime::text::Intern;
import frontend::sym::SymbolsTypeText;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT   160

namespace backend::emit;
/* A stateless unit: the type exists only because a unit file is
   named after its main type. Nothing instantiates it. */
pub struct EmitterText {
    int unused;
}

pub int dims_depth(const char *dims);
pub int hoist_ctype(int n, char *out, int cap, int *depth);
pub const char *sb_prefix(int kind);
pub int sb_text_has_word(const char *txt, const char *w);
pub int sb_text_place_p(const char *e);
pub int sb_view_ret(const char *t);
pub int unit_has_adt(int u, int pub_only);
pub int init_has_elem_groups(const char *t);
pub const char *elem_ret_ctype(int inst, const char *text);

/* Number of array dimensions in a declarator suffix (`[2][3]` is 2). A trait
   object needs one vptr slot per element; more than one dimension leaves no
   reachable slot, so the emitter rejects it instead of emitting bad C. */
int dims_depth(const char *dims)
{
    int i, n;
    n = 0;
    for (i = 0; dims[i]; i++)
        if (dims[i] == '[') n++;
    return n;
}

/* Phase 31 O3: the shared static type reader, reached through its singleton.
   A trait method is dispatched through a named receiver only, so the pointer is
   held in a local. */
int hoist_ctype(int n, char *out, int cap, int *depth)
{
    struct Expr *ex;
    ex = frontend::parse::expr_get();
    return ex->static_ctype(n, out, cap, depth, 0);
}

/* SH-102: the method prefix for a kind from `ct_is_string_value_type`. */
const char *sb_prefix(int kind)
{
    return kind == 2 ? "U16String" : "String";
}

/* A whole identifier in a captured raw initialiser. */
int sb_text_has_word(const char *txt, const char *w)
{
    size_t n = strlen(w);
    const char *p = txt;
    if (n == 0) return 0;
    while ((p = strstr(p, w)) != 0) {
        int left = (p == txt) || !(isalnum((unsigned char)p[-1]) || p[-1] == '_');
        int right = !(isalnum((unsigned char)p[n]) || p[n] == '_');
        if (left && right) return 1;
        p++;
    }
    return 0;
}

/* 1 when the text is a C place (so `&(text)` is legal): an optional `*`, an
   identifier, then `.field` / `->field` / `[index]` suffixes. */
int sb_text_place_p(const char *e)
{
    const char *p = e;
    int n;
    if (!p) return 0;
    while (*p == ' ' || *p == '\t') p++;
    if (*p == '*') {
        p++;
        while (*p == ' ' || *p == '\t') p++;
    }
    if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || *p == '_')) return 0;
    while ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
           || (*p >= '0' && *p <= '9') || *p == '_') p++;
    for (;;) {
        while (*p == ' ' || *p == '\t') p++;
        if (*p == '.') {
            p++;
            if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || *p == '_')) return 0;
            while ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
                   || (*p >= '0' && *p <= '9') || *p == '_') p++;
            continue;
        }
        if (*p == '-' && p[1] == '>') {
            p += 2;
            if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || *p == '_')) return 0;
            while ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
                   || (*p >= '0' && *p <= '9') || *p == '_') p++;
            continue;
        }
        if (*p == '[') {
            n = 1;
            p++;
            while (*p && n > 0) {
                if (*p == '[') n++;
                else if (*p == ']') n--;
                p++;
            }
            if (n != 0) return 0;
            continue;
        }
        break;
    }
    while (*p == ' ' || *p == '\t') p++;
    return *p == 0;
}

/* 1 when a return type can hand back a view of a local owning handle: a
   borrowed `Str` / `U16Str`, a slice, or any pointer. Releasing that local
   would dangle the view, so the escape is left to the author (the P-4.5
   pass-through rule) and the binding is not released on that path. */
int sb_view_ret(const char *t)
{
    if (t == 0) return 0;
    if (strncmp(t, "struct ", 7) == 0) t += 7;
    if (strcmp(t, "Str") == 0 || strcmp(t, "U16Str") == 0
        || strcmp(t, "__ct_slice") == 0) return 1;
    if (strchr(t, '*')) return 1;
    return 0;
}

/* ---- Phase 84: ADT layout and `match` emission ----

   One layout for every ADT: `int tag;` first, then a union with one anonymous
   struct per payload variant. C gives the union the largest member alignment and
   the struct the largest of its members, which is the frozen rule (D84-4). No
   vtable is involved: an ADT is a value, not a trait interface.

   `unit_has_adt` decides the `<stddef.h>` include: only the unit that writes the
   layout also writes the `_Static_assert`s, and only those need `offsetof`. */
int unit_has_adt(int u, int pub_only)
{
    int i, n;
    struct Adt *adts = frontend::sym::ct_adts(&n);

    for (i = 0; adts && i < n; i++) {
        if (adts[i].owner != u) continue;
        if (pub_only && !adts[i].is_pub) continue;
        return 1;
    }
    return 0;
}

/* True when a captured initialiser is `{ { … }, … }`: at least one element
   group, which is where `emit_elem_vptrs` puts the vptrs. `{ 0 }` and `{}` have
   none, so those keep the constructor path. */
int init_has_elem_groups(const char *t)
{
    int i, depth;
    depth = 0;
    for (i = 0; t[i]; i++) {
        if (t[i] == '"' || t[i] == '\'') {
            char q = t[i];
            i++;
            while (t[i] && t[i] != q) {
                if (t[i] == '\\' && t[i + 1]) i++;
                i++;
            }
            continue;
        }
        if (t[i] == '{') {
            depth++;
            if (depth == 2) return 1;
        } else if (t[i] == '}') {
            depth--;
        }
    }
    return 0;
}

/* Phase 31 O3 (S5b): the declared return type of an inherent method, with the
   instance's type arguments substituted and any nested instance resolved.
   S1a-0 C2n-3: the answer is pool text (a type spelling is a durable symbol
   name, not an output line), so the caller no longer supplies a 160-byte row;
   NULL is OOM or an over-long spelling. The substitution and resolve helpers
   keep their own formal cap, so the two working rows below are exactly as
   long as those helpers can answer. */
const char *elem_ret_ctype(int inst, const char *text)
{
    char cur[MAX_TEXT];
    char nxt[MAX_TEXT];
    char res[MAX_TEXT];
    int ti, tn, k, j;
    struct StructInst *ins;
    struct StructTmpl *tps;

    ins = frontend::sym::ct_insts(&k);
    if (!ins || inst < 0 || inst >= k) return (const char *)0;
    ti = frontend::sym::ct_tmpl_find(ins[inst].tmpl);
    tps = frontend::sym::ct_tmpls(&tn);
    if (snprintf(cur, sizeof cur, "%s", text) >= (int)sizeof cur) return (const char *)0;
    if (ti >= 0 && tps) {
        for (j = 0; j < tps[ti].ntparams; j++) {
            if (j >= ins[inst].nargs) break;
            if (tps[ti].tparam[j] && ins[inst].ctype[j]
                && frontend::sym::ct_generic_subst(cur, tps[ti].tparam[j],
                        ins[inst].ctype[j], nxt, sizeof nxt) == 0) {
                if (snprintf(cur, sizeof cur, "%s", nxt) >= (int)sizeof cur)
                    return (const char *)0;
            }
        }
    }
    if (strchr(cur, '<') && frontend::sym::ct_inst_resolve(cur, res, sizeof res) == 0)
        if (snprintf(cur, sizeof cur, "%s", res) >= (int)sizeof cur) return (const char *)0;
    return runtime::text::ct_intern(cur);
}
