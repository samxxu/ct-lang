#define N_BIN     11
#define N_MCALL   30
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_AND     12
#define B_BAND    15
#define B_BOR     16
#define B_COMMA   19
#define B_DIV     4
#define B_MOD     11
#define B_MUL     3
#define B_OR      13
#define B_SHL     17
#define B_SHR     18
#define B_SUB     2
#define B_XOR     14
#define MAX_TEXT  160
#define N_ADDR    27
#define N_ADTCTOR 81
#define N_ARROW   25
#define N_ASSIGN  13
#define N_BLOCK   4
#define N_BOX     34
#define N_BREAK   38
#define N_CALL    7
#define N_CASE    43
#define N_CAST    35
#define N_CLOSURE 59
#define N_COMPOUND 51
#define N_CONT    39
#define N_DECL    12
#define N_DECLS   40
#define N_DEFER   69
#define N_DEFER_RUN 70
#define N_DELETE  41
#define N_DEREF   28
#define N_DOWHILE 44
#define N_EMPTY   52
#define N_EXPR    6
#define N_FIELD   23
#define N_FIELDS  56
#define N_FNUM    54
#define N_FOR     16
#define N_FOREACH 62
#define N_FUNC    3
#define N_GOTO    50
#define N_IF      14
#define N_INDEX   26
#define N_INIT_BRACE 65
