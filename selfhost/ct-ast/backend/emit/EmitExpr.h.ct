#define N_INTO_SELF 64
#define N_LABEL   49
#define N_LOOP    60
#define N_MATCH   78
#define N_MATSEQ  73
#define N_MEMBER  24
#define N_NEWOBJ  77
#define N_NUM     8
#define N_OFFSETOF 47
