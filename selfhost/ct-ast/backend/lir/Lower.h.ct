            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs("]", g_lir_out);
            return 0;
        case LE_DEREF:
            fputs("(*", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_ADDR:
            fputs("(&", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_CAST:
            fprintf(g_lir_out, "(%s)(", e->text ? e->text : "");
