namespace backend::lir;

/* One lowering run. */
pub struct Lower {
    struct TModule *m;
    struct LModule *l;
    int unit;
    int file;
    int func;           /* LFunc id being lowered */
    int ret_type;       /* LType id of the current function's result */
    int root;           /* root LBlock id of the current function */
    int aborted;        /* the current function hit an unsupported row */
    int drop_seen;      /* an AutoDrop entry materialised (printing is S8) */
    int hard;           /* a pool refused a row: never a silent truncation */
    int *loops;         /* LBlock ids of the enclosing loop bodies */
    int nloops;
    int loopcap;
    int *breaks;        /* loop and switch bodies a `break` may target */
    int nbreaks;
    int breakcap;
    int mode;           /* 0 off, 1 on, 2 shadow */
    int forced;
    int defaulted;   /* build mode chose LIR without a flag */
         /* the CLI named the mode, so the env cannot override */
    int tmp_delta;      /* emitter counter minus the lowering's counter
                           (generated products move one and not the other) */
    int func_scope;     /* TScope id of the function being lowered */
    int func_has_self;  /* an impl method: the C spelling of `self` is `_self` */
    int no_bodies;      /* the unit uses a construct this stage must not lower */
    int global_no_bodies; /* the run set a mode the lowerer does not model */
    int stmt_is_last;   /* the statement being lowered ends its block */
    int hoist_temps;    /* 1 = a statement head (hoist_rvalue), 0 = a condition
                           (hoist_expr disables the receiver-temp chain) */
    int tmp_start_temps; /* LTemp count at function entry (rollback on abort) */
    int bypass_te;      /* the hoisted root whose own initialiser is lowering */
    int hoist_block;    /* the block the current statement-head hoists live in */
    int h_map_te[256];  /* TExpr id that a hoist names -> its temp */
    int h_map_tmp[256];
    int h_nmap;
    int h_into_ast[64]; /* AST `into` node index -> its promoted temp */
    int h_into_tmp[64];
    int h_into_cat[64]; /* the receiver category (2 = addressed in place) */
    int h_into_n;
    int h_temp[64];     /* statement-head hoists, in emission order */
    int h_init[64];
    int h_kind[64];     /* 1 optional temp, 2 receiver temp, 3 into */
    int h_type[64];
    int h_cat[64];
    int h_blk[64];
    int h_n;
    const char *sb_name[64]; /* SH-102 owning locals, declaration order */
    int sb_block[64];
    int sb_kind[64];
    const char *sb_prefix[64];
    int sb_own[64];     /* 0 = a borrowed view: no scope release */
    int sb_notail[64];  /* 1 = an impl-method parameter: the emitter releases it */
    int sb_n;
    int expr_depth;     /* lw_expr recursion guard (a malformed/cyclic row) */
    int hoist_depth;    /* lw_hoist_scan recursion guard */
    /* D-013 by-value owning parameters: retained at entry, released at exit */
    int p_n;
    const char *p_name[64];
    const char *p_prefix[64];
    int p_kind[64];
    int cv_ci[64];      /* closure bindings in scope: name -> closure id */
    const char *cv_name[64];
    int cv_n;
}

static struct Lower g_lower;

/* S8 glue predicates (definitions near the owning-local model below; the
   expression lowerer earlier in this unit needs the declarations). */
static int lw_spelling_glue(struct Lower *w, const char *sp, int depth);
static int lw_spelling_by_value(const char *sp);
static int lw_spelling_container(const char *sp);

pub int ct_lir_on(void);
pub int ct_lir_emit_on(void);
pub void ct_lir_set_switch(int mode);
pub void ct_lir_default_build(void);
pub void ct_lir_default_compile(void);
pub void ct_lir_disable_bodies(void);
pub int ct_lir_forced(void);
pub int ct_lir_quiet_fallback(void);
pub int ct_lir_build_program(int prog, const char *path, const char *base,
                             const char *ns, int is_hdr, int is_map);
pub int ct_lir_build_unit(void *up, int mod_unit, int tmp_base);
pub int ct_lir_ready(void);
pub int ct_lir_emit(FILE *out);
pub int ct_lir_try_body(const char *name, void *out, int ind, int ntmp,
                        int *new_ntmp, int stmts);
/* After a unit is emitted: how many bodies the seam actually took. A body
   whose `temp_start` did not match the emitter's counter stayed on the AST
   path even though it lowered, so a "ready" unit still needs this count. */
pub void ct_lir_report_printed(void)
{
    struct LModule *l = lmod_get();
    const char *e;

    e = getenv("CT_LIR_REPORT");
    if (!e || !e[0]) return;
    fprintf(stderr, "lir: bodies printed=%d skipped=%d\n", l->stat_printed,
            l->stat_fallback);
}

pub void ct_lir_free(void);
pub void ct_lir_report_printed(void);

/* ------------------------------------------------------------------------- */
/* switch                                                                     */
/* ------------------------------------------------------------------------- */
pub void ct_lir_set_switch(int mode)
{
    if (mode < 0) mode = 0;
    if (mode > 2) mode = 2;
    g_lower.mode = mode;
    g_lower.forced = 1;
    lmod_get()->enabled = mode != 0;
}

static int lw_env_switch(void)
{
    const char *e;

    e = getenv("CT_LIR");
    if (!e || !e[0]) return 0;
    if (strcmp(e, "0") == 0 || strcmp(e, "off") == 0) return 0;
    if (strcmp(e, "shadow") == 0) return 2;
    return 1;
}

/* S8: the self-hosting build prints from LIR by default. An explicit `--ir=`
   flag or `CT_LIR` env still wins, so `--ir=off` is the oracle. Compile mode
   keeps the AST default until its remaining shapes are closed (the S8 diff
   list); the switch is entered once, at the top of a build. */
pub void ct_lir_default_build(void)
{
    const char *e;

    if (g_lower.forced) return;
    e = getenv("CT_LIR");
    if (e && e[0]) return;
    g_lower.mode = 1;
    g_lower.defaulted = 1;
    lmod_get()->enabled = 1;
}

/* S8: the single-file compile path is LIR by default too, with the same
   opt-out (`--ir=off` / `CT_LIR=0`). The caller only enters this when the
   run has no map/model/abi/line special mode and no freestanding allocator
   mapping, because those are still emitter-owned. A verifier finding on this
   defaulted path falls back to the AST oracle (see the return code 2 below),
   so a program the AST path accepts never changes meaning. */
pub void ct_lir_default_compile(void)
{
    const char *e;

    if (g_lower.forced) return;
    e = getenv("CT_LIR");
    if (e && e[0]) return;
    g_lower.mode = 1;
    g_lower.defaulted = 1;
    lmod_get()->enabled = 1;
}

/* The defaulted path may silently fall back; an explicit flag or the strict
   env keeps the verifier fatal (test/ir's negatives). */
pub int ct_lir_quiet_fallback(void)
{
    return g_lower.defaulted && !g_lower.forced
           && !getenv("CT_LIR_STRICT");
}

/* `--runtime-checks` and the stable-receiver refusal live in the emitter's
   method-call writer; a LIR-printed body would bypass both, so that run keeps
   every body on the AST path. */
pub void ct_lir_disable_bodies(void)
{
    g_lower.global_no_bodies = 1;
}

pub int ct_lir_forced(void)
{
    return g_lower.forced;
}

pub int ct_lir_on(void)
{
    struct LModule *l = lmod_get();

    if (!g_lower.forced && !g_lower.defaulted) g_lower.mode = lw_env_switch();
    l->enabled = g_lower.mode != 0;
    return l->enabled;
}

pub int ct_lir_emit_on(void)
{
    if (!ct_lir_on()) return 0;
    return g_lower.mode != 2;
}

pub int ct_lir_ready(void)
{
    return lmod_get()->ready;
}

/* ------------------------------------------------------------------------- */
/* Small helpers                                                             */
/* ------------------------------------------------------------------------- */
static int lw_scope_kind(struct Lower *w, int scope)
{
    if (scope <= 0 || scope > w->m->nscopes) return 0;
    return w->m->scopes[scope - 1].kind;
}

static int lw_scope_parent(struct Lower *w, int scope)
{
    if (scope <= 0 || scope > w->m->nscopes) return 0;
    return w->m->scopes[scope - 1].parent;
}

static void lw_abort(struct Lower *w, const char *why)
{
    w->aborted = 1;
    if (getenv("CT_LIR_DEBUG")) fprintf(stderr, "lir: abort at %s\n", why);
}

static int lw_type(struct Lower *w, int tir_type)
{
    return lmod_type(w->l, backend::tir::tmod_cspell(w->m, tir_type));
}

/* A local of a struct that adopts a trait carries a vptr the emitter fills
   with generated initialiser code (a per-element loop or a designator list),
   which is not a TStmt/TSExpr and therefore not a row the lowerer can carry
   yet. The whole function falls back rather than lose that code. */
/* The generated vptr designators a struct initialiser carries. The emitter
   appends them after the source initialiser; the shapes are
   `.__<trait>_vptr = &<Struct>_<Trait>_vtable` for each adoption and the same
   path recursively for every field of struct type. */
static void lw_low_text(const char *src, char *dst, int cap)
{
    int i, n = 0;

    if (!src) { dst[0] = 0; return; }
    for (i = 0; src[i] && n < cap - 1; i++) {
        char c = src[i];
        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
        dst[n] = c;
        n++;
    }
    dst[n] = 0;
}

static struct ct_tstruct *lw_struct_row(struct Lower *w, const char *tag)
{
    int id;

    if (!tag || !tag[0]) return 0;
    id = backend::tir::tmod_find_struct(w->m, tag);
    if (id <= 0) return 0;
    return &w->m->structs[id - 1];
}

/* The generated vptr designators a struct initialiser carries: the shapes are
   `.__<trait>_vptr = &<Type>_<Trait>_vtable` for each use and the same path
   recursively for every value field of struct type. `prefix` is the member
   path without its leading dot (`""`, `inner.`, `inner.sub.`). */
static int lw_vptr_items(struct Lower *w, const char *tag, const char *prefix,
                         char *buf, int cap, int *used, int depth)
{
    struct ct_tstruct *d;
    int i, u = *used;

    if (depth > 6) return -1;
    d = lw_struct_row(w, tag);
    if (!d) return 0;
    for (i = 0; i < d->nuses; i++) {
        char low[256];
        int n;
        lw_low_text(d->uses[i], low, (int)sizeof(low));
        {
            char lead[512];
            snprintf(lead, sizeof(lead), ".%s", prefix);
            n = snprintf(buf + u, (size_t)(cap - u),
                         "%s%s__%s_vptr = &%s_%s_vtable",
                         u > 0 ? ", " : "", lead, low, tag, d->uses[i]);
        }
        if (n < 0 || u + n >= cap) return -1;
        u += n;
    }
    for (i = 0; i < d->nfields; i++) {
        const char *fs = d->fields[i].type;
        const char *ftag;
        char fbuf[512];
        int fl;
        if (!fs || strchr(fs, '*')) continue;
        if (d->fields[i].dims && d->fields[i].dims[0]) continue;
        if (strncmp(fs, "struct ", 7) == 0) ftag = fs + 7;
        else if (strncmp(fs, "union ", 6) == 0) ftag = fs + 6;
        else continue;
        fl = (int)strlen(ftag);
        while (fl > 0 && (ftag[fl - 1] == '*' || ftag[fl - 1] == ' ')) fl--;
        if (fl <= 0 || fl >= (int)sizeof(fbuf) - 1) continue;
        memcpy(fbuf, ftag, (size_t)fl);
        fbuf[fl] = 0;
        if (!lw_struct_row(w, fbuf)) continue;
        {
            char p2[512];
            snprintf(p2, sizeof(p2), "%s%s.", prefix,
                     d->fields[i].name ? d->fields[i].name : "");
            if (lw_vptr_items(w, fbuf, p2, buf, cap, &u, depth + 1) != 0)
                return -1;
        }
    }
    *used = u;
    return 0;
}

/* The same vptr set written as statements (`<recv>.__x_vptr = &...;`), one
   per line, for an array's per-element initialiser loop or for a heap object
   the declaration could not initialise. */
static int lw_vptr_stmts(struct Lower *w, const char *tag, const char *recv,
                         char *buf, int cap, int *used, int depth)
{
    struct ct_tstruct *d;
    int i, u = *used;

    if (depth > 6) return -1;
    d = lw_struct_row(w, tag);
    if (!d) return 0;
    for (i = 0; i < d->nuses; i++) {
        char low[256];
        int n;
        lw_low_text(d->uses[i], low, (int)sizeof(low));
        n = snprintf(buf + u, (size_t)(cap - u),
                     "%s%s.__%s_vptr = &%s_%s_vtable;\n", u > 0 ? "" : "",
                     recv, low, tag, d->uses[i]);
        if (n < 0 || u + n >= cap) return -1;
        u += n;
    }
    for (i = 0; i < d->nfields; i++) {
        const char *fs = d->fields[i].type;
        const char *ftag;
        char fbuf[512], r2[1024];
        int fl;
        if (!fs || strchr(fs, '*')) continue;
        if (d->fields[i].dims && d->fields[i].dims[0]) continue;
        if (strncmp(fs, "struct ", 7) == 0) ftag = fs + 7;
        else if (strncmp(fs, "union ", 6) == 0) ftag = fs + 6;
        else continue;
        fl = (int)strlen(ftag);
        while (fl > 0 && (ftag[fl - 1] == '*' || ftag[fl - 1] == ' ')) fl--;
        if (fl <= 0 || fl >= (int)sizeof(fbuf) - 1) continue;
        memcpy(fbuf, ftag, (size_t)fl);
        fbuf[fl] = 0;
        if (!lw_struct_row(w, fbuf)) continue;
        snprintf(r2, sizeof(r2), "%s.%s", recv,
                 d->fields[i].name ? d->fields[i].name : "");
        if (lw_vptr_stmts(w, fbuf, r2, buf, cap, &u, depth + 1) != 0)
            return -1;
    }
    *used = u;
    return 0;
}

static int lw_struct_needs_init(struct Lower *w, const char *tag, int depth)
{
    struct ct_tstruct *d;
    int i;

    if (!tag || !tag[0] || depth > 8) return 0;
    d = lw_struct_row(w, tag);
    if (!d) return 0;
    if (d->nuses > 0) return 1;
    for (i = 0; i < d->nfields; i++) {
        const char *fs = d->fields[i].type;
        const char *ftag;
        int fl;
        char buf[256];
        if (!fs || strchr(fs, '*')) continue;
        if (strncmp(fs, "struct ", 7) == 0) ftag = fs + 7;
        else if (strncmp(fs, "union ", 6) == 0) ftag = fs + 6;
        else continue;
        fl = (int)strlen(ftag);
        while (fl > 0 && (ftag[fl - 1] == '*' || ftag[fl - 1] == ' ')) fl--;
        if (fl <= 0 || fl >= (int)sizeof(buf)) continue;
        memcpy(buf, ftag, (size_t)fl);
        buf[fl] = 0;
        if (lw_struct_needs_init(w, buf, depth + 1)) return 1;
    }
    return 0;
}

/* The bare instance name behind a `Result<…>` spelling, or "" when the type
   is not a by-value Result (a pointer / another template). */
static const char *lw_result_tag(struct Lower *w, const char *sp)
{
    char buf[512];
    int n;
    struct ct_tstruct *row;

    if (!sp || !sp[0]) return "";
    snprintf(buf, sizeof(buf), "%s", sp);
    n = (int)strlen(buf);
    while (n > 0 && buf[n - 1] == ' ') n--;
    if (n > 0 && buf[n - 1] == '*') return "";
    buf[n] = 0;
    if (strncmp(buf, "struct ", 7) == 0) {
        memmove(buf, buf + 7, strlen(buf + 7) + 1);
    } else if (strncmp(buf, "union ", 6) == 0
               || strncmp(buf, "enum ", 5) == 0) {
        return "";
    }
    if (strncmp(buf, "Result_", 7) != 0) return "";
    row = lw_struct_row(w, buf);
    if (!row) return "";
    return runtime::text::ct_intern(buf);
}

/* The C spelling of a struct row's field, or "" when absent. */
static const char *lw_struct_field_type(struct Lower *w, const char *tag,
                                        const char *field)
{
    struct ct_tstruct *row = lw_struct_row(w, tag);
    int i;

    if (!row || !field) return "";
    for (i = 0; i < row->nfields; i++)
        if (row->fields[i].name && strcmp(row->fields[i].name, field) == 0)
            return row->fields[i].type ? row->fields[i].type : "";
    return "";
}

/* Does the function carry any defer / errdefer / owned cleanup entry? The
   `?` failure edge must run that chain; until the edge is modelled, such a
   function stays on the AST path. */
static int lw_func_has_cleanup(struct Lower *w, int func_scope)
{
    int i, k;

    if (func_scope <= 0) return 0;
    for (i = 0; i < w->m->nscopes; i++) {
        struct ct_tscope *sc = &w->m->scopes[i];
        int s = sc->id;
        while (s > 0 && s != func_scope) s = lw_scope_parent(w, s);
        if (s != func_scope) continue;
        for (k = 0; k < sc->ncleanups; k++) {
            int cid = sc->cleanups[k];
            if (cid <= 0 || cid > w->m->ncleanups) continue;
            return 1;
        }
    }
    return 0;
}

static struct ct_tadt *lw_adt_row(struct Lower *w, const char *name)
{
    int id;

    if (!name || !name[0]) return 0;
    id = backend::tir::tmod_find_adt(w->m, name);
    if (id <= 0) return 0;
    return &w->m->adts[id - 1];
}

static int lw_type_needs_init(struct Lower *w, int tir_type)
{
    const char *sp;
    const char *tag;
    int n;
    char buf[256];

    sp = backend::tir::tmod_cspell(w->m, tir_type);
    if (!sp) return 0;
    if (strncmp(sp, "struct ", 7) == 0) tag = sp + 7;
    else if (strncmp(sp, "union ", 6) == 0) tag = sp + 6;
    else return 0;
    n = (int)strlen(tag);
    while (n > 0 && tag[n - 1] == ' ') n--;
    if (n > 0 && tag[n - 1] == '*') return 0;   /* pointers are handled apart */
    if (n <= 0 || n >= (int)sizeof(buf)) return 0;
    memcpy(buf, tag, (size_t)n);
    buf[n] = 0;
    return lw_struct_needs_init(w, buf, 0);
}

static int lw_type_text(struct Lower *w, const char *spelling)
{
    return lmod_type(w->l, spelling ? spelling : "void");
}

/* A generic template has no C body of its own (the emitter skips it too):
   its monomorphised instances are generated C the lowerer does not model.
   Skipping it must not mark the unit as uncovered -- nothing is emitted. */
static int lw_decl_is_template(struct Lower *w, struct ct_tdecl *d)
{
    int i;

    if (d->is_template) return 1;
    /* The built-in layer's methods are emitted only through monomorphised
       instances (`Vec_int_push`, ...); their template N_FUNC has no C body of
       its own even when the symbol row's type-parameter count did not reach
       TIR. Their TIR name is `<Container>.<method>`. */
    if (d->name) {
        static const char *const builtin[] = {
            "Vec.", "Map.", "Box.", "Option.", "Result.", "String.",
            "Str.", "U16Str.", "U16String."
        };
        int bi;
        for (bi = 0; bi < (int)(sizeof(builtin) / sizeof(builtin[0])); bi++)
            if (strncmp(d->name, builtin[bi], strlen(builtin[bi])) == 0)
                return 1;
    }
    if (backend::tir::tmod_has_free_param(w->m, d->type)) return 1;
    for (i = 0; i < d->nparams; i++)
        if (backend::tir::tmod_has_free_param(w->m, d->params[i])) return 1;
    return 0;
}

/* An exit only sees the entries registered before it. The block-tail flush
   sees every entry, so its caller passes `all = 1`. */
static int lw_active(struct Lower *w, struct ct_lcleanup *c, int line, int col,
                     int all)
{
    (void)w;
    if (all) return 1;
    if (c->span.line < line) return 1;
    if (c->span.line == line && c->span.col <= col) return 1;
    return 0;
}

/* ------------------------------------------------------------------------- */
/* Expressions                                                               */
/* ------------------------------------------------------------------------- */
/* The callee's parameters, in source order: is parameter `idx` spelled
   `ref` / `out`? The call site then takes its address (SH-78 S2b). */
static int lw_decl_param_ref(struct Lower *w, int decl, int idx)
{
    struct ct_tdecl *d;
    struct ct_tscope *sc;
    int i, n = 0;

    if (decl <= 0 || decl > w->m->ndecls) return 0;
    d = &w->m->decls[decl - 1];
    if (d->scope <= 0 || d->scope > w->m->nscopes) return 0;
    sc = &w->m->scopes[d->scope - 1];
    for (i = 0; i < sc->nvars; i++) {
        struct ct_tvar *v;
        int vi = sc->vars[i];
        if (vi <= 0 || vi > w->m->nvars) continue;
        v = &w->m->vars[vi - 1];
        if (!v->is_param) continue;
        if (n == idx) return v->is_ref;
        n++;
    }
    return 0;
}

/* A trait / inherent method's `ref` / `out` parameter. The direct-call path
   reads the TDecl's parameter rows; a virtual dispatch has no TDecl, so the
   trait's MethodSig answers instead (same `pann` values the emitter uses). */
static int lw_method_param_ref(struct Lower *w, struct ct_texpr *t, int idx)
{
    struct Symbols *sym = frontend::sym::symbols_get();
    (void)w;
    if (t->target_kind == RT_VIRTUAL && t->target_key && t->text) {
        char tn[256];
        int tl = 0, ti, mi;
        while (t->target_key[tl] && t->target_key[tl] != '.') {
            if (tl < (int)sizeof(tn) - 1) tn[tl] = t->target_key[tl];
            tl++;
        }
        tn[tl < (int)sizeof(tn) ? tl : (int)sizeof(tn) - 1] = 0;
        ti = sym->find_trait(tn);
        if (ti >= 0) {
            for (mi = 0; mi < sym->traits[ti].nm; mi++) {
                struct MethodSig *ms = &sym->traits[ti].m[mi];
                if (!ms->name || strcmp(ms->name, t->text) != 0) continue;
                if (idx >= ms->nparams) return 0;
                return ms->pann[idx] == 2 || ms->pann[idx] == 3;
            }
        }
        return 0;
    }
    if (t->op == 2 && t->target_key && t->target_key[0]) {
        /* Inherent-method annotations are keyed by (host, method), not by the
           synthesized C name (`Counter_add` never appears in the symbol
           table). `find_meth_ann` is the same table the emitter reads. */
        char host[512];
        const char *dot;
        int hl, pann[16];
        dot = t->target_key;
        {
            const char *p = t->target_key;
            while (*p) {
                if (*p == '.') dot = p;
                p++;
            }
        }
        hl = (int)(dot - t->target_key);
        if (hl > (int)sizeof(host) - 1) hl = (int)sizeof(host) - 1;
        memcpy(host, t->target_key, (size_t)hl);
        host[hl] = 0;
        if (sym->find_meth_ann(host, dot + 1, pann, 16) == 0 && idx < 16)
            return pann[idx] == 2 || pann[idx] == 3;
    }
    return 0;
}

/* Apply the ref/out address rule to one already-lowered actual. `Vec.get`
   becomes `Vec.at` (already a pointer, SH-96); everything else takes `&`. */
static int lw_actual_ref(struct Lower *w, struct ct_texpr *t, int kid, int idx)
{
    struct ct_lexpr *kk;
    size_t nl;
    int aref;

    if (kid <= 0) return kid;
    if (!lw_method_param_ref(w, t, idx)) return kid;
    kk = &w->l->exprs[kid - 1];
    /* SH-96: `self` is already the receiver pointer in the emitted C, so
       `self.bump(self)` passes `_self`, not `&_self`. */
    if (kk->kind == LE_NAME && kk->text && strcmp(kk->text, "_self") == 0)
        return kid;
    nl = kk->text ? strlen(kk->text) : 0;
    if (kk->kind == LE_MCALL && nl > 4 && strncmp(kk->text, "Vec_", 4) == 0
        && strcmp(kk->text + nl - 4, "_get") == 0) {
        const char *nn = runtime::text::ct_internf("%.*s_at", (int)(nl - 4), kk->text);
        if (!nn) { w->hard = 1; return 0; }
        kk->text = nn;
        return kid;
    }
    aref = lmod_new_expr(w->l, LE_REF, t->span.file, t->span.line, t->span.col);
    if (aref <= 0) { w->hard = 1; return 0; }
    w->l->exprs[aref - 1].type = w->l->exprs[kid - 1].type;
    if (lmod_expr_add_kid(w->l, aref, kid) != 0) { w->hard = 1; return 0; }
    return aref;
}

/* A `ref` / `out` binding is a pointer in the emitted C: every read and write
   goes through `(*name)`. Names are matched from the tail so an inner shadow
   wins; only parameters are supported in this stage. */
/* The fallback for a name the typed row did not resolve: a row outside the
   function being lowered cannot be the referent, and a same-spelled local in
   another function must not turn this read into a dereference. */
static int lw_name_is_ref(struct Lower *w, const char *name)
{
    int i;

    if (!name || !name[0]) return 0;
    for (i = w->m->nvars - 1; i >= 0; i--) {
        struct ct_tvar *v = &w->m->vars[i];
        int scope;
        if (!v->name || strcmp(v->name, name) != 0) continue;
        if (w->func_scope > 0) {
            scope = v->scope;
            while (scope > 0 && scope != w->func_scope)
                scope = lw_scope_parent(w, scope);
            if (scope != w->func_scope) continue;
        }
        return v->is_ref;
    }
    return 0;
}

/* --- statement-head hoists (the emitter's hoist_scan/emit_hoists) --------
   Three shapes need a name before the statement that uses it:
   - a `?.` whose receiver is not a variable: `__ct_optN` is declared at the
     statement head, the conditional still assigns it;
   - a method call whose receiver chain is rooted at a call: each level gets
     `__ct_tmpN`, innermost first, with the call as its initialiser;
   - an `into` receiver: `__ct_recvN` plus its spliced block. */
/* The expression map lives for the whole function: a TExpr id names one AST
   node, so a stale row can never be reached by another statement. The
   statement's own entry list (`h_n`) is what resets per statement. */
static int lw_hoist_clear(struct Lower *w)
{
    w->h_n = 0;
    w->bypass_te = 0;
    return 0;
}

static int lw_hoist_into_lookup(struct Lower *w, int ast)
{
    int i;

    for (i = 0; i < w->h_into_n; i++)
        if (w->h_into_ast[i] == ast) return w->h_into_tmp[i];
    return 0;
}

static int lw_hoist_into_add(struct Lower *w, int ast, int temp, int cat)
{
    if (w->h_into_n >= 64) return -1;
    w->h_into_ast[w->h_into_n] = ast;
    w->h_into_tmp[w->h_into_n] = temp;
    w->h_into_cat[w->h_into_n] = cat;
    w->h_into_n++;
    return 0;
}

static int lw_hoist_into_cat(struct Lower *w, int ast)
{
    int i;

    for (i = 0; i < w->h_into_n; i++)
        if (w->h_into_ast[i] == ast) return w->h_into_cat[i];
    return 0;
}

static int lw_hoist_lookup(struct Lower *w, int teid)
{
    int i;

    for (i = 0; i < w->h_nmap; i++)
        if (w->h_map_te[i] == teid) return w->h_map_tmp[i];
    return 0;
}

static int lw_hoist_add(struct Lower *w, int teid, int temp)
{
    if (w->h_nmap >= 256) return -1;
    w->h_map_te[w->h_nmap] = teid;
    w->h_map_tmp[w->h_nmap] = temp;
    w->h_nmap++;
    return 0;
}

static int lw_hoist_entry(struct Lower *w, int kind, int temp, int init,
                          int type, int cat, int blk)
{
    if (w->h_n >= 64) return -1;
    w->h_temp[w->h_n] = temp;
    w->h_init[w->h_n] = init;
    w->h_kind[w->h_n] = kind;
    w->h_type[w->h_n] = type;
    w->h_cat[w->h_n] = cat;
    w->h_blk[w->h_n] = blk;
    w->h_n++;
    return 0;
}

static int lw_is_name_kind(int k)
{
    return k == TK_NAME_LOCAL || k == TK_NAME_GLOBAL;
}

/* The C type a hoisted receiver is declared with: the expression's own type,
   which the TIR builder resolved. */
static int lw_hoist_type(struct Lower *w, int teid)
{
    if (teid <= 0 || teid > w->m->nexprs) return 0;
    return lw_type(w, w->m->exprs[teid - 1].type);
}

static int lw_hoist_scan_body(struct Lower *w, int teid, int top);
static int lw_hoist_scan(struct Lower *w, int teid, int top)
{
    int r;
    if (w->hoist_depth > 400) {
        lw_abort(w, "Lhoistdepth");
        return -1;
    }
    w->hoist_depth++;
    r = lw_hoist_scan_body(w, teid, top);
    w->hoist_depth--;
    return r;
}

static int lw_hoist_scan_body(struct Lower *w, int teid, int top)
{
    struct ct_texpr *t;
    int i;

    if (teid <= 0 || teid > w->m->nexprs) return 0;
    t = &w->m->exprs[teid - 1];
    if (getenv("CT_LIR_DEBUG"))
        fprintf(stderr, "lir: hscan teid=%d kind=%d nkids=%d kids=%p top=%d\n",
                teid, t->kind, t->nkids, (void *)t->kids, top);
    /* A TIR row with kids but no kid table is a builder bug, not a shape the
       lowerer may walk: refuse the function instead of dereferencing null. */
    if (t->nkids > 0 && !t->kids) { lw_abort(w, "Lkids"); return -1; }
    if (t->kind == TK_OPTIONAL_CHAIN) {
        if (t->nkids >= 1 && !lw_is_name_kind(w->m->exprs[t->kids[0] - 1].kind)) {
            int temp = lmod_new_temp(w->l, LTK_OPT,
                                     lw_hoist_type(w, t->kids[0]),
                                     w->hoist_block);
            if (temp <= 0) { w->hard = 1; return -1; }
            if (lw_hoist_add(w, t->kids[0], temp) != 0
                || lw_hoist_entry(w, 1, temp, 0,
                                  lw_hoist_type(w, t->kids[0]), 0, 0) != 0) {
                w->hard = 1;
                return -1;
            }
        }
    }
    if (t->kind == TK_INTO_TARGET) {
        int temp, ty;
        if (t->nkids >= 1 && lw_hoist_scan(w, t->kids[0], 0) != 0) return -1;
        ty = lw_type(w, t->text && t->text[0]
                        ? backend::tir::tmod_type(w->m, t->text, 0)
                        : t->type);
        temp = lmod_new_temp(w->l, LTK_RECV, ty, w->hoist_block);
        if (temp <= 0) { w->hard = 1; return -1; }
        if (lw_hoist_into_add(w, (int)t->num, temp, t->aux == 2 ? 2 : 0) != 0
            || lw_hoist_entry(w, 3, temp, t->nkids >= 1 ? t->kids[0] : 0,
                              ty, t->aux == 2 ? 2 : 0, teid) != 0) {
            w->hard = 1;
            return -1;
        }
        /* the block is spliced by the statement, not scanned here */
        return 0;
    }
    if (t->kind == TK_CLOSURE || t->kind == TK_MATCH_ARM) {
        /* the trailing kids are statement ids, not expressions: only a match
           subject is an expression. */
        if (t->kind == TK_MATCH_ARM && t->nkids >= 1)
            if (lw_hoist_scan(w, t->kids[0], 0) != 0) return -1;
        return 0;
    }
    if (w->hoist_temps
        && t->op == 2 && (t->kind == TK_CALL || t->kind == TK_INTRINSIC)
        && t->target_kind != RT_RECIPE && t->aux != 6 && t->aux != 11
        && t->nkids >= 1) {
        int chain[8];
        int nc = 0, lvl = teid;
        for (;;) {
            int root;
            int ok = 0;
            if (lvl <= 0 || lvl > w->m->nexprs) break;
            if (w->m->exprs[lvl - 1].nkids < 1
                || !w->m->exprs[lvl - 1].kids) break;
            root = w->m->exprs[lvl - 1].kids[0];
            while (root > 0 && root <= w->m->nexprs
                   && w->m->exprs[root - 1].kind == TK_FIELD) {
                if (w->m->exprs[root - 1].nkids < 1
                    || !w->m->exprs[root - 1].kids) { root = 0; break; }
                root = w->m->exprs[root - 1].kids[0];
            }
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: chain lvl=%d root=%d\n", lvl, root);
            if (root <= 0 || root > w->m->nexprs) break;
            if (lw_hoist_lookup(w, root) > 0) break;
            if (w->m->exprs[root - 1].kind == TK_CALL
                || w->m->exprs[root - 1].kind == TK_INTRINSIC) {
                ok = w->m->exprs[root - 1].target_kind == RT_DIRECT;
                if (!ok && w->m->exprs[root - 1].text
                    && (w->m->exprs[lvl - 1].aux == 9
                        || w->m->exprs[lvl - 1].aux == 10))
                    ok = 1;
            }
            if (!ok && w->m->exprs[root - 1].kind == TK_CALL
                && w->m->exprs[root - 1].op == 2
                && w->m->exprs[root - 1].aux != 5
                && w->m->exprs[root - 1].aux != 6) {
                if (lw_hoist_type(w, root) > 0) ok = 1;
            }
            if (!ok) break;
            if (nc >= 8) { w->aborted = 1; return -1; }
            chain[nc] = root;
            nc++;
            if (w->m->exprs[root - 1].kind != TK_CALL
                || w->m->exprs[root - 1].op != 2)
                break;
            lvl = root;
        }
        if (nc > 0) {
            if (!top) {
                /* the emitter rejects a nested receiver that needs a temp */
                if (getenv("CT_LIR_DEBUG"))
                    fprintf(stderr, "lir: hoist nested at line %d\n",
                            w->m->exprs[lvl - 1].span.line);
                lw_abort(w, "L4540");
                return -1;
            }
            for (i = nc - 1; i >= 0; i--) {
                int hty = lw_hoist_type(w, chain[i]);
                /* A function-pointer call's TIR type is the field's pointer
                   type; a `T (*name)(...)` temp declaration is not the C a
                   value declaration takes, so this shape stays on AST. */
                if (hty > 0 && strstr(lmod_cspell(w->l, hty), "(*)")) {
                    lw_abort(w, "Lhoistfnptr");
                    return -1;
                }
                {
                    int temp = lmod_new_temp(w->l, LTK_TMP, hty,
                                             w->hoist_block);
                    if (temp <= 0) { w->hard = 1; return -1; }
                    if (lw_hoist_add(w, chain[i], temp) != 0
                        || lw_hoist_entry(w, 2, temp, chain[i], hty, 0, 0) != 0) {
                        w->hard = 1;
                        return -1;
                    }
                }
            }
        }
    }
    for (i = 0; i < t->nkids; i++)
        if (lw_hoist_scan(w, t->kids[i], 0) != 0) return -1;
    return 0;
}

static int lw_expr(struct Lower *w, int teid);

/* A closure binding is not a C variable: later uses expand to the trampoline
   plus its stack environment (D21-14). */
static int lw_closure_var(struct Lower *w, const char *name)
{
    int i;

    if (!name || !name[0]) return -1;
    for (i = w->cv_n - 1; i >= 0; i--)
        if (w->cv_name[i] && strcmp(w->cv_name[i], name) == 0) return w->cv_ci[i];
    return -1;
}

static int lw_closure_register(struct Lower *w, const char *name, int ci)
{
    if (w->cv_n >= 64) return -1;
    w->cv_name[w->cv_n] = runtime::text::ct_intern(name ? name : "");
    w->cv_ci[w->cv_n] = ci;
    w->cv_n++;
    return 0;
}

static int lw_closure_arg(struct Lower *w, struct ct_texpr *t, int for_pair)
{
    int e;

    if (for_pair) {
        e = lmod_new_expr(w->l, LE_CLOSURE_PAIR, t->span.file, t->span.line,
                          t->span.col);
        if (e > 0) w->l->exprs[e - 1].num = lw_closure_var(w, t->text);
    } else {
        e = lmod_new_expr(w->l, LE_CLOSURE_ARG, t->span.file, t->span.line,
                          t->span.col);
        if (e > 0) {
            w->l->exprs[e - 1].num = t->num;
            w->l->exprs[e - 1].text = t->text;
        }
    }
    if (e <= 0) { w->hard = 1; return 0; }
    return e;
}

/* One call actual: a closure literal fills two C slots, a closure binding
   fills the same two from its stack instance, everything else is one. */
static int lw_expr_actual(struct Lower *w, int teid)
{
    struct ct_texpr *t;

    if (teid <= 0 || teid > w->m->nexprs) return 0;
    t = &w->m->exprs[teid - 1];
    if (t->kind == TK_CLOSURE) return lw_closure_arg(w, t, 0);
    if (t->kind == TK_NAME_LOCAL && lw_closure_var(w, t->text) >= 0)
        return lw_closure_arg(w, t, 1);
    return lw_expr(w, teid);
}

static int lw_expr_kid(struct Lower *w, int parent, int kid)
{
    int e;

    if (kid <= 0) return 0;
    e = lw_expr(w, kid);
    if (e <= 0) return -1;
    return lmod_expr_add_kid(w->l, parent, e);
}

static int lw_call_name(struct Lower *w, struct ct_texpr *t)
{
    if (t->target_kind == RT_DIRECT && t->target_a > 0
        && t->target_a <= w->m->ndecls)
        return t->target_a;
    return 0;
}

static int lw_expr(struct Lower *w, int teid)
{
    int r;
    if (w->expr_depth > 400) {
        lw_abort(w, "Ldepth");
        return 0;
    }
    w->expr_depth++;
    r = lw_expr_body(w, teid);
    w->expr_depth--;
    return r;
}

/* Depth guard: a TIR row that (directly or through a malformed kid cycle)
   points back into itself would recurse forever; refuse the function instead
   of crashing the compiler. 400 is far above any source nesting. */
static int lw_expr_body(struct Lower *w, int teid)
{
    struct ct_texpr *t;
    int e, i;

    if (teid <= 0 || teid > w->m->nexprs) { lw_abort(w, "L366"); return 0; }
    t = &w->m->exprs[teid - 1];
    if (t->nkids > 0 && !t->kids) { lw_abort(w, "Lkids"); return 0; }
    if (t->kind == TK_INTO_TARGET || t->kind == TK_INTO_SELF) {
        /* A multi-segment `into` chain materialises one receiver per segment
           plus the suffix rewrite; the lowerer currently drops segments, so
           the function stays on the AST body seam (S8 diff list #157). */
        lw_abort(w, "Linto");
        return 0;
    }
    if (teid != w->bypass_te && t->kind != TK_INTO_TARGET) {
        int ht = lw_hoist_lookup(w, teid);
        if (ht > 0) {
            e = lmod_new_expr(w->l, LE_TEMP, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            /* an `into` that addressed its receiver in place is read as the
               value: `(*__ct_recvN)`; every other temp prints as itself. */
            w->l->exprs[e - 1].num = ht;
            w->l->exprs[e - 1].op = (t->kind == TK_INTO_TARGET && t->aux == 2)
                                    ? 1 : 0;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            return e;
        }
    }
    switch (t->kind) {
        case TK_LITERAL:
            if (t->op == 1) e = lmod_new_expr(w->l, LE_NUM, t->span.file,
                                             t->span.line, t->span.col);
            else if (t->op == 2) e = lmod_new_expr(w->l, LE_FNUM, t->span.file,
                                                   t->span.line, t->span.col);
            else { lw_abort(w, "L374"); return 0; }
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].num = t->num;
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            return e;
        case TK_STRING_LIT:
            /* PH-80: a literal bound to `String` / `Str` becomes the matching
               handle; the emitter's shapes are two compound literals the LIR
               carries as their own kind. */
            e = lmod_new_expr(w->l, LE_STRLIT, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].op = t->op;
            w->l->exprs[e - 1].num = t->num;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            return e;
        case TK_NAME_LOCAL:
        case TK_NAME_GLOBAL:
            e = lmod_new_expr(w->l, LE_NAME, t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            if (t->member && t->member[0])
                w->l->exprs[e - 1].text = t->member;
            if (t->kind == TK_NAME_LOCAL && t->text
                && strcmp(t->text, "self") == 0 && w->func_has_self)
                w->l->exprs[e - 1].text = "_self";
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            if (t->text && strcmp(t->text, "$") == 0) {
                /* the range initialiser's index placeholder */
                w->l->exprs[e - 1].kind = LE_RANGEK;
                return e;
            }
            if (t->kind == TK_NAME_LOCAL
                && ((t->target_kind == RT_VAR && t->target_a > 0
                     && t->target_a <= w->m->nvars
                     && w->m->vars[t->target_a - 1].is_ref)
                    || lw_name_is_ref(w, t->text))) {
                int d = lmod_new_expr(w->l, LE_DEREF, t->span.file, t->span.line,
                                      t->span.col);
                if (d <= 0) { w->hard = 1; return 0; }
                w->l->exprs[d - 1].type = w->l->exprs[e - 1].type;
                if (lmod_expr_add_kid(w->l, d, e) != 0) { w->hard = 1; return 0; }
                return d;
            }
            return e;
        case TK_FIELD:
            if (!t->text || !t->text[0] || t->nkids < 1) { lw_abort(w, "L394"); return 0; }
            /* An impl body writes `self.n`, but the C receiver is the
               `_self` pointer, so the emitter turns that access into
               `_self->n`. The TIR row keeps the source operator (`.`), so the
               lowerer has to make the same pointer decision here. */
            {
                int arrow = t->op == 2;
                if (!arrow && w->func_has_self && t->kids[0] > 0
                    && t->kids[0] <= w->m->nexprs
                    && w->m->exprs[t->kids[0] - 1].kind == TK_NAME_LOCAL
                    && w->m->exprs[t->kids[0] - 1].text
                    && strcmp(w->m->exprs[t->kids[0] - 1].text, "self") == 0)
                    arrow = 1;
                e = lmod_new_expr(w->l, arrow ? LE_ARROW : LE_FIELD,
                                  t->span.file, t->span.line, t->span.col);
            }
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            if (lw_expr_kid(w, e, t->kids[0]) != 0) return 0;
            return e;
        case TK_INDEX:
        case TK_DEREF:
        case TK_ADDR:
            /* SH-96 / emit_ref_arg: `inc(vec[i])` passes the element place.
               The subscription sugar is a `Vec.get` call in TIR; the emitter
               rewrites it to `Vec.at` (which already returns a pointer) and
               adds no `&`. The lowerer has to make the same call, or the C
               would be `&Vec_int_get(...)` -- the address of an int rvalue. */
            if (t->kind == TK_ADDR && t->nkids >= 1) {
                struct ct_texpr *kc = &w->m->exprs[t->kids[0] - 1];
                if (kc->kind == TK_CALL && kc->text
                    && strcmp(kc->text, "get") == 0
                    && kc->target_key && strncmp(kc->target_key, "Vec", 3) == 0) {
                    int kid = lw_expr(w, t->kids[0]);
                    struct ct_lexpr *le;
                    size_t nl;

                    if (kid <= 0) return 0;
                    le = &w->l->exprs[kid - 1];
                    nl = le->text ? strlen(le->text) : 0;
                    if (le->kind == LE_MCALL && nl > 4
                        && strcmp(le->text + nl - 4, "_get") == 0) {
                        const char *nn = runtime::text::ct_internf("%.*s_at",
                                                                   (int)(nl - 4),
                                                                   le->text);
                        if (!nn) { w->hard = 1; return 0; }
                        le->text = nn;
                        return kid;
                    }
                    /* not the expected shape: fall back to the safe wrap by
                       building a fresh LE_ADDR around the lowered child */
                    e = lmod_new_expr(w->l, LE_ADDR, t->span.file, t->span.line,
                                      t->span.col);
                    if (e <= 0) { w->hard = 1; return 0; }
                    w->l->exprs[e - 1].type = lw_type(w, t->type);
                    if (lmod_expr_add_kid(w->l, e, kid) != 0) { w->hard = 1; return 0; }
                    return e;
                }
            }
        case TK_UNARY:
        case TK_CAST:
            if (t->kind == TK_INDEX) e = lmod_new_expr(w->l, LE_INDEX, t->span.file,
                                                       t->span.line, t->span.col);
            else if (t->kind == TK_DEREF) e = lmod_new_expr(w->l, LE_DEREF, t->span.file,
                                                            t->span.line, t->span.col);
            else if (t->kind == TK_ADDR) e = lmod_new_expr(w->l, LE_ADDR, t->span.file,
                                                           t->span.line, t->span.col);
            else if (t->kind == TK_UNARY) e = lmod_new_expr(w->l, LE_UNARY, t->span.file,
                                                            t->span.line, t->span.col);
            else e = lmod_new_expr(w->l, LE_CAST, t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            w->l->exprs[e - 1].op = t->op;
            if (t->kind == TK_CAST) {
                if (!t->text || !t->text[0]) { lw_abort(w, "L420"); return 0; }
                w->l->exprs[e - 1].text = t->text;
            }
            for (i = 0; i < t->nkids; i++)
                if (lw_expr_kid(w, e, t->kids[i]) != 0) return 0;
            return e;
        case TK_BINARY:
        case TK_ASSIGN:
        case TK_TERNARY:
            if (t->nkids < 2) { lw_abort(w, "L429"); return 0; }
            if (t->kind == TK_BINARY) e = lmod_new_expr(w->l, LE_BINARY, t->span.file,
                                                        t->span.line, t->span.col);
            else if (t->kind == TK_ASSIGN) e = lmod_new_expr(w->l, LE_ASSIGN, t->span.file,
                                                             t->span.line, t->span.col);
            else e = lmod_new_expr(w->l, LE_TERN, t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            w->l->exprs[e - 1].op = t->op;
            for (i = 0; i < t->nkids; i++)
                if (lw_expr_kid(w, e, t->kids[i]) != 0) return 0;
            return e;
        case TK_POSTFIX:
        case TK_PREFIX:
            if (t->nkids < 1) { lw_abort(w, "L443"); return 0; }
            e = lmod_new_expr(w->l, t->kind == TK_POSTFIX ? LE_POST : LE_PRE,
                              t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            w->l->exprs[e - 1].op = t->op;
            if (lw_expr_kid(w, e, t->kids[0]) != 0) return 0;
            return e;
        case TK_CALL:
        case TK_INTRINSIC:
            if (lw_closure_var(w, t->text) >= 0) {
                /* `f(args)` on a closure binding: the trampoline plus its
                   stack environment, then the actuals (D21-14). */
                e = lmod_new_expr(w->l, LE_CLOSURE_CALL, t->span.file,
                                  t->span.line, t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].num = lw_closure_var(w, t->text);
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                for (i = 0; i < t->nkids; i++) {
                    int kid = lw_expr_actual(w, t->kids[i]);
                    if (kid <= 0) return 0;
                    if (lmod_expr_add_kid(w->l, e, kid) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
                return e;
            }
            if (t->target_kind == RT_VIRTUAL && t->nkids >= 1) {
                /* dynamic dispatch: the receiver must be a stable place, or
                   the emitter would have hoisted it into a temp first, which
                   this stage does not model. */
                int rk = w->m->exprs[t->kids[0] - 1].kind;
                int trait_len = 0;
                if (lw_hoist_lookup(w, t->kids[0]) <= 0
                    && rk != TK_NAME_LOCAL && rk != TK_NAME_GLOBAL
                    && rk != TK_FIELD && rk != TK_INDEX
                    && rk != TK_CALL && rk != TK_INTRINSIC
                    && rk != TK_INTO_SELF && rk != TK_INTO_TARGET) {
                    lw_abort(w, "L4530");
                    return 0;
                }
                if (!t->target_key) { lw_abort(w, "L4531"); return 0; }
                while (t->target_key[trait_len] && t->target_key[trait_len] != '.')
                    trait_len++;
                if (trait_len == 0) { lw_abort(w, "L4532"); return 0; }
                e = lmod_new_expr(w->l, LE_VMCALL, t->span.file, t->span.line,
                                  t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].text = t->text;
                w->l->exprs[e - 1].member =
                    runtime::text::ct_intern_len(t->target_key, trait_len);
                w->l->exprs[e - 1].op = t->aux;
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                for (i = 0; i < t->nkids; i++) {
                    int kid = lw_expr_actual(w, t->kids[i]);
                    {
                        int base = (t->aux == 11 && t->target_kind != RT_VIRTUAL) ? 0 : 1;
                        if (i >= base) kid = lw_actual_ref(w, t, kid, i - base);
                    }
                    if (kid <= 0) return 0;
                    if (lmod_expr_add_kid(w->l, e, kid) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
                return e;
            }
            if (t->target_kind == RT_INDIRECT && (t->op == 2 || t->op == 3)) {
                /* `p(args)` through a function pointer prints `(*p)(args)`;
                   a callee expression prints `<expr>(args)` and its first
                   child is that callee. */
                e = lmod_new_expr(w->l, t->op == 2 ? LE_FNCALL : LE_CALLEXPR,
                                  t->span.file, t->span.line, t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].text = t->text;
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                for (i = 0; i < t->nkids; i++) {
                    int kid = lw_expr_actual(w, t->kids[i]);
                    if (kid <= 0) return 0;
                    if (lmod_expr_add_kid(w->l, e, kid) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
                return e;
            }
            if (t->target_kind == RT_BUILTIN && t->op == 2
                && (t->aux == 9 || t->aux == 10 || t->aux == 11)) {
                /* an inherent method of a concrete/instantiated struct is a
                   plain C call named `<Type>_<method>`; the receiver is the
                   first actual (`.` takes its address, `->` passes it). */
                char nm[512];
                int j = 0;
                const char *k = t->target_key;
                if (!k || !k[0]) { lw_abort(w, "L4533"); return 0; }
                while (*k && j < (int)sizeof(nm) - 1) {
                    nm[j++] = *k == '.' ? '_' : *k;
                    k++;
                }
                nm[j] = 0;
                e = lmod_new_expr(w->l, LE_MCALL, t->span.file, t->span.line,
                                  t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].text = runtime::text::ct_intern(nm);
                w->l->exprs[e - 1].op = t->aux;
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                for (i = 0; i < t->nkids; i++) {
                    int kid = lw_expr_actual(w, t->kids[i]);
                    {
                        int base = (t->aux == 11 && t->target_kind != RT_VIRTUAL) ? 0 : 1;
                        if (i >= base) kid = lw_actual_ref(w, t, kid, i - base);
                    }
                    if (kid <= 0) return 0;
                    if (lmod_expr_add_kid(w->l, e, kid) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
                return e;
            }
            if (t->op == 2 && t->target_kind == RT_DIRECT) {
                /* An inherent method of a concrete / instantiated struct:
                   `find_func` resolved `<Type>.<method>`, and the emitter
                   prints a plain `<Struct>_<method>` call whose receiver is
                   the first actual (`.` takes its address, `->` passes the
                   pointer, a static method has no receiver). */
                char nm[1024];
                int j = 0;
                const char *k = t->target_key;
                if (!k || !k[0]) { lw_abort(w, "L4533"); return 0; }
                while (*k && j < (int)sizeof(nm) - 1) {
                    nm[j++] = *k == '.' ? '_' : *k;
                    k++;
                }
                nm[j] = 0;
                e = lmod_new_expr(w->l, LE_MCALL, t->span.file, t->span.line,
                                  t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].text = runtime::text::ct_intern(nm);
                w->l->exprs[e - 1].op = t->aux;
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                for (i = 0; i < t->nkids; i++) {
                    int kid = lw_expr_actual(w, t->kids[i]);
                    {
                        int base = (t->aux == 11 && t->target_kind != RT_VIRTUAL) ? 0 : 1;
                        if (i >= base) kid = lw_actual_ref(w, t, kid, i - base);
                    }
                    if (kid <= 0) return 0;
                    if (lmod_expr_add_kid(w->l, e, kid) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
                return e;
            }
            if (t->op != 1) {
                lw_abort(w, "L453");
                return 0;
            }
            e = lmod_new_expr(w->l, t->kind == TK_CALL ? LE_CALL : LE_INTRINSIC,
                              t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            if (t->target_kind == RT_DIRECT) {
                int d = lw_call_name(w, t);
                if (d <= 0) { lw_abort(w, "L459"); return 0; }
                {
                    struct ct_tdecl *cd = &w->m->decls[d - 1];
                    w->l->exprs[e - 1].text = runtime::text::ct_intern(
                        (cd->cname && cd->cname[0]) ? cd->cname : cd->name);
                }
            } else if (t->target_kind == RT_INTRINSIC || t->target_kind == RT_BUILTIN) {
                /* BI_EXTERNAL / BI_IO / BI_ALLOC print as their own name; the
                   string / container / retain / release builtins expand to a
                   recipe and are not in the S2 subset */
                if (t->target_kind == RT_INTRINSIC
                    && t->target_b != 1 && t->target_b != 2
                    && t->target_b != 3 && t->target_b != 4
                    && t->target_b != 5 && t->target_b != 7
                    && t->target_b != 8) {
                    /* BI_STRING (4), BI_CONTAINER (5), BI_RETAIN (7) and
                       BI_RELEASE (8) all name a C symbol of the product (a
                       libc function, a built-in layer function, or a
                       monomorphised `...__ctN`), so they print as their own
                       name. Only the recipe classes need an expansion the
                       LIR does not carry yet. */
                    if (getenv("CT_LIR_DEBUG"))
                        fprintf(stderr, "lir: L467 b=%d key=%s text=%s\n",
                                t->target_b, t->target_key ? t->target_key : "",
                                t->text ? t->text : "");
                    lw_abort(w, "L467");
                    return 0;
                }
                w->l->exprs[e - 1].text = (t->target_key && t->target_key[0])
                                              ? t->target_key : t->text;
                if (w->l->exprs[e - 1].text
                    && strncmp(w->l->exprs[e - 1].text, "__ct_", 5) == 0
                    && strncmp(w->l->exprs[e - 1].text, "__ct_atomic_", 12) != 0) {
                    /* an emitter-injected helper / intrinsic prologue: its C
                       is not a row of the program being printed. The atomic
                       family is different: the emitter writes those as
                       `static inline` definitions in the same product, so a
                       call to one is a call to a real symbol. */
                    lw_abort(w, "L520");
                    return 0;
                }
            } else {
                lw_abort(w, "L473");
                return 0;
            }
            if (!w->l->exprs[e - 1].text || !w->l->exprs[e - 1].text[0]) {
                lw_abort(w, "L477");
                return 0;
            }
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            for (i = 0; i < t->nkids; i++) {
                int kid = lw_expr_actual(w, t->kids[i]);
                if (kid <= 0) return 0;
                if ((t->target_kind == RT_DIRECT
                     && lw_decl_param_ref(w, lw_call_name(w, t), i))
                    || (t->target_kind != RT_DIRECT
                        && lw_method_param_ref(w, t, i))) {
                    /* the emitter writes `&` + actual for a ref/out formal,
                       except for a `Vec` subscription: `emit_ref_arg` turns
                       `Vec.get` into `Vec.at`, which already answers a
                       pointer (SH-96). Mirror that here. */
                    struct ct_lexpr *kk = &w->l->exprs[kid - 1];
                    size_t nl = kk->text ? strlen(kk->text) : 0;
                    int need_ref = 1;
                    if (kk->kind == LE_MCALL && nl > 4
                        && strncmp(kk->text, "Vec_", 4) == 0
                        && strcmp(kk->text + nl - 4, "_get") == 0) {
                        const char *nn = runtime::text::ct_internf(
                            "%.*s_at", (int)(nl - 4), kk->text);
                        if (!nn) { w->hard = 1; return 0; }
                        kk->text = nn;
                        need_ref = 0;
                    }
                    if (need_ref) {
                        int aref = lmod_new_expr(w->l, LE_REF, t->span.file,
                                                 t->span.line, t->span.col);
                        if (aref <= 0) { w->hard = 1; return 0; }
                        w->l->exprs[aref - 1].type = w->l->exprs[kid - 1].type;
                        if (lmod_expr_add_kid(w->l, aref, kid) != 0) {
                            w->hard = 1;
                            return 0;
                        }
                        kid = aref;
                    }
                }
                if (lmod_expr_add_kid(w->l, e, kid) != 0) { w->hard = 1; return 0; }
            }
            return e;
        case TK_INIT_RANGE:
        case TK_INIT_BRACE:
        case TK_INIT_MBRACE: {
            int kind = t->kind == TK_INIT_RANGE ? LE_INIT_RANGE
                     : (t->kind == TK_INIT_BRACE ? LE_INIT_BRACE
                                                 : LE_INIT_MBRACE);
            if (lw_spelling_by_value(backend::tir::tmod_cspell(w->m, t->type))
                && lw_spelling_glue(w, backend::tir::tmod_cspell(w->m, t->type), 0)) {
                lw_abort(w, "Lglueinit");
                return 0;
            }
            e = lmod_new_expr(w->l, kind, t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].member = t->target_key;
            w->l->exprs[e - 1].num = t->num;
            w->l->exprs[e - 1].op = t->aux;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            for (i = 0; i < t->nkids; i++)
                if (lw_expr_kid(w, e, t->kids[i]) != 0) return 0;
            return e;
        }
        case TK_BOX:
            if (t->aux & 4) {
                /* SH-20 namespace host: the emitter resolves the `Trait::ns`
                   value against the map table and reports the missing map;
                   the lowerer has no map lookup, so the body stays on AST. */
                lw_abort(w, "Lnsmap");
                return 0;
            }
            e = lmod_new_expr(w->l, LE_BOX, t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;    /* trait */
            w->l->exprs[e - 1].member = t->member; /* struct */
            w->l->exprs[e - 1].op = t->aux;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            if (t->nkids >= 1) {
                int kid = lw_expr(w, t->kids[0]);
                if (kid <= 0) return 0;
                if (lmod_expr_add_kid(w->l, e, kid) != 0) { w->hard = 1; return 0; }
            }
            return e;
        case TK_NEWOBJ: {
            char buf[512];
            int k = w->l->tmp_next;
            /* `new T { … }` feeds a raw brace initialiser whose owning
               fields need the emitter's rewrite; keep that shape on AST. */
            if ((t->member && lw_struct_has_owning_field(w, t->member))
                || (t->nkids >= 1
                    && lw_struct_has_owning_field(w,
                           backend::tir::tmod_cspell(w->m,
                               w->m->exprs[t->kids[0] - 1].type)))) {
                lw_abort(w, "Lnewinit");
                return 0;
            }
            int kid;
            w->l->tmp_next++;
            e = lmod_new_expr(w->l, LE_NEWOBJ, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;     /* struct name */
            w->l->exprs[e - 1].member = t->member; /* payload type */
            w->l->exprs[e - 1].op = k;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            if (t->nkids >= 1) {
                kid = lw_expr(w, t->kids[0]);
                if (kid <= 0) return 0;
                if (lmod_expr_add_kid(w->l, e, kid) != 0) { w->hard = 1; return 0; }
            }
            (void)buf;
            return e;
        }
        case TK_RAW:
            if (!t->text || !t->text[0]) { lw_abort(w, "L485"); return 0; }
            /* a raw ADT constructor / brace value carries the emitter's
               payload retain rewrite; keep that shape on AST */
            {
                char atag[512];
                const char *asp = backend::tir::tmod_cspell(w->m, t->type);
                if ((asp
                     && lw_spelling_tag(asp, atag, (int)sizeof(atag)) == 0
                     && lw_adt_owns(w, atag, 0))
                    || (t->text && strstr(t->text, "){ .tag = ")
                        && strstr(t->text, ".u = {"))) {
                    if (lw_raw_adt_place_p(t->text)) {
                        lw_abort(w, "Ladtraw");
                        return 0;
                    }
                }
            }
            e = lmod_new_expr(w->l, LE_RAW, t->span.file, t->span.line, t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            return e;
        case TK_OPTIONAL_CHAIN: {
            /* `?.`: `(<recv> ? <recv>->f : 0)`, with the hoisted temp where
               the receiver is not a stable place. The receiver prints its
               real expression inside the conditional's assignment, so the
               hoist map must not replace it here. */
            int temp = t->nkids >= 1 ? lw_hoist_lookup(w, t->kids[0]) : 0;
            int saved = w->bypass_te;
            e = lmod_new_expr(w->l, LE_OPT, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            if (temp > 0) w->bypass_te = t->kids[0];
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].op = t->aux;
            w->l->exprs[e - 1].num = (long)temp;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            for (i = 0; i < t->nkids; i++)
                if (lw_expr_kid(w, e, t->kids[i]) != 0) { w->bypass_te = saved; return 0; }
            w->bypass_te = saved;
            return e;
        }
        case TK_INTO_TARGET: {
            /* the promoted receiver; the declaration and the spliced block
               were emitted at the statement head. */
            int temp = lw_hoist_into_lookup(w, (int)t->num);
            if (temp <= 0) { lw_abort(w, "L7630"); return 0; }
            e = lmod_new_expr(w->l, LE_TEMP, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].num = temp;
            w->l->exprs[e - 1].op = t->aux == 2 ? 1 : 0;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            return e;
        }
        case TK_INTO_SELF: {
            int owner = (int)t->num;
            int temp = lw_hoist_into_lookup(w, owner);
            if (temp <= 0) { lw_abort(w, "L7640"); return 0; }
            e = lmod_new_expr(w->l, LE_TEMP, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].num = temp;
            if (t->aux == 1) w->l->exprs[e - 1].op = 0;
            else if (lw_hoist_into_cat(w, owner) == 2)
                w->l->exprs[e - 1].op = 1;
            else w->l->exprs[e - 1].op = 0;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            return e;
        }
        case TK_ADT_CTOR: {
            struct ct_tadt *a = lw_adt_row(w, t->text);
            struct ct_tadvariant *v;
            if (!a || t->num < 0 || t->num >= a->nvariants) {
                lw_abort(w, "L7810");
                return 0;
            }
            v = &a->variants[(int)t->num];
            e = lmod_new_expr(w->l, LE_ADTCTOR, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = a->full;
            w->l->exprs[e - 1].num = t->num;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            for (i = 0; i < t->nkids; i++) {
                const char *ft = i < v->nfields ? v->fields[i].type : "";
                int owns = lw_is_string_value(ft) != 0
                        || lw_own_kind(w, ft) != 0
                        || lw_spelling_container(ft);
                if (owns) {
                    int ak = w->m->exprs[t->kids[i] - 1].kind;
                    if (ak == TK_NAME_LOCAL || ak == TK_NAME_GLOBAL
                        || ak == TK_FIELD || ak == TK_INDEX) {
                        /* an owning payload stored from a place needs the
                           emitter's retain; not modelled */
                        lw_abort(w, "L7811");
                        return 0;
                    }
                }
                if (lw_expr_kid(w, e, t->kids[i]) != 0) return 0;
            }
            return e;
        }
        case TK_MATCH_ARM: {
            struct ct_tadt *a = lw_adt_row(w, t->text);
            int temp, j, ext;
            if (!a) { lw_abort(w, "L7820"); return 0; }
            /* v1-PH-2 S5: a guard turns the match into the flag-arm shape
               (`__ct_matchedK`); an or-pattern alone keeps the if/else chain
               with a grouped condition. */
            ext = 0;
            for (j = 1; j < t->nkids; j++)
                if (w->m->stmts[t->kids[j] - 1].guard >= 0) ext = 1;
            temp = lmod_new_temp(w->l, LTK_MATCH, lw_type(w, t->type),
                                 w->hoist_block);
            if (temp <= 0) { w->hard = 1; return 0; }
            e = lmod_new_expr(w->l, LE_MATCHEXPR, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = a->full;
            w->l->exprs[e - 1].member = t->member;   /* result type spelling */
            w->l->exprs[e - 1].op = t->aux | (ext ? 2 : 0);
            w->l->exprs[e - 1].num = temp;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            {
                int sub = lw_expr(w, t->kids[0]);
                if (sub <= 0) return 0;
                if (lmod_expr_add_kid(w->l, e, sub) != 0) { w->hard = 1; return 0; }
            }
            {
                char *cacc;
                int clen, ccap;
                cacc = (char *)0;
                clen = 0;
                ccap = 0;
                for (j = 1; j < t->nkids; j++) {
                    struct ct_tstmt *arm = &w->m->stmts[t->kids[j] - 1];
                    int blk;
                    if (lw_conds_put(&cacc, &clen, &ccap, arm->text2) != 0) {
                        free(cacc);
                        w->hard = 1;
                        return 0;
                    }
                    blk = lw_match_arm_block(w, t->kids[j], temp, 1, 0,
                                             ext, (t->nkids - 1 > 1) ? 1 : 0);
                    if (blk <= 0) {
                        free(cacc);
                        lw_abort(w, "L7821");
                        return 0;
                    }
                    if (lmod_expr_add_kid(w->l, e, (int)arm->num) != 0
                        || lmod_expr_add_kid(w->l, e, blk) != 0) {
                        free(cacc);
                        w->hard = 1;
                        return 0;
                    }
                }
                w->l->exprs[e - 1].extra = runtime::text::ct_intern(
                    cacc ? cacc : "");
                free(cacc);
            }
            return e;
        }
        case TK_CLOSURE:
            return lw_closure_arg(w, t, 0);
        case TK_TRY_EXPR: {
            /* postfix `?`: a statement expression carrying the failure edge.
               The value / error spellings come from the Result instance the
               operand names; the failure returns the *enclosing* function's
               Result instance through its generated `<tag>_err`. */
            const char *otag, *rtag, *vty, *ety, *rerr;
            int temp;
            if (lw_func_has_cleanup(w, w->func_scope)) {
                lw_abort(w, "L7700");
                return 0;
            }
            otag = lw_result_tag(w, t->text);
            if (!otag[0]) { lw_abort(w, "L7701"); return 0; }
            if (!w->ret_type) { lw_abort(w, "L7702"); return 0; }
            rtag = lw_result_tag(w, lmod_cspell(w->l, w->ret_type));
            if (!rtag[0]) { lw_abort(w, "L7703"); return 0; }
            vty = lw_struct_field_type(w, otag, "value");
            ety = lw_struct_field_type(w, otag, "err");
            rerr = lw_struct_field_type(w, rtag, "err");
            if (!vty[0] || !ety[0] || !rerr[0]
                || strcmp(ety, rerr) != 0) {
                lw_abort(w, "L7704");
                return 0;
            }
            temp = lmod_new_temp(w->l, LTK_Q,
                                 lmod_type(w->l, t->text ? t->text : ""),
                                 w->hoist_block);
            if (temp <= 0) { w->hard = 1; return 0; }
            e = lmod_new_expr(w->l, LE_TRY, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].num = temp;
            w->l->exprs[e - 1].text = runtime::text::ct_intern(
                t->text ? t->text : "");        /* operand Result spelling */
            w->l->exprs[e - 1].member = rtag;   /* return Result tag */
            if (lw_expr_kid(w, e, t->kids[0]) != 0) return 0;
            /* value / err field spellings ride the two spare text slots of
               the statement-expression kind via the type table names. */
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            w->l->exprs[e - 1].op = 0;
            w->l->exprs[e - 1].extra =
                runtime::text::ct_internf("%s\n%s", vty, ety);
            return e;
        }
        case TK_SLICE: {
            /* P-7.2 slice forms: index (`__ct_slice_at`), get (`__ct_slice_get`)
               and range (`__ct_slice_range`, or the plain `{ptr,len}` pair for
               a whole-array view). `op` is the form, `num` the range's view. */
            e = lmod_new_expr(w->l, LE_SLICE, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].op = t->op;
            w->l->exprs[e - 1].num = (long)t->aux;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            for (i = 0; i < t->nkids; i++)
                if (lw_expr_kid(w, e, t->kids[i]) != 0) return 0;
            return e;
        }
        case TK_COMPOUND: {
            /* `(type){ … }`: the braces are the captured initialiser the same
               writer a declaration uses would print, so a trait-carrying
               struct gets its vptr items before the closing brace. */
            const char *csp = backend::tir::tmod_cspell(w->m, t->type);
            if (lw_spelling_by_value(csp)
                && lw_spelling_glue(w, csp, 0)) {
                lw_abort(w, "Lgluecompound");
                return 0;
            }
            {
                char atag[512];
                int adt_owns = lw_spelling_tag(csp, atag, (int)sizeof(atag)) == 0
                               && lw_adt_owns(w, atag, 0);
                const char *rewritten = 0;
                int rw_kid = -1;
                if (adt_owns || lw_spelling_container(csp)) {
                    for (i = 0; i < t->nkids; i++) {
                        struct ct_texpr *ck = &w->m->exprs[t->kids[i] - 1];
                        if (ck->kind != TK_RAW || !ck->text) continue;
                        if (lw_spelling_container(csp)) {
                            const char *rw = lw_rewrite_struct_init(
                                w, csp, ck->text, (int)strlen(ck->text));
                            if (!rw) { lw_abort(w, "Lcompoundinit"); return 0; }
                            if (strcmp(rw, ck->text) != 0) {
                                /* owning field from a place: the rewritten
                                   text carries the retain */
                                rewritten = rw;
                                rw_kid = i;
                                continue;
                            }
                        }
                        if (lw_raw_adt_place_p(ck->text)
                            || (lw_struct_has_any_owning_field(w, csp)
                                && lw_raw_has_place_item(ck->text))) {
                            /* an owning payload handed over from a place; the
                               emitter's retain rewrite is not modelled here.
                               A place in a non-owning payload (e.g.
                               `Result<int, Str>`) moves/borrows and is fine. */
                            lw_abort(w, "Lcompoundplace");
                            return 0;
                        }
                    }
                }
                e = lmod_new_expr(w->l, LE_COMPOUND, t->span.file, t->span.line,
                                  t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].text = t->text;
                w->l->exprs[e - 1].op = t->op;
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                for (i = 0; i < t->nkids; i++) {
                    if (i == rw_kid) {
                        int ke = lmod_new_expr(w->l, LE_RAW, t->span.file,
                                               t->span.line, t->span.col);
                        if (ke <= 0) { w->hard = 1; return 0; }
                        w->l->exprs[ke - 1].text = rewritten;
                        w->l->exprs[ke - 1].type =
                            lw_type(w, w->m->exprs[t->kids[i] - 1].type);
                        if (lmod_expr_add_kid(w->l, e, ke) != 0) {
                            w->hard = 1; return 0;
                        }
                    } else if (lw_expr_kid(w, e, t->kids[i]) != 0) {
                        return 0;
                    }
                }
                return e;
            }
        }
        case TK_SIZEOF:
            if (t->target_key && t->target_key[0]) {
                e = lmod_new_expr(w->l, LE_OFFSETOF, t->span.file, t->span.line,
                                  t->span.col);
                if (e <= 0) { w->hard = 1; return 0; }
                w->l->exprs[e - 1].text = t->text;
                w->l->exprs[e - 1].member = t->target_key;
                w->l->exprs[e - 1].type = lw_type(w, t->type);
                return e;
            }
            e = lmod_new_expr(w->l, LE_SIZEOF, t->span.file, t->span.line,
                              t->span.col);
            if (e <= 0) { w->hard = 1; return 0; }
            w->l->exprs[e - 1].text = t->text;
            w->l->exprs[e - 1].op = t->op;
            w->l->exprs[e - 1].type = lw_type(w, t->type);
            if (t->nkids == 1 && lw_expr_kid(w, e, t->kids[0]) != 0) return 0;
            return e;
        default:
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: unsupported TExpr kind=%d ast=%ld\n",
                        t->kind, t->num);
            lw_abort(w, "L485");
            return 0;
    }
}

/* ------------------------------------------------------------------------- */
/* Blocks and cleanups                                                       */
/* ------------------------------------------------------------------------- */
static int lw_block_stmt(struct Lower *w, int tsid, int kind, int parent);

static int lw_push_loop(struct Lower *w, int block)
{
    if (w->nloops >= w->loopcap) {
        int cap = w->loopcap > 0 ? w->loopcap * 2 : 16;
        int *grown = (int *)realloc(w->loops, (size_t)cap * sizeof(*grown));
        if (!grown) { w->hard = 1; return -1; }
        w->loops = grown;
        w->loopcap = cap;
    }
    w->loops[w->nloops] = block;
    w->nloops++;
    return 0;
}

static int lw_loop_id(struct Lower *w)
{
    if (w->nloops <= 0) return 0;
    return w->loops[w->nloops - 1];
}

static int lw_push_break(struct Lower *w, int block)
{
    if (w->nbreaks >= w->breakcap) {
        int cap = w->breakcap > 0 ? w->breakcap * 2 : 16;
        int *grown = (int *)realloc(w->breaks, (size_t)cap * sizeof(*grown));
        if (!grown) { w->hard = 1; return -1; }
        w->breaks = grown;
        w->breakcap = cap;
    }
    w->breaks[w->nbreaks] = block;
    w->nbreaks++;
    return 0;
}

static int lw_break_id(struct Lower *w)
{
    if (w->nbreaks <= 0) return 0;
    return w->breaks[w->nbreaks - 1];
}

/* Collect the scope chain of one exit.
   - `stop` is the last scope to include (0 = stop before the function root);
   - `kind_limit` stops before a scope of this kind (SC_FUNC for returns). */
static int lw_chain(struct Lower *w, int scope, int stop_scope, int stop_kind,
                    int *out, int *nout)
{
    int n = 0;

    while (scope > 0) {
        if (stop_scope > 0 && scope == stop_scope) {
            if (n >= LX_MAX_CHAIN) { w->aborted = 1; return -1; }
            out[n] = scope;
            n++;
            break;
        }
        if (stop_kind > 0 && lw_scope_kind(w, scope) == stop_kind) break;
        if (n >= LX_MAX_CHAIN) { w->aborted = 1; return -1; }
        out[n] = scope;
        n++;
        if (stop_scope == 0 && stop_kind == 0) break;
        scope = lw_scope_parent(w, scope);
    }
    *nout = n;
    return 0;
}

static int lw_drop_base(struct Lower *w, struct ct_lcleanup *c, const char **base)
{
    int teid = c->body_stmt;

    *base = "";
    if (teid <= 0 || teid > w->m->nexprs) return -1;
    {
        int tid = w->m->exprs[teid - 1].type;
        const char *sp = backend::tir::tmod_cspell(w->m, tid);
        size_t n;
        if (strncmp(sp, "struct ", 7) == 0) sp += 7;
        n = strlen(sp);
        while (n > 0 && (sp[n - 1] == '*' || sp[n - 1] == ' ')) n--;
        *base = runtime::text::ct_intern_len(sp, (int)n);
        if (!*base) return -1;
        return 0;
    }
}

/* Materialise `chain` (inner -> outer) into statement ids. `edge` 1 is an
   error edge (errdefer runs); `all` 1 is the block-tail flush (no position
   filter). */
static int lw_materialise(struct Lower *w, int *chain, int nchain, int edge,
                          int line, int col, int all, int parent_block,
                          int *out, int *nout)
{
    int n = 0, ci, k;

    /* deferred entries first, layers inner -> outer, reverse source order */
    for (ci = 0; ci < nchain; ci++) {
        struct ct_lscope *s = &w->l->scopes[chain[ci] - 1];
        for (k = s->ncleanups - 1; k >= 0; k--) {
            struct ct_lcleanup *c = &w->l->cleanups[s->cleanups[k] - 1];
            int body, sid;
            if (c->kind != CL_DEFER && c->kind != CL_ERRDEFER) continue;
            if (edge == 0 && c->on_error) continue;
            if (lw_active(w, c, line, col, all) == 0) continue;
            if (n >= 64) { lw_abort(w, "L595"); return -1; }
            body = lw_block_stmt(w, c->body_stmt, LB_DEFER_BODY, parent_block);
            if (body <= 0) return -1;
            sid = lmod_new_stmt(w->l, c->kind == CL_ERRDEFER ? LS_ERRDEFER_RUN
                                                             : LS_DEFER_RUN,
                                c->span.file, c->span.line, c->span.col);
            if (sid <= 0) { w->hard = 1; return -1; }
            w->l->stmts[sid - 1].body_blk = body;
            w->l->stmts[sid - 1].aux = c->body_stmt;
            w->l->stmts[sid - 1].origin = c->id;
            out[n] = sid;
            n++;
        }
    }
    /* owned entries second, same layer order. The parser's `autodrop_append`
       already appends the release / handback deletes in reverse declaration
       order (the order they must run), and an explicit `delete` sits at its
       source position, so this table is walked forward -- reversing here would
       release the first-declared handle first. */
    for (ci = 0; ci < nchain; ci++) {
        struct ct_lscope *s = &w->l->scopes[chain[ci] - 1];
        for (k = 0; k < s->ncleanups; k++) {
            struct ct_lcleanup *c = &w->l->cleanups[s->cleanups[k] - 1];
            const char *base;
            int sid, ex, ty;
            if (c->kind != CL_DROP && c->kind != CL_RELEASE
                && c->kind != CL_HANDBACK) continue;
            if (lw_active(w, c, line, col, all) == 0) continue;
            if (n >= 64) { lw_abort(w, "L619"); return -1; }
            ex = lw_expr(w, c->body_stmt);
            if (ex <= 0) return -1;
            if (lw_drop_base(w, c, &base) != 0) { w->aborted = 1; return -1; }
            ty = lw_type(w, w->m->exprs[c->body_stmt - 1].type);
            sid = lmod_new_stmt(w->l, LS_DROP, c->span.file, c->span.line, c->span.col);
            if (sid <= 0) { w->hard = 1; return -1; }
            w->l->stmts[sid - 1].expr = ex;
            w->l->stmts[sid - 1].type = ty;
            w->l->stmts[sid - 1].name = base;
            w->l->stmts[sid - 1].aux = c->kind == CL_HANDBACK ? 1
                                     : (c->kind == CL_DROP ? 2 : 3);
            w->l->stmts[sid - 1].origin = c->id;
            w->l->stmts[sid - 1].err_edge = c->on_error;
            w->l->stmts[sid - 1].assignable = 1;
            out[n] = sid;
            n++;
        }
    }
    *nout = n;
    return 0;
}

static int lw_add_cleanups_to_stmt(struct Lower *w, int sid, int *ids, int n)
{
    int i;
    for (i = 0; i < n; i++)
        if (lmod_stmt_add_cleanup(w->l, sid, ids[i]) != 0) { w->hard = 1; return -1; }
    return 0;
}

static int lw_add_cleanups_to_block(struct Lower *w, int blk, int *ids, int n)
{
    int i;
    for (i = 0; i < n; i++)
        if (lmod_block_add_cleanup(w->l, blk, ids[i]) != 0) { w->hard = 1; return -1; }
    return 0;
}

static int lw_add_tail_to_block(struct Lower *w, int blk, int *ids, int n)
{
    int i;
    for (i = 0; i < n; i++)
        if (lmod_block_add_tail(w->l, blk, ids[i]) != 0) { w->hard = 1; return -1; }
    return 0;
}

/* The block-tail flush of one C block: only its own scope, every entry.
   `skip_owned` drops the AutoDrop / release / handback entries: a block that
   ends in a `return` has already run that object's release on the return
   edge (the parser moves the delete there and clears autodrop), while a
   `defer` body is still printed at the closing brace -- dead code after the
   return, exactly like the AST path. */
static int lw_tail_cleanups(struct Lower *w, int blk, int scope, int skip_owned)
{
    int chain[1];
    int ids[64];
    int n = 0;

    chain[0] = scope;
    if (lw_materialise(w, chain, 1, 0, 0, 0, 1, blk, ids, &n) != 0) return -1;
    if (skip_owned) {
        int i, k = 0;
        for (i = 0; i < n; i++)
            if (w->l->stmts[ids[i] - 1].kind != LS_DROP) ids[k++] = ids[i];
        n = k;
    }
    return lw_add_tail_to_block(w, blk, ids, n);
}

/* ------------------------------------------------------------------------- */
/* Statements                                                                */
/* ------------------------------------------------------------------------- */
/* SH-102 in LIR: the owning string handles (`String` / `U16String` values)
   are tracked per block. A declaration with no initialiser gets `= { 0 }`,
   every exit releases the live handles in reverse declaration order, and a
   `return` materialises its value into `__ct_sretN` first (SH-45) so the
   release cannot run under the value it feeds. */
static int lw_is_string_value(const char *sp)
{
    const char *b;
    size_t n;

    if (!sp || !sp[0]) return 0;
    b = sp;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    while (*b == ' ' || *b == '\t') b++;
    n = strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t')) n--;
    if (n == 0 || b[n - 1] == '*') return 0;
    if (n == 6 && strncmp(b, "String", 6) == 0) return 1;
    if (n == 9 && strncmp(b, "U16String", 9) == 0) return 2;
    return 0;
}

/* Does an ADT own a handle through any payload field? Mirrors the emitter's
   `adt_owns`: a String/U16String field or an owning container/ADT field. */
static int lw_adt_owns(struct Lower *w, const char *tag, int depth)
{
    struct ct_tadt *a = lw_adt_row(w, tag);
    int i, j;

    if (!a || depth > 4) return 0;
    for (i = 0; i < a->nvariants; i++)
        for (j = 0; j < a->variants[i].nfields; j++) {
            const char *ft = a->variants[i].fields[j].type;
            if (lw_is_string_value(ft)) return 1;
            if (ft && (strstr(ft, "Vec_") || strstr(ft, "Map_")
                       || strstr(ft, "Option_") || strstr(ft, "Result_")
                       || strstr(ft, "Box_")))
                return 1;
            if (ft && lw_adt_owns(w, ft, depth + 1)) return 1;
        }
    return 0;
}

/* The owning-value kind of a local: 0 none, 1 String, 2 U16String, 3 an
   owning user ADT (`Msg`). */
static int lw_own_kind(struct Lower *w, const char *sp)
{
    int k = lw_is_string_value(sp);
    char buf[512];
    const char *b;
    int n;

    if (k) return k;
    if (!sp || !sp[0]) return 0;
    /* A container / Box value is owned by its container glue, never by the
       emitter's string-handle table (`sb_decl` does not push one); its
       `release()` is an explicit call in the source. */
    if (lw_spelling_container(sp)) return 0;
    b = sp;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    n = (int)strlen(b);
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '*')) {
        if (b[n - 1] == '*') return 0;
        n--;
    }
    if (n <= 0 || n >= (int)sizeof(buf)) return 0;
    memcpy(buf, b, (size_t)n);
    buf[n] = 0;
    if (!lw_adt_row(w, buf)) return 0;
    return lw_adt_owns(w, buf, 0) ? 3 : 0;
}

/* 1 when the owning-handle writer (`sb_assign`) reaches the assignment and
   wraps it in `{ … }`, i.e. the target type owns and the target is a tracked
   local or an arrow field of a *plain* struct. Two shapes stay unwrapped in the
   writer and therefore must stay unwrapped here:
     - a deref target (`(*p) = …`), whose type spelling the writer does not
       resolve;
     - a field reached through a generic instance row (`Box<String>.value`),
       whose template field is a type parameter the container glue owns. */
static int lw_assign_brace(struct Lower *w, int lhs_te)
{
    struct ct_texpr *lt;
    const char *ltsp;
    const char *bt;
    char base[512];
    int n;

    if (lhs_te <= 0 || lhs_te > w->m->nexprs) return 0;
    lt = &w->m->exprs[lhs_te - 1];
    if (lt->type <= 0) return 0;
    ltsp = backend::tir::tmod_cspell(w->m, lt->type);
    if (lw_own_kind(w, ltsp) == 0) return 0;
    if (lt->kind == TK_NAME_LOCAL) return 1;
    if (lt->kind != TK_FIELD || lt->op != 2 || lt->nkids < 1) return 0;
    if (lt->kids[0] <= 0 || lt->kids[0] > w->m->nexprs) return 0;
    if (w->m->exprs[lt->kids[0] - 1].type <= 0) return 0;
    bt = backend::tir::tmod_cspell(w->m, w->m->exprs[lt->kids[0] - 1].type);
    if (!bt) return 0;
    if (strncmp(bt, "struct ", 7) == 0) bt += 7;
    else if (strncmp(bt, "union ", 6) == 0) bt += 6;
    else if (strncmp(bt, "enum ", 5) == 0) bt += 5;
    n = (int)strlen(bt);
    while (n > 0 && (bt[n - 1] == ' ' || bt[n - 1] == '*')) n--;
    if (n <= 0 || n >= (int)sizeof(base)) return 0;
    memcpy(base, bt, (size_t)n);
    base[n] = 0;
    if (frontend::sym::ct_inst_find(base) >= 0) return 0;
    return 1;
}

/* The release spelling of an owning kind: `String` / `U16String` / ADT tag. */
static const char *lw_own_prefix(struct Lower *w, const char *sp, int kind)
{
    if (kind == 1) return "String";
    if (kind == 2) return "U16String";
    {
        static char buf[256];
        const char *b = sp;
        struct ct_tadt *a;
        int n;
        if (strncmp(b, "struct ", 7) == 0) b += 7;
        n = (int)strlen(b);
        while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '*')) n--;
        if (n <= 0 || n >= (int)sizeof(buf)) return "String";
        memcpy(buf, b, (size_t)n);
        buf[n] = 0;
        a = lw_adt_row(w, buf);
        return a ? a->full : buf;
    }
}

/* v1-PH-2 S8 conservative gate for the shapes the lowerer does not model:
     - `lw_spelling_glue`   a struct whose vptr items or Handback order the
                            emitter writes recursively;
     - `lw_spelling_by_value` the C spelling is not a pointer (a pointer's
                            pointee glue belongs to the allocation, not here). */
static int lw_spelling_tag(const char *sp, char *out, int cap)
{
    const char *b;
    int n;

    if (!sp || !sp[0] || cap <= 1) return -1;
    b = sp;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    else if (strncmp(b, "union ", 6) == 0) b += 6;
    while (*b == ' ' || *b == '\t') b++;
    n = (int)strlen(b);
    {
        int i;
        for (i = 0; i < n; i++)
            if (b[i] == '[') { n = i; break; }
    }
    while (n > 0 && (b[n - 1] == ' ' || b[n - 1] == '\t' || b[n - 1] == '*'))
        n--;
    if (n <= 0 || n >= cap) return -1;
    memcpy(out, b, (size_t)n);
    out[n] = 0;
    return 0;
}

static int lw_spelling_by_value(const char *sp)
{
    return sp && sp[0] && strchr(sp, '*') == 0;
}
/* S8: the LIR printer still has a handful of bounded scratch rows (a match
   binding, a long qualified spelling). A unit carrying an identifier longer
   than this stays on the AST body seam; the c2p probes use 700-2000 byte
   names to prove the emitter's dynamic rows, and those bytes are emitter
   owned. 256 is far above any identifier the compiler's own source uses. */
#define LW_NAME_MAX 256

static int lw_text_long(const char *t)
{
    return t && strlen(t) > (size_t)LW_NAME_MAX;
}

/* A multi-segment `into` chain is not lowered yet, and lowering it far enough
   to discover that leaves the hoist rows half-built (the AST writer shares no
   rows with LIR, but the aborted lowering is wasted work and the chain shapes
   are few). Refuse the unit before any row is created. */
static int lw_tables_have_into(struct Lower *w, struct ct_tmark *mark)
{
    int i;
    for (i = mark->nexprs; i < w->m->nexprs; i++)
        if (w->m->exprs[i].kind == TK_INTO_TARGET
            || w->m->exprs[i].kind == TK_INTO_SELF)
            return 1;
    return 0;
}

static int lw_tables_have_long_text(struct Lower *w, struct ct_tmark *mark)
{
    struct TModule *m = w->m;
    int i, j, k;

    for (i = mark->ndecls; i < m->ndecls; i++)
        if (lw_text_long(m->decls[i].name) || lw_text_long(m->decls[i].cname))
            return 1;
    for (i = mark->nexprs; i < m->nexprs; i++) {
        /* `text` also carries payloads the bounded scratch rows never copy:
           a string literal's body and a `#ct-raw` C fragment. Diagnostics and
           usage blocks are far longer than any identifier, and a raw fragment
           is printed verbatim, so neither may keep a whole unit on AST. The
           guard stays for the name / spelling / member rows it protects. */
        if (m->exprs[i].kind == TK_STRING_LIT || m->exprs[i].kind == TK_RAW)
            continue;
        if (lw_text_long(m->exprs[i].text) || lw_text_long(m->exprs[i].member)
            || lw_text_long(m->exprs[i].target_key))
            return 1;
    }
    for (i = mark->nstmts; i < m->nstmts; i++)
        if (lw_text_long(m->stmts[i].text) || lw_text_long(m->stmts[i].text2))
            return 1;
    for (i = mark->nvars; i < m->nvars; i++)
        if (lw_text_long(m->vars[i].name) || lw_text_long(m->vars[i].spelling)
            || lw_text_long(m->vars[i].dims))
            return 1;
    for (i = mark->ntypes; i < m->ntypes; i++)
        if (lw_text_long(m->types[i].key) || lw_text_long(m->types[i].cspell))
            return 1;
    for (i = 0; i < m->nstructs; i++) {
        struct ct_tstruct *s = &m->structs[i];
        if (lw_text_long(s->name)) return 1;
        for (j = 0; j < s->nuses; j++)
            if (lw_text_long(s->uses[j])) return 1;
        for (j = 0; j < s->nfields; j++)
            if (lw_text_long(s->fields[j].name)
                || lw_text_long(s->fields[j].type)
                || lw_text_long(s->fields[j].dims))
                return 1;
    }
    for (i = 0; i < m->nadts; i++) {
        struct ct_tadt *a = &m->adts[i];
        if (lw_text_long(a->name) || lw_text_long(a->full)) return 1;
        for (j = 0; j < a->nvariants; j++) {
            if (lw_text_long(a->variants[j].name)
                || lw_text_long(a->variants[j].cname)) return 1;
            for (k = 0; k < a->variants[j].nfields; k++)
                if (lw_text_long(a->variants[j].fields[k].name)
                    || lw_text_long(a->variants[j].fields[k].type))
                    return 1;
        }
    }
    return 0;
}


static int lw_spelling_struct_row(struct Lower *w, const char *sp,
                                  struct ct_tstruct **out)
{
    char tag[512];
    int id;

    *out = 0;
    if (lw_spelling_tag(sp, tag, (int)sizeof(tag)) != 0) return 0;
    id = backend::tir::tmod_find_struct(w->m, tag);
    if (id <= 0) return 0;
    *out = &w->m->structs[id - 1];
    return 1;
}

/* A captured raw initialiser's expression is a place (variable / field /
   arrow / index chain) -- mirrors the emitter's `sb_text_place_p`. */
static int lw_text_place(const char *e)
{
    const char *p = e;
    int n;

    if (!p) return 0;
    while (*p == ' ' || *p == '\t') p++;
    if (*p == '*') {
        p++;
        while (*p == ' ' || *p == '\t') p++;
    }
    if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || *p == '_'))
        return 0;
    while ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
           || (*p >= '0' && *p <= '9') || *p == '_') p++;
    for (;;) {
        while (*p == ' ' || *p == '\t') p++;
        if (*p == '.') {
            p++;
            if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || *p == '_'))
                return 0;
            while ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
                   || (*p >= '0' && *p <= '9') || *p == '_') p++;
            continue;
        }
        if (*p == '-' && p[1] == '>') {
            p += 2;
            if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || *p == '_'))
                return 0;
            while ((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z')
                   || (*p >= '0' && *p <= '9') || *p == '_') p++;
            continue;
        }
        if (*p == '[') {
            n = 1;
            p++;
            while (*p && n > 0) {
                if (*p == '[') n++;
                else if (*p == ']') n--;
                p++;
            }
            if (n != 0) return 0;
            continue;
        }
        break;
    }
    while (*p == ' ' || *p == '\t') p++;
    return *p == 0;
}

/* D-013 §3 / PH-81: a by-value struct's raw brace initialiser gives an owning
   `String` / `U16String` field its own reference -- a bare string literal
   becomes a heap `String` (`str_dup_len`), a stored place is retained. This is
   the LIR copy of the emitter's `sb_rewrite_init`, and it runs before the vptr
   items are appended. Returns `t` unchanged when no item needs a rewrite, and
   0 when the row cannot be rewritten safely (the function then stays on AST). */
static const char *lw_rewrite_struct_init(struct Lower *w, const char *type,
                                          const char *t, int len)
{
    struct ct_tstruct *s;
    int starts[64], ends[64], epos[64], fields[64], litmode[64], retmode[64];
    int nitem;
    int i, depth, p, q, count, changed;
    char *buf;
    size_t cap, used;

    if (!t || len < 2 || t[0] != '{' || t[len - 1] != '}') return t;
    if (!lw_spelling_struct_row(w, type, &s)) return t;
    if (s->nfields <= 0 || s->nfields > 64) return t;
    nitem = 0;
    depth = 0;
    p = 1;
    q = 1;
    count = 0;
    while (p < len - 1) {
        char c = t[p];
        if (c == '"' || c == '\'') {
            char quote = c;
            p++;
            while (p < len - 1 && t[p] != quote) {
                if (t[p] == '\\' && p + 1 < len - 1) p++;
                p++;
            }
            p++;
            continue;
        }
        if (c == '/' && p + 1 < len - 1 && t[p + 1] == '/') {
            while (p < len - 1 && t[p] != '\n') p++;
            continue;
        }
        if (c == '/' && p + 1 < len - 1 && t[p + 1] == '*') {
            p += 2;
            while (p + 1 < len - 1 && !(t[p] == '*' && t[p + 1] == '/')) p++;
            p += 2;
            continue;
        }
        if (c == '{' || c == '(' || c == '[') depth++;
        else if (c == '}' || c == ')' || c == ']') depth--;
        else if (c == ',' && depth == 0) {
            if (nitem >= 64) return 0;
            starts[nitem] = q;
            ends[nitem] = p;
            nitem++;
            q = p + 1;
        }
        p++;
    }
    if (nitem >= 64) return 0;
    starts[nitem] = q;
    ends[nitem] = len - 1;
    nitem++;
    if (s->nfields < nitem) return t;

    changed = 0;
    for (i = 0; i < nitem; i++) {
        int s0 = starts[i], e0 = ends[i], fs, fi, kind;
        litmode[i] = 0;
        retmode[i] = 0;
        while (s0 < e0 && (t[s0] == ' ' || t[s0] == '\t' || t[s0] == '\n'
                           || t[s0] == '\r')) s0++;
        while (e0 > s0 && (t[e0 - 1] == ' ' || t[e0 - 1] == '\t'
                           || t[e0 - 1] == '\n' || t[e0 - 1] == '\r')) e0--;
        fs = s0;
        fi = -1;
        if (s0 < e0 && t[s0] == '.') {
            int ne = s0 + 1, nl;
            const char *fname;
            while (ne < e0 && ((t[ne] >= 'A' && t[ne] <= 'Z')
                               || (t[ne] >= 'a' && t[ne] <= 'z')
                               || (t[ne] >= '0' && t[ne] <= '9')
                               || t[ne] == '_')) ne++;
            nl = ne - (s0 + 1);
            fname = runtime::text::ct_intern_len(t + s0 + 1, nl);
            if (!fname) return 0;
            while (ne < e0 && (t[ne] == ' ' || t[ne] == '\t')) ne++;
            if (ne >= e0 || t[ne] != '=') return t;
            for (fi = 0; fi < s->nfields; fi++)
                if (strcmp(s->fields[fi].name, fname) == 0) break;
            if (fi >= s->nfields) return t;
            ne++;
            while (ne < e0 && (t[ne] == ' ' || t[ne] == '\t')) ne++;
            fs = ne;
            count = fi + 1;
        } else if (s0 < e0 && t[s0] == '[') {
            return t;
        } else {
            fi = count;
            count++;
            if (fi >= s->nfields) return t;
        }
        fields[i] = fi;
        epos[i] = fs;
        if (s->fields[fi].dims && s->fields[fi].dims[0]) continue;
        kind = lw_is_string_value(s->fields[fi].type);
        if (!kind) continue;
        {
            int el = e0 - fs;
            /* a bare string literal becomes an owning heap copy */
            if (el >= 2 && t[fs] == '"' && t[e0 - 1] == '"') {
                litmode[i] = 1;
                starts[i] = s0;
                ends[i] = e0;
                changed = 1;
                continue;
            }
            /* a stored place keeps its own reference */
            {
                char tmp[512];
                int tn = el < (int)sizeof(tmp) - 1 ? el : (int)sizeof(tmp) - 1;
                memcpy(tmp, t + fs, (size_t)tn);
                tmp[tn] = 0;
                if (lw_text_place(tmp)) {
                    retmode[i] = 1;
                    starts[i] = s0;
                    ends[i] = e0;
                    changed = 1;
                }
            }
        }
    }
    if (!changed) return t;
    cap = (size_t)len * 2 + 512;
    buf = (char *)malloc(cap);
    if (!buf) return 0;
    used = 0;
    buf[used++] = '{';
    buf[used++] = ' ';
    for (i = 0; i < nitem; i++) {
        int s0 = starts[i], e0 = ends[i], fs = epos[i];
        int fi = fields[i];
        int kind;
        if (i > 0) { buf[used++] = ','; buf[used++] = ' '; }
        if (fs > s0) {
            if (used + (size_t)(fs - s0) >= cap) { free(buf); return 0; }
            memcpy(buf + used, t + s0, (size_t)(fs - s0));
            used += (size_t)(fs - s0);
        }
        kind = (s->fields[fi].dims && s->fields[fi].dims[0])
                   ? 0 : lw_is_string_value(s->fields[fi].type);
        if (litmode[i]) {
            const char *lit = "str_dup_len(";
            size_t ll = strlen(lit);
            if (used + ll + (size_t)(e0 - fs) + 64 >= cap) { free(buf); return 0; }
            memcpy(buf + used, lit, ll);
            used += ll;
            memcpy(buf + used, t + fs, (size_t)(e0 - fs));
            used += (size_t)(e0 - fs);
            used += (size_t)snprintf(buf + used, cap - used,
                                     ", (int)(sizeof(%.*s) - 1))",
                                     e0 - fs, t + fs);
        } else if (retmode[i] && kind) {
            size_t pl = strlen(lw_own_prefix(w, s->fields[fi].type, kind)) + 10;
            if (used + pl + (size_t)(e0 - fs) + 3 >= cap) { free(buf); return 0; }
            used += (size_t)snprintf(buf + used, cap - used, "%s_retain(&(",
                                     lw_own_prefix(w, s->fields[fi].type, kind));
            memcpy(buf + used, t + fs, (size_t)(e0 - fs));
            used += (size_t)(e0 - fs);
            buf[used++] = ')';
            buf[used++] = ')';
        } else {
            if (used + (size_t)(e0 - fs) >= cap) { free(buf); return 0; }
            memcpy(buf + used, t + fs, (size_t)(e0 - fs));
            used += (size_t)(e0 - fs);
        }
    }
    buf[used++] = ' ';
    buf[used++] = '}';
    buf[used] = 0;
    {
        const char *pooled = runtime::text::ct_intern_len(buf, (int)used);
        free(buf);
        if (!pooled) return 0;
        return pooled;
    }
}

/* A struct value whose C shape needs emitter glue: vptr items (a trait use),
   `Handback` cleanup order, or a nested field with either. */
static int lw_spelling_glue(struct Lower *w, const char *sp, int depth)
{
    struct ct_tstruct *s;
    int i;

    if (!sp || !sp[0] || depth > 4) return 0;
    if (!lw_spelling_struct_row(w, sp, &s)) return 0;
    if (s->nuses > 0 || s->uses_handback) return 1;
    for (i = 0; i < s->nfields; i++)
        if (lw_spelling_glue(w, s->fields[i].type, depth + 1)) return 1;
    return 0;
}

static int lw_sb_add2(struct Lower *w, const char *name, int block, int kind,
                      const char *prefix, int own, int notail)
{
    if (w->sb_n >= 64) return -1;
    w->sb_name[w->sb_n] = runtime::text::ct_intern(name ? name : "");
    w->sb_block[w->sb_n] = block;
    w->sb_kind[w->sb_n] = kind;
    w->sb_prefix[w->sb_n] = runtime::text::ct_intern(prefix ? prefix : "String");
    w->sb_own[w->sb_n] = own;
    w->sb_notail[w->sb_n] = notail;
    w->sb_n++;
    return 0;
}

static int lw_sb_add(struct Lower *w, const char *name, int block, int kind,
                     const char *prefix, int own)
{
    return lw_sb_add2(w, name, block, kind, prefix, own, 0);
}

/* A built-in container / Box instance spelling (`Vec_int`, `struct
   Option_String`, ...). The emitter keeps its lifecycle in the container
   glue, not in the handle table. */
static int lw_spelling_container(const char *sp)
{
    return sp && (strstr(sp, "Vec_") || strstr(sp, "Map_")
                  || strstr(sp, "Box_") || strstr(sp, "Option_")
                  || strstr(sp, "Result_"));
}

/* A struct local whose vptr initialisation is not a flat item list: an array
   field of trait-carrying elements needs the emitter's element loop. */
static int lw_struct_has_vptr_array_field(struct Lower *w, const char *sp)
{
    struct ct_tstruct *s;
    int i;

    if (!lw_spelling_struct_row(w, sp, &s)) return 0;
    for (i = 0; i < s->nfields; i++)
        if (s->fields[i].dims && s->fields[i].dims[0]
            && lw_spelling_glue(w, s->fields[i].type, 0))
            return 1;
    return 0;
}

/* A by-value struct with a directly owning field (String / U16String). */
static int lw_struct_has_owning_field(struct Lower *w, const char *sp)
{
    struct ct_tstruct *s;
    int i;

    if (!lw_spelling_struct_row(w, sp, &s)) return 0;
    for (i = 0; i < s->nfields; i++)
        if (lw_is_string_value(s->fields[i].type)) return 1;
    return 0;
}

/* A raw brace initialiser hands an owning value from a bare place (one
   top-level item that is a variable / field chain, not a call or literal). */
static int lw_raw_has_place_item(const char *t)
{
    int p = 1, len, depth = 0, start = 1;

    if (!t || t[0] != '{') return 0;
    len = (int)strlen(t);
    for (p = 1; p < len; p++) {
        char c = t[p];
        if (c == '"' || c == '\'') {
            char quote = c;
            p++;
            while (p < len - 1 && t[p] != quote) {
                if (t[p] == '\\') p++;
                p++;
            }
            continue;
        }
        if (c == '{' || c == '(' || c == '[') depth++;
        else if (c == '}' || c == ')' || c == ']') { if (depth == 0) break; depth--; }
        else if (c == ',' && depth == 0) {
            char item[512];
            int n = p - start;
            if (n > 0 && n < (int)sizeof(item)) {
                memcpy(item, t + start, (size_t)n);
                item[n] = 0;
                if (lw_text_place(item)) return 1;
            }
            start = p + 1;
        }
    }
    if (len - start > 0 && len - start < 512) {
        char item[512];
        int n = len - start - 1;
        if (n > 0) {
            memcpy(item, t + start, (size_t)n);
            item[n] = 0;
            if (lw_text_place(item)) return 1;
        }
    }
    return 0;
}

/* An ADT constructor's raw text hands an owning payload from a bare place
   (`(m)`), which the emitter wraps in `<T>_retain(&(m))`; a fresh call or
   literal moves instead. */
static int lw_raw_adt_place_p(const char *t)
{
    const char *p = t ? t : "";
    while ((p = strstr(p, "= (")) != 0) {
        const char *q = p + 3;
        while (*q == ' ' || *q == '\t') q++;
        if ((*q >= 'A' && *q <= 'Z') || (*q >= 'a' && *q <= 'z') || *q == '_') {
            while ((*q >= 'A' && *q <= 'Z') || (*q >= 'a' && *q <= 'z')
                   || (*q >= '0' && *q <= '9') || *q == '_') q++;
            while (*q == ' ' || *q == '\t') q++;
            if (*q == ')') return 1;
        }
        p += 3;
    }
    return 0;
}

/* `sp` names a trait, i.e. the value is a trait interface. */
static int lw_spelling_is_trait(struct Lower *w, const char *sp)
{
    char tag[512];
    const char *b = sp;

    if (!sp || !sp[0]) return 0;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    else if (strncmp(b, "union ", 6) == 0) b += 6;
    snprintf(tag, sizeof(tag), "%s", b);
    {
        int n = (int)strlen(tag);
        while (n > 0 && (tag[n - 1] == ' ' || tag[n - 1] == '*')) n--;
        tag[n] = 0;
    }
    {
        int i;
        for (i = 0; i < w->m->ndecls; i++)
            if (w->m->decls[i].kind == 7 /* TD_TRAIT */
                && w->m->decls[i].name
                && strcmp(w->m->decls[i].name, tag) == 0)
                return 1;
    }
    return 0;
}

/* A by-value struct with any owning field (handle / ADT / container). */
static int lw_struct_has_any_owning_field(struct Lower *w, const char *sp)
{
    struct ct_tstruct *s;
    int i;

    if (!lw_spelling_struct_row(w, sp, &s)) return 0;
    for (i = 0; i < s->nfields; i++) {
        const char *ft = s->fields[i].type;
        if (lw_is_string_value(ft) || lw_own_kind(w, ft) != 0
            || lw_spelling_container(ft))
            return 1;
    }
    return 0;
}

/* A borrowed string view (`Str` / `U16Str`), never an owning handle. */
static int lw_spelling_view(const char *sp)
{
    const char *b = sp;
    if (!sp) return 0;
    if (strncmp(b, "struct ", 7) == 0) b += 7;
    return strcmp(b, "Str") == 0 || strcmp(b, "U16Str") == 0;
}

/* A return value the emitter treats as freshly handed over (no retain): a
   call / literal / constructor / `?` payload / expression-match result, or a
   container view (`*map.get(k)`) that the container keeps owning. */
static int lw_ret_is_fresh(struct Lower *w, int teid)
{
    struct ct_texpr *t;

    if (teid <= 0 || teid > w->m->nexprs) return 0;
    t = &w->m->exprs[teid - 1];
    switch (t->kind) {
        case TK_CALL:
        case TK_INTRINSIC:
        case TK_STRING_LIT:
        case TK_LITERAL:
        case TK_ADT_CTOR:
        case TK_MATCH_ARM:
            return 1;
        case TK_TRY_EXPR:
            return 1;
        case TK_CAST:
            return t->nkids > 0 ? lw_ret_is_fresh(w, t->kids[0]) : 0;
        case TK_DEREF:
            if (t->nkids > 0) {
                struct ct_texpr *k = &w->m->exprs[t->kids[0] - 1];
                if (k->kind == TK_CALL && k->text
                    && (strcmp(k->text, "get") == 0
                        || strcmp(k->text, "entry") == 0
                        || strcmp(k->text, "pop") == 0))
                    return 1;
            }
            return 0;
        default:
            return 0;
    }
}

/* The tracked owning local `name` (the first row, as the emitter's sb_find). */
static int lw_sb_find(struct Lower *w, const char *name)
{
    int i;
    if (!name || !name[0]) return -1;
    for (i = 0; i < w->sb_n; i++)
        if (w->sb_name[i] && strcmp(w->sb_name[i], name) == 0) return i;
    return -1;
}

/* TIR place test mirroring the emitter's `sb_is_place`: a variable, field /
   arrow access, index, dereference. Anything else is a fresh value. */
static int lw_tir_is_place(struct ct_texpr *t)
{
    if (!t) return 0;
    switch (t->kind) {
        case TK_NAME_LOCAL:
        case TK_NAME_GLOBAL:
        case TK_FIELD:
        case TK_INDEX:
        case TK_DEREF:
            return 1;
        default:
            return 0;
    }
}

/* Is `blk` the block itself or an ancestor of it? */
static int lw_block_within(struct Lower *w, int blk, int cand)
{
    while (blk > 0 && blk <= w->l->nblocks) {
        if (blk == cand) return 1;
        blk = w->l->blocks[blk - 1].parent;
    }
    return 0;
}

/* A release statement for one tracked handle. */
static int lw_sb_release_stmt(struct Lower *w, int i, int kind, int ind_span)
{
    int e, sid;
    (void)ind_span;
    (void)kind;
    e = lmod_new_expr(w->l, LE_NAME, 0, 0, 0);
    if (e <= 0) { w->hard = 1; return -1; }
    w->l->exprs[e - 1].text = w->sb_name[i];
    w->l->exprs[e - 1].type = lmod_type(w->l, "void");
    sid = lmod_new_stmt(w->l, LS_RELEASE, 0, 0, 0);
    if (sid <= 0) { w->hard = 1; return -1; }
    w->l->stmts[sid - 1].expr = e;
    w->l->stmts[sid - 1].name = w->sb_prefix[i];
    return sid;
}

static int lw_one_stmt(struct Lower *w, int tsid, int block, int *out);

/* A match arm body: bindings first (the emitter injects them into the arm's
   block), then the statements. An expression arm's single yield assignment is
   replaced by `__ct_mresN = <expr>;`. */
static int lw_match_bind_stmt(struct Lower *w, const char *type, const char *name,
                              const char *path, int match_temp,
                              const char *conds)
{
    int sid;
    int k;

    sid = lmod_new_stmt(w->l, LS_MATCHBIND, 0, 0, 0);
    if (sid <= 0) { w->hard = 1; return -1; }
    w->l->stmts[sid - 1].spelling = runtime::text::ct_intern(type ? type : "");
    w->l->stmts[sid - 1].name = runtime::text::ct_intern(name ? name : "");
    /* v1-PH-2 S4: the full accessor after the match temporary (`.` / `->`,
       or `*` for a pointer subject bound whole). */
    w->l->stmts[sid - 1].member = runtime::text::ct_intern(path ? path : "");
    w->l->stmts[sid - 1].text = runtime::text::ct_intern(conds ? conds : "");
    k = lw_own_kind(w, type);
    w->l->stmts[sid - 1].fname = k ? lw_own_prefix(w, type, k) : "";
    w->l->stmts[sid - 1].target = match_temp;
    w->l->stmts[sid - 1].aux = k;
    return sid;
}

/* v1-PH-2 S4: the arms' serialised pattern tests travel as one newline
   separated string (one line per arm). The printer resolves the match
   temporary and writes the same ` && (path == value)` shape the AST path
   writes, so `--ir=on` stays byte-identical. */
static int lw_conds_put(char **buf, int *len, int *cap, const char *s)
{
    int n, need, ncap;
    char *grown;

    n = (int)strlen(s ? s : "");
    need = *len + n + 2;
    if (need > *cap) {
        ncap = *cap > 0 ? *cap : 128;
        while (ncap < need) ncap *= 2;
        grown = (char *)realloc(*buf, (size_t)ncap);
        if (!grown) return -1;
        *buf = grown;
        *cap = ncap;
    }
    if (n > 0) memcpy(*buf + *len, s, (size_t)n);
    *len += n;
    (*buf)[(*len)++] = '\n';
    (*buf)[*len] = 0;
    return 0;
}


/* The parser leaves `__ct_mres` (no index) as the placeholder name of a
   match expression's result assignment; the AST writer rewrites it to
   `__ct_mres<k>` at print time. TIR captured the placeholder, so the lowerer
   must recognise it wherever it appears in the arm (bindings and locals may
   precede it) and turn it into the LS_MATCHYIELD row. */
static int lw_is_match_yield(struct Lower *w, int tsid)
{
    struct ct_tstmt *st;
    struct ct_texpr *a, *l;

    if (tsid <= 0 || tsid > w->m->nstmts) return 0;
    st = &w->m->stmts[tsid - 1];
    if (st->kind != TS_EXPR || st->nkids < 1) return 0;
    if (st->kids[0] <= 0 || st->kids[0] > w->m->nexprs) return 0;
    a = &w->m->exprs[st->kids[0] - 1];
    if (a->kind != TK_ASSIGN || a->nkids < 2) return 0;
    if (a->kids[0] <= 0 || a->kids[0] > w->m->nexprs) return 0;
    l = &w->m->exprs[a->kids[0] - 1];
    return l->kind == TK_NAME_LOCAL && l->text
           && strcmp(l->text, "__ct_mres") == 0;
}

static int lw_match_arm_block(struct Lower *w, int arm_tsid, int match_temp,
                              int is_expr, int parent, int ext, int set_matched)
{
    struct ct_tstmt *arm, *body;
    int body_tsid, blk, i;
    const char *enc;

    if (arm_tsid <= 0 || arm_tsid > w->m->nstmts) return 0;
    arm = &w->m->stmts[arm_tsid - 1];
    body_tsid = is_expr ? (arm->nkids >= 2 ? arm->kids[1] : 0)
                        : (arm->nkids >= 1 ? arm->kids[0] : 0);
    if (body_tsid <= 0 || body_tsid > w->m->nstmts) {
        if (getenv("CT_LIR_DEBUG")) {
            int q;
            fprintf(stderr, "lir: arm body id=%d nkids=%d enc=%s", body_tsid,
                    arm->nkids, arm->text ? arm->text : "");
            for (q = 0; q < arm->nkids; q++) {
                int kid = arm->kids[q];
                fprintf(stderr, " kid%d=%d", q, kid);
                if (kid > 0 && kid <= w->m->nexprs)
                    fprintf(stderr, "(xkind=%d)", w->m->exprs[kid - 1].kind);
                if (kid > 0 && kid <= w->m->nstmts)
                    fprintf(stderr, "(skind=%d)", w->m->stmts[kid - 1].kind);
            }
            fprintf(stderr, "\n");
        }
        return 0;
    }
    body = &w->m->stmts[body_tsid - 1];
    if (body->kind != TS_BLOCK) {
        if (getenv("CT_LIR_DEBUG")) fprintf(stderr, "lir: arm body kind=%d\n", body->kind);
        return 0;
    }
    blk = lmod_new_block(w->l, LB_BLOCK, body->scope, parent);
    if (blk <= 0) { w->hard = 1; return 0; }
    w->l->blocks[blk - 1].span.file = body->span.file;
    w->l->blocks[blk - 1].span.line = body->span.line;
    w->l->blocks[blk - 1].span.col = body->span.col;
    /* bindings: `field|name|type;` each */
    enc = arm->text ? arm->text : "";
    while (*enc) {
        char fl[512], nm[512], ty[512];
        int a = 0, b = 0, c = 0;
        while (*enc && *enc != '|') { if (a < (int)sizeof(fl) - 1) fl[a++] = *enc; enc++; }
        fl[a] = 0;
        if (*enc == '|') enc++;
        while (*enc && *enc != '|') { if (b < (int)sizeof(nm) - 1) nm[b++] = *enc; enc++; }
        nm[b] = 0;
        if (*enc == '|') enc++;
        while (*enc && *enc != ';') { if (c < (int)sizeof(ty) - 1) ty[c++] = *enc; enc++; }
        ty[c] = 0;
        if (*enc == ';') enc++;
        {
            int bs, ok2;
            if (lw_spelling_container(ty)) {
                /* a container payload binding keeps its own reference and is
                   released by the container glue; that shape stays on AST */
                lw_abort(w, "Lbindcontainer");
                return 0;
            }
            bs = lw_match_bind_stmt(w, ty, nm, fl, match_temp, arm->text2);
            ok2 = lw_own_kind(w, ty);
            if (bs <= 0) {
                if (getenv("CT_LIR_DEBUG")) fprintf(stderr, "lir: arm bind fail\n");
                return 0;
            }
            if (ok2 && lw_sb_add(w, nm, blk, ok2,
                                 lw_own_prefix(w, ty, ok2), 1) != 0) {
                w->hard = 1;
                return 0;
            }
            if (lmod_block_add_stmt(w->l, blk, bs) != 0) { w->hard = 1; return 0; }
        }
    }
    {
        int inner = blk;
        if (ext) {
            /* S5 guard shape: the arm's bindings stay in the arm block; the
               guard and the source body move into a nested block the wrapper
               prints (`if (guard) { __ct_matchedK = 1; { body } }`). */
            inner = lmod_new_block(w->l, LB_BLOCK, body->scope, blk);
            if (inner <= 0) { w->hard = 1; return 0; }
            w->l->blocks[inner - 1].span.file = body->span.file;
            w->l->blocks[inner - 1].span.line = body->span.line;
            w->l->blocks[inner - 1].span.col = body->span.col;
        }
        for (i = 0; i < body->nkids; i++) {
            int sid = 0;
            if (is_expr && body->kids[i] > 0
                && lw_is_match_yield(w, body->kids[i])) {
                struct ct_texpr *yt = &w->m->exprs[
                    w->m->stmts[body->kids[i] - 1].kids[0] - 1];
                int re;
                if (yt->kind != TK_ASSIGN || yt->nkids < 2) {
                    if (getenv("CT_LIR_DEBUG"))
                        fprintf(stderr, "lir: yield kind=%d kids=%d\n",
                                yt->kind, yt->nkids);
                    return 0;
                }
                re = lw_expr(w, yt->kids[1]);
                if (re <= 0) return 0;
                sid = lmod_new_stmt(w->l, LS_MATCHYIELD, 0, 0, 0);
                if (sid <= 0) { w->hard = 1; return 0; }
                w->l->stmts[sid - 1].expr = re;
                w->l->stmts[sid - 1].target = match_temp;
            } else if (lw_one_stmt(w, body->kids[i], inner, &sid) != 0) {
                return 0;
            }
            if (sid > 0 && lmod_block_add_stmt(w->l, inner, sid) != 0) {
                w->hard = 1;
                return 0;
            }
        }
        if (lw_tail_cleanups(w, inner, body->scope, 0) != 0) return 0;
        if (ext && lw_sb_tail(w, inner) != 0) return 0;
        if (ext) {
            int wid = lmod_new_stmt(w->l, LS_MATCHWRAP, arm->span.file,
                                    arm->span.line, arm->span.col);
            if (wid <= 0) { w->hard = 1; return 0; }
            if (arm->guard > 0) {
                int ge = lw_expr(w, arm->guard);
                if (ge <= 0) return 0;
                w->l->stmts[wid - 1].expr = ge;
            }
            w->l->stmts[wid - 1].body_blk = inner;
            w->l->stmts[wid - 1].target = match_temp;
            w->l->stmts[wid - 1].aux = set_matched;
            if (lmod_block_add_stmt(w->l, blk, wid) != 0) {
                w->hard = 1;
                return 0;
            }
        }
    }
    if (lw_tail_cleanups(w, blk, body->scope, 0) != 0) return 0;
    if (lw_sb_tail(w, blk) != 0) return 0;
    return blk;
}

static int lw_jump_cleanups(struct Lower *w, int block, int edge, int is_cont,
                            int line, int col, int *ids, int *n)
{
    int chain[LX_MAX_CHAIN];
    int nchain = 0;
    int loop = is_cont ? lw_loop_id(w) : lw_break_id(w);
    int stop_scope;

    if (loop <= 0) return -1;
    stop_scope = w->l->blocks[loop - 1].scope;
    if (lw_chain(w, w->l->blocks[block - 1].scope, stop_scope, 0, chain, &nchain) != 0)
        return -1;
    return lw_materialise(w, chain, nchain, edge, line, col, 0, block, ids, n);
}

static int lw_return_cleanups(struct Lower *w, int block, int edge, int line,
                              int col, int *ids, int *n)
{
    int chain[LX_MAX_CHAIN];
    int nchain = 0;

    if (lw_chain(w, w->l->blocks[block - 1].scope, 0, SC_FUNC, chain, &nchain) != 0)
        return -1;
    return lw_materialise(w, chain, nchain, edge, line, col, 0, block, ids, n);
}

/* Does the lowered return value name `name`? The AST rule counts a field
   spelling too, because L2 scans words. */
static int lw_lir_mentions(struct Lower *w, int eid, const char *name)
{
    struct ct_lexpr *e;
    int i;

    if (eid <= 0 || eid > w->l->nexprs || !name || !name[0]) return 0;
    e = &w->l->exprs[eid - 1];
    if (e->kind == LE_NAME)
        return e->text && strcmp(e->text, name) == 0;
    if (e->kind == LE_FIELD || e->kind == LE_ARROW)
        return (e->text && strcmp(e->text, name) == 0)
            || lw_lir_mentions(w, e->kids[0], name);
    if (e->kind == LE_CALL || e->kind == LE_MCALL)
        if (e->text && strcmp(e->text, name) == 0) return 1;
    for (i = 0; i < e->nkids; i++)
        if (lw_lir_mentions(w, e->kids[i], name)) return 1;
    return 0;
}

/* Does the value hand `name` over? A field read is not a transfer; a bare
   name and an element of it are. */
static int lw_lir_returns(struct Lower *w, int eid, const char *name)
{
    struct ct_lexpr *e;
    int i;

    if (eid <= 0 || eid > w->l->nexprs || !name || !name[0]) return 0;
    e = &w->l->exprs[eid - 1];
    if (e->kind == LE_NAME)
        return e->text && strcmp(e->text, name) == 0;
    if (e->kind == LE_FIELD || e->kind == LE_ARROW) return 0;
    if (e->kind == LE_INDEX) return lw_lir_returns(w, e->kids[0], name);
    for (i = 0; i < e->nkids; i++)
        if (lw_lir_returns(w, e->kids[i], name)) return 1;
    return 0;
}

/* SH-45: a `return` gets a materialised value only when a defer block is
   active (any kind), or when it reads an object the same exit is about to
   release. A constant return with only an AutoDrop edge prints in place. */
static int lw_active_for_return(struct Lower *w, int block, int ret_expr,
                                int line, int col)
{
    int chain[LX_MAX_CHAIN];
    int nchain = 0, ci, k;

    if (lw_chain(w, w->l->blocks[block - 1].scope, 0, SC_FUNC, chain, &nchain) != 0)
        return 0;
    for (ci = 0; ci < nchain; ci++) {
        struct ct_lscope *sc = &w->l->scopes[chain[ci] - 1];
        for (k = 0; k < sc->ncleanups; k++) {
            struct ct_lcleanup *c = &w->l->cleanups[sc->cleanups[k] - 1];
            const char *nm;
            if (lw_active(w, c, line, col, 0) == 0) continue;
            if (c->kind == CL_DEFER || c->kind == CL_ERRDEFER) return 1;
            if (c->kind != CL_DROP && c->kind != CL_RELEASE
                && c->kind != CL_HANDBACK) continue;
            if (ret_expr <= 0 || c->body_stmt <= 0
                || c->body_stmt > w->m->nexprs) continue;
            if (w->m->exprs[c->body_stmt - 1].kind != TK_NAME_LOCAL) continue;
            nm = w->m->exprs[c->body_stmt - 1].text;
            if (lw_lir_mentions(w, ret_expr, nm)
                && !lw_lir_returns(w, ret_expr, nm))
                return 1;
        }
    }
    return 0;
}

/* Print the statement-head hoists in emission order: optional temps, then
   receiver temps with their initialisers, then an `into` receiver with its
   spliced block. */
static int lw_emit_hoists(struct Lower *w, int block)
{
    int i, k;

    for (k = 1; k <= 3; k++) {
        for (i = 0; i < w->h_n; i++) {
            int sid, init_le = 0;
            if (w->h_kind[i] != k) continue;
            if (k != 1 && w->h_init[i] > 0) {
                /* the initialiser is the hoisted expression itself (the
                   emitter's `raw_call`); lower it with the map bypassed so
                   it prints the call, not the temp. */
                w->bypass_te = w->h_init[i];
                init_le = lw_expr(w, w->h_init[i]);
                w->bypass_te = 0;
                if (init_le <= 0) return -1;
            }
            sid = lmod_new_stmt(w->l, LS_TEMPDECL, 0, 0, 0);
            if (sid <= 0) { w->hard = 1; return -1; }
            w->l->stmts[sid - 1].origin = w->h_temp[i];
            w->l->stmts[sid - 1].expr = init_le;
            w->l->stmts[sid - 1].type = w->h_type[i];
            w->l->stmts[sid - 1].aux = w->h_cat[i];
            w->l->stmts[sid - 1].kind = LS_TEMPDECL;
            if (lmod_block_add_stmt(w->l, block, sid) != 0) {
                w->hard = 1;
                return -1;
            }
            if (k == 3 && w->h_blk[i] > 0) {
                /* The into block is spliced at the same indentation, one
                   statement at a time; each runs its own hoist pass. `h_blk`
                   is the into TExpr id; kids 1.. are its statements. */
                int j, t = w->h_blk[i];
                if (t <= 0 || t > w->m->nexprs) { w->aborted = 1; return -1; }
                for (j = 1; j < w->m->exprs[t - 1].nkids; j++) {
                    int ss = 0;
                    if (lw_one_stmt(w, w->m->exprs[t - 1].kids[j], block,
                                    &ss) != 0) return -1;
                    if (ss > 0 && lmod_block_add_stmt(w->l, block, ss) != 0) {
                        w->hard = 1;
                        return -1;
                    }
                }
            }
        }
    }
    return 0;
}

static int lw_hoist_for(struct Lower *w, int block, int teid, int top,
                        int temps)
{
    if (teid <= 0) return 0;
    lw_hoist_clear(w);
    w->hoist_block = block;
    w->hoist_temps = temps;
    if (lw_hoist_scan(w, teid, top) != 0) return -1;
    if (w->h_n == 0) return 0;
    return lw_emit_hoists(w, block);
}

static int lw_one_stmt(struct Lower *w, int tsid, int block, int *out)
{
    struct ct_tstmt *s;
    int sid, e, blk;

    *out = 0;
    if (w->aborted) return 0;
    if (tsid <= 0 || tsid > w->m->nstmts) { lw_abort(w, "L728"); return 0; }
    s = &w->m->stmts[tsid - 1];
    if (getenv("CT_LIR_DEBUG"))
        fprintf(stderr, "lir: stmt %d kind=%d kids=%d\n", tsid, s->kind, s->nkids);
    switch (s->kind) {
        case TS_EMPTY:
            sid = lmod_new_stmt(w->l, LS_EMPTY, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            *out = sid;
            return 0;
        case TS_DECL: {
            struct ct_tvar *v;
            const char *sp;
            const char *init_text = 0;
            if (s->aux <= 0 || s->aux > w->m->nvars) { lw_abort(w, "L738"); return 0; }
            v = &w->m->vars[s->aux - 1];
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: decl var '%s' type='%s' kids=%d\n",
                        v->name ? v->name : "",
                        backend::tir::tmod_cspell(w->m, v->type), s->nkids);
            if (v->is_ref) { lw_abort(w, "L740"); return 0; }
            sid = lmod_new_stmt(w->l, LS_DECL, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].type = lw_type(w, v->type);
            w->l->stmts[sid - 1].name = v->name;
            w->l->stmts[sid - 1].dims = v->dims ? v->dims : "";
            w->l->stmts[sid - 1].spelling = v->spelling;
            w->l->stmts[sid - 1].attr = v->attr;
            w->l->stmts[sid - 1].aux = v->is_static ? 1 : 0;
            w->l->stmts[sid - 1].err_edge = v->is_unused ? 1 : 0;
            w->l->stmts[sid - 1].scope = s->scope;
            if (s->nkids > 1) { lw_abort(w, "L746"); return 0; }
            if (s->nkids == 1
                && lw_hoist_for(w, block, s->kids[0], 1, 1) != 0)
                return 0;
            if (s->nkids == 1) {
                struct ct_texpr *ct = &w->m->exprs[s->kids[0] - 1];
                if (ct->kind == TK_CLOSURE) {
                    /* a closure binding: the declared name never becomes a C
                       variable, its stack instance is the environment. */
                    if (lw_closure_register(w, v->name, (int)ct->num) != 0) {
                        /* the emitter's per-frame binding table is still a
                           fixed 64 and reports the capacity error itself; the
                           lowerer refuses the function instead of hard-failing
                           the whole compile (S1a-0 cap closure_bind). */
                        lw_abort(w, "Lclosurebind");
                        return 0;
                    }
                    w->l->stmts[sid - 1].kind = LS_CLOSURE_DECL;
                    w->l->stmts[sid - 1].origin = (int)ct->num;
                    w->l->stmts[sid - 1].name = ct->text;
                    *out = sid;
                    return 0;
                }
            }
            /* An explicit GNU local attribute is a name-position row
               (`int spare __attribute__((unused))`); the printer writes it
               after the declarator, exactly as the AST writer does. No glue
               depends on it, so the body stays on LIR. */
            sp = backend::tir::tmod_cspell(w->m, v->type);
            /* A typedef alias of a vptr / Handback / owning-field struct has
               no `struct <tag>` spelling of its own, so the vptr-item writer
               below cannot reach its row; the function stays on AST. */
            if (lw_spelling_by_value(sp) && lw_spelling_glue(w, sp, 0)
                && strncmp(sp, "struct ", 7) != 0
                && strncmp(sp, "union ", 6) != 0) {
                lw_abort(w, "Lgluealias");
                return 0;
            }
            if (lw_spelling_by_value(sp) && strstr(sp, "__")
                && lw_type_needs_init(w, v->type)) {
                /* an instance spelling (`Box_Box__Circle`) resolves its vptr
                   items through the emitter's instance table, not the struct
                   row; keep the local on AST */
                lw_abort(w, "Lglueinst");
                return 0;
            }
            if (lw_spelling_by_value(sp)
                && lw_struct_has_vptr_array_field(w, sp)) {
                /* an array field of trait-carrying elements needs the
                   emitter's per-element vptr loop, not a flat item list */
                lw_abort(w, "Lgluearray");
                return 0;
            }
            /* D-013 / PH-81: an owning struct field initialised inside a raw
               brace initialiser keeps its own reference; rewrite before the
               vptr items are appended (the emitter's `sb_rewrite_init`). */
            if (s->nkids == 1 && !(v->dims && v->dims[0])) {
                struct ct_texpr *ir = &w->m->exprs[s->kids[0] - 1];
                if (ir->kind == TK_RAW && ir->text && ir->text[0] == '{'
                    && lw_spelling_container(sp)
                    && lw_raw_has_place_item(ir->text)) {
                    /* a container instance's raw initialiser hands an owning
                       payload from a place; its element glue retains it, and
                       the instance struct row does not spell the substituted
                       field type here */
                    lw_abort(w, "Linitplace");
                    return 0;
                }
                if (ir->kind == TK_RAW && ir->text && ir->text[0] == '{') {
                    init_text = lw_rewrite_struct_init(w, sp, ir->text,
                                                       (int)strlen(ir->text));
                    if (!init_text) { lw_abort(w, "Linitrewrite"); return 0; }
                }
            }
            if (sp && (strncmp(sp, "struct ", 7) == 0
                       || strncmp(sp, "union ", 6) == 0)) {
                const char *tag = strncmp(sp, "struct ", 7) == 0 ? sp + 7 : sp + 6;
                if (strchr(tag, '*')) {
                    /* A pointer to a struct: the emitter writes the vptr
                       statements after a heap allocation (a call to
                       malloc/calloc) and nothing for an aliasing initialiser.
                       The statements are keyed by the pointee's base name --
                       `emit_vptr_stmts` strips the stars just like the type
                       key it reads. */
                    if (s->nkids == 1) {
                        struct ct_texpr *it = &w->m->exprs[s->kids[0] - 1];
                        if ((it->kind == TK_CALL || it->kind == TK_INTRINSIC)
                            && it->text
                            && (strcmp(it->text, "malloc") == 0
                                || strcmp(it->text, "calloc") == 0)) {
                            char base[512], stmts[8192], recv[1024];
                            int bl, cs = 0;
                            snprintf(base, sizeof(base), "%s", tag);
                            bl = (int)strlen(base);
                            while (bl > 0 && (base[bl - 1] == '*'
                                              || base[bl - 1] == ' ')) bl--;
                            base[bl] = 0;
                            snprintf(recv, sizeof(recv), "(*%s)",
                                     v->name ? v->name : "");
                            if (lw_vptr_stmts(w, base, recv, stmts,
                                              (int)sizeof(stmts), &cs, 0) != 0) {
                                lw_abort(w, "L7552");
                                return 0;
                            }
                            if (cs > 0 && stmts[cs - 1] == '\n') cs--;
                            if (cs > 0) {
                                w->l->stmts[sid - 1].vptr =
                                    runtime::text::ct_intern_len(stmts, cs);
                                w->l->stmts[sid - 1].vptr_loop = 0;
                            }
                        }
                    }
                } else if (lw_type_needs_init(w, v->type)) {
                    char items[4096];
                    int iused = 0, inject = 0;
                    if (v->dims && v->dims[0]) {
                        /* an array of trait-carrying values: the emitter
                           prints the declaration, then one loop writing every
                           element's vptr. An initialised such array falls
                           back. */
                        char cnt[256], stmts[4096];
                        int ci = 0, cn = 0, cs = 0, k;
                        if (s->nkids != 0) { lw_abort(w, "L7555"); return 0; }
                        k = 0;
                        while (v->dims[k] && v->dims[k] != '[') k++;
                        if (v->dims[k] == '[') k++;
                        while (v->dims[k] && v->dims[k] != ']'
                               && ci < (int)sizeof(cnt) - 1)
                            cnt[ci++] = v->dims[k++];
                        cnt[ci] = 0;
                        if (ci == 0) { lw_abort(w, "L7555"); return 0; }
                        {
                            char recv[512];
                            snprintf(recv, sizeof(recv), "%s[__ct_i]",
                                     v->name ? v->name : "");
                            if (lw_vptr_stmts(w, tag, recv, stmts,
                                              (int)sizeof(stmts), &cs, 0) != 0
                                || cs == 0) {
                                lw_abort(w, "L7556");
                                return 0;
                            }
                            if (cs > 0 && stmts[cs - 1] == '\n') cs--;
                        }
                        (void)cn;
                        w->l->stmts[sid - 1].count = runtime::text::ct_intern(cnt);
                        w->l->stmts[sid - 1].vptr =
                            runtime::text::ct_intern_len(stmts, cs);
                        w->l->stmts[sid - 1].vptr_loop = 1;
                        *out = sid;
                        return 0;
                    }
                    if (lw_vptr_items(w, tag, "", items, (int)sizeof(items),
                                      &iused, 0) != 0) {
                        lw_abort(w, "L7553");
                        return 0;
                    }
                    if (iused == 0) inject = 0;
                    else if (s->nkids == 0) inject = 1;
                    else {
                        struct ct_texpr *it = &w->m->exprs[s->kids[0] - 1];
                        if (it->kind == TK_RAW && it->text && it->text[0]
                            && it->text[strlen(it->text) - 1] == '}')
                            inject = 1;
                    }
                    if (inject) {
                        char buf[8192];
                        int m = 0;
                        if (s->nkids == 0) {
                            m = snprintf(buf, sizeof(buf), "{ %s }", items);
                        } else {
                            struct ct_texpr *it = &w->m->exprs[s->kids[0] - 1];
                            const char *rt = init_text ? init_text : it->text;
                            int n = (int)strlen(rt) - 1;
                            int only_space = 1, q;
                            if (n < 0 || n >= (int)sizeof(buf) - 1
                                || n + iused + 4 >= (int)sizeof(buf)) {
                                lw_abort(w, "L7554");
                                return 0;
                            }
                            for (q = 1; q < n; q++)
                                if (rt[q] != ' ' && rt[q] != '\t'
                                    && rt[q] != '\n' && rt[q] != '\r')
                                    only_space = 0;
                            if (only_space) {
                                /* `{ }` gets the items directly, no comma */
                                m = snprintf(buf, sizeof(buf), "{ %s }", items);
                            } else {
                                memcpy(buf, rt, (size_t)n);
                                m = n;
                                buf[m++] = ',';
                                buf[m++] = ' ';
                                memcpy(buf + m, items, (size_t)iused);
                                m += iused;
                                buf[m++] = '}';
                                buf[m] = 0;
                            }
                        }
                        e = lmod_new_expr(w->l, LE_RAW, s->span.file,
                                          s->span.line, s->span.col);
                        if (e <= 0) { w->hard = 1; return 0; }
                        w->l->exprs[e - 1].text = runtime::text::ct_intern_len(buf, m);
                        w->l->exprs[e - 1].type = lw_type(w, v->type);
                        w->l->stmts[sid - 1].expr = e;
                        *out = sid;
                        return 0;
                    }
                }
            }
            {
                int sk = lw_own_kind(w, sp);
                /* An array is not a value the emitter tracks (its elements are
                   written by the container/source code); a borrowed initialiser
                   (`String v = *map.get(k)`) keeps no reference of its own. */
                if (sk && !v->is_static && !(v->dims && v->dims[0])) {
                    if (lw_sb_add(w, v->name, block, sk,
                                  lw_own_prefix(w, sp, sk),
                                  v->is_borrow ? 0 : 1) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                    if (s->nkids == 0) w->l->stmts[sid - 1].zero_init = 1;
                }
            }
            if (s->nkids == 1) {
                if (init_text) {
                    e = lmod_new_expr(w->l, LE_RAW, s->span.file,
                                      s->span.line, s->span.col);
                    if (e <= 0) { w->hard = 1; return 0; }
                    w->l->exprs[e - 1].text = init_text;
                    w->l->exprs[e - 1].type = lw_type(w, v->type);
                } else {
                    e = lw_expr(w, s->kids[0]);
                    if (e <= 0) return 0;
                }
                w->l->stmts[sid - 1].expr = e;
                /* D-013 §3: a local handle initialised from a place keeps its
                   own reference (`String b = a;` -> `String_retain(&(a))`). */
                {
                    int sk = lw_own_kind(w, sp);
                    if (sk && !v->is_static && !v->is_borrow
                        && !(v->dims && v->dims[0])
                        && lw_tir_is_place(&w->m->exprs[s->kids[0] - 1])) {
                        w->l->stmts[sid - 1].retain_rhs = 1;
                        w->l->stmts[sid - 1].retain_pfx =
                            lw_own_prefix(w, sp, sk);
                    }
                }
            }
            *out = sid;
            return 0;
        }
        case TS_DECLS: {
            int i;
            sid = lmod_new_stmt(w->l, LS_DECLS, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            for (i = 0; i < s->nkids; i++) {
                int sub = 0;
                if (w->m->stmts[s->kids[i] - 1].kind != TS_DECL) {
                    lw_abort(w, "L755");
                    return 0;
                }
                if (lw_one_stmt(w, s->kids[i], block, &sub) != 0) return 0;
                if (sub > 0 && lmod_stmt_add_kid(w->l, sid, sub) != 0) {
                    w->hard = 1;
                    return 0;
                }
            }
            *out = sid;
            return 0;
        }
        case TS_EXPR: {
            struct ct_texpr *t;
            if (s->nkids != 1) { lw_abort(w, "L757"); return 0; }
            t = &w->m->exprs[s->kids[0] - 1];
            if (lw_hoist_for(w, block,
                             t->kind == TK_ASSIGN ? t->kids[1] : s->kids[0],
                             1, 1) != 0)
                return 0;
            if (t->kind == TK_INTO_TARGET) {
                /* a bare `expr into { … };` is the promoted receiver and the
                   spliced block only; the emitter prints no statement. */
                *out = 0;
                return 0;
            }
            if (t->kind == TK_ASSIGN) {
                int tracked = -1;
                /* D-013 field dataflow: writing an owning value into a
                   struct field / array element needs the emitter's
                   release-old / maybe-uninitialised checks (`sb_assign` on
                   N_MEMBER / N_INDEX). This slice has no field-state
                   machine, so the function stays on the AST body seam. */
                if (t->op == 0 && t->nkids >= 2) {
                    struct ct_texpr *lt = &w->m->exprs[t->kids[0] - 1];
                    if (lt->kind == TK_FIELD && lt->op != 2) {
                        /* only a `.` member write on a struct local needs the
                           emitter's field-state machine; an arrow / index
                           target resolves its type differently on the AST
                           path and stays a plain assignment there */
                        const char *ltsp = backend::tir::tmod_cspell(w->m,
                                                                     lt->type);
                        /* a container field write is a plain assignment in
                           the emitter (its glue is the container's own); only
                           a String / owning ADT field needs the field-state
                           machine. */
                        if (lw_own_kind(w, ltsp) != 0) {
                            lw_abort(w, "Lownfield");
                            return 0;
                        }
                    }
                }
                sid = lmod_new_stmt(w->l, LS_ASSIGN, s->span.file, s->span.line, s->span.col);
                if (sid <= 0) { w->hard = 1; return 0; }
                w->l->stmts[sid - 1].aux = t->op;
                /* D-013 §3 / sb_assign: an owning-handle write is always
                   wrapped in `{ … }`, even when the old value is borrowed and
                   nothing is retained or released. The writer's brace is part
                   of the shape, so reproduce it here. */
                if (t->op == 0 && t->nkids >= 2
                    && lw_assign_brace(w, t->kids[0]) != 0)
                    w->l->stmts[sid - 1].brace = 1;
                /* D-013 §3: rebinding a tracked owning local holds the old
                   value, retains (or borrows) the new one, then releases the
                   old -- the same shape the emitter's `sb_assign` writes. */
                if (t->op == 0 && t->nkids >= 2
                    && w->m->exprs[t->kids[0] - 1].kind == TK_NAME_LOCAL)
                    tracked = lw_sb_find(w, w->m->exprs[t->kids[0] - 1].text);
                if (tracked >= 0 && !s->is_borrow && w->sb_own[tracked]) {
                    /* `struct String __ct_soldN = <lhs>; <lhs> = ...; release */
                    int stmp, ta = w->m->exprs[t->kids[0] - 1].target_a;
                    if (ta <= 0 || ta > w->m->nvars) {
                        lw_abort(w, "Lownrebind");
                        return 0;
                    }
                    stmp = lmod_new_temp(w->l, LTK_SOLD,
                                         w->m->vars[ta - 1].type, block);
                    if (stmp <= 0) { w->hard = 1; return 0; }
                    w->l->stmts[sid - 1].sold_temp = stmp;
                    w->l->stmts[sid - 1].value_type =
                        lmod_cspell(w->l, lw_type(w, w->m->vars[ta - 1].type));
                    w->l->stmts[sid - 1].retain_pfx = w->sb_prefix[tracked];
                    if (lw_tir_is_place(&w->m->exprs[t->kids[1] - 1]))
                        w->l->stmts[sid - 1].retain_rhs = 1;
                } else if (tracked >= 0 && s->is_borrow) {
                    /* a borrowed right-hand side: the target owns nothing */
                    w->sb_own[tracked] = 0;
                }
                e = lw_expr(w, t->kids[0]);
                if (e <= 0) return 0;
                w->l->stmts[sid - 1].expr = e;
                e = lw_expr(w, t->kids[1]);
                if (e <= 0) return 0;
                w->l->stmts[sid - 1].rhs = e;
            } else {
                sid = lmod_new_stmt(w->l, LS_EXPR, s->span.file, s->span.line, s->span.col);
                if (sid <= 0) { w->hard = 1; return 0; }
                e = lw_expr(w, s->kids[0]);
                if (e <= 0) return 0;
                w->l->stmts[sid - 1].expr = e;
            }
            *out = sid;
            return 0;
        }
        case TS_RET: {
            int ids[64];
            int n = 0, bid = block;
            struct ct_lblock *b = &w->l->blocks[bid - 1];
            if (b->term != LT_NONE) { lw_abort(w, "L783"); return 0; }
            if (s->nkids > 1) { lw_abort(w, "L784"); return 0; }
            if (s->nkids == 1
                && lw_hoist_for(w, block, s->kids[0], 1, 1) != 0)
                return 0;
            if (!w->stmt_is_last) {
                /* dead code follows this return (a label or a branch the
                   emitter still prints); keep the source order by making the
                   exit a statement on its own brace-less block. */
                bid = lmod_new_block(w->l, LB_BLOCK, s->scope, block);
                if (bid <= 0) { w->hard = 1; return 0; }
                b = &w->l->blocks[bid - 1];
                b->span.file = s->span.file;
                b->span.line = s->span.line;
                b->span.col = s->span.col;
            }
            b->term = LT_RETURN;
            b->term_err = s->err_edge;
            b->span.file = s->span.file;
            b->span.line = s->span.line;
            b->span.col = s->span.col;
            if (s->nkids == 1) {
                e = lw_expr(w, s->kids[0]);
                if (e <= 0) return 0;
                /* lowering the value may create blocks (arm bodies, nested
                   matches), which reallocates the block table: re-acquire. */
                b = &w->l->blocks[bid - 1];
                b->ret_expr = e;
            }
            if (lw_return_cleanups(w, block, s->err_edge, s->span.line,
                                   s->span.col, ids, &n) != 0) return 0;
            if (lw_add_cleanups_to_block(w, block, ids, n) != 0) return 0;
            {
                /* SH-102 first: a live owning string handle forces the value
                   into `__ct_sretN` and releases the other handles first.
                   D-013 §3: a return that hands back a *place* of an owning
                   type takes its own reference (`__ct_sretN =
                   <pfx>_retain(&__ct_sretN);`) -- a local handle is moved. */
                int q, moved = -1, active = 0;
                int ret_own, need_retain = 0, void_ret;
                const char *ret_pfx = 0;
                const char *rsp = lmod_cspell(w->l, w->ret_type);
                void_ret = w->ret_type > 0 && strcmp(rsp, "void") == 0;
                ret_own = (w->ret_type > 0 && lw_spelling_by_value(rsp))
                              ? lw_own_kind(w, rsp) : 0;
                if (ret_own)
                    ret_pfx = lw_own_prefix(w, rsp, ret_own);
                if ((strstr(rsp, "_iface") != 0 || lw_spelling_is_trait(w, rsp))
                    && s->nkids == 1) {
                    /* returning a *local struct value* as a trait interface
                       copies it into a heap box (SH-75, AST-only); returning
                       a pointer just wraps (void *)p + vtable */
                    struct ct_texpr *rv = &w->m->exprs[s->kids[0] - 1];
                    if (rv->kind == TK_BOX && rv->nkids >= 1)
                        rv = &w->m->exprs[rv->kids[0] - 1];
                    if (rv->kind == TK_NAME_LOCAL) {
                        int ptr = 0;
                        if (rv->target_a > 0 && rv->target_a <= w->m->nvars) {
                            const char *vt = backend::tir::tmod_cspell(w->m,
                                w->m->vars[rv->target_a - 1].type);
                            if (vt && strchr(vt, '*')) ptr = 1;
                        }
                        if (!ptr) {
                            lw_abort(w, "Lifaceret");
                            return 0;
                        }
                    }
                }
                if (ret_own && s->nkids == 1
                    && lw_spelling_view(backend::tir::tmod_cspell(w->m,
                            w->m->exprs[s->kids[0] - 1].type))) {
                    /* handing back a borrowed `Str` / `U16Str` where the
                       caller expects an owning handle is the emitter's
                       escape diagnostic; keep it on the AST body seam. */
                    lw_abort(w, "Lviewret");
                    return 0;
                }
                for (q = 0; q < w->sb_n; q++)
                    if (lw_block_within(w, block, w->sb_block[q])) active++;
                if (s->nkids == 1 && w->m->exprs[s->kids[0] - 1].kind
                    == TK_NAME_LOCAL) {
                    const char *nm = w->m->exprs[s->kids[0] - 1].text;
                    for (q = w->sb_n - 1; q >= 0; q--)
                        if (w->sb_name[q] && strcmp(w->sb_name[q], nm) == 0
                            && w->sb_own[q]
                            && lw_block_within(w, block, w->sb_block[q])) {
                            moved = q;
                            break;
                        }
                }
                if (ret_own && s->nkids == 1 && moved < 0)
                    need_retain = s->is_borrow
                                  || !lw_ret_is_fresh(w, s->kids[0]);
                if (active > 0) {
                    if (!void_ret) {
                        int t = lmod_new_temp(w->l, LTK_SRET, w->ret_type,
                                              block);
                        if (t <= 0) { w->hard = 1; return 0; }
                        b = &w->l->blocks[bid - 1];
                        b->ret_temp = t;
                        b->ret_retain = need_retain;
                        b->ret_pfx = ret_pfx;
                    }
                    for (q = w->sb_n - 1; q >= 0; q--) {
                        int rsid;
                        int view_ret = lw_spelling_view(rsp)
                            && b->ret_expr > 0
                            && lw_lir_mentions(w, b->ret_expr,
                                               w->sb_name[q]);
                        if (q == moved || !w->sb_own[q]) continue;
                        if (view_ret) continue;
                        if (!lw_block_within(w, block, w->sb_block[q])) continue;
                        rsid = lw_sb_release_stmt(w, q, 1, 0);
                        if (rsid <= 0) return 0;
                        if (lmod_block_add_cleanup(w->l, block, rsid) != 0) {
                            w->hard = 1;
                            return 0;
                        }
                    }
                } else if (ret_own && need_retain && b->ret_expr > 0
                           && !void_ret) {
                    int t = lmod_new_temp(w->l, LTK_SRET, w->ret_type, block);
                    if (t <= 0) { w->hard = 1; return 0; }
                    b = &w->l->blocks[bid - 1];
                    b->ret_temp = t;
                    b->ret_retain = 1;
                    b->ret_pfx = ret_pfx;
                } else if (b->ret_expr > 0 && w->ret_type > 0 && !void_ret
                           && lw_active_for_return(w, block, b->ret_expr,
                                                   s->span.line, s->span.col)) {
                    int t = lmod_new_temp(w->l, LTK_RET, w->ret_type, block);
                    if (t <= 0) { w->hard = 1; return 0; }
                    b = &w->l->blocks[bid - 1];
                    b->ret_temp = t;
                }
            }
            /* consumed by the block terminator, no separate statement --
               unless the exit got a brace-less block of its own. */
            if (!w->stmt_is_last) {
                sid = lmod_new_stmt(w->l, LS_RETBLOCK, s->span.file,
                                    s->span.line, s->span.col);
                if (sid <= 0) { w->hard = 1; return 0; }
                w->l->stmts[sid - 1].body_blk = (int)(b - w->l->blocks) + 1;
                *out = sid;
                return 0;
            }
            *out = 0;
            return 0;
        }
        case TS_IF: {
            int cond, then_blk = 0, else_blk = 0, kid = 0;
            if (s->nkids < 2) { lw_abort(w, "L811"); return 0; }
            if (lw_hoist_for(w, block, s->kids[0], 1, 0) != 0) return 0;
            cond = lw_expr(w, s->kids[0]);
            if (cond <= 0) return 0;
            kid = 1;
            if (s->flags & 1) {
                int k = s->kids[kid++];
                if (k <= 0 || w->m->stmts[k - 1].kind != TS_BLOCK) { lw_abort(w, "L817"); return 0; }
                then_blk = lw_block_stmt(w, k, LB_THEN, block);
                if (then_blk <= 0) return 0;
            }
            if (s->flags & 2) {
                int k = s->kids[kid++];
                if (k <= 0 || w->m->stmts[k - 1].kind != TS_BLOCK) { lw_abort(w, "L823"); return 0; }
                else_blk = lw_block_stmt(w, k, LB_ELSE, block);
                if (else_blk <= 0) return 0;
            }
            sid = lmod_new_stmt(w->l, LS_IF, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].cond = cond;
            w->l->stmts[sid - 1].then_blk = then_blk;
            w->l->stmts[sid - 1].else_blk = else_blk;
            *out = sid;
            return 0;
        }
        case TS_WHILE: {
            int cond, body_blk;
            if (s->nkids < 2 || !(s->flags & 1)) { lw_abort(w, "L837"); return 0; }
            if (lw_hoist_for(w, block, s->kids[0], 1, 0) != 0) return 0;
            cond = lw_expr(w, s->kids[0]);
            if (cond <= 0) return 0;
            if (w->m->stmts[s->kids[1] - 1].kind != TS_BLOCK) { lw_abort(w, "L840"); return 0; }
            body_blk = lw_block_stmt(w, s->kids[1], LB_WHILE_BODY, block);
            if (body_blk <= 0) return 0;
            sid = lmod_new_stmt(w->l, LS_WHILE, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].cond = cond;
            w->l->stmts[sid - 1].body_blk = body_blk;
            *out = sid;
            return 0;
        }
        case TS_FOR: {
            int init = 0, cond = 0, step = 0, body_blk = 0, kid = 0;
            int static_init = 0;
            if (s->flags & 1) {
                int k = s->kids[kid++];
                if (k <= 0) { lw_abort(w, "L854"); return 0; }
                /* `for (static int i = …; …)`: C99 only allows `register` or
                   no storage class in a for-init, so the emitter hoists the
                   declaration into a block and prints `for (; …)`. LIR
                   reproduces that shape in the printer (the declaration row
                   stays attached, `aux` marks the wrapper). */
                if (k <= w->m->nstmts && w->m->stmts[k - 1].kind == TS_DECL) {
                    int vi = w->m->stmts[k - 1].aux;
                    if (vi > 0 && vi <= w->m->nvars
                        && w->m->vars[vi - 1].is_static) {
                        static_init = 1;
                    }
                }
                if (lw_one_stmt(w, k, block, &init) != 0) return 0;
                if (init <= 0) { lw_abort(w, "L856"); return 0; }
            }
            if (s->flags & 2) {
                int ck = s->kids[kid++];
                if (lw_hoist_for(w, block, ck, 1, 0) != 0) return 0;
                cond = lw_expr(w, ck);
                if (cond <= 0) return 0;
            }
            if (s->flags & 4) {
                int sk = s->kids[kid++];
                if (lw_hoist_for(w, block, sk, 1, 0) != 0) return 0;
                step = lw_expr(w, sk);
                if (step <= 0) return 0;
            }
            if (s->flags & 8) {
                int k = s->kids[kid++];
                if (k <= 0 || w->m->stmts[k - 1].kind != TS_BLOCK) { lw_abort(w, "L868"); return 0; }
                body_blk = lw_block_stmt(w, k, LB_FOR_BODY, block);
                if (body_blk <= 0) return 0;
            }
            sid = lmod_new_stmt(w->l, LS_FOR, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].init_stmt = init;
            w->l->stmts[sid - 1].cond = cond;
            w->l->stmts[sid - 1].step = step;
            w->l->stmts[sid - 1].body_blk = body_blk;
            /* aux 1 tells the printer to wrap the declaration and the
               `for (; …)` in a block, the AST writer's static-for shape. */
            w->l->stmts[sid - 1].aux = static_init ? 1 : 0;
            *out = sid;
            return 0;
        }
        case TS_LOOP: {
            int n = s->nkids;
            int body = 0, has_range = 0;
            int k;
            if (n < 1) { lw_abort(w, "L900"); return 0; }
            if (n >= 1 && s->kids[n - 1] > 0
                && w->m->stmts[s->kids[n - 1] - 1].kind == TS_BLOCK) {
                body = s->kids[n - 1];
                n--;
            }
            if (n >= 2) has_range = 1;
            if (n < 1 || n > 2) { lw_abort(w, "L901"); return 0; }
            sid = lmod_new_stmt(w->l, LS_LOOP, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].aux = has_range;
            e = lw_expr(w, s->kids[0]);
            if (e <= 0) return 0;
            w->l->stmts[sid - 1].expr = e;
            if (has_range) {
                e = lw_expr(w, s->kids[1]);
                if (e <= 0) return 0;
                w->l->stmts[sid - 1].rhs = e;
            }
            k = w->l->tmp_next;
            w->l->tmp_next++;
            w->l->stmts[sid - 1].loop_k = k;
            if (body > 0) {
                blk = lw_block_stmt(w, body, LB_FOR_BODY, block);
                if (blk <= 0) return 0;
                w->l->stmts[sid - 1].body_blk = blk;
            }
            *out = sid;
            return 0;
        }
        case TS_FOREACH: {
            int n = s->nkids, body = 0, k;
            if (n < 1) { lw_abort(w, "L910"); return 0; }
            if (n >= 2 && s->kids[n - 1] > 0
                && w->m->stmts[s->kids[n - 1] - 1].kind == TS_BLOCK) {
                body = s->kids[n - 1];
            }
            sid = lmod_new_stmt(w->l, LS_FOREACH, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].aux = s->aux;      /* 0 array, 1 Vec, 2 Map, 3 slice */
            w->l->stmts[sid - 1].item_type = s->text;
            w->l->stmts[sid - 1].fname = s->text2;
            e = lw_expr(w, s->kids[0]);
            if (e <= 0) return 0;
            w->l->stmts[sid - 1].expr = e;
            k = w->l->tmp_next;
            w->l->tmp_next++;
            w->l->stmts[sid - 1].loop_k = k;
            if (body > 0) {
                blk = lw_block_stmt(w, body, LB_FOR_BODY, block);
                if (blk <= 0) return 0;
                w->l->stmts[sid - 1].body_blk = blk;
            }
            *out = sid;
            return 0;
        }
        case TS_BREAK:
        case TS_CONT: {
            int ids[64];
            int n = 0;
            if (s->nkids != 0) { lw_abort(w, "L885"); return 0; }
            sid = lmod_new_stmt(w->l, LS_JUMP, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].aux = s->kind == TS_BREAK ? LJ_BREAK : LJ_CONTINUE;
            w->l->stmts[sid - 1].err_edge = s->err_edge;
            w->l->stmts[sid - 1].target = s->kind == TS_BREAK
                                            ? lw_break_id(w) : lw_loop_id(w);
            w->l->stmts[sid - 1].scope = s->scope;
            if (lw_jump_cleanups(w, block, s->err_edge,
                                 s->kind == TS_CONT, s->span.line,
                                 s->span.col, ids, &n) != 0) return 0;
            if (lw_add_cleanups_to_stmt(w, sid, ids, n) != 0) return 0;
            /* SH-102: the jump skips the closing brace of every block it
               leaves, so the owning handles declared inside the loop / switch
               body are released here (after the defer cleanups, before the
               jump -- the emitter's `sb_jump_release`). */
            {
                int q;
                int target = w->l->stmts[sid - 1].target;
                for (q = w->sb_n - 1; q >= 0; q--) {
                    int rsid;
                    if (!w->sb_own[q] || w->sb_notail[q]) continue;
                    /* live at the jump (its block encloses this one) and
                       declared inside the construct being left */
                    if (!lw_block_within(w, block, w->sb_block[q])) continue;
                    if (!lw_block_within(w, w->sb_block[q], target)) continue;
                    rsid = lw_sb_release_stmt(w, q, w->sb_kind[q], 0);
                    if (rsid <= 0) return 0;
                    if (lmod_stmt_add_cleanup(w->l, sid, rsid) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
            }
            *out = sid;
            return 0;
        }
        case TS_DELETE: {
            /* A user `delete` (the parser-generated AutoDrop ones became
               cleanup entries): the emitter prints a guarded release, a Drop
               call first when the struct adopts Drop, and a null write when
               the operand is assignable (SH-40). */
            const char *sp, *base, *b;
            size_t bl;
            struct ct_texpr *te;
            if (s->nkids != 1) { lw_abort(w, "L9000"); return 0; }
            e = lw_expr(w, s->kids[0]);
            if (e <= 0) return 0;
            te = &w->m->exprs[s->kids[0] - 1];
            sp = backend::tir::tmod_cspell(w->m, te->type);
            if (!sp) sp = "";
            if (strncmp(sp, "struct ", 7) == 0) sp += 7;
            else if (strncmp(sp, "union ", 6) == 0) sp += 6;
            bl = strlen(sp);
            while (bl > 0 && (sp[bl - 1] == '*' || sp[bl - 1] == ' ')) bl--;
            b = runtime::text::ct_intern_len(sp, (int)bl);
            if (!b) { w->hard = 1; return 0; }
            base = b;
            sid = lmod_new_stmt(w->l, LS_DROP, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].expr = e;
            w->l->stmts[sid - 1].type = lw_type(w, te->type);
            w->l->stmts[sid - 1].name = base;
            w->l->stmts[sid - 1].aux = s->aux == 1 ? 1 : 2;
            w->l->stmts[sid - 1].assignable =
                (te->kind == TK_NAME_LOCAL || te->kind == TK_NAME_GLOBAL
                 || te->kind == TK_FIELD || te->kind == TK_INDEX
                 || te->kind == TK_DEREF);
            *out = sid;
            return 0;
        }
        case TS_SWITCH: {
            int cond, swblk;
            if (s->nkids < 2) { lw_abort(w, "L7900"); return 0; }
            if (lw_hoist_for(w, block, s->kids[0], 1, 0) != 0) return 0;
            cond = lw_expr(w, s->kids[0]);
            if (cond <= 0) return 0;
            swblk = lw_block_stmt(w, s->kids[1], LB_SWITCH, block);
            if (swblk <= 0) return 0;
            sid = lmod_new_stmt(w->l, LS_SWITCH, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].cond = cond;
            w->l->stmts[sid - 1].body_blk = swblk;
            *out = sid;
            return 0;
        }
        case TS_CASE: {
            int nval = s->aux ? 0 : ((s->flags & 1) ? 2 : 1);
            int i, v1 = 0, v2 = 0, cblk;
            if (s->nkids < nval) { lw_abort(w, "L7910"); return 0; }
            for (i = 0; i < nval; i++) {
                int ve = lw_expr(w, s->kids[i]);
                if (ve <= 0) return 0;
                if (i == 0) v1 = ve;
                else v2 = ve;
            }
            sid = lmod_new_stmt(w->l, LS_CASE, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].aux = s->aux;
            w->l->stmts[sid - 1].expr = v1;
            w->l->stmts[sid - 1].rhs = v2;
            cblk = lmod_new_block(w->l, LB_BLOCK, s->scope, block);
            if (cblk <= 0) { w->hard = 1; return 0; }
            for (i = nval; i < s->nkids; i++) {
                int sub = 0;
                if (lw_one_stmt(w, s->kids[i], cblk, &sub) != 0) return 0;
                if (sub > 0 && lmod_block_add_stmt(w->l, cblk, sub) != 0) {
                    w->hard = 1;
                    return 0;
                }
            }
            if (lw_tail_cleanups(w, cblk, s->scope, 0) != 0) return 0;
            w->l->stmts[sid - 1].body_blk = cblk;
            if (lmod_block_add_stmt(w->l, block, sid) != 0) {
                w->hard = 1;
                return 0;
            }
            *out = 0;
            return 0;
        }
        case TS_DO: {
            int cond, body;
            if (s->nkids < 2) { lw_abort(w, "L7920"); return 0; }
            if (lw_hoist_for(w, block, s->kids[1], 1, 0) != 0) return 0;
            body = lw_block_stmt(w, s->kids[0], LB_DO_BODY, block);
            if (body <= 0) return 0;
            cond = lw_expr(w, s->kids[1]);
            if (cond <= 0) return 0;
            sid = lmod_new_stmt(w->l, LS_DO, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].cond = cond;
            w->l->stmts[sid - 1].body_blk = body;
            *out = sid;
            return 0;
        }
        case TS_MATCH: {
            struct ct_tadt *a;
            int temp, j, nonadt, ext;
            char *cacc;
            int clen, ccap;
            nonadt = s->aux & 4;
            a = nonadt ? (struct ct_tadt *)0 : lw_adt_row(w, s->text);
            if (!nonadt && !a) { lw_abort(w, "L7830"); return 0; }
            /* v1-PH-2 S5: a guard turns the match into the flag-arm shape;
               an or-pattern alone keeps the if/else chain. */
            ext = 0;
            for (j = 1; j < s->nkids; j++)
                if (w->m->stmts[s->kids[j] - 1].guard >= 0) ext = 1;
            temp = lmod_new_temp(w->l, LTK_MATCH, 0, block);
            if (temp <= 0) { w->hard = 1; return 0; }
            sid = lmod_new_stmt(w->l, LS_MATCH, s->span.file, s->span.line,
                                s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            e = lw_expr(w, s->kids[0]);
            if (e <= 0) return 0;
            w->l->stmts[sid - 1].expr = e;
            w->l->stmts[sid - 1].name = nonadt
                ? (s->text2 ? s->text2 : "") : a->full;
            w->l->stmts[sid - 1].origin = temp;
            w->l->stmts[sid - 1].aux = s->aux | (ext ? 8 : 0);
            cacc = (char *)0;
            clen = 0;
            ccap = 0;
            for (j = 1; j < s->nkids; j++) {
                struct ct_tstmt *arm = &w->m->stmts[s->kids[j] - 1];
                int blk;
                if (lw_conds_put(&cacc, &clen, &ccap, arm->text2) != 0) {
                    free(cacc);
                    w->hard = 1;
                    return 0;
                }
                blk = lw_match_arm_block(w, s->kids[j], temp, 0, block,
                                         ext, (s->nkids - 1 > 1) ? 1 : 0);
                if (blk <= 0) {
                    free(cacc);
                    lw_abort(w, "L7831");
                    return 0;
                }
                if (lmod_stmt_add_kid(w->l, sid, (int)arm->num) != 0
                    || lmod_stmt_add_kid(w->l, sid, blk) != 0) {
                    free(cacc);
                    w->hard = 1;
                    return 0;
                }
            }
            w->l->stmts[sid - 1].spelling = runtime::text::ct_intern(
                cacc ? cacc : "");
            free(cacc);
            *out = sid;
            return 0;
        }
        case TS_GOTO: {
            if (!s->text || !s->text[0]) { lw_abort(w, "L899"); return 0; }
            sid = lmod_new_stmt(w->l, LS_GOTO, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].name = s->text;
            *out = sid;
            return 0;
        }
        case TS_LABEL: {
            int k;
            if (!s->text || !s->text[0]) { lw_abort(w, "L907"); return 0; }
            sid = lmod_new_stmt(w->l, LS_LABEL, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].name = s->text;
            /* The statements a label owns print one indentation level deeper
               (C99 forbids a declaration directly after a label, so the
               emitter writes an empty statement first). They live in a
               brace-less child block. */
            {
                int lk = lmod_new_block(w->l, LB_BLOCK, s->scope, block);
                if (lk <= 0) { w->hard = 1; return 0; }
                for (k = 0; k < s->nkids; k++) {
                    int sub = 0;
                    if (lw_one_stmt(w, s->kids[k], lk, &sub) != 0) return 0;
                    if (sub > 0 && lmod_block_add_stmt(w->l, lk, sub) != 0) {
                        w->hard = 1;
                        return 0;
                    }
                }
                w->l->stmts[sid - 1].body_blk = lk;
            }
            *out = sid;
            return 0;
        }
        case TS_BLOCK:
            blk = lw_block_stmt(w, tsid, LB_BLOCK, block);
            if (blk <= 0) return 0;
            sid = lmod_new_stmt(w->l, LS_BLOCK, s->span.file, s->span.line, s->span.col);
            if (sid <= 0) { w->hard = 1; return 0; }
            w->l->stmts[sid - 1].body_blk = blk;
            *out = sid;
            return 0;
        default:
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: unsupported TStmt kind=%d\n", s->kind);
            lw_abort(w, "L923");
            return 0;
    }
}

/* Fill a block from the statements of `tsid`. The block row already exists
   (so a loop body is on the loop stack before its body is lowered). */
static int lw_fill_block(struct Lower *w, int tsid, int blk)
{
    struct ct_tstmt *s;
    int i;

    if (tsid <= 0 || tsid > w->m->nstmts) { lw_abort(w, "L935"); return -1; }
    s = &w->m->stmts[tsid - 1];
    for (i = 0; i < s->nkids; i++) {
        int sid;
        if (w->aborted) return 0;
        w->stmt_is_last = (i == s->nkids - 1);
        if (lw_one_stmt(w, s->kids[i], blk, &sid) != 0) return -1;
        if (sid > 0) {
            if (lmod_block_add_stmt(w->l, blk, sid) != 0) { w->hard = 1; return -1; }
        }
    }
    return 0;
}

/* Create the LIR block for a TIR block row, without its statements. The root
   uses this first so the D-013 parameter retains can be registered (scope
   releases, exit cleanups) before any body statement lowers. */
static int lw_block_new(struct Lower *w, int tsid, int kind, int parent, int *loop)
{
    struct ct_tstmt *s;
    int blk;

    *loop = 0;
    if (tsid <= 0 || tsid > w->m->nstmts) { lw_abort(w, "L953"); return 0; }
    s = &w->m->stmts[tsid - 1];
    if (s->kind != TS_BLOCK) { lw_abort(w, "L955"); return 0; }
    blk = lmod_new_block(w->l, kind, s->scope, parent);
    if (blk <= 0) { w->hard = 1; return 0; }
    w->l->blocks[blk - 1].tir_stmt = s->id;
    w->l->blocks[blk - 1].span.file = s->span.file;
    w->l->blocks[blk - 1].span.line = s->span.line;
    w->l->blocks[blk - 1].span.col = s->span.col;
    if (kind == LB_WHILE_BODY || kind == LB_FOR_BODY || kind == LB_DO_BODY) {
        *loop = 1;
        if (lw_push_loop(w, blk) != 0) return 0;
        if (lw_push_break(w, blk) != 0) return 0;
    } else if (kind == LB_SWITCH) {
        if (lw_push_break(w, blk) != 0) return 0;
    }
    return blk;
}

static int lw_block_finish(struct Lower *w, int tsid, int blk, int kind)
{
    struct ct_tstmt *s = &w->m->stmts[tsid - 1];
    int loop = (kind == LB_WHILE_BODY || kind == LB_FOR_BODY
                || kind == LB_DO_BODY);

    if (w->aborted) return 0;
    if (lw_fill_block(w, tsid, blk) != 0) return -1;
    if (!w->aborted) {
        if (lw_tail_cleanups(w, blk, s->scope,
                             w->l->blocks[blk - 1].term == LT_RETURN) != 0)
            return 0;
        /* SH-102: the block's own owning handles are released at its closing
           brace, in reverse declaration order -- even after a `return` (the
           emitter prints that dead code too). */
        if (lw_sb_tail(w, blk) != 0) return 0;
        /* the fall-out terminator for condition blocks: a CondJump back to
           the loop header / to the join, recorded for the S8 CFG pass */
        if ((kind == LB_WHILE_BODY || kind == LB_FOR_BODY)
            && w->l->blocks[blk - 1].term == LT_NONE) {
            /* a body that ends in `return` keeps its terminator: the C loop
               already supplies the back edge, and the return must print. */
            w->l->blocks[blk - 1].term = LT_CONDJUMP;
        }
    }
    if (kind == LB_SWITCH) w->nbreaks--;
    if (loop) { w->nloops--; w->nbreaks--; }
    return blk;
}

static int lw_block_stmt(struct Lower *w, int tsid, int kind, int parent)
{
    int blk, loop = 0;

    blk = lw_block_new(w, tsid, kind, parent, &loop);
    if (blk <= 0) return 0;
    return lw_block_finish(w, tsid, blk, kind);
}

/* ------------------------------------------------------------------------- */
/* Functions and the program                                                 */
/* ------------------------------------------------------------------------- */
/* The owning locals declared in `blk` are released at its closing brace, in
   reverse declaration order. */
static int lw_sb_tail(struct Lower *w, int blk)
{
    int q;

    for (q = w->sb_n - 1; q >= 0; q--) {
        int rsid;
        if (w->sb_block[q] != blk || !w->sb_own[q] || w->sb_notail[q]) continue;
        rsid = lw_sb_release_stmt(w, q, w->sb_kind[q], 0);
        if (rsid <= 0) return -1;
        if (lmod_block_add_tail(w->l, blk, rsid) != 0) {
            w->hard = 1;
            return -1;
        }
    }
    return 0;
}

static int lw_lower_func(struct Lower *w, int decl)
{
    struct ct_tdecl *d = &w->m->decls[decl - 1];
    int f, start_blocks, i, root;
    const char *rs;

    if (d->body <= 0) return 0;            /* prototype only; the shell prints it */
    if (lw_decl_is_template(w, d)) return 0;  /* no C body of its own */
    w->l->stat_funcs++;
    rs = backend::tir::tmod_cspell(w->m, d->type);
    if (!rs) rs = "void";
    f = lmod_new_func(w->l, d->name, lw_type_text(w, rs), decl);
    if (f <= 0) { w->hard = 1; return 0; }
    w->l->funcs[f - 1].is_static = d->is_static;
    if (d->cname && d->cname[0])
        w->l->funcs[f - 1].cname = runtime::text::ct_intern(d->cname);
    w->l->funcs[f - 1].seam = (d->is_method && d->cname && d->cname[0])
                                  ? w->l->funcs[f - 1].cname
                                  : runtime::text::ct_intern(d->name);
    w->func = f;
    w->func_scope = d->scope;
    w->func_has_self = 0;
    w->cv_n = 0;
    w->sb_n = 0;
    w->p_n = 0;
    w->h_nmap = 0;
    w->h_into_n = 0;
    w->ret_type = w->l->funcs[f - 1].ret;
    if ((strstr(rs, "_iface") != 0)
        || (lw_spelling_by_value(rs) && lw_own_kind(w, rs) != 0)) {
        /* D-013: a by-value owning result is materialised into __ct_sretN and
           the live handles are released first; an interface of a local value
           is boxed by the AST writer. */
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: return type '%s' needs owning glue\n", rs);
        w->aborted = 1;
    }
    /* Temps are function-local in the product, so number them from zero and
       let the seam shift the whole body by the emitter's counter at entry.
       A module-wide counter would encode the *lowering* order, which is not
       the emission order (impl methods are written before plain functions). */
    w->l->tmp_next = 0;
    w->l->funcs[f - 1].temp_start = w->l->tmp_next;
    {
        int start_temps = w->l->ntemps;
        w->tmp_start_temps = start_temps;
    }
    w->aborted = 0;
    w->drop_seen = 0;
    w->expr_depth = 0;
    w->hoist_depth = 0;
    w->nloops = 0;
    start_blocks = w->l->nblocks;
    /* parameters, in source order, from the function scope's variable rows */
    if (d->scope > 0 && d->scope <= w->m->nscopes) {
        struct ct_tscope *sc = &w->m->scopes[d->scope - 1];
        for (i = 0; i < sc->nvars; i++) {
            struct ct_tvar *v;
            int vi = sc->vars[i];
            if (vi <= 0 || vi > w->m->nvars) continue;
            v = &w->m->vars[vi - 1];
            if (!v->is_param) continue;
            if (backend::tir::tmod_has_free_param(w->m, v->type)) {
                w->aborted = 1;
                break;
            }
            {
                const char *psp = backend::tir::tmod_cspell(w->m, v->type);
                int pk;
                if (v->is_ref && lw_spelling_by_value(psp)
                    && lw_own_kind(w, psp) != 0) {
                    /* a `ref` / `out` owning handle target is the caller's
                       storage; the emitter's param_own rebind contract is not
                       part of this slice */
                    w->aborted = 1;
                    break;
                }
                pk = (!v->is_ref && lw_spelling_by_value(psp))
                         ? lw_own_kind(w, psp) : 0;
                if (pk && w->p_n < 64) {
                    /* D-013 §3: a by-value owning parameter is retained at
                       entry (the caller keeps its own reference) and the
                       callee releases it on every exit. Registered before the
                       body so exits see it; the root block is created first. */
                    w->p_name[w->p_n] = v->name;
                    w->p_prefix[w->p_n] = lw_own_prefix(w, psp, pk);
                    w->p_kind[w->p_n] = pk;
                    w->p_n++;
                }
            }
            if (lmod_func_add_param(w->l, f, v->name, lw_type(w, v->type), 0) != 0) {
                w->hard = 1;
                return 0;
            }
            if (d->is_method && v->name && strcmp(v->name, "self") == 0)
                w->func_has_self = 1;
        }
    }
    if (!w->aborted) {
        int rloop = 0;
        root = lw_block_new(w, d->body, LB_ROOT, 0, &rloop);
        if (root <= 0) { w->hard = 1; return 0; }
        w->root = root;
        w->l->funcs[f - 1].root = root;
        /* the parameter retains come before every body statement */
        for (i = 0; i < w->p_n; i++) {
            int rsid = lmod_new_stmt(w->l, LS_RETAINPARAM,
                                     w->l->blocks[root - 1].span.file,
                                     w->l->blocks[root - 1].span.line,
                                     w->l->blocks[root - 1].span.col);
            if (rsid <= 0) { w->hard = 1; return 0; }
            if (lw_sb_add2(w, w->p_name[i], root, w->p_kind[i],
                           w->p_prefix[i], 1, d->is_method ? 1 : 0) != 0) {
                w->hard = 1;
                return 0;
            }
            w->l->stmts[rsid - 1].name = w->sb_name[w->sb_n - 1];
            w->l->stmts[rsid - 1].retain_pfx = w->p_prefix[i];
            /* An impl method's prologue is printed by the emitter, which
               writes its own `sb_retain_params`; only a plain function body
               owes the entry retains. The scope tracking is the same. */
            if (!d->is_method
                && lmod_block_add_stmt(w->l, root, rsid) != 0) {
                w->hard = 1;
                return 0;
            }
        }
        if (lw_block_finish(w, d->body, root, LB_ROOT) <= 0) {
            w->hard = 1;
            return 0;
        }
    }
    for (i = start_blocks; i < w->l->nblocks; i++)
        if (lmod_func_add_block(w->l, f, i + 1) != 0) { w->hard = 1; return 0; }
    w->l->funcs[f - 1].temp_end = w->l->tmp_next;
    if (w->aborted || w->hard || w->drop_seen || w->no_bodies) {
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: function '%s' not lowered\n", d->name ? d->name : "");
        w->l->funcs[f - 1].ok = 0;
        w->l->ready = 0;
        /* The body stays on the AST path, so its `__ct_*N` allocations never
           happen in the product: give the numbers back or every later body
           starts at a counter the emitter never reached. */
        w->l->tmp_next = w->l->funcs[f - 1].temp_start;
        w->l->ntemps = w->tmp_start_temps;
        w->l->funcs[f - 1].temp_end = w->l->tmp_next;
        if (w->hard) return -1;
    } else {
        w->l->funcs[f - 1].ok = 1;
        w->l->stat_funcs_ok++;
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: lowered '%s' seam='%s'\n",
                    d->name ? d->name : "",
                    w->l->funcs[f - 1].seam ? w->l->funcs[f - 1].seam : "");
        if (lmod_add_decl(w->l, f) != 0) { w->hard = 1; return -1; }
    }
    return 0;
}

/* Copy the TIR scope / cleanup tables so the verifier recomputes exits from
   LIR alone. Compile mode starts empty, so ids line up. */
static int lw_copy_scopes(struct Lower *w)
{
    int i, k;

    for (i = 0; i < w->m->nscopes; i++) {
        struct ct_tscope *s = &w->m->scopes[i];
        int ls = lmod_new_scope(w->l, s->parent, s->kind);
        if (ls <= 0) return -1;
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: scope %d kind=%d parent=%d ncleanups=%d\n",
                    s->id, s->kind, s->parent, s->ncleanups);
        for (k = 0; k < s->ncleanups; k++) {
            int cid = s->cleanups[k];
            struct ct_tcleanup *c;
            if (cid <= 0 || cid > w->m->ncleanups) return -1;
            c = &w->m->cleanups[cid - 1];
            if (lmod_scope_add_cleanup(w->l, ls, c->kind, c->body, c->on_error,
                                       c->span.file, c->span.line, c->span.col) <= 0)
                return -1;
        }
    }
    return 0;
}

/* Lower every declaration of one unit's slice. `start` is the decl count
   before the TIR builder ran, so only this unit's rows are visited. */
static int lw_lower_slice(struct Lower *w, int unit, int start)
{
    struct TModule *m = w->m;
    int i;

    for (i = start; i < m->ndecls; i++) {
        struct ct_tdecl *d = &m->decls[i];
        if (d->unit != unit) continue;
        if (d->kind != TD_FUNC) {
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: top-level decl kind=%d name=%s\n",
                        d->kind, d->name ? d->name : "");
            continue;   /* the program shell prints every declaration */
        }
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: func decl '%s' body=%d template=%d unit=%d/%d\n",
                    d->name ? d->name : "", d->body, d->is_template, d->unit, unit);
        if (lw_lower_func(w, d->id) != 0) {
            fprintf(stderr, "lir: a LIR pool refused a row\n");
            return 1;
        }
    }
    if (w->hard) {
        fprintf(stderr, "lir: a LIR pool refused a row\n");
        return 1;
    }
    w->l->ready = (w->l->stat_funcs == 0
                   || w->l->stat_funcs_ok == w->l->stat_funcs);
    return 0;
}

pub int ct_lir_build_program(int prog, const char *path, const char *base,
                             const char *ns, int is_hdr, int is_map)
{
    struct Lower *w = &g_lower;
    struct LModule *l = lmod_get();
    struct TModule *m;
    struct ct_tmark mark;
    int unit, start;

    if (!ct_lir_on()) return 0;
    lmod_reset(l);
    /* the reset clears `enabled`; the switch is on (just checked) and the
       body seam reads this flag when the emitter asks for a body. */
    l->enabled = 1;
    w->l = l;
    w->m = backend::tir::tmod_get();
    m = w->m;
    w->hard = 0;
    w->drop_seen = 0;
    w->unit = 0;
    w->aborted = 0;
    w->no_bodies = g_lower.global_no_bodies;
    w->func = 0;
    w->loops = 0;
    w->nloops = 0;
    w->loopcap = 0;
    backend::tir::tmod_mark(m, &mark);
    start = mark.ndecls;
    {
        /* A defaulted (not requested) run may fall back to the AST writer; the
           TIR/LIR reporters are silenced then, so the fallback cannot leak a
           finding the AST path would not print. */
        int quiet = ct_lir_quiet_fallback();
        int trc;
        backend::verify::ct_verifier_set_quiet(quiet);
        trc = backend::tir::ct_tir_build_program(prog, path, base, ns, is_hdr, is_map);
        backend::verify::ct_verifier_set_quiet(0);
        if (trc != 0) return quiet ? 2 : 1;
    }
    unit = m->nunits;
    w->unit = unit;
    l->path = path;
    if (lw_tables_have_into(w, &mark)) {
        /* No lowering at all: the abort would otherwise leave half-built
           hoist rows. AST prints the unit byte for byte. */
        ct_lir_set_switch(0);
        return 0;
    }
    if (runtime::arena::arena_get()->noutconv > 0) w->no_bodies = 1;
    if (lw_tables_have_long_text(w, &mark)) {
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: a >%d-byte name keeps this unit on AST\n",
                    LW_NAME_MAX);
        w->no_bodies = 1;
    }
    l->ready = 1;
    if (lw_copy_scopes(w) != 0) {
        fprintf(stderr, "lir: cannot copy the scope table\n");
        return 1;
    }
    if (getenv("CT_LIR_DEBUG")) {
        int di;
        for (di = 0; di < m->nstmts; di++)
            fprintf(stderr, "lir: tir stmt %d kind=%d kids=%d scope=%d\n",
                    di + 1, m->stmts[di].kind, m->stmts[di].nkids,
                    m->stmts[di].scope);
    }
    if (lw_lower_slice(w, unit, start) != 0) return 1;
    /* CP2: the LIR verifier runs before the caller opens the output file, so
       a negative leaves no `.c` behind. Fault injection is the test seam. */
    {
        int quiet = ct_lir_quiet_fallback();
        int vrc;
        backend::verify::ct_lir_verify_set_quiet(quiet);
        vrc = backend::verify::ct_lir_verify(l);
        backend::verify::ct_lir_verify_set_quiet(0);
        if (vrc != 0) return quiet ? 2 : 1;
    }
    lmod_report(l, base ? base : path);
    free(w->loops);
    w->loops = 0;
    w->nloops = 0;
    w->loopcap = 0;
    free(w->breaks);
    w->breaks = 0;
    w->nbreaks = 0;
    w->breakcap = 0;
    return 0;
}

/* Build mode: one unit at a time. The module layer calls this immediately
   before that unit's `.c` is opened, so a verifier failure leaves no product
   for the failing unit. `tmp_base` is the emitter's module-wide `__ct_*N`
   counter at this unit's start; the lowerer resumes from it so a body can be
   printed when both walkers agree on the numbering. */
pub int ct_lir_build_unit(void *up, int mod_unit, int tmp_base)
{
    struct Lower *w = &g_lower;
    struct LModule *l = lmod_get();
    struct TModule *m;
    struct ct_tmark mark;
    int unit, start;

    if (!ct_lir_on()) return 0;
    lmod_reset(l);
    /* the reset clears `enabled`; the switch is on (just checked) and the
       body seam reads this flag when the emitter asks for a body. */
    l->enabled = 1;
    w->l = l;
    w->m = backend::tir::tmod_get();
    m = w->m;
    w->hard = 0;
    w->drop_seen = 0;
    w->aborted = 0;
    w->no_bodies = g_lower.global_no_bodies;
    w->func = 0;
    w->loops = 0;
    w->nloops = 0;
    w->loopcap = 0;
    backend::tir::tmod_mark(m, &mark);
    start = mark.ndecls;
    if (backend::tir::ct_tir_build_unit(up, mod_unit) != 0) return 1;
    unit = m->nunits;
    w->unit = unit;
    {
        struct Unit *uu = (struct Unit *)up;
        if (uu) l->path = uu->path;
    }
    (void)tmp_base;   /* per-function temp numbering: no seed from the emitter */
    if (lw_tables_have_into(w, &mark)) {
        l->ready = 0;
        return 0;
    }
    {
        struct Unit *uu = (struct Unit *)up;
        if (uu && (uu->has_outconv || uu->has_anon_typedef)) w->no_bodies = 1;
    }
    if (lw_tables_have_long_text(w, &mark)) w->no_bodies = 1;
    l->ready = 1;
    if (lw_copy_scopes(w) != 0) {
        fprintf(stderr, "lir: cannot copy the scope table\n");
        return 1;
    }
    if (lw_lower_slice(w, unit, start) != 0) return 1;
    if (backend::verify::ct_lir_verify(l) != 0) return 1;
    lmod_report(l, "build-unit");
    free(w->loops);
    w->loops = 0;
    w->nloops = 0;
    w->loopcap = 0;
    free(w->breaks);
    w->breaks = 0;
    w->nbreaks = 0;
    w->breakcap = 0;
    return 0;
}

/* ------------------------------------------------------------------------- */
/* Printing: LIR -> C (the subset, byte for byte)                            */
/* ------------------------------------------------------------------------- */
#define PW_EXPR   1
#define PW_COND   2
#define PW_INLINE 3

static FILE *g_lir_out;

/* Find group `gi` of a `|`-separated cond encoding (the S5 or-pattern). */
static int lw_cond_group(const char *enc, int gi, const char **start,
                         const char **end)
{
    const char *p = enc;
    int i;

    for (i = 0; ; i++) {
        const char *bar = strchr(p, '|');
        if (i == gi) {
            *start = p;
            *end = bar ? bar : p + strlen(p);
            return 0;
        }
        if (!bar) return -1;
        p = bar + 1;
    }
}

/* One test row: `<path> == <value>;` -> `(m<path> == <value>)`. */
static int lw_pw_cond_row(const char *m, const char *p, const char *end,
                          int leading_and)
{
    const char *eq = 0, *semi = 0, *q;

    for (q = p; q < end; q++) {
        if (*q == '=' && !eq) eq = q;
        if (*q == ';') { semi = q; break; }
    }
    if (!eq || !semi || eq > semi) return -1;
    if (leading_and) fputs(" && ", g_lir_out);
    fputs("(", g_lir_out);
    fputs(m, g_lir_out);
    fwrite(p, 1, (size_t)(eq - p), g_lir_out);
    fputs(" == ", g_lir_out);
    fwrite(eq + 1, 1, (size_t)(semi - eq - 1), g_lir_out);
    fputs(")", g_lir_out);
    return 0;
}

/* One group's rows, joined by `&&`, without a leading operator; empty = `1`. */
static int lw_pw_cond_rows(const char *m, const char *p, const char *end)
{
    int first = 1;

    if (p >= end) { fputs("1", g_lir_out); return 0; }
    while (p < end) {
        const char *semi;
        if (lw_pw_cond_row(m, p, end, !first) != 0) return -1;
        first = 0;
        semi = p;
        while (semi < end && *semi != ';') semi++;
        p = semi + 1;
    }
    return 0;
}

/* An or-pattern binding's value: one nested ternary over the groups, each
   group selecting the same name from its own variant path. `enc` is the
   `gi:path,gi:path` encoding; `conds` is the arm's `|`-separated tests. */
static int lw_pw_or_bind(const char *m, const char *enc, const char *conds)
{
    const char *p = enc;
    int nentry = 1, i;

    for (i = 0; p[i]; i++)
        if (p[i] == ',') nentry++;
    for (i = 0; i < nentry; i++) {
        const char *colon = strchr(p, ':');
        const char *comma = strchr(p, ',');
        int gi = 0;
        const char *q, *gs, *ge;

        if (!colon) return -1;
        for (q = p; q < colon; q++) {
            if (*q < '0' || *q > '9') return -1;
            gi = gi * 10 + (*q - '0');
        }
        if (lw_cond_group(conds, gi, &gs, &ge) != 0) return -1;
        fputs("(", g_lir_out);
        if (lw_pw_cond_rows(m, gs, ge) != 0) return -1;
        fputs(" ? ", g_lir_out);
        fputs(m, g_lir_out);
        if (comma) fwrite(colon + 1, 1, (size_t)(comma - colon - 1), g_lir_out);
        else fputs(colon + 1, g_lir_out);
        fputs(" : ", g_lir_out);
        p = comma ? comma + 1 : colon + 1 + strlen(colon + 1);
    }
    /* the last group's value, then one closing paren per ternary */
    {
        const char *colon = strrchr(enc, ':');
        if (!colon) return -1;
        fputs(m, g_lir_out);
        fputs(colon + 1, g_lir_out);
    }
    for (i = 0; i < nentry; i++) fputs(")", g_lir_out);
    return 0;
}

static int lw_pw_conds(const char *m, const char *seg)
{
    if (!seg) return 0;
    if (strchr(seg, '|')) {
        int gi = 0;
        fputs(" && (", g_lir_out);
        for (;;) {
            const char *gs, *ge;
            if (lw_cond_group(seg, gi, &gs, &ge) != 0) break;
            if (gi > 0) fputs(" || ", g_lir_out);
            fputs("(", g_lir_out);
            if (lw_pw_cond_rows(m, gs, ge) != 0) return -1;
            fputs(")", g_lir_out);
            gi++;
        }
        fputs(")", g_lir_out);
        return 0;
    }
    while (*seg) {
        const char *eq;
        const char *semi;

        eq = strchr(seg, '=');
        semi = strchr(seg, ';');
        if (!eq || !semi || eq > semi) return -1;
        fputs(" && (", g_lir_out);
        fputs(m, g_lir_out);
        fwrite(seg, 1, (size_t)(eq - seg), g_lir_out);
        fputs(" == ", g_lir_out);
        fwrite(eq + 1, 1, (size_t)(semi - eq - 1), g_lir_out);
        fputs(")", g_lir_out);
        seg = semi + 1;
    }
    return 0;
}
static int g_lir_range_k;   /* the range initialiser's current index */

static void lw_ind(int ind)
{
    int i;
    for (i = 0; i < ind; i++) fputs("    ", g_lir_out);
}

static const char *lw_bin_op(int op)
{
    switch (op) {
        case LB_SUB: return "-";
        case LB_MUL: return "*";
        case LB_DIV: return "/";
        case LB_MOD: return "%";
        case LB_LT: return "<";
        case LB_GT: return ">";
        case LB_LE: return "<=";
        case LB_GE: return ">=";
        case LB_EQ: return "==";
        case LB_NE: return "!=";
        case LB_AND: return "&&";
        case LB_OR: return "||";
        case LB_XOR: return "^";
        case LB_BAND: return "&";
        case LB_BOR: return "|";
        case LB_SHL: return "<<";
        case LB_SHR: return ">>";
        case LB_COMMA: return ",";
        default: return "+";
    }
}

static const char *lw_assign_op(int op)
{
    switch (op) {
        case 1: return " += ";
        case 2: return " -= ";
        case 3: return " *= ";
        case 4: return " /= ";
        case 5: return " %= ";
        case 6: return " &= ";
        case 7: return " |= ";
        case 8: return " ^= ";
        case 9: return " <<= ";
        case 10: return " >>= ";
        default: return " = ";
    }
}

static int lw_pw_expr(struct Lower *w, int eid, int ctx);

static int lw_pw_kid(struct Lower *w, struct ct_lexpr *e, int i, int ctx)
{
    if (i < 0 || i >= e->nkids) return -1;
    return lw_pw_expr(w, e->kids[i], ctx);
}

static int lw_pw_expr(struct Lower *w, int eid, int ctx)
{
    struct ct_lexpr *e;
    int i;

    if (eid <= 0 || eid > w->l->nexprs) return -1;
    e = &w->l->exprs[eid - 1];
    switch (e->kind) {
        case LE_NUM:
            fprintf(g_lir_out, "%ld%s", e->num, e->text ? e->text : "");
            return 0;
        case LE_FNUM:
        case LE_STR:
        case LE_NAME:
            fputs(e->text ? e->text : "", g_lir_out);
            return 0;
        case LE_SLICE: {
            const char *et = e->text ? e->text : "";
            int sub = e->op, aux = (int)e->num;
            if (sub == 0) {
                fputs("(*(", g_lir_out);
                fputs(et, g_lir_out);
                fputs(" *)__ct_slice_at(&(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs("), ", g_lir_out);
                if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
                fputs(", sizeof(", g_lir_out);
                fputs(et, g_lir_out);
                fputs(")))", g_lir_out);
                return 0;
            }
            if (sub == 2) {
                fputs("((", g_lir_out);
                fputs(et, g_lir_out);
                fputs(" *)__ct_slice_get(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
                fputs(", sizeof(", g_lir_out);
                fputs(et, g_lir_out);
                fputs(")))", g_lir_out);
                return 0;
            }
            if (aux == 3) {
                fputs("(struct __ct_slice){ (void *)(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs("), (int)(sizeof(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(") / sizeof((", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(")[0])) }", g_lir_out);
                return 0;
            }
            fputs("__ct_slice_range((void *)(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(aux == 1 ? "), " : ").ptr, ", g_lir_out);
            if (aux == 1) {
                fputs("(int)(sizeof(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(") / sizeof((", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(")[0]))", g_lir_out);
            } else {
                fputs("(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(").len", g_lir_out);
            }
            fputs(", ", g_lir_out);
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs(", ", g_lir_out);
            if (e->nkids > 2) {
                if (lw_pw_kid(w, e, 2, PW_EXPR) != 0) return -1;
            } else if (aux == 1) {
                fputs("(int)(sizeof(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(") / sizeof((", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(")[0]))", g_lir_out);
            } else {
                fputs("(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(").len", g_lir_out);
            }
            fprintf(g_lir_out, ", sizeof(%s), \"%s:%d\")", et,
                    w->l->path ? w->l->path : "", e->span.line);
            return 0;
        }
        case LE_COMPOUND: {
            const char *sp = e->text ? e->text : "";
            const char *tag = sp;
            char base[512], items[8192];
            int bl, nuses = 0, iused = 0;
            if (strncmp(tag, "struct ", 7) == 0) tag += 7;
            else if (strncmp(tag, "union ", 6) == 0) tag += 6;
            bl = (int)strlen(tag);
            while (bl > 0 && (tag[bl - 1] == '*' || tag[bl - 1] == ' ')) bl--;
            if (bl > 0 && bl < (int)sizeof(base)) {
                struct ct_tstruct *row;
                memcpy(base, tag, (size_t)bl);
                base[bl] = 0;
                row = lw_struct_row(w, base);
                if (row && row->nuses > 0) {
                    nuses = 1;
                    if (lw_vptr_items(w, base, "", items, (int)sizeof(items),
                                      &iused, 0) != 0) return -1;
                }
            }
            fprintf(g_lir_out, "(%s)", sp);
            if (nuses && e->nkids == 1) {
                struct ct_lexpr *k = &w->l->exprs[e->kids[0] - 1];
                if (k->kind == LE_RAW && k->text) {
                    const char *r = k->text;
                    int len = (int)strlen(r), only = 1, q;
                    if (len >= 2 && r[len - 1] == '}') {
                        for (q = 1; q < len - 1; q++)
                            if (r[q] != ' ' && r[q] != '\t'
                                && r[q] != '\n' && r[q] != '\r') only = 0;
                        if (only) {
                            fprintf(g_lir_out, "{ %s }", items);
                            return 0;
                        }
                        fwrite(r, 1, (size_t)(len - 1), g_lir_out);
                        fprintf(g_lir_out, ", %s}", items);
                        return 0;
                    }
                }
            }
            for (i = 0; i < e->nkids; i++)
                if (lw_pw_kid(w, e, i, PW_EXPR) != 0) return -1;
            return 0;
        }
        case LE_STRLIT:
            if (e->op == 1) {
                fprintf(g_lir_out,
                        "((struct String){ (char *)ct_str_lit_%ld.d,"
                        " (int)(sizeof(ct_str_lit_%ld.d) - 1) })",
                        e->num, e->num);
            } else if (e->op == 2) {
                fprintf(g_lir_out,
                        "((struct Str){ (char *)%s, (int)(sizeof(%s) - 1) })",
                        e->text ? e->text : "",
                        e->text ? e->text : "");
            } else {
                fputs(e->text ? e->text : "", g_lir_out);
            }
            return 0;
        case LE_TEMP: {
            const char *nm = lmod_temp_name(w->l, (int)e->num, w->tmp_delta);
            if (e->op == 1) fputs("(*", g_lir_out);
            fputs(nm, g_lir_out);
            if (e->op == 1) fputs(")", g_lir_out);
            return 0;
        }
        case LE_CLOSURE_ARG:
            fprintf(g_lir_out, "__ct_cl_tramp_%ld, &(struct __ct_cl_env_%ld){ %s }",
                    e->num, e->num, e->text ? e->text : "0");
            return 0;
        case LE_CLOSURE_PAIR:
            fprintf(g_lir_out, "__ct_cl_tramp_%ld, &__ct_cl_env_v_%ld",
                    e->num, e->num);
            return 0;
        case LE_CLOSURE_CALL:
            fprintf(g_lir_out, "__ct_cl_tramp_%ld(&__ct_cl_env_v_%ld",
                    e->num, e->num);
            for (i = 0; i < e->nkids; i++) {
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, i, PW_EXPR) != 0) return -1;
            }
            fputs(")", g_lir_out);
            return 0;
        case LE_ADTCTOR: {
            struct ct_tadt *a = lw_adt_row(w, e->text);
            struct ct_tadvariant *v;
            int j;
            if (!a || e->num < 0 || e->num >= a->nvariants) return -1;
            v = &a->variants[(int)e->num];
            fprintf(g_lir_out, "((struct %s){ .tag = %d", a->full, (int)e->num);
            if (v->nfields > 0) {
                fprintf(g_lir_out, ", .u = { .%s = { ", v->cname);
                for (j = 0; j < e->nkids && j < v->nfields; j++) {
                    if (j > 0) fputs(", ", g_lir_out);
                    fprintf(g_lir_out, ".%s = (", v->fields[j].name);
                    if (lw_pw_kid(w, e, j, PW_EXPR) != 0) return -1;
                    fputs(")", g_lir_out);
                }
                fputs(" } }", g_lir_out);
            }
            fputs(" })", g_lir_out);
            return 0;
        }
        case LE_MATCHEXPR: {
            int kn = (int)e->num;
            int k = lmod_temp_num(w->l, kn, w->tmp_delta);
            char mbuf[64];
            const char *m = mbuf;
            int narm = (e->nkids - 1) / 2, j;
            snprintf(mbuf, sizeof(mbuf), "%s",
                     lmod_temp_name(w->l, kn, w->tmp_delta));
            int ext = (e->op & 2) != 0;
            const char *cs = e->extra ? e->extra : "";
            fprintf(g_lir_out, "({ struct %s %s = (", e->text ? e->text : "", m);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, "); %s __ct_mres%d = (%s){0}; ",
                    e->member ? e->member : "int", k,
                    e->member ? e->member : "int");
            if (ext)
                fprintf(g_lir_out,
                        "int __ct_matched%d __attribute__((unused)) = 0; ", k);
            for (j = 0; j < narm; j++) {
                int variant = e->kids[1 + 2 * j];
                int blk = e->kids[2 + 2 * j];
                const char *line_end;
                line_end = strchr(cs, '\n');
                if (ext) {
                    if (narm == 1) {
                        fputs("{\n", g_lir_out);
                        if (lw_pw_block(w, blk, 1) != 0) return -1;
                        cs = line_end ? line_end + 1 : cs + strlen(cs);
                        continue;
                    }
                    fputs("if (", g_lir_out);
                    fprintf(g_lir_out, "!__ct_matched%d && (", k);
                    if (variant < 0) fputs("1", g_lir_out);
                    else fprintf(g_lir_out, "%s%stag == %d", m,
                                 (e->op & 1) ? "->" : ".", variant);
                    {
                        char seg[4096];
                        const char *line = cs;
                        int sn = 0;
                        while (line < (line_end ? line_end : cs + strlen(cs))
                               && sn < (int)sizeof(seg) - 1)
                            seg[sn++] = *line++;
                        seg[sn] = 0;
                        if (lw_pw_conds(m, seg) != 0) return -1;
                    }
                    fputs(")) ", g_lir_out);
                    if (lw_pw_block(w, blk, 0) != 0) return -1;
                    cs = line_end ? line_end + 1 : cs + strlen(cs);
                    continue;
                }
                if (j == narm - 1) {
                    if (narm > 1) fputs("else ", g_lir_out);
                } else {
                    char seg[4096];
                    const char *line = cs;
                    int sn;
                    fputs(j == 0 ? "if (" : "else if (", g_lir_out);
                    if (variant < 0) fputs("1", g_lir_out);
                    else fprintf(g_lir_out, "%s%stag == %d", m,
                                 (e->op & 1) ? "->" : ".", variant);
                    sn = 0;
                    while (line < (line_end ? line_end : cs + strlen(cs))
                           && sn < (int)sizeof(seg) - 1)
                        seg[sn++] = *line++;
                    seg[sn] = 0;
                    if (lw_pw_conds(m, seg) != 0) return -1;
                    fputs(") ", g_lir_out);
                }
                if (lw_pw_block(w, blk, 0) != 0) return -1;
                cs = line_end ? line_end + 1 : cs + strlen(cs);
            }
            fprintf(g_lir_out, "__ct_mres%d; })", k);
            return 0;
        }
        case LE_TRY: {
            char qbuf[64];
            const char *q = qbuf;
            snprintf(qbuf, sizeof(qbuf), "%s",
                     lmod_temp_name(w->l, (int)e->num, w->tmp_delta));
            int qn = lmod_temp_num(w->l, (int)e->num, w->tmp_delta);
            char vty[512], ety[512];
            const char *sep;
            int k;
            snprintf(vty, sizeof(vty), "%s", e->extra ? e->extra : "");
            sep = strchr(vty, '\n');
            if (sep) {
                k = (int)(sep - vty);
                snprintf(ety, sizeof(ety), "%s", sep + 1);
                vty[k] = 0;
            } else {
                ety[0] = 0;
            }
            fprintf(g_lir_out, "({ %s %s = ", e->text ? e->text : "", q);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, ";\nif (!%s.ok) {\n", q);
            lw_ind(1);
            fprintf(g_lir_out, "%s __ct_e%d = %s.err;\n", ety, qn, q);
            lw_ind(1);
            fprintf(g_lir_out, "%s = (%s){0};\n", q,
                    e->text ? e->text : "");
            lw_ind(1);
            fprintf(g_lir_out, "return %s_err(__ct_e%d);\n",
                    e->member ? e->member : "", qn);
            fputs("}\n", g_lir_out);
            lw_ind(1);
            fprintf(g_lir_out, "%s __ct_v%d = %s.value;\n", vty, qn, q);
            lw_ind(1);
            fprintf(g_lir_out, "%s = (%s){0};\n", q,
                    e->text ? e->text : "");
            lw_ind(1);
            fprintf(g_lir_out, "__ct_v%d;\n})", qn);
            return 0;
        }
        case LE_OPT: {
            int temp = (int)e->num;
            char obuf[64];
            snprintf(obuf, sizeof(obuf), "%s",
                     temp > 0 ? lmod_temp_name(w->l, temp, w->tmp_delta) : "");
            fputs("(", g_lir_out);
            if (temp > 0) {
                fprintf(g_lir_out, "(%s = ", obuf);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(")", g_lir_out);
            } else if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) {
                return -1;
            }
            fputs(" ? ", g_lir_out);
            if (e->op == 1) {
                if (temp > 0) fputs(obuf, g_lir_out);
                else if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out, "->%s", e->text ? e->text : "");
            } else if (e->op == 2) {
                if (temp > 0) fputs(obuf, g_lir_out);
                else if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs("[", g_lir_out);
                if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
                fputs("]", g_lir_out);
            } else {
                fprintf(g_lir_out, "%s_get(", e->text ? e->text : "");
                if (temp > 0) fputs(obuf, g_lir_out);
                else if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
                fputs(")", g_lir_out);
            }
            fputs(" : 0)", g_lir_out);
            return 0;
        }
        case LE_FIELD:
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, ".%s", e->text ? e->text : "");
            return 0;
        case LE_ARROW:
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, "->%s", e->text ? e->text : "");
            return 0;
        case LE_INDEX:
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs("[", g_lir_out);
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs("]", g_lir_out);
            return 0;
        case LE_DEREF:
            fputs("(*", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_ADDR:
            fputs("(&", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_CAST:
            fprintf(g_lir_out, "(%s)(", e->text ? e->text : "");
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_UNARY:
            fputs(e->op == LU_NEG ? "(-" : (e->op == LU_BNOT ? "(~" : "(!"),
                  g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_POST:
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(e->op == LP_INC ? "++" : "--", g_lir_out);
            return 0;
        case LE_PRE:
            fputs(e->op == LP_INC ? "++" : "--", g_lir_out);
            return lw_pw_kid(w, e, 0, PW_EXPR);
        case LE_BINARY:
            if (e->op == LB_COMMA) {
                /* The AST comma writer uses the surrounding context for its
                   operands: a normal expression parenthesises an assignment
                   (`((a = 9), (a + 1))`), a for-init/step context keeps it
                   inline (`(m = x, i = 0)`). Mirror that so bytes agree. */
                int kctx = ctx == PW_INLINE ? PW_INLINE : PW_EXPR;
                fputs("(", g_lir_out);
                if (lw_pw_kid(w, e, 0, kctx) != 0) return -1;
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, 1, kctx) != 0) return -1;
                fputs(")", g_lir_out);
                return 0;
            }
            if (ctx == PW_COND && e->op >= LB_LT && e->op <= LB_NE) {
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out, " %s ", lw_bin_op(e->op));
                return lw_pw_kid(w, e, 1, PW_EXPR);
            }
            fputs("(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, " %s ", lw_bin_op(e->op));
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_ASSIGN:
            if (ctx != PW_INLINE) fputs("(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(lw_assign_op(e->op), g_lir_out);
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            if (ctx != PW_INLINE) fputs(")", g_lir_out);
            return 0;
        case LE_TERN:
            fputs("(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(" ? ", g_lir_out);
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs(" : ", g_lir_out);
            if (lw_pw_kid(w, e, 2, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_MCALL: {
            int j;
            fputs(e->text ? e->text : "", g_lir_out);
            fputs("(", g_lir_out);
            if (e->op == 11) {
                for (j = 0; j < e->nkids; j++) {
                    if (j > 0) fputs(", ", g_lir_out);
                    if (lw_pw_kid(w, e, j, PW_EXPR) != 0) return -1;
                }
            } else {
                if (e->op == 9) {
                    int no_amp = 0;
                    if (e->nkids > 0) {
                        struct ct_lexpr *r = &w->l->exprs[e->kids[0] - 1];
                        if (r->kind == LE_NAME && r->text
                            && strcmp(r->text, "_self") == 0)
                            no_amp = 1;
                    }
                    if (!no_amp) fputs("&", g_lir_out);
                }
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                for (j = 1; j < e->nkids; j++) {
                    fputs(", ", g_lir_out);
                    if (lw_pw_kid(w, e, j, PW_EXPR) != 0) return -1;
                }
            }
            fputs(")", g_lir_out);
            return 0;
        }
        case LE_RANGEK:
            fprintf(g_lir_out, "((int)%d)", g_lir_range_k);
            return 0;
        case LE_INIT_RANGE: {
            int k, start = (int)e->num, cnt = e->op;
            int has_name = e->member && e->member[0];
            if (cnt <= 0) { return -1; }
            if (has_name)
                fprintf(g_lir_out, " = %s_from((%s[%d]){ ", e->member,
                        e->text ? e->text : "", cnt);
            else
                fputs(" = { ", g_lir_out);
            for (k = start; k < start + cnt; k++) {
                if (k != start) fputs(", ", g_lir_out);
                g_lir_range_k = k;
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            }
            if (has_name) fprintf(g_lir_out, " }, %d)", cnt);
            else fputs(" }", g_lir_out);
            return 0;
        }
        case LE_INIT_BRACE: {
            int cnt = e->op, j;
            if (cnt <= 0) {
                fprintf(g_lir_out, " = %s_from(0, 0)", e->member ? e->member : "");
                return 0;
            }
            fprintf(g_lir_out, " = %s_from((%s[%d]){ ",
                    e->member ? e->member : "", e->text ? e->text : "", cnt);
            for (j = 0; j < e->nkids; j++) {
                if (j > 0) fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, j, PW_EXPR) != 0) return -1;
            }
            fprintf(g_lir_out, " }, %d)", cnt);
            return 0;
        }
        case LE_INIT_MBRACE: {
            int cnt = e->op, j;
            if (cnt <= 0) {
                fprintf(g_lir_out, " = %s_from(0, 0)", e->member ? e->member : "");
                return 0;
            }
            fprintf(g_lir_out, " = %s_from((%s[%d]){ ",
                    e->member ? e->member : "", e->text ? e->text : "", cnt);
            for (j = 0; j + 1 < e->nkids; j += 2) {
                if (j > 0) fputs(", ", g_lir_out);
                fputs("{", g_lir_out);
                if (lw_pw_kid(w, e, j, PW_EXPR) != 0) return -1;
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, j + 1, PW_EXPR) != 0) return -1;
                fputs("}", g_lir_out);
            }
            fprintf(g_lir_out, " }, %d)", cnt);
            return 0;
        }
        case LE_BOX: {
            if (e->op & 2) fputs("&", g_lir_out);
            if (e->op & 4) {
                fprintf(g_lir_out, "(struct %s_iface){ (void *)0, &%s_vtable }",
                        e->text ? e->text : "", e->member ? e->member : "");
                return 0;
            }
            fprintf(g_lir_out, "(struct %s_iface){ (void *)",
                    e->text ? e->text : "");
            {
                /* SH-96: `self` is already the receiver pointer, so the
                   interface stores `_self`, not `&_self`. */
                int no_amp = e->op & 1;
                if (!no_amp && e->nkids > 0) {
                    struct ct_lexpr *r = &w->l->exprs[e->kids[0] - 1];
                    if (r->kind == LE_NAME && r->text
                        && strcmp(r->text, "_self") == 0)
                        no_amp = 1;
                }
                if (!no_amp) fputs("&", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            }
            fprintf(g_lir_out, ", &%s_%s_vtable }",
                    e->member ? e->member : "", e->text ? e->text : "");
            return 0;
        }
        case LE_NEWOBJ: {
            int kn = e->op + w->tmp_delta;
            fprintf(g_lir_out, "({ struct %s __ct_new%d = %s__new(&(%s)",
                    e->text ? e->text : "", kn, e->text ? e->text : "",
                    e->member ? e->member : "");
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, "); __ct_new%d; })", kn);
            return 0;
        }
        case LE_VMCALL: {
            char low[256];
            lw_low_text(e->member, low, (int)sizeof(low));
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            if (e->op == 0 || e->op == 1) {
                fprintf(g_lir_out, ".__%s_vptr->%s(&", low,
                        e->text ? e->text : "");
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            } else if (e->op == 2) {
                fprintf(g_lir_out, "->__%s_vptr->%s(", low,
                        e->text ? e->text : "");
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            } else if (e->op == 3) {
                fprintf(g_lir_out, ".vt->%s(", e->text ? e->text : "");
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(".self", g_lir_out);
            } else if (e->op == 4) {
                fprintf(g_lir_out, "->vt->%s(", e->text ? e->text : "");
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs("->self", g_lir_out);
            } else {
                return -1;
            }
            for (i = 1; i < e->nkids; i++) {
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, i, PW_EXPR) != 0) return -1;
            }
            fputs(")", g_lir_out);
            return 0;
        }
        case LE_FNCALL:
            fprintf(g_lir_out, "(*%s)(", e->text ? e->text : "");
            for (i = 0; i < e->nkids; i++) {
                if (i > 0) fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, i, PW_EXPR) != 0) return -1;
            }
            fputs(")", g_lir_out);
            return 0;
        case LE_CALLEXPR:
            if (e->nkids < 1) return -1;
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs("(", g_lir_out);
            for (i = 1; i < e->nkids; i++) {
                if (i > 1) fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, i, PW_EXPR) != 0) return -1;
            }
            fputs(")", g_lir_out);
            return 0;
        case LE_RAW:
            fputs(e->text ? e->text : "", g_lir_out);
            return 0;
        case LE_SIZEOF: {
            static const char *const kw[5] = {"sizeof", "sizeof", "_Alignof",
                                              "alignof", "alignof"};
            if (e->nkids == 0) {
                fprintf(g_lir_out, "%s(%s)", kw[e->op < 0 || e->op > 4 ? 1 : e->op],
                        e->text ? e->text : "");
            } else {
                fputs(e->op == 3 ? "alignof(" : "sizeof(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fputs(")", g_lir_out);
            }
            return 0;
        }
        case LE_REF:
            fputs("&", g_lir_out);
            return lw_pw_kid(w, e, 0, PW_EXPR);
        case LE_OFFSETOF:
            fprintf(g_lir_out, "offsetof(%s, %s)", e->text ? e->text : "",
                    e->member ? e->member : "");
            return 0;
        case LE_CALL:
        case LE_INTRINSIC:
            fprintf(g_lir_out, "%s(", e->text ? e->text : "");
            for (i = 0; i < e->nkids; i++) {
                if (i > 0) fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, i, PW_EXPR) != 0) return -1;
            }
            fputs(")", g_lir_out);
            return 0;
        default:
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: cannot print LE kind=%d\n", e->kind);
            return -1;
    }
}

static int lw_pw_block(struct Lower *w, int blk, int ind);
static int lw_pw_stmt(struct Lower *w, int sid, int ind);

static int lw_pw_cleanups(struct Lower *w, int *ids, int n, int ind)
{
    int i;
    for (i = 0; i < n; i++)
        if (lw_pw_stmt(w, ids[i], ind) != 0) return -1;
    return 0;
}

static int lw_pw_decl(struct Lower *w, struct ct_lstmt *s, int ind, int inline_form)
{
    if (!inline_form) lw_ind(ind);
    if (!inline_form && s->aux == 1) fputs("static ", g_lir_out);
    {
        const char *sp = (s->spelling && s->spelling[0])
                             ? s->spelling : lmod_cspell(w->l, s->type);
        const char *star = sp ? strstr(sp, "(*)") : 0;
        if (star) {
            /* `int (*)(…)` takes the name inside the parentheses, the same
               position the emitter's declarator writer uses. */
            /* D-029/S3: a function-pointer array keeps its dimensions inside
               the declarator (`int (*tbl[2])(int)`), exactly like the AST
               emitter; dropping them printed a scalar for an array. */
            fprintf(g_lir_out, "%.*s(*%s%s)%s", (int)(star - sp), sp,
                    s->name ? s->name : "", s->dims ? s->dims : "", star + 3);
        } else {
            fprintf(g_lir_out, "%s %s%s", sp, s->name ? s->name : "",
                    s->dims ? s->dims : "");
        }
    }
    if (!inline_form && s->err_edge) fputs(" __attribute__((unused))", g_lir_out);
    if (s->attr && s->attr[0]) fprintf(g_lir_out, " %s", s->attr);
    if (s->zero_init && s->expr <= 0) fputs(" = { 0 }", g_lir_out);
    if (s->expr > 0) {
        struct ct_lexpr *ie = &w->l->exprs[s->expr - 1];
        int self_assign = ie->kind == LE_INIT_RANGE
                       || ie->kind == LE_INIT_BRACE
                       || ie->kind == LE_INIT_MBRACE;
        if (!self_assign) fputs(" = ", g_lir_out);
        if (s->retain_rhs)
            fprintf(g_lir_out, "%s_retain(&(",
                    s->retain_pfx ? s->retain_pfx : "String");
        if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
        if (s->retain_rhs) fputs("))", g_lir_out);
    }
    if (!inline_form) fputs(";\n", g_lir_out);
    return 0;
}

static int lw_pw_stmt(struct Lower *w, int sid, int ind)
{
    struct ct_lstmt *s;

    if (sid <= 0 || sid > w->l->nstmts) return -1;
    s = &w->l->stmts[sid - 1];
    switch (s->kind) {
        case LS_EMPTY:
            return 0;
        case LS_DECL:
            if (lw_pw_decl(w, s, ind, 0) != 0) return -1;
            if (s->vptr && s->vptr_loop) {
                const char *p = s->vptr;
                lw_ind(ind);
                fprintf(g_lir_out,
                        "for (unsigned long __ct_i = 0; __ct_i < %s; __ct_i++) {\n",
                        s->count ? s->count : "");
                lw_ind(ind + 1);
                while (*p) {
                    if (*p == '\n') {
                        fputs("\n", g_lir_out);
                        lw_ind(ind + 1);
                    } else {
                        fputc(*p, g_lir_out);
                    }
                    p++;
                }
                fputs("\n", g_lir_out);
                lw_ind(ind);
                fputs("}\n", g_lir_out);
            } else if (s->vptr) {
                const char *p = s->vptr;
                lw_ind(ind);
                while (*p) {
                    if (*p == '\n') {
                        fputs("\n", g_lir_out);
                        lw_ind(ind);
                    } else {
                        fputc(*p, g_lir_out);
                    }
                    p++;
                }
                fputs("\n", g_lir_out);
            }
            return 0;
        case LS_DECLS: {
            int i;
            for (i = 0; i < s->nkids; i++) {
                struct ct_lstmt *sub;
                if (s->kids[i] <= 0 || s->kids[i] > w->l->nstmts) return -1;
                sub = &w->l->stmts[s->kids[i] - 1];
                if (sub->kind != LS_DECL) return -1;
                if (lw_pw_decl(w, sub, ind, 0) != 0) return -1;
            }
            return 0;
        }
        case LS_ASSIGN:
            if (s->sold_temp > 0 || s->retain_rhs) {
                /* D-013 §3 rebind: hold the old value, retain/move the new
                   one, then release the old -- one statement expression. */
                char soldbuf[64];
                const char *sold = soldbuf;
                soldbuf[0] = 0;
                if (s->sold_temp > 0)
                    snprintf(soldbuf, sizeof(soldbuf), "%s",
                             lmod_temp_name(w->l, s->sold_temp, w->tmp_delta));
                lw_ind(ind);
                fputs("{ ", g_lir_out);
                if (s->sold_temp > 0)
                    fprintf(g_lir_out, "%s %s = ",
                            s->value_type ? s->value_type : "void", sold);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs("; ", g_lir_out);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(lw_assign_op(s->aux), g_lir_out);
                if (s->retain_rhs)
                    fprintf(g_lir_out, "%s_retain(&(",
                            s->retain_pfx ? s->retain_pfx : "String");
                if (lw_pw_expr(w, s->rhs, PW_EXPR) != 0) return -1;
                if (s->retain_rhs) fputs("))", g_lir_out);
                fputs("; ", g_lir_out);
                if (s->sold_temp > 0)
                    fprintf(g_lir_out, "%s_release(&%s); ",
                            s->retain_pfx ? s->retain_pfx : "String", sold);
                fputs("}\n", g_lir_out);
                return 0;
            }
            lw_ind(ind);
            if (s->brace) fputs("{ ", g_lir_out);
            if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
            fputs(lw_assign_op(s->aux), g_lir_out);
            if (lw_pw_expr(w, s->rhs, PW_EXPR) != 0) return -1;
            if (s->brace) fputs("; }\n", g_lir_out);
            else fputs(";\n", g_lir_out);
            return 0;
        case LS_EXPR:
            lw_ind(ind);
            if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
            fputs(";\n", g_lir_out);
            return 0;
        case LS_CLOSURE_DECL:
            lw_ind(ind);
            fprintf(g_lir_out,
                    "struct __ct_cl_env_%d __attribute__((unused)) "
                    "__ct_cl_env_v_%d = { %s };\n", s->origin, s->origin,
                    s->name ? s->name : "0");
            return 0;
        case LS_SWITCH:
            lw_ind(ind);
            fputs("switch (", g_lir_out);
            if (lw_pw_expr(w, s->cond, PW_COND) != 0) return -1;
            fputs(") ", g_lir_out);
            return lw_pw_block(w, s->body_blk, ind);
        case LS_CASE:
            lw_ind(ind);
            if (s->aux) {
                fputs("default:", g_lir_out);
            } else {
                fputs("case ", g_lir_out);
                if (s->expr > 0 && lw_pw_expr(w, s->expr, PW_EXPR) != 0)
                    return -1;
                if (s->rhs > 0) {
                    fputs(" ... ", g_lir_out);
                    if (lw_pw_expr(w, s->rhs, PW_EXPR) != 0) return -1;
                }
                fputs(":", g_lir_out);
            }
            fputs("\n", g_lir_out);
            if (s->body_blk > 0)
                return lw_pw_stmts_only(w, s->body_blk, ind + 1);
            return 0;
        case LS_DO:
            lw_ind(ind);
            fputs("do {\n", g_lir_out);
            if (lw_pw_stmts_only(w, s->body_blk, ind + 1) != 0) return -1;
            lw_ind(ind);
            fputs("} while (", g_lir_out);
            if (lw_pw_expr(w, s->cond, PW_COND) != 0) return -1;
            fputs(");\n", g_lir_out);
            return 0;
        case LS_MATCH: {
            char mbuf[64];
            const char *m = mbuf;
            int kn = lmod_temp_num(w->l, s->origin, w->tmp_delta);
            snprintf(mbuf, sizeof(mbuf), "%s",
                     lmod_temp_name(w->l, s->origin, w->tmp_delta));
            int narm = s->nkids / 2, j;
            int nonadt = s->aux & 4;
            int ptr = s->aux & 1;
            int ext = s->aux & 8;
            const char *cs = s->spelling ? s->spelling : "";
            lw_ind(ind);
            if (nonadt)
                fprintf(g_lir_out, "%s%s%s __attribute__((unused)) = (",
                        s->name ? s->name : "", ptr ? " *" : " ", m);
            else
                fprintf(g_lir_out, "struct %s%s%s __attribute__((unused)) = (",
                        s->name ? s->name : "", ptr ? " *" : " ", m);
            if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
            fputs(");\n", g_lir_out);
            if (ext) {
                lw_ind(ind);
                fprintf(g_lir_out,
                        "int __ct_matched%d __attribute__((unused)) = 0;\n",
                        kn);
            }
            for (j = 0; j < narm; j++) {
                int variant = s->kids[2 * j];
                int blk = s->kids[2 * j + 1];
                const char *line;
                const char *line_end;
                line = cs;
                line_end = strchr(cs, '\n');
                if (ext) {
                    if (narm == 1) {
                        lw_ind(ind);
                        fputs("{\n", g_lir_out);
                        if (lw_pw_block(w, blk, ind + 1) != 0) return -1;
                        lw_ind(ind);
                        fputs("}\n", g_lir_out);
                        cs = line_end ? line_end + 1 : cs + strlen(cs);
                        continue;
                    }
                    lw_ind(ind);
                    fprintf(g_lir_out, "if (!__ct_matched%d && (", kn);
                    if (nonadt || variant < 0) fputs("1", g_lir_out);
                    else fprintf(g_lir_out, "%s%stag == %d", m,
                                 ptr ? "->" : ".", variant);
                    {
                        char seg[4096];
                        int sn = 0;
                        while (line < (line_end ? line_end : cs + strlen(cs))
                               && sn < (int)sizeof(seg) - 1)
                            seg[sn++] = *line++;
                        seg[sn] = 0;
                        if (lw_pw_conds(m, seg) != 0) return -1;
                    }
                    fputs(")) ", g_lir_out);
                    if (lw_pw_block(w, blk, ind) != 0) return -1;
                    cs = line_end ? line_end + 1 : cs + strlen(cs);
                    continue;
                }
                lw_ind(ind);
                if (j == narm - 1) {
                    if (narm > 1) fputs("else ", g_lir_out);
                } else {
                    fputs(j == 0 ? "if (" : "else if (", g_lir_out);
                    if (nonadt || variant < 0) fputs("1", g_lir_out);
                    else fprintf(g_lir_out, "%s%stag == %d", m,
                                 ptr ? "->" : ".", variant);
                    {
                        char seg[4096];
                        int sn;
                        sn = 0;
                        while (line < (line_end ? line_end : cs + strlen(cs))
                               && sn < (int)sizeof(seg) - 1)
                            seg[sn++] = *line++;
                        seg[sn] = 0;
                        if (lw_pw_conds(m, seg) != 0) return -1;
                    }
                    fputs(") ", g_lir_out);
                }
                if (lw_pw_block(w, blk, ind) != 0) return -1;
                cs = line_end ? line_end + 1 : cs + strlen(cs);
            }
            return 0;
        }
        case LS_MATCHBIND: {
            const char *m = lmod_temp_name(w->l, s->target, w->tmp_delta);
            const char *path = s->member ? s->member : "";
            lw_ind(ind);
            fprintf(g_lir_out, "%s %s __attribute__((unused)) = ",
                    s->spelling ? s->spelling : "int",
                    s->name ? s->name : "");
            if (s->aux >= 1)
                fprintf(g_lir_out, "%s_retain(&(",
                        s->fname && s->fname[0] ? s->fname
                            : (s->aux == 2 ? "U16String" : "String"));
            if (path[0] == '?') {
                if (lw_pw_or_bind(m, path + 1, s->text) != 0) return -1;
            } else if (strcmp(path, "*") == 0) {
                fprintf(g_lir_out, "(*%s)", m);
            } else {
                fprintf(g_lir_out, "%s%s", m, path);
            }
            if (s->aux >= 1) fputs("))", g_lir_out);
            fputs(";\n", g_lir_out);
            return 0;
        }
        case LS_MATCHWRAP: {
            int kn = lmod_temp_num(w->l, s->target, w->tmp_delta);
            int level = ind;
            if (s->expr > 0) {
                lw_ind(ind);
                fputs("if (", g_lir_out);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(") {\n", g_lir_out);
                level = ind + 1;
            }
            if (s->aux) {
                lw_ind(level);
                fprintf(g_lir_out, "__ct_matched%d = 1;\n", kn);
            }
            lw_ind(level);
            if (lw_pw_block(w, s->body_blk, level) != 0) return -1;
            if (s->expr > 0) {
                lw_ind(ind);
                fputs("}\n", g_lir_out);
            }
            return 0;
        }
        case LS_MATCHYIELD: {
            int k = lmod_temp_num(w->l, s->target, w->tmp_delta);
            lw_ind(ind);
            fprintf(g_lir_out, "__ct_mres%d = ", k);
            if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
            fputs(";\n", g_lir_out);
            return 0;
        }
        case LS_RETBLOCK:
            if (s->body_blk <= 0 || s->body_blk > w->l->nblocks) return -1;
            return lw_pw_return(w, &w->l->blocks[s->body_blk - 1], ind);
        case LS_RELEASE:
            lw_ind(ind);
            fprintf(g_lir_out, "%s_release(&", s->name ? s->name : "String");
            if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
            fputs(");\n", g_lir_out);
            return 0;
        case LS_RETAINPARAM:
            lw_ind(ind);
            fprintf(g_lir_out, "%s = %s_retain(&%s);\n",
                    s->name ? s->name : "",
                    s->retain_pfx ? s->retain_pfx : "String",
                    s->name ? s->name : "");
            return 0;
        case LS_TEMPDECL: {
            const char *nm = lmod_temp_name(w->l, s->origin, w->tmp_delta);
            lw_ind(ind);
            if (s->aux == 2) {
                fprintf(g_lir_out, "%s * %s = &(", lmod_cspell(w->l, s->type),
                        nm);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(");\n", g_lir_out);
            } else {
                fprintf(g_lir_out, "%s %s", lmod_cspell(w->l, s->type), nm);
                if (s->expr > 0) {
                    fputs(" = ", g_lir_out);
                    if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                }
                fputs(";\n", g_lir_out);
            }
            if (s->body_blk > 0) {
                if (lw_pw_stmts_only(w, s->body_blk, ind) != 0) return -1;
            }
            return 0;
        }
        case LS_DROP: {
            /* `if (x) { <T>_Drop_drop(x); free(x); x = 0; }` -- a user delete
               and an AutoDrop cleanup share this shape; the struct row decides
               whether a Drop body runs first. */
            struct ct_tstruct *row = lw_struct_row(w, s->name);
            lw_ind(ind);
            fputs("if (", g_lir_out);
            if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
            fputs(") { ", g_lir_out);
            if (s->aux == 1) {
                fprintf(g_lir_out, "%s_Handback_handback(",
                        s->name ? s->name : "");
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs("); ", g_lir_out);
            } else {
                if (row && row->uses_drop) {
                    fprintf(g_lir_out, "%s_Drop_drop(",
                            s->name ? s->name : "");
                    if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                    fputs("); ", g_lir_out);
                }
                fprintf(g_lir_out, "%s(",
                        w->l->free_sym ? w->l->free_sym : "free");
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs("); ", g_lir_out);
            }
            if (s->assignable) {
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(" = 0; ", g_lir_out);
            }
            fputs("}\n", g_lir_out);
            return 0;
        }
        case LS_DEFER_RUN:
        case LS_ERRDEFER_RUN:
            return lw_pw_block(w, s->body_blk, ind);
        case LS_BLOCK:
            return lw_pw_block(w, s->body_blk, ind);
        case LS_IF:
            lw_ind(ind);
            fputs("if (", g_lir_out);
            if (lw_pw_expr(w, s->cond, PW_COND) != 0) return -1;
            fputs(") ", g_lir_out);
            if (s->then_blk > 0 && lw_pw_block(w, s->then_blk, ind) != 0) return -1;
            if (s->else_blk > 0) {
                lw_ind(ind);
                fputs("else ", g_lir_out);
                if (lw_pw_block(w, s->else_blk, ind) != 0) return -1;
            }
            return 0;
        case LS_WHILE:
            lw_ind(ind);
            fputs("while (", g_lir_out);
            if (lw_pw_expr(w, s->cond, PW_COND) != 0) return -1;
            fputs(") ", g_lir_out);
            return lw_pw_block(w, s->body_blk, ind);
        case LS_FOR:
            if (s->aux == 1) {
                /* `for (static int i = …; …)`: C99 forbids the storage class
                   in a for-init, so the declaration is printed in its own
                   block and the loop header starts empty -- the AST writer's
                   shape. */
                struct ct_lstmt *is;
                if (s->init_stmt <= 0 || s->init_stmt > w->l->nstmts)
                    return -1;
                is = &w->l->stmts[s->init_stmt - 1];
                if (is->kind != LS_DECL) return -1;
                lw_ind(ind);
                fputs("{\n", g_lir_out);
                if (lw_pw_decl(w, is, ind + 1, 0) != 0) return -1;
                lw_ind(ind + 1);
                fputs("for (; ", g_lir_out);
                if (s->cond > 0 && lw_pw_expr(w, s->cond, PW_COND) != 0)
                    return -1;
                fputs("; ", g_lir_out);
                if (s->step > 0 && lw_pw_expr(w, s->step, PW_INLINE) != 0)
                    return -1;
                fputs(") ", g_lir_out);
                if (lw_pw_block(w, s->body_blk, ind + 1) != 0) return -1;
                lw_ind(ind);
                fputs("}\n", g_lir_out);
                return 0;
            }
            lw_ind(ind);
            fputs("for (", g_lir_out);
            if (s->init_stmt > 0) {
                struct ct_lstmt *is = &w->l->stmts[s->init_stmt - 1];
                if (is->kind == LS_DECL) {
                    if (lw_pw_decl(w, is, ind, 1) != 0) return -1;
                } else if (is->kind == LS_ASSIGN) {
                    if (lw_pw_expr(w, is->expr, PW_INLINE) != 0) return -1;
                    fputs(lw_assign_op(is->aux), g_lir_out);
                    if (lw_pw_expr(w, is->rhs, PW_INLINE) != 0) return -1;
                } else {
                    if (lw_pw_expr(w, is->expr, PW_INLINE) != 0) return -1;
                }
            }
            fputs("; ", g_lir_out);
            if (s->cond > 0 && lw_pw_expr(w, s->cond, PW_COND) != 0) return -1;
            fputs("; ", g_lir_out);
            if (s->step > 0 && lw_pw_expr(w, s->step, PW_INLINE) != 0) return -1;
            fputs(") ", g_lir_out);
            return lw_pw_block(w, s->body_blk, ind);
        case LS_FOREACH: {
            int k = s->loop_k + w->tmp_delta;
            const char *it = s->item_type ? s->item_type : "int";
            const char *fn = s->fname ? s->fname : "";
            int k2;
            lw_ind(ind);
            fputs("{\n", g_lir_out);
            if (s->aux == 3) {
                lw_ind(ind + 1);
                fprintf(g_lir_out,
                        "struct __ct_slice *__ct_foreach_c_%d = &(", k);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(");\n", g_lir_out);
                lw_ind(ind + 1);
                fprintf(g_lir_out,
                        "int __ct_foreach_n_%d = __ct_foreach_c_%d->len;\n", k, k);
            } else if (s->aux == 1 || s->aux == 2) {
                lw_ind(ind + 1);
                fprintf(g_lir_out,
                        "struct %s *__ct_foreach_c_%d = &(", fn, k);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(");\n", g_lir_out);
                lw_ind(ind + 1);
                fprintf(g_lir_out,
                        "int __ct_foreach_n_%d = %s_len(__ct_foreach_c_%d);\n",
                        k, fn, k);
            } else {
                lw_ind(ind + 1);
                fprintf(g_lir_out,
                        "int __ct_foreach_n_%d = (int)(sizeof(", k);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(") / sizeof((", g_lir_out);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fputs(")[0]));\n", g_lir_out);
            }
            lw_ind(ind + 1);
            fprintf(g_lir_out,
                    "for (int __ct_foreach_i_%d = 0; __ct_foreach_i_%d < __ct_foreach_n_%d; __ct_foreach_i_%d++) {\n",
                    k, k, k, k);
            if (s->aux != 2) {
                lw_ind(ind + 2);
                fprintf(g_lir_out, "int i = __ct_foreach_i_%d;\n", k);
            }
            lw_ind(ind + 2);
            if (s->aux == 1)
                fprintf(g_lir_out, "%s item = %s_get(__ct_foreach_c_%d, __ct_foreach_i_%d);\n",
                        it, fn, k, k);
            else if (s->aux == 2)
                fprintf(g_lir_out, "%s item = %s_entry(__ct_foreach_c_%d, __ct_foreach_i_%d);\n",
                        it, fn, k, k);
            else if (s->aux == 3)
                fprintf(g_lir_out,
                        "%s item = (*(%s *)__ct_slice_at(__ct_foreach_c_%d, __ct_foreach_i_%d, sizeof(%s)));\n",
                        it, it, k, k, it);
            else {
                fprintf(g_lir_out, "%s item = (", it);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out, ")[__ct_foreach_i_%d];\n", k);
            }
            lw_ind(ind + 2);
            fputs("(void)item;\n", g_lir_out);
            if (s->aux != 2) {
                lw_ind(ind + 2);
                fputs("(void)i;\n", g_lir_out);
            }
            if (s->body_blk > 0 && s->body_blk <= w->l->nblocks) {
                struct ct_lblock *b = &w->l->blocks[s->body_blk - 1];
                for (k2 = 0; k2 < b->nstmts; k2++)
                    if (lw_pw_stmt(w, b->stmts[k2], ind + 2) != 0) return -1;
                if (lw_pw_cleanups(w, b->tail_cleanups, b->ntail, ind + 2) != 0)
                    return -1;
            }
            lw_ind(ind + 1);
            fputs("}\n", g_lir_out);
            lw_ind(ind);
            fputs("}\n", g_lir_out);
            return 0;
        }
        case LS_LOOP: {
            int k = s->loop_k + w->tmp_delta;
            lw_ind(ind);
            if (!s->aux) {
                fprintf(g_lir_out, "for (int i = 0, __ct_loop_n_%d = (", k);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out, "); i < __ct_loop_n_%d; i++) ", k);
            } else {
                fprintf(g_lir_out,
                        "for (int __ct_loop_n_%d, __ct_loop_hi_%d, i = ((__ct_loop_n_%d = (",
                        k, k, k);
                if (lw_pw_expr(w, s->expr, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out, ")), (__ct_loop_hi_%d = (", k);
                if (lw_pw_expr(w, s->rhs, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out,
                        ")), __ct_loop_n_%d); i < __ct_loop_hi_%d; i++) ", k, k);
            }
            return lw_pw_block(w, s->body_blk, ind);
        }
        case LS_JUMP:
            if (lw_pw_cleanups(w, s->cleanups, s->ncleanups, ind) != 0) return -1;
            lw_ind(ind);
            fputs(s->aux == LJ_BREAK ? "break;\n" : "continue;\n", g_lir_out);
            return 0;
        case LS_GOTO:
            lw_ind(ind);
            fprintf(g_lir_out, "goto %s;\n", s->name ? s->name : "");
            return 0;
        case LS_LABEL:
            lw_ind(ind);
            fprintf(g_lir_out, "%s:\n", s->name ? s->name : "");
            lw_ind(ind + 1);
            fputs(";\n", g_lir_out);
            if (s->body_blk > 0)
                return lw_pw_stmts_only(w, s->body_blk, ind + 1);
            return 0;
        default:
            if (getenv("CT_LIR_DEBUG"))
                fprintf(stderr, "lir: cannot print LS kind=%d\n", s->kind);
            return -1;
    }
}

static int lw_pw_return(struct Lower *w, struct ct_lblock *b, int ind)
{
    int wrap = b->ret_temp > 0;
    struct ct_ltemp *t = 0;
    const char *tname = "";

    if (wrap) {
        if (b->ret_temp <= 0 || b->ret_temp > w->l->ntemps) return -1;
        t = &w->l->temps[b->ret_temp - 1];
        tname = lmod_temp_name(w->l, b->ret_temp, w->tmp_delta);
        fputs("{\n", g_lir_out);
        ind++;
        lw_ind(ind);
        fprintf(g_lir_out, "%s %s = ", lmod_cspell(w->l, t->type), tname);
        if (lw_pw_expr(w, b->ret_expr, PW_EXPR) != 0) return -1;
        fputs(";\n", g_lir_out);
        if (b->ret_retain) {
            lw_ind(ind);
            fprintf(g_lir_out, "%s = %s_retain(&%s);\n", tname,
                    b->ret_pfx ? b->ret_pfx : "String", tname);
        }
    } else {
        /* a void return still runs its cleanups first */
        if (lw_pw_cleanups(w, b->term_cleanups, b->ntermc, ind) != 0) return -1;
    }
    if (wrap) {
        if (lw_pw_cleanups(w, b->term_cleanups, b->ntermc, ind) != 0) return -1;
        lw_ind(ind);
        fprintf(g_lir_out, "return %s;\n", tname);
        ind--;
        lw_ind(ind);
        fputs("}\n", g_lir_out);
        return 0;
    }
    lw_ind(ind);
    if (b->ret_expr <= 0) {
        fputs("return;\n", g_lir_out);
        return 0;
    }
    fputs("return ", g_lir_out);
    if (lw_pw_expr(w, b->ret_expr, PW_EXPR) != 0) return -1;
    fputs(";\n", g_lir_out);
    return 0;
}

static int lw_pw_block(struct Lower *w, int blk, int ind)
{
    struct ct_lblock *b;
    int i;

    if (blk <= 0 || blk > w->l->nblocks) return -1;
    b = &w->l->blocks[blk - 1];
    fputs("{\n", g_lir_out);
    for (i = 0; i < b->nstmts; i++)
        if (lw_pw_stmt(w, b->stmts[i], ind + 1) != 0) return -1;
    if (b->term == LT_RETURN) {
        if (lw_pw_return(w, b, ind + 1) != 0) return -1;
    } else if (b->term == LT_GOTO) {
        lw_ind(ind + 1);
        fputs("goto;\n", g_lir_out);
        return -1;
    }
    if (lw_pw_cleanups(w, b->tail_cleanups, b->ntail, ind + 1) != 0) return -1;
    lw_ind(ind);
    fputs("}\n", g_lir_out);
    return 0;
}

/* The body seam (contract §4.1, stage S2b): the emitter prints the banner,
   signatures, declarations and prototypes; this prints one body it lowered end
   to end. `ntmp` is the emitter's module-wide `__ct_*N` counter at body entry;
   an exact match proves the two walkers allocated the same numbers, and the
   returned `new_ntmp` lets the emitter resume where the unswitched program
   would have been. A mismatch falls back to the AST body: the seam must never
   print a body whose temporaries would renumber the rest of the file. */
/* The statements of a root block without its braces (an impl method body). */
static int lw_pw_stmts_only(struct Lower *w, int blk, int ind)
{
    struct ct_lblock *b;
    int i;

    if (blk <= 0 || blk > w->l->nblocks) return -1;
    b = &w->l->blocks[blk - 1];
    for (i = 0; i < b->nstmts; i++)
        if (lw_pw_stmt(w, b->stmts[i], ind) != 0) return -1;
    if (b->term == LT_RETURN) {
        if (lw_pw_return(w, b, ind) != 0) return -1;
    } else if (b->term == LT_GOTO) {
        return -1;
    }
    if (lw_pw_cleanups(w, b->tail_cleanups, b->ntail, ind) != 0) return -1;
    return 0;
}

pub int ct_lir_try_body(const char *name, void *out, int ind, int ntmp,
                        int *new_ntmp, int stmts)
{
    struct LModule *l = lmod_get();
    struct Lower *w = &g_lower;
    int i;

    if (!l->enabled || g_lower.mode == 2) return 0;
    /* the SH-111 negative probes inject an AST fault and expect the emitter's
       verifier to reject it; the seam must not print the body first */
    if (getenv("CT_EMIT_INVARIANT_FAULT")) return 0;
    if (!name || !name[0]) return 0;
    for (i = 0; i < l->nfuncs; i++) {
        struct ct_lfunc *f = &l->funcs[i];
        if (!f->ok) continue;
        if (!f->seam || strcmp(f->seam, name) != 0) continue;
        /* The two walkers number `__ct_*N` from one module-wide counter. A
           generated product between two bodies (an instance body, a vtable
           initialiser) moves the emitter's counter and not the lowering's,
           so a body is printed at the emitter's current number, not at the
           number lowering happened to record: the delta is constant for the
           whole body. A negative delta would mean the lowering spent more
           numbers than the emitter would have -- a real divergence, so that
           body stays on the AST path. */
        w->tmp_delta = ntmp;
        w->l = l;
        g_lir_out = (FILE *)out;
        if (stmts) {
            /* an impl method: the emitter already wrote the signature, the
               `_self` cast and the `(void)` prologue, so only the statement
               list is printed here -- no braces. */
            if (lw_pw_stmts_only(w, f->root, ind) != 0) return -1;
        } else if (lw_pw_block(w, f->root, ind) != 0) {
            return -1;
        }
        l->stat_printed++;
        if (getenv("CT_LIR_DEBUG"))
            fprintf(stderr, "lir: body '%s' printed ntmp=%d start=%d end=%d\n",
                    name, ntmp, f->temp_start, f->temp_end);
        if (new_ntmp) *new_ntmp = ntmp + f->temp_end;
        return 1;
    }
    if (getenv("CT_LIR_DEBUG"))
        fprintf(stderr, "lir: body '%s' not in this unit's lowered set\n", name);
    return 0;
}

static int lw_pw_params(struct Lower *w, struct ct_lfunc *f, int names)
{
    int i;

    if (f->nparams == 0) {
        fputs(names ? "void) " : "void)", g_lir_out);
        return 0;
    }
    for (i = 0; i < f->nparams; i++) {
        if (i > 0) fputs(", ", g_lir_out);
        if (names) {
            fprintf(g_lir_out, "%s %s", lmod_cspell(w->l, f->params[i].type),
                    f->params[i].name ? f->params[i].name : "");
        } else {
            fputs(lmod_cspell(w->l, f->params[i].type), g_lir_out);
        }
    }
    fputs(names ? ") " : ")", g_lir_out);
    return 0;
}

pub int ct_lir_emit(FILE *out)
{
    struct Lower *w = &g_lower;
    struct LModule *l = lmod_get();
    int i;

    if (!out) return 1;
    g_lir_out = out;
    w->l = l;
    l->emitting = 1;
    /* prototypes, in program order */
    for (i = 0; i < l->ndecls; i++) {
        struct ct_lfunc *f = &l->funcs[l->decls[i] - 1];
        if (f->is_static) fputs("static ", out);
        fprintf(out, "%s %s(", lmod_cspell(l, f->ret),
                f->name ? f->name : "");
        if (lw_pw_params(w, f, 0) != 0) return 1;
        fputs(";\n", out);
    }
    /* definitions, in program order */
    for (i = 0; i < l->ndecls; i++) {
        struct ct_lfunc *f = &l->funcs[l->decls[i] - 1];
        if (f->is_static) fputs("static ", out);
        fprintf(out, "%s %s(", lmod_cspell(l, f->ret),
                f->name ? f->name : "");
        if (lw_pw_params(w, f, 1) != 0) return 1;
        if (lw_pw_block(w, f->root, 0) != 0) return 1;
    }
    l->emitting = 0;
    return 0;
}

pub void ct_lir_free(void)
{
    if (g_lower.loops) free(g_lower.loops);
    g_lower.loops = 0;
    g_lower.nloops = 0;
    g_lower.loopcap = 0;
}
