            fprintf(g_lir_out, " }, %d)", cnt);
            return 0;
        }
        case LE_INIT_MBRACE: {
            int cnt = e->op, j;
            if (cnt <= 0) {
                fprintf(g_lir_out, " = %s_from(0, 0)", e->member ? e->member : "");
                return 0;
            }
            fprintf(g_lir_out, " = %s_from((%s[%d]){ ",
