            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_POST:
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(e->op == LP_INC ? "++" : "--", g_lir_out);
            return 0;
        case LE_PRE:
            fputs(e->op == LP_INC ? "++" : "--", g_lir_out);
            return lw_pw_kid(w, e, 0, PW_EXPR);
        case LE_BINARY:
            if (e->op == LB_COMMA) {
                fputs("(", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_INLINE) != 0) return -1;
                fputs(", ", g_lir_out);
                if (lw_pw_kid(w, e, 1, PW_INLINE) != 0) return -1;
                fputs(")", g_lir_out);
                return 0;
            }
            if (ctx == PW_COND && e->op >= LB_LT && e->op <= LB_NE) {
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
                fprintf(g_lir_out, " %s ", lw_bin_op(e->op));
                return lw_pw_kid(w, e, 1, PW_EXPR);
            }
            fputs("(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fprintf(g_lir_out, " %s ", lw_bin_op(e->op));
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_ASSIGN:
            if (ctx != PW_INLINE) fputs("(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(lw_assign_op(e->op), g_lir_out);
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            if (ctx != PW_INLINE) fputs(")", g_lir_out);
            return 0;
        case LE_TERN:
            fputs("(", g_lir_out);
            if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            fputs(" ? ", g_lir_out);
            if (lw_pw_kid(w, e, 1, PW_EXPR) != 0) return -1;
            fputs(" : ", g_lir_out);
            if (lw_pw_kid(w, e, 2, PW_EXPR) != 0) return -1;
            fputs(")", g_lir_out);
            return 0;
        case LE_MCALL: {
            int j;
            fputs(e->text ? e->text : "", g_lir_out);
