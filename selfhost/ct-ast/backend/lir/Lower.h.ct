            if (e->op == 11) {
                for (j = 0; j < e->nkids; j++) {
                    if (j > 0) fputs(", ", g_lir_out);
                    if (lw_pw_kid(w, e, j, PW_EXPR) != 0) return -1;
                }
            } else {
                if (e->op == 9) {
                    int no_amp = 0;
                    if (e->nkids > 0) {
                        struct ct_lexpr *r = &w->l->exprs[e->kids[0] - 1];
                        if (r->kind == LE_NAME && r->text
                            && strcmp(r->text, "_self") == 0)
