            if (e->op & 4) {
                fprintf(g_lir_out, "(struct %s_iface){ (void *)0, &%s_vtable }",
                        e->text ? e->text : "", e->member ? e->member : "");
                return 0;
            }
            fprintf(g_lir_out, "(struct %s_iface){ (void *)",
                    e->text ? e->text : "");
            if (e->op & 1) {
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            } else {
                fputs("&", g_lir_out);
                if (lw_pw_kid(w, e, 0, PW_EXPR) != 0) return -1;
            }
            fprintf(g_lir_out, ", &%s_%s_vtable }",
