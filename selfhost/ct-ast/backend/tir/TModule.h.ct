pub int tmod_new_stmt(struct TModule *self, int kind, int file, int line, int col,
                      int scope)
{
    int slot, id;

    if (tir_reserve((void **)&self->stmts, &self->scap, self->nstmts + 1,
                    (int)sizeof(struct ct_tstmt)) != 0) return -1;
    slot = self->nstmts;
    id = slot + 1;
    self->stmts[slot].id = id;
    self->stmts[slot].kind = kind;
    self->stmts[slot].span.file = file;
    self->stmts[slot].span.line = line;
    self->stmts[slot].span.col = col;
    self->stmts[slot].scope = scope;
    self->nstmts++;
