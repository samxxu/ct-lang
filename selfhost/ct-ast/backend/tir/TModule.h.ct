pub int tmod_stmt_add_kid(struct TModule *self, int stmt, int kid)
{
    struct ct_tstmt *s;

    if (stmt <= 0 || stmt > self->nstmts) return -1;
    s = &self->stmts[stmt - 1];
    if (tir_reserve((void **)&s->kids, &s->kcap, s->nkids + 1,
                    (int)sizeof(int)) != 0) return -1;
    s->kids[s->nkids] = kid;
    s->nkids++;
    return 0;
