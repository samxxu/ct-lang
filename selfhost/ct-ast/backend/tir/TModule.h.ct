}

pub int tmod_new_expr(struct TModule *self, int kind, int file, int line, int col)
{
    int slot, id;

    if (tir_reserve((void **)&self->exprs, &self->ecap, self->nexprs + 1,
                    (int)sizeof(struct ct_texpr)) != 0) return -1;
