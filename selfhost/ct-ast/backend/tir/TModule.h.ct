pub struct TModule *tmod_get(void)
{
    return &g_tir;
}

pub void tmod_mark(struct TModule *self, struct ct_tmark *out)
{
    if (!out) return;
    out->ndecls = self->ndecls;
    out->nexprs = self->nexprs;
    out->nstmts = self->nstmts;
    out->nscopes = self->nscopes;
    out->nvars = self->nvars;
    out->ncleanups = self->ncleanups;
    out->ntypes = self->ntypes;
    out->ninsts = self->ninsts;
    out->nmembers = self->nmembers;
    out->nroots = self->nroots;
    out->ngraph = self->graph.nnodes;
}

/* One source file id. Spans reference this table, so a verifier message can
   name the unit a TIR row came from without a `const char *` per row. */
pub int tmod_file(struct TModule *self, const char *path)
{
    int i;
    const char *pooled;

    if (!path) path = "";
    for (i = 0; i < self->nfiles; i++)
        if (strcmp(self->files[i], path) == 0) return i + 1;
    if (tir_reserve((void **)&self->files, &self->fcap, self->nfiles + 1,
                    (int)sizeof(*self->files)) != 0) return -1;
    pooled = runtime::text::ct_intern(path);
    if (!pooled) return -1;
    self->files[self->nfiles] = pooled;
    self->nfiles++;
    return self->nfiles;
}

/* Intern one type spelling. Same normalized key means same TypeId, so a type
   reference is an id comparison, never a strcmp at the verifier. */
pub int tmod_type(struct TModule *self, const char *spelling, int in_template)
{
    int i, id, slot, free_param, kind;
    const char *key;
    const char *cs;

    if (!spelling || !spelling[0]) return 0;
    key = frontend::type::type_key_text(spelling);
    if (!key || !key[0]) return 0;
    for (i = 0; i < self->ntypes; i++) {
        if (strcmp(self->types[i].key, key) != 0) continue;
        if (!in_template && self->types[i].free_param)
            self->types[i].used_concrete = 1;
        return self->types[i].id;
    }
    if (self->ntypes >= CAP_LIMIT) return -1;
    if (tir_reserve((void **)&self->types, &self->tcap, self->ntypes + 1,
                    (int)sizeof(struct ct_ttype)) != 0) return -1;
    free_param = tir_free_param(spelling);
    kind = tir_type_kind(spelling, free_param);
    cs = runtime::text::ct_intern(spelling);
    if (!cs) return -1;
    key = runtime::text::ct_intern(key);
    if (!key) return -1;
    slot = self->ntypes;
    id = slot + 1;
    self->types[slot].id = id;
    self->types[slot].kind = kind;
    self->types[slot].key = key;
    self->types[slot].cspell = cs;
    self->types[slot].free_param = free_param;
    self->types[slot].used_concrete = free_param ? (in_template ? 0 : 1) : 0;
    /* Register the row before resolving its parameter: the nested call may
       append a row (and move the table), which must see this one already
       counted or the two writes collide on the same slot. */
    self->ntypes++;
    if (free_param) {
        const char *tname = 0;
        for (i = 0; spelling[i] && !tname; i++) {
            if (spelling[i] < 'A' || spelling[i] > 'Z') continue;
            if (spelling[i + 1] >= 'a' && spelling[i + 1] <= 'z') continue;
            if (spelling[i + 1] >= '0' && spelling[i + 1] <= '9') continue;
            if (i > 0 && (spelling[i - 1] >= 'a' && spelling[i - 1] <= 'z')) continue;
            tname = runtime::text::ct_intern_len(spelling + i, 1);
        }
        if (tname && strcmp(tname, spelling) != 0) {
            int pt;
            pt = tmod_type(self, tname, 1);   /* the parameter's own type row */
            if (pt <= 0) return -1;
            if (tir_reserve((void **)&self->types[slot].tparams,
                            &self->types[slot].pcap, 1, (int)sizeof(int)) != 0)
                return -1;
            self->types[slot].tparams[0] = pt;
            self->types[slot].ntparams = 1;
        }
    }
    return id;
}

pub int tmod_type_void(struct TModule *self)
{
    return tmod_type(self, "void", 0);
}

pub const char *tmod_cspell(struct TModule *self, int tid)
{
    if (tid <= 0 || tid > self->ntypes) return "";
    return self->types[tid - 1].cspell;
}

pub int tmod_has_free_param(struct TModule *self, int tid)
{
    if (tid <= 0 || tid > self->ntypes) return 0;
    return self->types[tid - 1].free_param;
}

/* The same classifier for a spelling that has no TypeId yet. */
pub int tmod_spelling_free(const char *s)
{
    return tir_free_param(s);
}

pub int tmod_new_unit(struct TModule *self, const char *name, const char *ns,
                      int kind, int prog)
{
    int slot, id;

    if (tir_reserve((void **)&self->units, &self->ucap, self->nunits + 1,
                    (int)sizeof(struct ct_tunit)) != 0) return -1;
    slot = self->nunits;
    id = slot + 1;
    self->units[slot].name = name ? name : "";
    self->units[slot].ns = ns ? ns : "";
    self->units[slot].kind = kind;
    self->units[slot].prog = prog;
    self->nunits++;
    return id;
}

pub int tmod_unit_add_import(struct TModule *self, int unit, const char *name)
{
    struct ct_tunit *u;

    if (unit <= 0 || unit > self->nunits) return -1;
    u = &self->units[unit - 1];
    if (tir_reserve((void **)&u->imports, &u->icap, u->nimports + 1,
                    (int)sizeof(int)) != 0) return -1;
    u->imports[u->nimports] = tmod_file(self, name);
    if (u->imports[u->nimports] < 0) return -1;
    u->nimports++;
    return 0;
}

pub int tmod_unit_add_decl(struct TModule *self, int unit, int decl)
{
    struct ct_tunit *u;

    if (unit <= 0 || unit > self->nunits) return -1;
    u = &self->units[unit - 1];
    if (tir_reserve((void **)&u->decls, &u->dcap, u->ndecls + 1,
                    (int)sizeof(int)) != 0) return -1;
    u->decls[u->ndecls] = decl;
    u->ndecls++;
    return 0;
}

pub int tmod_new_decl(struct TModule *self, int kind, const char *name,
                      int file, int line, int col, int unit)
{
    int slot, id;

    if (tir_reserve((void **)&self->decls, &self->dcap, self->ndecls + 1,
                    (int)sizeof(struct ct_tdecl)) != 0) return -1;
    slot = self->ndecls;
    id = slot + 1;
    self->decls[slot].id = id;
    self->decls[slot].kind = kind;
    self->decls[slot].name = name ? name : "";
    self->decls[slot].span.file = file;
    self->decls[slot].span.line = line;
    self->decls[slot].span.col = col;
    self->decls[slot].unit = unit;
    self->ndecls++;
    return id;
}

