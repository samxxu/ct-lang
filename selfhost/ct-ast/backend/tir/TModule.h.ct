pub int tmod_new_scope(struct TModule *self, int parent, int kind)
{
    int slot, id;

    if (tir_reserve((void **)&self->scopes, &self->sccap, self->nscopes + 1,
                    (int)sizeof(struct ct_tscope)) != 0) return -1;
    slot = self->nscopes;
    id = slot + 1;
    self->scopes[slot].id = id;
    self->scopes[slot].parent = parent;
    self->scopes[slot].kind = kind;
    self->nscopes++;
    return id;
}

pub int tmod_scope_add_var(struct TModule *self, int scope, const char *name,
                           int type, int ownkind, int decl, int is_param)
{
    struct ct_tscope *s;
    int slot, id;
    const char *pooled;

    if (scope <= 0 || scope > self->nscopes) return -1;
    if (self->nvars >= CAP_LIMIT) return -1;
    if (tir_reserve((void **)&self->vars, &self->vcap, self->nvars + 1,
                    (int)sizeof(struct ct_tvar)) != 0) return -1;
    s = &self->scopes[scope - 1];
    if (tir_reserve((void **)&s->vars, &s->vcap, s->nvars + 1,
                    (int)sizeof(int)) != 0) return -1;
    pooled = runtime::text::ct_intern(name ? name : "");
    if (!pooled) return -1;
    slot = self->nvars;
    id = slot + 1;
    self->vars[slot].id = id;
    self->vars[slot].name = pooled;
    self->vars[slot].type = type;
    self->vars[slot].scope = scope;
    self->vars[slot].own_kind = ownkind;
    self->vars[slot].decl = decl;
    self->vars[slot].is_param = is_param;
    self->nvars++;
    s->vars[s->nvars] = id;
    s->nvars++;
    return id;
}

pub int tmod_scope_add_cleanup(struct TModule *self, int scope, int kind, int body,
                               int on_error, int file, int line, int col)
{
    struct ct_tscope *s;
    int slot, id;

    if (scope <= 0 || scope > self->nscopes) return -1;
    if (tir_reserve((void **)&self->cleanups, &self->ccap, self->ncleanups + 1,
                    (int)sizeof(struct ct_tcleanup)) != 0) return -1;
    s = &self->scopes[scope - 1];
    if (tir_reserve((void **)&s->cleanups, &s->ccap, s->ncleanups + 1,
                    (int)sizeof(int)) != 0) return -1;
    slot = self->ncleanups;
    id = slot + 1;
    self->cleanups[slot].id = id;
    self->cleanups[slot].kind = kind;
    self->cleanups[slot].body = body;
    self->cleanups[slot].on_error = on_error;
    self->cleanups[slot].span.file = file;
    self->cleanups[slot].span.line = line;
    self->cleanups[slot].span.col = col;
    self->cleanups[slot].scope = scope;
    self->ncleanups++;
    s->cleanups[s->ncleanups] = id;
    s->ncleanups++;
    return id;
}

pub int tmod_new_inst(struct TModule *self, int tmpl, int unit)
{
    int slot, id;

    if (self->ninsts >= CAP_LIMIT) return -1;
    if (tir_reserve((void **)&self->insts, &self->icap, self->ninsts + 1,
                    (int)sizeof(struct ct_tinst)) != 0) return -1;
    slot = self->ninsts;
    id = slot + 1;
    self->insts[slot].id = id;
    self->insts[slot].tmpl = tmpl;
    self->insts[slot].unit = unit;
    self->ninsts++;
    return id;
}

pub int tmod_inst_add_arg(struct TModule *self, int inst, int type)
{
    struct ct_tinst *r;

    if (inst <= 0 || inst > self->ninsts) return -1;
    r = &self->insts[inst - 1];
    if (tir_reserve((void **)&r->args, &r->acap, r->nargs + 1,
                    (int)sizeof(int)) != 0) return -1;
    r->args[r->nargs] = type;
    r->nargs++;
    return 0;
}

pub int tmod_inst_add_member(struct TModule *self, int inst, int member)
{
    struct ct_tinst *r;

    if (inst <= 0 || inst > self->ninsts) return -1;
    r = &self->insts[inst - 1];
    if (tir_reserve((void **)&r->members, &r->mcap, r->nmembers + 1,
                    (int)sizeof(int)) != 0) return -1;
    r->members[r->nmembers] = member;
    r->nmembers++;
    return 0;
}

pub int tmod_new_member(struct TModule *self, int owner, const char *name,
                        int type, int value, int line)
{
    int slot;
    const char *pooled;

    if (tir_reserve((void **)&self->members, &self->mcap, self->nmembers + 1,
                    (int)sizeof(struct ct_tmember)) != 0) return -1;
    pooled = runtime::text::ct_intern(name ? name : "");
    if (!pooled) return -1;
    slot = self->nmembers;
    self->members[slot].owner = owner;
    self->members[slot].name = pooled;
    self->members[slot].type = type;
    self->members[slot].value = value;
    self->members[slot].line = line;
    self->nmembers++;
    return slot + 1;
}

pub int tmod_member_count(struct TModule *self, int owner)
{
    int i, n;

    n = 0;
    for (i = 0; i < self->nmembers; i++)
        if (self->members[i].owner == owner) n++;
    return n;
}

pub int tmod_add_root(struct TModule *self, int kind, int unit, const char *name)
{
    int slot;
    const char *pooled;

    if (tir_reserve((void **)&self->roots, &self->rcap, self->nroots + 1,
                    (int)sizeof(struct ct_troot)) != 0) return -1;
    pooled = runtime::text::ct_intern(name ? name : "");
    if (!pooled) return -1;
    slot = self->nroots;
    self->roots[slot].kind = kind;
    self->roots[slot].unit = unit;
    self->roots[slot].name = pooled;
    self->nroots++;
    return 0;
}

pub int tmod_graph_node(struct TModule *self, int kind, int id)
{
    int i, slot;
    struct ct_tgraph *g;

    g = &self->graph;
    for (i = 0; i < g->nnodes; i++)
        if (g->nodes[i].kind == kind && g->nodes[i].id == id) return i;
    if (tir_reserve((void **)&g->nodes, &g->ncap, g->nnodes + 1,
                    (int)sizeof(struct ct_tnode)) != 0) return -1;
    slot = g->nnodes;
    g->nodes[slot].kind = kind;
    g->nodes[slot].id = id;
    g->nnodes++;
    return slot;
}

pub int tmod_graph_edge(struct TModule *self, int from, int to, int kind,
                        const char *key, int approximate)
{
    struct ct_tgraph *g;
    int slot;
    const char *pooled;

    g = &self->graph;
    if (from < 0 || to < 0) return 0;
    for (slot = 0; slot < g->nedges; slot++) {
        if (g->edges[slot].from != from || g->edges[slot].to != to) continue;
        if (g->edges[slot].kind != kind) continue;
        return 0;
    }
    if (tir_reserve((void **)&g->edges, &g->ecap, g->nedges + 1,
                    (int)sizeof(struct ct_tedge)) != 0) return -1;
    pooled = runtime::text::ct_intern(key ? key : "");
    if (!pooled) return -1;
    slot = g->nedges;
    g->edges[slot].from = from;
    g->edges[slot].to = to;
    g->edges[slot].kind = kind;
    g->edges[slot].key = pooled;
    g->edges[slot].approximate = approximate;
    g->nedges++;
    return 0;
}

/* The coverage / timing line. Debug only: `CT_TIR_REPORT=1`. One line per
   unit plus the running total, so a build's last line is the whole run. */
pub void tmod_report(struct TModule *self, const char *unit, double ms)
{
    const char *e;
    int i, td, ti, tv, tx, tr, tc, tb, tvar, tun;

    e = getenv("CT_TIR_REPORT");
    if (!e || !e[0]) return;
    td = 0;
    ti = 0;
    tv = 0;
    tx = 0;
    tr = 0;
    tc = 0;
    tb = 0;
    tvar = 0;
    tun = 0;
    for (i = 0; i < self->nexprs; i++) {
        switch (self->exprs[i].target_kind) {
            case RT_DIRECT: td++; break;
            case RT_INDIRECT: ti++; break;
            case RT_VIRTUAL: tv++; break;
            case RT_INTRINSIC: tx++; break;
            case RT_RECIPE: tr++; break;
            case RT_CLOSURE: tc++; break;
            case RT_BUILTIN: tb++; break;
            case RT_VAR: tvar++; break;
            case RT_NONE: tun++; break;
        }
    }
    self->stat_ms += ms;
    self->stat_units_seen += 1;
    self->stat_exprs_seen += self->nexprs;
    fprintf(stderr,
            "tir: unit=%s units=%d decls=%d types=%d exprs=%d stmts=%d scopes=%d"
            " vars=%d cleanups=%d insts=%d members=%d roots=%d graph=%d/%d"
            " targets=d%d/i%d/v%d/x%d/r%d/c%d/b%d/var%d none=%d"
            " fallback_types=%d raw_opaque=%d unresolved=%d time_ms=%.3f\n",
            unit ? unit : "", self->nunits, self->ndecls, self->ntypes,
            self->nexprs, self->nstmts, self->nscopes, self->nvars,
            self->ncleanups, self->ninsts, self->nmembers, self->nroots,
            self->graph.nnodes, self->graph.nedges, td, ti, tv, tx, tr, tc, tb,
            tvar, tun, self->stat_fallback_type, self->stat_raw_expr,
            self->stat_unknown_target, ms);
}
