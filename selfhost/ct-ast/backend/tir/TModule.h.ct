/* ------------------------------------------------------------------------- */
/* The value rows. Auxiliary records carry the `ct_` prefix the unit-name    */
/* lint reserves for a main type's companions.                               */
/* ------------------------------------------------------------------------- */
pub struct ct_tspan {
    int file;
    int line;
    int col;
}

pub struct ct_tunit {
    const char *name;
    const char *ns;
    int *imports;
    int nimports;
    int icap;
    int *decls;
    int ndecls;
    int dcap;
    int abi_export;
    int kind;
    int prog;
}

pub struct ct_tdecl {
    int id;
    int kind;
    const char *name;
    struct ct_tspan span;
    int type;
    int *params;
    int nparams;
    int pcap;
    int scope;
    int *traits;
    int ntraits;
    int tcap;
    int abi;
    int unit;
    int body;           /* TStmt id of a function's body, 0 elsewhere (S1b-S2) */
    int is_static;      /* the source spelled `static` on the definition */
    int is_inline;      /* the source spelled `inline` */
    int is_vararg;      /* the parameter list ends in `...` */
}

pub struct ct_ttype {
    int id;
    int kind;
    const char *key;
    const char *cspell;
    int *tparams;
    int ntparams;
    int pcap;
    int inst;
    int free_param;     /* the spelling still names a type parameter */
    int used_concrete;  /* used outside a template body at least once */
}

pub struct ct_texpr {
    int id;
    int kind;
    int type;
    int vclass;
    int own;
    struct ct_tspan span;
    int *kids;
    int nkids;
    int kcap;
    int target_kind;
    int target_a;
    int target_b;
    const char *target_key;
    /* S1b-S2: the C-shaped facts a lowering needs. `text` is a literal's
       spelling, a field/member name, a cast/sizeof type or a callee name;
       `num` is an integer literal's value; `op` is the operator code of a
       binary / unary / postfix / prefix / assignment row. */
    const char *text;
    long num;
    int op;
}

pub struct ct_tstmt {
    int id;
    int kind;
    struct ct_tspan span;
    int scope;
    int *kids;
    int nkids;
    int kcap;
    int aux;
    int err_edge;       /* `return err:` / `break err:` / `continue err:` */
    int flags;          /* per-kind child-shape bitmask (S1b-S2, see TBuilder) */
    const char *text;   /* goto / label name (S1b-S2) */
}

pub struct ct_tscope {
    int id;
    int parent;
    int kind;
    int *vars;
    int nvars;
    int vcap;
    int *cleanups;
    int ncleanups;
    int ccap;
}

pub struct ct_tvar {
    int id;
    const char *name;
    int type;
    int scope;
    int own_kind;       /* OA_NONE / OA_DROP_AT_EXIT / OA_HANDBACK_AT_EXIT */
    int decl;           /* file-scope TDecl id for a global, 0 for a local */
    int decl_stmt;      /* TStmt id of the declaration, for retro-attribution */
    int is_param;
    int is_ref;         /* `ref` / `out`: the C spelling is a pointer */
}

pub struct ct_tcleanup {
    int id;
    int kind;
    int body;           /* TStmt id of the deferred body */
    int on_error;
    struct ct_tspan span;
    int scope;
}

pub struct ct_tinst {
    int id;
    int tmpl;
    int *args;
    int nargs;
    int acap;
    int *members;
    int nmembers;
    int mcap;
    int unit;
}

pub struct ct_tmember {
    int owner;          /* TDecl id */
    const char *name;
    int type;
    int value;
    int line;
}

pub struct ct_troot {
    int kind;
    int unit;
    const char *name;
}

pub struct ct_tnode {
    int kind;
    int id;
}

pub struct ct_tedge {
    int from;           /* index into graph.nodes */
    int to;
    int kind;
    const char *key;
    int approximate;
}

pub struct ct_tgraph {
    struct ct_tnode *nodes;
    int nnodes;
    int ncap;
    struct ct_tedge *edges;
    int nedges;
    int ecap;
}

/* A unit's slice boundaries: the verifier walks [start, current) so one run
   that accumulates several units re-checks only the unit it was handed. */
pub struct ct_tmark {
    int ndecls;
    int nexprs;
    int nstmts;
    int nscopes;
    int nvars;
    int ncleanups;
    int ntypes;
    int ninsts;
    int nmembers;
    int nroots;
    int ngraph;
}

pub struct TModule {
    struct ct_tunit *units;
    int nunits;
    int ucap;
    struct ct_tdecl *decls;
    int ndecls;
    int dcap;
    struct ct_ttype *types;
    int ntypes;
    int tcap;
    struct ct_texpr *exprs;
    int nexprs;
    int ecap;
    struct ct_tstmt *stmts;
    int nstmts;
    int scap;
    struct ct_tscope *scopes;
    int nscopes;
    int sccap;
    struct ct_tvar *vars;
    int nvars;
    int vcap;
    struct ct_tcleanup *cleanups;
    int ncleanups;
    int ccap;
    struct ct_tinst *insts;
    int ninsts;
    int icap;
    struct ct_tmember *members;
    int nmembers;
    int mcap;
    struct ct_troot *roots;
    int nroots;
    int rcap;
    const char **files;
    int nfiles;
    int fcap;
    struct ct_tgraph graph;
    /* Coverage counters for the report. */
    int stat_fallback_type;
    int stat_unknown_target;
    int stat_void_expr;
    int stat_raw_expr;
    /* Report totals accumulated across units of one run. */
    long stat_units_seen;
    long stat_exprs_seen;
    long stat_stmts_seen;
    long stat_scopes_seen;
    long stat_cleanups_seen;
    double stat_ms;
}

static struct TModule g_tir;

/* Grow `*slot` so it holds at least `need` rows of `row` bytes. New rows are
   zeroed, so an append can rely on "0 = none" without clearing by hand. */
static int tir_reserve(void **slot, int *cap, int need, int row)
{
    int ncap;
    void *grown;

    if (need <= *cap) return 0;
    ncap = *cap > 0 ? *cap * 2 : 32;
    while (ncap < need && ncap < NODE_LIMIT) ncap *= 2;
    if (ncap > NODE_LIMIT) ncap = NODE_LIMIT;
    if (need > ncap) return -1;
    grown = realloc(*slot, (size_t)ncap * (size_t)row);
    if (!grown) return -1;
    memset((char *)grown + (size_t)(*cap) * (size_t)row, 0,
           (size_t)(ncap - *cap) * (size_t)row);
    *slot = grown;
    *cap = ncap;
    return 0;
}

/* A single uppercase identifier is a type parameter; a longer uppercase word
   or any lowercase continuation is part of a real type name. `struct S` and
   friends name a tag, never a parameter. */
static int tir_free_param(const char *s)
{
    int i, prev_word;
    char c, prev;

    if (!s) return 0;
    prev_word = 0;
    for (i = 0; s[i]; i++) {
        c = s[i];
        if (c == ' ' || c == '*') {
            prev_word = 0;
            continue;
        }
        if (c == '<' || c == ',' || c == '(') {
            prev_word = 0;
            continue;
        }
        if (c < 'A' || c > 'Z') {
            prev_word = 0;
            continue;
        }
        prev = i > 0 ? s[i - 1] : ' ';
        if (prev == '_' || (prev >= 'a' && prev <= 'z')
            || (prev >= 'A' && prev <= 'Z')
            || (prev >= '0' && prev <= '9'))
            continue;
        if ((s[i + 1] >= 'a' && s[i + 1] <= 'z')
            || (s[i + 1] >= '0' && s[i + 1] <= '9') || s[i + 1] == '_')
            continue;
        if (s[i + 1] >= 'A' && s[i + 1] <= 'Z') continue;
        /* `struct` / `union` / `enum` introduce a tag, not a parameter */
        if (i >= 7 && strncmp(s + i - 7, "struct ", 7) == 0) continue;
        if (i >= 6 && strncmp(s + i - 6, "union ", 6) == 0) continue;
        if (i >= 5 && strncmp(s + i - 5, "enum ", 5) == 0) continue;
        if (prev_word) continue;
        (void)prev;
        return 1;
    }
    return 0;
}

static int tir_type_kind(const char *s, int free_param)
{
    size_t n;

    if (!s || !s[0] || strcmp(s, "void") == 0) return TY_VOID;
    if (free_param) return TY_TPARAM;
    if (strstr(s, "(*)")) return TY_FN;
    if (strncmp(s, "struct ", 7) == 0) return TY_STRUCT;
    if (strncmp(s, "union ", 6) == 0) return TY_UNION;
    if (strncmp(s, "enum ", 5) == 0) return TY_ENUM;
    if (strchr(s, '<')) return TY_INST;
    n = strlen(s);
    if (n > 0 && s[n - 1] == '*') return TY_PTR;
    return TY_PRIM;
}

