/*
 * Verifier.h.ct - the TIR checkpoint (S1b-S1: V1-V4, contract §5).
 *
 * The verifier is a second, independent walk over the TIR rows: it does not
 * trust the builder's decisions and recomputes every condition from the
 * recorded facts. It runs after a unit's slice is built and before the caller
 * opens any output file, so a failed check leaves no `.c` behind.
 *
 * Diagnostics use the `E-IR-1xx` domain (docs/diagnostics/codes.md). The
 * message shape matches the compiler's parse errors:
 *
 *     <path>:<line>:<col>: error: <text> [E-IR-101]
 *
 * V1 type completeness, V2 value class, V3 resolved targets, V4 instance
 * closure. V5-V10 belong to S1b-S2/S3 and are not implemented here; the
 * contract's negative-key list is the input for those stages.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
import runtime::text::Intern;

import backend::tir::TModule;
import backend::tir::TModule::ct_tdecl as ct_tdecl;
import backend::tir::TModule::ct_ttype as ct_ttype;
import backend::tir::TModule::ct_texpr as ct_texpr;
import backend::tir::TModule::ct_tmark as ct_tmark;
import backend::tir::TModule::TModule as TModule;
import backend::lir::LModule;
import backend::lir::LModule::ct_lblock as ct_lblock;
import backend::lir::LModule::ct_lstmt as ct_lstmt;
import backend::lir::LModule::ct_lfunc as ct_lfunc;
import backend::lir::LModule::ct_ltemp as ct_ltemp;
import backend::lir::LModule::ct_lcleanup as ct_lcleanup;
import backend::lir::LModule::ct_lscope as ct_lscope;
import backend::lir::LModule::ct_lexpr as ct_lexpr;
import backend::lir::LModule::LModule as LModule;

/* mirrors of TModule.h.ct; test/ir/run.sh compares both unit blocks */
#define TK_ADDR              7
#define TK_CALL             11
#define TK_INTRINSIC        12
#define TK_ASSIGN           26
#define TK_POSTFIX          27
#define TK_PREFIX           28
#define VC_PLACE            1
#define RT_NONE             0
#define RT_DIRECT           1
#define RT_INDIRECT         2
#define RT_VIRTUAL          3
#define RT_INTRINSIC        4
#define RT_RECIPE           5
#define RT_CLOSURE          6
#define RT_BUILTIN          7
#define RT_VAR              8
#define TD_FUNC             1
#define TD_TRAIT            7
#define TD_STRUCT           3
#define TE_INSTANTIATE      5
#define CAP_LIMIT 65536

/* LIR mirrors of backend/lir/LModule.h.ct; test/ir/run.sh compares them. */
#define LE_NAME              4
#define LS_DECL              1
#define LS_DEFER_RUN         5
#define LS_ERRDEFER_RUN      6
#define LS_DROP              4
#define LS_JUMP             12
#define LT_RETURN            1
#define CL_DEFER             1
#define CL_ERRDEFER          2
#define CL_DROP              3
#define CL_RELEASE           4
#define CL_HANDBACK          5
#define SC_FUNC              1
#define LB_DEFER_BODY        8

namespace backend::verify;

pub struct Verifier {
    int errors;
}

pub int ct_verifier_run(struct TModule *m, int unit, struct ct_tmark *mark);
pub int ct_verifier_errors(void);

static struct Verifier g_verifier;

static void vfail(struct TModule *m, int file, int line, int col,
                  const char *code, const char *msg)
{
    const char *path;

    path = "?";
    if (file > 0 && file <= m->nfiles) path = m->files[file - 1];
    fprintf(stderr, "%s:%d:%d: error: %s [%s]\n", path, line, col, msg, code);
    g_verifier.errors++;
}

static int v_decl_kind(struct TModule *m, int decl)
{
    if (decl <= 0 || decl > m->ndecls) return 0;
    return m->decls[decl - 1].kind;
}

/* V1: every expression has a TypeId, every declaration has one, and a type
   that still names a template parameter is never used outside a template. */
static int v_check_types(struct TModule *m, struct ct_tmark *mark)
{
    int i;

    for (i = mark->nexprs; i < m->nexprs; i++) {
        if (m->exprs[i].type <= 0) {
            vfail(m, m->exprs[i].span.file, m->exprs[i].span.line,
                  m->exprs[i].span.col, "E-IR-101",
                  "TIR expression has no type id");
            continue;
        }
        if (m->exprs[i].type > m->ntypes) {
            vfail(m, m->exprs[i].span.file, m->exprs[i].span.line,
                  m->exprs[i].span.col, "E-IR-101",
                  "TIR expression names an unknown type id");
        }
    }
    for (i = mark->ndecls; i < m->ndecls; i++) {
        if (m->decls[i].type <= 0 && m->decls[i].kind != TD_TRAIT) {
            vfail(m, m->decls[i].span.file, m->decls[i].span.line,
                  m->decls[i].span.col, "E-IR-101",
                  "TIR declaration has no type id");
        }
    }
    for (i = mark->ntypes; i < m->ntypes; i++) {
        if (m->types[i].free_param && m->types[i].used_concrete
            && m->types[i].inst == 0) {
            vfail(m, 0, 0, 0, "E-IR-101",
                  runtime::text::ct_internf(
                      "type '%s' keeps a free type parameter outside a template",
                      m->types[i].cspell));
        }
    }
    return 0;
}

/* V2: the value-class judgement table (§3.3) at the contexts S1 covers:
   assignment target, ++/-- target, address-of operand. */
static int v_check_value_class(struct TModule *m, struct ct_tmark *mark)
{
    int i, kid;

    for (i = mark->nexprs; i < m->nexprs; i++) {
        struct ct_texpr *e;
        e = &m->exprs[i];
        if (e->kind != TK_ASSIGN && e->kind != TK_PREFIX
            && e->kind != TK_POSTFIX && e->kind != TK_ADDR) continue;
        if (e->nkids <= 0) continue;
        kid = e->kids[0];
        if (kid <= 0 || kid > m->nexprs) continue;
        if (m->exprs[kid - 1].vclass == VC_PLACE) continue;
        vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-102",
              e->kind == TK_ASSIGN
                  ? "assignment target is not a place"
                  : "value-class requirement violated (place expected)");
    }
    return 0;
}

/* V3: every call-like node has a resolved target, a virtual slot belongs to
   the receiver's trait, and a recipe names a key. */
static int v_check_targets(struct TModule *m, struct ct_tmark *mark)
{
    int i;

    for (i = mark->nexprs; i < m->nexprs; i++) {
        struct ct_texpr *e;
        e = &m->exprs[i];
        if (e->kind != TK_CALL && e->kind != TK_INTRINSIC) continue;
        if (e->target_kind == RT_NONE) {
            vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-103",
                  "call has no resolved target");
            continue;
        }
        if (e->target_kind == RT_VIRTUAL) {
            int slot;
            slot = e->target_b;
            if (v_decl_kind(m, e->target_a) != TD_TRAIT) {
                vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-103",
                      "virtual target is not a trait");
            } else if (slot < 0
                       || slot >= backend::tir::tmod_member_count(m, e->target_a)) {
                vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-103",
                      "virtual slot does not belong to the receiver trait");
            }
        } else if (e->target_kind == RT_DIRECT) {
            int k;
            k = v_decl_kind(m, e->target_a);
            if (k != TD_FUNC && k != TD_STRUCT) {
                vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-103",
                      "direct target is not a declaration");
            }
        } else if (e->target_kind == RT_RECIPE) {
            if (!e->target_key || !e->target_key[0]) {
                vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-103",
                      "recipe target has no key");
            }
        } else if (e->target_kind == RT_INDIRECT) {
            if (e->target_a <= 0) {
                vfail(m, e->span.file, e->span.line, e->span.col, "E-IR-103",
                      "indirect target has no callee type");
            }
        }
    }
    return 0;
}

/* DFS over the instantiate edges; 1 = cycle found. */
static int v_dfs(struct TModule *m, int node, int *color)
{
    int e;

    color[node] = 1;
    for (e = 0; e < m->graph.nedges; e++) {
        int to;
        if (m->graph.edges[e].from != node) continue;
        if (m->graph.edges[e].kind != TE_INSTANTIATE) continue;
        to = m->graph.edges[e].to;
        if (to < 0 || to >= m->graph.nnodes) continue;
        if (color[to] == 1) return 1;
        if (color[to] == 0 && v_dfs(m, to, color) != 0) return 1;
    }
    color[node] = 2;
    return 0;
}

/* V4: an instance has a template and concrete arguments, and the instance
   graph is acyclic. */
static int v_check_instances(struct TModule *m, struct ct_tmark *mark)
{
    int i, rc;

    for (i = mark->ninsts; i < m->ninsts; i++) {
        int kind;
        kind = v_decl_kind(m, m->insts[i].tmpl);
        if (kind != TD_FUNC && kind != TD_STRUCT) {
            vfail(m, m->insts[i].unit > 0 && m->insts[i].unit <= m->nunits
                      ? 0 : 0, 0, 0, "E-IR-104",
                  "instance has no open template");
            continue;
        }
        if (kind == TD_FUNC && m->insts[i].nargs <= 0) {
            vfail(m, 0, 0, 0, "E-IR-104",
                  "instance has no concrete argument");
        }
    }
    if (m->graph.nnodes > 0) {
        int *color;
        color = (int *)calloc((size_t)m->graph.nnodes, sizeof(int));
        if (!color) {
            vfail(m, 0, 0, 0, "E-IR-104", "cannot allocate the instance-cycle mark");
            return 0;
        }
        rc = 0;
        for (i = 0; i < m->graph.nnodes && rc == 0; i++)
            if (color[i] == 0) rc = v_dfs(m, i, color);
        if (rc != 0) {
            vfail(m, 0, 0, 0, "E-IR-104", "instance closure contains a cycle");
        }
        free(color);
    }
    return 0;
}

pub int ct_verifier_errors(void)
{
    return g_verifier.errors;
}

/* Run V1-V4 over the slice [mark, current). `unit` is accepted for a later
   per-unit message table; the rows carry their own file spans today. */
pub int ct_verifier_run(struct TModule *m, int unit, struct ct_tmark *mark)
{
    g_verifier.errors = 0;
    (void)unit;
    if (!m || !mark) return -1;
    if (m->nexprs == 0 && m->ndecls == 0) {
        fprintf(stderr, "tir: verifier ran on an empty module\n");
        return -1;
    }
    v_check_types(m, mark);
    v_check_value_class(m, mark);
    v_check_targets(m, mark);
    v_check_instances(m, mark);
    if (g_verifier.errors > 0) {
        fprintf(stderr, "tir: verifier: %d TIR invariant failure(s) in this unit\n",
                g_verifier.errors);
        return -1;
    }
    return 0;
}

/* ------------------------------------------------------------------------- */
/* LIR checkpoint (S1b-S2): V5-V8 (contract §5.2)                            */
/*                                                                           */
/* The walk below recomputes every exit's cleanup set from the LIR rows,     */
/* never from the lowerer's own result: it starts at the TScope table copied */
/* into LModule, applies §4.3, and compares the sequence with the statements */
/* the lowerer materialised. A failed check runs before the caller opens the */
/* output file, so a negative leaves no `.c` behind.                         */
/* ------------------------------------------------------------------------- */
#define LX_MAX_CHAIN 256
#define LEXP_MAX 64

pub struct lir_expect {
    int kind;
    int origin;
}

static int g_lir_errors;

static void lfail(struct LModule *l, int file, int line, int col,
                  const char *code, const char *msg)
{
    struct TModule *m;
    const char *path;

    (void)l;
    m = backend::tir::tmod_get();
    path = "?";
    if (m && file > 0 && file <= m->nfiles) path = m->files[file - 1];
    fprintf(stderr, "%s:%d:%d: error: %s [%s]\n", path, line, col, msg, code);
    g_lir_errors++;
}

static int lver_scope_kind(struct LModule *l, int scope)
{
    if (scope <= 0 || scope > l->nscopes) return 0;
    return l->scopes[scope - 1].kind;
}

static int lver_scope_parent(struct LModule *l, int scope)
{
    if (scope <= 0 || scope > l->nscopes) return 0;
    return l->scopes[scope - 1].parent;
}

static int lver_active(struct ct_lcleanup *c, int line, int col, int all)
{
    if (all) return 1;
    if (c->span.line < line) return 1;
    if (c->span.line == line && c->span.col <= col) return 1;
    return 0;
}

static int lver_chain(struct LModule *l, int scope, int stop_scope, int stop_kind,
                      int *out, int *nout)
{
    int n = 0;

    while (scope > 0) {
        if (n >= LX_MAX_CHAIN) { *nout = n; return -1; }
        if (stop_scope > 0 && scope == stop_scope) {
            out[n] = scope;
            n++;
            break;
        }
        if (stop_kind > 0 && lver_scope_kind(l, scope) == stop_kind) break;
        out[n] = scope;
        n++;
        scope = lver_scope_parent(l, scope);
    }
    *nout = n;
    return 0;
}

/* Recompute §4.3: deferred entries first (layers inner -> outer, reverse
   source order), then owned entries the same way. */
static int lver_expect(struct LModule *l, int *chain, int nchain, int edge,
                       int all, int line, int col, struct lir_expect *out,
                       int *nout)
{
    int n = 0, ci, k;

    for (ci = 0; ci < nchain; ci++) {
        struct ct_lscope *s = &l->scopes[chain[ci] - 1];
        for (k = s->ncleanups - 1; k >= 0; k--) {
            struct ct_lcleanup *c = &l->cleanups[s->cleanups[k] - 1];
            if (c->kind != CL_DEFER && c->kind != CL_ERRDEFER) continue;
            if (edge == 0 && c->on_error) continue;
            if (!lver_active(c, line, col, all)) continue;
            if (n >= LEXP_MAX) return -1;
            out[n].kind = c->kind == CL_ERRDEFER ? LS_ERRDEFER_RUN : LS_DEFER_RUN;
            out[n].origin = c->id;
            n++;
        }
    }
    for (ci = 0; ci < nchain; ci++) {
        struct ct_lscope *s = &l->scopes[chain[ci] - 1];
        for (k = s->ncleanups - 1; k >= 0; k--) {
            struct ct_lcleanup *c = &l->cleanups[s->cleanups[k] - 1];
            if (c->kind != CL_DROP && c->kind != CL_RELEASE
                && c->kind != CL_HANDBACK) continue;
            if (!lver_active(c, line, col, all)) continue;
            if (n >= LEXP_MAX) return -1;
            out[n].kind = LS_DROP;
            out[n].origin = c->id;
            n++;
        }
    }
    *nout = n;
    return 0;
}

static int lver_cmp(struct LModule *l, struct lir_expect *exp, int nexp,
                    int *ids, int nids, int file, int line, int col)
{
    int i, j = 0;

    for (i = 0; i < nids; i++) {
        struct ct_lstmt *s;
        if (ids[i] <= 0 || ids[i] > l->nstmts) {
            lfail(l, file, line, col, "E-IR-106",
                  "a cleanup set names no statement");
            return 1;
        }
        s = &l->stmts[ids[i] - 1];
        if (s->kind != LS_DEFER_RUN && s->kind != LS_ERRDEFER_RUN
            && s->kind != LS_DROP) continue;
        if (j >= nexp) {
            lfail(l, file, line, col, "E-IR-106",
                  "a cleanup statement is not in the recomputed exit set");
            return 1;
        }
        if (exp[j].kind != s->kind || exp[j].origin != s->origin) {
            lfail(l, file, line, col, "E-IR-106",
                  "the cleanup set does not match the recomputed exit order");
            return 1;
        }
        j++;
    }
    if (j != nexp) {
        lfail(l, file, line, col, "E-IR-106",
              "the cleanup set is missing an entry");
        return 1;
    }
    return 0;
}

/* V7: errdefer runs on error edges only, and no exit repeats an entry. */
static int lver_v7_set(struct LModule *l, int *ids, int nids, int error_edge,
                       int file, int line, int col)
{
    int i, j;

    for (i = 0; i < nids; i++) {
        struct ct_lstmt *s;
        if (ids[i] <= 0 || ids[i] > l->nstmts) continue;
        s = &l->stmts[ids[i] - 1];
        if (s->kind == LS_ERRDEFER_RUN && !error_edge) {
            lfail(l, file, line, col, "E-IR-107",
                  "an errdefer runs on a normal exit");
        }
        if (s->kind != LS_DEFER_RUN && s->kind != LS_ERRDEFER_RUN
            && s->kind != LS_DROP) continue;
        for (j = 0; j < i; j++) {
            struct ct_lstmt *p;
            if (ids[j] <= 0 || ids[j] > l->nstmts) continue;
            p = &l->stmts[ids[j] - 1];
            if (p->kind == s->kind && p->origin == s->origin) {
                lfail(l, file, line, col, "E-IR-107",
                      "the exit repeats a cleanup entry");
                break;
            }
        }
    }
    return 0;
}

static int lver_declared(struct LModule *l, struct ct_lfunc *f, const char *name)
{
    int i, j;

    if (!name || !name[0]) return 0;
    for (i = 0; i < f->nparams; i++)
        if (f->params[i].name && strcmp(f->params[i].name, name) == 0) return 1;
    for (i = 0; i < f->nblocks; i++) {
        struct ct_lblock *b;
        if (f->blocks[i] <= 0 || f->blocks[i] > l->nblocks) continue;
        b = &l->blocks[f->blocks[i] - 1];
        for (j = 0; j < b->nstmts; j++) {
            struct ct_lstmt *s;
            if (b->stmts[j] <= 0 || b->stmts[j] > l->nstmts) continue;
            s = &l->stmts[b->stmts[j] - 1];
            if (s->kind == LS_DECL && s->name && strcmp(s->name, name) == 0)
                return 1;
        }
    }
    return 0;
}

/* V8: an object is dropped at most once per exit, and only a declared
   object is dropped. (Move-after-use stays on the AST path for S2.) */
static int lver_v8_set(struct LModule *l, struct ct_lfunc *f, int *ids, int nids,
                       int file, int line, int col)
{
    int i, j;

    for (i = 0; i < nids; i++) {
        struct ct_lstmt *s;
        if (ids[i] <= 0 || ids[i] > l->nstmts) continue;
        s = &l->stmts[ids[i] - 1];
        if (s->kind != LS_DROP) continue;
        if (!lver_declared(l, f, s->name)) {
            lfail(l, file, line, col, "E-IR-108",
                  "a drop names an object that is not declared here");
        }
        for (j = 0; j < i; j++) {
            struct ct_lstmt *p;
            if (ids[j] <= 0 || ids[j] > l->nstmts) continue;
            p = &l->stmts[ids[j] - 1];
            if (p->kind == LS_DROP && p->name && s->name
                && strcmp(p->name, s->name) == 0) {
                lfail(l, file, line, col, "E-IR-108",
                      "the exit drops the same object twice");
                break;
            }
        }
    }
    return 0;
}

/* V5: temporary discipline. One declaration per temporary, a legal spelling,
   a unique name in the module, and a return value declared in the block that
   prints it. */
static int lver_tmp_prefix_ok(const char *nm)
{
    const char *p;

    if (!nm) return 0;
    if (strncmp(nm, "__ct_", 5) != 0) return 0;
    p = nm + 5;
    if (strncmp(p, "tmp", 3) == 0) p += 3;
    else if (strncmp(p, "recv", 4) == 0) p += 4;
    else if (strncmp(p, "opt", 3) == 0) p += 3;
    else if (strncmp(p, "ret", 3) == 0) p += 3;
    else if (strncmp(p, "sret", 4) == 0) p += 4;
    else if (strncmp(p, "new", 3) == 0) p += 3;
    else return 0;
    if (!*p) return 0;
    while (*p) {
        if (*p < '0' || *p > '9') return 0;
        p++;
    }
    return 1;
}

static int lver_v5(struct LModule *l)
{
    int i, j;

    for (i = 0; i < l->ntemps; i++) {
        struct ct_ltemp *t = &l->temps[i];
        if (!lver_tmp_prefix_ok(t->name)) {
            lfail(l, 0, 0, 0, "E-IR-105",
                  "a temporary does not use a compiler prefix");
            continue;
        }
        if (t->decl_block <= 0 || t->decl_block > l->nblocks) {
            lfail(l, 0, 0, 0, "E-IR-105",
                  "a temporary is declared outside every block");
            continue;
        }
        for (j = 0; j < i; j++)
            if (l->temps[j].name && t->name
                && strcmp(l->temps[j].name, t->name) == 0) {
                lfail(l, 0, 0, 0, "E-IR-105",
                      "two temporaries share one name");
                break;
            }
    }
    for (i = 0; i < l->nfuncs; i++) {
        struct ct_lfunc *f = &l->funcs[i];
        if (!f->ok) continue;
        for (j = 0; j < f->nblocks; j++) {
            struct ct_lblock *b;
            if (f->blocks[j] <= 0 || f->blocks[j] > l->nblocks) continue;
            b = &l->blocks[f->blocks[j] - 1];
            if (b->ret_temp <= 0) continue;
            if (b->ret_temp > l->ntemps) {
                lfail(l, b->span.file, b->span.line, b->span.col, "E-IR-105",
                      "a return names a temporary that does not exist");
            } else if (l->temps[b->ret_temp - 1].decl_block != b->id) {
                lfail(l, b->span.file, b->span.line, b->span.col, "E-IR-105",
                      "a temporary is used outside its declaring block");
            }
        }
    }
    return 0;
}

/* Test seam: CT_LIR_FAULT=<key> appends / mutates one row before the checks,
   exactly like CT_TIR_FAULT does for V1-V4. Only reachable under the switch. */
static void lver_fault(struct LModule *l, const char *key)
{
    int i, j;

    if (strcmp(key, "ir-v5-temp-cross-scope") == 0) {
        if (l->ntemps > 0) l->temps[0].decl_block = 0;
        return;
    }
    if (strcmp(key, "ir-v6-cleanup-mismatch") == 0) {
        for (i = 0; i < l->nblocks; i++) {
            struct ct_lblock *b = &l->blocks[i];
            if (b->ntermc > 0) { b->ntermc--; return; }
            if (b->ntail > 0) { b->ntail--; return; }
        }
        return;
    }
    if (strcmp(key, "ir-v7-errdefer-normal") == 0) {
        struct ct_lcleanup *c = 0;
        for (j = 0; j < l->ncleanups; j++)
            if (l->cleanups[j].kind == CL_ERRDEFER) { c = &l->cleanups[j]; break; }
        if (!c) return;
        for (i = 0; i < l->nblocks; i++) {
            struct ct_lblock *b = &l->blocks[i];
            int blk, sid;
            if (b->ntail == 0 && b->ntermc == 0) continue;
            blk = backend::lir::lmod_new_block(l, LB_DEFER_BODY, c->scope, 0);
            sid = backend::lir::lmod_new_stmt(l, LS_ERRDEFER_RUN, 0, 0, 0);
            if (blk <= 0 || sid <= 0) return;
            l->stmts[sid - 1].body_blk = blk;
            l->stmts[sid - 1].origin = c->id;
            if (b->ntail > 0) backend::lir::lmod_block_add_tail(l, i + 1, sid);
            else backend::lir::lmod_block_add_cleanup(l, i + 1, sid);
            return;
        }
        return;
    }
    if (strcmp(key, "ir-v8-double-drop") == 0) {
        for (i = 0; i < l->nfuncs; i++) {
            struct ct_lfunc *f = &l->funcs[i];
            const char *name = 0;
            if (!f->ok) continue;
            if (f->nparams > 0) name = f->params[0].name;
            if (!name)
                for (j = 0; j < f->nblocks && !name; j++) {
                    struct ct_lblock *b;
                    int k;
                    if (f->blocks[j] <= 0 || f->blocks[j] > l->nblocks) continue;
                    b = &l->blocks[f->blocks[j] - 1];
                    for (k = 0; k < b->nstmts; k++) {
                        struct ct_lstmt *s;
                        if (b->stmts[k] <= 0 || b->stmts[k] > l->nstmts) continue;
                        s = &l->stmts[b->stmts[k] - 1];
                        if (s->kind == LS_DECL && s->name) { name = s->name; break; }
                    }
                }
            if (!name) continue;
            for (j = 0; j < 2; j++) {
                int sid = backend::lir::lmod_new_stmt(l, LS_DROP, 0, 0, 0);
                if (sid <= 0) return;
                l->stmts[sid - 1].name = name;
                backend::lir::lmod_block_add_tail(l, f->root, sid);
            }
            return;
        }
        return;
    }
}

static void lver_block(struct LModule *l, struct ct_lfunc *f, int bid)
{
    struct ct_lblock *b;
    struct lir_expect exp[LEXP_MAX];
    int chain[LX_MAX_CHAIN];
    int nchain = 0, nexp = 0, i;

    if (bid <= 0 || bid > l->nblocks) return;
    b = &l->blocks[bid - 1];
    /* the normal fall-out of one C block: its own scope, every entry */
    chain[0] = b->scope;
    if (lver_expect(l, chain, 1, 0, 1, 0, 0, exp, &nexp) == 0) {
        lver_cmp(l, exp, nexp, b->tail_cleanups, b->ntail,
                 b->span.file, b->span.line, b->span.col);
        lver_v7_set(l, b->tail_cleanups, b->ntail, 0,
                    b->span.file, b->span.line, b->span.col);
        lver_v8_set(l, f, b->tail_cleanups, b->ntail,
                    b->span.file, b->span.line, b->span.col);
    }
    if (b->term == LT_RETURN) {
        nchain = 0;
        lver_chain(l, b->scope, 0, SC_FUNC, chain, &nchain);
        nexp = 0;
        if (lver_expect(l, chain, nchain, b->term_err, 0, b->span.line,
                        b->span.col, exp, &nexp) == 0) {
            lver_cmp(l, exp, nexp, b->term_cleanups, b->ntermc,
                     b->span.file, b->span.line, b->span.col);
            lver_v7_set(l, b->term_cleanups, b->ntermc, b->term_err,
                        b->span.file, b->span.line, b->span.col);
            lver_v8_set(l, f, b->term_cleanups, b->ntermc,
                        b->span.file, b->span.line, b->span.col);
        }
    }
    for (i = 0; i < b->nstmts; i++) {
        struct ct_lstmt *s;
        int target_scope, stop_scope;
        if (b->stmts[i] <= 0 || b->stmts[i] > l->nstmts) continue;
        s = &l->stmts[b->stmts[i] - 1];
        if (s->kind != LS_JUMP) continue;
        stop_scope = 0;
        if (s->target > 0 && s->target <= l->nblocks)
            stop_scope = l->blocks[s->target - 1].scope;
        target_scope = s->scope > 0 ? s->scope : b->scope;
        nchain = 0;
        if (stop_scope > 0)
            lver_chain(l, target_scope, stop_scope, 0, chain, &nchain);
        else
            lver_chain(l, target_scope, 0, SC_FUNC, chain, &nchain);
        nexp = 0;
        if (lver_expect(l, chain, nchain, s->err_edge, 0, s->span.line,
                        s->span.col, exp, &nexp) == 0) {
            lver_cmp(l, exp, nexp, s->cleanups, s->ncleanups,
                     s->span.file, s->span.line, s->span.col);
            lver_v7_set(l, s->cleanups, s->ncleanups, s->err_edge,
                        s->span.file, s->span.line, s->span.col);
            lver_v8_set(l, f, s->cleanups, s->ncleanups,
                        s->span.file, s->span.line, s->span.col);
        }
    }
}

/* CP2, called after lowering and before the caller opens the output file. */
pub int ct_lir_verify(struct LModule *l)
{
    const char *fault;
    int i, j;

    g_lir_errors = 0;
    if (!l) return -1;
    fault = getenv("CT_LIR_FAULT");
    if (fault && fault[0]) lver_fault(l, fault);
    lver_v5(l);
    for (i = 0; i < l->nfuncs; i++) {
        struct ct_lfunc *f = &l->funcs[i];
        if (!f->ok) continue;
        for (j = 0; j < f->nblocks; j++) lver_block(l, f, f->blocks[j]);
    }
    if (g_lir_errors > 0) {
        fprintf(stderr, "lir: verifier: %d LIR invariant failure(s) in this unit\n",
                g_lir_errors);
        return -1;
    }
    return 0;
}
