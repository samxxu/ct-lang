/*
 * Arena.h.ct - the node pool and the string-literal pool, one class of its own.
 *
 * Node storage and literal storage are the compiler's two big pools.
 * They live here as an explicit `Arena` object so the driver and the parser
 * reach them through a pointer instead of two file-scope globals, and the
 * capacity macros stay with the code that consumes them. Macros do not cross a
 * unit boundary, so `MAX_NODES` is only usable in this unit -- the pools are
 * heap blocks sized by it at first use. The node pool is compiled for the
 * whole unit closure at once, so its size follows the compiler's own source
 * (~70 K nodes by v0.15.0); the pool is a capacity, not a language limit.
 */
#include <stdlib.h>
#define MAX_NODES 131072
namespace runtime::arena;
/* The pool owns storage only: node kinds and the meaning of the child slots are
   documented where the nodes are built (frontend/parse/Parser.h.ct, Expr.h.ct
   and Stmt.h.ct). The field layout matches the `Node` shape the whole pipeline
   reads and writes. It is a plain `pub struct` (no `use`) -- an exported value
   type the caller can read through the pointer, not an object with behaviour. */
pub struct Node {
    int  kind;
    int  a;
    int  b;
    int  c;
    int  d;
    int  next;
    int  aux;
    int  line;
    long num;
    /* A GNU `__attribute__((…))` on this declaration: -1 when it carried none,
       otherwise the offset of its captured spelling in the string pool (the
       emitter prints it at the declaration's trailing position). */
    int  attr;
    char text[160];
    char text2[160];
    char text3[160];
}

pub trait ArenaOps {
    int  alloc(int kind, int line);
    int  str_begin(void);
    int  str_put(int c);
    void str_end(void);
    const char *str_at(int off);
    void reset(void);
}

pub struct Arena {
    /* The two pools are calloc'd on first use (SH-42): as inline arrays in a
       file-scope `static` instance they put ~69 MB of zeroes into __DATA and
       shipped an 88 MB compiler. The lengths stay literal -- the generated
       header carries no macros -- and `alloc` / `str_put` still bound against
       MAX_NODES / 262144, so the capacity semantics are unchanged. */
    struct Node *nodes;
    int  nnode;
    char *strpool;
    int  nstrpool;
} use ArenaOps;

pub struct Arena *arena_get(void);

/* Lazily give the pools their backing store. calloc keeps the zero-filled
   semantics the static arrays had; a failure is reported as -1 (nodes) or a
   skipped byte (strings) so the caller's existing diagnostics still fire. */
static int arena_grow_nodes(struct Arena *self)
{
    if (self->nodes) return 0;
    self->nodes = calloc(MAX_NODES, sizeof(*self->nodes));
    return self->nodes ? 0 : -1;
}

static int arena_grow_strpool(struct Arena *self)
{
    if (self->strpool) return 0;
    self->strpool = calloc(262144, 1);
    return self->strpool ? 0 : -1;
}

impl ArenaOps for Arena {
    /* A fresh node with every child slot cleared. `text3` is left alone: the
       parser writes it before the emitter ever reads it. Overflow stays a hard
       error -- the caller turns -1 into a diagnostic. */
    int alloc(int kind, int line)
    {
        int n;
        if (self->nnode >= MAX_NODES) return -1;
        if (arena_grow_nodes(self) != 0) return -1;
        n = self->nnode;
        self->nnode++;
        self->nodes[n].kind = kind;
        self->nodes[n].a = -1;
        self->nodes[n].b = -1;
        self->nodes[n].c = -1;
        self->nodes[n].d = -1;
        self->nodes[n].next = -1;
        self->nodes[n].aux = 0;
        self->nodes[n].line = line;
        self->nodes[n].num = 0;
        self->nodes[n].attr = -1;
        self->nodes[n].text[0] = 0;
        self->nodes[n].text2[0] = 0;
        return n;
    }

    /* Literals are copied into a pool, not kept in `Node.text`: adjacent
       literals join into one C string and easily exceed the 160-byte field.
       `str_begin` marks the literal's start, `str_put` appends a byte and
       `str_end` terminates it, keeping the NUL for good. */
    int str_begin(void)
    {
        return self->nstrpool;
    }

    int str_put(int c)
    {
        if (self->nstrpool + 2 >= 262144) return -1;   /* room for this byte and the NUL */
        if (arena_grow_strpool(self) != 0) return -1;
        self->strpool[self->nstrpool] = (char)c;
        self->nstrpool++;
        return 0;
    }

    void str_end(void)
    {
        if (arena_grow_strpool(self) != 0) return;
        self->strpool[self->nstrpool] = 0;
        self->nstrpool++;
    }

    const char *str_at(int off)
    {
        if (!self->strpool) return "";
        return self->strpool + off;
    }

    /* Drop the nodes a previous unit used. The literal pool is *not* wound back:
       old nodes keep their offsets, and new literals simply append after them,
       which is what the compiler did when the pool was a file-scope array. */
    void reset(void)
    {
        self->nnode = 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. It starts all-zero
   and grows its pools on first use. */
static struct Arena g_arena;

struct Arena *arena_get(void)
{
    return &g_arena;
}
