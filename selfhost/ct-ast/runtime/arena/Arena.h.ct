/*
 * Arena.h.ct - the node pool and the string-literal pool, one class of its own.
 *
 * Node storage and literal storage are the compiler's two big pools.
 * They live here as an explicit `Arena` object so the driver and the parser
 * reach them through a pointer instead of two file-scope globals, and the
 * capacity macros stay with the code that consumes them. Macros do not cross a
 * unit boundary, so `MAX_NODES` is only usable in this unit -- the pools are
 * heap blocks sized by it at first use. The node pool is compiled for the
 * whole unit closure at once, so its size follows the compiler's own source
 * (~70 K nodes by v0.15.0); the pool is a capacity, not a language limit.
 */
#include <stdlib.h>
#include <string.h>
import runtime::text::Intern;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_NODES 262144
#define NODE_LIMIT 16777216
namespace runtime::arena;
/* The pool owns storage only: node kinds and the meaning of the child slots are
   documented where the nodes are built (frontend/parse/Parser.h.ct, Expr.h.ct
   and Stmt.h.ct). The field layout matches the `Node` shape the whole pipeline
   reads and writes. It is a plain `pub struct` (no `use`) -- an exported value
   type the caller can read through the pointer, not an object with behaviour. */
/* PH-88/v1-PH-0 S0.5: one ADT variant per node kind, declared in numeric
   order so `(NodeKind){ .tag = kind }` is a faithful view of the flat
   `Node.kind` (the tree keeps its int tag; this is the matchable spelling the
   exhaustive `match` needs). Values 0, 32 and 68 carry no node kind today;
   their unused variants keep the tag == value invariant. `p88_emit` pins this
   list against the N_* macros, and the compiler reports a missing arm as
   `match does not cover variant`. */
pub enum NodeKind {
    NK_UNUSED0(),
    NK_PROG(),
    NK_PP(),
    NK_FUNC(),
    NK_BLOCK(),
    NK_RET(),
    NK_EXPR(),
    NK_CALL(),
    NK_NUM(),
    NK_STR(),
    NK_VAR(),
    NK_BIN(),
    NK_DECL(),
    NK_ASSIGN(),
    NK_IF(),
    NK_WHILE(),
    NK_FOR(),
    NK_UNARY(),
    NK_POST(),
    NK_PARAM(),
    NK_STRUCT(),
    NK_TYPEDEF(),
    NK_GLOBAL(),
    NK_FIELD(),
    NK_MEMBER(),
    NK_ARROW(),
    NK_INDEX(),
    NK_ADDR(),
    NK_DEREF(),
    NK_METHOD(),
    NK_MCALL(),
    NK_RAW(),
    NK_UNUSED32(),
    NK_IMPL(),
    NK_BOX(),
    NK_CAST(),
    NK_SIZEOF(),
    NK_TERN(),
    NK_BREAK(),
    NK_CONT(),
    NK_DECLS(),
    NK_DELETE(),
    NK_SWITCH(),
    NK_CASE(),
    NK_DOWHILE(),
    NK_ENUM(),
    NK_ENUMVAL(),
    NK_OFFSETOF(),
    NK_UNION(),
    NK_LABEL(),
    NK_GOTO(),
    NK_COMPOUND(),
    NK_EMPTY(),
    NK_VAARG(),
    NK_FNUM(),
    NK_SASSERT(),
    NK_FIELDS(),
    NK_PRE(),
    NK_RAW_TEXT(),
    NK_CLOSURE(),
    NK_LOOP(),
    NK_INIT_RANGE(),
    NK_FOREACH(),
    NK_INTO(),
    NK_INTO_SELF(),
    NK_INIT_BRACE(),
    NK_INIT_ITEM(),
    NK_INIT_MBRACE(),
    NK_UNUSED68(),
    NK_DEFER(),
    NK_DEFER_RUN(),
    NK_TRY(),
    NK_OPT(),
    NK_MATSEQ(),
    NK_SLICE_INDEX(),
    NK_SLICE_RANGE(),
    NK_SLICE_GET(),
    NK_NEWOBJ(),
    NK_MATCH(),
    NK_ARM(),
    NK_BIND(),
    NK_ADTCTOR(),
    NK_ADTFIELD(),
    NK_ADTMEM(),
}

pub struct Node {
    int  kind;
    int  a;
    int  b;
    int  c;
    int  d;
    int  next;
    int  aux;
    int  line;
    long num;
    /* A GNU `__attribute__((…))` on this declaration: -1 when it carried none,
       otherwise the offset of its captured spelling in the string pool (the
       emitter prints it at the declaration's trailing position). */
    int  attr;
    /* S1a-0 C2n-2: the four text rows are pointers into `runtime::text::Intern`,
       not fixed `char[160]` arrays. A text is allocated once, deduplicated by
       content and never moved, so a write is a pointer assignment and a row
       copy is a pointer copy: no `strncpy`, no `sizeof` and no truncation at
       the old 160-byte cap. `alloc` starts each row on the interned empty
       string. */
    const char *text;
    const char *text2;
    const char *text3;
    /* Phase 53: the receiver type of an optional-chain node, kept beside the
       result type so the emitter can declare its `__ct_optN` temporary. */
    const char *text4;
    /* PH-80 SH-102: the ownership facts the parser learned about a declaration,
       assignment or return that feeds an owning `String` / `U16String` handle.
       Bit 1 (2) = the value comes from a borrowed view, so a binding must not
       claim a reference. The emitter's automatic retain/release reads it; the
       node kinds that carry no such meaning leave it zero. */
    int  sflags;
}

pub trait ArenaOps {
    int  alloc(int kind, int line);
    int  str_begin(void);
    int  str_put(int c);
    void str_end(void);
    const char *str_at(int off);
    void reset(void);
}

/* LANG-26 / D-020 §6.1: one `out` actual whose formal type and actual type
   convert to each other. The parser records the two explicit conversion calls
   and the write-back assignment here; the emitter splices them around the call
   as one GNU statement expression, so the temporary lives exactly across the
   call and no parser/AST shape change is needed. `ret` empty means the callee
   returns void. */
pub struct OutConv {
    int  call;       /* the N_CALL / N_MCALL node carrying the actual */
    int  actual;     /* the caller's place (conversion receiver, write target) */
    int  temp;       /* the `Formal temp` N_VAR between the two conversions */
    int  fwd;        /* actual -> formal conversion call */
    int  writeback;  /* `actual = temp -> actual` assignment node */
    /* S1a-0 C2n-2: these two spellings are per-unit text, so they live in the
       intern pool like the node rows (the old `char[160]` rows could cut a
       long formal type). */
    const char *formal;/* C spelling of the formal's base type */
    const char *ret;   /* C spelling of the callee's result ('void' or empty) */
}
pub struct Arena {
    /* The two pools are calloc'd on first use (SH-42): as inline arrays in a
       file-scope `static` instance they put ~69 MB of zeroes into __DATA and
       shipped an 88 MB compiler. The lengths stay literal -- the generated
       header carries no macros -- and `alloc` / `str_put` still bound against
       MAX_NODES / 262144, so the capacity semantics are unchanged. */
    struct Node *nodes;
    int  nnode;
    int  nodecap;
    char *strpool;
    int  nstrpool;
    /* LANG-26: at most 32 converted `out` actuals per unit; a call with more is
       a hard error rather than a silent drop. */
    struct OutConv outconv[32];
    int  noutconv;
} use ArenaOps;

pub struct Arena *arena_get(void);

/* Lazily give the pools their backing store. calloc keeps the zero-filled
   semantics the static arrays had; a failure is reported as -1 (nodes) or a
   skipped byte (strings) so the caller's existing diagnostics still fire. */
static int arena_grow_nodes(struct Arena *self)
{
    int cap;
    struct Node *grown;

    if (self->nodes && self->nnode < self->nodecap) return 0;
    if (self->nodecap > 0) {
        cap = self->nodecap * 2;
    } else {
        const char *e = getenv("CT_ARENA_INIT");
        cap = e && atoi(e) > 0 ? atoi(e) : MAX_NODES;
    }
    if (cap < 8) cap = 8;
    if (cap > NODE_LIMIT) {
        if (self->nodecap >= NODE_LIMIT) return -1;
        cap = NODE_LIMIT;
    }
    grown = (struct Node *)realloc(self->nodes, (size_t)cap * sizeof(*self->nodes));
    if (!grown) return -1;
    /* calloc used to zero every slot; realloc only preserves the old ones. */
    memset((char *)grown + (size_t)self->nodecap * sizeof(*self->nodes), 0,
           (size_t)(cap - self->nodecap) * sizeof(*self->nodes));
    self->nodes = grown;
    self->nodecap = cap;
    return 0;
}

static int arena_grow_strpool(struct Arena *self)
{
    if (self->strpool) return 0;
    self->strpool = calloc(262144, 1);
    return self->strpool ? 0 : -1;
}

impl ArenaOps for Arena {
    /* A fresh node with every child slot cleared and every text row on the
       interned empty string. The rows are pointers now: `text3` used to be
       left uninitialised (the parser wrote it before the emitter read it), but
       a pointer that a `!row` check reads must never be indeterminate, so all
       four start empty. A NULL from `ct_intern` is the explicit OOM: roll the
       slot back and report -1 so the caller's existing diagnostic fires. */
    int alloc(int kind, int line)
    {
        int n;
        const char *empty;
        if (self->nnode >= NODE_LIMIT) return -1;
        if (arena_grow_nodes(self) != 0) return -1;
        n = self->nnode;
        empty = runtime::text::ct_intern("");
        if (!empty) return -1;
        self->nnode++;
        self->nodes[n].kind = kind;
        self->nodes[n].a = -1;
        self->nodes[n].b = -1;
        self->nodes[n].c = -1;
        self->nodes[n].d = -1;
        self->nodes[n].next = -1;
        self->nodes[n].aux = 0;
        self->nodes[n].line = line;
        self->nodes[n].num = 0;
        self->nodes[n].attr = -1;
        self->nodes[n].text = empty;
        self->nodes[n].text2 = empty;
        self->nodes[n].text3 = empty;
        self->nodes[n].text4 = empty;
        return n;
    }

    /* Literals are copied into a pool, not kept in `Node.text`: adjacent
       literals join into one C string and easily exceed the 160-byte field.
       `str_begin` marks the literal's start, `str_put` appends a byte and
       `str_end` terminates it, keeping the NUL for good. */
    int str_begin(void)
    {
        return self->nstrpool;
    }

    int str_put(int c)
    {
        if (self->nstrpool + 2 >= 262144) return -1;   /* room for this byte and the NUL */
        if (arena_grow_strpool(self) != 0) return -1;
        self->strpool[self->nstrpool] = (char)c;
        self->nstrpool++;
        return 0;
    }

    void str_end(void)
    {
        if (arena_grow_strpool(self) != 0) return;
        self->strpool[self->nstrpool] = 0;
        self->nstrpool++;
    }

    const char *str_at(int off)
    {
        if (!self->strpool) return "";
        return self->strpool + off;
    }

    /* Drop the nodes a previous unit used. The literal pool is *not* wound back:
       old nodes keep their offsets, and new literals simply append after them,
       which is what the compiler did when the pool was a file-scope array. */
    void reset(void)
    {
        self->nnode = 0;
        self->noutconv = 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. It starts all-zero
   and grows its pools on first use. */
static struct Arena g_arena;

struct Arena *arena_get(void)
{
    return &g_arena;
}
