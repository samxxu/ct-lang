/*
 * driver.ct - the compile-mode driver, one unit of its own.
 *
 * `ct <file> -o <file>` (compile mode): the CLI loop, the one-shot run setup
 * (reset the pools and the tables, point the source path, lex and parse) and
 * the output side (open the sink, write the banner, drive the emitter, write
 * the header and the map). It holds the output sink and the collaborators of
 * one run, so those are real methods on an object rather than free functions
 * over file-scope globals. The build-mode entry (`build_main`) lives with the
 * module object; `main` dispatches to this unit for compile mode.
 *
 * The instance is private to this unit: a generated header carries no
 * #include, so neither the FILE * nor the trait may appear in its surface.
 * `main` reaches it through the `pub` primitives at the end of the file.
 *
 * Macros do not cross a unit boundary, so the caps used here are declared here;
 * MAX_PATH 1024 is also the path length `frontend/module/Module.h.ct` and the
 * emitter spell.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import backend::emit::Emit;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Module;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import runtime::arena::Arena;
import tool::diag::diag;

#define MAX_PATH 1024

namespace tool::driver;
/* The compile-mode entry and the plumbing `main` cannot see through the trait. */
trait DriverOps {
    int  fail(const char *msg);
    int  default_output(const char *in, char *out, size_t cap);
    int  run(int argc, char **argv);
}

/* Output state for one run (the C sink) plus the collaborators the compile path
   threads through. The build-mode tables and the run options stay on the module
   object; this unit only points at it. The version is bound by the driver so the
   banner and `-v` do not restate the macro. */
struct Driver {
    FILE *out;
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct Module *m;
    struct Memory *mem;
    struct Parser *p;
    const char *version;
} use DriverOps;

impl DriverOps for Driver {
    /* The token cursor and the error store live in frontend::parse; the driver
       forwards so the store stays single. */
    int fail(const char *msg)
    {
        (void)self;
        return frontend::parse::ct_parse_fail(msg);
    }

    int default_output(const char *in, char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0) {
            if (snprintf(out, cap, "%.*s.c", (int)(n - 3), in) >= (int)cap) return -1;
            return 0;
        }
        if (snprintf(out, cap, "%s.c", in) >= (int)cap) return -1;
        return 0;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        const char *out;
        char outbuf[MAX_PATH];
        int i, prog;
        FILE *f;

        in = NULL;
        out = NULL;
        if (argc > 1 && strcmp(argv[1], "build") == 0)
            return self->m->build_main(argc - 1, argv + 1);
        self->m->build_mode = 0;
        self->m->line_mode = 0;
        self->m->line_force = -1;
        self->m->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s <input.ct> [-o <output.c>] [-I <dir>] [--line|--no-line]\n"
                       "              [--emit-map <file|->] [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--std=c99|gnu99]\n"
                       "       %s get <spec>[@<range>]\n"
                       "       %s install\n",
                       self->m->prog, self->m->prog, self->m->prog, self->m->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->m->prog, self->version);
                return 0;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->m->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->m->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->m->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->m->std_flag = "-std=gnu99";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                i++;   /* accepted for CLI parity; compile mode resolves no imports */
                continue;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->m->line_mode = 1;
                self->m->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->m->line_mode = 0;
                self->m->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->m->map_path, sizeof self->m->map_path, "%s", argv[i]) >= (int)sizeof self->m->map_path) {
                    fprintf(stderr, "ctc: map path is too long\n");
                    return 1;
                }
                self->m->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: %s <input.ct> [-o <output.c>]\n", self->m->prog);
            return 1;
        }
        if (!out) {
            if (self->default_output(in, outbuf, sizeof outbuf) != 0) {
                fprintf(stderr, "ctc: output path too long\n");
                return 1;
            }
            out = outbuf;
        }

        self->m->path = in;
        self->mem->path = self->m->path;
        backend::emit::ct_emit_set_path(self->m->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        tool::diag::ct_diag_reset();
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->ntb = 0;
        self->sym->self_mode = 0;
        self->p->nparams = 0;
        self->p->ncalls = 0;
        self->p->cur_func[0] = 0;
        frontend::parse::ct_parse_clear_error();
        if (self->m->read_file(in) != 0) {
            return frontend::parse::ct_parse_report();
        }
        prog = frontend::parse::ct_parse_program();
        if (prog < 0) {
            if (tool::diag::ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                return 1;
            }
            return frontend::parse::ct_parse_report();
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        self->out = f;
        backend::emit::ct_emit_set_out(self->out);
        fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                self->version, self->m->path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              self->out);
        if (self->m->line_mode) fprintf(self->out, "#line 1 \"%s\"\n", self->m->path);
        if (self->m->emit_program(prog) != 0) {
            fclose(f);
            /* the file was opened before emission, so a failure in the middle of
               it would leave a truncated `.c` that looks like a real artefact */
            remove(out);
            return frontend::parse::ct_parse_report();
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ctc: cannot write '%s'\n", out);
            return 1;
        }
        if (self->m->write_header(out) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (self->m->have_map && self->m->write_map(self->m->map_path, prog, -1) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (tool::diag::ct_diag_emit(self->m->diag_json, 0) != 0) return 1;
        return 0;
    }
}

static struct Driver g_driver;

/* Only primitives cross the unit boundary. Every pointer to another unit's type
   goes in as `void *` and is cast here, because a generated header carries no
   #include and a prototype that named `struct Symbols *` would
   scope a fresh, incompatible type. */
pub void ct_driver_bind(void *arena, void *lex, void *sym, void *mem, void *m, void *p, const char *version);
void ct_driver_bind(void *arena, void *lex, void *sym, void *mem, void *m, void *p, const char *version)
{
    g_driver.arena = (struct Arena *)arena;
    g_driver.lex = (struct Lexer *)lex;
    g_driver.sym = (struct Symbols *)sym;
    g_driver.mem = (struct Memory *)mem;
    g_driver.m = (struct Module *)m;
    g_driver.p = (struct Parser *)p;
    g_driver.version = version;
}

pub int ct_driver_run(int argc, char **argv);
int ct_driver_run(int argc, char **argv)
{
    return g_driver.run(argc, argv);
}
