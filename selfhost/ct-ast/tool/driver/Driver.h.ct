/*
 * Driver.h.ct - the compile-mode driver, one unit of its own.
 *
 * `ct <file> -o <file>` (compile mode): the CLI loop, the one-shot run setup
 * (reset the pools and the tables, point the source path, lex and parse) and
 * the output side (open the sink, write the banner, drive the emitter, write
 * the header and the map). It holds the output sink and the collaborators of
 * one run, so those are real methods on an object rather than free functions
 * over file-scope globals. The build-mode entry (`build_main`) lives with the
 * module object; `main` dispatches to this unit for compile mode.
 *
 * The instance is private to this unit: a generated header carries no
 * #include, so neither the FILE * nor the trait may appear in its surface.
 * `main` reaches it through the `pub` primitives at the end of the file.
 *
 * Macros do not cross a unit boundary, so the caps used here are declared here.
 * S1a-0 C2l: the compile-mode default output path and the `-I` root handed to
 * `ct check` are run-scoped blocks (tool/sh), not `char[MAX_PATH]` arrays.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
import frontend::module::ModuleBoundary;

import backend::emit::Emitter;
import backend::tir::TBuilder;
import backend::lir::Lower;
import backend::mem::Memory;
import frontend::lex::Lexer;
import frontend::module::Module;
import frontend::parse::Parser;
import frontend::sym::Symbols;
import runtime::arena::Arena;
import runtime::arena::Arena::Node as Node;
import tool::diag::Diag;
import tool::pkg::Pkg;
import tool::sh::Sh;
import frontend::module::ModuleBoundary;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_FLAGS 1024                  /* mirrors Module.h.ct's --cflags cap */

namespace tool::driver;
/* The compile-mode entry and the plumbing `main` cannot see through the trait. */
trait DriverOps {
    int  fail(const char *msg);
    int  default_output(const char *in, char **out);
    /* Phase 29: parse the built-in `Vec` / `Map` unit before the input and
       return its program node, or -1 when the layer is not installed. */
    int  load_builtin(const char *in);
    int  run(int argc, char **argv);
}

/* Output state for one run (the C sink) plus the collaborators the compile path
   threads through. The build-mode tables and the run options stay on the module
   object; this unit only points at it. The version is bound by the driver so the
   banner and `-v` do not restate the macro. */
struct Driver {
    FILE *out;
    struct Arena *arena;
    struct Lexer *lex;
    struct Symbols *sym;
    struct Module *m;
    struct Memory *mem;
    struct Parser *p;
    const char *version;
} use DriverOps;

/* PH-66 R3: whole-identifier search over the input source. The layer is
   spliced per unit, so an unused unit must stay out of the product entirely
   (its prologue includes were what put <stdio.h> into an empty program). */
/* PH-69-R1: `ct check` routes import-bearing units through the build graph. */
/* S1b-S2b: the LIR body seam. The emitter owns a plain function-pointer field
   so it never depends on the lowerer; the driver binds it for the duration of
   one program. */
static int drv_lir_body(const char *name, void *out, int ind, int ntmp,
                        int *new_ntmp)
{
    return backend::lir::ct_lir_try_body(name, out, ind, ntmp, new_ntmp);
}

static int file_has_import(const char *path)
{
    FILE *f = fopen(path, "r");
    char line[1024];

    if (!f) return 0;
    while (fgets(line, sizeof line, f)) {
        char *p = line;
        while (*p == ' ' || *p == '\t') p++;
        if (strncmp(p, "import ", 7) == 0 || strncmp(p, "import::", 8) == 0) {
            fclose(f);
            return 1;
        }
    }
    fclose(f);
    return 0;
}

static int src_has_word(const char *s, const char *w)
{
    size_t wn = strlen(w);
    const char *p = s;

    while (*p) {
        const char *q;
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) {
            p++;
            continue;
        }
        q = p;
        while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
               || (*q >= '0' && *q <= '9') || *q == '_') q++;
        if ((size_t)(q - p) == wn && strncmp(p, w, wn) == 0) return 1;
        p = q;
    }
    return 0;
}

/* Does the source use any identifier with this prefix (`str_`)? */
static int src_has_prefix(const char *s, const char *pre)
{
    size_t pn = strlen(pre);
    const char *p = s;

    while (*p) {
        const char *q;
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) {
            p++;
            continue;
        }
        q = p;
        while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
               || (*q >= '0' && *q <= '9') || *q == '_') q++;
        if ((size_t)(q - p) >= pn && strncmp(p, pre, pn) == 0) return 1;
        p = q;
    }
    return 0;
}

/* PH-81: the built-in layer must load for `Box<T>` (or its deprecated `box<T>` alias) / `new T { ... }`, but a
   comment or a string that merely contains the word must not pull it in (that
   changed the `--emit-c` bytes of module fixtures whose prose says "a new X").
   This scan skips comments and literals and requires `new` to be followed by a
   type name or a brace. */
static int src_has_new_expr(const char *s)
{
    const char *p = s;

    while (*p) {
        if (p[0] == '/' && p[1] == '/') {
            while (*p && *p != '\n') p++;
            continue;
        }
        if (p[0] == '/' && p[1] == '*') {
            p += 2;
            while (*p && !(p[0] == '*' && p[1] == '/')) p++;
            if (*p) p += 2;
            continue;
        }
        if (*p == '"' || *p == '\'') {
            char q = *p;
            p++;
            while (*p && *p != q) {
                if (*p == '\\' && p[1]) p++;
                p++;
            }
            if (*p) p++;
            continue;
        }
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) {
            p++;
            continue;
        }
        {
            const char *q = p;
            while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                   || (*q >= '0' && *q <= '9') || *q == '_') q++;
            if ((size_t)(q - p) == 3 && strncmp(p, "new", 3) == 0) {
                const char *t = q;
                while (*t == ' ' || *t == '\t') t++;
                if ((*t >= 'a' && *t <= 'z') || (*t >= 'A' && *t <= 'Z')
                    || *t == '_' || *t == '{')
                    return 1;
            }
            p = q;
        }
    }
    return 0;
}

/* PH-66 R3: decide BEFORE parsing. Parsing an unused unit would leave its
   symbols in the tables, and the emitter would then declare (never define)
   things like `Str_Drop_drop` -- a `-Wunused-function` warning on GCC. */
/* PH-81 / LANG-24: `Box<T>` (or the deprecated `box<T>` alias) in code -- not
   a comment/string, and not a variable merely named Box/box. */
static int src_has_Box_type(const char *s)
{
    const char *p = s;

    while (*p) {
        if (p[0] == '/' && p[1] == '/') { while (*p && *p != '\n') p++; continue; }
        if (p[0] == '/' && p[1] == '*') {
            p += 2;
            while (*p && !(p[0] == '*' && p[1] == '/')) p++;
            if (*p) p += 2;
            continue;
        }
        if (*p == '"' || *p == '\'') {
            char q = *p;
            p++;
            while (*p && *p != q) { if (*p == '\\' && p[1]) p++; p++; }
            if (*p) p++;
            continue;
        }
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) { p++; continue; }
        {
            const char *q = p;
            while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                   || (*q >= '0' && *q <= '9') || *q == '_') q++;
            if ((size_t)(q - p) == 3
                && (strncmp(p, "Box", 3) == 0 || strncmp(p, "box", 3) == 0)) {
                const char *t = q;
                while (*t == ' ' || *t == '\t') t++;
                if (*t == '<') return 1;
            }
            p = q;
        }
    }
    return 0;
}

/* LANG-24: a source that declares its own `struct Box` keeps that type; the
   built-in layer is not spliced, so the historical phase 29/33/36 fixtures
   (and any project that already owns the name) keep compiling. `Box` is still
   auto-loaded for every program that does not declare it. */
static int src_declares_Box(const char *s)
{
    const char *p = s;
    int after_tag = 0;

    while (*p) {
        if (p[0] == '/' && p[1] == '/') { while (*p && *p != '\n') p++; continue; }
        if (p[0] == '/' && p[1] == '*') {
            p += 2;
            while (*p && !(p[0] == '*' && p[1] == '/')) p++;
            if (*p) p += 2;
            continue;
        }
        if (*p == '"' || *p == '\'') {
            char q = *p;
            p++;
            while (*p && *p != q) { if (*p == '\\' && p[1]) p++; p++; }
            if (*p) p++;
            continue;
        }
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')
              || (*p >= '0' && *p <= '9') || *p == '_')) {
            if (*p != ' ' && *p != '\t' && *p != '\n' && *p != '\r')
                after_tag = 0;
            p++;
            continue;
        }
        {
            const char *q = p;
            while ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z')
                   || (*q >= '0' && *q <= '9') || *q == '_') q++;
            if ((size_t)(q - p) == 6 && strncmp(p, "struct", 6) == 0) {
                after_tag = 1;
            } else if ((size_t)(q - p) == 5 && strncmp(p, "union", 5) == 0) {
                after_tag = 1;
            } else if ((size_t)(q - p) == 4 && strncmp(p, "enum", 4) == 0) {
                after_tag = 1;
            } else {
                if (after_tag && (size_t)(q - p) == 3
                    && strncmp(p, "Box", 3) == 0)
                    return 1;
                after_tag = 0;
            }
            p = q;
        }
    }
    return 0;
}

static int layer_wanted(const char *src, int bi)
{
    if (src == 0) return 1;
    if (bi == 0)
        /* PH-80 (D-013): the string layer needs `Vec` for `split`, so the
           container unit is spliced whenever either string half is. */
        return src_has_word(src, "Vec") || src_has_word(src, "Map")
            || src_has_word(src, "Str") || src_has_word(src, "String")
            || src_has_word(src, "U16String") || src_has_word(src, "U16Str")
            || src_has_prefix(src, "str_") || src_has_prefix(src, "u16_");
    if (bi == 1) return src_has_word(src, "Option");
    if (bi == 2) return src_has_word(src, "Result");
    if (bi == 3 || bi == 4)
        /* SH-120: `Str.h.ct` and `String.h.ct` are a pair -- String extends
           Str and owns every allocating helper, so either name (or a `str_`
           call) splices both; the UTF-16 half also needs them. */
        return src_has_word(src, "Str") || src_has_word(src, "String")
            || src_has_word(src, "U16String") || src_has_word(src, "U16Str")
            || src_has_prefix(src, "str_") || src_has_prefix(src, "u16_");
    if (bi == 5 || bi == 6)
        /* SH-120: only a program that names the UTF-16 pair (or calls a
           `u16_` layer function) splices the UTF-16 units. */
        return src_has_word(src, "U16String") || src_has_word(src, "U16Str")
            || src_has_prefix(src, "u16_");
    /* PH-81: the Box template has its own unit, so programs that never name a
       Box are byte-identical to the pre-S1 output. */
    return !src_declares_Box(src)
        && (src_has_Box_type(src) || src_has_new_expr(src));
}

/* DOC-87 Stage 1: compile mode asks `Module::find_builtin` for the layer file,
   so both modes share one five-step lookup, one hard-error rule and one set of
   compatibility warnings. Keeping the probe in one unit also keeps the
   self-hosted compiler's 512-function budget intact. */

impl DriverOps for Driver {
    /* The token cursor and the error store live in frontend::parse; the driver
       forwards so the store stays single. */
    int fail(const char *msg)
    {
        (void)self;
        return frontend::parse::ct_parse_fail(msg);
    }

    int default_output(const char *in, char **out)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0)
            *out = tool::sh::ct_scratch_fmt("%.*s.c", (int)(n - 3), in);
        else
            *out = tool::sh::ct_scratch_fmt("%s.c", in);
        return 0;
    }

    /* Phase 29: `Vec`, `Map` and `MapEntry` are always in scope -- no import
       and no `-I`. The layer is one ordinary `.h.ct` unit; it is parsed before
       the input so its templates are in the table when the input names them,
       and its top-level nodes are spliced in front of the input's, so compile
       mode still emits one C translation unit. An installation without the
       layer is not an error: programs that never touch a container compile
       exactly as before. */
    int load_builtin(const char *in)
    {
        char *cand;
        const char *savepath;
        int bi, prog, head, rr;
        char *insrc = 0;

        /* SH-90: `--freestanding` means no implicit layer. Splicing it anyway
           put `<stdio.h>` and the `Str` unit's `malloc` calls into a product
           that must link under `-nostdlib`; build mode already prunes, so the
           two modes disagreed. */
        if (self->m->freestanding) return -1;
        head = -1;
        {
            FILE *fi = fopen(in, "r");
            if (fi) {
                long sz;
                if (fseek(fi, 0, SEEK_END) == 0) {
                    sz = ftell(fi);
                    if (sz > 0 && sz < (long)(4 << 20)) {
                        insrc = (char *)malloc((size_t)sz + 1);
                        if (insrc) {
                            size_t rd;
                            rewind(fi);
                            rd = fread(insrc, 1, (size_t)sz, fi);
                            insrc[rd] = 0;
                        }
                    }
                }
                fclose(fi);
            }
        }
        /* P34 S9a: the layer spans `Vec.h.ct`, `Option.h.ct` and
           `Result.h.ct`; P36 S4a1 adds `Str.h.ct`; SH-120 adds the split
           `String.h.ct`, `utf16/U16Str.h.ct` and `utf16/U16String.h.ct`
           (eight slots). Compile mode is one C translation unit, so the
           parsed declaration chains are spliced into one program. DOC-87
           Stage 1: the file is located by the module layer, which owns
           `lib/core` / `CT_CORE_DIR` and the fallbacks. */
        for (bi = 0; bi < 8; bi++) {
            const char *base;
            base = bi == 0 ? "Vec.h.ct"
                 : (bi == 1 ? "Option.h.ct"
                 : (bi == 2 ? "Result.h.ct"
                 : (bi == 3 ? "Str.h.ct"
                 : (bi == 4 ? "String.h.ct"
                 : (bi == 5 ? "utf16/U16Str.h.ct"
                 : (bi == 6 ? "utf16/U16String.h.ct" : "Box.h.ct"))))));
            if (insrc && !layer_wanted(insrc, bi)) continue;
            prog = -1;
            rr = self->m->find_builtin(in, base, &cand);
            if (rr == -2) return -2;
            if (rr == 0) {
                savepath = self->m->path;
                self->m->path = cand;
                self->mem->path = cand;
                self->sym->path = cand;
                if (self->m->read_file(cand) != 0) {
                    self->m->path = savepath;
                    self->mem->path = savepath;
                    self->sym->path = savepath;
                    return -1;
                }
                self->lex->pos = 0;
                self->lex->bol = 1;
                self->lex->line = 1;
                self->lex->tokline = 1;
                self->lex->lstart = 0;
                self->lex->tokstart = 0;
                self->p->unit_is_hdr = 1;
                self->p->unit_is_map = 0;
                prog = frontend::parse::ct_parse_program();
                self->m->path = savepath;
                self->mem->path = savepath;
                self->sym->path = savepath;
                if (prog < 0) {
                    fprintf(stderr, "ctc: the built-in layer failed to parse: %s\n", cand);
                    frontend::parse::ct_parse_report();
                    return -1;
                }
            }
            if (prog < 0) continue;
            if (head < 0) {
                head = prog;
            } else {
                int last = self->arena->nodes[head].a;
                if (last < 0) {
                    self->arena->nodes[head].a = self->arena->nodes[prog].a;
                } else {
                    while (self->arena->nodes[last].next > 0)
                        last = self->arena->nodes[last].next;
                    self->arena->nodes[last].next = self->arena->nodes[prog].a;
                }
            }
        }
        if (insrc) free(insrc);
        return head;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        char *out;
        int i, prog, stdprog, io_from;
        FILE *f;

        in = NULL;
        out = NULL;
        self->m->check_mode = 0;
        self->p->types_mode = 0;
        /* SH-115 + v1-PH-1 S3: `ct build` defaults to `--check-level=error`;
           `ct check` keeps its own opt-in (`--types`). The build branch below
           sets the default before it parses the flag, so `--check-level=off`
           remains the silent escape hatch and restores the pre-SH-115 build. */
        self->m->types_level = 0;
        /* Phase 32: `--types` is an opt-in gate on `ct check` only. The scan
           runs before the `build` dispatch so `ct build --types` names the
           rule instead of failing as an unknown option deeper in. */
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "--types") == 0) {
                if (!(argc > 1 && strcmp(argv[1], "check") == 0)) {
                    fprintf(stderr, "ctc: --types is only valid with 'ct check'\n");
                    return 1;
                }
                self->p->types_mode = 1;
                break;
            }
        }
        /* PH-85 S85d: `--check-level=off|warn|error` is a build-only flag; the
           B checker it wires into the build has no meaning for `check`
           (`--types` already makes every finding an error there). */
        for (i = 1; i < argc; i++) {
            if (strncmp(argv[i], "--check-level", 13) == 0) {
                if (!(argc > 1 && strcmp(argv[1], "build") == 0)) {
                    fprintf(stderr, "ctc: --check-level is only valid with 'ct build'\n");
                    return 1;
                }
            }
        }
        /* Phase 39: `--lib` is a build-only mode; reject it before the
           compile/check argument loop turns it into an unknown option. */
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "--lib") == 0) {
                if (!(argc > 1 && strcmp(argv[1], "build") == 0)) {
                    fprintf(stderr, "ctc: --lib is only valid with 'ct build'\n");
                    return 1;
                }
                break;
            }
        }
        if (argc > 1 && strcmp(argv[1], "build") == 0) {
            /* SH-115 + v1-PH-1 S3: the CLI default for the build path is
               `error`. The flag loop below overrides it for `off` / `warn` /
               `error`; `ct check` never enters this branch with its own
               inputs, so its opt-in `--types` behaviour is unchanged. */
            self->m->types_level = 2;
            /* S2: `build` reads ./ct.lock and the roots become explicit `-I`
               entries after the user's own flags. `--locked` is consumed here
               because `build_main` has no concept of strictness. */
            /* S1a-0 C1/C2k: the lock reader grows these by doubling (the old
               `char roots[16][512]` silently overflowed past 16 rows), and
               each root is its own exact-size string (no 512-byte stride). */
            char **roots;
            char **notes;
            char *bargv[256];
            int nroots, nnotes, rootcap, notecap, locked, bi, ai, want_help;
            roots = NULL;
            notes = NULL;
            nroots = 0;
            nnotes = 0;
            rootcap = 0;
            notecap = 0;
            locked = 0;
            want_help = 0;
            for (ai = 2; ai < argc; ai++) {
                if (strcmp(argv[ai], "--locked") == 0) locked = 1;
                if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0
                    || strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0)
                    want_help = 1;
            }
            /* help/version must not depend on the project's lock being valid */
            if (want_help) return self->m->build_main(argc - 1, argv + 1);
            if (tool::pkg::ct_pkg_lock_roots(self->version, locked,
                                              &roots, &nroots, &rootcap,
                                              &notes, &nnotes, &notecap) != 0)
                return 1;
            for (ai = 0; ai < nnotes; ai++)
                fprintf(stderr, "ctc: note: %s\n", notes[ai]);
            bi = 0;
            bargv[bi++] = "build";
            for (ai = 2; ai < argc; ai++) {
                if (strcmp(argv[ai], "--locked") == 0) continue;
                if (strncmp(argv[ai], "--check-level=", 14) == 0
                    || strcmp(argv[ai], "--check-level") == 0) {
                    const char *v;
                    int lv;
                    if (strcmp(argv[ai], "--check-level") == 0) {
                        if (ai + 1 >= argc) {
                            fprintf(stderr, "ctc: --check-level needs an argument\n");
                            return 1;
                        }
                        ai++;
                        v = argv[ai];
                    } else {
                        v = argv[ai] + 14;
                    }
                    if (strcmp(v, "off") == 0) lv = 0;
                    else if (strcmp(v, "warn") == 0) lv = 1;
                    else if (strcmp(v, "error") == 0) lv = 2;
                    else {
                        fprintf(stderr, "ctc: --check-level takes off, warn or error, not '%s'\n", v);
                        return 1;
                    }
                    self->m->types_level = lv;
                    continue;
                }
                if (bi >= 250) {
                    fprintf(stderr, "ctc: too many build arguments\n");
                    return 1;
                }
                bargv[bi++] = argv[ai];
            }
            for (ai = 0; ai < nroots; ai++) {
                if (bi >= 250) {
                    fprintf(stderr, "ctc: too many build arguments\n");
                    return 1;
                }
                bargv[bi++] = "-I";
                bargv[bi++] = roots[ai];
            }
            return self->m->build_main(bi, bargv);
        }
        /* `ct compile <file>` is the documented spelling, so the keyword is
           consumed here; otherwise the loop below would take it for the input.
           `ct check` (19.4) walks the same path and stops before emission:
           findings are errors (D19-4) and no `.c` is written. */
        if (argc > 1 && (strcmp(argv[1], "compile") == 0
                         || strcmp(argv[1], "check") == 0)) {
            if (strcmp(argv[1], "check") == 0) {
                int ai = 2;
                const char *inp = NULL;
                for (ai = 2; ai < argc; ai++)
                    if (strcmp(argv[ai], "--diag-codes") == 0) self->m->diag_codes = 1;
                ai = 2;
                self->m->check_mode = 1;
                tool::diag::ct_diag_set_strict(1);
                while (ai < argc && argv[ai][0] == '-') ai++;
                if (ai < argc) inp = argv[ai];
                if (inp && file_has_import(inp)) {
                    char *dir = (char *)0;
                    char *barg[10];
                    int bi = 0;
                    if (self->m->path_dir(inp, &dir) != 0) dir = (char *)0;
                    barg[bi++] = (char *)"build";
                    barg[bi++] = (char *)inp;
                    barg[bi++] = (char *)"--emit-c";
                    barg[bi++] = (char *)"-o";
                    barg[bi++] = (char *)"/tmp";
                    if (dir && dir[0]) {
                        barg[bi++] = (char *)"-I";
                        barg[bi++] = dir;
                    }
                    if (self->m->diag_codes) barg[bi++] = (char *)"--diag-codes";
                    barg[bi] = 0;
                    backend::emit::ct_emit_set_no_write(1);
                    {
                        int rc = self->m->build_main(bi, barg);
                        /* `ct check`: every finding is a failure, even when the
                           build path only counted it as a warning. */
                        if (rc == 0 && (tool::diag::ct_diag_nsem() > 0
                                        || tool::diag::ct_diag_nwarn() > 0))
                            return 1;
                        return rc;
                    }
                }
            }
            argv++;
            argc--;
        }
        self->m->build_mode = 0;
        self->m->line_mode = 0;
        self->m->line_force = -1;
        self->m->have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s <input.ct> [-o <output.c>] [--line|--no-line]\n"
                       "              [--emit-map <file|->] [--emit-model <file|->] [--diagnostics=text|json] [--diag-codes] [--std=c99|gnu99|c11]\n"
                       "       %s check <input.ct> [--types] [--diagnostics=text|json] [--diag-codes] [--std=c99|gnu99|c11]\n"
                       "       %s build <input.ct>... [-o <exe>] [-I <dir>] [--ns-root <dir>] [--locked]\n"
                       "                 [--emit-c] [--outdir <dir>] [--cc <path>]\n"
                       "                 [--cflags <s>] [--ldflags <s>]\n"
                       "                 [--line|--no-line] [--emit-map <file|->]\n"
                       "                 [--diagnostics=text|json] [--diag-codes] [--std=c99|gnu99|c11]\n"
                       "                 [--freestanding] [--alloc <m,f[,r,c]>] [--c-boundary=strict|allow]\n"
                       "                 [--show-io-headers]\n"
                       "       %s get <spec>[@<range>]\n"
                       "       %s install\n"
                       "       %s verify [--strict]\n"
                       "       %s migrate\n"
                       "       %s update\n"
                       "       %s pkg check <dir>\n",
                       self->m->prog, self->m->prog, self->m->prog, self->m->prog,
                       self->m->prog, self->m->prog, self->m->prog, self->m->prog,
                       self->m->prog);
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->m->prog, self->version);
                return 0;
            }
            if (strcmp(argv[i], "--diag-codes") == 0) {
                self->m->diag_codes = 1;
                continue;
            }
            if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
                const char *v = argv[i] + 14;
                if (strcmp(v, "json") == 0) {
                    self->m->diag_json = 1;
                    continue;
                }
                if (strcmp(v, "text") == 0) {
                    self->m->diag_json = 0;
                    continue;
                }
                fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
                return 1;
            }
            if (strncmp(argv[i], "--std=", 6) == 0) {
                const char *v = argv[i] + 6;
                if (strcmp(v, "c99") == 0) {
                    self->m->std_flag = "-std=c99";
                    continue;
                }
                if (strcmp(v, "gnu99") == 0) {
                    self->m->std_flag = "-std=gnu99";
                    continue;
                }
                if (strcmp(v, "c11") == 0) {
                    self->m->std_flag = "-std=c11";
                    continue;
                }
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--emit-c") == 0) {
                self->m->emit_c = 1;   /* compile mode already emits only C */
                continue;
            }
            /* S1b-S2: the LIR switch. `on` prints from LIR when the whole unit
               lowered; `shadow` only builds + verifies; `off` is the default. */
            if (strncmp(argv[i], "--ir=", 5) == 0) {
                const char *v = argv[i] + 5;
                if (strcmp(v, "on") == 0) {
                    backend::lir::ct_lir_set_switch(1);
                    continue;
                }
                if (strcmp(v, "off") == 0) {
                    backend::lir::ct_lir_set_switch(0);
                    continue;
                }
                if (strcmp(v, "shadow") == 0) {
                    backend::lir::ct_lir_set_switch(2);
                    continue;
                }
                fprintf(stderr, "ctc: unknown --ir value '%s' (on/off/shadow)\n", v);
                return 1;
            }
            /* PH-64: the bare-metal contract. --freestanding turns off the
               constructor and the implicit heap; --alloc names the target's
               allocator so heap-owning values stop pulling libc. */
            if (strcmp(argv[i], "--freestanding") == 0) {
                self->m->freestanding = 1;
                continue;
            }
            if (strcmp(argv[i], "--allow-c-boundary") == 0) {
                self->m->c_boundary = 0;
                continue;
            }
            if (strcmp(argv[i], "--show-c-boundary") == 0) {
                self->m->show_c_boundary = 1;
                continue;
            }
            if (strcmp(argv[i], "--show-io-headers") == 0) {
                self->m->show_io_headers = 1;
                continue;
            }
            if (strncmp(argv[i], "--c-boundary=", 13) == 0) {
                const char *v = argv[i] + 13;
                if (strcmp(v, "strict") == 0) {
                    self->m->c_boundary = 1;
                    continue;
                }
                if (strcmp(v, "allow") == 0) {
                    self->m->c_boundary = 0;
                    continue;
                }
                fprintf(stderr, "ctc: --c-boundary takes strict or allow, not '%s'\n", v);
                return 1;
            }
            if (strcmp(argv[i], "--alloc") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --alloc needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->m->alloc_map, sizeof self->m->alloc_map, "%s", argv[i])
                        >= (int)sizeof self->m->alloc_map) {
                    fprintf(stderr, "ctc: --alloc value is too long\n");
                    return 1;
                }
                continue;
            }
            /* Phase 32: consumed here so the pre-scan's gate is not an
               unknown option in the loop; the flag itself is already set. */
            if (strcmp(argv[i], "--types") == 0) {
                self->p->types_mode = 1;
                continue;
            }
            /* PH-70: flow/semantic findings share `ct check`; the flag is
               accepted here so `ct check --semantics` is a valid spelling. */
            if (strcmp(argv[i], "--semantics") == 0) {
                /* PH-70: 2 = check + flow/semantic findings; 1 = plain check. */
                self->m->check_mode = 2;
                continue;
            }
            if (strcmp(argv[i], "--outdir") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --outdir needs an argument\n");
                    return 1;
                }
                i++;
                self->m->outdir_opt = argv[i];
                continue;
            }
            if (strcmp(argv[i], "--cc") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --cc needs an argument\n");
                    return 1;
                }
                i++;
                self->m->cc = argv[i];
                continue;
            }
            if (strcmp(argv[i], "--cflags") == 0 || strcmp(argv[i], "--ldflags") == 0) {
                int is_cf = argv[i][2] == 'c';
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: %s needs an argument\n", argv[i]);
                    return 1;
                }
                i++;
                char **fp;
                int *fcap;
                if (is_cf) {
                    fp = &self->m->cflags;
                    fcap = &self->m->cflagscap;
                } else {
                    fp = &self->m->ldflags;
                    fcap = &self->m->ldflagscap;
                }
                if (frontend::module::ct_append_flags(fp, fcap, MAX_FLAGS, argv[i]) != 0) {
                    fprintf(stderr, "ctc: %s value is too long\n", is_cf ? "--cflags" : "--ldflags");
                    return 1;
                }
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -I needs an argument\n");
                    return 1;
                }
                /* Single-unit modes resolve no imports, so the flag cannot have
                   an effect; say so rather than dropping it silently (SH-54).
                   The exit code is unchanged: `-I` stays accepted for CLI
                   parity with `build`. */
                fprintf(stderr, "ctc: warning: -I is ignored by %s mode; "
                                "imports require 'ct build'\n",
                        self->m->check_mode ? "check" : "compile");
                i++;
                continue;
            }
            if (strcmp(argv[i], "--line") == 0) {
                self->m->line_mode = 1;
                self->m->line_force = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                self->m->line_mode = 0;
                self->m->line_force = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                self->m->map_path = tool::sh::ct_scratch_dup(argv[i]);
                self->m->have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "--emit-model") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --emit-model needs an argument\n");
                    return 1;
                }
                i++;
                self->m->model_path = tool::sh::ct_scratch_dup(argv[i]);
                self->m->have_model = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (in) {
                fprintf(stderr, "ctc: compile mode takes one input; '%s' is extra\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: %s <input.ct> [-o <output.c>]\n", self->m->prog);
            return 1;
        }
        /* compile mode resolves no imports, so a mapping unit has no consumer
           and no output; it is a `build`-only input. `ct check` (19.4) writes
           nothing by design, so a `.m.ct` unit is a perfectly good input there
           -- its declarations and default bodies are what gets checked. */
        if (!self->m->check_mode) {
            size_t pl = strlen(in);
            if (pl > 5 && strcmp(in + pl - 5, ".m.ct") == 0) {
                fprintf(stderr, "ctc: a .m.ct unit produces no output; import it from a .ct unit%s\n",
                        self->m->diag_codes ? " [E-DRIVER-003]" : "");
                return 1;
            }
        }
        /* `ct check` resolves no output path at all: it never opens a file, so
           asking for one could only fail on a path it does not need (SH-49). */
        if (!out && !self->m->check_mode) {
            if (self->default_output(in, &out) != 0) {
                fprintf(stderr, "ctc: out of memory\n");
                return 1;
            }
        }

        if (self->m->show_c_boundary) {
            printf("%s\n", self->m->c_boundary_for(in) ? "strict" : "allow");
            return 0;
        }
        self->m->path = in;
        /* LANG-10 7b: a parse failure follows the chosen diagnostics channel
           (compile/check -> stdout). Set before any lexer/parser call. */
        frontend::parse::ct_parse_set_json(self->m->diag_json, 0, self->m->diag_codes);
        tool::diag::ct_diag_set_codes(self->m->diag_codes);
        self->mem->path = self->m->path;
        self->sym->path = self->mem->path;
        backend::emit::ct_emit_set_path(self->m->path);
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        tool::diag::ct_diag_reset();
        /* PH-82: `ct compile`/`ct check` ignore `-I`, so the policy resolves
           from the input's own package directory here. */
        tool::diag::ct_diag_set_leaks_error(self->m->leaks_for(in));
        self->arena->reset();
        self->sym->nfunc = 0;
        self->sym->nvar = 0;
        self->sym->nscope = 0;
        self->mem->nowner = 0;
        self->mem->leak_active = 0;
        self->mem->leak_frame = -1;
        self->mem->leak_impl = 0;
        self->mem->ret_owned = 0;
        self->sym->ntype = 0;
        self->sym->ntraits = 0;
        self->sym->nstructs = 0;
        self->sym->nstruct_inst = 0;
        self->sym->ntb = 0;
        self->sym->nalias = 0;
        self->sym->ntalias = 0;
        self->sym->ntachain = 0;
        self->sym->alias_decl = 0;
        self->sym->self_mode = 0;
        self->p->nparams = 0;
        self->p->ncalls = 0;
        self->p->cur_func = "";
        /* Phase 29: the built-in container layer is parsed first so `Vec` /
           `Map` need neither an import nor an `-I`; its nodes are spliced in
           front of the input's below. A missing layer is not an error. */
        stdprog = self->load_builtin(in);
        /* DOC-87 Stage 1: a CT_CORE_DIR that names a missing directory is a
           hard error, never a silent fallback to the working tree. */
        if (stdprog == -2) {
            frontend::parse::ct_parse_report();
            return 1;
        }
        /* P36 S4a2: the built-in layer's functions do not count against the
           user program's `MAX_FUNCS` budget. */
        self->sym->nfunc_base = self->sym->nfunc;
        /* PH-66 R3: calls recorded from here on belong to the product (the
           layer may be parsed but not spliced). */
        io_from = self->m->io_call_count();
        /* L29-W1: a project-local `vendor/std` is never read; the built-in
           layer wins, but the shadowing is not silent. */
        if (stdprog >= 0) {
            FILE *vs = fopen("vendor/std", "r");
            if (vs) {
                fclose(vs);
                if (tool::diag::ct_std_shadow_warn(1, 1,
                        "the built-in Vec/Map supersede a project-local 'vendor/std' (ignored)",
                        "vendor/std") != 0)
                    return self->fail("too many warnings");
            }
        }
        /* The layer opens a namespace; the input starts at the root again. */
        self->sym->ns = "";
        self->p->ns_decl = "";
        /* A `.m.ct` input is a mapping unit even when it is fed to `ct check`,
           which skips the build path that normally marks it. */
        {
            size_t pl = strlen(in);
            self->p->unit_is_map = (pl > 5 && strcmp(in + pl - 5, ".m.ct") == 0) ? 1 : 0;
            self->p->unit_is_hdr = (pl > 5 && strcmp(in + pl - 5, ".h.ct") == 0) ? 1 : 0;
            self->p->c_strict = (!self->p->unit_is_map
                                 && self->m->c_boundary_for(in)) ? 1 : 0;
            {
                /* S1a-0 C2p-6: the base name is a pool text; the old 160-byte
                   row cut nothing observable for a normal path but was the
                   last fixed row on this route. */
                const char *b = in;
                const char *r;
                int L;
                for (r = in; *r != 0; r++) if (*r == '/') b = r + 1;
                L = (int)strlen(b);
                if (L > 5 && strcmp(b + L - 5, ".h.ct") == 0) L -= 5;
                else if (L > 3 && strcmp(b + L - 3, ".ct") == 0) L -= 3;
                self->p->c_base = runtime::text::ct_intern_len(b, L);
                if (!self->p->c_base) return self->fail("out of memory");
            }
        }
        frontend::parse::ct_parse_clear_error();
        /* The built-in layer left the cursor at its own EOF; the input starts
           from byte zero again. */
        self->lex->pos = 0;
        self->lex->bol = 1;
        self->lex->line = 1;
        self->lex->tokline = 1;
        self->lex->lstart = 0;
        self->lex->tokstart = 0;
        if (self->m->read_file(in) != 0) {
            return frontend::parse::ct_parse_report();
        }
        /* The build path pre-scans top-level aliases before parsing; compile
           mode has one unit and needs the same table so a use before the
           declaration is reported instead of becoming an opaque C type. */
        if (self->m->scan_forward_type_aliases(in, self->p->cur_unit) != 0)
            return frontend::parse::ct_parse_report();
        {
            prog = frontend::parse::ct_parse_program();
            if (prog >= 0 && self->m->freestanding) {
                const char *iofn = self->m->io_first_name(io_from);
                /* Let the heap diagnostic win when the program also uses the
                   allocator: "pass --alloc" is the first thing to fix there. */
                const char *src = self->lex->src;
                if (src && (src_has_word(src, "malloc") || src_has_word(src, "calloc")
                            || src_has_word(src, "realloc")))
                    iofn = "";
                if (iofn[0]) {
                    fprintf(stderr, "%s:%d: error: '%s' is not declared in a freestanding"
                            " build; provide it through a shim\n",
                            in, self->m->io_first_line(io_from), iofn);
                    return 1;
                }
            }
            if (prog >= 0 && self->m->show_io_headers) {
                int mask = self->m->io_header_mask_tail(io_from);
                if (mask & 1) printf("stdio.h\n");
                if (mask & 2) printf("wchar.h\n");
                return 0;
            }
        }
        if (prog < 0) {
            if (tool::diag::ct_diag_nsem()) {
                fprintf(stderr, "ctc: %d error(s) generated\n", tool::diag::ct_diag_nsem());
                return 1;
            }
            return frontend::parse::ct_parse_report();
        }
        /* Splice the layer's declaration nodes in front of the input's: one
           program, one C translation unit, one set of emitted container
           instances (D29-3). */
        if (stdprog >= 0) {
            int last;
            last = self->arena->nodes[stdprog].a;
            if (last > 0) {
                while (self->arena->nodes[last].next > 0)
                    last = self->arena->nodes[last].next;
                self->arena->nodes[last].next = self->arena->nodes[prog].a;
                prog = stdprog;
            } else {
                prog = stdprog;
            }
        }
        /* PH-82: the direct-cycle warning runs over the unit's whole struct
           table before any artifact is opened; `leaks = error` then fails the
           run here, while the warn form leaves the records to the closing
           flush. */
        if (self->m->cycle_check() != 0)
            return frontend::parse::ct_parse_report();
        if (!self->m->check_mode && tool::diag::ct_diag_leaks_failed()) {
            tool::diag::ct_diag_emit(self->m->diag_json, 0);
            return 1;
        }
        /* `ct check` (19.4): the semantic findings are this entry's output and
           its exit code -- 1 when any was reported, 0 when clean. Nothing is
           emitted, so compile and build artifacts cannot change. */
        if (self->m->check_mode) {
            if (tool::diag::ct_diag_emit(self->m->diag_json, 0) != 0) return 1;
            if (tool::diag::ct_diag_nwarn() > 0) return 1;
            return 0;
        }
        /* S1b-S1: the TIR shadow (CT_TIR=1) is built and V1-V4 verified here,
           before the output file is opened; a failure leaves no `.c`.
           S1b-S2 builds TIR once through the LIR entry when the LIR switch is
           on (that path runs V1-V4 and then V5-V8 too). */
        if (backend::lir::ct_lir_on()) {
            if (backend::lir::ct_lir_build_program(prog, in, self->p->c_base, "",
                                                   self->p->unit_is_hdr,
                                                   self->p->unit_is_map) != 0)
                return 1;
        } else if (backend::tir::ct_tir_shadow_on()
                   && backend::tir::ct_tir_shadow_program(prog, in, self->p->c_base,
                                                          "", self->p->unit_is_hdr,
                                                          self->p->unit_is_map) != 0) {
            return 1;
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ctc: cannot write '%s'%s\n", out,
                    self->m->diag_codes ? " [E-DRIVER-004]" : "");
            return 1;
        }
        self->out = f;
        backend::emit::ct_emit_set_out(self->out);
        fprintf(self->out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                self->version, self->m->path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              self->out);
        {
            int mask = self->m->io_header_mask_tail(io_from);
            int adn = 0;
            if (self->m->freestanding) mask = 0;
            backend::emit::ct_emit_bind_io_mask(mask);
            if (mask & 1) fputs("#include <stdio.h>\n", self->out);
            if (mask & 2) fputs("#include <wchar.h>\n", self->out);
            /* Phase 84: an ADT layout carries offsetof-based assertions. */
            frontend::sym::ct_adts(&adn);
            if (adn > 0) fputs("#include <stddef.h>\n", self->out);
        }
        if (self->m->line_mode) fprintf(self->out, "#line 1 \"%s\"\n", self->m->path);
        /* S1b-S2b: the body seam. The program shell (banner, declarations,
           prototypes, generated glue) stays with the emitter; a function body
           the lowerer covered end to end is printed from LIR inside it. The
           switch can therefore only change the bytes of a body LIR owns, and
           `test/ir/run.sh` compares those bytes with the unswitched path. */
        if (backend::lir::ct_lir_on() && backend::lir::ct_lir_emit_on()
            && !self->m->line_mode && !self->m->have_map
            && !self->m->have_model && !self->m->abi_mode
            && !self->p->unit_is_hdr && !self->p->unit_is_map) {
            backend::emit::ct_emit_set_body_hook(drv_lir_body);
        }
        if (self->m->emit_program(prog) != 0) {
            fclose(f);
            /* the file was opened before emission, so a failure in the middle of
               it would leave a truncated `.c` that looks like a real artefact */
            remove(out);
            return frontend::parse::ct_parse_report();
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ctc: cannot write '%s'%s\n", out,
                    self->m->diag_codes ? " [E-DRIVER-004]" : "");
            return 1;
        }
        if (self->m->write_header(out) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (self->m->have_map && self->m->write_map(self->m->map_path, prog, -1) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (self->m->have_model && self->m->write_model(self->m->model_path, prog) != 0) {
            return frontend::parse::ct_parse_report();
        }
        if (tool::diag::ct_diag_emit(self->m->diag_json, 0) != 0) return 1;
        return 0;
    }
}

static struct Driver g_driver;

/* Only primitives cross the unit boundary. Every pointer to another unit's type
   goes in as `void *` and is cast here, because a generated header carries no
   #include and a prototype that named `struct Symbols *` would
   scope a fresh, incompatible type. */
pub void ct_driver_bind(void *arena, void *lex, void *sym, void *mem, void *m, void *p, const char *version);
void ct_driver_bind(void *arena, void *lex, void *sym, void *mem, void *m, void *p, const char *version)
{
    g_driver.arena = (struct Arena *)arena;
    g_driver.lex = (struct Lexer *)lex;
    g_driver.sym = (struct Symbols *)sym;
    g_driver.mem = (struct Memory *)mem;
    g_driver.m = (struct Module *)m;
    g_driver.p = (struct Parser *)p;
    g_driver.version = version;
}

pub int ct_driver_run(int argc, char **argv);
int ct_driver_run(int argc, char **argv)
{
    return g_driver.run(argc, argv);
}
