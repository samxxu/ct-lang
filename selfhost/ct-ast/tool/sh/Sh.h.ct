/*
 * Sh.h.ct - shell quoting and the one growable text builder, shared by the
 * units that compose command lines.
 *
 * Two units build command lines: the package manager (`ct get`'s git calls,
 * Phase 8) and the build driver (`ct build`'s cc invocation, Phase 17.6). Both
 * must escape a token the same way, so the rule lives here rather than twice --
 * a spec, a path or an executable name can never break out of its argument.
 *
 * S1a-0 C2e/C2f: `ct_text_*` is the `char **` + capacity builder both sides
 * use. It grows from a caller-chosen initial size (the old fixed cap) to the
 * formal `TEXT_LIMIT`, never truncates, and reports OOM explicitly. The caller
 * owns the block and frees it with `ct_text_free`.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */

/* Mirror of the formal text bound in frontend/sym/Limits.h.ct. */
#define TEXT_LIMIT 65536

#include "Sh.shim.h"
namespace tool::sh;
/* A stateless unit: the type exists only because a unit file is named after its
   main type. Nothing instantiates it. */
pub struct Sh {
    int unused;
}
/* Allocate `init` bytes and start empty. 0 ok, -1 OOM / over TEXT_LIMIT. */
pub int ct_text_init(char **buf, int *cap, int init);
/* Truncate to empty (allocating `init` bytes if the block is still unset). */
pub int ct_text_reset(char **buf, int *cap, int init);
/* Append `s`. */
pub int ct_text_cat(char **buf, int *cap, const char *s);
/* Append `fmt`/...; retries after growth, so nothing is cut. */
pub int ct_text_printf(char **buf, int *cap, const char *fmt, ...);
/* S1a-0 C2l: one formatted block, owned by the caller and returned in *out.
   It starts at `init` (a path caller passes 1024) and doubles to TEXT_LIMIT;
   -1 is OOM, -3 is over the formal bound. Unlike `ct_text_printf` this writes
   a fresh block, so a path helper needs no companion capacity field. */
pub int ct_text_fmt(char **out, int init, const char *fmt, ...);
/* Copy `s` into a fresh exact block; same error codes. */
pub int ct_text_dup(const char *s, char **out);
/* S1a-0 C2l: run-scoped path strings. These allocate a fresh block (a path
   starts at the old 1024 and doubles to TEXT_LIMIT), register it in one pool
   and return it; `ct_scratch_free_all` releases the whole pool when the
   command ends. A helper that may fail mid-build (an early return) therefore
   needs no per-site free, and OOM / over-limit is an explicit hard stop. */
pub char *ct_scratch_fmt(const char *fmt, ...);
pub char *ct_scratch_dup(const char *s);
/* A raw run-scoped block of `size` bytes, for a caller that fills it itself
   (e.g. a header guard built character by character). */
pub char *ct_scratch_alloc(int size);
pub void ct_scratch_free_all(void);
/* Append `s` single-quoted for the shell. */
pub int ct_text_quote(char **buf, int *cap, const char *s);
/* Release the block and reset the caller's slot. */
pub void ct_text_free(char **buf, int *cap);
/* Single-quote `s` into a fresh block; the caller owns *out. */
pub int ct_sh_quote(const char *s, char **out, int *cap);

static int ct_text_need(char **buf, int *cap, int need, int init)
{
    int ncap;
    char *np;

    if (need < 0 || need > TEXT_LIMIT) return -1;
    if (need <= *cap) return 0;
    ncap = *cap > 0 ? *cap : (init > 0 ? init : 1);
    while (ncap < need) {
        if (ncap > TEXT_LIMIT / 2) {
            ncap = TEXT_LIMIT;
            break;
        }
        ncap = ncap * 2;
    }
    if (ncap > TEXT_LIMIT) ncap = TEXT_LIMIT;
    if (ncap < need) return -1;
    np = (char *)realloc(*buf, (size_t)ncap);
    if (!np) {
        fprintf(stderr, "ctc: out of memory\n");
        return -1;
    }
    *buf = np;
    *cap = ncap;
    return 0;
}

int ct_text_init(char **buf, int *cap, int init)
{
    if (*buf == 0) {
        if (ct_text_need(buf, cap, 1, init) != 0) return -1;
    }
    (*buf)[0] = 0;
    return 0;
}

int ct_text_reset(char **buf, int *cap, int init)
{
    return ct_text_init(buf, cap, init);
}

int ct_text_cat(char **buf, int *cap, const char *s)
{
    size_t l, sl;

    if (!s) return 0;
    l = *buf ? strlen(*buf) : 0;
    sl = strlen(s);
    if (l + sl + 1 > (size_t)TEXT_LIMIT) return -1;
    if (ct_text_need(buf, cap, (int)(l + sl + 1), 1) != 0) return -1;
    memcpy(*buf + l, s, sl + 1);
    return 0;
}

int ct_text_printf(char **buf, int *cap, const char *fmt, ...)
{
    va_list ap;
    size_t l;
    int n;

    for (;;) {
        if (*buf == 0) {
            if (ct_text_need(buf, cap, 1, 1) != 0) return -1;
            (*buf)[0] = 0;
        }
        l = strlen(*buf);
        va_start(ap, fmt);
        n = vsnprintf(*buf + l, (size_t)(*cap - (int)l), fmt, ap);
        va_end(ap);
        if (n < 0) return -1;
        if ((size_t)n < (size_t)(*cap - (int)l)) return 0;
        /* Drop the truncated attempt before growing; otherwise the retry
           appends the format to its own prefix. */
        (*buf)[l] = 0;
        if (ct_text_need(buf, cap, (int)(l + (size_t)n + 1), 1) != 0) return -1;
    }
}

int ct_text_fmt(char **out, int init, const char *fmt, ...)
{
    va_list ap;
    char *buf, *grown;
    int cap, n, ncap;

    *out = (char *)0;
    cap = init > 0 ? init : 1;
    if (cap > TEXT_LIMIT) cap = TEXT_LIMIT;
    buf = (char *)malloc((size_t)cap);
    if (!buf) return -1;
    for (;;) {
        va_start(ap, fmt);
        n = vsnprintf(buf, (size_t)cap, fmt, ap);
        va_end(ap);
        if (n < 0) { free(buf); return -1; }
        if (n < cap) break;
        if (cap >= TEXT_LIMIT) { free(buf); return -3; }
        ncap = cap * 2;
        if (ncap > TEXT_LIMIT) ncap = TEXT_LIMIT;
        grown = (char *)realloc(buf, (size_t)ncap);
        if (!grown) { free(buf); return -1; }
        buf = grown;
        cap = ncap;
    }
    *out = buf;
    return 0;
}

int ct_text_dup(const char *s, char **out)
{
    size_t n;
    char *buf;

    *out = (char *)0;
    if (!s) return -1;
    n = strlen(s);
    if (n > (size_t)TEXT_LIMIT) return -3;
    buf = (char *)malloc(n + 1);
    if (!buf) return -1;
    memcpy(buf, s, n + 1);
    *out = buf;
    return 0;
}

/* --- S1a-0 C2l: the run-scoped path pool ------------------------------- */
static char **g_scratch;
static int g_nscratch;
static int g_capscratch;

static void ct_scratch_keep(char *p)
{
    char **grown;
    int ncap;

    if (g_nscratch >= g_capscratch) {
        ncap = g_capscratch > 0 ? g_capscratch * 2 : 256;
        grown = (char **)realloc(g_scratch, (size_t)ncap * sizeof(*grown));
        if (!grown) {
            fprintf(stderr, "ctc: out of memory\n");
            exit(1);
        }
        g_scratch = grown;
        g_capscratch = ncap;
    }
    g_scratch[g_nscratch] = p;
    g_nscratch++;
}

static void ct_scratch_die(const char *what)
{
    fprintf(stderr, "ctc: %s\n", what);
    exit(1);
}

char *ct_scratch_fmt(const char *fmt, ...)
{
    va_list ap;
    char *buf, *grown;
    int cap, n, ncap;

    cap = 1024;
    buf = (char *)malloc((size_t)cap);
    if (!buf) ct_scratch_die("out of memory");
    for (;;) {
        va_start(ap, fmt);
        n = vsnprintf(buf, (size_t)cap, fmt, ap);
        va_end(ap);
        if (n < 0) {
            free(buf);
            ct_scratch_die("bad formatted path");
        }
        if (n < cap) break;
        if (cap >= TEXT_LIMIT) {
            free(buf);
            ct_scratch_die("text exceeds 65536 bytes");
        }
        ncap = cap * 2;
        if (ncap > TEXT_LIMIT) ncap = TEXT_LIMIT;
        grown = (char *)realloc(buf, (size_t)ncap);
        if (!grown) {
            free(buf);
            ct_scratch_die("out of memory");
        }
        buf = grown;
        cap = ncap;
    }
    ct_scratch_keep(buf);
    return buf;
}

char *ct_scratch_dup(const char *s)
{
    size_t n;
    char *p;

    if (!s) s = "";
    n = strlen(s);
    if (n > (size_t)TEXT_LIMIT) ct_scratch_die("text exceeds 65536 bytes");
    p = (char *)malloc(n + 1);
    if (!p) ct_scratch_die("out of memory");
    memcpy(p, s, n + 1);
    ct_scratch_keep(p);
    return p;
}

char *ct_scratch_alloc(int size)
{
    char *p;

    if (size < 1) size = 1;
    if (size > TEXT_LIMIT) ct_scratch_die("text exceeds 65536 bytes");
    p = (char *)malloc((size_t)size);
    if (!p) ct_scratch_die("out of memory");
    p[0] = 0;
    ct_scratch_keep(p);
    return p;
}

void ct_scratch_free_all(void)
{
    int i;

    for (i = 0; i < g_nscratch; i++) free(g_scratch[i]);
    free(g_scratch);
    g_scratch = (char **)0;
    g_nscratch = 0;
    g_capscratch = 0;
}

int ct_text_quote(char **buf, int *cap, const char *s)
{
    size_t l, sl, i, o;

    if (!s) return -1;
    sl = strlen(s);
    if (sl > (size_t)(TEXT_LIMIT - 3) / 4) return -1;
    l = *buf ? strlen(*buf) : 0;
    if (ct_text_need(buf, cap, (int)(l + 4 * sl + 3), 1) != 0) return -1;
    o = l;
    (*buf)[o] = '\'';
    o++;
    for (i = 0; i < sl; i++) {
        if (s[i] == '\'') {
            (*buf)[o] = '\'';
            (*buf)[o + 1] = '\\';
            (*buf)[o + 2] = '\'';
            (*buf)[o + 3] = '\'';
            o += 4;
        } else {
            (*buf)[o] = s[i];
            o++;
        }
    }
    (*buf)[o] = '\'';
    o++;
    (*buf)[o] = 0;
    return 0;
}

void ct_text_free(char **buf, int *cap)
{
    free(*buf);
    *buf = 0;
    *cap = 0;
}

int ct_sh_quote(const char *s, char **out, int *cap)
{
    if (*out == 0) {
        if (ct_text_need(out, cap, 1, 1) != 0) return -1;
    }
    (*out)[0] = 0;
    return ct_text_quote(out, cap, s);
}
