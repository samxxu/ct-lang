/*
 * Sh.h.ct - shell quoting and the one growable text builder, shared by the
 * units that compose command lines.
 *
 * Two units build command lines: the package manager (`ct get`'s git calls,
 * Phase 8) and the build driver (`ct build`'s cc invocation, Phase 17.6). Both
 * must escape a token the same way, so the rule lives here rather than twice --
 * a spec, a path or an executable name can never break out of its argument.
 *
 * S1a-0 C2e/C2f: `ct_text_*` is the `char **` + capacity builder both sides
 * use. It grows from a caller-chosen initial size (the old fixed cap) to the
 * formal `TEXT_LIMIT`, never truncates, and reports OOM explicitly. The caller
 * owns the block and frees it with `ct_text_free`.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

/* Mirror of the formal text bound in frontend/sym/Limits.h.ct. */
#define TEXT_LIMIT 65536

namespace tool::sh;
/* A stateless unit: the type exists only because a unit file is named after its
   main type. Nothing instantiates it. */
pub struct Sh {
    int unused;
}
/* Allocate `init` bytes and start empty. 0 ok, -1 OOM / over TEXT_LIMIT. */
pub int ct_text_init(char **buf, int *cap, int init);
/* Truncate to empty (allocating `init` bytes if the block is still unset). */
pub int ct_text_reset(char **buf, int *cap, int init);
/* Append `s`. */
pub int ct_text_cat(char **buf, int *cap, const char *s);
/* Append `fmt`/...; retries after growth, so nothing is cut. */
pub int ct_text_printf(char **buf, int *cap, const char *fmt, ...);
/* Append `s` single-quoted for the shell. */
pub int ct_text_quote(char **buf, int *cap, const char *s);
/* Release the block and reset the caller's slot. */
pub void ct_text_free(char **buf, int *cap);
/* Single-quote `s` into a fresh block; the caller owns *out. */
pub int ct_sh_quote(const char *s, char **out, int *cap);

static int ct_text_need(char **buf, int *cap, int need, int init)
{
    int ncap;
    char *np;

    if (need < 0 || need > TEXT_LIMIT) return -1;
    if (need <= *cap) return 0;
    ncap = *cap > 0 ? *cap : (init > 0 ? init : 1);
    while (ncap < need) {
        if (ncap > TEXT_LIMIT / 2) {
            ncap = TEXT_LIMIT;
            break;
        }
        ncap = ncap * 2;
    }
    if (ncap > TEXT_LIMIT) ncap = TEXT_LIMIT;
    if (ncap < need) return -1;
    np = (char *)realloc(*buf, (size_t)ncap);
    if (!np) {
        fprintf(stderr, "ctc: out of memory\n");
        return -1;
    }
    *buf = np;
    *cap = ncap;
    return 0;
}

int ct_text_init(char **buf, int *cap, int init)
{
    if (*buf == 0) {
        if (ct_text_need(buf, cap, 1, init) != 0) return -1;
    }
    (*buf)[0] = 0;
    return 0;
}

int ct_text_reset(char **buf, int *cap, int init)
{
    return ct_text_init(buf, cap, init);
}

int ct_text_cat(char **buf, int *cap, const char *s)
{
    size_t l, sl;

    if (!s) return 0;
    l = *buf ? strlen(*buf) : 0;
    sl = strlen(s);
    if (l + sl + 1 > (size_t)TEXT_LIMIT) return -1;
    if (ct_text_need(buf, cap, (int)(l + sl + 1), 1) != 0) return -1;
    memcpy(*buf + l, s, sl + 1);
    return 0;
}

int ct_text_printf(char **buf, int *cap, const char *fmt, ...)
{
    va_list ap;
    size_t l;
    int n;

    for (;;) {
        if (*buf == 0) {
            if (ct_text_need(buf, cap, 1, 1) != 0) return -1;
            (*buf)[0] = 0;
        }
        l = strlen(*buf);
        va_start(ap, fmt);
        n = vsnprintf(*buf + l, (size_t)(*cap - (int)l), fmt, ap);
        va_end(ap);
        if (n < 0) return -1;
        if ((size_t)n < (size_t)(*cap - (int)l)) return 0;
        /* Drop the truncated attempt before growing; otherwise the retry
           appends the format to its own prefix. */
        (*buf)[l] = 0;
        if (ct_text_need(buf, cap, (int)(l + (size_t)n + 1), 1) != 0) return -1;
    }
}

int ct_text_quote(char **buf, int *cap, const char *s)
{
    size_t l, sl, i, o;

    if (!s) return -1;
    sl = strlen(s);
    if (sl > (size_t)(TEXT_LIMIT - 3) / 4) return -1;
    l = *buf ? strlen(*buf) : 0;
    if (ct_text_need(buf, cap, (int)(l + 4 * sl + 3), 1) != 0) return -1;
    o = l;
    (*buf)[o] = '\'';
    o++;
    for (i = 0; i < sl; i++) {
        if (s[i] == '\'') {
            (*buf)[o] = '\'';
            (*buf)[o + 1] = '\\';
            (*buf)[o + 2] = '\'';
            (*buf)[o + 3] = '\'';
            o += 4;
        } else {
            (*buf)[o] = s[i];
            o++;
        }
    }
    (*buf)[o] = '\'';
    o++;
    (*buf)[o] = 0;
    return 0;
}

void ct_text_free(char **buf, int *cap)
{
    free(*buf);
    *buf = 0;
    *cap = 0;
}

int ct_sh_quote(const char *s, char **out, int *cap)
{
    if (*out == 0) {
        if (ct_text_need(out, cap, 1, 1) != 0) return -1;
    }
    (*out)[0] = 0;
    return ct_text_quote(out, cap, s);
}
