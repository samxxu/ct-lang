/*
 * Cache.h.ct - the incremental cache: key spelling, hit and store.
 *
 * Phase 6.3 (ported in 10.5). A cache is a property of a build directory, not
 * of the compiler's syntax state, so it is an object of its own: it owns the
 * version string that goes into every key and turns a unit's key material into
 * a stamped key. Nothing here parses or emits.
 *
 * Macros do not cross a unit boundary, so the caps are declared here; MAX_KEY
 * 768 is the value `frontend/module/Module.h.ct` spells. S1a-0 C2l: the cache
 * directory and key-file paths are exact owned strings (the old MAX_PATH 1024
 * buffers silently disabled the cache on a longer output path). The cache
 * deliberately knows nothing about `Unit`: the module layer hands in the key
 * material as strings and numbers, so this unit never imports upward.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

import tool::sh::Sh;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_KEY  768
/* S1a-0 C2b: the key grows on demand from MAX_KEY to the formal text bound. */
#define MAX_KEY_MAX 65536

namespace tool::cache;
pub trait CacheOps {
    unsigned long digest(const char *s);
    int  key(const char *path, const char *imports, unsigned long dep,
             int line_force, int diag_json, int runtime_checks,
             const char *nsroot, char **out, int *ocap);
    /* S1a-0 C2l: both paths are owned by this call and freed by the caller
       (`hit` / `store`). */
    int  paths(const char *outc, char **dir, char **kf);
    int  hit(const char *outc, const char *key, int need_h);
    void store(const char *outc, const char *key);
}

pub struct Cache {
    const char *version;        /* CTC_VERSION, seeded by the driver at start-up */
} use CacheOps;

pub struct Cache *cache_get(void);

impl CacheOps for Cache {
    /* FNV-1a: folds a variable-length string into the fixed-width number a key
       carries, so dependency chains stay bounded (L2's `digest`, D41). */
    unsigned long digest(const char *s)
    {
        unsigned long h;
        size_t i;
        (void)self;
        h = (unsigned long)2166136261;
        i = 0;
        while (s[i]) {
            h = h ^ (unsigned long)(unsigned char)s[i];
            h = h * (unsigned long)16777619;
            i++;
        }
        return h;
    }

    /* The key of one unit: what its .c/.h are a function of. The caller (the
       module layer, which owns the graph) hands in the imports text and the
       folded dependency digest; the cache adds the file stamp and the run's
       options. `-1` means "no key" and is treated as "cannot be reused" (a
       missing stamp must never be papered over). The spelling matches L2 byte
       for byte. */
    int key(const char *path, const char *imports, unsigned long dep,
            int line_force, int diag_json, int runtime_checks,
            const char *nsroot, char **out, int *ocap)
    {
        char stamp[64];
        struct stat st;
        int w, cap, ncap;
        char *buf, *grown;
        (void)self;

        /* S1a-0 C2b: the key is owned by this function and handed back whole.
           It starts at the old 768 and doubles until it fits, the way the
           table caps do; the formal cap is the resource guard. -2 is OOM and
           -3 is "over the formal text bound", so the caller can name the
           cause instead of silently skipping the cache. */
        *out = (char *)0;
        *ocap = 0;
        if (stat(path, &st) != 0) return -1;
        snprintf(stamp, sizeof stamp, "%lu.%lu",
                 (unsigned long)st.st_mtime, (unsigned long)st.st_size);
        cap = MAX_KEY;
        buf = (char *)malloc((size_t)cap);
        if (!buf) return -2;
        for (;;) {
            /* runtime_checks=0 must keep the L2 spelling byte for byte; only the
               new option adds a component, so a default build stays comparable. */
            if (runtime_checks)
                w = snprintf(buf, (size_t)cap,
                             "ctc %s L%d D%d R%d N%s P%s S%s I%lu K%lu",
                             self->version, line_force, diag_json, runtime_checks, nsroot,
                             path, stamp, self->digest(imports), dep);
            else
                w = snprintf(buf, (size_t)cap,
                             "ctc %s L%d D%d N%s P%s S%s I%lu K%lu",
                             self->version, line_force, diag_json, nsroot,
                             path, stamp, self->digest(imports), dep);
            if (w < 0) { free(buf); return -1; }
            if (w < cap) break;
            if (cap >= MAX_KEY_MAX) { free(buf); return -3; }
            ncap = cap * 2;
            if (ncap > MAX_KEY_MAX) ncap = MAX_KEY_MAX;
            grown = (char *)realloc(buf, (size_t)ncap);
            if (!grown) { free(buf); return -2; }
            buf = grown;
            cap = ncap;
        }
        *out = buf;
        *ocap = cap;
        return 0;
    }

    /* `<dir of outc>/.ctcache/<base>.key`: the cache sits beside the unit's own
       outputs, so `-o <dir>` keeps it out of the source tree. S1a-0 C2l: the
       two blocks grow from the old 1024-byte stack buffers to TEXT_LIMIT; a
       non-zero return means OOM or a path over the formal bound, never a
       silently disabled cache. */
    int paths(const char *outc, char **dir, char **kf)
    {
        const char *slash;
        const char *base;
        int rc;
        (void)self;
        *dir = (char *)0;
        *kf = (char *)0;
        slash = strrchr(outc, '/');
        base = slash ? slash + 1 : outc;
        if (slash)
            rc = tool::sh::ct_text_fmt(dir, 1024, "%.*s/.ctcache",
                                       (int)(slash - outc), outc);
        else
            rc = tool::sh::ct_text_fmt(dir, 1024, ".ctcache");
        if (rc != 0) return rc;
        rc = tool::sh::ct_text_fmt(kf, 1024, "%s/%s.key", *dir, base);
        if (rc != 0) {
            free(*dir);
            *dir = (char *)0;
            return rc;
        }
        return 0;
    }

    /* A hit needs the key file to match byte for byte and both artefacts on
       disk: a key whose .c/.h were deleted must not be reused. Only a `.h.ct`
       unit writes a header, so `need_h` is 0 for an implementation unit and the
       `.h` probe is skipped there. */
    int hit(const char *outc, const char *key, int need_h)
    {
        char *dir = (char *)0;
        char *kf = (char *)0;
        char *hp = (char *)0;
        char *buf = (char *)0;
        FILE *f;
        size_t n, kl, hl;
        int ok = 0;
        (void)self;

        if (self->paths(outc, &dir, &kf) != 0) goto done;
        kl = strlen(key);
        buf = (char *)malloc(kl + 1);
        if (!buf) goto done;
        f = fopen(kf, "r");
        if (!f) goto done;
        n = fread(buf, 1, kl + 1, f);
        fclose(f);
        if (n != kl || memcmp(buf, key, kl) != 0) goto done;
        if (need_h) {
            if (tool::sh::ct_text_dup(outc, &hp) != 0) goto done;
            hl = strlen(hp);
            if (hl < 3 || hp[hl - 1] != 'c' || hp[hl - 2] != '.') goto done;
            hp[hl - 1] = 'h';
            f = fopen(hp, "rb");
            if (!f) goto done;
            fclose(f);
        }
        f = fopen(outc, "rb");
        if (!f) goto done;
        fclose(f);
        ok = 1;
done:
        free(dir);
        free(kf);
        free(hp);
        free(buf);
        return ok;
    }

    /* Best effort by design: a cache that cannot be written costs a rebuild,
       never a broken build, so an unwritable directory stays silent. */
    void store(const char *outc, const char *key)
    {
        char *dir = (char *)0;
        char *kf = (char *)0;
        FILE *f;
        (void)self;
        if (self->paths(outc, &dir, &kf) != 0) return;
        mkdir(dir, 0755);            /* EEXIST on a warm cache is the normal case */
        f = fopen(kf, "w");
        if (f) {
            fprintf(f, "%s", key);   /* no newline: `hit` compares byte for byte */
            fclose(f);
        }
        free(dir);
        free(kf);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Cache g_cache;

struct Cache *cache_get(void)
{
    return &g_cache;
}
