/*
 * Pkg.h.ct - the package manager (`ct get` / `ct install`), one unit of its own.
 *
 * It is a leaf: it owns its lock/seen state and never touches the AST, so it
 * has no collaborators at all. The whole trait stays in this unit on
 * purpose -- the emitter makes each impl's vtable `static`, and an instance's
 * vptr initialisers can only name vtables its own unit can see, so one struct's
 * impls cannot be spread across units.
 *
 * Macros do not cross units, so the caps this unit needs are declared here;
 * MAX_TEXT 160 is the value `frontend/sym/Symbols.h.ct` lists, the MAX_PKG_*
 * and MAX_LOCK caps are this package manager's own.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <dirent.h>

import tool::sh::Sh;
import tool::pkg::PkgIndex;

#define MAX_TEXT       160
#define MAX_LOCK       4096             /* MAX_PKG_PATH * 8, spelled out */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   512
#define MAX_PKG_CMD    2048
#define MAX_PKG_DEPTH  8
#define MAX_PKG_LINE   1024             /* MAX_PKG_PATH * 2, spelled out */
#define MAX_PKG_GITERR 8                /* PKG-23: trailing git stderr lines */

namespace tool::pkg;
/* The package manager (Phase 8, ported in 10.6). `get`/`install` never reach the
   compile core: only `get` may run `git`, and `install` is offline (D42). */
trait PkgOps {
    int  read_manifest(const char *dir, char *name, size_t ncap, char *ver, size_t vcap,
                       char deps[][MAX_PKG_PATH], int *ndeps);
    int  version_parse(const char *s, int v[3]);
    int  version_cmp(const int a[3], const int b[3]);
    int  range_match(const char *range, const char *ver);
    int  copy_file(const char *src, const char *dst);
    int  copy_tree(const char *src, const char *dst);
    int  dir_digest(const char *dir, char *out, size_t cap);
    int  ensure_dir(const char *path);
    int  split_spec(const char *spec, char *path, size_t pcap, char *range, size_t rcap);
    int  is_git_ref(const char *spec);
    int  git_url(const char *spec, char *url, size_t cap);
    int  git_name(const char *spec, char *name, size_t cap);
    int  git_avail(void);
    int  sh_quote(const char *s, char *out, size_t cap);
    int  git_run(const char *cmd, const char *outfile);
    int  read_line_of(const char *path, char *buf, size_t cap);
    int  git_pick_tag(const char *cache, const char *range, char *tag, size_t tcap);
    int  fetch_git(const char *url, const char *name, const char *cache_pub,
                   const char *range, const char *pin_tag, const char *expect_sha,
                   int depth);
    int  get_git(const char *spec, const char *range, int depth);
    int  get_spec(const char *spec, const char *base, int depth);
    int  get_one(const char *dir, const char *range, int depth);
    int  remember_dep(const char *spec);
    int  dep_name(const char *spec, char *name, size_t cap);
    int  get(const char *spec, const char *root);
    int  install(const char *prog);
    int  get_main(int argc, char **argv);
    int  install_main(int argc, char **argv);
}

/* `ct update` / `ct verify` helpers. They are file statics rather than more
   `PkgOps` methods because L2 -- the compiler that builds ct-ast -- caps the
   whole program at MAX_FUNCS (512 since Phase 54; ct-ast used 250 of it when
   the cap was raised) and MAX_MAP_IMPLS 256 (2/256 left). They own no
   per-compile state beyond `g_pkg`, which is one unit-wide instance, so a
   static that names it directly reads the same. */
static int pkg_read_meta(const char *dir, char *cflags, size_t ccap,
                         char *ldflags, size_t lcap, char *req, size_t rcap);
/* PH-77: the built-in official pin table (compile-time constants, never the
   network or a mutable index). It is the only resolver a bare name may use. */
static int pkg_pin_lookup(const char *name, const char *range,
                          char *ver, size_t vcap, char *url, size_t ucap,
                          char *tag, size_t tcap, char *sha, size_t scap);
/* PH-77: resolve an official name to its source, letting an explicit index
   override a `publisher = ct` row (D-010 #4); the pin is the fallback. */
static int pkg_official_resolve(const char *name, char *url, size_t ucap,
                                char *tag, size_t tcap, char *sha, size_t scap);
static int pkg_index_lookup(const char *name, const char *range, char *url, size_t ucap,
                            char *tag, size_t tcap, char *sha, size_t scap,
                            char *pub, size_t pcap);
/* PH-83: the legacy-row text is shared with `ct get` so both commands give the
   same diagnostic (contract §4.4). */
static int index_legacy_msg(char *out, size_t cap, const char *spec, const char *ver);
static int pkg_index_verify(int argc, char **argv, const char *prog, const char *version);
static int pkg_append_words(char *dst, size_t cap, const char *src);
static int pkg_check_requires(const char *pkg, const char *req);
static int pkg_verify_lock(const char *prog, char lname[][MAX_TEXT], char lver[][32],
                           char lns[][MAX_TEXT], char ldig[][80], int *nlock);
static int pkg_lock_keep(char *dst, size_t cap);
static int pkg_update(const char *prog);
static int pkg_verify(const char *prog, int strict);
static int pkg_verify_strict(void);
/* S1 shared store: identity fields, $CT_HOME layout, and the digest-preserving
   commit. The helpers stay file-static because they need no vtable slot. */
static int pkg_read_identity(const char *dir, char *publisher, size_t pcap,
                             char *nsroot, size_t ncap);
static int pkg_store_root(char *out, size_t cap);
static int pkg_store_dir(const char *publisher, const char *name, const char *ver,
                         char *out, size_t cap);
static int pkg_store_pkgdir(const char *full, const char *ver, char *out, size_t cap);
static int pkg_mkdirs(const char *path);
static int pkg_identity_check(const char *src, const char *publisher,
                              const char *name, const char *nsroot);
static int pkg_store_commit(const char *src, const char *publisher, const char *name,
                            const char *ver, const char *nsroot, const char *dig,
                            char *store, size_t scap);
/* S0: 0 = no ct.lock, 1 = v1 (no `# ct-lock 2` header), 2 = v2; inlined in
   `install()` because this unit sits exactly on the 256-function limit. */

/* The manager's state lives in this struct so the unit owns it outright; `prog`
   and `version` are wired at start-up, which keeps CTC_VERSION defined in
   exactly one place. */
struct PkgRec {
    char name[MAX_TEXT];
    char version[32];
    char publisher[MAX_TEXT];
    char kind[16];
    char url[MAX_PKG_CMD];
    char tag[MAX_TEXT];
    char commit[64];
    char store[MAX_PKG_PATH];
    char digest[80];
    char action[16];
};

struct Pkg {
    char lock[MAX_LOCK];
    int  locklen;
    int  nlocks;
    char seen[MAX_PKG_DEPS][MAX_TEXT];
    int  nseen;
    struct PkgRec recs[MAX_PKG_DEPS];
    int  nrecs;
    int  quiet;
    int  json;
    /* `ct install --force` downgrades a `requires` mismatch to a warning; the
       default is to refuse, so an incompatible package cannot be wired in. */
    int  force;
    /* PKG-23: `ct get --refresh` discards the cached git checkout before the
       clone, so a damaged `.git` is recoverable without hand-editing $HOME. */
    int  refresh;
    /* PKG-23: where git_run sends stderr for the current operation. Empty
       keeps the old `2>/dev/null`; fetch_git sets it so a failure can be
       classified. The file is removed after it has been read. */
    char giterr[MAX_PKG_CMD];
    /* `ct get` enforces `requires` while it walks the spec (M2); this stays a
       `get` mode rather than a property of `get_one` itself. */
    int  check_requires;
    /* The optional index: `--index <path>` wins over `CT_INDEX`. Nothing is
       built in -- a package name only resolves through an index the user named. */
    char index[MAX_PKG_PATH];
    int  have_index;
    const char *prog;
    const char *version;
} use PkgOps;

/* --- SHA-256 (FIPS 180-4) -------------------------------------------------
   `ct.lock` pins stored content, so its digest has to resist collisions.
   FNV-1a plus an additive per-file fold (SH-44) did not: two files could be
   made to cancel out. The tree now hashes as one stream -- each file's
   relative path and bytes, in sorted path order -- and the lock spells the
   result `sha256:<64 hex>`, so a legacy 16-hex value is rejected rather than
   compared loosely. */

#define MAX_DIGEST_FILES 4096

static const char *g_hexd = "0123456789abcdef";

static const unsigned int g_sha_k[64] = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

struct Sha256 {
    unsigned int h[8];
    unsigned int nbuf;
    unsigned long total;
    unsigned char buf[64];
};

/* PH-83 `ct index verify`: one invalid row, encoded in a flat char buffer.
   A struct pointer cannot cross this file-static boundary: the compiler mangles
   a namespaced struct tag, but a `struct X **` parameter keeps the short name.
   Layout per record: int line, kind[32], msg[512]. */
#define INDEX_ERR_STRIDE   560
#define INDEX_ERR_KIND_OFF 4
#define INDEX_ERR_MSG_OFF  36



#define CT_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))

static void sha256_init(struct Sha256 *s)
{
    s->h[0] = 0x6a09e667;
    s->h[1] = 0xbb67ae85;
    s->h[2] = 0x3c6ef372;
    s->h[3] = 0xa54ff53a;
    s->h[4] = 0x510e527f;
    s->h[5] = 0x9b05688c;
    s->h[6] = 0x1f83d9ab;
    s->h[7] = 0x5be0cd19;
    s->nbuf = 0;
    s->total = 0;
}

static void sha256_block(struct Sha256 *s, const unsigned char *p)
{
    unsigned int w[64];
    unsigned int a, b, c, d, e, f, g, h;
    unsigned int t1, t2, s0, s1;
    int i;

    for (i = 0; i < 16; i++)
        w[i] = ((unsigned int)p[4 * i] << 24)
             | ((unsigned int)p[4 * i + 1] << 16)
             | ((unsigned int)p[4 * i + 2] << 8)
             | (unsigned int)p[4 * i + 3];
    for (i = 16; i < 64; i++) {
        s0 = CT_ROR(w[i - 15], 7) ^ CT_ROR(w[i - 15], 18) ^ (w[i - 15] >> 3);
        s1 = CT_ROR(w[i - 2], 17) ^ CT_ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    a = s->h[0];
    b = s->h[1];
    c = s->h[2];
    d = s->h[3];
    e = s->h[4];
    f = s->h[5];
    g = s->h[6];
    h = s->h[7];
    for (i = 0; i < 64; i++) {
        s1 = CT_ROR(e, 6) ^ CT_ROR(e, 11) ^ CT_ROR(e, 25);
        t1 = h + s1 + ((e & f) ^ ((~e) & g)) + g_sha_k[i] + w[i];
        s0 = CT_ROR(a, 2) ^ CT_ROR(a, 13) ^ CT_ROR(a, 22);
        t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    s->h[0] = s->h[0] + a;
    s->h[1] = s->h[1] + b;
    s->h[2] = s->h[2] + c;
    s->h[3] = s->h[3] + d;
    s->h[4] = s->h[4] + e;
    s->h[5] = s->h[5] + f;
    s->h[6] = s->h[6] + g;
    s->h[7] = s->h[7] + h;
}

static void sha256_update(struct Sha256 *s, const unsigned char *p, size_t n)
{
    size_t i;
    for (i = 0; i < n; i++) {
        s->buf[s->nbuf] = p[i];
        s->nbuf++;
        s->total++;
        if (s->nbuf == 64) {
            sha256_block(s, s->buf);
            s->nbuf = 0;
        }
    }
}

static void sha256_final(struct Sha256 *s)
{
    unsigned char pad[64];
    unsigned long bits;
    unsigned int i;
    int k;

    bits = s->total * 8;
    memset(pad, 0, sizeof pad);
    pad[0] = 128;
    k = (s->nbuf < 56) ? 56 - (int)s->nbuf : 120 - (int)s->nbuf;
    sha256_update(s, pad, (size_t)k);
    for (i = 0; i < 8; i++)
        pad[i] = (unsigned char)((bits >> (56 - 8 * (int)i)) & 255);
    sha256_update(s, pad, 8);
}

static void sha256_hex(const struct Sha256 *s, char *out)
{
    int i, j;
    unsigned int v;
    for (i = 0; i < 8; i++) {
        v = s->h[i];
        for (j = 0; j < 8; j++)
            out[i * 8 + j] = g_hexd[(v >> (28 - 4 * j)) & 15];
    }
    out[64] = 0;
}

/* One file's contribution: its relative path, a newline, then its bytes. The
   path is what `readdir` yielded, so the order is fixed by `sha_sort`. */
static int sha256_file(struct Sha256 *s, const char *rel, const char *path)
{
    FILE *f;
    int c;
    unsigned char b;

    sha256_update(s, (const unsigned char *)rel, strlen(rel));
    b = (unsigned char)'\n';
    sha256_update(s, &b, 1);
    f = fopen(path, "rb");
    if (!f) return -1;
    c = fgetc(f);
    while (c != EOF) {
        b = (unsigned char)c;
        sha256_update(s, &b, 1);
        c = fgetc(f);
    }
    fclose(f);
    return 0;
}

/* Collect the relative paths of every regular file under `dir` into `list`
   (row stride MAX_PKG_PATH); `vendor`, `.git` and `.ctcache` are not part of
   a package, matching what `copy_tree` ships. */
static int sha_collect(const char *dir, const char *rel, char *list, int *n, int cap)
{
    DIR *d;
    struct dirent *e;
    struct stat st;
    char full[MAX_PKG_PATH], r[MAX_PKG_PATH];
    int w;

    d = opendir(dir);
    if (!d) return -1;
    for (;;) {
        e = readdir(d);
        if (e == NULL) break;
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
        if (strcmp(e->d_name, ".git") == 0 || strcmp(e->d_name, "vendor") == 0) continue;
        if (strcmp(e->d_name, ".ctcache") == 0) continue;
        if (snprintf(full, sizeof full, "%s/%s", dir, e->d_name) >= (int)sizeof full) continue;
        if (rel[0]) w = snprintf(r, sizeof r, "%s/%s", rel, e->d_name);
        else        w = snprintf(r, sizeof r, "%s", e->d_name);
        if (w < 0 || (size_t)w >= sizeof r) continue;
        if (stat(full, &st) != 0) continue;
        if (S_ISDIR(st.st_mode)) {
            if (sha_collect(full, r, list, n, cap) != 0) {
                closedir(d);
                return -1;
            }
        } else if (S_ISREG(st.st_mode)) {
            if (*n >= cap) {
                closedir(d);
                return -1;
            }
            snprintf(list + (size_t)(*n) * MAX_PKG_PATH, MAX_PKG_PATH, "%s", r);
            *n = *n + 1;
        }
    }
    closedir(d);
    return 0;
}

/* Insertion sort on the collected rows: the digest must not depend on the
   `readdir` order, which differs between filesystems. */
static void sha_sort(char *list, int n)
{
    char tmp[MAX_PKG_PATH];
    int i, j;

    for (i = 1; i < n; i++) {
        snprintf(tmp, sizeof tmp, "%s", list + (size_t)i * MAX_PKG_PATH);
        j = i - 1;
        while (j >= 0 && strcmp(list + (size_t)j * MAX_PKG_PATH, tmp) > 0) {
            /* A row copy, not a formatted print: gcc cannot see that the two
               rows are disjoint and warns -Wrestrict on the overlapping-looking
               `snprintf`, which the warning-free gate treats as a failure. */
            memcpy(list + (size_t)(j + 1) * MAX_PKG_PATH,
                   list + (size_t)j * MAX_PKG_PATH, MAX_PKG_PATH);
            j--;
        }
        snprintf(list + (size_t)(j + 1) * MAX_PKG_PATH, MAX_PKG_PATH, "%s", tmp);
    }
}

/* `sha256:<64 lowercase hex>` is the only accepted lock spelling (SH-44). */
static int sha_hex_ok(const char *s)
{
    int i;
    if (strncmp(s, "sha256:", 7) != 0) return 0;
    if (strlen(s) != 71) return 0;
    for (i = 7; i < 71; i++) {
        if ((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')) continue;
        return 0;
    }
    return 1;
}

/* PKG-23: redact a URL userinfo (the part before `@`) before a git message or
   a URL reaches stderr. The rewrite is one-way; the caller passes a separate
   output buffer. */
static void pkg_scrub(const char *in, char *out, size_t cap)
{
    const char *p, *q, *at;
    size_t o;

    o = 0;
    p = in;
    while (*p && o + 1 < cap) {
        if (p[0] == ':' && p[1] == '/' && p[2] == '/') {
            q = p + 3;
            at = 0;
            while (*q && *q != '/' && *q != '?' && *q != '#'
                   && *q != ' ' && *q != '\'' && *q != '"') {
                if (*q == '@') { at = q; break; }
                q++;
            }
            if (at != 0) {
                if (o + 7 >= cap) break;
                memcpy(out + o, "://***@", 7);
                o += 7;
                p = at + 1;
                continue;
            }
        }
        out[o] = *p;
        o++;
        p++;
    }
    out[o] = 0;
}

/* PKG-23: turn the captured git stderr into a cause and an action. The
   last MAX_PKG_GITERR non-empty lines are printed redacted; the classes are
   ordered most-specific first so "Authentication failed" is not reported
   as a generic network error. `spec` is the explicit spelling to retry
   (`ct/std@0.19.0` for the official pin), `cache` is the checkout path. */
static void pkg_git_diag(const char *errfile, const char *cache,
                         const char *spec)
{
    FILE *f;
    char line[MAX_PKG_LINE], ring[MAX_PKG_GITERR][MAX_PKG_LINE];
    char scrubbed[MAX_PKG_CMD], all[MAX_PKG_CMD];
    size_t ll, al;
    int n, i, shown, start;
    int cache_bad, auth_bad, tag_bad, net_bad;

    n = 0;
    all[0] = 0;
    f = fopen(errfile, "r");
    if (f != 0) {
        while (fgets(line, sizeof line, f) != 0) {
            ll = strlen(line);
            while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
                ll--;
                line[ll] = 0;
            }
            if (line[0] == 0) continue;
            snprintf(ring[n % MAX_PKG_GITERR], MAX_PKG_LINE, "%s", line);
            pkg_scrub(line, scrubbed, sizeof scrubbed);
            al = strlen(all);
            if (al + strlen(scrubbed) + 2 < sizeof all) {
                strcat(all, scrubbed);
                strcat(all, "\n");
            }
            n++;
        }
        fclose(f);
    }
    shown = n < MAX_PKG_GITERR ? n : MAX_PKG_GITERR;
    start = n - shown;
    if (shown > 0) {
        fprintf(stderr, "  git said (last %d line(s); credentials redacted):\n", shown);
        for (i = start; i < n; i++) {
            pkg_scrub(ring[i % MAX_PKG_GITERR], scrubbed, sizeof scrubbed);
            fprintf(stderr, "    %s\n", scrubbed);
        }
    }
    /* No stderr at all from `git config`/`fetch`/`checkout` means git refused
       before it could describe the failure; the cache is the only party left
       to blame, and the caller names its path. */
    cache_bad = n == 0
                || strstr(all, "not a git repository") != 0
                || strstr(all, "not a git repo") != 0
                || strstr(all, "corrupt") != 0
                || strstr(all, "Corrupt") != 0
                || strstr(all, "bad config") != 0
                || strstr(all, "index file corrupt") != 0
                || strstr(all, "loose object") != 0;
    auth_bad = strstr(all, "Authentication failed") != 0
               || strstr(all, "authentication failed") != 0
               || strstr(all, "could not read Username") != 0
               || strstr(all, "could not read Password") != 0
               || strstr(all, "Permission denied") != 0
               || strstr(all, "publickey") != 0
               || strstr(all, "returned error: 401") != 0
               || strstr(all, "returned error: 403") != 0
               || strstr(all, "Repository not found") != 0
               || strstr(all, "terminal prompts disabled") != 0
               || strstr(all, "Invalid username or password") != 0;
    tag_bad = strstr(all, "did not match any file") != 0
              || strstr(all, "does not take a path argument") != 0
              || strstr(all, "pathspec") != 0
              || strstr(all, "couldn't find remote ref") != 0
              || strstr(all, "remote ref does not exist") != 0
              || strstr(all, "not our ref") != 0
              || strstr(all, "no such remote ref") != 0
              || strstr(all, "bad object") != 0
              || strstr(all, "missing object") != 0
              || strstr(all, "reference is not a tree") != 0
              || strstr(all, "invalid reference") != 0;
    net_bad = strstr(all, "Could not resolve host") != 0
              || strstr(all, "unable to access") != 0
              || strstr(all, "Failed to connect") != 0
              || strstr(all, "Couldn't connect") != 0
              || strstr(all, "Connection refused") != 0
              || strstr(all, "Connection timed out") != 0
              || strstr(all, "Operation timed out") != 0
              || strstr(all, "Network is unreachable") != 0
              || strstr(all, "No route to host") != 0
              || strstr(all, "CONNECT tunnel failed") != 0
              || strstr(all, "proxy") != 0
              || strstr(all, "Proxy") != 0
              || strstr(all, "SSL") != 0
              || strstr(all, "TLS") != 0
              || strstr(all, "RPC failed") != 0
              || strstr(all, "early EOF") != 0
              || strstr(all, "remote end hung up") != 0;
    if (cache_bad) {
        fprintf(stderr, "  cause: the package cache is corrupt\n");
        fprintf(stderr, "  cache: %s\n", cache);
        fprintf(stderr, "  next: rm -rf '%s' and retry, "
                        "or run 'ct get --refresh %s'\n", cache, spec);
    } else if (auth_bad) {
        fprintf(stderr, "  cause: authentication/permission denied\n");
        fprintf(stderr, "  next: check the credentials or SSH key for the "
                        "remote; git runs non-interactively "
                        "(GIT_TERMINAL_PROMPT=0), then retry\n");
    } else if (tag_bad) {
        fprintf(stderr, "  cause: remote tag/object missing\n");
        fprintf(stderr, "  next: the pinned tag is not present on the "
                        "remote; check the pin/tag or publish it, then "
                        "retry with 'ct get %s'\n", spec);
    } else if (net_bad) {
        fprintf(stderr, "  cause: network/proxy unreachable\n");
        fprintf(stderr, "  next: retry; check https_proxy/ALL_PROXY and DNS, "
                        "or pin explicitly with 'ct get %s'\n", spec);
    } else {
        fprintf(stderr, "  cause: unclassified git failure\n");
        fprintf(stderr, "  next: retry; if it persists run "
                        "'ct get --refresh %s' or remove the cache '%s'\n",
                spec, cache);
    }
    remove(errfile);
}

impl PkgOps for Pkg {
    /* Parse `<dir>/ct.pkg`. Line-oriented: `#` starts a comment, `key = value`,
       and `dep` may repeat. A missing name or version is an error. */
    int read_manifest(const char *dir, char *name, size_t ncap, char *ver, size_t vcap,
                      char deps[][MAX_PKG_PATH], int *ndeps)
    {
        char path[MAX_PKG_PATH];
        char line[MAX_PKG_PATH];
        FILE *f;
        int ok;
        (void)self;

        if (snprintf(path, sizeof path, "%s/ct.pkg", dir) >= (int)sizeof path) return -1;
        f = fopen(path, "r");
        if (!f) return -1;
        name[0] = 0;
        ver[0] = 0;
        *ndeps = 0;
        ok = 1;
        while (fgets(line, sizeof line, f) != NULL) {
            char *ls, *le, *eq, *k, *v, *ve;
            size_t kl, vl, ll;
            ll = strlen(line);
            while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
                ll = ll - 1;
                line[ll] = 0;
            }
            ls = line;
            while (*ls == ' ' || *ls == '\t') ls++;
            if (*ls == 0 || *ls == '#') continue;
            le = ls + strlen(ls);
            eq = ls;
            while (eq < le && *eq != '=') eq++;
            if (eq == le) continue;
            k = eq;
            while (k > ls && (k[-1] == ' ' || k[-1] == '\t')) k = k - 1;
            v = eq + 1;
            while (*v == ' ' || *v == '\t') v++;
            ve = v + strlen(v);
            while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t')) ve = ve - 1;
            kl = (size_t)(k - ls);
            vl = (size_t)(ve - v);
            if (kl == 4 && strncmp(ls, "name", 4) == 0) {
                if (vl >= ncap) { ok = 0; break; }
                memcpy(name, v, vl);
                name[vl] = 0;
            } else if (kl == 7 && strncmp(ls, "version", 7) == 0) {
                if (vl >= vcap) { ok = 0; break; }
                memcpy(ver, v, vl);
                ver[vl] = 0;
            } else if (kl == 3 && strncmp(ls, "dep", 3) == 0) {
                if (*ndeps >= MAX_PKG_DEPS || vl >= MAX_PKG_PATH) { ok = 0; break; }
                memcpy(deps[*ndeps], v, vl);
                deps[*ndeps][vl] = 0;
                (*ndeps)++;
            } else if (!((kl == 9 && strncmp(ls, "publisher", 9) == 0)
                         || (kl == 7 && strncmp(ls, "ns-root", 7) == 0)
                         || (kl == 6 && strncmp(ls, "cflags", 6) == 0)
                         || (kl == 7 && strncmp(ls, "ldflags", 7) == 0)
                         || (kl == 8 && strncmp(ls, "requires", 8) == 0)
                         || (kl == 7 && (strncmp(ls, "licence", 7) == 0
                                         || strncmp(ls, "license", 7) == 0))
                         || (kl == 5 && strncmp(ls, "leaks", 5) == 0)
                         || (kl == 9 && strncmp(ls, "namespace", 9) == 0)
                         || (kl == 6 && strncmp(ls, "source", 6) == 0)
                         || (kl == 7 && strncmp(ls, "website", 7) == 0)
                         || (kl == 4 && strncmp(ls, "type", 4) == 0)
                         || (kl == 6 && strncmp(ls, "strict", 6) == 0))) {
                fprintf(stderr, "ctc: warning: '%s/ct.pkg' has unknown key '%.*s'\n",
                        dir, (int)kl, ls);
            }
        }
        fclose(f);
        if (!ok) return -1;
        return (name[0] && ver[0]) ? 0 : -1;
    }

    int version_parse(const char *s, int v[3])
    {
        int n;
        (void)self;
        v[0] = 0;
        v[1] = 0;
        v[2] = 0;
        n = sscanf(s, "%d.%d.%d", &v[0], &v[1], &v[2]);
        return (n >= 1) ? 0 : -1;
    }

    int version_cmp(const int a[3], const int b[3])
    {
        int i;
        (void)self;
        for (i = 0; i < 3; i++) {
            if (a[i] < b[i]) return -1;
            if (a[i] > b[i]) return 1;
        }
        return 0;
    }

    /* A range is one or more clauses separated by spaces, all of which must hold
       (AND); `||` is deliberately unsupported. A clause is `^x.y.z`, `~x.y.z`,
       `>=x.y.z`, `>x.y.z`, `<x.y.z`, `<=x.y.z`, `=x.y.z`, a bare version (exact)
       or `*`. The operator and its version may be separated by spaces. */
    int range_match(const char *range, const char *ver)
    {
        char work[MAX_TEXT];
        int v[3];
        const char *p;
        size_t n;
        (void)self;

        if (!range || !range[0] || strcmp(range, "*") == 0) return 1;
        n = strlen(range);
        if (n >= sizeof work) return 0;
        memcpy(work, range, n + 1);
        if (self->version_parse(ver, v) != 0) return 0;

        p = work;
        while (*p) {
            char opc;
            char *q;
            char verstr[MAX_TEXT];
            int lo[3], rc;
            size_t vl;

            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            opc = 0;
            if (p[0] == '>' && p[1] == '=') { opc = 'G'; p += 2; }
            else if (p[0] == '<' && p[1] == '=') { opc = 'L'; p += 2; }
            else if (p[0] == '>') { opc = 'g'; p++; }
            else if (p[0] == '<') { opc = 'l'; p++; }
            else if (p[0] == '=') { opc = 'e'; p++; }
            else if (p[0] == '^') { opc = '^'; p++; }
            else if (p[0] == '~') { opc = '~'; p++; }
            while (*p == ' ' || *p == '\t') p++;
            q = (char *)p;
            while (*p && *p != ' ' && *p != '\t') p++;
            vl = (size_t)(p - q);
            if (vl == 0) return 0;
            if (vl == 1 && q[0] == '*') continue;
            if (vl >= sizeof verstr) return 0;
            memcpy(verstr, q, vl);
            verstr[vl] = 0;
            if (self->version_parse(verstr, lo) != 0) return 0;
            rc = self->version_cmp(v, lo);
            if (opc == 0 || opc == 'e') {
                if (rc != 0) return 0;
            } else if (opc == '^') {
                if (v[0] != lo[0] || rc < 0) return 0;
            } else if (opc == '~') {
                if (v[0] != lo[0] || v[1] != lo[1] || rc < 0) return 0;
            } else if (opc == 'G') {
                if (rc < 0) return 0;
            } else if (opc == 'g') {
                if (rc <= 0) return 0;
            } else if (opc == 'L') {
                if (rc > 0) return 0;
            } else if (opc == 'l') {
                if (rc >= 0) return 0;
            }
        }
        return 1;
    }

    int copy_file(const char *src, const char *dst)
    {
        FILE *in, *out;
        char buf[4096];
        size_t n;
        (void)self;

        in = fopen(src, "rb");
        if (!in) return -1;
        out = fopen(dst, "wb");
        if (!out) { fclose(in); return -1; }
        for (;;) {
            n = fread(buf, 1, sizeof buf, in);
            if (n == 0) break;
            if (fwrite(buf, 1, n, out) != n) { fclose(in); fclose(out); return -1; }
        }
        fclose(in);
        if (fclose(out) != 0) return -1;
        return 0;
    }

    /* Copy a package directory; build caches and VCS metadata are not package
       content, so they are skipped rather than copied. */
    int copy_tree(const char *src, const char *dst)
    {
        DIR *d;
        struct dirent *e;
        struct stat st;
        struct stat ds;
        char s[MAX_PKG_PATH], t[MAX_PKG_PATH];
        int rc;
        (void)self;

        rc = 0;
        if (mkdir(dst, 0755) != 0) {
            if (stat(dst, &ds) != 0 || !S_ISDIR(ds.st_mode)) return -1;
        }
        d = opendir(src);
        if (!d) return -1;
        for (;;) {
            e = readdir(d);
            if (e == NULL) break;
            if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
            if (strcmp(e->d_name, ".git") == 0 || strcmp(e->d_name, "vendor") == 0) continue;
            if (strcmp(e->d_name, ".ctcache") == 0) continue;
            snprintf(s, sizeof s, "%s/%s", src, e->d_name);
            snprintf(t, sizeof t, "%s/%s", dst, e->d_name);
            if (stat(s, &st) != 0) { rc = -1; break; }
            if (S_ISDIR(st.st_mode)) {
                if (self->copy_tree(s, t) != 0) { rc = -1; break; }
            } else if (S_ISREG(st.st_mode)) {
                if (self->copy_file(s, t) != 0) { rc = -1; break; }
            }
        }
        closedir(d);
        return rc;
    }

    /* One digest per tree: every regular file's relative path and bytes feed
       a single SHA-256 in sorted path order, so neither `readdir` order nor an
       additive fold can make two different trees agree (SH-44). */
    int dir_digest(const char *dir, char *out, size_t cap)
    {
        struct Sha256 sha;
        struct stat st;
        char *list;
        char hex[65];
        int i, n, w;
        (void)self;

        if (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode)) return -1;
        list = (char *)malloc((size_t)MAX_DIGEST_FILES * (size_t)MAX_PKG_PATH);
        if (!list) return -1;
        n = 0;
        if (sha_collect(dir, "", list, &n, MAX_DIGEST_FILES) != 0) {
            free(list);
            return -1;
        }
        sha_sort(list, n);
        sha256_init(&sha);
        for (i = 0; i < n; i++) {
            char full[MAX_PKG_PATH];
            if (snprintf(full, sizeof full, "%s/%s", dir, list + (size_t)i * MAX_PKG_PATH)
                >= (int)sizeof full) {
                free(list);
                return -1;
            }
            if (sha256_file(&sha, list + (size_t)i * MAX_PKG_PATH, full) != 0) {
                free(list);
                return -1;
            }
        }
        free(list);
        sha256_final(&sha);
        sha256_hex(&sha, hex);
        w = snprintf(out, cap, "sha256:%s", hex);
        if (w < 0 || (size_t)w >= cap) return -1;
        return 0;
    }

    int ensure_dir(const char *path)
    {
        struct stat st;
        (void)self;
        if (mkdir(path, 0755) == 0) return 0;
        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 0;
        return -1;
    }

    /* `path[@range]`: the last `@` separates the two, so a path may contain one. */
    int split_spec(const char *spec, char *path, size_t pcap, char *range, size_t rcap)
    {
        const char *at, *q;
        size_t n;
        (void)self;

        at = NULL;
        for (q = spec; *q; q++)
            if (*q == '@') at = q;
        if (!at) {
            if (strlen(spec) >= pcap) return -1;
            snprintf(path, pcap, "%s", spec);
            range[0] = 0;
            return 0;
        }
        n = (size_t)(at - spec);
        if (n >= pcap || strlen(at + 1) >= rcap) return -1;
        memcpy(path, spec, n);
        path[n] = 0;
        snprintf(range, rcap, "%s", at + 1);
        return 0;
    }

    /* A spec is a git source unless it names a filesystem location. */
    int is_git_ref(const char *spec)
    {
        (void)self;
        if (spec[0] == '.' || spec[0] == '/') return 0;
        if (strncmp(spec, "file://", 7) == 0) return 0;
        return 1;
    }

    int git_url(const char *spec, char *url, size_t cap)
    {
        const char *reg;
        int w;
        (void)self;

        if (strstr(spec, "://")) {
            if (strlen(spec) >= cap) return -1;
            snprintf(url, cap, "%s", spec);
            return 0;
        }
        if (strchr(spec, '/')) {
            w = snprintf(url, cap, "https://%s", spec);
            if (w < 0 || (size_t)w >= cap) return -1;
            return 0;
        }
        reg = getenv("CT_REGISTRY");
        if (!reg || !reg[0]) reg = "https://github.com/ct-pkg";
        w = snprintf(url, cap, "%s/%s", reg, spec);
        if (w < 0 || (size_t)w >= cap) return -1;
        return 0;
    }

    int git_name(const char *spec, char *name, size_t cap)
    {
        const char *b, *e;
        size_t l;
        (void)self;

        e = spec + strlen(spec);
        while (e > spec && e[-1] == '/') e = e - 1;
        b = e;
        while (b > spec && b[-1] != '/') b = b - 1;
        l = (size_t)(e - b);
        if (l == 0 || l >= cap) return -1;
        memcpy(name, b, l);
        name[l] = 0;
        return 0;
    }

    int git_avail(void)
    {
        (void)self;
        return system("git --version >/dev/null 2>&1") == 0;
    }

    /* Single-quote `s` for the shell; every path and URL that reaches `git_run`
       goes through here, so a spec can never break out of its argument. The rule
       itself lives in `tool/sh/Sh.h.ct`, shared with `ct build`'s cc line. */
    int sh_quote(const char *s, char *out, size_t cap)
    {
        (void)self;
        return tool::sh::ct_sh_quote(s, out, (int)cap);
    }

    /* The one subprocess call site. CI-9: a network fetch must not hang the
       caller and must not prompt for credentials. `GIT_TERMINAL_PROMPT=0` and
       `GIT_ASKPASS=true` close the prompt paths; `-c http.lowSpeedLimit/Time`
       makes git abort a stalled HTTP transfer even where no `timeout` utility
       exists (macOS); where `timeout` does exist (Linux CI) it adds a hard
       wall-clock cap around the whole git process. `CT_GIT_TIMEOUT` overrides
       the cap in seconds (digits only). */
    int git_run(const char *cmd, const char *outfile)
    {
        char full[MAX_PKG_CMD], qo[MAX_PKG_CMD], qe[MAX_PKG_CMD], cap[16], pre[32];
        const char *limit, *rest, *ef;
        size_t i;
        int w;
        (void)self;

        /* Every caller builds a `git ...` line; inserting the per-invocation
           config after the binary keeps `-C <dir> <subcommand>` intact. */
        if (strncmp(cmd, "git ", 4) != 0) return -1;
        rest = cmd + 4;
        limit = getenv("CT_GIT_TIMEOUT");
        if (limit != 0 && limit[0] != 0) {
            i = 0;
            while (limit[i] >= '0' && limit[i] <= '9' && i + 1 < sizeof cap) {
                cap[i] = limit[i];
                i++;
            }
            if (i == 0 || limit[i] != 0) return -1;
            cap[i] = 0;
            limit = cap;
        } else {
            limit = "180";
        }
        if (system("command -v timeout >/dev/null 2>&1") == 0) {
            if (snprintf(pre, sizeof pre, "timeout %s ", limit) >= (int)sizeof pre) return -1;
        } else {
            pre[0] = 0;
        }
        /* PKG-23: fetch_git asks for the git stderr. `umask 077` keeps the
           temporary capture private (it can contain a rewritten URL), and the
           caller removes it after reading. No capture keeps the old shape. */
        ef = self->giterr;
        if (ef != 0 && ef[0] != 0) {
            if (self->sh_quote(ef, qe, sizeof qe) != 0) return -1;
        } else {
            qe[0] = 0;
        }
        if (outfile != 0) {
            if (self->sh_quote(outfile, qo, sizeof qo) != 0) return -1;
            if (qe[0] != 0) {
                w = snprintf(full, sizeof full,
                             "umask 077; GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true %s"
                             "git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 "
                             "%s > %s 2> %s", pre, rest, qo, qe);
            } else {
                w = snprintf(full, sizeof full,
                             "GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true %s"
                             "git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 "
                             "%s > %s 2>/dev/null", pre, rest, qo);
            }
        } else if (qe[0] != 0) {
            w = snprintf(full, sizeof full,
                         "umask 077; GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true %s"
                         "git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 "
                         "%s 2> %s", pre, rest, qe);
        } else {
            w = snprintf(full, sizeof full,
                         "GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true %s"
                         "git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 "
                         "%s 2>/dev/null", pre, rest);
        }
        if (w < 0 || (size_t)w >= sizeof full) return -1;
        return system(full);
    }

    int read_line_of(const char *path, char *buf, size_t cap)
    {
        FILE *f;
        size_t n;
        int c;
        (void)self;

        n = 0;
        f = fopen(path, "r");
        if (!f) return -1;
        c = fgetc(f);
        while (c != EOF && c != '\n' && c != '\r') {
            if (n + 1 >= cap) { fclose(f); return -1; }
            buf[n] = (char)c;
            n++;
            c = fgetc(f);
        }
        fclose(f);
        buf[n] = 0;
        return 0;
    }

    /* Omitted range / `*` selects the newest tag; an explicit range uses
       minimal version selection (the lowest tag satisfying it).
       `0` = a tag was chosen, `-2` = no tags and any version is acceptable
       (fall back to the default branch), `-1` = no tag fits. */
    int git_pick_tag(const char *cache, const char *range, char *tag, size_t tcap)
    {
        char q1[MAX_PKG_CMD], cmd[MAX_PKG_CMD], out[MAX_PKG_CMD], root[MAX_PKG_CMD];
        char line[MAX_PKG_CMD];
        const char *home;
        FILE *f;
        int have, v[3], best[3], w, want_latest;

        home = getenv("HOME");
        if (!home || !home[0]) return -1;
        if (snprintf(root, sizeof root, "%s/.cache/ct-pkg", home) >= (int)sizeof root) return -1;
        if (snprintf(out, sizeof out, "%s/.ct-pkg.tags", root) >= (int)sizeof out) return -1;
        tag[0] = 0;
        want_latest = (!range || !range[0] || strcmp(range, "*") == 0);
        if (self->sh_quote(cache, q1, sizeof q1) != 0) return -1;
        w = snprintf(cmd, sizeof cmd, "git -C %s tag -l", q1);
        if (w < 0 || (size_t)w >= sizeof cmd) return -1;
        if (self->git_run(cmd, out) != 0) return -1;

        f = fopen(out, "r");
        if (!f) return -1;
        have = 0;
        while (fgets(line, sizeof line, f) != NULL) {
            char *ls, *le, *vp;
            char tmp[MAX_TEXT];
            size_t vl, tl, ll;
            ll = strlen(line);
            while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r'
                              || line[ll - 1] == ' ' || line[ll - 1] == '\t')) {
                ll = ll - 1;
                line[ll] = 0;
            }
            ls = line;
            while (*ls == ' ' || *ls == '\t') ls++;
            le = ls + strlen(ls);
            if (ls == le) continue;
            vp = ls;
            vl = (size_t)(le - ls);
            if (vl && *vp == 'v') {
                vp++;
                vl = vl - 1;
            }
            if (vl == 0 || vl >= sizeof tmp) continue;
            memcpy(tmp, vp, vl);
            tmp[vl] = 0;
            if (self->version_parse(tmp, v) != 0) continue;
            if (!self->range_match(range, tmp)) continue;
            tl = (size_t)(le - ls);
            if (tl == 0 || tl >= tcap) continue;
            if (!have
                || (want_latest ? self->version_cmp(v, best) > 0
                                : self->version_cmp(v, best) < 0)) {
                memcpy(tag, ls, tl);
                tag[tl] = 0;
                best[0] = v[0];
                best[1] = v[1];
                best[2] = v[2];
                have = 1;
            }
        }
        fclose(f);
        if (have) return 0;
        if (!range || !range[0] || strcmp(range, "*") == 0) return -2;
        return -1;
    }

    /* Fetch a git package into the cache, check out the version the range
       picks, pin the commit, then commit the tree to the shared store.
       `pin_tag`/`expect_sha` come from the index (both NULL for a plain spec). */
    int fetch_git(const char *url, const char *name, const char *cache_pub,
                  const char *range, const char *pin_tag, const char *expect_sha,
                  int depth)
    {
        char hdir[MAX_PKG_CMD], root[MAX_PKG_CMD], cache[MAX_PKG_CMD], gitdir[MAX_PKG_CMD];
        char out[MAX_PKG_CMD], q1[MAX_PKG_CMD], q2[MAX_PKG_CMD], cmd[MAX_PKG_CMD];
        char diag_spec[MAX_PKG_CMD], sdiag[MAX_PKG_CMD], surl[MAX_PKG_CMD];
        char mname[MAX_TEXT], mver[32], deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char tag[MAX_TEXT], commit[64], dig[80];
        char publisher[MAX_TEXT], nsroot[MAX_PKG_PATH], store[MAX_PKG_PATH];
        const char *home;
        struct stat st;
        int ndeps, i, w, rc, fresh, existed, orc;
        struct PkgRec *rec;

        self->giterr[0] = 0;
        pkg_scrub(url, surl, sizeof surl);

        ndeps = 0;
        if (depth > MAX_PKG_DEPTH) {
            fprintf(stderr, "ctc: dependency chain is too deep at '%s'\n", name);
            return -1;
        }
        if (!self->git_avail()) {
            fprintf(stderr, "ctc: git is required for '%s' but was not found; "
                            "install git or use a local directory source\n", name);
            return -1;
        }
        home = getenv("HOME");
        if (!home || !home[0]) {
            fprintf(stderr, "ctc: cannot locate the package cache (HOME is unset)\n");
            return -1;
        }
        if (snprintf(hdir, sizeof hdir, "%s/.cache", home) >= (int)sizeof hdir) return -1;
        if (snprintf(root, sizeof root, "%s/.cache/ct-pkg", home) >= (int)sizeof root) return -1;
        /* The cache key carries the publisher: two publishers may ship a
           package with the same name, and a bare-name cache silently reuses
           whichever one happened to be fetched first (PKG-5). */
        if (cache_pub && cache_pub[0]) {
            char pdir[MAX_PKG_CMD];
            if (self->ensure_dir(hdir) != 0 || self->ensure_dir(root) != 0) {
                fprintf(stderr, "ctc: cannot create the package cache '%s'\n", root);
                return -1;
            }
            if (snprintf(pdir, sizeof pdir, "%s/%s", root, cache_pub) >= (int)sizeof pdir) return -1;
            if (self->ensure_dir(pdir) != 0) {
                fprintf(stderr, "ctc: cannot create the package cache '%s'\n", pdir);
                return -1;
            }
            if (snprintf(cache, sizeof cache, "%s/%s", pdir, name) >= (int)sizeof cache) return -1;
        } else if (snprintf(cache, sizeof cache, "%s/%s", root, name) >= (int)sizeof cache) {
            return -1;
        }
        if (snprintf(gitdir, sizeof gitdir, "%s/.git", cache) >= (int)sizeof gitdir) return -1;
        if (snprintf(out, sizeof out, "%s/.ct-pkg.out", root) >= (int)sizeof out) return -1;
        if (self->ensure_dir(hdir) != 0 || self->ensure_dir(root) != 0) {
            fprintf(stderr, "ctc: cannot create the package cache '%s'\n", root);
            return -1;
        }
        /* PKG-23: capture stderr under the shared cache root. The capture is
           discarded on success and read+removed on failure, so a credential
           that git echoed never survives in the cache directory. */
        if (snprintf(self->giterr, sizeof self->giterr, "%s/.ct-pkg.err", root)
            >= (int)sizeof self->giterr) return -1;
        /* The explicit spelling the failure advice points at: official pins
           are most useful as `ct/std@0.19.0`; a URL or a publisher-qualified
           name stays in the shape the user typed. */
        if (cache_pub && cache_pub[0]) {
            const char *vt;
            vt = (pin_tag && pin_tag[0]) ? pin_tag : "";
            if (vt[0] == 'v') vt = vt + 1;
            if (vt[0] != 0) {
                if (snprintf(diag_spec, sizeof diag_spec, "%s/%s@%s",
                             cache_pub, name, vt) >= (int)sizeof diag_spec)
                    return -1;
            } else if (snprintf(diag_spec, sizeof diag_spec, "%s/%s",
                                cache_pub, name) >= (int)sizeof diag_spec) {
                return -1;
            }
        } else if (snprintf(diag_spec, sizeof diag_spec, "%s", url)
                   >= (int)sizeof diag_spec) {
            return -1;
        }
        pkg_scrub(diag_spec, sdiag, sizeof sdiag);

        fresh = 0;
        if (stat(gitdir, &st) != 0) fresh = 1;
        else if (!S_ISDIR(st.st_mode)) fresh = 1;
        if (self->refresh) {
            /* Remove the whole checkout, not just a valid `.git`: a partial
               clone leaves a non-empty directory that a fresh clone refuses. */
            if (stat(cache, &st) == 0) {
                if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
                w = snprintf(cmd, sizeof cmd, "rm -rf %s", q2);
                if (w < 0 || (size_t)w >= sizeof cmd) return -1;
                if (system(cmd) != 0) {
                    fprintf(stderr, "ctc: cannot refresh the package cache '%s'\n", cache);
                    return -1;
                }
            }
            fresh = 1;
        }
        if (!fresh) {
            char origin[MAX_PKG_CMD];
            if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
            w = snprintf(cmd, sizeof cmd, "git -C %s config --get remote.origin.url", q2);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            orc = self->git_run(cmd, out);
            if (orc != 0) {
                fprintf(stderr, "ctc: cannot inspect the package cache '%s' "
                                "(its .git is unreadable)\n", cache);
                pkg_git_diag(self->giterr, cache, sdiag);
                return -1;
            }
            remove(self->giterr);
            if (self->read_line_of(out, origin, sizeof origin) != 0) {
                fprintf(stderr, "ctc: the package cache '%s' has no origin\n", cache);
                fprintf(stderr, "  cause: the package cache is incomplete\n");
                fprintf(stderr, "  cache: %s\n", cache);
                fprintf(stderr, "  next: rm -rf '%s' and retry, "
                                "or run 'ct get --refresh %s'\n", cache, sdiag);
                return -1;
            }
            if (strcmp(origin, url) != 0) {
                char os[MAX_PKG_CMD];
                pkg_scrub(origin, os, sizeof os);
                fprintf(stderr, "ctc: cache for '%s/%s' has a different origin\n",
                        cache_pub && cache_pub[0] ? cache_pub : "?", name);
                fprintf(stderr, "  expected: %s\n", surl);
                fprintf(stderr, "  recorded: %s\n", os);
                fprintf(stderr, "  cache: %s\n", cache);
                fprintf(stderr, "  next: rm -rf '%s' and retry, "
                                "or run 'ct get --refresh %s'\n", cache, sdiag);
                return -1;
            }
        }
        if (self->sh_quote(url, q1, sizeof q1) != 0) return -1;
        if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
        if (fresh) {
            w = snprintf(cmd, sizeof cmd, "git clone --quiet %s %s", q1, q2);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git clone of '%s' failed\n", surl);
                pkg_git_diag(self->giterr, cache, sdiag);
                return -1;
            }
        } else {
            w = snprintf(cmd, sizeof cmd, "git -C %s fetch --quiet --tags --force", q2);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git fetch of '%s' failed\n", surl);
                pkg_git_diag(self->giterr, cache, sdiag);
                return -1;
            }
        }
        remove(self->giterr);

        tag[0] = 0;
        if (pin_tag && pin_tag[0]) {
            if (strlen(pin_tag) >= sizeof tag) return -1;
            snprintf(tag, sizeof tag, "%s", pin_tag);
            rc = 0;
        } else {
            rc = self->git_pick_tag(cache, range, tag, sizeof tag);
        }
        if (rc == 0) {
            if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
            if (self->sh_quote(tag, q1, sizeof q1) != 0) return -1;
            w = snprintf(cmd, sizeof cmd, "git -C %s checkout --quiet --detach %s", q2, q1);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git checkout of '%s' failed\n", tag);
                pkg_git_diag(self->giterr, cache, sdiag);
                return -1;
            }
            remove(self->giterr);
        } else if (rc == -2) {
            if (!fresh) {
                if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
                w = snprintf(cmd, sizeof cmd, "git -C %s reset --hard --quiet origin/HEAD", q2);
                if (w >= 0 && (size_t)w < sizeof cmd) self->git_run(cmd, NULL);
                remove(self->giterr);
            }
        } else {
            remove(self->giterr);
            fprintf(stderr, "ctc: no tag of '%s' satisfies '%s'\n", name, range);
            return -1;
        }

        if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
        w = snprintf(cmd, sizeof cmd, "git -C %s rev-parse --verify HEAD", q2);
        if (w < 0 || (size_t)w >= sizeof cmd) return -1;
        if (self->git_run(cmd, out) != 0) {
            fprintf(stderr, "ctc: git cannot resolve a commit for '%s'\n", name);
            pkg_git_diag(self->giterr, cache, sdiag);
            return -1;
        }
        remove(self->giterr);
        if (self->read_line_of(out, commit, sizeof commit) != 0 || commit[0] == 0) {
            fprintf(stderr, "ctc: git returned no commit for '%s'\n", name);
            return -1;
        }

        if (self->read_manifest(cache, mname, sizeof mname, mver, sizeof mver, deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", cache);
            return -1;
        }
        if (strcmp(mname, name) != 0) {
            fprintf(stderr, "ctc: '%s/ct.pkg' names '%s', but the source is '%s'\n",
                    cache, mname, name);
            return -1;
        }
        if (!self->range_match(range, mver)) {
            fprintf(stderr, "ctc: %s %s does not satisfy '%s'\n", mname, mver, range);
            return -1;
        }
        if (pkg_read_identity(cache, publisher, sizeof publisher, nsroot, sizeof nsroot) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", cache);
            return -1;
        }
        /* PKG-9: same early check as `get_one`; a git source with a missing
           identity may not fetch/commit its dependencies either. */
        if (pkg_identity_check(cache, publisher, mname, nsroot) != 0) return -1;
        /* PH-77: the official identity is `ct`, so a `ct/<name>` source that
           declares a different publisher is a mis-tagged release, not a
           package we may store under a second identity. */
        if (cache_pub && strcmp(cache_pub, "ct") == 0 && strcmp(publisher, "ct") != 0) {
            fprintf(stderr, "ctc: '%s/ct.pkg' declares publisher '%s', but the "
                            "official identity is 'ct'\n", cache, publisher);
            return -1;
        }
        for (i = 0; i < self->nseen; i++)
            if (strcmp(self->seen[i], mname) == 0) return 0;
        if (self->nseen >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: too many packages (max %d)\n", MAX_PKG_DEPS);
            return -1;
        }
        snprintf(self->seen[self->nseen], MAX_TEXT, "%s", mname);
        self->nseen++;

        /* M2: the same pre-copy check as `get_one`, so a git source whose
           `requires` is unsatisfied never reaches the shared store. */
        if (self->check_requires) {
            char mreq[MAX_TEXT], mcf[MAX_TEXT], mlf[MAX_TEXT];
            if (pkg_read_meta(cache, mcf, sizeof mcf, mlf, sizeof mlf,
                              mreq, sizeof mreq) != 0) {
                fprintf(stderr, "ctc: package '%s' has metadata that does not fit\n", mname);
                return -1;
            }
            if (pkg_check_requires(mname, mreq) != 0) {
                if (!self->force) {
                    fprintf(stderr, "ctc: use --force to get anyway\n");
                    return -1;
                }
                fprintf(stderr, "ctc: continuing despite the requires mismatch (--force)\n");
            }
        }

        for (i = 0; i < ndeps; i++)
            if (self->get_spec(deps[i], cache, depth + 1) != 0) return -1;

        if (self->dir_digest(cache, dig, sizeof dig) != 0) {
            fprintf(stderr, "ctc: cannot hash '%s'\n", cache);
            return -1;
        }
        if (expect_sha && expect_sha[0] && strcmp(dig, expect_sha) != 0) {
            fprintf(stderr, "ctc: '%s' does not match the pinned digest "
                            "(source %s, expected %s)\n",
                    mname, dig, expect_sha);
            return -1;
        }
        existed = 0;
        if (pkg_store_dir(publisher, mname, mver, store, sizeof store) == 0
            && stat(store, &st) == 0)
            existed = 1;
        if (pkg_store_commit(cache, publisher, mname, mver, nsroot, dig,
                             store, sizeof store) != 0)
            return -1;
        w = snprintf(self->lock + self->locklen,
                     sizeof self->lock - (size_t)self->locklen,
                     "%s/%s %s git %s %s %s %s\n",
                     publisher, mname, mver, url, commit, nsroot, dig);
        if (w < 0 || (size_t)w >= sizeof self->lock - (size_t)self->locklen) return -1;
        self->locklen += w;
        self->nlocks++;
        if (self->nrecs < MAX_PKG_DEPS) {
            rec = &self->recs[self->nrecs++];
            snprintf(rec->name, sizeof rec->name, "%s/%s",
                     publisher[0] ? publisher : "?", mname);
            snprintf(rec->version, sizeof rec->version, "%s", mver);
            snprintf(rec->publisher, sizeof rec->publisher, "%s", publisher);
            snprintf(rec->kind, sizeof rec->kind, "git");
            snprintf(rec->url, sizeof rec->url, "%s", url);
            snprintf(rec->tag, sizeof rec->tag, "%s", tag[0] ? tag : "-");
            snprintf(rec->commit, sizeof rec->commit, "%s", commit);
            snprintf(rec->store, sizeof rec->store, "%s", store);
            snprintf(rec->digest, sizeof rec->digest, "%s", dig);
            snprintf(rec->action, sizeof rec->action, "%s", existed ? "reused" : "installed");
        }
        return 0;
    }

    /* A spec that names a git source: resolve its url and name, then fetch. */
    int get_git(const char *spec, const char *range, int depth)
    {
        char url[MAX_PKG_CMD], name[MAX_TEXT], publisher[MAX_TEXT];
        const char *slash;

        publisher[0] = 0;
        slash = strchr(spec, '/');
        if (slash && !strstr(spec, "://") && !strstr(spec, "@")) {
            size_t pl = (size_t)(slash - spec);
            if (pl == 0 || pl >= sizeof publisher) return -1;
            memcpy(publisher, spec, pl);
            publisher[pl] = 0;
        }
        if (self->git_url(spec, url, sizeof url) != 0) {
            fprintf(stderr, "ctc: cannot resolve a git url for '%s'\n", spec);
            return -1;
        }
        if (self->git_name(spec, name, sizeof name) != 0) {
            fprintf(stderr, "ctc: cannot derive a package name from '%s'\n", spec);
            return -1;
        }
        return self->fetch_git(url, name, publisher, range, NULL, NULL, depth);
    }

    /* Every dependency edge takes this: split off the range, then route to
       `get_git` or, for a filesystem location, to `get_one`. PH-77 gives the
       three name shapes distinct resolvers (D-010 #2):
         - a bare name resolves the built-in official pin table only, and is a
           hard error otherwise;
         - `ct/<name>` prefers an explicit index row with `publisher = ct`,
           then falls back to the pin;
         - any other `<publisher>/<name>` needs an explicit index. */
    int get_spec(const char *spec, const char *base, int depth)
    {
        char path[MAX_PKG_PATH], range[32], full[MAX_PKG_PATH];
        char url[MAX_PKG_CMD], tag[MAX_TEXT], sha[80], pub[MAX_TEXT];
        char pver[32];
        const char *ix;
        int rc;
        (void)self;

        if (self->split_spec(spec, path, sizeof path, range, sizeof range) != 0) return -1;
        ix = self->have_index ? self->index : getenv("CT_INDEX");
        if (self->is_git_ref(path)) {
            if (strchr(path, '/') == NULL && strstr(path, "://") == NULL) {
                /* Only an official pin may be spelled without a publisher. */
                rc = pkg_pin_lookup(path, range, pver, sizeof pver,
                                    url, sizeof url, tag, sizeof tag,
                                    sha, sizeof sha);
                if (rc == 0)
                    return self->fetch_git(url, path, "ct", range, tag, sha, depth);
                if (rc == -1) return -1;
                fprintf(stderr,
                    "ctc: '%s' is not an official package\n"
                    "  bare names resolve the built-in official pins only (ct/std);\n"
                    "  a third-party package always keeps its publisher.\n"
                    "  write '<publisher>/<name>' with an index:\n"
                    "       ct get --index <file> <publisher>/%s\n"
                    "       CT_INDEX=<file> ct get <publisher>/%s\n"
                    "  or name a git URL / a local directory.\n",
                    path, path, path);
                return -1;
            }
            if (strchr(path, '/') != NULL && strstr(path, "://") == NULL) {
                const char *leaf = strrchr(path, '/') + 1;
                int is_ct = ((size_t)(leaf - path) == 3
                             && strncmp(path, "ct/", 3) == 0);
                rc = 2;
                if (ix && ix[0]) {
                    rc = pkg_index_lookup(path, range, url, sizeof url,
                                          tag, sizeof tag, sha, sizeof sha,
                                          pub, sizeof pub);
                    if (rc == 0)
                        return self->fetch_git(url, leaf, pub, range, tag, sha, depth);
                    if (rc == -1) return -1;
                }
                if (is_ct) {
                    rc = pkg_pin_lookup(leaf, range, pver, sizeof pver,
                                        url, sizeof url, tag, sizeof tag,
                                        sha, sizeof sha);
                    if (rc == 0)
                        return self->fetch_git(url, leaf, "ct", range, tag, sha, depth);
                    if (rc == -1) return -1;
                }
                if (!ix || !ix[0]) {
                    fprintf(stderr,
                        "ctc: no index resolver for '%s'\n"
                        "  '%s' is a publisher-qualified package name; the built-in\n"
                        "  pins cover the official packages only (ct/std).\n"
                        "  publisher-qualified package:\n"
                        "       ct get --index <file> %s\n"
                        "       CT_INDEX=<file> ct get %s\n"
                        "     the index is a local plain-text file; line format:\n"
                        "       name version publisher git-url tag sha256:<64 hex>\n"
                        "  known git URL:\n"
                        "       ct get https://<host>/<publisher>/<repo>\n"
                        "  local checkout:\n"
                        "       ct get ./path-to-%s\n",
                        path, path, path, path, leaf);
                    return -1;
                }
                fprintf(stderr, "ctc: package '%s' is not in the index\n", path);
                return -1;
            }
            return self->get_git(path, range, depth);
        }
        if (strncmp(path, "file://", 7) == 0) {
            if (snprintf(full, sizeof full, "%s", path + 7) >= (int)sizeof full) return -1;
        } else if (path[0] == '/') {
            if (snprintf(full, sizeof full, "%s", path) >= (int)sizeof full) return -1;
        } else if (snprintf(full, sizeof full, "%s/%s", base, path) >= (int)sizeof full) {
            return -1;
        }
        return self->get_one(full, range, depth);
    }

    int get_one(const char *dir, const char *range, int depth)
    {
        char name[MAX_TEXT], ver[32], deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char dig[80];
        char publisher[MAX_TEXT], nsroot[MAX_PKG_PATH], store[MAX_PKG_PATH];
        int ndeps, i, w, existed;
        struct stat st;
        struct PkgRec *rec;

        ndeps = 0;
        if (depth > MAX_PKG_DEPTH) {
            fprintf(stderr, "ctc: dependency chain is too deep at '%s'\n", dir);
            return -1;
        }
        if (self->read_manifest(dir, name, sizeof name, ver, sizeof ver, deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", dir);
            return -1;
        }
        if (pkg_read_identity(dir, publisher, sizeof publisher, nsroot, sizeof nsroot) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", dir);
            return -1;
        }
        /* PKG-9: the identity is required before anything is fetched or
           committed. This used to be checked only inside `pkg_store_commit`,
           i.e. after `get_spec` had already written every dependency into the
           shared store, so a refused get left a partial install behind. */
        if (pkg_identity_check(dir, publisher, name, nsroot) != 0) return -1;
        if (!self->range_match(range, ver)) {
            fprintf(stderr, "ctc: %s %s does not satisfy '%s'\n", name, ver, range);
            return -1;
        }
        for (i = 0; i < self->nseen; i++)
            if (strcmp(self->seen[i], name) == 0) return 0;
        if (self->nseen >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: too many packages (max %d)\n", MAX_PKG_DEPS);
            return -1;
        }
        snprintf(self->seen[self->nseen], MAX_TEXT, "%s", name);
        self->nseen++;

        /* M2: `requires` is checked before the tree reaches the store, so a
           refused package leaves the previous store version byte-identical.
           `get()` used to make this check after the copy, which is why a
           rejected upgrade still replaced `vendor/<name>` while leaving
           `ct.lock` alone. */
        if (self->check_requires) {
            char mreq[MAX_TEXT], mcf[MAX_TEXT], mlf[MAX_TEXT];
            if (pkg_read_meta(dir, mcf, sizeof mcf, mlf, sizeof mlf,
                              mreq, sizeof mreq) != 0) {
                fprintf(stderr, "ctc: package '%s' has metadata that does not fit\n", name);
                return -1;
            }
            if (pkg_check_requires(name, mreq) != 0) {
                if (!self->force) {
                    fprintf(stderr, "ctc: use --force to get anyway\n");
                    return -1;
                }
                fprintf(stderr, "ctc: continuing despite the requires mismatch (--force)\n");
            }
        }

        for (i = 0; i < ndeps; i++)
            if (self->get_spec(deps[i], dir, depth + 1) != 0) return -1;

        if (self->dir_digest(dir, dig, sizeof dig) != 0) {
            fprintf(stderr, "ctc: cannot hash '%s'\n", dir);
            return -1;
        }
        existed = 0;
        if (pkg_store_dir(publisher, name, ver, store, sizeof store) == 0
            && stat(store, &st) == 0)
            existed = 1;
        if (pkg_store_commit(dir, publisher, name, ver, nsroot, dig,
                             store, sizeof store) != 0)
            return -1;
        w = snprintf(self->lock + self->locklen,
                     sizeof self->lock - (size_t)self->locklen,
                     "%s/%s %s dir %s - %s %s\n", publisher, name, ver, dir, nsroot, dig);
        if (w < 0 || (size_t)w >= sizeof self->lock - (size_t)self->locklen) return -1;
        self->locklen += w;
        self->nlocks++;
        if (self->nrecs < MAX_PKG_DEPS) {
            rec = &self->recs[self->nrecs++];
            snprintf(rec->name, sizeof rec->name, "%s/%s",
                     publisher[0] ? publisher : "?", name);
            snprintf(rec->version, sizeof rec->version, "%s", ver);
            snprintf(rec->publisher, sizeof rec->publisher, "%s", publisher);
            snprintf(rec->kind, sizeof rec->kind, "dir");
            snprintf(rec->url, sizeof rec->url, "%s", dir);
            snprintf(rec->tag, sizeof rec->tag, "-");
            snprintf(rec->commit, sizeof rec->commit, "-");
            snprintf(rec->store, sizeof rec->store, "%s", store);
            snprintf(rec->digest, sizeof rec->digest, "%s", dig);
            snprintf(rec->action, sizeof rec->action, "%s", existed ? "reused" : "installed");
        }
        return 0;
    }

    /* D24: `get` records the spec as a `dep = ...` line unless that line (or
       the same package spelled differently) is already there. */
    int remember_dep(const char *spec)
    {
        char buf[MAX_LOCK];
        char newname[MAX_TEXT], cur[MAX_PKG_PATH], cn[MAX_TEXT];
        char *p, *end;
        long len;
        size_t n, sl, cl;
        int found, have_name;
        FILE *f;
        (void)self;

        f = fopen("./ct.pkg", "r");
        if (!f) return 0;
        len = -1;
        n = 0;
        if (fseek(f, 0, SEEK_END) == 0) {
            long sz;
            size_t sz2;
            sz = ftell(f);
            if (sz >= 0 && (size_t)sz < sizeof buf && fseek(f, 0, SEEK_SET) == 0) {
                sz2 = (size_t)sz;
                if (sz2 > 0) n = fread(buf, 1, sz2, f);
                if (n == sz2) len = sz;
            }
        }
        if (len < 0) {
            fclose(f);
            fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
            return -1;
        }
        fclose(f);
        buf[n] = 0;
        sl = strlen(spec);
        have_name = (self->dep_name(spec, newname, sizeof newname) == 0);
        found = 0;
        p = buf;
        end = buf + n;
        while (p < end) {
            char *ls, *le, *v, *ve;
            size_t vl;
            ls = p;
            le = p;
            while (le < end && *le != '\n') le = le + 1;
            p = (le < end) ? le + 1 : end;
            while (ls < le && (*ls == ' ' || *ls == '\t')) ls = ls + 1;
            if ((size_t)(le - ls) < 4 || strncmp(ls, "dep", 3) != 0) continue;
            v = ls + 3;
            while (v < le && (*v == ' ' || *v == '\t')) v = v + 1;
            if (v >= le || *v != '=') continue;
            v = v + 1;
            while (v < le && (*v == ' ' || *v == '\t')) v = v + 1;
            ve = le;
            while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t' || ve[-1] == '\r')) ve = ve - 1;
            vl = (size_t)(ve - v);
            if (sl == vl && strncmp(v, spec, vl) == 0) {
                found = 1;
                break;
            }
            if (have_name) {
                cl = vl < sizeof cur - 1 ? vl : sizeof cur - 1;
                memcpy(cur, v, cl);
                cur[cl] = 0;
                if (self->dep_name(cur, cn, sizeof cn) == 0 && strcmp(cn, newname) == 0) {
                    found = 1;
                    break;
                }
            }
        }
        if (!found) {
            f = fopen("./ct.pkg", "a");
            if (!f) {
                fprintf(stderr, "ctc: cannot write './ct.pkg'\n");
                return -1;
            }
            if (n > 0 && buf[n - 1] != '\n') fputc('\n', f);
            fprintf(f, "dep = %s\n", spec);
            if (fclose(f) != 0) {
                fprintf(stderr, "ctc: cannot write './ct.pkg'\n");
                return -1;
            }
        }
        return 0;
    }

    /* The name a dependency resolves to: a local package by its manifest, a git
       package by its spec tail; falls back to the tail when the local source is
       gone. */
    int dep_name(const char *spec, char *name, size_t cap)
    {
        char path[MAX_PKG_PATH], range[32], full[MAX_PKG_PATH];
        char mp[MAX_PKG_PATH], sname[MAX_TEXT], sver[32];
        char deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        int ndeps;
        FILE *f;
        (void)self;

        ndeps = 0;
        if (self->split_spec(spec, path, sizeof path, range, sizeof range) != 0) return -1;
        if (self->is_git_ref(path)) return self->git_name(path, name, cap);
        if (strncmp(path, "file://", 7) == 0) {
            if (snprintf(full, sizeof full, "%s", path + 7) >= (int)sizeof full) return -1;
        } else if (path[0] == '/') {
            if (snprintf(full, sizeof full, "%s", path) >= (int)sizeof full) return -1;
        } else if (snprintf(full, sizeof full, "./%s", path) >= (int)sizeof full) {
            return -1;
        }
        if (snprintf(mp, sizeof mp, "%s/ct.pkg", full) >= (int)sizeof mp) return -1;
        f = fopen(mp, "r");
        if (!f) return self->git_name(path, name, cap);
        fclose(f);
        if (self->read_manifest(full, sname, sizeof sname, sver, sizeof sver, deps, &ndeps) != 0)
            return self->git_name(path, name, cap);
        if (snprintf(name, cap, "%s", sname) >= (int)cap) return -1;
        return 0;
    }

    int get(const char *spec, const char *root)
    {
        FILE *f;
        char kept[MAX_LOCK];
        char head[64];
        size_t klen;
        int i, ninst, nreuse;
        (void)self;

        self->locklen = 0;
        self->nseen = 0;
        self->nrecs = 0;
        self->nlocks = 0;
        self->check_requires = 1;
        self->lock[0] = 0;
        /* S7: a pre-existing v1 lock cannot be merged into a store-backed run.
           The rows would keep their five fields under a v2 header; point the
           project at the one-time bridge instead. An empty file is no lock. */
        f = fopen("./ct.lock", "r");
        if (f != NULL) {
            if (fgets(head, sizeof head, f) != NULL
                && !(strncmp(head, "# ct-lock 2", 11) == 0
                     && (head[11] == '\n' || head[11] == '\r' || head[11] == 0))) {
                fclose(f);
                fprintf(stderr, "ctc: ct.lock is v1 (no '# ct-lock 2' header); run 'ct migrate'\n");
                return 1;
            }
            fclose(f);
        }
        /* P20-04: a package whose `requires` this compiler does not satisfy is
           refused inside `get_spec` -- before `ct.lock` is merged or opened --
           so a failed `get` leaves the previous lock byte-identical instead of
           writing half of a new one. `--force` downgrades the mismatch to a
           warning, exactly as `ct install` does. */
        if (self->get_spec(spec, root, 0) != 0) return 1;
        /* PH-77: a lock still spelling the legacy `std/std` identity is only
           rewritten by `ct update`. Merging a fresh `ct/std` row beside it
           would leave one package under two identities, which the build reader
           rejects -- so refuse here and point at the migration. */
        {
            int legacy = 0, official = 0;
            for (i = 0; i < self->nrecs; i++)
                if (strcmp(self->recs[i].name, "ct/std") == 0) official = 1;
            f = fopen("./ct.lock", "r");
            if (f != NULL) {
                char line[MAX_PKG_LINE];
                while (fgets(line, sizeof line, f) != NULL)
                    if (strncmp(line, "std/std ", 8) == 0) legacy = 1;
                fclose(f);
            }
            if (legacy && official) {
                fprintf(stderr, "ctc: ct.lock still pins 'std/std'; run 'ct update' "
                                "to migrate it to 'ct/std'\n");
                return 1;
            }
        }
        /* `ct get` names one spec; the rows it did not touch stay in the lock,
           so a second get cannot unpin the first package (PKG-2). */
        if (pkg_lock_keep(kept, sizeof kept) != 0) return 1;
        klen = strlen(kept);
        if (self->locklen + (int)klen >= (int)sizeof self->lock) {
            fprintf(stderr, "ctc: ct.lock is too large to merge\n");
            return 1;
        }
        memcpy(self->lock + self->locklen, kept, klen + 1);
        self->locklen += (int)klen;

        f = fopen("./ct.lock", "w");
        if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        fputs("# ct-lock 2\n", f);
        fputs(self->lock, f);
        if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        if (self->remember_dep(spec) != 0) return 1;
        ninst = 0;
        nreuse = 0;
        for (i = 0; i < self->nrecs; i++) {
            if (strcmp(self->recs[i].action, "reused") == 0) nreuse++;
            else ninst++;
        }
        if (self->json) {
            printf("{\"requested\":\"%s\",\"packages\":[", spec);
            for (i = 0; i < self->nrecs; i++) {
                struct PkgRec *r = &self->recs[i];
                printf("%s{\"name\":\"%s\",\"version\":\"%s\",\"publisher\":\"%s\","
                       "\"source\":\"%s\",\"url\":\"%s\",\"spec\":\"%s@%s\","
                       "\"tag\":\"%s\","
                       "\"commit\":\"%s\",\"store\":\"%s\",\"digest\":\"%s\","
                       "\"action\":\"%s\"}",
                       i ? "," : "", r->name, r->version, r->publisher,
                       r->kind, r->url, r->url, r->version, r->tag,
                       r->commit, r->store, r->digest, r->action);
            }
            printf("],\"summary\":{\"packages\":%d,\"installed\":%d,\"reused\":%d}}\n",
                   self->nrecs, ninst, nreuse);
        } else if (self->quiet) {
            for (i = 0; i < self->nrecs; i++)
                printf("%s %s %s@%s\n", self->recs[i].name, self->recs[i].version,
                       self->recs[i].url, self->recs[i].version);
        } else {
            printf("requested  %s\n", spec);
            for (i = 0; i < self->nrecs; i++) {
                struct PkgRec *r = &self->recs[i];
                printf("resolved   %s %s\n", r->name, r->version);
                printf("  source   %s@%s\n", r->url, r->version);
                if (strcmp(r->tag, "-") != 0) printf("  tag      %s\n", r->tag);
                if (strcmp(r->commit, "-") != 0) printf("  commit   %s\n", r->commit);
                printf("  store    %s\n", r->store);
                printf("  digest   %s\n", r->digest);
                printf("  action   %s\n", r->action);
            }
            printf("%d package(s): %d installed, %d reused\n",
                   self->nrecs, ninst, nreuse);
        }
        return 0;
    }

    /* `ct install`: verify the lock against the shared store and the project
       manifest, then print one `ct build` command that carries every package's
       include root and build metadata. Offline, no subprocess. */
    int install(const char *prog)
    {
        FILE *f;
        DIR *d;
        struct dirent *e;
        struct stat st;
        char pname[MAX_TEXT], pver[32], pdeps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char lname[MAX_PKG_DEPS][MAX_TEXT], lver[MAX_PKG_DEPS][32];
        char lns[MAX_PKG_DEPS][MAX_TEXT], ldig[MAX_PKG_DEPS][80];
        char vdir[MAX_PKG_PATH], cf[MAX_TEXT], lf[MAX_TEXT], rq[MAX_TEXT];
        char ipath[MAX_PKG_DEPS][MAX_PKG_PATH];
        char allcf[MAX_PKG_CMD], alldf[MAX_PKG_CMD], qcf[MAX_PKG_CMD], qlf[MAX_PKG_CMD];
        char dpath[MAX_PKG_PATH], drange[32], dname[MAX_TEXT];
        char iline[MAX_PKG_LINE], imp[MAX_TEXT], rel[MAX_PKG_PATH], cand[MAX_PKG_PATH];
        int ndeps, nlock, i, j, rc, units, seen;
        size_t nl;
        (void)self;

        ndeps = 0;
        nlock = 0;
        rc = 0;
        units = 0;
        /* a missing manifest reads differently from an incomplete one, and both
           are pinned diagnostics (L2 opens first, then parses) */
        f = fopen("./ct.pkg", "r");
        if (!f) {
            fprintf(stderr, "ctc: cannot open './ct.pkg'\n");
            return 1;
        }
        fclose(f);
        if (self->read_manifest(".", pname, sizeof pname, pver, sizeof pver, pdeps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
            return 1;
        }
        if (pkg_verify_lock(prog, lname, lver, lns, ldig, &nlock) != 0) return 1;

        for (i = 0; i < ndeps; i++) {
            if (self->split_spec(pdeps[i], dpath, sizeof dpath, drange, sizeof drange) != 0
                || self->dep_name(pdeps[i], dname, sizeof dname) != 0) {
                fprintf(stderr, "ctc: bad dependency '%s'\n", pdeps[i]);
                rc = 1;
                continue;
            }
            seen = 0;
            for (j = 0; j < nlock; j++) {
                const char *ls = strrchr(lname[j], '/');
                if ((strcmp(lname[j], dname) == 0
                     || (ls != NULL && strcmp(ls + 1, dname) == 0))
                    && self->range_match(drange, lver[j]))
                    seen = 1;
            }
            if (!seen) {
                fprintf(stderr, "ctc: dependency '%s' is not satisfied by ct.lock\n", pdeps[i]);
                rc = 1;
            }
        }
        if (rc != 0) return 1;

        allcf[0] = 0;
        alldf[0] = 0;
        for (i = 0; i < nlock; i++) {
            /* S7: every lock row is store-backed; the version directory plus
               the declared ns-root is the include root. */
            if (pkg_store_pkgdir(lname[i], lver[i], vdir, sizeof vdir) != 0) return 1;
            if (strcmp(lns[i], ".") == 0)
                snprintf(ipath[i], sizeof ipath[i], "%s", vdir);
            else if (snprintf(ipath[i], sizeof ipath[i], "%s/%s", vdir, lns[i])
                     >= (int)sizeof ipath[i]) return 1;
            if (pkg_read_meta(vdir, cf, sizeof cf, lf, sizeof lf, rq, sizeof rq) != 0) {
                fprintf(stderr, "ctc: package '%s' has metadata that does not fit\n", lname[i]);
                return 1;
            }
            if (pkg_check_requires(lname[i], rq) != 0) {
                if (!self->force) {
                    fprintf(stderr, "ctc: use --force to install anyway\n");
                    return 1;
                }
                fprintf(stderr, "ctc: continuing despite the requires mismatch (--force)\n");
            }
            if (pkg_append_words(allcf, sizeof allcf, cf) != 0
                || pkg_append_words(alldf, sizeof alldf, lf) != 0) {
                fprintf(stderr, "ctc: package flags are too long\n");
                return 1;
            }
        }

        /* PKG-6: `install` promises a command that can build. Resolve every
           `import a::b` in the project units against the same roots the
           printed `-I` list will hand to `ct build`; a miss is a failed
           install, not a successful hint. */
        d = opendir(".");
        if (d) {
            for (;;) {
                e = readdir(d);
                if (e == NULL) break;
                nl = strlen(e->d_name);
                if (nl <= 3 || strcmp(e->d_name + nl - 3, ".ct") != 0) continue;
                f = fopen(e->d_name, "r");
                if (f == NULL) continue;
                while (fgets(iline, sizeof iline, f) != NULL) {
                    char *p = iline, *q = imp;
                    while (*p == ' ' || *p == '\t') p++;
                    if (strncmp(p, "import", 6) != 0) continue;
                    p += 6;
                    if (*p != ' ' && *p != '\t') continue;
                    while (*p == ' ' || *p == '\t') p++;
                    while (*p && *p != ';' && *p != ' ' && *p != '\t'
                           && *p != '\n' && *p != '\r') {
                        if (q - imp + 1 >= (int)sizeof imp) break;
                        *q++ = *p++;
                    }
                    *q = 0;
                    if (!imp[0]) continue;
                    q = rel;
                    for (p = imp; *p; p++) {
                        if (*p == ':' && p[1] == ':') {
                            *q++ = '/';
                            p++;
                        } else {
                            *q++ = *p;
                        }
                        if (q - rel + 1 >= (int)sizeof rel) break;
                    }
                    *q = 0;
                    seen = 0;
                    if (snprintf(cand, sizeof cand, "%s.h.ct", rel) < (int)sizeof cand
                        && stat(cand, &st) == 0 && S_ISREG(st.st_mode)) seen = 1;
                    if (!seen && snprintf(cand, sizeof cand, "%s.ct", rel) < (int)sizeof cand
                        && stat(cand, &st) == 0 && S_ISREG(st.st_mode)) seen = 1;
                    for (j = 0; !seen && j < nlock; j++) {
                        if (snprintf(cand, sizeof cand, "%s/%s.h.ct", ipath[j], rel)
                            < (int)sizeof cand
                            && stat(cand, &st) == 0 && S_ISREG(st.st_mode)) seen = 1;
                        if (!seen
                            && snprintf(cand, sizeof cand, "%s/%s.ct", ipath[j], rel)
                               < (int)sizeof cand
                            && stat(cand, &st) == 0 && S_ISREG(st.st_mode)) seen = 1;
                    }
                    if (!seen) {
                        fprintf(stderr, "ctc: '%s' cannot resolve import '%s'\n",
                                e->d_name, rel);
                        rc = 1;
                    }
                }
                fclose(f);
            }
            closedir(d);
        }
        if (rc != 0) return 1;

        printf("%s build", prog);
        /* v2 lock: `ct build` adds the lock roots itself, and printing them
           again collides with the dev-override root (SH-83). */
        if (allcf[0]) {
            if (self->sh_quote(allcf, qcf, sizeof qcf) != 0) return 1;
            printf(" --cflags %s", qcf);
        }
        if (alldf[0]) {
            if (self->sh_quote(alldf, qlf, sizeof qlf) != 0) return 1;
            printf(" --ldflags %s", qlf);
        }
        d = opendir(".");
        if (d) {
            for (;;) {
                e = readdir(d);
                if (e == NULL) break;
                nl = strlen(e->d_name);
                if (nl <= 3 || strcmp(e->d_name + nl - 3, ".ct") != 0) continue;
                if (stat(e->d_name, &st) != 0 || !S_ISREG(st.st_mode)) continue;
                printf(" %s", e->d_name);
                units++;
            }
            closedir(d);
        }
        if (units == 0) printf(" <unit>.ct");
        printf(" -o build\n");
        /* S7: only a v2 lock reaches this point; `pkg_verify_lock` rejects v1
           and points at `ct migrate`. */
        printf("# lock-format: v2\n");
        return 0;
    }

    /* `ct get [--index <path>] <spec>[@<range>]`: a local directory or a git
       package; a bare name resolves through the explicit index when one is set. */
    int get_main(int argc, char **argv)
    {
        const char *spec;
        int i;
        (void)self;

        spec = NULL;
        for (i = 0; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s get [--index <path>] [--force] [--refresh] [-q|--quiet] [--json] <spec>[@<range>]\n", self->prog);
                printf("  spec: a local directory (. or / or file://) or a git package\n"
                       "        (official ct/<name> from the built-in pins, a\n"
                       "        <publisher>/<name> via CT_INDEX, or an https URL)\n");
                printf("  --force  get even when a package 'requires' this compiler version\n");
                printf("  --refresh  discard the cached git checkout and fetch it again\n");
                printf("  -q, --quiet  one line per package: name version url\n");
                printf("  --json       machine-readable result on stdout\n");
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (strcmp(argv[i], "--index") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --index needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->index, sizeof self->index, "%s", argv[i]) >= (int)sizeof self->index) {
                    fprintf(stderr, "ctc: index path is too long\n");
                    return 1;
                }
                self->have_index = 1;
                continue;
            }
            if (strcmp(argv[i], "--force") == 0) {
                self->force = 1;
                continue;
            }
            if (strcmp(argv[i], "--refresh") == 0) {
                self->refresh = 1;
                continue;
            }
            if (strcmp(argv[i], "-q") == 0 || strcmp(argv[i], "--quiet") == 0) {
                self->quiet = 1;
                continue;
            }
            if (strcmp(argv[i], "--json") == 0) {
                self->json = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            spec = argv[i];
        }
        if (!spec) {
            fprintf(stderr, "usage: %s get [--index <path>] [--force] <spec>[@<range>]\n", self->prog);
            return 1;
        }
        return self->get(spec, ".");
    }

    /* `ct install` takes no operands: anything but help/version is rejected. */
    int install_main(int argc, char **argv)
    {
        int ai;
        char cdir[MAX_PKG_PATH], cpath[MAX_PKG_PATH], cline[MAX_PKG_LINE];
        char cname[MAX_TEXT], cpub[MAX_TEXT], cver[MAX_TEXT], cns[MAX_TEXT];
        char cqueue[32][MAX_PKG_PATH], ckey[MAX_TEXT], cval[MAX_TEXT], *cp, *ck, *cv, *cq;
        int cqh, cqt, cbads, cfound;
        DIR *cd;
        struct dirent *ce;
        struct stat cst;
        FILE *cf;
        (void)self;

        /* S0: `ct pkg check <dir>` shares this entry point. The AST compiler's
           256-function budget is fully spent, so the read-only audit lives here
           instead of in a unit of its own (see phase54.md §7). */
        if (argc > 1 && strcmp(argv[0], "check") == 0) {
            for (ai = 2; ai < argc; ai++) {
                if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
                    printf("usage: %s pkg check <dir>\n", self->prog);
                    printf("  read-only: PK-1 ct.pkg, PK-2 name/publisher/version/ns-root,\n");
                    printf("  PK-5 ns-root shape, PK-8 no absolute -I in the package tree\n");
                    return 0;
                }
                if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
                    printf("%s v%s\n", self->prog, self->version);
                    return 0;
                }
                if (argv[ai][0] == '-') {
                    fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
                    return 1;
                }
            }
            if (argc != 2) {
                fprintf(stderr, "usage: %s pkg check <dir>\n", self->prog);
                return 1;
            }
            if (snprintf(cpath, sizeof cpath, "%s/ct.pkg", argv[1]) >= (int)sizeof cpath) {
                fprintf(stderr, "ctc: path too long: '%s'\n", argv[1]);
                return 1;
            }
            cf = fopen(cpath, "r");
            if (cf == NULL) {
                fprintf(stderr, "ctc: cannot read '%s'\n", cpath);
                return 1;
            }
            cname[0] = 0; cpub[0] = 0; cver[0] = 0; cns[0] = 0;
            while (fgets(cline, sizeof cline, cf) != NULL) {
                cp = cline;
                while (*cp == ' ' || *cp == '\t') cp++;
                if (*cp == '#' || *cp == '\n' || *cp == '\r' || *cp == 0) continue;
                ck = ckey;
                while (*cp != 0 && *cp != '=' && *cp != ' ' && *cp != '\t' && *cp != '\n') *ck++ = *cp++;
                *ck = 0;
                while (*cp == ' ' || *cp == '\t') cp++;
                if (*cp != '=') continue;
                cp++;
                while (*cp == ' ' || *cp == '\t') cp++;
                cv = cval;
                while (*cp != 0 && *cp != '\n' && *cp != '\r'
                       && *cp != ' ' && *cp != '\t' && *cp != '#') *cv++ = *cp++;
                *cv = 0;
                if (cval[0] == 0) continue;
                if (strcmp(ckey, "name") == 0) snprintf(cname, sizeof cname, "%s", cval);
                else if (strcmp(ckey, "publisher") == 0) snprintf(cpub, sizeof cpub, "%s", cval);
                else if (strcmp(ckey, "version") == 0) snprintf(cver, sizeof cver, "%s", cval);
                else if (strcmp(ckey, "ns-root") == 0) snprintf(cns, sizeof cns, "%s", cval);
            }
            fclose(cf);
            cbads = 0;
            if (cname[0] == 0) {
                fprintf(stderr, "ctc: '%s' is missing 'name'\n", cpath); cbads = 1;
            }
            if (cpub[0] == 0 || strcmp(cpub, "local") == 0) {
                fprintf(stderr, "ctc: '%s' is missing 'publisher'%s\n", cpath,
                        cpub[0] ? " (local is a placeholder)" : "");
                cbads = 1;
            }
            if (cver[0] == 0) {
                fprintf(stderr, "ctc: '%s' is missing 'version'\n", cpath); cbads = 1;
            }
            if (cns[0] == 0) {
                fprintf(stderr, "ctc: '%s' is missing 'ns-root'\n", cpath); cbads = 1;
            }
            if (cbads) return 1;
            if (cns[0] == '/' || strstr(cns, "..") != NULL) {
                fprintf(stderr, "ctc: ns-root '%s' must be a relative path without '..'\n", cns);
                return 1;
            }
            if (snprintf(cdir, sizeof cdir, "%s/%s", argv[1], cns) >= (int)sizeof cdir) {
                fprintf(stderr, "ctc: path too long: '%s/%s'\n", argv[1], cns);
                return 1;
            }
            if (stat(cdir, &cst) != 0 || !S_ISDIR(cst.st_mode)) {
                fprintf(stderr, "ctc: ns-root '%s' of '%s/%s' is not a directory\n", cdir, cpub, cname);
                return 1;
            }
            cfound = 0;
            cqh = 0; cqt = 0;
            snprintf(cqueue[cqt++], MAX_PKG_PATH, "%s", argv[1]);
            while (cqh < cqt && !cfound) {
                cd = opendir(cqueue[cqh]);
                if (cd != NULL) {
                    while ((ce = readdir(cd)) != NULL) {
                        if (strcmp(ce->d_name, ".") == 0 || strcmp(ce->d_name, "..") == 0) continue;
                        if (strcmp(ce->d_name, ".git") == 0
                            || strcmp(ce->d_name, "docs") == 0
                            || strcmp(ce->d_name, "issues") == 0
                            || strcmp(ce->d_name, "battle") == 0
                            || strcmp(ce->d_name, "test") == 0) continue;
                        if (snprintf(cpath, sizeof cpath, "%s/%s", cqueue[cqh], ce->d_name)
                            >= (int)sizeof cpath) continue;
                        if (stat(cpath, &cst) != 0) continue;
                        if (S_ISDIR(cst.st_mode)) {
                            if (cqt < 32) snprintf(cqueue[cqt++], MAX_PKG_PATH, "%s", cpath);
                            continue;
                        }
                        if (!S_ISREG(cst.st_mode) || cst.st_size > 262144) continue;
                        /* Documentation examples are not build inputs. */
                        if (strlen(cpath) > 3 && strcmp(cpath + strlen(cpath) - 3, ".md") == 0)
                            continue;
                        cf = fopen(cpath, "r");
                        if (cf == NULL) continue;
                        while (fgets(cline, sizeof cline, cf) != NULL) {
                            for (cp = cline; (cp = strstr(cp, "-I")) != NULL; cp += 2) {
                                if (cp != cline && cp[-1] != ' ' && cp[-1] != '\t'
                                    && cp[-1] != '"' && cp[-1] != '\'') continue;
                                cq = cp + 2;
                                while (*cq == ' ' || *cq == '\t') cq++;
                                if (*cq == '/') { cfound = 1; break; }
                            }
                            if (cfound) break;
                        }
                        fclose(cf);
                        if (cfound) break;
                    }
                    closedir(cd);
                }
                cqh++;
            }
            if (cfound) {
                fprintf(stderr, "ctc: '%s' contains an absolute -I\n", cpath);
                return 1;
            }
            printf("ok: 4 criteria\n");
            return 0;
        }

        for (ai = 0; ai < argc; ai++) {
            if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
                printf("usage: %s install [--force]\n", self->prog);
                printf("  verify the store against ct.lock and print the suggested build command\n");
                printf("  --force  install even when a package 'requires' this compiler version\n");
                return 0;
            }
            if (strcmp(argv[ai], "--force") == 0) {
                self->force = 1;
                continue;
            }
            if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (argv[ai][0] == '-') {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
                return 1;
            }
            fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
            return 1;
        }
        return self->install(self->prog);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. The state stays
   private to this unit -- a generated header cannot carry the MAX_* macros its
   fixed-size fields need -- so the driver reaches it through the wrappers below
   instead of through a struct accessor. */
static struct Pkg g_pkg;

/* --- PH-77 official pins -------------------------------------------------- */

/* The official packages this compiler trusts without a network round-trip.
   These are compile-time constants (D-010 #4): updating one is part of the
   release checklist, and `test/ast/p77_external.sh` compares the row against
   the published index when the network is available. `ct get std` and
   `ct get ct/std` both land on this one row. */
static int pkg_pin_lookup(const char *name, const char *range,
                          char *ver, size_t vcap, char *url, size_t ucap,
                          char *tag, size_t tcap, char *sha, size_t scap)
{
    static const char *const pnames[] = { "std" };
    static const char *const pvers[]  = { "0.19.0" };
    static const char *const purls[]  = { "https://github.com/ct-pkg/std" };
    static const char *const ptags[]  = { "v0.19.0" };
    static const char *const pshas[]  = {
        "sha256:432086f0ec6c9ef3cdce5e24d465924d207e81d04f97595518d6e7d584ddaa79"
    };
    int i, n;

    n = (int)(sizeof pnames / sizeof pnames[0]);
    for (i = 0; i < n; i++) {
        if (strcmp(name, pnames[i]) != 0) continue;
        /* The table carries one version per name; a range that excludes it is
           a hard error, because no network lookup can widen a pin. */
        if (range && range[0] && !g_pkg.range_match(range, pvers[i])) {
            fprintf(stderr,
                    "ctc: no official version of '%s' satisfies '%s' "
                    "(the built-in pin is %s); use a URL to get another version\n",
                    name, range, pvers[i]);
            return -1;
        }
        if (strlen(pvers[i]) >= vcap || strlen(purls[i]) >= ucap
            || strlen(ptags[i]) >= tcap || strlen(pshas[i]) >= scap)
            return -1;
        snprintf(ver, vcap, "%s", pvers[i]);
        snprintf(url, ucap, "%s", purls[i]);
        snprintf(tag, tcap, "%s", ptags[i]);
        snprintf(sha, scap, "%s", pshas[i]);
        return 0;
    }
    return 1;                       /* not an official package */
}

/* Resolve an official name to its source. An explicit index row that names
   `ct/<name>` wins (D-010 #4); otherwise the built-in pin answers. */
static int pkg_official_resolve(const char *name, char *url, size_t ucap,
                                char *tag, size_t tcap, char *sha, size_t scap)
{
    char full[MAX_TEXT], ver[32], ipub[MAX_TEXT];
    const char *ix;
    int rc;

    ix = g_pkg.have_index ? g_pkg.index : getenv("CT_INDEX");
    if (ix && ix[0]) {
        if (snprintf(full, sizeof full, "ct/%s", name) >= (int)sizeof full) return -1;
        rc = pkg_index_lookup(full, "", url, ucap, tag, tcap, sha, scap,
                              ipub, sizeof ipub);
        if (rc == 0) return 0;
        if (rc == -1) return -1;
    }
    return pkg_pin_lookup(name, "", ver, sizeof ver, url, ucap, tag, tcap, sha, scap);
}


/* --- S1 shared store ------------------------------------------------------ */

/* `publisher` and `ns-root` from `<dir>/ct.pkg`. Missing keys stay empty; the
   store commit turns either absence into a hard error (S1 identity is required
   now that vendor/ is gone). Line syntax matches read_manifest. */
static int pkg_read_identity(const char *dir, char *publisher, size_t pcap,
                             char *nsroot, size_t ncap)
{
    char path[MAX_PKG_PATH];
    char line[MAX_PKG_LINE];
    FILE *f;

    publisher[0] = 0;
    nsroot[0] = 0;
    if (snprintf(path, sizeof path, "%s/ct.pkg", dir) >= (int)sizeof path) return -1;
    f = fopen(path, "r");
    if (!f) return -1;
    while (fgets(line, sizeof line, f) != NULL) {
        char *ls, *eq, *v, *ve;
        size_t kl, vl;
        ls = line;
        while (*ls == ' ' || *ls == '\t') ls++;
        if (*ls == 0 || *ls == '#' || *ls == '\n' || *ls == '\r') continue;
        eq = strchr(ls, '=');
        if (!eq) continue;
        v = eq + 1;
        while (*v == ' ' || *v == '\t') v++;
        ve = v + strlen(v);
        while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t'
                          || ve[-1] == '\n' || ve[-1] == '\r')) ve--;
        vl = (size_t)(ve - v);
        while (eq > ls && (eq[-1] == ' ' || eq[-1] == '\t')) eq--;
        kl = (size_t)(eq - ls);
        if (kl == 9 && strncmp(ls, "publisher", 9) == 0) {
            if (vl >= pcap) { fclose(f); return -1; }
            memcpy(publisher, v, vl); publisher[vl] = 0;
        } else if (kl == 7 && strncmp(ls, "ns-root", 7) == 0) {
            if (vl >= ncap) { fclose(f); return -1; }
            memcpy(nsroot, v, vl); nsroot[vl] = 0;
        }
    }
    fclose(f);
    return 0;
}

/* `$CT_HOME` (default `$HOME/.ct`) names the per-user root; the store is
   `<root>/pkg` and a package lands at `<root>/pkg/<publisher>/<name>/<ver>`. */
static int pkg_store_root(char *out, size_t cap)
{
    const char *ct, *home;

    ct = getenv("CT_HOME");
    if (ct && ct[0]) {
        if (snprintf(out, cap, "%s", ct) >= (int)cap) return -1;
        return 0;
    }
    home = getenv("HOME");
    if (!home || !home[0]) {
        fprintf(stderr, "ctc: cannot locate the package store (HOME and CT_HOME are unset)\n");
        return -1;
    }
    if (snprintf(out, cap, "%s/.ct", home) >= (int)cap) return -1;
    return 0;
}

static int pkg_store_dir(const char *publisher, const char *name, const char *ver,
                         char *out, size_t cap)
{
    char root[MAX_PKG_PATH];

    if (pkg_store_root(root, sizeof root) != 0) return -1;
    if (snprintf(out, cap, "%s/pkg/%s/%s/%s", root, publisher, name, ver) >= (int)cap) {
        fprintf(stderr, "ctc: store path is too long for '%s/%s@%s'\n", publisher, name, ver);
        return -1;
    }
    return 0;
}

/* Same as `pkg_store_dir` for a lock row that already spells `<publisher>/<name>`. */
static int pkg_store_pkgdir(const char *full, const char *ver, char *out, size_t cap)
{
    char root[MAX_PKG_PATH];

    if (pkg_store_root(root, sizeof root) != 0) return -1;
    if (snprintf(out, cap, "%s/pkg/%s/%s", root, full, ver) >= (int)cap) {
        fprintf(stderr, "ctc: store path is too long for '%s@%s'\n", full, ver);
        return -1;
    }
    return 0;
}

/* mkdir -p for the store only; `ensure_dir` is one level by design. */
static int pkg_mkdirs(const char *path)
{
    char tmp[MAX_PKG_PATH];
    size_t i, n;
    struct stat st;

    if (snprintf(tmp, sizeof tmp, "%s", path) >= (int)sizeof tmp) return -1;
    n = strlen(tmp);
    for (i = 1; i <= n; i++) {
        if (tmp[i] != '/' && tmp[i] != 0) continue;
        tmp[i] = 0;
        if (tmp[0] && mkdir(tmp, 0755) != 0) {
            if (stat(tmp, &st) != 0 || !S_ISDIR(st.st_mode)) return -1;
        }
        if (i < n) tmp[i] = '/';
    }
    return 0;
}

/* PKG-9: the manifest identity (`publisher` + `ns-root`) must be complete and
   usable before any tree is fetched or committed. Both `get_one` and
   `fetch_git` call this right after `pkg_read_identity`; `pkg_store_commit`
   calls it again as the last line of defence. */
static int pkg_identity_check(const char *src, const char *publisher,
                              const char *name, const char *nsroot)
{
    char nspath[MAX_PKG_PATH];
    struct stat st;

    if (!publisher[0]) {
        fprintf(stderr, "ctc: '%s/ct.pkg' is missing 'publisher'\n", src);
        return -1;
    }
    if (strcmp(publisher, "local") == 0) {
        fprintf(stderr, "ctc: '%s/ct.pkg' is missing 'publisher' (local is a placeholder)\n", src);
        return -1;
    }
    if (strchr(publisher, '/') || strstr(publisher, "..") || strchr(name, '/') || strstr(name, "..")) {
        fprintf(stderr, "ctc: invalid package identity '%s/%s'\n", publisher, name);
        return -1;
    }
    if (!nsroot[0]) {
        fprintf(stderr, "ctc: '%s/ct.pkg' is missing 'ns-root'\n", src);
        return -1;
    }
    if (nsroot[0] == '/' || strstr(nsroot, "..") != NULL) {
        fprintf(stderr, "ctc: ns-root '%s' must be a relative path without '..'\n", nsroot);
        return -1;
    }
    if (snprintf(nspath, sizeof nspath, "%s/%s", src, nsroot) >= (int)sizeof nspath) return -1;
    if (stat(nspath, &st) != 0 || !S_ISDIR(st.st_mode)) {
        fprintf(stderr, "ctc: ns-root '%s' of '%s/%s' is not a directory\n",
                nspath, publisher, name);
        return -1;
    }
    return 0;
}

/* Validate the store identity, commit the tree exactly once and return the
   version directory. A second install of the same version is a no-op when the
   digest matches; a different digest is a hard error and never overwrites. */
static int pkg_store_commit(const char *src, const char *publisher, const char *name,
                            const char *ver, const char *nsroot, const char *dig,
                            char *store, size_t scap)
{
    char parent[MAX_PKG_PATH];
    char existed[80];
    struct stat st;
    size_t n;

    if (pkg_identity_check(src, publisher, name, nsroot) != 0) return -1;
    if (pkg_store_dir(publisher, name, ver, store, scap) != 0) return -1;
    snprintf(parent, sizeof parent, "%s", store);
    n = strlen(parent);
    while (n > 0 && parent[n - 1] != '/') n--;
    if (n > 0) parent[n - 1] = 0;
    if (pkg_mkdirs(parent) != 0) {
        fprintf(stderr, "ctc: cannot create the package store '%s'\n", parent);
        return -1;
    }
    if (stat(store, &st) == 0) {
        if (!S_ISDIR(st.st_mode) || g_pkg.dir_digest(store, existed, sizeof existed) != 0
            || strcmp(existed, dig) != 0) {
            fprintf(stderr, "ctc: store '%s' already exists with a different digest\n", store);
            return -1;
        }
        return 0;                   /* same version, same bytes: no-op */
    }
    if (g_pkg.copy_tree(src, store) != 0) {
        fprintf(stderr, "ctc: cannot store '%s' at '%s'\n", src, store);
        return -1;
    }
    if (g_pkg.dir_digest(store, existed, sizeof existed) != 0
        || strcmp(existed, dig) != 0) {
        fprintf(stderr, "ctc: the stored tree '%s' does not match the source digest\n", store);
        return -1;
    }
    return 0;
}

/* --- `ct update` / `ct verify` helpers (prototypes above) ------------------ */

/* The optional build metadata in `<dir>/ct.pkg`: `cflags`, `ldflags` and
   `requires = ct >= x.y.z`. Missing keys (or a missing manifest) leave the
   buffers empty; a value that does not fit is an error. */
static int pkg_read_meta(const char *dir, char *cflags, size_t ccap,
                         char *ldflags, size_t lcap, char *req, size_t rcap)
{
    char path[MAX_PKG_PATH];
    char line[MAX_PKG_PATH];
    FILE *f;
    int ok;

    cflags[0] = 0;
    ldflags[0] = 0;
    req[0] = 0;
    if (snprintf(path, sizeof path, "%s/ct.pkg", dir) >= (int)sizeof path) return -1;
    f = fopen(path, "r");
    if (!f) return 0;
    ok = 1;
    while (fgets(line, sizeof line, f) != NULL) {
        char *ls, *le, *eq, *k, *v, *ve;
        size_t kl, vl, ll;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        ls = line;
        while (*ls == ' ' || *ls == '\t') ls++;
        if (*ls == 0 || *ls == '#') continue;
        le = ls + strlen(ls);
        eq = ls;
        while (eq < le && *eq != '=') eq++;
        if (eq == le) continue;
        k = eq;
        while (k > ls && (k[-1] == ' ' || k[-1] == '\t')) k = k - 1;
        v = eq + 1;
        while (*v == ' ' || *v == '\t') v++;
        ve = v + strlen(v);
        while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t')) ve = ve - 1;
        kl = (size_t)(k - ls);
        vl = (size_t)(ve - v);
        if (kl == 6 && strncmp(ls, "cflags", 6) == 0) {
            if (vl >= ccap) { ok = 0; break; }
            memcpy(cflags, v, vl);
            cflags[vl] = 0;
        } else if (kl == 7 && strncmp(ls, "ldflags", 7) == 0) {
            if (vl >= lcap) { ok = 0; break; }
            memcpy(ldflags, v, vl);
            ldflags[vl] = 0;
        } else if (kl == 8 && strncmp(ls, "requires", 8) == 0) {
            if (vl >= rcap) { ok = 0; break; }
            memcpy(req, v, vl);
            req[vl] = 0;
        }
    }
    fclose(f);
    return ok ? 0 : -1;
}

/* The legacy-row diagnostic (D-014 #5, contract §3.2/§4.4). `ct get` and
   `ct index verify` both call this so the wording cannot drift. */
static int index_legacy_msg(char *out, size_t cap, const char *spec, const char *ver)
{
    int w = snprintf(out, cap,
                     "index row for '%s %s' is legacy (five fields); "
                     "a six-field row is required", spec, ver);
    return (w < 0 || (size_t)w >= cap) ? -1 : 0;
}

/* Look `name` up in the plain-text index: one entry per line as
   `name version git-url tag sha256:<hex>`. Omitted range / `*` selects the
   newest row; an explicit range uses minimal version selection (the lowest
   satisfying row), the same rule as `git_pick_tag`.
   Returns 0 on a hit, 1 when no index is configured, 2 when the name (or
   range) has no entry, and -1 when a configured index cannot be read.
   PH-83: a resolved five-field (legacy) row is a hard error -- the requested
   spec hit it, so the resolver refuses before any network work (D-014 #5). */
static int pkg_index_lookup(const char *name, const char *range, char *url, size_t ucap,
                            char *tag, size_t tcap, char *sha, size_t scap,
                            char *pub, size_t pcap)
{
    char path[MAX_PKG_PATH], line[MAX_PKG_LINE];
    char ambb[MAX_TEXT], bestpub[MAX_TEXT], bestver[MAX_TEXT];
    const char *ip;
    const char *slash;
    FILE *f;
    int best[3], bestset, found, bad, amb, want_latest, best_legacy;
    size_t ll, plen;

    ip = g_pkg.have_index ? g_pkg.index : getenv("CT_INDEX");
    if (!ip || !ip[0]) return 1;
    if (strlen(ip) >= sizeof path) return -1;
    snprintf(path, sizeof path, "%s", ip);
    f = fopen(path, "r");
    if (!f) {
        fprintf(stderr, "ctc: cannot read the package index '%s'\n", path);
        return -1;
    }
    slash = strrchr(name, '/');
    plen = slash ? (size_t)(slash - name) : 0;
    bestset = 0;
    want_latest = (!range || !range[0] || strcmp(range, "*") == 0);
    found = 0;
    bestpub[0] = 0;
    bestver[0] = 0;
    best_legacy = 0;
    bad = 0;
    amb = 0;
    ambb[0] = 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[8];
        char *p;
        const char *publisher, *rurl, *rtag, *rsha;
        int ntok, match, legacy;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r'
                          || line[ll - 1] == ' ' || line[ll - 1] == '\t')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        p = line;
        while (*p == ' ' || *p == '\t') p++;
        if (*p == 0 || *p == '#') continue;
        ntok = 0;
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 8) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok < 5) continue;
        /* S1 index row: `name version publisher url tag sha256:...`; a row with
           only five fields is the legacy shape and is rejected when selected. */
        legacy = (ntok < 6);
        if (!legacy) {
            publisher = tok[2];
            rurl = tok[3];
            rtag = tok[4];
            rsha = tok[5];
        } else {
            publisher = "";
            rurl = tok[2];
            rtag = tok[3];
            rsha = tok[4];
        }
        if (slash) {
            /* A legacy row has no publisher field, so a qualified request can
               only match its bare name; the row is then rejected as legacy
               (D-014 #5). A six-field row matches on publisher + name. */
            match = (strcmp(tok[0], name) == 0
                     || (!publisher[0] && strcmp(tok[0], slash + 1) == 0)
                     || (publisher[0]
                         && strlen(publisher) == plen
                         && strncmp(publisher, name, plen) == 0
                         && strcmp(tok[0], slash + 1) == 0));
        } else {
            match = (strcmp(tok[0], name) == 0);
        }
        if (!match) continue;
        /* SP-014: a bare name carried by two publishers cannot be guessed. */
        if (!slash && publisher[0]) {
            if (amb && strcmp(ambb, publisher) != 0) {
                fprintf(stderr, "ctc: '%s' is ambiguous; write %s/%s or %s/%s\n",
                        name, ambb, name, publisher, name);
                fclose(f);
                return -1;
            }
            if (!amb) {
                snprintf(ambb, sizeof ambb, "%s", publisher);
                amb = 1;
            }
        }
        /* A legacy row is rejected for being legacy, not for its digest; the
           digest check is a six-field requirement (contract §4.4 IV-5). */
        if (!legacy && !sha_hex_ok(rsha)) {
            bad = 1;
            continue;
        }
        if (range && range[0] && !g_pkg.range_match(range, tok[1])) continue;
        {
            int v[3];
            if (g_pkg.version_parse(tok[1], v) != 0) continue;
            if (!bestset
                || (want_latest ? g_pkg.version_cmp(v, best) > 0
                                : g_pkg.version_cmp(v, best) < 0)) {
                if (!legacy
                    && (strlen(rurl) >= ucap || strlen(rtag) >= tcap
                        || strlen(rsha) >= scap)) {
                    bad = 1;
                    continue;
                }
                best[0] = v[0];
                best[1] = v[1];
                best[2] = v[2];
                snprintf(bestpub, sizeof bestpub, "%s", publisher);
                snprintf(bestver, sizeof bestver, "%s", tok[1]);
                bestset = 1;
                found = 1;
                best_legacy = legacy;
                if (!legacy) {
                    snprintf(url, ucap, "%s", rurl);
                    snprintf(tag, tcap, "%s", rtag);
                    snprintf(sha, scap, "%s", rsha);
                }
            }
        }
    }
    fclose(f);
    if (found) {
        if (best_legacy) {
            char msg[MAX_PKG_LINE];
            index_legacy_msg(msg, sizeof msg, name, bestver);
            fprintf(stderr, "ctc: %s\n", msg);
            return -1;
        }
        if (pub && pcap) snprintf(pub, pcap, "%s", bestpub);
        return 0;
    }
    return bad ? -1 : 2;
}







/* `ct index verify [<file>] [--json] [-q]`: read-only replay of the index's
   structural contract. It never fetches, never spawns, never writes store or
   lock (contract §4.4). Exit 0 valid, 1 bad rows, 2 usage/unreadable.
   PKG-14: the path must be a *regular file*; `stat` runs before `fopen`, so a
   FIFO is never opened (opening it would block), and a read error (`ferror`)
   is exit 2 as well. */
static int pkg_index_verify(int argc, char **argv, const char *prog, const char *version)
{
    char path[MAX_PKG_PATH], line[MAX_PKG_LINE], key[MAX_PKG_LINE];
    char *errs;
    char *seen;
    const char *positional, *ip, *home;
    FILE *f;
    int ai, json, quiet, nerr, cerr, nseen, cseen, rows, valid, lineno, i, rc;

    positional = NULL;
    json = 0;
    quiet = 0;
    for (ai = 0; ai < argc; ai++) {
        if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
            printf("usage: %s index verify [<file>] [--json] [-q]\n", prog);
            printf("  read-only: check field count, identity, tag, digest and duplicates\n");
            printf("  file: <file> > CT_INDEX > $CT_HOME/index/index (single index)\n");
            printf("  exit: 0 valid, 1 bad rows (with line numbers), 2 usage/unreadable\n");
            return 0;
        }
        if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
            printf("%s v%s\n", prog, version);
            return 0;
        }
        if (strcmp(argv[ai], "--json") == 0) {
            json = 1;
            continue;
        }
        if (strcmp(argv[ai], "-q") == 0 || strcmp(argv[ai], "--quiet") == 0) {
            quiet = 1;
            continue;
        }
        if (argv[ai][0] == '-' && argv[ai][1]) {
            fprintf(stderr, "%s: unknown option '%s'\n", prog, argv[ai]);
            return 2;
        }
        if (positional != NULL) {
            fprintf(stderr, "usage: %s index verify [<file>] [--json] [-q]\n", prog);
            return 2;
        }
        positional = argv[ai];
    }
    /* Single-index resolution, same order as I13. */
    if (positional != NULL) {
        ip = positional;
    } else {
        ip = getenv("CT_INDEX");
        if (ip == NULL || !ip[0]) {
            home = getenv("CT_HOME");
            if (home == NULL || !home[0]) home = getenv("HOME");
            if (home == NULL || !home[0]) {
                fprintf(stderr, "%s: no index file and no CT_INDEX/CT_HOME/HOME\n", prog);
                return 2;
            }
            if (snprintf(path, sizeof path, "%s/index/index", home) >= (int)sizeof path) {
                fprintf(stderr, "%s: index path is too long\n", prog);
                return 2;
            }
            ip = path;
        }
    }
    if (strlen(ip) >= sizeof path) {
        fprintf(stderr, "%s: index path is too long\n", prog);
        return 2;
    }
    /* The default branch points `ip` at `path`; copying it onto itself is
       undefined (glibc returns an empty string), so only copy when the two
       differ. This is the Linux CI difference PKG-14 exposed. */
    if (ip != path) snprintf(path, sizeof path, "%s", ip);
    {
        struct stat st;
        if (stat(path, &st) != 0) {
            char msg[MAX_PKG_LINE];
            snprintf(msg, sizeof msg, "cannot read the package index '%s'", path);
            return index_io_fail(prog, path, json, "io", msg);
        }
        if (!S_ISREG(st.st_mode)) {
            char msg[MAX_PKG_LINE];
            snprintf(msg, sizeof msg, "not a regular file: '%s'", path);
            return index_io_fail(prog, path, json, "io", msg);
        }
    }
    f = fopen(path, "r");
    if (f == NULL) {
        char msg[MAX_PKG_LINE];
        snprintf(msg, sizeof msg, "cannot read the package index '%s'", path);
        return index_io_fail(prog, path, json, "io", msg);
    }
    errs = NULL;
    seen = NULL;
    nerr = 0;
    cerr = 0;
    nseen = 0;
    cseen = 0;
    rows = 0;
    valid = 0;
    lineno = 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[8];
        char *p;
        const char *publisher;
        int ntok, dup, bad;
        size_t ll;

        lineno++;
        ll = strlen(line);
        if (ll == sizeof line - 1 && line[ll - 1] != '\n') {
            int c;
            while ((c = fgetc(f)) != EOF && c != '\n') { }
            rows++;
            if (index_err_add(&errs, &nerr, &cerr, lineno, "field-count",
                              "index line is longer than 1023 bytes") != 0) goto oom;
            continue;
        }
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r'
                          || line[ll - 1] == ' ' || line[ll - 1] == '\t')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        p = line;
        while (*p == ' ' || *p == '\t') p++;
        if (*p == 0 || *p == '#') continue;
        rows++;
        ntok = 0;
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 8) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok == 5) {
            char msg[MAX_PKG_LINE];
            index_legacy_msg(msg, sizeof msg, tok[0], tok[1]);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "legacy-five-field", msg) != 0)
                goto oom;
            continue;
        }
        if (ntok != 6) {
            char msg[128];
            snprintf(msg, sizeof msg, "index row has %d fields; six are required", ntok);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "field-count", msg) != 0)
                goto oom;
            continue;
        }
        publisher = tok[2];
        bad = 0;
        if (!index_name_ok(tok[0])) {
            char msg[256];
            snprintf(msg, sizeof msg,
                     "index package name '%s' must match [a-z0-9][a-z0-9-]*", tok[0]);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "identity", msg) != 0) goto oom;
            bad = 1;
        } else if (!publisher[0] || strcmp(publisher, "local") == 0
                   || strchr(publisher, '/') != NULL) {
            char msg[256];
            snprintf(msg, sizeof msg,
                     "index publisher '%s' must be non-empty, not 'local', without '/'",
                     publisher);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "identity", msg) != 0) goto oom;
            bad = 1;
        } else if (!index_version_ok(tok[1])) {
            char msg[256];
            snprintf(msg, sizeof msg,
                     "index version '%s' must be x.y.z", tok[1]);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "identity", msg) != 0) goto oom;
            bad = 1;
        }
        if (bad) continue;
        if (tok[4][0] != 'v' || strcmp(tok[4] + 1, tok[1]) != 0) {
            char msg[256];
            snprintf(msg, sizeof msg, "index tag '%s' must be 'v%s'", tok[4], tok[1]);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "tag-version", msg) != 0) goto oom;
            continue;
        }
        if (!sha_hex_ok(tok[5])) {
            if (index_err_add(&errs, &nerr, &cerr, lineno, "digest",
                              "index digest must be sha256:<64 lowercase hex>") != 0)
                goto oom;
            continue;
        }
        snprintf(key, sizeof key, "%s/%s %s", publisher, tok[0], tok[1]);
        dup = 0;
        for (i = 0; i < nseen; i++) {
            if (strcmp(seen + (size_t)i * MAX_PKG_LINE, key) == 0) {
                dup = 1;
                break;
            }
        }
        if (dup) {
            char msg[512];
            snprintf(msg, sizeof msg, "index row '%s' appears more than once", key);
            if (index_err_add(&errs, &nerr, &cerr, lineno, "duplicate", msg) != 0) goto oom;
            continue;
        }
        if (nseen >= cseen) {
            int nc = cseen ? cseen * 2 : 16;
            char *np = (char *)realloc(seen, (size_t)nc * MAX_PKG_LINE);
            if (np == NULL) goto oom;
            seen = np;
            cseen = nc;
        }
        snprintf(seen + (size_t)nseen * MAX_PKG_LINE, MAX_PKG_LINE, "%s", key);
        nseen++;
        valid++;
    }
    if (ferror(f)) {
        fclose(f);
        if (json) {
            printf("{\"index\":");
            index_json_str(path);
            printf(",\"ok\":false,\"rows\":%d,\"valid\":%d,\"invalid\":%d,"
                   "\"errors\":[", rows, valid, nerr + 1);
            index_json_err_list(errs, nerr);
            if (nerr) putchar(',');
            printf("{\"line\":0,\"kind\":\"io\","
                   "\"message\":\"error reading the package index\"}]}\n");
        } else {
            fprintf(stderr, "%s: error reading the package index '%s'\n", prog, path);
        }
        free(errs);
        free(seen);
        return 2;
    }
    fclose(f);
    if (json) {
        printf("{\"index\":");
        index_json_str(path);
        printf(",\"ok\":%s,\"rows\":%d,\"valid\":%d,\"invalid\":%d,\"errors\":[",
               nerr ? "false" : "true", rows, valid, nerr);
        index_json_err_list(errs, nerr);
        printf("]}\n");
    } else {
        if (!quiet) printf("index: %s\n", path);
        for (i = 0; i < nerr; i++) {
            char *rec = errs + (size_t)i * (size_t)INDEX_ERR_STRIDE;
            int eline;
            memcpy(&eline, rec, sizeof eline);
            printf("line %d: %s: %s\n", eline, rec + INDEX_ERR_KIND_OFF,
                   rec + INDEX_ERR_MSG_OFF);
        }
        if (nerr == 0) {
            if (!quiet) printf("index verify: OK (%d rows)\n", rows);
        } else {
            printf("index verify: FAIL (%d invalid of %d rows)\n", nerr, rows);
        }
    }
    free(errs);
    free(seen);
    rc = nerr ? 1 : 0;
    return rc;

oom:
    fclose(f);
    free(errs);
    free(seen);
    fprintf(stderr, "%s: out of memory while verifying '%s'\n", prog, path);
    return 2;
}

/* Append `src` to `dst` with one separating space; an empty `src` is a no-op. */
static int pkg_append_words(char *dst, size_t cap, const char *src)
{
    size_t dl, sl;

    if (!src || !src[0]) return 0;
    dl = strlen(dst);
    sl = strlen(src);
    if (dl + (dl ? 1 : 0) + sl >= cap) return -1;
    if (dl) {
        dst[dl] = ' ';
        dl++;
    }
    memcpy(dst + dl, src, sl + 1);
    return 0;
}

/* `requires = ct >= x.y.z`: a mismatch blocks `ct install`, because an
   incompatible package would only fail later inside the generated C. */
static int pkg_check_requires(const char *pkg, const char *req)
{
    char work[MAX_TEXT];
    const char *p;
    size_t n;

    p = req;
    while (*p == ' ' || *p == '\t') p++;
    if (*p == 0) return 0;
    /* `ct>=x.y.z` and `ct = x.y.z` are the same clause: the operator may follow
       the name directly, so the separator is not what identifies the compiler. */
    if (!(strncmp(p, "ct", 2) == 0
          && (p[2] == 0 || p[2] == ' ' || p[2] == '\t' || p[2] == '>'
              || p[2] == '<' || p[2] == '=' || p[2] == '^' || p[2] == '~'
              || p[2] == '*'))) {
        /* Only the compiler version belongs here; a package spec written as a
           `requires` is not a version range and would fail confusingly. */
        fprintf(stderr, "ctc: package '%s' has an unsupported requires '%s';"
                        " use dep = pkg@range for package dependencies\n", pkg, req);
        return 0;
    }
    p = p + 2;
    while (*p == ' ' || *p == '\t') p++;
    n = strlen(p);
    if (n == 0) return 0;
    if (n >= sizeof work) {
        fprintf(stderr, "ctc: package '%s' has an unsupported requires '%s';"
                        " use dep = pkg@range for package dependencies\n", pkg, req);
        return 0;
    }
    snprintf(work, sizeof work, "%s", p);
    if (!g_pkg.range_match(work, g_pkg.version)) {
        fprintf(stderr, "ctc: package '%s' requires '%s', but this is v%s\n",
                pkg, req, g_pkg.version);
        return -1;
    }
    return 0;
}

/* Verify every lock entry against the shared store. Returns 0 or 1; the pinned
   diagnostics are shared by `install` and `verify`. S7: a v1 lock is a hard
   error -- there is no vendor/ fallback left -- and points at `ct migrate`. */
static int pkg_verify_lock(const char *prog, char lname[][MAX_TEXT], char lver[][32],
                           char lns[][MAX_TEXT], char ldig[][80], int *nlock)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    char head[64];
    char vdir[MAX_PKG_PATH], vdig[80];
    int rc, i, j;

    *nlock = 0;
    rc = 0;
    f = fopen("./ct.lock", "r");
    if (!f) {
        fprintf(stderr, "ctc: no './ct.lock'; run `%s get` first\n", prog);
        return 1;
    }
    if (fgets(head, sizeof head, f) == NULL) {
        fclose(f);
        fprintf(stderr, "ctc: ct.lock is empty\n");
        return 1;
    }
    if (!(strncmp(head, "# ct-lock 2", 11) == 0
          && (head[11] == '\n' || head[11] == '\r' || head[11] == 0))) {
        fclose(f);
        fprintf(stderr, "ctc: ct.lock is v1 (no '# ct-lock 2' header); run 'ct migrate'\n");
        return 1;
    }
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[12];
        char *p;
        int ntok;
        size_t ll;
        ntok = 0;
        p = line;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 12) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok == 0 || tok[0][0] == '#') continue;
        if (ntok < 7) {
            fprintf(stderr, "ctc: ct.lock row '%s' is not v2; run 'ct migrate'\n", tok[0]);
            rc = 1;
            continue;
        }
        if (*nlock >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: ct.lock lists more than %d packages\n", MAX_PKG_DEPS);
            fclose(f);
            return 1;
        }
        /* v2: <publisher>/<name> <ver> <type> <locator> <commit|-> <ns-root> <digest> */
        snprintf(lname[*nlock], MAX_TEXT, "%s", tok[0]);
        snprintf(lver[*nlock], 32, "%s", tok[1]);
        snprintf(lns[*nlock], MAX_TEXT, "%s", tok[5]);
        snprintf(ldig[*nlock], 80, "%s", tok[6]);
        /* PH-77: the old official identity is a warning, not a failure -- the
           old store still satisfies the row, and `ct update` migrates it. */
        if (strcmp(tok[0], "std/std") == 0)
            fprintf(stderr, "ctc: warning: ct.lock uses the legacy publisher 'std' "
                            "('std/std'); run 'ct update' to migrate it to 'ct/std'\n");
        if (!sha_hex_ok(tok[6])) {
            fprintf(stderr, "ctc: '%s' has an unsupported digest '%s' in ct.lock; re-run '%s get' to regenerate\n", tok[0], tok[6], prog);
            rc = 1;
        } else if (pkg_store_pkgdir(tok[0], tok[1], vdir, sizeof vdir) != 0) {
            rc = 1;
        } else if (g_pkg.dir_digest(vdir, vdig, sizeof vdig) != 0) {
            fprintf(stderr, "ctc: '%s' is not installed at '%s'\n", tok[0], vdir);
            rc = 1;
        } else if (strcmp(vdig, tok[6]) != 0) {
            fprintf(stderr, "ctc: '%s' does not match ct.lock (store %s, lock %s)\n",
                    tok[0], vdig, tok[6]);
            rc = 1;
        }
        *nlock = *nlock + 1;
    }
    if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot read './ct.lock'\n"); return 1; }
    if (*nlock == 0) { fprintf(stderr, "ctc: ct.lock is empty\n"); return 1; }
    /* SP-006/SP-013: one row per package; two rows sharing the bare name are a
       hard error even under different publishers. */
    for (i = 0; i < *nlock; i++)
        for (j = i + 1; j < *nlock; j++) {
            const char *bi = strrchr(lname[i], '/');
            const char *bj = strrchr(lname[j], '/');
            if (strcmp(bi ? bi + 1 : lname[i], bj ? bj + 1 : lname[j]) == 0) {
                fprintf(stderr, "ctc: package '%s' is required twice: %s and %s\n",
                        bi ? bi + 1 : lname[i], lname[i], lname[j]);
                return 1;
            }
        }
    return rc;
}

/* Keep the ct.lock rows `ct get` did not resolve again. One invocation resolves
   one spec, so rewriting the lock from the new rows alone would drop every
   other package ct.pkg already pins; a later `ct update` then re-picks the
   lowest cached tag and silently downgrades them (PKG-2). A row whose name this
   run resolved is dropped instead, so re-getting a package replaces it rather
   than duplicating it. A missing lock is not an error. */
static int pkg_lock_keep(char *dst, size_t cap)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    size_t len, ll, nl;
    int i;

    len = 0;
    dst[0] = 0;
    f = fopen("./ct.lock", "r");
    if (!f) return 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *p;

        p = line;
        while (*p == ' ' || *p == '\t') p++;
        nl = 0;
        while (p[nl] && p[nl] != ' ' && p[nl] != '\t'
               && p[nl] != '\n' && p[nl] != '\r')
            nl++;
        if (nl == 0) continue;
        if (*p == '#') continue;        /* S1: v2 format header */
        {
            const char *base = p;
            size_t bl = nl, j;
            for (j = 0; j < nl; j++) if (p[j] == '/') { base = p + j + 1; bl = nl - j - 1; }
            for (i = 0; i < g_pkg.nseen; i++)
                if (strlen(g_pkg.seen[i]) == bl
                    && memcmp(g_pkg.seen[i], base, bl) == 0) break;
        }
        if (i < g_pkg.nseen) continue;
        ll = strlen(line);
        if (len + ll + 1 > cap) {
            fprintf(stderr, "ctc: ct.lock is too large to merge\n");
            fclose(f);
            return -1;
        }
        memcpy(dst + len, line, ll);
        len += ll;
        dst[len] = 0;
    }
    fclose(f);
    /* a hand-edited lock may lack the final newline; keep the merged rows apart */
    if (len > 0 && dst[len - 1] != '\n') {
        if (len + 2 > cap) {
            fprintf(stderr, "ctc: ct.lock is too large to merge\n");
            return -1;
        }
        dst[len] = '\n';
        dst[len + 1] = 0;
    }
    return 0;
}

/* S3: the v2 update is an offline pin audit. The store is verified and every
   direct dependency must be covered by a row; the pinned rows are written back
   unchanged. PH-77 adds the one migration this command owns: a legacy
   `std/std` row is replaced by the official `ct/std` identity at the pinned
   version, with the old store left in place (D-010 #5). */
static int pkg_update_v2(const char *prog)
{
    FILE *f;
    char buf[MAX_LOCK], out[MAX_LOCK];
    size_t n;
    long sz;
    char pname[MAX_TEXT], pver[32], pdeps[MAX_PKG_DEPS][MAX_PKG_PATH];
    char lname[MAX_PKG_DEPS][MAX_TEXT], lver[MAX_PKG_DEPS][32];
    char lns[MAX_PKG_DEPS][MAX_TEXT], ldig[MAX_PKG_DEPS][80];
    char url[MAX_PKG_CMD], tag[MAX_TEXT], sha[80], oldver[32], newver[32];
    int ndeps, nlock, i, j, seen, rc, outlen, legacy, official;

    ndeps = 0;
    nlock = 0;
    f = fopen("./ct.pkg", "r");
    if (!f) { fprintf(stderr, "ctc: cannot open './ct.pkg'\n"); return 1; }
    fclose(f);
    if (g_pkg.read_manifest(".", pname, sizeof pname, pver, sizeof pver,
                            pdeps, &ndeps) != 0) {
        fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
        return 1;
    }
    if (pkg_verify_lock(prog, lname, lver, lns, ldig, &nlock) != 0) return 1;
    rc = 0;
    for (i = 0; i < ndeps; i++) {
        char path[MAX_PKG_PATH], range[32], dname[MAX_TEXT];
        if (g_pkg.split_spec(pdeps[i], path, sizeof path, range, sizeof range) != 0
            || g_pkg.dep_name(pdeps[i], dname, sizeof dname) != 0) {
            fprintf(stderr, "ctc: bad dependency '%s'\n", pdeps[i]);
            rc = 1;
            continue;
        }
        seen = 0;
        for (j = 0; j < nlock; j++) {
            const char *ls = strrchr(lname[j], '/');
            if ((strcmp(lname[j], dname) == 0
                 || (ls != NULL && strcmp(ls + 1, dname) == 0))
                && g_pkg.range_match(range, lver[j]))
                seen = 1;
        }
        if (!seen) {
            fprintf(stderr, "ctc: dependency '%s' is not satisfied by ct.lock\n", pdeps[i]);
            rc = 1;
        }
    }
    if (rc != 0) return 1;
    f = fopen("./ct.lock", "r");
    if (!f) { fprintf(stderr, "ctc: no './ct.lock'; run `%s get` first\n", prog); return 1; }
    if (fseek(f, 0, SEEK_END) != 0 || (sz = ftell(f)) < 0
        || (size_t)sz >= sizeof buf || fseek(f, 0, SEEK_SET) != 0) {
        fprintf(stderr, "ctc: ct.lock is too large to update\n");
        fclose(f);
        return 1;
    }
    n = fread(buf, 1, (size_t)sz, f);
    fclose(f);
    if (n != (size_t)sz) { fprintf(stderr, "ctc: cannot read './ct.lock'\n"); return 1; }
    buf[n] = 0;

    /* PH-77: a legacy `std/std` row (the old publisher) is migrated in place.
       The old store and its digest are left untouched; only the identity of
       the pin changes, so a rollback to the old lock still builds. */
    legacy = 0;
    official = 0;
    {
        char *p = buf;
        while (*p) {
            if (strncmp(p, "std/std ", 8) == 0) legacy = 1;
            else if (strncmp(p, "ct/std ", 7) == 0) official = 1;
            while (*p && *p != '\n') p++;
            if (*p == '\n') p++;
        }
    }
    if (!legacy) {
        f = fopen("./ct.lock", "w");
        if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        fputs(buf, f);
        if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        printf("updated %d package(s)\n", nlock);
        return 0;
    }
    if (official) {
        fprintf(stderr, "ctc: ct.lock pins both 'std/std' and 'ct/std'; "
                        "remove one row before migrating\n");
        return 1;
    }
    oldver[0] = 0;
    {
        char *p = buf;
        while (*p) {
            if (strncmp(p, "std/std ", 8) == 0) {
                sscanf(p + 8, "%31s", oldver);
                break;
            }
            while (*p && *p != '\n') p++;
            if (*p == '\n') p++;
        }
    }
    if (pkg_official_resolve("std", url, sizeof url, tag, sizeof tag,
                             sha, sizeof sha) != 0) {
        fprintf(stderr, "ctc: cannot resolve the official pin for 'std'\n");
        return 1;
    }
    g_pkg.locklen = 0;
    g_pkg.lock[0] = 0;
    g_pkg.nlocks = 0;
    g_pkg.nseen = 0;
    g_pkg.nrecs = 0;
    if (g_pkg.fetch_git(url, "std", "ct", "", tag, sha, 0) != 0) {
        fprintf(stderr, "ctc: cannot migrate 'std/std' to the official pin\n");
        return 1;
    }
    if (g_pkg.nrecs == 0) {
        fprintf(stderr, "ctc: cannot migrate 'std/std': the official pin produced no row\n");
        return 1;
    }
    snprintf(newver, sizeof newver, "%s", g_pkg.recs[g_pkg.nrecs - 1].version);
    outlen = 0;
    out[0] = 0;
    {
        char *p = buf;
        while (*p) {
            char *e = p;
            size_t ll;
            while (*e && *e != '\n') e++;
            ll = (size_t)(e - p) + (*e == '\n' ? 1u : 0u);
            if (strncmp(p, "std/std ", 8) == 0) {
                size_t nl2 = strlen(g_pkg.lock);
                if (outlen + (int)nl2 >= (int)sizeof out) {
                    fprintf(stderr, "ctc: ct.lock is too large to migrate\n");
                    return 1;
                }
                memcpy(out + outlen, g_pkg.lock, nl2);
                outlen += (int)nl2;
            } else {
                if (outlen + (int)ll >= (int)sizeof out) {
                    fprintf(stderr, "ctc: ct.lock is too large to migrate\n");
                    return 1;
                }
                memcpy(out + outlen, p, ll);
                outlen += (int)ll;
            }
            out[outlen] = 0;
            p = e;
            if (*p == '\n') p++;
        }
    }
    f = fopen("./ct.lock", "w");
    if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
    fputs(out, f);
    if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
    printf("migrate std/std %s -> ct/std %s\n", oldver, newver);
    printf("updated %d package(s)\n", nlock);
    return 0;
}

/* `ct update`: S7 makes this a store-backed pin audit. The old no-lock path
   re-resolved ct.pkg and copied every dependency into `vendor/`; that write
   path is gone, so update now needs a v2 lock and only verifies it in place. */
static int pkg_update(const char *prog)
{
    (void)prog;
    return pkg_update_v2(prog);
}

/* PH-71-R3: `ct.pkg` may opt into strict verification per package
   (`strict = on`). The CLI flag still wins; absent/off keeps today's default. */
static int manifest_strict_default(void)
{
    FILE *f;
    char line[MAX_PKG_LINE];

    f = fopen("./ct.pkg", "r");
    if (f == NULL) return 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *p = line;
        char *eq;
        size_t kl;
        while (*p == ' ' || *p == '\t') p++;
        if (*p == 0 || *p == '#') continue;
        eq = strchr(p, '=');
        if (eq == NULL) continue;
        kl = (size_t)(eq - p);
        while (kl > 0 && (p[kl - 1] == ' ' || p[kl - 1] == '\t')) kl--;
        if (kl != 6 || strncmp(p, "strict", 6) != 0) continue;
        p = eq + 1;
        while (*p == ' ' || *p == '\t') p++;
        fclose(f);
        return (strncmp(p, "on", 2) == 0 || strncmp(p, "true", 4) == 0
                || strncmp(p, "1", 1) == 0) ? 1 : 0;
    }
    fclose(f);
    return 0;
}

/* SP-016: `--strict` refuses a lock that still depends on a dev override
   (`dir` row) and a v1 lock (no vendor fallback is left). The store digest
   check follows. */
static int pkg_verify_strict(void)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    char head[64];
    int fmt;

    f = fopen("./ct.lock", "r");
    if (f == NULL) return 0;            /* pkg_verify_lock reports the missing lock */
    fmt = 1;
    if (fgets(head, sizeof head, f) != NULL
        && strncmp(head, "# ct-lock 2", 11) == 0
        && (head[11] == '\n' || head[11] == '\r' || head[11] == 0))
        fmt = 2;
    else
        rewind(f);
    if (fmt == 1) {
        fprintf(stderr, "ctc: ct.lock is v1 (no '# ct-lock 2' header); run 'ct migrate'\n");
        fclose(f);
        return 1;
    }
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[12];
        char *p;
        int ntok;
        size_t ll;
        ntok = 0;
        p = line;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 12) { tok[ntok] = p; ntok++; }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) { *p = 0; p++; }
        }
        if (ntok >= 7 && strcmp(tok[2], "dir") == 0) {
            fprintf(stderr, "ctc: '%s' is a dev override (dir row); --strict requires a store-backed lock\n",
                    tok[0]);
            fclose(f);
            return 1;
        }
    }
    fclose(f);
    return 0;
}

/* SP-029: rewrite a v1 lock as v2 and put every vendored tree into the store.
   The vendor copy is the source of truth (and stays in place); the new rows are
   store-backed (`git - -`) so a later build does not need vendor/. */
static int pkg_migrate(const char *prog)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    char head[64];
    char out[MAX_LOCK];
    int outlen, nrow, fmt, i, rc;
    char mname[MAX_TEXT], mver[32];
    char deps[MAX_PKG_DEPS][MAX_PKG_PATH];
    char publisher[MAX_TEXT], nsroot[MAX_PKG_PATH];
    char src[MAX_PKG_PATH], dig[80], store[MAX_PKG_PATH];
    char name[MAX_TEXT], ver[32], typ[16], commit[64];
    int ndeps;
    struct stat st;

    outlen = 0;
    out[0] = 0;
    f = fopen("./ct.lock", "r");
    if (f == NULL) {
        fprintf(stderr, "ctc: no './ct.lock'; nothing to migrate\n");
        return 1;
    }
    fmt = 1;
    if (fgets(head, sizeof head, f) != NULL
        && strncmp(head, "# ct-lock 2", 11) == 0
        && (head[11] == '\n' || head[11] == '\r' || head[11] == 0))
        fmt = 2;
    else
        rewind(f);
    if (fmt == 2) {
        fprintf(stderr, "ctc: ct.lock is already v2; nothing to migrate\n");
        fclose(f);
        return 1;
    }
    nrow = 0;
    rc = 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[12];
        char *p;
        int ntok, w;
        size_t ll;
        ntok = 0;
        p = line;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 12) { tok[ntok] = p; ntok++; }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) { *p = 0; p++; }
        }
        if (ntok == 0 || tok[0][0] == '#' || ntok < 5) continue;
        snprintf(name, sizeof name, "%s", tok[0]);
        snprintf(ver, sizeof ver, "%s", tok[1]);
        snprintf(typ, sizeof typ, "%s", tok[2]);
        commit[0] = 0;
        if (strcmp(typ, "git") == 0) snprintf(commit, sizeof commit, "%s", tok[3]);
        snprintf(dig, sizeof dig, "%s", tok[ntok - 1]);
        if (snprintf(src, sizeof src, "./vendor/%s", name) >= (int)sizeof src) {
            fprintf(stderr, "ctc: package path too long for '%s'\n", name);
            rc = 1;
            continue;
        }
        if (stat(src, &st) != 0 || !S_ISDIR(st.st_mode)) {
            fprintf(stderr, "ctc: '%s' is locked but not vendored at '%s'\n", name, src);
            rc = 1;
            continue;
        }
        ndeps = 0;
        if (g_pkg.read_manifest(src, mname, sizeof mname, mver, sizeof mver,
                                deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", src);
            rc = 1;
            continue;
        }
        if (strcmp(mname, name) != 0 || strcmp(mver, ver) != 0) {
            fprintf(stderr, "ctc: '%s/ct.pkg' names '%s %s', lock says '%s %s'\n",
                    src, mname, mver, name, ver);
            rc = 1;
            continue;
        }
        if (pkg_read_identity(src, publisher, sizeof publisher,
                              nsroot, sizeof nsroot) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", src);
            rc = 1;
            continue;
        }
        if (g_pkg.dir_digest(src, store, sizeof store) != 0
            || strcmp(store, dig) != 0) {
            fprintf(stderr, "ctc: '%s' does not match ct.lock\n", name);
            rc = 1;
            continue;
        }
        if (pkg_store_commit(src, publisher, name, ver, nsroot, dig,
                             store, sizeof store) != 0) {
            rc = 1;
            continue;
        }
        w = snprintf(out + outlen, sizeof out - (size_t)outlen,
                     "%s/%s %s git - %s %s %s\n", publisher, name, ver,
                     commit[0] ? commit : "-", nsroot, dig);
        if (w < 0 || (size_t)w >= sizeof out - (size_t)outlen) {
            fprintf(stderr, "ctc: ct.lock is too large to migrate\n");
            fclose(f);
            return 1;
        }
        outlen += w;
        nrow++;
    }
    fclose(f);
    if (rc != 0) return 1;
    if (nrow == 0) {
        fprintf(stderr, "ctc: ct.lock is empty\n");
        return 1;
    }
    f = fopen("./ct.lock", "w");
    if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
    fputs("# ct-lock 2\n", f);
    fputs(out, f);
    if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
    printf("migrated %d package(s)\n", nrow);
    (void)i;
    (void)prog;
    return 0;
}

/* `ct verify`: the offline half of install -- no manifest, no command. */
static int pkg_verify(const char *prog, int strict)
{
    char lname[MAX_PKG_DEPS][MAX_TEXT], lver[MAX_PKG_DEPS][32];
    char lns[MAX_PKG_DEPS][MAX_TEXT], ldig[MAX_PKG_DEPS][80];
    int nlock;

    if (strict && pkg_verify_strict() != 0) return 1;
    if (pkg_verify_lock(prog, lname, lver, lns, ldig, &nlock) != 0) return 1;
    printf("verified %d package(s)\n", nlock);
    return 0;
}

/* ---- S0: lock format recognition -------------------------------------- */

/* S2: the build-time lock reader. The driver calls this before `build_main`
   and appends every root as an explicit `-I` (after the user's own flags), so
   import resolution and the existing duplicate/clash rules stay unchanged.
   `locked` is `--locked`: store presence and digest are then strict. */
pub int ct_pkg_lock_roots(const char *prog, int locked, char *roots, int *nroots, char *notes, int *nnotes);
int ct_pkg_lock_roots(const char *prog, int locked, char *roots, int *nroots, char *notes, int *nnotes)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    char head[64];
    char full[MAX_PKG_DEPS][MAX_PKG_PATH];
    char bare[MAX_PKG_DEPS][MAX_TEXT];
    char ver[MAX_PKG_DEPS][32];
    char typ[MAX_PKG_DEPS][16];
    char loc[MAX_PKG_DEPS][MAX_PKG_PATH];
    char nsr[MAX_PKG_DEPS][MAX_PKG_PATH];
    char dig[MAX_PKG_DEPS][80];
    int nrow, fmt, i, j;
    struct stat st;

    *nroots = 0;
    *nnotes = 0;
    f = fopen("./ct.lock", "r");
    if (f == NULL) {
        if (locked) {
            fprintf(stderr, "ctc: no './ct.lock'; --locked needs a lock\n");
            return 1;
        }
        /* S7: vendor/ is no longer a build input. A project without a lock
           simply has no lock roots; explicit `-I` still works. */
        return 0;
    }
    fmt = 1;
    if (fgets(head, sizeof head, f) != NULL
        && strncmp(head, "# ct-lock 2", 11) == 0
        && (head[11] == '\n' || head[11] == '\r' || head[11] == 0))
        fmt = 2;
    else
        rewind(f);
    if (fmt == 1) {
        fprintf(stderr, "ctc: ct.lock is v1 (no '# ct-lock 2' header); run 'ct migrate'\n");
        fclose(f);
        return 1;
    }
    nrow = 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[12];
        char *p;
        int ntok;
        size_t ll;
        ntok = 0;
        p = line;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 12) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok == 0 || tok[0][0] == '#' || ntok < 4) continue;
        if (nrow >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: ct.lock lists more than %d packages\n", MAX_PKG_DEPS);
            fclose(f);
            return 1;
        }
        snprintf(full[nrow], MAX_PKG_PATH, "%s", tok[0]);
        {
            const char *ls = strrchr(tok[0], '/');
            snprintf(bare[nrow], MAX_TEXT, "%s", ls ? ls + 1 : tok[0]);
        }
        snprintf(ver[nrow], 32, "%s", tok[1]);
        typ[nrow][0] = 0;
        loc[nrow][0] = 0;
        nsr[nrow][0] = 0;
        dig[nrow][0] = 0;
        if (ntok >= 7) {
            snprintf(typ[nrow], 16, "%s", tok[2]);
            snprintf(loc[nrow], MAX_PKG_PATH, "%s", tok[3]);
            snprintf(nsr[nrow], MAX_PKG_PATH, "%s", tok[5]);
            snprintf(dig[nrow], 80, "%s", tok[6]);
        }
        nrow++;
    }
    fclose(f);
    if (nrow == 0) {
        fprintf(stderr, "ctc: ct.lock is empty\n");
        return 1;
    }
    /* SP-006/SP-013: the graph pins one version per package, so two rows with
       the same bare name (any publisher) are a hard error before any store
       lookup can mask it. */
    for (i = 0; i < nrow; i++)
        for (j = i + 1; j < nrow; j++)
            if (strcmp(bare[i], bare[j]) == 0) {
                fprintf(stderr, "ctc: package '%s' is required twice: %s and %s\n",
                        bare[i], full[i], full[j]);
                return 1;
            }
    for (i = 0; i < nrow; i++) {
        if (typ[i][0] == 0) {
            fprintf(stderr, "ctc: ct.lock row '%s' has no source type; run 'ct migrate'\n",
                    full[i]);
            return 1;
        }
        if (strcmp(typ[i], "dir") == 0) {
            if (strcmp(nsr[i], ".") == 0)
                snprintf(roots + (*nroots) * 512, 512, "%s", loc[i]);
            else
                snprintf(roots + (*nroots) * 512, 512, "%s/%s", loc[i], nsr[i]);
            snprintf(notes + (*nnotes) * 512, 512,
                     "'%s' resolves to the local directory (dev override): %s",
                     full[i], loc[i]);
            (*nnotes)++;
            (*nroots)++;
        } else if (strcmp(typ[i], "git") == 0) {
            char sdir[MAX_PKG_PATH], sdig[80];
            if (pkg_store_pkgdir(full[i], ver[i], sdir, sizeof sdir) != 0) return 1;
            if (stat(sdir, &st) != 0 || !S_ISDIR(st.st_mode)) {
                fprintf(stderr, "ctc: '%s' is not installed at '%s'\n", full[i], sdir);
                return 1;
            }
            if (locked) {
                if (g_pkg.dir_digest(sdir, sdig, sizeof sdig) != 0
                    || strcmp(sdig, dig[i]) != 0) {
                    fprintf(stderr, "ctc: '%s' does not match ct.lock\n", full[i]);
                    return 1;
                }
            }
            if (strcmp(nsr[i], ".") == 0)
                snprintf(roots + (*nroots) * 512, 512, "%s", sdir);
            else
                snprintf(roots + (*nroots) * 512, 512, "%s/%s", sdir, nsr[i]);
            (*nroots)++;
        } else {
            fprintf(stderr, "ctc: ct.lock row '%s' has an unknown source type '%s'\n",
                    full[i], typ[i]);
            return 1;
        }
    }
    (void)prog;
    return 0;
}
/* Only primitives cross the unit boundary (the same shape L2 uses for core.ct):
   the driver hands over its name and the version string, then dispatches. */
pub int ct_pkg_get(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_get(int argc, char **argv, const char *prog, const char *version)
{
    g_pkg.prog = prog;
    g_pkg.version = version;
    return g_pkg.get_main(argc, argv);
}

pub int ct_pkg_install(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_install(int argc, char **argv, const char *prog, const char *version)
{
    g_pkg.prog = prog;
    g_pkg.version = version;
    return g_pkg.install_main(argc, argv);
}

pub int ct_pkg_update(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_update(int argc, char **argv, const char *prog, const char *version)
{
    int ai;

    g_pkg.prog = prog;
    g_pkg.version = version;
    for (ai = 0; ai < argc; ai++) {
        if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
            printf("usage: %s update\n", prog);
            printf("  verify the store and every ct.pkg dependency against ct.lock;\n");
            printf("  migrate a legacy 'std/std' pin to the official 'ct/std' identity\n");
            return 0;
        }
        if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
            printf("%s v%s\n", prog, version);
            return 0;
        }
        if (argv[ai][0] == '-') {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
            return 1;
        }
        fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
        return 1;
    }
    return pkg_update(prog);
}

pub int ct_pkg_verify(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_verify(int argc, char **argv, const char *prog, const char *version)
{
    int ai, strict = 0;

    g_pkg.prog = prog;
    g_pkg.version = version;
    for (ai = 0; ai < argc; ai++) {
        if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
            printf("usage: %s verify [--strict]\n", prog);
            printf("  check the store against ct.lock (offline); a legacy 'std/std' pin only warns\n");
            printf("  --strict  reject dir rows\n");
            return 0;
        }
        if (strcmp(argv[ai], "--strict") == 0) {
            strict = 1;
            continue;
        }
        if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
            printf("%s v%s\n", prog, version);
            return 0;
        }
        if (argv[ai][0] == '-') {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
            return 1;
        }
        fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
        return 1;
    }
    if (!strict && manifest_strict_default()) strict = 1;
    return pkg_verify(prog, strict);
}

pub int ct_pkg_migrate(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_migrate(int argc, char **argv, const char *prog, const char *version)
{
    int ai;

    g_pkg.prog = prog;
    g_pkg.version = version;
    for (ai = 0; ai < argc; ai++) {
        if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
            printf("usage: %s migrate\n", prog);
            printf("  move vendor/ packages into the shared store and rewrite ct.lock as v2\n");
            return 0;
        }
        if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
            printf("%s v%s\n", prog, version);
            return 0;
        }
        if (argv[ai][0] == '-') {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
            return 1;
        }
        fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
        return 1;
    }
    return pkg_migrate(prog);
}

pub int ct_index_verify(int argc, char **argv, const char *prog, const char *version);
int ct_index_verify(int argc, char **argv, const char *prog, const char *version)
{
    return pkg_index_verify(argc, argv, prog, version);
}
