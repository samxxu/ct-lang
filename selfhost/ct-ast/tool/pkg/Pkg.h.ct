/*
 * Pkg.h.ct - the package manager (`ct get` / `ct install`), one unit of its own.
 *
 * It is a leaf: it owns its lock/seen state and never touches the AST, so it
 * has no collaborators at all. The whole trait stays in this unit on
 * purpose -- the emitter makes each impl's vtable `static`, and an instance's
 * vptr initialisers can only name vtables its own unit can see, so one struct's
 * impls cannot be spread across units.
 *
 * Macros do not cross units, so the caps this unit needs are declared here;
 * MAX_TEXT 160 is the value `frontend/sym/Symbols.h.ct` lists, the MAX_PKG_*
 * and MAX_LOCK caps are this package manager's own.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <dirent.h>

import tool::sh::Sh;

#define MAX_TEXT       160
#define MAX_LOCK       4096             /* MAX_PKG_PATH * 8, spelled out */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   512
#define MAX_PKG_CMD    2048
#define MAX_PKG_DEPTH  8
#define MAX_PKG_LINE   1024             /* MAX_PKG_PATH * 2, spelled out */

namespace tool::pkg;
/* The package manager (Phase 8, ported in 10.6). `get`/`install` never reach the
   compile core: only `get` may run `git`, and `install` is offline (D42). */
trait PkgOps {
    int  read_manifest(const char *dir, char *name, size_t ncap, char *ver, size_t vcap,
                       char deps[][MAX_PKG_PATH], int *ndeps);
    int  version_parse(const char *s, int v[3]);
    int  version_cmp(const int a[3], const int b[3]);
    int  range_match(const char *range, const char *ver);
    int  copy_file(const char *src, const char *dst);
    int  copy_tree(const char *src, const char *dst);
    int  dir_digest(const char *dir, char *out, size_t cap);
    int  ensure_dir(const char *path);
    int  split_spec(const char *spec, char *path, size_t pcap, char *range, size_t rcap);
    int  is_git_ref(const char *spec);
    int  git_url(const char *spec, char *url, size_t cap);
    int  git_name(const char *spec, char *name, size_t cap);
    int  git_avail(void);
    int  sh_quote(const char *s, char *out, size_t cap);
    int  git_run(const char *cmd, const char *outfile);
    int  read_line_of(const char *path, char *buf, size_t cap);
    int  git_pick_tag(const char *cache, const char *range, char *tag, size_t tcap);
    int  fetch_git(const char *url, const char *name, const char *range,
                   const char *pin_tag, const char *expect_sha, int depth);
    int  get_git(const char *spec, const char *range, int depth);
    int  get_spec(const char *spec, const char *base, int depth);
    int  get_one(const char *dir, const char *range, int depth);
    int  remember_dep(const char *spec);
    int  dep_name(const char *spec, char *name, size_t cap);
    int  get(const char *spec, const char *root);
    int  install(const char *prog);
    int  get_main(int argc, char **argv);
    int  install_main(int argc, char **argv);
}

/* `ct update` / `ct verify` helpers. They are file statics rather than more
   `PkgOps` methods because L2 -- the compiler that builds ct-ast -- caps the
   whole program at MAX_FUNCS 128 (17/128 free here) and MAX_MAP_IMPLS 256
   (2/256 left). They own no per-compile state beyond `g_pkg`, which is one
   unit-wide instance, so a static that names it directly reads the same. */
static int pkg_read_meta(const char *dir, char *cflags, size_t ccap,
                         char *ldflags, size_t lcap, char *req, size_t rcap);
static int pkg_index_lookup(const char *name, const char *range, char *url, size_t ucap,
                            char *tag, size_t tcap, char *sha, size_t scap);
static int pkg_append_words(char *dst, size_t cap, const char *src);
static int pkg_check_requires(const char *pkg, const char *req);
static int pkg_verify_lock(const char *prog, char lname[][MAX_TEXT], char lver[][32],
                           int *nlock);
static int pkg_read_pins(void);
static int pkg_pin_ref(const char *name, char *ref, size_t cap);
static int pkg_lock_keep(char *dst, size_t cap);
static int pkg_update(const char *prog);
static int pkg_verify(const char *prog);

/* The manager's state lives in this struct so the unit owns it outright; `prog`
   and `version` are wired at start-up, which keeps CTC_VERSION defined in
   exactly one place. */
struct Pkg {
    char lock[MAX_LOCK];
    int  locklen;
    int  nlocks;
    char seen[MAX_PKG_DEPS][MAX_TEXT];
    int  nseen;
    /* `ct update` re-reads ct.pkg but keeps the git commits ct.lock already
       pinned; `offline` makes the git path refuse to clone or fetch. */
    char pinname[MAX_PKG_DEPS][MAX_TEXT];
    char pinref[MAX_PKG_DEPS][64];
    int  npins;
    int  offline;
    /* `ct install --force` downgrades a `requires` mismatch to a warning; the
       default is to refuse, so an incompatible package cannot be wired in. */
    int  force;
    /* The optional index: `--index <path>` wins over `CT_INDEX`. Nothing is
       built in -- a package name only resolves through an index the user named. */
    char index[MAX_PKG_PATH];
    int  have_index;
    const char *prog;
    const char *version;
} use PkgOps;

/* --- SHA-256 (FIPS 180-4) -------------------------------------------------
   `ct.lock` pins vendored content, so its digest has to resist collisions.
   FNV-1a plus an additive per-file fold (SH-44) did not: two files could be
   made to cancel out. The tree now hashes as one stream -- each file's
   relative path and bytes, in sorted path order -- and the lock spells the
   result `sha256:<64 hex>`, so a legacy 16-hex value is rejected rather than
   compared loosely. */

#define MAX_DIGEST_FILES 4096

static const char *g_hexd = "0123456789abcdef";

static const unsigned int g_sha_k[64] = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

struct Sha256 {
    unsigned int h[8];
    unsigned int nbuf;
    unsigned long total;
    unsigned char buf[64];
};

#define CT_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))

static void sha256_init(struct Sha256 *s)
{
    s->h[0] = 0x6a09e667;
    s->h[1] = 0xbb67ae85;
    s->h[2] = 0x3c6ef372;
    s->h[3] = 0xa54ff53a;
    s->h[4] = 0x510e527f;
    s->h[5] = 0x9b05688c;
    s->h[6] = 0x1f83d9ab;
    s->h[7] = 0x5be0cd19;
    s->nbuf = 0;
    s->total = 0;
}

static void sha256_block(struct Sha256 *s, const unsigned char *p)
{
    unsigned int w[64];
    unsigned int a, b, c, d, e, f, g, h;
    unsigned int t1, t2, s0, s1;
    int i;

    for (i = 0; i < 16; i++)
        w[i] = ((unsigned int)p[4 * i] << 24)
             | ((unsigned int)p[4 * i + 1] << 16)
             | ((unsigned int)p[4 * i + 2] << 8)
             | (unsigned int)p[4 * i + 3];
    for (i = 16; i < 64; i++) {
        s0 = CT_ROR(w[i - 15], 7) ^ CT_ROR(w[i - 15], 18) ^ (w[i - 15] >> 3);
        s1 = CT_ROR(w[i - 2], 17) ^ CT_ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    a = s->h[0];
    b = s->h[1];
    c = s->h[2];
    d = s->h[3];
    e = s->h[4];
    f = s->h[5];
    g = s->h[6];
    h = s->h[7];
    for (i = 0; i < 64; i++) {
        s1 = CT_ROR(e, 6) ^ CT_ROR(e, 11) ^ CT_ROR(e, 25);
        t1 = h + s1 + ((e & f) ^ ((~e) & g)) + g_sha_k[i] + w[i];
        s0 = CT_ROR(a, 2) ^ CT_ROR(a, 13) ^ CT_ROR(a, 22);
        t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    s->h[0] = s->h[0] + a;
    s->h[1] = s->h[1] + b;
    s->h[2] = s->h[2] + c;
    s->h[3] = s->h[3] + d;
    s->h[4] = s->h[4] + e;
    s->h[5] = s->h[5] + f;
    s->h[6] = s->h[6] + g;
    s->h[7] = s->h[7] + h;
}

static void sha256_update(struct Sha256 *s, const unsigned char *p, size_t n)
{
    size_t i;
    for (i = 0; i < n; i++) {
        s->buf[s->nbuf] = p[i];
        s->nbuf++;
        s->total++;
        if (s->nbuf == 64) {
            sha256_block(s, s->buf);
            s->nbuf = 0;
        }
    }
}

static void sha256_final(struct Sha256 *s)
{
    unsigned char pad[64];
    unsigned long bits;
    unsigned int i;
    int k;

    bits = s->total * 8;
    memset(pad, 0, sizeof pad);
    pad[0] = 128;
    k = (s->nbuf < 56) ? 56 - (int)s->nbuf : 120 - (int)s->nbuf;
    sha256_update(s, pad, (size_t)k);
    for (i = 0; i < 8; i++)
        pad[i] = (unsigned char)((bits >> (56 - 8 * (int)i)) & 255);
    sha256_update(s, pad, 8);
}

static void sha256_hex(const struct Sha256 *s, char *out)
{
    int i, j;
    unsigned int v;
    for (i = 0; i < 8; i++) {
        v = s->h[i];
        for (j = 0; j < 8; j++)
            out[i * 8 + j] = g_hexd[(v >> (28 - 4 * j)) & 15];
    }
    out[64] = 0;
}

/* One file's contribution: its relative path, a newline, then its bytes. The
   path is what `readdir` yielded, so the order is fixed by `sha_sort`. */
static int sha256_file(struct Sha256 *s, const char *rel, const char *path)
{
    FILE *f;
    int c;
    unsigned char b;

    sha256_update(s, (const unsigned char *)rel, strlen(rel));
    b = (unsigned char)'\n';
    sha256_update(s, &b, 1);
    f = fopen(path, "rb");
    if (!f) return -1;
    c = fgetc(f);
    while (c != EOF) {
        b = (unsigned char)c;
        sha256_update(s, &b, 1);
        c = fgetc(f);
    }
    fclose(f);
    return 0;
}

/* Collect the relative paths of every regular file under `dir` into `list`
   (row stride MAX_PKG_PATH); `vendor`, `.git` and `.ctcache` are not part of
   a package, matching what `copy_tree` ships. */
static int sha_collect(const char *dir, const char *rel, char *list, int *n, int cap)
{
    DIR *d;
    struct dirent *e;
    struct stat st;
    char full[MAX_PKG_PATH], r[MAX_PKG_PATH];
    int w;

    d = opendir(dir);
    if (!d) return -1;
    for (;;) {
        e = readdir(d);
        if (e == NULL) break;
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
        if (strcmp(e->d_name, ".git") == 0 || strcmp(e->d_name, "vendor") == 0) continue;
        if (strcmp(e->d_name, ".ctcache") == 0) continue;
        if (snprintf(full, sizeof full, "%s/%s", dir, e->d_name) >= (int)sizeof full) continue;
        if (rel[0]) w = snprintf(r, sizeof r, "%s/%s", rel, e->d_name);
        else        w = snprintf(r, sizeof r, "%s", e->d_name);
        if (w < 0 || (size_t)w >= sizeof r) continue;
        if (stat(full, &st) != 0) continue;
        if (S_ISDIR(st.st_mode)) {
            if (sha_collect(full, r, list, n, cap) != 0) {
                closedir(d);
                return -1;
            }
        } else if (S_ISREG(st.st_mode)) {
            if (*n >= cap) {
                closedir(d);
                return -1;
            }
            snprintf(list + (size_t)(*n) * MAX_PKG_PATH, MAX_PKG_PATH, "%s", r);
            *n = *n + 1;
        }
    }
    closedir(d);
    return 0;
}

/* Insertion sort on the collected rows: the digest must not depend on the
   `readdir` order, which differs between filesystems. */
static void sha_sort(char *list, int n)
{
    char tmp[MAX_PKG_PATH];
    int i, j;

    for (i = 1; i < n; i++) {
        snprintf(tmp, sizeof tmp, "%s", list + (size_t)i * MAX_PKG_PATH);
        j = i - 1;
        while (j >= 0 && strcmp(list + (size_t)j * MAX_PKG_PATH, tmp) > 0) {
            /* A row copy, not a formatted print: gcc cannot see that the two
               rows are disjoint and warns -Wrestrict on the overlapping-looking
               `snprintf`, which the warning-free gate treats as a failure. */
            memcpy(list + (size_t)(j + 1) * MAX_PKG_PATH,
                   list + (size_t)j * MAX_PKG_PATH, MAX_PKG_PATH);
            j--;
        }
        snprintf(list + (size_t)(j + 1) * MAX_PKG_PATH, MAX_PKG_PATH, "%s", tmp);
    }
}

/* `sha256:<64 lowercase hex>` is the only accepted lock spelling (SH-44). */
static int sha_hex_ok(const char *s)
{
    int i;
    if (strncmp(s, "sha256:", 7) != 0) return 0;
    if (strlen(s) != 71) return 0;
    for (i = 7; i < 71; i++) {
        if ((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')) continue;
        return 0;
    }
    return 1;
}

impl PkgOps for Pkg {
    /* Parse `<dir>/ct.pkg`. Line-oriented: `#` starts a comment, `key = value`,
       and `dep` may repeat. A missing name or version is an error. */
    int read_manifest(const char *dir, char *name, size_t ncap, char *ver, size_t vcap,
                      char deps[][MAX_PKG_PATH], int *ndeps)
    {
        char path[MAX_PKG_PATH];
        char line[MAX_PKG_PATH];
        FILE *f;
        int ok;
        (void)self;

        if (snprintf(path, sizeof path, "%s/ct.pkg", dir) >= (int)sizeof path) return -1;
        f = fopen(path, "r");
        if (!f) return -1;
        name[0] = 0;
        ver[0] = 0;
        *ndeps = 0;
        ok = 1;
        while (fgets(line, sizeof line, f) != NULL) {
            char *ls, *le, *eq, *k, *v, *ve;
            size_t kl, vl, ll;
            ll = strlen(line);
            while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
                ll = ll - 1;
                line[ll] = 0;
            }
            ls = line;
            while (*ls == ' ' || *ls == '\t') ls++;
            if (*ls == 0 || *ls == '#') continue;
            le = ls + strlen(ls);
            eq = ls;
            while (eq < le && *eq != '=') eq++;
            if (eq == le) continue;
            k = eq;
            while (k > ls && (k[-1] == ' ' || k[-1] == '\t')) k = k - 1;
            v = eq + 1;
            while (*v == ' ' || *v == '\t') v++;
            ve = v + strlen(v);
            while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t')) ve = ve - 1;
            kl = (size_t)(k - ls);
            vl = (size_t)(ve - v);
            if (kl == 4 && strncmp(ls, "name", 4) == 0) {
                if (vl >= ncap) { ok = 0; break; }
                memcpy(name, v, vl);
                name[vl] = 0;
            } else if (kl == 7 && strncmp(ls, "version", 7) == 0) {
                if (vl >= vcap) { ok = 0; break; }
                memcpy(ver, v, vl);
                ver[vl] = 0;
            } else if (kl == 3 && strncmp(ls, "dep", 3) == 0) {
                if (*ndeps >= MAX_PKG_DEPS || vl >= MAX_PKG_PATH) { ok = 0; break; }
                memcpy(deps[*ndeps], v, vl);
                deps[*ndeps][vl] = 0;
                (*ndeps)++;
            }
        }
        fclose(f);
        if (!ok) return -1;
        return (name[0] && ver[0]) ? 0 : -1;
    }

    int version_parse(const char *s, int v[3])
    {
        int n;
        (void)self;
        v[0] = 0;
        v[1] = 0;
        v[2] = 0;
        n = sscanf(s, "%d.%d.%d", &v[0], &v[1], &v[2]);
        return (n >= 1) ? 0 : -1;
    }

    int version_cmp(const int a[3], const int b[3])
    {
        int i;
        (void)self;
        for (i = 0; i < 3; i++) {
            if (a[i] < b[i]) return -1;
            if (a[i] > b[i]) return 1;
        }
        return 0;
    }

    /* A range is one or more clauses separated by spaces, all of which must hold
       (AND); `||` is deliberately unsupported. A clause is `^x.y.z`, `~x.y.z`,
       `>=x.y.z`, `>x.y.z`, `<x.y.z`, `<=x.y.z`, `=x.y.z`, a bare version (exact)
       or `*`. The operator and its version may be separated by spaces. */
    int range_match(const char *range, const char *ver)
    {
        char work[MAX_TEXT];
        int v[3];
        const char *p;
        size_t n;
        (void)self;

        if (!range || !range[0] || strcmp(range, "*") == 0) return 1;
        n = strlen(range);
        if (n >= sizeof work) return 0;
        memcpy(work, range, n + 1);
        if (self->version_parse(ver, v) != 0) return 0;

        p = work;
        while (*p) {
            char opc;
            char *q;
            char verstr[MAX_TEXT];
            int lo[3], rc;
            size_t vl;

            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            opc = 0;
            if (p[0] == '>' && p[1] == '=') { opc = 'G'; p += 2; }
            else if (p[0] == '<' && p[1] == '=') { opc = 'L'; p += 2; }
            else if (p[0] == '>') { opc = 'g'; p++; }
            else if (p[0] == '<') { opc = 'l'; p++; }
            else if (p[0] == '=') { opc = 'e'; p++; }
            else if (p[0] == '^') { opc = '^'; p++; }
            else if (p[0] == '~') { opc = '~'; p++; }
            while (*p == ' ' || *p == '\t') p++;
            q = (char *)p;
            while (*p && *p != ' ' && *p != '\t') p++;
            vl = (size_t)(p - q);
            if (vl == 0) return 0;
            if (vl == 1 && q[0] == '*') continue;
            if (vl >= sizeof verstr) return 0;
            memcpy(verstr, q, vl);
            verstr[vl] = 0;
            if (self->version_parse(verstr, lo) != 0) return 0;
            rc = self->version_cmp(v, lo);
            if (opc == 0 || opc == 'e') {
                if (rc != 0) return 0;
            } else if (opc == '^') {
                if (v[0] != lo[0] || rc < 0) return 0;
            } else if (opc == '~') {
                if (v[0] != lo[0] || v[1] != lo[1] || rc < 0) return 0;
            } else if (opc == 'G') {
                if (rc < 0) return 0;
            } else if (opc == 'g') {
                if (rc <= 0) return 0;
            } else if (opc == 'L') {
                if (rc > 0) return 0;
            } else if (opc == 'l') {
                if (rc >= 0) return 0;
            }
        }
        return 1;
    }

    int copy_file(const char *src, const char *dst)
    {
        FILE *in, *out;
        char buf[4096];
        size_t n;
        (void)self;

        in = fopen(src, "rb");
        if (!in) return -1;
        out = fopen(dst, "wb");
        if (!out) { fclose(in); return -1; }
        for (;;) {
            n = fread(buf, 1, sizeof buf, in);
            if (n == 0) break;
            if (fwrite(buf, 1, n, out) != n) { fclose(in); fclose(out); return -1; }
        }
        fclose(in);
        if (fclose(out) != 0) return -1;
        return 0;
    }

    /* Copy a package directory; build caches and VCS metadata are not package
       content, so they are skipped rather than vendored. */
    int copy_tree(const char *src, const char *dst)
    {
        DIR *d;
        struct dirent *e;
        struct stat st;
        struct stat ds;
        char s[MAX_PKG_PATH], t[MAX_PKG_PATH];
        int rc;
        (void)self;

        rc = 0;
        if (mkdir(dst, 0755) != 0) {
            if (stat(dst, &ds) != 0 || !S_ISDIR(ds.st_mode)) return -1;
        }
        d = opendir(src);
        if (!d) return -1;
        for (;;) {
            e = readdir(d);
            if (e == NULL) break;
            if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
            if (strcmp(e->d_name, ".git") == 0 || strcmp(e->d_name, "vendor") == 0) continue;
            if (strcmp(e->d_name, ".ctcache") == 0) continue;
            snprintf(s, sizeof s, "%s/%s", src, e->d_name);
            snprintf(t, sizeof t, "%s/%s", dst, e->d_name);
            if (stat(s, &st) != 0) { rc = -1; break; }
            if (S_ISDIR(st.st_mode)) {
                if (self->copy_tree(s, t) != 0) { rc = -1; break; }
            } else if (S_ISREG(st.st_mode)) {
                if (self->copy_file(s, t) != 0) { rc = -1; break; }
            }
        }
        closedir(d);
        return rc;
    }

    /* One digest per tree: every regular file's relative path and bytes feed
       a single SHA-256 in sorted path order, so neither `readdir` order nor an
       additive fold can make two different trees agree (SH-44). */
    int dir_digest(const char *dir, char *out, size_t cap)
    {
        struct Sha256 sha;
        struct stat st;
        char *list;
        char hex[65];
        int i, n, w;
        (void)self;

        if (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode)) return -1;
        list = (char *)malloc((size_t)MAX_DIGEST_FILES * (size_t)MAX_PKG_PATH);
        if (!list) return -1;
        n = 0;
        if (sha_collect(dir, "", list, &n, MAX_DIGEST_FILES) != 0) {
            free(list);
            return -1;
        }
        sha_sort(list, n);
        sha256_init(&sha);
        for (i = 0; i < n; i++) {
            char full[MAX_PKG_PATH];
            if (snprintf(full, sizeof full, "%s/%s", dir, list + (size_t)i * MAX_PKG_PATH)
                >= (int)sizeof full) {
                free(list);
                return -1;
            }
            if (sha256_file(&sha, list + (size_t)i * MAX_PKG_PATH, full) != 0) {
                free(list);
                return -1;
            }
        }
        free(list);
        sha256_final(&sha);
        sha256_hex(&sha, hex);
        w = snprintf(out, cap, "sha256:%s", hex);
        if (w < 0 || (size_t)w >= cap) return -1;
        return 0;
    }

    int ensure_dir(const char *path)
    {
        struct stat st;
        (void)self;
        if (mkdir(path, 0755) == 0) return 0;
        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 0;
        return -1;
    }

    /* `path[@range]`: the last `@` separates the two, so a path may contain one. */
    int split_spec(const char *spec, char *path, size_t pcap, char *range, size_t rcap)
    {
        const char *at, *q;
        size_t n;
        (void)self;

        at = NULL;
        for (q = spec; *q; q++)
            if (*q == '@') at = q;
        if (!at) {
            if (strlen(spec) >= pcap) return -1;
            snprintf(path, pcap, "%s", spec);
            range[0] = 0;
            return 0;
        }
        n = (size_t)(at - spec);
        if (n >= pcap || strlen(at + 1) >= rcap) return -1;
        memcpy(path, spec, n);
        path[n] = 0;
        snprintf(range, rcap, "%s", at + 1);
        return 0;
    }

    /* A spec is a git source unless it names a filesystem location. */
    int is_git_ref(const char *spec)
    {
        (void)self;
        if (spec[0] == '.' || spec[0] == '/') return 0;
        if (strncmp(spec, "file://", 7) == 0) return 0;
        return 1;
    }

    int git_url(const char *spec, char *url, size_t cap)
    {
        const char *reg;
        int w;
        (void)self;

        if (strstr(spec, "://")) {
            if (strlen(spec) >= cap) return -1;
            snprintf(url, cap, "%s", spec);
            return 0;
        }
        if (strchr(spec, '/')) {
            w = snprintf(url, cap, "https://%s", spec);
            if (w < 0 || (size_t)w >= cap) return -1;
            return 0;
        }
        reg = getenv("CT_REGISTRY");
        if (!reg || !reg[0]) reg = "https://github.com/ct-pkg";
        w = snprintf(url, cap, "%s/%s", reg, spec);
        if (w < 0 || (size_t)w >= cap) return -1;
        return 0;
    }

    int git_name(const char *spec, char *name, size_t cap)
    {
        const char *b, *e;
        size_t l;
        (void)self;

        e = spec + strlen(spec);
        while (e > spec && e[-1] == '/') e = e - 1;
        b = e;
        while (b > spec && b[-1] != '/') b = b - 1;
        l = (size_t)(e - b);
        if (l == 0 || l >= cap) return -1;
        memcpy(name, b, l);
        name[l] = 0;
        return 0;
    }

    int git_avail(void)
    {
        (void)self;
        return system("git --version >/dev/null 2>&1") == 0;
    }

    /* Single-quote `s` for the shell; every path and URL that reaches `git_run`
       goes through here, so a spec can never break out of its argument. The rule
       itself lives in `tool/sh/Sh.h.ct`, shared with `ct build`'s cc line. */
    int sh_quote(const char *s, char *out, size_t cap)
    {
        (void)self;
        return tool::sh::ct_sh_quote(s, out, (int)cap);
    }

    /* The one subprocess call site. */
    int git_run(const char *cmd, const char *outfile)
    {
        char full[MAX_PKG_CMD], qo[MAX_PKG_CMD];
        int w;
        (void)self;

        if (outfile) {
            if (self->sh_quote(outfile, qo, sizeof qo) != 0) return -1;
            w = snprintf(full, sizeof full, "%s > %s 2>/dev/null", cmd, qo);
        } else {
            w = snprintf(full, sizeof full, "%s 2>/dev/null", cmd);
        }
        if (w < 0 || (size_t)w >= sizeof full) return -1;
        return system(full);
    }

    int read_line_of(const char *path, char *buf, size_t cap)
    {
        FILE *f;
        size_t n;
        int c;
        (void)self;

        n = 0;
        f = fopen(path, "r");
        if (!f) return -1;
        c = fgetc(f);
        while (c != EOF && c != '\n' && c != '\r') {
            if (n + 1 >= cap) { fclose(f); return -1; }
            buf[n] = (char)c;
            n++;
            c = fgetc(f);
        }
        fclose(f);
        buf[n] = 0;
        return 0;
    }

    /* Pick the lowest tag satisfying `range` (minimal version selection).
       `0` = a tag was chosen, `-2` = no tags and any version is acceptable
       (fall back to the default branch), `-1` = no tag fits. */
    int git_pick_tag(const char *cache, const char *range, char *tag, size_t tcap)
    {
        char q1[MAX_PKG_CMD], cmd[MAX_PKG_CMD], out[MAX_PKG_CMD], root[MAX_PKG_CMD];
        char line[MAX_PKG_CMD];
        const char *home;
        FILE *f;
        int have, v[3], best[3], w;

        home = getenv("HOME");
        if (!home || !home[0]) return -1;
        if (snprintf(root, sizeof root, "%s/.cache/ct-pkg", home) >= (int)sizeof root) return -1;
        if (snprintf(out, sizeof out, "%s/.ct-pkg.tags", root) >= (int)sizeof out) return -1;
        tag[0] = 0;
        if (self->sh_quote(cache, q1, sizeof q1) != 0) return -1;
        w = snprintf(cmd, sizeof cmd, "git -C %s tag -l", q1);
        if (w < 0 || (size_t)w >= sizeof cmd) return -1;
        if (self->git_run(cmd, out) != 0) return -1;

        f = fopen(out, "r");
        if (!f) return -1;
        have = 0;
        while (fgets(line, sizeof line, f) != NULL) {
            char *ls, *le, *vp;
            char tmp[MAX_TEXT];
            size_t vl, tl, ll;
            ll = strlen(line);
            while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r'
                              || line[ll - 1] == ' ' || line[ll - 1] == '\t')) {
                ll = ll - 1;
                line[ll] = 0;
            }
            ls = line;
            while (*ls == ' ' || *ls == '\t') ls++;
            le = ls + strlen(ls);
            if (ls == le) continue;
            vp = ls;
            vl = (size_t)(le - ls);
            if (vl && *vp == 'v') {
                vp++;
                vl = vl - 1;
            }
            if (vl == 0 || vl >= sizeof tmp) continue;
            memcpy(tmp, vp, vl);
            tmp[vl] = 0;
            if (self->version_parse(tmp, v) != 0) continue;
            if (!self->range_match(range, tmp)) continue;
            tl = (size_t)(le - ls);
            if (tl == 0 || tl >= tcap) continue;
            if (!have || self->version_cmp(v, best) < 0) {
                memcpy(tag, ls, tl);
                tag[tl] = 0;
                best[0] = v[0];
                best[1] = v[1];
                best[2] = v[2];
                have = 1;
            }
        }
        fclose(f);
        if (have) return 0;
        if (!range || !range[0] || strcmp(range, "*") == 0) return -2;
        return -1;
    }

    /* Fetch a git package into the cache, check out the version the range
       picks, pin the commit, then resolve and vendor it like a local source.
       `pin_tag`/`expect_sha` come from the index (both NULL for a plain spec).
       In `offline` mode (`ct update`) nothing is cloned or fetched, and a
       commit ct.lock already pins wins over tag selection. */
    int fetch_git(const char *url, const char *name, const char *range,
                  const char *pin_tag, const char *expect_sha, int depth)
    {
        char hdir[MAX_PKG_CMD], root[MAX_PKG_CMD], cache[MAX_PKG_CMD], gitdir[MAX_PKG_CMD];
        char out[MAX_PKG_CMD], q1[MAX_PKG_CMD], q2[MAX_PKG_CMD], cmd[MAX_PKG_CMD];
        char mname[MAX_TEXT], mver[32], deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char tag[MAX_TEXT], pin[64], commit[64], dig[80], dst[MAX_PKG_PATH];
        const char *home;
        struct stat st;
        int ndeps, i, w, rc, fresh;

        ndeps = 0;
        if (depth > MAX_PKG_DEPTH) {
            fprintf(stderr, "ctc: dependency chain is too deep at '%s'\n", name);
            return -1;
        }
        if (!self->git_avail()) {
            fprintf(stderr, "ctc: git is required for '%s' but was not found; "
                            "install git or use a local directory source\n", name);
            return -1;
        }
        home = getenv("HOME");
        if (!home || !home[0]) {
            fprintf(stderr, "ctc: cannot locate the package cache (HOME is unset)\n");
            return -1;
        }
        if (snprintf(hdir, sizeof hdir, "%s/.cache", home) >= (int)sizeof hdir) return -1;
        if (snprintf(root, sizeof root, "%s/.cache/ct-pkg", home) >= (int)sizeof root) return -1;
        if (snprintf(cache, sizeof cache, "%s/%s", root, name) >= (int)sizeof cache) return -1;
        if (snprintf(gitdir, sizeof gitdir, "%s/.git", cache) >= (int)sizeof gitdir) return -1;
        if (snprintf(out, sizeof out, "%s/.ct-pkg.out", root) >= (int)sizeof out) return -1;
        if (!self->offline && (self->ensure_dir(hdir) != 0 || self->ensure_dir(root) != 0)) {
            fprintf(stderr, "ctc: cannot create the package cache '%s'\n", root);
            return -1;
        }

        fresh = 0;
        if (stat(gitdir, &st) != 0) fresh = 1;
        else if (!S_ISDIR(st.st_mode)) fresh = 1;
        if (self->offline) {
            if (fresh) {
                fprintf(stderr, "ctc: '%s' is not cached; run '%s get' first\n",
                        name, self->prog);
                return -1;
            }
        } else {
            if (self->sh_quote(url, q1, sizeof q1) != 0) return -1;
            if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
            if (fresh) {
                w = snprintf(cmd, sizeof cmd, "git clone --quiet %s %s", q1, q2);
                if (w < 0 || (size_t)w >= sizeof cmd) return -1;
                if (self->git_run(cmd, NULL) != 0) {
                    fprintf(stderr, "ctc: git clone of '%s' failed\n", url);
                    return -1;
                }
            } else {
                w = snprintf(cmd, sizeof cmd, "git -C %s fetch --quiet --tags --force", q2);
                if (w < 0 || (size_t)w >= sizeof cmd) return -1;
                if (self->git_run(cmd, NULL) != 0) {
                    fprintf(stderr, "ctc: git fetch of '%s' failed\n", url);
                    return -1;
                }
            }
        }

        tag[0] = 0;
        if (pin_tag && pin_tag[0]) {
            if (strlen(pin_tag) >= sizeof tag) return -1;
            snprintf(tag, sizeof tag, "%s", pin_tag);
            rc = 0;
        } else if (self->offline && pkg_pin_ref(name, pin, sizeof pin) == 0) {
            if (strlen(pin) >= sizeof tag) return -1;
            snprintf(tag, sizeof tag, "%s", pin);
            rc = 0;
        } else {
            rc = self->git_pick_tag(cache, range, tag, sizeof tag);
        }
        if (rc == 0) {
            if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
            if (self->sh_quote(tag, q1, sizeof q1) != 0) return -1;
            w = snprintf(cmd, sizeof cmd, "git -C %s checkout --quiet --detach %s", q2, q1);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git checkout of '%s' failed\n", tag);
                return -1;
            }
        } else if (rc == -2) {
            if (!fresh && !self->offline) {
                if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
                w = snprintf(cmd, sizeof cmd, "git -C %s reset --hard --quiet origin/HEAD", q2);
                if (w >= 0 && (size_t)w < sizeof cmd) self->git_run(cmd, NULL);
            }
        } else {
            fprintf(stderr, "ctc: no tag of '%s' satisfies '%s'\n", name, range);
            return -1;
        }

        if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
        w = snprintf(cmd, sizeof cmd, "git -C %s rev-parse --verify HEAD", q2);
        if (w < 0 || (size_t)w >= sizeof cmd) return -1;
        if (self->git_run(cmd, out) != 0) {
            fprintf(stderr, "ctc: git cannot resolve a commit for '%s'\n", name);
            return -1;
        }
        if (self->read_line_of(out, commit, sizeof commit) != 0 || commit[0] == 0) {
            fprintf(stderr, "ctc: git returned no commit for '%s'\n", name);
            return -1;
        }

        if (self->read_manifest(cache, mname, sizeof mname, mver, sizeof mver, deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", cache);
            return -1;
        }
        if (strcmp(mname, name) != 0) {
            fprintf(stderr, "ctc: '%s/ct.pkg' names '%s', but the source is '%s'\n",
                    cache, mname, name);
            return -1;
        }
        if (!self->range_match(range, mver)) {
            fprintf(stderr, "ctc: %s %s does not satisfy '%s'\n", mname, mver, range);
            return -1;
        }
        for (i = 0; i < self->nseen; i++)
            if (strcmp(self->seen[i], mname) == 0) return 0;
        if (self->nseen >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: too many packages (max %d)\n", MAX_PKG_DEPS);
            return -1;
        }
        snprintf(self->seen[self->nseen], MAX_TEXT, "%s", mname);
        self->nseen++;

        for (i = 0; i < ndeps; i++)
            if (self->get_spec(deps[i], cache, depth + 1) != 0) return -1;

        if (snprintf(dst, sizeof dst, "./vendor/%s", mname) >= (int)sizeof dst) return -1;
        if (self->copy_tree(cache, dst) != 0) {
            fprintf(stderr, "ctc: cannot vendor '%s' from '%s'\n", mname, cache);
            return -1;
        }
        if (self->dir_digest(cache, dig, sizeof dig) != 0) {
            fprintf(stderr, "ctc: cannot hash '%s'\n", cache);
            return -1;
        }
        if (expect_sha && expect_sha[0] && strcmp(dig, expect_sha) != 0) {
            fprintf(stderr, "ctc: '%s' does not match the index (source %s, index %s)\n",
                    mname, dig, expect_sha);
            return -1;
        }
        w = snprintf(self->lock + self->locklen, sizeof self->lock - (size_t)self->locklen,
                     "%s %s git %s %s\n", mname, mver, commit, dig);
        if (w < 0 || (size_t)w >= sizeof self->lock - (size_t)self->locklen) return -1;
        self->locklen += w;
        self->nlocks++;
        return 0;
    }

    /* A spec that names a git source: resolve its url and name, then fetch. */
    int get_git(const char *spec, const char *range, int depth)
    {
        char url[MAX_PKG_CMD], name[MAX_TEXT];

        if (self->git_url(spec, url, sizeof url) != 0) {
            fprintf(stderr, "ctc: cannot resolve a git url for '%s'\n", spec);
            return -1;
        }
        if (self->git_name(spec, name, sizeof name) != 0) {
            fprintf(stderr, "ctc: cannot derive a package name from '%s'\n", spec);
            return -1;
        }
        return self->fetch_git(url, name, range, NULL, NULL, depth);
    }

    /* Every dependency edge takes this: split off the range, then route to
       `get_git` or, for a filesystem location, to `get_one`. A bare name
       (`foo`, no slash and no scheme) is looked up in the explicit index first;
       a spec with a prefix keeps the old registry behaviour. */
    int get_spec(const char *spec, const char *base, int depth)
    {
        char path[MAX_PKG_PATH], range[32], full[MAX_PKG_PATH];
        char url[MAX_PKG_CMD], tag[MAX_TEXT], sha[80];
        int ix;
        (void)self;

        if (self->split_spec(spec, path, sizeof path, range, sizeof range) != 0) return -1;
        if (self->is_git_ref(path)) {
            if (strchr(path, '/') == NULL && strstr(path, "://") == NULL) {
                ix = pkg_index_lookup(path, range, url, sizeof url,
                                      tag, sizeof tag, sha, sizeof sha);
                if (ix == 0)
                    return self->fetch_git(url, path, range, tag, sha, depth);
                if (ix == -1) return -1;
                if (ix == 2) {
                    fprintf(stderr, "ctc: package '%s' is not in the index\n", path);
                    return -1;
                }
            }
            return self->get_git(path, range, depth);
        }
        if (strncmp(path, "file://", 7) == 0) {
            if (snprintf(full, sizeof full, "%s", path + 7) >= (int)sizeof full) return -1;
        } else if (path[0] == '/') {
            if (snprintf(full, sizeof full, "%s", path) >= (int)sizeof full) return -1;
        } else if (snprintf(full, sizeof full, "%s/%s", base, path) >= (int)sizeof full) {
            return -1;
        }
        return self->get_one(full, range, depth);
    }

    int get_one(const char *dir, const char *range, int depth)
    {
        char name[MAX_TEXT], ver[32], deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char dig[80], dst[MAX_PKG_PATH];
        int ndeps, i, w;

        ndeps = 0;
        if (depth > MAX_PKG_DEPTH) {
            fprintf(stderr, "ctc: dependency chain is too deep at '%s'\n", dir);
            return -1;
        }
        if (self->read_manifest(dir, name, sizeof name, ver, sizeof ver, deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", dir);
            return -1;
        }
        if (!self->range_match(range, ver)) {
            fprintf(stderr, "ctc: %s %s does not satisfy '%s'\n", name, ver, range);
            return -1;
        }
        for (i = 0; i < self->nseen; i++)
            if (strcmp(self->seen[i], name) == 0) return 0;
        if (self->nseen >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: too many packages (max %d)\n", MAX_PKG_DEPS);
            return -1;
        }
        snprintf(self->seen[self->nseen], MAX_TEXT, "%s", name);
        self->nseen++;

        for (i = 0; i < ndeps; i++)
            if (self->get_spec(deps[i], dir, depth + 1) != 0) return -1;

        if (snprintf(dst, sizeof dst, "./vendor/%s", name) >= (int)sizeof dst) return -1;
        if (self->copy_tree(dir, dst) != 0) {
            fprintf(stderr, "ctc: cannot vendor '%s' from '%s'\n", name, dir);
            return -1;
        }
        if (self->dir_digest(dir, dig, sizeof dig) != 0) {
            fprintf(stderr, "ctc: cannot hash '%s'\n", dir);
            return -1;
        }
        w = snprintf(self->lock + self->locklen, sizeof self->lock - (size_t)self->locklen,
                     "%s %s dir %s %s\n", name, ver, dir, dig);
        if (w < 0 || (size_t)w >= sizeof self->lock - (size_t)self->locklen) return -1;
        self->locklen += w;
        self->nlocks++;
        return 0;
    }

    /* D24: `get` records the spec as a `dep = ...` line unless that line (or
       the same package spelled differently) is already there. */
    int remember_dep(const char *spec)
    {
        char buf[MAX_LOCK];
        char newname[MAX_TEXT], cur[MAX_PKG_PATH], cn[MAX_TEXT];
        char *p, *end;
        long len;
        size_t n, sl, cl;
        int found, have_name;
        FILE *f;
        (void)self;

        f = fopen("./ct.pkg", "r");
        if (!f) return 0;
        len = -1;
        n = 0;
        if (fseek(f, 0, SEEK_END) == 0) {
            long sz;
            size_t sz2;
            sz = ftell(f);
            if (sz >= 0 && (size_t)sz < sizeof buf && fseek(f, 0, SEEK_SET) == 0) {
                sz2 = (size_t)sz;
                if (sz2 > 0) n = fread(buf, 1, sz2, f);
                if (n == sz2) len = sz;
            }
        }
        if (len < 0) {
            fclose(f);
            fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
            return -1;
        }
        fclose(f);
        buf[n] = 0;
        sl = strlen(spec);
        have_name = (self->dep_name(spec, newname, sizeof newname) == 0);
        found = 0;
        p = buf;
        end = buf + n;
        while (p < end) {
            char *ls, *le, *v, *ve;
            size_t vl;
            ls = p;
            le = p;
            while (le < end && *le != '\n') le = le + 1;
            p = (le < end) ? le + 1 : end;
            while (ls < le && (*ls == ' ' || *ls == '\t')) ls = ls + 1;
            if ((size_t)(le - ls) < 4 || strncmp(ls, "dep", 3) != 0) continue;
            v = ls + 3;
            while (v < le && (*v == ' ' || *v == '\t')) v = v + 1;
            if (v >= le || *v != '=') continue;
            v = v + 1;
            while (v < le && (*v == ' ' || *v == '\t')) v = v + 1;
            ve = le;
            while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t' || ve[-1] == '\r')) ve = ve - 1;
            vl = (size_t)(ve - v);
            if (sl == vl && strncmp(v, spec, vl) == 0) {
                found = 1;
                break;
            }
            if (have_name) {
                cl = vl < sizeof cur - 1 ? vl : sizeof cur - 1;
                memcpy(cur, v, cl);
                cur[cl] = 0;
                if (self->dep_name(cur, cn, sizeof cn) == 0 && strcmp(cn, newname) == 0) {
                    found = 1;
                    break;
                }
            }
        }
        if (!found) {
            f = fopen("./ct.pkg", "a");
            if (!f) {
                fprintf(stderr, "ctc: cannot write './ct.pkg'\n");
                return -1;
            }
            if (n > 0 && buf[n - 1] != '\n') fputc('\n', f);
            fprintf(f, "dep = %s\n", spec);
            if (fclose(f) != 0) {
                fprintf(stderr, "ctc: cannot write './ct.pkg'\n");
                return -1;
            }
        }
        return 0;
    }

    /* The name a dependency resolves to: a local package by its manifest, a git
       package by its spec tail; falls back to the tail when the local source is
       gone. */
    int dep_name(const char *spec, char *name, size_t cap)
    {
        char path[MAX_PKG_PATH], range[32], full[MAX_PKG_PATH];
        char mp[MAX_PKG_PATH], sname[MAX_TEXT], sver[32];
        char deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        int ndeps;
        FILE *f;
        (void)self;

        ndeps = 0;
        if (self->split_spec(spec, path, sizeof path, range, sizeof range) != 0) return -1;
        if (self->is_git_ref(path)) return self->git_name(path, name, cap);
        if (strncmp(path, "file://", 7) == 0) {
            if (snprintf(full, sizeof full, "%s", path + 7) >= (int)sizeof full) return -1;
        } else if (path[0] == '/') {
            if (snprintf(full, sizeof full, "%s", path) >= (int)sizeof full) return -1;
        } else if (snprintf(full, sizeof full, "./%s", path) >= (int)sizeof full) {
            return -1;
        }
        if (snprintf(mp, sizeof mp, "%s/ct.pkg", full) >= (int)sizeof mp) return -1;
        f = fopen(mp, "r");
        if (!f) return self->git_name(path, name, cap);
        fclose(f);
        if (self->read_manifest(full, sname, sizeof sname, sver, sizeof sver, deps, &ndeps) != 0)
            return self->git_name(path, name, cap);
        if (snprintf(name, cap, "%s", sname) >= (int)cap) return -1;
        return 0;
    }

    int get(const char *spec, const char *root)
    {
        FILE *f;
        char kept[MAX_LOCK];
        size_t klen;
        (void)self;

        self->locklen = 0;
        self->nseen = 0;
        self->nlocks = 0;
        self->lock[0] = 0;
        /* `copy_tree` creates the package directory itself, not its parent */
        if (self->ensure_dir("./vendor") != 0) {
            fprintf(stderr, "ctc: cannot create 'vendor/'\n");
            return 1;
        }
        if (self->get_spec(spec, root, 0) != 0) return 1;
        /* P20-04: a package whose `requires` this compiler does not satisfy is
           refused here -- before `ct.lock` is merged or opened -- so a failed
           `get` leaves the previous lock byte-identical instead of writing half
           of a new one. `--force` downgrades the mismatch to a warning, exactly
           as `ct install` does. */
        {
            char names[MAX_PKG_DEPS][MAX_TEXT];
            char vdir[MAX_PKG_PATH], mreq[MAX_TEXT], mcf[MAX_TEXT], mlf[MAX_TEXT];
            const char *p, *e;
            size_t ln;
            int nn, li;

            nn = 0;
            p = self->lock;
            while (*p && nn < MAX_PKG_DEPS) {
                while (*p == '\n' || *p == '\r') p = p + 1;
                if (*p == 0) break;
                e = p;
                while (*e && *e != ' ' && *e != '\t' && *e != '\n') e = e + 1;
                ln = (size_t)(e - p);
                if (ln > 0 && ln < MAX_TEXT) {
                    memcpy(names[nn], p, ln);
                    names[nn][ln] = 0;
                    nn++;
                }
                while (*e && *e != '\n') e = e + 1;
                p = e;
            }
            for (li = 0; li < nn; li++) {
                if (snprintf(vdir, sizeof vdir, "./vendor/%s", names[li]) >= (int)sizeof vdir) {
                    fprintf(stderr, "ctc: package path too long for '%s'\n", names[li]);
                    return 1;
                }
                if (pkg_read_meta(vdir, mcf, sizeof mcf, mlf, sizeof mlf, mreq, sizeof mreq) != 0) {
                    fprintf(stderr, "ctc: package '%s' has metadata that does not fit\n", names[li]);
                    return 1;
                }
                if (pkg_check_requires(names[li], mreq) != 0) {
                    if (!self->force) {
                        fprintf(stderr, "ctc: use --force to get anyway\n");
                        return 1;
                    }
                    fprintf(stderr, "ctc: continuing despite the requires mismatch (--force)\n");
                }
            }
        }
        /* `ct get` names one spec; the rows it did not touch stay in the lock,
           so a second get cannot unpin the first package (PKG-2). */
        if (pkg_lock_keep(kept, sizeof kept) != 0) return 1;
        klen = strlen(kept);
        if (self->locklen + (int)klen >= (int)sizeof self->lock) {
            fprintf(stderr, "ctc: ct.lock is too large to merge\n");
            return 1;
        }
        memcpy(self->lock + self->locklen, kept, klen + 1);
        self->locklen += (int)klen;

        f = fopen("./ct.lock", "w");
        if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        fputs(self->lock, f);
        if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        if (self->remember_dep(spec) != 0) return 1;
        printf("vendored %d package(s)\n", self->nlocks);
        return 0;
    }

    /* `ct install`: verify the lock against the vendored tree and the project
       manifest, then print one `ct build` command that carries every package's
       include root and build metadata. Offline, no subprocess. */
    int install(const char *prog)
    {
        FILE *f;
        DIR *d;
        struct dirent *e;
        struct stat st;
        char pname[MAX_TEXT], pver[32], pdeps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char lname[MAX_PKG_DEPS][MAX_TEXT], lver[MAX_PKG_DEPS][32];
        char vdir[MAX_PKG_PATH], cf[MAX_TEXT], lf[MAX_TEXT], rq[MAX_TEXT];
        char allcf[MAX_PKG_CMD], alldf[MAX_PKG_CMD], qcf[MAX_PKG_CMD], qlf[MAX_PKG_CMD];
        char dpath[MAX_PKG_PATH], drange[32], dname[MAX_TEXT];
        int ndeps, nlock, i, j, rc, units, seen;
        size_t nl;
        (void)self;

        ndeps = 0;
        nlock = 0;
        rc = 0;
        units = 0;
        /* a missing manifest reads differently from an incomplete one, and both
           are pinned diagnostics (L2 opens first, then parses) */
        f = fopen("./ct.pkg", "r");
        if (!f) {
            fprintf(stderr, "ctc: cannot open './ct.pkg'\n");
            return 1;
        }
        fclose(f);
        if (self->read_manifest(".", pname, sizeof pname, pver, sizeof pver, pdeps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
            return 1;
        }
        if (pkg_verify_lock(prog, lname, lver, &nlock) != 0) return 1;

        for (i = 0; i < ndeps; i++) {
            if (self->split_spec(pdeps[i], dpath, sizeof dpath, drange, sizeof drange) != 0
                || self->dep_name(pdeps[i], dname, sizeof dname) != 0) {
                fprintf(stderr, "ctc: bad dependency '%s'\n", pdeps[i]);
                rc = 1;
                continue;
            }
            seen = 0;
            for (j = 0; j < nlock; j++)
                if (strcmp(lname[j], dname) == 0 && self->range_match(drange, lver[j])) seen = 1;
            if (!seen) {
                fprintf(stderr, "ctc: dependency '%s' is not satisfied by ct.lock\n", pdeps[i]);
                rc = 1;
            }
        }
        if (rc != 0) return 1;

        allcf[0] = 0;
        alldf[0] = 0;
        for (i = 0; i < nlock; i++) {
            if (snprintf(vdir, sizeof vdir, "./vendor/%s", lname[i]) >= (int)sizeof vdir) return 1;
            if (pkg_read_meta(vdir, cf, sizeof cf, lf, sizeof lf, rq, sizeof rq) != 0) {
                fprintf(stderr, "ctc: package '%s' has metadata that does not fit\n", lname[i]);
                return 1;
            }
            if (pkg_check_requires(lname[i], rq) != 0) {
                if (!self->force) {
                    fprintf(stderr, "ctc: use --force to install anyway\n");
                    return 1;
                }
                fprintf(stderr, "ctc: continuing despite the requires mismatch (--force)\n");
            }
            if (pkg_append_words(allcf, sizeof allcf, cf) != 0
                || pkg_append_words(alldf, sizeof alldf, lf) != 0) {
                fprintf(stderr, "ctc: package flags are too long\n");
                return 1;
            }
        }

        printf("%s build", prog);
        for (i = 0; i < nlock; i++) printf(" -I vendor/%s", lname[i]);
        if (allcf[0]) {
            if (self->sh_quote(allcf, qcf, sizeof qcf) != 0) return 1;
            printf(" --cflags %s", qcf);
        }
        if (alldf[0]) {
            if (self->sh_quote(alldf, qlf, sizeof qlf) != 0) return 1;
            printf(" --ldflags %s", qlf);
        }
        d = opendir(".");
        if (d) {
            for (;;) {
                e = readdir(d);
                if (e == NULL) break;
                nl = strlen(e->d_name);
                if (nl <= 3 || strcmp(e->d_name + nl - 3, ".ct") != 0) continue;
                if (stat(e->d_name, &st) != 0 || !S_ISREG(st.st_mode)) continue;
                printf(" %s", e->d_name);
                units++;
            }
            closedir(d);
        }
        if (units == 0) printf(" <unit>.ct");
        printf(" -o build\n");
        return 0;
    }

    /* `ct get [--index <path>] <spec>[@<range>]`: a local directory or a git
       package; a bare name resolves through the explicit index when one is set. */
    int get_main(int argc, char **argv)
    {
        const char *spec;
        int i;
        (void)self;

        spec = NULL;
        for (i = 0; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s get [--index <path>] [--force] <spec>[@<range>]\n", self->prog);
                printf("  spec: a local directory (. or / or file://) or a git package\n"
                       "        (name resolved against CT_INDEX, else CT_REGISTRY, else an https URL)\n");
                printf("  --force  get even when a package 'requires' this compiler version\n");
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (strcmp(argv[i], "--index") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ctc: --index needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(self->index, sizeof self->index, "%s", argv[i]) >= (int)sizeof self->index) {
                    fprintf(stderr, "ctc: index path is too long\n");
                    return 1;
                }
                self->have_index = 1;
                continue;
            }
            if (strcmp(argv[i], "--force") == 0) {
                self->force = 1;
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            spec = argv[i];
        }
        if (!spec) {
            fprintf(stderr, "usage: %s get [--index <path>] [--force] <spec>[@<range>]\n", self->prog);
            return 1;
        }
        return self->get(spec, ".");
    }

    /* `ct install` takes no operands: anything but help/version is rejected. */
    int install_main(int argc, char **argv)
    {
        int ai;
        (void)self;

        for (ai = 0; ai < argc; ai++) {
            if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
                printf("usage: %s install [--force]\n", self->prog);
                printf("  verify vendor/ against ct.lock and print the suggested build command\n");
                printf("  --force  install even when a package 'requires' this compiler version\n");
                return 0;
            }
            if (strcmp(argv[ai], "--force") == 0) {
                self->force = 1;
                continue;
            }
            if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
                printf("%s v%s\n", self->prog, self->version);
                return 0;
            }
            if (argv[ai][0] == '-') {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
                return 1;
            }
            fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
            return 1;
        }
        return self->install(self->prog);
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. The state stays
   private to this unit -- a generated header cannot carry the MAX_* macros its
   fixed-size fields need -- so the driver reaches it through the wrappers below
   instead of through a struct accessor. */
static struct Pkg g_pkg;

/* --- `ct update` / `ct verify` helpers (prototypes above) ------------------ */

/* The optional build metadata in `<dir>/ct.pkg`: `cflags`, `ldflags` and
   `requires = ct >= x.y.z`. Missing keys (or a missing manifest) leave the
   buffers empty; a value that does not fit is an error. */
static int pkg_read_meta(const char *dir, char *cflags, size_t ccap,
                         char *ldflags, size_t lcap, char *req, size_t rcap)
{
    char path[MAX_PKG_PATH];
    char line[MAX_PKG_PATH];
    FILE *f;
    int ok;

    cflags[0] = 0;
    ldflags[0] = 0;
    req[0] = 0;
    if (snprintf(path, sizeof path, "%s/ct.pkg", dir) >= (int)sizeof path) return -1;
    f = fopen(path, "r");
    if (!f) return 0;
    ok = 1;
    while (fgets(line, sizeof line, f) != NULL) {
        char *ls, *le, *eq, *k, *v, *ve;
        size_t kl, vl, ll;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        ls = line;
        while (*ls == ' ' || *ls == '\t') ls++;
        if (*ls == 0 || *ls == '#') continue;
        le = ls + strlen(ls);
        eq = ls;
        while (eq < le && *eq != '=') eq++;
        if (eq == le) continue;
        k = eq;
        while (k > ls && (k[-1] == ' ' || k[-1] == '\t')) k = k - 1;
        v = eq + 1;
        while (*v == ' ' || *v == '\t') v++;
        ve = v + strlen(v);
        while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t')) ve = ve - 1;
        kl = (size_t)(k - ls);
        vl = (size_t)(ve - v);
        if (kl == 6 && strncmp(ls, "cflags", 6) == 0) {
            if (vl >= ccap) { ok = 0; break; }
            memcpy(cflags, v, vl);
            cflags[vl] = 0;
        } else if (kl == 7 && strncmp(ls, "ldflags", 7) == 0) {
            if (vl >= lcap) { ok = 0; break; }
            memcpy(ldflags, v, vl);
            ldflags[vl] = 0;
        } else if (kl == 8 && strncmp(ls, "requires", 8) == 0) {
            if (vl >= rcap) { ok = 0; break; }
            memcpy(req, v, vl);
            req[vl] = 0;
        }
    }
    fclose(f);
    return ok ? 0 : -1;
}

/* Look `name` up in the plain-text index: one entry per line as
   `name version git-url tag sha256:<hex>`. The lowest version satisfying
   `range` wins (the same minimal-version rule as `git_pick_tag`).
   Returns 0 on a hit, 1 when no index is configured, 2 when the name (or
   range) has no entry, and -1 when a configured index cannot be read. */
static int pkg_index_lookup(const char *name, const char *range, char *url, size_t ucap,
                            char *tag, size_t tcap, char *sha, size_t scap)
{
    char path[MAX_PKG_PATH], line[MAX_PKG_LINE];
    const char *ip;
    FILE *f;
    int best[3], bestset, found, bad;
    size_t ll;

    ip = g_pkg.have_index ? g_pkg.index : getenv("CT_INDEX");
    if (!ip || !ip[0]) return 1;
    if (strlen(ip) >= sizeof path) return -1;
    snprintf(path, sizeof path, "%s", ip);
    f = fopen(path, "r");
    if (!f) {
        fprintf(stderr, "ctc: cannot read the package index '%s'\n", path);
        return -1;
    }
    bestset = 0;
    found = 0;
    bad = 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[8];
        char *p;
        int ntok;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r'
                          || line[ll - 1] == ' ' || line[ll - 1] == '\t')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        p = line;
        while (*p == ' ' || *p == '\t') p++;
        if (*p == 0 || *p == '#') continue;
        ntok = 0;
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 8) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok < 5) continue;
        if (strcmp(tok[0], name) != 0) continue;
        if (!sha_hex_ok(tok[4])) {
            bad = 1;
            continue;
        }
        if (range && range[0] && !g_pkg.range_match(range, tok[1])) continue;
        {
            int v[3];
            if (g_pkg.version_parse(tok[1], v) != 0) continue;
            if (!bestset || g_pkg.version_cmp(v, best) < 0) {
                if (strlen(tok[2]) >= ucap || strlen(tok[3]) >= tcap
                    || strlen(tok[4]) >= scap) {
                    bad = 1;
                    continue;
                }
                snprintf(url, ucap, "%s", tok[2]);
                snprintf(tag, tcap, "%s", tok[3]);
                snprintf(sha, scap, "%s", tok[4]);
                best[0] = v[0];
                best[1] = v[1];
                best[2] = v[2];
                bestset = 1;
                found = 1;
            }
        }
    }
    fclose(f);
    if (found) return 0;
    return bad ? -1 : 2;
}

/* Append `src` to `dst` with one separating space; an empty `src` is a no-op. */
static int pkg_append_words(char *dst, size_t cap, const char *src)
{
    size_t dl, sl;

    if (!src || !src[0]) return 0;
    dl = strlen(dst);
    sl = strlen(src);
    if (dl + (dl ? 1 : 0) + sl >= cap) return -1;
    if (dl) {
        dst[dl] = ' ';
        dl++;
    }
    memcpy(dst + dl, src, sl + 1);
    return 0;
}

/* `requires = ct >= x.y.z`: a mismatch blocks `ct install`, because an
   incompatible package would only fail later inside the generated C. */
static int pkg_check_requires(const char *pkg, const char *req)
{
    char work[MAX_TEXT];
    const char *p;
    size_t n;

    p = req;
    while (*p == ' ' || *p == '\t') p++;
    if (*p == 0) return 0;
    if (!(strncmp(p, "ct", 2) == 0 && (p[2] == 0 || p[2] == ' ' || p[2] == '\t'))) {
        /* Only the compiler version belongs here; a package spec written as a
           `requires` is not a version range and would fail confusingly. */
        fprintf(stderr, "ctc: package '%s' has an unsupported requires '%s';"
                        " use dep = pkg@range for package dependencies\n", pkg, req);
        return 0;
    }
    p = p + 2;
    while (*p == ' ' || *p == '\t') p++;
    n = strlen(p);
    if (n == 0) return 0;
    if (n >= sizeof work) {
        fprintf(stderr, "ctc: package '%s' has an unsupported requires '%s';"
                        " use dep = pkg@range for package dependencies\n", pkg, req);
        return 0;
    }
    snprintf(work, sizeof work, "%s", p);
    if (!g_pkg.range_match(work, g_pkg.version)) {
        fprintf(stderr, "ctc: package '%s' requires '%s', but this is v%s\n",
                pkg, req, g_pkg.version);
        return -1;
    }
    return 0;
}

/* Verify every lock entry against the vendored tree. Returns 0 or 1; the pinned
   diagnostics are shared by `install` and `verify`. */
static int pkg_verify_lock(const char *prog, char lname[][MAX_TEXT], char lver[][32],
                           int *nlock)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    char vdir[MAX_PKG_PATH], vdig[80];
    int rc;

    *nlock = 0;
    rc = 0;
    f = fopen("./ct.lock", "r");
    if (!f) {
        fprintf(stderr, "ctc: no './ct.lock'; run `%s get` first\n", prog);
        return 1;
    }
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[12];
        char *p;
        int ntok;
        size_t ll;
        ntok = 0;
        p = line;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 12) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok < 4) continue;
        if (*nlock >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: ct.lock lists more than %d packages\n", MAX_PKG_DEPS);
            fclose(f);
            return 1;
        }
        snprintf(lname[*nlock], MAX_TEXT, "%s", tok[0]);
        snprintf(lver[*nlock], 32, "%s", tok[1]);
        /* the digest is the last token; the ref in between may hold spaces.
           Its algorithm is part of the format: a legacy 16-hex FNV value is
           reported, never compared as if it were a SHA-256 (SH-44). */
        if (!sha_hex_ok(tok[ntok - 1])) {
            fprintf(stderr, "ctc: '%s' has an unsupported digest '%s' in ct.lock; re-run '%s get' to regenerate\n", tok[0], tok[ntok - 1], prog);
            rc = 1;
        } else if (snprintf(vdir, sizeof vdir, "./vendor/%s", tok[0]) >= (int)sizeof vdir) {
            fprintf(stderr, "ctc: package path too long for '%s'\n", tok[0]);
            rc = 1;
        } else if (g_pkg.dir_digest(vdir, vdig, sizeof vdig) != 0) {
            fprintf(stderr, "ctc: '%s' is locked but not vendored at '%s'\n", tok[0], vdir);
            rc = 1;
        } else if (strcmp(vdig, tok[ntok - 1]) != 0) {
            fprintf(stderr, "ctc: '%s' does not match ct.lock (vendor %s, lock %s)\n",
                    tok[0], vdig, tok[ntok - 1]);
            rc = 1;
        }
        *nlock = *nlock + 1;
    }
    if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot read './ct.lock'\n"); return 1; }
    if (*nlock == 0) { fprintf(stderr, "ctc: ct.lock is empty\n"); return 1; }
    return rc;
}

/* Read the git refs ct.lock already pins (name -> commit). A missing lock is
   not an error: `ct update` then resolves from the cache alone. */
static int pkg_read_pins(void)
{
    FILE *f;
    char line[MAX_PKG_LINE];

    g_pkg.npins = 0;
    f = fopen("./ct.lock", "r");
    if (!f) return 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *tok[12];
        char *p;
        int ntok;
        size_t ll;
        ntok = 0;
        p = line;
        ll = strlen(line);
        while (ll > 0 && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) {
            ll = ll - 1;
            line[ll] = 0;
        }
        while (*p) {
            while (*p == ' ' || *p == '\t') p++;
            if (!*p) break;
            if (ntok < 12) {
                tok[ntok] = p;
                ntok++;
            }
            while (*p && *p != ' ' && *p != '\t') p++;
            if (*p) {
                *p = 0;
                p++;
            }
        }
        if (ntok < 5 || strcmp(tok[2], "git") != 0) continue;
        if (g_pkg.npins >= MAX_PKG_DEPS) break;
        snprintf(g_pkg.pinname[g_pkg.npins], MAX_TEXT, "%s", tok[0]);
        snprintf(g_pkg.pinref[g_pkg.npins], 64, "%s", tok[3]);
        g_pkg.npins++;
    }
    fclose(f);
    return 0;
}

/* The commit ct.lock pins for `name`, if any; -1 means "no pin". */
static int pkg_pin_ref(const char *name, char *ref, size_t cap)
{
    int i;

    for (i = 0; i < g_pkg.npins; i++)
        if (strcmp(g_pkg.pinname[i], name) == 0) {
            if (strlen(g_pkg.pinref[i]) >= cap) return -1;
            snprintf(ref, cap, "%s", g_pkg.pinref[i]);
            return 0;
        }
    return -1;
}

/* Keep the ct.lock rows `ct get` did not resolve again. One invocation resolves
   one spec, so rewriting the lock from the new rows alone would drop every
   other package ct.pkg already pins; a later `ct update` then re-picks the
   lowest cached tag and silently downgrades them (PKG-2). A row whose name this
   run resolved is dropped instead, so re-getting a package replaces it rather
   than duplicating it. A missing lock is not an error. */
static int pkg_lock_keep(char *dst, size_t cap)
{
    FILE *f;
    char line[MAX_PKG_LINE];
    size_t len, ll, nl;
    int i;

    len = 0;
    dst[0] = 0;
    f = fopen("./ct.lock", "r");
    if (!f) return 0;
    while (fgets(line, sizeof line, f) != NULL) {
        char *p;

        p = line;
        while (*p == ' ' || *p == '\t') p++;
        nl = 0;
        while (p[nl] && p[nl] != ' ' && p[nl] != '\t'
               && p[nl] != '\n' && p[nl] != '\r')
            nl++;
        if (nl == 0) continue;
        for (i = 0; i < g_pkg.nseen; i++)
            if (strlen(g_pkg.seen[i]) == nl && memcmp(g_pkg.seen[i], p, nl) == 0) break;
        if (i < g_pkg.nseen) continue;
        ll = strlen(line);
        if (len + ll + 1 > cap) {
            fprintf(stderr, "ctc: ct.lock is too large to merge\n");
            fclose(f);
            return -1;
        }
        memcpy(dst + len, line, ll);
        len += ll;
        dst[len] = 0;
    }
    fclose(f);
    /* a hand-edited lock may lack the final newline; keep the merged rows apart */
    if (len > 0 && dst[len - 1] != '\n') {
        if (len + 2 > cap) {
            fprintf(stderr, "ctc: ct.lock is too large to merge\n");
            return -1;
        }
        dst[len] = '\n';
        dst[len + 1] = 0;
    }
    return 0;
}

/* `ct update`: re-resolve ct.pkg, keeping the git commits ct.lock pins and
   never fetching from a remote -- local directories and the cache only. */
static int pkg_update(const char *prog)
{
    FILE *f;
    char pname[MAX_TEXT], pver[32], pdeps[MAX_PKG_DEPS][MAX_PKG_PATH];
    int ndeps, i, rc;

    ndeps = 0;
    f = fopen("./ct.pkg", "r");
    if (!f) {
        fprintf(stderr, "ctc: cannot open './ct.pkg'\n");
        return 1;
    }
    fclose(f);
    if (g_pkg.read_manifest(".", pname, sizeof pname, pver, sizeof pver, pdeps, &ndeps) != 0) {
        fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
        return 1;
    }
    pkg_read_pins();
    g_pkg.locklen = 0;
    g_pkg.nseen = 0;
    g_pkg.nlocks = 0;
    g_pkg.lock[0] = 0;
    if (g_pkg.ensure_dir("./vendor") != 0) {
        fprintf(stderr, "ctc: cannot create 'vendor/'\n");
        return 1;
    }
    g_pkg.offline = 1;
    rc = 0;
    for (i = 0; i < ndeps; i++)
        if (g_pkg.get_spec(pdeps[i], ".", 0) != 0) { rc = 1; break; }
    g_pkg.offline = 0;
    if (rc != 0) return 1;

    f = fopen("./ct.lock", "w");
    if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
    fputs(g_pkg.lock, f);
    if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
    printf("updated %d package(s)\n", g_pkg.nlocks);
    (void)prog;
    return 0;
}

/* `ct verify`: the offline half of install -- no manifest, no command. */
static int pkg_verify(const char *prog)
{
    char lname[MAX_PKG_DEPS][MAX_TEXT], lver[MAX_PKG_DEPS][32];
    int nlock;

    if (pkg_verify_lock(prog, lname, lver, &nlock) != 0) return 1;
    printf("verified %d package(s)\n", nlock);
    return 0;
}

/* Only primitives cross the unit boundary (the same shape L2 uses for core.ct):
   the driver hands over its name and the version string, then dispatches. */
pub int ct_pkg_get(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_get(int argc, char **argv, const char *prog, const char *version)
{
    g_pkg.prog = prog;
    g_pkg.version = version;
    return g_pkg.get_main(argc, argv);
}

pub int ct_pkg_install(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_install(int argc, char **argv, const char *prog, const char *version)
{
    g_pkg.prog = prog;
    g_pkg.version = version;
    return g_pkg.install_main(argc, argv);
}

pub int ct_pkg_update(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_update(int argc, char **argv, const char *prog, const char *version)
{
    int ai;

    g_pkg.prog = prog;
    g_pkg.version = version;
    for (ai = 0; ai < argc; ai++) {
        if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
            printf("usage: %s update\n", prog);
            printf("  re-resolve ct.pkg against ct.lock pins, offline; rewrite ct.lock\n");
            return 0;
        }
        if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
            printf("%s v%s\n", prog, version);
            return 0;
        }
        if (argv[ai][0] == '-') {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
            return 1;
        }
        fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
        return 1;
    }
    return pkg_update(prog);
}

pub int ct_pkg_verify(int argc, char **argv, const char *prog, const char *version);
int ct_pkg_verify(int argc, char **argv, const char *prog, const char *version)
{
    int ai;

    g_pkg.prog = prog;
    g_pkg.version = version;
    for (ai = 0; ai < argc; ai++) {
        if (strcmp(argv[ai], "-h") == 0 || strcmp(argv[ai], "--help") == 0) {
            printf("usage: %s verify\n", prog);
            printf("  check vendor/ against ct.lock (offline)\n");
            return 0;
        }
        if (strcmp(argv[ai], "-v") == 0 || strcmp(argv[ai], "--version") == 0) {
            printf("%s v%s\n", prog, version);
            return 0;
        }
        if (argv[ai][0] == '-') {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[ai]);
            return 1;
        }
        fprintf(stderr, "ctc: unexpected argument '%s'\n", argv[ai]);
        return 1;
    }
    return pkg_verify(prog);
}
