/*
 * Diag.h.ct - the warning store and the semantic-error counter, one unit of its own.
 *
 * Warnings are recorded from four places (a signature mismatch while parsing
 * an impl, a potential leak while analysing memory, a call-site arity or
 * argument-type mismatch while parsing an expression, and an ambiguous trait
 * method) and printed once at the end;
 * the error counter also drives the "too many errors" stop and the driver's
 * summary line. Keeping the store here means both producers reach it through
 * primitive wrappers -- a generated header cannot carry the MAX_* macros or the
 * FILE * a richer interface would need.
 *
 * Macros do not cross units, so the caps this unit needs are declared here;
 * MAX_TEXT 160 is the value `frontend/sym/Symbols.h.ct` lists.
 */
#include "Diag.shim.h"
import runtime::text::Intern;

/* cap mirrors: frontend/sym/Limits.h.ct is authoritative; tools/limits_sync.py checks them. */
#define MAX_TEXT     160
#define TEXT_LIMIT   65536              /* S1a-0 C2l: formal text / path bound */
#define MAX_ERRORS   20                 /* recovery cap: past this the compiler stops */
#define MAX_WARNINGS 32
#define WARN_LIMIT   65536

namespace tool::diag;

/* LANG-25: the stable diagnostic code registry (docs/diagnostics/codes.md).
   The table lives here once; parse errors, the warning store and the emitter
   all ask these two functions, so text and JSON cannot drift. `999` is the
   explicit "not yet classified" bucket per domain -- a code is never guessed
   from the message a second time at a call site. */
pub const char *ct_diag_code_for_error(const char *msg);
const char *ct_diag_code_for_error(const char *msg)
{
    if (strstr(msg, "unexpected token")) return "E-PARSE-001";
    if (strstr(msg, "expected an expression")) return "E-PARSE-002";
    if (strstr(msg, "use of an undeclared variable")) return "E-PARSE-004";
    if (strstr(msg, "a defer block cannot transfer control")) return "E-PARSE-006";
    if (strstr(msg, "an errdefer block cannot transfer control")) return "E-PARSE-007";
    if (strstr(msg, "break is only allowed in a loop or switch")) return "E-PARSE-008";
    if (strstr(msg, "continue is only allowed in a loop")) return "E-PARSE-009";
    if (strstr(msg, "unreachable code after a jump")) return "E-PARSE-010";
    if (strstr(msg, "auto-drop requires the closing")) return "E-PARSE-011";
    if (strstr(msg, "a goto cannot cross a block with defer")) return "E-PARSE-012";
    if (strstr(msg, "an own object cannot be rolled back by errdefer")) return "E-PARSE-013";
    if (strstr(msg, "a closure cannot escape through 'return'")) return "E-PARSE-014";
    if (strstr(msg, "cannot resolve import")) return "E-DRIVER-001";
    if (strstr(msg, "cannot open the input file")) return "E-DRIVER-002";
    if (strstr(msg, "a .m.ct unit produces no output")) return "E-DRIVER-003";
    if (strstr(msg, "cannot write the output file")) return "E-DRIVER-004";
    if (strstr(msg, "a method call on a temporary")) return "E-LOWER-001";
    if (strstr(msg, "too many hoisted receivers")) return "E-LOWER-002";
    if (strstr(msg, "lowering invariant I1")) return "E-LOWER-004";
    if (strstr(msg, "lowering invariant I2")) return "E-LOWER-005";
    if (strstr(msg, "lowering invariant I3")) return "E-LOWER-006";
    if (strstr(msg, "lowering invariant I4")) return "E-LOWER-007";
    /* REQ-MEM-2 S7-c: the call-site write-summary finding. */
    if (strstr(msg, "is stored outside the call")) return "E-MEM-001";
    /* the two escalations reuse the warning-class code, not a second one */
    if (strstr(msg, "type mismatch")) return "W-TYPE-002";
    if (strstr(msg, "arity mismatch")) return "W-TYPE-001";
    if (strstr(msg, "ambiguous method")) return "W-TRAIT-001";
    if (strstr(msg, "signature mismatch")) return "W-TRAIT-002";
    return "";
}

pub const char *ct_diag_warn_code(int kind);
const char *ct_diag_warn_code(int kind)
{
    if (kind == 0) return "W-MEM-001";
    if (kind == 1) return "W-TRAIT-002";
    if (kind == 2) return "W-MEM-002";
    if (kind == 3) return "W-MEM-003";
    if (kind == 4) return "W-TYPE-001";
    if (kind == 5) return "W-TYPE-002";
    if (kind == 6) return "W-TRAIT-001";
    if (kind == 7) return "W-NAME-001";
    if (kind == 8) return "W-DRIVER-001";
    if (kind == 9) return "W-MEM-004";
    if (kind == 10) return "W-MEM-005";
    if (kind == 11) return "W-MEM-006";
    if (kind == 12) return "W-LANG-001";
    return "";
}

/* One collected warning (10.2 signature mismatch, 10.3 leak, 19.1 arity,
   19.2 argument type, 19.3 ambiguity, 22 nested `loop` shadowing). */
struct Warn {
    int  kind;          /* 0 potential_leak, 1 signature_mismatch, 2 leak on a path, 3 borrow escape,
                           4 arity_mismatch, 5 type_mismatch, 6 ambiguous_method, 7 loop_shadow,
                           8 std_shadow, 9 slice_escape, 10 potential_cycle, 11 str_escape,
                           12 deprecated_alias, 13 receiver_mutability */
    int  line;
    int  col;           /* 1-based column of the token the finding is about (0: none);
                           `ct check` reports it, compile-mode text stays `file:line:` */
    int  path_line;     /* kind 2: the conditional return that leaves it behind */
    /* S1a-0 C2l: the unit path is owned by the record, allocated at its exact
       length. It used to be `char file[MAX_PATH]`, so a path over 1023 bytes
       was truncated in every diagnostic. `diag_reset` frees it. */
    char *file;
    /* S1a-0 C2p: the four text fields are pool texts. The old MAX_TEXT rows
       cut a long variable/type/method name (and the message that embeds one)
       at 159 bytes. */
    const char *var;    /* leak: variable; mismatch: method */
    const char *tname;  /* leak: struct type; mismatch: trait */
    const char *stype;
    const char *msg;
}

trait DiagStore {
    int  sem_error(int line, int col, const char *msg, const char *path);
    int  record_sig_warn(int line, int col, const char *method, const char *trait,
                         const char *stype, const char *msg, const char *path);
    int  record_arity_warn(int line, int col, const char *callee, const char *msg,
                           const char *path);
    int  record_type_warn(int line, int col, const char *callee, const char *msg,
                          const char *path);
    int  record_amb_warn(int line, int col, const char *method, const char *msg,
                         const char *path);
    /* SH-60 / D-60-1: a `mut` static method on a literal or top-level-const
       receiver. Same severity policy as the other call-site findings: a
       warning in compile / build mode, an error under `ct check`. */
    int  record_recv_warn(int line, int col, const char *method, const char *msg,
                          const char *path);
    int  record_loop_warn(int line, int col, const char *msg, const char *path);
    /* P-7.2: a direct `return` of a slice that views a local array. */
    int  record_slice_warn(int line, int col, const char *msg, const char *path);
    /* SH-106: a borrowed `Str` view of a local / temporary `String` owner
       escaping through `return` or a local binding. Same severity policy as
       `slice_escape`: a warning in compile/build mode, an error under
       `ct check`. */
    int  record_str_warn(int line, int col, const char *msg, const char *path);
    /* LANG-24 Stage A: a deprecated spelling (`box<T>`); always a warning. */
    int  record_deprecated(int line, int col, const char *msg, const char *path);
    int  record_std_shadow(int line, int col, const char *msg, const char *path);
    int  record_leak(int kind, int line, int path_line, const char *file,
                     const char *var, const char *tname);
    /* PH-82: a direct `Box<X>` field cycle (kind 10); `msg` carries the whole
       sentence and the chain, because the record has no variable/type slot. */
    int  record_cycle(int line, int col, const char *msg, const char *path);
    int  emit(int json, int to_stderr);
    void put_json(FILE *f, const char *s);
    int  nsem(void);
    int  nwarn(void);
    void set_strict(int on);
    /* PH-85 S85d: the B checker's level when it runs on the build path.
       0 off (no gate runs), 1 warn (the finding prints but the build goes on),
       2 error (the finding is a hard error, the pre-PH-85 meaning). */
    void set_types_level(int on);
    /* S7 REQ-TYPE-1: the class mask / level `ct compile` uses. The store only
       keeps the values; the gates read them through the `ct_type_class_*`
       primitives below, so both grammar layers agree on one policy. */
    void set_types_class(int mask, int level);
    /* LANG-25: text mode appends the stable code only on request. */
    void set_codes(int on);
    int  type_fail(int line, int col, const char *msg, const char *path);
    /* PH-82: `leaks = error` in the package manifest. It escalates the
       existing `potential leak` records (kinds 0/2) to errors, so the run
       fails before it writes a product; `strict` keeps its own meaning. */
    void set_leaks_error(int on);
    void reset(void);
}

struct Diag {
    struct Warn *warns;
    int  nwarns;
    int  wcap;
    int  nsem;
    /* `ct check` (19.4, D19-4): the same records are the entry's findings, so
       text lines read `error:` and JSON objects carry a severity. Compile keeps
       0; build uses 2 for signature-only hard errors (Phase 37). */
    int  strict;
    /* Phase 37: `strict` is 0 (compile), 1 (check: all findings error) or
       2 (build: only signature mismatches are errors). `sig_errs` counts the
       signature records so build can fail before writing any `.c`. */
    int  sig_errs;
    /* PH-82: the package's `leaks = error` escalation (0 warn, 1 error). It is
       orthogonal to `strict`: a warn package keeps `warning:` in every mode,
       while an error package fails compile/build yet does not touch
       `c-boundary`, `ct check`'s policy or any other finding class. */
    int  leaks_error;
    /* PH-85 S85d: `ct build --check-level=warn` downgrades the B findings to
       warnings and `error` promotes them; SH-115 made 1 (`warn`) the CLI
       default and v1-PH-1 S3 moved it to 2 (`error`), so only an explicit
       `--check-level=off` (0) restores the exact pre-PH-85 build. */
    int  types_level;
    /* S7 REQ-TYPE-1: the default-path class gate. `types_level` above is the
       build path's whole-B knob, but `ct compile` has no build context, so the
       three §4.53 judgement classes are enabled one slice at a time through a
       mask (1 assignment / initializer, 2 return, 4 container argument) with a
       level of its own (0 off, 1 warn, 2 error). `ct check --types` and
       `ct build` leave the mask at 0 and keep their existing severity, so the
       new gate cannot change either of them. */
    int  types_class_mask;
    int  types_class_level;
    /* LANG-25: `--diag-codes` appends `[E-...]` / `[W-...]` to text lines.
       Default text stays byte-identical; JSON carries the code either way. */
    int  codes;
} use DiagStore;

/* S1a-0 C1: the warning store grows instead of stopping at MAX_WARNINGS. */
static int diag_grow_warns(struct Diag *self)
{
    int cap;
    struct Warn *grown;
    if (self->warns && self->nwarns < self->wcap) return 0;
    cap = self->wcap > 0 ? self->wcap * 2 : MAX_WARNINGS;
    if (cap > WARN_LIMIT) {
        if (self->wcap >= WARN_LIMIT) return -1;
        cap = WARN_LIMIT;
    }
    grown = (struct Warn *)realloc(self->warns, (size_t)cap * sizeof(*self->warns));
    if (!grown) return -1;
    self->warns = grown;
    self->wcap = cap;
    return 0;
}

/* S1a-0 C2p: record text goes into the one intern pool; an allocation failure
   is reported by the pool itself and an empty field keeps the printers safe. */
static const char *diag_intern(const char *s)
{
    const char *p = runtime::text::ct_intern(s ? s : "");
    return p ? p : "";
}

/* S1a-0 C2l: one record's file path, exact length, owned by the store. A path
   over the formal text bound is an explicit failure, never a silent cut. */
static char *diag_dup(const char *s)
{
    size_t n;
    char *p;

    n = strlen(s);
    if (n > (size_t)TEXT_LIMIT) {
        fprintf(stderr, "ctc: diagnostic path exceeds %d bytes\n", TEXT_LIMIT);
        return (char *)0;
    }
    p = (char *)malloc(n + 1);
    if (!p) {
        fprintf(stderr, "ctc: out of memory\n");
        return (char *)0;
    }
    memcpy(p, s, n + 1);
    return p;
}

/* The location prefix, printed straight from the record: a `char loc[]` copy
   is what used to cap the path. `ct check` adds the column (D19-4). */
static void diag_loc(FILE *f, const struct Warn *w, int strict)
{
    if (strict && w->col > 0) fprintf(f, "%s:%d:%d:", w->file, w->line, w->col);
    else fprintf(f, "%s:%d:", w->file, w->line);
}

impl DiagStore for Diag {
    /* A semantic error in L2's shape (`file:line:col: error: ...`). Reporting is
       followed by resynchronisation in `parse_program`, so the rest of the file
       is still checked; `run`/`build_main` close with L2's summary line. */
    int sem_error(int line, int col, const char *msg, const char *path)
    {
        const char *code;
        code = ct_diag_code_for_error(msg);
        if (self->codes && code[0])
            fprintf(stderr, "%s:%d:%d: error: %s [%s]\n", path, line, col, msg, code);
        else
            fprintf(stderr, "%s:%d:%d: error: %s\n", path, line, col, msg);
        self->nsem++;
        /* past the cap the reports are cascades of the first few, not news */
        if (self->nsem > MAX_ERRORS) {
            fprintf(stderr, "ctc: too many errors, stopping\n");
            exit(1);
        }
        return -1;
    }

    /* PH-85 S85d: a B/`--types` finding on the build path. At level 1 it
       prints a warning and returns 0, so the gate's caller keeps going and the
       build still writes its products; every other level is `sem_error`. */
    int type_fail(int line, int col, const char *msg, const char *path)
    {
        if (self->types_level == 1) {
            const char *code = ct_diag_code_for_error(msg);
            if (self->codes && code[0])
                fprintf(stderr, "%s:%d:%d: warning: %s [%s]\n", path, line, col, msg, code);
            else
                fprintf(stderr, "%s:%d:%d: warning: %s\n", path, line, col, msg);
            return 0;
        }
        return self->sem_error(line, col, msg, path);
    }

    int record_sig_warn(int line, int col, const char *method, const char *trait,
                        const char *stype, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 1;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = diag_intern(method);
        w->tname = diag_intern(trait);
        w->stype = diag_intern(stype);
        w->msg = diag_intern(msg);
        self->nwarns++;
        if (self->strict == 2) self->sig_errs++;
        return 0;
    }

    /* A call whose argument count does not match the resolved signature (19.1).
       Compile mode keeps it a warning so `ct compile` / `ct build` keep their
       exit codes and artifacts (D19-4); `ct check` (19.4) raises the same
       record to an error. */
    int record_arity_warn(int line, int col, const char *callee, const char *msg,
                          const char *path)
    {
        /* PH-85 S85d: `--check-level=error` escalates the B findings this
           store would otherwise keep as warnings. The count moves `nsem`, so
           `build_main` stops before any product is written. */
        if (self->types_level == 2) {
            const char *full = runtime::text::ct_internf(
                "arity mismatch: '%s' %s", callee, msg);
            if (!full) return -1;
            (void)self->sem_error(line, col, full, path);
            return 0;
        }
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 4;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = diag_intern(callee);
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* One argument whose type is confidently incompatible with the resolved
       signature (19.2). Same severity policy as arity: a warning in compile
       mode, an error under `ct check`. */
    int record_type_warn(int line, int col, const char *callee, const char *msg,
                         const char *path)
    {
        if (self->types_level == 2) {
            const char *full;
            if (callee[0])
                full = runtime::text::ct_internf("type mismatch: '%s' %s", callee, msg);
            else
                full = runtime::text::ct_internf("%s", msg);
            if (!full) return -1;
            (void)self->sem_error(line, col, full, path);
            return 0;
        }
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 5;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = diag_intern(callee);
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* A bare method call two traits of the receiver both declare (19.3,
       SH-46). The first match in `use` order stays the resolution (the spec
       pins it), so this is only ever a warning; `ct check` (19.4) raises it
       to an error. */
    int record_amb_warn(int line, int col, const char *method, const char *msg,
                        const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 6;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = diag_intern(method);
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* SH-60 / D-60-1: `mut` wrote its receiver but the receiver cannot be
       written (a literal or a top-level const value). Same record shape and
       severity policy as 19.2 / 19.3. */
    int record_recv_warn(int line, int col, const char *method, const char *msg,
                         const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 13;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = diag_intern(method);
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* An inner `loop` shadows the outer loop's implicit `i` (Phase 22, D22-5).
       Same severity policy as the other diagnostics: a warning in compile mode,
       an error under `ct check`. Only `loop`-in-`loop` gets here -- a
       hand-written `int i` or a native `for` is ordinary C shadowing. */
    int record_loop_warn(int line, int col, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 7;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = "";
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* P-7.2 (P-4.3): a direct `return` of a slice that views a local array.
       A lint in compile mode, an error under `ct check`, matching the other
       record-and-report warnings. */
    int record_slice_warn(int line, int col, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 9;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = "";
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* LANG-24 Stage A: `box<T>` is a deprecated alias for `Box<T>`. This is
       a compatibility notice, not a type error, so it stays `warning:` in
       every mode including `ct check` (v1.1 removes the alias). */
    int record_deprecated(int line, int col, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 12;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = "";
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* SH-106: a borrowed `Str` / `U16Str` view of a local or temporary
       owning handle escaping the frame. Same severity policy as the slice
       lint: a warning in compile mode, an error under `ct check`. */
    int record_str_warn(int line, int col, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 11;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = "";
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* L29-W1: the built-in container layer wins over a project-local
       `vendor/std`; the warning names the shadowed path. */    int record_std_shadow(int line, int col, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 8;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = "";
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }
    int record_leak(int kind, int line, int path_line, const char *file,
                    const char *var, const char *tname)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = kind;
        w->line = line;
        w->col = 0;
        w->path_line = path_line;
        w->file = diag_dup(file);
        if (!w->file) return -1;
        w->var = diag_intern(var);
        w->tname = diag_intern(tname);
        w->stype = "";
        w->msg = "";
        self->nwarns++;
        return 0;
    }

    /* PH-82: the direct-cycle finding (kind 10). The record carries the whole
       sentence so text and JSON share one wording; `col` is the declared
       struct's column, which `ct check` prints with the location contract. */
    int record_cycle(int line, int col, const char *msg, const char *path)
    {
        struct Warn *w;
        (void)self;
        if (diag_grow_warns(self) != 0) return -1;
        w = &self->warns[self->nwarns];
        w->kind = 10;
        w->line = line;
        w->col = col;
        w->path_line = 0;
        w->file = diag_dup(path);
        if (!w->file) return -1;
        w->var = "";
        w->tname = "";
        w->stype = "";
        w->msg = diag_intern(msg);
        self->nwarns++;
        return 0;
    }

    /* The emitter's `emit_json_str` is an EmitOps method, so this unit keeps a
       local copy; the escaping must match it byte for byte (the JSON documents
       are compared against L2's). */
    void put_json(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
    }

    /* One JSON document or one line per warning -- the same shape and wording
       L2 uses (D39). Compile mode sends JSON to stdout, build mode to stderr
       (stdout already carries the suggested cc command). */
    int emit(int json, int to_stderr)
    {
        int i;
        FILE *jf;
        FILE *tf;
        /* `ct check` turns these into findings; compile and build keep `warning` */
        const char *sev = self->strict == 1 ? "error" : "warning";
        const char *sigsev = (self->strict == 1 || self->strict == 2) ? "error" : "warning";
        /* PH-82: the leak records (kinds 0/2) and the direct-cycle record
           (kind 10) follow `leaks = error` in every mode; other classes do
           not. */
        const char *leaksev = (self->strict == 1 || self->leaks_error) ? "error" : "warning";
        int leak_errs = 0;
        (void)self;
        jf = to_stderr ? stderr : stdout;
        tf = stderr;
        if (self->nwarns == 0) return 0;
        if (self->leaks_error) {
            for (i = 0; i < self->nwarns; i++) {
                int k = self->warns[i].kind;
                if (k == 0 || k == 2 || k == 10) leak_errs++;
            }
        }
        if (json) {
            fputs("{\"warnings\":[", jf);
            for (i = 0; i < self->nwarns; i++) {
                struct Warn *w = &self->warns[i];
                if (i) fputc(',', jf);
                fputc('{', jf);
                fputs("\"code\":\"", jf);
                self->put_json(jf, ct_diag_warn_code(w->kind));
                fputs("\",", jf);
                if (self->strict == 1 || (w->kind == 1 && self->strict == 2)
                    || (self->leaks_error
                        && (w->kind == 0 || w->kind == 2 || w->kind == 10)))
                    fputs("\"severity\":\"error\",", jf);
                if (w->kind == 1) {
                    fputs("\"type\":\"signature_mismatch\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"method\":\"", jf);
                    self->put_json(jf, w->var);
                    fputs("\",\"trait\":\"", jf);
                    self->put_json(jf, w->tname);
                    fputs("\",\"struct\":\"", jf);
                    self->put_json(jf, w->stype);
                    fputs("\",\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 2) {
                    fputs("\"type\":\"potential_leak\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,\"variable\":\"", w->line);
                    self->put_json(jf, w->var);
                    fputs("\",\"type_name\":\"", jf);
                    self->put_json(jf, w->tname);
                    fprintf(jf, "*\",\"message\":\"may leak on a return path\","
                                 "\"path_line\":%d}", w->path_line);
                } else if (w->kind == 3) {
                    fputs("\"type\":\"borrow_escape\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,\"variable\":\"", w->line);
                    self->put_json(jf, w->var);
                    fputs("\",\"message\":\"a borrowed pointer escapes through 'return'\"}", jf);
                } else if (w->kind == 4) {
                    fputs("\"type\":\"arity_mismatch\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"callee\":\"", jf);
                    self->put_json(jf, w->var);
                    fputs("\",\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 5) {
                    fputs("\"type\":\"type_mismatch\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"callee\":\"", jf);
                    self->put_json(jf, w->var);
                    fputs("\",\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 6) {
                    fputs("\"type\":\"ambiguous_method\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"method\":\"", jf);
                    self->put_json(jf, w->var);
                    fputs("\",\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 7) {
                    fputs("\"type\":\"loop_shadow\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 8) {
                    fputs("\"type\":\"std_shadow\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 9) {
                    fputs("\"type\":\"slice_escape\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 11) {
                    fputs("\"type\":\"str_escape\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 12) {
                    /* LANG-24: a compatibility notice, never escalated. */
                    fputs("\"type\":\"deprecated_alias\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 13) {
                    /* SH-60: a `mut` method on a read-only receiver. */
                    fputs("\"type\":\"receiver_mutability\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"method\":\"", jf);
                    self->put_json(jf, w->var);
                    fputs("\",\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else if (w->kind == 10) {
                    /* PH-82: a direct `Box<X>` field cycle; `message` already
                       names the chain, so JSON carries no separate field. */
                    fputs("\"type\":\"potential_cycle\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,", w->line);
                    if (self->strict && w->col > 0) fprintf(jf, "\"col\":%d,", w->col);
                    fputs("\"message\":\"", jf);
                    self->put_json(jf, w->msg);
                    fputs("\"}", jf);
                } else {
                    fputs("\"type\":\"potential_leak\",\"file\":\"", jf);
                    self->put_json(jf, w->file);
                    fprintf(jf, "\",\"line\":%d,\"variable\":\"", w->line);
                    self->put_json(jf, w->var);
                    fputs("\",\"type_name\":\"", jf);
                    self->put_json(jf, w->tname);
                    fputs("*\",\"message\":\"allocated but never deleted\"}", jf);
                }
            }
            fputs("]}\n", jf);
        } else {
            for (i = 0; i < self->nwarns; i++) {
                struct Warn *w = &self->warns[i];
                /* `ct check` follows the source location contract
                   (`file:line:col:`); compile and build stay `file:line:` so
                   their bytes do not move (D19-4). */
                char csuf[64];
                const char *wcode = ct_diag_warn_code(w->kind);
                if (self->codes && wcode[0]) snprintf(csuf, sizeof csuf, " [%s]", wcode);
                else csuf[0] = 0;
                /* S1a-0 C2l: the location prints from the owned path; the old
                   fixed `loc` copy cut it at the 1024-byte cap. */
                diag_loc(tf, w, self->strict);
                if (w->kind == 1)
                    fprintf(tf, " %s: signature mismatch: '%s' in impl of '%s' for '%s': %s%s\n",
                            sigsev, w->var, w->tname, w->stype, w->msg, csuf);
                else if (w->kind == 2)
                    fprintf(tf, " %s: potential leak: '%s' (%s*) may leak on a return path (line %d)%s\n",
                            leaksev, w->var, w->tname, w->path_line, csuf);
                else if (w->kind == 3)
                    fprintf(tf, " %s: a borrowed pointer escapes through 'return'%s\n",
                            sev, csuf);
                else if (w->kind == 4)
                    fprintf(tf, " %s: arity mismatch: '%s' %s%s\n",
                            sev, w->var, w->msg, csuf);
                else if (w->kind == 5) {
                    /* Phase 32: an empty callee means the message already
                       carries its own label (`initializer: …`), so nothing
                       is prefixed. */
                    if (w->var[0])
                        fprintf(tf, " %s: type mismatch: '%s' %s%s\n",
                                sev, w->var, w->msg, csuf);
                    else
                        fprintf(tf, " %s: %s%s\n", sev, w->msg, csuf);
                }
                else if (w->kind == 6)
                    fprintf(tf, " %s: ambiguous method: '%s' %s%s\n",
                            sev, w->var, w->msg, csuf);
                else if (w->kind == 7)
                    fprintf(tf, " %s: %s%s\n", sev, w->msg, csuf);
                else if (w->kind == 8)
                    fprintf(tf, " %s: %s%s\n", sev, w->msg, csuf);
                else if (w->kind == 9)
                    fprintf(tf, " %s: %s%s\n", sev, w->msg, csuf);
                else if (w->kind == 11)
                    fprintf(tf, " %s: %s%s\n", sev, w->msg, csuf);
                else if (w->kind == 12)
                    /* LANG-24: the deprecated alias always prints `warning:`,
                       even when `ct check` escalates the other findings. */
                    fprintf(tf, " warning: %s%s\n", w->msg, csuf);
                else if (w->kind == 13)
                    fprintf(tf, " %s: %s%s\n", sev, w->msg, csuf);
                else if (w->kind == 10)
                    fprintf(tf, " %s: %s%s\n", leaksev, w->msg, csuf);
                else
                    fprintf(tf, " %s: potential leak: '%s' (%s*) allocated but never deleted%s\n",
                            leaksev, w->var, w->tname, csuf);
            }
        }
        /* PH-82: the leak escalation is the run's failure signal even when
           `strict` is not build's 2 (compile mode has 0). */
        if (leak_errs > 0) return leak_errs;
        return self->strict == 2 ? self->sig_errs : 0;
    }

    int nsem(void)
    {
        (void)self;
        return self->nsem;
    }

    int nwarn(void)
    {
        (void)self;
        return self->nwarns;
    }

    void set_types_level(int on)
    {
        self->types_level = on;
    }

    /* S7 REQ-TYPE-1: set by the driver once per run (the compile/bare form);
       `ct_diag_reset` runs once per unit and must not clear a run policy. */
    void set_types_class(int mask, int level)
    {
        self->types_class_mask = mask;
        self->types_class_level = level;
    }

    void set_codes(int on)
    {
        self->codes = on ? 1 : 0;
    }

    void set_strict(int on)
    {
        (void)self;
        self->strict = on;
    }

    void set_leaks_error(int on)
    {
        (void)self;
        self->leaks_error = on ? 1 : 0;
    }

    void reset(void)
    {
        int i;
        (void)self;
        /* S1a-0 C2l: each record owns its file path; a reset (one per unit in
           build mode) releases them before the slots are reused. */
        for (i = 0; i < self->nwarns; i++) {
            free(self->warns[i].file);
            self->warns[i].file = (char *)0;
        }
        self->nwarns = 0;
        self->nsem = 0;
        self->sig_errs = 0;
        self->leaks_error = 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Diag g_diag;

/* Only primitives cross the unit boundary; the path is passed per call because
   the driver may reset it (`build` re-points it at each unit). */
pub int ct_sem_error(int line, int col, const char *msg, const char *path);
int ct_sem_error(int line, int col, const char *msg, const char *path)
{
    return g_diag.sem_error(line, col, msg, path);
}

/* The `note:` channel (Phase 21 S4, D21-6): a hint that follows an error but is
   not one. It only prints, so it cannot move `nsem`, the `MAX_ERRORS` cap, the
   warning array, the JSON document or any exit code. */
pub int ct_sem_note(int line, int col, const char *msg, const char *path);
int ct_sem_note(int line, int col, const char *msg, const char *path)
{
    fprintf(stderr, "%s:%d:%d: note: %s\n", path, line, col, msg);
    return 0;
}

pub int ct_sig_warn(int line, int col, const char *method, const char *trait, const char *stype, const char *msg, const char *path);
int ct_sig_warn(int line, int col, const char *method, const char *trait,
                const char *stype, const char *msg, const char *path)
{
    return g_diag.record_sig_warn(line, col, method, trait, stype, msg, path);
}

pub int ct_arity_warn(int line, int col, const char *callee, const char *msg, const char *path);
int ct_arity_warn(int line, int col, const char *callee, const char *msg, const char *path)
{
    return g_diag.record_arity_warn(line, col, callee, msg, path);
}

pub int ct_type_warn(int line, int col, const char *callee, const char *msg, const char *path);
int ct_type_warn(int line, int col, const char *callee, const char *msg, const char *path)
{
    return g_diag.record_type_warn(line, col, callee, msg, path);
}

pub int ct_amb_warn(int line, int col, const char *method, const char *msg, const char *path);
int ct_amb_warn(int line, int col, const char *method, const char *msg, const char *path)
{
    return g_diag.record_amb_warn(line, col, method, msg, path);
}

/* SH-60 / D-60-1: a `mut` method on a literal / top-level-const receiver. */
pub int ct_recv_warn(int line, int col, const char *method, const char *msg, const char *path);
int ct_recv_warn(int line, int col, const char *method, const char *msg, const char *path)
{
    return g_diag.record_recv_warn(line, col, method, msg, path);
}

/* A nested `loop` shadows the outer `i` (Phase 22, D22-5). */
pub int ct_loop_warn(int line, int col, const char *msg, const char *path);
int ct_loop_warn(int line, int col, const char *msg, const char *path)
{
    return g_diag.record_loop_warn(line, col, msg, path);
}

/* P-7.2: a slice that views a local array escaping through `return`. */
pub int ct_slice_warn(int line, int col, const char *msg, const char *path);
int ct_slice_warn(int line, int col, const char *msg, const char *path)
{
    return g_diag.record_slice_warn(line, col, msg, path);
}

/* SH-106: a borrowed `Str` view of a local / temporary `String` owner
   escaping through `return` or a local binding. */
pub int ct_str_warn(int line, int col, const char *msg, const char *path);
int ct_str_warn(int line, int col, const char *msg, const char *path)
{
    return g_diag.record_str_warn(line, col, msg, path);
}

/* LANG-24 Stage A: the `box<T>` alias is deprecated; one record per use. */
pub int ct_deprecated_warn(int line, int col, const char *msg, const char *path);
int ct_deprecated_warn(int line, int col, const char *msg, const char *path)
{
    return g_diag.record_deprecated(line, col, msg, path);
}

pub int ct_std_shadow_warn(int line, int col, const char *msg, const char *path);
int ct_std_shadow_warn(int line, int col, const char *msg, const char *path)
{
    return g_diag.record_std_shadow(line, col, msg, path);
}

pub int ct_leak_warn(int kind, int line, int path_line, const char *file, const char *var, const char *tname);
int ct_leak_warn(int kind, int line, int path_line, const char *file,
                 const char *var, const char *tname)
{
    return g_diag.record_leak(kind, line, path_line, file, var, tname);
}

/* A borrowed pointer handed back through `return` (kind 3); the type name is
   empty because the warning only names the variable. */
pub int ct_borrow_warn(int line, const char *var, const char *path);
int ct_borrow_warn(int line, const char *var, const char *path)
{
    return g_diag.record_leak(3, line, 0, path, var, "");
}

pub int ct_diag_emit(int json, int to_stderr);
int ct_diag_emit(int json, int to_stderr)
{
    return g_diag.emit(json, to_stderr);
}

pub int ct_diag_nsem(void);
int ct_diag_nsem(void)
{
    return g_diag.nsem();
}

/* `ct check` (19.4): findings are errors, so the entry reports `error:` lines,
   tags JSON objects with a severity and derives its exit code from this count. */
pub int ct_diag_nwarn(void);
int ct_diag_nwarn(void)
{
    return g_diag.nwarn();
}

/* PH-82: `leaks = error` from the package manifest; a warn package keeps the
   pre-PH-82 severity everywhere. */
pub void ct_diag_set_leaks_error(int on);
void ct_diag_set_leaks_error(int on)
{
    g_diag.set_leaks_error(on);
}

/* 1 when the run has at least one leak record and the manifest asked for
   `leaks = error`: the entries fail before any product is written. */
pub int ct_diag_leaks_failed(void);
int ct_diag_leaks_failed(void)
{
    int i;

    if (!g_diag.leaks_error) return 0;
    for (i = 0; i < g_diag.nwarns; i++) {
        int k = g_diag.warns[i].kind;
        if (k == 0 || k == 2 || k == 10) return 1;
    }
    return 0;
}

/* PH-82: a direct `Box<X>` field cycle (kind 10). */
pub int ct_cycle_warn(int line, int col, const char *msg, const char *path);
int ct_cycle_warn(int line, int col, const char *msg, const char *path)
{
    return g_diag.record_cycle(line, col, msg, path);
}

pub void ct_diag_set_strict(int on);
void ct_diag_set_strict(int on)
{
    g_diag.set_strict(on);
}

/* PH-85 S85d: `ct build --check-level=off|warn|error`. The level is a run
   configuration, so `ct_diag_reset` (one call per unit) leaves it alone. */
pub void ct_diag_set_types_level(int on);
void ct_diag_set_types_level(int on)
{
    g_diag.set_types_level(on);
}

/* S7 REQ-TYPE-1: the three §4.53 classes on the default path. `ct compile`
   sets the mask / level once; each judgement site asks its own class gate, so
   a slice can be rolled back by clearing one bit. The gates answer 0 when the
   level is off, which is the `--check-level=off` escape hatch. */
pub void ct_diag_set_types_class(int mask, int level);
void ct_diag_set_types_class(int mask, int level)
{
    g_diag.set_types_class(mask, level);
}

pub int ct_type_class_assign(void);
int ct_type_class_assign(void)
{
    return g_diag.types_class_level > 0 && (g_diag.types_class_mask & 1) != 0;
}

pub int ct_type_class_return(void);
int ct_type_class_return(void)
{
    return g_diag.types_class_level > 0 && (g_diag.types_class_mask & 2) != 0;
}

pub int ct_type_class_container(void);
int ct_type_class_container(void)
{
    return g_diag.types_class_level > 0 && (g_diag.types_class_mask & 4) != 0;
}

/* S7 REQ-TYPE-1: one class finding's severity. With no class level set (build
   and `ct check --types`) it falls back to `record_type_warn`, so both keep
   the pre-S7 path byte for byte. On the default path level 2 is a hard error
   (the build cannot turn a bad assignment into C) and level 1 is the
   documented downgrade. */
pub int ct_type_class_warn(int line, int col, const char *callee, const char *msg,
                           const char *path);
int ct_type_class_warn(int line, int col, const char *callee, const char *msg,
                       const char *path)
{
    if (g_diag.types_class_level == 2)
        return g_diag.sem_error(line, col, msg, path);
    return g_diag.record_type_warn(line, col, callee, msg, path);
}

pub void ct_diag_set_codes(int on);
void ct_diag_set_codes(int on)
{
    g_diag.set_codes(on);
}

pub int ct_type_fail(int line, int col, const char *msg, const char *path);
int ct_type_fail(int line, int col, const char *msg, const char *path)
{
    return g_diag.type_fail(line, col, msg, path);
}

pub void ct_diag_reset(void);
void ct_diag_reset(void)
{
    g_diag.reset();
}
