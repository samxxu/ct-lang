/*
 * driver.ct - L1 driver unit: the CLI, the unit tables and `main`.
 *
 * The other half of the multi-unit split (see `core.ct` for the pipeline). This
 * unit owns everything that never touches the scanning state: the argument parser,
 * the `build` unit table, the import resolver, and `main`. It reaches the pipeline
 * only through the `pub` wrappers declared in `core.h`, so no symbol of `core.ct`
 * is referenced here by name and no type crosses the unit boundary.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
import core;
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
/* `stat` stamps a unit's mtime/size and `mkdir` creates the cache directory
   (Phase 6.3); both are POSIX, not a third-party dependency. */
#include <sys/stat.h>
/* Phase 8.1 vendors a local package by walking its directory; `opendir` is the
   POSIX way to do that without a subprocess. */
#include <dirent.h>
/* Phase 8.2 fetches git sources by shelling out to the system `git`. `system`
   lives in stdlib.h (ISO C), so no feature macro is needed; the call is confined
   to the package subcommand and never runs while compiling. */

/* This unit carries its own copy of the shared capacities (a generated header
   cannot carry a macro): the values must stay in lockstep with `core.ct`. */
#define MAX_NAME   128
#define MAX_UNITS  64                     /* units in one `ctc build` run */
#define MAX_BUILD  32                     /* inputs on a single command line */
#define MAX_IMPORTS 16                    /* `import` lines per unit */
#define MAX_INCDIRS 16                    /* `-I` search roots per command */
#define MAX_KEY   768                     /* one unit's cache key, stored as text */

#define CTC_VERSION "0.8.0"

/* The incremental-build cache (Phase 6.3). These are methods rather than plain
   functions because plain-C top-level signatures are capped (MAX_FUNCS) and this
   tree has no head-room left; the receiver carries the unit table, so nothing
   else has to be global. The key covers the compiler version, the run's options
   and, per unit, its path, its `mtime`/`size` stamp, its imports and its
   dependencies' key digests -- the digest keeps a key bounded however deep the
   import chain is. */
trait CacheOps {
    unsigned long digest(const char *s);
    int  key_of(int u, int line_force, int diag, char *out, size_t cap);
    int  keyfile_of(const char *outc, char *dir, size_t dcap, char *key, size_t kcap);
    int  hit(const char *outc, const char *key);
    void store(const char *outc, const char *key);
}

/* The `build` driver's state: the `-I` search roots (checked after the importing
   file's own directory, in command-line order) and the unit table it fills while
   resolving imports. One struct instead of nine loose globals. `struct Build` and
   `g_build` live in this unit because `struct Pipe` / `struct SymTab` do not cross
   the unit boundary. */
struct Build {
    char incdir[MAX_INCDIRS][MAX_NAME * 4];
    int  nincdirs;
    /* `--ns-root` (Phase 5): the tree root whose directories name namespaces.
       Defaults to the first input's directory; empty until resolved. */
    char ns_root[MAX_NAME * 4];
    int  has_ns_root;
    /* `--emit-map <file>`: the reverse-mapping table. `build` writes a file only
       (stdout carries the suggested cc command). */
    char map_path[MAX_NAME * 4];
    int  has_map;
    char unit_path[MAX_UNITS][MAX_NAME * 4];
    char unit_out[MAX_UNITS][MAX_NAME * 4];
    char unit_imp[MAX_UNITS][MAX_IMPORTS][MAX_NAME];
    int  unit_nimp[MAX_UNITS];
    /* The resolved dependencies (unit indices, already scheduled) and each unit's
       key digest: a unit folds its dependencies' digests into its own key, so a
       change anywhere in the chain invalidates everything downstream. */
    int  unit_dep[MAX_UNITS][MAX_IMPORTS];
    int  unit_ndep[MAX_UNITS];
    unsigned long unit_digest[MAX_UNITS];
    int  unit_n;
    int  order[MAX_UNITS];
    int  order_n;
} use CacheOps;

impl CacheOps for Build {
    /* FNV-1a: the map that folds a variable-length string into a fixed-width
       number for the key. Not a content hash of the sources -- it only keeps the
       key bounded when keys are folded into other keys. */
    unsigned long digest(const char *s) {
        unsigned long h = 2166136261UL;
        size_t i = 0;
        (void)self;   /* a pure fold; the receiver is not used */
        while (s[i]) {
            h = h ^ (unsigned long)(unsigned char)s[i];
            h = h * 16777619UL;
            i++;
        }
        return h;
    }

    /* The key of unit `u`: what the emitted .c/.h are a function of. `-1` means
       "no key", which the caller takes as "cannot be reused" (a missing stamp or
       an over-long key must never be papered over). The `-I` roots are not listed
       because they can only change which file an import resolves to, and the
       resolved path is already part of that dependency's own key. */
    int key_of(int u, int line_force, int diag, char *out, size_t cap) {
        char stamp[64], ih[MAX_IMPORTS * MAX_NAME];
        unsigned long dep = 0;
        struct stat st;
        size_t n = 0, k;
        int w;

        if (stat(self->unit_path[u], &st) != 0) return -1;
        snprintf(stamp, sizeof stamp, "%lu.%lu",
                 (unsigned long)st.st_mtime, (unsigned long)st.st_size);

        ih[0] = 0;
        for (k = 0; k < (size_t)self->unit_nimp[u]; k++) {
            w = snprintf(ih + n, sizeof ih - n, "%s;", self->unit_imp[u][k]);
            if (w < 0 || (size_t)w >= sizeof ih - n) return -1;
            n += (size_t)w;
        }
        for (k = 0; k < (size_t)self->unit_ndep[u]; k++)
            dep = dep * 1099511628211UL + self->unit_digest[self->unit_dep[u][k]];

        w = snprintf(out, cap, "ctc %s L%d D%d N%s P%s S%s I%lu K%lu",
                     CTC_VERSION, line_force, diag, self->ns_root,
                     self->unit_path[u], stamp, self->digest(ih), dep);
        if (w < 0 || (size_t)w >= cap) return -1;
        /* publish the digest: dependants fold it into their own keys */
        self->unit_digest[u] = self->digest(out);
        return 0;
    }

    /* `<dir of outc>/.ctcache/<base>.key`: the cache sits beside the unit's own
       outputs, so `-o <dir>` keeps it out of the source tree. */
    int keyfile_of(const char *outc, char *dir, size_t dcap, char *key, size_t kcap) {
        const char *slash = strrchr(outc, '/');
        const char *base = slash ? slash + 1 : outc;
        int w;

        (void)self;  /* the paths are derived from the argument; the receiver is not used */
        if (slash) w = snprintf(dir, dcap, "%.*s/.ctcache", (int)(slash - outc), outc);
        else       w = snprintf(dir, dcap, ".ctcache");
        if (w < 0 || (size_t)w >= dcap) return -1;
        w = snprintf(key, kcap, "%s/%s.key", dir, base);
        if (w < 0 || (size_t)w >= kcap) return -1;
        return 0;
    }

    /* A hit needs the key file to match byte for byte and both artefacts on disk:
       a key that matches but whose .c/.h were deleted or never finished must not
       be reused. */
    int hit(const char *outc, const char *key) {
        char dir[MAX_NAME * 4], kf[MAX_NAME * 4], hp[MAX_NAME * 4];
        char buf[MAX_KEY];
        FILE *f;
        size_t n, kl, hl;

        if (self->keyfile_of(outc, dir, sizeof dir, kf, sizeof kf) != 0) return 0;
        f = fopen(kf, "r");
        if (!f) return 0;
        n = fread(buf, 1, sizeof buf, f);
        fclose(f);
        kl = strlen(key);
        if (n != kl || memcmp(buf, key, kl) != 0) return 0;

        /* the header is the .c's sibling: `foo.c` -> `foo.h` */
        snprintf(hp, sizeof hp, "%s", outc);
        hl = strlen(hp);
        if (hl < 3 || hp[hl - 1] != 'c' || hp[hl - 2] != '.') return 0;
        hp[hl - 1] = 'h';
        f = fopen(hp, "rb");
        if (!f) return 0;
        fclose(f);
        f = fopen(outc, "rb");
        if (!f) return 0;
        fclose(f);
        return 1;
    }

    /* Best effort by design: a cache that cannot be written costs a rebuild, never
       a broken build, so an unwritable directory stays silent. */
    void store(const char *outc, const char *key) {
        char dir[MAX_NAME * 4], kf[MAX_NAME * 4];
        FILE *f;

        if (self->keyfile_of(outc, dir, sizeof dir, kf, sizeof kf) != 0) return;
        mkdir(dir, 0755);            /* EEXIST on a warm cache is the normal case */
        f = fopen(kf, "w");
        if (!f) return;
        fprintf(f, "%s", key);       /* no newline: `hit` compares the file byte for byte */
        fclose(f);
    }
}

static struct Build g_build;

/* The name printed by `-v` and the usage line. `ct` is the Phase 7 single entry;
   any other argv[0] -- the `ctc` compatibility alias and the ctc-l2 binary the
   gates build included -- keeps the historical `ctc` identity, so no pinned
   diagnostic or version line moves. */
static const char *g_ct_prog = "ctc";

/* ------------------------------------------------- `build` driver (plain C) */

/* Output path for `in` in build mode: `<outdir>/<base>.c`, or beside the input. */
static int build_output(const char *in, const char *outdir, char *out, size_t cap)
{
    char base[MAX_NAME];
    const char *b = strrchr(in, '/');
    size_t l;

    b = b ? b + 1 : in;
    snprintf(base, sizeof base, "%s", b);
    l = strlen(base);
    /* `foo.h.ct` names a header unit: strip the whole `.h.ct` so the pair comes
       out as `foo.c` + `foo.h`; a plain `foo.ct` keeps its old `.c` name. */
    if (l > 5 && strcmp(base + l - 5, ".h.ct") == 0) base[l - 5] = 0;
    else if (l > 3 && strcmp(base + l - 3, ".ct") == 0) base[l - 3] = 0;

    if (outdir)
        return snprintf(out, cap, "%s/%s.c", outdir, base) >= (int)cap ? -1 : 0;
    return snprintf(out, cap, "%.*s%s.c", (int)(b - in), in, base) >= (int)cap ? -1 : 0;
}

/* Does the file exist? (used to probe import candidates.) */
static int file_exists(const char *p)
{
    FILE *f = fopen(p, "rb");
    if (!f) return 0;
    fclose(f);
    return 1;
}

/* Collect every `import a::b;` module in `path`, each as "a/b". Returns the count. */
static int collect_imports(const char *path, char mods[][MAX_NAME], int max)
{
    size_t pos = 0;
    unsigned long len = 0;
    char *src = ct_read_file(path, &len);
    int n = 0;

    while (pos < len) {
        size_t ls = pos, q = ls, e;
        while (q < len && (src[q] == ' ' || src[q] == '\t')) q++;
        if (q + 6 <= len && memcmp(src + q, "import", 6) == 0 &&
            (q + 6 == len || !ct_is_ident_char((unsigned char)src[q + 6]))) {
            size_t t = q + 6, k = 0;
            char mod[MAX_NAME];
            int ok = 1;
            while (t < len && (src[t] == ' ' || src[t] == '\t')) t++;
            mod[0] = 0;
            for (;;) {
                size_t s = t;
                while (t < len && ct_is_ident_char((unsigned char)src[t])) t++;
                if (t == s) { ok = 0; break; }
                if (k && k + 1 < sizeof mod) mod[k++] = '/';
                if (k + (t - s) + 1 >= sizeof mod) { ok = 0; break; }
                memcpy(mod + k, src + s, t - s);
                k += t - s;
                mod[k] = 0;
                while (t < len && (src[t] == ' ' || src[t] == '\t')) t++;
                if (t + 1 < len && src[t] == ':' && src[t + 1] == ':') {
                    t += 2;
                    while (t < len && (src[t] == ' ' || src[t] == '\t')) t++;
                    continue;
                }
                break;
            }
            if (ok && k && t < len && src[t] == ';') {
                if (n >= max) {   /* overflow dies, never truncates */
                    fprintf(stderr, "ctc: too many imports in '%s' (max %d)\n", path, max);
                    free(src);
                    exit(1);
                }
                snprintf(mods[n], MAX_NAME, "%s", mod);
                n++;
            }
        }
        e = ls;
        while (e < len && src[e] != '\n') e++;
        pos = (e < len) ? e + 1 : len;
    }
    free(src);
    return n;
}

/* Resolve `mod` ("a/b") against the importing file's directory, then every `-I`
   root in command-line order -> `<root>/a/b.ct` or `<root>/a/b.h.ct`. Returns 0
   on success. `k == -1` is the "own directory" sentinel. */
static int resolve_import(const char *importer, const char *mod, char *out, size_t cap)
{
    char dir[MAX_NAME * 2];
    const char *slash = strrchr(importer, '/');
    const char *root;
    int k;

    if (slash) {
        size_t n = (size_t)(slash - importer);
        if (n >= sizeof dir) n = sizeof dir - 1;
        memcpy(dir, importer, n);
        dir[n] = 0;
    } else {
        snprintf(dir, sizeof dir, ".");
    }

    for (k = -1; k < g_build.nincdirs; k++) {
        root = (k < 0) ? dir : g_build.incdir[k];
        if (snprintf(out, cap, "%s/%s.ct", root, mod) >= (int)cap) return -1;
        if (file_exists(out)) return 0;
        if (snprintf(out, cap, "%s/%s.h.ct", root, mod) >= (int)cap) return -1;
        if (file_exists(out)) return 0;
    }
    return -1;
}

/* ------------------------------------------------------------------ units */

static int unit_find(const char *path)
{
    int i;
    for (i = 0; i < g_build.unit_n; i++)
        if (strcmp(g_build.unit_path[i], path) == 0) return i;
    return -1;
}

/* Add `path` and its imports (post-order: dependencies land in g_build.order first). */
static int unit_visit(const char *path)
{
    int idx = unit_find(path), k;
    char mods[MAX_IMPORTS][MAX_NAME];
    int n;

    if (idx >= 0) return idx;                      /* already scheduled */

    if (g_build.unit_n >= MAX_UNITS) {
        fprintf(stderr, "ctc: too many units (max %d)\n", MAX_UNITS);
        return -1;
    }
    idx = g_build.unit_n++;
    snprintf(g_build.unit_path[idx], sizeof g_build.unit_path[0], "%s", path);
    g_build.unit_nimp[idx] = 0;
    g_build.unit_ndep[idx] = 0;

    n = collect_imports(path, mods, MAX_IMPORTS);
    for (k = 0; k < n; k++) {
        char dep[MAX_NAME * 4];
        const char *seg;
        char hname[MAX_NAME];
        int di;
        if (resolve_import(path, mods[k], dep, sizeof dep) != 0) {
            fprintf(stderr, "ctc: cannot resolve import '%s' from '%s'\n", mods[k], path);
            return -1;
        }
        /* keep the dependency's unit index: the incremental cache needs it to
           fold a dependency's key into this unit's own key */
        di = unit_visit(dep);
        if (di < 0) return -1;
        if (g_build.unit_ndep[idx] < MAX_IMPORTS)
            g_build.unit_dep[idx][g_build.unit_ndep[idx]++] = di;
        seg = strrchr(mods[k], '/');
        seg = seg ? seg + 1 : mods[k];
        snprintf(hname, sizeof hname, "%s.h", seg);
        if (g_build.unit_nimp[idx] < MAX_IMPORTS)
            snprintf(g_build.unit_imp[idx][g_build.unit_nimp[idx]++], MAX_NAME, "%s", hname);
    }

    g_build.order[g_build.order_n++] = idx;
    return idx;
}

/* `build`: resolve imports, compile every unit in dependency order in
   multi-file mode, then print the suggested cc command. The compiler never
   invokes a C compiler itself (it stays dependency-free). */
static int build_main(int argc, char **argv, const char *prog)
{
    const char *in[MAX_BUILD];
    const char *outdir = NULL;
    int n = 0, i, o;
    int dirty[MAX_UNITS];              /* 1 = must be compiled this run */
    int first = -1;                    /* first unit that is not reused */
    int line_force = -1;               /* -1 mode default, 0 --no-line, 1 --line */
    int diag = 0;                      /* 0 text warnings, 1 `--diagnostics=json` */
    /* The target C standard (Phase 6.4). Nothing in the emitted C needs a GNU
       extension yet, so the value only shapes the suggested cc command; it is
       still part of the CLI so a build script can state what it targets. */
    const char *std_flag = "-std=c99";

    for (i = 0; i < argc; i++) {
        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) { ct_usage(prog); return 0; }
        if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
            printf("%s v%s\n", g_ct_prog, CTC_VERSION);
            return 0;
        }
        if (strcmp(argv[i], "-o") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: -o needs an argument\n"); return 1; }
            outdir = argv[++i];
            continue;
        }
        if (strcmp(argv[i], "-I") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: -I needs an argument\n"); return 1; }
            if (g_build.nincdirs >= MAX_INCDIRS) {
                fprintf(stderr, "ctc: too many -I roots (max %d)\n", MAX_INCDIRS);
                return 1;
            }
            snprintf(g_build.incdir[g_build.nincdirs], sizeof g_build.incdir[0], "%s", argv[++i]);
            g_build.nincdirs++;
            continue;
        }
        if (strcmp(argv[i], "--ns-root") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: --ns-root needs an argument\n"); return 1; }
            if (snprintf(g_build.ns_root, sizeof g_build.ns_root, "%s", argv[++i])
                >= (int)sizeof g_build.ns_root) {
                fprintf(stderr, "ctc: namespace root too long\n");
                return 1;
            }
            g_build.has_ns_root = 1;
            continue;
        }
        if (strcmp(argv[i], "--line") == 0) { line_force = 1; continue; }
        if (strcmp(argv[i], "--no-line") == 0) { line_force = 0; continue; }
        if (strcmp(argv[i], "--emit-map") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: --emit-map needs an argument\n"); return 1; }
            if (snprintf(g_build.map_path, sizeof g_build.map_path, "%s", argv[++i])
                >= (int)sizeof g_build.map_path) {
                fprintf(stderr, "ctc: map path too long\n");
                return 1;
            }
            /* stdout carries the suggested cc command in build mode */
            if (strcmp(g_build.map_path, "-") == 0) {
                fprintf(stderr, "ctc: --emit-map - is not supported with build; write a file\n");
                return 1;
            }
            g_build.has_map = 1;
            continue;
        }
        if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
            const char *v = argv[i] + 14;
            if (strcmp(v, "json") == 0) { diag = 1; continue; }
            if (strcmp(v, "text") == 0) { diag = 0; continue; }
            fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
            return 1;
        }
        if (strncmp(argv[i], "--std=", 6) == 0) {
            const char *v = argv[i] + 6;
            if (strcmp(v, "c99") == 0) { std_flag = "-std=c99"; continue; }
            if (strcmp(v, "gnu99") == 0) { std_flag = "-std=gnu99"; continue; }
            fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
            return 1;
        }
        if (argv[i][0] == '-' && argv[i][1]) {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
            ct_usage(prog);
            return 1;
        }
        if (n >= MAX_BUILD) {
            fprintf(stderr, "ctc: too many inputs (max %d)\n", MAX_BUILD);
            return 1;
        }
        in[n++] = argv[i];
    }

    if (!n) { ct_usage(prog); return 1; }

    /* Directory = namespace needs a root: the explicit `--ns-root`, or the
       directory holding the first input (so `build src/main.ct` maps
       `src/hal/uart.ct` to `hal`). */
    if (!g_build.has_ns_root) {
        const char *s = strrchr(in[0], '/');
        if (s) {
            size_t l = (size_t)(s - in[0]);
            if (l >= sizeof g_build.ns_root) {
                fprintf(stderr, "ctc: namespace root too long\n");
                return 1;
            }
            memcpy(g_build.ns_root, in[0], l);
            g_build.ns_root[l] = 0;
        } else {
            snprintf(g_build.ns_root, sizeof g_build.ns_root, ".");
        }
        g_build.has_ns_root = 1;
    }

    for (i = 0; i < n; i++)
        if (unit_visit(in[i]) < 0) return 1;

    /* Incremental cache (Phase 6.3): decide, unit by unit, whether the .c/.h on
       disk can be reused. `build` fills one symbol table for the whole run, so a
       unit that is compiled needs the units before it in that table as well:
       the recompiled set is a prefix of `order`. A unit's key folds its
       dependencies' digests, so a change anywhere in a chain invalidates
       everything below it, and a unit whose dependency is being recompiled is
       recompiled too. `--emit-map` never reuses: the map spans the whole run, so
       a skipped unit would be missing from it. */
    for (o = 0; o < g_build.order_n; o++) {
        int u = g_build.order[o];
        int k;
        char key[MAX_KEY];
        dirty[u] = 1;                       /* default: recompile */
        if (build_output(g_build.unit_path[u], outdir, g_build.unit_out[u],
                         sizeof g_build.unit_out[0]) != 0) {
            fprintf(stderr, "ctc: output path too long for '%s'\n", g_build.unit_path[u]);
            return 1;
        }
        if (g_build.key_of(u, line_force, diag, key, sizeof key) == 0 &&
            !g_build.has_map && g_build.hit(g_build.unit_out[u], key))
            dirty[u] = 0;
        for (k = 0; k < g_build.unit_ndep[u]; k++)
            if (dirty[g_build.unit_dep[u][k]]) dirty[u] = 1;
        if (dirty[u] && first < 0) first = o;
    }

    for (o = 0; o < g_build.order_n; o++) {
        int u = g_build.order[o];
        int k;
        char ns_expect[MAX_NAME * 4];
        char key[MAX_KEY];
        /* the cache is warm for this unit and every unit before it */
        if (first < 0 || (o > first && !dirty[u])) continue;
        /* Derive the unit's directory namespace from the root. A unit outside
           the root, or one with a non-normalised (`./`, `../`) component, gets
           no expectation and is not checked. */
        ns_expect[0] = 0;
        {
            const char *up = g_build.unit_path[u];
            const char *root = g_build.ns_root;
            size_t rl, k = 0, j;
            int ok = 1;

            while (up[0] == '.' && up[1] == '/') up += 2;
            while (root[0] == '.' && root[1] == '/') root += 2;
            rl = strlen(root);
            if (!(rl == 0 || strcmp(root, ".") == 0)) {
                if (strncmp(up, root, rl) != 0 || up[rl] != '/') ok = 0;
                else up += rl + 1;
            }
            if (ok) {
                const char *slash = strrchr(up, '/');
                size_t dl = slash ? (size_t)(slash - up) : 0;
                j = 0;
                while (j < dl) {
                    size_t e = j;
                    while (e < dl && up[e] != '/') e++;
                    if (e == j || (e - j == 1 && up[j] == '.') ||
                        (e - j == 2 && up[j] == '.' && up[j + 1] == '.')) {
                        ok = 0;
                        break;
                    }
                    if (k) { ns_expect[k++] = ':'; ns_expect[k++] = ':'; }
                    if (k + (e - j) + 1 >= sizeof ns_expect) { ok = 0; break; }
                    memcpy(ns_expect + k, up + j, e - j);
                    k += e - j;
                    j = e + 1;
                }
                if (!ok) k = 0;
                ns_expect[k] = 0;
            }
        }
        ct_begin_imports();
        for (k = 0; k < g_build.unit_nimp[u]; k++)
            ct_add_import(g_build.unit_imp[u][k]);
        /* The map covers the whole run, so only the last unit writes it: by then
           every unit's symbols are in the table. */
        if (ct_compile_file(g_build.unit_path[u], g_build.unit_out[u], 1, line_force, diag,
                            ns_expect,
                            (g_build.has_map && o + 1 == g_build.order_n) ? g_build.map_path : NULL,
                            in[0]) != 0)
            return 1;
        /* the key is stamped only after a successful compile: a unit that failed
           must never be reused, and a stale key file must never be mistaken for
           the current symbol table */
        if (g_build.key_of(u, line_force, diag, key, sizeof key) == 0)
            g_build.store(g_build.unit_out[u], key);
    }

    ct_cc_reset();
    ct_cc_add(std_flag);          /* the suggested command states the target standard */
    for (o = 0; o < g_build.order_n; o++) ct_cc_add(g_build.unit_out[g_build.order[o]]);
    ct_cc_finish();
    return 0;
}

/* Compile one .ct file to .c + .h (single-file mode). argv[0..argc-1] are the
   compile arguments (argv[0] is not the program name); prog is for diagnostics. */
static int compile_main(int argc, char **argv, const char *prog)
{
    const char *in = NULL, *outc = NULL;
    char outbuf[MAX_NAME * 4];
    int i;
    int line_force = -1;               /* -1 mode default, 0 --no-line, 1 --line */
    int diag = 0;                      /* 0 text warnings, 1 `--diagnostics=json` */

    for (i = 0; i < argc; i++) {
        if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
            ct_usage(prog);
            return 0;
        }
        if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
            printf("%s v%s\n", g_ct_prog, CTC_VERSION);
            return 0;
        }
        if (strcmp(argv[i], "-o") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: -o needs an argument\n"); return 1; }
            outc = argv[++i];
            continue;
        }
        if (strcmp(argv[i], "-I") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: -I needs an argument\n"); return 1; }
            if (g_build.nincdirs >= MAX_INCDIRS) {
                fprintf(stderr, "ctc: too many -I roots (max %d)\n", MAX_INCDIRS);
                return 1;
            }
            snprintf(g_build.incdir[g_build.nincdirs], sizeof g_build.incdir[0], "%s", argv[++i]);
            g_build.nincdirs++;
            continue;
        }
        if (strcmp(argv[i], "--line") == 0) { line_force = 1; continue; }
        if (strcmp(argv[i], "--no-line") == 0) { line_force = 0; continue; }
        if (strcmp(argv[i], "--emit-map") == 0) {
            if (i + 1 >= argc) { fprintf(stderr, "ctc: --emit-map needs an argument\n"); return 1; }
            if (snprintf(g_build.map_path, sizeof g_build.map_path, "%s", argv[++i])
                >= (int)sizeof g_build.map_path) {
                fprintf(stderr, "ctc: map path too long\n");
                return 1;
            }
            g_build.has_map = 1;
            continue;
        }
        if (strncmp(argv[i], "--diagnostics=", 14) == 0) {
            const char *v = argv[i] + 14;
            if (strcmp(v, "json") == 0) { diag = 1; continue; }
            if (strcmp(v, "text") == 0) { diag = 0; continue; }
            fprintf(stderr, "ctc: unknown diagnostics format '%s'\n", v);
            return 1;
        }
        if (strncmp(argv[i], "--std=", 6) == 0) {
            const char *v = argv[i] + 6;
            /* compile mode suggests no cc command, and no emitted construct is
               GNU-specific yet: validate the target, accept it, change nothing */
            if (strcmp(v, "c99") != 0 && strcmp(v, "gnu99") != 0) {
                fprintf(stderr, "ctc: unknown C standard '%s'\n", v);
                return 1;
            }
            continue;
        }
        if (argv[i][0] == '-' && argv[i][1]) {
            fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
            ct_usage(prog);
            return 1;
        }
        in = argv[i];
    }

    if (!in) { ct_usage(prog); return 1; }
    if (!outc) { ct_default_output(in, outbuf, sizeof outbuf); outc = outbuf; }
    return ct_compile_file(in, outc, 0, line_force, diag, "",
                           g_build.has_map ? g_build.map_path : NULL, NULL);
}

/* ------------------------------------ package manager (Phase 8.1 + 8.2 + 8.3) */

/* ct-pkg reads a package's `ct.pkg`, checks a version range, resolves its `dep`
   lines recursively and vendors the tree into `./vendor/<name>`, recording what
   was taken in `./ct.lock`. 8.1 covers a local directory source (copy, no git);
   8.2 adds a git source, the only place in the compiler that runs a subprocess:
   the system `git` is invoked from `ct get` alone, never from `ct compile` or
   `ct build`. A spec is local when it begins with `.`, `/` or `file://`; anything
   else is a git source -- a full `scheme://` URL used verbatim, a `host/path`
   given `https://`, or a bare name resolved against `CT_REGISTRY`
   (default `https://github.com/ct-pkg`). 8.3 adds a content digest per lock line
   and `ct install`, which re-checks the vendored tree against the lock (offline,
   no subprocess) and prints the `ct build` command that uses `vendor/`. */
#define MAX_PKG_DEPS   16
#define MAX_PKG_PATH   (MAX_NAME * 4)
#define MAX_PKG_DEPTH  8
#define MAX_PKG_CMD    2048      /* a shell command line, with two quoted paths */

trait PkgOps {
    int  read_manifest(const char *dir, char *name, size_t ncap, char *ver, size_t vcap,
                       char deps[][MAX_PKG_PATH], int *ndeps);
    int  version_parse(const char *s, int v[3]);
    int  version_cmp(const int a[3], const int b[3]);
    int  range_match(const char *range, const char *ver);
    int  copy_file(const char *src, const char *dst);
    int  copy_tree(const char *src, const char *dst);
    int  split_spec(const char *spec, char *path, size_t pcap, char *range, size_t rcap);
    int  ensure_dir(const char *path);
    int  get_one(const char *dir, const char *range, int depth);
    int  get(const char *spec, const char *root);
    int  run(int argc, char **argv, const char *prog);
    /* Phase 8.2: git sources. `get_spec` is the dispatcher (git vs local) every
       dependency edge goes through; the rest are the git machinery, kept in one
       trait so the single subprocess call site stays auditable. */
    int  is_git_ref(const char *spec);
    int  git_url(const char *spec, char *url, size_t cap);
    int  git_name(const char *spec, char *name, size_t cap);
    int  git_avail(void);
    int  sh_quote(const char *s, char *out, size_t cap);
    int  git_run(const char *cmd, const char *outfile);
    int  read_line_of(const char *path, char *buf, size_t cap);
    int  git_pick_tag(const char *cache, const char *range, char *tag, size_t tcap);
    int  get_git(const char *spec, const char *range, int depth);
    int  get_spec(const char *spec, const char *base, int depth);
    /* Phase 8.3: the content digest a lock line carries and `ct install` checks.
       `digest` mirrors `CacheOps::digest` (FNV-1a), so a lock line and a
       `.ctcache` key fold the same way; `dir_digest` folds a whole package tree
       additively, so readdir order can never change the result. */
    unsigned long digest(const char *s);
    unsigned long file_digest(const char *path);
    unsigned long dir_sum(const char *dir, const char *rel);
    int  dir_digest(const char *dir, char *out, size_t cap);
    int  install(const char *prog);
}

struct Pkg {
    char lock[MAX_PKG_PATH * 8];
    int  locklen;
    int  nlocks;
    /* packages already vendored in this run: a diamond dependency must not be
       copied twice, and a cycle must terminate */
    char seen[MAX_PKG_DEPS][MAX_NAME];
    int  nseen;
} use PkgOps;

impl PkgOps for Pkg {
    /* Parse `<dir>/ct.pkg`. The format is deliberately line-oriented: `#` starts
       a comment, `key = value`, and `dep` may repeat. A missing name or version
       is an error -- a package without either cannot be resolved. */
    int read_manifest(const char *dir, char *name, size_t ncap, char *ver, size_t vcap,
                      char deps[][MAX_PKG_PATH], int *ndeps) {
        char path[MAX_PKG_PATH];
        unsigned long len = 0;
        char *src, *p, *end;
        (void)self;

        snprintf(path, sizeof path, "%s/ct.pkg", dir);
        src = ct_read_file(path, &len);
        if (!src) return -1;
        name[0] = 0;
        ver[0] = 0;
        *ndeps = 0;
        p = src;
        end = src + len;
        while (p < end) {
            char *ls = p, *le = p, *eq, *k, *v, *ve;
            size_t kl, vl;
            while (le < end && *le != '\n') le++;
            p = (le < end) ? le + 1 : end;
            while (ls < le && (*ls == ' ' || *ls == '\t')) ls++;
            if (ls == le || *ls == '#') continue;
            eq = ls;
            while (eq < le && *eq != '=') eq++;
            if (eq == le) continue;
            k = eq;
            while (k > ls && (k[-1] == ' ' || k[-1] == '\t')) k--;
            v = eq + 1;
            while (v < le && (*v == ' ' || *v == '\t')) v++;
            ve = le;
            while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t' || ve[-1] == '\r')) ve--;
            kl = (size_t)(k - ls);
            vl = (size_t)(ve - v);
            if (kl == 4 && memcmp(ls, "name", 4) == 0) {
                if (vl >= ncap) { free(src); return -1; }
                memcpy(name, v, vl);
                name[vl] = 0;
            } else if (kl == 7 && memcmp(ls, "version", 7) == 0) {
                if (vl >= vcap) { free(src); return -1; }
                memcpy(ver, v, vl);
                ver[vl] = 0;
            } else if (kl == 3 && memcmp(ls, "dep", 3) == 0) {
                if (*ndeps >= MAX_PKG_DEPS || vl + 1 >= MAX_PKG_PATH) { free(src); return -1; }
                memcpy(deps[*ndeps], v, vl);
                deps[*ndeps][vl] = 0;
                (*ndeps)++;
            }
        }
        free(src);
        return (name[0] && ver[0]) ? 0 : -1;
    }

    int version_parse(const char *s, int v[3]) {
        int n;
        (void)self;
        v[0] = 0; v[1] = 0; v[2] = 0;
        n = sscanf(s, "%d.%d.%d", &v[0], &v[1], &v[2]);
        return (n >= 1) ? 0 : -1;
    }

    int version_cmp(const int a[3], const int b[3]) {
        int i;
        (void)self;
        for (i = 0; i < 3; i++) {
            if (a[i] < b[i]) return -1;
            if (a[i] > b[i]) return 1;
        }
        return 0;
    }

    /* `^x.y.z` = same major and >= x.y.z; `~x.y.z` = same major.minor and >= x.y.z;
       anything else is an exact match. An empty range or `*` accepts any version. */
    int range_match(const char *range, const char *ver) {
        int v[3], lo[3], op = 0;
        const char *r = range;
        (void)self;

        if (!range || !range[0] || strcmp(range, "*") == 0) return 1;
        if (r[0] == '^') { op = 1; r++; }
        else if (r[0] == '~') { op = 2; r++; }
        if (self->version_parse(r, lo) != 0) return 0;
        if (self->version_parse(ver, v) != 0) return 0;
        if (op == 1) {
            if (v[0] != lo[0]) return 0;
            return self->version_cmp(v, lo) >= 0;
        }
        if (op == 2) {
            if (v[0] != lo[0] || v[1] != lo[1]) return 0;
            return self->version_cmp(v, lo) >= 0;
        }
        return self->version_cmp(v, lo) == 0;
    }

    int copy_file(const char *src, const char *dst) {
        FILE *in, *out;
        char buf[4096];
        size_t n;
        (void)self;

        in = fopen(src, "rb");
        if (!in) return -1;
        out = fopen(dst, "wb");
        if (!out) { fclose(in); return -1; }
        while ((n = fread(buf, 1, sizeof buf, in)) > 0) {
            if (fwrite(buf, 1, n, out) != n) { fclose(in); fclose(out); return -1; }
        }
        fclose(in);
        if (fclose(out) != 0) return -1;
        return 0;
    }

    /* Copy a package directory. Build caches and VCS metadata are not package
       content, so they are skipped rather than vendored. */
    int copy_tree(const char *src, const char *dst) {
        DIR *d;
        struct dirent *e;
        struct stat st;
        char s[MAX_PKG_PATH], t[MAX_PKG_PATH];
        int rc = 0;
        (void)self;

        if (mkdir(dst, 0755) != 0) {
            struct stat ds;
            if (stat(dst, &ds) != 0 || !S_ISDIR(ds.st_mode)) return -1;
        }
        d = opendir(src);
        if (!d) return -1;
        while ((e = readdir(d)) != NULL) {
            if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
            if (strcmp(e->d_name, ".git") == 0 || strcmp(e->d_name, "vendor") == 0) continue;
            if (strcmp(e->d_name, ".ctcache") == 0) continue;
            snprintf(s, sizeof s, "%s/%s", src, e->d_name);
            snprintf(t, sizeof t, "%s/%s", dst, e->d_name);
            if (stat(s, &st) != 0) { rc = -1; break; }
            if (S_ISDIR(st.st_mode)) {
                if (self->copy_tree(s, t) != 0) { rc = -1; break; }
            } else if (S_ISREG(st.st_mode)) {
                if (self->copy_file(s, t) != 0) { rc = -1; break; }
            }
        }
        closedir(d);
        return rc;
    }

    /* FNV-1a, mirroring `CacheOps::digest`: the same fold the `.ctcache` key
       uses, so a lock digest and a cache key are comparable. Change detection
       only -- it is not a cryptographic hash (design D27). */
    unsigned long digest(const char *s) {
        unsigned long h = 2166136261UL;
        size_t i = 0;
        (void)self;
        while (s[i]) {
            h = h ^ (unsigned long)(unsigned char)s[i];
            h = h * 16777619UL;
            i++;
        }
        return h;
    }

    /* FNV-1a over a file's raw bytes. A file that cannot be read contributes 0;
       `dir_digest` re-checks that its directory exists, so a vanished package is
       reported rather than quietly hashed. */
    unsigned long file_digest(const char *path) {
        unsigned long h = 2166136261UL;
        FILE *f;
        int c;
        (void)self;
        f = fopen(path, "rb");
        if (!f) return 0;
        while ((c = fgetc(f)) != EOF) {
            h = h ^ (unsigned long)(unsigned char)c;
            h = h * 16777619UL;
        }
        fclose(f);
        return h;
    }

    /* Additively fold every regular file under `dir` (relative names carried in
       `rel`), skipping the same build/VCS directories `copy_tree` skips so a
       source tree and its vendored copy hash equal. Addition is commutative, so
       readdir order cannot change the digest. */
    unsigned long dir_sum(const char *dir, const char *rel) {
        DIR *d;
        struct dirent *e;
        struct stat st;
        char full[MAX_PKG_PATH], r[MAX_PKG_PATH];
        unsigned long total = 0;
        int w;

        (void)self;
        d = opendir(dir);
        if (!d) return 0;
        while ((e = readdir(d)) != NULL) {
            if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
            if (strcmp(e->d_name, ".git") == 0 || strcmp(e->d_name, "vendor") == 0) continue;
            if (strcmp(e->d_name, ".ctcache") == 0) continue;
            if (snprintf(full, sizeof full, "%s/%s", dir, e->d_name) >= (int)sizeof full) continue;
            if (rel[0]) w = snprintf(r, sizeof r, "%s/%s", rel, e->d_name);
            else        w = snprintf(r, sizeof r, "%s", e->d_name);
            if (w < 0 || (size_t)w >= sizeof r) continue;
            if (stat(full, &st) != 0) continue;
            if (S_ISDIR(st.st_mode)) total += self->dir_sum(full, r);
            else if (S_ISREG(st.st_mode)) total += self->file_digest(full) ^ self->digest(r);
        }
        closedir(d);
        return total;
    }

    /* Hex digest of a package directory; `-1` if it is not a readable directory,
       which the caller turns into a hard failure rather than a silent zero. */
    int dir_digest(const char *dir, char *out, size_t cap) {
        struct stat st;
        unsigned long h;
        int w;
        (void)self;
        if (stat(dir, &st) != 0 || !S_ISDIR(st.st_mode)) return -1;
        h = self->dir_sum(dir, "");
        w = snprintf(out, cap, "%016lx", h);
        if (w < 0 || (size_t)w >= cap) return -1;
        return 0;
    }

    /* Create `path` if it is missing; an existing directory is success (an
       EEXIST from a warm cache or a pre-created `vendor/` is the normal case). */
    int ensure_dir(const char *path) {
        struct stat st;
        (void)self;

        if (mkdir(path, 0755) == 0) return 0;
        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 0;
        return -1;
    }

    /* `path[@range]`: the last `@` separates the two, so a path may contain one. */
    int split_spec(const char *spec, char *path, size_t pcap, char *range, size_t rcap) {
        const char *at = NULL, *q;
        size_t n;
        (void)self;

        for (q = spec; *q; q++)
            if (*q == '@') at = q;
        if (!at) {
            if (strlen(spec) >= pcap) return -1;
            snprintf(path, pcap, "%s", spec);
            range[0] = 0;
            return 0;
        }
        n = (size_t)(at - spec);
        if (n >= pcap || strlen(at + 1) >= rcap) return -1;
        memcpy(path, spec, n);
        path[n] = 0;
        snprintf(range, rcap, "%s", at + 1);
        return 0;
    }

    /* A spec is a git source unless it names a filesystem location: a relative or
       absolute path, or a `file://` URL (copied, not cloned -- see design §4). */
    int is_git_ref(const char *spec) {
        (void)self;
        if (spec[0] == '.' || spec[0] == '/') return 0;
        if (strncmp(spec, "file://", 7) == 0) return 0;
        return 1;
    }

    /* Turn a git spec into a clone URL: a `scheme://` URL is taken verbatim, a
       bare `host/path` gets `https://`, and a package name alone is resolved
       against the registry (default `https://github.com/ct-pkg`). */
    int git_url(const char *spec, char *url, size_t cap) {
        const char *reg;
        int w;
        (void)self;

        if (strstr(spec, "://")) {
            if (strlen(spec) >= cap) return -1;
            snprintf(url, cap, "%s", spec);
            return 0;
        }
        if (strchr(spec, '/')) {
            w = snprintf(url, cap, "https://%s", spec);
            if (w < 0 || (size_t)w >= cap) return -1;
            return 0;
        }
        reg = getenv("CT_REGISTRY");
        if (!reg || !reg[0]) reg = "https://github.com/ct-pkg";
        w = snprintf(url, cap, "%s/%s", reg, spec);
        if (w < 0 || (size_t)w >= cap) return -1;
        return 0;
    }

    /* The vendor directory is named after the last path segment of the spec. */
    int git_name(const char *spec, char *name, size_t cap) {
        const char *b, *e;
        size_t l;
        (void)self;

        e = spec + strlen(spec);
        while (e > spec && e[-1] == '/') e--;
        b = e;
        while (b > spec && b[-1] != '/') b--;
        l = (size_t)(e - b);
        if (l == 0 || l >= cap) return -1;
        memcpy(name, b, l);
        name[l] = 0;
        return 0;
    }

    int git_avail(void) {
        (void)self;
        return system("git --version >/dev/null 2>&1") == 0;
    }

    /* Single-quote `s` for the shell, escaping embedded quotes as `'\''`. Every
       path and URL that reaches `git_run` goes through here, so a spec can never
       break out of its argument. */
    int sh_quote(const char *s, char *out, size_t cap) {
        size_t n = 0, i;
        (void)self;

        if (cap < 4) return -1;
        out[n++] = '\'';
        for (i = 0; s[i]; i++) {
            if (s[i] == '\'') {
                if (n + 5 >= cap) return -1;
                out[n++] = '\''; out[n++] = '\\'; out[n++] = '\''; out[n++] = '\'';
            } else {
                if (n + 2 >= cap) return -1;
                out[n++] = s[i];
            }
        }
        out[n++] = '\'';
        out[n] = 0;
        return 0;
    }

    /* The one subprocess call site. A command's exit status is the result; when
       `outfile` is given, stdout is captured there for `read_line_of`. `system`
       requires a shell, so every path splice is pre-quoted by the caller. */
    int git_run(const char *cmd, const char *outfile) {
        char full[MAX_PKG_CMD], qo[MAX_PKG_CMD];
        int w;
        (void)self;

        if (outfile) {
            if (self->sh_quote(outfile, qo, sizeof qo) != 0) return -1;
            w = snprintf(full, sizeof full, "%s > %s 2>/dev/null", cmd, qo);
        } else {
            w = snprintf(full, sizeof full, "%s 2>/dev/null", cmd);
        }
        if (w < 0 || (size_t)w >= sizeof full) return -1;
        return system(full);
    }

    /* First line of a captured-output file, without the trailing newline. */
    int read_line_of(const char *path, char *buf, size_t cap) {
        FILE *f;
        size_t n = 0;
        int c;
        (void)self;

        f = fopen(path, "r");
        if (!f) return -1;
        while ((c = fgetc(f)) != EOF && c != '\n' && c != '\r') {
            if (n + 1 >= cap) { fclose(f); return -1; }
            buf[n++] = (char)c;
        }
        fclose(f);
        buf[n] = 0;
        return 0;
    }

    /* Pick the version to lock: among the repository's tags, treated as SemVer
       (a leading `v` is optional), take the **lowest** one satisfying `range`
       (minimal version selection). `0` means a tag was chosen and written to
       `tag`; `-2` means there are no tags and the range accepts any version, so
       the caller falls back to the default branch; `-1` means no tag fits. */
    int git_pick_tag(const char *cache, const char *range, char *tag, size_t tcap) {
        char q1[MAX_PKG_CMD], cmd[MAX_PKG_CMD], out[MAX_PKG_CMD], root[MAX_PKG_CMD];
        const char *home;
        unsigned long len = 0;
        char *src, *p, *end;
        int have = 0, v[3], best[3], w;

        home = getenv("HOME");
        if (!home || !home[0]) return -1;
        if (snprintf(root, sizeof root, "%s/.cache/ct-pkg", home) >= (int)sizeof root) return -1;
        if (snprintf(out, sizeof out, "%s/.ct-pkg.tags", root) >= (int)sizeof out) return -1;
        tag[0] = 0;
        if (self->sh_quote(cache, q1, sizeof q1) != 0) return -1;
        w = snprintf(cmd, sizeof cmd, "git -C %s tag -l", q1);
        if (w < 0 || (size_t)w >= sizeof cmd) return -1;
        if (self->git_run(cmd, out) != 0) return -1;

        src = ct_read_file(out, &len);
        if (!src) return -1;
        p = src;
        end = src + len;
        while (p < end) {
            char *ls = p, *le = p, *vp;
            char tmp[MAX_NAME];
            size_t vl, tl;
            while (le < end && *le != '\n') le++;
            p = (le < end) ? le + 1 : end;
            while (le > ls && (le[-1] == '\r' || le[-1] == ' ' || le[-1] == '\t')) le--;
            while (ls < le && (*ls == ' ' || *ls == '\t')) ls++;
            if (ls == le) continue;
            vp = ls;
            vl = (size_t)(le - ls);
            if (vl && *vp == 'v') { vp++; vl--; }
            if (vl == 0 || vl >= sizeof tmp) continue;
            memcpy(tmp, vp, vl);
            tmp[vl] = 0;
            if (self->version_parse(tmp, v) != 0) continue;
            if (!self->range_match(range, tmp)) continue;
            tl = (size_t)(le - ls);
            if (tl == 0 || tl >= tcap) continue;
            if (!have || self->version_cmp(v, best) < 0) {
                memcpy(tag, ls, tl);
                tag[tl] = 0;
                best[0] = v[0]; best[1] = v[1]; best[2] = v[2];
                have = 1;
            }
        }
        free(src);
        if (have) return 0;
        if (!range || !range[0] || strcmp(range, "*") == 0) return -2;
        return -1;
    }

    /* Fetch a git package into the cache, check out the version the range picks,
       pin the resulting commit, then resolve and vendor it like a local source. */
    int get_git(const char *spec, const char *range, int depth) {
        char url[MAX_PKG_CMD], name[MAX_NAME], hdir[MAX_PKG_CMD], root[MAX_PKG_CMD];
        char cache[MAX_PKG_CMD], gitdir[MAX_PKG_CMD], out[MAX_PKG_CMD];
        char q1[MAX_PKG_CMD], q2[MAX_PKG_CMD], cmd[MAX_PKG_CMD];
        char mname[MAX_NAME], mver[32], deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char tag[MAX_NAME], commit[64], dig[32], dst[MAX_PKG_PATH];
        const char *home;
        struct stat st;
        int ndeps = 0, i, w, rc, fresh;

        if (depth > MAX_PKG_DEPTH) {
            fprintf(stderr, "ctc: dependency chain is too deep at '%s'\n", spec);
            return -1;
        }
        if (!self->git_avail()) {
            fprintf(stderr, "ctc: git is required for '%s' but was not found; "
                            "install git or use a local directory source\n", spec);
            return -1;
        }
        if (self->git_url(spec, url, sizeof url) != 0) {
            fprintf(stderr, "ctc: cannot resolve a git url for '%s'\n", spec);
            return -1;
        }
        if (self->git_name(spec, name, sizeof name) != 0) {
            fprintf(stderr, "ctc: cannot derive a package name from '%s'\n", spec);
            return -1;
        }
        home = getenv("HOME");
        if (!home || !home[0]) {
            fprintf(stderr, "ctc: cannot locate the package cache (HOME is unset)\n");
            return -1;
        }
        if (snprintf(hdir, sizeof hdir, "%s/.cache", home) >= (int)sizeof hdir) return -1;
        if (snprintf(root, sizeof root, "%s/.cache/ct-pkg", home) >= (int)sizeof root) return -1;
        if (snprintf(cache, sizeof cache, "%s/%s", root, name) >= (int)sizeof cache) return -1;
        if (snprintf(gitdir, sizeof gitdir, "%s/.git", cache) >= (int)sizeof gitdir) return -1;
        if (snprintf(out, sizeof out, "%s/.ct-pkg.out", root) >= (int)sizeof out) return -1;
        if (self->ensure_dir(hdir) != 0 || self->ensure_dir(root) != 0) {
            fprintf(stderr, "ctc: cannot create the package cache '%s'\n", root);
            return -1;
        }

        fresh = (stat(gitdir, &st) != 0 || !S_ISDIR(st.st_mode));
        if (self->sh_quote(url, q1, sizeof q1) != 0) return -1;
        if (self->sh_quote(cache, q2, sizeof q2) != 0) return -1;
        if (fresh) {
            w = snprintf(cmd, sizeof cmd, "git clone --quiet %s %s", q1, q2);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git clone of '%s' failed\n", url);
                return -1;
            }
        } else {
            w = snprintf(cmd, sizeof cmd, "git -C %s fetch --quiet --tags --force", q2);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git fetch of '%s' failed\n", url);
                return -1;
            }
        }

        rc = self->git_pick_tag(cache, range, tag, sizeof tag);
        if (rc == 0) {
            if (self->sh_quote(tag, q1, sizeof q1) != 0) return -1;
            w = snprintf(cmd, sizeof cmd, "git -C %s checkout --quiet --detach %s", q2, q1);
            if (w < 0 || (size_t)w >= sizeof cmd) return -1;
            if (self->git_run(cmd, NULL) != 0) {
                fprintf(stderr, "ctc: git checkout of '%s' failed\n", tag);
                return -1;
            }
        } else if (rc == -2) {
            /* no tags: the default branch tip is the only version on offer */
            if (!fresh) {
                w = snprintf(cmd, sizeof cmd, "git -C %s reset --hard --quiet origin/HEAD", q2);
                if (w >= 0 && (size_t)w < sizeof cmd) self->git_run(cmd, NULL);
            }
        } else {
            fprintf(stderr, "ctc: no tag of '%s' satisfies '%s'\n", name, range);
            return -1;
        }

        w = snprintf(cmd, sizeof cmd, "git -C %s rev-parse --verify HEAD", q2);
        if (w < 0 || (size_t)w >= sizeof cmd) return -1;
        if (self->git_run(cmd, out) != 0) {
            fprintf(stderr, "ctc: git cannot resolve a commit for '%s'\n", name);
            return -1;
        }
        if (self->read_line_of(out, commit, sizeof commit) != 0 || commit[0] == 0) {
            fprintf(stderr, "ctc: git returned no commit for '%s'\n", name);
            return -1;
        }

        if (self->read_manifest(cache, mname, sizeof mname, mver, sizeof mver, deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", cache);
            return -1;
        }
        if (!self->range_match(range, mver)) {
            fprintf(stderr, "ctc: %s %s does not satisfy '%s'\n", mname, mver, range);
            return -1;
        }
        for (i = 0; i < self->nseen; i++)
            if (strcmp(self->seen[i], mname) == 0) return 0;
        if (self->nseen >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: too many packages (max %d)\n", MAX_PKG_DEPS);
            return -1;
        }
        snprintf(self->seen[self->nseen], MAX_NAME, "%s", mname);
        self->nseen++;

        for (i = 0; i < ndeps; i++)
            if (self->get_spec(deps[i], cache, depth + 1) != 0) return -1;

        if (snprintf(dst, sizeof dst, "./vendor/%s", mname) >= (int)sizeof dst) return -1;
        if (self->copy_tree(cache, dst) != 0) {
            fprintf(stderr, "ctc: cannot vendor '%s' from '%s'\n", mname, cache);
            return -1;
        }
        if (self->dir_digest(cache, dig, sizeof dig) != 0) {
            fprintf(stderr, "ctc: cannot hash '%s'\n", cache);
            return -1;
        }
        w = snprintf(self->lock + self->locklen, sizeof self->lock - (size_t)self->locklen,
                     "%s %s git %s %s\n", mname, mver, commit, dig);
        if (w < 0 || (size_t)w >= sizeof self->lock - (size_t)self->locklen) return -1;
        self->locklen += w;
        self->nlocks++;
        return 0;
    }

    /* The single entry every dependency edge takes: split off the range, then
       route to `get_git` or, for a filesystem location, to `get_one`. */
    int get_spec(const char *spec, const char *base, int depth) {
        char path[MAX_PKG_PATH], range[32], full[MAX_PKG_PATH];
        (void)self;

        if (self->split_spec(spec, path, sizeof path, range, sizeof range) != 0) return -1;
        if (self->is_git_ref(path)) return self->get_git(path, range, depth);
        if (strncmp(path, "file://", 7) == 0) {
            if (snprintf(full, sizeof full, "%s", path + 7) >= (int)sizeof full) return -1;
        } else if (path[0] == '/') {
            if (snprintf(full, sizeof full, "%s", path) >= (int)sizeof full) return -1;
        } else if (snprintf(full, sizeof full, "%s/%s", base, path) >= (int)sizeof full) {
            return -1;
        }
        return self->get_one(full, range, depth);
    }

    int get_one(const char *dir, const char *range, int depth) {
        char name[MAX_NAME], ver[32], deps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char dig[32], dst[MAX_PKG_PATH];
        int ndeps = 0, i, w;
        (void)self;

        if (depth > MAX_PKG_DEPTH) {
            fprintf(stderr, "ctc: dependency chain is too deep at '%s'\n", dir);
            return -1;
        }
        if (self->read_manifest(dir, name, sizeof name, ver, sizeof ver, deps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read '%s/ct.pkg'\n", dir);
            return -1;
        }
        if (!self->range_match(range, ver)) {
            fprintf(stderr, "ctc: %s %s does not satisfy '%s'\n", name, ver, range);
            return -1;
        }
        for (i = 0; i < self->nseen; i++)
            if (strcmp(self->seen[i], name) == 0) return 0;
        if (self->nseen >= MAX_PKG_DEPS) {
            fprintf(stderr, "ctc: too many packages (max %d)\n", MAX_PKG_DEPS);
            return -1;
        }
        snprintf(self->seen[self->nseen], MAX_NAME, "%s", name);
        self->nseen++;

        /* dependencies first: the lock file is written in resolution order, so a
           reader can vendor them back without re-running the resolver. Each edge
           is dispatched by `get_spec`, so a local package may depend on a git one
           (and vice versa) -- relative paths resolve against `dir`, the package
           root just read. */
        for (i = 0; i < ndeps; i++)
            if (self->get_spec(deps[i], dir, depth + 1) != 0) return -1;

        if (snprintf(dst, sizeof dst, "./vendor/%s", name) >= (int)sizeof dst) return -1;
        if (self->copy_tree(dir, dst) != 0) {
            fprintf(stderr, "ctc: cannot vendor '%s' from '%s'\n", name, dir);
            return -1;
        }
        if (self->dir_digest(dir, dig, sizeof dig) != 0) {
            fprintf(stderr, "ctc: cannot hash '%s'\n", dir);
            return -1;
        }
        w = snprintf(self->lock + self->locklen, sizeof self->lock - (size_t)self->locklen,
                     "%s %s dir %s %s\n", name, ver, dir, dig);
        if (w < 0 || (size_t)w >= sizeof self->lock - (size_t)self->locklen) return -1;
        self->locklen += w;
        self->nlocks++;
        return 0;
    }

    int get(const char *spec, const char *root) {
        FILE *f;

        self->locklen = 0;
        self->nseen = 0;
        self->nlocks = 0;
        /* `copy_tree` creates the package directory itself, not its parent. */
        if (self->ensure_dir("./vendor") != 0) {
            fprintf(stderr, "ctc: cannot create 'vendor/'\n");
            return 1;
        }
        if (self->get_spec(spec, root, 0) != 0) return 1;

        f = fopen("./ct.lock", "w");
        if (!f) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        fputs(self->lock, f);
        if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot write 'ct.lock'\n"); return 1; }
        printf("vendored %d package(s)\n", self->nlocks);
        return 0;
    }

    /* `ct install` (Phase 8.3): verify the lock against the vendored tree and the
       project manifest, then print the `ct build` command that compiles with it.
       It never fetches, never calls `cc` and never edits the manifest -- `get`
       owns those (design D24). A missing package, a moved content digest or a
       manifest dependency the lock does not cover is a hard failure. */
    int install(const char *prog) {
        FILE *f;
        DIR *d;
        struct dirent *e;
        struct stat st;
        char line[MAX_PKG_PATH * 2];
        char pname[MAX_NAME], pver[32], pdeps[MAX_PKG_DEPS][MAX_PKG_PATH];
        char lname[MAX_PKG_DEPS][MAX_NAME], lver[MAX_PKG_DEPS][32];
        char vdir[MAX_PKG_PATH], vdig[32];
        char dpath[MAX_PKG_PATH], drange[32], dname[MAX_NAME];
        int ndeps = 0, nlock = 0, i, j, rc = 0, units = 0, seen;
        size_t nl;

        if (self->read_manifest(".", pname, sizeof pname, pver, sizeof pver, pdeps, &ndeps) != 0) {
            fprintf(stderr, "ctc: cannot read './ct.pkg'\n");
            return 1;
        }
        f = fopen("./ct.lock", "r");
        if (!f) {
            fprintf(stderr, "ctc: no './ct.lock'; run `%s get` first\n", prog);
            return 1;
        }
        while (fgets(line, sizeof line, f) != NULL) {
            char *tok[12];
            int ntok = 0;
            char *p = line;
            size_t ll = strlen(line);
            while (ll && (line[ll - 1] == '\n' || line[ll - 1] == '\r')) line[--ll] = 0;
            while (*p) {
                while (*p == ' ' || *p == '\t') p++;
                if (!*p) break;
                if (ntok < (int)(sizeof tok / sizeof tok[0])) tok[ntok++] = p;
                while (*p && *p != ' ' && *p != '\t') p++;
                if (*p) { *p = 0; p++; }
            }
            if (ntok < 4) continue;
            if (nlock >= MAX_PKG_DEPS) {
                fprintf(stderr, "ctc: ct.lock lists more than %d packages\n", MAX_PKG_DEPS);
                fclose(f);
                return 1;
            }
            snprintf(lname[nlock], MAX_NAME, "%s", tok[0]);
            snprintf(lver[nlock], 32, "%s", tok[1]);
            /* the content digest is the last token; the ref in between may hold
               spaces, so only the first three columns are positional */
            if (snprintf(vdir, sizeof vdir, "./vendor/%s", tok[0]) >= (int)sizeof vdir) {
                fprintf(stderr, "ctc: package path too long for '%s'\n", tok[0]);
                rc = 1;
            } else if (self->dir_digest(vdir, vdig, sizeof vdig) != 0) {
                fprintf(stderr, "ctc: '%s' is locked but not vendored at '%s'\n", tok[0], vdir);
                rc = 1;
            } else if (strcmp(vdig, tok[ntok - 1]) != 0) {
                fprintf(stderr, "ctc: '%s' does not match ct.lock (vendor %s, lock %s)\n",
                        tok[0], vdig, tok[ntok - 1]);
                rc = 1;
            }
            nlock++;
        }
        if (fclose(f) != 0) { fprintf(stderr, "ctc: cannot read './ct.lock'\n"); return 1; }
        if (nlock == 0) { fprintf(stderr, "ctc: ct.lock is empty\n"); return 1; }

        /* Every dependency the manifest declares must be in the lock, at a
           version inside its range -- otherwise the vendored tree is not what
           the project asked for. The package name is the spec's last segment
           (D21: a package's directory names it). */
        for (i = 0; i < ndeps; i++) {
            if (self->split_spec(pdeps[i], dpath, sizeof dpath, drange, sizeof drange) != 0
                || self->git_name(dpath, dname, sizeof dname) != 0) {
                fprintf(stderr, "ctc: bad dependency '%s'\n", pdeps[i]);
                rc = 1;
                continue;
            }
            seen = 0;
            for (j = 0; j < nlock; j++)
                if (strcmp(lname[j], dname) == 0 && self->range_match(drange, lver[j])) seen = 1;
            if (!seen) {
                fprintf(stderr, "ctc: dependency '%s' is not satisfied by ct.lock\n", pdeps[i]);
                rc = 1;
            }
        }
        if (rc != 0) return 1;

        /* the command the user runs next: vendored packages become `-I` roots,
           the project's own top-level `.ct` files are the units */
        printf("%s build", prog);
        for (i = 0; i < nlock; i++) printf(" -I vendor/%s", lname[i]);
        d = opendir(".");
        if (d) {
            while ((e = readdir(d)) != NULL) {
                nl = strlen(e->d_name);
                if (nl <= 3 || strcmp(e->d_name + nl - 3, ".ct") != 0) continue;
                if (stat(e->d_name, &st) != 0 || !S_ISREG(st.st_mode)) continue;
                printf(" %s", e->d_name);
                units++;
            }
            closedir(d);
        }
        if (units == 0) printf(" <unit>.ct");
        printf(" -o build\n");
        return 0;
    }

    int run(int argc, char **argv, const char *prog) {
        const char *spec = NULL;
        int i;

        for (i = 0; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: %s get <spec>[@<range>]\n", prog);
                printf("  spec: a local directory (. or / or file://) or a git package\n"
                       "        (name resolved against CT_REGISTRY, else an https URL)\n");
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("%s v%s\n", g_ct_prog, CTC_VERSION);
                return 0;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ctc: unknown option '%s'\n", argv[i]);
                return 1;
            }
            spec = argv[i];
        }
        if (!spec) {
            fprintf(stderr, "usage: %s get <spec>[@<range>]\n", prog);
            return 1;
        }
        return self->get(spec, ".");
    }
}

/* The instance lives after the impl: its vptr initialiser needs the vtable
   forward declaration the emitter places with the impl. */
static struct Pkg g_pkg;

int main(int argc, char **argv)
{
    int first = 1;
    const char *base = strrchr(argv[0], '/');

    base = base ? base + 1 : argv[0];
    if (strcmp(base, "ct") == 0) g_ct_prog = "ct";

    /* Single-entry `ct` with `ctc` kept as a compatibility alias. `compile` is
       the default subcommand (`ct X` == `ct compile X`); `build` compiles
       several units in multi-file mode. */
    if (first < argc && strcmp(argv[first], "build") == 0)
        return build_main(argc - first - 1, argv + first + 1, g_ct_prog);

    /* Phase 8.1/8.2: `ct get <spec>[@<range>]` vendors a local or git package. */
    if (first < argc && strcmp(argv[first], "get") == 0)
        return g_pkg.run(argc - first - 1, argv + first + 1, g_ct_prog);

    /* Phase 8.3: `ct install` verifies the vendored tree against `ct.lock` and
       prints the `ct build` command that compiles with it. */
    if (first < argc && strcmp(argv[first], "install") == 0)
        return g_pkg.install(g_ct_prog);

    if (first < argc && strcmp(argv[first], "compile") == 0)
        first++;

    return compile_main(argc - first, argv + first, g_ct_prog);
}
