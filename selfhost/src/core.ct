/*
 * core.ct - L1 core unit: the facilities, the data model and the whole pipeline.
 *
 * Part of the multi-unit split of the self-hosted compiler (Phase 2). `driver.ct`
 * is the other unit: it owns the CLI, the unit tables and `main`, and reaches this
 * unit only through the `pub` wrappers at the end of this file. The split dogfoods
 * `ctc build`; it must not move the generated corpus (L2 == L1 byte for byte).
 *
 * Why this unit is large: the facilities (`die`, `word_at`, `buf_*`, ...) read the
 * file-scope soup of scanning statics (`g_src`, `g_len`, `g_path`, ...) and are used
 * by the whole pipeline, so they cannot be moved to a second unit -- L1 has no `pub`
 * globals. Nor can the data model be exported through a header: a preprocessor line
 * is emitted verbatim into the .c (never the .h), so a generated header cannot carry
 * the `MAX_*` macros its fixed-size fields need, and the pipeline's own types name
 * `FILE *` / `size_t`, which a header has no way to include. Everything sharing that
 * state therefore stays here, and only primitives-only wrappers cross the boundary.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <ctype.h>
#include <setjmp.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_NAME   128
#define MAX_PARAM  256
#define MAX_PARAMS 16
#define MAX_METHOD 32
#define MAX_TRAITS 16
#define MAX_STRUCT 32
#define MAX_FIELDS 32
#define MAX_DEPTH  8
#define MAX_VARS   512
#define MAX_SCOPE  256
#define MAX_FUNCS  64
#define MAX_UNITS  64                     /* units in one `ctc build` run */
#define MAX_BUILD  32                     /* inputs on a single command line */
#define MAX_IMPORTS 16                    /* `import` lines per unit */
#define MAX_INCDIRS 16                    /* `-I` search roots per command */
#define MAX_WARNS  64                     /* collected leak warnings per run */
#define MAX_ERRORS 20                     /* recovery cap: past this the compiler stops */

#define CTC_VERSION "0.4.0"

/* ---------------------------------------------------------------- data */

typedef struct {
    char ret[MAX_NAME];
    char name[MAX_NAME];
    char params[MAX_PARAM];
    char ptypes[MAX_PARAMS][MAX_NAME];
    int  nparams;
} Method;

typedef struct {
    char   name[MAX_NAME];
    char   cname[MAX_NAME];
    Method m[MAX_METHOD];
    int    nm;
} Trait;

typedef struct {
    char name[MAX_NAME];
    char cname[MAX_NAME];
    char use_t[MAX_TRAITS][MAX_NAME];
    int  use_i[MAX_TRAITS];
    int  nu;
    size_t def_line;                   /* 1-based source line of the definition (for #line) */
    /* struct-typed fields, split into value and pointer tables: nested
       construction must never treat a borrowed pointer as an owned nested value */
    char fname[MAX_FIELDS][MAX_NAME];
    int  ftype[MAX_FIELDS];            /* ... and their index into the struct table */
    int  nf;
    char pfname[MAX_FIELDS][MAX_NAME];
    int  pftype[MAX_FIELDS];
    int  npf;
    /* interface fields (a trait used as a field type, `T x;` / `struct T *x;`)
       live in their own tables: they hold a fat pointer, so a call on them is
       dispatched through the field's own vt, not the enclosing struct's vptr */
    char ifname[MAX_FIELDS][MAX_NAME];
    int  iftype[MAX_FIELDS];           /* ... and their index into the trait table */
    int  ifarr[MAX_FIELDS];            /* 1 for `T x[n]`, an array of interface values */
    int  nif;
    char pifname[MAX_FIELDS][MAX_NAME];
    int  piftype[MAX_FIELDS];
    int  pifarr[MAX_FIELDS];           /* 1 for `T *x[n]`, an array of interface pointers */
    int  npif;
    /* Drop, the reserved built-in trait: `has_drop` comes from the use-clause,
       `has_user_drop` from a user-written `impl Drop for T` (its body span is
       captured in the two size_t), and `drop_used` marks the types a `delete`
       actually reaches -- only those bodies are emitted, so an unused drop never
       appears and -Wunused-function stays quiet. */
    int  has_drop;
    int  has_user_drop;
    int  drop_used;
    size_t drop_bstart;
    size_t drop_blen;
} Struct;

typedef struct {
    char name[MAX_NAME];
    int  s;                            /* index into the struct table, -1 when iface */
    int  ptr;                          /* 1 when declared as a pointer (uses '->') */
    int  arr;                          /* 1 when declared as an array (uses '[n]') */
    int  iface;                        /* 1 when this is an interface value */
    int  tr;                           /* index into the trait table when iface */
    int  owned;                        /* 1 when a heap object (malloc/calloc), not yet released */
    size_t own_line;                   /* source line of that allocation (for the leak warning) */
    int  autodrop;                     /* 1 when declared `own`: release at scope exit */
    int  path_warned;                  /* 1 once reported as possibly leaking on a return path */
} Var;

/* A recorded function signature: it lets a call site reject an rvalue receiver,
   box the arguments of a function that takes interface values, and recognise a
   function whose result already is an interface value. */
typedef struct {
    char name[MAX_NAME];
    int  retstruct;
    int  retptr;
    int  rettrait;                     /* >=0 when the return type is an interface */
    int  nparams;
    int  ptrait[MAX_PARAMS];           /* >=0 when that parameter is an interface */
} FuncSig;

typedef struct {
    char   name[MAX_NAME];
    char   params[MAX_PARAM];
    char   ret[MAX_NAME];              /* the return type as written, "" when omitted */
    int    nparams;
    size_t line;                       /* source line of the declaration */
    size_t bstart, blen;
} ImplMethod;

typedef struct { char *p; size_t n, cap; } Buf;

/* -------------------------------------------------------------- globals */

/* The scan context the free helpers read directly: `die` formats from it,
   `skip_literal` / `word_at` / `read_ident` scan it, and `find_trait` /
   `find_struct` prefix with `g_ns`. They stay file-scope because those helpers
   have no receiver — this is the facility layer, alongside `Buf` and `die`. The
   rest of the per-compile state lives on `g_pipe` / `g_sym`. */
static const char *g_src  = NULL;
static size_t      g_len  = 0;
static const char *g_path = "<input>";
/* The namespace prefix in force while a `namespace A::B { ... }` body is
   processed ("" at top level). A name declared inside gets it prefixed into its
   C name; lookups try the prefixed form first and fall back to the root. */
static char g_ns[MAX_NAME];

/* the output streams and scan state live inside `g_pipe`, and the four symbol
   tables inside `g_sym` (see `struct Pipe` / `struct SymTab`) */

/* An rvalue receiver (`f().m()`) is hoisted into a temp so it is evaluated once
   and in order; the declaration goes on the line before the rewritten one (see
   `emit_hoisted`), and `self->ntmp` keeps the temp names unique. */

/* Conservative leak warnings: a still-owned object at scope end is a definite
   leak (kind 0), and one left behind by a conditional return is reported once as
   a possible leak (kind 2). The collected table and the format flag live on
   `struct SymTab` (the `SymTabOps` methods own them); an error still `die`s. */
typedef struct {
    const char *file;
    size_t line;
    int  kind;                         /* 0 potential_leak, 1 signature_mismatch,
                                          2 potential_leak on a return path */
    size_t path_line;                  /* kind 2: the conditional return's line */
    char var[MAX_NAME];                /* leak: variable; mismatch: method */
    char tname[MAX_NAME];              /* leak: struct type; mismatch: trait */
    char sname[MAX_NAME];              /* mismatch: struct */
    char msg[MAX_PARAM];               /* mismatch: what differs */
} Warn;

/* Multi-error recovery: `die` reports and, while a guard is installed, longjmps
   back to it instead of exiting. `compile_range`'s loop installs the guard and
   resynchronises to the next line start or `}` (see `recover_pos`), so one bad
   construct no longer hides the rest of the file. Stops for good past
   MAX_ERRORS (cascading reports stop being useful). These four stay file-scope
   because `die` — a free helper with no receiver — reads and writes them; the
   loop's own bookkeeping lives on `struct Pipe`. */
static jmp_buf g_err_jmp;              /* the guard the loop set */
static int     g_guarded = 0;          /* 1 while that guard is live */
static int     g_nerrors = 0;          /* errors reported so far, whole run */
static size_t  g_err_pos = 0;          /* source offset of the last report */

/* ---------------------------------------------------------------- util */

static void *xmalloc(size_t n)
{
    void *p = malloc(n ? n : 1);
    if (!p) { fprintf(stderr, "ctc: out of memory\n"); exit(1); }
    return p;
}

static char *xstrndup(const char *s, size_t n)
{
    char *p = xmalloc(n + 1);
    memcpy(p, s, n);
    p[n] = 0;
    return p;
}

static int is_ident_char(int c)
{
    return isalnum((unsigned char)c) || c == '_';
}

static void die(size_t pos, const char *fmt, ...)
{
    va_list ap;
    int line = 1, col = 1;
    size_t i;

    for (i = 0; i < pos && i < g_len; i++) {
        if (g_src[i] == '\n') { line++; col = 1; } else col++;
    }
    fprintf(stderr, "%s:%d:%d: error: ", g_path, line, col);
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    va_end(ap);
    fputc('\n', stderr);

    /* With a recovery guard installed the error is reported and control returns
       to the loop, which resynchronises; otherwise this is still the fatal one
       error that stops the compiler. */
    g_nerrors++;
    if (g_guarded) {
        g_err_pos = pos;
        if (g_nerrors > MAX_ERRORS) {
            fprintf(stderr, "ctc: too many errors, stopping\n");
            exit(1);
        }
        longjmp(g_err_jmp, 1);
    }
    exit(1);
}

/* leading/trailing whitespace trim, in place */
static void trim(char *s)
{
    size_t n, i = 0;
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r') i++;
    if (i) memmove(s, s + i, strlen(s + i) + 1);
    n = strlen(s);
    while (n && isspace((unsigned char)s[n - 1])) s[--n] = 0;
}

static size_t trim_right_len(const char *s, size_t n)
{
    while (n && isspace((unsigned char)s[n - 1])) n--;
    return n;
}

static void to_lower(const char *in, char *out)
{
    size_t i;
    for (i = 0; in[i] && i < MAX_NAME - 1; i++)
        out[i] = (char)tolower((unsigned char)in[i]);
    out[i] = 0;
}

static void buf_init(Buf *b)
{
    b->cap = 256;
    b->n = 0;
    b->p = xmalloc(b->cap);
    b->p[0] = 0;
}

static void buf_putn(Buf *b, const char *s, size_t n)
{
    if (b->n + n + 1 > b->cap) {
        while (b->cap < b->n + n + 1) b->cap *= 2;
        b->p = realloc(b->p, b->cap);
        if (!b->p) { fprintf(stderr, "ctc: out of memory\n"); exit(1); }
    }
    memcpy(b->p + b->n, s, n);
    b->n += n;
    b->p[b->n] = 0;
}

static void buf_puts(Buf *b, const char *s)
{
    buf_putn(b, s, strlen(s));
}

static void buf_putc(Buf *b, char c)
{
    buf_putn(b, &c, 1);
}

/* --------------------------------------------------- source-level helpers */

static int word_at(size_t p, const char *w)
{
    size_t l = strlen(w);
    if (p + l > g_len) return 0;
    if (memcmp(g_src + p, w, l) != 0) return 0;
    if (p > 0 && is_ident_char((unsigned char)g_src[p - 1])) return 0;
    if (p + l < g_len && is_ident_char((unsigned char)g_src[p + l])) return 0;
    return 1;
}

static size_t skip_literal(size_t p)
{
    char q = g_src[p++];
    while (p < g_len) {
        if (g_src[p] == '\\' && p + 1 < g_len) { p += 2; continue; }
        if (g_src[p] == q) return p + 1;
        p++;
    }
    return p;
}

static size_t skip_comment(size_t p)
{
    if (p + 1 < g_len && g_src[p] == '/' && g_src[p + 1] == '/') {
        p += 2;
        while (p < g_len && g_src[p] != '\n') p++;
        return p;
    }
    if (p + 1 < g_len && g_src[p] == '/' && g_src[p + 1] == '*') {
        p += 2;
        while (p + 1 < g_len && !(g_src[p] == '*' && g_src[p + 1] == '/')) p++;
        return (p + 1 < g_len) ? p + 2 : g_len;
    }
    return p;
}

/* skip whitespace and comments (newlines included) */
static size_t skip_ws_comments(size_t p)
{
    for (;;) {
        while (p < g_len && isspace((unsigned char)g_src[p])) p++;
        if (p + 1 < g_len && g_src[p] == '/' &&
            (g_src[p + 1] == '/' || g_src[p + 1] == '*')) {
            p = skip_comment(p);
            continue;
        }
        return p;
    }
}

static size_t read_ident(size_t p, char *buf, size_t n)
{
    size_t i = 0;
    while (p < g_len && is_ident_char((unsigned char)g_src[p])) {
        if (i + 1 >= n) die(p, "identifier too long (max %d)", (int)n - 1);
        buf[i++] = g_src[p];
        p++;
    }
    buf[i] = 0;
    return p;
}

/* Copy the identifier at `src` into `buf` (MAX_NAME bytes) and return its
   length. A longer identifier is a hard error: dropping the tail would silently
   misparse (AGENTS §3 forbids silent truncation). */
static size_t copy_ident(const char *src, char *buf, size_t pos)
{
    size_t k = 0;
    while (is_ident_char((unsigned char)src[k])) {
        if (k + 1 >= MAX_NAME) die(pos, "identifier too long (max %d)", MAX_NAME - 1);
        buf[k] = src[k];
        k++;
    }
    buf[k] = 0;
    return k;
}

static size_t match_delim(size_t p, char open, char close)
{
    int depth = 0;
    size_t start = p;
    while (p < g_len) {
        char c = g_src[p];
        if (c == '"' || c == '\'') { p = skip_literal(p); continue; }
        if (c == '/' && p + 1 < g_len &&
            (g_src[p + 1] == '/' || g_src[p + 1] == '*')) { p = skip_comment(p); continue; }
        if (c == open) depth++;
        else if (c == close) { depth--; if (depth == 0) return p; }
        p++;
    }
    die(start, "unterminated '%c'", open);
    return p;
}

/* ---------------------------------------------------- symbol table */

/* Scan primitives the symbol table's leak tracker calls as well as the line
   rewriters: they are defined further down (with the line-rewriting layer), so
   their prototypes come first. */
static size_t line_literal_end(const char *s, size_t i, size_t n);
static size_t line_match_paren(const char *s, size_t k, size_t n);
static size_t line_assign_eq(const char *line);

/* The whole symbol table is one CT object. Lookups dispatch through SymTabOps,
   so call sites read `g_sym.find_trait(..)` instead of a bare global lookup. */
trait SymTabOps {
    Trait *find_trait(const char *name);
    Struct *find_struct(const char *name);
    const char *resolve_method(const Struct *s, const char *m);
    int find_var(const char *name);
    int new_var();
    /* Leak tracking: `warn_add` collects one warning, `leak_check_scope` reports
       the still-owned heap objects of a scope that is closing, and `leak_observe`
       clears ownership when an object is released or escapes. They are methods
       rather than plain functions because plain-C top-level signatures are capped
       (MAX_FUNCS) and the budget is nearly exhausted. */
    void warn_add(int vi);
    /* A signature mismatch is a warning, not an error: `msg` says what differs. */
    void warn_add_sig(size_t line, const char *method, const char *trait_name,
                      const char *stype, const char *msg);
    /* Do two type spellings mean the same once whitespace is ignored? */
    int type_same(const char *a, const char *b);
    void leak_check_scope(int from, int to);
    void leak_observe(const char *line);
    /* Path-sensitive return check: an unconditional return transfers the
       returned object's ownership; a conditional one may leave still-owned
       objects behind, which is reported once per object. */
    void leak_check_return(const char *line, int depth, int frame, size_t ret_line);
    void warn_add_path(int vi, size_t ret_line);
    /* AutoDrop: clear `autodrop` when the marked object is reassigned, escapes
       through an assignment, or is returned (ownership moved). Conservative by
       design: a missed auto-drop leaks, a wrong one corrupts memory. */
    void autodrop_observe(const char *line);
    /* Print the collected warnings, JSON to `jsonf` and text to `textf`. */
    void emit_warnings(FILE *jsonf, FILE *textf);
    void json_str(FILE *f, const char *s);
    /* does `w` occur in `s` as a whole word (literals and comments skipped)? */
    int line_has_word(const char *s, const char *w);
    FuncSig *find_func(const char *name);
    int is_any_trait_method(const char *m);
    /* does trait `tr` declare a method named `m`? (interface dispatch needs the
       trait-specific answer, not `is_any_trait_method`'s) */
    int trait_has_method(int tr, const char *m);
    /* Drop: propagate `drop_used` from a deleted type to the Drop value fields a
       generated body will call. It is a method rather than a plain function
       because plain-C top-level signatures are capped (MAX_FUNCS) and the budget
       is already tight. */
    void mark_drop_closure();
}

struct SymTab {
    Trait   traits[MAX_TRAITS];
    int     ntraits;
    Struct  structs[MAX_STRUCT];
    int     nstructs;
    Var     vars[MAX_VARS];
    int     nvars;
    FuncSig funcs[MAX_FUNCS];
    int     nfuncs;
    /* The structs whose use-clause mentions the reserved `Drop`, in declaration
       order. Their drop bodies are emitted only when a `delete` reaches them
       (`drop_used`). Part of the symbol table, not a loose global. */
    int     own_drop[MAX_STRUCT];
    int     nown_drop;
    /* Collected warnings (leak / signature mismatch) and the `--diagnostics`
       format. They live here because `warn_add`, `warn_add_sig` and
       `emit_warnings` are `SymTabOps` methods. Warnings never change the exit
       code. */
    Warn    warns[MAX_WARNS];
    int     nwarns;
    int     json;
} use SymTabOps;

impl SymTabOps for SymTab {
    /* A deleted Drop type pulls in the drops of its Drop value fields: mark them
       so their bodies are emitted too (a default body calls them). A user-written
       body is taken as-is and marks nothing, so it must not call a generated one. */
    void mark_drop_closure() {
        int changed = 1;
        while (changed) {
            int i, h;
            changed = 0;
            for (i = 0; i < self->nown_drop; i++) {
                Struct *S = &self->structs[self->own_drop[i]];
                if (!S->drop_used || S->has_user_drop) continue;
                for (h = 0; h < S->nf; h++) {
                    Struct *F = &self->structs[S->ftype[h]];
                    if (F->has_drop && !F->drop_used) {
                        F->drop_used = 1;
                        changed = 1;
                    }
                }
            }
        }
    }

    Trait *find_trait(const char *name) {
        int i;
        char q[MAX_NAME * 2];
        /* an unqualified name inside a namespace resolves there first, then at
           the root; comparison is on the mangled C name, so "" (top level)
           collapses the two passes into one */
        if (g_ns[0]) {
            snprintf(q, sizeof q, "%s%s", g_ns, name);
            for (i = 0; i < self->ntraits; i++)
                if (strcmp(self->traits[i].cname, q) == 0) return &self->traits[i];
        }
        for (i = 0; i < self->ntraits; i++)
            if (strcmp(self->traits[i].cname, name) == 0) return &self->traits[i];
        return NULL;
    }
    Struct *find_struct(const char *name) {
        int i;
        char q[MAX_NAME * 2];
        if (g_ns[0]) {
            snprintf(q, sizeof q, "%s%s", g_ns, name);
            for (i = 0; i < self->nstructs; i++)
                if (strcmp(self->structs[i].cname, q) == 0) return &self->structs[i];
        }
        for (i = 0; i < self->nstructs; i++)
            if (strcmp(self->structs[i].cname, name) == 0) return &self->structs[i];
        return NULL;
    }
    /* which trait of struct `s` declares method `m`? NULL when none does */
    const char *resolve_method(const Struct *s, const char *m) {
        int i, k;
        for (i = 0; i < s->nu; i++) {
            const Trait *t = &self->traits[s->use_i[i]];
            for (k = 0; k < t->nm; k++)
                if (strcmp(t->m[k].name, m) == 0) return t->name;
        }
        return NULL;
    }
    int find_var(const char *name) {
        int i;
        for (i = 0; i < self->nvars; i++)
            if (strcmp(self->vars[i].name, name) == 0) return i;
        return -1;
    }
    /* Reserve the next variable slot. Overflow is a hard error: a dropped
       registration would mis-compile method calls (AGENTS §3). The leak-tracking
       fields start cleared so a reused slot never inherits stale ownership from
       an earlier scope. */
    int new_var() {
        int i;
        if (self->nvars >= MAX_VARS) die(0, "too many variables (max %d)", MAX_VARS);
        i = self->nvars++;
        self->vars[i].owned = 0;
        self->vars[i].own_line = 0;
        self->vars[i].autodrop = 0;
        self->vars[i].path_warned = 0;
        return i;
    }
    /* Record one leak warning. Overflow is a hard error: a report that silently
       dropped entries would understate the leaks it was asked to find. */
    void warn_add(int vi) {
        Warn *w;
        if (self->nwarns >= MAX_WARNS) die(0, "too many warnings (max %d)", MAX_WARNS);
        w = &self->warns[self->nwarns++];
        w->file = g_path;
        w->line = self->vars[vi].own_line;
        w->path_line = 0;
        w->kind = 0;
        snprintf(w->var, MAX_NAME, "%s", self->vars[vi].name);
        snprintf(w->tname, MAX_NAME, "%s", self->structs[self->vars[vi].s].name);
    }
    /* Record one "may leak on a return path" warning (kind 2). The allocation
       line is the object's, `ret_line` the conditional return that leaves it
       behind. */
    void warn_add_path(int vi, size_t ret_line) {
        Warn *w;
        if (self->nwarns >= MAX_WARNS) die(0, "too many warnings (max %d)", MAX_WARNS);
        w = &self->warns[self->nwarns++];
        w->file = g_path;
        w->line = self->vars[vi].own_line;
        w->path_line = ret_line;
        w->kind = 2;
        snprintf(w->var, MAX_NAME, "%s", self->vars[vi].name);
        snprintf(w->tname, MAX_NAME, "%s", self->structs[self->vars[vi].s].name);
    }
    /* Record one signature-mismatch warning. Non-fatal, like a leak warning, and
       capped by the same table so a runaway report cannot grow without bound. */
    void warn_add_sig(size_t line, const char *method, const char *trait_name,
                      const char *stype, const char *msg) {
        Warn *w;
        (void)self;  /* the warning table is global, not per-receiver */
        if (self->nwarns >= MAX_WARNS) die(0, "too many warnings (max %d)", MAX_WARNS);
        w = &self->warns[self->nwarns++];
        w->file = g_path;
        w->line = line;
        w->path_line = 0;
        w->kind = 1;
        snprintf(w->var, MAX_NAME, "%s", method);
        snprintf(w->tname, MAX_NAME, "%s", trait_name);
        snprintf(w->sname, MAX_NAME, "%s", stype);
        snprintf(w->msg, MAX_PARAM, "%s", msg);
    }
    /* Compare two type spellings ignoring whitespace, so `int *` and `int*` agree
       (the trait and the impl may space the star differently). */
    int type_same(const char *a, const char *b) {
        (void)self;  /* a pure string comparison; the receiver is not used */
        for (;;) {
            while (*a == ' ' || *a == '\t') a++;
            while (*b == ' ' || *b == '\t') b++;
            if (*a != *b) return 0;
            if (!*a) return 1;
            a++;
            b++;
        }
    }
    /* a scope [from,to) is closing: still-owned heap objects in it are leaks.
       `own` variables are excluded: the generated code releases them right
       before this scope's `}`. Objects already reported as possibly leaking on
       a return path are not reported again as a definite leak. */
    void leak_check_scope(int from, int to) {
        int i;
        for (i = from; i < to; i++)
            if (self->vars[i].owned && !self->vars[i].autodrop &&
                !self->vars[i].path_warned)
                self->warn_add(i);
    }
    /* Update ownership for the owned heap objects mentioned on an assignment
       line: cleared when the object is assigned to a non-self lvalue (escape).
       A `delete p;` clears it in try_delete, and `return` is handled by
       leak_check_return. Path-insensitive and conservative: anything else
       leaves the object owned. */
    void leak_observe(const char *line) {
        size_t eq = line_assign_eq(line);
        int i;

        if (eq == (size_t)-1) return;
        for (i = 0; i < self->nvars; i++) {
            size_t nl;
            if (!self->vars[i].owned) continue;
            if (!self->line_has_word(line, self->vars[i].name)) continue;
            {
                size_t s = 0;
                while (s < eq && (line[s] == ' ' || line[s] == '\t')) s++;
                nl = strlen(self->vars[i].name);
                if (strncmp(line + s, self->vars[i].name, nl) == 0) {
                    char after = line[s + nl];
                    /* v = ... / v->f = ... / v.f = ... is not the object escaping */
                    if (after == 0 || after == '.' || after == '-' ||
                        after == ' ' || after == '\t')
                        continue;
                }
            }
            self->vars[i].owned = 0;
        }
    }
    /* Path-sensitive return check. A return at the frame's own level is
       unconditional: the returned object's ownership moves out, everything else
       stays owned and the closing brace reports the real leak. A return nested in
       a block (or written mid-line) may be skipped at run time, so every object
       it leaves behind is reported once as "may leak on a return path"; the
       object itself is only transferred when it is the returned expression, not
       when a field is read (`return p->n;`). */
    void leak_check_return(const char *line, int depth, int frame, size_t ret_line) {
        size_t len = strlen(line), ret = (size_t)-1, i, s;
        int line_initial, conditional, vi;

        for (i = 0; i < len; ) {
            char c = line[i];
            if (c == '"' || c == '\'') { i = line_literal_end(line, i, len); continue; }
            if (c == '/' && (line[i + 1] == '/' || line[i + 1] == '*')) break;
            if (is_ident_char((unsigned char)c)) {
                size_t j = i;
                while (j < len && is_ident_char((unsigned char)line[j])) j++;
                if (j - i == 6 && memcmp(line + i, "return", 6) == 0) { ret = i; break; }
                i = j;
                continue;
            }
            i++;
        }
        if (ret == (size_t)-1) return;
        for (i = 0; i < ret; i++)
            if (line[i] != ' ' && line[i] != '\t') break;
        line_initial = (i == ret);
        conditional = !line_initial || depth > frame;

        for (vi = 0; vi < self->nvars; vi++) {
            Var *v = &self->vars[vi];
            size_t nl, pos = (size_t)-1;

            if (!v->owned || v->autodrop) continue;
            nl = strlen(v->name);
            for (s = ret + 6; s < len; ) {
                char c = line[s];
                if (c == '"' || c == '\'') { s = line_literal_end(line, s, len); continue; }
                if (c == '/' && (line[s + 1] == '/' || line[s + 1] == '*')) break;
                if (c == ';') break;
                if (is_ident_char((unsigned char)c)) {
                    size_t j = s;
                    while (j < len && is_ident_char((unsigned char)line[j])) j++;
                    if (j - s == nl && memcmp(line + s, v->name, nl) == 0 &&
                        line[j] != '.' && line[j] != '-') {   /* a field read is not a transfer */
                        pos = s;
                        break;
                    }
                    s = j;
                    continue;
                }
                s++;
            }
            if (!conditional) {
                if (pos != (size_t)-1) v->owned = 0;   /* returned: ownership moves */
                continue;
            }
            if (pos == (size_t)-1 && !v->path_warned) {
                v->path_warned = 1;
                self->warn_add_path(vi, ret_line);
            }
        }
    }
    /* AutoDrop: ownership is lost as soon as the marked variable is reassigned,
       appears elsewhere in an assignment (escape), or is returned. Clearing the
       flag stops the scope-exit injection; releasing an object the program no
       longer owns would free memory twice or free a borrowed one. */
    void autodrop_observe(const char *line) {
        size_t eq = line_assign_eq(line);
        int is_return = self->line_has_word(line, "return"), i;
        size_t ret_pos = (size_t)-1;

        if (is_return) {
            size_t r;
            for (r = 0; line[r]; r++)
                if ((r == 0 || !is_ident_char((unsigned char)line[r - 1])) &&
                    strncmp(line + r, "return", 6) == 0 &&
                    !is_ident_char((unsigned char)line[r + 6])) { ret_pos = r; break; }
        }

        for (i = 0; i < self->nvars; i++) {
            size_t nl, s, pos = (size_t)-1;

            if (!self->vars[i].autodrop) continue;
            if (!self->line_has_word(line, self->vars[i].name)) continue;
            nl = strlen(self->vars[i].name);
            for (s = 0; line[s]; s++)
                if ((s == 0 || !is_ident_char((unsigned char)line[s - 1])) &&
                    strncmp(line + s, self->vars[i].name, nl) == 0 &&
                    !is_ident_char((unsigned char)line[s + nl])) { pos = s; break; }
            if (eq == (size_t)-1) {
                /* only the returned expression transfers ownership; a mention in
                   an `if (...)` condition does not */
                if (is_return && ret_pos != (size_t)-1) {
                    for (s = ret_pos + 6; line[s]; s++)
                        if (!is_ident_char((unsigned char)line[s - 1]) &&
                            strncmp(line + s, self->vars[i].name, nl) == 0 &&
                            !is_ident_char((unsigned char)line[s + nl])) {
                            self->vars[i].autodrop = 0;
                            break;
                        }
                }
                continue;
            }
            if (pos == (size_t)-1) continue;
            if (pos >= eq) {                 /* on the right-hand side */
                char after = line[pos + nl];
                /* reading a field or an element (`x = p->n;`, `x = p[0];`) does
                   not move ownership; only `x = p;` does */
                if (after != '.' && after != '-' && after != '[')
                    self->vars[i].autodrop = 0;
                continue;
            }
            /* a use in the lvalue is a field/element write or a dereference --
               ownership does not move. Only `p = ...` itself reassigns the
               variable and drops ownership. */
            {
                size_t a = 0, e = eq;
                while (a < e && (line[a] == ' ' || line[a] == '\t')) a++;
                while (e > a && (line[e - 1] == ' ' || line[e - 1] == '\t')) e--;
                if (e - a == nl && strncmp(line + a, self->vars[i].name, nl) == 0)
                    self->vars[i].autodrop = 0;
            }
        }
    }
    /* JSON string escaping: the two characters that must not appear raw. */
    void json_str(FILE *f, const char *s) {
        (void)self;  /* a pure writer; the receiver is not used */
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') fputc('\\', f);
            fputc(*s, f);
        }
    }
    /* Print the collected warnings. With `--diagnostics=json` a JSON document goes
       to `jsonf`; otherwise one human-readable line per warning goes to `textf`.
       Warnings never change the exit code. */
    void emit_warnings(FILE *jsonf, FILE *textf) {
        int i;
        (void)self;  /* the warning table is global, not per-receiver */
        if (!self->nwarns) return;
        if (self->json) {
            fputs("{\"warnings\":[", jsonf);
            for (i = 0; i < self->nwarns; i++) {
                Warn *w = &self->warns[i];
                if (i) fputc(',', jsonf);
                if (w->kind == 1) {
                    fputs("{\"type\":\"signature_mismatch\",\"file\":\"", jsonf);
                    self->json_str(jsonf, w->file);
                    fprintf(jsonf, "\",\"line\":%ld,\"method\":\"", (long)w->line);
                    self->json_str(jsonf, w->var);
                    fputs("\",\"trait\":\"", jsonf);
                    self->json_str(jsonf, w->tname);
                    fputs("\",\"struct\":\"", jsonf);
                    self->json_str(jsonf, w->sname);
                    fputs("\",\"message\":\"", jsonf);
                    self->json_str(jsonf, w->msg);
                    fputs("\"}", jsonf);
                } else if (w->kind == 2) {
                    fputs("{\"type\":\"potential_leak\",\"file\":\"", jsonf);
                    self->json_str(jsonf, w->file);
                    fprintf(jsonf, "\",\"line\":%ld,\"variable\":\"", (long)w->line);
                    self->json_str(jsonf, w->var);
                    fputs("\",\"type_name\":\"", jsonf);
                    self->json_str(jsonf, w->tname);
                    fprintf(jsonf, "*\",\"message\":\"may leak on a return path\","
                                    "\"path_line\":%ld}", (long)w->path_line);
                } else {
                    fputs("{\"type\":\"potential_leak\",\"file\":\"", jsonf);
                    self->json_str(jsonf, w->file);
                    fprintf(jsonf, "\",\"line\":%ld,\"variable\":\"", (long)w->line);
                    self->json_str(jsonf, w->var);
                    fputs("\",\"type_name\":\"", jsonf);
                    self->json_str(jsonf, w->tname);
                    fputs("*\",\"message\":\"allocated but never deleted\"}", jsonf);
                }
            }
            fputs("]}\n", jsonf);
        } else {
            for (i = 0; i < self->nwarns; i++) {
                Warn *w = &self->warns[i];
                if (w->kind == 1)
                    fprintf(textf, "%s:%ld: warning: signature mismatch: '%s' in impl of '%s' for '%s': %s\n",
                            w->file, (long)w->line, w->var, w->tname, w->sname, w->msg);
                else if (w->kind == 2)
                    fprintf(textf, "%s:%ld: warning: potential leak: '%s' (%s*) may leak on a return path (line %ld)\n",
                            w->file, (long)w->line, w->var, w->tname, (long)w->path_line);
                else
                    fprintf(textf, "%s:%ld: warning: potential leak: '%s' (%s*) allocated but never deleted\n",
                            w->file, (long)w->line, w->var, w->tname);
            }
        }
    }
    /* does `w` occur in `s` as a whole word (literals and comments skipped)? */
    int line_has_word(const char *s, const char *w) {
        size_t n = strlen(w), len = strlen(s), i = 0;
        (void)self;  /* a pure string probe; the receiver is not used */
        while (i < len) {
            char c = s[i];
            if (c == '"' || c == '\'') { i = line_literal_end(s, i, len); continue; }
            if (c == '/' && (s[i + 1] == '/' || s[i + 1] == '*')) break;
            if (is_ident_char((unsigned char)c)) {
                size_t j = i;
                while (j < len && is_ident_char((unsigned char)s[j])) j++;
                if (j - i == n && memcmp(s + i, w, n) == 0) return 1;
                i = j;
                continue;
            }
            i++;
        }
        return 0;
    }
    /* the last recorded signature of `name`, or NULL */
    FuncSig *find_func(const char *name) {
        int i;
        for (i = self->nfuncs - 1; i >= 0; i--)
            if (strcmp(self->funcs[i].name, name) == 0) return &self->funcs[i];
        return NULL;
    }
    /* does any declared trait have a method named `m`? */
    int is_any_trait_method(const char *m) {
        int i, j;
        for (i = 0; i < self->ntraits; i++)
            for (j = 0; j < self->traits[i].nm; j++)
                if (strcmp(self->traits[i].m[j].name, m) == 0) return 1;
        return 0;
    }
    /* does trait `tr` declare a method named `m`? */
    int trait_has_method(int tr, const char *m) {
        int i;
        for (i = 0; i < self->traits[tr].nm; i++)
            if (strcmp(self->traits[tr].m[i].name, m) == 0) return 1;
        return 0;
    }
}

static SymTab g_sym = { .ntraits = 0, .nstructs = 0, .nvars = 0, .nfuncs = 0 };

/* `struct_uses` stays plain C: it reads only the receiver Struct, no table. */
static int struct_uses(const Struct *s, const char *trait)
{
    int i;
    for (i = 0; i < s->nu; i++)
        if (strcmp(s->use_t[i], trait) == 0) return 1;
    return 0;
}

/* the struct index of the field `name` of `s`, or -1; *isptr reports whether the
   field is a pointer, so the following hop must use '->'. Plain C: it reads only
   the receiver Struct. */
static int find_field_ex(const Struct *s, const char *name, int *isptr)
{
    int i;
    for (i = 0; i < s->nf; i++)
        if (strcmp(s->fname[i], name) == 0) {
            *isptr = 0;
            return s->ftype[i];
        }
    for (i = 0; i < s->npf; i++)
        if (strcmp(s->pfname[i], name) == 0) {
            *isptr = 1;
            return s->pftype[i];
        }
    return -1;
}

/* Does `S` (recursively) hold a struct-typed field whose vptr must be written?
   The table is passed in so this stays a pure plain-C predicate. */
static int needs_nested_init(const Struct *structs, const Struct *S, int depth)
{
    int i;
    if (depth >= MAX_DEPTH) die(0, "nesting too deep in struct '%s'", S->name);
    for (i = 0; i < S->nf; i++) {
        const Struct *F = &structs[S->ftype[i]];
        if (F->nu > 0 || needs_nested_init(structs, F, depth + 1)) return 1;
    }
    return 0;
}

/* the trait of the interface field `name` of `s` (-1 when there is none);
   *isptr reports whether the field is a `struct T *` pointer and *isarr whether
   it is an array of them (`T x[n]` / `T *x[n]`). Plain C: it reads only the
   receiver Struct. */
static int find_iface_field(const Struct *s, const char *name, int *isptr, int *isarr)
{
    int i;
    for (i = 0; i < s->nif; i++)
        if (strcmp(s->ifname[i], name) == 0) {
            *isptr = 0;
            *isarr = s->ifarr[i];
            return s->iftype[i];
        }
    for (i = 0; i < s->npif; i++)
        if (strcmp(s->pifname[i], name) == 0) {
            *isptr = 1;
            *isarr = s->pifarr[i];
            return s->piftype[i];
        }
    return -1;
}

/* --------------------------------------------------- signature parsing */

static int is_type_keyword(const char *s)
{
    static const char *kw[] = {
        "void", "char", "short", "int", "long", "float", "double",
        "signed", "unsigned", "_Bool", "bool", "const", "volatile",
        "struct", "union", "enum", "size_t", "ssize_t", "FILE", "wchar_t",
        "int8_t", "int16_t", "int32_t", "int64_t",
        "uint8_t", "uint16_t", "uint32_t", "uint64_t", "ptrdiff_t", NULL
    };
    int i;
    for (i = 0; kw[i]; i++)
        if (strcmp(kw[i], s) == 0) return 1;
    return 0;
}

/* "char *name" -> "char *" ; "int" -> "int" (already a type) */
static void param_type_only(const char *piece, char *out)
{
    char t[MAX_NAME * 2];
    int end, st;
    char id[MAX_NAME];

    snprintf(t, sizeof t, "%s", piece);
    trim(t);

    end = (int)strlen(t);
    st = end;
    while (st > 0 && is_ident_char((unsigned char)t[st - 1])) st--;
    if (st == end) { snprintf(out, MAX_NAME, "%s", t); return; }

    snprintf(id, sizeof id, "%.*s", end - st, t + st);
    if (is_type_keyword(id)) { snprintf(out, MAX_NAME, "%s", t); return; }

    t[st] = 0;
    trim(t);
    snprintf(out, MAX_NAME, "%s", t);
}

/* parse_params / split_decl are `Pipe` methods now (see `impl PipeOps for
   Pipe` below): they turn one method declaration into the `Method` record and
   never read the symbol tables, so they take no `struct SymTab *sym`. */

/* C keywords that can never be a function's return type or its name */
static int is_stmt_keyword(const char *s)
{
    static const char *kw[] = {
        "if", "else", "while", "for", "switch", "case", "default", "do",
        "return", "goto", "break", "continue", "sizeof", NULL
    };
    int i;
    for (i = 0; kw[i]; i++)
        if (strcmp(kw[i], s) == 0) return 1;
    return 0;
}

/* the last identifier token in s[0..n): 1 and [*a,*b) when there is one */
static int last_ident(const char *s, size_t n, size_t *a, size_t *b)
{
    size_t e = n, st;
    while (e > 0 && !is_ident_char((unsigned char)s[e - 1])) e--;
    if (e == 0) return 0;
    st = e;
    while (st > 0 && is_ident_char((unsigned char)s[st - 1])) st--;
    *a = st;
    *b = e;
    return 1;
}

/* is the identifier at `off` in `type` already preceded by "struct"? */
static int already_qualified(const char *type, size_t off)
{
    size_t q = off;
    while (q > 0 && isspace((unsigned char)type[q - 1])) q--;
    return q >= 6 && memcmp(type + q - 6, "struct", 6) == 0 &&
           (q == 6 || !is_ident_char((unsigned char)type[q - 7]));
}

/* analyse_param / emit_qualified_type are `Pipe` methods now (see `impl
   PipeOps for Pipe` below); analyse_param reads the symbol tables through `sym`. */

/* The four code emitters (emit_trait_def / emit_struct_def / put_own_vptr /
   body_needs_vtable) are `Pipe` methods now -- see `impl PipeOps for Pipe`
   below. Each keeps its stream parameter (FILE* / Buf*) because it is used for
   both the .c output (`self->out`) and the .h output (`self->hout`), and reads
   the symbol tables through `self->sym`. `is_any_trait_method` stays a
   `SymTabOps` method (see the symbol-table section). */

/* ------------------------------------------------------- construct parsers */

/* The whole output pipeline lives on the `Pipe` object: the output streams and
   the symbol table are its fields, and the code emitters, the construct
   parsers, the method-declaration parsers, the declaration-piece helpers and the
   pipeline entry points are its methods, so call sites read
   `g_pipe.parse_trait(..)` / `g_pipe.compile_file(..)`. `self->sym` is the table
   the compiler is working on (a method aliases it as `sym` locally to keep the
   bodies readable). The per-line rewriting layer is the `RewriteOps` trait
   below; both are used by `struct Pipe`, so either half can call the other via
   `self`. */
trait PipeOps {
    size_t parse_trait(size_t p);
    size_t parse_struct(size_t p);
    size_t parse_impl(size_t p);
    /* method-declaration parsers, called from parse_trait */
    void parse_params(Method *m, const char *raw);
    void split_decl(const char *decl, size_t pos, Method *m);
    /* code emitters, called from the parsers above (stream passed explicitly).
       `srcline` is the source line the construct starts on: it anchors a `#line`
       directive when multi-file mode is on. */
    void emit_trait_def(FILE *f, const Trait *T, size_t srcline);
    void emit_struct_def(FILE *f, const Struct *S, const char *body, size_t srcline);
    void put_own_vptr(Buf *b, const Struct *S, int *first);
    void put_nested_assignments(Buf *b, const Struct *S, const char *recv, const char *ind, int with_self, int depth);
    void put_heap_vpts(Buf *b, const Struct *S, const char *ptr, const char *ind);
    int body_needs_vtable(size_t bstart, size_t blen);
    /* declaration-piece helpers, shared by parse_fields and parse_func_sig */
    int analyse_param(const char *s, size_t n, int *ia, int *ib, char *cbase, int *need_struct, char *name, int *isptr, int *tr);
    void emit_qualified_type(Buf *b, const char *piece, size_t len, int ia, int ib, const char *cbase, int need_struct, int is_trait);
    /* Read `Ident(::Ident)*` at p -- the head of a declaration. `cname` gets the
       mangled C name (a qualified path `A::B::Name` becomes `A_B_Name`; an
       unqualified one gets the enclosing namespace prefix), `shortname` its last
       segment. Returns the position just past the name, or NULL when there is
       none. */
    const char *read_qual_ref(const char *p, char *cname, char *shortname, int *qualified);
    char *parse_fields(const char *body, Struct *S, size_t pos);
    void emit_body(FILE *f, size_t bstart, size_t blen, const Struct *S, const char *params);
    void register_body_params(const char *params);
    /* the pipeline driver; the rewriting layer itself is the `RewriteOps` trait */
    void emit_hoisted();
    /* The lazily-generated drop functions: the prototypes go before the buffered
       body (a delete farther down calls them) and the definitions after it, when
       the structs they walk are complete. Only the types a delete reaches get a
       body, so an unused drop never appears (-Wunused-function stays quiet). */
    void emit_drop_prototypes(FILE *f);
    void emit_drop_bodies(FILE *f);
    void emit_raw_line(size_t ls, size_t le);
    void compile_range(size_t start, size_t end);
    /* Source-line tracking. The directive is written only when the running
       mapping would diverge, and only into the .c: the .h is included verbatim
       by the .c, so `#line` out there would be wrong. */
    int  line_of(size_t pos);
    void line_break();
    void line_at(FILE *f, size_t srcline);
    /* compile_file's own file I/O helpers */
    void header_path(const char *outc, char *out, size_t n);
    char *read_file(const char *path, size_t *out_len);
    /* `multi` selects multi-file mode: the .c then includes its own .h, opens
       with the imports the driver registered in `self->imp_h`, and emits `#line`.
       The symbol tables accumulate across units in that mode (a unit sees the
       units built before it) and are reset per file otherwise. */
    int compile_file(const char *in, const char *outc, int multi);
    void write_guard(const char *hpath);
    /* CLI helpers, called from `main` */
    void usage(const char *prog);
    void default_output(const char *in, char *out, size_t n);
}

/* The per-line rewriting layer: one source line in, rewritten line(s) out. It is
   a trait of its own both because it is a distinct layer (`emit_raw_line` and
   `emit_body` are the only ways in from the pipeline above) and because the two
   halves would otherwise run into `MAX_METHOD`. `struct Pipe` uses both. */
trait RewriteOps {
    void replace_self(const char *s, size_t n, Buf *out);
    /* interface values: boxing, the declaration, the assignment and `return` */
    void box_to_iface(Buf *out, const char *e, size_t len, int tr, size_t pos);
    void box_to_iface_ptr(Buf *out, const char *e, size_t len, int tr, size_t pos);
    void box_agg_fields(Buf *out, const Struct *S, const char *inner, size_t it);
    size_t skip_bracket(const char *s, size_t n, size_t pos);
    char *try_iface_decl(const char *line, int tr, size_t ws, const char *after);
    char *try_iface_assign(const char *line);
    char *try_return(const char *line);
    char *try_delete(const char *line);
    char *transform_line(const char *line);
    char *try_var_decl(const char *line);
    void transform_calls(const char *s, Buf *out);
    int walk_method(const char *s, size_t n, size_t pos, int cur, int isptr, int *out_cur, int *out_need_amp, const char **out_tr, size_t *out_rend, size_t *mp, char *memb);
    int walk_to_iface_field(const char *s, size_t n, size_t pos, int cur, int isptr, int *out_tr, size_t *out_end, int *out_ifptr);
    int decl_end_is_bare(const char *s);
    /* the same kind of source-shape predicate as decl_end_is_bare: does a captured
       user body mention `self`? A drop body need not use it, and an unused self
       would warn under -Wall -Wextra. */
    int body_uses_self(size_t bstart, size_t blen);
    void scope_track(size_t ls, size_t le);
    /* AutoDrop injection: `autodrop_before` queues the releases for a line that
       closes the innermost scope or returns, into the per-line hoist buffer;
       `emit_drops` writes the releases of [from,to) in reverse order. */
    void autodrop_before(const char *line);
    void emit_drops(Buf *b, const char *ind, size_t indlen, int from, int to);
    /* Resynchronisation point after a reported error: past the next `}` or the
       start of the next line, whichever comes first (literals and comments are
       skipped, so a brace inside a string does not count). */
    size_t recover_pos(size_t from, size_t end);
    char *parse_func_sig(const char *line, size_t ls, int *has_body, size_t *body_abs);
}

struct Pipe {
    FILE *out;
    FILE *hout;
    /* The symbol table this pipeline compiles against. Threading it through every
       method by hand (63 parameters) was manual dependency injection; owning it
       here is what makes the pipeline an object with state. A method still names
       it `sym` through a local alias, so the bodies read as before. */
    struct SymTab *sym;
    /* Scan state for the file being compiled: brace/parameter scope tracking and
       the body / `pub` / `#line` bookkeeping. Only `Pipe` methods touch it, so it
       belongs here rather than in a global. */
    int    scope[MAX_SCOPE];
    int    nscope;
    size_t body_abs;
    int    body_pre;
    /* 1 while `emit_body` walks an impl method: its top-level locals have no
       enclosing `}` in the emitted range, which AutoDrop has to distinguish from
       file scope (where `own` is rejected). */
    int    in_body;
    int    cur_rettr;
    size_t line_off;
    int    multi;
    int    ctor_pub;
    int    line_pub;
    int    emit_line;
    int    line_force;
    int    cur_line;
    long   line_next;
    /* Multi-error recovery bookkeeping that only `compile_range` reads. The
       guard itself (`g_err_jmp` / `g_guarded` / `g_nerrors` / `g_err_pos`) stays
       file-scope: `die` is a free helper and must reach it. */
    size_t guard_pos;
    size_t guard_end;
    int    safe_nvars;
    int    safe_nscope;
    /* Output state that belongs to one compile: the per-line hoist buffer and its
       temp counter, the file-scope constructor accumulator, the `#include`s the
       driver pre-loads, the header include guard, and the suggested cc command. */
    Buf  hoist;
    int  ntmp;
    Buf  unit_init;
    int  has_unit_init;
    char imp_h[MAX_IMPORTS][MAX_NAME];
    int  nimp_h;
    char guard[MAX_NAME * 2];
    Buf  cc;
    int  cc_ready;
} use PipeOps, RewriteOps;

/* Rewrite a struct body: each field's type is qualified and the struct-typed and
   interface-typed fields are recorded in `S` so nested construction and field
   chains can find them. Returns a new body string. This is a `Pipe` method now
   (see `impl PipeOps for Pipe` below). */

impl PipeOps for Pipe {
    void emit_trait_def(FILE *f, const Trait *T, size_t srcline) {
        int i, k;
        self->line_at(f, srcline);
        fprintf(f, "struct %s_vtbl {\n", T->cname);
        for (i = 0; i < T->nm; i++) {
            const Method *m = &T->m[i];
            fprintf(f, "    %s (*%s)(void *", m->ret, m->name);
            for (k = 0; k < m->nparams; k++) fprintf(f, ", %s", m->ptypes[k]);
            fprintf(f, ");\n");
        }
        fprintf(f, "};\n");
        fprintf(f, "struct %s_iface {\n    void *self;\n    struct %s_vtbl *vt;\n};\n",
                T->cname, T->cname);
        self->line_break();
    }

    void emit_struct_def(FILE *f, const Struct *S, const char *body, size_t srcline) {
        struct SymTab *sym = self->sym;
        int i;
        size_t blen = strlen(body);

        self->line_at(f, srcline);
        fprintf(f, "struct %s {", S->cname);
        if (blen && body[0] != '\n') fputc('\n', f);
        if (blen) fputs(body, f);
        if (blen == 0 || body[blen - 1] != '\n') fputc('\n', f);
        for (i = 0; i < S->nu; i++) {
            char low[MAX_NAME];
            to_lower(S->use_t[i], low);
            fprintf(f, "    struct %s_vtbl *__%s_vptr;\n", sym->traits[S->use_i[i]].cname, low);
        }
        fprintf(f, "};\n");
        self->line_break();
    }

    /* append one ".__<trait>_vptr = &<Struct>_<Trait>_vtable" per used trait */
    void put_own_vptr(Buf *b, const Struct *S, int *first) {
        int h;
        (void)self;  /* the buffer is passed in; the receiver is not used */
        for (h = 0; h < S->nu; h++) {
            char low[MAX_NAME];
            to_lower(S->use_t[h], low);
            if (!*first) buf_puts(b, ", ");
            *first = 0;
            buf_puts(b, ".__");
            buf_puts(b, low);
            buf_puts(b, "_vptr = &");
            buf_puts(b, S->cname);
            buf_putc(b, '_');
            buf_puts(b, S->use_t[h]);
            buf_puts(b, "_vtable");
        }
    }

    /* Emit "recv.__<trait>_vptr = &...;" for `recv` (when `with_self`) and,
       recursively, for its struct-typed fields. Statements rather than
       designators, so a nested object the user already initialised is never
       overridden. */
    void put_nested_assignments(Buf *b, const Struct *S, const char *recv,
                                const char *ind, int with_self, int depth) {
        struct SymTab *sym = self->sym;
        int i, h;

        (void)self;  /* the body walks struct fields; the receiver is not used */
        for (h = 0; with_self && h < S->nu; h++) {
            char low[MAX_NAME];
            to_lower(S->use_t[h], low);
            buf_puts(b, ind);
            buf_puts(b, recv);
            buf_puts(b, ".__");
            buf_puts(b, low);
            buf_puts(b, "_vptr = &");
            buf_puts(b, S->cname);
            buf_putc(b, '_');
            buf_puts(b, S->use_t[h]);
            buf_puts(b, "_vtable;\n");
        }
        for (i = 0; i < S->nf; i++) {
            const Struct *F = &sym->structs[S->ftype[i]];
            char sub[MAX_NAME * (MAX_DEPTH + 3)];
            if (F->nu == 0 && !needs_nested_init(sym->structs, F, depth + 1)) continue;
            if ((size_t)snprintf(sub, sizeof sub, "%s.%s", recv, S->fname[i]) >= sizeof sub)
                die(0, "nested field path too long in struct '%s'", S->name);
            self->put_nested_assignments(b, F, sub, ind, 1, depth + 1);
        }
    }

    /* Write the vptrs of a heap object obtained from malloc/calloc: the object's
       own vptrs use '->', its struct-typed fields recurse with the nested form. */
    void put_heap_vpts(Buf *b, const Struct *S, const char *ptr, const char *ind) {
        struct SymTab *sym = self->sym;
        int i, h;

        (void)self;  /* the body walks struct fields; the receiver is not used */
        for (h = 0; h < S->nu; h++) {
            char low[MAX_NAME];
            to_lower(S->use_t[h], low);
            buf_puts(b, ind);
            buf_puts(b, ptr);
            buf_puts(b, "->__");
            buf_puts(b, low);
            buf_puts(b, "_vptr = &");
            buf_puts(b, S->cname);
            buf_putc(b, '_');
            buf_puts(b, S->use_t[h]);
            buf_puts(b, "_vtable;\n");
        }
        for (i = 0; i < S->nf; i++) {
            const Struct *F = &sym->structs[S->ftype[i]];
            char sub[MAX_NAME * (MAX_DEPTH + 3)];
            if (F->nu == 0 && !needs_nested_init(sym->structs, F, 1)) continue;
            if ((size_t)snprintf(sub, sizeof sub, "%s->%s", ptr, S->fname[i]) >= sizeof sub)
                die(0, "nested field path too long in struct '%s'", S->name);
            self->put_nested_assignments(b, F, sub, ind, 1, 1);
        }
    }

    /* Does a body contain a call that will become a vtable dispatch? Any `.m(` /
       `->m(` whose `m` names a declared trait method counts; when it does, the
       impl's vtable variable must be declared before the method bodies. */
    int body_needs_vtable(size_t bstart, size_t blen) {
        struct SymTab *sym = self->sym;
        size_t i = bstart, end = bstart + blen;

        (void)self;  /* the body only consults the symbol table for the method */
        while (i < end) {
            char c = g_src[i];
            if (c == '"' || c == '\'') {
                size_t j = skip_literal(i);
                i = (j > end) ? end : j;
                continue;
            }
            if (c == '/' && i + 1 < end &&
                (g_src[i + 1] == '/' || g_src[i + 1] == '*')) {
                size_t j = skip_comment(i);
                i = (j > end) ? end : j;
                continue;
            }
            if (c == '.' || c == '-') {
                size_t ms = (c == '.') ? i + 1 : i + 2;
                size_t e, ml;
                char mem[MAX_NAME];
                if (c == '-') {
                    if (i + 1 >= end || g_src[i + 1] != '>') { i++; continue; }
                }
                e = ms;
                while (e < end && is_ident_char((unsigned char)g_src[e])) e++;
                ml = e - ms;
                if (ml > 0 && ml < MAX_NAME && e < end && g_src[e] == '(') {
                    memcpy(mem, g_src + ms, ml);
                    mem[ml] = 0;
                    if (sym->is_any_trait_method(mem)) return 1;
                }
                i = (e > i) ? e : i + 1;
                continue;
            }
            i++;
        }
        return 0;
    }

    /* Analyse one declaration piece: the struct its type names (an index into
       sym->structs, or -1), the trait when the type is an interface value
       (`*tr`), the identifier span [*ia,*ib) of the base type name, its
       generated spelling (`cbase`), whether "struct " must be inserted, the
       declared name ("" when unnamed) and whether it is a pointer. */
    const char *read_qual_ref(const char *p, char *cname, char *shortname, int *qualified) {
        char buf[MAX_NAME * 2], seg[MAX_NAME];
        size_t i;

        (void)self;  /* a pure string helper; the receiver is not used */
        *qualified = 0;
        for (i = 0; is_ident_char((unsigned char)p[i]); i++)
            if (i + 1 >= MAX_NAME) die(0, "identifier too long (max %d)", MAX_NAME - 1);
        if (i == 0) return NULL;
        memcpy(seg, p, i);
        seg[i] = 0;
        snprintf(buf, sizeof buf, "%s", seg);
        p += i;

        for (;;) {
            const char *z = p;
            while (*z == ' ' || *z == '\t') z++;
            if (z[0] == ':' && z[1] == ':') {
                char tmp[MAX_NAME * 2];
                z += 2;
                while (*z == ' ' || *z == '\t') z++;
                for (i = 0; is_ident_char((unsigned char)z[i]); i++)
                    if (i + 1 >= MAX_NAME) die(0, "identifier too long (max %d)", MAX_NAME - 1);
                if (i == 0) return NULL;
                memcpy(seg, z, i);
                seg[i] = 0;
                if (snprintf(tmp, sizeof tmp, "%s_%s", buf, seg) >= (int)sizeof tmp) return NULL;
                snprintf(buf, sizeof buf, "%s", tmp);
                *qualified = 1;
                p = z + i;
                continue;
            }
            break;
        }

        snprintf(shortname, MAX_NAME, "%s", seg);
        if (*qualified) snprintf(cname, MAX_NAME, "%s", buf);
        else snprintf(cname, MAX_NAME, "%s%s", g_ns, buf);
        return p;
    }

    int analyse_param(const char *s, size_t n, int *ia, int *ib, char *cbase, int *need_struct, char *name, int *isptr, int *tr) {
        struct SymTab *sym = self->sym;
        size_t a, b, lim = 0, tn, ea, eb;
        char type[MAX_NAME * 2], base[MAX_NAME];
        int idx = -1;
        const Struct *S;
        const Trait *T;

        (void)self;  /* the body only consults the symbol table for the type */
        *ia = -1;
        *ib = -1;
        *need_struct = 0;
        *tr = -1;
        cbase[0] = 0;
        base[0] = 0;
        name[0] = 0;
        *isptr = 0;

        while (lim < n && s[lim] != '[') lim++;
        if (!last_ident(s, lim, &a, &b)) return -1;

        {
            size_t lsx = b;
            char last[MAX_NAME];
            while (lsx > a && is_ident_char((unsigned char)s[lsx - 1])) lsx--;
            snprintf(last, sizeof last, "%.*s", (int)(b - lsx), s + lsx);
            if (!is_type_keyword(last) && !sym->find_struct(last) && !sym->find_trait(last)) {
                snprintf(name, MAX_NAME, "%s", last);
                snprintf(type, sizeof type, "%.*s", (int)a, s);
            } else {
                snprintf(type, sizeof type, "%.*s", (int)n, s);   /* the type itself */
            }
        }
        if (lim < n) name[0] = 0;                                 /* array: no object to bind */

        tn = strlen(type);
        while (tn > 0 && (type[tn - 1] == '*' || isspace((unsigned char)type[tn - 1]))) tn--;
        if (tn == 0 || !last_ident(type, tn, &ea, &eb)) return -1;

        {
            size_t bl = eb - ea;
            if (bl >= sizeof base) bl = sizeof base - 1;
            memcpy(base, type + ea, bl);
            base[bl] = 0;
            S = sym->find_struct(base);
            T = S ? NULL : sym->find_trait(base);
            if (S) snprintf(cbase, MAX_NAME, "%s", S->cname);
            else if (T) snprintf(cbase, MAX_NAME, "%s", T->cname);
        }

        if (S) {
            idx = (int)(S - sym->structs);
            *ia = (int)ea;
            *ib = (int)eb;
            *need_struct = !already_qualified(type, ea);
        } else if (T) {
            *tr = (int)(T - sym->traits);
            *ia = (int)ea;
            *ib = (int)eb;
            *need_struct = !already_qualified(type, ea);
        } else if (strlen(base) > 6 && strcmp(base + strlen(base) - 6, "_iface") == 0) {
            char pre[MAX_NAME];
            size_t pl = strlen(base) - 6;
            if (pl < sizeof pre) {
                memcpy(pre, base, pl);
                pre[pl] = 0;
                T = sym->find_trait(pre);
                if (T) *tr = (int)(T - sym->traits);
            }
        }

        *isptr = (strchr(type, '*') != NULL);
        return idx;
    }

    /* emit a declaration piece: replace the base type identifier [ia,ib) with its
       generated spelling, inserting "struct " as needed */
    void emit_qualified_type(Buf *b, const char *piece, size_t len, int ia, int ib, const char *cbase, int need_struct, int is_trait) {
        (void)self;  /* a pure emit helper; the receiver is not used */
        if (ia < 0) { buf_putn(b, piece, len); return; }
        buf_putn(b, piece, (size_t)ia);
        if (need_struct) buf_puts(b, "struct ");
        buf_puts(b, cbase);
        if (is_trait) buf_puts(b, "_iface");
        buf_putn(b, piece + ib, len - (size_t)ib);
    }

    char *parse_fields(const char *body, Struct *S, size_t pos) {
        Buf out;
        size_t n = strlen(body), i = 0;

        S->nf = 0;
        S->npf = 0;
        S->nif = 0;
        S->npif = 0;
        buf_init(&out);

        while (i < n) {
            size_t j = i, depth = 0;
            int ia = -1, ib = -1, need_struct = 0, ptr = 0, idx, tr, arr = 0;
            char fname[MAX_NAME], cbase[MAX_NAME];

            while (j < n) {
                char c = body[j];
                if (c == '"' || c == '\'') {
                    char q = c;
                    j++;
                    while (j < n) {
                        if (body[j] == '\\' && j + 1 < n) { j += 2; continue; }
                        if (body[j] == q) { j++; break; }
                        j++;
                    }
                    continue;
                }
                if (c == '{' || c == '(' || c == '[') depth++;
                else if (c == '}' || c == ')' || c == ']') depth--;
                else if (c == ';' && depth == 0) break;
                j++;
            }

            idx = self->analyse_param(body + i, j - i, &ia, &ib, cbase, &need_struct, fname, &ptr, &tr);
            self->emit_qualified_type(&out, body + i, j - i, ia, ib, cbase, need_struct, tr >= 0);

            /* an interface array field (`T x[n]` / `T *x[n]`) carries no object
               name out of analyse_param -- the name sits before the '[' */
            {
                const char *lb = memchr(body + i, '[', j - i);
                if (lb) {
                    size_t e2 = (size_t)(lb - (body + i));
                    size_t s2;
                    arr = 1;
                    while (e2 > 0 && isspace((unsigned char)body[i + e2 - 1])) e2--;
                    s2 = e2;
                    while (s2 > 0 && is_ident_char((unsigned char)body[i + s2 - 1])) s2--;
                    if (tr >= 0 && !fname[0] && e2 > s2) {
                        size_t ml = e2 - s2;
                        if (ml >= MAX_NAME) ml = MAX_NAME - 1;
                        memcpy(fname, body + i + s2, ml);
                        fname[ml] = 0;
                    }
                }
            }

            if (idx >= 0 && fname[0] && ptr) {          /* pointer field to a known struct */
                if (S->npf >= MAX_FIELDS) die(pos, "too many struct fields in '%s'", S->name);
                snprintf(S->pfname[S->npf], MAX_NAME, "%s", fname);
                S->pftype[S->npf] = idx;
                S->npf++;
            } else if (tr >= 0 && fname[0] && ptr) {    /* pointer interface field: `struct T *x` */
                if (S->npif >= MAX_FIELDS) die(pos, "too many struct fields in '%s'", S->name);
                snprintf(S->pifname[S->npif], MAX_NAME, "%s", fname);
                S->piftype[S->npif] = tr;
                S->pifarr[S->npif] = arr;
                S->npif++;
            } else if (tr >= 0 && fname[0]) {           /* interface-value field: `T x` */
                if (S->nif >= MAX_FIELDS) die(pos, "too many struct fields in '%s'", S->name);
                snprintf(S->ifname[S->nif], MAX_NAME, "%s", fname);
                S->iftype[S->nif] = tr;
                S->ifarr[S->nif] = arr;
                S->nif++;
            } else if (idx >= 0 && fname[0]) {          /* value field of a known struct */
                if (S->nf >= MAX_FIELDS) die(pos, "too many struct fields in '%s'", S->name);
                snprintf(S->fname[S->nf], MAX_NAME, "%s", fname);
                S->ftype[S->nf] = idx;
                S->nf++;
            }
            if (j < n) { buf_putc(&out, ';'); j++; }
            i = j;
        }
        return out.p;
    }

    /* raw param list -> verbatim params + type-only list */
    void parse_params(Method *m, const char *raw) {
        char tmp[MAX_PARAM * 2];
        char *p;
        int depth = 0;
        size_t start = 0, i, n;

        (void)self;  /* a pure parse helper; the receiver is not used */
        snprintf(tmp, sizeof tmp, "%s", raw);
        trim(tmp);

        m->nparams = 0;
        m->params[0] = 0;

        if (!tmp[0] || strcmp(tmp, "void") == 0) return;

        p = tmp;
        n = strlen(p);
        for (i = 0; i <= n; i++) {
            char c = (i < n) ? p[i] : ',';
            if (i < n) {
                if (c == '(' || c == '[') depth++;
                else if (c == ')' || c == ']') depth--;
            }
            if (c == ',' && depth == 0) {
                char piece[MAX_NAME * 2];
                size_t len = i - start;
                if (len >= sizeof piece) len = sizeof piece - 1;
                memcpy(piece, p + start, len);
                piece[len] = 0;
                trim(piece);
                if (piece[0]) {
                    if (m->nparams >= MAX_PARAMS)
                        die(0, "too many parameters in method '%s'", m->name);
                    if (m->nparams) strncat(m->params, ", ", sizeof m->params - strlen(m->params) - 1);
                    strncat(m->params, piece, sizeof m->params - strlen(m->params) - 1);
                    param_type_only(piece, m->ptypes[m->nparams]);
                    m->nparams++;
                }
                start = i + 1;
            }
        }
    }

    /* "void greet(int a)" -> ret="void", name="greet", params="int a" */
    void split_decl(const char *decl, size_t pos, Method *m) {
        const char *lp = strchr(decl, '(');
        const char *rp;
        char pre[MAX_NAME * 2];
        int end, st;

        (void)self;  /* a pure parse helper; the receiver is not used */
        if (!lp) die(pos, "expected '(' in method declaration");
        snprintf(pre, sizeof pre, "%.*s", (int)(lp - decl), decl);
        trim(pre);

        end = (int)strlen(pre);
        st = end;
        while (st > 0 && is_ident_char((unsigned char)pre[st - 1])) st--;
        if (st == end) die(pos, "expected method name in declaration");
        snprintf(m->name, sizeof m->name, "%.*s", end - st, pre + st);
        pre[st] = 0;
        trim(pre);
        if (!pre[0]) die(pos, "expected return type for method '%s'", m->name);
        snprintf(m->ret, sizeof m->ret, "%s", pre);

        rp = strchr(lp, ')');
        if (!rp) die(pos, "expected ')' in declaration of '%s'", m->name);
        {
            char raw[MAX_PARAM * 2];
            size_t len = (size_t)(rp - lp - 1);
            if (len >= sizeof raw) len = sizeof raw - 1;
            memcpy(raw, lp + 1, len);
            raw[len] = 0;
            self->parse_params(m, raw);
        }
        {
            const char *tail = rp + 1;
            while (*tail == ' ' || *tail == '\t') tail++;
            if (*tail) die(pos, "unexpected '%s' after declaration of '%s'", tail, m->name);
        }
    }

    size_t parse_trait(size_t p) {
        struct SymTab *sym = self->sym;
        char name[MAX_NAME];
        Trait *T;
        size_t close, bstart, bend, i;
        size_t tline = self->line_of(p);            /* source line of 'trait' */
        Buf raw, clean;

        p += 5;                                     /* "trait" */
        p = skip_ws_comments(p);
        p = read_ident(p, name, sizeof name);
        if (!name[0]) die(p, "expected trait name");
        if (strcmp(name, "Drop") == 0) die(p, "'Drop' is a reserved built-in trait and cannot be defined");
        p = skip_ws_comments(p);
        if (p >= g_len || g_src[p] != '{') die(p, "expected '{' after trait '%s'", name);

        close = match_delim(p, '{', '}');
        bstart = p + 1;
        bend = close;

        if (strlen(g_ns) + strlen(name) >= sizeof T->cname)
            die(p, "namespace-qualified name too long");
        /* A duplicate is a hard error: the table keeps the first definition and
           every later lookup would silently pick whichever came last. Compared on
           the mangled C name, so the same short name in two namespaces is fine. */
        {
            char cn[MAX_NAME];
            int i2;
            snprintf(cn, sizeof cn, "%s%s", g_ns, name);
            for (i2 = 0; i2 < sym->ntraits; i2++)
                if (strcmp(sym->traits[i2].cname, cn) == 0)
                    die(p, "duplicate trait '%s'", name);
        }
        if (sym->ntraits >= MAX_TRAITS) die(p, "too many traits (max %d)", MAX_TRAITS);
        T = &sym->traits[sym->ntraits++];
        snprintf(T->name, sizeof T->name, "%s", name);
        snprintf(T->cname, sizeof T->cname, "%s%s", g_ns, name);
        T->nm = 0;

        buf_init(&raw);
        buf_putn(&raw, g_src + bstart, bend - bstart);
        buf_init(&clean);
        {
            /* strip comments once so ';' inside them does not split declarations */
            size_t k = 0, ln = raw.n;
            while (k < ln) {
                char c = raw.p[k];
                if (c == '"' || c == '\'') {
                    char q = c;
                    buf_putc(&clean, raw.p[k++]);
                    while (k < ln) {
                        if (raw.p[k] == '\\' && k + 1 < ln) {
                            buf_putc(&clean, raw.p[k]);
                            buf_putc(&clean, raw.p[k + 1]);
                            k += 2;
                            continue;
                        }
                        buf_putc(&clean, raw.p[k]);
                        if (raw.p[k] == q) { k++; break; }
                        k++;
                    }
                    continue;
                }
                if (c == '/' && k + 1 < ln && raw.p[k + 1] == '/') {
                    while (k < ln && raw.p[k] != '\n') k++;
                    continue;
                }
                if (c == '/' && k + 1 < ln && raw.p[k + 1] == '*') {
                    k += 2;
                    while (k + 1 < ln && !(raw.p[k] == '*' && raw.p[k + 1] == '/')) k++;
                    k = (k + 1 < ln) ? k + 2 : ln;
                    continue;
                }
                buf_putc(&clean, raw.p[k++]);
            }
        }
        free(raw.p);

        i = 0;
        for (;;) {
            size_t j = i;
            while (j <= clean.n && !(j < clean.n && clean.p[j] == ';')) j++;
            {
                char *seg = xstrndup(clean.p + i, j - i);
                trim(seg);
                if (seg[0]) {
                    if (T->nm >= MAX_METHOD)
                        die(close, "too many methods in trait '%s'", T->name);
                    self->split_decl(seg, close, &T->m[T->nm]);
                    T->nm++;
                }
                free(seg);
            }
            if (j >= clean.n) break;
            i = j + 1;
        }
        free(clean.p);

        /* an exported declaration goes into the .h alone; otherwise it goes to the
           .c (and, in single-file mode, to the .h as well: the .h is types-only) */
        if (!self->multi) {
            self->emit_trait_def(self->out, T, tline);
            self->emit_trait_def(self->hout, T, tline);
        } else if (self->ctor_pub) {
            self->emit_trait_def(self->hout, T, tline);
        } else {
            self->emit_trait_def(self->out, T, tline);
        }
        return close + 1;
    }

    size_t parse_struct(size_t p) {
        struct SymTab *sym = self->sym;
        char name[MAX_NAME];
        Struct *S;
        size_t close, bstart, bend, q, probe;
        size_t sline = self->line_of(p);            /* source line of 'struct' */
        int i;

        p += 6;                                     /* "struct" */
        p = skip_ws_comments(p);
        p = read_ident(p, name, sizeof name);
        if (!name[0]) die(p, "expected struct name");
        p = skip_ws_comments(p);
        if (p >= g_len || g_src[p] != '{') die(p, "expected '{' after struct '%s'", name);

        close = match_delim(p, '{', '}');
        bstart = p + 1;
        bend = close;

        if (strlen(g_ns) + strlen(name) >= sizeof S->cname)
            die(p, "namespace-qualified name too long");
        /* see parse_trait: duplicate definitions are errors, judged on the mangled
           name so namespaces stay isolated */
        {
            char cn[MAX_NAME];
            int i2;
            snprintf(cn, sizeof cn, "%s%s", g_ns, name);
            for (i2 = 0; i2 < sym->nstructs; i2++)
                if (strcmp(sym->structs[i2].cname, cn) == 0)
                    die(p, "duplicate struct '%s'", name);
        }
        if (sym->nstructs >= MAX_STRUCT) die(p, "too many structs (max %d)", MAX_STRUCT);
        S = &sym->structs[sym->nstructs++];
        snprintf(S->name, sizeof S->name, "%s", name);
        snprintf(S->cname, sizeof S->cname, "%s%s", g_ns, name);
        S->nu = 0;
        /* slots are reused across compiles (the table is reset by count, not by
           clearing), so every Drop flag must start clean */
        S->has_drop = 0;
        S->drop_used = 0;
        S->has_user_drop = 0;
        S->drop_bstart = 0;
        S->drop_blen = 0;
        S->def_line = sline;

        q = close + 1;
        probe = q;
        while (probe < g_len && (g_src[probe] == ' ' || g_src[probe] == '\t')) probe++;
        if (probe < g_len && g_src[probe] == '\n') {
            size_t t = probe + 1;
            while (t < g_len && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (word_at(t, "use")) probe = t;
        }

        if (word_at(probe, "use")) {
            size_t u = skip_ws_comments(probe + 3);
            for (;;) {
                char tn[MAX_NAME];
                u = read_ident(u, tn, sizeof tn);
                if (!tn[0]) die(u, "expected trait name in 'use' clause of '%s'", S->name);
                if (strcmp(tn, "Drop") == 0) {
                    /* the reserved built-in trait: it has no vtable and no vptr, so
                       it never enters the use list -- only the marker */
                    S->has_drop = 1;
                } else {
                    if (S->nu >= MAX_TRAITS) die(u, "too many traits used by '%s'", S->name);
                    snprintf(S->use_t[S->nu], MAX_NAME, "%s", tn);
                    S->nu++;
                }
                u = skip_ws_comments(u);
                if (u < g_len && g_src[u] == ',') { u = skip_ws_comments(u + 1); continue; }
                break;
            }
            if (u >= g_len || g_src[u] != ';') die(u, "expected ';' after 'use' clause of '%s'", S->name);
            q = u + 1;
        } else {
            size_t t = q;
            while (t < g_len && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t < g_len && g_src[t] == ';') q = t + 1;
        }

        for (i = 0; i < S->nu; i++) {
            Trait *T = sym->find_trait(S->use_t[i]);
            if (!T)
                die(p, "struct '%s' uses undefined trait '%s'", S->name, S->use_t[i]);
            S->use_i[i] = (int)(T - sym->traits);
        }

        if (S->has_drop && sym->nown_drop < MAX_STRUCT) {
            sym->own_drop[sym->nown_drop] = (int)(S - sym->structs);
            sym->nown_drop++;
        }

        {
            char *raw = xstrndup(g_src + bstart, bend - bstart);
            char *qbody = self->parse_fields(raw, S, p);
            free(raw);
            if (!self->multi) {
                self->emit_struct_def(self->out, S, qbody, sline);
                self->emit_struct_def(self->hout, S, qbody, sline);
            } else if (self->ctor_pub) {
                self->emit_struct_def(self->hout, S, qbody, sline);
            } else {
                self->emit_struct_def(self->out, S, qbody, sline);
            }
            free(qbody);
        }
        return q;
    }

    size_t parse_impl(size_t p) {
        struct SymTab *sym = self->sym;
        char trait_name[MAX_NAME], struct_name[MAX_NAME];
        Trait *T;
        Struct *S;
        size_t close, i, k;
        size_t dline = self->line_of(p);            /* source line of 'impl' */
        ImplMethod impl[MAX_METHOD];
        int nimpl = 0, found;

        p += 4;                                     /* "impl" */
        p = skip_ws_comments(p);
        p = read_ident(p, trait_name, sizeof trait_name);
        if (!trait_name[0]) die(p, "expected trait name after 'impl'");
        p = skip_ws_comments(p);
        if (!word_at(p, "for")) die(p, "expected 'for' in impl of '%s'", trait_name);
        p = skip_ws_comments(p + 3);
        p = read_ident(p, struct_name, sizeof struct_name);
        if (!struct_name[0]) die(p, "expected struct name after 'for'");
        p = skip_ws_comments(p);
        if (p >= g_len || g_src[p] != '{') die(p, "expected '{' in impl body");

        close = match_delim(p, '{', '}');

        if (strcmp(trait_name, "Drop") == 0) {
            /* `impl Drop for T { void drop() { ... } }` -- capture the user body;
               the drop function itself is emitted lazily, only when a delete is
               seen, so an unused impl costs nothing. */
            size_t i2 = skip_ws_comments(p + 1), rp, bp, be;
            S = sym->find_struct(struct_name);
            if (!S) die(p, "impl for undefined struct '%s'", struct_name);
            if (!S->has_drop) die(p, "struct '%s' does not use trait 'Drop'", S->name);
            while (i2 < close && g_src[i2] != '(') i2++;
            if (i2 >= close) die(p, "expected 'drop()' in impl of 'Drop' for '%s'", S->name);
            rp = match_delim(i2, '(', ')');
            bp = skip_ws_comments(rp + 1);
            if (bp >= close || g_src[bp] != '{') die(bp, "expected '{' to start the drop() body");
            be = match_delim(bp, '{', '}');
            S->has_user_drop = 1;
            S->drop_bstart = bp + 1;
            S->drop_blen = be - bp - 1;
            {
                size_t q2 = close + 1, t2 = q2;
                while (t2 < g_len && (g_src[t2] == ' ' || g_src[t2] == '\t')) t2++;
                if (t2 < g_len && g_src[t2] == ';') q2 = t2 + 1;
                return q2;
            }
        }

        T = sym->find_trait(trait_name);
        if (!T) die(p, "impl for undefined trait '%s'", trait_name);
        S = sym->find_struct(struct_name);
        if (!S) die(p, "impl for undefined struct '%s'", struct_name);
        if (!struct_uses(S, T->name))
            die(p, "struct '%s' does not use trait '%s'", S->name, T->name);

        /* collect the methods written in the impl block */
        i = p + 1;
        while (1) {
            size_t lp, rp, bp, be;
            char header[MAX_NAME * 2];
            char pre[MAX_NAME * 2];
            int end, st;

            i = skip_ws_comments(i);
            if (i >= close) break;

            lp = i;
            while (lp < close && g_src[lp] != '(') lp++;
            if (lp >= close) die(i, "expected method declaration inside impl of '%s' for '%s'",
                                 T->name, S->name);

            snprintf(pre, sizeof pre, "%.*s", (int)(lp - i), g_src + i);
            trim(pre);
            end = (int)strlen(pre);
            st = end;
            while (st > 0 && is_ident_char((unsigned char)pre[st - 1])) st--;
            if (st == end) die(i, "expected method name inside impl of '%s' for '%s'",
                               T->name, S->name);
            if (nimpl >= MAX_METHOD) die(i, "too many methods in impl of '%s'", T->name);
            snprintf(header, sizeof header, "%.*s", end - st, pre + st);

            rp = match_delim(lp, '(', ')');
            {
                size_t blen = (rp > lp + 1) ? (rp - lp - 1) : 0;
                if (blen >= MAX_PARAM) die(lp, "parameter list too long (max %d)", MAX_PARAM - 1);
                memcpy(impl[nimpl].params, g_src + lp + 1, blen);
                impl[nimpl].params[blen] = 0;
                trim(impl[nimpl].params);
            }

            bp = skip_ws_comments(rp + 1);
            if (bp >= close || g_src[bp] != '{')
                die(bp, "expected '{' to start body of method '%s'", header);
            be = match_delim(bp, '{', '}');

            snprintf(impl[nimpl].name, MAX_NAME, "%s", header);
            /* keep what the impl actually wrote: the signature check compares the
               return type and the parameter count against the trait */
            impl[nimpl].ret[0] = 0;
            if (st > 0) {
                snprintf(impl[nimpl].ret, MAX_NAME, "%.*s", st, pre);
                trim(impl[nimpl].ret);
            }
            {
                Method tmp;            /* parse_params only needs the count here */
                snprintf(tmp.name, MAX_NAME, "%s", header);
                self->parse_params(&tmp, impl[nimpl].params);
                impl[nimpl].nparams = tmp.nparams;
            }
            impl[nimpl].line = self->line_of(i);
            impl[nimpl].bstart = bp + 1;
            impl[nimpl].blen = be - bp - 1;
            nimpl++;

            i = be + 1;
        }

        /* every impl method must belong to the trait */
        for (k = 0; k < (size_t)nimpl; k++) {
            int j;
            found = 0;
            for (j = 0; j < T->nm; j++)
                if (strcmp(T->m[j].name, impl[k].name) == 0) { found = 1; break; }
            if (!found)
                die(p, "method '%s' is not declared in trait '%s'", impl[k].name, T->name);
        }

        /* Signature consistency (a warning, not an error). The emitted function
           always takes the trait's return type, so a differing one would be
           silently dropped, and a differing parameter count would mis-call it. An
           omitted return type means "use the trait's", exactly as before. */
        for (k = 0; k < (size_t)nimpl; k++) {
            int j;
            const Method *tm;
            for (j = 0; j < T->nm; j++)
                if (strcmp(T->m[j].name, impl[k].name) == 0) break;
            if (j >= T->nm) continue;          /* already diagnosed above */
            tm = &T->m[j];
            if (impl[k].ret[0] && !sym->type_same(impl[k].ret, tm->ret)) {
                char msg[MAX_PARAM];
                snprintf(msg, sizeof msg, "return type '%s' does not match the trait's '%s'",
                         impl[k].ret, tm->ret);
                sym->warn_add_sig(impl[k].line, impl[k].name, T->name, S->name, msg);
            } else if (impl[k].nparams != tm->nparams) {
                char msg[MAX_PARAM];
                snprintf(msg, sizeof msg, "takes %d parameter(s), the trait declares %d",
                         impl[k].nparams, tm->nparams);
                sym->warn_add_sig(impl[k].line, impl[k].name, T->name, S->name, msg);
            }
        }

        /* bodies that call a sibling method need the vtable declared up front */
        {
            int needs_vtable = 0;
            for (k = 0; k < (size_t)nimpl; k++)
                if (self->body_needs_vtable(impl[k].bstart, impl[k].blen)) { needs_vtable = 1; break; }
            if (needs_vtable) {
                self->line_at(self->out, dline);
                fprintf(self->out, "static struct %s_vtbl %s_%s_vtable;\n\n",
                        T->cname, S->cname, T->name);
                self->line_break();
            }
        }

        /* emit one function per trait method, in trait order */
        for (k = 0; k < (size_t)T->nm; k++) {
            Method *tm = &T->m[k];
            int idx = -1;
            int j;
            for (j = 0; j < nimpl; j++)
                if (strcmp(impl[j].name, tm->name) == 0) { idx = j; break; }
            if (idx < 0)
                die(p, "trait method '%s' is not implemented for struct '%s'",
                    tm->name, S->name);

            self->line_at(self->out, dline);
            fprintf(self->out, "static %s %s_%s_%s(void *self", tm->ret, S->cname, T->name, tm->name);
            if (tm->nparams > 0) fprintf(self->out, ", %s", impl[idx].params);
            fprintf(self->out, ") {\n");
            fprintf(self->out, "    struct %s *_self = (struct %s *)self;\n", S->cname, S->cname);
            self->emit_body(self->out, impl[idx].bstart, impl[idx].blen, S, impl[idx].params);
            fprintf(self->out, "}\n\n");
            self->line_break();
        }

        self->line_at(self->out, dline);
        fprintf(self->out, "static struct %s_vtbl %s_%s_vtable = {\n",
                T->cname, S->cname, T->name);
        for (k = 0; k < (size_t)T->nm; k++)
            fprintf(self->out, "    .%s = %s_%s_%s%s\n",
                    T->m[k].name, S->cname, T->name, T->m[k].name,
                    (k + 1 < (size_t)T->nm) ? "," : "");
        fprintf(self->out, "};\n\n");
        self->line_break();

        {
            size_t q = close + 1;
            size_t t = q;
            while (t < g_len && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t < g_len && g_src[t] == ';') q = t + 1;
            return q;
        }
    }

    /* The 1-based source line a byte offset falls on; `die` derives its
       line:column the same way. */
    int line_of(size_t pos) {
        int line = 1;
        size_t i;
        (void)self;    /* the source buffer is file-scope, not part of the receiver */
        for (i = 0; i < pos && i < g_len; i++) {
            if (g_src[i] == '\n') line++;
        }
        return line;
    }

    /* Invalidate the running mapping so the next `line_at` writes an explicit
       directive -- used after a run of generated boilerplate. */
    void line_break(void) {
        (void)self;    /* the mapping is file-scope state */
        self->line_next = -1;
    }

    /* Begin an output line of `f` that originates at `srcline`. A `#line`
       directive is written only when the running mapping would diverge, so a run
       of consecutive source lines stays directive-free. Only the .c is tracked:
       the .h is included verbatim by the .c, so a directive out there would point
       at the wrong file. */
    void line_at(FILE *f, size_t srcline) {
        if (f != self->out || !self->emit_line) return;
        if ((long)srcline != self->line_next)
            fprintf(f, "#line %ld \"%s\"\n", (long)srcline, g_path);
        self->line_next = (long)srcline + 1;
    }

    /* If the line just rewritten hoisted a temp receiver, write that declaration
       first: it must run before the rewritten line, and both belong to the same
       source line, so the mapping is re-anchored afterwards. */
    void emit_hoisted(void) {
        if (self->hoist.n == 0) return;
        fputs(self->hoist.p, self->out);
        fputc('\n', self->out);
        self->line_break();
        self->line_at(self->out, (size_t)self->cur_line);
    }

    /* Pass one raw source line through the shared rewriting pipeline. */
    void emit_raw_line(size_t ls, size_t le) {
        struct SymTab *sym = self->sym;
        size_t len = le - ls, t = 0;
        char *line, *sig;
        int pre = sym->nvars, has_body = 0;
        size_t body_abs = 0;

        if (!self->hoist.cap) buf_init(&self->hoist);
        self->hoist.n = 0;
        self->hoist.p[0] = 0;

        line = xstrndup(g_src + ls, len);
        self->cur_line = self->line_of(ls);
        while (t < len && (line[t] == ' ' || line[t] == '\t')) t++;
        if (t < len && line[t] == '#') {                 /* preprocessor: verbatim */
            fputs(line, self->out);
            free(line);
            return;
        }

        /* A leading `pub` marks an exported declaration (multi-file mode): drop it
           from the emitted line and remember it, so a bodiless signature can be
           routed into the .h instead (see just below). */
        self->line_pub = 0;
        if (t + 3 <= len && strncmp(line + t, "pub", 3) == 0 &&
            !is_ident_char((unsigned char)line[t + 3])) {
            size_t z = t + 3;
            while (z < len && (line[z] == ' ' || line[z] == '\t')) z++;
            self->line_pub = 1;
            memmove(line, line + z, len - z + 1);
            len -= z;
            ls += z;
            t = 0;
        }

        sym->leak_observe(line);                         /* leak tracking */
        self->line_off = ls;
        sig = self->parse_func_sig(line, ls, &has_body, &body_abs);
        if (sig) {
            /* an exported prototype belongs in the .h and nowhere else; the
               newline compile_range writes still lands in the .c, so the .c keeps
               a blank line where the declaration used to be */
            if (has_body) { self->body_abs = body_abs; self->body_pre = pre; }
            fputs(sig, (self->line_pub && self->multi && !has_body) ? self->hout : self->out);
            free(sig);
        } else {
            char *out = self->transform_line(line);
            self->emit_hoisted();
            fputs(out, self->out);
            free(out);
        }
        free(line);
        self->scope_track(ls, le);
    }

    /* Scan [start,end): expand traits/structs/impls, pass the rest through. */
    void compile_range(size_t start, size_t end) {
        struct SymTab *sym = self->sym;
        size_t pos = start;
        jmp_buf outer_jmp;
        int outer_guarded = g_guarded;

        /* A namespace body compiles through a recursive call, so this range's
           guard would clobber its caller's; save and restore it around the loop. */
        memset(outer_jmp, 0, sizeof outer_jmp);
        if (outer_guarded) memcpy(outer_jmp, g_err_jmp, sizeof g_err_jmp);

        while (pos < end) {
            size_t ls = pos, q, le;

            /* One guard per construct: `die` reports and jumps back here, the loop
               resynchronises past the next `}` or line start, and the invariants a
               jump may skip past are put back before it does. */
            self->guard_pos = pos;
            self->guard_end = end;
            self->safe_nvars = sym->nvars;
            self->safe_nscope = self->nscope;
            if (setjmp(g_err_jmp) != 0) {
                g_guarded = 1;
                sym->nvars = self->safe_nvars;
                self->nscope = self->safe_nscope;
                self->body_abs = 0;
                pos = self->recover_pos(g_err_pos > self->guard_pos ? g_err_pos : self->guard_pos,
                                        self->guard_end);
                if (pos <= self->guard_pos) pos = self->guard_pos + 1;
                continue;
            }
            g_guarded = 1;

            q = ls;
            while (q < end && (g_src[q] == ' ' || g_src[q] == '\t')) q++;

            /* An optional `pub` marks a trait/struct as exported (multi-file
               mode); `pub` on a function line is stripped later, in
               `emit_raw_line`. */
            self->ctor_pub = 0;
            if (word_at(q, "pub")) {
                size_t t = skip_ws_comments(q + 3);
                if (word_at(t, "trait") || word_at(t, "struct")) { self->ctor_pub = 1; q = t; }
            }

            /* `import A::B;` is a compilation-unit declaration: the build driver
               resolves it and turns it into an `#include` line, so the line itself
               is consumed here and never emitted. Anything less than a complete
               header falls through as a plain line, which keeps a line that merely
               starts with the word from being mistaken for one. */
            if (word_at(q, "import")) {
                size_t t = skip_ws_comments(q + 6);
                int ok = 1;
                size_t nseg = 0;
                for (;;) {
                    char seg[MAX_NAME];
                    t = read_ident(t, seg, sizeof seg);
                    if (!seg[0]) { ok = 0; break; }
                    nseg++;
                    t = skip_ws_comments(t);
                    if (t + 1 < g_len && g_src[t] == ':' && g_src[t + 1] == ':') {
                        t = skip_ws_comments(t + 2);
                        continue;
                    }
                    break;
                }
                if (ok && nseg && t < g_len && g_src[t] == ';') {
                    size_t e = t;
                    while (e < end && g_src[e] != '\n') e++;
                    pos = (e < end) ? e + 1 : end;
                    continue;
                }
            }

            if (word_at(q, "trait")) {
                char nm[MAX_NAME];
                size_t t = read_ident(skip_ws_comments(q + 5), nm, sizeof nm);
                if (nm[0] || (t < g_len && g_src[t] == '{')) { pos = self->parse_trait(q); continue; }
            }
            if (word_at(q, "impl")) {
                char nm[MAX_NAME];
                size_t t = read_ident(skip_ws_comments(q + 4), nm, sizeof nm);
                if (nm[0] || (t < g_len && g_src[t] == '{')) { pos = self->parse_impl(q); continue; }
            }
            if (word_at(q, "struct")) {
                size_t t = skip_ws_comments(q + 6);
                char nm[MAX_NAME];
                t = read_ident(t, nm, sizeof nm);
                if (nm[0]) {
                    t = skip_ws_comments(t);
                    if (t < g_len && g_src[t] == '{') { pos = self->parse_struct(q); continue; }
                }
            }

            if (word_at(q, "namespace")) {
                /* namespace A::B::C { ... } mangles every enclosed declaration
                   with the prefix "A_B_C_" and resolves unqualified names there
                   first. The braces themselves are consumed, never emitted. Only
                   a complete header is a construct; anything else falls through
                   as a plain line. */
                size_t t = skip_ws_comments(q + 9);
                char pre[MAX_NAME], seg[MAX_NAME], saved[MAX_NAME], open[MAX_NAME * 2];
                size_t pl = 0, close = 0;
                int nseg = 0, ok = 1;

                pre[0] = 0;
                for (;;) {
                    size_t sl;

                    t = read_ident(t, seg, sizeof seg);
                    if (!seg[0]) {
                        if (nseg == 0) { ok = 0; break; }
                        die(t, "expected a name after '::' in namespace");
                    }
                    sl = strlen(seg);
                    if (nseg && pl + sl + 2 >= sizeof pre) die(t, "namespace path too long");
                    if (nseg) pre[pl++] = '_';
                    memcpy(pre + pl, seg, sl);
                    pl += sl;
                    pre[pl] = 0;
                    nseg++;
                    t = skip_ws_comments(t);
                    if (t + 1 < g_len && g_src[t] == ':' && g_src[t + 1] == ':') {
                        t = skip_ws_comments(t + 2);
                        continue;
                    }
                    break;
                }

                if (ok && t < g_len && g_src[t] == '{') {
                    close = match_delim(t, '{', '}');

                    snprintf(saved, sizeof saved, "%s", g_ns);
                    /* compare against g_ns's own capacity: truncating the prefix
                       would silently mangle every name inside */
                    if (snprintf(open, sizeof open, "%s%s_", g_ns, pre) >= (int)sizeof g_ns)
                        die(t, "namespace path too long");
                    snprintf(g_ns, sizeof g_ns, "%s", open);

                    self->compile_range(t + 1, close);

                    snprintf(g_ns, sizeof g_ns, "%s", saved);
                    pos = close + 1;
                    continue;
                }
            }

            le = ls;
            while (le < end && g_src[le] != '\n') le++;
            self->line_at(self->out, self->line_of(ls));
            self->emit_raw_line(ls, le);
            if (le < end) { fputc('\n', self->out); le++; }
            pos = le;
        }

        g_guarded = outer_guarded;
        if (outer_guarded) memcpy(g_err_jmp, outer_jmp, sizeof g_err_jmp);
    }

    /* Write the include guard and provenance banner into the header stream. */
    void write_guard(const char *hpath) {
        const char *b = strrchr(hpath, '/');
        char guard[MAX_NAME * 2];
        size_t i, j = 0;
        b = b ? b + 1 : hpath;

        for (i = 0; b[i] && b[i] != '.' && j + 1 < sizeof guard; i++)
            guard[j++] = (isalnum((unsigned char)b[i]) ? (char)toupper((unsigned char)b[i]) : '_');
        guard[j] = 0;
        if (!j) snprintf(guard, sizeof guard, "CT_OUTPUT");
        if (guard[0] >= '0' && guard[0] <= '9') {
            memmove(guard + 1, guard, j + 1);
            guard[0] = '_';
        }
        strncat(guard, "_H", sizeof guard - strlen(guard) - 1);

        fprintf(self->hout, "#ifndef %s\n#define %s\n\n", guard, guard);
        if (self->multi)
            fprintf(self->hout, "/* Generated by ctc v%s from %s (multi-file mode:\n"
                            "   exported types; the matching .c includes this header).\n"
                            "   Generated output is not covered by the GPL and may be "
                            "used without restriction (LICENSE.EXCEPTION). */\n\n",
                    CTC_VERSION, g_path);
        else
            fprintf(self->hout, "/* Generated by ctc v%s from %s (Phase 0: types only, the\n"
                            "   generated .c is self-contained).\n"
                            "   Generated output is not covered by the GPL and may be "
                            "used without restriction (LICENSE.EXCEPTION). */\n\n",
                    CTC_VERSION, g_path);
        snprintf(self->guard, sizeof self->guard, "%s", guard);
    }

    /* Print the CLI help text to stderr. */
    void usage(const char *prog) {
        (void)self;  /* a pure CLI helper; the receiver is not used */
        fprintf(stderr,
                "usage: %s [compile] <input.ct> [-o <output.c>] [-I <dir>]\n"
                "       %s build <input.ct>... [-o <outdir>] [-I <dir>]...\n\n"
                "L1: compiles C-with-traits (.ct) into plain C, writing <output.c> and\n"
                "a matching header <output.h>; if -o is omitted the output is <input>.c\n"
                "next to the input. `build` compiles every input in multi-file mode (the\n"
                ".c includes its own .h, `pub` symbols go into the .h, an `import` adds\n"
                "an include line, and `#line` is emitted) and prints the suggested cc\n"
                "command.\n\n"
                "  -o <file|dir>   compile: write the generated C to <file>\n"
                "                  build: write the outputs into <dir>\n"
                "  -I <dir>        extra `import` search root, repeatable; checked after\n"
                "                  the importing file's own directory\n"
                "  --line          force `#line` directives in the generated C\n"
                "  --no-line       suppress `#line` directives\n"
                "  --diagnostics=<fmt>  warning format: text (default) or json\n"
                "  -v, --version   print the compiler version and exit\n"
                "  -h, --help      print this help and exit\n",
                prog, prog);
    }

    /* Derive the default C output path from the input ("a.ct" -> "a.c",
       "a.h.ct" -> "a.c" -- the `.h.ct` basename names a header unit). */
    void default_output(const char *in, char *out, size_t n) {
        size_t l = strlen(in);
        (void)self;  /* a pure CLI helper; the receiver is not used */
        if (l > 5 && strcmp(in + l - 5, ".h.ct") == 0) {
            snprintf(out, n, "%.*s.c", (int)(l - 5), in);
        } else if (l > 3 && strcmp(in + l - 3, ".ct") == 0) {
            snprintf(out, n, "%.*s.c", (int)(l - 3), in);
        } else {
            snprintf(out, n, "%s.c", in);
        }
    }

    /* Derive the header path from the C output path ("<outc with .c -> .h>"). */
    void header_path(const char *outc, char *out, size_t n) {
        size_t l = strlen(outc);
        (void)self;  /* a pure path helper; the receiver is not used */
        if (l > 2 && strcmp(outc + l - 2, ".c") == 0) {
            snprintf(out, n, "%.*s.h", (int)(l - 2), outc);
        } else {
            snprintf(out, n, "%s.h", outc);
        }
    }

    /* Read one input file whole, normalising CRLF / lone CR. A failing open,
       read or allocation is fatal. */
    char *read_file(const char *path, size_t *out_len) {
        FILE *f = fopen(path, "rb");
        long sz;
        char *buf;

        (void)self;  /* a pure I/O helper; the receiver is not used */
        if (!f) { fprintf(stderr, "ctc: cannot open '%s'\n", path); exit(1); }
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) { fprintf(stderr, "ctc: cannot read '%s'\n", path); exit(1); }

        buf = xmalloc((size_t)sz + 1);
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            fprintf(stderr, "ctc: short read on '%s'\n", path);
            exit(1);
        }
        buf[sz] = 0;
        fclose(f);

        /* normalise CRLF / lone CR */
        {
            size_t i = 0, j = 0;
            while (i < (size_t)sz) {
                if (buf[i] == '\r') {
                    if (i + 1 < (size_t)sz && buf[i + 1] == '\n') i++;
                    buf[j++] = '\n';
                    i++;
                } else {
                    buf[j++] = buf[i++];
                }
            }
            buf[j] = 0;
            *out_len = j;
        }
        return buf;
    }

    /* The drop prototypes go before the body (a delete calls them) and the
       definitions after it (so the structs are complete). Both are emitted only
       for the types a delete actually reaches. */
    void emit_drop_prototypes(FILE *f) {
        struct SymTab *sym = self->sym;
        int i, any = 0;
        sym->mark_drop_closure();
        for (i = 0; i < sym->nown_drop; i++) {
            Struct *S = &sym->structs[sym->own_drop[i]];
            if (!S->drop_used) continue;
            self->line_at(f, S->def_line);
            fprintf(f, "static void %s_Drop_drop(void *self);\n", S->cname);
            any = 1;
        }
        if (any) fputc('\n', f);
        self->line_break();
    }

    void emit_drop_bodies(FILE *f) {
        struct SymTab *sym = self->sym;
        int i;
        for (i = 0; i < sym->nown_drop; i++) {
            Struct *S = &sym->structs[sym->own_drop[i]];
            int h, need_self = 0;
            if (!S->drop_used) continue;
            if (S->has_user_drop) {
                need_self = self->body_uses_self(S->drop_bstart, S->drop_blen);
            } else {
                for (h = 0; h < S->nf; h++)
                    if (sym->structs[S->ftype[h]].has_drop) { need_self = 1; break; }
            }
            self->line_at(f, S->def_line);
            fprintf(f, "static void %s_Drop_drop(void *self) {\n", S->cname);
            if (need_self)
                fprintf(f, "    struct %s *_self = (struct %s *)self;\n", S->cname, S->cname);
            else
                fprintf(f, "    (void)self;\n");
            if (S->has_user_drop) {
                self->emit_body(f, S->drop_bstart, S->drop_blen, S, "");
            } else {
                for (h = 0; h < S->nf; h++) {
                    const Struct *F = &sym->structs[S->ftype[h]];
                    if (!F->has_drop) continue;
                    fprintf(f, "    %s_Drop_drop(&_self->%s);\n", F->cname, S->fname[h]);
                }
            }
            fprintf(f, "}\n\n");
            self->line_break();
        }
    }

    /* Compile one input to `outc` and a matching header. `multi` selects
       multi-file mode (see the trait declaration). Returns 0 on success. */
    int compile_file(const char *in, const char *outc, int multi) {
        struct SymTab *sym = self->sym;
        char hbuf[MAX_NAME * 4];
        const char *base;
        FILE *body;
        int err_base = g_nerrors;   /* errors already reported by earlier units */

        self->multi = multi;
        g_ns[0] = 0;
        sym->nvars = 0;
        self->nscope = 0;
        self->body_abs = 0;
        self->body_pre = 0;
        self->cur_rettr = -1;
        self->ctor_pub = 0;
        self->line_pub = 0;
        sym->nown_drop = 0;
        /* multi-file mode accumulates the traits/structs/signatures across units
           so a unit can name what the units built before it exported; a
           single-file compile of the same file starts from an empty table, which
           is what keeps its output identical to the single-file compiler's */
        if (!multi) { sym->ntraits = 0; sym->nstructs = 0; sym->nfuncs = 0; }
        buf_init(&self->unit_init);
        self->has_unit_init = 0;

        self->header_path(outc, hbuf, sizeof hbuf);
        g_path = in;
        g_src = self->read_file(in, &g_len);

        /* `#line` is on in multi-file mode only: single-file output is left
           untouched so it stays byte-identical to L0's. `--line` / `--no-line`
           override the per-mode default. */
        self->emit_line = (self->line_force >= 0) ? self->line_force : multi;
        self->cur_line = 1;
        self->line_next = -1;

        self->out = fopen(outc, "w");
        if (!self->out) { fprintf(stderr, "ctc: cannot write '%s'\n", outc); return 1; }
        self->hout = fopen(hbuf, "w");
        if (!self->hout) { fprintf(stderr, "ctc: cannot write '%s'\n", hbuf); fclose(self->out); return 1; }

        self->write_guard(hbuf);

        /* provenance banner: the generated C is a build product, not a source file */
        fprintf(self->out, "/* Generated by ctc v%s from %s -- do not edit; "
                       "change the .ct and re-run ctc. */\n"
                       "/* Generated output is not covered by the GPL and may be "
                       "used without restriction (LICENSE.EXCEPTION). */\n",
                CTC_VERSION, g_path);

        /* Every generated .c opens by including the header it was built with, so
           its types are in scope; the imports the driver resolved follow, and the
           blank line keeps the banner off the first source line. */
        if (multi) {
            int i;
            base = strrchr(hbuf, '/');
            base = base ? base + 1 : hbuf;
            fprintf(self->out, "#include \"%s\"\n", base);
            for (i = 0; i < self->nimp_h; i++)
                fprintf(self->out, "#include \"%s\"\n", self->imp_h[i]);
            fputc('\n', self->out);
        }

        /* Buffer the body so the lazily-generated drop functions can be emitted
           before it: a drop function must be defined before the delete that calls
           it, and whether a type needs one is only known once the body is scanned. */
        body = tmpfile();
        if (!body) {
            fprintf(stderr, "ctc: cannot create a temporary file\n");
            fclose(self->out);
            fclose(self->hout);
            return 1;
        }
        {
            FILE *real = self->out;
            self->out = body;
            self->compile_range(0, g_len);
            self->out = real;
            /* Errors were reported along the way: the body is not a usable
               product, so the half-written .c/.h are dropped instead of left
               behind (a later successful unit is unaffected). */
            if (g_nerrors > err_base) {
                fclose(body);
                fclose(self->out);
                fclose(self->hout);
                remove(outc);
                remove(hbuf);
                return 1;
            }
            self->line_break();
            self->emit_drop_prototypes(real);
            rewind(body);
            for (;;) {
                char chunk[8192];
                size_t got = fread(chunk, 1, sizeof chunk, body);
                if (!got) break;
                fwrite(chunk, 1, got, real);
            }
            self->emit_drop_bodies(real);

            /* file-scope objects/arrays: their vptr writes were collected while
               scanning and are emitted here, after the types and vtables they
               reference, as a constructor that runs before main */
            if (self->has_unit_init)
                fprintf(real,
                        "static void __ct_init(void) __attribute__((constructor));\n"
                        "static void __ct_init(void) {\n%s}\n",
                        self->unit_init.p);
            free(self->unit_init.p);
        }
        fclose(body);

        fprintf(self->hout, "\n#endif /* %s */\n", self->guard);

        fclose(self->out);
        fclose(self->hout);
        return 0;
    }

    /* Emit an impl method body. `self` is registered as a pointer to `S` and the
       method's parameters are registered, then every line runs through the same
       pipeline as top-level code; only the identifier `self` is renamed to `_self`. */
    void emit_body(FILE *f, size_t bstart, size_t blen, const Struct *S, const char *params) {
        struct SymTab *sym = self->sym;
        size_t i, j, n = blen;
        int minind = 1 << 30;
        size_t *ls, *le;
        int nlines = 0, first = -1, last = -1, k;
        int saved_nvars = sym->nvars, saved_nscope = self->nscope;
        /* the body reuses the shared var table from index 0, so snapshot the
           enclosing file-scope entries and put them back on the way out; restoring
           only the count would leave the outer registrations clobbered */
        Var *saved_vars = xmalloc(sizeof(Var) * (saved_nvars ? (size_t)saved_nvars : 1));
        memcpy(saved_vars, sym->vars, sizeof(Var) * (size_t)saved_nvars);
        size_t saved_body_abs = self->body_abs;
        int saved_body_pre = self->body_pre;
        size_t saved_line_off = self->line_off;
        int saved_cur_line = self->cur_line;
        int saved_in_body = self->in_body;
        int vi;

        ls = xmalloc(sizeof(size_t) * (n + 2));
        le = xmalloc(sizeof(size_t) * (n + 2));

        i = 0;
        while (i < n) {
            j = i;
            while (j < n && g_src[bstart + j] != '\n') j++;
            ls[nlines] = bstart + i;
            le[nlines] = bstart + j;
            nlines++;
            i = j + 1;
            if (j >= n) break;
        }

        for (k = 0; k < nlines; k++) {
            size_t t = ls[k];
            while (t < le[k] && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t < le[k]) {
                int ind = (int)(t - ls[k]);
                if (ind < minind) minind = ind;
                if (first < 0) first = k;
                last = k;
            }
        }

        if (first < 0) { free(ls); free(le); return; }

        /* the body sees only its own locals, never the surrounding file scope */
        sym->nvars = 0;
        self->nscope = 0;
        self->body_abs = 0;
        vi = sym->new_var();
        snprintf(sym->vars[vi].name, MAX_NAME, "self");
        sym->vars[vi].s = (int)(S - sym->structs);
        sym->vars[vi].ptr = 1;
        sym->vars[vi].arr = 0;
        sym->vars[vi].iface = 0;
        sym->vars[vi].tr = -1;
        self->register_body_params(params);

        self->line_break();   /* anchor: the first body line always carries a #line */
        self->in_body = 1;
        for (k = first; k <= last; k++) {
            size_t t = ls[k], content;
            char *line, *out;
            Buf sb;

            self->cur_line = self->line_of(ls[k]);
            self->line_off = ls[k];
            if (!self->hoist.cap) buf_init(&self->hoist);
            self->hoist.n = 0;
            self->hoist.p[0] = 0;

            while (t < le[k] && (g_src[t] == ' ' || g_src[t] == '\t')) t++;
            if (t >= le[k]) { fputc('\n', f); self->scope_track(ls[k], le[k]); continue; }

            content = ls[k] + (size_t)minind;
            line = xstrndup(g_src + content, le[k] - content);
            out = self->transform_line(line);
            if (self->hoist.n == 0) self->line_at(f, (size_t)self->cur_line);
            else self->emit_hoisted();
            buf_init(&sb);
            self->replace_self(out, strlen(out), &sb);
            {
                size_t p2 = 0;
                while (p2 < sb.n) {
                    size_t q2 = p2;
                    while (q2 < sb.n && sb.p[q2] != '\n') q2++;
                    fputs("    ", f);
                    fwrite(sb.p + p2, 1, q2 - p2, f);
                    fputc('\n', f);
                    p2 = (q2 < sb.n) ? q2 + 1 : q2;
                }
            }
            free(line);
            free(out);
            free(sb.p);
            self->scope_track(ls[k], le[k]);
        }
        /* the method body's own scope has no `}` inside the emitted range: release
           its top-level `own` variables right before the caller writes the brace */
        if (!self->hoist.cap) buf_init(&self->hoist);
        self->hoist.n = 0;
        self->hoist.p[0] = 0;
        self->emit_drops(&self->hoist, "    ", 4, 0, sym->nvars);
        if (self->hoist.n > 0) {
            fputs(self->hoist.p, f);
            fputc('\n', f);
        }
        self->line_break();

        memcpy(sym->vars, saved_vars, sizeof(Var) * (size_t)saved_nvars);
        free(saved_vars);
        self->in_body = saved_in_body;
        sym->nvars = saved_nvars;
        self->nscope = saved_nscope;
        self->body_abs = saved_body_abs;
        self->body_pre = saved_body_pre;
        self->line_off = saved_line_off;
        self->cur_line = saved_cur_line;
        free(ls);
        free(le);
    }

    /* Register the impl method's parameters that are declared with a known struct
       type, so calls on them dispatch inside the body like top-level parameters do. */
    void register_body_params(const char *params) {
        struct SymTab *sym = self->sym;
        const char *p = params;
        (void)self;  /* the body only reads the symbol table, not the receiver */
        while (p && *p) {
            const char *c = strchr(p, ',');
            const char *end = c ? c : p + strlen(p);
            char piece[MAX_PARAM];
            char name[MAX_NAME];
            const char *q;
            Struct *ST;
            size_t plen = (size_t)(end - p), nk;

            if (plen >= sizeof piece) plen = sizeof piece - 1;
            memcpy(piece, p, plen);
            piece[plen] = 0;
            trim(piece);

            q = piece;
            while (*q == ' ' || *q == '\t') q++;
            if (strncmp(q, "struct", 6) == 0 && !is_ident_char((unsigned char)q[6])) {
                q += 6;
                while (*q == ' ' || *q == '\t') q++;
            }
            nk = copy_ident(q, name, 0);
            name[nk] = 0;
            q += nk;
            ST = nk ? sym->find_struct(name) : NULL;
            if (ST) {
                int isptr = 0;
                while (*q == ' ' || *q == '\t') q++;
                if (*q == '*') {
                    isptr = 1;
                    while (*q == '*' || *q == ' ' || *q == '\t') q++;
                }
                if (is_ident_char((unsigned char)*q) && !isdigit((unsigned char)*q)) {
                    char pv[MAX_NAME];
                    int pk = copy_ident(q, pv, 0);
                    pv[pk] = 0;
                    if (pk) {
                        int vi = sym->new_var();
                        snprintf(sym->vars[vi].name, MAX_NAME, "%s", pv);
                        sym->vars[vi].s = (int)(ST - sym->structs);
                        sym->vars[vi].ptr = isptr;
                        sym->vars[vi].arr = 0;
                        sym->vars[vi].iface = 0;
                        sym->vars[vi].tr = -1;
                    }
                }
            }
            p = c ? c + 1 : end;
        }
    }
}

/* ------------------------------------------------------- line rewriting */

/* The rewriting layer: everything below turns one source line into the line(s) it
   becomes, and is reached only through `emit_raw_line` / `emit_body`. It shares
   the receiver with `PipeOps`, so a method here can still call the pipeline's
   helpers through `self->` and vice versa. */
impl RewriteOps for Pipe {
    /* After a reported error, jump to a place the scanner can restart from: the
       first of the next `}` (consumed) and the next line start. Literals and
       comments are stepped over so a `}` inside a string is not mistaken for the
       end of the construct. */
    size_t recover_pos(size_t from, size_t end) {
        size_t p = from;
        (void)self;  /* a pure scan; the receiver is not used */
        while (p < end) {
            char c = g_src[p];
            if (c == '"' || c == '\'') { p = skip_literal(p); continue; }
            if (c == '/' && p + 1 < end &&
                (g_src[p + 1] == '/' || g_src[p + 1] == '*')) {
                p = skip_comment(p);
                continue;
            }
            if (c == '}' || c == '\n') return p + 1;
            p++;
        }
        return end;
    }
    /* `self` -> `_self` for one line. Strings and comments are copied verbatim, and
       a member literally named `self` (e.g. `g.self`) is not the implicit receiver. */
    void replace_self(const char *s, size_t n, Buf *out) {
        size_t i = 0;
        (void)self;  /* a pure string rewrite; the receiver is not used */
        while (i < n) {
            char c = s[i];
            if (c == '"' || c == '\'') {
                size_t j = line_literal_end(s, i, n);
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (c == '/' && i + 1 < n && (s[i + 1] == '/' || s[i + 1] == '*')) {
                size_t j;
                if (s[i + 1] == '/') {
                    j = n;
                } else {
                    j = i + 2;
                    while (j + 1 < n && !(s[j] == '*' && s[j + 1] == '/')) j++;
                    j = (j + 1 < n) ? j + 2 : n;
                }
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (is_ident_char((unsigned char)c) && !isdigit((unsigned char)c)) {
                size_t j = i;
                while (j < n && is_ident_char((unsigned char)s[j])) j++;
                if (j - i == 4 && memcmp(s + i, "self", 4) == 0 &&
                    !(i > 0 && (s[i - 1] == '.' ||
                                (s[i - 1] == '>' && i > 1 && s[i - 2] == '-'))))
                    buf_puts(out, "_self");
                else
                    buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            buf_putc(out, c);
            i++;
        }
    }

    /* Append `e` boxed into the interface value of trait `tr`, or verbatim when
       it already is an interface value of that trait. Dies when the expression's
       type cannot be inferred (only a variable or `&variable` can be boxed). */
    void box_to_iface(Buf *out, const char *e, size_t len, int tr, size_t pos) {
        struct SymTab *sym = self->sym;
        char id[MAX_NAME];
        const char *q = e, *r;
        size_t ql = len, k = 0;
        int vi, amped = 0;
        Struct *S;

        (void)self;  /* the symbol tables arrive as `sym`; the receiver is not used */
        while (ql > 0 && isspace((unsigned char)*q)) { q++; ql--; }
        while (ql > 0 && isspace((unsigned char)q[ql - 1])) ql--;
        if (ql == 0) die(pos, "cannot infer the type of the boxed value");
        if (*q == '&') {
            amped = 1;
            q++;
            ql--;
        }
        if (ql == 0 || ql >= MAX_NAME) die(pos, "cannot infer the type of the boxed value");

        while (k < ql && is_ident_char((unsigned char)q[k])) k++;
        if (k == 0) die(pos, "cannot infer the type of the boxed value");
        memcpy(id, q, k);
        id[k] = 0;
        r = q + k;
        while (r < q + ql && isspace((unsigned char)*r)) r++;

        if (*r == '(') {                       /* a call: it must already return this interface */
            FuncSig *FS = sym->find_func(id);
            if (FS && FS->rettrait == tr) {
                buf_putn(out, e, len);
                return;
            }
            if (FS && FS->rettrait >= 0)
                die(pos, "'%s' returns an interface value of a different trait", id);
            die(pos, "cannot infer the type of the boxed value");
        }
        if (r != q + ql)
            die(pos, "cannot infer the type of the boxed value");   /* not a plain name */

        vi = sym->find_var(id);
        if (vi < 0) die(pos, "cannot infer the type of '%s'", id);
        if (sym->vars[vi].iface) {
            if (sym->vars[vi].tr != tr)
                die(pos, "'%s' is an interface value of a different trait", id);
            if (amped) die(pos, "'%s' is already an interface value", id);
            buf_putn(out, e, len);                       /* already an interface value */
            return;
        }
        if (amped && sym->vars[vi].ptr)
            die(pos, "'&%s' is not an object of a struct type", id);

        S = &sym->structs[sym->vars[vi].s];
        if (!struct_uses(S, sym->traits[tr].name))
            die(pos, "struct '%s' does not use trait '%s'", S->name, sym->traits[tr].name);

        buf_puts(out, "(struct ");
        buf_puts(out, sym->traits[tr].cname);
        buf_puts(out, "_iface){ (void *)");
        if (sym->vars[vi].ptr) buf_puts(out, id);
        else { buf_putc(out, '&'); buf_puts(out, id); }
        buf_puts(out, ", &");
        buf_puts(out, S->cname);
        buf_putc(out, '_');
        buf_puts(out, sym->traits[tr].name);
        buf_puts(out, "_vtable }");
    }

    /* Append `e` boxed as a *pointer* to the interface value of trait `tr` -- a
       `struct <T>_iface *` for a pointer interface field (`struct T *x`). A
       concrete object is boxed into an anonymous fat pointer whose address is
       stored, so its lifetime is the enclosing block; an expression that already
       is an interface value has its address taken (or reused, for `&v`). */
    void box_to_iface_ptr(Buf *out, const char *e, size_t len, int tr, size_t pos) {
        struct SymTab *sym = self->sym;
        char id[MAX_NAME];
        const char *q = e, *r;
        size_t ql = len, k = 0;
        int vi, amped = 0;

        (void)self;  /* the symbol tables arrive as `sym`; the receiver is not used */
        while (ql > 0 && isspace((unsigned char)*q)) { q++; ql--; }
        while (ql > 0 && isspace((unsigned char)q[ql - 1])) ql--;
        if (ql == 0) die(pos, "cannot infer the type of the boxed value");
        if (*q == '&') { amped = 1; q++; ql--; }
        if (ql == 0 || ql >= MAX_NAME) die(pos, "cannot infer the type of the boxed value");
        while (k < ql && is_ident_char((unsigned char)q[k])) k++;
        if (k == 0) die(pos, "cannot infer the type of the boxed value");
        memcpy(id, q, k);
        id[k] = 0;
        r = q + k;
        while (r < q + ql && isspace((unsigned char)*r)) r++;

        if (*r == '(') {
            /* a call returning this interface value: box its result into an
               anonymous location whose address can be stored */
            FuncSig *FS = sym->find_func(id);
            if (!(FS && FS->rettrait == tr))
                die(pos, "cannot infer the type of the boxed value");
            buf_puts(out, "&(struct ");
            buf_puts(out, sym->traits[tr].cname);
            buf_puts(out, "_iface){ ");
            buf_putn(out, e, len);
            buf_puts(out, " }");
            return;
        }
        if (r != q + ql)
            die(pos, "cannot infer the type of the boxed value");

        vi = sym->find_var(id);
        if (vi < 0) die(pos, "cannot infer the type of '%s'", id);
        if (sym->vars[vi].iface) {
            if (sym->vars[vi].tr != tr)
                die(pos, "'%s' is an interface value of a different trait", id);
            if (!amped) buf_putc(out, '&');
            buf_putn(out, e, len);
            return;
        }
        /* a concrete object: store the address of the boxed copy */
        buf_putc(out, '&');
        self->box_to_iface(out, e, len, tr, pos);
    }

    /* The body of an aggregate initialiser (the text between the braces) is
       rewritten item by item: a designated initialiser of an interface field
       boxes its value exactly as the matching assignment would, so
       `struct Add s = { .l = a, .r = b };` builds the same fat pointers
       `s.l = a; s.r = b;` do. Non-interface fields, positional items and nested
       braces pass through untouched. */
    void box_agg_fields(Buf *out, const Struct *S, const char *inner, size_t it) {
        size_t i = 0;
        while (i < it) {
            size_t j = i, depth = 0, vstart, pn, ms;
            int isptr = 0, isarr = 0, ftr = -1;
            char mem[MAX_NAME];
            size_t ml;

            /* this item runs up to the next comma that is not inside brackets */
            while (j < it) {
                char c = inner[j];
                if (c == '"' || c == '\'') { j = line_literal_end(inner, j, it); continue; }
                if (c == '(' || c == '[' || c == '{') depth++;
                else if (c == ')' || c == ']' || c == '}') { if (depth) depth--; }
                else if (c == ',' && depth == 0) break;
                j++;
            }

            vstart = i;
            while (vstart < j && (inner[vstart] == ' ' || inner[vstart] == '\t')) vstart++;
            if (vstart < j && inner[vstart] == '.') {
                ms = vstart + 1;
                pn = ms;
                while (pn < j && is_ident_char((unsigned char)inner[pn])) pn++;
                ml = pn - ms;
                if (ml > 0 && ml < sizeof mem) {
                    size_t q = pn;
                    memcpy(mem, inner + ms, ml);
                    mem[ml] = 0;
                    while (q < j && isspace((unsigned char)inner[q])) q++;
                    if (q < j && inner[q] == '=') {
                        ftr = find_iface_field(S, mem, &isptr, &isarr);
                        /* an interface *array* field has no single value to box */
                        if (ftr >= 0 && !isarr) vstart = q + 1;
                        else ftr = -1;
                    }
                }
            }

            if (ftr < 0) {
                buf_putn(out, inner + i, j - i);
            } else {
                size_t vs = vstart;
                while (vs < j && isspace((unsigned char)inner[vs])) vs++;
                buf_putn(out, inner + i, (vs > i) ? vs - i : 0);   /* ".name = " */
                if (isptr) self->box_to_iface_ptr(out, inner + vs, j - vs, ftr, 0);
                else self->box_to_iface(out, inner + vs, j - vs, ftr, 0);
            }
            if (j < it) buf_putc(out, ',');
            i = j + 1;
        }
    }

    /* "Greeter g;" / "Greeter g = p;" / "Greeter *g;" — an interface-value
       declaration. A bare one starts as a null fat pointer; an initialised one
       boxes its expression. */
    char *try_iface_decl(const char *line, int tr, size_t ws, const char *after) {
        struct SymTab *sym = self->sym;
        char var[MAX_NAME];
        size_t vk = 0;
        const char *p = after;
        const char *rest, *r;
        Buf b;
        int ptr = 0;

        while (*p == ' ' || *p == '\t') p++;
        if (*p == '*') {
            ptr = 1;
            p++;
            while (*p == ' ' || *p == '\t') p++;
        }
        vk = copy_ident(p, var, 0);
        var[vk] = 0;
        if (!vk) return NULL;
        rest = p + vk;
        r = rest;
        while (*r == ' ' || *r == '\t') r++;

        buf_init(&b);
        buf_putn(&b, line, ws);
        buf_puts(&b, "struct ");
        buf_puts(&b, sym->traits[tr].cname);
        buf_puts(&b, ptr ? "_iface *" : "_iface ");
        buf_puts(&b, var);

        if (*r == '[') {                                 /* an interface array */
            const char *d = r, *cl = NULL;
            int dep = 0;
            while (*d) {
                if (*d == '[') dep++;
                else if (*d == ']') { dep--; if (!dep) { cl = d; break; } }
                d++;
            }
            if (!cl) die(0, "unsupported declaration of interface type '%s'", sym->traits[tr].name);
            buf_putn(&b, r, (size_t)(cl - r) + 1);       /* "[<n>]" */
            if (self->decl_end_is_bare(cl + 1)) {
                /* a fat pointer is two words, so the braces have to be nested */
                buf_puts(&b, ptr ? " = { 0 }" : " = { { 0, 0 } }");
            }
            buf_puts(&b, cl + 1);

            {
                int vi = sym->new_var();
                snprintf(sym->vars[vi].name, MAX_NAME, "%s", var);
                sym->vars[vi].s = -1;
                sym->vars[vi].ptr = ptr;
                sym->vars[vi].arr = 1;
                sym->vars[vi].iface = 1;
                sym->vars[vi].tr = tr;
            }
            return b.p;
        }

        if (ptr) {                                       /* a pointer to an interface value */
            if (!*r || (*r == ';' && self->decl_end_is_bare(r))) {
                buf_puts(&b, rest);
            } else if (*r == '=') {
                const char *e = r + 1;
                size_t el = 0;
                while (*e == ' ' || *e == '\t') e++;
                if (*e == '{' || strncmp(e, "(struct ", 8) == 0)
                    die(0, "unsupported declaration of interface type '%s'", sym->traits[tr].name);
                while (e[el] && e[el] != ';') el++;
                buf_puts(&b, " = ");
                self->box_to_iface_ptr(&b, e, el, tr, 0);
                buf_puts(&b, e + el);
            } else {
                die(0, "unsupported declaration of interface type '%s'", sym->traits[tr].name);
            }
            {
                int vi = sym->new_var();
                snprintf(sym->vars[vi].name, MAX_NAME, "%s", var);
                sym->vars[vi].s = -1;
                sym->vars[vi].ptr = 1;
                sym->vars[vi].arr = 0;
                sym->vars[vi].iface = 1;
                sym->vars[vi].tr = tr;
            }
            return b.p;
        }

        if (!*r || (*r == ';' && self->decl_end_is_bare(r))) {
            buf_puts(&b, " = { 0, 0 }");
            buf_puts(&b, rest);
        } else if (*r == '=') {
            const char *e = r + 1;
            size_t el = 0;
            while (*e == ' ' || *e == '\t') e++;
            if (*e == '{') {
                buf_puts(&b, rest);                      /* user-provided aggregate initialiser */
            } else {
                while (e[el] && e[el] != ';') el++;
                buf_puts(&b, " = ");
                self->box_to_iface(&b, e, el, tr, 0);
                buf_puts(&b, e + el);
            }
        } else {
            die(0, "unsupported declaration of interface type '%s'", sym->traits[tr].name);
        }

        {
            int vi = sym->new_var();
            snprintf(sym->vars[vi].name, MAX_NAME, "%s", var);
            sym->vars[vi].s = -1;
            sym->vars[vi].ptr = 0;
            sym->vars[vi].arr = 0;
            sym->vars[vi].iface = 1;
            sym->vars[vi].tr = tr;
        }
        return b.p;
    }

    /* "return <object>;" inside a function whose return type is an interface
       value: the returned object is boxed the same way an assignment is. */
    char *try_return(const char *line) {
        const char *p = line, *e;
        size_t el = 0;
        Buf b;

        if (self->cur_rettr < 0) return NULL;
        while (*p == ' ' || *p == '\t') p++;
        if (strncmp(p, "return", 6) != 0 || is_ident_char((unsigned char)p[6])) return NULL;
        e = p + 6;
        while (*e == ' ' || *e == '\t') e++;
        if (!*e || *e == ';') return NULL;                       /* "return;" */
        if (*e == '{' || strncmp(e, "(struct ", 8) == 0) return NULL;
        while (e[el] && e[el] != ';') el++;
        if (!el) return NULL;

        buf_init(&b);
        buf_putn(&b, line, (size_t)(e - line));
        self->box_to_iface(&b, e, el, self->cur_rettr, 0);
        buf_puts(&b, e + el);
        return b.p;
    }

    /* "g = p;" — assigning into an interface value (the target type is the
       variable), or into an interface-value field ("s.l = p;", boxed through the
       field's trait). */
    char *try_iface_assign(const char *line) {
        struct SymTab *sym = self->sym;
        const char *p = line, *r;
        char id[MAX_NAME];
        size_t k = 0, el = 0, fend = 0;
        int vi, ftr = -1, ifptr = 0;
        Buf b;

        while (*p == ' ' || *p == '\t') p++;
        k = copy_ident(p, id, 0);
        id[k] = 0;
        if (!k) return NULL;
        vi = sym->find_var(id);
        if (vi < 0) return NULL;

        if (!sym->vars[vi].iface) {
            /* an assignment into an interface-value field. A pointer interface
               field (`struct T *l`) stores the address of a boxed fat pointer;
               a value field stores the fat pointer itself. */
            size_t fpos = (size_t)(p + k - line);
            int aptr = sym->vars[vi].ptr;
            if (sym->vars[vi].s < 0) return NULL;
            if (sym->vars[vi].arr) {          /* an element of an array of structs */
                size_t nl = strlen(line);
                size_t e2;
                if (fpos >= nl || line[fpos] != '[') return NULL;
                e2 = self->skip_bracket(line, nl, fpos);
                if (e2 == (size_t)-1) return NULL;
                fpos = e2;
            }
            if (!self->walk_to_iface_field(line, strlen(line), fpos,
                                           sym->vars[vi].s, aptr, &ftr, &fend, &ifptr))
                return NULL;
            r = line + fend;
        } else if ((sym->vars[vi].arr || sym->vars[vi].ptr) && *(p + k) == '[') {
            /* an element of an interface array or of an indexable interface
               pointer: `xs[i] = v;` (the element of `T *xs[n]` is itself a
               pointer, so a pointer array boxes with box_to_iface_ptr) */
            size_t e2 = self->skip_bracket(line, strlen(line), (size_t)(p + k - line));
            if (e2 == (size_t)-1) return NULL;
            ftr = sym->vars[vi].tr;
            ifptr = sym->vars[vi].arr && sym->vars[vi].ptr;
            r = line + e2;
        } else {
            ftr = sym->vars[vi].tr;
            /* a bare interface pointer holds the *address* of a fat pointer, so
               `q = &v;` / `q = v;` boxes through the pointer path */
            ifptr = sym->vars[vi].ptr;
            r = p + k;
        }

        while (*r == ' ' || *r == '\t') r++;
        if (*r != '=' || r[1] == '=') return NULL;
        r++;
        while (*r == ' ' || *r == '\t') r++;
        if (!*r || *r == '{' || strncmp(r, "(struct ", 8) == 0) return NULL;
        while (r[el] && r[el] != ';') el++;
        if (!el) return NULL;

        buf_init(&b);
        buf_putn(&b, line, (size_t)(r - line));
        if (ifptr) self->box_to_iface_ptr(&b, r, el, ftr, 0);
        else self->box_to_iface(&b, r, el, ftr, 0);
        buf_puts(&b, r + el);
        return b.p;
    }

    /* "delete p;" -> "if (p) free(p);" for a registered pointer object. Any
       pointer is accepted, so `delete buf;` on a char * frees it too; a
       registered *non*-pointer is left as-is -- that is user error. */
    char *try_delete(const char *line) {
        struct SymTab *sym = self->sym;
        const char *p = line;
        size_t ind_len;
        char id[MAX_NAME];
        size_t k = 0;
        int vi;
        Buf b;

        while (*p == ' ' || *p == '\t') p++;
        ind_len = (size_t)(p - line);
        if (strncmp(p, "delete", 6) != 0 || is_ident_char((unsigned char)p[6])) return NULL;
        p += 6;
        while (*p == ' ' || *p == '\t') p++;
        k = copy_ident(p, id, 0);
        id[k] = 0;
        if (!k || !self->decl_end_is_bare(p + k)) return NULL;

        vi = sym->find_var(id);
        if (vi >= 0 && !sym->vars[vi].ptr) return NULL;
        if (vi >= 0) {
            sym->vars[vi].owned = 0;      /* released: no longer a leak */
            sym->vars[vi].autodrop = 0;   /* and no scope-exit release either */
        }

        buf_init(&b);
        buf_putn(&b, line, ind_len);
        {
            Struct *S = (vi >= 0 && sym->vars[vi].ptr && sym->vars[vi].s >= 0)
                        ? &sym->structs[sym->vars[vi].s] : NULL;
            if (S && S->has_drop) {          /* a Drop type: run drop() then free */
                S->drop_used = 1;
                buf_puts(&b, "if (");
                buf_puts(&b, id);
                buf_puts(&b, ") { ");
                buf_puts(&b, S->cname);
                buf_puts(&b, "_Drop_drop(");
                buf_puts(&b, id);
                buf_puts(&b, "); free(");
                buf_puts(&b, id);
                buf_puts(&b, "); }");
                return b.p;
            }
        }
        buf_puts(&b, "if (");
        buf_puts(&b, id);
        buf_puts(&b, ") free(");
        buf_puts(&b, id);
        buf_puts(&b, ");");
        return b.p;
    }

    char *transform_line(const char *line) {
        char *del, *ret, *asg, *decl;
        const char *base;
        Buf out;
        char *res;
        int own_decl = 0;

        /* AutoDrop bookkeeping runs first: the flag must be cleared (reassign,
           escape, return) before the closing-brace/return injection reads it. */
        self->sym->autodrop_observe(line);
        self->sym->leak_check_return(line, self->nscope, self->in_body ? 0 : 1,
                                     (size_t)self->cur_line);
        self->autodrop_before(line);

        /* `own` is a contextual keyword: only a line-initial `own <name>` is a
           declaration. `own = 5;` stays an ordinary assignment. */
        {
            const char *q = line;
            while (*q == ' ' || *q == '\t') q++;
            if (strncmp(q, "own", 3) == 0 && !is_ident_char((unsigned char)q[3])) {
                q += 3;
                while (*q == ' ' || *q == '\t') q++;
                own_decl = is_ident_char((unsigned char)*q) ? 1 : 0;
            }
        }

        del = self->try_delete(line);
        if (del) return del;
        ret = self->try_return(line);
        if (ret) return ret;
        asg = self->try_iface_assign(line);
        if (asg) return asg;

        decl = self->try_var_decl(line);
        if (own_decl && !decl)
            die(self->line_off, "'own' must declare a struct pointer with Drop");
        base = decl ? decl : line;
        buf_init(&out);
        self->transform_calls(base, &out);
        free(decl);
        res = out.p;
        return res;
    }

    /* "<Struct> x = {...};" / "struct <Struct> x = {...};" -> add struct + vptr */
    char *try_var_decl(const char *line) {
        struct SymTab *sym = self->sym;
        size_t i = 0, ws, vk;
        const char *p;
        char cname[MAX_NAME * 2], name[MAX_NAME], var[MAX_NAME];
        Struct *S;
        int done = 0, static_kw = 0, qual = 0, own_kw = 0;
        const char *rest;
        Buf b;

        while (line[i] == ' ' || line[i] == '\t') i++;
        ws = i;
        p = line + i;

        /* `own` marks the declaration for AutoDrop; it is not valid C, so the
           rewritten line drops it. It must precede `static` in v1. */
        if (strncmp(p, "own", 3) == 0 && !is_ident_char((unsigned char)p[3])) {
            const char *z = p + 3;
            while (*z == ' ' || *z == '\t') z++;
            own_kw = 1;
            p = z;
        }

        /* a leading `static` is re-emitted verbatim; the declaration underneath is
           still a ct struct object and must get its vptr written like any other */
        if (strncmp(p, "static", 6) == 0 && !is_ident_char((unsigned char)p[6])) {
            const char *z = p + 6;
            while (*z == ' ' || *z == '\t') z++;
            static_kw = 1;
            p = z;
        }

        if (strncmp(p, "struct", 6) == 0 && !is_ident_char((unsigned char)p[6])) {
            p += 6;
            while (*p == ' ' || *p == '\t') p++;
        }

        p = self->read_qual_ref(p, cname, name, &qual);
        if (!p) return NULL;
        S = sym->find_struct(qual ? cname : name);
        if (!S) {
            /* the type names a trait, not a struct: an interface value */
            Trait *TR = sym->find_trait(qual ? cname : name);
            if (!TR) return NULL;
            if (own_kw) die(self->line_off, "'own' requires a struct pointer that uses Drop");
            return self->try_iface_decl(line, (int)(TR - sym->traits), ws, p);
        }
        while (*p == ' ' || *p == '\t') p++;

        if (*p == '*') {                              /* pointer declaration */
            const char *q = p;
            char pv[MAX_NAME];
            int pk = 0, isheap = 0, isarr = 0;
            while (*q == '*' || *q == ' ' || *q == '\t') q++;
            pk = copy_ident(q, pv, 0);
            pv[pk] = 0;
            {
                const char *eq = strchr(p, '=');
                const char *aft = q + pk;
                if (eq) {
                    const char *rhs = eq + 1;
                    while (*rhs == ' ' || *rhs == '\t') rhs++;
                    if ((strncmp(rhs, "malloc", 6) == 0 && !is_ident_char((unsigned char)rhs[6])) ||
                        (strncmp(rhs, "calloc", 6) == 0 && !is_ident_char((unsigned char)rhs[6])))
                        isheap = 1;
                }
                while (*aft == ' ' || *aft == '\t') aft++;
                if (*aft == '[') isarr = 1;
            }
            if (own_kw) {
                if (!self->in_body && self->nscope == 0)
                    die(self->line_off, "'own' is only allowed inside a function body");
                if (isarr) die(self->line_off, "'own' does not support arrays");
                if (!isheap) die(self->line_off, "'own' requires a malloc or calloc initialiser");
                if (!S->has_drop)
                    die(self->line_off, "struct '%s' does not use trait 'Drop'", S->name);
            }
            if (pk) {
                int vi = sym->new_var();
                snprintf(sym->vars[vi].name, MAX_NAME, "%s", pv);
                sym->vars[vi].s = (int)(S - sym->structs);
                sym->vars[vi].ptr = 1;
                /* `T *ps[<n>]` is an array of pointers: its elements are reached
                   with '->', unlike `T *p`, where p[i] is a value */
                sym->vars[vi].arr = isarr;
                sym->vars[vi].iface = 0;
                sym->vars[vi].tr = -1;
                if (isheap) {                  /* track the allocation for leak warnings */
                    sym->vars[vi].owned = 1;
                    sym->vars[vi].own_line = (size_t)self->cur_line;
                }
                if (own_kw) sym->vars[vi].autodrop = 1;
            }
            buf_init(&b);
            buf_putn(&b, line, ws);
            if (static_kw) buf_puts(&b, "static ");
            buf_puts(&b, "struct ");
            buf_puts(&b, S->cname);
            buf_putc(&b, ' ');
            buf_puts(&b, p);
            /* `T *x = malloc(..)` / calloc gets its vptrs written on the next
               line, so a heap object is usable without a hand-written vptr. The
               indentation is plain spaces and the last line keeps its newline,
               which leaves a blank line before the following statement. */
            if (isheap && (S->nu > 0 || needs_nested_init(sym->structs, S, 0))) {
                char ind[MAX_NAME];
                size_t t;
                for (t = 0; t < ws && t + 1 < sizeof ind; t++) ind[t] = ' ';
                ind[t] = 0;
                buf_putc(&b, '\n');
                self->put_heap_vpts(&b, S, pv, ind);
            }
            return b.p;
        }

        if (own_kw) die(self->line_off, "'own' requires a pointer declaration");

        vk = copy_ident(p, var, 0);
        var[vk] = 0;
        if (!vk) return NULL;

        rest = p + vk;

        /* array declaration: "Person ps[2];" -- vptrs are written per element */
        {
            const char *q = rest;
            int needs;
            while (*q == ' ' || *q == '\t') q++;
            if (*q == '[') {
                const char *d = q + 1, *cl;
                Buf ib;
                int atfile;
                size_t k2, dl;

                needs = (S->nu > 0 || needs_nested_init(sym->structs, S, 0));
                while (*d >= '0' && *d <= '9') d++;
                cl = d;
                if (needs && (cl == q + 1 || *cl != ']' || !self->decl_end_is_bare(cl + 1)))
                    die(0, "struct '%s': only 'Type name[<n>];' arrays are supported", S->name);
                /* at file scope the per-element writes cannot be statements, so
                   they go into the per-unit constructor instead */
                atfile = (needs && self->nscope == 0);

                buf_init(&ib);
                buf_putn(&ib, line, ws);
                if (static_kw) buf_puts(&ib, "static ");
                buf_puts(&ib, "struct ");
                buf_puts(&ib, S->cname);
                buf_putc(&ib, ' ');
                buf_puts(&ib, var);
                buf_puts(&ib, q);

                if (needs) {
                    Buf *tgt = atfile ? &self->unit_init : &ib;
                    char ind[MAX_NAME], ind2[MAX_NAME], cnt[64], recv[MAX_NAME + 16];
                    int vi = sym->new_var();

                    snprintf(sym->vars[vi].name, MAX_NAME, "%s", var);
                    sym->vars[vi].s = (int)(S - sym->structs);
                    sym->vars[vi].ptr = 0;
                    sym->vars[vi].arr = 1;
                    sym->vars[vi].iface = 0;
                    sym->vars[vi].tr = -1;

                    if (atfile) {
                        self->has_unit_init = 1;
                        snprintf(ind, sizeof ind, "    ");
                    } else {
                        buf_putc(&ib, '\n');
                        for (k2 = 0; k2 < ws && k2 < sizeof ind - 1; k2++) ind[k2] = line[k2];
                        ind[k2] = 0;
                    }

                    dl = (size_t)(cl - q - 1);
                    if (dl >= sizeof cnt) dl = sizeof cnt - 1;
                    memcpy(cnt, q + 1, dl);
                    cnt[dl] = 0;
                    snprintf(ind2, sizeof ind2, "%s        ", ind);
                    snprintf(recv, sizeof recv, "%s[__ct_i]", var);

                    buf_puts(tgt, ind);
                    buf_puts(tgt, "{\n");
                    buf_puts(tgt, ind);
                    buf_puts(tgt, "    for (unsigned long __ct_i = 0; __ct_i < ");
                    buf_puts(tgt, cnt);
                    buf_puts(tgt, "; __ct_i++) {\n");
                    self->put_nested_assignments(tgt, S, recv, ind2, 1, 0);
                    buf_puts(tgt, ind);
                    buf_puts(tgt, "    }\n");
                    buf_puts(tgt, ind);
                    buf_puts(tgt, "}\n");
                    if (!atfile && ib.n > 0 && ib.p[ib.n - 1] == '\n') {
                        ib.n--;
                        ib.p[ib.n] = 0;
                    }
                }
                return ib.p;
            }
        }
        {
            int vi = sym->new_var();
            snprintf(sym->vars[vi].name, MAX_NAME, "%s", var);
            sym->vars[vi].s = (int)(S - sym->structs);
            sym->vars[vi].ptr = 0;
            sym->vars[vi].arr = 0;
            sym->vars[vi].iface = 0;
            sym->vars[vi].tr = -1;
        }

        buf_init(&b);
        buf_putn(&b, line, ws);
        if (static_kw) buf_puts(&b, "static ");
        buf_puts(&b, "struct ");
        buf_puts(&b, S->cname);
        buf_putc(&b, ' ');
        buf_puts(&b, var);

        {
            const char *r = rest;
            while (*r == ' ' || *r == '\t') r++;
            if (*r == '=' && S->nu > 0) {
                const char *e = r + 1;
                while (*e == ' ' || *e == '\t') e++;
                if (*e == '{') {
                    int depth = 0;
                    const char *close = NULL;
                    size_t ln = strlen(e);
                    size_t z;
                    for (z = 0; z < ln; z++) {
                        char cc = e[z];
                        if (cc == '"' || cc == '\'') { z = line_literal_end(e, z, ln) - 1; continue; }
                        if (cc == '{') depth++;
                        else if (cc == '}') { depth--; if (!depth) { close = e + z; break; } }
                    }
                    if (close) {
                        char *inner = xstrndup(e + 1, (size_t)(close - e - 1));
                        size_t it = trim_right_len(inner, strlen(inner));
                        int first = 1;
                        buf_putn(&b, rest, (size_t)(e - rest) + 1);        /* " = {" */
                        self->box_agg_fields(&b, S, inner, it);
                        if (it) buf_puts(&b, ", ");
                        else buf_putc(&b, ' ');
                        self->put_own_vptr(&b, S, &first);
                        buf_putc(&b, ' ');
                        buf_puts(&b, close);
                        free(inner);
                        done = 1;
                    } else {
                        die(0, "multi-line initialisers are not supported");
                    }
                }
                /* a non-brace initialiser ("Person a = make(\"A\");") keeps its
                   expression verbatim; the vptrs are written as statements on the
                   next line, so it falls through with `done` still 0 */
            } else if (S->nu > 0 && self->decl_end_is_bare(r)) {
                /* "Person p;" has no initialiser, so give it a designated one */
                int first = 1;
                buf_puts(&b, " = { ");
                self->put_own_vptr(&b, S, &first);
                buf_puts(&b, " }");
                buf_puts(&b, rest);
                done = 1;
            }
            if (!done) buf_puts(&b, rest);
        }

        if (needs_nested_init(sym->structs, S, 0) || (!done && S->nu > 0)) {
            /* the vptr writes are statements: inside a function they follow the
               declaration, indented like it; at file scope there are no statements
               at all, so they go into the per-unit constructor instead */
            int atfile = (self->nscope == 0);
            Buf *tgt = atfile ? &self->unit_init : &b;
            char ind[MAX_NAME];
            size_t k;

            if (atfile) {
                self->has_unit_init = 1;
                snprintf(ind, sizeof ind, "    ");
            } else {
                for (k = 0; k < ws && k < sizeof ind - 1; k++) ind[k] = line[k];
                ind[k] = 0;
                buf_putc(&b, '\n');
            }
            self->put_nested_assignments(tgt, S, var, ind, !done, 0);
            if (!atfile && b.n > 0 && b.p[b.n - 1] == '\n') {
                b.n--;
                b.p[b.n] = 0;
            }
        }

        return b.p;
    }

    void transform_calls(const char *s, Buf *out) {
        struct SymTab *sym = self->sym;
        size_t i = 0, n = strlen(s);
        while (i < n) {
            char c = s[i];

            if (c == '"' || c == '\'') {
                size_t j = line_literal_end(s, i, n);
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (c == '/' && i + 1 < n && s[i + 1] == '/') {
                buf_putn(out, s + i, n - i);
                break;
            }
            if (c == '/' && i + 1 < n && s[i + 1] == '*') {
                size_t j = i + 2;
                while (j + 1 < n && !(s[j] == '*' && s[j + 1] == '/')) j++;
                j = (j + 1 < n) ? j + 2 : n;
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            if (is_ident_char((unsigned char)c) && !isdigit((unsigned char)c)) {
                size_t j = i;
                char tok[MAX_NAME];
                size_t tl;
                int vi;

                while (j < n && is_ident_char((unsigned char)s[j])) j++;
                tl = j - i;
                if (tl >= sizeof tok) tl = sizeof tok - 1;
                memcpy(tok, s + i, tl);
                tok[tl] = 0;

                /* namespace path `A::B::name`: a call drops the path (functions
                   are not mangled), anything else becomes the C name
                   `A_B_name`. Like the block-comment scan, this runs on every
                   line -- including a comment's continuation line. */
                if (j + 1 < n && s[j] == ':' && s[j + 1] == ':') {
                    size_t z = j, finalstart = i, chainend = j;
                    int ok = 0;
                    while (z + 1 < n && s[z] == ':' && s[z + 1] == ':') {
                        size_t w = z + 2;
                        while (w < n && isspace((unsigned char)s[w])) w++;
                        if (!(w < n && is_ident_char((unsigned char)s[w]) &&
                              !isdigit((unsigned char)s[w]))) break;
                        finalstart = w;
                        while (w < n && is_ident_char((unsigned char)s[w])) w++;
                        chainend = w;
                        ok = 1;
                        z = w;
                        while (z < n && isspace((unsigned char)s[z])) z++;
                    }
                    if (ok) {
                        if (chainend < n && s[chainend] == '(') {
                            i = finalstart;
                        } else {
                            char mc[MAX_NAME * 2];
                            size_t w2 = i, k2 = 0;
                            while (w2 < chainend) {
                                char cc = s[w2];
                                if (cc == ':') {
                                    if (k2 + 1 < sizeof mc) mc[k2++] = '_';
                                    w2++;
                                    if (w2 < chainend && s[w2] == ':') w2++;
                                } else if (isspace((unsigned char)cc)) {
                                    w2++;
                                } else {
                                    if (k2 + 1 < sizeof mc) mc[k2++] = cc;
                                    w2++;
                                }
                            }
                            mc[k2] = 0;
                            buf_puts(out, mc);
                            i = chainend;
                        }
                        continue;
                    }
                }

                vi = sym->find_var(tok);

                /* interface dispatch: g.m(args) -> g.vt->m(g.self, args). The
                   method must belong to the trait the value was boxed as. A
                   subscripted receiver takes the element's own vt and the hop
                   follows the element kind (a value unless the element is itself
                   a pointer, i.e. `T *xs[n]`):
                     xs[i].m() -> xs[i].vt->m(xs[i].self)
                     q->m()    -> q->vt->m(q->self) */
                if (vi >= 0 && sym->vars[vi].iface) {
                    size_t rend = j, k = j, rlen;
                    int elptr = 0;
                    if ((sym->vars[vi].arr || sym->vars[vi].ptr) && j < n && s[j] == '[') {
                        size_t e2 = self->skip_bracket(s, n, j);
                        if (e2 == (size_t)-1) k = n;    /* unclosed: leave the line alone */
                        else {
                            rend = e2;                  /* the receiver is `xs[i]` */
                            elptr = sym->vars[vi].arr && sym->vars[vi].ptr;
                            k = e2;
                        }
                    } else if (sym->vars[vi].ptr) {
                        elptr = 1;                      /* no subscript: the receiver is the pointer */
                    }
                    if (k < n) {
                        if (elptr) {
                            if (k + 1 < n && s[k] == '-' && s[k + 1] == '>') k += 2;
                            else k = n;
                        } else if (s[k] == '.') {
                            k += 1;
                        } else {
                            k = n;
                        }
                    }
                    if (k < n) {
                        size_t ms = k, ml;
                        char mem[MAX_NAME];
                        while (k < n && is_ident_char((unsigned char)s[k])) k++;
                        ml = k - ms;
                        if (ml >= sizeof mem) ml = sizeof mem - 1;
                        memcpy(mem, s + ms, ml);
                        mem[ml] = 0;
                        if (ml && k < n && s[k] == '(' &&
                            sym->trait_has_method(sym->vars[vi].tr, mem)) {
                            size_t z = k + 1;
                            int empty;
                            while (z < n && isspace((unsigned char)s[z])) z++;
                            empty = (z < n && s[z] == ')');
                            rlen = rend - i;
                            buf_putn(out, s + i, rlen);
                            buf_puts(out, elptr ? "->vt->" : ".vt->");
                            buf_puts(out, mem);
                            buf_putc(out, '(');
                            buf_putn(out, s + i, rlen);
                            buf_puts(out, elptr ? "->self" : ".self");
                            if (!empty) buf_puts(out, ", ");
                            i = k + 1;
                            continue;
                        }
                    }
                }

                /* an rvalue receiver: `f().m()` / `f()->m()` / `f().a.b.m()` where
                   f returns a known struct. Its receiver is hoisted into a temp so
                   it is evaluated once and in order; only a statement head or an
                   initialiser allows that without reordering evaluation, so any
                   other position is a hard error. */
                if (vi < 0 && j < n && s[j] == '(') {
                    FuncSig *FS = sym->find_func(tok);
                    if (FS && FS->retstruct >= 0) {
                        size_t cp = line_match_paren(s, j, n);
                        if (cp != (size_t)-1) {
                            char mem[MAX_NAME];
                            const char *tr = NULL;
                            int cur = FS->retstruct, need_amp = 0;
                            size_t rend = 0, mp = 0;
                            if (self->walk_method(s, n, cp + 1, cur, FS->retptr, &cur, &need_amp,
                                                  &tr, &rend, &mp, mem)) {
        struct SymTab *sym = self->sym;
                                size_t fs = 0, eq, saved_off;
                                char tmp[MAX_NAME], low[MAX_NAME], *recv;
                                Buf ini;

                                while (fs < n && (s[fs] == ' ' || s[fs] == '\t')) fs++;
                                eq = line_assign_eq(s);
                                if (i != fs) {
                                    int ok = 0;
                                    if (eq != (size_t)-1) {
                                        size_t rs = eq + 1;
                                        while (rs < n && (s[rs] == ' ' || s[rs] == '\t')) rs++;
                                        if (i == rs) ok = 1;
                                    }
                                    if (!ok)
                                        die(self->line_off + i, "an rvalue receiver must start the statement or an initialiser");
                                }

                                snprintf(tmp, sizeof tmp, "__ct_tmp%d", self->ntmp++);
                                /* the initialiser is the receiver text, itself run
                                   through the rewriter so nested calls are handled */
                                recv = xstrndup(s + i, rend - i);
                                buf_init(&ini);
                                saved_off = self->line_off;
                                self->line_off += i;
                                self->transform_calls(recv, &ini);
                                self->line_off = saved_off;
                                free(recv);

                                buf_putn(&self->hoist, s, fs);    /* keep the line's indent */
                                buf_puts(&self->hoist, "struct ");
                                buf_puts(&self->hoist, sym->structs[cur].cname);
                                buf_puts(&self->hoist, need_amp ? " " : " *");
                                buf_puts(&self->hoist, tmp);
                                buf_puts(&self->hoist, " = ");
                                buf_puts(&self->hoist, ini.p);
                                buf_putc(&self->hoist, ';');
                                free(ini.p);

                                to_lower(tr, low);
                                buf_puts(out, tmp);
                                buf_puts(out, need_amp ? ".__" : "->__");
                                buf_puts(out, low);
                                buf_puts(out, "_vptr->");
                                buf_puts(out, mem);
                                buf_putc(out, '(');
                                if (need_amp) buf_putc(out, '&');
                                buf_puts(out, tmp);
                                {
                                    size_t z = mp + 1;
                                    int empty;
                                    while (z < n && isspace((unsigned char)s[z])) z++;
                                    empty = (z < n && s[z] == ')');
                                    if (!empty) buf_puts(out, ", ");
                                }
                                i = mp + 1;
                                continue;
                            }
                        }
                    }
                }

                /* a call to a function that takes interface values: box the
                   arguments whose parameter is one */
                if (vi < 0 && j < n && s[j] == '(') {
                    FuncSig *FS = sym->find_func(tok);
                    size_t cp = (size_t)-1;
                    int any = 0, q;
                    if (FS) {
                        for (q = 0; q < FS->nparams; q++)
                            if (FS->ptrait[q] >= 0) {
                                any = 1;
                                break;
                            }
                        if (any) cp = line_match_paren(s, j, n);
                    }
                    if (any && cp != (size_t)-1) {
                        Buf ab;
                        size_t a = j + 1, pi = 0;
                        buf_init(&ab);
                        while (a <= cp) {
                            size_t bb = a;
                            int dep = 0, tr;
                            while (bb < cp) {
                                char cc = s[bb];
                                if (cc == '"' || cc == '\'') {
                                    bb = line_literal_end(s, bb, cp);
                                    continue;
                                }
                                if (cc == '(' || cc == '[' || cc == '{') dep++;
                                else if (cc == ')' || cc == ']' || cc == '}') dep--;
                                else if (cc == ',' && dep == 0) break;
                                bb++;
                            }
                            tr = (pi < (size_t)FS->nparams) ? FS->ptrait[pi] : -1;
                            if (tr >= 0 && bb > a) self->box_to_iface(&ab, s + a, bb - a, tr, 0);
                            else buf_putn(&ab, s + a, bb - a);
                            pi++;
                            if (bb < cp) {
                                buf_putc(&ab, ',');
                                a = bb + 1;
                            } else break;
                        }
                        buf_puts(out, tok);
                        buf_putc(out, '(');
                        buf_puts(out, ab.p);
                        buf_putc(out, ')');
                        free(ab.p);
                        i = cp + 1;
                        continue;
                    }
                }

                if (vi >= 0) {
                    char mem[MAX_NAME], low[MAX_NAME];
                    const char *tr = NULL;
                    size_t pos = j, rend = 0, mp = 0;
                    int cur = sym->vars[vi].s;
                    int need_amp = 1, hit = 0, unclosed = 0;
                    int isptr = sym->vars[vi].ptr;

                    if ((sym->vars[vi].arr || sym->vars[vi].ptr) && pos < n && s[pos] == '[') {
                        /* the receiver is an element: consume "[<expr>]", whose
                           expression may be anything (balanced brackets, skipping
                           literals) -- e.g. ps[i], ps[i + 1], ps[f()] */
                        int d = 0;
                        size_t k = pos;
                        while (k < n) {
                            char e = s[k];
                            if (e == '"' || e == '\'') {
                                k = line_literal_end(s, k, n);
                                continue;
                            }
                            if (e == '[') d++;
                            else if (e == ']') {
                                d--;
                                if (d == 0) {
                                    k++;
                                    break;
                                }
                            }
                            k++;
                        }
                        if (d != 0) unclosed = 1;
                        else {
                            pos = k;
                            /* an element of `T *ps[n]` is itself a pointer (uses '->'),
                               while `p[i]` on a plain `T *p` is a value */
                            isptr = sym->vars[vi].arr && sym->vars[vi].ptr;
                        }
                    }
                    if (!unclosed)
                        hit = self->walk_method(s, n, pos, cur, isptr, &cur, &need_amp,
                                                &tr, &rend, &mp, mem);
                    if (hit) {
                        size_t z = mp + 1;
                        int empty;
                        while (z < n && isspace((unsigned char)s[z])) z++;
                        empty = (z < n && s[z] == ')');

                        to_lower(tr, low);
                        buf_putn(out, s + i, rend - i);           /* receiver */
                        buf_puts(out, need_amp ? ".__" : "->__");
                        buf_puts(out, low);
                        buf_puts(out, "_vptr->");
                        buf_puts(out, mem);
                        buf_putc(out, '(');
                        if (need_amp) buf_putc(out, '&');
                        buf_putn(out, s + i, rend - i);           /* receiver again */
                        if (!empty) buf_puts(out, ", ");
                        i = mp + 1;
                        continue;
                    }

                    /* an interface field as the receiver: `s.l.m()` ->
                       `s.l.vt->m(s.l.self)` (or `->` when the field is a pointer) */
                    if (!unclosed && cur >= 0) {
                        char meth[MAX_NAME];
                        int ftr = -1, ifptr = 0, ok = 0;
                        size_t fend = 0, k2 = 0;
                        if (self->walk_to_iface_field(s, n, pos, cur, isptr, &ftr, &fend, &ifptr)) {
        struct SymTab *sym = self->sym;
                            if (ifptr) {
                                if (fend + 1 < n && s[fend] == '-' && s[fend + 1] == '>') k2 = fend + 2;
                            } else {
                                if (fend < n && s[fend] == '.') k2 = fend + 1;
                            }
                            if (k2) {
                                size_t ms2 = k2, ml2;
                                while (k2 < n && is_ident_char((unsigned char)s[k2])) k2++;
                                ml2 = k2 - ms2;
                                if (ml2 > 0 && ml2 < MAX_NAME) {
                                    memcpy(meth, s + ms2, ml2);
                                    meth[ml2] = 0;
                                    if (k2 < n && s[k2] == '(' && sym->trait_has_method(ftr, meth))
                                        ok = 1;
                                }
                            }
                        }
                        if (ok) {
                            size_t z = k2 + 1;
                            int empty;
                            while (z < n && isspace((unsigned char)s[z])) z++;
                            empty = (z < n && s[z] == ')');
                            buf_putn(out, s + i, fend - i);       /* receiver incl. field */
                            buf_puts(out, ifptr ? "->vt->" : ".vt->");
                            buf_puts(out, meth);
                            buf_putc(out, '(');
                            buf_putn(out, s + i, fend - i);
                            buf_puts(out, ifptr ? "->self" : ".self");
                            if (!empty) buf_puts(out, ", ");
                            i = k2 + 1;
                            continue;
                        }
                    }
                }
                buf_putn(out, s + i, j - i);
                i = j;
                continue;
            }
            buf_putc(out, c);
            i++;
        }
    }

    /* Walk `.field` / `->field` hops from the receiver of struct `cur` (a pointer
       when `isptr`) until a trait method call is reached, and report the trait it
       names, the struct the *final* receiver is (*out_cur -- the writeback the
       rvalue-receiver hoist needs), where the receiver text ends (*out_rend) and
       where the argument list starts (*mp). `isptr` flips as the walk crosses
       pointer fields, so the hook picks `&recv` or `recv`. */
    int walk_method(const char *s, size_t n, size_t pos, int cur, int isptr,
                    int *out_cur, int *out_need_amp, const char **out_tr, size_t *out_rend,
                    size_t *mp, char *memb) {
        struct SymTab *sym = self->sym;
        char mem[MAX_NAME];

        (void)self;  /* the body only consults the symbol table for the method */
        for (;;) {
            size_t ms, k, ml;
            int fi;

            if (isptr) {
                if (!(pos + 1 < n && s[pos] == '-' && s[pos + 1] == '>')) return 0;
                k = pos + 2;
            } else {
                if (!(pos < n && s[pos] == '.')) return 0;
                k = pos + 1;
            }
            ms = k;
            while (k < n && is_ident_char((unsigned char)s[k])) k++;
            ml = k - ms;
            if (ml == 0) return 0;
            if (ml >= sizeof mem) ml = sizeof mem - 1;
            memcpy(mem, s + ms, ml);
            mem[ml] = 0;

            *out_tr = sym->resolve_method(&sym->structs[cur], mem);
            if (*out_tr && k < n && s[k] == '(') {
                *out_cur = cur;
                *out_need_amp = !isptr;
                *out_rend = pos;
                *mp = k;
                snprintf(memb, MAX_NAME, "%s", mem);
                return 1;
            }
            *out_tr = NULL;
            fi = find_field_ex(&sym->structs[cur], mem, &isptr);
            if (fi < 0) return 0;
            cur = fi;
            pos = k;
        }
    }

    /* Given `pos` at the '[' of an array subscript, return the index just past
       its matching ']' (literals skipped), or (size_t)-1 when it is unclosed.
       The receiver walks below all need the same "how far does this subscript
       run" answer, so it lives here rather than in each of them. */
    size_t skip_bracket(const char *s, size_t n, size_t pos) {
        int d = 0;
        size_t k = pos;
        (void)self;  /* a pure source-shape predicate; the receiver is not used */
        while (k < n) {
            char e = s[k];
            if (e == '"' || e == '\'') { k = line_literal_end(s, k, n); continue; }
            if (e == '[') d++;
            else if (e == ']') { d--; if (d == 0) return k + 1; }
            k++;
        }
        return (size_t)-1;
    }

    /* Walk `.field` / `->field` hops from the object of struct `cur` (a pointer
       when `isptr`), crossing struct-typed fields, until an interface-value field
       is reached. On success returns 1 and fills *out_tr (the field's trait),
       *out_end (where the receiver text ends, i.e. after the field name -- and
       after the `[<expr>]` when the field is an interface array) and *out_ifptr
       (the field is a `struct T *` pointer, so the hop uses '->'). */
    int walk_to_iface_field(const char *s, size_t n, size_t pos, int cur,
                            int isptr, int *out_tr, size_t *out_end, int *out_ifptr) {
        struct SymTab *sym = self->sym;
        (void)self;  /* the body only consults the symbol table for the field */
        for (;;) {
            size_t ms, k, ml;
            int tr, ifptr = 0, ifarr = 0, fi;
            char mem[MAX_NAME];

            if (isptr) {
                if (!(pos + 1 < n && s[pos] == '-' && s[pos + 1] == '>')) return 0;
                k = pos + 2;
            } else {
                if (!(pos < n && s[pos] == '.')) return 0;
                k = pos + 1;
            }
            ms = k;
            while (k < n && is_ident_char((unsigned char)s[k])) k++;
            ml = k - ms;
            if (ml == 0) return 0;
            if (ml >= sizeof mem) ml = sizeof mem - 1;
            memcpy(mem, s + ms, ml);
            mem[ml] = 0;

            tr = find_iface_field(&sym->structs[cur], mem, &ifptr, &ifarr);
            if (tr >= 0) {
                if (ifarr || (ifptr && k < n && s[k] == '[')) {
                    /* subscripted: consume "[<expr>]" so the receiver text (and the
                       dispatch) covers `x.f[i]`, not just `x.f`. The element is a
                       value unless the field is an array of pointers (`T *f[n]`). */
                    size_t k2 = self->skip_bracket(s, n, k);
                    if (k2 == (size_t)-1) return 0;
                    k = k2;
                    ifptr = (ifarr && ifptr) ? 1 : 0;
                }
                *out_tr = tr;
                *out_end = k;
                *out_ifptr = ifptr;
                return 1;
            }
            fi = find_field_ex(&sym->structs[cur], mem, &isptr);
            if (fi < 0) return 0;
            cur = fi;
            pos = k;
        }
    }

    /* is the tail of a declaration nothing but ';' (optionally a trailing comment)? */
    int decl_end_is_bare(const char *s) {
        (void)self;  /* a pure string test; the receiver is not used */
        while (*s == ' ' || *s == '\t') s++;
        if (*s != ';') return 0;
        s++;
        for (;;) {
            while (*s == ' ' || *s == '\t') s++;
            if (!*s) return 1;
            if (s[0] == '/' && s[1] == '/') return 1;
            if (s[0] == '/' && s[1] == '*') {
                const char *e = strstr(s + 2, "*/");
                if (!e) return 1;
                s = e + 2;
                continue;
            }
            return 0;
        }
    }

    /* Does [bstart, bstart+blen) mention `self` as a word? A user drop body need
       not use it, and an unused self would warn under -Wall -Wextra. */
    int body_uses_self(size_t bstart, size_t blen) {
        size_t i = bstart, end = bstart + blen;
        (void)self;  /* a pure source test; the receiver is not used */
        while (i < end) {
            if (g_src[i] == '"' || g_src[i] == '\'') { i = skip_literal(i); continue; }
            if (g_src[i] == '/' && i + 1 < end && (g_src[i + 1] == '/' || g_src[i + 1] == '*')) {
                i = skip_comment(i);
                continue;
            }
            if (is_ident_char((unsigned char)g_src[i]) && !isdigit((unsigned char)g_src[i])) {
                size_t j = i;
                while (j < end && is_ident_char((unsigned char)g_src[j])) j++;
                if (j - i == 4 && memcmp(g_src + i, "self", 4) == 0) return 1;
                i = j;
                continue;
            }
            i++;
        }
        return 0;
    }

    /* Append the release statement of every `own` variable in [from,to), in
       reverse declaration order (the last object declared is released first).
       Each statement nulls the pointer, so a second injection on another path is
       a guarded no-op instead of a double free. */
    void emit_drops(Buf *b, const char *ind, size_t indlen, int from, int to) {
        struct SymTab *sym = self->sym;
        int i, any = 0;

        for (i = to - 1; i >= from; i--) {
            Var *v = &sym->vars[i];
            Struct *S;
            if (!v->autodrop) continue;
            S = &sym->structs[v->s];
            S->drop_used = 1;              /* emit this type's Drop function */
            if (any) buf_putc(b, '\n');
            buf_putn(b, ind, indlen);
            buf_puts(b, "if (");
            buf_puts(b, v->name);
            buf_puts(b, ") { ");
            buf_puts(b, S->cname);
            buf_puts(b, "_Drop_drop(");
            buf_puts(b, v->name);
            buf_puts(b, "); free(");
            buf_puts(b, v->name);
            buf_puts(b, "); ");
            buf_puts(b, v->name);
            buf_puts(b, " = 0; }");
            any = 1;
        }
    }

    /* Queue the `own` releases that belong before this line, into the per-line
       hoist buffer (emitted ahead of the line, with `#line` re-anchored). A
       line-initial `}` ends the innermost scope, a line-initial `return` ends the
       whole frame. Any other brace/return would have to be split out of a
       conditional expression, which this line-oriented injector cannot place
       safely -- that is reported instead of guessed. */
    void autodrop_before(const char *line) {
        struct SymTab *sym = self->sym;
        const char *p = line;
        size_t ind, q;
        int has_own = 0, i;

        for (i = 0; i < sym->nvars; i++)
            if (sym->vars[i].autodrop) { has_own = 1; break; }
        if (!has_own) return;

        while (*p == ' ' || *p == '\t') p++;
        ind = (size_t)(p - line);

        if (*p == '}') {
            if (self->nscope > 0)
                self->emit_drops(&self->hoist, line, ind,
                                 self->scope[self->nscope - 1], sym->nvars);
            return;
        }
        if (strncmp(p, "return", 6) == 0 && !is_ident_char((unsigned char)p[6])) {
            self->emit_drops(&self->hoist, line, ind, 0, sym->nvars);
            /* a return at the frame's own level ends every scope: clearing the
               flags keeps the later brace from emitting unreachable duplicates.
               A return nested in a block is conditional, so those objects must
               stay owned for the path that falls through. */
            if (self->nscope == (self->in_body ? 0 : 1))
                for (i = 0; i < sym->nvars; i++) sym->vars[i].autodrop = 0;
            return;
        }

        /* A brace that closes a scope opened on an earlier line, or a conditional
           return, cannot be prefixed with the release. */
        {
            int depth = 0;
            for (q = 0; line[q]; q++) {
                if (line[q] == '"' || line[q] == '\'') {
                    char quote = line[q++];
                    while (line[q] && line[q] != quote) {
                        if (line[q] == '\\' && line[q + 1]) q++;
                        q++;
                    }
                    if (line[q]) q++;
                    continue;
                }
                if (line[q] == '/' && line[q + 1] == '/') break;
                if (line[q] == '/' && line[q + 1] == '*') {
                    q += 2;
                    while (line[q] && !(line[q] == '*' && line[q + 1] == '/')) q++;
                    if (line[q]) q++;
                    continue;
                }
                if (line[q] == '{') { depth++; continue; }
                if (line[q] == '}') {
                    /* a `}` with a `{` earlier on the same line closes an inner
                       same-line block: no `own` variable can live there */
                    if (depth > 0) { depth--; continue; }
                    die(self->line_off, "auto-drop requires the closing '}' at the start of a line");
                }
                if (line[q] == 'r' && strncmp(line + q, "return", 6) == 0 &&
                    !is_ident_char((unsigned char)line[q + 6]) &&
                    (q == 0 || !is_ident_char((unsigned char)line[q - 1])))
                    die(self->line_off, "auto-drop requires 'return' at the start of a line");
            }
        }
    }

    /* roll sym->nvars back at every closing brace so locals stay in their own scope;
       string and comment contents are ignored */
    void scope_track(size_t ls, size_t le) {
        struct SymTab *sym = self->sym;
        size_t p = ls;
        (void)self;  /* the body tracks the symbol table, not the receiver */
        while (p < le) {
            char c = g_src[p];
            if (c == '"' || c == '\'') {
                size_t j = skip_literal(p);
                p = (j > le) ? le : j;
                continue;
            }
            if (c == '/' && p + 1 < le &&
                (g_src[p + 1] == '/' || g_src[p + 1] == '*')) {
                size_t j = skip_comment(p);
                p = (j > le) ? le : j;
                continue;
            }
            if (c == '{') {
                int save = sym->nvars;
                if (self->body_abs && p == self->body_abs) { save = self->body_pre; self->body_abs = 0; }
                if (self->nscope >= MAX_SCOPE) die(p, "too many nested scopes (max %d)", MAX_SCOPE);
                self->scope[self->nscope++] = save;
            } else if (c == '}') {
                if (self->nscope > 0) {
                    int base = self->scope[self->nscope - 1];
                    /* a still-owned heap object whose scope ends here is unreachable */
                    sym->leak_check_scope(base, sym->nvars);
                    sym->nvars = self->scope[--self->nscope];
                }
            }
            p++;
        }
    }

    /* Ordinary function definition or prototype: qualify the struct types in its
       return type and parameters, record the signature, and register the parameters
       when a body follows. Returns a new line, or NULL when `line` is not one. */
    char *parse_func_sig(const char *line, size_t ls, int *has_body, size_t *body_abs) {
        struct SymTab *sym = self->sym;
        size_t n = strlen(line), lpo, he, ns, rt, rp, i, end;
        const char *lp;
        char name[MAX_NAME], tok[MAX_NAME];
        Buf b;
        int isdef = 0, ret_tr = -1, ret_ia = -1, ret_ib = -1, ret_ns = 0;
        int ret_struct = -1, ret_rptr = 0;
        int npar = 0, ptrait[MAX_PARAMS];
        char ret_cbase[MAX_NAME];
        (void)self;  /* the body records signatures in the symbol table, not the receiver */

        *has_body = 0;
        *body_abs = 0;

        lp = strchr(line, '(');
        if (!lp) return NULL;
        lpo = (size_t)(lp - line);
        {
            const char *sc = strchr(line, ';');
            if (sc && (size_t)(sc - line) < lpo) return NULL;      /* ';' before '(' */
        }

        he = trim_right_len(line, lpo);
        ns = he;
        while (ns > 0 && is_ident_char((unsigned char)line[ns - 1])) ns--;
        if (ns == he) return NULL;                                 /* no function name */
        rt = trim_right_len(line, ns);
        if (rt == 0) return NULL;                                  /* no return type */

        {
            size_t k, u;
            for (k = 0; k < rt; k++) {
                char c = line[k];
                if (!(is_ident_char((unsigned char)c) || c == '*' || c == ' ' || c == '\t'))
                    return NULL;
            }
            snprintf(name, sizeof name, "%.*s", (int)(he - ns), line + ns);
            if (is_stmt_keyword(name)) return NULL;
            for (k = 0; k < rt; ) {
                u = k;
                while (u < rt && !is_ident_char((unsigned char)line[u])) u++;
                k = u;
                while (k < rt && is_ident_char((unsigned char)line[k])) k++;
                if (k > u) {
                    size_t tl = k - u;
                    if (tl >= sizeof tok) tl = sizeof tok - 1;
                    memcpy(tok, line + u, tl);
                    tok[tl] = 0;
                    if (is_stmt_keyword(tok)) return NULL;
                }
            }
        }

        rp = line_match_paren(line, lpo, n);
        if (rp == (size_t)-1) return NULL;                         /* ')' on another line */

        {
            size_t k = skip_ws_comments(ls + rp + 1);
            if (k < g_len && g_src[k] == '{') { isdef = 1; *has_body = 1; *body_abs = k; }
            else if (k < g_len && g_src[k] == ';') { isdef = 0; }
            else return NULL;
        }

        {
            char rname[MAX_NAME];
            ret_struct = self->analyse_param(line, rt, &ret_ia, &ret_ib, ret_cbase,
                                             &ret_ns, rname, &ret_rptr, &ret_tr);
        }
        buf_init(&b);
        self->emit_qualified_type(&b, line, lpo, ret_ia, ret_ib, ret_cbase, ret_ns, ret_tr >= 0);
        buf_putc(&b, '(');

        for (i = lpo + 1, end = rp; i < end; ) {
            size_t j = i;
            int depth = 0, pia = -1, pib = -1, pns = 0, ptr = 0, sidx, ptrtr = -1, parr = 0;
            char pname[MAX_NAME], pcbase[MAX_NAME];

            while (j < end) {
                char c = line[j];
                if (c == '"' || c == '\'') { j = line_literal_end(line, j, end); continue; }
                if (c == '(' || c == '[' || c == '{') depth++;
                else if (c == ')' || c == ']' || c == '}') depth--;
                else if (c == ',' && depth == 0) break;
                j++;
            }
            sidx = self->analyse_param(line + i, j - i, &pia, &pib, pcbase, &pns, pname, &ptr, &ptrtr);
            self->emit_qualified_type(&b, line + i, j - i, pia, pib, pcbase, pns, ptrtr >= 0);

            /* an interface *array* parameter (`Expr xs[]`) carries no name out of
               analyse_param -- the name sits before the '[' -- and it makes the
               parameter indexable in the body */
            if (ptrtr >= 0 && !pname[0]) {
                const char *lb = memchr(line + i, '[', j - i);
                if (lb) {
                    size_t e2 = (size_t)(lb - (line + i)), s2;
                    while (e2 > 0 && isspace((unsigned char)line[i + e2 - 1])) e2--;
                    s2 = e2;
                    while (s2 > 0 && is_ident_char((unsigned char)line[i + s2 - 1])) s2--;
                    if (e2 > s2) {
                        size_t ml = e2 - s2;
                        if (ml >= MAX_NAME) ml = MAX_NAME - 1;
                        memcpy(pname, line + i + s2, ml);
                        pname[ml] = 0;
                        parr = 1;
                    }
                }
            }

            if (isdef && pname[0] && (sidx >= 0 || ptrtr >= 0)) {
                int vi = sym->new_var();
                snprintf(sym->vars[vi].name, MAX_NAME, "%s", pname);
                sym->vars[vi].s = (sidx >= 0) ? sidx : -1;
                sym->vars[vi].ptr = ptr;
                sym->vars[vi].arr = parr;
                sym->vars[vi].iface = (sidx >= 0) ? 0 : 1;
                sym->vars[vi].tr = (sidx >= 0) ? -1 : ptrtr;
            }
            {
                char pbuf[MAX_NAME * 2];
                size_t pl = j - i;
                if (pl >= sizeof pbuf) die(0, "parameter too long (max %d)", (int)sizeof pbuf - 1);
                memcpy(pbuf, line + i, pl);
                pbuf[pl] = 0;
                trim(pbuf);
                if (pbuf[0] && strcmp(pbuf, "void") != 0) {
                    if (npar >= MAX_PARAMS) die(0, "too many parameters (max %d)", MAX_PARAMS);
                    ptrait[npar++] = ptrtr;
                }
            }
            if (j < end) { buf_putc(&b, ','); j++; }
            i = j;
        }
        /* record the signature so call sites can reject rvalue receivers and box
           interface arguments */
        if (sym->nfuncs >= MAX_FUNCS) die(0, "too many functions (max %d)", MAX_FUNCS);
        {
            FuncSig *FS = &sym->funcs[sym->nfuncs++];
            int q;
            snprintf(FS->name, MAX_NAME, "%s", name);
            FS->nparams = npar;
            FS->rettrait = ret_tr;
            FS->retstruct = (ret_tr >= 0) ? -1 : ret_struct;
            FS->retptr = (ret_tr >= 0) ? 0 : ret_rptr;
            for (q = 0; q < npar; q++) FS->ptrait[q] = ptrait[q];
        }
        if (isdef) self->cur_rettr = ret_tr;

        buf_putc(&b, ')');
        buf_puts(&b, line + rp + 1);
        return b.p;
    }
}

/* The single pipeline instance. The methods name their own state through
   `self->...`; the top-level `pub` wrappers below (which have no `self`) reach it
   through `g_pipe`. */
static Pipe g_pipe = { };

/* ------------------------------------------------ raw line rewriting */

static size_t line_literal_end(const char *s, size_t i, size_t n)
{
    char q = s[i++];
    while (i < n) {
        if (s[i] == '\\' && i + 1 < n) { i += 2; continue; }
        if (s[i] == q) return i + 1;
        i++;
    }
    return n;
}

static size_t line_match_paren(const char *s, size_t k, size_t n)
{
    int depth = 0;
    while (k < n) {
        char c = s[k];
        if (c == '"' || c == '\'') { k = line_literal_end(s, k, n); continue; }
        if (c == '(') depth++;
        else if (c == ')') { depth--; if (!depth) return k; }
        k++;
    }
    return (size_t)-1;
}

/* Offset of the first plain '=' (the assignment or initialiser), or -1. A '=='
   or a compound operator like '+=' is not one. */
static size_t line_assign_eq(const char *line)
{
    size_t len = strlen(line), i = 0;
    while (i < len) {
        char c = line[i];
        if (c == '"' || c == '\'') { i = line_literal_end(line, i, len); continue; }
        if (c == '/' && (line[i + 1] == '/' || line[i + 1] == '*')) break;
        if (c == '=') {
            char next = line[i + 1];
            char prev = (i > 0) ? line[i - 1] : 0;
            if (next == '=') { i += 2; continue; }
            if (prev && strchr("=!<>+-*/%&|^", prev)) { i++; continue; }
            return i;
        }
        i++;
    }
    return (size_t)-1;
}

/* ------------------------------------------------- core export surface */

/* `driver.ct` is a separate unit and can reach nothing file-scope here, so the CLI
   side talks to the pipeline through these wrappers. Primitive-only signatures are
   not a style choice: the generated header cannot name a macro, an include or a
   typed global, so `struct Pipe` / `struct SymTab` / `Buf` cannot cross at all. */

pub int ct_is_ident_char(int c);
int ct_is_ident_char(int c)
{
    return is_ident_char(c);
}

pub char *ct_read_file(const char *path, unsigned long *len);
char *ct_read_file(const char *path, unsigned long *len)
{
    size_t n = 0;
    char *s = g_pipe.read_file(path, &n);
    *len = (unsigned long)n;
    return s;
}

/* the `#include`s a build-mode unit's .c opens with, filled before compiling it */
pub void ct_begin_imports(void);
void ct_begin_imports(void)
{
    g_pipe.nimp_h = 0;
}

pub void ct_add_import(const char *h);
void ct_add_import(const char *h)
{
    snprintf(g_pipe.imp_h[g_pipe.nimp_h], MAX_NAME, "%s", h);
    g_pipe.nimp_h++;
}

pub int ct_compile_file(const char *in, const char *outc, int multi, int line_force, int json);
int ct_compile_file(const char *in, const char *outc, int multi, int line_force, int json)
{
    int rc;
    int err_base = g_nerrors;
    g_pipe.line_force = line_force;
    g_sym.json = json;
    g_pipe.sym = &g_sym;
    rc = g_pipe.compile_file(in, outc, multi);
    if (g_nerrors > err_base) {
        /* close the multi-error report with a count; the failure itself travels
           back through the exit code */
        fprintf(stderr, "ctc: %d error(s) generated\n", g_nerrors - err_base);
        return 1;
    }
    /* Warnings are printed once per run. Single-file mode prints them here (JSON
       to stdout, text to stderr); `build` defers to ct_cc_finish so a whole run's
       warnings land after the cc command instead of once per unit. */
    if (rc == 0 && !multi) g_sym.emit_warnings(stdout, stderr);
    return rc;
}

pub void ct_usage(const char *prog);
void ct_usage(const char *prog)
{
    g_pipe.usage(prog);
}

pub void ct_default_output(const char *in, char *out, unsigned long n);
void ct_default_output(const char *in, char *out, unsigned long n)
{
    g_pipe.default_output(in, out, (size_t)n);
}

/* The suggested cc command `build` prints: spliced here so `driver.ct` never needs
   `Buf` (which cannot cross units) for it. It lives on `g_pipe` (see `struct Pipe`). */

pub void ct_cc_reset(void);
void ct_cc_reset(void)
{
    if (!g_pipe.cc_ready) {
        buf_init(&g_pipe.cc);
        g_pipe.cc_ready = 1;
    }
    g_pipe.cc.n = 0;
    g_pipe.cc.p[0] = 0;
    buf_puts(&g_pipe.cc, "cc");
}

pub void ct_cc_add(const char *path);
void ct_cc_add(const char *path)
{
    buf_putc(&g_pipe.cc, ' ');
    buf_puts(&g_pipe.cc, path);
}

pub void ct_cc_finish(void);
void ct_cc_finish(void)
{
    buf_puts(&g_pipe.cc, " -o a.out");
    printf("%s\n", g_pipe.cc.p);
    /* build keeps stdout for the cc command, so every warning goes to stderr */
    g_sym.emit_warnings(stderr, stderr);
}
