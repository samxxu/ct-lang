/*
 * main.ct - Phase 9: the AST compiler.
 *
 * 9.1 proved the pipe end to end (lexer -> recursive descent -> AST -> C).
 * 9.2 adds the statement/control-flow layer and real signatures:
 *
 *   - `int` / `void` functions with parameters, prototypes and forward calls
 *   - local declarations, assignment, `if` / `else`, `while`, `for`
 *   - `return expr;` and `return;`
 *   - comparisons (< > <= >= == !=), `%`, unary `-` / `!`, postfix `++` / `--`
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one central dispatch).
 * Symbol tables follow D33: a function table plus a variable table with a scope
 * stack (only variables are scoped). The tables carry names, not types -- 9.2
 * does no type checking; the declared type is `int` and `void` for returns.
 *
 * Output contract: banner, `<base>.h` guard and a self-contained `.c`; byte
 * equality with the old pipeline is not required (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define CTC_VERSION "0.8.0"

#define MAX_NODES 4096
#define MAX_TEXT  160
#define MAX_PATH  1024
#define MAX_FUNCS 64
#define MAX_VARS  512
#define MAX_SCOPE 256

/* node kinds (D32: one tag, one central dispatch) */
#define N_PROG   1
#define N_PP     2
#define N_FUNC   3
#define N_BLOCK  4
#define N_RET    5
#define N_EXPR   6
#define N_CALL   7
#define N_NUM    8
#define N_STR    9
#define N_VAR    10
#define N_BIN    11
#define N_DECL   12
#define N_ASSIGN 13
#define N_IF     14
#define N_WHILE  15
#define N_FOR    16
#define N_UNARY  17
#define N_POST   18
#define N_PARAM  19

/* token kinds */
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

/* binary operators (stored in `aux`) */
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define P_INC 1
#define P_DEC 2

/* return types */
#define R_VOID 0
#define R_INT  1

/* `parse_func` returns this when the declaration was a prototype (no node). */
#define NO_NODE (-2)

typedef struct Node {
    int  kind;
    int  a;             /* first child / left operand / condition */
    int  b;             /* second child / right operand / body */
    int  c;             /* third child (else branch / for step) */
    int  d;             /* fourth child (for body) */
    int  next;          /* next sibling in a list */
    int  aux;           /* operator kind, return type */
    long num;           /* numeric literal */
    char text[MAX_TEXT];/* identifier, string literal or preprocessor line */
} Node;

typedef struct Fn {
    char name[MAX_TEXT];
    int  nparams;
    int  ret;
} Fn;

typedef struct Var {
    char name[MAX_TEXT];
} Var;

static Node g_nodes[MAX_NODES];
static int  g_nnode;
static const char *g_src;
static int  g_pos;
static int  g_bol;          /* at the beginning of a line (for `#` lines) */
static int  g_tok;
static char g_toktext[MAX_TEXT];
static long g_toknum;
static FILE *g_out;
static const char *g_path;
static char g_errmsg[MAX_TEXT];
static int  g_nparams;      /* parameters of the function being parsed */

static Fn  g_funcs[MAX_FUNCS];
static int g_nfunc;
static Var g_vars[MAX_VARS];
static int g_nvar;
static int g_scope[MAX_SCOPE];
static int g_nscope;

trait AstOps {
    int  new_node(int kind);
    int  fail(const char *msg);
    void lex_next(void);
    int  accept(const char *p);
    int  expect(const char *p);
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name);
    int  find_var(const char *name);
    int  find_func(const char *name);
    int  add_func(const char *name, int nparams, int ret);
    int  parse_program(void);
    int  parse_func(void);
    int  parse_params(void);
    int  parse_block(void);
    int  parse_stmt(void);
    int  parse_branch(void);
    int  parse_decl_node(void);
    int  parse_expr_stmt_node(void);
    int  parse_expr(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  read_file(const char *path);
    int  default_output(const char *in, char *out, size_t cap);
    int  run(int argc, char **argv);
}

trait EmitOps {
    int  emit_program(int prog);
    int  emit_node(int n, int ind);
    int  emit_inline(int n);
    int  emit_expr(int n);
    int  emit_cond(int n);
    int  emit_indent(int n);
    int  write_header(const char *outc);
}

/* 9.1/9.2 need no per-run state beyond the globals above; the struct exists so
   the methods live in impl blocks (plain-C signatures are capped by MAX_FUNCS). */
struct Ast {
    int nerr;
} use AstOps, EmitOps;

impl AstOps for Ast {
    int new_node(int kind)
    {
        int n;
        (void)self;
        if (g_nnode >= MAX_NODES) return self->fail("too many AST nodes");
        n = g_nnode;
        g_nnode++;
        g_nodes[n].kind = kind;
        g_nodes[n].a = -1;
        g_nodes[n].b = -1;
        g_nodes[n].c = -1;
        g_nodes[n].d = -1;
        g_nodes[n].next = -1;
        g_nodes[n].aux = 0;
        g_nodes[n].num = 0;
        g_nodes[n].text[0] = 0;
        return n;
    }

    int fail(const char *msg)
    {
        (void)self;
        if (!g_errmsg[0]) snprintf(g_errmsg, sizeof g_errmsg, "%s", msg);
        return -1;
    }

    /* One token at a time. Preprocessor lines are kept verbatim: they are
       emitted before the program, never interpreted. */
    void lex_next(void)
    {
        int c, n;
        (void)self;

        for (;;) {
            c = (unsigned char)g_src[g_pos];
            if (c == 0) { g_tok = T_EOF; g_toktext[0] = 0; return; }
            if (c == '\n') { g_bol = 1; g_pos++; continue; }
            if (c == ' ' || c == '\t' || c == '\r') { g_pos++; continue; }
            if (c == '/' && g_src[g_pos + 1] == '/') {
                while (g_src[g_pos] && g_src[g_pos] != '\n') g_pos++;
                continue;
            }
            break;
        }
        if (g_bol && c == '#') {
            n = 0;
            while (g_src[g_pos] && g_src[g_pos] != '\n') {
                if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                g_pos++;
            }
            g_toktext[n] = 0;
            g_tok = T_PP;
            g_bol = 0;
            return;
        }
        g_bol = 0;
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
            n = 0;
            while (g_src[g_pos] && ((g_src[g_pos] >= 'a' && g_src[g_pos] <= 'z')
                   || (g_src[g_pos] >= 'A' && g_src[g_pos] <= 'Z')
                   || (g_src[g_pos] >= '0' && g_src[g_pos] <= '9')
                   || g_src[g_pos] == '_')) {
                if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                g_pos++;
            }
            g_toktext[n] = 0;
            g_tok = T_ID;
            return;
        }
        if (c >= '0' && c <= '9') {
            g_toknum = 0;
            while (g_src[g_pos] >= '0' && g_src[g_pos] <= '9') {
                g_toknum = g_toknum * 10 + (g_src[g_pos] - '0');
                g_pos++;
            }
            g_tok = T_NUM;
            return;
        }
        if (c == '"') {
            n = 0;
            g_toktext[n] = '"';
            n++;
            g_pos++;
            while (g_src[g_pos] && g_src[g_pos] != '"') {
                if (g_src[g_pos] == '\\' && g_src[g_pos + 1]) {
                    if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                    g_pos++;
                }
                if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                g_pos++;
            }
            if (g_src[g_pos] == '"') {
                if (n + 1 < MAX_TEXT) { g_toktext[n] = '"'; n++; }
                g_pos++;
            }
            g_toktext[n] = 0;
            g_tok = T_STR;
            return;
        }
        /* two-character punctuation must be tried before the one-char default */
        if ((c == '=' || c == '!' || c == '<' || c == '>') && g_src[g_pos + 1] == '=') {
            g_toktext[0] = (char)c;
            g_toktext[1] = '=';
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos++;
            g_pos++;
            return;
        }
        if ((c == '+' || c == '-') && g_src[g_pos + 1] == c) {
            g_toktext[0] = (char)c;
            g_toktext[1] = (char)c;
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos++;
            g_pos++;
            return;
        }
        g_toktext[0] = (char)c;
        g_toktext[1] = 0;
        g_tok = T_PUNCT;
        g_pos++;
    }

    int accept(const char *p)
    {
        (void)self;
        if (g_tok == T_PUNCT && strcmp(g_toktext, p) == 0) {
            self->lex_next();
            return 1;
        }
        return 0;
    }

    int expect(const char *p)
    {
        (void)self;
        if (self->accept(p)) return 0;
        return self->fail("unexpected token");
    }

    /* ---- D33: flat tables plus a scope stack (only variables are scoped) ---- */

    int push_scope(void)
    {
        (void)self;
        if (g_nscope >= MAX_SCOPE) return self->fail("too many nested scopes");
        g_scope[g_nscope] = g_nvar;
        g_nscope++;
        return 0;
    }

    int pop_scope(void)
    {
        (void)self;
        if (g_nscope <= 0) return self->fail("scope stack underflow");
        g_nscope--;
        g_nvar = g_scope[g_nscope];
        return 0;
    }

    int declare_var(const char *name)
    {
        (void)self;
        if (g_nvar >= MAX_VARS) return self->fail("too many variables");
        snprintf(g_vars[g_nvar].name, MAX_TEXT, "%s", name);
        g_nvar++;
        return 0;
    }

    int find_var(const char *name)
    {
        int i;
        (void)self;
        for (i = g_nvar - 1; i >= 0; i--)
            if (strcmp(g_vars[i].name, name) == 0) return i;
        return -1;
    }

    int find_func(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < g_nfunc; i++)
            if (strcmp(g_funcs[i].name, name) == 0) return i;
        return -1;
    }

    /* A prototype followed by its definition updates the same entry. */
    int add_func(const char *name, int nparams, int ret)
    {
        int i;
        (void)self;
        i = self->find_func(name);
        if (i >= 0) {
            g_funcs[i].nparams = nparams;
            g_funcs[i].ret = ret;
            return i;
        }
        if (g_nfunc >= MAX_FUNCS) return self->fail("too many functions");
        snprintf(g_funcs[g_nfunc].name, MAX_TEXT, "%s", name);
        g_funcs[g_nfunc].nparams = nparams;
        g_funcs[g_nfunc].ret = ret;
        g_nfunc++;
        return g_nfunc - 1;
    }

    int parse_program(void)
    {
        int prog, tail, n;
        (void)self;

        prog = self->new_node(N_PROG);
        if (prog < 0) return -1;
        tail = -1;
        self->lex_next();
        while (g_tok == T_PP) {
            n = self->new_node(N_PP);
            if (n < 0) return -1;
            snprintf(g_nodes[n].text, MAX_TEXT, "%s", g_toktext);
            if (tail < 0) g_nodes[prog].a = n;
            else g_nodes[tail].next = n;
            tail = n;
            self->lex_next();
        }
        while (g_tok != T_EOF) {
            if (g_tok != T_ID || (strcmp(g_toktext, "int") != 0
                                  && strcmp(g_toktext, "void") != 0))
                return self->fail("expected a function definition");
            n = self->parse_func();
            if (n == -1) return -1;
            if (n == NO_NODE) continue;
            if (tail < 0) g_nodes[prog].a = n;
            else g_nodes[tail].next = n;
            tail = n;
        }
        return prog;
    }

    /* `int|void name(params) ;` or `int|void name(params) { ... }`. */
    int parse_func(void)
    {
        int ret, f, b, params;
        char name[MAX_TEXT];
        (void)self;

        ret = (strcmp(g_toktext, "int") == 0) ? R_INT : R_VOID;
        self->lex_next();
        if (g_tok != T_ID) return self->fail("expected a function name");
        snprintf(name, sizeof name, "%s", g_toktext);
        self->lex_next();
        if (self->expect("(") != 0) return -1;
        if (self->push_scope() != 0) return -1;
        params = self->parse_params();
        if (params < 0) {
            self->pop_scope();
            return -1;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
            self->lex_next();
            if (self->add_func(name, g_nparams, ret) < 0) {
                self->pop_scope();
                return -1;
            }
            self->pop_scope();
            return NO_NODE;
        }
        b = self->parse_block();
        if (b < 0) {
            self->pop_scope();
            return -1;
        }
        if (self->add_func(name, g_nparams, ret) < 0) {
            self->pop_scope();
            return -1;
        }
        f = self->new_node(N_FUNC);
        if (f < 0) {
            self->pop_scope();
            return -1;
        }
        snprintf(g_nodes[f].text, MAX_TEXT, "%s", name);
        g_nodes[f].aux = ret;
        g_nodes[f].a = params;
        g_nodes[f].b = b;
        self->pop_scope();
        return f;
    }

    /* `(void)` or `(int a, int b)`; the count lands in `g_nparams`. */
    int parse_params(void)
    {
        int first, tail, p;
        char name[MAX_TEXT];
        (void)self;

        g_nparams = 0;
        first = 0;
        tail = 0;
        if (g_tok == T_ID && strcmp(g_toktext, "void") == 0) {
            self->lex_next();
            if (self->expect(")") != 0) return -1;
            return 0;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        for (;;) {
            if (g_tok != T_ID || strcmp(g_toktext, "int") != 0)
                return self->fail("9.2 parameters must be 'int'");
            self->lex_next();
            if (g_tok != T_ID) return self->fail("expected a parameter name");
            snprintf(name, sizeof name, "%s", g_toktext);
            self->lex_next();
            p = self->new_node(N_PARAM);
            if (p < 0) return -1;
            snprintf(g_nodes[p].text, MAX_TEXT, "%s", name);
            if (self->declare_var(name) != 0) return -1;
            if (tail == 0) first = p;
            else g_nodes[tail].next = p;
            tail = p;
            g_nparams++;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }

    int parse_block(void)
    {
        int blk, tail, s;
        (void)self;

        if (self->expect("{") != 0) return -1;
        if (self->push_scope() != 0) return -1;
        blk = self->new_node(N_BLOCK);
        if (blk < 0) {
            self->pop_scope();
            return -1;
        }
        tail = -1;
        while (g_tok != T_EOF && !(g_tok == T_PUNCT && strcmp(g_toktext, "}") == 0)) {
            s = self->parse_stmt();
            if (s < 0) {
                self->pop_scope();
                return -1;
            }
            if (tail < 0) g_nodes[blk].a = s;
            else g_nodes[tail].next = s;
            tail = s;
        }
        if (self->expect("}") != 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        return blk;
    }

    int parse_stmt(void)
    {
        int s, e, c;
        (void)self;

        if (g_tok == T_PUNCT && strcmp(g_toktext, "{") == 0) return self->parse_block();
        if (g_tok == T_ID && strcmp(g_toktext, "return") == 0) {
            s = self->new_node(N_RET);
            if (s < 0) return -1;
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
                self->lex_next();
                return s;
            }
            e = self->parse_expr();
            if (e < 0) return -1;
            g_nodes[s].a = e;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "if") == 0) {
            s = self->new_node(N_IF);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            g_nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            g_nodes[s].b = e;
            if (g_tok == T_ID && strcmp(g_toktext, "else") == 0) {
                self->lex_next();
                e = self->parse_branch();
                if (e < 0) return -1;
                g_nodes[s].c = e;
            }
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "while") == 0) {
            s = self->new_node(N_WHILE);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            g_nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            g_nodes[s].b = e;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "for") == 0) {
            s = self->new_node(N_FOR);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (self->push_scope() != 0) return -1;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
                g_nodes[s].a = -1;
            } else if (g_tok == T_ID && strcmp(g_toktext, "int") == 0) {
                e = self->parse_decl_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].a = e;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].a = e;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
                g_nodes[s].b = -1;
            } else {
                c = self->parse_expr();
                if (c < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].b = c;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0) {
                g_nodes[s].c = -1;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].c = e;
            }
            if (self->expect(")") != 0) {
                self->pop_scope();
                return -1;
            }
            e = self->parse_branch();
            if (e < 0) {
                self->pop_scope();
                return -1;
            }
            g_nodes[s].d = e;
            self->pop_scope();
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "int") == 0) {
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        s = self->parse_expr_stmt_node();
        if (s < 0) return -1;
        if (self->expect(";") != 0) return -1;
        return s;
    }

    /* A branch is always a block node, so emission never needs implicit braces. */
    int parse_branch(void)
    {
        int b, s;
        (void)self;

        if (g_tok == T_PUNCT && strcmp(g_toktext, "{") == 0) return self->parse_block();
        if (self->push_scope() != 0) return -1;
        s = self->parse_stmt();
        if (s < 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        b = self->new_node(N_BLOCK);
        if (b < 0) return -1;
        g_nodes[b].a = s;
        return b;
    }

    /* `int name [= expr]` without the trailing semicolon. */
    int parse_decl_node(void)
    {
        int n, e;
        char name[MAX_TEXT];
        (void)self;

        self->lex_next();
        if (g_tok != T_ID) return self->fail("expected a variable name");
        snprintf(name, sizeof name, "%s", g_toktext);
        self->lex_next();
        n = self->new_node(N_DECL);
        if (n < 0) return -1;
        snprintf(g_nodes[n].text, MAX_TEXT, "%s", name);
        g_nodes[n].aux = R_INT;
        if (self->declare_var(name) != 0) return -1;
        if (g_tok == T_PUNCT && strcmp(g_toktext, "=") == 0) {
            self->lex_next();
            e = self->parse_expr();
            if (e < 0) return -1;
            g_nodes[n].a = e;
        }
        return n;
    }

    /* An expression statement, or `name = expr` when `=` follows a plain name. */
    int parse_expr_stmt_node(void)
    {
        int e, rhs, n;
        (void)self;

        e = self->parse_expr();
        if (e < 0) return -1;
        if (g_tok == T_PUNCT && strcmp(g_toktext, "=") == 0) {
            if (g_nodes[e].kind != N_VAR) return self->fail("assignment target must be a variable");
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            g_nodes[e].kind = N_ASSIGN;
            g_nodes[e].a = rhs;
            return e;
        }
        if (g_nodes[e].kind == N_POST) return e;
        n = self->new_node(N_EXPR);
        if (n < 0) return -1;
        g_nodes[n].a = e;
        return n;
    }

    int parse_expr(void)
    {
        (void)self;
        return self->parse_cmp();
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT) {
            op = 0;
            if (strcmp(g_toktext, "<") == 0) op = B_LT;
            else if (strcmp(g_toktext, ">") == 0) op = B_GT;
            else if (strcmp(g_toktext, "<=") == 0) op = B_LE;
            else if (strcmp(g_toktext, ">=") == 0) op = B_GE;
            else if (strcmp(g_toktext, "==") == 0) op = B_EQ;
            else if (strcmp(g_toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT && (strcmp(g_toktext, "+") == 0 || strcmp(g_toktext, "-") == 0)) {
            op = (g_toktext[0] == '+') ? B_ADD : B_SUB;
            self->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT && (strcmp(g_toktext, "*") == 0
               || strcmp(g_toktext, "/") == 0 || strcmp(g_toktext, "%") == 0)) {
            op = B_MUL;
            if (g_toktext[0] == '/') op = B_DIV;
            else if (g_toktext[0] == '%') op = B_MOD;
            self->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        op = 0;
        if (g_tok == T_PUNCT && strcmp(g_toktext, "-") == 0) op = U_NEG;
        else if (g_tok == T_PUNCT && strcmp(g_toktext, "!") == 0) op = U_NOT;
        if (op != 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_UNARY);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            g_nodes[n].aux = op;
            return n;
        }
        return self->parse_postfix();
    }

    int parse_postfix(void)
    {
        int n;
        (void)self;

        n = self->parse_primary();
        if (n < 0) return -1;
        if (g_tok == T_PUNCT && (strcmp(g_toktext, "++") == 0 || strcmp(g_toktext, "--") == 0)) {
            if (g_nodes[n].kind != N_VAR) return self->fail("'++' / '--' need a variable");
            g_nodes[n].kind = N_POST;
            g_nodes[n].aux = (g_toktext[0] == '+') ? P_INC : P_DEC;
            self->lex_next();
        }
        return n;
    }

    int parse_primary(void)
    {
        int n, args;
        (void)self;

        if (g_tok == T_NUM) {
            n = self->new_node(N_NUM);
            if (n < 0) return -1;
            g_nodes[n].num = g_toknum;
            self->lex_next();
            return n;
        }
        if (g_tok == T_STR) {
            n = self->new_node(N_STR);
            if (n < 0) return -1;
            snprintf(g_nodes[n].text, MAX_TEXT, "%s", g_toktext);
            self->lex_next();
            return n;
        }
        if (g_tok == T_ID) {
            n = self->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(g_nodes[n].text, MAX_TEXT, "%s", g_toktext);
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0) {
                args = self->parse_args();
                if (args < 0) return -1;
                g_nodes[n].kind = N_CALL;
                g_nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->find_var(g_nodes[n].text) < 0) {
                /* the scope stack is unwound after each function, so this check
                   has to happen while parsing, not in the emitter */
                return self->fail("use of an undeclared variable");
            }
            return n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0) {
            self->lex_next();
            n = self->parse_expr();
            if (n < 0) return -1;
            if (self->expect(")") != 0) return -1;
            return n;
        }
        return self->fail("expected an expression");
    }

    /* `(` args `)`: 0 means an empty list (node 0 is the program). */
    int parse_args(void)
    {
        int first, tail, e;
        (void)self;

        if (self->expect("(") != 0) return -1;
        if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        first = -1;
        tail = -1;
        for (;;) {
            e = self->parse_expr();
            if (e < 0) return -1;
            if (tail < 0) first = e;
            else g_nodes[tail].next = e;
            tail = e;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        (void)self;
        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        g_src = buf;
        return 0;
    }

    /* `foo.ct` -> `foo.c`; anything else gets `.c` appended. */
    int default_output(const char *in, char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0) {
            if (snprintf(out, cap, "%.*s.c", (int)(n - 3), in) >= (int)cap) return -1;
            return 0;
        }
        if (snprintf(out, cap, "%s.c", in) >= (int)cap) return -1;
        return 0;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        const char *out;
        char outbuf[MAX_PATH];
        int i, prog;
        FILE *f;

        in = NULL;
        out = NULL;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: ct-ast <input.ct> [-o <output.c>]\n");
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("ct-ast v%s\n", CTC_VERSION);
                return 0;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ct-ast: unknown option '%s'\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: ct-ast <input.ct> [-o <output.c>]\n");
            return 1;
        }
        if (!out) {
            if (self->default_output(in, outbuf, sizeof outbuf) != 0) {
                fprintf(stderr, "ct-ast: output path too long\n");
                return 1;
            }
            out = outbuf;
        }

        g_path = in;
        g_pos = 0;
        g_bol = 1;
        g_nnode = 0;
        g_nfunc = 0;
        g_nvar = 0;
        g_nscope = 0;
        g_nparams = 0;
        g_errmsg[0] = 0;
        if (self->read_file(in) != 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        prog = self->parse_program();
        if (prog < 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ct-ast: cannot write '%s'\n", out);
            return 1;
        }
        g_out = f;
        fprintf(g_out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, g_path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              g_out);
        if (self->emit_program(prog) != 0) {
            fclose(f);
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ct-ast: cannot write '%s'\n", out);
            return 1;
        }
        if (self->write_header(out) != 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        return 0;
    }
}

impl EmitOps for Ast {
    int emit_indent(int n)
    {
        int i;
        (void)self;
        for (i = 0; i < n * 4; i++) fputc(' ', g_out);
        return 0;
    }

    /* Preprocessor lines first, then one prototype per function (so a call may
       precede its definition), then the definitions in source order. */
    int emit_program(int prog)
    {
        int n, i;
        (void)self;

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next)
            if (g_nodes[n].kind == N_PP) fprintf(g_out, "%s\n", g_nodes[n].text);

        for (i = 0; i < g_nfunc; i++) {
            if (g_funcs[i].ret == R_VOID) fputs("void ", g_out);
            else fputs("int ", g_out);
            fprintf(g_out, "%s(", g_funcs[i].name);
            if (g_funcs[i].nparams == 0) {
                fputs("void", g_out);
            } else {
                int k;
                for (k = 0; k < g_funcs[i].nparams; k++) {
                    if (k > 0) fputs(", ", g_out);
                    fputs("int", g_out);
                }
            }
            fputs(");\n", g_out);
        }

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            if (g_nodes[n].kind == N_FUNC) {
                if (self->emit_node(n, 0) != 0) return -1;
            } else if (g_nodes[n].kind != N_PP) {
                return self->fail("unknown top-level node");
            }
        }
        return 0;
    }

    int emit_node(int n, int ind)
    {
        int c;
        (void)self;

        if (g_nodes[n].kind == N_FUNC) {
            if (g_nodes[n].aux == R_VOID) fputs("void ", g_out);
            else fputs("int ", g_out);
            fprintf(g_out, "%s(", g_nodes[n].text);
            c = g_nodes[n].a;
            if (c == 0) {
                fputs("void) ", g_out);
            } else {
                int first;
                first = 1;
                while (c > 0) {
                    if (!first) fputs(", ", g_out);
                    fprintf(g_out, "int %s", g_nodes[c].text);
                    first = 0;
                    c = g_nodes[c].next;
                }
                fputs(") ", g_out);
            }
            return self->emit_node(g_nodes[n].b, ind);
        }
        if (g_nodes[n].kind == N_BLOCK) {
            fputs("{\n", g_out);
            for (c = g_nodes[n].a; c >= 0; c = g_nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            self->emit_indent(ind);
            fputs("}\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_RET) {
            self->emit_indent(ind);
            if (g_nodes[n].a < 0) {
                fputs("return;\n", g_out);
                return 0;
            }
            fputs("return ", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(";\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_DECL || g_nodes[n].kind == N_ASSIGN
            || g_nodes[n].kind == N_EXPR || g_nodes[n].kind == N_POST) {
            self->emit_indent(ind);
            if (self->emit_inline(n) != 0) return -1;
            fputs(";\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_IF) {
            self->emit_indent(ind);
            fputs("if (", g_out);
            if (self->emit_cond(g_nodes[n].a) != 0) return -1;
            fputs(") ", g_out);
            if (self->emit_node(g_nodes[n].b, ind) != 0) return -1;
            if (g_nodes[n].c >= 0) {
                self->emit_indent(ind);
                fputs("else ", g_out);
                if (self->emit_node(g_nodes[n].c, ind) != 0) return -1;
            }
            return 0;
        }
        if (g_nodes[n].kind == N_WHILE) {
            self->emit_indent(ind);
            fputs("while (", g_out);
            if (self->emit_cond(g_nodes[n].a) != 0) return -1;
            fputs(") ", g_out);
            return self->emit_node(g_nodes[n].b, ind);
        }
        if (g_nodes[n].kind == N_FOR) {
            self->emit_indent(ind);
            fputs("for (", g_out);
            if (g_nodes[n].a >= 0 && self->emit_inline(g_nodes[n].a) != 0) return -1;
            fputs("; ", g_out);
            if (g_nodes[n].b >= 0 && self->emit_cond(g_nodes[n].b) != 0) return -1;
            fputs("; ", g_out);
            if (g_nodes[n].c >= 0 && self->emit_inline(g_nodes[n].c) != 0) return -1;
            fputs(") ", g_out);
            return self->emit_node(g_nodes[n].d, ind);
        }
        {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "unknown statement node (kind %d)", g_nodes[n].kind);
            return self->fail(msg);
        }
    }

    /* A statement-shaped node without indentation or the trailing semicolon:
       used by `for (init; cond; step)` as well as by ordinary statements. */
    int emit_inline(int n)
    {
        (void)self;

        if (g_nodes[n].kind == N_DECL) {
            fprintf(g_out, "int %s", g_nodes[n].text);
            if (g_nodes[n].a >= 0) {
                fputs(" = ", g_out);
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            }
            return 0;
        }
        if (g_nodes[n].kind == N_ASSIGN) {
            fputs(g_nodes[n].text, g_out);
            fputs(" = ", g_out);
            return self->emit_expr(g_nodes[n].a);
        }
        if (g_nodes[n].kind == N_EXPR) return self->emit_expr(g_nodes[n].a);
        if (g_nodes[n].kind == N_POST) {
            fprintf(g_out, "%s%s", g_nodes[n].text,
                    g_nodes[n].aux == P_INC ? "++" : "--");
            return 0;
        }
        return self->fail("cannot inline this node");
    }

    /* A condition must not gain a second pair of parentheses: clang warns about
       `if ((a == b))` under -Wall, and D34 requires a warning-free build. */
    int emit_cond(int n)
    {
        const char *op;
        (void)self;

        if (g_nodes[n].kind == N_BIN && g_nodes[n].aux >= B_LT && g_nodes[n].aux <= B_NE) {
            op = "<";
            if (g_nodes[n].aux == B_GT) op = ">";
            else if (g_nodes[n].aux == B_LE) op = "<=";
            else if (g_nodes[n].aux == B_GE) op = ">=";
            else if (g_nodes[n].aux == B_EQ) op = "==";
            else if (g_nodes[n].aux == B_NE) op = "!=";
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fprintf(g_out, " %s ", op);
            return self->emit_expr(g_nodes[n].b);
        }
        return self->emit_expr(n);
    }

    int emit_expr(int n)
    {
        int c;
        const char *op;
        (void)self;

        if (g_nodes[n].kind == N_NUM) {
            fprintf(g_out, "%ld", g_nodes[n].num);
            return 0;
        }
        if (g_nodes[n].kind == N_STR) {
            fputs(g_nodes[n].text, g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_VAR) {
            fputs(g_nodes[n].text, g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_BIN) {
            op = "+";
            if (g_nodes[n].aux == B_SUB) op = "-";
            else if (g_nodes[n].aux == B_MUL) op = "*";
            else if (g_nodes[n].aux == B_DIV) op = "/";
            else if (g_nodes[n].aux == B_MOD) op = "%";
            else if (g_nodes[n].aux == B_LT) op = "<";
            else if (g_nodes[n].aux == B_GT) op = ">";
            else if (g_nodes[n].aux == B_LE) op = "<=";
            else if (g_nodes[n].aux == B_GE) op = ">=";
            else if (g_nodes[n].aux == B_EQ) op = "==";
            else if (g_nodes[n].aux == B_NE) op = "!=";
            fputs("(", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fprintf(g_out, " %s ", op);
            if (self->emit_expr(g_nodes[n].b) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_UNARY) {
            fputs(g_nodes[n].aux == U_NEG ? "(-" : "(!", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_CALL) {
            fprintf(g_out, "%s(", g_nodes[n].text);
            c = g_nodes[n].a;
            while (c >= 0) {
                if (self->emit_expr(c) != 0) return -1;
                c = g_nodes[c].next;
                if (c >= 0) fputs(", ", g_out);
            }
            fputs(")", g_out);
            return 0;
        }
        return self->fail("unknown expression node");
    }

    /* The header carries the same banner and guard as the old pipeline; 9.2 has
       no exported types yet, so there is nothing between the guard and `#endif`. */
    int write_header(const char *outc)
    {
        char path[MAX_PATH];
        char base[MAX_PATH];
        char guard[MAX_PATH];
        const char *name;
        FILE *f;
        size_t n, i, m;

        (void)self;
        if (snprintf(path, sizeof path, "%s", outc) >= (int)sizeof path)
            return self->fail("output path too long");
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        if (snprintf(base, sizeof base, "%s", name) >= (int)sizeof base)
            return self->fail("output path too long");
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        n = strlen(base);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            guard[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            if (m + 1 >= sizeof guard) return self->fail("output name too long");
            guard[m] = c;
            m++;
        }
        if (m + 3 >= sizeof guard) return self->fail("output name too long");
        guard[m] = '_';
        guard[m + 1] = 'H';
        guard[m + 2] = 0;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                CTC_VERSION, g_path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Ast g_ast;

int main(int argc, char **argv)
{
    return g_ast.run(argc, argv);
}
