/*
 * main.ct - Phase 9: the AST compiler.
 *
 * 9.1 proved the pipe (lexer -> parser -> AST -> C). 9.2 added statements,
 * control flow and signatures. 9.3 added the declaration layer, 9.4 traits and
 * interface values, and 9.5a the module layer:
 *
 *   - `build` mode: one `.c` + `.h` per unit, imports resolved recursively
 *   - `import a::b;` (the importing file's directory first, then `-I` roots)
 *   - `pub` routing: exported traits/structs/typedefs/prototypes land in `.h`
 *   - `namespace A::B { ... }` plus `--ns-root` directory validation
 *   - metadata: `#line` (`--line` / `--no-line`) and `--emit-map`
 *
 * Node shape follows D32 (`typedef struct` pool + `kind`, one dispatch per
 * concern). Symbol tables follow D33: functions, variables and types are
 * separate flat tables; only variables are scoped.
 *
 * Output contract: banner, `<base>.h` guard and a self-contained `.c`; byte
 * equality with the old pipeline is not required (D34).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define CTC_VERSION "0.8.0"

#define MAX_NODES  32768
#define MAX_TEXT   160
#define MAX_PATH   1024
#define MAX_FUNCS  64
#define MAX_PARAMS 8
#define MAX_VARS   512
#define MAX_SCOPE  256
#define MAX_TYPES  64
#define MAX_TRAITS 16
#define MAX_METHODS 32
#define MAX_STRUCTS 32
#define MAX_FIELDS 32
#define MAX_UNITS  64
#define MAX_IMPORTS 16
#define MAX_INCDIRS 16
#define MAX_CALLS  256

/* node kinds (D32: one tag, one dispatch) */
#define N_PROG    1
#define N_PP      2
#define N_FUNC    3
#define N_BLOCK   4
#define N_RET     5
#define N_EXPR    6
#define N_CALL    7
#define N_NUM     8
#define N_STR     9
#define N_VAR     10
#define N_BIN     11
#define N_DECL    12
#define N_ASSIGN  13
#define N_IF      14
#define N_WHILE   15
#define N_FOR     16
#define N_UNARY   17
#define N_POST    18
#define N_PARAM   19
#define N_STRUCT  20
#define N_TYPEDEF 21
#define N_GLOBAL  22
#define N_FIELD   23
#define N_MEMBER  24
#define N_ARROW   25
#define N_INDEX   26
#define N_ADDR    27
#define N_DEREF   28
#define N_METHOD  29
#define N_MCALL   30
#define N_RAW     31
#define N_TRAIT   32
#define N_IMPL    33
#define N_BOX     34
#define N_CAST    35
#define N_SIZEOF  36
#define N_TERN    37
#define N_BREAK   38
#define N_CONT    39
#define N_DECLS   40
#define N_DELETE  41

/* token kinds */
#define T_EOF    0
#define T_ID     1
#define T_NUM    2
#define T_STR    3
#define T_PUNCT  4
#define T_PP     5

/* binary operators (stored in `aux`) */
#define B_ADD 1
#define B_SUB 2
#define B_MUL 3
#define B_DIV 4
#define B_LT  5
#define B_GT  6
#define B_LE  7
#define B_GE  8
#define B_EQ  9
#define B_NE  10
#define B_MOD 11
#define B_AND 12
#define B_OR  13

/* unary / postfix operators */
#define U_NEG 1
#define U_NOT 2
#define P_INC 1
#define P_DEC 2

/* `parse_func` returns this when the declaration was a prototype (no node). */
#define NO_NODE (-2)

typedef struct Node {
    int  kind;
    int  a;             /* first child / left operand / condition / target */
    int  b;             /* second child / right operand / body */
    int  c;             /* third child (else branch / for step) */
    int  d;             /* fourth child (for body) / `pub` flag */
    int  next;          /* next sibling in a list */
    int  aux;           /* operator kind or `static` flag */
    int  line;          /* source line, for `#line` and the map */
    long num;           /* numeric literal or array length */
    char text[MAX_TEXT];/* type, string literal or preprocessor line */
    char text2[MAX_TEXT];/* declared / member / function name */
    char text3[MAX_TEXT];/* array length written as a name (a macro constant) */
} Node;

typedef struct Fn {
    char name[MAX_TEXT];
    char ret[MAX_TEXT];
    char ptype[MAX_PARAMS][MAX_TEXT];
    int  nparams;
    int  is_static;
    int  is_pub;
    int  line;
} Fn;

typedef struct Var {
    char name[MAX_TEXT];
    char type[MAX_TEXT];
} Var;

typedef struct MethodSig {
    char name[MAX_TEXT];
    char ret[MAX_TEXT];
    char ptype[MAX_PARAMS][MAX_TEXT];
    int  nparams;
} MethodSig;

typedef struct Trait {
    char name[MAX_TEXT];
    MethodSig m[MAX_METHODS];
    int  nm;
    int  is_pub;
    int  line;
} Trait;

typedef struct Field {
    char name[MAX_TEXT];
    char type[MAX_TEXT];
} Field;

typedef struct StructDef {
    char name[MAX_TEXT];
    char use[MAX_TRAITS][MAX_TEXT];
    int  nuse;
    /* field types: a receiver chain (`s.owner.greet()`) needs them, and so does
       the nested vptr initialiser of a struct-typed field */
    Field fields[MAX_FIELDS];
    int  nfields;
} StructDef;

/* One translation unit of a `build`: its source, output base, declared
   namespace and the exported names of the units it imports. */
typedef struct Unit {
    char path[MAX_PATH];
    char base[MAX_TEXT];
    char ns[MAX_TEXT];
    char dep[MAX_IMPORTS][MAX_TEXT];
    int  ndep;
    int  prog;
    int  is_hdr;
    int  fn_start;
    int  fn_end;
    int  tr_start;
    int  tr_end;
    int  call_start;
    int  call_end;
} Unit;

/* One `callee(...)` in a function body, for the map's call graph. */
typedef struct Call {
    char caller[MAX_TEXT];
    char callee[MAX_TEXT];
    int  line;
} Call;

static Node g_nodes[MAX_NODES];
static int  g_nnode;
static const char *g_src;
static int  g_pos;
static int  g_bol;
static int  g_tok;
static char g_toktext[MAX_TEXT];
static long g_toknum;
static FILE *g_out;
static const char *g_path;
static char g_errmsg[MAX_TEXT];
static int  g_nparams;

/* String literals live in a pool, not in Node.text: adjacent literals join into
   one C string and easily exceed MAX_TEXT. Node.num holds the pool offset. */
#define MAX_STRPOOL (256 * 1024)
static char g_strpool[MAX_STRPOOL];
static int  g_nstrpool;

/* fields of an untagged `typedef struct { ... }`, parked until the alias exists */
static Field g_pend_fields[MAX_FIELDS];
static int   g_npend;

static Fn  g_funcs[MAX_FUNCS];
static int g_nfunc;
static Var g_vars[MAX_VARS];
static int g_nvar;
static int g_scope[MAX_SCOPE];
static int g_nscope;
static char g_types[MAX_TYPES][MAX_TEXT];
static int  g_type_kind[MAX_TYPES];   /* 1 = struct tag, 2 = typedef */
static int g_ntype;
static Trait g_traits[MAX_TRAITS];
static int g_ntraits;
static StructDef g_structs[MAX_STRUCTS];
static int g_nstructs;
static int g_self_mode;               /* inside an impl body: `self` -> `_self` */
static char g_ret_type[MAX_TEXT];     /* return type of the function being parsed */

static Unit g_units[MAX_UNITS];
static int  g_nunits;
static int  g_build_mode;
static char g_ns[MAX_TEXT];           /* current namespace prefix, e.g. "hal_" */
static char g_ns_decl[MAX_TEXT];      /* namespace path declared by the current unit */
static char g_outdir[MAX_PATH];
static const char *g_incdirs[MAX_INCDIRS];
static int  g_ninc;
static const char *g_nsroot;
static char g_rels[MAX_IMPORTS][MAX_TEXT];  /* import paths seen by the scanner */
static int  g_nrels;
static int  g_line;                   /* lexer line, 1-based */
static int  g_tokline;                /* line of the current token */
static Call g_calls[MAX_CALLS];
static int  g_ncalls;
static char g_cur_func[MAX_TEXT];     /* caller recorded for the map */
static int  g_line_mode;              /* emit `#line`: 0 off, 1 on */
static char g_map_path[MAX_PATH];
static int  g_have_map;

trait AstOps {
    int  new_node(int kind);
    int  fail(const char *msg);
    void lex_next(void);
    int  accept(const char *p);
    int  expect(const char *p);
    int  read_file(const char *path);
    int  default_output(const char *in, char *out, size_t cap);
    int  run(int argc, char **argv);
}

trait SymOps {
    int  push_scope(void);
    int  pop_scope(void);
    int  declare_var(const char *name, const char *type);
    int  find_var(const char *name);
    int  var_type(const char *name, char *out, size_t cap);
    int  find_func(const char *name);
    int  add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param);
    int  find_type(const char *name);
    int  add_type(const char *name, int kind);
    int  find_struct(const char *name);
    int  add_struct(const char *name);
    int  find_trait(const char *name);
    int  add_trait(const char *name);
    int  method_trait(const char *stype, const char *method, char *tout, size_t tcap);
    int  ns_decl_name(const char *name, char *out, size_t cap);
    int  resolve_type(const char *name, char *out, size_t cap);
    int  record_call(const char *callee, int line);
}

trait ParseOps {
    int  is_type_word(const char *w);
    int  type_append(char *out, size_t cap, size_t *n, const char *tok);
    int  parse_type(char *out, size_t cap);
    int  parse_array_dims(int n);
    int  next_is_type_name(void);
    int  parse_program(void);
    int  parse_func(int is_static, int is_pub);
    int  parse_params(void);
    int  parse_struct_def(void);
    int  parse_typedef(int is_pub);
    int  parse_field_def(void);
    int  parse_block(void);
    int  parse_stmt(void);
    int  parse_branch(void);
    int  parse_decl_node(void);
    int  parse_expr_stmt_node(void);
    int  parse_expr(void);
    int  parse_cmp(void);
    int  parse_add(void);
    int  parse_mul(void);
    int  parse_unary(void);
    int  parse_postfix(void);
    int  parse_primary(void);
    int  parse_args(void);
    int  parse_trait(int is_pub);
    int  parse_impl(void);
    int  parse_use_list(int sindex);
    int  parse_init_raw(char *out, size_t cap);
    int  is_iface_type(const char *type, char *tout, size_t tcap);
    int  concrete_struct(const char *type, char *sout, size_t scap, int *is_ptr);
    int  expr_type(int n, char *out, size_t cap);
    int  maybe_box(int n, const char *trait);
}

/* Build-mode driving: path handling, import resolution, unit loading and the
   namespace/directory check. Kept out of ParseOps because that trait is one
   method below MAX_METHOD. */
trait ModuleOps {
    int  base_name(const char *path, char *out, size_t cap, int *is_hdr);
    int  path_dir(const char *path, char *out, size_t cap);
    int  append_node(int prog, int n);
    int  skip_import(void);
    int  scan_imports(const char *from);
    int  resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr);
    int  load_unit(const char *path);
    int  check_ns_dir(int u);
    int  parse_top_decl(int is_pub);
    int  parse_namespace(int prog);
    int  struct_def_ahead(void);
    int  build_main(int argc, char **argv);
}

trait EmitOps {
    int  emit_program(int prog);
    int  emit_unit(int u);
    int  write_unit_header(int u);
    int  emit_trait_range(int start, int end, int mode);
    int  emit_proto(int i);
    int  emit_vtable_fwd(int prog);
    int  header_guard(const char *base, char *out, size_t cap);
    int  write_map(const char *dest, int prog, int u);
    int  emit_json_str(FILE *f, const char *s);
    int  emit_node(int n, int ind);
    int  emit_inline(int n);
    int  emit_expr(int n);
    int  emit_cond(int n);
    int  emit_indent(int n);
    int  emit_type_decl(int n, int ind, int with_semi);
    int  emit_trait_decls(void);
    int  emit_impls(int prog);
    int  type_has_vptr(const char *type);
    int  type_needs_init(const char *type);
    int  emit_vptr_items(const char *prefix, const char *type);
    int  emit_field_vptrs(int si, int started);
    int  emit_vptr_stmts(const char *recv, const char *type, int ind);
    int  emit_unit_init(int prog);
    int  emit_raw_init(int raw, const char *type);
    int  write_header(const char *outc);
}

/* The state lives in file-scope globals (9.x is a small compiler); the struct
   exists so the methods live in impl blocks (MAX_FUNCS is a real cap). */
struct Ast {
    int nerr;
} use AstOps, SymOps, ParseOps, ModuleOps, EmitOps;

impl AstOps for Ast {
    int new_node(int kind)
    {
        int n;
        (void)self;
        if (g_nnode >= MAX_NODES) return self->fail("too many AST nodes");
        n = g_nnode;
        g_nnode++;
        g_nodes[n].kind = kind;
        g_nodes[n].a = -1;
        g_nodes[n].b = -1;
        g_nodes[n].c = -1;
        g_nodes[n].d = -1;
        g_nodes[n].next = -1;
        g_nodes[n].aux = 0;
        g_nodes[n].line = g_tokline;
        g_nodes[n].num = 0;
        g_nodes[n].text[0] = 0;
        g_nodes[n].text2[0] = 0;
        return n;
    }

    int fail(const char *msg)
    {
        (void)self;
        /* the line and the offending token are the two things a self-hosting
           run needs to locate a gap; diagnostics are not compared (D34) */
        if (!g_errmsg[0])
            snprintf(g_errmsg, sizeof g_errmsg, "line %d: %s (at '%s')", g_tokline, msg, g_toktext);
        return -1;
    }

    void lex_next(void)
    {
        int c, n;
        (void)self;

        for (;;) {
            c = (unsigned char)g_src[g_pos];
            if (c == 0) { g_tok = T_EOF; g_toktext[0] = 0; return; }
            if (c == '\n') { g_bol = 1; g_line++; g_pos++; continue; }
            if (c == ' ' || c == '\t' || c == '\r') { g_pos++; continue; }
            if (c == '/' && g_src[g_pos + 1] == '/') {
                while (g_src[g_pos] && g_src[g_pos] != '\n') g_pos++;
                continue;
            }
            if (c == '/' && g_src[g_pos + 1] == '*') {
                g_pos += 2;
                while (g_src[g_pos] && !(g_src[g_pos] == '*' && g_src[g_pos + 1] == '/')) {
                    if (g_src[g_pos] == '\n') g_line++;
                    g_pos++;
                }
                if (g_src[g_pos]) g_pos += 2;
                continue;
            }
            break;
        }
        g_tokline = g_line;
        if (g_bol && c == '#') {
            n = 0;
            while (g_src[g_pos] && g_src[g_pos] != '\n') {
                if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                g_pos++;
            }
            g_toktext[n] = 0;
            g_tok = T_PP;
            g_bol = 0;
            return;
        }
        g_bol = 0;
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') {
            n = 0;
            while (g_src[g_pos] && ((g_src[g_pos] >= 'a' && g_src[g_pos] <= 'z')
                   || (g_src[g_pos] >= 'A' && g_src[g_pos] <= 'Z')
                   || (g_src[g_pos] >= '0' && g_src[g_pos] <= '9')
                   || g_src[g_pos] == '_')) {
                if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                g_pos++;
            }
            g_toktext[n] = 0;
            g_tok = T_ID;
            return;
        }
        if (c >= '0' && c <= '9') {
            g_toknum = 0;
            if (c == '0' && (g_src[g_pos + 1] == 'x' || g_src[g_pos + 1] == 'X')) {
                g_pos += 2;
                for (;;) {
                    char h = g_src[g_pos];
                    int dv;
                    if (h >= '0' && h <= '9') dv = h - '0';
                    else if (h >= 'a' && h <= 'f') dv = h - 'a' + 10;
                    else if (h >= 'A' && h <= 'F') dv = h - 'A' + 10;
                    else break;
                    g_toknum = g_toknum * 16 + dv;
                    g_pos++;
                }
            } else {
                while (g_src[g_pos] >= '0' && g_src[g_pos] <= '9') {
                    g_toknum = g_toknum * 10 + (g_src[g_pos] - '0');
                    g_pos++;
                }
            }
            g_tok = T_NUM;
            return;
        }
        if (c == '"' || c == '\'') {
            char q = (char)c;
            n = 0;
            g_toktext[n] = q;
            n++;
            g_pos++;
            while (g_src[g_pos] && g_src[g_pos] != q) {
                if (g_src[g_pos] == '\\' && g_src[g_pos + 1]) {
                    if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                    g_pos++;
                }
                if (n + 1 < MAX_TEXT) { g_toktext[n] = g_src[g_pos]; n++; }
                g_pos++;
            }
            if (g_src[g_pos] == q) {
                if (n + 1 < MAX_TEXT) { g_toktext[n] = q; n++; }
                g_pos++;
            }
            g_toktext[n] = 0;
            g_tok = T_STR;
            return;
        }
        if (c == '-' && g_src[g_pos + 1] == '>') {
            g_toktext[0] = '-';
            g_toktext[1] = '>';
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos += 2;
            return;
        }
        if (c == ':' && g_src[g_pos + 1] == ':') {
            g_toktext[0] = ':';
            g_toktext[1] = ':';
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos += 2;
            return;
        }
        if ((c == '=' || c == '!' || c == '<' || c == '>') && g_src[g_pos + 1] == '=') {
            g_toktext[0] = (char)c;
            g_toktext[1] = '=';
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos += 2;
            return;
        }
        if ((c == '+' || c == '-') && g_src[g_pos + 1] == c) {
            g_toktext[0] = (char)c;
            g_toktext[1] = (char)c;
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos += 2;
            return;
        }
        /* `&&` and `||` are their own tokens; a lone `&` / `|` stays literal */
        if ((c == '&' || c == '|') && g_src[g_pos + 1] == c) {
            g_toktext[0] = (char)c;
            g_toktext[1] = (char)c;
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos += 2;
            return;
        }
        /* compound assignment: `+=` `-=` `*=` `/=` `%=` */
        if ((c == '+' || c == '-' || c == '*' || c == '/' || c == '%')
            && g_src[g_pos + 1] == '=') {
            g_toktext[0] = (char)c;
            g_toktext[1] = '=';
            g_toktext[2] = 0;
            g_tok = T_PUNCT;
            g_pos += 2;
            return;
        }
        g_toktext[0] = (char)c;
        g_toktext[1] = 0;
        g_tok = T_PUNCT;
        g_pos++;
    }

    int accept(const char *p)
    {
        (void)self;
        if (g_tok == T_PUNCT && strcmp(g_toktext, p) == 0) {
            self->lex_next();
            return 1;
        }
        return 0;
    }

    int expect(const char *p)
    {
        (void)self;
        if (self->accept(p)) return 0;
        return self->fail("unexpected token");
    }

    int read_file(const char *path)
    {
        FILE *f;
        long sz;
        char *buf;

        (void)self;
        f = fopen(path, "rb");
        if (!f) return self->fail("cannot open the input file");
        fseek(f, 0, SEEK_END);
        sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) {
            fclose(f);
            return self->fail("cannot read the input file");
        }
        buf = (char *)malloc((size_t)sz + 1);
        if (!buf) {
            fclose(f);
            return self->fail("out of memory");
        }
        if (sz > 0 && fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
            free(buf);
            fclose(f);
            return self->fail("short read");
        }
        fclose(f);
        buf[sz] = 0;
        g_src = buf;
        return 0;
    }

    int default_output(const char *in, char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = strlen(in);
        if (n >= 3 && strcmp(in + n - 3, ".ct") == 0) {
            if (snprintf(out, cap, "%.*s.c", (int)(n - 3), in) >= (int)cap) return -1;
            return 0;
        }
        if (snprintf(out, cap, "%s.c", in) >= (int)cap) return -1;
        return 0;
    }

    int run(int argc, char **argv)
    {
        const char *in;
        const char *out;
        char outbuf[MAX_PATH];
        int i, prog;
        FILE *f;

        in = NULL;
        out = NULL;
        if (argc > 1 && strcmp(argv[1], "build") == 0)
            return self->build_main(argc - 1, argv + 1);
        g_build_mode = 0;
        g_line_mode = 0;
        g_have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: ct-ast <input.ct> [-o <output.c>] [--line|--no-line] [--emit-map <file|->]\n"
                       "       ct-ast build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                     [--line|--no-line] [--emit-map <file|->]\n");
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("ct-ast v%s\n", CTC_VERSION);
                return 0;
            }
            if (strcmp(argv[i], "--line") == 0) {
                g_line_mode = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                g_line_mode = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(g_map_path, sizeof g_map_path, "%s", argv[i]) >= (int)sizeof g_map_path) {
                    fprintf(stderr, "ct-ast: map path is too long\n");
                    return 1;
                }
                g_have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: -o needs an argument\n");
                    return 1;
                }
                i++;
                out = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ct-ast: unknown option '%s'\n", argv[i]);
                return 1;
            }
            in = argv[i];
        }
        if (!in) {
            fprintf(stderr, "usage: ct-ast <input.ct> [-o <output.c>]\n");
            return 1;
        }
        if (!out) {
            if (self->default_output(in, outbuf, sizeof outbuf) != 0) {
                fprintf(stderr, "ct-ast: output path too long\n");
                return 1;
            }
            out = outbuf;
        }

        g_path = in;
        g_pos = 0;
        g_bol = 1;
        g_line = 1;
        g_tokline = 1;
        g_nnode = 0;
        g_nfunc = 0;
        g_nvar = 0;
        g_nscope = 0;
        g_ntype = 0;
        g_ntraits = 0;
        g_nstructs = 0;
        g_self_mode = 0;
        g_nparams = 0;
        g_ncalls = 0;
        g_cur_func[0] = 0;
        g_errmsg[0] = 0;
        if (self->read_file(in) != 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        prog = self->parse_program();
        if (prog < 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        f = fopen(out, "w");
        if (!f) {
            fprintf(stderr, "ct-ast: cannot write '%s'\n", out);
            return 1;
        }
        g_out = f;
        fprintf(g_out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, g_path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              g_out);
        if (g_line_mode) fprintf(g_out, "#line 1 \"%s\"\n", g_path);
        if (self->emit_program(prog) != 0) {
            fclose(f);
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        if (fclose(f) != 0) {
            fprintf(stderr, "ct-ast: cannot write '%s'\n", out);
            return 1;
        }
        if (self->write_header(out) != 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        if (g_have_map && self->write_map(g_map_path, prog, -1) != 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        return 0;
    }
}

impl SymOps for Ast {
    int push_scope(void)
    {
        (void)self;
        if (g_nscope >= MAX_SCOPE) return self->fail("too many nested scopes");
        g_scope[g_nscope] = g_nvar;
        g_nscope++;
        return 0;
    }

    int pop_scope(void)
    {
        (void)self;
        if (g_nscope <= 0) return self->fail("scope stack underflow");
        g_nscope--;
        g_nvar = g_scope[g_nscope];
        return 0;
    }

    int declare_var(const char *name, const char *type)
    {
        (void)self;
        if (g_nvar >= MAX_VARS) return self->fail("too many variables");
        snprintf(g_vars[g_nvar].name, MAX_TEXT, "%s", name);
        snprintf(g_vars[g_nvar].type, MAX_TEXT, "%s", type);
        g_nvar++;
        return 0;
    }

    int find_var(const char *name)
    {
        int i;
        (void)self;
        for (i = g_nvar - 1; i >= 0; i--)
            if (strcmp(g_vars[i].name, name) == 0) return i;
        return -1;
    }

    int var_type(const char *name, char *out, size_t cap)
    {
        int i;
        (void)self;
        i = self->find_var(name);
        if (i < 0) return -1;
        if (snprintf(out, cap, "%s", g_vars[i].type) >= (int)cap) return -1;
        return 0;
    }

    int find_func(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < g_nfunc; i++)
            if (strcmp(g_funcs[i].name, name) == 0) return i;
        return -1;
    }

    /* A prototype followed by its definition updates the same entry. `pub` on
       either declaration exports the prototype to the unit header. */
    int add_func(const char *name, const char *ret, int is_static, int is_pub, int first_param)
    {
        int i, k, p;
        (void)self;

        i = self->find_func(name);
        if (i < 0) {
            if (g_nfunc >= MAX_FUNCS) return self->fail("too many functions");
            i = g_nfunc;
            g_nfunc++;
            snprintf(g_funcs[i].name, MAX_TEXT, "%s", name);
            g_funcs[i].is_pub = 0;
        }
        if (is_pub) g_funcs[i].is_pub = 1;
        snprintf(g_funcs[i].ret, MAX_TEXT, "%s", ret);
        g_funcs[i].is_static = is_static;
        g_funcs[i].nparams = 0;
        p = first_param;
        k = 0;
        while (p > 0 && k < MAX_PARAMS) {
            snprintf(g_funcs[i].ptype[k], MAX_TEXT, "%s", g_nodes[p].text);
            k++;
            p = g_nodes[p].next;
        }
        if (k >= MAX_PARAMS && p > 0) return self->fail("too many parameters");
        g_funcs[i].nparams = k;
        return i;
    }

    int find_type(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < g_ntype; i++)
            if (strcmp(g_types[i], name) == 0) return i;
        return -1;
    }

    int add_type(const char *name, int kind)
    {
        int i;
        (void)self;
        i = self->find_type(name);
        if (i >= 0) {
            /* a struct tag discovered while parsing a type keeps its kind */
            if (g_type_kind[i] == 0) g_type_kind[i] = kind;
            return 0;
        }
        if (g_ntype >= MAX_TYPES) return self->fail("too many types");
        snprintf(g_types[g_ntype], MAX_TEXT, "%s", name);
        g_type_kind[g_ntype] = kind;
        g_ntype++;
        return 0;
    }

    int find_struct(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < g_nstructs; i++)
            if (strcmp(g_structs[i].name, name) == 0) return i;
        return -1;
    }

    int add_struct(const char *name)
    {
        int i;
        (void)self;
        if (!name[0]) return -1;
        i = self->find_struct(name);
        if (i >= 0) return i;
        if (g_nstructs >= MAX_STRUCTS) return self->fail("too many structs");
        snprintf(g_structs[g_nstructs].name, MAX_TEXT, "%s", name);
        g_structs[g_nstructs].nuse = 0;
        g_nstructs++;
        return g_nstructs - 1;
    }

    int find_trait(const char *name)
    {
        int i;
        (void)self;
        for (i = 0; i < g_ntraits; i++)
            if (strcmp(g_traits[i].name, name) == 0) return i;
        return -1;
    }

    int add_trait(const char *name)
    {
        int i;
        (void)self;
        i = self->find_trait(name);
        if (i >= 0) return i;
        if (g_ntraits >= MAX_TRAITS) return self->fail("too many traits");
        snprintf(g_traits[g_ntraits].name, MAX_TEXT, "%s", name);
        g_traits[g_ntraits].nm = 0;
        g_ntraits++;
        return g_ntraits - 1;
    }

    /* Which trait of `stype` declares `method`: the vtable field name and the
       dispatch target both need it. `stype` may carry a `struct ` prefix or a
       trailing `*` (a pointer receiver). */
    int method_trait(const char *stype, const char *method, char *tout, size_t tcap)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        int s, ti, mi;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", stype) >= (int)sizeof buf) return -1;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            base[n - 1] = 0;
            n--;
        }
        s = self->find_struct(base);
        if (s < 0) return -1;
        for (ti = 0; ti < g_structs[s].nuse; ti++) {
            int t = self->find_trait(g_structs[s].use[ti]);
            if (t < 0) continue;
            for (mi = 0; mi < g_traits[t].nm; mi++) {
                if (strcmp(g_traits[t].m[mi].name, method) == 0) {
                    if (snprintf(tout, tcap, "%s", g_traits[t].name) >= (int)tcap) return -1;
                    return 0;
                }
            }
        }
        return -1;
    }

    /* A declaration inside `namespace A::B` is stored under its C name,
       `A_B_<name>`; the top level adds no prefix. */
    int ns_decl_name(const char *name, char *out, size_t cap)
    {
        (void)self;
        if (snprintf(out, cap, "%s%s", g_ns, name) >= (int)cap)
            return self->fail("name is too long");
        return 0;
    }

    /* Unqualified lookup: the current namespace first, then the top level. */
    int resolve_type(const char *name, char *out, size_t cap)
    {
        char qname[MAX_TEXT];
        (void)self;

        if (g_ns[0]) {
            if (snprintf(qname, sizeof qname, "%s%s", g_ns, name) >= (int)sizeof qname)
                return self->fail("name is too long");
            if (self->find_type(qname) >= 0 || self->find_trait(qname) >= 0
                || self->find_struct(qname) >= 0) {
                if (snprintf(out, cap, "%s", qname) >= (int)cap)
                    return self->fail("name is too long");
                return 0;
            }
        }
        if (snprintf(out, cap, "%s", name) >= (int)cap)
            return self->fail("name is too long");
        return 0;
    }

    /* Remember `callee(...)` inside the function currently being parsed. */
    int record_call(const char *callee, int line)
    {
        (void)self;
        if (!g_cur_func[0]) return 0;
        if (g_ncalls >= MAX_CALLS) return self->fail("too many calls");
        snprintf(g_calls[g_ncalls].caller, MAX_TEXT, "%s", g_cur_func);
        snprintf(g_calls[g_ncalls].callee, MAX_TEXT, "%s", callee);
        g_calls[g_ncalls].line = line;
        g_ncalls++;
        return 0;
    }
}

impl ParseOps for Ast {
    int is_type_word(const char *w)
    {
        (void)self;
        return strcmp(w, "int") == 0 || strcmp(w, "void") == 0
            || strcmp(w, "char") == 0 || strcmp(w, "unsigned") == 0
            || strcmp(w, "signed") == 0 || strcmp(w, "long") == 0
            || strcmp(w, "short") == 0 || strcmp(w, "float") == 0
            || strcmp(w, "double") == 0 || strcmp(w, "const") == 0
            || strcmp(w, "struct") == 0 || strcmp(w, "enum") == 0
            || strcmp(w, "union") == 0 || strcmp(w, "size_t") == 0
            || strcmp(w, "FILE") == 0;
    }

    int type_append(char *out, size_t cap, size_t *n, const char *tok)
    {
        int w;
        (void)self;
        if (*n > 0) {
            if (*n + 1 >= cap) return self->fail("type is too long");
            out[*n] = ' ';
            (*n)++;
        }
        w = snprintf(out + *n, cap - *n, "%s", tok);
        if (w < 0 || (size_t)w >= cap - *n) return self->fail("type is too long");
        *n += (size_t)w;
        return 0;
    }

    /* Consume a type specifier. `struct X` keeps the tag; a known typedef name
       is part of the type; `*` accumulates (9.3 supports a single pointer). */
    int parse_type(char *out, size_t cap)
    {
        size_t n;
        (void)self;

        n = 0;
        out[0] = 0;
        for (;;) {
            if (g_tok == T_ID && self->is_type_word(g_toktext)) {
                if (self->type_append(out, cap, &n, g_toktext) != 0) return -1;
                if (strcmp(g_toktext, "struct") == 0) {
                    char sname[MAX_TEXT];
                    self->lex_next();
                    if (g_tok != T_ID) return self->fail("expected a struct name");
                    if (self->resolve_type(g_toktext, sname, sizeof sname) != 0) return -1;
                    if (self->type_append(out, cap, &n, sname) != 0) return -1;
                    if (self->add_type(sname, 1) != 0) return -1;
                }
                self->lex_next();
                continue;
            }
            if (g_tok == T_ID) {
                int ti;
                char rname[MAX_TEXT];
                char iface[MAX_TEXT];
                if (self->resolve_type(g_toktext, rname, sizeof rname) != 0) return -1;
                ti = self->find_type(rname);
                if (ti < 0) break;
                /* a bare struct tag needs `struct`; a trait becomes its iface */
                if (g_type_kind[ti] == 1) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                } else if (g_type_kind[ti] == 3) {
                    if (self->type_append(out, cap, &n, "struct") != 0) return -1;
                    if (snprintf(iface, sizeof iface, "%s_iface", rname) >= (int)sizeof iface)
                        return self->fail("type name is too long");
                    if (self->type_append(out, cap, &n, iface) != 0) return -1;
                    self->lex_next();
                    continue;
                }
                if (self->type_append(out, cap, &n, rname) != 0) return -1;
                self->lex_next();
                continue;
            }
            if (g_tok == T_PUNCT && strcmp(g_toktext, "*") == 0) {
                if (self->type_append(out, cap, &n, "*") != 0) return -1;
                self->lex_next();
                continue;
            }
            break;
        }
        if (n == 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "expected a type (tok %d '%s')", g_tok, g_toktext);
            return self->fail(msg);
        }
        return 0;
    }

    /* Zero or more `[<len>]` groups after a declared name. The whole suffix is
       kept verbatim in `text3`, so a macro constant (`char buf[MAX_TEXT]`) and a
       second dimension (`[MAX_PARAMS][MAX_TEXT]`) both survive; a numeric length
       keeps `num` for the callers that still read it. */
    int parse_array_dims(int n)
    {
        (void)self;
        while (g_tok == T_PUNCT && strcmp(g_toktext, "[") == 0) {
            char dim[MAX_TEXT];
            char cur[MAX_TEXT];
            self->lex_next();
            if (g_tok == T_NUM) {
                snprintf(dim, sizeof dim, "[%ld]", g_toknum);
            } else if (g_tok == T_ID) {
                snprintf(dim, sizeof dim, "[%s]", g_toktext);
            } else {
                return self->fail("expected an array length");
            }
            self->lex_next();
            if (self->expect("]") != 0) return -1;
            snprintf(cur, sizeof cur, "%s%s", g_nodes[n].text3, dim);
            snprintf(g_nodes[n].text3, MAX_TEXT, "%s", cur);
            g_nodes[n].num = 0;      /* text3 is the authoritative spelling */
        }
        return 0;
    }

    /* One-token lookahead: with the current token at `(`, does the token after it
       start a type? It tells a cast (`(char)c`) from a parenthesised expression
       (`(a + b)`) without consuming anything, so postfix binding stays intact. */
    int next_is_type_name(void)
    {
        int save_tok, save_line, save_bol, save_srcline, res;
        long save_num;
        size_t save_pos;
        char save_text[MAX_TEXT];
        (void)self;
        save_tok = g_tok;
        save_num = g_toknum;
        save_line = g_tokline;
        save_pos = g_pos;
        save_srcline = g_line;
        save_bol = g_bol;
        snprintf(save_text, sizeof save_text, "%s", g_toktext);
        self->lex_next();
        res = (g_tok == T_ID && (self->is_type_word(g_toktext)
                                 || self->find_type(g_toktext) >= 0));
        g_tok = save_tok;
        g_toknum = save_num;
        g_tokline = save_line;
        g_pos = save_pos;
        g_line = save_srcline;
        g_bol = save_bol;
        snprintf(g_toktext, MAX_TEXT, "%s", save_text);
        return res;
    }

    int parse_program(void)
    {
        int prog, n;
        (void)self;

        prog = self->new_node(N_PROG);
        if (prog < 0) return -1;
        self->lex_next();
        while (g_tok != T_EOF) {
            if (g_tok == T_PP) {
                n = self->new_node(N_PP);
                if (n < 0) return -1;
                snprintf(g_nodes[n].text, MAX_TEXT, "%s", g_toktext);
                if (self->append_node(prog, n) != 0) return -1;
                self->lex_next();
                continue;
            }
            if (g_tok == T_ID && strcmp(g_toktext, "import") == 0) {
                if (!g_build_mode)
                    return self->fail("'import' is not supported in compile mode");
                if (self->skip_import() != 0) return -1;
                continue;
            }
            if (g_tok == T_ID && strcmp(g_toktext, "namespace") == 0) {
                if (self->parse_namespace(prog) != 0) return -1;
                continue;
            }
            n = self->parse_top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) return -1;
            if (self->append_node(prog, n) != 0) return -1;
        }
        return prog;
    }

    /* A function (prototype or definition) or a global variable. */
    int parse_func(int is_static, int is_pub)
    {
        int f, b, params, fi, func_line;
        char ret[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        func_line = g_tokline;
        if (self->parse_type(ret, sizeof ret) != 0) return -1;
        if (g_tok != T_ID) return self->fail("expected a name");
        snprintf(name, sizeof name, "%s", g_toktext);
        self->lex_next();
        if (g_tok != T_PUNCT || strcmp(g_toktext, "(") != 0) {
            int g, e;
            g = self->new_node(N_GLOBAL);
            if (g < 0) return -1;
            snprintf(g_nodes[g].text, MAX_TEXT, "%s", ret);
            snprintf(g_nodes[g].text2, MAX_TEXT, "%s", name);
            g_nodes[g].aux = is_static;
            g_nodes[g].d = is_pub;
            g_nodes[g].line = func_line;
            /* a file-scope name is visible to every function body */
            if (self->declare_var(name, ret) != 0) return -1;
            if (self->parse_array_dims(g) != 0) return -1;
            if (self->accept("=")) {
                if (g_tok == T_PUNCT && strcmp(g_toktext, "{") == 0) {
                    char raw[MAX_TEXT];
                    e = self->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->parse_init_raw(raw, sizeof raw) != 0) return -1;
                    snprintf(g_nodes[e].text, MAX_TEXT, "%s", raw);
                } else {
                    e = self->parse_expr();
                    if (e < 0) return -1;
                }
                g_nodes[g].a = e;
            }
            if (self->expect(";") != 0) return -1;
            return g;
        }
        if (self->push_scope() != 0) return -1;
        params = self->parse_params();
        if (params < 0) {
            self->pop_scope();
            return -1;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
            self->lex_next();
            fi = self->add_func(name, ret, is_static, is_pub, params);
            if (fi < 0) {
                self->pop_scope();
                return -1;
            }
            g_funcs[fi].line = func_line;
            self->pop_scope();
            return NO_NODE;
        }
        snprintf(g_ret_type, sizeof g_ret_type, "%s", ret);
        snprintf(g_cur_func, sizeof g_cur_func, "%s", name);
        b = self->parse_block();
        g_cur_func[0] = 0;
        g_ret_type[0] = 0;
        if (b < 0) {
            self->pop_scope();
            return -1;
        }
        fi = self->add_func(name, ret, is_static, is_pub, params);
        if (fi < 0) {
            self->pop_scope();
            return -1;
        }
        g_funcs[fi].line = func_line;
        f = self->new_node(N_FUNC);
        if (f < 0) {
            self->pop_scope();
            return -1;
        }
        snprintf(g_nodes[f].text, MAX_TEXT, "%s", ret);
        snprintf(g_nodes[f].text2, MAX_TEXT, "%s", name);
        g_nodes[f].aux = is_static;
        g_nodes[f].d = is_pub;
        g_nodes[f].line = func_line;
        g_nodes[f].a = params;
        g_nodes[f].b = b;
        self->pop_scope();
        return f;
    }

    int parse_params(void)
    {
        int first, tail, p;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        g_nparams = 0;
        first = 0;
        tail = 0;
        if (self->expect("(") != 0) return -1;
        if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        for (;;) {
            if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0 &&
                strcmp(typebuf, "void") == 0) {
                self->lex_next();
                return 0;
            }
            if (g_tok != T_ID) return self->fail("expected a parameter name");
            snprintf(name, sizeof name, "%s", g_toktext);
            self->lex_next();
            p = self->new_node(N_PARAM);
            if (p < 0) return -1;
            snprintf(g_nodes[p].text, MAX_TEXT, "%s", typebuf);
            snprintf(g_nodes[p].text2, MAX_TEXT, "%s", name);
            if (self->declare_var(name, typebuf) != 0) return -1;
            if (tail == 0) first = p;
            else g_nodes[tail].next = p;
            tail = p;
            g_nparams++;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }

    int parse_field_def(void)
    {
        int m;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        if (g_tok != T_ID) return self->fail("expected a field name");
        snprintf(name, sizeof name, "%s", g_toktext);
        self->lex_next();
        m = self->new_node(N_FIELD);
        if (m < 0) return -1;
        snprintf(g_nodes[m].text, MAX_TEXT, "%s", typebuf);
        snprintf(g_nodes[m].text2, MAX_TEXT, "%s", name);
        if (self->parse_array_dims(m) != 0) return -1;
        if (self->expect(";") != 0) return -1;
        return m;
    }

    /* `struct Name { ... }` (the trailing `;` is the caller's business). */
    int parse_struct_def(void)
    {
        int s, tail, m, struct_line;
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        (void)self;

        struct_line = g_tokline;
        self->lex_next();
        name[0] = 0;
        qname[0] = 0;
        if (g_tok == T_ID) {
            snprintf(name, sizeof name, "%s", g_toktext);
            if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
            if (self->add_type(qname, 1) != 0) return -1;
            if (self->add_struct(qname) < 0) return -1;
            self->lex_next();
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
            /* `struct X;` -- a forward declaration: the tag is registered above,
               so `struct X *p` parses; the body may follow later */
            self->lex_next();
            return NO_NODE;
        }
        if (self->expect("{") != 0) return -1;
        s = self->new_node(N_STRUCT);
        if (s < 0) return -1;
        g_nodes[s].line = struct_line;
        snprintf(g_nodes[s].text2, MAX_TEXT, "%s", qname);
        tail = -1;
        g_npend = 0;
        while (g_tok != T_EOF && !(g_tok == T_PUNCT && strcmp(g_toktext, "}") == 0)) {
            m = self->parse_field_def();
            if (m < 0) return -1;
            /* record the field type: receiver chains and nested vptr writes need it.
               An untagged body (typedef struct { ... }) lands in the pending list,
               which parse_typedef attaches to the alias. */
            if (qname[0]) {
                int si2 = self->find_struct(qname);
                if (si2 >= 0 && g_structs[si2].nfields < MAX_FIELDS) {
                    snprintf(g_structs[si2].fields[g_structs[si2].nfields].name, MAX_TEXT,
                             "%s", g_nodes[m].text2);
                    snprintf(g_structs[si2].fields[g_structs[si2].nfields].type, MAX_TEXT,
                             "%s", g_nodes[m].text);
                    g_structs[si2].nfields++;
                }
            } else if (g_npend < MAX_FIELDS) {
                snprintf(g_pend_fields[g_npend].name, MAX_TEXT, "%s", g_nodes[m].text2);
                snprintf(g_pend_fields[g_npend].type, MAX_TEXT, "%s", g_nodes[m].text);
                g_npend++;
            }
            if (tail < 0) g_nodes[s].a = m;
            else g_nodes[tail].next = m;
            tail = m;
        }
        if (self->expect("}") != 0) return -1;
        if (g_tok == T_ID && strcmp(g_toktext, "use") == 0) {
            self->lex_next();
            if (qname[0] && self->parse_use_list(self->find_struct(qname)) != 0) return -1;
        }
        return s;
    }

    /* `typedef struct { ... } Name;` or `typedef <type> Name;`. */
    int parse_typedef(int is_pub)
    {
        int t, td_line;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        (void)self;

        td_line = g_tokline;
        self->lex_next();
        if (g_tok == T_ID && strcmp(g_toktext, "struct") == 0) {
            t = self->parse_struct_def();
            if (t < 0) return -1;
            if (g_tok != T_ID) return self->fail("expected a typedef name");
            snprintf(name, sizeof name, "%s", g_toktext);
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
            /* keep the tag in `text`: `typedef struct Tag {...} Alias;` must emit
               the tag, or a `struct Tag` reference elsewhere is incomplete */
            snprintf(g_nodes[t].text, MAX_TEXT, "%s", g_nodes[t].text2);
            snprintf(g_nodes[t].text2, MAX_TEXT, "%s", qname);
            g_nodes[t].aux = 1;
            g_nodes[t].d = is_pub;
            g_nodes[t].line = td_line;
            if (self->add_type(qname, 2) != 0) return -1;
            if (self->add_struct(qname) < 0) return -1;
            /* the tag and the alias are two table entries: give the alias the
               `use` list the body attached to the tag, or its vptr fields vanish */
            {
                int tagi = -1, ai, ui;
                if (g_nodes[t].text[0]) tagi = self->find_struct(g_nodes[t].text);
                ai = self->find_struct(qname);
                if (tagi >= 0 && ai >= 0 && tagi != ai) {
                    g_structs[ai].nuse = g_structs[tagi].nuse;
                    for (ui = 0; ui < g_structs[tagi].nuse; ui++)
                        snprintf(g_structs[ai].use[ui], MAX_TEXT, "%s", g_structs[tagi].use[ui]);
                    g_structs[ai].nfields = g_structs[tagi].nfields;
                    for (ui = 0; ui < g_structs[tagi].nfields; ui++) {
                        snprintf(g_structs[ai].fields[ui].name, MAX_TEXT, "%s",
                                 g_structs[tagi].fields[ui].name);
                        snprintf(g_structs[ai].fields[ui].type, MAX_TEXT, "%s",
                                 g_structs[tagi].fields[ui].type);
                    }
                } else if (ai >= 0 && !g_nodes[t].text[0]) {
                    /* an untagged body: the pending list belongs to this alias */
                    g_structs[ai].nfields = g_npend;
                    for (ui = 0; ui < g_npend; ui++) {
                        snprintf(g_structs[ai].fields[ui].name, MAX_TEXT, "%s",
                                 g_pend_fields[ui].name);
                        snprintf(g_structs[ai].fields[ui].type, MAX_TEXT, "%s",
                                 g_pend_fields[ui].type);
                    }
                }
            }
            return t;
        }
        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        if (g_tok != T_ID) return self->fail("expected a typedef name");
        snprintf(name, sizeof name, "%s", g_toktext);
        self->lex_next();
        if (self->expect(";") != 0) return -1;
        if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
        t = self->new_node(N_TYPEDEF);
        if (t < 0) return -1;
        snprintf(g_nodes[t].text, MAX_TEXT, "%s", typebuf);
        snprintf(g_nodes[t].text2, MAX_TEXT, "%s", qname);
        g_nodes[t].d = is_pub;
        g_nodes[t].line = td_line;
        if (self->add_type(qname, 2) != 0) return -1;
        return t;
    }

    /* `use A, B` after a struct body; the trailing `;` stays with the caller. */
    int parse_use_list(int sindex)
    {
        char tname[MAX_TEXT];
        (void)self;
        if (sindex < 0) return self->fail("unknown struct in 'use'");
        for (;;) {
            if (g_tok != T_ID) return self->fail("expected a trait name");
            if (self->resolve_type(g_toktext, tname, sizeof tname) != 0) return -1;
            if (g_structs[sindex].nuse >= MAX_TRAITS) return self->fail("too many used traits");
            snprintf(g_structs[sindex].use[g_structs[sindex].nuse], MAX_TEXT, "%s", tname);
            g_structs[sindex].nuse++;
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        return 0;
    }

    /* `trait Name { ret m(params); ... }` -- no node, the table is enough. */
    int parse_trait(int is_pub)
    {
        int ti, mi, np, trait_line;
        char name[MAX_TEXT];
        char qname[MAX_TEXT];
        char ret[MAX_TEXT];
        char ptype[MAX_TEXT];
        (void)self;

        trait_line = g_tokline;
        self->lex_next();
        if (g_tok != T_ID) return self->fail("expected a trait name");
        snprintf(name, sizeof name, "%s", g_toktext);
        if (self->ns_decl_name(name, qname, sizeof qname) != 0) return -1;
        ti = self->add_trait(qname);
        if (ti < 0) return -1;
        g_traits[ti].is_pub = is_pub;
        g_traits[ti].line = trait_line;
        if (self->add_type(qname, 3) != 0) return -1;   /* trait = iface type */
        self->lex_next();
        if (self->expect("{") != 0) return -1;
        while (g_tok != T_EOF && !(g_tok == T_PUNCT && strcmp(g_toktext, "}") == 0)) {
            if (self->parse_type(ret, sizeof ret) != 0) return -1;
            if (g_tok != T_ID) return self->fail("expected a method name");
            if (g_traits[ti].nm >= MAX_METHODS) return self->fail("too many trait methods");
            mi = g_traits[ti].nm;
            snprintf(g_traits[ti].m[mi].name, MAX_TEXT, "%s", g_toktext);
            snprintf(g_traits[ti].m[mi].ret, MAX_TEXT, "%s", ret);
            g_traits[ti].m[mi].nparams = 0;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (g_tok == T_ID && strcmp(g_toktext, "void") == 0) {
                self->lex_next();
                if (self->expect(")") != 0) return -1;
                if (self->expect(";") != 0) return -1;
                g_traits[ti].nm++;
                continue;
            }
            np = 0;
            if (!(g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0)) {
                for (;;) {
                    if (self->parse_type(ptype, sizeof ptype) != 0) return -1;
                    if (g_tok == T_ID) self->lex_next();
                    if (np >= MAX_PARAMS) return self->fail("too many method parameters");
                    snprintf(g_traits[ti].m[mi].ptype[np], MAX_TEXT, "%s", ptype);
                    np++;
                    if (g_tok == T_PUNCT && strcmp(g_toktext, ",") == 0) {
                        self->lex_next();
                        continue;
                    }
                    break;
                }
            }
            if (self->expect(")") != 0) return -1;
            if (self->expect(";") != 0) return -1;
            g_traits[ti].m[mi].nparams = np;
            g_traits[ti].nm++;
        }
        if (self->expect("}") != 0) return -1;
        return NO_NODE;
    }

    /* `impl T for S { methods }` -- one N_IMPL node carrying N_METHOD children. */
    int parse_impl(void)
    {
        int ti, si, node, mnode, params, body, tail, impl_line;
        char tname[MAX_TEXT];
        char sname[MAX_TEXT];
        char rtrait[MAX_TEXT];
        char rstruct[MAX_TEXT];
        char ret[MAX_TEXT];
        char mname[MAX_TEXT];
        char stype[MAX_TEXT];
        int type_index;
        (void)self;

        impl_line = g_tokline;
        self->lex_next();
        if (g_tok != T_ID) return self->fail("expected a trait name");
        snprintf(tname, sizeof tname, "%s", g_toktext);
        if (self->resolve_type(tname, rtrait, sizeof rtrait) != 0) return -1;
        ti = self->find_trait(rtrait);
        if (ti < 0) return self->fail("impl of an unknown trait");
        self->lex_next();
        if (g_tok != T_ID || strcmp(g_toktext, "for") != 0)
            return self->fail("expected 'for' after the trait name");
        self->lex_next();
        if (g_tok != T_ID) return self->fail("expected a struct name");
        snprintf(sname, sizeof sname, "%s", g_toktext);
        if (self->resolve_type(sname, rstruct, sizeof rstruct) != 0) return -1;
        si = self->find_struct(rstruct);
        if (si < 0) si = self->add_struct(rstruct);
        if (si < 0) return -1;
        type_index = self->find_type(rstruct);
        if (type_index >= 0 && g_type_kind[type_index] == 1)
            snprintf(stype, sizeof stype, "struct %s", rstruct);
        else
            snprintf(stype, sizeof stype, "%s", rstruct);
        self->lex_next();
        if (self->expect("{") != 0) return -1;
        node = self->new_node(N_IMPL);
        if (node < 0) return -1;
        g_nodes[node].line = impl_line;
        snprintf(g_nodes[node].text2, MAX_TEXT, "%s", rtrait);
        g_nodes[node].aux = si;
        snprintf(g_nodes[node].text, MAX_TEXT, "%s", stype);
        tail = -1;
        while (g_tok != T_EOF && !(g_tok == T_PUNCT && strcmp(g_toktext, "}") == 0)) {
            if (self->parse_type(ret, sizeof ret) != 0) return -1;
            if (g_tok != T_ID) return self->fail("expected a method name");
            snprintf(mname, sizeof mname, "%s", g_toktext);
            self->lex_next();
            if (self->push_scope() != 0) return -1;
            if (self->declare_var("self", stype) != 0) {
                self->pop_scope();
                return -1;
            }
            params = self->parse_params();
            if (params < 0) {
                self->pop_scope();
                return -1;
            }
            snprintf(g_ret_type, sizeof g_ret_type, "%s", ret);
            snprintf(g_cur_func, sizeof g_cur_func, "%s_%s_%s",
                     g_structs[si].name, rtrait, mname);
            body = self->parse_block();
            g_cur_func[0] = 0;
            g_ret_type[0] = 0;
            if (body < 0) {
                self->pop_scope();
                return -1;
            }
            self->pop_scope();
            mnode = self->new_node(N_METHOD);
            if (mnode < 0) return -1;
            snprintf(g_nodes[mnode].text, MAX_TEXT, "%s", ret);
            snprintf(g_nodes[mnode].text2, MAX_TEXT, "%s", mname);
            g_nodes[mnode].a = params;
            g_nodes[mnode].b = body;
            g_nodes[mnode].num = ti;
            g_nodes[mnode].aux = si;
            if (tail < 0) g_nodes[node].a = mnode;
            else g_nodes[tail].next = mnode;
            tail = mnode;
        }
        if (self->expect("}") != 0) return -1;
        return node;
    }

    /* Capture a `{ ... }` initializer verbatim; the caller appends vptr items. */
    int parse_init_raw(char *out, size_t cap)
    {
        int depth, n, c;
        (void)self;

        n = 0;
        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
        out[n] = '{';
        n++;
        depth = 1;
        while (g_src[g_pos] && depth > 0) {
            c = (unsigned char)g_src[g_pos];
            if (c == '"') {
                if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                out[n] = '"';
                n++;
                g_pos++;
                while (g_src[g_pos] && g_src[g_pos] != '"') {
                    if (g_src[g_pos] == '\\' && g_src[g_pos + 1]) {
                        if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                        out[n] = g_src[g_pos];
                        n++;
                        g_pos++;
                    }
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = g_src[g_pos];
                    n++;
                    g_pos++;
                }
                if (g_src[g_pos] == '"') {
                    if (n + 1 >= (int)cap) return self->fail("initializer is too long");
                    out[n] = '"';
                    n++;
                    g_pos++;
                }
                continue;
            }
            if (c == '{') depth++;
            else if (c == '}') depth--;
            if (n + 1 >= (int)cap) return self->fail("initializer is too long");
            out[n] = (char)c;
            n++;
            g_pos++;
        }
        if (depth != 0) return self->fail("unterminated initializer");
        out[n] = 0;
        self->lex_next();
        return 0;
    }

    int parse_block(void)
    {
        int blk, tail, s;
        (void)self;

        if (self->expect("{") != 0) return -1;
        if (self->push_scope() != 0) return -1;
        blk = self->new_node(N_BLOCK);
        if (blk < 0) {
            self->pop_scope();
            return -1;
        }
        tail = -1;
        while (g_tok != T_EOF && !(g_tok == T_PUNCT && strcmp(g_toktext, "}") == 0)) {
            s = self->parse_stmt();
            if (s < 0) {
                self->pop_scope();
                return -1;
            }
            if (tail < 0) g_nodes[blk].a = s;
            else g_nodes[tail].next = s;
            tail = s;
        }
        if (self->expect("}") != 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        return blk;
    }

    int parse_stmt(void)
    {
        int s, e, c;
        (void)self;

        if (g_tok == T_PUNCT && strcmp(g_toktext, "{") == 0) return self->parse_block();
        if (g_tok == T_ID && strcmp(g_toktext, "return") == 0) {
            s = self->new_node(N_RET);
            if (s < 0) return -1;
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
                self->lex_next();
                return s;
            }
            e = self->parse_expr();
            if (e < 0) return -1;
            {
                char tr[MAX_TEXT];
                if (self->is_iface_type(g_ret_type, tr, sizeof tr)) {
                    e = self->maybe_box(e, tr);
                    if (e < 0) return -1;
                }
            }
            g_nodes[s].a = e;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "delete") == 0) {
            s = self->new_node(N_DELETE);
            if (s < 0) return -1;
            self->lex_next();
            e = self->parse_expr();
            if (e < 0) return -1;
            g_nodes[s].a = e;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "break") == 0) {
            s = self->new_node(N_BREAK);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "continue") == 0) {
            s = self->new_node(N_CONT);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect(";") != 0) return -1;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "if") == 0) {
            s = self->new_node(N_IF);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            g_nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            g_nodes[s].b = e;
            if (g_tok == T_ID && strcmp(g_toktext, "else") == 0) {
                self->lex_next();
                e = self->parse_branch();
                if (e < 0) return -1;
                g_nodes[s].c = e;
            }
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "while") == 0) {
            s = self->new_node(N_WHILE);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            c = self->parse_expr();
            if (c < 0) return -1;
            if (self->expect(")") != 0) return -1;
            g_nodes[s].a = c;
            e = self->parse_branch();
            if (e < 0) return -1;
            g_nodes[s].b = e;
            return s;
        }
        if (g_tok == T_ID && strcmp(g_toktext, "for") == 0) {
            s = self->new_node(N_FOR);
            if (s < 0) return -1;
            self->lex_next();
            if (self->expect("(") != 0) return -1;
            if (self->push_scope() != 0) return -1;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
                g_nodes[s].a = -1;
            } else if (g_tok == T_ID && (self->is_type_word(g_toktext)
                       || self->find_type(g_toktext) >= 0)) {
                e = self->parse_decl_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].a = e;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].a = e;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (g_tok == T_PUNCT && strcmp(g_toktext, ";") == 0) {
                g_nodes[s].b = -1;
            } else {
                c = self->parse_expr();
                if (c < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].b = c;
            }
            if (self->expect(";") != 0) {
                self->pop_scope();
                return -1;
            }
            if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0) {
                g_nodes[s].c = -1;
            } else {
                e = self->parse_expr_stmt_node();
                if (e < 0) {
                    self->pop_scope();
                    return -1;
                }
                g_nodes[s].c = e;
            }
            if (self->expect(")") != 0) {
                self->pop_scope();
                return -1;
            }
            e = self->parse_branch();
            if (e < 0) {
                self->pop_scope();
                return -1;
            }
            g_nodes[s].d = e;
            self->pop_scope();
            return s;
        }
        if (g_tok == T_ID && (self->is_type_word(g_toktext)
                              || self->find_type(g_toktext) >= 0)) {
            s = self->parse_decl_node();
            if (s < 0) return -1;
            if (self->expect(";") != 0) return -1;
            return s;
        }
        s = self->parse_expr_stmt_node();
        if (s < 0) return -1;
        if (self->expect(";") != 0) return -1;
        return s;
    }

    int parse_branch(void)
    {
        int b, s;
        (void)self;

        if (g_tok == T_PUNCT && strcmp(g_toktext, "{") == 0) return self->parse_block();
        if (self->push_scope() != 0) return -1;
        s = self->parse_stmt();
        if (s < 0) {
            self->pop_scope();
            return -1;
        }
        self->pop_scope();
        b = self->new_node(N_BLOCK);
        if (b < 0) return -1;
        g_nodes[b].a = s;
        return b;
    }

    /* `<type> name[dims] [= expr] (, name[dims] [= expr])*` without the trailing
       semicolon. Several declarators share the type and come back as an N_DECLS
       wrapper, so every consumer still sees one statement node. */
    int parse_decl_node(void)
    {
        int n, e, head, tail, base_stars, first_decl;
        char typebuf[MAX_TEXT];
        char name[MAX_TEXT];
        (void)self;

        if (self->parse_type(typebuf, sizeof typebuf) != 0) return -1;
        head = -1;
        tail = -1;
        base_stars = 0;
        first_decl = 1;
        for (;;) {
            int stars = 0, si;
            size_t tl;
            char t2[MAX_TEXT];

            while (g_tok == T_PUNCT && strcmp(g_toktext, "*") == 0) {
                stars++;
                self->lex_next();
            }
            /* `parse_type` folds the first declarator's stars into the type; each
               later declarator brings its own, so the star suffix is rebuilt per
               declarator (`const char *p, *q;` and `int *a, **b;` both work) */
            tl = strlen(typebuf);
            while (tl > 0 && (typebuf[tl - 1] == '*' || typebuf[tl - 1] == ' ')) {
                if (first_decl && typebuf[tl - 1] == '*') base_stars++;
                tl--;
            }
            typebuf[tl] = 0;
            if (first_decl) {
                stars = base_stars;
                first_decl = 0;
            }
            for (si = 0; si < stars; si++) {
                snprintf(t2, sizeof t2, "%s *", typebuf);
                snprintf(typebuf, sizeof typebuf, "%s", t2);
            }
            if (g_tok != T_ID) return self->fail("expected a variable name");
            snprintf(name, sizeof name, "%s", g_toktext);
            self->lex_next();
            n = self->new_node(N_DECL);
            if (n < 0) return -1;
            snprintf(g_nodes[n].text, MAX_TEXT, "%s", typebuf);
            snprintf(g_nodes[n].text2, MAX_TEXT, "%s", name);
            if (self->declare_var(name, typebuf) != 0) return -1;
            if (self->parse_array_dims(n) != 0) return -1;
            if (g_tok == T_PUNCT && strcmp(g_toktext, "=") == 0) {
                self->lex_next();
                if (g_tok == T_PUNCT && strcmp(g_toktext, "{") == 0) {
                    char raw[MAX_TEXT];
                    e = self->new_node(N_RAW);
                    if (e < 0) return -1;
                    if (self->parse_init_raw(raw, sizeof raw) != 0) return -1;
                    snprintf(g_nodes[e].text, MAX_TEXT, "%s", raw);
                } else {
                    e = self->parse_expr();
                    if (e < 0) return -1;
                }
                g_nodes[n].a = e;
            }
            if (g_nodes[n].a >= 0) {
                char tr[MAX_TEXT];
                if (self->is_iface_type(typebuf, tr, sizeof tr)) {
                    e = self->maybe_box(g_nodes[n].a, tr);
                    if (e < 0) return -1;
                    g_nodes[n].a = e;
                }
            }
            if (head < 0) head = n;
            else g_nodes[tail].next = n;
            tail = n;
            if (!self->accept(",")) break;
        }
        if (g_nodes[head].next >= 0) {
            int w = self->new_node(N_DECLS);
            if (w < 0) return -1;
            g_nodes[w].a = head;
            return w;
        }
        return head;
    }

    int parse_expr_stmt_node(void)
    {
        int e, rhs, n;
        (void)self;

        e = self->parse_expr();
        if (e < 0) return -1;
        if (g_tok == T_PUNCT && (strcmp(g_toktext, "+=") == 0 || strcmp(g_toktext, "-=") == 0
                                 || strcmp(g_toktext, "*=") == 0 || strcmp(g_toktext, "/=") == 0
                                 || strcmp(g_toktext, "%=") == 0)) {
            int op = 0, k2;
            char oc = g_toktext[0];
            k2 = g_nodes[e].kind;
            if (k2 != N_VAR && k2 != N_MEMBER && k2 != N_ARROW && k2 != N_INDEX && k2 != N_DEREF)
                return self->fail("assignment target is not assignable");
            if (oc == '+') op = 1;
            else if (oc == '-') op = 2;
            else if (oc == '*') op = 3;
            else if (oc == '/') op = 4;
            else op = 5;
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            n = self->new_node(N_ASSIGN);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            g_nodes[n].b = rhs;
            g_nodes[n].aux = op;
            return n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "=") == 0) {
            int k;
            char tt[MAX_TEXT];
            char tr[MAX_TEXT];
            k = g_nodes[e].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->fail("assignment target is not assignable");
            self->lex_next();
            rhs = self->parse_expr();
            if (rhs < 0) return -1;
            if ((k == N_VAR && self->var_type(g_nodes[e].text2, tt, sizeof tt) == 0)
                || (k == N_INDEX && self->expr_type(e, tt, sizeof tt) == 0)) {
                if (self->is_iface_type(tt, tr, sizeof tr)) {
                    rhs = self->maybe_box(rhs, tr);
                    if (rhs < 0) return -1;
                }
            }
            n = self->new_node(N_ASSIGN);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            g_nodes[n].b = rhs;
            return n;
        }
        if (g_nodes[e].kind == N_POST) return e;
        n = self->new_node(N_EXPR);
        if (n < 0) return -1;
        g_nodes[n].a = e;
        return n;
    }

    int parse_expr(void)
    {
        int left, right, inner, n, c;
        (void)self;

        /* `&&` binds tighter than `||`; both are looser than parse_cmp's operators.
           The loops live here so the trait's method budget stays put. */
        left = self->parse_cmp();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT && strcmp(g_toktext, "&&") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = B_AND;
            left = n;
        }
        while (g_tok == T_PUNCT && strcmp(g_toktext, "||") == 0) {
            self->lex_next();
            right = self->parse_cmp();
            if (right < 0) return -1;
            while (g_tok == T_PUNCT && strcmp(g_toktext, "&&") == 0) {
                self->lex_next();
                inner = self->parse_cmp();
                if (inner < 0) return -1;
                n = self->new_node(N_BIN);
                if (n < 0) return -1;
                g_nodes[n].a = right;
                g_nodes[n].b = inner;
                g_nodes[n].aux = B_AND;
                right = n;
            }
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = B_OR;
            left = n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "?") == 0) {
            int a, b;
            self->lex_next();
            a = self->parse_expr();
            if (a < 0) return -1;
            if (self->expect(":") != 0) return -1;
            b = self->parse_expr();
            if (b < 0) return -1;
            c = self->new_node(N_TERN);
            if (c < 0) return -1;
            g_nodes[c].a = left;
            g_nodes[c].b = a;
            g_nodes[c].c = b;
            return c;
        }
        return left;
    }

    int parse_cmp(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_add();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT) {
            op = 0;
            if (strcmp(g_toktext, "<") == 0) op = B_LT;
            else if (strcmp(g_toktext, ">") == 0) op = B_GT;
            else if (strcmp(g_toktext, "<=") == 0) op = B_LE;
            else if (strcmp(g_toktext, ">=") == 0) op = B_GE;
            else if (strcmp(g_toktext, "==") == 0) op = B_EQ;
            else if (strcmp(g_toktext, "!=") == 0) op = B_NE;
            if (op == 0) break;
            self->lex_next();
            right = self->parse_add();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_add(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_mul();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT && (strcmp(g_toktext, "+") == 0 || strcmp(g_toktext, "-") == 0)) {
            op = (g_toktext[0] == '+') ? B_ADD : B_SUB;
            self->lex_next();
            right = self->parse_mul();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_mul(void)
    {
        int left, right, n, op;
        (void)self;

        left = self->parse_unary();
        if (left < 0) return -1;
        while (g_tok == T_PUNCT && (strcmp(g_toktext, "*") == 0
               || strcmp(g_toktext, "/") == 0 || strcmp(g_toktext, "%") == 0)) {
            op = B_MUL;
            if (g_toktext[0] == '/') op = B_DIV;
            else if (g_toktext[0] == '%') op = B_MOD;
            self->lex_next();
            right = self->parse_unary();
            if (right < 0) return -1;
            n = self->new_node(N_BIN);
            if (n < 0) return -1;
            g_nodes[n].a = left;
            g_nodes[n].b = right;
            g_nodes[n].aux = op;
            left = n;
        }
        return left;
    }

    int parse_unary(void)
    {
        int n, e, op;
        (void)self;

        if (g_tok == T_ID && strcmp(g_toktext, "sizeof") == 0) {
            char tbuf[MAX_TEXT];
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0
                && self->next_is_type_name()) {
                self->lex_next();
                if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
                if (self->expect(")") != 0) return -1;
                n = self->new_node(N_SIZEOF);
                if (n < 0) return -1;
                snprintf(g_nodes[n].text, MAX_TEXT, "%s", tbuf);
                g_nodes[n].aux = 1;
                return n;
            }
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_SIZEOF);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            return n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0
            && self->next_is_type_name()) {
            char tbuf[MAX_TEXT];
            self->lex_next();
            if (self->parse_type(tbuf, sizeof tbuf) != 0) return -1;
            if (self->expect(")") != 0) return -1;
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_CAST);
            if (n < 0) return -1;
            snprintf(g_nodes[n].text, MAX_TEXT, "%s", tbuf);
            g_nodes[n].a = e;
            return n;
        }
        op = 0;
        if (g_tok == T_PUNCT && strcmp(g_toktext, "-") == 0) op = U_NEG;
        else if (g_tok == T_PUNCT && strcmp(g_toktext, "!") == 0) op = U_NOT;
        if (op != 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_UNARY);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            g_nodes[n].aux = op;
            return n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "&") == 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_ADDR);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            return n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "*") == 0) {
            self->lex_next();
            e = self->parse_unary();
            if (e < 0) return -1;
            n = self->new_node(N_DEREF);
            if (n < 0) return -1;
            g_nodes[n].a = e;
            return n;
        }
        return self->parse_postfix();
    }

    int parse_postfix(void)
    {
        int n, m, idx, args;
        char fname[MAX_TEXT];
        char rtype[MAX_TEXT];
        char trname[MAX_TEXT];
        (void)self;

        n = self->parse_primary();
        if (n < 0) return -1;
        for (;;) {
            if (g_tok == T_PUNCT && strcmp(g_toktext, "[") == 0) {
                self->lex_next();
                idx = self->parse_expr();
                if (idx < 0) return -1;
                if (self->expect("]") != 0) return -1;
                m = self->new_node(N_INDEX);
                if (m < 0) return -1;
                g_nodes[m].a = n;
                g_nodes[m].b = idx;
                n = m;
                continue;
            }
            if (g_tok == T_PUNCT && (strcmp(g_toktext, ".") == 0
                                     || strcmp(g_toktext, "->") == 0)) {
                int arrow;
                arrow = (g_toktext[0] == '-') ? 1 : 0;
                self->lex_next();
                if (g_tok != T_ID) return self->fail("expected a field or method name");
                snprintf(fname, sizeof fname, "%s", g_toktext);
                self->lex_next();
                if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0) {
                    args = self->parse_args();
                    if (args < 0) return -1;
                    m = self->new_node(N_MCALL);
                    if (m < 0) return -1;
                    g_nodes[m].a = n;
                    g_nodes[m].b = (args == 0) ? -1 : args;
                    g_nodes[m].aux = arrow ? 2 : 1;
                    snprintf(g_nodes[m].text2, MAX_TEXT, "%s", fname);
                    /* resolve the trait now: locals are out of scope by the time
                       the emitter runs */
                    if (self->expr_type(n, rtype, sizeof rtype) == 0) {
                        if (self->is_iface_type(rtype, trname, sizeof trname)) {
                            int t = self->find_trait(trname);
                            int mi, ok = 0;
                            if (t >= 0) {
                                for (mi = 0; mi < g_traits[t].nm; mi++)
                                    if (strcmp(g_traits[t].m[mi].name, fname) == 0) ok = 1;
                            }
                            if (ok) {
                                g_nodes[m].aux = 3;
                                snprintf(g_nodes[m].text, MAX_TEXT, "%s", trname);
                            }
                        } else if (self->method_trait(rtype, fname, trname, sizeof trname) == 0) {
                            snprintf(g_nodes[m].text, MAX_TEXT, "%s", trname);
                        }
                    }
                } else {
                    m = self->new_node(arrow ? N_ARROW : N_MEMBER);
                    if (m < 0) return -1;
                    g_nodes[m].a = n;
                    snprintf(g_nodes[m].text2, MAX_TEXT, "%s", fname);
                }
                n = m;
                continue;
            }
            break;
        }
        if (g_tok == T_PUNCT && (strcmp(g_toktext, "++") == 0 || strcmp(g_toktext, "--") == 0)) {
            int k;
            k = g_nodes[n].kind;
            if (k != N_VAR && k != N_MEMBER && k != N_ARROW && k != N_INDEX && k != N_DEREF)
                return self->fail("'++' / '--' need an assignable target");
            m = self->new_node(N_POST);
            if (m < 0) return -1;
            g_nodes[m].a = n;
            g_nodes[m].aux = (g_toktext[0] == '+') ? P_INC : P_DEC;
            self->lex_next();
            return m;
        }
        return n;
    }

    int parse_primary(void)
    {
        int n, args, id_line;
        (void)self;

        if (g_tok == T_NUM) {
            n = self->new_node(N_NUM);
            if (n < 0) return -1;
            g_nodes[n].num = g_toknum;
            self->lex_next();
            return n;
        }
        if (g_tok == T_STR) {
            int off = g_nstrpool;
            n = self->new_node(N_STR);
            if (n < 0) return -1;
            /* adjacent literals concatenate; they are copied into the pool so the
               joined string is not limited by MAX_TEXT */
            while (g_tok == T_STR) {
                int m = 0;
                while (g_toktext[m] && g_nstrpool + 2 < MAX_STRPOOL) {
                    g_strpool[g_nstrpool] = g_toktext[m];
                    g_nstrpool++;
                    m++;
                }
                if (g_toktext[m]) return self->fail("string pool is full");
                self->lex_next();
            }
            g_strpool[g_nstrpool] = 0;
            g_nstrpool++;      /* keep this literal's terminator for good */
            g_nodes[n].num = off;
            return n;
        }
        if (g_tok == T_ID) {
            id_line = g_tokline;
            n = self->new_node(N_VAR);
            if (n < 0) return -1;
            snprintf(g_nodes[n].text2, MAX_TEXT, "%s", g_toktext);
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0) {
                int fi;
                args = self->parse_args();
                if (args < 0) return -1;
                fi = self->find_func(g_nodes[n].text2);
                if (fi >= 0 && self->record_call(g_nodes[n].text2, id_line) != 0) return -1;
                if (fi >= 0 && args > 0) {
                    int cur, prev, k, first_arg;
                    cur = args;
                    prev = -1;
                    k = 0;
                    first_arg = args;
                    while (cur > 0 && k < g_funcs[fi].nparams) {
                        char tr[MAX_TEXT];
                        if (self->is_iface_type(g_funcs[fi].ptype[k], tr, sizeof tr)) {
                            int boxed = self->maybe_box(cur, tr);
                            if (boxed < 0) return -1;
                            if (boxed != cur) {
                                if (prev < 0) first_arg = boxed;
                                else g_nodes[prev].next = boxed;
                                g_nodes[boxed].next = g_nodes[cur].next;
                                cur = boxed;
                            }
                        }
                        prev = cur;
                        cur = g_nodes[cur].next;
                        k++;
                    }
                    args = first_arg;
                }
                g_nodes[n].kind = N_CALL;
                g_nodes[n].a = (args == 0) ? -1 : args;
            } else if (self->find_var(g_nodes[n].text2) < 0) {
                /* CT has no preprocessor: an ALL_CAPS name is a macro constant
                   (MAX_NODES, NULL, ...) and is emitted verbatim. Anything else
                   still has to be declared. */
                int ci, all_caps;
                const char *nm = g_nodes[n].text2;
                all_caps = (nm[0] != 0);
                for (ci = 0; nm[ci]; ci++) {
                    char cc = nm[ci];
                    if (!((cc >= 'A' && cc <= 'Z') || (cc >= '0' && cc <= '9') || cc == '_')) {
                        all_caps = 0;
                        break;
                    }
                }
                if (all_caps || strcmp(nm, "stderr") == 0
                    || strcmp(nm, "stdout") == 0 || strcmp(nm, "stdin") == 0) {
                    g_nodes[n].kind = N_RAW;
                    snprintf(g_nodes[n].text, MAX_TEXT, "%s", nm);
                    return n;
                }
                return self->fail("use of an undeclared variable");
            }
            return n;
        }
        if (g_tok == T_PUNCT && strcmp(g_toktext, "(") == 0) {
            self->lex_next();
            n = self->parse_expr();
            if (n < 0) return -1;
            if (self->expect(")") != 0) return -1;
            return n;
        }
        return self->fail("expected an expression");
    }

    int parse_args(void)
    {
        int first, tail, e;
        (void)self;

        if (self->expect("(") != 0) return -1;
        if (g_tok == T_PUNCT && strcmp(g_toktext, ")") == 0) {
            self->lex_next();
            return 0;
        }
        first = -1;
        tail = -1;
        for (;;) {
            e = self->parse_expr();
            if (e < 0) return -1;
            if (tail < 0) first = e;
            else g_nodes[tail].next = e;
            tail = e;
            if (g_tok == T_PUNCT && strcmp(g_toktext, ",") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(")") != 0) return -1;
        return first;
    }

    /* `struct T_iface` -> T. */
    int is_iface_type(const char *type, char *tout, size_t tcap)
    {
        const char *base;
        size_t n;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) != 0) return 0;
        base += 7;
        n = strlen(base);
        if (n <= 6 || strcmp(base + n - 6, "_iface") != 0) return 0;
        if (n - 6 >= tcap) return 0;
        snprintf(tout, tcap, "%.*s", (int)(n - 6), base);
        return 1;
    }

    /* `struct S` / `S` / `struct S *` -> S (and whether it was a pointer). */
    int concrete_struct(const char *type, char *sout, size_t scap, int *is_ptr)
    {
        char buf[MAX_TEXT];
        char *base;
        size_t n;
        (void)self;

        if (snprintf(buf, sizeof buf, "%s", type) >= (int)sizeof buf) return 0;
        base = buf;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        n = strlen(base);
        *is_ptr = 0;
        while (n > 0 && (base[n - 1] == ' ' || base[n - 1] == '*')) {
            if (base[n - 1] == '*') *is_ptr = 1;
            base[n - 1] = 0;
            n--;
        }
        if (self->find_struct(base) < 0) return 0;
        if (snprintf(sout, scap, "%s", base) >= (int)scap) return 0;
        return 1;
    }

    /* A best-effort static type for the expressions boxing needs. */
    int expr_type(int n, char *out, size_t cap)
    {
        int i;
        (void)self;

        if (g_nodes[n].kind == N_VAR) return self->var_type(g_nodes[n].text2, out, cap);
        if (g_nodes[n].kind == N_INDEX) return self->expr_type(g_nodes[n].a, out, cap);
        if (g_nodes[n].kind == N_ADDR) {
            if (self->expr_type(g_nodes[n].a, out, cap) != 0) return -1;
            if (strlen(out) + 2 >= cap) return -1;
            strcat(out, " *");
            return 0;
        }
        if (g_nodes[n].kind == N_CALL) {
            i = self->find_func(g_nodes[n].text2);
            if (i < 0) return -1;
            if (snprintf(out, cap, "%s", g_funcs[i].ret) >= (int)cap) return -1;
            return 0;
        }
        if (g_nodes[n].kind == N_MEMBER || g_nodes[n].kind == N_ARROW) {
            char rt[MAX_TEXT];
            char sname[MAX_TEXT];
            int is_ptr, si, fi;
            if (self->expr_type(g_nodes[n].a, rt, sizeof rt) != 0) return -1;
            is_ptr = (g_nodes[n].kind == N_ARROW);
            if (!self->concrete_struct(rt, sname, sizeof sname, &is_ptr)) return -1;
            si = self->find_struct(sname);
            if (si < 0) return -1;
            for (fi = 0; fi < g_structs[si].nfields; fi++)
                if (strcmp(g_structs[si].fields[fi].name, g_nodes[n].text2) == 0) {
                    if (snprintf(out, cap, "%s", g_structs[si].fields[fi].type) >= (int)cap) return -1;
                    return 0;
                }
            return -1;
        }
        if (g_nodes[n].kind == N_BOX) {
            if (snprintf(out, cap, "struct %s_iface", g_nodes[n].text) >= (int)cap) return -1;
            return 0;
        }
        if (g_nodes[n].kind == N_CAST) {
            if (snprintf(out, cap, "%s", g_nodes[n].text) >= (int)cap) return -1;
            return 0;
        }
        if (g_nodes[n].kind == N_SIZEOF) {
            if (snprintf(out, cap, "%s", "int") >= (int)cap) return -1;
            return 0;
        }
        return -1;
    }

    /* Wrap `n` in a fat pointer when `trait` is expected; an expression that is
       already the right interface passes through unchanged. */
    int maybe_box(int n, const char *trait)
    {
        char t[MAX_TEXT];
        char tname[MAX_TEXT];
        char sname[MAX_TEXT];
        int is_ptr, si, u, box, found;
        (void)self;

        if (g_nodes[n].kind == N_BOX) return n;
        if (self->expr_type(n, t, sizeof t) != 0)
            return self->fail("cannot infer the type to box");
        if (self->is_iface_type(t, tname, sizeof tname)) {
            if (strcmp(tname, trait) == 0) return n;
            return self->fail("interface type mismatch");
        }
        if (!self->concrete_struct(t, sname, sizeof sname, &is_ptr))
            return self->fail("cannot box this expression");
        si = self->find_struct(sname);
        if (si < 0) return self->fail("cannot box an unknown struct");
        found = 0;
        for (u = 0; u < g_structs[si].nuse; u++)
            if (strcmp(g_structs[si].use[u], trait) == 0) found = 1;
        if (!found) return self->fail("the struct does not use this trait");
        box = self->new_node(N_BOX);
        if (box < 0) return -1;
        g_nodes[box].a = n;
        g_nodes[box].aux = is_ptr;
        snprintf(g_nodes[box].text, MAX_TEXT, "%s", trait);
        snprintf(g_nodes[box].text2, MAX_TEXT, "%s", sname);
        return box;
    }
}

impl ModuleOps for Ast {
    /* `foo.ct` -> `foo`; `foo.h.ct` -> `foo` and `is_hdr = 1`. */
    int base_name(const char *path, char *out, size_t cap, int *is_hdr)
    {
        const char *slash, *name;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        name = slash ? slash + 1 : path;
        n = strlen(name);
        *is_hdr = 0;
        if (n > 5 && strcmp(name + n - 5, ".h.ct") == 0) {
            *is_hdr = 1;
            n -= 5;
        } else if (n > 3 && strcmp(name + n - 3, ".ct") == 0) {
            n -= 3;
        }
        if (n + 1 > cap) return self->fail("output name is too long");
        snprintf(out, cap, "%.*s", (int)n, name);
        return 0;
    }

    int path_dir(const char *path, char *out, size_t cap)
    {
        const char *slash;
        size_t n;
        (void)self;

        slash = strrchr(path, '/');
        if (!slash) {
            if (cap < 2) return self->fail("path is too long");
            snprintf(out, cap, "%s", ".");
            return 0;
        }
        n = (size_t)(slash - path);
        if (n == 0) n = 1;   /* "/x" -> "/" */
        if (n + 1 > cap) return self->fail("path is too long");
        snprintf(out, cap, "%.*s", (int)n, path);
        return 0;
    }

    int append_node(int prog, int n)
    {
        int t;
        (void)self;

        g_nodes[n].next = -1;
        if (g_nodes[prog].a < 0) {
            g_nodes[prog].a = n;
            return 0;
        }
        t = g_nodes[prog].a;
        while (g_nodes[t].next >= 0) t = g_nodes[t].next;
        g_nodes[t].next = n;
        return 0;
    }

    /* Consume `import a::b;` and remember the path; `load_unit` resolves it. */
    int skip_import(void)
    {
        char rel[MAX_TEXT];
        size_t n;
        (void)self;

        n = 0;
        rel[0] = 0;
        self->lex_next();
        for (;;) {
            if (g_tok != T_ID) return self->fail("expected an import path");
            if (n > 0) {
                if (n + 1 >= sizeof rel) return self->fail("import path is too long");
                rel[n] = '/';
                n++;
            }
            if (n + strlen(g_toktext) >= sizeof rel) return self->fail("import path is too long");
            snprintf(rel + n, sizeof rel - n, "%s", g_toktext);
            n += strlen(g_toktext);
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, "::") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (self->expect(";") != 0) return -1;
        if (g_nrels >= MAX_IMPORTS) return self->fail("too many imports");
        snprintf(g_rels[g_nrels], MAX_TEXT, "%s", rel);
        g_nrels++;
        return 0;
    }

    /* Imports are the leading declarations of a unit, so one pass finds them
       before anything is parsed. */
    int scan_imports(const char *from)
    {
        (void)self;
        g_nrels = 0;
        g_path = from;
        g_pos = 0;
        g_bol = 1;
        g_tok = 0;
        self->lex_next();
        for (;;) {
            if (g_tok == T_PP) {
                self->lex_next();
                continue;
            }
            if (g_tok == T_ID && strcmp(g_toktext, "import") == 0) {
                if (self->skip_import() != 0) return -1;
                continue;
            }
            break;
        }
        return 0;
    }

    /* `a::b` -> `<root>/a/b.ct`, then `a/b.h.ct`, for the importing file's own
       directory and then every `-I` root. */
    int resolve_import(const char *from, const char *rel, char *out, size_t cap, int *is_hdr)
    {
        char dir[MAX_PATH];
        char cand[MAX_PATH];
        const char *root;
        FILE *f;
        int r;
        (void)self;

        if (self->path_dir(from, dir, sizeof dir) != 0) return -1;
        for (r = -1; r < g_ninc; r++) {
            root = (r < 0) ? dir : g_incdirs[r];
            if (snprintf(cand, sizeof cand, "%s/%s.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 0;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
            if (snprintf(cand, sizeof cand, "%s/%s.h.ct", root, rel) >= (int)sizeof cand)
                return self->fail("import path is too long");
            f = fopen(cand, "rb");
            if (f) {
                fclose(f);
                *is_hdr = 1;
                if (snprintf(out, cap, "%s", cand) >= (int)cap) return self->fail("import path is too long");
                return 0;
            }
        }
        snprintf(cand, sizeof cand, "cannot resolve import '%s'", rel);
        return self->fail(cand);
    }

    /* Parse the import closure depth first, so a unit's declarations are in the
       shared tables before its importers are parsed. Returns the unit index. */
    int load_unit(const char *path)
    {
        char rels[MAX_IMPORTS][MAX_TEXT];
        char dep[MAX_PATH];
        char *mysrc;
        int u, i, d, nrels, is_hdr;
        (void)self;

        for (u = 0; u < g_nunits; u++)
            if (strcmp(g_units[u].path, path) == 0) return u;
        if (g_nunits >= MAX_UNITS) {
            self->fail("too many units");
            return -1;
        }
        u = g_nunits;
        g_nunits++;
        if (snprintf(g_units[u].path, MAX_PATH, "%s", path) >= MAX_PATH) {
            self->fail("path is too long");
            return -1;
        }
        g_units[u].ndep = 0;
        g_units[u].prog = -1;
        g_units[u].ns[0] = 0;
        if (self->base_name(path, g_units[u].base, MAX_TEXT, &is_hdr) != 0) return -1;
        g_units[u].is_hdr = is_hdr;

        if (self->read_file(path) != 0) return -1;
        mysrc = (char *)g_src;
        if (self->scan_imports(path) != 0) return -1;
        nrels = g_nrels;
        for (i = 0; i < nrels; i++) snprintf(rels[i], MAX_TEXT, "%s", g_rels[i]);
        for (i = 0; i < nrels; i++) {
            if (self->resolve_import(path, rels[i], dep, sizeof dep, &is_hdr) != 0) return -1;
            d = self->load_unit(dep);
            if (d < 0) return -1;
            if (g_units[u].ndep >= MAX_IMPORTS) {
                self->fail("too many imports");
                return -1;
            }
            snprintf(g_units[u].dep[g_units[u].ndep], MAX_TEXT, "%s", g_units[d].base);
            g_units[u].ndep++;
        }

        g_src = mysrc;
        g_pos = 0;
        g_bol = 1;
        g_line = 1;
        g_tokline = 1;
        g_tok = 0;
        g_nvar = 0;
        g_nscope = 0;
        g_ns[0] = 0;
        g_ns_decl[0] = 0;
        g_self_mode = 0;
        g_ret_type[0] = 0;
        g_cur_func[0] = 0;
        g_nparams = 0;
        g_path = path;
        g_units[u].fn_start = g_nfunc;
        g_units[u].tr_start = g_ntraits;
        g_units[u].call_start = g_ncalls;
        g_units[u].prog = self->parse_program();
        if (g_units[u].prog < 0) return -1;
        g_units[u].fn_end = g_nfunc;
        g_units[u].tr_end = g_ntraits;
        g_units[u].call_end = g_ncalls;
        snprintf(g_units[u].ns, MAX_TEXT, "%s", g_ns_decl);
        return u;
    }

    /* A unit that declares a namespace must sit in the matching directory under
       `--ns-root` (D13 option A: validation, not derivation). */
    int check_ns_dir(int u)
    {
        char rest[MAX_PATH];
        char dir[MAX_TEXT];
        char want[MAX_TEXT];
        const char *p;
        size_t rn, k, m;

        (void)self;
        if (!g_units[u].ns[0]) return 0;
        if (!g_nsroot || !g_nsroot[0]) return 0;
        rn = strlen(g_nsroot);
        if (strncmp(g_units[u].path, g_nsroot, rn) != 0) return 0;
        p = g_units[u].path + rn;
        if (*p == '/') p++;
        snprintf(rest, sizeof rest, "%s", p);
        if (strncmp(rest, "./", 2) == 0 || strncmp(rest, "../", 3) == 0
            || strstr(rest, "/./") != NULL || strstr(rest, "/../") != NULL) return 0;

        k = strlen(rest);
        while (k > 0 && rest[k - 1] != '/') k--;
        if (k > 0) k--;                    /* drop the slash before the basename */
        if (k >= sizeof dir) return self->fail("path is too long");
        snprintf(dir, sizeof dir, "%.*s", (int)k, rest);

        m = 0;
        for (k = 0; g_units[u].ns[k]; k++) {
            if (m + 1 >= sizeof want) return self->fail("namespace is too long");
            if (g_units[u].ns[k] == ':' && g_units[u].ns[k + 1] == ':') {
                want[m] = '/';
                m++;
                k++;
            } else {
                want[m] = g_units[u].ns[k];
                m++;
            }
        }
        want[m] = 0;
        if (strcmp(dir, want) != 0) {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "namespace '%s' does not match the directory '%s'",
                     g_units[u].ns, dir);
            return self->fail(msg);
        }
        return 0;
    }

    /* `struct` starts either a definition (`struct S {`) or the return type of a
       function/global (`struct S *f();`). Peek with a lexer snapshot. */
    int struct_def_ahead(void)
    {
        int pos, bol, tok, is_def;
        long num;
        char text[MAX_TEXT];
        (void)self;

        pos = g_pos;
        bol = g_bol;
        tok = g_tok;
        num = g_toknum;
        snprintf(text, sizeof text, "%s", g_toktext);
        self->lex_next();
        is_def = 0;
        if (g_tok == T_ID) self->lex_next();
        /* a body (`{`) or a forward declaration (`;`) both start a CT struct */
        if (g_tok == T_PUNCT && (strcmp(g_toktext, "{") == 0 || strcmp(g_toktext, ";") == 0))
            is_def = 1;
        g_pos = pos;
        g_bol = bol;
        g_tok = tok;
        g_toknum = num;
        snprintf(g_toktext, MAX_TEXT, "%s", text);
        return is_def;
    }

    /* One top-level declaration; `pub` may lead it. */
    int parse_top_decl(int is_pub)
    {
        int n;
        (void)self;

        if (g_tok == T_ID && strcmp(g_toktext, "pub") == 0) {
            if (is_pub) return self->fail("duplicate 'pub'");
            self->lex_next();
            return self->parse_top_decl(1);
        }
        if (g_tok == T_ID && strcmp(g_toktext, "typedef") == 0) {
            n = self->parse_typedef(is_pub);
        } else if (g_tok == T_ID && strcmp(g_toktext, "trait") == 0) {
            n = self->parse_trait(is_pub);
        } else if (g_tok == T_ID && strcmp(g_toktext, "impl") == 0) {
            n = self->parse_impl();
        } else if (g_tok == T_ID && strcmp(g_toktext, "struct") == 0
                   && self->struct_def_ahead()) {
            n = self->parse_struct_def();
            /* CT writes `struct X { ... }` bare (the old pipeline accepts both) */
            if (n >= 0) self->accept(";");
        } else if (g_tok == T_ID && strcmp(g_toktext, "static") == 0) {
            self->lex_next();
            n = self->parse_func(1, is_pub);
        } else {
            n = self->parse_func(0, is_pub);
        }
        if (n == NO_NODE) return NO_NODE;
        if (n < 0) return -1;
        g_nodes[n].d = is_pub ? 1 : 0;
        return n;
    }

    /* `namespace A::B { ... }`: C has one global namespace, so declarations are
       stored under the `A_B_` prefix. Functions keep their names (the published
       rule), and the block itself emits nothing. */
    int parse_namespace(int prog)
    {
        char path[MAX_TEXT];
        char prefix[MAX_TEXT];
        char save[MAX_TEXT];
        size_t np, npre;
        int n;
        (void)self;

        self->lex_next();
        np = 0;
        npre = 0;
        path[0] = 0;
        prefix[0] = 0;
        for (;;) {
            if (g_tok != T_ID) return self->fail("expected a namespace name");
            if (np > 0) {
                if (np + 2 >= sizeof path) return self->fail("namespace is too long");
                path[np] = ':';
                path[np + 1] = ':';
                np += 2;
                path[np] = 0;
            }
            if (np + strlen(g_toktext) >= sizeof path) return self->fail("namespace is too long");
            snprintf(path + np, sizeof path - np, "%s", g_toktext);
            np += strlen(g_toktext);
            if (npre + strlen(g_toktext) + 1 >= sizeof prefix)
                return self->fail("namespace is too long");
            snprintf(prefix + npre, sizeof prefix - npre, "%s_", g_toktext);
            npre += strlen(g_toktext) + 1;
            self->lex_next();
            if (g_tok == T_PUNCT && strcmp(g_toktext, "::") == 0) {
                self->lex_next();
                continue;
            }
            break;
        }
        if (!g_ns[0]) snprintf(g_ns_decl, MAX_TEXT, "%s", path);
        if (self->expect("{") != 0) return -1;
        snprintf(save, sizeof save, "%s", g_ns);
        if (snprintf(g_ns, sizeof g_ns, "%s%s", save, prefix) >= (int)sizeof g_ns)
            return self->fail("namespace is too long");
        while (g_tok != T_EOF && !(g_tok == T_PUNCT && strcmp(g_toktext, "}") == 0)) {
            if (g_tok == T_PP) {
                n = self->new_node(N_PP);
                if (n < 0) return -1;
                snprintf(g_nodes[n].text, MAX_TEXT, "%s", g_toktext);
                if (self->append_node(prog, n) != 0) return -1;
                self->lex_next();
                continue;
            }
            n = self->parse_top_decl(0);
            if (n == NO_NODE) continue;
            if (n < 0) return -1;
            if (self->append_node(prog, n) != 0) return -1;
        }
        if (self->expect("}") != 0) return -1;
        snprintf(g_ns, sizeof g_ns, "%s", save);
        return 0;
    }

    int build_main(int argc, char **argv)
    {
        const char *inputs[MAX_UNITS];
        int ninput, i, u;
        const char *outdir;
        char root[MAX_PATH];
        (void)self;

        ninput = 0;
        outdir = NULL;
        g_ninc = 0;
        g_nsroot = NULL;
        g_line_mode = 1;
        g_have_map = 0;
        for (i = 1; i < argc; i++) {
            if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
                printf("usage: ct-ast build <input.ct>... -o <dir> [-I <dir>] [--ns-root <dir>]\n"
                       "                     [--line|--no-line] [--emit-map <file|->]\n");
                return 0;
            }
            if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--version") == 0) {
                printf("ct-ast v%s\n", CTC_VERSION);
                return 0;
            }
            if (strcmp(argv[i], "--line") == 0) {
                g_line_mode = 1;
                continue;
            }
            if (strcmp(argv[i], "--no-line") == 0) {
                g_line_mode = 0;
                continue;
            }
            if (strcmp(argv[i], "--emit-map") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: --emit-map needs an argument\n");
                    return 1;
                }
                i++;
                if (snprintf(g_map_path, sizeof g_map_path, "%s", argv[i]) >= (int)sizeof g_map_path) {
                    fprintf(stderr, "ct-ast: map path is too long\n");
                    return 1;
                }
                g_have_map = 1;
                continue;
            }
            if (strcmp(argv[i], "-o") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: -o needs an argument\n");
                    return 1;
                }
                i++;
                outdir = argv[i];
                continue;
            }
            if (strcmp(argv[i], "-I") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: -I needs an argument\n");
                    return 1;
                }
                i++;
                if (g_ninc >= MAX_INCDIRS) {
                    fprintf(stderr, "ct-ast: too many -I roots\n");
                    return 1;
                }
                g_incdirs[g_ninc] = argv[i];
                g_ninc++;
                continue;
            }
            if (strcmp(argv[i], "--ns-root") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "ct-ast: --ns-root needs an argument\n");
                    return 1;
                }
                i++;
                g_nsroot = argv[i];
                continue;
            }
            if (argv[i][0] == '-' && argv[i][1]) {
                fprintf(stderr, "ct-ast: unknown option '%s'\n", argv[i]);
                return 1;
            }
            if (ninput >= MAX_UNITS) {
                fprintf(stderr, "ct-ast: too many inputs\n");
                return 1;
            }
            inputs[ninput] = argv[i];
            ninput++;
        }
        if (ninput == 0) {
            fprintf(stderr, "usage: ct-ast build <input.ct>... -o <dir>\n");
            return 1;
        }
        if (!outdir) {
            fprintf(stderr, "ct-ast: build needs -o <dir>\n");
            return 1;
        }
        if (snprintf(g_outdir, sizeof g_outdir, "%s", outdir) >= (int)sizeof g_outdir) {
            fprintf(stderr, "ct-ast: output directory is too long\n");
            return 1;
        }
        if (!g_nsroot) {
            if (self->path_dir(inputs[0], root, sizeof root) != 0) {
                fprintf(stderr, "ct-ast: %s\n", g_errmsg);
                return 1;
            }
            g_nsroot = root;
        }

        g_nunits = 0;
        g_nnode = 0;
        g_nfunc = 0;
        g_nvar = 0;
        g_nscope = 0;
        g_ntype = 0;
        g_ntraits = 0;
        g_nstructs = 0;
        g_nrels = 0;
        g_nparams = 0;
        g_self_mode = 0;
        g_ret_type[0] = 0;
        g_ns[0] = 0;
        g_ns_decl[0] = 0;
        g_line = 1;
        g_tokline = 1;
        g_ncalls = 0;
        g_cur_func[0] = 0;
        g_errmsg[0] = 0;
        g_build_mode = 1;

        for (i = 0; i < ninput; i++) {
            if (self->load_unit(inputs[i]) < 0) {
                fprintf(stderr, "ct-ast: %s\n", g_errmsg);
                return 1;
            }
        }
        for (u = 0; u < g_nunits; u++) {
            if (self->check_ns_dir(u) != 0) {
                fprintf(stderr, "ct-ast: %s\n", g_errmsg);
                return 1;
            }
        }
        for (u = 0; u < g_nunits; u++) {
            if (self->emit_unit(u) != 0) {
                fprintf(stderr, "ct-ast: %s\n", g_errmsg);
                return 1;
            }
            if (self->write_unit_header(u) != 0) {
                fprintf(stderr, "ct-ast: %s\n", g_errmsg);
                return 1;
            }
        }
        if (g_have_map && self->write_map(g_map_path, g_units[0].prog, 0) != 0) {
            fprintf(stderr, "ct-ast: %s\n", g_errmsg);
            return 1;
        }
        return 0;
    }
}

impl EmitOps for Ast {
    int emit_indent(int n)
    {
        int i;
        (void)self;
        for (i = 0; i < n * 4; i++) fputc(' ', g_out);
        return 0;
    }

    /* PP lines, then types/globals in source order, then prototypes, then the
       definitions. Prototypes come after the type declarations they may use. */
    int emit_program(int prog)
    {
        int n, i;
        (void)self;

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next)
            if (g_nodes[n].kind == N_PP) fprintf(g_out, "%s\n", g_nodes[n].text);

        if (self->emit_trait_decls() != 0) return -1;
        if (self->emit_vtable_fwd(prog) != 0) return -1;

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            if (g_nodes[n].kind == N_STRUCT || g_nodes[n].kind == N_TYPEDEF
                || g_nodes[n].kind == N_GLOBAL) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        if (self->emit_impls(prog) != 0) return -1;

        for (i = 0; i < g_nfunc; i++)
            if (self->emit_proto(i) != 0) return -1;

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            if (g_nodes[n].kind == N_FUNC) {
                if (self->emit_node(n, 0) != 0) return -1;
            }
        }
        if (self->emit_unit_init(prog) != 0) return -1;
        return 0;
    }

    /* One prototype line for `g_funcs[i]`. */
    int emit_proto(int i)
    {
        int k;
        (void)self;

        if (g_funcs[i].is_static) fputs("static ", g_out);
        fprintf(g_out, "%s %s(", g_funcs[i].ret, g_funcs[i].name);
        if (g_funcs[i].nparams == 0) {
            fputs("void", g_out);
        } else {
            for (k = 0; k < g_funcs[i].nparams; k++) {
                if (k > 0) fputs(", ", g_out);
                fputs(g_funcs[i].ptype[k], g_out);
            }
        }
        fputs(");\n", g_out);
        return 0;
    }

    /* Tentative definitions so a global declared above an impl can already
       point at its vtable; C99 6.9.2 lets the definition below complete them. */
    int emit_vtable_fwd(int prog)
    {
        int n, si;
        const char *tname;
        (void)self;

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            if (g_nodes[n].kind != N_IMPL) continue;
            si = g_nodes[n].aux;
            tname = g_nodes[n].text2;
            fprintf(g_out, "static struct %s_vtbl %s_%s_vtable;\n",
                    tname, g_structs[si].name, tname);
        }
        return 0;
    }

    /* One vtable type and one interface type per trait. */
    int emit_trait_decls(void)
    {
        (void)self;
        return self->emit_trait_range(0, g_ntraits, 0);
    }

    /* `mode`: 0 = every trait, 1 = exported only, 2 = private only. */
    int emit_trait_range(int start, int end, int mode)
    {
        int t, m, k;
        (void)self;

        for (t = start; t < end; t++) {
            if (mode == 1 && !g_traits[t].is_pub) continue;
            if (mode == 2 && g_traits[t].is_pub) continue;
            fprintf(g_out, "struct %s_vtbl {\n", g_traits[t].name);
            for (m = 0; m < g_traits[t].nm; m++) {
                fprintf(g_out, "    %s (*%s)(void *", g_traits[t].m[m].ret,
                        g_traits[t].m[m].name);
                for (k = 0; k < g_traits[t].m[m].nparams; k++)
                    fprintf(g_out, ", %s", g_traits[t].m[m].ptype[k]);
                fputs(");\n", g_out);
            }
            fputs("};\n", g_out);
            fprintf(g_out, "struct %s_iface {\n    void *self;\n    struct %s_vtbl *vt;\n};\n\n",
                    g_traits[t].name, g_traits[t].name);
        }
        return 0;
    }

    int type_has_vptr(const char *type)
    {
        const char *base;
        int si;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        return (si >= 0 && g_structs[si].nuse > 0) ? 1 : 0;
    }

    /* Does this *value* type need a vptr written somewhere -- itself or through a
       nested value field? `Outer { Inner in; }` needs one even though Outer uses
       no trait of its own. Pointer types are not initialised this way. */
    int type_needs_init(const char *type)
    {
        const char *base;
        char tb[MAX_TEXT];
        size_t tl;
        int si, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        snprintf(tb, sizeof tb, "%s", base);
        tl = strlen(tb);
        while (tl > 0 && (tb[tl - 1] == ' ')) {
            tl--;
            tb[tl] = 0;
        }
        if (strchr(tb, '*') != 0) return 0;
        si = self->find_struct(tb);
        if (si < 0) return 0;
        if (g_structs[si].nuse > 0) return 1;
        for (fi = 0; fi < g_structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", g_structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (self->type_needs_init(ft)) return 1;
        }
        return 0;
    }

    int emit_vptr_items(const char *prefix, const char *type)
    {
        const char *base;
        int si, u, i;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        if (si < 0) return 0;
        for (u = 0; u < g_structs[si].nuse; u++) {
            char low[MAX_TEXT];
            for (i = 0; g_structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                char c = g_structs[si].use[u][i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            if (u > 0) fputs(", ", g_out);
            fprintf(g_out, "%s.__%s_vptr = &%s_%s_vtable", prefix, low, base, g_structs[si].use[u]);
        }
        return 0;
    }

    /* The statement form of `emit_vptr_items`: write `recv.__x_vptr = ...` (and
       one level of nested value fields) for an object that could not carry an
       initialiser -- an array element, or a heap object after malloc. */
    int emit_vptr_stmts(const char *recv, const char *type, int ind)
    {
        const char *base;
        char tb[MAX_TEXT];
        size_t tl;
        int si, u, i, fi;
        (void)self;

        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        snprintf(tb, sizeof tb, "%s", base);
        tl = strlen(tb);
        while (tl > 0 && (tb[tl - 1] == '*' || tb[tl - 1] == ' ')) {
            tl--;
            tb[tl] = 0;
        }
        si = self->find_struct(tb);
        if (si < 0) return 0;
        for (u = 0; u < g_structs[si].nuse; u++) {
            char low[MAX_TEXT];
            for (i = 0; g_structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                char c = g_structs[si].use[u][i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            self->emit_indent(ind);
            fprintf(g_out, "%s.__%s_vptr = &%s_%s_vtable;\n", recv, low, tb, g_structs[si].use[u]);
        }
        for (fi = 0; fi < g_structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            char sub[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", g_structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;
            if (!self->type_needs_init(ft)) continue;
            snprintf(sub, sizeof sub, "%s.%s", recv, g_structs[si].fields[fi].name);
            if (self->emit_vptr_stmts(sub, ft, ind) != 0) return -1;
        }
        return 0;
    }

    /* File-scope arrays cannot carry per-element writes in an initialiser, so
       they go into the per-unit constructor (the same shape as D5=A in the old
       pipeline). Emitted only when such an array exists. */
    int emit_unit_init(int prog)
    {
        int n, any;
        (void)self;

        any = 0;
        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next)
            if (g_nodes[n].kind == N_GLOBAL && g_nodes[n].text3[0]
                && self->type_needs_init(g_nodes[n].text)) any = 1;
        if (!any) return 0;
        fputs("static void __ct_init(void) __attribute__((constructor));\n", g_out);
        fputs("static void __ct_init(void) {\n", g_out);
        fputs("    unsigned long __ct_i;\n", g_out);
        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            char cnt[MAX_TEXT];
            char recv[MAX_TEXT];
            int i, k;
            if (g_nodes[n].kind != N_GLOBAL || !g_nodes[n].text3[0]) continue;
            if (!self->type_needs_init(g_nodes[n].text)) continue;
            /* the count is the first bracket group of the suffix */
            k = 0;
            for (i = 1; g_nodes[n].text3[i] && g_nodes[n].text3[i] != ']' && k + 1 < MAX_TEXT; i++) {
                cnt[k] = g_nodes[n].text3[i];
                k++;
            }
            cnt[k] = 0;
            snprintf(recv, sizeof recv, "%s[__ct_i]", g_nodes[n].text2);
            fprintf(g_out, "    for (__ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
            if (self->emit_vptr_stmts(recv, g_nodes[n].text, 2) != 0) return -1;
            fputs("    }\n", g_out);
        }
        fputs("}\n\n", g_out);
        return 0;
    }

    /* A captured `{ ... }` initializer; vptr items are appended before the final
       brace. An empty list gets `{ items }` without a dangling comma. */
    int emit_raw_init(int raw, const char *type)
    {
        const char *t;
        const char *base;
        int len, i, only_space, si;
        (void)self;

        t = g_nodes[raw].text;
        len = (int)strlen(t);
        base = type;
        if (strncmp(base, "struct ", 7) == 0) base += 7;
        while (*base == ' ') base++;
        si = self->find_struct(base);
        fputs(" = ", g_out);
        if (len < 2 || t[len - 1] != '}') {
            fputs(t, g_out);
            return 0;
        }
        only_space = 1;
        for (i = 1; i < len - 1; i++)
            if (t[i] != ' ' && t[i] != '\t' && t[i] != '\n' && t[i] != '\r') only_space = 0;
        if (only_space) {
            fputs("{ ", g_out);
            if (self->type_has_vptr(type)) {
                if (self->emit_vptr_items("", type) != 0) return -1;
            }
            if (si >= 0 && self->emit_field_vptrs(si, self->type_has_vptr(type)) != 0) return -1;
            fputs(" }", g_out);
            return 0;
        }
        fwrite(t, 1, (size_t)(len - 1), g_out);
        if (self->type_has_vptr(type)) {
            fputs(", ", g_out);
            if (self->emit_vptr_items("", type) != 0) return -1;
        }
        /* the captured text already has members, so a nested item needs its comma */
        if (si >= 0 && self->emit_field_vptrs(si, 1) != 0) return -1;
        fputs("}", g_out);
        return 0;
    }

    /* A struct-typed field with traits of its own needs a nested designator
       (`.owner.__greeter_vptr = ...`), or `s.owner.greet()` dereferences NULL. */
    int emit_field_vptrs(int si, int started)
    {
        int fi;
        (void)self;
        for (fi = 0; fi < g_structs[si].nfields; fi++) {
            char ft[MAX_TEXT];
            char prefix[MAX_TEXT];
            snprintf(ft, sizeof ft, "%s", g_structs[si].fields[fi].type);
            if (strchr(ft, '*') != 0) continue;          /* a borrowed pointer, not a value */
            if (!self->type_needs_init(ft)) continue;
            snprintf(prefix, sizeof prefix, ".%s", g_structs[si].fields[fi].name);
            if (started) fputs(", ", g_out);
            if (self->emit_vptr_items(prefix, ft) != 0) return -1;
            started = 1;
        }
        return 0;
    }

    /* Impl methods and their vtables, emitted before the ordinary functions so
       `main` can already dispatch through them. */
    int emit_impls(int prog)
    {
        int n, m, k, u;
        (void)self;

        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            int si, ti;
            const char *tname;
            const char *sname;
            if (g_nodes[n].kind != N_IMPL) continue;
            si = g_nodes[n].aux;
            tname = g_nodes[n].text2;
            ti = -1;
            for (k = 0; k < g_ntraits; k++)
                if (strcmp(g_traits[k].name, tname) == 0) ti = k;
            if (ti < 0) return self->fail("impl of an unknown trait");
            sname = g_nodes[n].text;
            for (m = g_nodes[n].a; m >= 0; m = g_nodes[m].next) {
                fprintf(g_out, "static %s %s_%s_%s(void *self", g_nodes[m].text,
                        g_structs[si].name, tname, g_nodes[m].text2);
                k = g_nodes[m].a;
                while (k > 0) {
                    fprintf(g_out, ", %s %s", g_nodes[k].text, g_nodes[k].text2);
                    k = g_nodes[k].next;
                }
                fputs(") {\n", g_out);
                fprintf(g_out, "    %s *_self = (%s *)self;\n", sname, sname);
                g_self_mode = 1;
                k = g_nodes[g_nodes[m].b].a;
                while (k >= 0) {
                    if (self->emit_node(k, 1) != 0) {
                        g_self_mode = 0;
                        return -1;
                    }
                    k = g_nodes[k].next;
                }
                g_self_mode = 0;
                fputs("}\n\n", g_out);
            }
            fprintf(g_out, "static struct %s_vtbl %s_%s_vtable = {\n",
                    tname, g_structs[si].name, tname);
            u = 0;
            for (m = g_nodes[n].a; m >= 0; m = g_nodes[m].next) {
                if (u > 0) fputs(",\n", g_out);
                fprintf(g_out, "    .%s = %s_%s_%s", g_nodes[m].text2,
                        g_structs[si].name, tname, g_nodes[m].text2);
                u++;
            }
            fputs("\n};\n\n", g_out);
        }
        return 0;
    }

    /* Top-level declarations: struct / typedef / global (with a semicolon as
       appropriate). */
    int emit_type_decl(int n, int ind, int with_semi)
    {
        int m;
        (void)self;

        if (g_nodes[n].kind == N_STRUCT) {
            int si, u;
            if (g_nodes[n].aux) {
                /* `typedef struct Tag { ... } Name;` keeps the tag so a
                   `struct Tag` reference (or self-reference) stays valid */
                if (g_nodes[n].text[0]) {
                    fprintf(g_out, "typedef struct %s {\n", g_nodes[n].text);
                } else {
                    fputs("typedef struct {\n", g_out);
                }
            } else {
                fprintf(g_out, "struct %s {\n", g_nodes[n].text2);
            }
            for (m = g_nodes[n].a; m >= 0; m = g_nodes[m].next) {
                self->emit_indent(ind + 1);
                if (self->emit_inline(m) != 0) return -1;
                fputs(";\n", g_out);
            }
            si = self->find_struct(g_nodes[n].text2);
            if (si >= 0) {
                for (u = 0; u < g_structs[si].nuse; u++) {
                    char low[MAX_TEXT];
                    int i;
                    for (i = 0; g_structs[si].use[u][i] && i + 1 < MAX_TEXT; i++) {
                        char c = g_structs[si].use[u][i];
                        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                        low[i] = c;
                    }
                    low[i] = 0;
                    self->emit_indent(ind + 1);
                    fprintf(g_out, "struct %s_vtbl *__%s_vptr;\n",
                            g_structs[si].use[u], low);
                }
            }
            self->emit_indent(ind);
            if (g_nodes[n].aux) fprintf(g_out, "} %s;\n", g_nodes[n].text2);
            else fputs("};\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_TYPEDEF) {
            fprintf(g_out, "typedef %s %s;\n", g_nodes[n].text, g_nodes[n].text2);
            return 0;
        }
        if (g_nodes[n].kind == N_GLOBAL) {
            self->emit_indent(ind);
            if (g_nodes[n].aux) fputs("static ", g_out);
            fprintf(g_out, "%s %s", g_nodes[n].text, g_nodes[n].text2);
            if (g_nodes[n].text3[0]) fputs(g_nodes[n].text3, g_out);
            if (g_nodes[n].a >= 0 && g_nodes[g_nodes[n].a].kind == N_RAW) {
                if (self->emit_raw_init(g_nodes[n].a, g_nodes[n].text) != 0) return -1;
            } else if (g_nodes[n].a >= 0) {
                fputs(" = ", g_out);
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            } else if (self->type_needs_init(g_nodes[n].text) && !g_nodes[n].text3[0]) {
                /* an array gets per-element writes (local) or a constructor
                   (file scope); a designator on the array itself is invalid */
                fputs(" = { ", g_out);
                if (self->emit_vptr_items("", g_nodes[n].text) != 0) return -1;
                if (self->emit_field_vptrs(self->find_struct(
                        strncmp(g_nodes[n].text, "struct ", 7) == 0
                            ? g_nodes[n].text + 7 : g_nodes[n].text),
                        self->type_has_vptr(g_nodes[n].text)) != 0) return -1;
                fputs(" }", g_out);
            }
            if (with_semi) fputs(";\n", g_out);
            return 0;
        }
        return self->fail("unknown declaration node");
    }

    int emit_node(int n, int ind)
    {
        int c;
        (void)self;

        if (g_nodes[n].kind == N_FUNC) {
            if (g_nodes[n].aux) fputs("static ", g_out);
            fprintf(g_out, "%s %s(", g_nodes[n].text, g_nodes[n].text2);
            c = g_nodes[n].a;
            if (c == 0) {
                fputs("void) ", g_out);
            } else {
                int first;
                first = 1;
                while (c > 0) {
                    if (!first) fputs(", ", g_out);
                    fprintf(g_out, "%s %s", g_nodes[c].text, g_nodes[c].text2);
                    first = 0;
                    c = g_nodes[c].next;
                }
                fputs(") ", g_out);
            }
            return self->emit_node(g_nodes[n].b, ind);
        }
        if (g_nodes[n].kind == N_BLOCK) {
            fputs("{\n", g_out);
            for (c = g_nodes[n].a; c >= 0; c = g_nodes[c].next)
                if (self->emit_node(c, ind + 1) != 0) return -1;
            self->emit_indent(ind);
            fputs("}\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_RET) {
            self->emit_indent(ind);
            if (g_nodes[n].a < 0) {
                fputs("return;\n", g_out);
                return 0;
            }
            fputs("return ", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(";\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_DELETE) {
            self->emit_indent(ind);
            fputs("if (", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(") free(", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(");\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_BREAK) {
            self->emit_indent(ind);
            fputs("break;\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_CONT) {
            self->emit_indent(ind);
            fputs("continue;\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_DECLS) {
            int c = g_nodes[n].a;
            while (c >= 0) {
                self->emit_indent(ind);
                if (self->emit_inline(c) != 0) return -1;
                fputs(";\n", g_out);
                c = g_nodes[c].next;
            }
            return 0;
        }
        if (g_nodes[n].kind == N_DECL) {
            const char *tp = g_nodes[n].text;
            size_t tl = strlen(tp);
            int heap_ptr = 0;

            /* `T *p = malloc(..)` writes its vptrs on the next line */
            if (tl > 0 && tp[tl - 1] == '*' && g_nodes[n].a >= 0
                && g_nodes[g_nodes[n].a].kind == N_CALL
                && (strcmp(g_nodes[g_nodes[n].a].text2, "malloc") == 0
                    || strcmp(g_nodes[g_nodes[n].a].text2, "calloc") == 0))
                heap_ptr = 1;

            if (g_nodes[n].text3[0] && g_nodes[n].a < 0 && self->type_needs_init(tp)) {
                /* a local array of trait-carrying values: one loop writes every
                   element's vptr (`Type name[n];` has no initialiser to extend) */
                char cnt[MAX_TEXT];
                char recv[MAX_TEXT];
                size_t ci;
                int k = 0;
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", g_out);
                for (ci = 1; g_nodes[n].text3[ci] && g_nodes[n].text3[ci] != ']'
                           && k + 1 < MAX_TEXT; ci++) {
                    cnt[k] = g_nodes[n].text3[ci];
                    k++;
                }
                cnt[k] = 0;
                snprintf(recv, sizeof recv, "%s[__ct_i]", g_nodes[n].text2);
                self->emit_indent(ind);
                fprintf(g_out, "for (unsigned long __ct_i = 0; __ct_i < %s; __ct_i++) {\n", cnt);
                if (self->emit_vptr_stmts(recv, tp, ind + 1) != 0) return -1;
                self->emit_indent(ind);
                fputs("}\n", g_out);
                return 0;
            }
            if (heap_ptr) {
                char recv[MAX_TEXT];
                self->emit_indent(ind);
                if (self->emit_inline(n) != 0) return -1;
                fputs(";\n", g_out);
                snprintf(recv, sizeof recv, "(*%s)", g_nodes[n].text2);
                return self->emit_vptr_stmts(recv, tp, ind);
            }
        }
        if (g_nodes[n].kind == N_DECL || g_nodes[n].kind == N_ASSIGN
            || g_nodes[n].kind == N_EXPR || g_nodes[n].kind == N_POST) {
            self->emit_indent(ind);
            if (self->emit_inline(n) != 0) return -1;
            fputs(";\n", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_IF) {
            self->emit_indent(ind);
            fputs("if (", g_out);
            if (self->emit_cond(g_nodes[n].a) != 0) return -1;
            fputs(") ", g_out);
            if (self->emit_node(g_nodes[n].b, ind) != 0) return -1;
            if (g_nodes[n].c >= 0) {
                self->emit_indent(ind);
                fputs("else ", g_out);
                if (self->emit_node(g_nodes[n].c, ind) != 0) return -1;
            }
            return 0;
        }
        if (g_nodes[n].kind == N_WHILE) {
            self->emit_indent(ind);
            fputs("while (", g_out);
            if (self->emit_cond(g_nodes[n].a) != 0) return -1;
            fputs(") ", g_out);
            return self->emit_node(g_nodes[n].b, ind);
        }
        if (g_nodes[n].kind == N_FOR) {
            self->emit_indent(ind);
            fputs("for (", g_out);
            if (g_nodes[n].a >= 0 && self->emit_inline(g_nodes[n].a) != 0) return -1;
            fputs("; ", g_out);
            if (g_nodes[n].b >= 0 && self->emit_cond(g_nodes[n].b) != 0) return -1;
            fputs("; ", g_out);
            if (g_nodes[n].c >= 0 && self->emit_inline(g_nodes[n].c) != 0) return -1;
            fputs(") ", g_out);
            return self->emit_node(g_nodes[n].d, ind);
        }
        {
            char msg[MAX_TEXT];
            snprintf(msg, sizeof msg, "unknown statement node (kind %d)", g_nodes[n].kind);
            return self->fail(msg);
        }
    }

    int emit_inline(int n)
    {
        (void)self;

        if (g_nodes[n].kind == N_DECLS) {
            /* a `for` initialiser: one shared type, then bare declarators */
            int c = g_nodes[n].a, first = 1;
            while (c >= 0) {
                if (first) {
                    if (self->emit_inline(c) != 0) return -1;
                } else {
                    fputs(", ", g_out);
                    fputs(g_nodes[c].text2, g_out);
                    if (g_nodes[c].text3[0]) fputs(g_nodes[c].text3, g_out);
                    if (g_nodes[c].a >= 0) {
                        if (g_nodes[g_nodes[c].a].kind == N_RAW) {
                            if (self->emit_raw_init(g_nodes[c].a, g_nodes[c].text) != 0) return -1;
                        } else {
                            fputs(" = ", g_out);
                            if (self->emit_expr(g_nodes[c].a) != 0) return -1;
                        }
                    }
                }
                first = 0;
                c = g_nodes[c].next;
            }
            return 0;
        }
        if (g_nodes[n].kind == N_DECL || g_nodes[n].kind == N_FIELD) {
            fprintf(g_out, "%s %s", g_nodes[n].text, g_nodes[n].text2);
            if (g_nodes[n].text3[0]) fputs(g_nodes[n].text3, g_out);
            if (g_nodes[n].kind == N_DECL) {
                if (g_nodes[n].a >= 0 && g_nodes[g_nodes[n].a].kind == N_RAW) {
                    if (self->emit_raw_init(g_nodes[n].a, g_nodes[n].text) != 0) return -1;
                } else if (g_nodes[n].a >= 0) {
                    fputs(" = ", g_out);
                    if (self->emit_expr(g_nodes[n].a) != 0) return -1;
                } else if (self->type_needs_init(g_nodes[n].text) && !g_nodes[n].text3[0]) {
                    fputs(" = { ", g_out);
                    if (self->emit_vptr_items("", g_nodes[n].text) != 0) return -1;
                    if (self->emit_field_vptrs(self->find_struct(
                            strncmp(g_nodes[n].text, "struct ", 7) == 0
                                ? g_nodes[n].text + 7 : g_nodes[n].text),
                            self->type_has_vptr(g_nodes[n].text)) != 0) return -1;
                    fputs(" }", g_out);
                }
            }
            return 0;
        }
        if (g_nodes[n].kind == N_ASSIGN) {
            const char *aop = " = ";
            if (g_nodes[n].aux == 1) aop = " += ";
            else if (g_nodes[n].aux == 2) aop = " -= ";
            else if (g_nodes[n].aux == 3) aop = " *= ";
            else if (g_nodes[n].aux == 4) aop = " /= ";
            else if (g_nodes[n].aux == 5) aop = " %= ";
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(aop, g_out);
            return self->emit_expr(g_nodes[n].b);
        }
        if (g_nodes[n].kind == N_EXPR) return self->emit_expr(g_nodes[n].a);
        if (g_nodes[n].kind == N_POST) {
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(g_nodes[n].aux == P_INC ? "++" : "--", g_out);
            return 0;
        }
        return self->fail("cannot inline this node");
    }

    int emit_cond(int n)
    {
        const char *op;
        (void)self;

        if (g_nodes[n].kind == N_BIN && g_nodes[n].aux >= B_LT && g_nodes[n].aux <= B_NE) {
            op = "<";
            if (g_nodes[n].aux == B_GT) op = ">";
            else if (g_nodes[n].aux == B_LE) op = "<=";
            else if (g_nodes[n].aux == B_GE) op = ">=";
            else if (g_nodes[n].aux == B_EQ) op = "==";
            else if (g_nodes[n].aux == B_NE) op = "!=";
            else if (g_nodes[n].aux == B_AND) op = "&&";
            else if (g_nodes[n].aux == B_OR) op = "||";
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fprintf(g_out, " %s ", op);
            return self->emit_expr(g_nodes[n].b);
        }
        return self->emit_expr(n);
    }

    int emit_expr(int n)
    {
        int c;
        const char *op;
        (void)self;

        if (g_nodes[n].kind == N_NUM) {
            fprintf(g_out, "%ld", g_nodes[n].num);
            return 0;
        }
        if (g_nodes[n].kind == N_STR) {
            fputs(g_strpool + g_nodes[n].num, g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_RAW) {
            fputs(g_nodes[n].text, g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_VAR) {
            if (g_self_mode && strcmp(g_nodes[n].text2, "self") == 0) fputs("_self", g_out);
            else fputs(g_nodes[n].text2, g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_MEMBER) {
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fprintf(g_out, ".%s", g_nodes[n].text2);
            return 0;
        }
        if (g_nodes[n].kind == N_ARROW) {
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fprintf(g_out, "->%s", g_nodes[n].text2);
            return 0;
        }
        if (g_nodes[n].kind == N_INDEX) {
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs("[", g_out);
            if (self->emit_expr(g_nodes[n].b) != 0) return -1;
            fputs("]", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_ADDR) {
            fputs("(&", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_DEREF) {
            fputs("(*", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_CAST) {
            fprintf(g_out, "(%s)(", g_nodes[n].text);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_SIZEOF) {
            if (g_nodes[n].aux) {
                fprintf(g_out, "sizeof(%s)", g_nodes[n].text);
                return 0;
            }
            fputs("sizeof(", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_POST) {
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(g_nodes[n].aux == P_INC ? "++" : "--", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_TERN) {
            fputs("(", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(" ? ", g_out);
            if (self->emit_expr(g_nodes[n].b) != 0) return -1;
            fputs(" : ", g_out);
            if (self->emit_expr(g_nodes[n].c) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_BIN) {
            op = "+";
            if (g_nodes[n].aux == B_SUB) op = "-";
            else if (g_nodes[n].aux == B_MUL) op = "*";
            else if (g_nodes[n].aux == B_DIV) op = "/";
            else if (g_nodes[n].aux == B_MOD) op = "%";
            else if (g_nodes[n].aux == B_LT) op = "<";
            else if (g_nodes[n].aux == B_GT) op = ">";
            else if (g_nodes[n].aux == B_LE) op = "<=";
            else if (g_nodes[n].aux == B_GE) op = ">=";
            else if (g_nodes[n].aux == B_EQ) op = "==";
            else if (g_nodes[n].aux == B_NE) op = "!=";
            else if (g_nodes[n].aux == B_AND) op = "&&";
            else if (g_nodes[n].aux == B_OR) op = "||";
            fputs("(", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fprintf(g_out, " %s ", op);
            if (self->emit_expr(g_nodes[n].b) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_UNARY) {
            fputs(g_nodes[n].aux == U_NEG ? "(-" : "(!", g_out);
            if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_BOX) {
            fprintf(g_out, "(struct %s_iface){ (void *)", g_nodes[n].text);
            if (g_nodes[n].aux) {
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            } else {
                fputs("&", g_out);
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            }
            fprintf(g_out, ", &%s_%s_vtable }", g_nodes[n].text2, g_nodes[n].text);
            return 0;
        }
        if (g_nodes[n].kind == N_MCALL) {
            char tname[MAX_TEXT];
            char low[MAX_TEXT];
            int i, c2, rk;
            if (g_nodes[n].a < 0) return self->fail("method call without a receiver");
            rk = g_nodes[g_nodes[n].a].kind;
            if (rk != N_VAR && rk != N_INDEX && rk != N_CALL
                && rk != N_MEMBER && rk != N_ARROW)
                return self->fail("method receiver must be a variable, an element, a call or a field chain");
            if (!g_nodes[n].text[0])
                return self->fail("cannot resolve the method trait (unknown receiver type)");
            snprintf(tname, sizeof tname, "%s", g_nodes[n].text);
            for (i = 0; tname[i] && i + 1 < MAX_TEXT; i++) {
                char c = tname[i];
                if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
                low[i] = c;
            }
            low[i] = 0;
            if (g_nodes[n].aux == 3) {
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
                fprintf(g_out, ".vt->%s(", g_nodes[n].text2);
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
                fputs(".self", g_out);
            } else if (g_nodes[n].aux == 2) {
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
                fprintf(g_out, "->__%s_vptr->%s(", low, g_nodes[n].text2);
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            } else {
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
                fprintf(g_out, ".__%s_vptr->%s(&", low, g_nodes[n].text2);
                if (self->emit_expr(g_nodes[n].a) != 0) return -1;
            }
            c2 = g_nodes[n].b;
            while (c2 >= 0) {
                fputs(", ", g_out);
                if (self->emit_expr(c2) != 0) return -1;
                c2 = g_nodes[c2].next;
            }
            fputs(")", g_out);
            return 0;
        }
        if (g_nodes[n].kind == N_CALL) {
            fprintf(g_out, "%s(", g_nodes[n].text2);
            c = g_nodes[n].a;
            while (c >= 0) {
                if (self->emit_expr(c) != 0) return -1;
                c = g_nodes[c].next;
                if (c >= 0) fputs(", ", g_out);
            }
            fputs(")", g_out);
            return 0;
        }
        return self->fail("unknown expression node");
    }

    /* `foo` -> `FOO_H`; a leading digit gets an underscore so the guard is a
       valid identifier. */
    int header_guard(const char *base, char *out, size_t cap)
    {
        size_t n, i, m;
        (void)self;

        n = strlen(base);
        m = 0;
        if (n > 0 && base[0] >= '0' && base[0] <= '9') {
            out[m] = '_';
            m++;
        }
        for (i = 0; i < n; i++) {
            char c = base[i];
            if (c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
            else if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) c = '_';
            if (m + 1 >= cap) return self->fail("output name too long");
            out[m] = c;
            m++;
        }
        if (m + 3 >= cap) return self->fail("output name too long");
        out[m] = '_';
        out[m + 1] = 'H';
        out[m + 2] = 0;
        return 0;
    }

    /* Build mode: one `.c` per unit. It includes its own header (so the `pub`
       declarations are visible exactly once) and the headers of its imports. */
    int emit_unit(int u)
    {
        char path[MAX_PATH];
        int n, i;
        FILE *f;
        (void)self;

        if (snprintf(path, sizeof path, "%s/%s.c", g_outdir, g_units[u].base) >= (int)sizeof path)
            return self->fail("output path is too long");
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the output file");
        g_out = f;
        g_path = g_units[u].path;
        fprintf(g_out, "/* Generated by ct v%s from %s -- do not edit; change the .ct and re-run ct. */\n",
                CTC_VERSION, g_path);
        fputs("/* Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n",
              g_out);
        fprintf(g_out, "#include \"%s.h\"\n", g_units[u].base);
        for (i = 0; i < g_units[u].ndep; i++)
            fprintf(g_out, "#include \"%s.h\"\n", g_units[u].dep[i]);
        fputs("\n", g_out);
        if (g_line_mode) fprintf(g_out, "#line 1 \"%s\"\n", g_path);

        for (n = g_nodes[g_units[u].prog].a; n >= 0; n = g_nodes[n].next)
            if (g_nodes[n].kind == N_PP) fprintf(g_out, "%s\n", g_nodes[n].text);

        if (self->emit_trait_range(g_units[u].tr_start, g_units[u].tr_end, 2) != 0) return -1;
        if (self->emit_vtable_fwd(g_units[u].prog) != 0) return -1;

        for (n = g_nodes[g_units[u].prog].a; n >= 0; n = g_nodes[n].next) {
            if ((g_nodes[n].kind == N_STRUCT || g_nodes[n].kind == N_TYPEDEF
                 || g_nodes[n].kind == N_GLOBAL) && g_nodes[n].d != 1) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        if (self->emit_impls(g_units[u].prog) != 0) return -1;

        for (i = g_units[u].fn_start; i < g_units[u].fn_end; i++)
            if (self->emit_proto(i) != 0) return -1;

        for (n = g_nodes[g_units[u].prog].a; n >= 0; n = g_nodes[n].next)
            if (g_nodes[n].kind == N_FUNC && self->emit_node(n, 0) != 0) return -1;

        if (fclose(f) != 0) return self->fail("cannot write the output file");
        return 0;
    }

    /* Build mode: the unit's exported surface (D34 keeps the naming contract,
       not byte equality with the old pipeline). */
    int write_unit_header(int u)
    {
        char path[MAX_PATH];
        char guard[MAX_PATH];
        int n, i;
        FILE *f;
        (void)self;

        if (snprintf(path, sizeof path, "%s/%s.h", g_outdir, g_units[u].base) >= (int)sizeof path)
            return self->fail("output path is too long");
        if (self->header_guard(g_units[u].base, guard, sizeof guard) != 0) return -1;
        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        g_out = f;
        g_path = g_units[u].path;
        fprintf(g_out, "#ifndef %s\n", guard);
        fprintf(g_out, "#define %s\n\n", guard);
        fprintf(g_out, "/* Generated by ct v%s from %s (multi-file mode: exported types; the matching .c\n"
                       "   includes this header).\n"
                       "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                CTC_VERSION, g_path);
        for (i = 0; i < g_units[u].ndep; i++)
            fprintf(g_out, "#include \"%s.h\"\n", g_units[u].dep[i]);
        if (g_units[u].ndep > 0) fputs("\n", g_out);

        if (self->emit_trait_range(g_units[u].tr_start, g_units[u].tr_end, 1) != 0) return -1;

        for (n = g_nodes[g_units[u].prog].a; n >= 0; n = g_nodes[n].next) {
            if ((g_nodes[n].kind == N_STRUCT || g_nodes[n].kind == N_TYPEDEF)
                && g_nodes[n].d == 1) {
                if (self->emit_type_decl(n, 0, 1) != 0) return -1;
            }
        }

        for (i = g_units[u].fn_start; i < g_units[u].fn_end; i++) {
            if (!g_funcs[i].is_pub || g_funcs[i].is_static) continue;
            if (self->emit_proto(i) != 0) return -1;
        }

        fputs("\n#endif\n", g_out);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }

    /* JSON string body (no surrounding quotes). */
    int emit_json_str(FILE *f, const char *s)
    {
        (void)self;
        for (; *s; s++) {
            if (*s == '"' || *s == '\\') {
                fputc('\\', f);
                fputc(*s, f);
            } else if (*s == '\n') {
                fputs("\\n", f);
            } else if (*s == '\t') {
                fputs("\\t", f);
            } else if ((unsigned char)*s < 0x20) {
                fputc('?', f);
            } else {
                fputc(*s, f);
            }
        }
        return 0;
    }

    /* `--emit-map`: the same shape the old pipeline emits (compiler / file /
       traits / structs / functions / impls / calls). `u < 0` means compile
       mode, where the tables cover the single unit. */
    int write_map(const char *dest, int prog, int u)
    {
        FILE *f;
        const char *path;
        int trs, tre, fns, fne, cls, cle;
        int i, m, n, first, si, count;
        (void)self;

        if (strcmp(dest, "-") == 0) {
            f = stdout;
        } else {
            f = fopen(dest, "w");
            if (!f) return self->fail("cannot write the map");
        }
        if (u >= 0) {
            path = g_units[u].path;
            trs = g_units[u].tr_start;
            tre = g_units[u].tr_end;
            fns = g_units[u].fn_start;
            fne = g_units[u].fn_end;
            cls = g_units[u].call_start;
            cle = g_units[u].call_end;
        } else {
            path = g_path;
            trs = 0;
            tre = g_ntraits;
            fns = 0;
            fne = g_nfunc;
            cls = 0;
            cle = g_ncalls;
        }

        fputs("{\n", f);
        fprintf(f, "  \"compiler\": \"ct v%s\",\n", CTC_VERSION);
        fputs("  \"file\": \"", f);
        self->emit_json_str(f, path);
        fputs("\",\n", f);

        fputs("  \"traits\": [", f);
        first = 1;
        for (i = trs; i < tre; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, g_traits[i].name);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, g_traits[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"methods\":[", g_traits[i].line);
            for (m = 0; m < g_traits[i].nm; m++) {
                if (m > 0) fputc(',', f);
                fputs("{\"name\":\"", f);
                self->emit_json_str(f, g_traits[i].m[m].name);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, g_traits[i].m[m].ret);
                fprintf(f, "\",\"params\":%d}", g_traits[i].m[m].nparams);
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"structs\": [", f);
        first = 1;
        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            if (g_nodes[n].kind != N_STRUCT) continue;
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, g_nodes[n].text2);
            fputs("\",\"cname\":\"", f);
            self->emit_json_str(f, g_nodes[n].text2);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"uses\":[", g_nodes[n].line);
            si = self->find_struct(g_nodes[n].text2);
            if (si >= 0) {
                for (i = 0; i < g_structs[si].nuse; i++) {
                    if (i > 0) fputc(',', f);
                    fputc('"', f);
                    self->emit_json_str(f, g_structs[si].use[i]);
                    fputc('"', f);
                }
            }
            fputs("]}", f);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"functions\": [", f);
        first = 1;
        for (i = fns; i < fne; i++) {
            if (!first) fputc(',', f);
            fputs("{\"name\":\"", f);
            self->emit_json_str(f, g_funcs[i].name);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d,\"ret\":\"", g_funcs[i].line);
            self->emit_json_str(f, g_funcs[i].ret);
            fprintf(f, "\",\"params\":%d}", g_funcs[i].nparams);
            first = 0;
        }
        fputs("],\n", f);

        fputs("  \"impls\": [", f);
        first = 1;
        for (n = g_nodes[prog].a; n >= 0; n = g_nodes[n].next) {
            const char *tname;
            if (g_nodes[n].kind != N_IMPL) continue;
            si = g_nodes[n].aux;
            tname = g_nodes[n].text2;
            for (m = g_nodes[n].a; m >= 0; m = g_nodes[m].next) {
                if (!first) fputc(',', f);
                fputs("{\"struct\":\"", f);
                self->emit_json_str(f, g_structs[si].name);
                fputs("\",\"trait\":\"", f);
                self->emit_json_str(f, tname);
                fputs("\",\"method\":\"", f);
                self->emit_json_str(f, g_nodes[m].text2);
                fputs("\",\"symbol\":\"", f);
                fprintf(f, "%s_%s_%s", g_structs[si].name, tname, g_nodes[m].text2);
                fputs("\",\"ret\":\"", f);
                self->emit_json_str(f, g_nodes[m].text);
                count = 0;
                for (i = g_nodes[m].a; i > 0; i = g_nodes[i].next) count++;
                fprintf(f, "\",\"params\":%d,\"file\":\"", count);
                self->emit_json_str(f, path);
                fprintf(f, "\",\"line\":%d}", g_nodes[n].line);
                first = 0;
            }
        }
        fputs("],\n", f);

        fputs("  \"calls\": [", f);
        for (i = cls; i < cle; i++) {
            if (i > cls) fputc(',', f);
            fputs("{\"caller\":\"", f);
            self->emit_json_str(f, g_calls[i].caller);
            fputs("\",\"callee\":\"", f);
            self->emit_json_str(f, g_calls[i].callee);
            fputs("\",\"file\":\"", f);
            self->emit_json_str(f, path);
            fprintf(f, "\",\"line\":%d}", g_calls[i].line);
        }
        fputs("]\n", f);
        fputs("}\n", f);

        if (f != stdout) {
            if (fclose(f) != 0) return self->fail("cannot write the map");
        }
        return 0;
    }

    /* Compile mode: a placeholder header (types only; the .c is self-contained). */
    int write_header(const char *outc)
    {
        char path[MAX_PATH];
        char base[MAX_PATH];
        char guard[MAX_PATH];
        const char *name;
        FILE *f;
        size_t n;

        (void)self;
        if (snprintf(path, sizeof path, "%s", outc) >= (int)sizeof path)
            return self->fail("output path too long");
        n = strlen(path);
        if (n < 3 || path[n - 1] != 'c' || path[n - 2] != '.')
            return self->fail("output must end in .c");
        path[n - 1] = 'h';
        name = strrchr(path, '/');
        name = name ? name + 1 : path;
        if (snprintf(base, sizeof base, "%s", name) >= (int)sizeof base)
            return self->fail("output path too long");
        n = strlen(base);
        if (n < 3) return self->fail("output name too short");
        base[n - 2] = 0;
        if (self->header_guard(base, guard, sizeof guard) != 0) return -1;

        f = fopen(path, "w");
        if (!f) return self->fail("cannot write the header");
        fprintf(f, "#ifndef %s\n", guard);
        fprintf(f, "#define %s\n\n", guard);
        fprintf(f, "/* Generated by ct v%s from %s (Phase 0: types only, the\n"
                   "   generated .c is self-contained).\n"
                   "   Generated output is not covered by the GPL and may be used without restriction (LICENSE.EXCEPTION). */\n\n",
                CTC_VERSION, g_path);
        fputs("#endif\n", f);
        if (fclose(f) != 0) return self->fail("cannot write the header");
        return 0;
    }
}

/* The instance lives after the impls: its vptr initialisers need the vtable
   forward declarations the emitter places with each impl. */
static struct Ast g_ast;

int main(int argc, char **argv)
{
    return g_ast.run(argc, argv);
}
