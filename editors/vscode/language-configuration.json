{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^((?!.*?/\\*).*\\*/)?\\s*.*\\{[^}\"']*$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*/\\*(?!\\*)(?![^\\*]*\\*/).*$",
      "afterText": "^(?![\\s*]*\\*/)",
      "action": { "indent": "none", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*/\\*\\*(?![^\\*]*\\*/).*$",
      "afterText": "^(?!\\s*\\*/)",
      "action": { "indent": "none", "appendText": " * " }
    }
  ]
}
