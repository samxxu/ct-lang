{
  "name": "CT",
  "scopeName": "source.ct",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#ct-raw" },
    { "include": "#ct-raw-end" },
    { "include": "#ct-import" },
    { "include": "#ct-namespace" },
    { "include": "#ct-type-alias" },
    { "include": "#ct-generic-struct" },
    { "include": "#ct-generic-impl" },
    { "include": "#ct-generic-decl" },
    { "include": "#ct-generic-call" },
    { "include": "#ct-generic-static-call" },
    { "include": "#ct-generic-type" },
    { "include": "#ct-path" },
    { "include": "#ct-trait" },
    { "include": "#ct-trait-open" },
    { "include": "#ct-impl" },
    { "include": "#ct-impl-open" },
    { "include": "#ct-map" },
    { "include": "#ct-map-namespace" },
    { "include": "#ct-map-type" },
    { "include": "#ct-map-open" },
    { "include": "#ct-recipe" },
    { "include": "#ct-use" },
    { "include": "#ct-self" },
    { "include": "#ct-delete" },
    { "include": "#ct-own" },
    { "include": "#ct-borrow" },
    { "include": "#ct-borrow-param" },
    { "include": "#ct-trait-builtin" },
    { "include": "#ct-pub" },
    { "include": "#ct-loop" },
    { "include": "#ct-foreach" },
    { "include": "#ct-into-inline-method" },
    { "include": "#ct-into-inline-field" },
    { "include": "#ct-into" },
    { "include": "#ct-into-method" },
    { "include": "#ct-into-field" },
    { "include": "#ct-foreach-entry" },
    { "include": "#ct-container-method" },
    { "include": "#ct-range-dots" },
    { "include": "#ct-range-index" },
    { "include": "#ct-closure-arrow" },
    { "include": "#ct-static-assert" },
    { "include": "#ct-alignas" },
    { "include": "#ct-alignof-type" },
    { "include": "#ct-alignof" },
    { "include": "#ct-atomic" },
    { "include": "#ct-generic-select" },
    { "include": "#ct-noreturn" },
    { "include": "#ct-thread-local" },
    { "include": "#ct-c11-builtin-types" },
    { "include": "#ct-attribute" },
    { "include": "source.c" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#comment-line" },
        { "include": "#comment-block" }
      ]
    },
    "comment-line": {
      "match": "//.*$",
      "name": "comment.line.double-slash.ct"
    },
    "comment-block": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.ct"
    },
    "strings": {
      "patterns": [
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },
    "string-double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.ct",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.ct" }
      ]
    },
    "string-single": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.ct",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.ct" }
      ]
    },
    "ct-raw": {
      "begin": "^#ct-raw[ \\t]*$",
      "end": "^#ct-endraw[ \\t]*$",
      "name": "meta.raw.ct",
      "contentName": "source.c"
    },
    "ct-raw-end": {
      "match": "^#ct-endraw[ \\t]*$",
      "name": "meta.raw.ct"
    },
    "ct-import": {
      "match": "^[ \\t]*(import)[ \\t]+([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*::[ \\t]*[A-Za-z_][A-Za-z0-9_]*)*)(?:[ \\t]+(as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?[ \\t]*;",
      "captures": {
        "1": { "name": "keyword.other.import.ct" },
        "2": {
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.namespace.ct" }
          ]
        },
        "3": { "name": "keyword.other.as.ct" },
        "4": { "name": "entity.name.type.alias.ct" }
      }
    },
    "ct-namespace": {
      "match": "^[ \\t]*(namespace)[ \\t]+([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*::[ \\t]*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "storage.type.namespace.ct" },
        "2": {
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.namespace.ct" }
          ]
        }
      }
    },
    "ct-type-alias": {
      "match": "^[ \\t]*(?:(pub)[ \\t]+)?(type)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(=)",
      "captures": {
        "1": { "name": "storage.modifier.pub.ct" },
        "2": { "name": "storage.type.alias.ct" },
        "3": { "name": "entity.name.type.alias.ct" },
        "4": { "name": "keyword.operator.assignment.ct" }
      }
    },
    "ct-generic-struct": {
      "match": "^[ \\t]*(?:(pub)[ \\t]+)?(struct)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(<)[ \\t]*([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*,[ \\t]*[A-Za-z_][A-Za-z0-9_]*)?)[ \\t]*(>)",
      "captures": {
        "1": { "name": "storage.modifier.pub.ct" },
        "2": { "name": "storage.type.struct.ct" },
        "3": { "name": "entity.name.type.struct.ct" },
        "4": { "name": "punctuation.definition.generic.begin.ct" },
        "5": {
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.parameter.ct" }
          ]
        },
        "6": { "name": "punctuation.definition.generic.end.ct" }
      }
    },
    "ct-generic-decl": {
      "match": "^[ \\t]*(?!(?:return|goto|case|else|do|sizeof|typedef|switch|while|for|if|break|continue)\\b)([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(\\*+)?[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(<)[ \\t]*([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]*(:)[ \\t]*([A-Za-z_][A-Za-z0-9_]*))?[ \\t]*(>)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.type.generic.ct" },
        "2": { "name": "keyword.operator.pointer.ct" },
        "3": { "name": "entity.name.function.ct" },
        "4": { "name": "punctuation.definition.generic.begin.ct" },
        "5": { "name": "entity.name.type.parameter.ct" },
        "6": { "name": "keyword.operator.constraint.ct" },
        "7": { "name": "entity.name.type.trait.ct" },
        "8": { "name": "punctuation.definition.generic.end.ct" }
      }
    },
    "ct-generic-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(<)[ \\t]*((?:(?:struct|union|enum|const|volatile|unsigned|signed)[ \\t]+)*[A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*\\*+)?)[ \\t]*(>)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.ct" },
        "2": { "name": "punctuation.definition.generic.begin.ct" },
        "3": { "name": "entity.name.type.generic.ct" },
        "4": { "name": "punctuation.definition.generic.end.ct" }
      }
    },
    "ct-generic-static-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(<)([^;{}()=\\n]*?)[ \\t]*(>)([ \\t]*::[ \\t]*)([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.type.generic.ct" },
        "2": { "name": "punctuation.definition.generic.begin.ct" },
        "3": {
          "patterns": [
            { "match": "\\b(?:struct|union|enum|const|volatile|unsigned|signed)\\b", "name": "storage.type.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.generic.ct" },
            { "match": "\\*", "name": "keyword.operator.pointer.ct" },
            { "match": ",", "name": "punctuation.separator.comma.ct" }
          ]
        },
        "4": { "name": "punctuation.definition.generic.end.ct" },
        "5": { "name": "punctuation.separator.namespace.ct" },
        "6": { "name": "entity.name.function.ct" }
      }
    },
    "ct-generic-type": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(<)([^;{}()=\\n]*?)[ \\t]*(>)(?=[ \\t]*[A-Za-z_*&])",
      "captures": {
        "1": { "name": "entity.name.type.generic.ct" },
        "2": { "name": "punctuation.definition.generic.begin.ct" },
        "3": {
          "patterns": [
            { "match": "\\b(?:struct|union|enum|const|volatile|unsigned|signed)\\b", "name": "storage.type.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.generic.ct" },
            { "match": "\\*", "name": "keyword.operator.pointer.ct" },
            { "match": ",", "name": "punctuation.separator.comma.ct" }
          ]
        },
        "4": { "name": "punctuation.definition.generic.end.ct" }
      }
    },
    "ct-path": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)((?:[ \\t]*::[ \\t]*[A-Za-z_][A-Za-z0-9_]*)+)",
      "captures": {
        "1": { "name": "entity.name.namespace.ct" },
        "2": {
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.namespace.ct" }
          ]
        }
      }
    },
    "ct-trait": {
      "match": "^[ \\t]*(?:(pub)[ \\t]+)?(trait)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.pub.ct" },
        "2": { "name": "storage.type.trait.ct" },
        "3": { "name": "entity.name.type.trait.ct" }
      }
    },
    "ct-trait-open": {
      "begin": "^[ \\t]*(?:(pub)[ \\t]+)?(trait)[ \\t]+(?=[A-Za-z_])",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pub.ct" },
        "2": { "name": "storage.type.trait.ct" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.trait.ct" }
      ]
    },
    "ct-impl": {
      "match": "^\\s*(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.impl.ct" },
        "2": { "name": "entity.name.type.trait.ct" },
        "3": { "name": "keyword.control.ct" },
        "4": { "name": "entity.name.type.struct.ct" }
      }
    },
    "ct-generic-impl": {
      "match": "^[ \\t]*(impl)[ \\t]*(<)[ \\t]*([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*,[ \\t]*[A-Za-z_][A-Za-z0-9_]*)?)[ \\t]*(>)[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(<)[ \\t]*([^<>{}]*?)[ \\t]*(>)[ \\t]*(?:(use)[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?[ \\t]*(?=\\{)",
      "captures": {
        "1": { "name": "storage.type.impl.ct" },
        "2": { "name": "punctuation.definition.generic.begin.ct" },
        "3": {
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.parameter.ct" }
          ]
        },
        "4": { "name": "punctuation.definition.generic.end.ct" },
        "5": { "name": "entity.name.type.struct.ct" },
        "6": { "name": "punctuation.definition.generic.begin.ct" },
        "7": {
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.generic.ct" },
            { "match": ",", "name": "punctuation.separator.comma.ct" }
          ]
        },
        "8": { "name": "punctuation.definition.generic.end.ct" },
        "9": { "name": "keyword.other.use.ct" },
        "10": { "name": "entity.name.type.trait.ct" }
      }
    },
    "ct-impl-open": {
      "begin": "^[ \\t]*(impl)[ \\t]+(?=[A-Za-z_])",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": { "name": "storage.type.impl.ct" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "match": "\\b(for)\\b", "name": "keyword.control.ct" },
        { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.ct" }
      ]
    },
    "ct-map": {
      "match": "^[ \\t]*(map)[ \\t]+(trait)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+(for)[ \\t]+(instance)[ \\t]+([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*::[ \\t]*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "storage.type.map.ct" },
        "2": { "name": "storage.type.trait.ct" },
        "3": { "name": "entity.name.type.trait.ct" },
        "4": { "name": "keyword.control.ct" },
        "5": { "name": "keyword.other.instance.ct" },
        "6": {
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.struct.ct" }
          ]
        }
      }
    },
    "ct-map-namespace": {
      "match": "^[ \\t]*(map)[ \\t]+(trait)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+(for)[ \\t]+(namespace)[ \\t]+([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*::[ \\t]*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "storage.type.map.ct" },
        "2": { "name": "storage.type.trait.ct" },
        "3": { "name": "entity.name.type.trait.ct" },
        "4": { "name": "keyword.control.ct" },
        "5": { "name": "keyword.other.namespace.ct" },
        "6": {
          "patterns": [
            { "match": "::", "name": "punctuation.separator.namespace.ct" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.namespace.ct" }
          ]
        }
      }
    },
    "ct-map-type": {
      "match": "^[ \\t]*(map)[ \\t]+(trait)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+(for)[ \\t]+(type)[ \\t]+([^;{}]*?)[ \\t]*\\{",
      "captures": {
        "1": { "name": "storage.type.map.ct" },
        "2": { "name": "storage.type.trait.ct" },
        "3": { "name": "entity.name.type.trait.ct" },
        "4": { "name": "keyword.control.ct" },
        "5": { "name": "keyword.other.type.ct" },
        "6": { "patterns": [ { "include": "source.c" } ] }
      }
    },
    "ct-map-open": {
      "begin": "^[ \\t]*(map)[ \\t]+(?=trait\\b)",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": { "name": "storage.type.map.ct" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "match": "\\b(trait|for)\\b", "name": "keyword.control.ct" },
        { "match": "\\b(instance|namespace|type)\\b", "name": "keyword.other.host.ct" },
        { "match": "::", "name": "punctuation.separator.namespace.ct" },
        { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.ct" }
      ]
    },
    "ct-recipe": {
      "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*\\([^()]*\\)[ \\t]+(->)[ \\t]+",
      "captures": {
        "1": { "name": "entity.name.function.ct" },
        "2": { "name": "keyword.other.recipe.ct" }
      }
    },
    "ct-use": {
      "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*;",
      "captures": {
        "1": { "name": "keyword.other.use.ct" },
        "2": {
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.trait.ct" }
          ]
        }
      }
    },
    "ct-self": {
      "match": "\\bself\\b",
      "name": "variable.language.self.ct"
    },
    "ct-delete": {
      "match": "\\b(delete)\\b",
      "captures": {
        "1": { "name": "keyword.other.delete.ct" }
      }
    },
    "ct-own": {
      "match": "^[ \\t]*(own)\\b",
      "captures": {
        "1": { "name": "storage.modifier.own.ct" }
      }
    },
    "ct-borrow": {
      "match": "^[ \\t]*(borrow)\\b",
      "captures": {
        "1": { "name": "storage.modifier.borrow.ct" }
      }
    },
    "ct-borrow-param": {
      "match": "\\b(borrow)[ \\t]+(?=[A-Za-z_])",
      "captures": {
        "1": { "name": "storage.modifier.borrow.ct" }
      }
    },
    "ct-trait-builtin": {
      "match": "\\b(Handback|Drop)\\b",
      "captures": {
        "1": { "name": "entity.name.type.trait.ct" }
      }
    },
    "ct-pub": {
      "match": "^[ \\t]*(pub)\\b",
      "captures": {
        "1": { "name": "storage.modifier.pub.ct" }
      }
    },
    "ct-loop": {
      "match": "(?<![.>])\\b(loop)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "keyword.control.loop.ct" }
      }
    },
    "ct-foreach": {
      "match": "(?<![.>])\\b(foreach)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "keyword.control.foreach.ct" }
      }
    },
    "ct-into-inline-method": {
      "match": "\\b(into)([ \\t]*)(\\{)([ \\t]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "keyword.control.into.ct" },
        "3": { "name": "punctuation.definition.block.ct" },
        "5": { "name": "punctuation.accessor.ct" },
        "6": { "name": "entity.name.function.ct" }
      }
    },
    "ct-into-inline-field": {
      "match": "\\b(into)([ \\t]*)(\\{)([ \\t]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.into.ct" },
        "3": { "name": "punctuation.definition.block.ct" },
        "5": { "name": "punctuation.accessor.ct" },
        "6": { "name": "variable.other.property.ct" }
      }
    },
    "ct-into": {
      "match": "\\b(into)\\b[ \\t]*(\\{)",
      "captures": {
        "1": { "name": "keyword.control.into.ct" },
        "2": { "name": "punctuation.definition.block.ct" }
      }
    },
    "ct-into-method": {
      "match": "(?:^|(?<=[;]))[ \\t]*(\\.)([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "punctuation.accessor.ct" },
        "2": { "name": "entity.name.function.ct" }
      }
    },
    "ct-into-field": {
      "match": "(?:^|(?<=[;]))[ \\t]*(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.accessor.ct" },
        "2": { "name": "variable.other.property.ct" }
      }
    },
    "ct-foreach-entry": {
      "match": "\\b(item)([ \\t]*)(\\.)([ \\t]*)(key|value)\\b",
      "captures": {
        "1": { "name": "variable.other.foreach-item.ct" },
        "3": { "name": "punctuation.accessor.ct" },
        "5": { "name": "variable.other.property.ct" }
      }
    },
    "ct-container-method": {
      "match": "(?:\\.|->)(len|get|set|push|pop|clear|retain|release|put|remove|entry|from)[ \\t]*(?=\\()",
      "captures": {
        "1": { "name": "support.function.container.ct" }
      }
    },
    "ct-range-dots": {
      "match": "(?<!\\.)\\.\\.(?!\\.)",
      "name": "keyword.operator.range.ct"
    },
    "ct-range-index": {
      "match": "\\$",
      "name": "variable.language.range-index.ct"
    },
    "ct-closure-arrow": {
      "match": "=>",
      "name": "keyword.operator.closure.ct"
    },
    "ct-static-assert": {
      "match": "\\b(_Static_assert|static_assert)\\b",
      "captures": {
        "1": { "name": "keyword.control.static-assert.ct" }
      }
    },
    "ct-alignas": {
      "match": "\\b_Alignas\\b",
      "name": "storage.modifier.alignas.ct"
    },
    "ct-alignof-type": {
      "match": "\\b(_Alignof|alignof)[ \\t]+(?![(])([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*\\*+)?)",
      "captures": {
        "1": { "name": "keyword.operator.alignof.ct" },
        "2": { "name": "entity.name.type.generic.ct" }
      }
    },
    "ct-alignof": {
      "match": "\\b(_Alignof|alignof)\\b",
      "name": "keyword.operator.alignof.ct"
    },
    "ct-atomic": {
      "match": "\\b_Atomic\\b",
      "name": "storage.modifier.atomic.ct"
    },
    "ct-generic-select": {
      "match": "\\b_Generic\\b",
      "name": "keyword.control.generic.ct"
    },
    "ct-noreturn": {
      "match": "\\b_Noreturn\\b",
      "name": "storage.modifier.noreturn.ct"
    },
    "ct-thread-local": {
      "match": "\\b_Thread_local\\b",
      "name": "storage.modifier.thread-local.ct"
    },
    "ct-c11-builtin-types": {
      "match": "\\b(_Bool|_Complex|_Imaginary)\\b",
      "name": "storage.type.builtin.ct"
    },
    "ct-attribute": {
      "match": "\\b__attribute__\\b",
      "name": "storage.modifier.attribute.ct"
    }
  }
}
