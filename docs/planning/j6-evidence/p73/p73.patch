+/* P-7.3 positive 2: UTF-8 length / byte / codepoint / single-codepoint view. */
+#include <stdio.h>
+
+int main(void)
+{
+    String s = "héllo, 世界";
+    Str one = s[1];
+    Str v = s.as_str();
+    Str sub = v.slice(1, 2);
+    Str d = s.data;
+    String copy = s.slice(0, 1);
+
+    printf("len=%d char_len=%d\n", s.len(), s.char_len());
+    printf("bytes=%d %d %d\n", s.byte_at(0), s.byte_at(1), s.byte_at(2));
+    printf("cps=%d %d %d\n", s.codepoint_at(0), s.codepoint_at(1), s.codepoint_at(7));
+    printf("one_len=%d one_cp=%d one_byte0=%d\n",
+           one.len(), one.codepoint_at(0), one.byte_at(0));
+    printf("view_len=%d view_cp1=%d data_len=%d\n",
+           v.len(), v.codepoint_at(1), d.len());
+    printf("sub_len=%d sub_cp=%d\n", sub.len(), sub.codepoint_at(0));
+    printf("copy_len=%d copy_refs=%d live=%d\n",
+           copy.len(), copy.refs(), ct_str_live_count());
+    copy.release();
+    printf("live_after=%d\n", ct_str_live_count());
+    return 0;
+}
