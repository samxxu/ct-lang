@@ -0,0 +1,45 @@
+/* P-7.3 positive 3: refcount trace, immortal literal, zero-free drop. */
+#include <stdio.h>
+
+String mk_literal(void)
+{
+    return "ret";
+}
+
+String mk_owned(void)
+{
+    Str v = "own";
+    return v.to_string();
+}
+
+int main(void)
+{
+    String a = "lit";
+    Str v = "hé";
+    String b;
+    String c;
+    String r;
+    String o;
+
+    printf("lit_refs=%d live=%d\n", a.refs(), ct_str_live_count());
+    a.release();
+    printf("lit_after_refs=%d len=%d live=%d\n", a.refs(), a.len(), ct_str_live_count());
+
+    b = v.to_string();
+    printf("b_refs=%d live=%d\n", b.refs(), ct_str_live_count());
+    c = b.copy();
+    printf("c_refs=%d b_refs=%d live=%d\n", c.refs(), b.refs(), ct_str_live_count());
+    b.release();
+    printf("b_after_refs=%d len=%d c_refs=%d live=%d\n",
+           b.refs(), b.len(), c.refs(), ct_str_live_count());
+    c.release();
+    printf("c_after_refs=%d len=%d live=%d\n", c.refs(), c.len(), ct_str_live_count());
+
+    r = mk_literal();
+    printf("ret_refs=%d live=%d\n", r.refs(), ct_str_live_count());
+    o = mk_owned();
+    printf("owned_refs=%d len=%d live=%d\n", o.refs(), o.len(), ct_str_live_count());
+    o.release();
+    printf("owned_after_refs=%d live=%d\n", o.refs(), ct_str_live_count());
+    return 0;
+}
