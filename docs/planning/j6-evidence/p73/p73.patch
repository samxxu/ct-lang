diff --git a/test/p73/run.sh b/test/p73/run.sh
new file mode 100755
index 0000000..4dfc7cc
--- /dev/null
+++ b/test/p73/run.sh
@@ -0,0 +1,165 @@
+#!/bin/sh
+# P-7.3 (S5 String/Str minimal vertical slice) evidence harness.
+# Builds the bootstrap chain from this tree, compiles the prototypes with the
+# rebuilt ct-ast, runs the five positives (one under ASan) and the five
+# negatives. Every command's output is kept under out/.
+set -u
+
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+build="$here/.build"
+out="$here/out"
+CC=${CC:-cc}
+CT_STD_DIR="$root/lib/std"
+export CT_STD_DIR
+
+pass=0
+fail=0
+ok()  { pass=$((pass + 1)); printf 'PASS %s\n' "$1"; }
+bad() { fail=$((fail + 1)); printf 'FAIL %s: %s\n' "$1" "$2"; }
+
+rm -rf "$build" "$out"
+mkdir -p "$build/l2src" "$build/astsrc" "$out"
+
+echo "== toolchain =="
+if ! "$CC" -Wall -Wextra -std=c99 "$root/selfhost/l0/ctc.c" -o "$build/ctc" \
+        >"$out/l0.log" 2>&1; then
+    bad "L0 build" "$(tail -3 "$out/l0.log")"; exit 1
+fi
+if ! "$build/ctc" "$root/selfhost/l1/ctc.ct" -o "$build/l1.c" \
+        >"$out/l1.log" 2>&1; then
+    bad "L0 -> L1" "$(tail -3 "$out/l1.log")"; exit 1
+fi
+if ! "$CC" -Wall -Wextra -std=c99 "$build/l1.c" -o "$build/l1" \
+        >"$out/l1b.log" 2>&1; then
+    bad "L1 build" "$(tail -3 "$out/l1b.log")"; exit 1
+fi
+if ! "$build/l1" build "$root/selfhost/l2/driver.ct" -o "$build/l2src" \
+        >"$out/l2.log" 2>&1; then
+    bad "L1 -> L2" "$(tail -3 "$out/l2.log")"; exit 1
+fi
+if ! "$CC" -Wall -Wextra -std=c99 "$build/l2src"/*.c -o "$build/l2" \
+        >"$out/l2b.log" 2>&1; then
+    bad "L2 build" "$(tail -3 "$out/l2b.log")"; exit 1
+fi
+if ! "$build/l2" build -I "$root/selfhost/ct-ast" "$root/selfhost/ct-ast/main.ct" \
+        -o "$build/astsrc" >"$out/ast.log" 2>&1; then
+    bad "L2 -> ct-ast" "$(tail -3 "$out/ast.log")"; exit 1
+fi
+if ! "$CC" -Wall -Wextra -std=c99 "$build/astsrc"/*.c -o "$build/ct-ast" \
+        >"$out/astb.log" 2>&1; then
+    bad "ct-ast build" "$(tail -3 "$out/astb.log")"; exit 1
+fi
+ok "bootstrap chain L0 -> L1 -> L2 -> ct-ast"
+
+echo "== positives =="
+for name in abi methods drop cstr vec drop_ptr; do
+    src="$here/$name.ct"
+    c="$out/$name.c"
+    exe="$out/$name"
+    if ! "$build/ct-ast" --allow-c-boundary "$src" -o "$c" \
+            >"$out/$name.ct.out" 2>"$out/$name.ct.err"; then
+        bad "$name (ct-ast)" "$(tail -2 "$out/$name.ct.err")"
+        continue
+    fi
+    if ! "$CC" -Wall -Wextra -std=c99 "$c" -o "$exe" \
+            >"$out/$name.cc.out" 2>"$out/$name.cc.err"; then
+        bad "$name (cc)" "$(tail -3 "$out/$name.cc.err")"
+        continue
+    fi
+    if [ -s "$out/$name.cc.err" ]; then
+        bad "$name (cc warning)" "$(head -2 "$out/$name.cc.err")"
+        continue
+    fi
+    if ! "$exe" >"$out/$name.stdout" 2>"$out/$name.run.err"; then
+        bad "$name (run)" "non-zero exit"
+        continue
+    fi
+    if ! cmp -s "$out/$name.stdout" "$here/expected/$name.out"; then
+        bad "$name (output)" "$(diff -u "$here/expected/$name.out" "$out/$name.stdout" | head -8)"
+        continue
+    fi
+    ok "$name (compile + warning-free cc + expected stdout)"
+done
+
+echo "== build mode =="
+rm -rf "$out/build_drop"
+mkdir -p "$out/build_drop"
+if "$build/ct-ast" build --emit-c --allow-c-boundary "$here/drop.ct" -o "$out/build_drop" \
+        >"$out/build_drop.ct.out" 2>"$out/build_drop.ct.err"; then
+    if "$CC" -Wall -Wextra -std=c99 "$out/build_drop"/*.c -o "$out/build_drop/drop" \
+            >"$out/build_drop.cc.out" 2>"$out/build_drop.cc.err"; then
+        if [ -s "$out/build_drop.cc.err" ]; then
+            bad "build mode (cc warning)" "$(head -2 "$out/build_drop.cc.err")"
+        elif "$out/build_drop/drop" >"$out/build_drop.stdout" 2>"$out/build_drop.run.err" \
+                && cmp -s "$out/build_drop.stdout" "$here/expected/drop.out"; then
+            ok "build mode (separate Str.c/drop.c, warning-free, same stdout)"
+        else
+            bad "build mode (run/output)" "stdout differs"
+        fi
+    else
+        bad "build mode (cc)" "$(tail -3 "$out/build_drop.cc.err")"
+    fi
+else
+    bad "build mode (ct-ast)" "$(tail -3 "$out/build_drop.ct.err")"
+fi
+
+echo "== ASan drop =="
+if "$CC" -Wall -Wextra -std=c99 -fsanitize=address -g "$out/drop.c" -o "$out/drop_asan" \
+        >"$out/drop.asan.cc.out" 2>"$out/drop.asan.cc.err"; then
+    if ASAN_OPTIONS=detect_leaks=0 "$out/drop_asan" >"$out/drop.asan.stdout" 2>"$out/drop.asan.err"; then
+        if cmp -s "$out/drop.asan.stdout" "$here/expected/drop.out"; then
+            ok "drop under ASan (no UAF/overflow; live counter reaches 0)"
+        else
+            bad "drop ASan output" "stdout differs"
+        fi
+    else
+        bad "drop ASan run" "$(tail -5 "$out/drop.asan.err")"
+    fi
+else
+    bad "drop ASan build" "$(tail -3 "$out/drop.asan.cc.err")"
+fi
+
+echo "== ASan sensitivity (expected failure) =="
+if "$build/ct-ast" --allow-c-boundary "$here/uaf_probe.ct" -o "$out/uaf_probe.c" \
+        >"$out/uaf_probe.ct.out" 2>"$out/uaf_probe.ct.err" \
+   && "$CC" -Wall -Wextra -std=c99 -fsanitize=address -g "$out/uaf_probe.c" \
+        -o "$out/uaf_probe_asan" >"$out/uaf_probe.cc.out" 2>"$out/uaf_probe.cc.err"; then
+    if ASAN_OPTIONS=detect_leaks=0 "$out/uaf_probe_asan" \
+            >"$out/uaf_probe.stdout" 2>"$out/uaf_probe.err"; then
+        bad "ASan sensitivity" "the deliberate use-after-free was not caught"
+    elif grep -Fq "heap-use-after-free" "$out/uaf_probe.err"; then
+        ok "ASan sensitivity (deliberate post-release read -> heap-use-after-free)"
+    else
+        bad "ASan sensitivity" "ASan did not report heap-use-after-free"
+    fi
+else
+    bad "ASan sensitivity build" "$(tail -3 "$out/uaf_probe.ct.err" "$out/uaf_probe.cc.err" 2>/dev/null)"
+fi
+
+echo "== negatives =="
+neg_one() {
+    name=$1
+    pattern=$2
+    if "$build/ct-ast" --allow-c-boundary "$here/$name.ct" -o "$out/$name.c" \
+            >"$out/$name.stdout" 2>"$out/$name.err"; then
+        bad "$name" "ct-ast accepted a negative"
+        return
+    fi
+    if grep -Fq "$pattern" "$out/$name.err"; then
+        ok "$name (rejected: $pattern)"
+    else
+        bad "$name" "missing expected diagnostic: $pattern"
+    fi
+}
+
+neg_one neg_immutable "read-only subscript"
+neg_one neg_data_write "read-only subscript"
+neg_one neg_data_assign "assignment target is not assignable"
+neg_one neg_data_cstr "expected 'const char *', got 'struct Str'"
+neg_one neg_utf16 "UTF-16 string literal is not implicit"
+neg_one neg_ptr_write "String/Str is immutable"
+
+echo
+printf 'summary: %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ]
diff --git a/test/p73/uaf_probe.ct b/test/p73/uaf_probe.ct
new file mode 100644
index 0000000..7c8ba6c
--- /dev/null
+++ b/test/p73/uaf_probe.ct
@@ -0,0 +1,14 @@
+/* P-7.3 ASan sensitivity probe: NOT a supported program. It saves the raw
+ * pointer, releases the owning handle, then reads the freed byte, so ASan must
+ * report heap-use-after-free. The harness expects this to fail. */
+#include <stdio.h>
+
+int main(void)
+{
+    Str v = "uaf";
+    String a = v.to_string();
+    char *raw = a.ptr;
+    a.release();
+    printf("%d\n", (int)raw[0]);
+    return 0;
+}
diff --git a/test/p73/vec.ct b/test/p73/vec.ct
new file mode 100644
index 0000000..0638450
--- /dev/null
+++ b/test/p73/vec.ct
@@ -0,0 +1,23 @@
+/* P-7.3 positive 5 (A.3.2 partial): Vec<String> element retain/release. */
+#include <stdio.h>
+
+int main(void)
+{
+    Vec<String> v = {};
+    Str lit = "vec";
+    String a = lit.to_string();
+
+    printf("before_push a=%d live=%d\n", a.refs(), ct_str_live_count());
+    v.push(a);
+    printf("after_push a=%d vec_len=%d live=%d\n",
+           a.refs(), v.len(), ct_str_live_count());
+    {
+        String seen = v.get(0);
+        printf("element_len=%d\n", seen.len());
+    }
+    v.release();
+    printf("after_vec_release a=%d live=%d\n", a.refs(), ct_str_live_count());
+    a.release();
+    printf("after_a_release a=%d live=%d\n", a.refs(), ct_str_live_count());
+    return 0;
+}
