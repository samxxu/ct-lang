+/* P-7.3 positive 4: .data has no NUL contract; cstr() is the C exit. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(void)
+{
+    String s = "abc";
+    Str v = s.as_str().slice(0, 2);
+    Str d = v.data;
+    char *p = s.cstr();
+    char *q = v.cstr();
+
+    printf("cstr=%s strlen=%d nul=%d\n", p, (int)strlen(p), (int)p[s.len()]);
+    free(p);
+    printf("sub_cstr=%s strlen=%d nul=%d\n", q, (int)strlen(q), (int)q[v.len()]);
+    free(q);
+    printf("data_len=%d raw_after=%d\n", d.len(), (int)v.ptr[v.len()]);
+    return 0;
+}
