diff --git a/test/p73/abi.ct b/test/p73/abi.ct
new file mode 100644
index 0000000..f6c2513
--- /dev/null
+++ b/test/p73/abi.ct
@@ -0,0 +1,38 @@
+/* P-7.3 positive 1: ABI layout and immortal literal handles. */
+#include <stdio.h>
+#include <stddef.h>
+
+struct ct_lit_probe {
+    struct ct_str_hdr h;
+    char d[4];
+};
+
+_Static_assert(sizeof(struct String) == 16, "String handle must be 16 bytes");
+_Static_assert(sizeof(struct Str) == 16, "Str view must be 16 bytes");
+_Static_assert(sizeof(struct ct_str_hdr) == 8, "refcount header must be 8 bytes");
+_Static_assert(offsetof(struct ct_lit_probe, d) == 8,
+               "payload must start 8 bytes after the header");
+_Static_assert(_Alignof(struct String) == 8, "String is 8-byte aligned");
+_Static_assert(_Alignof(char) == 1, "header_size(String) = round_up(8, 1) = 8");
+
+int main(void)
+{
+    String lit = "hello";
+    String empty = "";
+    Str view = "world";
+    struct ct_str_hdr *hp;
+
+    hp = (struct ct_str_hdr *)(lit.ptr - sizeof(struct ct_str_hdr));
+    printf("sizeof(String)=%d\n", (int)sizeof(struct String));
+    printf("sizeof(Str)=%d\n", (int)sizeof(struct Str));
+    printf("sizeof(header)=%d\n", (int)sizeof(struct ct_str_hdr));
+    printf("literal_refs=%d empty_refs=%d\n", lit.refs(), empty.refs());
+    printf("literal_len=%d empty_len=%d\n", lit.len(), empty.len());
+    printf("header_gap=%d\n", (int)(lit.ptr - (char *)hp));
+    lit.release();
+    empty.release();
+    printf("after_release_refs=%d empty_refs=%d\n", lit.refs(), empty.refs());
+    printf("after_release_len=%d live=%d\n", lit.len(), ct_str_live_count());
+    printf("view_refs_are_none=%d\n", (int)view.len());
+    return 0;
+}
