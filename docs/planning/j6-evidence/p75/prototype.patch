index 0000000..083b862
--- /dev/null
+++ b/test/ast/p81_box/ctx.ct
@@ -0,0 +1,17 @@
+/* PH-81 S1b: `new` is contextual. It introduces a construction only in front
+ * of a named type; `int new;`, a field named `new`, a parameter named `new`
+ * and `new = ...` keep their identifier meaning. */
+#include <stdio.h>
+
+struct R { int new; }
+
+int pick(int new) { return new + 1; }
+
+int main(void)
+{
+    int new = 3;
+    new = new + 1;
+    struct R r = { 7 };
+    printf("var=%d field=%d param=%d\n", new, r.new, pick(new));
+    return 0;
+}
diff --git a/test/ast/p81_box/cycle.ct b/test/ast/p81_box/cycle.ct
new file mode 100644
index 0000000..8701e06
--- /dev/null
+++ b/test/ast/p81_box/cycle.ct
@@ -0,0 +1,20 @@
+/* PH-81 E81-5: a reference cycle is the author's responsibility. `retain()`
+ * makes the two nodes own each other; releasing both handles leaves each
+ * payload at refs=1, with no compiler warning and no run-time cycle check. */
+#include <stdio.h>
+struct Node { int id; box<Node> next; }
+int main(void) {
+    box<Node> a = new Node { .id = 1 };
+    box<Node> b = new Node { .id = 2 };
+    a.next = b.retain();
+    b.next = a.retain();
+    printf("before: a_refs=%d b_refs=%d\n", a.refs(), b.refs());
+    Node *pa = a.at();
+    Node *pb = b.at();
+    a.release();
+    b.release();
+    printf("after handles: a_refs=%d b_refs=%d (cycle is author-owned)\n",
+           pa->next.refs(), pb->next.refs());
+    printf("ids still live: a=%d b=%d\n", pa->next.at()->id, pb->next.at()->id);
+    return 0;
+}
