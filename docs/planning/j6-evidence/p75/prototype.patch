diff --git a/test/ast/p81_box/record.ct b/test/ast/p81_box/record.ct
new file mode 100644
index 0000000..5da1ab2
--- /dev/null
+++ b/test/ast/p81_box/record.ct
@@ -0,0 +1,38 @@
+/* PH-81 E81-1/E81-2: `new T { ... }` is the only construction form, the brace
+ * list is the same one `T x = { ... }` uses (positional and designated), and
+ * `b.f` / `b.f = ...` auto-dereference the handle. `box<T>` shares the
+ * `{refs, aux}` header: releasing the last handle releases the payload's
+ * owning fields. */
+#include <stdio.h>
+
+struct Record { int id; String tag; }
+struct Point { int x; int y; }
+
+int main(void)
+{
+    String lit = "owned";
+    String owned = lit.to_string();
+    box<Record> r = new Record { 7, owned };
+    printf("id=%d tag=%d refs=%d tag_refs=%d\n",
+           r.id, r.tag.len(), r.refs(), r.tag.refs());
+    owned.release();
+    printf("after source release tag_refs=%d live=%d\n",
+           r.tag.refs(), ct_str_live_count());
+    r.id = 8;
+    printf("id_after_set=%d\n", r.id);
+
+    box<Point> p = new Point { .y = 2, .x = 1 };
+    printf("point=%d,%d\n", p.x, p.y);
+    p.x = 5;
+    printf("point_after_set=%d,%d\n", p.x, p.y);
+
+    box<Record> q = new Record { .tag = "literal", .id = 9 };
+    printf("designated id=%d tag=%d tag_refs=%d\n", q.id, q.tag.len(), q.tag.refs());
+
+    printf("before release refs=%d live=%d\n", r.refs(), ct_str_live_count());
+    r.release();
+    p.release();
+    q.release();
+    printf("after release refs=%d live=%d\n", r.refs(), ct_str_live_count());
+    return 0;
+}
diff --git a/test/ast/p81_box/uaf.ct b/test/ast/p81_box/uaf.ct
new file mode 100644
index 0000000..ff5cbba
--- /dev/null
+++ b/test/ast/p81_box/uaf.ct
@@ -0,0 +1,12 @@
+/* PH-81 E81-4: `at()` borrows the payload; `release()` invalidates it. The
+ * probe is only useful under ASan, where the post-release read is a
+ * heap-use-after-free. */
+#include <stdio.h>
+struct R { int id; String tag; }
+int main(void) {
+    box<R> b = new R { 1, "x" };
+    R *p = b.at();
+    b.release();
+    printf("%d\n", p->id);
+    return 0;
+}
diff --git a/test/ast/p81_box/vecbox.ct b/test/ast/p81_box/vecbox.ct
new file mode 100644
index 0000000..84b6833
--- /dev/null
+++ b/test/ast/p81_box/vecbox.ct
@@ -0,0 +1,36 @@
+/* PH-81 E81-1/E81-4: `box<T>` is a first-class element and field. The element
+ * glue retains on insertion and releases on container release; a `get` copy is
+ * a second handle, so the caller retains it explicitly (the `Vec.get` contract
+ * for every owning element). */
+#include <stdio.h>
+
+struct Item { int id; String name; }
+struct Holder { box<Item> child; int n; } use Drop
+
+int main(void)
+{
+    Vec<box<Item> > v;
+    v.h = 0;
+    box<Item> a = new Item { 1, "one" };
+    v.push(a);
+    printf("after push a_refs=%d len=%d\n", a.refs(), v.len());
+    a.release();
+
+    box<Item> got = v.get(0).retain();
+    printf("got id=%d refs=%d name=%d\n", got.id, got.refs(), got.name.len());
+    got.release();
+    printf("after got release len=%d\n", v.len());
+    v.release();
+    printf("after v release len=%d\n", v.len());
+
+    box<Item> keep = new Item { 2, "two" };
+    own Holder *h = malloc(sizeof(struct Holder));
+    h->child = keep.retain();
+    h->n = 3;
+    printf("holder before delete refs=%d\n", keep.refs());
+    delete h;
+    printf("holder after delete refs=%d id=%d\n", keep.refs(), keep.id);
+    keep.release();
+    printf("keep released refs=%d live=%d\n", keep.refs(), ct_str_live_count());
+    return 0;
+}
