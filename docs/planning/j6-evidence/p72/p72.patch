diff --git a/evidence/p72/run.sh b/evidence/p72/run.sh
new file mode 100755
index 00000000..9680ba8d
--- /dev/null
+++ b/evidence/p72/run.sh
@@ -0,0 +1,167 @@
+#!/usr/bin/env bash
+# P-7.2 (S3 slice prototype) reproduction script.
+#
+# Builds the bootstrap chain the way selfhost/check-ast.sh does
+# (L0 -> L1 -> L2 -> ct-ast), then runs every fixture in cases/.
+# Prints every command and its raw output; exits non-zero if any case
+# disagrees with its expected result.
+set -u
+
+root="$(cd "$(dirname "$0")/../.." && pwd)"
+cd "$root" || exit 1
+CC="${CC:-cc}"
+work="${TMPDIR:-/tmp}/p72-evidence.$$"
+rm -rf "$work"
+mkdir -p "$work" || exit 1
+trap 'rm -rf "$work"' EXIT HUP INT TERM
+
+pass=0
+fail=0
+ok()  { pass=$((pass + 1)); printf 'PASS  %s\n' "$1"; }
+bad() { fail=$((fail + 1)); printf 'FAIL  %s: %s\n' "$1" "$2"; }
+show() { printf '  $ %s\n' "$*"; }
+
+echo "== bootstrap: L0 -> L1 -> L2 -> ct-ast =="
+show "$CC -Wall -Wextra -std=c99 selfhost/l0/ctc.c -o $work/ctc"
+"$CC" -Wall -Wextra -std=c99 selfhost/l0/ctc.c -o "$work/ctc" || { echo "L0 build failed"; exit 1; }
+show "$work/ctc selfhost/l1/ctc.ct -o $work/l1.c"
+"$work/ctc" selfhost/l1/ctc.ct -o "$work/l1.c" || { echo "L0 -> L1 failed"; exit 1; }
+show "$CC -Wall -Wextra -std=c99 $work/l1.c -o $work/l1"
+"$CC" -Wall -Wextra -std=c99 "$work/l1.c" -o "$work/l1" || { echo "L1 build failed"; exit 1; }
+mkdir -p "$work/l2src"
+show "$work/l1 build selfhost/l2/driver.ct -o $work/l2src"
+"$work/l1" build selfhost/l2/driver.ct -o "$work/l2src" || { echo "L1 -> L2 failed"; exit 1; }
+show "$CC -Wall -Wextra -std=c99 $work/l2src/*.c -o $work/l2"
+"$CC" -Wall -Wextra -std=c99 "$work"/l2src/*.c -o "$work/l2" || { echo "L2 build failed"; exit 1; }
+mkdir -p "$work/astsrc"
+show "$work/l2 build -I selfhost/ct-ast selfhost/ct-ast/main.ct -o $work/astsrc"
+"$work/l2" build -I selfhost/ct-ast selfhost/ct-ast/main.ct -o "$work/astsrc" || { echo "L2 -> ct-ast failed"; exit 1; }
+show "$CC -Wall -Wextra -std=c99 $work/astsrc/*.c -o $work/ct-ast"
+"$CC" -Wall -Wextra -std=c99 "$work"/astsrc/*.c -o "$work/ct-ast" || { echo "ct-ast build failed"; exit 1; }
+echo "ct-ast: $("$work/ct-ast" --version 2>&1 | head -1)"
+echo
+
+echo "== self-host fixpoint (the compiler's own sources carry no slice syntax) =="
+mkdir -p "$work/self1" "$work/self2"
+show "$work/ct-ast build --emit-c -I selfhost/ct-ast selfhost/ct-ast/main.ct -o $work/self1"
+"$work/ct-ast" build --emit-c -I selfhost/ct-ast selfhost/ct-ast/main.ct -o "$work/self1" \
+    >"$work/self1.out" 2>"$work/self1.err"
+e1=$?
+show "$CC -Wall -Wextra -std=c99 $work/self1/*.c -o $work/ct-ast2"
+"$CC" -Wall -Wextra -std=c99 "$work"/self1/*.c -o "$work/ct-ast2" >"$work/selfcc.log" 2>&1
+e2=$?
+show "$work/ct-ast2 build --emit-c -I selfhost/ct-ast selfhost/ct-ast/main.ct -o $work/self2"
+"$work/ct-ast2" build --emit-c -I selfhost/ct-ast selfhost/ct-ast/main.ct -o "$work/self2" \
+    >"$work/self2.out" 2>"$work/self2.err"
+e3=$?
+echo "  exits: gen1=$e1 cc=$e2 gen2=$e3"
+sed 's/^/  /' "$work/self1.err" "$work/selfcc.log" "$work/self2.err"
+if [ "$e1" -ne 0 ] || [ "$e2" -ne 0 ] || [ "$e3" -ne 0 ]; then
+    bad selfhost "the chain did not rebuild the compiler"
+elif diff -r -q -x .ctcache "$work/self1" "$work/self2" >"$work/fix.diff" 2>&1; then
+    ok selfhost
+else
+    bad selfhost "$(head -3 "$work/fix.diff")"
+fi
+echo
+
+# run_pos <name> <expected file>
+run_pos() {
+    n="$1"
+    echo "== positive: $n =="
+    show "CT_C_BOUNDARY=allow $work/ct-ast evidence/p72/cases/$n.ct -o $work/$n.c"
+    CT_C_BOUNDARY=allow "$work/ct-ast" "evidence/p72/cases/$n.ct" -o "$work/$n.c" \
+        >"$work/$n.log" 2>&1
+    e=$?
+    echo "  exit=$e"
+    sed 's/^/  /' "$work/$n.log"
+    if [ "$e" -ne 0 ]; then bad "$n compile" "exit $e"; return; fi
+    show "$CC -std=c99 -Wall -Wextra $work/$n.c -o $work/$n.bin"
+    "$CC" -std=c99 -Wall -Wextra "$work/$n.c" -o "$work/$n.bin" >"$work/$n.cc.log" 2>&1
+    c=$?
+    echo "  exit=$c"
+    sed 's/^/  /' "$work/$n.cc.log"
+    if [ "$c" -ne 0 ]; then bad "$n host-cc" "exit $c"; return; fi
+    show "$work/$n.bin"
+    "$work/$n.bin" >"$work/$n.out" 2>"$work/$n.run.log"
+    r=$?
+    echo "  exit=$r"
+    sed 's/^/  /' "$work/$n.out"
+    sed 's/^/  stderr: /' "$work/$n.run.log"
+    if [ "$r" -ne 0 ]; then bad "$n run" "exit $r"; return; fi
+    if ! diff -u "evidence/p72/expected/$n.out" "$work/$n.out" >"$work/$n.diff" 2>&1; then
+        bad "$n stdout" "$(head -3 "$work/$n.diff")"; return
+    fi
+    ok "$n"
+    echo
+}
+
+# run_compile_err <name> <expected substring>
+run_compile_err() {
+    n="$1"; pat="$2"
+    echo "== negative: $n (expect hard error containing: $pat) =="
+    show "CT_C_BOUNDARY=allow $work/ct-ast evidence/p72/cases/$n.ct -o $work/$n.c"
+    CT_C_BOUNDARY=allow "$work/ct-ast" "evidence/p72/cases/$n.ct" -o "$work/$n.c" \
+        >"$work/$n.log" 2>&1
+    e=$?
+    echo "  exit=$e"
+    sed 's/^/  /' "$work/$n.log"
+    if [ "$e" -eq 0 ]; then bad "$n" "expected a hard error, got exit 0"; return; fi
+    if ! grep -qF "$pat" "$work/$n.log"; then bad "$n" "diagnostic did not contain: $pat"; return; fi
+    ok "$n"
+    echo
+}
+
+echo "== negative: neg_trap (compile, then trap at run time) =="
+show "CT_C_BOUNDARY=allow $work/ct-ast evidence/p72/cases/neg_trap.ct -o $work/neg_trap.c"
+CT_C_BOUNDARY=allow "$work/ct-ast" evidence/p72/cases/neg_trap.ct -o "$work/neg_trap.c" >"$work/neg_trap.log" 2>&1
+e=$?
+echo "  compile exit=$e"
+sed 's/^/  /' "$work/neg_trap.log"
+if [ "$e" -ne 0 ]; then bad neg_trap "compile exit $e"; else
+    "$CC" -std=c99 -Wall -Wextra "$work/neg_trap.c" -o "$work/neg_trap.bin" >"$work/neg_trap.cc.log" 2>&1
+    c=$?
+    echo "  host-cc exit=$c"
+    if [ "$c" -ne 0 ]; then bad neg_trap "host-cc exit $c"; else
+        show "$work/neg_trap.bin"
+        "$work/neg_trap.bin" >"$work/neg_trap.out" 2>"$work/neg_trap.run.log"
+        r=$?
+        echo "  run exit=$r"
+        sed 's/^/  stdout: /' "$work/neg_trap.out"
+        sed 's/^/  stderr: /' "$work/neg_trap.run.log"
+        if [ "$r" -eq 0 ]; then bad neg_trap "expected a trap, got exit 0"
+        elif ! grep -qF "out of bounds" "$work/neg_trap.run.log"; then bad neg_trap "trap message missing"
+        else ok neg_trap; fi
+    fi
+fi
+echo
+
+echo "== negative: neg_return_lint (compile succeeds, lint on stderr) =="
+show "CT_C_BOUNDARY=allow $work/ct-ast evidence/p72/cases/neg_return_lint.ct -o $work/neg_return_lint.c"
+CT_C_BOUNDARY=allow "$work/ct-ast" evidence/p72/cases/neg_return_lint.ct -o "$work/neg_return_lint.c" >"$work/neg_return_lint.log" 2>&1
+e=$?
+echo "  exit=$e"
+sed 's/^/  /' "$work/neg_return_lint.log"
+if [ "$e" -ne 0 ]; then bad neg_return_lint "expected exit 0 with a lint, got $e"
+elif ! grep -qF "slice escape" "$work/neg_return_lint.log"; then bad neg_return_lint "lint message missing"
+else ok neg_return_lint; fi
+echo
+
+run_pos pos_basic
+run_pos pos_struct
+run_pos pos_param
+run_pos pos_subslice
+run_pos pos_const
+run_pos pos_arrays_unchanged
+
+run_compile_err neg_const_write "cannot write to an element of a const slice"
+run_compile_err neg_field "cannot be a struct field"
+run_compile_err neg_global "cannot be a file-scope variable"
+run_compile_err neg_generic "cannot be a generic type argument"
+run_compile_err neg_arrelem "cannot be an array element"
+run_compile_err neg_subslice_oob "slice construction out of bounds"
+run_compile_err neg_bad_init "can only be initialized from an array"
+
+echo "============================================================="
+printf 'P-7.2 evidence: %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ]
diff --git a/selfhost/ct-ast/backend/emit/Emitter.h.ct b/selfhost/ct-ast/backend/emit/Emitter.h.ct
index 2812b9cb..d9326337 100644
