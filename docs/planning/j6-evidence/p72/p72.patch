+/* P-7.2 positive: a slice parameter, a subslice of a parameter, and a
+   slice-returning function whose result feeds another slice local. */
+#include <stdio.h>
+
+int sum(int[] s)
+{
+    int k = 0;
+    foreach (s) { k = k + item; }
+    if (s.get(0) != 0) s[0] = 100;
+    return k;
+}
+
+int[] tail(int[] s)
+{
+    int[] r = s[1..];
+    return r;                 /* a parameter view, not a local array: no lint */
+}
+
+int main(void)
+{
+    int a[] = {1, 2, 3, 4};
+    int[] s = a;
+    int[] t;
+    int z;
+
+    z = sum(s);
+    t = tail(s);
+    printf("sum=%d a0=%d t0=%d t2=%d\n", z, a[0], t[0], t[2]);
+    t[0] = 20;
+    printf("a1=%d\n", a[1]);
+    return 0;
+}
