/* S2b 反例：ref 实参的基类型不匹配，必须硬错（不能靠 C 隐式转换蒙混）。 */
trait Touch {
    void bump(ref int x, out int y);
}

struct Box {
    int v;
} use Touch;

impl Touch for Box {
    void bump(ref int x, out int y) {
        x = x + self->v;
        y = x * 2;
    }
}

int main(void)
{
    Box b = { 3 };
    Box other = { 1 };
    int r;

    b.bump(other, r);
    return 0;
}
