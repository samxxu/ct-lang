+/* S2 prototype: a `ref`/`out` actual must be an assignable place. The set is
+   deliberately the common one: variables, fields, `*p`, and index places
+   (arrays, slices, Vec/Map). Literals, calls, casts and arithmetic are out. */
+static int ref_arg_place(struct Expr *self, int n)
+{
+    int k = self->arena->nodes[n].kind;
+    return k == N_VAR || k == N_MEMBER || k == N_ARROW
+        || k == N_DEREF || k == N_INDEX;
+}
+
+/* S2 prototype: an `out` owning actual must already be initialized. Owning is
+   `String` / `box<…>` / `Vec<…>` / `Map<…>` or a struct declared `use Drop`. */
+static int type_is_owning(struct Expr *self, const char *type)
+{
+    int si;
+    if (strcmp(type, "String") == 0) return 1;
+    if (strncmp(type, "box<", 4) == 0) return 1;
+    if (strncmp(type, "Vec<", 4) == 0) return 1;
+    if (strncmp(type, "Map<", 4) == 0) return 1;
+    if (strncmp(type, "struct ", 7) == 0) {
+        si = self->sym->find_struct(type + 7);
+        return si >= 0 && self->sym->structs[si].uses_drop;
+    }
+    return 0;
+}
