diff --git a/test/p74/asan/trace.ct b/test/p74/asan/trace.ct
new file mode 100644
index 00000000..35eb2d79
--- /dev/null
+++ b/test/p74/asan/trace.ct
@@ -0,0 +1,95 @@
+/* P-7.4-7 / A.3.2 + A.3.3: the copy/Drop protocol at every position the
+ * evidence table names (parameter, return, field, Vec element, own/delete)
+ * plus the immortal literal and the borrowed view's lack of Drop.
+ * The protocol is explicit: a callee that keeps a by-value handle calls
+ * retain(), a caller that drops its copy calls release(); the automatic
+ * insertion is C-6's S5a contract, not this ABI prototype's. */
+#include <stdio.h>
+#include <stdlib.h>
+
+struct Holder {
+    String tag;
+}
+
+int take_len(String a)
+{
+    return a.len();
+}
+
+String keep_param(String a)
+{
+    return a.retain();
+}
+
+String make_local(void)
+{
+    Str lit = "mk";
+    return lit.to_string();
+}
+
+String nonlocal_ret(String src)
+{
+    String r = src.retain();
+    return r;
+}
+
+int main(void)
+{
+    Str lit = "keep";
+    Str mak = "mk";
+    String keep = lit.to_string();
+    String got;
+    String made;
+    Holder h;
+    Vec<String> v = {};
+    String elem;
+    own String *p = malloc(sizeof(struct String));
+
+    printf("keep refs=%d live=%d\n", keep.refs(), ct_str_live_count());
+    printf("param take_len=%d refs_after=%d\n", take_len(keep), keep.refs());
+    got = keep_param(keep);
+    printf("keep_param refs=%d live=%d\n", got.refs(), ct_str_live_count());
+    got.release();
+    printf("after_param_copy_release keep=%d\n", keep.refs());
+
+    made = make_local();
+    printf("make_local len=%d refs=%d live=%d\n", made.len(), made.refs(), ct_str_live_count());
+    made.release();
+    printf("after_local_release live=%d\n", ct_str_live_count());
+
+    got = nonlocal_ret(keep);
+    printf("nonlocal refs=%d keep=%d\n", got.refs(), keep.refs());
+    keep.release();
+    printf("after_src_release got=%d\n", got.refs());
+    got.release();
+
+    keep = mak.to_string();
+    h.tag = keep.retain();
+    printf("field refs=%d keep=%d live=%d\n", h.tag.refs(), keep.refs(), ct_str_live_count());
+    h.tag.release();
+    printf("field_after_release keep=%d\n", keep.refs());
+
+    v.push(keep);
+    printf("vec push keep=%d vec_len=%d\n", keep.refs(), v.len());
+    elem = v.get(0);
+    printf("vec elem len=%d\n", elem.len());
+    v.release();
+    printf("vec_release keep=%d\n", keep.refs());
+    keep.release();
+    printf("after_keep_release live=%d\n", ct_str_live_count());
+
+    *p = lit.to_string();
+    printf("ptr before_delete refs=%d live=%d\n", p->refs(), ct_str_live_count());
+    delete p;
+    printf("ptr after_delete p_null=%d live=%d\n", p == 0, ct_str_live_count());
+
+    {
+        String literal = "immortal";
+        String empty = "";
+        printf("literal refs=%d empty refs=%d\n", literal.refs(), empty.refs());
+        literal.release();
+        empty.release();
+        printf("literal after release=%d empty=%d\n", literal.refs(), empty.refs());
+    }
+    return 0;
+}
