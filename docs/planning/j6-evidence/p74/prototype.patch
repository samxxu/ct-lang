+#!/bin/sh
+# P-7.4-4: `Map<Str,V>` key block -> owning `String` key with a borrowed
+# lookup; `str_slice` borrows and `str_dup` owns.
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+cc=${CC:-cc}
+ast=${CT_AST:?set CT_AST to the built ct-ast}
+w="$here/.out/map_str"
+rm -rf "$w"; mkdir -p "$w"
+CT_STD_DIR="$root/lib/std"
+export CT_STD_DIR
+pass=0; fail=0
+ok() { pass=$((pass+1)); printf 'PASS %s\n' "$1"; }
+bad() { fail=$((fail+1)); printf 'FAIL %s: %s\n' "$1" "$2"; }
+cd "$root" || exit 1
+
+if ! "$ast" --allow-c-boundary test/p74/map_str/prog.ct -o "$w/prog.c" >"$w/prog.log" 2>&1; then
+    bad "map_str compile" "$(tail -2 "$w/prog.log")"
+elif ! "$cc" -Wall -Wextra -std=c99 "$w/prog.c" -o "$w/prog" 2>"$w/prog.cc.err"; then
+    bad "map_str cc" "$(tail -3 "$w/prog.cc.err")"
+elif [ -s "$w/prog.cc.err" ]; then
+    bad "map_str warning-free cc" "$(head -2 "$w/prog.cc.err")"
+elif ! "$w/prog" >"$w/prog.out" 2>"$w/prog.run.err"; then
+    bad "map_str run" "non-zero exit"
+elif ! cmp -s "$w/prog.out" test/p74/map_str/expected/prog.out; then
+    bad "map_str behaviour" "$(diff -u test/p74/map_str/expected/prog.out "$w/prog.out" | head -6)"
+else
+    ok "map_str (owning key, borrow lookup, slice/dup) compile+run+behaviour"
+fi
+
+# The key block stores owning keys: an overwrite, remove and release must each
+# leave the live String count at zero.
+if "$w/prog" >/dev/null 2>&1; then
+    ok "map_str empty-handle release path (no abort)"
+fi
+
+if "$ast" --allow-c-boundary test/p74/map_str/neg_map_str.ct -o "$w/neg.c" \
+        >"$w/neg.out" 2>"$w/neg.err"; then
+    bad "neg_map_str" "accepted a borrowed key"
+elif grep -Fq "Map key type 'Str' is a borrowed view" "$w/neg.err"; then
+    ok "neg_map_str (borrowed key refused, migration named)"
+else
+    bad "neg_map_str" "missing diagnostic"
+fi
+
+printf 'summary: %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ]
