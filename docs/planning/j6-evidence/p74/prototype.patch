+/* P-7.4-5: UTF-8 codepoint/byte_* API and the UTF-16 core JS method set.
+ * Every method is called once with a known value; the out-of-range branches
+ * are exercised at the end of each block (the "negative" half of the row). */
+#include <stdio.h>
+
+void put_u16(U16String *u)
+{
+    Str v = u->to_utf8();
+    printf("%.*s", v.len(), v.ptr);
+}
+
+int main(void)
+{
+    /* ---- UTF-8: codepoints and bytes ---- */
+    Str s = "héllo";
+    Str ll = "ll";
+    Str l = "l";
+    Str view;
+    Str bytes;
+    Str d;
+    String cp_own;
+    int i;
+
+    printf("u8 len=%d chars=%d\n", s.len(), s.char_len());
+    printf("u8 bytes=%d,%d,%d,%d,%d,%d\n", s.byte_at(0), s.byte_at(1), s.byte_at(2),
+           s.byte_at(3), s.byte_at(4), s.byte_at(5));
+    printf("u8 byte_oob=%d\n", s.byte_at(99));
+    printf("u8 cps=%d,%d,%d,%d,%d\n", s.codepoint_at(0), s.codepoint_at(1),
+           s.codepoint_at(2), s.codepoint_at(3), s.codepoint_at(4));
+    printf("u8 cp_oob=%d\n", s.codepoint_at(99));
+    view = s[1];
+    printf("u8 sub len=%d cp=%d\n", view.len(), view.codepoint_at(0));
+    view = s.char_at(1);
+    printf("u8 char_at len=%d\n", view.len());
+    view = s.get(99);
+    printf("u8 get_oob len=%d\n", view.len());
+    bytes = s.byte_slice(1, 2);
+    printf("u8 byte_slice len=%d cp=%d\n", bytes.len(), bytes.codepoint_at(0));
+    printf("u8 byte_index=%d from3=%d\n", s.byte_index_of(ll), s.byte_index_of_from(l, 4));
+    view = s.as_str();
+    d = s.data();
+    printf("u8 as_str len=%d data len=%d\n", view.len(), d.len());
+    cp_own = s.to_string();
+    {
+        String sn = cp_own.slice(1, 2);
+        printf("u8 slice len=%d refs=%d live=%d\n", sn.len(), sn.refs(), ct_str_live_count());
+        sn.release();
+    }
+    cp_own.release();
+    {
+        char *cstr_p;
+        cstr_p = s.cstr();
+        printf("u8 cstr first=%c\n", cstr_p[0]);
+    }
+
+    /* ---- UTF-16: the JS core subset ---- */
+    {
+        Str src = "Aé😀B";
+        Str comma = ",";
+        Str zero = "0";
+        Str ab = "ab";
+        Str bang = "!";
+        Str e_acute = "é";
+        Str e_plain = "e";
+        Str l16 = "l";
+        Str L16 = "L";
+        Str hello = "hello";
+        Str spaced = "  x \t";
+        Str abc = "aBc";
+        Str seven = "7";
+        Str x = "x";
+        Str csv = "a,b,c";
+        Str fmt;
+        U16String u = U16String.from_utf8(src);
+        U16String u_comma = U16String.from_utf8(comma);
+        U16String u_zero = U16String.from_utf8(zero);
+        U16String u_ab = U16String.from_utf8(ab);
+        U16String u_bang = U16String.from_utf8(bang);
+        U16String u_eacute = U16String.from_utf8(e_acute);
+        U16String u_eplain = U16String.from_utf8(e_plain);
+        U16String u_l = U16String.from_utf8(l16);
+        U16String u_L = U16String.from_utf8(L16);
+        U16String u_hello = U16String.from_utf8(hello);
+        U16String u_spaced = U16String.from_utf8(spaced);
+        U16String u_abc = U16String.from_utf8(abc);
+        U16String u_seven = U16String.from_utf8(seven);
+        U16String u_x = U16String.from_utf8(x);
+        U16String u_csv = U16String.from_utf8(csv);
+        U16String back;
+        U16String ut;
+        U16Str s_comma = u_comma.get(0);
+        U16Str s_zero = u_zero.get(0);
+        U16Str s_ab = u_ab.as_str();
+        U16Str s_bang = u_bang.get(0);
+        U16Str s_eacute = u_eacute.get(0);
+        U16Str s_eplain = u_eplain.get(0);
+        U16Str s_l = u_l.get(0);
+        U16Str s_L = u_L.get(0);
+        U16Str s_hello = u_hello.as_str();
+        U16Str s_x = u_x.get(0);
+        U16Str one;
+        U16Str last;
+        String f8;
+        Vec<U16String> parts;
+
+        printf("u16 len=%d\n", u.len());
+        printf("u16 codes=%d,%d,%d,%d,%d\n", u.char_code_at(0), u.char_code_at(1),
+               u.char_code_at(2), u.char_code_at(3), u.char_code_at(4));
+        printf("u16 code_oob=%d\n", u.char_code_at(99));
+        printf("u16 cps=%d,%d,%d\n", u.code_point_at(0), u.code_point_at(2),
+               u.code_point_at(99));
+        one = u[0];
+        printf("u16 sub=%d\n", one.char_code_at(0));
+        one = u.char_at(1);
+        printf("u16 char_at=%d\n", one.char_code_at(0));
+        last = u.at(-1);
+        one = u.at(99);
+        printf("u16 at(-1)=%d at_oob=%d\n", last.char_code_at(0), one.len());
+        last = u.get(99);
+        printf("u16 get_oob=%d\n", last.len());
+
+        printf("u16 find=%d from4=%d last=%d\n", u_hello.index_of(s_l),
+               u_hello.index_of_from(s_l, 4), u_hello.last_index_of(s_l));
+        printf("u16 has=%d,%d,%d,%d\n", u_hello.includes(s_l),
+               u_hello.starts_with(s_hello), u_hello.ends_with(s_hello),
+               u_hello.includes(s_x));
+
+        back = u.slice(1, 3);
+        printf("u16 slice=%d\n", back.len());
+        back.release();
+        back = u.substring(3, 1);
+        printf("u16 substring=%d\n", back.len());
+        back.release();
+        back = u.concat(s_bang);
+        printf("u16 concat=%d\n", back.len());
+        back.release();
+        back = u.replace(s_eacute, s_eplain);
+        put_u16(&back);
+        printf(" replace=%d\n", back.len());
+        back.release();
+        back = u_hello.replace_all(s_l, s_L);
+        put_u16(&back);
+        printf(" replace_all=%d\n", back.len());
+        back.release();
+        back = u_abc.to_upper_case();
+        put_u16(&back);
+        printf(" upper\n");
+        back.release();
+        back = u_abc.to_lower_case();
+        put_u16(&back);
+        printf(" lower\n");
+        back.release();
+        back = u_spaced.trim();
+        printf("u16 trim=%d\n", back.len());
+        back.release();
+        back = u_spaced.trim_start();
+        printf("u16 trim_start=%d\n", back.len());
+        back.release();
+        back = u_spaced.trim_end();
+        printf("u16 trim_end=%d\n", back.len());
+        back.release();
+        back = u_x.repeat(3);
+        put_u16(&back);
+        printf(" repeat=%d\n", back.len());
+        back.release();
+        back = u_seven.pad_start(5, s_zero);
+        put_u16(&back);
+        printf(" pad_start=%d\n", back.len());
+        back.release();
+        back = u_x.pad_end(4, s_ab);
+        put_u16(&back);
+        printf(" pad_end=%d\n", back.len());
+        back.release();
+
+        parts = u_csv.split(s_comma);
+        printf("u16 split=%d", parts.len());
+        for (i = 0; i < parts.len(); i++) {
+            U16String part;
+            part = parts.get(i);
+            printf(" %d", part.len());
+        }
+        printf("\n");
+        parts.release();
+
+        back = u.to_utf16();
+        printf("u16 to_utf16=%d\n", back.len());
+        back.release();
+        one = u.get(0);
+        back = U16String.from_utf16(one);
+        printf("u16 from_utf16=%d\n", back.len());
+        back.release();
+        one = u.get(1);
+        f8 = String.from_utf16(one);
+        printf("u16 String.from_utf16=%d\n", f8.len());
+        f8.release();
+        one = u.get(0);
+        ut = one.to_string();
+        fmt = one.to_utf8();
+        printf("u16 U16Str.to_string=%d u16str_to_utf8=%d\n", ut.len(), fmt.len());
+        ut.release();
+        u.release();
+        u_comma.release();
+        u_zero.release();
+        u_ab.release();
+        u_bang.release();
+        u_eacute.release();
+        u_eplain.release();
+        u_l.release();
+        u_L.release();
+        u_hello.release();
+        u_spaced.release();
+        u_abc.release();
+        u_seven.release();
+        u_x.release();
+        u_csv.release();
+    }
+    return 0;
+}
diff --git a/test/p74/asan.sh b/test/p74/asan.sh
new file mode 100755
index 00000000..8b41b79c
--- /dev/null
+++ b/test/p74/asan.sh
@@ -0,0 +1,75 @@
+#!/bin/sh
+# P-7.4-7 (without `box<String>`): A.3.1-A.3.3 traces plus ASan/UBSan.
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+cc=${CC:-cc}
+ast=${CT_AST:?set CT_AST to the built ct-ast}
+w="$here/.out/asan"
+rm -rf "$w"; mkdir -p "$w"
+CT_STD_DIR="$root/lib/std"
+export CT_STD_DIR
+pass=0; fail=0
+ok() { pass=$((pass+1)); printf 'PASS %s\n' "$1"; }
+bad() { fail=$((fail+1)); printf 'FAIL %s: %s\n' "$1" "$2"; }
+cd "$root" || exit 1
+
+build_run() {
+    name=$1; cflags=$2; src=${3:-test/p74/asan/$1.ct}
+    if ! "$ast" --allow-c-boundary "$src" -o "$w/$name.c" >"$w/$name.log" 2>&1; then
+        bad "$name compile" "$(tail -2 "$w/$name.log")"; return 1
+    fi
+    if ! "$cc" -Wall -Wextra -std=c99 $cflags "$w/$name.c" -o "$w/$name" 2>"$w/$name.cc.err"; then
+        bad "$name cc" "$(tail -3 "$w/$name.cc.err")"; return 1
+    fi
+    if [ -s "$w/$name.cc.err" ]; then
+        bad "$name warning-free cc" "$(head -2 "$w/$name.cc.err")"; return 1
+    fi
+    if ! ASAN_OPTIONS=detect_leaks=0 "$w/$name" >"$w/$name.out" 2>"$w/$name.err"; then
+        bad "$name run" "non-zero exit: $(head -2 "$w/$name.err")"; return 1
+    fi
+    if [ -s "$w/$name.err" ]; then
+        bad "$name stderr" "$(head -2 "$w/$name.err")"; return 1
+    fi
+    exp="test/p74/asan/expected/$name.out"
+    if [ "$name" = "api" ]; then exp="test/p74/api_matrix/expected/prog.out"; fi
+    if [ -f "$exp" ] && ! cmp -s "$w/$name.out" "$exp"; then
+        bad "$name behaviour" "stdout differs"; return 1
+    fi
+    ok "$name ($cflags)"
+    return 0
+}
+
+build_run abi ""
+build_run trace ""
+build_run trace "-fsanitize=address -g"
+build_run trace "-fsanitize=undefined -g"
+build_run api "-fsanitize=address -g" test/p74/api_matrix/prog.ct
+build_run api "-fsanitize=undefined -g" test/p74/api_matrix/prog.ct
+
+# ASan sensitivity: a deliberate post-release read must be caught.
+if "$ast" --allow-c-boundary test/p74/asan/uaf_probe.ct -o "$w/uaf.c" >/dev/null 2>"$w/uaf.log" \
+   && "$cc" -Wall -Wextra -std=c99 -fsanitize=address -g "$w/uaf.c" -o "$w/uaf" 2>"$w/uaf.cc.err"; then
+    if ASAN_OPTIONS=detect_leaks=0 "$w/uaf" >"$w/uaf.out" 2>"$w/uaf.err"; then
+        bad "asan sensitivity" "the post-release read was not caught"
+    elif grep -Fq "heap-use-after-free" "$w/uaf.err"; then
+        ok "asan sensitivity (post-release read -> heap-use-after-free)"
+    else
+        bad "asan sensitivity" "ASan did not report heap-use-after-free"
+    fi
+else
+    bad "asan sensitivity build" "$(tail -2 "$w/uaf.log" "$w/uaf.cc.err" 2>/dev/null)"
+fi
+
+# A.3.3 negative: the borrowed `Str` has no Drop.
+if "$ast" --allow-c-boundary test/p74/asan/neg_borrow_no_drop.ct -o "$w/neg_drop.c" \
+        >"$w/neg_drop.out" 2>"$w/neg_drop.err"; then
+    bad "neg_borrow_no_drop" "accepted `delete` on a borrowed Str"
+elif grep -Fq "does not use trait 'Drop'" "$w/neg_drop.err"; then
+    ok "neg_borrow_no_drop (borrowed Str owns nothing, no Drop)"
+else
+    bad "neg_borrow_no_drop" "missing diagnostic"
+fi
+
+printf 'summary: %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ]
