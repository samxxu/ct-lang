diff --git a/test/p74/map_str/prog.ct b/test/p74/map_str/prog.ct
new file mode 100644
index 00000000..da71eefc
--- /dev/null
+++ b/test/p74/map_str/prog.ct
@@ -0,0 +1,42 @@
+/* P-7.4-4: `Map<Str, V>` migrated to owning `String` keys with borrowed `Str`
+ * lookups; `str_slice` is the view form and `str_dup` the deep copy. */
+#include <stdio.h>
+#include <string.h>
+
+int main(void)
+{
+    Str a = "a\0b";
+    Str a2 = "a\0b";
+    Str b = "a\0c";
+    Str plain = "a";
+    Str key = "key";
+    Map<String, int> m;
+    int *v;
+    int removed;
+    MapEntry<String, int> e;
+    m.h = 0;
+    printf("put a=%d b=%d\n", m.put(a, 1), m.put(b, 2));
+    printf("len=%d v1=%d v2=%d\n", m.len(), *m.get(a), *m.get(b));
+    printf("has a2=%d missing=%d\n", m.has(a2), m.has(plain));
+    e = m.entry(0);
+    printf("entry0 key len=%d starts=%d value=%d\n", e.key.len(), e.key.byte_at(0), e.value);
+    /* Split: C argument evaluation order is unspecified (TEST-19). */
+    {
+        int overwritten = m.put(a2, 7);
+        printf("overwrite=%d v1=%d len=%d\n", overwritten, *m.get(a2), m.len());
+    }
+    removed = m.remove(b);
+    printf("remove=%d len=%d\n", removed, m.len());
+    v = m.get(a2);
+    printf("get after remove=%d\n", v == 0 ? -1 : *v);
+    printf("release=%d\n", m.release());
+
+    /* naming migration: slice borrows, dup owns */
+    Str s = "hello";
+    Str view = str_slice(s, 1, 3);
+    String keep = str_dup(view);
+    printf("view=%d own=%d ownrefs=%d\n", view.len(), keep.len(), keep.refs());
+    keep.release();
+    printf("key len=%d\n", key.len());
+    return 0;
+}
diff --git a/test/p74/migration.sh b/test/p74/migration.sh
new file mode 100755
index 00000000..4b1919fc
--- /dev/null
+++ b/test/p74/migration.sh
@@ -0,0 +1,91 @@
+#!/bin/sh
+# P-7.4-3: existing consumers of the old owning `Str` are enumerated and run
+# one by one. The prototype keeps the old type only as `std::str::Str`; every
+# bare `Str` consumer therefore lands on the migration list, and each row is
+# asserted to fail with the expected class of diagnostic. Non-consumers must
+# still pass.
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+cc=${CC:-cc}
+ast=${CT_AST:?set CT_AST to the built ct-ast}
+w="$here/.out/migration"
+rm -rf "$w"; mkdir -p "$w"
+CT_STD_DIR="$root/lib/std"
+export CT_STD_DIR
+pass=0; fail=0
+ok() { pass=$((pass+1)); printf 'PASS %s\n' "$1"; }
+bad() { fail=$((fail+1)); printf 'FAIL %s: %s\n' "$1" "$2"; }
+cd "$root" || exit 1
+
+# The 11 test/ast consumers and the one example consumer, all using the old
+# owning `Str` under its bare name. Each must be on the migration list and is
+# run individually; a consumer that suddenly passes would make this list stale.
+migrate() {
+    f=$1; want=$2; stage=${3:-ast}
+    if [ "$stage" = "ast" ]; then
+        if "$ast" --allow-c-boundary "$f" -o "$w/one.c" >"$w/one.out" 2>"$w/one.err"; then
+            bad "$f" "unexpectedly migrated (remove it from the list)"
+            return
+        fi
+        if grep -Fq "$want" "$w/one.err"; then
+            ok "$f (migration required: $want)"
+        else
+            bad "$f" "unexpected diagnostic: $(head -1 "$w/one.err")"
+        fi
+        return
+    fi
+    # The consumer still compiles to C but the generated C names the removed
+    # legacy function; the migration is caught at the cc stage.
+    if ! "$ast" --allow-c-boundary "$f" -o "$w/one.c" >"$w/one.out" 2>"$w/one.err"; then
+        bad "$f" "unexpected ct-ast failure: $(head -1 "$w/one.err")"
+        return
+    fi
+    if "$cc" -Wall -Wextra -std=c99 "$w/one.c" -o "$w/one" >"$w/one.cc.out" 2>"$w/one.cc.err"; then
+        bad "$f" "unexpectedly migrated (remove it from the list)"
+        return
+    fi
+    if grep -Fq "$want" "$w/one.cc.err"; then
+        ok "$f (migration required at cc: $want)"
+    else
+        bad "$f" "unexpected cc diagnostic: $(head -1 "$w/one.cc.err")"
+    fi
+}
+migrate test/ast/225_generic_drop/prog.ct "assignment target is not assignable"
+migrate test/ast/227_vec_element_release/prog.ct "str_from" cc
+migrate test/ast/230_str_embedded_nul/prog.ct "method call on a temporary"
+migrate test/ast/231_str_ops/prog.ct "no method 'release'"
+migrate test/ast/232_str_own_pointer/prog.ct "does not use trait 'Drop'"
+migrate test/ast/241_map_str_key/prog.ct "borrowed view"
+migrate test/ast/242_map_str_release/prog.ct "borrowed view"
+migrate test/ast/286_generic_ptr_field/prog.ct "borrowed view"
+migrate test/ast/p50_sanitize/prog.ct "borrowed view"
+migrate test/ast/p50_str_has/prog.ct "borrowed view"
