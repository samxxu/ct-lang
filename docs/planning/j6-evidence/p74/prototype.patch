diff --git a/test/p74/coexist.sh b/test/p74/coexist.sh
new file mode 100755
index 00000000..63729172
--- /dev/null
+++ b/test/p74/coexist.sh
@@ -0,0 +1,62 @@
+#!/bin/sh
+# P-7.4-2: old owning `Str` only as `std::str::Str`, bare `Str` is the borrow.
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+cc=${CC:-cc}
+ast=${CT_AST:?set CT_AST to the built ct-ast}
+w="$here/.out/coexist"
+rm -rf "$w"; mkdir -p "$w"
+CT_STD_DIR="$root/lib/std"
+export CT_STD_DIR
+pass=0; fail=0
+ok() { pass=$((pass+1)); printf 'PASS %s\n' "$1"; }
+bad() { fail=$((fail+1)); printf 'FAIL %s: %s\n' "$1" "$2"; }
+cd "$root" || exit 1
+
+# 1. build mode: same unit uses both types, the qualified name resolves.
+mkdir -p "$w/b"
+if ! "$ast" build --emit-c --allow-c-boundary -I . test/p74/coexist/main.ct -o "$w/b" >"$w/b.log" 2>&1; then
+    bad "coexist build-mode compile" "$(tail -2 "$w/b.log")"
+else
+    if "$cc" -Wall -Wextra -std=c99 -I "$w/b" "$w"/b/*.c -o "$w/b/prog" 2>"$w/b.cc.err" \
+       && [ ! -s "$w/b.cc.err" ] \
+       && "$w/b/prog" >"$w/b.out" 2>"$w/b.run.err" \
+       && cmp -s "$w/b.out" test/p74/coexist/expected/main.out; then
+        ok "coexist build mode (both types, qualified names, warning-free)"
+    else
+        bad "coexist build mode" "$(tail -2 "$w/b.cc.err" "$w/b.run.err" 2>/dev/null | head -2)"
+    fi
+fi
+
+# 2. compile mode: the layer is spliced and the namespace is saved/restored.
+if ! "$ast" --allow-c-boundary test/p74/coexist/main.ct -o "$w/c.c" >"$w/c.log" 2>&1; then
+    bad "coexist compile-mode compile" "$(tail -2 "$w/c.log")"
+else
+    if "$cc" -Wall -Wextra -std=c99 "$w/c.c" -o "$w/c" 2>"$w/c.cc.err" \
+       && [ ! -s "$w/c.cc.err" ] \
+       && "$w/c" >"$w/c.out" 2>/dev/null \
+       && cmp -s "$w/c.out" test/p74/coexist/expected/main.out; then
+        ok "coexist compile mode (merged layer, warning-free)"
+    else
+        bad "coexist compile mode" "$(tail -2 "$w/c.cc.err" 2>/dev/null)"
+    fi
+fi
+
+# 3. negatives: the borrowed view has no release; the legacy type has no view API.
+neg() {
+    name=$1; pattern=$2
+    if "$ast" --allow-c-boundary "test/p74/coexist/$name.ct" -o "$w/$name.c" \
+            >"$w/$name.out" 2>"$w/$name.err"; then
+        bad "$name" "accepted a negative"
+    elif grep -Fq "$pattern" "$w/$name.err"; then
+        ok "$name (rejected: $pattern)"
+    else
+        bad "$name" "missing diagnostic: $pattern"
+    fi
+}
+neg neg_release_view "no method 'release'"
+neg neg_legacy_borrow_api "no method 'as_str'"
+
+printf 'summary: %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ]
