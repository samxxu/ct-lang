+#!/bin/sh
+# P-7.4-5: UTF-8 codepoint/byte_* and the UTF-16 core JS method matrix.
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+root=$(cd "$here/../.." && pwd)
+cc=${CC:-cc}
+ast=${CT_AST:?set CT_AST to the built ct-ast}
+w="$here/.out/api"
+rm -rf "$w"; mkdir -p "$w"
+CT_STD_DIR="$root/lib/std"
+export CT_STD_DIR
+pass=0; fail=0
+ok() { pass=$((pass+1)); printf 'PASS %s\n' "$1"; }
+bad() { fail=$((fail+1)); printf 'FAIL %s: %s\n' "$1" "$2"; }
+cd "$root" || exit 1
+
+if ! "$ast" --allow-c-boundary test/p74/api_matrix/prog.ct -o "$w/prog.c" >"$w/prog.log" 2>&1; then
+    bad "api_matrix compile" "$(tail -2 "$w/prog.log")"
+elif ! "$cc" -Wall -Wextra -std=c99 "$w/prog.c" -o "$w/prog" 2>"$w/prog.cc.err"; then
+    bad "api_matrix cc" "$(tail -3 "$w/prog.cc.err")"
+elif [ -s "$w/prog.cc.err" ]; then
+    bad "api_matrix warning-free cc" "$(head -2 "$w/prog.cc.err")"
+elif ! "$w/prog" >"$w/prog.out" 2>"$w/prog.run.err"; then
+    bad "api_matrix run" "non-zero exit"
+elif ! cmp -s "$w/prog.out" test/p74/api_matrix/expected/prog.out; then
+    bad "api_matrix behaviour" "$(diff -u test/p74/api_matrix/expected/prog.out "$w/prog.out" | head -8)"
+else
+    ok "api_matrix (UTF-8 codepoint/byte_* + UTF-16 core methods, warning-free)"
+fi
+
+neg() {
+    name=$1; pattern=$2
+    if "$ast" --allow-c-boundary "test/p74/api_matrix/$name.ct" -o "$w/$name.c" \
+            >"$w/$name.out" 2>"$w/$name.err"; then
+        bad "$name" "accepted a negative"
+    elif grep -Fq "$pattern" "$w/$name.err"; then
+        ok "$name (rejected: $pattern)"
+    else
+        bad "$name" "missing diagnostic: $pattern"
+    fi
+}
+neg neg_utf16_literal "UTF-16 string literal is not implicit"
+neg neg_u16_write "read-only subscript"
+
+printf 'summary: %d passed, %d failed\n' "$pass" "$fail"
+[ "$fail" -eq 0 ]
