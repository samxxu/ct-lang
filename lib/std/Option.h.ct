/*
 * Option.h.ct - the built-in `Option<T>` (Phase 34 S9a).
 *
 * `Option` is an ordinary generic struct, not a compiler branch: a present
 * value is `{ 1, v }` and an absent one is `{ 0 }` (the trailing field stays
 * zero-initialised). `has` is the discriminant; it comes first so a brace
 * initialiser can omit the payload. The methods are plain statically
 * dispatched impl members, so `Option<Point>` and `Option<Show>` instantiate
 * exactly like any other generic struct.
 *
 * `release` exists so a caller can spell the lifecycle explicitly; the payload
 * is a value, so there is nothing to free and the method is a no-op.
 *
 * `set` / `clear` are the mutators: `set` fills the payload and raises the
 * discriminant, `clear` lowers it and leaves the payload alone (it is gated by
 * `has`, and a value payload has nothing to release -- D34-8). `unwrap` is the
 * checked read: it aborts like `Vec.release` on a released handle rather than
 * answering a zero payload (D29-12), so a missing value is never silently
 * mistaken for a real one.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>

pub struct Option<T> {
    int has;
    T value;
} use Drop;

impl<T> Option<T> {
    /* A none Option with a zero-initialised payload: the Drop glue drops every
       `uses_drop` field unconditionally, so the unused payload must be in a
       safe-to-drop state (e.g. a Str with data == 0). */
    pub static Option<T> none() {
        Option<T> o = { 0 };
        return o;
    }

    pub int is_some() {
        return self.has;
    }

    pub int is_none() {
        return !self.has;
    }

    /* The payload when present, the caller's fallback otherwise. */
    pub T unwrap_or(T dflt) {
        if (self.has) {
            return self.value;
        }
        return dflt;
    }

    /* The payload, or a hard error: a none value has nothing to answer. */
    pub T unwrap() {
        if (!self.has) {
            fprintf(stderr, "Option: unwrap on a none value\n");
            abort();
        }
        return self.value;
    }

    /* Fills the payload and makes the option present. */
    pub void set(T v) {
        self.value = v;
        self.has = 1;
    }

    /* Makes the option absent; the payload is left untouched but unreachable
       through `unwrap` / `unwrap_or` until the next `set`. */
    pub void clear() {
        self.has = 0;
    }

    pub void release() {
    }
}
