/*
 * Str.h.ct - the built-in UTF-8 `String` owning handle and the borrowed `Str`
 * view, plus the UTF-16 `U16String` / `U16Str` pair (PH-80 / v0.80.0).
 *
 *   struct ct_str_hdr { int refs; int aux; };   (8 bytes, before the payload)
 *   struct String     { char *ptr; int len; };  (16 bytes on LP64)
 *   struct Str        { char *ptr; int len; };  (borrowed, no Drop)
 *   struct U16String  { uint16_t *ptr; int len; };
 *   struct U16Str     { uint16_t *ptr; int len; };
 *
 * `String.ptr` points at the payload; the shared header sits at `ptr - 8`. A
 * literal handle is a static `{refs = -1}` block emitted by the compiler, so
 * releasing it is a no-op and its bytes are never freed. UTF-16 payloads use
 * the same header, reached through a `char *` conversion (a `uint16_t *`
 * subtraction would scale by two).
 *
 * `String` is immutable: `s[i]` is a read-only single-codepoint `Str` view and
 * there is deliberately no `set` method, so the compiler's custom-subscript
 * protocol turns a write into a hard error. `.data` is the read-only raw view
 * (`const char *` / `const uint16_t *`, no NUL guarantee, indexable only);
 * `cstr()` is the only C-boundary exit and supplies the terminator.
 *
 * Copying follows D-013 §3: the explicit protocol is `copy()` / `retain()`
 * (share the buffer, bump `refs`) and `release()` (drop one reference). A
 * `Vec`/`Map` insertion retains through the container element glue; a plain
 * by-value parameter, return or field assignment is a shallow struct copy and
 * is not retained automatically in this phase.
 *
 * Limitations: the refcount is a plain non-atomic `int` (the author owns
 * synchronisation); UTF-8 decoding accepts 1..4 byte sequences and treats an
 * invalid lead byte as one codepoint; no regex/locale/normalize (those stay in
 * `std`).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

/* The shared 8-byte header. `refs = -1` is the immortal literal/empty form. */
pub struct ct_str_hdr {
    int refs;
    int aux;
}

pub struct String {
    char *ptr;
    int len;
} use Drop

pub struct Str {
    char *ptr;
    int len;
}

/* P-7.4-5: the real UTF-16 pair. `U16String` owns (refcount header before the
 * code units); `U16Str` borrows. Implicit literal construction is still refused
 * by the parser, so a UTF-16 value only comes from a factory. */
pub struct U16String {
    uint16_t *ptr;
    int len;
} use Drop

pub struct U16Str {
    uint16_t *ptr;
    int len;
}

/* ---- UTF-8 helpers (basic 1..4 byte sequences) ------------------------- */

static int ct_str_seq_len(const char *p, int off, int len)
{
    unsigned char c;
    if (off < 0 || off >= len) return 1;
    c = (unsigned char)p[off];
    if (c < 0x80) return 1;
    if ((c & 0xE0) == 0xC0) return 2;
    if ((c & 0xF0) == 0xE0) return 3;
    if ((c & 0xF8) == 0xF0) return 4;
    return 1;                         /* invalid lead: treat it as one byte */
}

/* Byte offset of codepoint `i`, or -1 when `i` is out of range. */
static int ct_str_cp_off(const char *p, int len, int i)
{
    int off = 0, n = 0;
    if (i < 0) return -1;
    while (off < len) {
        if (n == i) return off;
        off += ct_str_seq_len(p, off, len);
        n++;
    }
    return -1;
}

/* Codepoint count (invalid bytes count as one codepoint each). */
static int ct_str_cp_count(const char *p, int len)
{
    int off = 0, n = 0;
    while (off < len) {
        off += ct_str_seq_len(p, off, len);
        n++;
    }
    return n;
}

static int ct_str_decode(const char *p, int off, int len)
{
    unsigned char c;
    int n, k, v;
    if (off < 0 || off >= len) return -1;
    c = (unsigned char)p[off];
    n = ct_str_seq_len(p, off, len);
    if (n == 1) return c;
    v = c & (0xFF >> (n + 1));
    for (k = 1; k < n; k++) {
        if (off + k >= len) return v;
        v = (v << 6) | ((unsigned char)p[off + k] & 0x3F);
    }
    return v;
}

/* Live heap buffers, so a fixture can prove a drop freed its allocation
 * without relying only on the sanitizer. Literals never count. */
static int ct_str_live = 0;

pub int ct_str_live_count(void)
{
    return ct_str_live;
}

static Str ct_str_view(char *p, int len)
{
    Str v;
    v.ptr = p;
    v.len = len;
    return v;
}

/* A new owning handle over `len` bytes; refs = 1. */
static String ct_str_alloc(const char *p, int len)
{
    String s;
    struct ct_str_hdr *h;
    int i;
    if (len < 0) len = 0;
    h = (struct ct_str_hdr *)malloc(sizeof(struct ct_str_hdr) + (size_t)len + 1);
    if (h == 0) {
        s.ptr = 0;
        s.len = 0;
        return s;
    }
    h->refs = 1;
    h->aux = 0;
    ct_str_live = ct_str_live + 1;
    s.ptr = (char *)(h + 1);
    s.len = len;
    for (i = 0; i < len; i++) s.ptr[i] = p ? p[i] : 0;
    s.ptr[len] = 0;                   /* internal convenience, not a contract */
    return s;
}

impl String {
    /* The byte length (UTF-8 bytes, not codepoints). */
    pub int len() {
        return self->len;
    }

    pub int char_len() {
        return ct_str_cp_count(self->ptr, self->len);
    }

    pub int byte_at(int i) {
        if (i < 0 || i >= self->len) return 0;
        return (unsigned char)self->ptr[i];
    }

    pub int codepoint_at(int i) {
        int off = ct_str_cp_off(self->ptr, self->len, i);
        if (off < 0) return -1;
        return ct_str_decode(self->ptr, off, self->len);
    }

    /* A read-only single-codepoint view; the compiler turns `s[i]` into this
     * call through the custom-subscript `get` protocol. There is no `set`, so
     * `s[i] = x` is a hard error. */
    pub Str get(int i) {
        int off = ct_str_cp_off(self->ptr, self->len, i);
        int n;
        if (off < 0) return ct_str_view(self->ptr, 0);
        n = ct_str_seq_len(self->ptr, off, self->len);
        if (off + n > self->len) n = self->len - off;
        return ct_str_view(self->ptr + off, n);
    }

    pub Str as_str() {
        return ct_str_view(self->ptr, self->len);
    }

    /* The C-boundary exit: an independent NUL-terminated copy; the caller
     * frees it (`free(s.cstr())`). */
    pub char *cstr() {
        char *p;
        int i;
        p = (char *)malloc((size_t)self->len + 1);
        if (p == 0) return 0;
        for (i = 0; i < self->len; i++) p[i] = self->ptr[i];
        p[self->len] = 0;
        return p;
    }

    /* A new String over an independent copy. */
    pub String to_string() {
        return ct_str_alloc(self->ptr, self->len);
    }

    /* A new String over a sub-range; bounds are clamped. */
    pub String slice(int start, int n) {
        if (start < 0) start = 0;
        if (start > self->len) start = self->len;
        if (n < 0) n = 0;
        if (n > self->len - start) n = self->len - start;
        return ct_str_alloc(self->ptr + start, n);
    }

    /* A retained alias sharing the same buffer (explicit copy protocol).
       The increment is written here rather than through `retain()` because a
       method later in the same `impl` block is not yet visible while this body
       is parsed. */
    pub String copy() {
        String r;
        struct ct_str_hdr *h;
        r.ptr = self->ptr;
        r.len = self->len;
        if (r.ptr != 0) {
            h = (struct ct_str_hdr *)((char *)r.ptr - sizeof(struct ct_str_hdr));
            if (h->refs >= 0) h->refs = h->refs + 1;
        }
        return r;
    }

    pub int refs() {
        struct ct_str_hdr *h;
        if (self->ptr == 0) return 0;
        h = (struct ct_str_hdr *)((char *)self->ptr - sizeof(struct ct_str_hdr));
        return h->refs;
    }

    /* Bump the count and hand back a second handle (the container-element
       protocol expects `T retain(T *)`). Immortal (refs < 0) is a no-op. */
    pub String retain() {
        String r;
        struct ct_str_hdr *h;
        r.ptr = self->ptr;
        r.len = self->len;
        if (r.ptr == 0) return r;
        h = (struct ct_str_hdr *)((char *)r.ptr - sizeof(struct ct_str_hdr));
        if (h->refs >= 0) h->refs = h->refs + 1;
        return r;
    }

    pub void release() {
        struct ct_str_hdr *h;
        if (self->ptr == 0) return;
        h = (struct ct_str_hdr *)((char *)self->ptr - sizeof(struct ct_str_hdr));
        if (h->refs < 0) return;      /* immortal literal/empty: never freed */
        h->refs = h->refs - 1;
        if (h->refs == 0) {
            ct_str_live = ct_str_live - 1;
            free(h);
        }
        self->ptr = 0;
        self->len = 0;
    }

    pub void drop() {
        self->release();
    }
}

/* The owning handle's Drop is the same refcount release. CT only runs this for
 * an `own String *` / `delete` or a host struct's field glue; a plain local
 * `String` is still released explicitly (`s.release()`), exactly like `Vec`. */
impl Drop for String {
    void drop() {
        struct ct_str_hdr *h;
        if (self->ptr == 0) return;
        h = (struct ct_str_hdr *)((char *)self->ptr - sizeof(struct ct_str_hdr));
        if (h->refs < 0) return;
        h->refs = h->refs - 1;
        if (h->refs == 0) {
            ct_str_live = ct_str_live - 1;
            free(h);
        }
        self->ptr = 0;
        self->len = 0;
    }
}

impl Str {
    pub int len() {
        return self->len;
    }

    pub int char_len() {
        return ct_str_cp_count(self->ptr, self->len);
    }

    pub int byte_at(int i) {
        if (i < 0 || i >= self->len) return 0;
        return (unsigned char)self->ptr[i];
    }

    pub int codepoint_at(int i) {
        int off = ct_str_cp_off(self->ptr, self->len, i);
        if (off < 0) return -1;
        return ct_str_decode(self->ptr, off, self->len);
    }

    pub Str get(int i) {
        int off = ct_str_cp_off(self->ptr, self->len, i);
        int n;
        if (off < 0) return ct_str_view(self->ptr, 0);
        n = ct_str_seq_len(self->ptr, off, self->len);
        if (off + n > self->len) n = self->len - off;
        return ct_str_view(self->ptr + off, n);
    }

    pub Str as_str() {
        return ct_str_view(self->ptr, self->len);
    }

    pub char *cstr() {
        char *p;
        int i;
        p = (char *)malloc((size_t)self->len + 1);
        if (p == 0) return 0;
        for (i = 0; i < self->len; i++) p[i] = self->ptr[i];
        p[self->len] = 0;
        return p;
    }

    /* Deep copy into a new owning String. */
    pub String to_string() {
        return ct_str_alloc(self->ptr, self->len);
    }

    /* A borrowed sub-view (no allocation). */
    pub Str slice(int start, int n) {
        if (start < 0) start = 0;
        if (start > self->len) start = self->len;
        if (n < 0) n = 0;
        if (n > self->len - start) n = self->len - start;
        return ct_str_view(self->ptr + start, n);
    }
}

/* ---- P-7.4-4: `str_slice` borrows, `str_dup` owns ----------------------- */

/* The migrated spelling of the old `str_slice`: a borrowed view, no copy. The
   old deep-copy semantics survive only as the explicit `str_dup`. */
pub Str str_slice(Str s, int start, int n)
{
    if (start < 0) start = 0;
    if (start > s.len) start = s.len;
    if (n < 0) n = 0;
    if (n > s.len - start) n = s.len - start;
    return ct_str_view(s.ptr + start, n);
}

/* The explicit deep copy; the old `str_slice` name no longer means this. */
pub String str_dup(Str s)
{
    return ct_str_alloc(s.ptr, s.len);
}

pub String str_dup_len(const char *p, int n)
{
    return ct_str_alloc(p, n);
}

/* The migrated spelling of the old `str_concat`: a new owning `String` over
   the two byte ranges (`Str` arguments, so a literal works without a copy). */
pub String str_concat(Str a, Str b)
{
    String r;
    struct ct_str_hdr *h;
    int i;
    h = (struct ct_str_hdr *)malloc(sizeof(struct ct_str_hdr)
                                    + (size_t)a.len + (size_t)b.len + 1);
    if (h == 0) {
        r.ptr = 0;
        r.len = 0;
        return r;
    }
    h->refs = 1;
    h->aux = 0;
    ct_str_live = ct_str_live + 1;
    r.ptr = (char *)(h + 1);
    r.len = a.len + b.len;
    for (i = 0; i < a.len; i++) r.ptr[i] = a.ptr[i];
    for (i = 0; i < b.len; i++) r.ptr[a.len + i] = b.ptr[i];
    r.ptr[r.len] = 0;
    return r;
}

/* Byte-wise lexicographic order (`unsigned char`, so UTF-8 compares by its
   encoded bytes); -1, 0 or 1. */
pub int str_compare(Str a, Str b)
{
    int i, n;
    n = a.len < b.len ? a.len : b.len;
    for (i = 0; i < n; i++) {
        unsigned char x = (unsigned char)a.ptr[i];
        unsigned char y = (unsigned char)b.ptr[i];
        if (x < y) return -1;
        if (x > y) return 1;
    }
    if (a.len < b.len) return -1;
    if (a.len > b.len) return 1;
    return 0;
}

/* ---- P-7.4-5: UTF-16 owning / borrowed pair ----------------------------- */

/* `U16String` owns a refcounted array of code units; `U16Str` borrows one.
   The header is the same 8-byte `ct_str_hdr`; its payload is 2-byte aligned,
   so `header_size(U16String) = round_up(8, 2) = 8`. Code-unit length is the
   JS `length`; `code_point_at` combines a surrogate pair. */
static int ct_u16_live = 0;

pub int ct_u16_live_count(void)
{
    return ct_u16_live;
}

static U16Str ct_u16_view(uint16_t *p, int len)
{
    U16Str v;
    v.ptr = p;
    v.len = len;
    return v;
}

static U16String ct_u16_alloc(const uint16_t *p, int len)
{
    U16String s;
    struct ct_str_hdr *h;
    int i;
    if (len < 0) len = 0;
    h = (struct ct_str_hdr *)malloc(sizeof(struct ct_str_hdr)
                                    + (size_t)(len + 1) * sizeof(uint16_t));
    if (h == 0) {
        s.ptr = 0;
        s.len = 0;
        return s;
    }
    h->refs = 1;
    h->aux = 0;
    ct_u16_live = ct_u16_live + 1;
    s.ptr = (uint16_t *)(h + 1);
    s.len = len;
    for (i = 0; i < len; i++) s.ptr[i] = p ? p[i] : 0;
    s.ptr[len] = 0;
    return s;
}

static int ct_u16_lead(uint16_t c)
{
    return c >= 0xD800 && c <= 0xDBFF;
}

static int ct_u16_trail(uint16_t c)
{
    return c >= 0xDC00 && c <= 0xDFFF;
}

/* UTF-16 code-unit count of a UTF-8 byte range. Invalid sequences are treated
   as the replacement character, matching the UTF-8 helpers' 1..4 byte rule. */
static int ct_u16_units_for_utf8(const char *p, int n)
{
    int off = 0, units = 0;
    while (off < n) {
        int l = ct_str_seq_len(p, off, n);
        int cp = ct_str_decode(p, off, n);
        if (l <= 0) l = 1;
        off += l;
        units += cp > 0xFFFF ? 2 : 1;
    }
    return units;
}

/* Decode UTF-8 into a fresh owning UTF-16 handle. */
pub U16String u16_from_utf8(Str s)
{
    U16String out;
    int off, k, units;
    units = ct_u16_units_for_utf8(s.ptr, s.len);
    out = ct_u16_alloc(0, units);
    if (out.ptr == 0) return out;
    off = 0;
    k = 0;
    while (off < s.len) {
        int l = ct_str_seq_len(s.ptr, off, s.len);
        int cp = ct_str_decode(s.ptr, off, s.len);
        if (l <= 0) l = 1;
        if (l > s.len - off) l = s.len - off;
        off += l;
        if (cp > 0xFFFF) {
            int v = cp - 0x10000;
            out.ptr[k] = (uint16_t)(0xD800 + (v >> 10));
            out.ptr[k + 1] = (uint16_t)(0xDC00 + (v & 0x3FF));
            k = k + 2;
        } else {
            out.ptr[k] = (uint16_t)cp;
            k = k + 1;
        }
    }
    return out;
}

impl U16String {
    /* JS `length`: code units, not codepoints. */
    pub int len() {
        return self->len;
    }

    pub uint16_t char_code_at(int i) {
        if (i < 0 || i >= self->len) return 0;
        return self->ptr[i];
    }

    /* A single-code-unit borrowed view; out of range gives an empty view. */
    pub U16Str char_at(int i) {
        if (i < 0 || i >= self->len) return ct_u16_view(self->ptr, 0);
        return ct_u16_view(self->ptr + i, 1);
    }

    /* Custom subscript protocol: `u[i]` is the read-only one-unit view. There
       is no `set`, so a write is a hard error. */
    pub U16Str get(int i) {
        if (i < 0 || i >= self->len) return ct_u16_view(self->ptr, 0);
        return ct_u16_view(self->ptr + i, 1);
    }

    /* JS `at`: a negative index counts from the end. */
    pub U16Str at(int i) {
        int k = i;
        if (k < 0) k = self->len + k;
        return self->get(k);
    }

    /* The decoded code point at code-unit index `i`; a surrogate pair counts
       once. Out of range answers -1. */
    pub int code_point_at(int i) {
        uint16_t c;
        if (i < 0 || i >= self->len) return -1;
        c = self->ptr[i];
        if (ct_u16_lead(c) && i + 1 < self->len && ct_u16_trail(self->ptr[i + 1])) {
            int v = ((c - 0xD800) << 10) + (self->ptr[i + 1] - 0xDC00) + 0x10000;
            return v;
        }
        return c;
    }

    pub Str to_utf8() {
        char *buf;
        int i, k, n;
        String out;
        n = 0;
        for (i = 0; i < self->len; i++) {
            int cp = self->code_point_at(i);
            if (cp < 0) cp = 0xFFFD;
            if (cp < 0x80) n = n + 1;
            else if (cp < 0x800) n = n + 2;
            else if (cp < 0x10000) n = n + 3;
            else n = n + 4;
            if (cp > 0xFFFF) i = i + 1;
        }
        out = ct_str_alloc(0, n);
        if (out.ptr == 0) return ct_str_view(0, 0);
        buf = out.ptr;
        k = 0;
        for (i = 0; i < self->len; i++) {
            int cp = self->code_point_at(i);
            if (cp < 0) cp = 0xFFFD;
            if (cp < 0x80) {
                buf[k] = (char)cp;
                k = k + 1;
            } else if (cp < 0x800) {
                buf[k] = (char)(0xC0 | (cp >> 6));
                buf[k + 1] = (char)(0x80 | (cp & 0x3F));
                k = k + 2;
            } else if (cp < 0x10000) {
                buf[k] = (char)(0xE0 | (cp >> 12));
                buf[k + 1] = (char)(0x80 | ((cp >> 6) & 0x3F));
                buf[k + 2] = (char)(0x80 | (cp & 0x3F));
                k = k + 3;
            } else {
                buf[k] = (char)(0xF0 | (cp >> 18));
                buf[k + 1] = (char)(0x80 | ((cp >> 12) & 0x3F));
                buf[k + 2] = (char)(0x80 | ((cp >> 6) & 0x3F));
                buf[k + 3] = (char)(0x80 | (cp & 0x3F));
                k = k + 4;
                i = i + 1;
            }
        }
        return ct_str_view(out.ptr, out.len);
    }

    pub U16String to_utf16() {
        return ct_u16_alloc(self->ptr, self->len);
    }

    /* The full borrowed view (the UTF-16 counterpart of `String.as_str`). */
    pub U16Str as_str() {
        return ct_u16_view(self->ptr, self->len);
    }

    pub U16String copy() {
        return ct_u16_alloc(self->ptr, self->len);
    }

    pub U16String retain() {
        U16String r;
        struct ct_str_hdr *h;
        r.ptr = self->ptr;
        r.len = self->len;
        if (r.ptr == 0) return r;
        h = (struct ct_str_hdr *)((char *)r.ptr - sizeof(struct ct_str_hdr));
        if (h->refs >= 0) h->refs = h->refs + 1;
        return r;
    }

    pub void release() {
        struct ct_str_hdr *h;
        if (self->ptr == 0) return;
        h = (struct ct_str_hdr *)((char *)self->ptr - sizeof(struct ct_str_hdr));
        if (h->refs < 0) return;
        h->refs = h->refs - 1;
        if (h->refs == 0) {
            ct_u16_live = ct_u16_live - 1;
            free(h);
        }
        self->ptr = 0;
        self->len = 0;
    }

    pub int refs() {
        struct ct_str_hdr *h;
        if (self->ptr == 0) return 0;
        h = (struct ct_str_hdr *)((char *)self->ptr - sizeof(struct ct_str_hdr));
        return h->refs;
    }
}

impl Drop for U16String {
    void drop() {
        struct ct_str_hdr *h;
        if (self->ptr == 0) return;
        h = (struct ct_str_hdr *)((char *)self->ptr - sizeof(struct ct_str_hdr));
        if (h->refs < 0) return;
        h->refs = h->refs - 1;
        if (h->refs == 0) {
            ct_u16_live = ct_u16_live - 1;
            free(h);
        }
        self->ptr = 0;
        self->len = 0;
    }
}

impl U16Str {
    pub int len() {
        return self->len;
    }

    pub uint16_t char_code_at(int i) {
        if (i < 0 || i >= self->len) return 0;
        return self->ptr[i];
    }

    pub U16Str char_at(int i) {
        if (i < 0 || i >= self->len) return ct_u16_view(self->ptr, 0);
        return ct_u16_view(self->ptr + i, 1);
    }

    pub U16Str get(int i) {
        if (i < 0 || i >= self->len) return ct_u16_view(self->ptr, 0);
        return ct_u16_view(self->ptr + i, 1);
    }

    pub U16Str at(int i) {
        int k = i;
        if (k < 0) k = self->len + k;
        return self->get(k);
    }

    pub int code_point_at(int i) {
        uint16_t c;
        if (i < 0 || i >= self->len) return -1;
        c = self->ptr[i];
        if (ct_u16_lead(c) && i + 1 < self->len && ct_u16_trail(self->ptr[i + 1])) {
            int v = ((c - 0xD800) << 10) + (self->ptr[i + 1] - 0xDC00) + 0x10000;
            return v;
        }
        return c;
    }

    pub U16String to_string() {
        return ct_u16_alloc(self->ptr, self->len);
    }

    pub Str to_utf8() {
        U16String t;
        t = self->to_string();
        return t.to_utf8();
    }
}
impl U16String {
    /* Explicit factory: a UTF-16 value only comes from a factory. */
    pub static U16String from_utf8(Str s) {
        return u16_from_utf8(s);
    }

    /* An owning copy of a borrowed UTF-16 view. */
    pub static U16String from_utf16(U16Str s) {
        return ct_u16_alloc(s.ptr, s.len);
    }

    /* JS `slice`: negative indexes count from the end, then both ends clamp. */
    pub U16String slice(int start, int end) {
        int a = start, b = end;
        if (a < 0) a = self->len + a;
        if (b < 0) b = self->len + b;
        if (a < 0) a = 0;
        if (b < 0) b = 0;
        if (a > self->len) a = self->len;
        if (b > self->len) b = self->len;
        if (b < a) b = a;
        return ct_u16_alloc(self->ptr + a, b - a);
    }

    /* JS `substring`: NaN/negative clamp to 0 and the arguments swap. */
    pub U16String substring(int start, int end) {
        int a = start, b = end, t;
        if (a < 0) a = 0;
        if (b < 0) b = 0;
        if (a > self->len) a = self->len;
        if (b > self->len) b = self->len;
        if (a > b) {
            t = a;
            a = b;
            b = t;
        }
        return ct_u16_alloc(self->ptr + a, b - a);
    }

    /* The first code-unit index of `needle`, at or after `from`; -1 when
       absent. An empty needle matches at `from` when in range. */
    pub int index_of_from(U16Str needle, int from) {
        int i, j;
        if (from < 0) from = 0;
        if (needle.len == 0) return from <= self->len ? from : -1;
        i = from;
        while (i + needle.len <= self->len) {
            j = 0;
            while (j < needle.len && self->ptr[i + j] == needle.ptr[j]) j++;
            if (j == needle.len) return i;
            i++;
        }
        return -1;
    }

    pub int index_of(U16Str needle) {
        return self->index_of_from(needle, 0);
    }

    pub int last_index_of(U16Str needle) {
        int i, j;
        if (needle.len == 0) return self->len;
        if (needle.len > self->len) return -1;
        i = self->len - needle.len;
        while (i >= 0) {
            j = 0;
            while (j < needle.len && self->ptr[i + j] == needle.ptr[j]) j++;
            if (j == needle.len) return i;
            i--;
        }
        return -1;
    }

    pub int includes(U16Str needle) {
        return self->index_of_from(needle, 0) >= 0;
    }

    pub int starts_with(U16Str prefix) {
        int i;
        if (prefix.len > self->len) return 0;
        for (i = 0; i < prefix.len; i++)
            if (self->ptr[i] != prefix.ptr[i]) return 0;
        return 1;
    }

    pub int ends_with(U16Str suffix) {
        int i;
        if (suffix.len > self->len) return 0;
        for (i = 0; i < suffix.len; i++)
            if (self->ptr[self->len - suffix.len + i] != suffix.ptr[i]) return 0;
        return 1;
    }

    /* `concat` returns a fresh owning value, like JS `+`; neither input is
       consumed. */
    pub U16String concat(U16Str other) {
        U16String out;
        int i;
        out = ct_u16_alloc(0, self->len + other.len);
        if (out.ptr == 0) return out;
        for (i = 0; i < self->len; i++) out.ptr[i] = self->ptr[i];
        for (i = 0; i < other.len; i++) out.ptr[self->len + i] = other.ptr[i];
        return out;
    }

    /* One pass over `before`; `after` may be longer or shorter. */
    pub U16String replace(U16Str before, U16Str after) {
        int at = self->index_of_from(before, 0);
        U16String out;
        int i;
        if (at < 0) return ct_u16_alloc(self->ptr, self->len);
        out = ct_u16_alloc(0, self->len - before.len + after.len);
        if (out.ptr == 0) return out;
        for (i = 0; i < at; i++) out.ptr[i] = self->ptr[i];
        for (i = 0; i < after.len; i++) out.ptr[at + i] = after.ptr[i];
        for (i = at + before.len; i < self->len; i++)
            out.ptr[i - before.len + after.len] = self->ptr[i];
        return out;
    }

    /* Count occurrences (an empty `before` never matches, so no infinite
       loop), size the result once, then copy. */
    pub U16String replace_all(U16Str before, U16Str after) {
        int i, hits, at, src, dst;
        U16String out;
        if (before.len == 0) return ct_u16_alloc(self->ptr, self->len);
        hits = 0;
        i = 0;
        while (i + before.len <= self->len) {
            if (self->index_of_from(before, i) == i) {
                hits = hits + 1;
                i = i + before.len;
            } else {
                i = i + 1;
            }
        }
        out = ct_u16_alloc(0, self->len + hits * (after.len - before.len));
        if (out.ptr == 0) return out;
        src = 0;
        dst = 0;
        while (src < self->len) {
            at = self->index_of_from(before, src);
            if (at == src) {
                for (i = 0; i < after.len; i++) out.ptr[dst + i] = after.ptr[i];
                dst = dst + after.len;
                src = src + before.len;
            } else {
                out.ptr[dst] = self->ptr[src];
                dst = dst + 1;
                src = src + 1;
            }
        }
        return out;
    }

    /* ASCII case mapping; a non-ASCII code unit is left unchanged (no locale
       tables are built in). */
    pub U16String to_upper_case() {
        U16String out;
        int i;
        out = ct_u16_alloc(self->ptr, self->len);
        if (out.ptr == 0) return out;
        for (i = 0; i < self->len; i++)
            if (out.ptr[i] >= 'a' && out.ptr[i] <= 'z')
                out.ptr[i] = (uint16_t)(out.ptr[i] - 32);
        return out;
    }

    pub U16String to_lower_case() {
        U16String out;
        int i;
        out = ct_u16_alloc(self->ptr, self->len);
        if (out.ptr == 0) return out;
        for (i = 0; i < self->len; i++)
            if (out.ptr[i] >= 'A' && out.ptr[i] <= 'Z')
                out.ptr[i] = (uint16_t)(out.ptr[i] + 32);
        return out;
    }

    /* JS whitespace is wider than ASCII; the built-in subset trims the ASCII
       set only (documented in the matrix). */
    pub int trim_lead(int from) {
        int i = from;
        while (i < self->len && (self->ptr[i] == ' ' || self->ptr[i] == '\t'
               || self->ptr[i] == '\n' || self->ptr[i] == '\r'))
            i++;
        return i;
    }

    pub int trim_tail(int from) {
        int i = from;
        while (i > 0 && (self->ptr[i - 1] == ' ' || self->ptr[i - 1] == '\t'
               || self->ptr[i - 1] == '\n' || self->ptr[i - 1] == '\r'))
            i--;
        return i;
    }

    pub U16String trim() {
        int a = self->trim_lead(0);
        int b = self->trim_tail(self->len);
        if (b < a) b = a;
        return ct_u16_alloc(self->ptr + a, b - a);
    }

    pub U16String trim_start() {
        int a = self->trim_lead(0);
        return ct_u16_alloc(self->ptr + a, self->len - a);
    }

    pub U16String trim_end() {
        int b = self->trim_tail(self->len);
        return ct_u16_alloc(self->ptr, b);
    }

    pub U16String repeat(int n) {
        U16String out;
        int i, k;
        if (n < 0) n = 0;
        out = ct_u16_alloc(0, self->len * n);
        if (out.ptr == 0) return out;
        for (k = 0; k < n; k++)
            for (i = 0; i < self->len; i++) out.ptr[k * self->len + i] = self->ptr[i];
        return out;
    }

    /* Pad to `target` code units; the pad string is repeated and truncated.
       An empty pad or a non-positive target is a no-op copy. */
    pub U16String pad_start(int target, U16Str pad) {
        U16String out;
        int fill, i;
        if (target <= self->len || pad.len == 0) return ct_u16_alloc(self->ptr, self->len);
        out = ct_u16_alloc(0, target);
        if (out.ptr == 0) return out;
        fill = target - self->len;
        for (i = 0; i < fill; i++) out.ptr[i] = pad.ptr[i % pad.len];
        for (i = 0; i < self->len; i++) out.ptr[fill + i] = self->ptr[i];
        return out;
    }

    pub U16String pad_end(int target, U16Str pad) {
        U16String out;
        int fill, i;
        if (target <= self->len || pad.len == 0) return ct_u16_alloc(self->ptr, self->len);
        out = ct_u16_alloc(0, target);
        if (out.ptr == 0) return out;
        for (i = 0; i < self->len; i++) out.ptr[i] = self->ptr[i];
        fill = target - self->len;
        for (i = 0; i < fill; i++) out.ptr[self->len + i] = pad.ptr[i % pad.len];
        return out;
    }

    /* `split` returns owning pieces; `Vec<U16String>` uses the element
       retain/release glue, so the vector and the caller each own a handle. */
    pub Vec<U16String> split(U16Str sep) {
        Vec<U16String> out;
        int at, from, i;
        U16String piece;
        out.h = 0;
        if (sep.len == 0) {
            for (i = 0; i < self->len; i++) {
                piece = ct_u16_alloc(self->ptr + i, 1);
                out.push(piece);
                piece.release();
            }
            return out;
        }
        from = 0;
        while (from <= self->len) {
            at = self->index_of_from(sep, from);
            if (at < 0) at = self->len;
            piece = ct_u16_alloc(self->ptr + from, at - from);
            out.push(piece);
            piece.release();
            if (at == self->len) break;
            from = at + sep.len;
        }
        return out;
    }
}

/* ---- P-7.4-4: the `Map` key block for owning `String` keys -------------- */

/* A stored `String` key compares by its bytes; the lookup key is a borrow, so
   a caller never has to own a copy just to read. The block stores owning
   handles (`String`), never the borrowed `Str` argument: a `Map<Str, V>` is a
   storage position and is refused by the borrow rules (A.4 P-4.2).

   The key comparison, deep copy and release are written inline instead of
   through helper functions: a `static` helper called only from an instance
   body has no prototype in compile mode, and calling a sibling method from a
   generic body is forbidden (P15). */
impl<V> Map<String, V> {
    /* 1 when overwritten, 1 when appended, 0 on a failed copy or growth. The
       deep copy is the `str_dup` semantics (an independent owning handle). */
    pub int put(Str k, V v)
    {
        int i, j, same;
        struct MapEntry<String, V> *es;
        String nk;
        struct ct_str_hdr *nh;
        if (k.len < 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<String, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            same = 0;
            if (es[i].key.len == k.len) {
                if (k.len == 0) same = 1;
                else if (es[i].key.ptr != 0 && k.ptr != 0)
                    same = memcmp(es[i].key.ptr, k.ptr, (size_t)k.len) == 0;
            }
            if (same) {
                nh = (struct ct_str_hdr *)malloc(sizeof(struct ct_str_hdr)
                                                 + (size_t)k.len + 1);
                if (nh == 0) return 0;
                nh->refs = 1;
                nh->aux = 0;
                nk.ptr = (char *)(nh + 1);
                nk.len = k.len;
                for (j = 0; j < k.len; j++) nk.ptr[j] = k.ptr[j];
                nk.ptr[k.len] = 0;
                __ct_elem_retain(&v);
                __ct_elem_release(&es[i].value);
                {
                    struct ct_str_hdr *kh;
                    if (es[i].key.ptr != 0) {
                        kh = (struct ct_str_hdr *)((char *)es[i].key.ptr - sizeof(struct ct_str_hdr));
                        if (kh->refs > 0) {
                            kh->refs = kh->refs - 1;
                            if (kh->refs == 0) {
                                free(kh);
                            }
                        }
                    }
                }
                es[i].key = nk;
                es[i].value = v;
                return 1;
            }
        }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<String, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data, (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        nh = (struct ct_str_hdr *)malloc(sizeof(struct ct_str_hdr) + (size_t)k.len + 1);
        if (nh == 0) return 0;
        nh->refs = 1;
        nh->aux = 0;
        nk.ptr = (char *)(nh + 1);
        nk.len = k.len;
        for (j = 0; j < k.len; j++) nk.ptr[j] = k.ptr[j];
        nk.ptr[k.len] = 0;
        __ct_elem_retain(&v);
        es[self->h->len].key = nk;
        es[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    pub V *get(Str k)
    {
        int i, same;
        struct MapEntry<String, V> *es;
        if (self->h == 0 || k.len < 0) return 0;
        es = (struct MapEntry<String, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            same = 0;
            if (es[i].key.len == k.len) {
                if (k.len == 0) same = 1;
                else if (es[i].key.ptr != 0 && k.ptr != 0)
                    same = memcmp(es[i].key.ptr, k.ptr, (size_t)k.len) == 0;
            }
            if (same) return &es[i].value;
        }
        return 0;
    }

    pub V *at(Str k)
    {
        int i, j, same;
        struct MapEntry<String, V> *es;
        String nk;
        struct ct_str_hdr *nh;
        V z;
        if (k.len < 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<String, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            same = 0;
            if (es[i].key.len == k.len) {
                if (k.len == 0) same = 1;
                else if (es[i].key.ptr != 0 && k.ptr != 0)
                    same = memcmp(es[i].key.ptr, k.ptr, (size_t)k.len) == 0;
            }
            if (same) return &es[i].value;
        }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<String, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data, (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        nh = (struct ct_str_hdr *)malloc(sizeof(struct ct_str_hdr) + (size_t)k.len + 1);
        if (nh == 0) return 0;
        nh->refs = 1;
        nh->aux = 0;
        nk.ptr = (char *)(nh + 1);
        nk.len = k.len;
        for (j = 0; j < k.len; j++) nk.ptr[j] = k.ptr[j];
        nk.ptr[k.len] = 0;
        memset(&z, 0, sizeof(z));
        es[self->h->len].key = nk;
        es[self->h->len].value = z;
        self->h->len = self->h->len + 1;
        return &es[self->h->len - 1].value;
    }

    pub int has(Str k)
    {
        int i, same;
        struct MapEntry<String, V> *es;
        if (self->h == 0 || k.len < 0) return 0;
        es = (struct MapEntry<String, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            same = 0;
            if (es[i].key.len == k.len) {
                if (k.len == 0) same = 1;
                else if (es[i].key.ptr != 0 && k.ptr != 0)
                    same = memcmp(es[i].key.ptr, k.ptr, (size_t)k.len) == 0;
            }
            if (same) return 1;
        }
        return 0;
    }

    pub int remove(Str k)
    {
        int i, j, same;
        struct MapEntry<String, V> *es;
        if (self->h == 0 || k.len < 0) return 0;
        es = (struct MapEntry<String, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            same = 0;
            if (es[i].key.len == k.len) {
                if (k.len == 0) same = 1;
                else if (es[i].key.ptr != 0 && k.ptr != 0)
                    same = memcmp(es[i].key.ptr, k.ptr, (size_t)k.len) == 0;
            }
            if (same) {
                struct ct_str_hdr *kh;
                __ct_elem_release(&es[i].value);
                if (es[i].key.ptr != 0) {
                    kh = (struct ct_str_hdr *)((char *)es[i].key.ptr - sizeof(struct ct_str_hdr));
                    if (kh->refs > 0) {
                        kh->refs = kh->refs - 1;
                        if (kh->refs == 0) {
                            free(kh);
                        }
                    }
                }
                for (j = i; j + 1 < self->h->len; j++) es[j] = es[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        }
        return 0;
    }

    pub void clear()
    {
        int i, j;
        struct MapEntry<String, V> *es;
        if (self->h == 0) return;
        es = (struct MapEntry<String, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            struct ct_str_hdr *kh;
            __ct_elem_release(&es[i].value);
            if (es[i].key.ptr != 0) {
                kh = (struct ct_str_hdr *)((char *)es[i].key.ptr - sizeof(struct ct_str_hdr));
                if (kh->refs > 0) {
                    kh->refs = kh->refs - 1;
                    if (kh->refs == 0) {
                        free(kh);
                    }
                }
            }
        }
        self->h->len = 0;
        j = 0;
        (void)j;
    }

    pub int release()
    {
        int left;
        int i;
        struct MapEntry<String, V> *es;
        if (self->h == 0) {
            fprintf(stderr, "Map: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            es = (struct MapEntry<String, V> *)self->h->data;
            for (i = 0; i < self->h->len; i++) {
                struct ct_str_hdr *kh;
                __ct_elem_release(&es[i].value);
                if (es[i].key.ptr != 0) {
                    kh = (struct ct_str_hdr *)((char *)es[i].key.ptr - sizeof(struct ct_str_hdr));
                    if (kh->refs > 0) {
                        kh->refs = kh->refs - 1;
                        if (kh->refs == 0) {
                            free(kh);
                        }
                    }
                }
            }
            free(self->h->data);
            free(self->h);
        }
        self->h = 0;
        return left < 0 ? 0 : left;
    }
}

/* ---- P-7.4-5: UTF-8 codepoint / byte-level API ------------------------- */

impl String {
    /* The read-only single-codepoint view (`s[i]` is the same call through the
       custom subscript protocol). */
    pub Str char_at(int i) {
        return self->get(i);
    }

    /* An O(1) byte-range view; bounds are clamped, no allocation. */
    pub Str byte_slice(int start, int n) {
        if (start < 0) start = 0;
        if (start > self->len) start = self->len;
        if (n < 0) n = 0;
        if (n > self->len - start) n = self->len - start;
        return ct_str_view(self->ptr + start, n);
    }

    /* A byte-level search (UTF-8 continuation bytes are fine); -1 when
       absent and `from` clamped. */
    pub int byte_index_of_from(Str needle, int from) {
        int i, j;
        if (from < 0) from = 0;
        if (needle.len == 0) return from <= self->len ? from : -1;
        i = from;
        while (i + needle.len <= self->len) {
            j = 0;
            while (j < needle.len && self->ptr[i + j] == needle.ptr[j]) j++;
            if (j == needle.len) return i;
            i++;
        }
        return -1;
    }

    pub int byte_index_of(Str needle) {
        return self->byte_index_of_from(needle, 0);
    }
}

impl Str {
    pub Str char_at(int i) {
        return self->get(i);
    }

    pub Str byte_slice(int start, int n) {
        if (start < 0) start = 0;
        if (start > self->len) start = self->len;
        if (n < 0) n = 0;
        if (n > self->len - start) n = self->len - start;
        return ct_str_view(self->ptr + start, n);
    }

    pub int byte_index_of_from(Str needle, int from) {
        int i, j;
        if (from < 0) from = 0;
        if (needle.len == 0) return from <= self->len ? from : -1;
        i = from;
        while (i + needle.len <= self->len) {
            j = 0;
            while (j < needle.len && self->ptr[i + j] == needle.ptr[j]) j++;
            if (j == needle.len) return i;
            i++;
        }
        return -1;
    }

    pub int byte_index_of(Str needle) {
        return self->byte_index_of_from(needle, 0);
    }
}

impl String {
    /* `String.from_utf16(U16Str)` is the other explicit cross-encoding
       factory; it reuses the UTF-16 view's own encoder. */
    pub static String from_utf16(U16Str s) {
        Str v = s.to_utf8();
        return v.to_string();
    }

    pub U16String to_utf16() {
        Str v = self->as_str();
        return u16_from_utf8(v);
    }
}
