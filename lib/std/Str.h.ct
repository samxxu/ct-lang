/*
 * Str.h.ct - the built-in length-carrying string (Phase 36 S4a1).
 *
 * `Str` owns a heap buffer and its byte length. It is not NUL-terminated and
 * may carry embedded `\0` bytes; `len` is the whole contract. The explicit
 * `impl Drop for Str` frees the buffer: the automatic field glue cannot,
 * because a `char *` carries no Drop, so without this impl `delete` would free
 * only the struct and leak `data`.
 *
 * The released state is `data == 0`, `len == -1`; the drop is safe on it
 * because `free(0)` is a no-op. `release()` (S4a2) inlines the same pair, the
 * shape the fallback plan fixes (Phase 36 card §15).
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdlib.h>

pub struct Str {
    char *data;
    int len;
} use Drop;

impl Drop for Str {
    void drop() {
        free(self->data);
        self->data = 0;
        self->len = -1;
    }
}

/* Copy `n` bytes (plus a trailing NUL, which is not part of `len`). An
   embedded `\0` inside the first `n` bytes is kept: `len` is the contract. */
pub Str str_from_len(const char *p, int n)
{
    Str r;
    int i;

    if (n < 0) n = 0;
    r.data = (char *)malloc((size_t)n + 1);
    if (!r.data) {
        r.len = -1;
        return r;
    }
    for (i = 0; i < n; i++) r.data[i] = p ? p[i] : 0;
    r.data[n] = 0;
    r.len = n;
    return r;
}

/* Copy a NUL-terminated C string. */
pub Str str_from(const char *s)
{
    int n;

    n = 0;
    if (s) {
        while (s[n]) n++;
    }
    return str_from_len(s, n);
}

/* The byte count; an embedded `\0` counts like any other byte. */
pub int str_len(Str s)
{
    return s.len;
}

/* A new, independently releasable handle over `n` bytes from `start`. The
   bounds are clamped to the source; an embedded `\0` is copied as data. */
pub Str str_slice(Str s, int start, int n)
{
    if (start < 0) start = 0;
    if (n < 0) n = 0;
    if (start > s.len) start = s.len;
    if (n > s.len - start) n = s.len - start;
    return str_from_len(s.data + start, n);
}

/* Concatenate two handles into a new one; both inputs keep their buffers. */
pub Str str_concat(Str a, Str b)
{
    Str r;
    int i;

    r.data = (char *)malloc((size_t)a.len + (size_t)b.len + 1);
    if (!r.data) {
        r.len = -1;
        return r;
    }
    for (i = 0; i < a.len; i++) r.data[i] = a.data[i];
    for (i = 0; i < b.len; i++) r.data[a.len + i] = b.data[i];
    r.len = a.len + b.len;
    r.data[r.len] = 0;
    return r;
}

/* Byte-wise lexicographic order (`unsigned char`, so UTF-8 compares by its
   encoded bytes); returns -1, 0 or 1. */
pub int str_compare(Str a, Str b)
{
    int i, n;

    n = a.len < b.len ? a.len : b.len;
    for (i = 0; i < n; i++) {
        unsigned char x = (unsigned char)a.data[i];
        unsigned char y = (unsigned char)b.data[i];
        if (x < y) return -1;
        if (x > y) return 1;
    }
    if (a.len < b.len) return -1;
    if (a.len > b.len) return 1;
    return 0;
}

/* A NUL-terminated copy for C interfaces; the caller frees it. An embedded
   `\0` truncates what a C consumer sees, so `len` stays the contract. */
pub char *str_c_str(Str s)
{
    char *p;
    int i;

    p = (char *)malloc((size_t)s.len + 1);
    if (!p) return 0;
    for (i = 0; i < s.len; i++) p[i] = s.data[i];
    p[s.len] = 0;
    return p;
}

impl Str {
    /* A new handle over an independent copy of the buffer; this is the shape
       Phase 31's element protocol needs (`retain` returning the element). */
    pub Str retain() {
        return str_from_len(self->data, self->len);
    }

    /* Free the buffer and mark the handle released; `Drop` inlines the same
       pair, so `release` followed by `delete` is harmless (`free(0)`). */
    pub void release() {
        free(self->data);
        self->data = 0;
        self->len = -1;
    }
}
