/*
 * Result.h.ct - the built-in `Result<T, E>` (Phase 34 S9c).
 *
 * `Result` is an ordinary generic struct with two parameters, not a compiler
 * branch: success is `{ 1, v, err }` and failure is `{ 0, v, err }`, with `ok`
 * as the discriminant. A brace initialiser may leave the unused payload zero,
 * so `Result<int, char *> r = { 1, 42, 0 };` and `{ 0, 0, "boom" }` are the
 * two canonical spellings. The methods are plain statically dispatched impl
 * members, exactly like `Option`'s.
 *
 * `release` mirrors `Option.release`: the payloads are values, so there is
 * nothing to free and the method is a no-op (D34-8).
 *
 * `unwrap` / `unwrap_err` are the checked reads: they abort like `Option.unwrap`
 * when the result is on the other side, so a missing payload is never silently
 * mistaken for a real one. `set_ok` / `set_err` are the mutators that flip the
 * discriminant; the payload of the other side is left untouched but gated.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>

pub struct Result<T, E> {
    int ok;
    T value;
    E err;
} use Drop;

impl<T, E> Result<T, E> {
    /* A success Result: the error payload is zero-initialised so the Drop glue
       (which drops every `uses_drop` field unconditionally) can drop it safely. */
    pub static Result<T, E> ok(T v) {
        Result<T, E> r = { 0 };
        r.ok = 1;
        r.value = v;
        return r;
    }

    /* A failure Result: the value payload is zero-initialised for the same
       reason as `ok`. */
    pub static Result<T, E> err(E e) {
        Result<T, E> r = { 0 };
        r.ok = 0;
        r.err = e;
        return r;
    }

    pub int is_ok() {
        return self.ok;
    }

    pub int is_err() {
        return !self.ok;
    }

    /* The success payload when present, the caller's fallback otherwise. */
    pub T unwrap_or(T dflt) {
        if (self.ok) {
            return self.value;
        }
        return dflt;
    }

    /* The error payload when the result failed, the caller's fallback
       otherwise. */
    pub E unwrap_err_or(E dflt) {
        if (!self.ok) {
            return self.err;
        }
        return dflt;
    }

    /* The success payload, or a hard error: a failure has nothing to answer. */
    pub T unwrap() {
        if (!self.ok) {
            fprintf(stderr, "Result: unwrap on an error value\n");
            abort();
        }
        return self.value;
    }

    /* The error payload, or a hard error: a success carries no error. */
    pub E unwrap_err() {
        if (self.ok) {
            fprintf(stderr, "Result: unwrap_err on an ok value\n");
            abort();
        }
        return self.err;
    }

    /* Makes the result a success with the given payload. */
    pub void set_ok(T v) {
        self.value = v;
        self.ok = 1;
    }

    /* Makes the result a failure with the given error. */
    pub void set_err(E e) {
        self.err = e;
        self.ok = 0;
    }

    pub void release() {
    }
}
