/*
 * Vec.h.ct - the built-in growable array `Vec<T>` and the insertion-ordered
 * `Map<K, V>` / `MapEntry<K, V>` pair (Phase 29).
 *
 * This unit is the whole built-in layer. `Vec` and `Map` share one private
 * buffer header, so they have to live in one unit: a header may not define the
 * same struct twice, and both headers would otherwise be included by the same
 * consumer. The file is named after its first `pub` type, which is the unit
 * naming rule every `.h.ct` follows.
 *
 * Both containers are ordinary generic structs: the compiler has no branch for
 * them (B29-3 / E29-12). Their methods live in `impl<...>` blocks, so they are
 * statically dispatched and never appear in a vtable.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Root namespace on purpose: the layer is pre-parsed, not imported, so `Vec` /
   `Map` have to be spelled exactly as the user writes them (D29-3). */

/* The buffer header shared by both containers: a reference count, the number of
   live elements and the allocated capacity. `release` frees the data and the
   header once the count reaches zero; a second release on the same handle is a
   hard error, not a silent no-op (D29-12). */
pub struct ct_buf {
    int refs;
    int len;
    int cap;
}

pub struct Vec<T> {
    struct ct_buf *h;
    T *data;
}

/* `Map` stores its entries in insertion order and answers lookups by scanning
   them: a compact array of `MapEntry` values with no auxiliary index. Insertion
   order is therefore the array order, `remove` keeps it by shifting the tail
   left, and `put` on an existing key rewrites the value in place. A key is
   compared by content: `int` keys by their bytes, `char *` keys by `strcmp`
   (the two cases are told apart by the argument width, see §2.3/D29-11). */
pub struct MapEntry<K, V> {
    K key;
    V value;
}

pub struct Map<K, V> {
    struct ct_buf *h;
    struct MapEntry<K, V> *entries;
}

impl<T> Vec<T> {
    /* P29-3: the constructor the range lowering calls. The compiler builds the
       composite literal and passes its length, so this is the only place that
       knows how a `Vec` is laid out (B29-3). `items` NULL or `n <= 0` answers an
       empty handle; a failed allocation answers the same, so the caller always
       owns a handle it may `release()`. */
    static Vec<T> from(T *items, int n)
    {
        Vec<T> v;
        void *raw;
        T *nd;
        v.h = 0;
        v.data = 0;
        if (items == 0 || n <= 0) return v;
        v.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (v.h == 0) return v;
        raw = malloc((size_t)(n * (int)sizeof(v.data[0])));
        if (raw == 0) {
            free(v.h);
            v.h = 0;
            return v;
        }
        nd = raw;
        v.data = nd;
        memcpy(v.data, items, (size_t)(n * (int)sizeof(v.data[0])));
        v.h->refs = 1;
        v.h->len = n;
        v.h->cap = n;
        return v;
    }

    int len()
    {
        if (self->h == 0) return 0;
        return self->h->len;
    }

    /* Out of range answers a zero value, never a read past the buffer. */
    T get(int i)
    {
        T z;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || i < 0 || i >= self->h->len) return z;
        return self->data[i];
    }

    /* Out of range is a no-op. */
    void set(int i, T v)
    {
        if (self->h == 0 || i < 0 || i >= self->h->len) return;
        self->data[i] = v;
    }

    /* Grows by doubling; 0 when the allocation fails, 1 on success. */
    int push(T v)
    {
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) return 0;
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->data = 0;
        }
        if (self->h->len == self->h->cap) {
            int nc;
            T *nd;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->data, (size_t)(nc * (int)sizeof(self->data[0])));
            if (raw == 0) return 0;
            nd = raw;
            self->data = nd;
            self->h->cap = nc;
        }
        self->data[self->h->len] = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* Empty answers a zero value. */
    T pop()
    {
        T z;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || self->h->len == 0) return z;
        self->h->len = self->h->len - 1;
        return self->data[self->h->len];
    }

    /* Drops the elements, keeps the buffer for reuse. */
    void clear()
    {
        if (self->h != 0) self->h->len = 0;
    }

    /* A second handle on the same buffer; both stay readable (D29-12). */
    Vec<T> retain()
    {
        Vec<T> r;
        r.h = self->h;
        r.data = self->data;
        if (r.h != 0) r.h->refs = r.h->refs + 1;
        return r;
    }

    /* Returns the remaining count. Releasing a released handle aborts: the
       alternative -- a silent no-op -- would hide a double free. */
    int release()
    {
        int left;
        if (self->h == 0) {
            fprintf(stderr, "Vec: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            free(self->data);
            free(self->h);
            self->data = 0;
            self->h = 0;
            return 0;
        }
        return left;
    }
}

impl<K, V> Map<K, V> {
    int len()
    {
        if (self->h == 0) return 0;
        return self->h->len;
    }

    /* 1 when the key is present (and its value was overwritten), 1 when it was
       appended, 0 when the allocation failed or a `char *` key is NULL. */
    int put(K k, V v)
    {
        int i;
        char *ks;
        /* `K` has no parameterised trait to ask, so a key of pointer width is
           compared as a string and every other key by its bytes (D29). The
           pointer is read through `memcpy`, so an `int` instance never casts an
           integer to a pointer in the generated C. */
        ks = 0;
        memcpy(&ks, &k, sizeof(k));
        if (sizeof(k) != sizeof(char *)) ks = 0;
        if (sizeof(k) == sizeof(char *) && ks == 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) return 0;
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->entries = 0;
        }
        for (i = 0; i < self->h->len; i++) {
            if (ks != 0) {
                char *es;
                es = 0;
                memcpy(&es, &self->entries[i].key, sizeof(self->entries[i].key));
                if (strcmp(es, ks) == 0) {
                    self->entries[i].value = v;
                    return 1;
                }
            } else if (memcmp(&self->entries[i].key, &k, sizeof(k)) == 0) {
                self->entries[i].value = v;
                return 1;
            }
        }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<K, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->entries,
                    (size_t)(nc * (int)sizeof(self->entries[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->entries = ne;
            self->h->cap = nc;
        }
        self->entries[self->h->len].key = k;
        self->entries[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* NULL when absent; otherwise an interior pointer that stays valid until
       the next modification. */
    V *get(K k)
    {
        int i;
        char *ks;
        if (self->h == 0) return 0;
        ks = 0;
        memcpy(&ks, &k, sizeof(k));
        if (sizeof(k) != sizeof(char *)) ks = 0;
        for (i = 0; i < self->h->len; i++) {
            if (ks != 0) {
                char *es;
                es = 0;
                memcpy(&es, &self->entries[i].key, sizeof(self->entries[i].key));
                if (strcmp(es, ks) == 0) return &self->entries[i].value;
            } else if (memcmp(&self->entries[i].key, &k, sizeof(k)) == 0) {
                return &self->entries[i].value;
            }
        }
        return 0;
    }

    /* 1 when the key was found and removed; the tail shifts left so the
       remaining entries keep their insertion order. */
    int remove(K k)
    {
        int i;
        char *ks;
        if (self->h == 0) return 0;
        ks = 0;
        memcpy(&ks, &k, sizeof(k));
        if (sizeof(k) != sizeof(char *)) ks = 0;
        for (i = 0; i < self->h->len; i++) {
            int hit;
            if (ks != 0) {
                char *es;
                es = 0;
                memcpy(&es, &self->entries[i].key, sizeof(self->entries[i].key));
                hit = strcmp(es, ks) == 0;
            } else {
                hit = memcmp(&self->entries[i].key, &k, sizeof(k)) == 0;
            }
            if (hit) {
                int j;
                for (j = i; j + 1 < self->h->len; j++)
                    self->entries[j] = self->entries[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        }
        return 0;
    }

    void clear()
    {
        if (self->h != 0) self->h->len = 0;
    }

    /* The i-th entry in insertion order; a zero entry when out of range. */
    MapEntry<K, V> entry(int i)
    {
        MapEntry<K, V> z;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || i < 0 || i >= self->h->len) return z;
        return self->entries[i];
    }

    Map<K, V> retain()
    {
        Map<K, V> r;
        r.h = self->h;
        r.entries = self->entries;
        if (r.h != 0) r.h->refs = r.h->refs + 1;
        return r;
    }

    int release()
    {
        int left;
        if (self->h == 0) {
            fprintf(stderr, "Map: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            free(self->entries);
            free(self->h);
            self->entries = 0;
            self->h = 0;
            return 0;
        }
        return left;
    }
}
