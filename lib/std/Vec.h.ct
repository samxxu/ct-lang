/*
 * Vec.h.ct - the built-in growable array `Vec<T>` and the insertion-ordered
 * `Map<K, V>` / `MapEntry<K, V>` pair (Phase 29).
 *
 * This unit is the whole built-in layer. `Vec` and `Map` share one private
 * buffer header, so they have to live in one unit: a header may not define the
 * same struct twice, and both headers would otherwise be included by the same
 * consumer. The file is named after its first `pub` type, which is the unit
 * naming rule every `.h.ct` follows.
 *
 * Both containers are ordinary generic structs: the compiler has no branch for
 * them (B29-3 / E29-12). Their methods live in `impl<...>` blocks, so they are
 * statically dispatched and never appear in a vtable.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>


/* Root namespace on purpose: the layer is pre-parsed, not imported, so `Vec` /
   `Map` have to be spelled exactly as the user writes them (D29-3). */

/* The buffer header shared by both containers: a reference count, the number of
   live elements, the allocated capacity and the element storage. The header
   owns the storage (H-A): a handle is only the `h` pointer, so copying a handle
   never duplicates a stale data pointer when a sibling grows the buffer.
   `release` frees the data and the header once the count reaches zero; a second
   release on the same handle is a hard error, not a silent no-op (D29-12). */
pub struct ct_buf {
    int refs;
    int len;
    int cap;
    void *data;
}

pub struct Vec<T> {
    struct ct_buf *h;
}

/* `Map` stores its entries in insertion order and answers lookups by scanning
   them: a compact array of `MapEntry` values with no auxiliary index. Insertion
   order is therefore the array order, `remove` keeps it by shifting the tail
   left, and `put` on an existing key rewrites the value in place. A key is
   compared by content: `int` / `long` keys by their bytes, `char *` keys by
   `strcmp`, `Str` keys by length plus `memcmp` over exactly `len` bytes so an
   embedded NUL compares as data (PH-47). Each key owns what it shows: the
   `char *` forms borrow the caller's pointer, while `Str` is deep-copied on
   `put` and released with its entry (D47-3'). */
pub struct MapEntry<K, V> {
    K key;
    V value;
}

pub struct Map<K, V> {
    struct ct_buf *h;
}

impl<T> Vec<T> {
    /* P29-3: the constructor the range lowering calls. The compiler builds the
       composite literal and passes its length, so this is the only place that
       knows how a `Vec` is laid out (B29-3). An empty source still answers a
       non-zero header (D31-21) so the caller always owns a handle it may
       `release()`; a failed allocation aborts instead of answering `h == 0`. */
    pub static Vec<T> from(T *items, int n)
    {
        Vec<T> v;
        void *raw;
        T *nd;
        int i;
        v.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (v.h == 0) abort();
        v.h->refs = 1;
        v.h->len = 0;
        v.h->cap = 0;
        v.h->data = 0;
        if (items == 0 || n <= 0) return v;
        raw = malloc((size_t)(n * (int)sizeof(items[0])));
        if (raw == 0) abort();
        nd = raw;
        v.h->data = nd;
        memcpy(v.h->data, items, (size_t)(n * (int)sizeof(items[0])));
        for (i = 0; i < n; i++)
            __ct_elem_retain(&nd[i]);
        v.h->len = n;
        v.h->cap = n;
        return v;
    }

    pub int len()
    {
        if (self->h == 0) return 0;
        return self->h->len;
    }

    /* Out of range answers a zero value, never a read past the buffer. */
    pub T get(int i)
    {
        T z;
        T *d;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || i < 0 || i >= self->h->len) return z;
        d = self->h->data;
        return d[i];
    }

    /* PH-50 D50-1/D50-3: the bounds predicate that makes an in-range zero
       value distinguishable from an out-of-range read. `get` keeps its
       zero-value answer unchanged (D50-1). */
    pub int has(int i)
    {
        if (self->h == 0) return 0;
        return i >= 0 && i < self->h->len;
    }

    /* PH-50 D50-2/D50-3: a borrowed pointer to the slot itself, never a copy
       and never an extra reference. The caller must not `release` it; the
       pointer is invalidated by any later mutation of this container (the same
       lifetime `get`'s interior pointer has). 0 when the index is out of
       range, so `has` / `at` agree and no zero sentinel is needed. */
    pub T *at(int i)
    {
        T *d;
        if (self->h == 0 || i < 0 || i >= self->h->len) return 0;
        d = self->h->data;
        return &d[i];
    }

    /* Out of range is a no-op. The new value is retained before the old slot is
       released, so `v.set(i, v.get(i))` stays safe when the slot is the only
       owner. */
    pub void set(int i, T v)
    {
        T *d;
        void *raw;
        int nc;
        if (i < 0) abort();
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        if (i >= self->h->len && i - self->h->len > 1024)
            fprintf(stderr, "ctc: warning: Vec growth span %d exceeds CT_VEC_GROW_WARN_SPAN (1024)\n",
                    i - self->h->len);
        if (i >= self->h->cap) {
            nc = self->h->cap == 0 ? 4 : self->h->cap;
            while (nc <= i) nc = nc * 2;
            raw = realloc(self->h->data, (size_t)(nc * (int)sizeof(v)));
            if (raw == 0) abort();
            self->h->data = raw;
            self->h->cap = nc;
        }
        d = self->h->data;
        if (i >= self->h->len) {
            memset(&d[self->h->len], 0, (size_t)((i + 1 - self->h->len) * (int)sizeof(v)));
            self->h->len = i + 1;
        }
        __ct_elem_retain(&v);
        __ct_elem_release(&d[i]);
        d[i] = v;
    }

    /* Grows by doubling; 0 when the allocation fails, 1 on success. A failed
       header allocation aborts: a handle the caller cannot `release` must never
       leave this function (D31-21). */
    pub int push(T v)
    {
        T *d;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        if (self->h->len == self->h->cap) {
            int nc;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data, (size_t)(nc * (int)sizeof(v)));
            if (raw == 0) return 0;
            self->h->data = raw;
            self->h->cap = nc;
        }
        d = self->h->data;
        __ct_elem_retain(&v);
        d[self->h->len] = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* Empty answers a zero value. The returned copy carries the reference the
       container had on the slot, so the caller owns it after the pop. */
    pub T pop()
    {
        T z;
        T *d;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || self->h->len == 0) return z;
        self->h->len = self->h->len - 1;
        d = self->h->data;
        z = d[self->h->len];
        __ct_elem_retain(&z);
        __ct_elem_release(&d[self->h->len]);
        return z;
    }

    /* Drops the elements, keeps the buffer for reuse. */
    pub void clear()
    {
        int i;
        T *d;
        if (self->h == 0) return;
        d = self->h->data;
        for (i = 0; i < self->h->len; i++)
            __ct_elem_release(&d[i]);
        self->h->len = 0;
    }

    /* A second handle on the same buffer; both stay readable (D29-12). */
    pub Vec<T> retain()
    {
        Vec<T> r;
        r.h = self->h;
        if (r.h != 0) r.h->refs = r.h->refs + 1;
        return r;
    }

    /* Returns the remaining count. A released handle is cleared either way, so
       releasing it a second time aborts instead of decrementing the count a
       sibling handle still owns (D29-12, V29-2). */
    pub int release()
    {
        int left;
        int i;
        T *d;
        if (self->h == 0) {
            fprintf(stderr, "Vec: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            d = self->h->data;
            for (i = 0; i < self->h->len; i++)
                __ct_elem_release(&d[i]);
            free(self->h->data);
            free(self->h);
        }
        self->h = 0;
        return left < 0 ? 0 : left;
    }
}

/* P29-14 (V29-1): string keys get their own block. The generic block compares
   bytes, which is right for `int` and `long` but wrong for `char *` -- and a
   `sizeof(k) == sizeof(char *)` test cannot tell `long` from a pointer on LP64.
   Declaring this block first makes it own `put` / `get` / `remove` for
   `Map<char *, V>`; the generic block still supplies `len` / `entry` / `clear`
   / `retain` / `release`, and the emitter skips the shadowed names. */
impl<V> Map<char *, V> {
    /* 1 when overwritten, 1 when appended, 0 on allocation failure or a NULL
       key (a NULL key has no content to compare). */
    pub int put(char *k, V v)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (k == 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) {
                __ct_elem_retain(&v);
                __ct_elem_release(&es[i].value);
                es[i].value = v;
                return 1;
            }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<char *, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        __ct_elem_retain(&v);
        es[self->h->len].key = k;
        es[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* PH-62 S4: the slot pointer, creating the entry when the key is missing.
       A nested write (`m["a"]["b"] = 7`) needs a live inner handle, and an
       `at` chain must not hand the caller a NULL to deref; the reference
       count and the entry layout stay the ones `put` uses, and a zero value
       owns nothing, so no retain is needed on insert. A NULL key (no content
       to compare) or a failed growth answers 0, like `get` / `put`. */
    pub V *at(char *k)
    {
        int i;
        struct MapEntry<char *, V> *es;
        V z;
        if (k == 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) return &es[i].value;
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<char *, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        memset(&z, 0, sizeof(z));
        es[self->h->len].key = k;
        es[self->h->len].value = z;
        self->h->len = self->h->len + 1;
        return &es[self->h->len - 1].value;
    }

    pub V *get(char *k)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (self->h == 0 || k == 0) return 0;
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) return &es[i].value;
        return 0;
    }

    /* PH-50: key presence with the exact comparison `get` uses; the value is
       not copied and nothing is retained. A NULL key is absent, like `get`. */
    pub int has(char *k)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (self->h == 0 || k == 0) return 0;
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) return 1;
        return 0;
    }

    pub int remove(char *k)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (self->h == 0 || k == 0) return 0;
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) {
                int j;
                __ct_elem_release(&es[i].value);
                for (j = i; j + 1 < self->h->len; j++)
                    es[j] = es[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        return 0;
    }

    /* Phase 31 S13a: the brace-literal constructor for `Map<char *, V>`. The
       generic block below declares the same name for every key and the shadow
       rule keeps this copy for string keys, exactly like `put` / `get` /
       `remove` (P24). The loop reproduces `put` inline: a generic impl body
       cannot call its sibling methods (`self` is `void *` there, P15), so an
       inline copy is the only shape that works. Insertion order is the item
       order, and a repeated key overwrites in place (D29-11); an empty list
       still allocates the header so the handle can be released (D31-21). */
    pub static Map<char *, V> from(struct MapEntry<char *, V> *items, int n)
    {
        Map<char *, V> m;
        int i;
        m.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (m.h == 0) abort();
        m.h->refs = 1;
        m.h->len = 0;
        m.h->cap = 0;
        m.h->data = 0;
        for (i = 0; i < n && items != 0; i++) {
            struct MapEntry<char *, V> *e;
            char *k;
            int j, hit;
            k = items[i].key;
            if (k == 0) continue;
            e = (struct MapEntry<char *, V> *)m.h->data;
            hit = -1;
            for (j = 0; j < m.h->len; j++)
                if (strcmp(e[j].key, k) == 0) {
                    hit = j;
                    break;
                }
            if (hit >= 0) {
                V old;
                old = e[hit].value;
                __ct_elem_retain(&items[i].value);
                __ct_elem_release(&old);
                e[hit].value = items[i].value;
                continue;
            }
            if (m.h->len == m.h->cap) {
                int nc;
                void *raw;
                nc = m.h->cap == 0 ? 4 : m.h->cap * 2;
                raw = realloc(m.h->data, (size_t)(nc * (int)sizeof(e[0])));
                if (raw == 0) return m;
                m.h->data = raw;
                m.h->cap = nc;
                e = (struct MapEntry<char *, V> *)m.h->data;
            }
            __ct_elem_retain(&items[i].value);
            e[m.h->len] = items[i];
            m.h->len = m.h->len + 1;
        }
        return m;
    }
}

/* PH-47 (D47-3' / D47-6): the third key block. `Str` carries its length, so a
   key compares by `len` plus `memcmp` over exactly those bytes -- two keys that
   differ only after an embedded `\0` stay distinct, and the four padding bytes
   of the 16-byte struct are never read. `put` deep-copies the key through the
   `Str` API (`Str_retain` is `str_from_len(k.data, k.len)`), releasing the old
   copy on an overwrite, and `remove` / `clear` / `release` release each key
   exactly once. `entry` / `foreach` hand out a borrowed copy, never an owned
   one: releasing it would free the buffer the entry still owns (D47-6).
   Declared before the generic block so the shadow rule keeps this copy for
   `Map<Str, V>` exactly as the `char *` block above does for string keys. The
   compiler forward-declares `Str_retain` / `Str_release` before the instance
   bodies (compile mode has no header), so calling them here needs no local
   prototype. */
impl<V> Map<Str, V> {
    /* 1 when overwritten, 1 when appended, 0 on a released key or a failed
       copy. A key handle already in the released state (`len < 0`) carries no
       bytes to compare or copy. */
    pub int put(struct Str k, V v)
    {
        int i;
        struct MapEntry<struct Str, V> *es;
        struct Str nk;
        if (k.len < 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<struct Str, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (es[i].key.len == k.len
                && (k.len == 0
                    || memcmp(es[i].key.data, k.data, (size_t)k.len) == 0)) {
                /* Copy first, then release: `k` may be a borrowed copy of this
                   very entry (`m.put(m.entry(0).key, v)`), and the copy is the
                   only thing that keeps its bytes alive across the release. */
                nk = Str_retain(&k);
                if (nk.len < 0) return 0;
                __ct_elem_retain(&v);
                __ct_elem_release(&es[i].value);
                Str_release(&es[i].key);
                es[i].key = nk;
                es[i].value = v;
                return 1;
            }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<struct Str, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        nk = Str_retain(&k);
        if (nk.len < 0) return 0;
        __ct_elem_retain(&v);
        es[self->h->len].key = nk;
        es[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* NULL when absent; otherwise an interior pointer into the entries. */
    pub V *get(struct Str k)
    {
        int i;
        struct MapEntry<struct Str, V> *es;
        if (self->h == 0 || k.len < 0) return 0;
        es = (struct MapEntry<struct Str, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (es[i].key.len == k.len
                && (k.len == 0
                    || memcmp(es[i].key.data, k.data, (size_t)k.len) == 0))
                return &es[i].value;
        return 0;
    }

    /* PH-62 S4: the slot pointer, creating the entry when the key is missing.
       The inserted key is deep-copied through `Str_retain` exactly like `put`
       (a released key carries no bytes to compare or copy); the zero value
       owns nothing. A failed copy or growth answers 0, like `get` / `put`. */
    pub V *at(struct Str k)
    {
        int i;
        struct MapEntry<struct Str, V> *es;
        struct Str nk;
        V z;
        if (k.len < 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<struct Str, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (es[i].key.len == k.len
                && (k.len == 0
                    || memcmp(es[i].key.data, k.data, (size_t)k.len) == 0))
                return &es[i].value;
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<struct Str, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        nk = Str_retain(&k);
        if (nk.len < 0) return 0;
        memset(&z, 0, sizeof(z));
        es[self->h->len].key = nk;
        es[self->h->len].value = z;
        self->h->len = self->h->len + 1;
        return &es[self->h->len - 1].value;
    }

    /* PH-50: len + memcmp, the same comparison `get` uses, so an embedded NUL
       is data and never a terminator. The value is not copied. */
    pub int has(struct Str k)
    {
        int i;
        struct MapEntry<struct Str, V> *es;
        if (self->h == 0 || k.len < 0) return 0;
        es = (struct MapEntry<struct Str, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (es[i].key.len == k.len
                && (k.len == 0
                    || memcmp(es[i].key.data, k.data, (size_t)k.len) == 0))
                return 1;
        return 0;
    }

    /* 1 when the key was found and removed. The removed key and value are
       released once; the tail shift moves the surviving handles, which stay
       owned by their entries. */
    pub int remove(struct Str k)
    {
        int i;
        struct MapEntry<struct Str, V> *es;
        if (self->h == 0 || k.len < 0) return 0;
        es = (struct MapEntry<struct Str, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (es[i].key.len == k.len
                && (k.len == 0
                    || memcmp(es[i].key.data, k.data, (size_t)k.len) == 0)) {
                int j;
                __ct_elem_release(&es[i].value);
                Str_release(&es[i].key);
                for (j = i; j + 1 < self->h->len; j++)
                    es[j] = es[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        return 0;
    }

    /* The brace-literal constructor for `Map<Str, V>`. It reproduces `put`
       inline (a generic impl body cannot call a sibling method, P15) and
       deep-copies every key it keeps; a repeated key deep-copies once more and
       releases the entry's old copy, exactly like the overwrite branch above.
       The item's borrowed handle is never stored, so it is never released. */
    pub static Map<Str, V> from(struct MapEntry<struct Str, V> *items, int n)
    {
        Map<Str, V> m;
        int i;
        m.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (m.h == 0) abort();
        m.h->refs = 1;
        m.h->len = 0;
        m.h->cap = 0;
        m.h->data = 0;
        for (i = 0; i < n && items != 0; i++) {
            struct MapEntry<struct Str, V> *e;
            struct Str k;
            struct Str nk;
            int j, hit;
            k = items[i].key;
            if (k.len < 0) continue;
            e = (struct MapEntry<struct Str, V> *)m.h->data;
            hit = -1;
            for (j = 0; j < m.h->len; j++)
                if (e[j].key.len == k.len
                    && (k.len == 0
                        || memcmp(e[j].key.data, k.data, (size_t)k.len) == 0)) {
                    hit = j;
                    break;
                }
            if (hit >= 0) {
                V old;
                nk = Str_retain(&k);
                if (nk.len < 0) return m;
                old = e[hit].value;
                __ct_elem_retain(&items[i].value);
                __ct_elem_release(&old);
                Str_release(&e[hit].key);
                e[hit].key = nk;
                e[hit].value = items[i].value;
                continue;
            }
            if (m.h->len == m.h->cap) {
                int nc;
                void *raw;
                nc = m.h->cap == 0 ? 4 : m.h->cap * 2;
                raw = realloc(m.h->data, (size_t)(nc * (int)sizeof(e[0])));
                if (raw == 0) return m;
                m.h->data = raw;
                m.h->cap = nc;
                e = (struct MapEntry<struct Str, V> *)m.h->data;
            }
            nk = Str_retain(&k);
            if (nk.len < 0) return m;
            __ct_elem_retain(&items[i].value);
            e[m.h->len].key = nk;
            e[m.h->len].value = items[i].value;
            m.h->len = m.h->len + 1;
        }
        return m;
    }

    /* Drops every entry's value and key, one release each; the buffer itself
       stays for reuse, like the generic block. */
    pub void clear()
    {
        int i;
        struct MapEntry<struct Str, V> *es;
        if (self->h == 0) return;
        es = (struct MapEntry<struct Str, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            __ct_elem_release(&es[i].value);
            Str_release(&es[i].key);
        }
        self->h->len = 0;
    }

    /* Releases the caller's handle; when it is the last one, every entry
       releases its key and value exactly once. A second release on the same
       handle stays the hard error the generic block documents (D29-12). */
    pub int release()
    {
        int left;
        int i;
        struct MapEntry<struct Str, V> *es;
        if (self->h == 0) {
            fprintf(stderr, "Map: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            es = (struct MapEntry<struct Str, V> *)self->h->data;
            for (i = 0; i < self->h->len; i++) {
                __ct_elem_release(&es[i].value);
                Str_release(&es[i].key);
            }
            free(self->h->data);
            free(self->h);
        }
        self->h = 0;
        return left < 0 ? 0 : left;
    }
}

impl<K, V> Map<K, V> {
    pub int len()
    {
        if (self->h == 0) return 0;
        return self->h->len;
    }

    /* 1 when the key is present (and its value was overwritten), 1 when it was
       appended, 0 when the allocation failed. Keys are compared by their bytes,
       which is what the roster's integer types need; `char *` keys are served
       by the block above (V29-1). */
    pub int put(K k, V v)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0) {
                __ct_elem_retain(&v);
                __ct_elem_release(&es[i].value);
                es[i].value = v;
                return 1;
            }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<K, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        __ct_elem_retain(&v);
        es[self->h->len].key = k;
        es[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* NULL when absent; otherwise an interior pointer that stays valid until
       the next modification. */
    pub V *get(K k)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return 0;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0)
                return &es[i].value;
        return 0;
    }

    /* PH-62 S4: the slot pointer, creating the entry when the key is missing.
       Keys compare by their bytes, the same rule `put` / `get` use; the
       inserted zero value owns nothing, so no retain is needed. A failed
       growth answers 0, like `put`. */
    pub V *at(K k)
    {
        int i;
        struct MapEntry<K, V> *es;
        V z;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) abort();
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0)
                return &es[i].value;
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<K, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        memset(&z, 0, sizeof(z));
        es[self->h->len].key = k;
        es[self->h->len].value = z;
        self->h->len = self->h->len + 1;
        return &es[self->h->len - 1].value;
    }

    /* PH-50: key presence for the byte-compared integer keys. `char *` and
       `Str` are served by their earlier blocks, exactly like `get` (V29-1). */
    pub int has(K k)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return 0;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0)
                return 1;
        return 0;
    }

    /* 1 when the key was found and removed; the tail shifts left so the
       remaining entries keep their insertion order. */
    pub int remove(K k)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return 0;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0) {
                int j;
                __ct_elem_release(&es[i].value);
                for (j = i; j + 1 < self->h->len; j++)
                    es[j] = es[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        }
        return 0;
    }

    /* Phase 31 S13b: the brace-literal constructor for an integer key. The
       `impl<V> Map<char *, V>` block above declares the same name and serves
       string keys; this copy is kept for every other key (P24). The loop
       reproduces `put` inline because a generic impl body cannot call a sibling
       method (`self` is `void *` there, P15), and keys compare by bytes, which
       is the roster's integer-key rule (V29-1). Insertion order is the item
       order and a repeated key overwrites in place (D29-11); an empty list still
       allocates the header so the handle can be released (D31-21). */
    pub static Map<K, V> from(struct MapEntry<K, V> *items, int n)
    {
        Map<K, V> m;
        int i;
        m.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (m.h == 0) abort();
        m.h->refs = 1;
        m.h->len = 0;
        m.h->cap = 0;
        m.h->data = 0;
        for (i = 0; i < n && items != 0; i++) {
            struct MapEntry<K, V> *e;
            K k;
            int j, hit;
            k = items[i].key;
            e = (struct MapEntry<K, V> *)m.h->data;
            hit = -1;
            for (j = 0; j < m.h->len; j++)
                if (memcmp(&e[j].key, &k, sizeof(k)) == 0) {
                    hit = j;
                    break;
                }
            if (hit >= 0) {
                V old;
                old = e[hit].value;
                __ct_elem_retain(&items[i].value);
                __ct_elem_release(&old);
                e[hit].value = items[i].value;
                continue;
            }
            if (m.h->len == m.h->cap) {
                int nc;
                void *raw;
                nc = m.h->cap == 0 ? 4 : m.h->cap * 2;
                raw = realloc(m.h->data, (size_t)(nc * (int)sizeof(e[0])));
                if (raw == 0) return m;
                m.h->data = raw;
                m.h->cap = nc;
                e = (struct MapEntry<K, V> *)m.h->data;
            }
            __ct_elem_retain(&items[i].value);
            e[m.h->len] = items[i];
            m.h->len = m.h->len + 1;
        }
        return m;
    }

    pub void clear()
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            __ct_elem_release(&es[i].value);
        self->h->len = 0;
    }

    /* The i-th entry in insertion order; a zero entry when out of range. */
    pub MapEntry<K, V> entry(int i)
    {
        MapEntry<K, V> z;
        struct MapEntry<K, V> *es;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || i < 0 || i >= self->h->len) return z;
        es = (struct MapEntry<K, V> *)self->h->data;
        return es[i];
    }

    pub Map<K, V> retain()
    {
        Map<K, V> r;
        r.h = self->h;
        if (r.h != 0) r.h->refs = r.h->refs + 1;
        return r;
    }

    pub int release()
    {
        int left;
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) {
            fprintf(stderr, "Map: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            es = (struct MapEntry<K, V> *)self->h->data;
            for (i = 0; i < self->h->len; i++)
                __ct_elem_release(&es[i].value);
            free(self->h->data);
            free(self->h);
        }
        self->h = 0;
        return left < 0 ? 0 : left;
    }
}
