/*
 * Vec.h.ct - the built-in growable array `Vec<T>` and the insertion-ordered
 * `Map<K, V>` / `MapEntry<K, V>` pair (Phase 29).
 *
 * This unit is the whole built-in layer. `Vec` and `Map` share one private
 * buffer header, so they have to live in one unit: a header may not define the
 * same struct twice, and both headers would otherwise be included by the same
 * consumer. The file is named after its first `pub` type, which is the unit
 * naming rule every `.h.ct` follows.
 *
 * Both containers are ordinary generic structs: the compiler has no branch for
 * them (B29-3 / E29-12). Their methods live in `impl<...>` blocks, so they are
 * statically dispatched and never appear in a vtable.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Root namespace on purpose: the layer is pre-parsed, not imported, so `Vec` /
   `Map` have to be spelled exactly as the user writes them (D29-3). */

/* The buffer header shared by both containers: a reference count, the number of
   live elements, the allocated capacity and the element storage. The header
   owns the storage (H-A): a handle is only the `h` pointer, so copying a handle
   never duplicates a stale data pointer when a sibling grows the buffer.
   `release` frees the data and the header once the count reaches zero; a second
   release on the same handle is a hard error, not a silent no-op (D29-12). */
pub struct ct_buf {
    int refs;
    int len;
    int cap;
    void *data;
}

pub struct Vec<T> {
    struct ct_buf *h;
}

/* `Map` stores its entries in insertion order and answers lookups by scanning
   them: a compact array of `MapEntry` values with no auxiliary index. Insertion
   order is therefore the array order, `remove` keeps it by shifting the tail
   left, and `put` on an existing key rewrites the value in place. A key is
   compared by content: `int` keys by their bytes, `char *` keys by `strcmp`
   (the two cases are told apart by the argument width, see §2.3/D29-11). */
pub struct MapEntry<K, V> {
    K key;
    V value;
}

pub struct Map<K, V> {
    struct ct_buf *h;
}

impl<T> Vec<T> {
    /* P29-3: the constructor the range lowering calls. The compiler builds the
       composite literal and passes its length, so this is the only place that
       knows how a `Vec` is laid out (B29-3). `items` NULL or `n <= 0` answers an
       empty handle; a failed allocation answers the same, so the caller always
       owns a handle it may `release()`. */
    static Vec<T> from(T *items, int n)
    {
        Vec<T> v;
        void *raw;
        T *nd;
        int i;
        v.h = 0;
        if (items == 0 || n <= 0) return v;
        v.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (v.h == 0) return v;
        raw = malloc((size_t)(n * (int)sizeof(items[0])));
        if (raw == 0) {
            free(v.h);
            v.h = 0;
            return v;
        }
        nd = raw;
        v.h->data = nd;
        memcpy(v.h->data, items, (size_t)(n * (int)sizeof(items[0])));
        for (i = 0; i < n; i++)
            __ct_elem_retain(&nd[i]);
        v.h->refs = 1;
        v.h->len = n;
        v.h->cap = n;
        return v;
    }

    int len()
    {
        if (self->h == 0) return 0;
        return self->h->len;
    }

    /* Out of range answers a zero value, never a read past the buffer. */
    T get(int i)
    {
        T z;
        T *d;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || i < 0 || i >= self->h->len) return z;
        d = self->h->data;
        return d[i];
    }

    /* Out of range is a no-op. The new value is retained before the old slot is
       released, so `v.set(i, v.get(i))` stays safe when the slot is the only
       owner. */
    void set(int i, T v)
    {
        T *d;
        if (self->h == 0 || i < 0 || i >= self->h->len) return;
        d = self->h->data;
        __ct_elem_retain(&v);
        __ct_elem_release(&d[i]);
        d[i] = v;
    }

    /* Grows by doubling; 0 when the allocation fails, 1 on success. */
    int push(T v)
    {
        T *d;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) return 0;
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        if (self->h->len == self->h->cap) {
            int nc;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data, (size_t)(nc * (int)sizeof(v)));
            if (raw == 0) return 0;
            self->h->data = raw;
            self->h->cap = nc;
        }
        d = self->h->data;
        __ct_elem_retain(&v);
        d[self->h->len] = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* Empty answers a zero value. The returned copy carries the reference the
       container had on the slot, so the caller owns it after the pop. */
    T pop()
    {
        T z;
        T *d;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || self->h->len == 0) return z;
        self->h->len = self->h->len - 1;
        d = self->h->data;
        z = d[self->h->len];
        __ct_elem_retain(&z);
        __ct_elem_release(&d[self->h->len]);
        return z;
    }

    /* Drops the elements, keeps the buffer for reuse. */
    void clear()
    {
        int i;
        T *d;
        if (self->h == 0) return;
        d = self->h->data;
        for (i = 0; i < self->h->len; i++)
            __ct_elem_release(&d[i]);
        self->h->len = 0;
    }

    /* A second handle on the same buffer; both stay readable (D29-12). */
    Vec<T> retain()
    {
        Vec<T> r;
        r.h = self->h;
        if (r.h != 0) r.h->refs = r.h->refs + 1;
        return r;
    }

    /* Returns the remaining count. A released handle is cleared either way, so
       releasing it a second time aborts instead of decrementing the count a
       sibling handle still owns (D29-12, V29-2). */
    int release()
    {
        int left;
        int i;
        T *d;
        if (self->h == 0) {
            fprintf(stderr, "Vec: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            d = self->h->data;
            for (i = 0; i < self->h->len; i++)
                __ct_elem_release(&d[i]);
            free(self->h->data);
            free(self->h);
        }
        self->h = 0;
        return left < 0 ? 0 : left;
    }
}

/* P29-14 (V29-1): string keys get their own block. The generic block compares
   bytes, which is right for `int` and `long` but wrong for `char *` -- and a
   `sizeof(k) == sizeof(char *)` test cannot tell `long` from a pointer on LP64.
   Declaring this block first makes it own `put` / `get` / `remove` for
   `Map<char *, V>`; the generic block still supplies `len` / `entry` / `clear`
   / `retain` / `release`, and the emitter skips the shadowed names. */
impl<V> Map<char *, V> {
    /* 1 when overwritten, 1 when appended, 0 on allocation failure or a NULL
       key (a NULL key has no content to compare). */
    int put(char *k, V v)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (k == 0) return 0;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) return 0;
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) {
                __ct_elem_retain(&v);
                __ct_elem_release(&es[i].value);
                es[i].value = v;
                return 1;
            }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<char *, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        __ct_elem_retain(&v);
        es[self->h->len].key = k;
        es[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    V *get(char *k)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (self->h == 0 || k == 0) return 0;
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) return &es[i].value;
        return 0;
    }

    int remove(char *k)
    {
        int i;
        struct MapEntry<char *, V> *es;
        if (self->h == 0 || k == 0) return 0;
        es = (struct MapEntry<char *, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (strcmp(es[i].key, k) == 0) {
                int j;
                __ct_elem_release(&es[i].value);
                for (j = i; j + 1 < self->h->len; j++)
                    es[j] = es[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        return 0;
    }

    /* Phase 31 S13a: the brace-literal constructor for `Map<char *, V>`. The
       generic block below declares the same name for every key and the shadow
       rule keeps this copy for string keys, exactly like `put` / `get` /
       `remove` (P24). The loop reproduces `put` inline: a generic impl body
       cannot call its sibling methods (`self` is `void *` there, P15), so an
       inline copy is the only shape that works. Insertion order is the item
       order, and a repeated key overwrites in place (D29-11); an empty list
       still allocates the header so the handle can be released (D31-21). */
    static Map<char *, V> from(struct MapEntry<char *, V> *items, int n)
    {
        Map<char *, V> m;
        int i;
        m.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (m.h == 0) return m;
        m.h->refs = 1;
        m.h->len = 0;
        m.h->cap = 0;
        m.h->data = 0;
        for (i = 0; i < n && items != 0; i++) {
            struct MapEntry<char *, V> *e;
            char *k;
            int j, hit;
            k = items[i].key;
            if (k == 0) continue;
            e = (struct MapEntry<char *, V> *)m.h->data;
            hit = -1;
            for (j = 0; j < m.h->len; j++)
                if (strcmp(e[j].key, k) == 0) {
                    hit = j;
                    break;
                }
            if (hit >= 0) {
                V old;
                old = e[hit].value;
                __ct_elem_retain(&items[i].value);
                __ct_elem_release(&old);
                e[hit].value = items[i].value;
                continue;
            }
            if (m.h->len == m.h->cap) {
                int nc;
                void *raw;
                nc = m.h->cap == 0 ? 4 : m.h->cap * 2;
                raw = realloc(m.h->data, (size_t)(nc * (int)sizeof(e[0])));
                if (raw == 0) return m;
                m.h->data = raw;
                m.h->cap = nc;
                e = (struct MapEntry<char *, V> *)m.h->data;
            }
            __ct_elem_retain(&items[i].value);
            e[m.h->len] = items[i];
            m.h->len = m.h->len + 1;
        }
        return m;
    }
}

impl<K, V> Map<K, V> {
    int len()
    {
        if (self->h == 0) return 0;
        return self->h->len;
    }

    /* 1 when the key is present (and its value was overwritten), 1 when it was
       appended, 0 when the allocation failed. Keys are compared by their bytes,
       which is what the roster's integer types need; `char *` keys are served
       by the block above (V29-1). */
    int put(K k, V v)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) {
            self->h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
            if (self->h == 0) return 0;
            self->h->refs = 1;
            self->h->len = 0;
            self->h->cap = 0;
            self->h->data = 0;
        }
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0) {
                __ct_elem_retain(&v);
                __ct_elem_release(&es[i].value);
                es[i].value = v;
                return 1;
            }
        if (self->h->len == self->h->cap) {
            int nc;
            struct MapEntry<K, V> *ne;
            void *raw;
            nc = self->h->cap == 0 ? 4 : self->h->cap * 2;
            raw = realloc(self->h->data,
                    (size_t)(nc * (int)sizeof(ne[0])));
            if (raw == 0) return 0;
            ne = raw;
            self->h->data = ne;
            self->h->cap = nc;
            es = ne;
        }
        __ct_elem_retain(&v);
        es[self->h->len].key = k;
        es[self->h->len].value = v;
        self->h->len = self->h->len + 1;
        return 1;
    }

    /* NULL when absent; otherwise an interior pointer that stays valid until
       the next modification. */
    V *get(K k)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return 0;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0)
                return &es[i].value;
        return 0;
    }

    /* 1 when the key was found and removed; the tail shifts left so the
       remaining entries keep their insertion order. */
    int remove(K k)
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return 0;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++) {
            if (memcmp(&es[i].key, &k, sizeof(k)) == 0) {
                int j;
                __ct_elem_release(&es[i].value);
                for (j = i; j + 1 < self->h->len; j++)
                    es[j] = es[j + 1];
                self->h->len = self->h->len - 1;
                return 1;
            }
        }
        return 0;
    }

    /* Phase 31 S13b: the brace-literal constructor for an integer key. The
       `impl<V> Map<char *, V>` block above declares the same name and serves
       string keys; this copy is kept for every other key (P24). The loop
       reproduces `put` inline because a generic impl body cannot call a sibling
       method (`self` is `void *` there, P15), and keys compare by bytes, which
       is the roster's integer-key rule (V29-1). Insertion order is the item
       order and a repeated key overwrites in place (D29-11); an empty list still
       allocates the header so the handle can be released (D31-21). */
    static Map<K, V> from(struct MapEntry<K, V> *items, int n)
    {
        Map<K, V> m;
        int i;
        m.h = (struct ct_buf *)malloc(sizeof(struct ct_buf));
        if (m.h == 0) return m;
        m.h->refs = 1;
        m.h->len = 0;
        m.h->cap = 0;
        m.h->data = 0;
        for (i = 0; i < n && items != 0; i++) {
            struct MapEntry<K, V> *e;
            K k;
            int j, hit;
            k = items[i].key;
            e = (struct MapEntry<K, V> *)m.h->data;
            hit = -1;
            for (j = 0; j < m.h->len; j++)
                if (memcmp(&e[j].key, &k, sizeof(k)) == 0) {
                    hit = j;
                    break;
                }
            if (hit >= 0) {
                V old;
                old = e[hit].value;
                __ct_elem_retain(&items[i].value);
                __ct_elem_release(&old);
                e[hit].value = items[i].value;
                continue;
            }
            if (m.h->len == m.h->cap) {
                int nc;
                void *raw;
                nc = m.h->cap == 0 ? 4 : m.h->cap * 2;
                raw = realloc(m.h->data, (size_t)(nc * (int)sizeof(e[0])));
                if (raw == 0) return m;
                m.h->data = raw;
                m.h->cap = nc;
                e = (struct MapEntry<K, V> *)m.h->data;
            }
            __ct_elem_retain(&items[i].value);
            e[m.h->len] = items[i];
            m.h->len = m.h->len + 1;
        }
        return m;
    }

    void clear()
    {
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) return;
        es = (struct MapEntry<K, V> *)self->h->data;
        for (i = 0; i < self->h->len; i++)
            __ct_elem_release(&es[i].value);
        self->h->len = 0;
    }

    /* The i-th entry in insertion order; a zero entry when out of range. */
    MapEntry<K, V> entry(int i)
    {
        MapEntry<K, V> z;
        struct MapEntry<K, V> *es;
        memset(&z, 0, sizeof(z));
        if (self->h == 0 || i < 0 || i >= self->h->len) return z;
        es = (struct MapEntry<K, V> *)self->h->data;
        return es[i];
    }

    Map<K, V> retain()
    {
        Map<K, V> r;
        r.h = self->h;
        if (r.h != 0) r.h->refs = r.h->refs + 1;
        return r;
    }

    int release()
    {
        int left;
        int i;
        struct MapEntry<K, V> *es;
        if (self->h == 0) {
            fprintf(stderr, "Map: release on a released handle\n");
            abort();
        }
        self->h->refs = self->h->refs - 1;
        left = self->h->refs;
        if (left <= 0) {
            es = (struct MapEntry<K, V> *)self->h->data;
            for (i = 0; i < self->h->len; i++)
                __ct_elem_release(&es[i].value);
            free(self->h->data);
            free(self->h);
        }
        self->h = 0;
        return left < 0 ? 0 : left;
    }
}
