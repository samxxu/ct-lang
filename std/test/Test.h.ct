/*
 * Test.h.ct - a tiny assertion counter (std::test).
 *
 * Assertion macros cannot cross a unit boundary, so this module exposes
 * functions instead: `check_true` / `check_eq_int` / `check_eq_str` count a
 * check and report a failure on stderr, and `report` returns the exit status
 * the caller should use. `test/std/run.sh` and user self-tests share it.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>

namespace std::test;

pub struct Test {
    int checks;
    int failures;
}

pub void init(Test *t);
void init(Test *t)
{
    if (!t) return;
    t->checks = 0;
    t->failures = 0;
}

/* Count one check; on failure print `FAIL: msg` and count it. */
pub int check_true(Test *t, int cond, const char *msg);
int check_true(Test *t, int cond, const char *msg)
{
    if (!t) return 0;
    t->checks++;
    if (!cond) {
        t->failures++;
        fprintf(stderr, "FAIL: %s\n", msg ? msg : "(no message)");
        return 0;
    }
    return 1;
}

pub int check_eq_int(Test *t, int got, int want, const char *msg);
int check_eq_int(Test *t, int got, int want, const char *msg)
{
    if (!t) return 0;
    t->checks++;
    if (got != want) {
        t->failures++;
        fprintf(stderr, "FAIL: %s (got %d, want %d)\n",
                msg ? msg : "(no message)", got, want);
        return 0;
    }
    return 1;
}

pub int check_eq_str(Test *t, const char *got, const char *want, const char *msg);
int check_eq_str(Test *t, const char *got, const char *want, const char *msg)
{
    if (!t) return 0;
    t->checks++;
    if (!got) got = "";
    if (!want) want = "";
    if (strcmp(got, want) != 0) {
        t->failures++;
        fprintf(stderr, "FAIL: %s (got '%s', want '%s')\n",
                msg ? msg : "(no message)", got, want);
        return 0;
    }
    return 1;
}

/* Print the summary; return 0 when every check passed, 1 otherwise. */
pub int report(Test *t);
int report(Test *t)
{
    if (!t) return 1;
    printf("%d checks, %d failures\n", t->checks, t->failures);
    if (t->failures == 0) return 0;
    return 1;
}
