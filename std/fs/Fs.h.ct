/*
 * Fs.h.ct - a thin file-system wrapper (std::fs).
 *
 * `stdio` and `dirent` are the only substrates; this unit adds bounded
 * semantics, not a new interface: `read_file` refuses a file that does not fit
 * the caller's buffer instead of truncating it, and `list` fails when the
 * joined listing does not fit, so a caller never sees a partial answer and
 * believes it is complete.
 *
 * License: same as the rest of the compiler (see LICENSE / LICENSE.EXCEPTION).
 */
#include <stdio.h>
#include <string.h>
#include <dirent.h>
#include <sys/stat.h>

namespace std::fs;

/* Stateless marker type; nothing instantiates it. */
pub struct Fs {
    int unused;
}

/* 1 when `path` names something `stat` can see, 0 otherwise. */
pub int exists(const char *path);
int exists(const char *path)
{
    struct stat st;

    if (!path || !*path) return 0;
    return stat(path, &st) == 0;
}

/* Read the whole file into `out`. Returns the byte count, or -1 when the file
   cannot be opened or does not fit `cap` (including the terminating NUL). */
pub int read_file(const char *path, char *out, int cap);
int read_file(const char *path, char *out, int cap)
{
    FILE *f;
    int c;
    int n;

    if (!path || !out || cap <= 0) return -1;
    f = fopen(path, "rb");
    if (!f) return -1;
    n = 0;
    for (;;) {
        c = fgetc(f);
        if (c == EOF) break;
        if (n + 1 >= cap) {
            fclose(f);
            return -1;
        }
        out[n] = (char)c;
        n++;
    }
    out[n] = 0;
    fclose(f);
    return n;
}

/* Replace or create `path` with `data`; 0 on success, -1 on failure. */
pub int write_file(const char *path, const char *data);
int write_file(const char *path, const char *data)
{
    FILE *f;

    if (!path || !data) return -1;
    f = fopen(path, "wb");
    if (!f) return -1;
    if (fwrite(data, 1, strlen(data), f) != strlen(data)) {
        fclose(f);
        return -1;
    }
    if (fclose(f) != 0) return -1;
    return 0;
}

/* Join the entries of `dir` with '\n' into `out` (no trailing newline) and
   return the entry count, or -1 when `dir` cannot be opened or the listing
   does not fit `cap`. `.` and `..` are skipped. */
pub int list(const char *dir, char *out, int cap);
int list(const char *dir, char *out, int cap)
{
    DIR *d;
    struct dirent *e;
    int n;
    int count;
    int len;
    int i;

    if (!dir || !out || cap <= 0) return -1;
    d = opendir(dir);
    if (!d) return -1;
    n = 0;
    count = 0;
    while ((e = readdir(d)) != 0) {
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
        len = (int)strlen(e->d_name);
        if (n + len + 2 > cap) {
            closedir(d);
            return -1;
        }
        if (n > 0) {
            out[n] = '\n';
            n++;
        }
        for (i = 0; i < len; i++) {
            out[n] = e->d_name[i];
            n++;
        }
        count++;
    }
    out[n] = 0;
    closedir(d);
    return count;
}
