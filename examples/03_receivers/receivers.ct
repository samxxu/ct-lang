// receivers.ct — general receivers end to end (Phase 1.9a): a variable-subscript
// element, a pointer-array element and a pointer field chain all dispatch.
//
// The point of the file is where a receiver may live, not how a `Person` is
// built, so the two shapes are made by `person()` and `box()` instead of by
// field-by-field assembly in `main`.
// License: MIT; see LICENSE.EXCEPTION
#include <stdio.h>

trait Greeter {
    void greet();
}

struct Person {
    char *name;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("hello %s\n", self->name);
    }
}

struct Box {
    Person *who;
};

static Person person(char *name) {
    Person p = { .name = name };
    return p;
}

static struct Box box(Person *who) {
    struct Box b = { .who = who };
    return b;
}

int main() {
    Person ps[2];
    ps[0] = person("Ann");
    ps[1] = person("Bob");
    int i = 1;
    ps[i].greet();

    Person p = person("Cid");
    Person *slots[1];
    slots[0] = &p;
    slots[0]->greet();

    struct Box b = box(&p);
    b.who->greet();
    return 0;
}
