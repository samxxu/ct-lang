#include <stdio.h>

trait Node {
    void show();
}

struct Lit {
    int v;
} use Node;

struct Add {
    Node lhs;        // interface-value fields: children are boxed fat pointers
    Node rhs;
} use Node;

// A pointer-to-interface field. `Node` is already the box (the fat pointer);
// the field only stores its address, so assigning the field does not box again.
struct Wrap {
    Node *node;
};

impl Node for Lit {
    void show() {
        printf("%d", self->v);
    }
}

impl Node for Add {
    void show() {
        printf("(");
        self->lhs.show();
        printf(" + ");
        self->rhs.show();
        printf(")");
    }
}

int main(void) {
    Lit one = { .v = 1 };
    Lit two = { .v = 2 };
    Lit three = { .v = 3 };

    Add sum;                 // interface fields start empty
    sum.lhs = one;           // a statement assignment boxes into the fat pointer
    sum.rhs = two;

    Add outer;
    outer.lhs = three;
    outer.rhs = sum;         // a node boxes another node: (3 + (1 + 2))

    outer.show();
    printf("\n");

    // Value field vs pointer field, side by side:
    //   - `outer.rhs = sum` boxes a value into the fat pointer (a new interface
    //     value is built in the field);
    //   - `w.node = &held` stores the address of an interface value that already
    //     exists, so there is no second box.
    Node held;
    Wrap w;
    held = sum;
    w.node = &held;
    w.node->show();
    printf("\n");
    return 0;
}
