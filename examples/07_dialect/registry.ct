// registry.ct — dialect demo: a register map written into comments
//
// Every line inside the block below is a comment, so `ctc` on its own cannot
// see what those lines describe: the trait, the register structs and their impls
// do not exist until an expander generates them. `ctc` stays dialect-unaware —
// it only ever receives plain CT.
//
// The plugins that own these dialects live in the conventional `ct-dialects/`
// directory, named after each dialect (`register/map` -> `register-map.sh`,
// `fsm/state` -> `fsm-state.sh`), and may be written in any language. Expand
// and compile with:
//
//     sh ct-dialects/register-map.sh registry.ct > registry.gen.ct
//     sh ct-dialects/fsm-state.sh registry.gen.ct > registry.gen2.ct
//     ../../ctc registry.gen2.ct -o registry.gen.c
//
// Only the dialect comment block is committed (the "lazy" mode of
// docs/design/dialect.md §3); the generated region is materialised at build
// time and never checked in. `test/run.sh`'s `dialect` layer drives this demo.
//
// License: MIT; see LICENSE.EXCEPTION (free to copy into your own project)
//@ct-dialect: register/map
//@ register CTRL   0x00 rw
//@ register STATUS 0x04 ro

// A second dialect in the same file: each plugin owns its own block and passes
// the other one through untouched, so the drivers apply them in sequence.
//@ct-dialect: fsm/state
//@ state IDLE go RUN
//@ state RUN stop IDLE

#include <stdio.h>

int main(void)
{
    CTRL ctrl = { .off = REG_CTRL_OFF };
    STATUS status = { .off = REG_STATUS_OFF };

    ctrl.write(0x81);
    printf("ctrl   @%d = %d\n", ctrl.off, ctrl.read());

    /* STATUS is read-only: its generated write() refuses and counts the attempt */
    status.write(0xFF);
    printf("status @%d = %d (%d write(s) refused)\n",
           status.off, status.read(), status.denied);

    /* The second dialect generated constants and a transition function */
    int state = FSM_IDLE;
    state = fsm_step(state, FSM_EV_GO);
    printf("fsm after go: %d\n", state);
    state = fsm_step(state, FSM_EV_STOP);
    printf("fsm after stop: %d\n", state);

    return 0;
}
