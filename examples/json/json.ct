//@ct-requires: ct-ast
/*
 * json.ct -- a JSON reader/writer written in plain CT.
 *
 * The reader is a zero-allocation read-only view: `parse` validates the whole
 * document once (and remembers where the first error is), but never builds a
 * tree. A `JsonView` is just a byte range inside the caller's text; `member`,
 * `at`, `count` and the `as_*` accessors re-scan that range on demand. Nothing
 * is allocated, nothing is owned, and the text may be a read-only literal.
 *
 * The writer is the mirror image: `JsonOut` appends into a caller-provided
 * buffer (cap = 0 measures the length), keeps its nesting stack in a fixed
 * field, and never allocates either.
 *
 * Limits are stated where they live: nesting depth (64 by default), byte-based
 * error columns, and double precision (see README.md).
 *
 * Reading is dispatched per kind through `trait JsonValue`. Each kind is a
 * stateless ops object (`JsonObjectOps`, `JsonArrayOps`, ...) with one global
 * instance; a `JsonValue` value is just a borrowed {ops, vtable} pair, so
 * handing one out never points at a stack frame. `JsonDoc`'s accessors keep
 * their signatures and delegate to the ops object for the view's kind.
 *
 * `loop` is used for the decimal exponent scaling in `JsonNumberOps.as_double`
 * (Phase 22); everything else stays within what L0 also accepts, and the file
 * still needs ct-ast because of that one loop.
 */
#include <stdio.h>
#include <string.h>
#include <float.h>

/* value kinds reported by kind(); MISSING is not a JSON kind */
#define JSON_MISSING 0
#define JSON_OBJECT 1
#define JSON_ARRAY 2
#define JSON_STRING 3
#define JSON_NUMBER 4
#define JSON_TRUE 5
#define JSON_FALSE 6
#define JSON_NULL 7

/* parse errors, sticky in the document and reported by error() */
#define JSON_OK 0
#define JSON_ERR_EOF 1
#define JSON_ERR_CHAR 2
#define JSON_ERR_LITERAL 3
#define JSON_ERR_TRAILING 4
#define JSON_ERR_STRING 5
#define JSON_ERR_ESCAPE 6
#define JSON_ERR_UNICODE 7
#define JSON_ERR_SURROGATE 8
#define JSON_ERR_NUMBER 9
#define JSON_ERR_DEPTH 10

/* accessor errors, reset on every accessor call and reported by read_error() */
#define JSON_READ_NONE 0
#define JSON_READ_KIND 1
#define JSON_READ_MISSING 2
#define JSON_READ_RANGE 3
#define JSON_READ_INTEGER 4

/* writer errors, sticky in the writer and reported by error() */
#define JSON_EMIT_NONE 0
#define JSON_EMIT_STATE 1
#define JSON_EMIT_DEPTH 2
#define JSON_EMIT_FINITE 3

#define JSON_DEPTH_DEFAULT 64
#define JSON_OUT_DEPTH 64

struct JsonView;
struct JsonOut;

/* ---------------------------------------------------------------- writer */

trait JsonWrite {
    int begin(char *buf, int cap);
    int object();
    int array();
    int end();
    int key(const char *name);
    int string(const char *text);
    int integer(long long value);
    int real(double value);
    int boolean(int value);
    int null();
    int finish();
    int length();
    int error();
}

struct JsonOut {
    char *buf;
    int cap;
    int len;
    int err;
    int depth;
    int root_done;
    unsigned char in_object[JSON_OUT_DEPTH];
    unsigned char state[JSON_OUT_DEPTH];
} use JsonWrite;

/* ---------------------------------------------------------------- reader */

trait Json {
    int parse(const char *text, int len);
    int error();
    int error_offset();
    int error_line();
    int error_column();
    struct JsonView root();
    int kind(struct JsonView *v);
    int count(struct JsonView *v);
    struct JsonView member(struct JsonView *v, const char *key);
    struct JsonView at(struct JsonView *v, int index);
    int as_int(struct JsonView *v, long long *out);
    int as_double(struct JsonView *v, double *out);
    int as_bool(struct JsonView *v, int *out);
    int as_string(struct JsonView *v, char *buf, int cap);
    int offset_of(struct JsonView *v);
    int len_of(struct JsonView *v);
    int read_error();
    int emit(struct JsonView *v, struct JsonOut *out);
}

struct JsonDoc {
    const char *src;
    int len;
    int err;
    int off;
    int depth_limit;
    int root_start;
    int root_len;
    int read_err;
} use Json;

/* a view is a byte range in doc->src: no kind, no pointers, no ownership */
struct JsonView {
    int start;
    int len;
};

/* ------------------------------------------------------------ scan core */

static int jv_is_ws(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

static int jv_skip_ws(const char *s, int n, int i) {
    while (i < n && jv_is_ws(s[i])) {
        i++;
    }
    return i;
}

static int jv_fail(int *code, int *off, int c, int o) {
    *code = c;
    *off = o;
    return -1;
}

static int jv_hex(char c) {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return c - 'A' + 10;
    }
    return -1;
}

/* four hex digits starting at i; -1 with *bad at the first non-hex byte */
static int jv_hex4(const char *s, int i, int *bad) {
    int k;
    int v;
    int d;
    v = 0;
    for (k = 0; k < 4; k++) {
        d = jv_hex(s[i + k]);
        if (d < 0) {
            *bad = i + k;
            return -1;
        }
        v = v * 16 + d;
    }
    return v;
}

/* s[i] is '"'; returns the offset just past the closing quote */
static int jv_scan_string(const char *s, int n, int i, int *code, int *off) {
    i++;
    while (1) {
        unsigned char c;
        int bad;
        int cp;
        if (i >= n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        c = (unsigned char)s[i];
        if (c == '"') {
            return i + 1;
        }
        if (c < 0x20) {
            return jv_fail(code, off, JSON_ERR_STRING, i);
        }
        if (c != '\\') {
            i++;
            continue;
        }
        if (i + 1 >= n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        c = (unsigned char)s[i + 1];
        if (c == '"' || c == '\\' || c == '/' || c == 'b' || c == 'f'
                || c == 'n' || c == 'r' || c == 't') {
            i += 2;
            continue;
        }
        if (c != 'u') {
            return jv_fail(code, off, JSON_ERR_ESCAPE, i + 1);
        }
        if (i + 6 > n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        cp = jv_hex4(s, i + 2, &bad);
        if (cp < 0) {
            return jv_fail(code, off, JSON_ERR_UNICODE, bad);
        }
        if (cp >= 0xD800 && cp <= 0xDBFF) {
            int lo;
            if (i + 6 >= n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            if (s[i + 6] != '\\') {
                return jv_fail(code, off, JSON_ERR_SURROGATE, i + 6);
            }
            if (i + 7 >= n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            if (s[i + 7] != 'u') {
                return jv_fail(code, off, JSON_ERR_SURROGATE, i + 7);
            }
            if (i + 12 > n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            lo = jv_hex4(s, i + 8, &bad);
            if (lo < 0) {
                return jv_fail(code, off, JSON_ERR_UNICODE, bad);
            }
            if (lo < 0xDC00 || lo > 0xDFFF) {
                return jv_fail(code, off, JSON_ERR_SURROGATE, i + 8);
            }
            i += 12;
            continue;
        }
        if (cp >= 0xDC00 && cp <= 0xDFFF) {
            return jv_fail(code, off, JSON_ERR_SURROGATE, i + 2);
        }
        i += 6;
    }
}

/* strict RFC 8259 number: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE][+-]?[0-9]+)? */
static int jv_scan_number(const char *s, int n, int i, int *code, int *off) {
    if (i < n && s[i] == '-') {
        i++;
    }
    if (i >= n) {
        return jv_fail(code, off, JSON_ERR_EOF, n);
    }
    if (s[i] == '0') {
        i++;
        if (i < n && s[i] >= '0' && s[i] <= '9') {
            return jv_fail(code, off, JSON_ERR_NUMBER, i);
        }
    } else if (s[i] >= '1' && s[i] <= '9') {
        while (i < n && s[i] >= '0' && s[i] <= '9') {
            i++;
        }
    } else {
        return jv_fail(code, off, JSON_ERR_NUMBER, i);
    }
    if (i < n && s[i] == '.') {
        i++;
        if (i >= n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        if (s[i] < '0' || s[i] > '9') {
            return jv_fail(code, off, JSON_ERR_NUMBER, i);
        }
        while (i < n && s[i] >= '0' && s[i] <= '9') {
            i++;
        }
    }
    if (i < n && (s[i] == 'e' || s[i] == 'E')) {
        i++;
        if (i < n && (s[i] == '+' || s[i] == '-')) {
            i++;
        }
        if (i >= n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        if (s[i] < '0' || s[i] > '9') {
            return jv_fail(code, off, JSON_ERR_NUMBER, i);
        }
        while (i < n && s[i] >= '0' && s[i] <= '9') {
            i++;
        }
    }
    return i;
}

/* returns the offset just past one value, or -1 with the error recorded */
static int jv_scan_value(const char *s, int n, int i, int depth, int dmax,
        int *code, int *off) {
    i = jv_skip_ws(s, n, i);
    if (i >= n) {
        return jv_fail(code, off, JSON_ERR_EOF, n);
    }
    if (s[i] == '{') {
        if (depth > dmax) {
            return jv_fail(code, off, JSON_ERR_DEPTH, i);
        }
        i = jv_skip_ws(s, n, i + 1);
        if (i < n && s[i] == '}') {
            return i + 1;
        }
        while (1) {
            int key_end;
            i = jv_skip_ws(s, n, i);
            if (i >= n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            if (s[i] != '"') {
                return jv_fail(code, off, JSON_ERR_CHAR, i);
            }
            key_end = jv_scan_string(s, n, i, code, off);
            if (key_end < 0) {
                return -1;
            }
            i = jv_skip_ws(s, n, key_end);
            if (i >= n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            if (s[i] != ':') {
                return jv_fail(code, off, JSON_ERR_CHAR, i);
            }
            i = jv_scan_value(s, n, i + 1, depth + 1, dmax, code, off);
            if (i < 0) {
                return -1;
            }
            i = jv_skip_ws(s, n, i);
            if (i >= n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            if (s[i] == ',') {
                i++;
                continue;
            }
            if (s[i] == '}') {
                return i + 1;
            }
            return jv_fail(code, off, JSON_ERR_CHAR, i);
        }
    }
    if (s[i] == '[') {
        if (depth > dmax) {
            return jv_fail(code, off, JSON_ERR_DEPTH, i);
        }
        i = jv_skip_ws(s, n, i + 1);
        if (i < n && s[i] == ']') {
            return i + 1;
        }
        while (1) {
            i = jv_scan_value(s, n, i, depth + 1, dmax, code, off);
            if (i < 0) {
                return -1;
            }
            i = jv_skip_ws(s, n, i);
            if (i >= n) {
                return jv_fail(code, off, JSON_ERR_EOF, n);
            }
            if (s[i] == ',') {
                i++;
                continue;
            }
            if (s[i] == ']') {
                return i + 1;
            }
            return jv_fail(code, off, JSON_ERR_CHAR, i);
        }
    }
    if (s[i] == '"') {
        return jv_scan_string(s, n, i, code, off);
    }
    if (s[i] == 't') {
        if (i + 4 > n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        if (s[i + 1] == 'r' && s[i + 2] == 'u' && s[i + 3] == 'e') {
            return i + 4;
        }
        return jv_fail(code, off, JSON_ERR_LITERAL, i);
    }
    if (s[i] == 'f') {
        if (i + 5 > n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        if (s[i + 1] == 'a' && s[i + 2] == 'l' && s[i + 3] == 's'
                && s[i + 4] == 'e') {
            return i + 5;
        }
        return jv_fail(code, off, JSON_ERR_LITERAL, i);
    }
    if (s[i] == 'n') {
        if (i + 4 > n) {
            return jv_fail(code, off, JSON_ERR_EOF, n);
        }
        if (s[i + 1] == 'u' && s[i + 2] == 'l' && s[i + 3] == 'l') {
            return i + 4;
        }
        return jv_fail(code, off, JSON_ERR_LITERAL, i);
    }
    if (s[i] == '-' || (s[i] >= '0' && s[i] <= '9')) {
        return jv_scan_number(s, n, i, code, off);
    }
    return jv_fail(code, off, JSON_ERR_CHAR, i);
}

static int jv_view_ok(const struct JsonDoc *doc, const struct JsonView *v) {
    if (v == 0 || v->start < 0 || v->len <= 0) {
        return 0;
    }
    if (v->start > doc->len) {
        return 0;
    }
    return v->len <= doc->len - v->start;
}

static int jv_dmax(const struct JsonDoc *doc) {
    return doc->depth_limit > 0 ? doc->depth_limit : JSON_DEPTH_DEFAULT;
}

/* decode one escape sequence at *ip; writes 1..4 UTF-8 bytes, advances *ip */
static int jv_decode(const char *s, int *ip, unsigned char *out) {
    int i;
    int bad;
    unsigned char c;
    i = *ip;
    c = (unsigned char)s[i];
    if (c != '\\') {
        out[0] = c;
        *ip = i + 1;
        return 1;
    }
    c = (unsigned char)s[i + 1];
    *ip = i + 2;
    switch (c) {
    case '"':
        out[0] = '"';
        return 1;
    case '\\':
        out[0] = '\\';
        return 1;
    case '/':
        out[0] = '/';
        return 1;
    case 'b':
        out[0] = '\b';
        return 1;
    case 'f':
        out[0] = '\f';
        return 1;
    case 'n':
        out[0] = '\n';
        return 1;
    case 'r':
        out[0] = '\r';
        return 1;
    case 't':
        out[0] = '\t';
        return 1;
    case 'u': {
        int cp;
        cp = jv_hex4(s, i + 2, &bad);
        if (cp < 0) {
            return -1;
        }
        if (cp >= 0xD800 && cp <= 0xDBFF) {
            int lo;
            lo = jv_hex4(s, i + 8, &bad);
            if (lo < 0) {
                return -1;
            }
            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
            *ip = i + 12;
        } else {
            *ip = i + 6;
        }
        if (cp < 0x80) {
            out[0] = (unsigned char)cp;
            return 1;
        }
        if (cp < 0x800) {
            out[0] = (unsigned char)(0xC0 | (cp >> 6));
            out[1] = (unsigned char)(0x80 | (cp & 0x3F));
            return 2;
        }
        if (cp < 0x10000) {
            out[0] = (unsigned char)(0xE0 | (cp >> 12));
            out[1] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F));
            out[2] = (unsigned char)(0x80 | (cp & 0x3F));
            return 3;
        }
        out[0] = (unsigned char)(0xF0 | (cp >> 18));
        out[1] = (unsigned char)(0x80 | ((cp >> 12) & 0x3F));
        out[2] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F));
        out[3] = (unsigned char)(0x80 | (cp & 0x3F));
        return 4;
    }
    default:
        return -1;
    }
}

/* compare a raw object key range with a decoded C string (last-wins lookup) */
static int jv_key_eq(const char *s, int start, int stop, const char *key) {
    unsigned char out[4];
    int i;
    int k;
    int j;
    int n;
    i = start;
    k = 0;
    while (i < stop) {
        n = jv_decode(s, &i, out);
        if (n < 0) {
            return 0;
        }
        for (j = 0; j < n; j++) {
            if (key[k] == '\0' || (unsigned char)key[k] != out[j]) {
                return 0;
            }
            k++;
        }
    }
    return key[k] == '\0';
}

/* ---------------------------------------------------------- iteration */

struct JsonIter {
    int i;
    int end;
    int obj;
    int done;
    int dmax;
};

static int jv_iter_begin(const struct JsonDoc *doc, const struct JsonView *v,
        struct JsonIter *it) {
    char c;
    if (v->start < 0 || v->len <= 0) {
        return 0;
    }
    c = doc->src[v->start];
    if (c == '{') {
        it->obj = 1;
    } else if (c == '[') {
        it->obj = 0;
    } else {
        return 0;
    }
    it->i = v->start + 1;
    it->end = v->start + v->len;
    it->done = 0;
    it->dmax = jv_dmax(doc);
    return 1;
}

/* 1 = a member/element was returned, 0 = end, -1 = malformed (never after parse) */
static int jv_iter_next(const struct JsonDoc *doc, struct JsonIter *it,
        struct JsonView *val, int *key_start, int *key_len) {
    const char *s;
    int i;
    int code;
    int off;
    int vstart;
    int key_end;
    s = doc->src;
    if (it->done) {
        return 0;
    }
    i = jv_skip_ws(s, it->end, it->i);
    if (i >= it->end) {
        it->done = 1;
        return 0;
    }
    if (s[i] == '}' || s[i] == ']') {
        it->done = 1;
        return 0;
    }
    *key_start = -1;
    *key_len = 0;
    if (it->obj) {
        if (s[i] != '"') {
            return -1;
        }
        *key_start = i + 1;
        key_end = jv_scan_string(s, it->end, i, &code, &off);
        if (key_end < 0) {
            return -1;
        }
        *key_len = key_end - i - 2;
        i = jv_skip_ws(s, it->end, key_end);
        if (i >= it->end || s[i] != ':') {
            return -1;
        }
        i++;
    }
    vstart = jv_skip_ws(s, it->end, i);
    code = JSON_OK;
    off = 0;
    i = jv_scan_value(s, it->end, vstart, 1, it->dmax, &code, &off);
    if (i < 0) {
        return -1;
    }
    val->start = vstart;
    val->len = i - vstart;
    i = jv_skip_ws(s, it->end, i);
    if (i < it->end && s[i] == ',') {
        it->i = i + 1;
    } else {
        it->i = i;
    }
    return 1;
}

/* ------------------------------------------------------------ writer core */

static void jw_byte(struct JsonOut *o, char c) {
    if (o->len < o->cap) {
        o->buf[o->len] = c;
    }
    o->len = o->len + 1;
}

static void jw_bytes(struct JsonOut *o, const char *p, int n) {
    int i;
    for (i = 0; i < n; i++) {
        jw_byte(o, p[i]);
    }
}

static int jw_before(struct JsonOut *o) {
    int top;
    if (o->err != JSON_EMIT_NONE) {
        return 0;
    }
    if (o->depth == 0) {
        if (o->root_done) {
            o->err = JSON_EMIT_STATE;
            return 0;
        }
        return 1;
    }
    top = o->depth - 1;
    if (o->in_object[top]) {
        if (o->state[top] != 2) {
            o->err = JSON_EMIT_STATE;
            return 0;
        }
    } else if (o->state[top] == 1) {
        jw_byte(o, ',');
    }
    return 1;
}

static void jw_after(struct JsonOut *o) {
    if (o->depth == 0) {
        o->root_done = 1;
    } else {
        o->state[o->depth - 1] = 1;
    }
}

static int jw_open(struct JsonOut *o, int is_object) {
    if (!jw_before(o)) {
        return 0;
    }
    if (o->depth >= JSON_OUT_DEPTH) {
        o->err = JSON_EMIT_DEPTH;
        return 0;
    }
    jw_byte(o, is_object ? '{' : '[');
    jw_after(o);
    o->in_object[o->depth] = (unsigned char)(is_object ? 1 : 0);
    o->state[o->depth] = 0;
    o->depth = o->depth + 1;
    return 1;
}

static void jw_escaped(struct JsonOut *o, const char *text) {
    int i;
    unsigned char c;
    static const char *hex = "0123456789abcdef";
    i = 0;
    while (text[i] != '\0') {
        c = (unsigned char)text[i];
        if (c == '"' || c == '\\') {
            jw_byte(o, '\\');
            jw_byte(o, (char)c);
        } else if (c == '\b') {
            jw_bytes(o, "\\b", 2);
        } else if (c == '\f') {
            jw_bytes(o, "\\f", 2);
        } else if (c == '\n') {
            jw_bytes(o, "\\n", 2);
        } else if (c == '\r') {
            jw_bytes(o, "\\r", 2);
        } else if (c == '\t') {
            jw_bytes(o, "\\t", 2);
        } else if (c < 0x20) {
            jw_bytes(o, "\\u00", 4);
            jw_byte(o, hex[(c >> 4) & 0xF]);
            jw_byte(o, hex[c & 0xF]);
        } else {
            jw_byte(o, (char)c);
        }
        i++;
    }
}

/* ------------------------------------------------------------- writer impl */

impl JsonWrite for JsonOut {
    int begin(char *buf, int cap) {
        self->buf = buf;
        self->cap = cap > 0 ? cap : 0;
        self->len = 0;
        self->err = JSON_EMIT_NONE;
        self->depth = 0;
        self->root_done = 0;
        return 1;
    }
    int object() {
        return jw_open(self, 1);
    }
    int array() {
        return jw_open(self, 0);
    }
    int end() {
        int top;
        if (self->err != JSON_EMIT_NONE) {
            return 0;
        }
        if (self->depth == 0) {
            self->err = JSON_EMIT_STATE;
            return 0;
        }
        top = self->depth - 1;
        if (self->in_object[top] && self->state[top] == 2) {
            self->err = JSON_EMIT_STATE;
            return 0;
        }
        jw_byte(self, self->in_object[top] ? '}' : ']');
        self->depth = self->depth - 1;
        return 1;
    }
    int key(const char *name) {
        int top;
        if (self->err != JSON_EMIT_NONE) {
            return 0;
        }
        if (self->depth == 0) {
            self->err = JSON_EMIT_STATE;
            return 0;
        }
        top = self->depth - 1;
        if (!self->in_object[top] || self->state[top] == 2) {
            self->err = JSON_EMIT_STATE;
            return 0;
        }
        if (self->state[top] == 1) {
            jw_byte(self, ',');
        }
        jw_byte(self, '"');
        jw_escaped(self, name);
        jw_bytes(self, "\":", 2);
        self->state[top] = 2;
        return 1;
    }
    int string(const char *text) {
        if (!jw_before(self)) {
            return 0;
        }
        jw_byte(self, '"');
        jw_escaped(self, text);
        jw_byte(self, '"');
        jw_after(self);
        return 1;
    }
    int integer(long long value) {
        char tmp[32];
        int n;
        if (!jw_before(self)) {
            return 0;
        }
        n = snprintf(tmp, sizeof tmp, "%lld", value);
        jw_bytes(self, tmp, n);
        jw_after(self);
        return 1;
    }
    int real(double value) {
        char tmp[40];
        int n;
        if (value != value || value > DBL_MAX || value < -DBL_MAX) {
            self->err = JSON_EMIT_FINITE;
            return 0;
        }
        if (!jw_before(self)) {
            return 0;
        }
        n = snprintf(tmp, sizeof tmp, "%.17g", value);
        jw_bytes(self, tmp, n);
        jw_after(self);
        return 1;
    }
    int boolean(int value) {
        if (!jw_before(self)) {
            return 0;
        }
        if (value) {
            jw_bytes(self, "true", 4);
        } else {
            jw_bytes(self, "false", 5);
        }
        jw_after(self);
        return 1;
    }
    int null() {
        if (!jw_before(self)) {
            return 0;
        }
        jw_bytes(self, "null", 4);
        jw_after(self);
        return 1;
    }
    int finish() {
        if (self->err != JSON_EMIT_NONE) {
            return -1;
        }
        if (self->depth != 0 || !self->root_done) {
            self->err = JSON_EMIT_STATE;
            return -1;
        }
        if (self->cap > 0) {
            int at;
            at = self->len < self->cap ? self->len : self->cap - 1;
            self->buf[at] = '\0';
        }
        return self->len;
    }
    int length() {
        return self->len;
    }
    int error() {
        return self->err;
    }
}

/* ------------------------------------------------------- per-kind ops */

/*
 * The read side's polymorphic surface. Every instance is an empty struct: a
 * view carries all the state it needs (the document plus a byte range), so a
 * borrowed `JsonValue` value is stable for as long as the caller's text and
 * never points into a stack frame. Unknown/MISSING has no ops object; the
 * caller keeps the existing JSON_READ_MISSING behaviour.
 */
trait JsonValue {
    int kind();
    int count(struct JsonDoc *doc, struct JsonView v);
    struct JsonView at(struct JsonDoc *doc, struct JsonView v, int index);
    struct JsonView member(struct JsonDoc *doc, struct JsonView v,
            const char *key);
    int as_int(struct JsonDoc *doc, struct JsonView v, long long *out);
    int as_double(struct JsonDoc *doc, struct JsonView v, double *out);
    int as_bool(struct JsonDoc *doc, struct JsonView v, int *out);
    int as_string(struct JsonDoc *doc, struct JsonView v, char *buf, int cap);
    int offset_of(struct JsonDoc *doc, struct JsonView v);
    int len_of(struct JsonDoc *doc, struct JsonView v);
    int emit(struct JsonDoc *doc, struct JsonView v, struct JsonOut *out);
}

struct JsonObjectOps {
} use JsonValue;

struct JsonArrayOps {
} use JsonValue;

struct JsonStringOps {
} use JsonValue;

struct JsonNumberOps {
} use JsonValue;

struct JsonTrueOps {
} use JsonValue;

struct JsonFalseOps {
} use JsonValue;

struct JsonNullOps {
} use JsonValue;

/* the MISSING view: start -1 is what every "not found" return uses */
static struct JsonView jv_missing_view(void) {
    struct JsonView v;
    v.start = -1;
    v.len = 0;
    return v;
}

/* emit is kind-blind: the whole range is already validated JSON text */
static int jv_emit_raw(struct JsonDoc *doc, struct JsonView v,
        struct JsonOut *out) {
    if (!jw_before(out)) {
        return 0;
    }
    jw_bytes(out, doc->src + v.start, v.len);
    jw_after(out);
    return 1;
}

/* classify the first byte of a valid range; lexical, not kind behaviour */
static int jv_kind_of(const char *s, int start) {
    char c;
    c = s[start];
    if (c == '{') {
        return JSON_OBJECT;
    }
    if (c == '[') {
        return JSON_ARRAY;
    }
    if (c == '"') {
        return JSON_STRING;
    }
    if (c == 't') {
        return JSON_TRUE;
    }
    if (c == 'f') {
        return JSON_FALSE;
    }
    if (c == 'n') {
        return JSON_NULL;
    }
    return JSON_NUMBER;
}

impl JsonValue for JsonObjectOps {
    int kind() {
        return JSON_OBJECT;
    }
    int count(struct JsonDoc *doc, struct JsonView v) {
        struct JsonIter it;
        struct JsonView val;
        int ks;
        int kl;
        int k;
        int rc;
        if (!jv_iter_begin(doc, &v, &it)) {
            doc->read_err = JSON_READ_KIND;
            return -1;
        }
        k = 0;
        while (1) {
            rc = jv_iter_next(doc, &it, &val, &ks, &kl);
            if (rc < 0) {
                doc->read_err = JSON_READ_MISSING;
                return -1;
            }
            if (rc == 0) {
                break;
            }
            k++;
        }
        return k;
    }
    struct JsonView at(struct JsonDoc *doc, struct JsonView v, int index) {
        doc->read_err = JSON_READ_KIND;
        return jv_missing_view();
    }
    struct JsonView member(struct JsonDoc *doc, struct JsonView v,
            const char *key) {
        struct JsonIter it;
        struct JsonView val;
        struct JsonView found;
        int ks;
        int kl;
        int rc;
        found = jv_missing_view();
        if (!jv_iter_begin(doc, &v, &it) || !it.obj) {
            doc->read_err = JSON_READ_KIND;
            return found;
        }
        while (1) {
            rc = jv_iter_next(doc, &it, &val, &ks, &kl);
            if (rc < 0) {
                doc->read_err = JSON_READ_MISSING;
                return found;
            }
            if (rc == 0) {
                break;
            }
            if (jv_key_eq(doc->src, ks, ks + kl, key)) {
                found = val;
            }
        }
        if (found.start < 0) {
            doc->read_err = JSON_READ_MISSING;
        }
        return found;
    }
    int as_int(struct JsonDoc *doc, struct JsonView v, long long *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_double(struct JsonDoc *doc, struct JsonView v, double *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_bool(struct JsonDoc *doc, struct JsonView v, int *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_string(struct JsonDoc *doc, struct JsonView v, char *buf, int cap) {
        doc->read_err = JSON_READ_KIND;
        return -1;
    }
    int offset_of(struct JsonDoc *doc, struct JsonView v) {
        return v.start;
    }
    int len_of(struct JsonDoc *doc, struct JsonView v) {
        return v.len;
    }
    int emit(struct JsonDoc *doc, struct JsonView v, struct JsonOut *out) {
        return jv_emit_raw(doc, v, out);
    }
}

impl JsonValue for JsonArrayOps {
    int kind() {
        return JSON_ARRAY;
    }
    int count(struct JsonDoc *doc, struct JsonView v) {
        struct JsonIter it;
        struct JsonView val;
        int ks;
        int kl;
        int k;
        int rc;
        if (!jv_iter_begin(doc, &v, &it)) {
            doc->read_err = JSON_READ_KIND;
            return -1;
        }
        k = 0;
        while (1) {
            rc = jv_iter_next(doc, &it, &val, &ks, &kl);
            if (rc < 0) {
                doc->read_err = JSON_READ_MISSING;
                return -1;
            }
            if (rc == 0) {
                break;
            }
            k++;
        }
        return k;
    }
    struct JsonView at(struct JsonDoc *doc, struct JsonView v, int index) {
        struct JsonIter it;
        struct JsonView val;
        struct JsonView found;
        int ks;
        int kl;
        int k;
        int rc;
        found = jv_missing_view();
        if (!jv_iter_begin(doc, &v, &it) || it.obj) {
            doc->read_err = JSON_READ_KIND;
            return found;
        }
        k = 0;
        while (1) {
            rc = jv_iter_next(doc, &it, &val, &ks, &kl);
            if (rc < 0) {
                doc->read_err = JSON_READ_MISSING;
                return found;
            }
            if (rc == 0) {
                break;
            }
            if (k == index) {
                return val;
            }
            k++;
        }
        doc->read_err = JSON_READ_MISSING;
        return found;
    }
    struct JsonView member(struct JsonDoc *doc, struct JsonView v,
            const char *key) {
        doc->read_err = JSON_READ_KIND;
        return jv_missing_view();
    }
    int as_int(struct JsonDoc *doc, struct JsonView v, long long *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_double(struct JsonDoc *doc, struct JsonView v, double *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_bool(struct JsonDoc *doc, struct JsonView v, int *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_string(struct JsonDoc *doc, struct JsonView v, char *buf, int cap) {
        doc->read_err = JSON_READ_KIND;
        return -1;
    }
    int offset_of(struct JsonDoc *doc, struct JsonView v) {
        return v.start;
    }
    int len_of(struct JsonDoc *doc, struct JsonView v) {
        return v.len;
    }
    int emit(struct JsonDoc *doc, struct JsonView v, struct JsonOut *out) {
        return jv_emit_raw(doc, v, out);
    }
}

impl JsonValue for JsonStringOps {
    int kind() {
        return JSON_STRING;
    }
    int count(struct JsonDoc *doc, struct JsonView v) {
        doc->read_err = JSON_READ_KIND;
        return -1;
    }
    struct JsonView at(struct JsonDoc *doc, struct JsonView v, int index) {
        doc->read_err = JSON_READ_KIND;
        return jv_missing_view();
    }
    struct JsonView member(struct JsonDoc *doc, struct JsonView v,
            const char *key) {
        doc->read_err = JSON_READ_KIND;
        return jv_missing_view();
    }
    int as_int(struct JsonDoc *doc, struct JsonView v, long long *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_double(struct JsonDoc *doc, struct JsonView v, double *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_bool(struct JsonDoc *doc, struct JsonView v, int *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_string(struct JsonDoc *doc, struct JsonView v, char *buf, int cap) {
        unsigned char out[4];
        int i;
        int end;
        int n;
        int j;
        int m;
        i = v.start + 1;
        end = v.start + v.len - 1;
        n = 0;
        while (i < end) {
            m = jv_decode(doc->src, &i, out);
            if (m < 0) {
                doc->read_err = JSON_READ_MISSING;
                return -1;
            }
            for (j = 0; j < m; j++) {
                if (n < cap - 1 && buf != 0) {
                    buf[n] = (char)out[j];
                }
                n++;
            }
        }
        if (cap > 0 && buf != 0) {
            int at;
            at = n < cap ? n : cap - 1;
            buf[at] = '\0';
        }
        return n;
    }
    int offset_of(struct JsonDoc *doc, struct JsonView v) {
        return v.start;
    }
    int len_of(struct JsonDoc *doc, struct JsonView v) {
        return v.len;
    }
    int emit(struct JsonDoc *doc, struct JsonView v, struct JsonOut *out) {
        return jv_emit_raw(doc, v, out);
    }
}

impl JsonValue for JsonNumberOps {
    int kind() {
        return JSON_NUMBER;
    }
    int count(struct JsonDoc *doc, struct JsonView v) {
        doc->read_err = JSON_READ_KIND;
        return -1;
    }
    struct JsonView at(struct JsonDoc *doc, struct JsonView v, int index) {
        doc->read_err = JSON_READ_KIND;
        return jv_missing_view();
    }
    struct JsonView member(struct JsonDoc *doc, struct JsonView v,
            const char *key) {
        doc->read_err = JSON_READ_KIND;
        return jv_missing_view();
    }
    int as_int(struct JsonDoc *doc, struct JsonView v, long long *out) {
        unsigned long long mag;
        unsigned long long limit;
        unsigned long long d;
        int i;
        int end;
        int neg;
        if (doc->src[v.start] < '-' || doc->src[v.start] > '9') {
            doc->read_err = JSON_READ_KIND;
            return 0;
        }
        i = v.start;
        end = v.start + v.len;
        neg = 0;
        if (doc->src[i] == '-') {
            neg = 1;
            i++;
        }
        limit = neg ? 9223372036854775808ULL : 9223372036854775807ULL;
        mag = 0;
        while (i < end) {
            char c;
            c = doc->src[i];
            if (c == '.' || c == 'e' || c == 'E') {
                doc->read_err = JSON_READ_INTEGER;
                return 0;
            }
            d = (unsigned long long)(c - '0');
            if (d > 9) {
                doc->read_err = JSON_READ_INTEGER;
                return 0;
            }
            if (mag > (limit - d) / 10) {
                doc->read_err = JSON_READ_RANGE;
                return 0;
            }
            mag = mag * 10 + d;
            i++;
        }
        if (neg) {
            if (mag == 9223372036854775808ULL) {
                *out = (-9223372036854775807LL - 1);
            } else {
                *out = -(long long)mag;
            }
        } else {
            *out = (long long)mag;
        }
        return 1;
    }
    int as_double(struct JsonDoc *doc, struct JsonView v, double *out) {
        unsigned long long sig;
        int i;
        int end;
        int neg;
        int started;
        int nsig;
        int exp;
        int esign;
        int eval;
        double val;
        if (doc->src[v.start] < '-' || doc->src[v.start] > '9') {
            doc->read_err = JSON_READ_KIND;
            return 0;
        }
        i = v.start;
        end = v.start + v.len;
        neg = 0;
        if (doc->src[i] == '-') {
            neg = 1;
            i++;
        }
        sig = 0;
        started = 0;
        nsig = 0;
        exp = 0;
        while (i < end && doc->src[i] >= '0' && doc->src[i] <= '9') {
            int d;
            d = doc->src[i] - '0';
            if (d != 0) {
                started = 1;
            }
            if (started && nsig < 19) {
                sig = sig * 10 + (unsigned long long)d;
                nsig++;
            } else if (started) {
                exp++;
            }
            i++;
        }
        if (i < end && doc->src[i] == '.') {
            i++;
            while (i < end && doc->src[i] >= '0' && doc->src[i] <= '9') {
                int d;
                d = doc->src[i] - '0';
                if (!started && d == 0) {
                    exp--;
                } else if (nsig < 19) {
                    sig = sig * 10 + (unsigned long long)d;
                    nsig++;
                    started = 1;
                    exp--;
                }
                i++;
            }
        }
        if (i < end && (doc->src[i] == 'e' || doc->src[i] == 'E')) {
            i++;
            esign = 1;
            if (i < end && (doc->src[i] == '+' || doc->src[i] == '-')) {
                if (doc->src[i] == '-') {
                    esign = -1;
                }
                i++;
            }
            eval = 0;
            while (i < end && doc->src[i] >= '0' && doc->src[i] <= '9') {
                if (eval < 100000) {
                    eval = eval * 10 + (doc->src[i] - '0');
                }
                i++;
            }
            exp = exp + esign * eval;
        }
        if (exp > 400) {
            exp = 400;
        }
        if (exp < -400) {
            exp = -400;
        }
        val = (double)sig;
        if (exp > 0) {
            loop(exp) {
                val = val * 10.0;
                if (val > DBL_MAX) {
                    doc->read_err = JSON_READ_RANGE;
                    return 0;
                }
            }
        } else {
            loop(-exp) {
                val = val / 10.0;
            }
        }
        if (neg) {
            val = -val;
        }
        *out = val;
        return 1;
    }
    int as_bool(struct JsonDoc *doc, struct JsonView v, int *out) {
        doc->read_err = JSON_READ_KIND;
        return 0;
    }
    int as_string(struct JsonDoc *doc, struct JsonView v, char *buf, int cap) {
        doc->read_err = JSON_READ_KIND;
        return -1;
    }
    int offset_of(struct JsonDoc *doc, struct JsonView v) {
        return v.start;
    }
    int len_of(struct JsonDoc *doc, struct JsonView v) {
        return v.len;
    }
    int emit(struct JsonDoc *doc, struct JsonView v, struct JsonOut *out) {
        return jv_emit_raw(doc, v, out);
    }
}

