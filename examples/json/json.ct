/* one stateless instance per kind; the ifaces below borrow these addresses */
static struct JsonObjectOps g_json_object_ops;
static struct JsonArrayOps g_json_array_ops;
static struct JsonStringOps g_json_string_ops;
static struct JsonNumberOps g_json_number_ops;
static struct JsonTrueOps g_json_true_ops;
static struct JsonFalseOps g_json_false_ops;
static struct JsonNullOps g_json_null_ops;

static JsonValue json_ops_none(void) {
    JsonValue ops;
    ops.self = 0;
    ops.vt = 0;
    return ops;
}

static JsonValue json_ops_for(int kind) {
    if (kind == JSON_OBJECT) {
        return g_json_object_ops;
    }
    if (kind == JSON_ARRAY) {
        return g_json_array_ops;
    }
    if (kind == JSON_STRING) {
        return g_json_string_ops;
    }
    if (kind == JSON_NUMBER) {
        return g_json_number_ops;
    }
    if (kind == JSON_TRUE) {
        return g_json_true_ops;
    }
    if (kind == JSON_FALSE) {
        return g_json_false_ops;
    }
    if (kind == JSON_NULL) {
        return g_json_null_ops;
    }
    return json_ops_none();
}

/* validate the range, reset read_error, and pick the ops for its first byte */
static JsonValue json_ops_for_view(struct JsonDoc *doc,
        const struct JsonView *v) {
    if (!jv_view_ok(doc, v)) {
        doc->read_err = JSON_READ_MISSING;
        return json_ops_none();
    }
    doc->read_err = JSON_READ_NONE;
    return json_ops_for(jv_kind_of(doc->src, v->start));
}

/* ------------------------------------------------------------- reader impl */

impl Json for JsonDoc {
    int parse(const char *text, int len) {
        int code;
        int off;
        int end;
        int token_end;
        self->src = text;
        self->len = len > 0 ? len : 0;
        self->err = JSON_OK;
        self->off = 0;
        self->root_start = 0;
        self->root_len = 0;
        self->read_err = JSON_READ_NONE;
        if (text == 0 || len <= 0) {
            self->err = JSON_ERR_EOF;
            return 0;
        }
        code = JSON_OK;
        off = 0;
        token_end = jv_scan_value(text, len, 0, 1, jv_dmax(self), &code, &off);
        if (token_end < 0) {
            self->err = code;
            self->off = off;
            return 0;
        }
        end = jv_skip_ws(text, len, token_end);
        if (end != len) {
            self->err = JSON_ERR_TRAILING;
            self->off = end;
            return 0;
        }
        self->root_start = jv_skip_ws(text, len, 0);
        self->root_len = token_end - self->root_start;
        return 1;
    }
    int error() {
        return self->err;
    }
    int error_offset() {
        return self->off;
    }
    int error_line() {
        int i;
        int line;
        line = 1;
        for (i = 0; i < self->off && i < self->len; i++) {
            if (self->src[i] == '\n') {
                line++;
            }
        }
        return line;
    }
    int error_column() {
        int i;
        int col;
        col = 1;
        for (i = 0; i < self->off && i < self->len; i++) {
            if (self->src[i] == '\n') {
                col = 1;
            } else {
                col++;
            }
        }
        return col;
    }
    struct JsonView root() {
        struct JsonView v;
        v.start = self->err == JSON_OK ? self->root_start : -1;
        v.len = self->err == JSON_OK ? self->root_len : 0;
        return v;
    }
    int kind(struct JsonView *v) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return JSON_MISSING;
        }
        return ops.kind();
    }
    int count(struct JsonView *v) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return -1;
        }
        return ops.count(self, *v);
    }
    struct JsonView member(struct JsonView *v, const char *key) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return jv_missing_view();
        }
        return ops.member(self, *v, key);
    }
    struct JsonView at(struct JsonView *v, int index) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0 || index < 0) {
            self->read_err = JSON_READ_MISSING;
            return jv_missing_view();
        }
        return ops.at(self, *v, index);
    }
    int as_int(struct JsonView *v, long long *out) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return 0;
        }
        return ops.as_int(self, *v, out);
    }
    int as_double(struct JsonView *v, double *out) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return 0;
        }
        return ops.as_double(self, *v, out);
    }
    int as_bool(struct JsonView *v, int *out) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return 0;
        }
        return ops.as_bool(self, *v, out);
    }
    int as_string(struct JsonView *v, char *buf, int cap) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return -1;
        }
        return ops.as_string(self, *v, buf, cap);
    }
    int offset_of(struct JsonView *v) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return -1;
        }
        return ops.offset_of(self, *v);
    }
    int len_of(struct JsonView *v) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return -1;
        }
        return ops.len_of(self, *v);
    }
    int read_error() {
        return self->read_err;
    }
    int emit(struct JsonView *v, struct JsonOut *out) {
        JsonValue ops;
        ops = json_ops_for_view(self, v);
        if (ops.vt == 0) {
            return 0;
        }
        return ops.emit(self, *v, out);
    }
}

/* --------------------------------------------------------------- messages */

static const char *json_message(int code) {
    switch (code) {
    case JSON_OK:
        return "ok";
    case JSON_ERR_EOF:
        return "unexpected end of input";
    case JSON_ERR_CHAR:
        return "unexpected character";
    case JSON_ERR_LITERAL:
        return "bad literal";
    case JSON_ERR_TRAILING:
        return "trailing data";
    case JSON_ERR_STRING:
        return "control character in string";
    case JSON_ERR_ESCAPE:
        return "bad escape";
    case JSON_ERR_UNICODE:
        return "bad \\u escape";
    case JSON_ERR_SURROGATE:
        return "lone surrogate";
    case JSON_ERR_NUMBER:
        return "bad number";
    case JSON_ERR_DEPTH:
        return "nesting too deep";
    default:
        return "unknown error";
    }
}

/* ------------------------------------------------------------ demo + tests */

static const char *k_demo_text =
    "{\n"
    "  \"name\": \"ct\",\n"
    "  \"tags\": [\"json\", \"zero-alloc\"],\n"
    "  \"stars\": 42,\n"
    "  \"ok\": true,\n"
    "  \"none\": null\n"
    "}";

static const char *k_escape_text =
    "\"a\\\"b\\\\c\\/d\\b\\f\\n\\r\\t\\u0041\\u00e9\\u20ac\\ud83d\\ude00\"";

static const char *k_numbers_text =
    "{\"i\":-9223372036854775808,"
    "\"max\":9223372036854775807,"
    "\"over\":9223372036854775808,"
    "\"one\":1.0,"
    "\"exp\":1.25e2,"
    "\"tiny\":1e-300,"
    "\"huge\":1e999,"
    "\"sub\":1e-400}";

static const char *k_edge_text =
    "{\"empty_obj\":{},\"empty_arr\":[],\"dup\":1,\"dup\":2,"
    "\"a\\u0062\":7,"
    "\"nested\":[[1,[2,[3]]],true,null,\"s\"]}";

static int g_failures;

static void check(int cond, const char *what) {
    if (cond) {
        printf("ok   %s\n", what);
    } else {
        printf("FAIL %s\n", what);
        g_failures++;
    }
}

static void check_int(int got, int want, const char *what) {
    if (got == want) {
        printf("ok   %s = %d\n", what, want);
    } else {
        printf("FAIL %s: got %d, want %d\n", what, got, want);
        g_failures++;
    }
}

static void demo(void) {
    struct JsonDoc doc;
    struct JsonView root;
    struct JsonView tags;
    struct JsonView item;
    char buf[32];
    long long stars;
    int ok;
    int i;
    int count;
    printf("-- demo --\n");
    if (!doc.parse(k_demo_text, (int)strlen(k_demo_text))) {
        printf("demo: parse failed: %s\n", json_message(doc.error()));
        g_failures++;
        return;
    }
    root = doc.root();
    item = doc.member(&root, "name");
    doc.as_string(&item, buf, (int)sizeof buf);
    printf("name  = %s\n", buf);
    tags = doc.member(&root, "tags");
    count = doc.count(&tags);
    printf("tags  = %d", count);
    for (i = 0; i < count; i++) {
        item = doc.at(&tags, i);
        doc.as_string(&item, buf, (int)sizeof buf);
        printf(" %s", buf);
    }
    printf("\n");
    item = doc.member(&root, "stars");
    doc.as_int(&item, &stars);
    printf("stars = %lld\n", stars);
    item = doc.member(&root, "ok");
    doc.as_bool(&item, &ok);
    printf("ok    = %s\n", ok ? "true" : "false");
    item = doc.member(&root, "none");
    printf("none  = %s\n", doc.kind(&item) == JSON_NULL ? "null" : "not null");
}

static void test_reader(void) {
    struct JsonDoc doc;
    struct JsonView root;
    struct JsonView v;
    struct JsonView inner;
    char buf[64];
    char deep[140];
    const char *raw;
    long long n;
    double d;
    int len;
    int i;

    printf("-- reader --\n");
    check(doc.parse(k_edge_text, (int)strlen(k_edge_text)) == 1,
            "parse edge document");
    check_int(doc.error(), JSON_OK, "error() after valid parse");
    check_int(doc.error_line(), 1, "error_line() after valid parse");
    check_int(doc.error_column(), 1, "error_column() after valid parse");
    root = doc.root();
    check_int(doc.kind(&root), JSON_OBJECT, "root kind");
    check_int(doc.count(&root), 6, "root member count");
    v = doc.member(&root, "empty_obj");
    check_int(doc.kind(&v), JSON_OBJECT, "empty object kind");
    check_int(doc.count(&v), 0, "empty object count");
    v = doc.member(&root, "empty_arr");
    check_int(doc.kind(&v), JSON_ARRAY, "empty array kind");
    check_int(doc.count(&v), 0, "empty array count");
    v = doc.member(&root, "dup");
    check(doc.as_int(&v, &n) == 1, "duplicate key is readable");
    check(n == 2, "duplicate key keeps the last value");
    v = doc.member(&root, "ab");
    check(doc.as_int(&v, &n) == 1 && n == 7, "escaped key matches decoded name");
    v = doc.member(&root, "nested");
    check_int(doc.count(&v), 4, "nested array count");
    inner = doc.at(&v, 0);
    check_int(doc.kind(&inner), JSON_ARRAY, "nested array kind");
    inner = doc.at(&v, 1);
    check_int(doc.kind(&inner), JSON_TRUE, "true kind");
    inner = doc.at(&v, 2);
    check_int(doc.kind(&inner), JSON_NULL, "null kind");
    inner = doc.at(&v, 3);
    check_int(doc.as_string(&inner, buf, (int)sizeof buf), 1, "array string length");
    check(strcmp(buf, "s") == 0, "array string value");
    v = doc.member(&root, "absent");
    check_int(doc.kind(&v), JSON_MISSING, "missing member kind");
    check_int(doc.read_error(), JSON_READ_MISSING, "missing member read_error");
    inner = doc.at(&root, 0);
    check_int(doc.read_error(), JSON_READ_KIND, "at() on object read_error");
    check_int(doc.kind(&inner), JSON_MISSING, "at() on object yields missing");
    v = doc.at(&root, -1);
    check_int(doc.read_error(), JSON_READ_MISSING, "negative index read_error");
    check_int(doc.kind(&v), JSON_MISSING, "negative index yields missing");

    check(doc.parse(k_numbers_text, (int)strlen(k_numbers_text)) == 1,
            "parse numbers document");
    root = doc.root();
    v = doc.member(&root, "i");
    check(doc.as_int(&v, &n) == 1 && n == (-9223372036854775807LL - 1),
            "int64 minimum");
    v = doc.member(&root, "max");
    check(doc.as_int(&v, &n) == 1 && n == 9223372036854775807LL,
            "int64 maximum");
    v = doc.member(&root, "over");
    check(doc.as_int(&v, &n) == 0, "int64 overflow rejected");
    check_int(doc.read_error(), JSON_READ_RANGE, "overflow read_error");
    v = doc.member(&root, "one");
    check(doc.as_int(&v, &n) == 0, "fractional number is not an int");
    check_int(doc.read_error(), JSON_READ_INTEGER, "fraction read_error");
    check(doc.as_double(&v, &d) == 1 && d == 1.0, "fractional number as double");
    v = doc.member(&root, "exp");
    check(doc.as_double(&v, &d) == 1 && d == 125.0, "exponent number");
    v = doc.member(&root, "tiny");
    check(doc.as_double(&v, &d) == 1 && d > 0.0 && d < 1e-299, "tiny exponent");
    v = doc.member(&root, "huge");
    check(doc.as_double(&v, &d) == 0, "overflowing real is rejected");
    check_int(doc.read_error(), JSON_READ_RANGE, "real range read_error");
    v = doc.member(&root, "sub");
    check(doc.as_double(&v, &d) == 1 && d == 0.0, "underflow becomes zero");
    v = doc.member(&root, "max");
    check(doc.as_int(&v, &n) == 1, "integer is also a double source");
    check(doc.as_double(&v, &d) == 1 && d > 9.2e18, "int64 max as double");

    check(doc.parse(k_escape_text, (int)strlen(k_escape_text)) == 1,
            "parse escape document");
    root = doc.root();
    check_int(doc.kind(&root), JSON_STRING, "escape root kind");
    len = doc.as_string(&root, buf, (int)sizeof buf);
    check_int(len, 22, "decoded escape length");
    check((unsigned char)buf[0] == 'a' && buf[1] == '"' && buf[2] == 'b'
            && buf[3] == '\\' && buf[4] == 'c' && buf[5] == '/'
            && buf[6] == 'd', "decoded printable escapes");
    check(buf[7] == '\b' && buf[8] == '\f' && buf[9] == '\n' && buf[10] == '\r'
            && buf[11] == '\t', "decoded control escapes");
    check((unsigned char)buf[12] == 'A', "\\u0041 is A");
    check((unsigned char)buf[13] == 0xC3 && (unsigned char)buf[14] == 0xA9,
            "\\u00e9 is UTF-8 e-acute");
    check((unsigned char)buf[15] == 0xE2 && (unsigned char)buf[16] == 0x82
            && (unsigned char)buf[17] == 0xAC, "\\u20ac is UTF-8 euro");
    check((unsigned char)buf[18] == 0xF0 && (unsigned char)buf[19] == 0x9F
            && (unsigned char)buf[20] == 0x98 && (unsigned char)buf[21] == 0x80,
            "surrogate pair is UTF-8 emoji");
    check(buf[22] == '\0', "decoded string is NUL terminated");
    check_int(doc.as_string(&root, buf, 5), 22, "short buffer still reports length");
    check_int((int)strlen(buf), 4, "short buffer holds cap - 1 bytes");
    check_int(doc.offset_of(&root), 0, "offset_of");
    check_int(doc.len_of(&root), (int)strlen(k_escape_text), "len_of");

    raw = doc.src;
    check(raw[0] == '"', "src is still the caller's text");
    check_int(doc.read_error(), JSON_READ_NONE, "read_error after success");

    len = 0;
    for (i = 0; i < 64; i++) {
        deep[len] = '[';
        len++;
    }
    deep[len] = '0';
    len++;
    for (i = 0; i < 64; i++) {
        deep[len] = ']';
        len++;
    }
    check(doc.parse(deep, len) == 1, "64 nested arrays accepted");
}

static void test_writer(void) {
    struct JsonOut out;
    char text[256];
    char measure[8];
    double d;
    int n;
    int i;
    int rc;

    printf("-- writer --\n");
    check(out.begin(text, (int)sizeof text) == 1, "begin");
    check(out.object() == 1, "object");
    check(out.key("name") == 1, "key");
    check(out.string("ct") == 1, "string");
    check(out.key("n") == 1 && out.integer(42) == 1, "integer");
    check(out.key("pi") == 1 && out.real(3.5) == 1, "real");
    check(out.key("ok") == 1 && out.boolean(1) == 1, "boolean");
    check(out.key("none") == 1 && out.null() == 1, "null");
    check(out.key("list") == 1 && out.array() == 1, "nested array");
    check(out.integer(1) == 1 && out.string("two") == 1, "array values");
    check(out.end() == 1 && out.end() == 1, "closing brackets");
    n = out.finish();
    check(n == (int)strlen("{\"name\":\"ct\",\"n\":42,\"pi\":3.5,\"ok\":true,\"none\":null,\"list\":[1,\"two\"]}"), "finish returns the required length");
    check(strcmp(text,
            "{\"name\":\"ct\",\"n\":42,\"pi\":3.5,\"ok\":true,\"none\":null,"
            "\"list\":[1,\"two\"]}") == 0, "serialized document");
    check_int(out.error(), JSON_EMIT_NONE, "writer error after success");

    check(out.begin(measure, 0) == 1, "begin with cap = 0");
    check(out.object() == 1 && out.key("a") == 1 && out.string("b") == 1
            && out.end() == 1, "measure-only write");
    check_int(out.finish(), 9, "measure-only length");

    check(out.begin(text, (int)sizeof text) == 1, "begin for escaping");
    check(out.string("a\"b\\c\nd\te\x01") == 1, "escaped string");
    n = out.finish();
    check(n == (int)strlen("\"a\\\"b\\\\c\\nd\\te\\u0001\""), "escaped string length");
    check(strcmp(text, "\"a\\\"b\\\\c\\nd\\te\\u0001\"") == 0,
            "escaped string bytes");

    check(out.begin(text, (int)sizeof text) == 1, "begin for structural errors");
    check(out.key("x") == 0 && out.error() == JSON_EMIT_STATE,
            "key at top level is rejected");
    check(out.begin(text, (int)sizeof text) == 1, "begin again");
    check(out.integer(1) == 1, "one root value");
    check(out.integer(2) == 0 && out.error() == JSON_EMIT_STATE,
            "second root value is rejected");
    check(out.begin(text, (int)sizeof text) == 1, "begin for pending key");
    check(out.object() == 1 && out.key("x") == 1 && out.end() == 0
            && out.error() == JSON_EMIT_STATE, "pending key is rejected");
    check(out.begin(text, (int)sizeof text) == 1, "begin for depth");
    rc = 1;
    for (i = 0; i <= JSON_OUT_DEPTH && rc; i++) {
        rc = out.array();
    }
    check(rc == 0 && out.error() == JSON_EMIT_DEPTH, "writer depth limit");
    check(out.begin(text, (int)sizeof text) == 1, "begin for non-finite");
    d = 0.0;
    d = d / d;
    check(out.real(d) == 0 && out.error() == JSON_EMIT_FINITE,
            "NaN is rejected");
}

struct JsonBadCase {
    const char *text;
    int code;
    int offset;
    int line;
    int column;
};

static void test_errors(void) {
    struct JsonDoc doc;
    struct JsonBadCase cases[25];
    struct JsonView root;
    struct JsonOut out;
    char buf[256];
    char deep[140];
    char text[64];
    int count;
    int i;
    int len;
    int n;

    printf("-- errors --\n");
    count = 0;
    cases[count].text = "";
    cases[count].code = JSON_ERR_EOF;
    cases[count].offset = 0;
    cases[count].line = 1;
    cases[count].column = 1;
    count++;
    cases[count].text = "{";
    cases[count].code = JSON_ERR_EOF;
    cases[count].offset = 1;
    cases[count].line = 1;
    cases[count].column = 2;
    count++;
    cases[count].text = "{\"a\"}";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 4;
    cases[count].line = 1;
    cases[count].column = 5;
    count++;
    cases[count].text = "{\"a\":1,}";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 7;
    cases[count].line = 1;
    cases[count].column = 8;
    count++;
    cases[count].text = "[1,]";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 3;
    cases[count].line = 1;
    cases[count].column = 4;
    count++;
    cases[count].text = "{a:1}";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 1;
    cases[count].line = 1;
    cases[count].column = 2;
    count++;
    cases[count].text = "tru";
    cases[count].code = JSON_ERR_EOF;
    cases[count].offset = 3;
    cases[count].line = 1;
    cases[count].column = 4;
    count++;
    cases[count].text = "truex";
    cases[count].code = JSON_ERR_TRAILING;
    cases[count].offset = 4;
    cases[count].line = 1;
    cases[count].column = 5;
    count++;
    cases[count].text = "01";
    cases[count].code = JSON_ERR_NUMBER;
    cases[count].offset = 1;
    cases[count].line = 1;
    cases[count].column = 2;
    count++;
    cases[count].text = "1.";
    cases[count].code = JSON_ERR_EOF;
    cases[count].offset = 2;
    cases[count].line = 1;
    cases[count].column = 3;
    count++;
    cases[count].text = ".5";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 0;
    cases[count].line = 1;
    cases[count].column = 1;
    count++;
    cases[count].text = "+1";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 0;
    cases[count].line = 1;
    cases[count].column = 1;
    count++;
    cases[count].text = "1e";
    cases[count].code = JSON_ERR_EOF;
    cases[count].offset = 2;
    cases[count].line = 1;
    cases[count].column = 3;
    count++;
    cases[count].text = "\"a\nb\"";
    cases[count].code = JSON_ERR_STRING;
    cases[count].offset = 2;
    cases[count].line = 1;
    cases[count].column = 3;
    count++;
    cases[count].text = "\"a\\x\"";
    cases[count].code = JSON_ERR_ESCAPE;
    cases[count].offset = 3;
    cases[count].line = 1;
    cases[count].column = 4;
    count++;
    cases[count].text = "\"\\u12g4\"";
    cases[count].code = JSON_ERR_UNICODE;
    cases[count].offset = 5;
    cases[count].line = 1;
    cases[count].column = 6;
    count++;
    cases[count].text = "\"\\ud800\"";
    cases[count].code = JSON_ERR_SURROGATE;
    cases[count].offset = 7;
    cases[count].line = 1;
    cases[count].column = 8;
    count++;
    cases[count].text = "\"\\udc00\"";
    cases[count].code = JSON_ERR_SURROGATE;
    cases[count].offset = 3;
    cases[count].line = 1;
    cases[count].column = 4;
    count++;
    cases[count].text = "{} {}";
    cases[count].code = JSON_ERR_TRAILING;
    cases[count].offset = 3;
    cases[count].line = 1;
    cases[count].column = 4;
    count++;
    cases[count].text = "{\n  \"a\":\n}";
    cases[count].code = JSON_ERR_CHAR;
    cases[count].offset = 9;
    cases[count].line = 3;
    cases[count].column = 1;
    count++;

    for (i = 0; i < count; i++) {
        len = (int)strlen(cases[i].text);
        if (doc.parse(cases[i].text, len) != 0) {
            printf("FAIL case %d parsed\n", i);
            g_failures++;
            continue;
        }
        if (doc.error() != cases[i].code) {
            printf("FAIL case %d code %d, want %d\n", i, doc.error(),
                    cases[i].code);
            g_failures++;
            continue;
        }
        if (doc.error_offset() != cases[i].offset
                || doc.error_line() != cases[i].line
                || doc.error_column() != cases[i].column) {
            printf("FAIL case %d position %d/%d/%d, want %d/%d/%d\n", i,
                    doc.error_offset(), doc.error_line(), doc.error_column(),
                    cases[i].offset, cases[i].line, cases[i].column);
            g_failures++;
            continue;
        }
        root = doc.root();
        if (doc.kind(&root) != JSON_MISSING) {
            printf("FAIL case %d root after error is not missing\n", i);
            g_failures++;
            continue;
        }
        printf("ok   error %d: %s at line %d column %d\n", i,
                json_message(doc.error()), doc.error_line(), doc.error_column());
    }

    len = 0;
    for (i = 0; i < 65; i++) {
        deep[len] = '[';
        len++;
    }
    deep[len] = '0';
    len++;
    for (i = 0; i < 65; i++) {
        deep[len] = ']';
        len++;
    }
    check(doc.parse(deep, len) == 0 && doc.error() == JSON_ERR_DEPTH
            && doc.error_offset() == 64, "65 nested arrays rejected");

    check(doc.parse(k_demo_text, (int)strlen(k_demo_text)) == 1,
            "parse before round trip");
    root = doc.root();
    check(out.begin(buf, (int)sizeof buf) == 1, "begin for round trip");
    check(doc.emit(&root, &out) == 1, "emit root view");
    n = out.finish();
    check(n == (int)strlen(k_demo_text), "round trip length");
    check(strcmp(buf, k_demo_text) == 0, "round trip bytes");

    check(doc.parse("{\"k\":\"v\"}", 9) == 1, "parse for emitted value");
    root = doc.root();
    check(out.begin(text, (int)sizeof text) == 1, "begin emitted value");
    check(out.array() == 1, "array around emitted value");
    check(doc.emit(&root, &out) == 1, "emit document inside array");
    check(out.integer(7) == 1, "value after emit");
    check(out.end() == 1, "close array around emit");
    check(out.finish() == (int)strlen("[{\"k\":\"v\"},7]"), "emit length inside array");
    check(strcmp(text, "[{\"k\":\"v\"},7]") == 0, "emit bytes inside array");

    check(json_message(JSON_ERR_DEPTH) != 0, "message lookup");
    printf("errors: %d messages checked\n", count);
}

int main(void) {
    demo();
    test_reader();
    test_writer();
    test_errors();
    if (g_failures != 0) {
        printf("FAILED %d\n", g_failures);
        return 1;
    }
    printf("all checks passed\n");
    return 0;
}
