//@ct-requires: ct-ast


static int sum(int[] xs)
{
    int total = 0;
    for (int i = 0; i < xs.len; i++) {
        total = total + xs[i];
    }
    return total;
}

int main(void)
{
    int a[] = { 3, 1, 4, 1, 5 };
    int[] s = a;
    int[] middle = s[1..3];

    printf("%d %d %d\n", sum(s), sum(middle), s.len);
    return 0;
}
