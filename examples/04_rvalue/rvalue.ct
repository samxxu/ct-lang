// rvalue.ct — an rvalue receiver (Phase 1.9b): the struct returned by a factory
// call is used directly as the receiver, `make_person("Ann", 30).greet()`. The
// receiver is evaluated exactly once (hoisted into a temp).
// License: MIT; see LICENSE.EXCEPTION
#include <stdio.h>

trait Greeter {
    void greet();
    int bumps(int n);
}

struct Person {
    char *name;
    int age;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("Hi %s (%d)\n", self->name, self->age);
    }
    int bumps(int n) {
        return self->age + n;
    }
}

Person make_person(char *name, int age) {
    Person p = { .name = name, .age = age };
    return p;
}

int main() {
    make_person("Ann", 30).greet();
    int total = make_person("Bob", 41).bumps(1);
    printf("total %d\n", total);
    return 0;
}
