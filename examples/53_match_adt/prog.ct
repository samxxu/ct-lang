//@ct-requires: ct-ast


enum Msg {
    Text(String body),
    Empty(),
}

int main(void)
{
    Msg m = Msg.Text(str_concat("h", "i"));

    match (m) {
        Msg.Text(body) => {
            printf("%s\n", body.cstr());
            body.release();
        }
        Msg.Empty() => {
            printf("empty\n");
        }
    }
    return 0;
}
