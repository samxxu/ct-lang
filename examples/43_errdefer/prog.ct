//@ct-requires: ct-ast
#include <stdio.h>

static int f(int fail)
{
    int x = 1 errdefer { printf("e%d\n", $); };
    int y = 2 defer { printf("d%d\n", $); };
    if (fail) {
        return err: 10;
    }
    return x + y;
}

int main(void)
{
    printf("ok=%d\n", f(0));
    printf("---\n");
    printf("fail=%d\n", f(1));
    return 0;
}
