// loop_semantics.ct - the two `loop` forms and what they guarantee (Phase 22 / 23).
//
// `loop(n)` counts 0..n-1 and `loop(a..b)` counts a..b-1. The count is
// evaluated once, both bounds are evaluated once (lower first), and `i` is a
// plain writable int. `loop(0..3)` is the same program as `loop(3)`.
//
// The count and the bounds come from `Probes` methods here, so "evaluated once"
// is proved through method calls, and the call counter is a field of the object
// rather than a file-scope mutable.
//
// License: MIT; see LICENSE.EXCEPTION
//@ct-requires: ct-ast
#include <stdio.h>

trait Counter {
    int count();
    int lo();
    int hi();
}

struct Probes {
    int calls;
} use Counter;

impl Counter for Probes {
    int count() {
        self->calls = self->calls + 1;
        return 3;
    }
    int lo() {
        printf("eval lo\n");
        return 2;
    }
    int hi() {
        printf("eval hi\n");
        return 5;
    }
}

int main(void)
{
    struct Probes p = { .calls = 0 };

    /* the implicit counter starts at 0 and stops before the count */
    loop(3) {
        printf("count %d\n", i);
    }
    /* zero rounds are not a diagnostic */
    loop(0) {
        printf("never\n");
    }
    /* the count expression runs once, however many rounds follow */
    loop(p.count()) {
        printf("once %d\n", i);
    }
    printf("calls %d\n", p.calls);

    /* half-open [2, 5): the lower bound is evaluated first, once each.
       The upper bound is a method call, which the parser requires to be
       parenthesised inside a range today. */
    loop(p.lo()..(p.hi())) {
        printf("range %d\n", i);
    }
    /* an empty range is silent */
    loop(4..2) {
        printf("never\n");
    }
    /* `loop(0..b)` folds to `loop(b)` and prints the same thing */
    loop(0..3) {
        printf("zero %d\n", i);
    }

    /* break / continue / writing `i` work exactly as in a native for */
    loop(5) {
        if (i == 2) {
            continue;
        }
        if (i == 4) {
            break;
        }
        printf("skip %d\n", i);
    }
    loop(3) {
        printf("write %d\n", i);
        i = i + 1;
    }
    return 0;
}
