/*
 * 场景：一个字节分类器，演示 case 取值的完整表达式面。
 *
 * CT 的 case 取值和 C 一样是整数常量表达式：位移、加法、字符字面量、
 * sizeof 都合法，ct 不折叠、原样交给 C。区别只在「声明不能紧跟在标签后」：
 * 这里用块把局部变量包起来（C 允许裸声明，但那是标签不构成作用域的老坑，
 * ct 直接拒绝，避免误读）。
 */
#include <stdio.h>

static int classify(int key)
{
    int out;

    out = -1;
    switch (key) {
    case (1 << 3): {            /* 8：位移表达式 */
        int local;
        local = 40;
        out = local;
        break;
    }
    case 'A':                   /* 65：字符字面量 */
        out = 41;
        break;
    case 1 + 2:                 /* 3：加法 */
        out = 42;
        break;
    case sizeof(int) * 4:       /* 16：sizeof 参与常量表达式 */
        out = 43;
        break;
    default:
        out = 0;
        break;
    }
    return out;
}

static int nested(int a, int b)
{
    int out;

    out = 0;
    switch (a) {
    case 1:
        switch (b) {
        case 2:
            out = 12;
            break;
        default:
            out = 10;
            break;
        }
        break;
    default:
        out = 99;
        break;
    }
    return out;
}

int main(void)
{
    printf("%d %d %d %d %d\n", classify(8), classify(65), classify(3),
           classify(16), classify(7));
    printf("%d %d\n", nested(1, 2), nested(1, 9));
    return 0;
}
