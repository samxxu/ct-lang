/*
 * 场景：没有 for 也要循环——用向后 goto 手写重试循环，并在失败时
 * 跳到清理标签。这是 C 里常见的「单出口」写法。
 *
 * CT 与 C 一致：标签拥有从自身到下一条标签（或 }）的整条语句链；
 * 连续的标签（retry: done:）允许，第一条拥有第二条。标签后必须有一条
 * 语句，最省的是空语句 `;`（见 src 里的 done: ;）。
 */
#include <stdio.h>

static int next_step(int step)
{
    if (step < 3) {
        return step + 1;
    }
    return 0;
}

static int retry_loop(void)
{
    int step;
    int tries;

    step = 0;
    tries = 0;
retry:
    tries = tries + 1;
    step = next_step(step);
    if (step != 0) {
        goto retry;
    }
    return tries;
}

static int guarded(int fail)
{
    int rc;

    rc = 0;
    if (fail) {
        rc = -1;
        goto cleanup;
    }
    rc = 7;
cleanup:
    ;
    return rc;
}

int main(void)
{
    printf("%d %d %d\n", retry_loop(), guarded(0), guarded(1));
    return 0;
}
