/*
 * 场景：求平均并放大 100 倍做定点显示。double/float 混合，最后统一截断。
 *
 * CT 与 C 一致：格式串与实参类型的匹配由用户负责（与 printf 一样）；
 * ct 不折叠浮点常量，编译期常量仍由 C 处理。
 */
#include <stdio.h>

static double average(int a, int b)
{
    return (a + b) / 2.0;
}

static float scale(float x)
{
    return x * 1.5f;
}

int main(void)
{
    double a;

    a = average(1, 2);
    printf("%d %d\n", (int)(a * 100), (int)(scale(2.0f) * 100));
    printf("%d %d\n", (int)(1e-3 * 1000), (int)(2.5e2 / 10));
    return 0;
}
