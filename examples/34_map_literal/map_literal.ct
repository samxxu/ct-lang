// 34_map_literal - brace initializers for `Map` (Phase 31 O4)
//
// A local `Map<K, V>` declaration may initialize from `{key: value, …}`. The
// list is parsed as expressions and lowered to the built-in constructor,
// `Map_<enc>_from((struct MapEntry_<enc>[]){ … }, n)`; an empty list passes
// `(0, 0)` and still owns a releasable header. The constructor inserts in item
// order and rewrites a repeated key in place, exactly like `put`, so the runtime
// key `again` keeps `"a"`'s first position and takes its last value.
//
// License: MIT; see LICENSE.EXCEPTION
//@ct-requires: ct-ast


int main(void)
{
    String a_key = "a";
    String b_key = "b";
    String again = a_key;          /* same buffer: the literal dedupe is by handle */
    String one = "one";
    String two = "two";
    Str a = a_key.as_str();
    Str b = b_key.as_str();
    Map<String, int> letters = {a_key: 1, b_key: 2, again: 9};
    Map<String, int> empty = {};
    Map<int, String> names = {1: one, 2: two};

    printf("letters: len = %d, first = ", letters.len());
    MapEntry<String, int> first = letters.entry(0);
    first.key.print();
    printf(", a = %d, b = %d\n", *letters.get(a), *letters.get(b));
    printf("empty: len = %d\n", empty.len());
    printf("names: len = %d, ", names.len());
    String n1 = *names.get(1);
    n1.print();
    printf(" ");
    String n2 = *names.get(2);
    n2.println();

    letters.release();
    empty.release();
    names.release();
    return 0;
}
