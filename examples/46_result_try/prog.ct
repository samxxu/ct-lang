//@ct-requires: ct-ast

Result<int, Str> parse(int n)
{
    Str e = "negative";
    Str z = "";
    if (n < 0) return err: (Result<int, Str>){ 0, 0, e };
    return (Result<int, Str>){ 1, n * 2, z };
}
Result<long, Str> twice(int n)
{
    Str z = "";
    long v = parse(n)?;
    return (Result<long, Str>){ 1, v + 1, z };
}
int main(void)
{
    Result<long, Str> ok = twice(5);
    Result<long, Str> bad = twice(-1);
    printf("%d %ld\n", ok.ok, ok.ok ? ok.value : -1);
    printf("%d ", bad.ok);
    if (bad.ok) { printf("ok\n"); } else { bad.err.println(); }
    return 0;
}
