// 场景：有人在普通 .ct 里写 `type T = int;`，想给 int 起个别名。
// 角度：反例——类型别名只允许出现在跨单元头（.h.ct）或映射单元（.m.ct）里。
//   原因是别名会参与“宿主键”的规范化和导出；普通 .ct 是单文件编译单元，
//   别名如果只活在单个生成物里，别的单元看到的类型拼写就会不一致。
//   编译器在别名所在行直接报错并退出 1，而不是让它局部生效。
// 期望：stderr 与 expected.err 逐字节一致，退出码 1。
#include <stdio.h>

type T = int;

int main(void) {
    T x = 1;
    printf("%d\n", x);
    return 0;
}
