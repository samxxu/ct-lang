// 场景：函数从池里借到一个连接，临时代码想“顺手把它释放掉”，写了 delete。
// 为什么写这个：借用不是所有权。borrow 声明的指针来自别处（池、调用方栈），
//   delete 会 free 一块不归当前帧管理的内存——这里是编译器直接拒绝，而不是
//   运行期双重释放。
// 角度：反例，固化确切诊断与退出码（1）。正确写法：直接返回，让 Handback
//   在块尾归还；确实要销毁，只能由所有者 delete（见 15_memory/borrow_handback）。
// 仅 ct-ast：borrow / Handback 是 CT 线能力。
#include <stdio.h>

struct Conn {
    int fd;
} use Handback;

impl Handback for Conn {
    void handback()
    {
        printf("handback %d\n", self->fd);
    }
}

static void render(borrow struct Conn *c)
{
    printf("%d\n", c->fd);
    delete c;
}

int main(void)
{
    struct Conn local;
    local.fd = 3;
    render(&local);
    return 0;
}
