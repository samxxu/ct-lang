// 场景：工厂函数 malloc 一个对象交给调用方；调用方用 own 接住，让作用域
//   负责释放。
// 为什么写这个：PH-49 起 own 接受「返回类型字面量为 struct X * 的函数调用」，
//   只要工厂返回类型与声明类型一致；Drop 由该类型自己的 impl 负责。
// 角度：正例，作用域出口跑真实的 Drop 一次。其他指针表达式（&x、字段取址、
//   指针算术）仍是 L49-1；工厂返回类型不匹配也拒绝。
// 仅 ct-ast：own 是 CT 线能力。
#include <stdio.h>
#include <stdlib.h>

struct Box { int n; } use Drop;

impl Drop for Box {
    void drop(void)
    {
        printf("drop %d\n", self->n);
    }
}

static struct Box *make(int n)
{
    struct Box *b = malloc(sizeof(Box));
    b->n = n;
    return b;
}

int main(void)
{
    own Box *b = make(1);
    printf("%d\n", b->n);
    return 0;
}
