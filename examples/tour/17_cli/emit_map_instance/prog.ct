// 场景：两个实例各绑一张表，用 --emit-map 把编译器内部的解析结果导出来。
// 角度：--emit-map 的“实例宿主”形态——maps[].host 是 "instance"，
//   每个实例一条记录、各自有 symbol；calls[] 还会记下装箱后派发的调用点。
// 期望：stdout（map JSON）与 expected.out 逐字节一致，退出码 0。
#include <stdio.h>

trait Lamp {
    int set(int on);
}

struct Led {
    int id;
    int on;
};

struct Led led_a;
struct Led led_b;

static int led_drive(struct Led *l, int on) {
    l->on = on;
    return l->id * 10 + on;
}

map trait Lamp for instance led_a {
    set(on) -> led_drive(&led_a, on);
}

map trait Lamp for instance led_b {
    set(on) -> led_drive(&led_b, on);
}

int main(void) {
    Lamp a;
    led_a.id = 1;
    led_b.id = 2;
    a = led_a;
    printf("%d\n", a.set(1));
    return 0;
}
