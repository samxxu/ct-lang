// 场景：系统时钟模块，调用方只想知道“这段代码跑了几毫秒”，
//   不需要在运行期替换实现，也不需要在对象里保存状态。
// 为什么用 map for namespace：静态 trait 让 `sys::Clock.ticks(5)` 在编译期
//   解析成一个普通 C 函数调用（sys_ticks），没有 iface、没有 vtable、
//   没有装箱。和 07_map_namespace/dynamic 对照：那边用 Writer::hal 装箱，
//   适合运行期换实现；这里适合“全局唯一的副作用”。
// 角度：静态路径的零成本特性——调用点生成的 C 与手写 sys_ticks(5) 完全一致；
//   代价是失去多态，写错命名空间或 trait 名会在编译期直接失败。
namespace sys;

#include "sys.shim.h"

pub trait Clock {
    int ticks(int ms);
}

map trait Clock for namespace sys {
    ticks(ms) -> sys_ticks(ms);
}
