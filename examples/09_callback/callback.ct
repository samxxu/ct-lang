// callback.ct - the container callback convention (Phase 21 S0).
//
// A container never takes a bare callback: it takes the `(fn, env)` pair that
// the closure ABI freezes, with `env` as the callback's first parameter. Today
// the pair is spelled by hand (tier 1: struct + trait, plus a two-line adapter
// that has the `(void *self, ...)` shape); once `=>` lands (S3) a closure
// argument expands into exactly this pair. The container must not retain
// either word.
//
// License: MIT; see LICENSE.EXCEPTION
#include <stdio.h>

trait IntOp {
    int apply(int x);
}

struct Adder {
    int n;
} use IntOp;

impl IntOp for Adder {
    int apply(int x) {
        return x + self->n;
    }
}

struct IntRing {
    int items[4];
    int len;
};

/* The conventional signature: the callback first, then its opaque env. The
   element type is concrete; without generics each element type gets its own
   container function, which is the cost the convention does not hide. */
static int ring_each(struct IntRing *r, int (*fn)(void *env, int x), void *env) {
    int i;
    int sum;
    sum = 0;
    for (i = 0; i < r->len; i++) {
        sum = sum + fn(env, r->items[i]);
    }
    return sum;
}

/* The tier-1 adapter: the env is the object itself. The generated impl wrapper
   has the same shape but is `static` and cannot be named in source, so the
   adapter is written out here. */
static int adder_call(void *env, int x) {
    struct Adder *a;
    a = (struct Adder *)env;
    return a->apply(x);
}

/* A plain C adapter: its context lives on the caller's stack. */
static int add_ten(void *env, int x) {
    int *n;
    n = (int *)env;
    return x + *n;
}

int main(void) {
    struct IntRing r;
    struct Adder a = { .n = 10 };
    int base;

    r.items[0] = 1;
    r.items[1] = 2;
    r.items[2] = 3;
    r.len = 3;

    /* tier 1: the object is the env, the adapter is the fn */
    printf("%d\n", ring_each(&r, adder_call, &a));

    /* a plain C adapter follows the same pair shape */
    base = 20;
    printf("%d\n", ring_each(&r, add_ten, &base));
    return 0;
}
