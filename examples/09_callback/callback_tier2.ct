//@ct-requires: ct-ast
// callback_tier2.ct - the same `(fn, env)` convention, tier 2 (Phase 21, v0.21.0).
//
// A `=>` closure literal expands into exactly the pair tier 1 spells by hand:
// the trampoline becomes `fn`, the captured environment becomes `env`. The
// container stores neither word. A declared closure binding hands over the
// same pair by name.
//
// Kept apart from callback.ct because the L0 seed does not know `=>`.
// License: MIT; see LICENSE.EXCEPTION
#include <stdio.h>

struct IntRing {
    int items[4];
    int len;
};

/* Same signature as tier 1: the callback first, then its opaque env. */
static int ring_each(struct IntRing *r, int (*fn)(void *env, int x), void *env) {
    int i;
    int sum;
    sum = 0;
    for (i = 0; i < r->len; i++) {
        sum = sum + fn(env, r->items[i]);
    }
    return sum;
}

int main(void) {
    struct IntRing r;
    int base = 10;
    int extra = 20;
    int (*add_extra)(int x) = (int x) => x + extra;

    r.items[0] = 1;
    r.items[1] = 2;
    r.items[2] = 3;
    r.len = 3;

    /* tier 2a: a literal fills both slots of the pair */
    printf("%d\n", ring_each(&r, (int x) => x + base));

    /* tier 2b: a declared binding is handed over as the same pair */
    printf("%d\n", ring_each(&r, add_extra));
    return 0;
}
