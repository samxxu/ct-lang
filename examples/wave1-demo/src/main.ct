import hal::Uart;
import hal::Gpio;
import hal::Clock;
import hal::Log;
import PosixHal;
import std::io::Stdout;
import std::str::CharStr;
import std::num::Num;
import std::math::Real;

/* std::io has no printf; format with the mapped int / char * methods and
   write the finished line. */
void print_int(char *label, int value)
{
    char num[16];
    char line[64];
    value.to_str(num, 16);
    label.concat(num, line, 64);
    std::io::Stdout.puts(line);
}

int main(void)
{
    Uart u;
    Gpio g;
    Log l;
    char *s;
    int t1;
    int t2;

    /* Every map in PosixHal names the same instance, so one object boxes into
       all three object traits. Clock is a namespace entry, not a boxable
       trait; hal::Clock.nowMs() is called directly. */
    u = posix_hal;
    g = posix_hal;
    l = posix_hal;

    /* The UART is the only stream with a bytes-in, bytes-out contract; its line
       goes first so the output order does not depend on stdio buffering. */
    u.send("hal\n", 4);

    s = "wave";
    print_int("strlen=", s.length());
    print_int("sqrt=", (int)16.0.sqrt());

    g.write(3, 1);
    print_int("gpio3=", g.read(3));

    /* hal-posix anchors its clock at the first call, so t1 must be 0. Adding
       that to the monotonic check makes an "absolute uptime" regression (PKG-1)
       fail here: the same demo also runs in packages.yml on both targets. */
    t1 = hal::Clock.nowMs();
    t2 = hal::Clock.nowMs();
    print_int("clock=", t2 >= t1 && t1 == 0);

    print_int("uart=", u.send("", 0));
    print_int("log=", l.write("", 0));
    return 0;
}
