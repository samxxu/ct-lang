// 59_custom_subscript - `x[k]` / `x[k] = v` on a user struct.
//
// `x[k]` expands to the inherent `get(k)`; the statement `x[k] = v` expands to
// `set(k, v)`. Since S2 (D-028) the match is by name **and parameter type**, so
// the two `get` methods below coexist: `s[0]` picks `get(int)` and `s[name]`
// picks `get(Str)`. The C symbol of the second overload gets the type suffix.
//
// Also out of scope for this sugar: `+=` / `++` / `&x[k]` and assignment to a
// non-place -- all three are rejected with their own diagnostics (spec §4.64).
//
// License: MIT; see LICENSE.EXCEPTION
//@ct-requires: ct-ast


struct Slot { int value; int other; }

impl Slot {
    int get(int k)
    {
        if (k == 0) {
            return self->value;
        }
        return self->other;
    }
    void set(int k, int n)
    {
        if (k == 0) {
            self->value = n;
        } else {
            self->other = n;
        }
    }
    int get(Str name)
    {
        if (name.len == 4) {
            return self->value + 1;
        }
        return self->value;
    }
}

int main(void)
{
    Slot s;
    Str name = "name";

    s.value = 1;
    s.other = 2;
    s[0] = 7;
    s[1] = 8;
    printf("zero=%d one=%d name=%d\n", s[0], s[1], s[name]);
    return 0;
}
