// 59_custom_subscript - `x["k"]` / `x["k"] = v` on a user struct.
//
// `x["k"]` expands to the inherent `get(k)`; the statement `x["k"] = v`
// expands to `set(k, v)`. Scheme A matches by name + arity only, so the key is
// written as the C string the method takes; keyed dispatch by parameter type
// (so `get(int)` and `get(char *)` could coexist) is REQ-JSACCESS-1 and not
// implemented yet.
//
// Also out of scope for this sugar: `+=` / `++` / `&x[k]` and assignment to a
// non-place -- all three are rejected with their own diagnostics (spec §4.64).
//
// License: MIT; see LICENSE.EXCEPTION
//@ct-requires: ct-ast
#include <stdio.h>
#include <string.h>

struct Slot { int value; }

impl Slot {
    int get(char *k)
    {
        if (strcmp(k, "main") == 0) {
            return self->value;
        }
        return 0;
    }
    void set(char *k, int n)
    {
        if (strcmp(k, "main") == 0) {
            self->value = n;
        }
    }
}

int main(void)
{
    Slot s;

    s.value = 1;
    s["main"] = 7;
    printf("main=%d other=%d\n", s["main"], s["other"]);
    return 0;
}
