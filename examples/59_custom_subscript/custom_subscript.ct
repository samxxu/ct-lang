// 59_custom_subscript - `x[k]` / `x[k] = v` on a user struct.
//
// `x[k]` expands to the inherent `get(k)`; the statement `x[k] = v` expands to
// `set(k, v)`. Since S2 (D-028) the match is by name **and parameter type**, so
// an int keyed protocol can coexist with a string keyed one on the same struct
// -- here the int instance is the only one, and no C string is involved.
//
// Also out of scope for this sugar: `+=` / `++` / `&x[k]` and assignment to a
// non-place -- all three are rejected with their own diagnostics (spec §4.64).
//
// License: MIT; see LICENSE.EXCEPTION
//@ct-requires: ct-ast


struct Slot { int value; int other; }

impl Slot {
    int get(int k)
    {
        if (k == 0) {
            return self->value;
        }
        return self->other;
    }
    void set(int k, int n)
    {
        if (k == 0) {
            self->value = n;
        } else {
            self->other = n;
        }
    }
}

int main(void)
{
    Slot s;

    s.value = 1;
    s.other = 2;
    s[0] = 7;
    s[1] = 8;
    printf("zero=%d one=%d\n", s[0], s[1]);
    return 0;
}
