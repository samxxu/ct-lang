//@ct-requires: ct-ast
// Phase 80: `String` / `Str` ownership -- the handle owns a refcounted buffer,
// `release` drops one reference, `retain` shares it, and `delete` on an
// `own String *` runs the Drop. `Option<String>` and `Vec<String>` propagate
// the lifecycle to their payload.
#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    // 1. A `String` owns its buffer; `release` marks the handle released.
    String s = str_dup("hello");
    printf("s len=%d\n", s.len());
    s.release();
    printf("s after release: len=%d\n", s.len());

    // 2. `retain` shares the buffer: the source may be released and the copy
    //    stays usable while a reference remains.
    String t = str_dup("world");
    String u = t.retain();
    char *uc;
    t.release();
    uc = u.cstr();
    printf("u len=%d (source released)\n", u.len());
    free(uc);
    u.release();

    // 3. `own String *` + `delete`: Drop releases the buffer, frees the struct,
    //    then nulls the pointer.
    own String *p = malloc(sizeof(struct String));
    *p = str_dup("heap");
    delete p;
    printf("deleted p is null: %d\n", p == 0);

    // 4. `Option<String>`: a present value drops the String payload; `none`
    //    carries a zero handle whose drop is safe.
    own Option<String> *o = malloc(sizeof(struct Option_String));
    o->has = 1;
    o->value = str_dup("opt");
    delete o;

    own Option<String> *n = malloc(sizeof(struct Option_String));
    *n = Option<String>::none();
    delete n;

    // 5. `Vec<String>` releases every element on `release()`.
    Vec<String> v = { str_dup("a"), str_dup("b") };
    v.release();

    printf("done\n");
    return 0;
}
