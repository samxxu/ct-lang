// 24_receiver_forms.ct — general receivers (Phase 1.9a): variable subscript,
// pointer-array element and pointer field chain all dispatch normally.
// License: MIT; see LICENSE.EXCEPTION
#include <stdio.h>

trait Greeter {
    void greet();
}

struct Person {
    char *name;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("hi %s\n", self->name);
    }
}

struct Box {
    Person *who;
};

int main() {
    Person ps[3];
    ps[0].name = "A";
    ps[1].name = "B";
    int i = 1;
    ps[i].greet();

    Person p = { .name = "C" };
    Person *ptrs[2];
    ptrs[0] = &p;
    ptrs[0]->greet();

    struct Box b = { .who = &p };
    b.who->greet();
    return 0;
}
