// 03: pass-through — trait-free struct, preprocessor lines, literals and comments
#include <stdio.h>

#define TOUCH(p) ((p).greet())          /* preprocessor lines are never rewritten */

struct Point {
    int x;
    int y;
};

static const char *k_msg = "self->x and p.greet() stay untouched 中文 \" \\ 也不重写";
// p.greet() inside a line comment stays untouched —— 中文注释同样不参与重写
/* self->y inside a block comment stays untouched too */

void show(struct Point *pt) {
    printf("%s %d\n", k_msg, pt->x);
}
