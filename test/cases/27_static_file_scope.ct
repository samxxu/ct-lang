// 27: static file-scope objects and arrays also get their vptrs written
#include <stdio.h>

trait Greeter {
    void greet();
}

struct Person {
    char *name;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("hi %s\n", self->name);
    }
}

static Person g;        // static file-scope object
static Person gs[2];    // static file-scope array

int main(void) {
    g.name = "G";
    gs[0].name = "A";
    gs[1].name = "B";
    g.greet();
    gs[0].greet();
    gs[1].greet();
    return 0;
}
