// 10: a declaration without an initialiser still gets a vptr initialiser
#include <stdio.h>

trait Greeter {
    void greet();
}

struct Person {
    char *name;
    int age;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("hi %s %d\n", self->name, self->age);
    }
}

int main(void) {
    Person p;
    p.name = "Tom";
    p.age = 36;
    p.greet();
    return 0;
}
