// 11: objects passed by value — the parameter type is qualified and dispatch works
#include <stdio.h>

trait Greeter {
    void greet();
    void greet_name(char *name);
}

struct Person {
    char *name;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("hi %s\n", self->name);
    }
    void greet_name(char *name) {
        printf("hi %s, I'm %s\n", name, self->name);
    }
}

void show(Person p) {
    p.greet();
    p.greet_name("Jerry");
}

int main(void) {
    Person p = { .name = "Tom" };
    show(p);
    return 0;
}
