// 05: variable declarations — designated init, struct-qualified form, pointer declaration
#include <stdio.h>

trait Greeter {
    void greet();
}

struct Person {
    char *name;
} use Greeter;

impl Greeter for Person {
    void greet() {
        printf("hello %s\n", self->name);
    }
}

int main(void) {
    Person a = { .name = "A" };
    Person *pa = &a;
    struct Person b = { .name = "B" };
    a.greet();
    b.greet();
    pa->name = "still A";
    a.greet();
    return 0;
}
