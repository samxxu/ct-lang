/* std::test - the failing half. Every check here is meant to fail, so the
   runner can assert that `report` returns non-zero and names each failure. */
import std::test::Test;

int main(void)
{
    Test t;

    std::test::init(&t);
    std::test::check_true(&t, 0, "intentional failure");
    std::test::check_eq_int(&t, 1, 2, "intentional int mismatch");
    std::test::check_eq_str(&t, "a", "b", "intentional string mismatch");
    std::test::check_true(&t, 1, "a passing check");
    return std::test::report(&t);
}
