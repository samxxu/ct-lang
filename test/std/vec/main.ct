/* std::vec - growth, indexing and the empty / out-of-range cases. */
import std::vec::Vec;
import std::test::Test;

int main(void)
{
    Test t;
    VecInt vi;
    VecStr vs;
    int i;
    int x;
    char *s;

    std::test::init(&t);

    std::vec::int_init(&vi);
    std::test::check_eq_int(&t, std::vec::int_len(&vi), 0, "a fresh int vector is empty");
    std::test::check_eq_int(&t, std::vec::int_push(&vi, 7), 0, "push 7");
    std::test::check_eq_int(&t, std::vec::int_push(&vi, 8), 0, "push 8");
    std::test::check_eq_int(&t, std::vec::int_len(&vi), 2, "len after two pushes");
    std::test::check_eq_int(&t, std::vec::int_at(&vi, 1, &x), 0, "at(1)");
    std::test::check_eq_int(&t, x, 8, "at(1) value");
    std::test::check_eq_int(&t, std::vec::int_at(&vi, 2, &x), -1, "at past the end");
    std::test::check_eq_int(&t, std::vec::int_at(&vi, -1, &x), -1, "at before the start");

    /* More than VEC_MIN_CAP forces the doubling path. */
    for (i = 0; i < 100; i++) std::vec::int_push(&vi, i);
    std::test::check_eq_int(&t, std::vec::int_len(&vi), 102, "len after growth");
    std::test::check_eq_int(&t, std::vec::int_at(&vi, 101, &x), 0, "last element after growth");
    std::test::check_eq_int(&t, x, 99, "last element value");
    std::test::check_eq_int(&t, std::vec::int_pop(&vi, &x), 0, "pop");
    std::test::check_eq_int(&t, x, 99, "pop value");
    std::test::check_eq_int(&t, std::vec::int_len(&vi), 101, "len after pop");
    std::vec::int_free(&vi);
    std::test::check_eq_int(&t, std::vec::int_len(&vi), 0, "len after free");
    std::test::check_eq_int(&t, std::vec::int_pop(&vi, &x), -1, "pop on an empty vector");

    std::vec::str_init(&vs);
    std::test::check_eq_int(&t, std::vec::str_push(&vs, "one"), 0, "push a string");
    std::test::check_eq_int(&t, std::vec::str_push(&vs, "two"), 0, "push another");
    std::test::check_eq_int(&t, std::vec::str_len(&vs), 2, "string len");
    std::test::check_eq_int(&t, std::vec::str_at(&vs, 0, &s), 0, "string at(0)");
    std::test::check_eq_str(&t, s, "one", "string at(0) value");
    std::test::check_eq_int(&t, std::vec::str_at(&vs, 2, &s), -1, "string at past the end");
    std::test::check_eq_int(&t, std::vec::str_pop(&vs, &s), 0, "string pop");
    std::test::check_eq_str(&t, s, "two", "string pop value");
    std::test::check_eq_int(&t, std::vec::str_pop(&vs, &s), 0, "string pop the last element");
    std::test::check_eq_str(&t, s, "one", "string pop value of the last element");
    std::test::check_eq_int(&t, std::vec::str_pop(&vs, &s), -1, "string pop on an empty vector");
    std::vec::str_free(&vs);
    std::test::check_eq_int(&t, std::vec::str_len(&vs), 0, "string len after free");

    return std::test::report(&t);
}
