/* std::arena - alignment, overflow blocks, reset and the freed arena. */
import std::arena::Arena;
import std::test::Test;

int main(void)
{
    Test t;
    Arena a;
    char *p;
    char *q;
    int i;

    std::test::init(&t);

    std::test::check_eq_int(&t, std::arena::init(&a, 32), 0, "init");
    p = std::arena::alloc(&a, 1);
    std::test::check_true(&t, p != 0, "alloc a byte");
    std::test::check_eq_int(&t, (int)((long)p % 8), 0, "alloc is 8-byte aligned");
    q = std::arena::alloc(&a, 8);
    std::test::check_true(&t, q != 0, "alloc eight bytes");
    std::test::check_true(&t, q > p, "the second slice is above the first");

    /* A request larger than the block takes a second block. */
    q = std::arena::alloc(&a, 40);
    std::test::check_true(&t, q != 0, "alloc across a block boundary");
    for (i = 0; i < 40; i++) q[i] = (char)i;

    std::arena::reset(&a);
    p = std::arena::alloc(&a, 8);
    std::test::check_true(&t, p != 0, "alloc after reset");
    std::test::check_eq_int(&t, (int)((long)p % 8), 0, "reset keeps the alignment");
    std::test::check_eq_int(&t, std::arena::init(&a, 0), 0, "re-init a live arena");
    std::arena::free_all(&a);
    std::test::check_true(&t, std::arena::alloc(&a, 8) == 0, "alloc after free_all fails");
    std::test::check_true(&t, std::arena::alloc(&a, 0) == 0, "alloc of zero bytes is refused");

    return std::test::report(&t);
}
