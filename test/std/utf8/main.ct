/* std::utf8 - the four sequence lengths and the sequences a strict decoder
   must reject. */
import std::utf8::Utf8;
import std::test::Test;

int main(void)
{
    Test t;
    char eacute[3];
    char euro[4];
    char emoji[5];
    char overlong[3];
    char surrogate[4];
    char buf[16];
    int cp;
    int n;

    std::test::init(&t);

    std::test::check_eq_int(&t, std::utf8::decode("A", &cp), 1, "decode ASCII");
    std::test::check_eq_int(&t, cp, 65, "decode ASCII value");

    eacute[0] = (char)0xC3;
    eacute[1] = (char)0xA9;
    eacute[2] = 0;
    std::test::check_eq_int(&t, std::utf8::decode(eacute, &cp), 2, "decode two bytes");
    std::test::check_eq_int(&t, cp, 233, "decode two-byte value");

    euro[0] = (char)0xE2;
    euro[1] = (char)0x82;
    euro[2] = (char)0xAC;
    euro[3] = 0;
    std::test::check_eq_int(&t, std::utf8::decode(euro, &cp), 3, "decode three bytes");
    std::test::check_eq_int(&t, cp, 8364, "decode three-byte value");

    emoji[0] = (char)0xF0;
    emoji[1] = (char)0x9F;
    emoji[2] = (char)0x98;
    emoji[3] = (char)0x80;
    emoji[4] = 0;
    std::test::check_eq_int(&t, std::utf8::decode(emoji, &cp), 4, "decode four bytes");
    std::test::check_eq_int(&t, cp, 128512, "decode four-byte value");

    std::test::check_eq_int(&t, std::utf8::encode(233, buf, 16), 2, "encode two bytes");
    std::test::check_eq_int(&t, std::utf8::decode(buf, &cp), 2, "round-trip two bytes");
    std::test::check_eq_int(&t, cp, 233, "round-trip two-byte value");
    std::test::check_eq_int(&t, std::utf8::encode(128512, buf, 16), 4, "encode four bytes");
    std::test::check_eq_int(&t, std::utf8::decode(buf, &cp), 4, "round-trip four bytes");
    std::test::check_eq_int(&t, cp, 128512, "round-trip four-byte value");
    std::test::check_eq_int(&t, std::utf8::encode(233, buf, 2), 2, "encode fits exactly");
    std::test::check_eq_int(&t, std::utf8::encode(233, buf, 1), -1, "encode needs the full width");
    std::test::check_eq_int(&t, std::utf8::encode(0xD800, buf, 16), -1, "encode rejects a surrogate");
    std::test::check_eq_int(&t, std::utf8::encode(0x110000, buf, 16), -1, "encode rejects out of range");

    overlong[0] = (char)0xC0;
    overlong[1] = (char)0x80;
    overlong[2] = 0;
    std::test::check_eq_int(&t, std::utf8::decode(overlong, &cp), -1, "decode rejects an overlong");
    surrogate[0] = (char)0xED;
    surrogate[1] = (char)0xA0;
    surrogate[2] = (char)0x80;
    surrogate[3] = 0;
    std::test::check_eq_int(&t, std::utf8::decode(surrogate, &cp), -1, "decode rejects a surrogate");
    std::test::check_eq_int(&t, std::utf8::decode("\x80", &cp), -1, "decode rejects a lone continuation");
    std::test::check_eq_int(&t, std::utf8::decode("\xC3", &cp), -1, "decode rejects a truncated sequence");

    n = std::utf8::length("héllo");
    std::test::check_eq_int(&t, n, 5, "length counts code points, not bytes");
    std::test::check_eq_int(&t, std::utf8::length(emoji), 1, "length of one four-byte point");
    std::test::check_eq_int(&t, std::utf8::length("\x80"), -1, "length rejects invalid text");

    return std::test::report(&t);
}
