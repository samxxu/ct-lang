/* The declaration unit of a C library's global and function. `extern` is a
   declaration only: it lands in `lib.h` and `lib.c` defines nothing for it.
   The definitions live in lib_impl.c. */
extern int lib_flag;

pub extern int lib_fn(int x);

pub int lib_flag_get(void);
int lib_flag_get(void) { return lib_flag; }
