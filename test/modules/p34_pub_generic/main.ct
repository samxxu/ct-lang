// Phase 34 S2b: repeated `id<int>` calls share one consumer-owned instance;
// the owner's `id<long>` does not consume a consumer instance number.
#include <stdio.h>

import lib;

int main(void)
{
    int a = id<int>(3);
    int b = id<int>(3);
    long c = from_lib(4);
    printf("%d %d %ld\n", a, b, c);
    return 0;
}
