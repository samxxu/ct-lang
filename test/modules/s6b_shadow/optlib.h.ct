pub enum Option<T> {
    Some(T v),
    None(),
}

impl<T> Option<T> {
    pub int is_some() {
        match (self) {
            Option.Some(v) => { return 1; }
            Option.None() => { return 0; }
        }
        return 0;
    }

    pub T get_or(T d) {
        match (self) {
            Option.Some(v) => { return v; }
            Option.None() => { }
        }
        return d;
    }
}
