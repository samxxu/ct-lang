/* The consumer: it reads and writes both exports, which are distinct objects
   because the namespace prefixes the C name. */
#include <stdio.h>

import a::one;
import b::two;

int main(void)
{
    int ha;
    int hb;
    int ga;
    int gb;

    printf("%d %d\n", a::h, b::h);
    a::h = 5;
    b::h = 50;
    /* The getters write the very globals the same argument list reads, so the
       reads are bound first: C does not order argument evaluation. */
    ha = a::h;
    hb = b::h;
    ga = a::get_a();
    gb = b::get_b();
    printf("%d %d %d %d\n", ha, hb, ga, gb);
    return 0;
}
