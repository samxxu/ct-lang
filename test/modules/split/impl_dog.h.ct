import shapes;

#include <stdio.h>

/* A `pub` trait on a `pub` struct exports its vtable (2a.1): `shapes.h`
   declares `struct Speak_vtbl Dog_Speak_vtable;` and this unit defines it with
   external linkage, so another unit that boxes a Dog points at the same table.
   `Dog_Speak_hi` itself stays static here -- callers dispatch through the vptr
   stored in the object, never through the function symbol. */
impl Speak for Dog {
    void hi() {
        printf("woof %d\n", self->n);
    }
}

static Dog g_dog = { .n = 7 };

/* The accessor hands back the singleton; callers in other units reach `hi()` by
   dispatching through the vptr stored in the object, never through the vtable
   symbol, which is why a separate unit can still call it. */
pub struct Dog *dog_get(void);
struct Dog *dog_get(void)
{
    return &g_dog;
}
