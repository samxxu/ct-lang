#include <stdio.h>
#define PROLOGUE_MACRO 7

// The header prologue copies `#include` lines but never other `#` lines: a
// macro is implementation detail, and repeating it in the header could
// collide with a consumer's own definition.

pub int answer(void) {
    return PROLOGUE_MACRO;
}

int main(void) {
    printf("%d\n", answer());
    return 0;
}
