// this one overflows the *value interface field* table (nif): `T x` where T is a
// trait (the field holds a fat pointer).
trait T { void tick(); }

struct Big {
    T v0;
    T v1;
    T v2;
    T v3;
    T v4;
    T v5;
    T v6;
    T v7;
    T v8;
    T v9;
    T v10;
    T v11;
    T v12;
    T v13;
    T v14;
    T v15;
    T v16;
    T v17;
    T v18;
    T v19;
    T v20;
    T v21;
    T v22;
    T v23;
    T v24;
    T v25;
    T v26;
    T v27;
    T v28;
    T v29;
    T v30;
    T v31;
    T v32;
};
