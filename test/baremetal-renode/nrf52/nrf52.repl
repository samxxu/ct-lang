/* Minimal nRF52840 platform with the plain (non-EasyDMA) UART model: the
   board repl marks uart0 easyDMA, and that path does not emit characters in
   the Renode build used by CI. */
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

flash: Memory.MappedMemory @ sysbus 0x0
    size: 0x100000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

uart0: UART.NRF52840_UART @ sysbus 0x40002000
    -> nvic@2
