#include <stdio.h>

/* Phase 1: namespaces mangle every generated symbol with a prefix and resolve
   unqualified names in the enclosing namespace. `A::B::x` is the qualified form. */

namespace Shop {
    trait Greeter { void greet(); }
    struct Person { char *name; } use Greeter;
    impl Greeter for Person { void greet() { printf("hi %s\n", self->name); } }

    void demo(void) {
        Person p = { .name = "Tom" };
        p.greet();
    }
}

int main(void) {
    Shop::Person q = { .name = "Ada" };
    q.greet();
    Shop::demo();
    return 0;
}
