// S1b-S2 cleanup edge 6: several defers in one block run in reverse source
// order, both on the return edge and on the block-tail edge.
#include <stdio.h>

static int h(void)
{
    defer { printf("A\n"); }
    defer { printf("B\n"); }
    defer { printf("C\n"); }
    return 5;
}

int main(void)
{
    printf("h=%d\n", h());
    return 0;
}
