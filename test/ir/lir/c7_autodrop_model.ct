// S1b-S2 owned entry: AutoDrop lowers to a Drop cleanup entry, is verified
// (V6/V8), and S2c prints it from LIR (
// `if (b) { Box_Drop_drop(b); free(b); b = 0; }`), ready=1 byte for byte.
#include <stdio.h>
#include <stdlib.h>

struct Box { int n; } use Drop;

impl Drop for Box {
    void drop(void)
    {
        printf("drop %d\n", self->n);
    }
}

int main(void)
{
    own Box *b = malloc(sizeof(Box));
    b->n = 3;
    return 0;
}
