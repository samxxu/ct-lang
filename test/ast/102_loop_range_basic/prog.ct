/* 102 (Phase 23): loop(a..b) is half-open -- it prints 2, 3, 4 and nothing
   else, next to the native `for` it stands for, so "equivalent" is an
   executable claim rather than prose. */
#include <stdio.h>

int main(void)
{
    int j;
    int sum_loop = 0;
    int sum_for = 0;

    loop(2..5) {
        printf("loop %d\n", i);
        sum_loop = sum_loop + i;
    }
    for (j = 2; j < 5; j++) {
        printf("for %d\n", j);
        sum_for = sum_for + j;
    }
    printf("sum %d %d\n", sum_loop, sum_for);
    return 0;
}
