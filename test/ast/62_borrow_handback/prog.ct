#include <stdio.h>

struct Conn {
    int fd;
    int in_use;
} use Handback;

impl Handback for Conn {
    void handback() { self->in_use = 0; printf("handback %d\n", self->fd); }
}

struct ConnPool {
    struct Conn slots[2];
};

static struct ConnPool g_pool;

static struct Conn *acquire(int fd)
{
    struct Conn *c = &g_pool.slots[fd];
    c->fd = fd;
    c->in_use = 1;
    return c;
}

void render(borrow struct Conn *c)
{
    printf("render %d\n", c->fd);
}

int main(void)
{
    {
        borrow struct Conn *a = acquire(0);
        borrow struct Conn *b = acquire(1);
        render(a);
        printf("in_use %d %d\n", a->in_use, b->in_use);
    }
    printf("after %d %d\n", g_pool.slots[0].in_use, g_pool.slots[1].in_use);
    return 0;
}
