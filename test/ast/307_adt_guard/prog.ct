/* 307: S5 guards (v1-PH-2).
   `pattern if expr` evaluates the guard after the pattern matched; a false
   guard falls through to the next arm, and the pattern bindings are in scope
   inside the guard. A guarded arm never counts toward exhaustiveness, so an
   unguarded arm (or `_`) still has to cover the variant. */


enum Shape {
    Circle(int r),
    Square(int s),
    Rect(int w, int h),
}

enum Flag {
    On(),
    Off(),
}

int area(Shape s, int limit)
{
    match (s) {
        Shape.Circle(r) if r > limit => { return 100 + r; }
        Shape.Square(s) if s > limit => { return 200 + s; }
        Shape.Circle(r) if r > 0 => { return r; }
        Shape.Circle(r) => { return 0; }
        Shape.Square(s) => { return s; }
        Shape.Rect(w, h) if w > h => { return w; }
        Shape.Rect(w, h) => { return h; }
    }
    return -1;
}

int classify(Shape s, int limit)
{
    return match (s) {
        Shape.Circle(r) if r > limit => 1,
        Shape.Circle(r) => 2,
        Shape.Square(s) => 3,
        Shape.Rect(w, h) => 4,
    };
}

int bucket(int n, int hi)
{
    match (n) {
        -1 if hi > 0 => { return 1; }
        -1 => { return 2; }
        _ => { return 0; }
    }
    return 3;
}

int gated(Shape s, Flag fl)
{
    /* The guard parses its own expression `match`: the outer arm's pattern
       facts have to be frozen before the nested reader reuses the scratch. */
    match (s) {
        Shape.Circle(r) if (match (fl) {
            Flag.On() => 1,
            Flag.Off() => 0,
        }) > 0 && r > 0 => { return r; }
        Shape.Circle(r) => { return 0; }
        Shape.Square(x) => { return x; }
        Shape.Rect(w, h) => { return w * h; }
    }
    return -1;
}

int main(void)
{
    printf("%d %d %d\n", area(Shape.Circle(5), 3), area(Shape.Circle(2), 3),
           area(Shape.Circle(-1), 3));
    printf("%d %d %d\n", area(Shape.Square(9), 3), area(Shape.Square(1), 3),
           area(Shape.Rect(5, 2), 3));
    printf("%d %d %d\n", classify(Shape.Circle(5), 3),
           classify(Shape.Circle(1), 3), classify(Shape.Square(1), 3));
    printf("%d %d %d %d\n", bucket(-1, 1), bucket(-1, 0), bucket(4, 1),
           classify(Shape.Rect(1, 1), 3));
    printf("%d %d %d %d\n", gated(Shape.Circle(7), Flag.On()),
           gated(Shape.Circle(7), Flag.Off()), gated(Shape.Circle(0), Flag.On()),
           gated(Shape.Square(4), Flag.On()));
    return 0;
}
