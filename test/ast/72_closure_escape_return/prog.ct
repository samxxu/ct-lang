// 72 (Phase 21 S4): a closure that only lives in its frame is fine -- it is
// created, captures `n` and `base`, and is called before the frame returns.
// The escape form (`return c;`) lives in test/ast/errors/closure_escape_return.ct.
#include <stdio.h>

int apply(int base)
{
    int n = 3;
    int (*add)(int x) = (int x) => x + n + base;
    return add(5);
}

int main(void)
{
    printf("%d\n", apply(10));
    return 0;
}
