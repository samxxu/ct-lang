/* AutoDrop (SH-33): every `return` releases what the scope owns before it
   leaves, so the drop runs on the taken path instead of after it. Both a
   brace-less branch return and a return inside a braced branch are pinned;
   the braced one also shows that the release appended at the `}` is a no-op
   afterwards, because the pointer was nulled. */
#include <stdio.h>
#include <stdlib.h>

struct Box {
    int n;
} use Drop;

impl Drop for Box {
    void drop(void) {
        printf("dropped %d\n", self->n);
    }
}

int pick(int c)
{
    own Box *b = malloc(sizeof(Box));
    b->n = c;
    if (c) return 1;
    printf("using %d\n", b->n);
    return 0;
}

int pick2(int c)
{
    own Box *b = malloc(sizeof(Box));
    b->n = 10;
    if (c) {
        printf("early %d\n", b->n);
        return 1;
    }
    return 0;
}

int main(void)
{
    printf("pick(1)=%d\n", pick(1));
    printf("pick(0)=%d\n", pick(0));
    printf("pick2(1)=%d\n", pick2(1));
    printf("pick2(0)=%d\n", pick2(0));
    return 0;
}
