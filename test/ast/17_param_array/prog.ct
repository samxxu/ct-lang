#include <stdio.h>

trait Expr { int eval(); }

struct Num { int v; } use Expr;

impl Expr for Num { int eval() { return self->v; } }

int total(Expr xs[], int n) {
    int i = 0;
    int acc = 0;
    for (i = 0; i < n; i++) acc = acc + xs[i].eval();
    return acc;
}

int total_ptr(Expr *xs, int n) {
    int i = 0;
    int acc = 0;
    for (i = 0; i < n; i++) acc = acc + xs[i].eval();
    return acc;
}

int main(void) {
    Num a = { .v = 1 };
    Num b = { .v = 2 };
    Expr kids[2];
    kids[0] = a;
    kids[1] = b;
    printf("%d %d\n", total(kids, 2), total_ptr(kids, 2));
    return 0;
}
