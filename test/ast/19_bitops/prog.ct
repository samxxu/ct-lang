// 19: bitwise operators and their compound assignments. The precedence chain
// is C's: `&` -> `^` -> `|` loosest among the bitwise levels, `<<` / `>>`
// between `+` and the comparisons, `~` in the unary tier.
#include <stdio.h>

int main(void) {
    int a;
    int b;
    int t;

    a = 6;
    b = 3;
    printf("%d\n", a & b);        /* 2 */
    printf("%d\n", a | b);        /* 7 */
    printf("%d\n", a ^ b);        /* 5 */
    printf("%d\n", ~a);           /* -7 */
    printf("%d\n", a << 2);       /* 24 */
    printf("%d\n", a >> 1);       /* 3 */

    /* `&` binds tighter than `|`: (6 & 3) | 8 == 10 */
    printf("%d\n", a & b | 8);    /* 10 */
    /* shifts bind looser than `+`: 1 << (2 + 3) == 32 */
    printf("%d\n", 1 << 2 + 3);   /* 32 */
    /* comparisons bind tighter than `&`: 1 & (6 < 3) == 0 */
    printf("%d\n", 1 & a < b);    /* 0 */

    t = 6;
    t &= 3;                       /* 2 */
    t |= 8;                       /* 10 */
    t ^= 3;                       /* 9 */
    t <<= 2;                      /* 36 */
    t >>= 1;                      /* 18 */
    printf("%d\n", t);            /* 18 */
    return 0;
}
