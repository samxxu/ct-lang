/* P0 (REQ-HW-002): an array *without* an initialiser keeps its old shape -- a
   per-element write loop for a local, the per-unit constructor for file scope.
   The fix must not change that path, and must not make it worse. */
#include <stdio.h>

trait Greeter {
    char *who();
}

struct Person {
    char *name;
    int age;
} use Greeter;

impl Greeter for Person {
    char *who() {
        return self->name;
    }
}

Person ps[2];

int main(void)
{
    Person a = { .name = "a", .age = 1 };
    Person b = { .name = "b", .age = 2 };
    Person local[2];
    ps[0] = a;
    ps[1] = b;
    local[0] = a;
    local[1] = b;
    printf("%s %s %s %s\n", ps[0].who(), ps[1].who(), local[0].who(), local[1].who());
    return 0;
}
