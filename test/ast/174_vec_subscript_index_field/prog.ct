/* V29-4 turned positive in Phase 31 (was `vec_subscript_index_field.ct`,
   9:18): a member array of handles. */
#include <stdio.h>

struct Holder {
    Vec<int> v[1];
}

int main(void)
{
    Vec<int> a = {10};
    struct Holder h;
    h.v[0] = a;
    int got = h.v[0][0];
    printf("%d\n", got);
    return 0;
}
