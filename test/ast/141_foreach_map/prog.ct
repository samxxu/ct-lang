#include <stdio.h>

int main(void)
{
    Map<char *, int> m;
    Map<int, char *> rev;

    m.h = 0;
    m.put("b", 2);
    m.put("a", 1);
    m.put("b", 20);             /* rewrites in place, keeps the position */
    m.put("c", 3);

    /* insertion order: b a c */
    foreach (m) {
        printf("%s=%d\n", item.key, item.value);
    }
    printf("len = %d, a = %d\n", m.len(), *m.get("a"));

    m.remove("a");              /* later entries shift left */
    foreach (m) {
        printf("left %s=%d\n", item.key, item.value);
    }

    rev.h = 0;
    rev.put(2, "two");
    rev.put(1, "one");
    foreach (rev) {
        printf("%d -> %s\n", item.key, item.value);
    }

    m.release();
    rev.release();
    return 0;
}
