#include <stdio.h>

int add(int a, int b);

int add(int a, int b)
{
    return a + b;
}

int main(void)
{
    int i;
    int sum = 0;
    for (i = 1; i <= 5; i++) {
        if (i == 3) {
            sum = sum + 10;
        } else {
            sum = sum + i;
        }
    }
    i = 0;
    while (i < 3) {
        i++;
    }
    printf("%d %d\n", sum, add(2, add(3, 4)));
    return 0;
}
