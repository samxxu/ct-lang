/* D-034 D5 / B2: the trait declares an indexed `get` but no indexed `set`, so
   `s[0] = 3` has no write slot. This is a compile-time error (D034-8), not a
   run-time branch: there is no read-only-implementation case. */
trait Slot {
    int get(int k) index;
}

struct Bag {
    int n;
} use Slot;

impl Slot for Bag {
    int get(int k)
    {
        return self->n + k;
    }
}

int main(void)
{
    Bag b;
    Slot s;

    b.n = 1;
    s = b;
    s[0] = 3;
    return 0;
}
