/* V29-4: a `typedef` alias for a function pointer returning a Vec must resolve
   through the typedef table; `fp()[0]` is still a subscript on a Vec. */
Vec<int> mk(void)
{
    Vec<int> v = 4..8 {$ + 10};
    return v;
}

typedef Vec<int> (*VecFn)(void);

int main(void)
{
    VecFn fp = mk;
    return fp()[0].h;
}
