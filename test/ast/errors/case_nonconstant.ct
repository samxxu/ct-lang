/* batch 5: a case label accepts integer constant expressions only; a declared
   variable inside the expression keeps the whole label non-constant, so it is
   refused rather than emitted as C for gcc to reject. */
int main(void) {
    int key;
    key = 1;
    switch (key) {
    case key + 1:
        return 1;
    default:
        break;
    }
    return 0;
}
