/* PH-52 L52-6: a custom subscript supports only `=`; compound assignment needs
   an explicit get/set pair. */
struct X {
    int n;
}

impl X {
    int get(char *k)
    {
        return self->n;
    }
    void set(char *k, int v)
    {
        self->n = v;
    }
}

int main(void)
{
    X x;
    x.n = 1;
    x["k"] += 2;
    return 0;
}
