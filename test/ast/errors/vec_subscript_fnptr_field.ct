/* V29-4: a function-pointer field called through `h.fp()` returns a Vec; the
   subscript is rejected on the call's return type. */
Vec<int> mk(void)
{
    Vec<int> v = 4..8 {$ + 10};
    return v;
}

struct Holder {
    Vec<int> (*fp)(void);
}

int main(void)
{
    Holder h;
    h.fp = mk;
    return h.fp()[0].h;
}
