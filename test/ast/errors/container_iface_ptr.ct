/* L31-1: a container of interface pointers is not supported; store the
   interface value itself.  `Vec<Show>` (the value) is allowed; `Vec<Show *>`
   (the pointer) is rejected because there is no way to box a concrete value
   into an interface-pointer slot. */
trait Show {
    int base();
}

int main(void)
{
    Vec<Show *> v;
    v.h = 0;
    v.data = 0;
    return v.len();
}
