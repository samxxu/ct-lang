/* V29-4: an inherent method of an instantiated struct may return a Vec; a
   subscript on `b.mv()` is rejected on the method's declared return type. */
Vec<int> mk(void)
{
    Vec<int> v = 4..8 {$ + 10};
    return v;
}

struct Box<T> {
    T v;
}

impl<T> Box<T> {
    Vec<int> mv()
    {
        return mk();
    }
}

int main(void)
{
    Box<int> b;
    b.v = 1;
    return b.mv()[0].h;
}
