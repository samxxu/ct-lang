/* L29-13: a container copies its elements, and an interface value carries a
   vptr that a copy has no story for. */
trait Show {
    int base();
}

struct Num {
    int v;
}

impl Show for Num {
    int base() {
        return self->v;
    }
}

int main(void)
{
    Vec<Show> v;
    return v.len();
}
