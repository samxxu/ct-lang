/* LANG-13 反向覆盖：三级链只允许在语句 / 赋值右值的起点物化。
   嵌进二元表达式后没有确定的求值点，必须继续以定位诊断拒绝，
   不能修成「任意位置一律放行」。 */
#include <stdio.h>

struct Ref { int n; }

impl Ref {
    Ref get(int k) { struct Ref r = { self->n + k }; return r; }
    int has(int k) { return self->n == k; }
}

int main(void)
{
    struct Ref doc = { 1 };
    int x = 1 + doc[2][3][4].has(10);
    printf("%d\n", x);
    return 0;
}
