#include <stdio.h>

int main(void)
{
    Vec<int> v;
    Vec<int> w;
    int left;

    v.h = 0;
    printf("push %d %d %d\n", v.push(4), v.push(5), v.push(6));
    printf("len %d, oob %d\n", v.len(), v.get(9) == 0);

    v.set(1, 50);
    printf("set %d %d %d\n", v.get(0), v.get(1), v.get(2));
    printf("pop %d, len %d\n", v.pop(), v.len());

    /* bounds: get answers a zero value, set is a no-op */
    v.set(9, 1);
    printf("bounds %d %d\n", v.get(9), v.len());

    w = v.retain();
    w.push(7);
    printf("shared %d %d\n", v.len(), w.get(2));
    /* V29-2: `release` ends the handle, so the sibling is released first and
       `clear` runs through the handle that is still live; the buffer is shared,
       so the cleared length is what remains. */
    left = w.release();
    printf("release %d\n", left);
    v.clear();
    printf("cleared %d\n", v.len());
    left = v.release();
    printf("freed %d\n", left);
    return 0;
}
