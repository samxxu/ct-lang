/* Phase 52 / E52-2: a generic instance (`Box<int>`) also resolves the
   protocol; the product names Box_int_get, never the template spelling. */
#include <stdio.h>

struct Box<T> {
    T value;
}

impl<T> Box<T> {
    T get(char *k)
    {
        return self->value;
    }
}

int main(void)
{
    Box<int> b;
    b.value = 42;
    printf("v=%d\n", b["k"]);
    return 0;
}
