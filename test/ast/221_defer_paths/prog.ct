#include <stdio.h>

static void normal(void)
{
    defer { printf("normal-defer\n"); }
    printf("normal-body\n");
}

static int early(void)
{
    defer { printf("early-defer\n"); }
    return 7;
}

int main(void)
{
    int i;

    normal();
    if (early() != 7) return 3;
    for (i = 0; i < 3; i++) {
        defer { printf("loop-defer%d\n", i); }
        if (i == 0) continue;
        if (i == 1) break;
    }
    printf("done\n");
    return 0;
}
