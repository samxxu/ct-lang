/* The member decay stops at one dimension: `char names[2][8]` decays to
   `char (*)[8]`, which no host spells, so the receiver type stays unknown and
   the build fails instead of silently becoming `char *`. */
import lit::lit;

#include <string.h>

struct Grid {
    char names[2][8];
};

int main(void)
{
    struct Grid g;

    strcpy(g.names[0], "abc");
    return g.names.id();
}
