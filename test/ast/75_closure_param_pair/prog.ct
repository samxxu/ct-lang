// 75 (Phase 21 S4/R03): a declared closure binding fills the `(fn, env)`
// parameter pair directly. `ring_each(add)` passes the binding's trampoline and
// the address of its stack environment, two C arguments for one source actual.
// The binding is still a binding (D21-13): it cannot be copied, renamed, stored
// in a field or returned, and its own trampoline keeps the return type its
// declaration took. A parameter tail that does not match the host, and a
// position that is not a pair, are pinned in errors/.
#include <stdio.h>

int ring_each(int (*fn)(void *env, int x), void *env)
{
    return fn(env, 3);
}

int main(void)
{
    int n = 2;
    int (*add)(int x) = (int x) => x + n;
    printf("%d %d\n", add(1), ring_each(add));
    return 0;
}
