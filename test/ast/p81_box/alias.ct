/* LANG-24 Stage A: `box<T>` is a deprecated alias for `Box<T>`. It still
 * parses and produces the same `Box_*` instance symbols, and every use prints
 * one `warning: 'box<T>' is deprecated; write 'Box<T>'` (v1.1 removes it). */
#include <stdio.h>

struct R { int x; }

int main(void)
{
    box<R> a = new R { 1 };
    box<R> b = new R { 2 };
    printf("%d %d\n", a.x, b.x);
    a.release();
    b.release();
    return 0;
}
