/* LANG-24 Stage A: `box<T>` is a deprecated alias for `Box<T>`. It still
 * parses (root or `core::` spelling) and produces the same `Box_*` instance
 * symbols; every use prints one
 * `warning: 'box<T>' is deprecated; write 'Box<T>'` (v1.1 removes it). */


struct R { int x; }

int main(void)
{
    box<R> a = new R { 1 };
    box<R> b = new R { 2 };
    core::box<R> c = new R { 3 };
    R raw = { 4 };
    box<R> d = box<R>::of(raw);
    printf("%d %d %d %d\n", a.x, b.x, c.x, d.x);
    a.release();
    b.release();
    c.release();
    d.release();
    return 0;
}
