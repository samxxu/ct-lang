/* PH-81 E81-1/E81-2: `new T { ... }` is the only construction form, the brace
 * list is the same one `T x = { ... }` uses (positional and designated), and
 * `b.f` / `b.f = ...` auto-dereference the handle. `Box<T>` shares the
 * `{refs, aux}` header: releasing the last handle releases the payload's
 * owning fields. */


struct Record { int id; String tag; }
struct Point { int x; int y; }

int main(void)
{
    String lit = "owned";
    String owned = lit.to_string();
    Box<Record> r = new Record { 7, owned };
    printf("id=%d tag=%d refs=%d tag_refs=%d\n",
           r.id, r.tag.len(), r.refs(), r.tag.refs());
    owned.release();
    printf("after source release tag_refs=%d live=%d\n",
           r.tag.refs(), ct_str_live_count());
    r.id = 8;
    printf("id_after_set=%d\n", r.id);

    Box<Point> p = new Point { .y = 2, .x = 1 };
    printf("point=%d,%d\n", p.x, p.y);
    p.x = 5;
    printf("point_after_set=%d,%d\n", p.x, p.y);

    Box<Record> q = new Record { .tag = "literal", .id = 9 };
    printf("designated id=%d tag=%d tag_refs=%d\n", q.id, q.tag.len(), q.tag.refs());

    printf("before release refs=%d live=%d\n", r.refs(), ct_str_live_count());
    r.release();
    p.release();
    q.release();
    printf("after release refs=%d live=%d\n", r.refs(), ct_str_live_count());
    return 0;
}
