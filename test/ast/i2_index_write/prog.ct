/* D-034 (I2) stage two / B1: `void set(K, V) index` is the interface value's
   `[] =`. `s[k] = v` probes the TRAIT declaration, matches the key's static
   type and lands on the existing vtable set slot; the product is the explicit
   `s.set(k, v)` one. */

trait Store {
    int get(int k) index;
    void set(int k, int v) index;
}

struct Mem {
    int n;
} use Store;

impl Store for Mem {
    int get(int k)
    {
        return self->n + k;
    }
    void set(int k, int v)
    {
        self->n = self->n + k * v;
    }
}

int main(void)
{
    Mem m;
    Store s;

    m.n = 1;
    s = m;
    s[2] = 3;
    printf("%d\n", s.get(0));
    return 0;
}
