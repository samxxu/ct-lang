/* 126 (Phase 26 fix, SH-63): a struct tag named `T` coexists with a type
   parameter named `T`. `struct T` must stay a tag; bare `T` is the parameter.
   The `_Generic` arm keeps the tag form legal (SH-62 P2). */
#include <stdio.h>

struct T {
    int v;
};

T getv<T>(struct T *p)
{
    struct T *q;
    T out;

    q = p;
    out = q->v;
    return out;
}

int selTag<T>(int x)
{
    return _Generic(x, struct T: 1, default: 0);
}

int main(void)
{
    struct T t;

    t.v = 7;
    printf("%d %d\n", getv<int>(&t), selTag<int>(0));
    return 0;
}
