#include <string.h>

namespace lib;

/* A type alias renames the C spelling the map is written on; there is no
   `typedef` in `lib.shim.h` any more. `Text` and `Count` are compile-time
   synonyms only. */
pub type Text  = char *;
pub type Count = int;

pub trait TextOps {
    int size();
    int same(Text other);
}

map trait TextOps for type Text {
    size(t)       -> ct_text_size(t);
    same(t, other) -> ct_text_same(t, other);
}

pub trait CountOps {
    int twice();
    int plus(int other);
}

map trait CountOps for type Count {
    twice(n)      -> ct_twice(n);
    plus(n, other) -> ct_plus(n, other);
}
