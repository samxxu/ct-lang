/* Phase 50 / E50-6: the pointer `at` hands back is borrowed (D50-2). Reading it
   and then releasing the container must not double-free the element; the caller
   never releases the `at` pointer. Run under ASAN/UBSAN by p50_has.sh. */


int main(void)
{
    Vec<String> v;
    String *s;
    Map<String, int> m;
    String k;
    int *vp;

    v.h = 0;
    v.push(str_dup("alpha"));
    v.push(str_dup(""));
    s = v.at(0);
    printf("vec has=%d len=%d zero=%d\n", v.has(0), s ? s->len : -1, v.has(1));
    s = v.at(1);
    printf("vec zero len=%d\n", s ? s->len : -1);
    s = v.at(9);
    printf("vec miss=%d at=%d\n", v.has(9), s == 0);
    v.release();

    k = str_dup_len("k\0x", 3);
    m.h = 0;
    m.put(k.as_str(), 7);
    vp = m.get(k.as_str());
    printf("map has=%d val=%d\n", m.has(k.as_str()), vp ? *vp : -1);
    m.release();
    k.release();
    return 0;
}
