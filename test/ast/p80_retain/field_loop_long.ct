/* SH-102 round 3 R6b: 100 iterations, so a fix that only covers the first few
 * turns cannot pass by accident. */


struct Holder { String tag; }

int main(void)
{
    Str lit = "abc";
    Holder h = { 0 };
    int i;
    for (i = 0; i < 100; i++) {
        h.tag = lit.to_string();
    }
    printf("after loop refs=%d live=%d\n", h.tag.refs(), ct_str_live_count());
    h.tag.release();
    printf("final live=%d\n", ct_str_live_count());
    return 0;
}
