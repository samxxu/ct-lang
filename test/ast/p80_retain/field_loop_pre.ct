/* SH-102 round 3 R6b: a straight-line assignment before the loop defines the
 * field, so every iteration releases the previous value. */


struct Holder { String tag; }

int main(void)
{
    Str lit = "abc";
    Holder h;
    int i;
    h.tag = lit.to_string();
    for (i = 0; i < 3; i++) {
        h.tag = lit.to_string();
        printf("iter %d refs=%d live=%d\n", i, h.tag.refs(), ct_str_live_count());
    }
    h.tag.release();
    printf("final live=%d\n", ct_str_live_count());
    return 0;
}
