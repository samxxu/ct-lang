/* SH-102 round 4:C-1 误拒回归。循环前的直线赋值已定义 `h.tag`，分支内的
 * 重赋只作用于这一份已定义存储；分支之后仍按“定义在分支前”处理。 */


struct Holder { String tag; }

int main(void)
{
    Str lit = "abc";
    Holder h;
    int cond = 0;
    h.tag = lit.to_string();
    if (cond) {
        h.tag = lit.to_string();
    }
    h.tag = lit.to_string();
    printf("after branch refs=%d live=%d\n", h.tag.refs(), ct_str_live_count());
    h.tag.release();
    printf("final live=%d\n", ct_str_live_count());
    return 0;
}
