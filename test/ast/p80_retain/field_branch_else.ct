/* SH-102 round 4:两个分支都定义同一字段时，if/else 之后该字段是已定义的
 * （defined_after = defined_before || (then && else)），分支外的重赋合法。 */


struct Holder { String tag; }

int main(void)
{
    Str lit = "abc";
    Holder h;
    int cond = 0;
    if (cond) {
        h.tag = lit.to_string();
    } else {
        h.tag = lit.to_string();
    }
    h.tag = lit.to_string();
    printf("after ifelse refs=%d live=%d\n", h.tag.refs(), ct_str_live_count());
    h.tag.release();
    printf("final live=%d\n", ct_str_live_count());
    return 0;
}
