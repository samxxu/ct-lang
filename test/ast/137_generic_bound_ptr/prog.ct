/* 137 (Phase 28 / A2): the same bound reached through a pointer receiver
   (`p->m`), through an array element (`arr[i].m`), and through a default
   method the adopting struct never writes. */
#include <stdio.h>

trait Compare {
    int cmp(void *other);
    int label()
    {
        return 100;
    }
}

struct Point {
    int x;
} use Compare;

impl Compare for Point {
    int cmp(void *other)
    {
        struct Point *o = (struct Point *)other;
        return self->x - o->x;
    }
}

T maxp<T: Compare>(T a, T b)
{
    if (a->cmp(b) > 0) {
        return a;
    }
    return b;
}

int at<T: Compare>(T *xs, int i, int j)
{
    if (xs[i].cmp(&xs[j]) > 0) {
        return xs[i].label();
    }
    return xs[j].label();
}

int main(void)
{
    struct Point p;
    struct Point q;
    struct Point arr[2];

    p.x = 3;
    q.x = 7;
    arr[0].x = 5;
    arr[1].x = 2;

    printf("ptr %d\n", maxp<struct Point *>(&p, &q)->x);
    printf("arr %d\n", at<struct Point>(arr, 0, 1));
    return 0;
}
