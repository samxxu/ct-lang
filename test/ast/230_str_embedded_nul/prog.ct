// E36-6 (P36): `str_from_len` copies exactly `n` bytes, so an embedded `\0`
// survives; `str_len` answers the byte count, never `strlen`.


int main(void)
{
    String a = str_dup_len("a\0b", 3);
    String b = str_dup_len("", 0);

    printf("%d %d %d\n", a.len(), a.data[1], b.len());
    a.release();
    b.release();
    return 0;
}
