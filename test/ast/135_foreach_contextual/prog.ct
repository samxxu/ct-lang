/* 135 (Phase 27): `foreach` is a contextual keyword, never reserved (D27-1).
   A variable and a label may carry the name; only a statement-position
   `foreach (` is promoted to the statement form. */
#include <stdio.h>

int main(void)
{
    int foreach = 3;
    int n = 0;

    goto foreach;
    n = 1;
foreach:
    printf("%d %d\n", foreach, n);
    return 0;
}
