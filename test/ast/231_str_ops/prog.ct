// E36-7 (P36): slice / concat / compare work on byte lengths: the empty
// string, an all-`\0` buffer and UTF-8 multi-byte text. `str_c_str` is a
// NUL-terminated copy the caller frees; `len` stays the contract.
#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    String a = str_dup("hello");
    String b = str_dup("世界");
    Str s = str_slice(a.as_str(), 1, 3);
    String c = str_concat(a.as_str(), b.as_str());
    String e = str_dup("");
    String z = str_dup_len("\0\0", 2);
    char *cs = s.cstr();

    printf("%d %d %d\n", s.len(), b.len(), c.len());
    printf("%s %d %d\n", cs, e.len(), z.len());
    printf("%d %d %d %d\n", str_compare(a.as_str(), b.as_str()),
           str_compare(b.as_str(), a.as_str()),
           str_compare(a.as_str(), a.as_str()), str_compare(e.as_str(), e.as_str()));
    free(cs);
    a.release();
    b.release();
    c.release();
    e.release();
    z.release();
    return 0;
}
