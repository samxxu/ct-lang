/* REQ-INDEX-1 / D-028 §1.4: with no matching `set`, `x[k] = v` is the borrow
   write `*get(k) = v` when `get` answers a pointer. */


struct Buf {
    int a[4];
}

impl Buf {
    int *get(int i)
    {
        return &self->a[i];
    }
}

int main(void)
{
    Buf b;
    b.a[1] = 1;
    b[1] = 5;
    printf("%d\n", *b[1]);
    return 0;
}
