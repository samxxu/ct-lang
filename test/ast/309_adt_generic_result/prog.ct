/* v1-PH-2 S6: two type parameters, each substituted into its own variant.
   `Res<int, int>` and `Res<int, char *>` are distinct instances. */
#include <stdio.h>

enum Res<T, E> {
    Ok(T v),
    Err(E e),
}

int main(void)
{
    Res<int, int> a = Res<int, int>.Ok(5);
    Res<int, int> b = Res<int, int>.Err(-2);
    Res<int, char *> c = Res<int, char *>.Err("bad");

    int x;
    int y;
    int z;

    match (a) {
        Res.Ok(v) => { x = v; }
        Res.Err(e) => { x = 0; }
    }
    match (b) {
        Res.Ok(v) => { y = 0; }
        Res.Err(e) => { y = e; }
    }
    match (c) {
        Res<int, char *>.Ok(v) => { z = v; }
        Res<int, char *>.Err(msg) => { z = 1; printf("%s\n", msg); }
    }
    printf("%d %d %d\n", x, y, z);
    return 0;
}
