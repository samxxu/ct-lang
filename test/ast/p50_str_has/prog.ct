/* Phase 50 / E50-5: a `Str` key compares by len + bytes, so an embedded NUL is
   data (`a\0b` != `a\0c`) and a longer/shorter prefix is a miss. A present zero
   value still reports `has == 1`. License: MIT; see LICENSE.EXCEPTION */
#include <stdio.h>

int main(void)
{
    String a = str_dup_len("a\0b", 3);
    String b = str_dup_len("a\0c", 3);
    String longer = str_dup_len("a\0bX", 4);
    String prefix = str_dup_len("a\0", 2);
    String plain = str_dup("a");
    Map<String, int> m;
    int *p;

    m.h = 0;
    m.put(a.as_str(), 0);
    m.put(b.as_str(), 2);
    p = m.get(a.as_str());
    printf("nul-a has=%d hit=%d val=%d\n", m.has(a.as_str()), p != 0, p ? *p : -1);
    p = m.get(b.as_str());
    printf("nul-b has=%d hit=%d val=%d\n", m.has(b.as_str()), p != 0, p ? *p : -1);
    printf("longer=%d prefix=%d plain=%d\n", m.has(longer.as_str()), m.has(prefix.as_str()), m.has(plain.as_str()));
    p = m.get(longer.as_str());
    printf("miss get=%d\n", p == 0);
    m.release();
    a.release();
    b.release();
    longer.release();
    prefix.release();
    plain.release();
    return 0;
}
