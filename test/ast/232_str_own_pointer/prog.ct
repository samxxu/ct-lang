// E36-8 (P80): `own String *` reuses the existing AutoDrop path. `delete` runs
// the `impl Drop for String` (which releases the refcounted buffer), frees the
// struct and nulls the pointer. The built-in layer is `lib/std/Str.h.ct`.
#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    own String *p = malloc(sizeof(struct String));
    char *c;

    *p = str_dup("hi");
    c = p->cstr();
    printf("%s %d\n", c, p->len);
    free(c);
    delete p;
    printf("%d\n", p == 0);
    return 0;
}
