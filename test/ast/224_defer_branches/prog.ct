#include <stdio.h>

static void branch(void)
{
    if (1) defer { printf("if-defer\n"); }
    printf("after-if\n");
}

static void loopfn(void)
{
    int i;
    defer { printf("func-defer\n"); }
    for (i = 0; i < 2; i++) {
        defer { printf("loop-defer%d\n", i); }
        if (i == 0) continue;
        break;
    }
    printf("after-loop\n");
}

static void nested(void)
{
    defer { printf("outer\n"); }
    {
        defer { printf("inner\n"); }
        return;
    }
}

static void gotosame(void)
{
    int n = 0;
    {
        defer { printf("goto-defer\n"); n = 1; }
        goto L;
    L:
        printf("goto-label\n");
    }
    printf("goto-n=%d\n", n);
}

static void gotonested(void)
{
    defer { printf("nested-defer\n"); }
    if (1) goto N;
N:
    printf("nested-label\n");
}

int main(void)
{
    int defer = 1;
    branch();
    loopfn();
    nested();
    gotosame();
    gotonested();
    printf("defer=%d\n", defer);
    return 0;
}
