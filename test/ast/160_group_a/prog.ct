/* Phase 30 E30-9 group A: field configuration plus external calls. The
   receiver (a pointer returned by a call) is named once, the verbs line up. */
#include <stdio.h>
#include <string.h>

struct AppConfig {
    char *host;
    int port;
    int registered;
};

static struct AppConfig g_cfg;

static struct AppConfig *config_instance(void)
{
    return &g_cfg;
}

static void validate_config(struct AppConfig *c)
{
    printf("validate %s %d\n", c->host, c->port);
}

static void register_shutdown(struct AppConfig *c, int port)
{
    c->registered = port;
}

int main(void)
{
    struct AppConfig *cfg = config_instance() into {
        .host = "0.0.0.0";
        .port = 8080;
        validate_config($);
        register_shutdown($, .port);
    };
    printf("cfg %s %d %d\n", cfg->host, cfg->port, cfg->registered);
    return 0;
}
