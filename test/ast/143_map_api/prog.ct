#include <stdio.h>

int main(void)
{
    Map<char *, int> m;
    Map<char *, int> shared;
    MapEntry<char *, int> e;
    int *slot;
    int left;

    m.h = 0;
    {
        int p1 = m.put("bo", 1);
        int p2 = m.put("amy", 2);
        int p3 = m.put("cy", 3);
        printf("put %d %d %d\n", p1, p2, p3);
    }
    printf("len %d\n", m.len());

    slot = m.get("amy");
    printf("get %d %d\n", slot != 0, *slot);
    printf("miss %d\n", m.get("zz") == 0);

    /* a duplicate key keeps its position and overwrites the value */
    {
        int dup = m.put("amy", 20);
        printf("dup %d, value %d\n", dup, *m.get("amy"));
    }

    e = m.entry(1);
    printf("entry %s %d\n", e.key, e.value);
    e = m.entry(9);
    printf("oob %d\n", e.value);

    /* remove shifts the tail left, so the insertion order survives */
    {
        int removed = m.remove("bo");
        printf("remove %d %d\n", removed, m.len());
    }
    e = m.entry(0);
    printf("shift %s %d\n", e.key, e.value);

    shared = m.retain();
    shared.put("dee", 4);
    printf("shared %d %d\n", m.len(), *m.get("dee"));
    left = m.release();
    printf("release %d\n", left);
    printf("left %d\n", shared.len());
    left = shared.release();
    printf("freed %d\n", left);
    return 0;
}
