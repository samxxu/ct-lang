pub struct Handle {
    int pos;
    int wrote;
};

pub struct Builder {
    int total;
    int steps;
};

pub struct Handle *handle_open(void);
pub int handle_read(struct Handle *h, int n);
pub void handle_close(struct Handle *h);
pub struct Builder builder_make(int total);
pub struct Builder builder_add(struct Builder b, int n);
pub int builder_value(struct Builder b);

static struct Handle g_handle;

struct Handle *handle_open(void)
{
    g_handle.pos = 0;
    g_handle.wrote = 0;
    return &g_handle;
}

int handle_read(struct Handle *h, int n)
{
    h->pos = h->pos + n;
    return n;
}

void handle_close(struct Handle *h)
{
    h->pos = 0;
}

struct Builder builder_make(int total)
{
    struct Builder b;
    b.total = total;
    b.steps = 0;
    return b;
}

struct Builder builder_add(struct Builder b, int n)
{
    b.total = b.total + n;
    b.steps = b.steps + 1;
    return b;
}

int builder_value(struct Builder b)
{
    return b.total;
}
