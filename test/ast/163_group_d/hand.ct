/* Phase 30 E30-9 group D: the hand-written side. Each subject is hoisted into
   a temp so a field can be read after the actions; the builder chain then runs
   on the temp. */
import lib::types;
import lib::ops;
#include <stdio.h>

int main(void)
{
    struct Handle *recv_demo0 = handle_open();
    recv_demo0->read(4);
    int pos = recv_demo0->pos;
    printf("pos %d\n", pos);

    struct Builder recv_demo1 = builder_make(10);
    recv_demo1 = recv_demo1.add(1);
    struct Builder b = recv_demo1.add(2).add(3);
    printf("b %d %d\n", b.value(), b.steps);
    return 0;
}
