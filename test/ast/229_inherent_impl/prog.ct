// Phase 34 S5a: non-generic inherent methods on a struct. S4 accepted the
// `impl Counter { … }` syntax; S5a wires lookup, static dispatch and the
// `<Struct>_<method>` emission. Instance methods take `&self`, static methods
// take no receiver; `self.field` in the body spells `_self->field`.
#include <stdio.h>

struct Counter {
    int n;
}

impl Counter {
    int get() { return self.n; }
    void inc() { self.n = self.n + 1; }
    static Counter make(int v) { Counter c; c.n = v; return c; }
}

int main(void)
{
    Counter c = Counter.make(5);
    c.inc();
    printf("%d\n", c.get());
    return 0;
}
