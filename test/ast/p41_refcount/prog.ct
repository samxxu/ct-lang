#include <pthread.h>
#include <stdio.h>
atomic int count = 0;
void *worker(void *arg)
{
    int i;
    (void)arg;
    for (i = 0; i < 1000; i++) {
        int old = ct_atomic_load(&count);
        while (!ct_atomic_cas(&count, &old, old + 1))
            ;
    }
    return 0;
}
int main(void)
{
    pthread_t t[4];
    int i;
    for (i = 0; i < 4; i++)
        pthread_create(&t[i], 0, worker, 0);
    for (i = 0; i < 4; i++)
        pthread_join(t[i], 0);
    printf("count=%d\n", ct_atomic_load(&count));
    return 0;
}
